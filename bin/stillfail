#!/bin/sh
# still.fail's command line, from a clone or from an installed release (~/.stillfail/app, see cloud/src/install.ts).
#   stillfail start [--port N]                          runs the station (the release's service does this):
#                                                       stillfail-station, whose loopback port (4760, or a free one when
#                                                       that is taken; --port insists on one) sends links to the page it
#                                                       once had on to still.fail cloud
#   stillfail status                                    where the station is: its workspace and cloud, whether it is
#                                                       online, and why it does no work when it does none
#   stillfail update [--beta|--stable]                  updates this station to its cloud's latest release, on its
#                                                       channel (stable, or the test channel's), once its signature
#                                                       verifies; --beta/--stable puts it on that channel first (back to
#                                                       the stable release even when that is older than the beta it runs)
#   stillfail station enroll <cloud-origin> <token> [--provider comma] [--lock <hash>] [--join | --stay]
#                                                       joins a workspace in still.fail cloud (or in Comma), leaving
#                                                       those it is in; --join stays in them, --stay too when it is in
#                                                       one; --lock pins that workspace lock
#
#   stillfail station id
#   stillfail lock status|reset                         the workspace lock on this station: what is pinned, or taking
#                                                       it away (when every device that could sign is lost)
#   stillfail lock reset --workspace <id>               the lock of a workspace it joined, taken away alike
#   stillfail heap                                      a heap snapshot of the running station's main thread, written
#                                                       to <data>/run (only the latest kept; it holds the station's
#                                                       tokens): what its memory holds, for Chrome's DevTools
#   stillfail uninstall [--purge]                       stops the station for good: its service (launchd's, systemd's,
#                                                       WSL's keeper) and its Helper gone, its release, its Node and
#                                                       ~/.local/bin's link removed; its chats, memory and secrets kept
#                                                       in the data (<data>/uninstalled says so) unless --purge
# The data is in $STILLFAIL_DATA, default ~/.stillfail.
set -eu
# Called through a link (~/.local/bin/stillfail): the app is where the link points.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
here=$(cd "$(dirname "$self")/.." && pwd)
# Called as another product's command (`monoid`: the installer links it so, client/i18n/brand.ts), that product's data
# directory (~/.monoid) beside still.fail's.
own=$HOME/.stillfail
case "$(basename "$0")" in stillfail|stillfail-*) ;; *) [ ! -d "$HOME/.$(basename "$0")/app" ] || own="$HOME/.$(basename "$0")" ;; esac
data=${STILLFAIL_DATA:-$own}
station=${STILLFAIL_STATION_BIN:-$here/mesh/target/release/stillfail-station}

# The station here taken away (the app's 卸载本机 Station does the same: apps/mbui/src/host/*_station.*). Its service as
# the installer named it (cloud/src/install.ts): for a data directory of its own ($STILLFAIL_DATA, a test's), only a
# service that runs that directory, never the person's own station beside it.
uninstall() {
  purge=$1
  case "$data" in ""|/|"$HOME"|"$HOME/") echo "stillfail uninstall: refusing to remove $data" >&2; exit 2 ;; esac
  product=stillfail reverse=fail.still
  case "$(basename "$0") $data" in monoid\ *|*" $HOME/.monoid") product=monoid reverse=build.monoid ;; esac
  apart=""
  [ "$data" = "$HOME/.$product" ] || apart=yes
  case "$(uname -s)" in
    Darwin)
      labels="$reverse.station"
      [ "$product" != stillfail ] || labels="$labels org.3720.ember.station"
      for l in $labels; do
        plist="$HOME/Library/LaunchAgents/$l.plist"
        [ -f "$plist" ] || continue
        [ -z "$apart" ] || grep -qF "<key>STILLFAIL_DATA</key><string>$data</string>" "$plist" || continue
        launchctl bootout "gui/$(id -u)/$l" 2>/dev/null || true
        # (bootout returns before the service is gone)
        for _ in 1 2 3 4 5; do launchctl print "gui/$(id -u)/$l" >/dev/null 2>&1 || break; sleep 1; done
        # (stopped from the app, it is disabled: that is cleared, a later install's service starting as it should)
        launchctl enable "gui/$(id -u)/$l" 2>/dev/null || true
        rm -f "$plist"
      done ;;
    *)
      unit="$product-station.service"
      unit_file="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$unit"
      if [ -f "$unit_file" ] && { [ -z "$apart" ] || grep -qxF "Environment=STILLFAIL_DATA=$data" "$unit_file"; }; then
        systemctl --user disable --now "$unit" 2>/dev/null || true
        rm -f "$unit_file"
        systemctl --user daemon-reload 2>/dev/null || true
      fi
      # WSL's keeper (install.sh keep_wsl): what Windows starts at its sign-in to keep this Linux up
      if [ -z "$apart" ] && [ -n "${WSL_DISTRO_NAME:-}" ] && command -v wslpath >/dev/null 2>&1 && command -v cmd.exe >/dev/null 2>&1; then
        appdata=$(cd / && cmd.exe /c "echo %APPDATA%" 2>/dev/null | tr -d '\r')
        case "$appdata" in ?:\\*) rm -f "$(wslpath -u "$appdata")/Microsoft/Windows/Start Menu/Programs/Startup/$product-station-$WSL_DISTRO_NAME.vbs" ;; esac
      fi ;;
  esac
  # what still runs of it (started by hand, or its service's last): by its pid, as it said it, while that pid is still a
  # process of this data's (a pid is reused once its process is gone)
  for pid in $(cat "$data/stillfail.pid" 2>/dev/null || :; sed -n 's/.*"pid":[ ]*\([0-9][0-9]*\).*/\1/p' "$data/run/station.json" 2>/dev/null); do
    [ "$pid" -gt 1 ] 2>/dev/null && ps -o args= -p "$pid" 2>/dev/null | grep -qF -- "$data" && kill "$pid" 2>/dev/null || continue
    for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
  done
  # its Helper (station/native/helper: the macOS app the station starts), told to quit on its socket with its token,
  # once the station that would start it again is gone
  sock="$data/helper/helper.sock"
  if [ -S "$sock" ] && [ -f "$data/helper/token" ]; then
    node=$data/app/node/bin/node
    [ -x "$node" ] || node=$(command -v node 2>/dev/null || true)
    [ -z "$node" ] || "$node" -e '
      const s = require("net").connect(process.argv[1]);
      const end = () => s.destroy();
      s.setTimeout(3000, end);
      s.on("error", end);
      s.on("connect", () => s.write(JSON.stringify({ token: process.argv[2], op: "quit" }) + "\n"));
      s.on("data", end);' "$sock" "$(tr -d ' \r\n' < "$data/helper/token")" 2>/dev/null || true
  fi
  link="$HOME/.local/bin/$product"
  if [ -L "$link" ]; then case "$(readlink "$link")" in "$data/app/"*) rm -f "$link" ;; esac; fi
  if [ -n "$purge" ]; then
    rm -rf "$data"
  else
    rm -rf "$data/app" "$data/app.old" "$data/app.failed" "$data/node" "$data/helper" "$data/run" "$data/stillfail.pid"
    [ ! -d "$data" ] || : > "$data/uninstalled"
  fi
  if [ -n "$purge" ]; then echo "stillfail: uninstalled, $data removed"; else echo "stillfail: uninstalled; chats, memory and secrets kept in $data"; fi
}

case "${1:-} ${2:-}" in
  "uninstall ") [ $# -eq 1 ] || { echo "usage: stillfail uninstall [--purge]" >&2; exit 2; }; uninstall "" ;;
  "uninstall --purge") [ $# -eq 2 ] || { echo "usage: stillfail uninstall [--purge]" >&2; exit 2; }; uninstall yes ;;
  "uninstall "*) echo "usage: stillfail uninstall [--purge]" >&2; exit 2 ;;
  "start "*) shift; exec "$station" run --app "$here" --data "$data" "$@" ;;
  "update "*)
    # The channel's latest release, verified by this release's Node (the station's `update`: its signature, newer than
    # this one) and installed by the installer this release carries, told what it must hash to
    # (scripts/release-sign.ts). Not the cloud's installer: whoever serves it could put anything here.
    node=${STILLFAIL_NODE:-$here/node/bin/node}
    [ -x "$node" ] && [ -f "$here/station/main.js" ] || { echo "stillfail update: $here is not an installed release (no node/bin/node or station/main.js)" >&2; exit 1; }
    case "${2:-}" in --beta|--stable|"") ;; *) echo "usage: stillfail update [--beta|--stable]" >&2; exit 2 ;; esac
    shift
    plan=$("$node" "$here/station/main.js" update "$@" --app "$here" --data "$data") || exit $?
    script=""
    while IFS='=' read -r key value; do
      case $key in
        script) script=$value ;;
        STILLFAIL_ORIGIN|STILLFAIL_CHANNEL|STILLFAIL_RELEASE_SHA256|STILLFAIL_NODE_SHA256|STILLFAIL_INSTALL_LANG|STILLFAIL_ARCHIVE) export "$key=$value" ;;
      esac
    done <<PLAN
$plan
PLAN
    [ -n "$script" ] || { echo "stillfail update: no installer to run" >&2; exit 1; }
    STILLFAIL_DATA=$data exec sh "$script" ;;
  "station enroll") shift 2; exec "$station" enroll "$@" --data "$data" ;;
  "status "*|"station status") exec "$station" status --data "$data" ;;
  "station id") exec "$station" id --data "$data" ;;
  "lock status"|"lock reset") what=$2; shift 2; exec "$station" lock "$what" "$@" --data "$data" ;;
  "heap "*)
    node=${STILLFAIL_NODE:-$here/node/bin/node}
    [ -x "$node" ] && [ -f "$here/station/main.js" ] || { echo "stillfail heap: $here is not an installed release (no node/bin/node or station/main.js)" >&2; exit 1; }
    exec "$node" "$here/station/main.js" heap --data "$data" ;;
  *) echo "usage: stillfail start [--port N] | stillfail status | stillfail update [--beta|--stable] | stillfail station enroll <cloud-origin> <token> [--provider comma] [--lock <hash>] [--join | --stay] | stillfail station id | stillfail lock status | stillfail lock reset [--workspace <id>] | stillfail heap" >&2; exit 2 ;;
esac
