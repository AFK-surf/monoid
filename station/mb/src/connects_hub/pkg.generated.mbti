pub async fn WorkspaceConnects::route(Self, String, String, String, String) -> Unit
pub fn WorkspaceConnects::runs_on(Self, String) -> String?
pub async fn WorkspaceConnects::settle_moving(Self, peer? : String?) -> Unit
pub async fn WorkspaceConnects::take_held(Self, String) -> Unit

pub(all) struct WorkspaceDeps {
  data : String
  hub : WsHub
  store : WsStore
  config : Config
  here : () -> String
  home : () -> String?
  stations : (String) -> Array[@jsjson.JValue]
  bus : Bus
  names : (String) -> NameBook?
  fs : Fs
  log : Log
  speech : Speech
  uuid : () -> String
}

pub(all) struct WsHub {
  chat_of : async (String) -> Surface?
  config_connects : async () -> Array[@jsjson.JValue]
  receive : async (String, @jsjson.JValue) -> Unit
  moved_to : async (String, String, String) -> String?
  quiet_in : async (String) -> Bool
  surface : async (String) -> String
  told_bots : async (String, Array[String]) -> Unit
}

pub(all) struct WsStore {
  drop_connect_thread_station : async (String, String, String) -> Unit
  set_connect_thread_station : async (String, String, String, String) -> Unit
  connect_thread_station : async (String, String, String) -> String?
  drop_connect_threads : async (String) -> Unit
  connect_threads : async (String) -> Array[@jsjson.JValue]
  connect_local_threads : async (String) -> Array[@jsjson.JValue]
  thread_at : async (String, String, String) -> @jsjson.JValue
}

