// Values as JavaScript has them (@jsjson.JV: JSON.parse and JSON.stringify exactly), and what the routes ask of
// them: a field, its type, `String(v)`, a whole number, an object put together in JavaScript's order of keys.

///|
pub using @jsjson {
  type JV,
  js,
  jnum,
  jint,
  jbool,
  jarr,
  jstrs,
  jopt,
  jobj,
  jset,
  jdel,
  jspread,
  jget,
  jhas,
  jstr,
  jnumber,
  is_object,
  is_array,
  is_objectish,
  jitems,
  jfields,
  jv_stringify as stringify,
  stringify_opt,
  jv_parse as parse,
  is_integer,
  is_safe_integer,
  num_text,
  jv_js_string as js_string,
  text_of,
  js_number,
  trim_js,
  chars,
  code_points,
  points,
  utf8,
  utf8_text,
  try_parse,
  js_compare,
  jundef,
  is_undef,
  defined,
}
