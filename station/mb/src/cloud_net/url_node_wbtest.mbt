// What Node's `new URL` gives for these, written by its own run (a station test's vectors).

///|
test "urls as Node parses them" {
  url_case("https://relay.example.com", Some(["https://relay.example.com/", "https://relay.example.com", "/", "", ""]))
  url_case("https://Relay.Example.COM/", Some(["https://relay.example.com/", "https://relay.example.com", "/", "", ""]))
  url_case("https://relay.example.com:443/", Some(["https://relay.example.com/", "https://relay.example.com", "/", "", ""]))
  url_case("https://relay.example.com:8443//", Some(["https://relay.example.com:8443//", "https://relay.example.com:8443", "//", "", ""]))
  url_case("http://localhost:3000/x/../y/./z", Some(["http://localhost:3000/y/z", "http://localhost:3000", "/y/z", "", ""]))
  url_case("HTTPS://a.b/%7e?q=1#f", Some(["https://a.b/%7e?q=1#f", "https://a.b", "/%7e", "?q=1", "#f"]))
  url_case("https://user:pw@host/", Some(["https://user:pw@host/", "https://host", "/", "", ""]))
  url_case("https://host/?", Some(["https://host/?", "https://host", "/", "", ""]))
  url_case("https://host/#", Some(["https://host/#", "https://host", "/", "", ""]))
  url_case("https://0x7f.1/", Some(["https://127.0.0.1/", "https://127.0.0.1", "/", "", ""]))
  url_case("https://127.1/", Some(["https://127.0.0.1/", "https://127.0.0.1", "/", "", ""]))
  url_case("https://[::1]:443/", Some(["https://[::1]/", "https://[::1]", "/", "", ""]))
  url_case("https://[2001:db8:0:0:0:0:2:1]/", Some(["https://[2001:db8::2:1]/", "https://[2001:db8::2:1]", "/", "", ""]))
  url_case("https://[::ffff:192.168.1.1]/", Some(["https://[::ffff:c0a8:101]/", "https://[::ffff:c0a8:101]", "/", "", ""]))
  url_case("  https://trim.me/  ", Some(["https://trim.me/", "https://trim.me", "/", "", ""]))
  url_case("https://ta\tb.c/", Some(["https://tab.c/", "https://tab.c", "/", "", ""]))
  url_case("https:\\\\back.slash\\path", Some(["https://back.slash/path", "https://back.slash", "/path", "", ""]))
  url_case("https:noslash.com", Some(["https://noslash.com/", "https://noslash.com", "/", "", ""]))
  url_case("https://例え.jp/パス", Some(["https://xn--r8jz45g.jp/%E3%83%91%E3%82%B9", "https://xn--r8jz45g.jp", "/%E3%83%91%E3%82%B9", "", ""]))
  url_case("https://xn--r8jz45g.jp/", Some(["https://xn--r8jz45g.jp/", "https://xn--r8jz45g.jp", "/", "", ""]))
  url_case("https://host/a b", Some(["https://host/a%20b", "https://host", "/a%20b", "", ""]))
  url_case("https://host/a%20b?x y#z w", Some(["https://host/a%20b?x%20y#z%20w", "https://host", "/a%20b", "?x%20y", "#z%20w"]))
  url_case("wss://app.still.fail/v1/stations/connect", Some(["wss://app.still.fail/v1/stations/connect", "wss://app.still.fail", "/v1/stations/connect", "", ""]))
  url_case("lan", None)
  url_case("ours", None)
  url_case("tailnet", None)
  url_case("direct", None)
  url_case("mailto:x@y", Some(["mailto:x@y", "null", "x@y", "", ""]))
  url_case("foo://Host/Path", Some(["foo://Host/Path", "null", "/Path", "", ""]))
  url_case("foo:bar baz", Some(["foo:bar baz", "null", "bar baz", "", ""]))
  url_case("https://", None)
  url_case("https://:443", None)
  url_case("http://a:99999/", None)
  url_case("https://host/%2e%2E/x", Some(["https://host/x", "https://host", "/x", "", ""]))
  url_case("https://host/a/%2e./b", Some(["https://host/b", "https://host", "/b", "", ""]))
  url_case("file:///tmp/x", Some(["file:///tmp/x", "null", "/tmp/x", "", ""]))
  url_case("file://localhost/etc", Some(["file:///etc", "null", "/etc", "", ""]))
  url_case("https://a..b/", Some(["https://a..b/", "https://a..b", "/", "", ""]))
  url_case("https://host:/", Some(["https://host/", "https://host", "/", "", ""]))
  url_case("https://ho%73t/", Some(["https://host/", "https://host", "/", "", ""]))
  url_case("https://host/^`{}", Some(["https://host/%5E%60%7B%7D", "https://host", "/%5E%60%7B%7D", "", ""]))
  url_case("https://host/?a'b\"c", Some(["https://host/?a%27b%22c", "https://host", "/", "?a%27b%22c", ""]))
  url_case("https://exa mple.com/", None)
  url_case("https://h/p?q#f#g", Some(["https://h/p?q#f#g", "https://h", "/p", "?q", "#f#g"]))
  url_case("data:text/plain,hi", Some(["data:text/plain,hi", "null", "text/plain,hi", "", ""]))
  url_case("https://1.2.3.4.5/", None)
  url_case("https://256.0.0.1/", None)
  url_case("https://09.1/", None)
  url_case("https://foo.0x/", None)
  url_case("https://h/é", Some(["https://h/%C3%A9", "https://h", "/%C3%A9", "", ""]))
}
