pub(all) struct SchedulerDeps {
  data : String
  disk : Disk
  clock : Clock
  say : Say
  modules : Array[Module]
  changed : (() -> Unit)?
  progress : ((Need, @jsjson.JValue) -> Unit)?
  tell_arrived : (async (String, Need) -> Unit)?
  now : (() -> Double)?
  refusal : (async (String, String) -> String?)?
  room_for_all : (async (String, String, @jsjson.JValue) -> String?)?
  hold : (() -> (() -> Unit))?
  restarted : (() -> String)?
  reads : ((String) -> PlanReads)?
  turn : ((Bool, String) -> Unit)?
}

pub(all) struct Selection {
  module : String?
  item : String?
  all : Bool
  with_needs : Bool
  follow : Array[String]?
  arrive_stopped : Bool
}
