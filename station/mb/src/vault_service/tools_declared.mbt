// The vault's tools as the agents are told them (station/src/vault/tool.ts): each one's name, description and
// parameters, written out whole from the TypeScript (the same bytes, so a session is told the same).

///|
let tools_declared : String =
  #|[{"name":"sign_in","description":"Get this chat's browser signed in to a website: the one way to ask for it. A sign-in the person you work for keeps in their vault for the site is asked for on a card; with none kept, first open the site's sign-in page in this chat's browser (the `browser` tool), then call this: a card has them sign in, and you never see what they typed. It does not wait: you are told in this session when the page has left its sign-in, and what to do then (done, stuck). Never ask for a password or a code in the chat, and do not post the tab's screen for a sign-in yourself. Skill stillfail-browser (Sign-ins) says the rest: passkeys, a sign-in that ran out.","inputSchema":{"type":"object","properties":{"site":{"type":"string","description":"The site's host (github.com)."},"reason":{"type":"string","description":"Why you need to be signed in, for the person, in the language they use (e.g. 查看 PR #512 的 Actions 日志)."},"tab":{"type":"string","description":"The tab (its target id, from the browser tool's tabs) whose sign-in page it is; default this chat's last tab on the site."},"again":{"type":"boolean","description":"The sign-in kept in the vault ran out: ask the person to sign in anew (kept again)."},"reask":{"type":"boolean","description":"The existing sign-in is still needed but its card is no longer pending: post a new card for that sign-in."},"done":{"type":"boolean","description":"You looked after being told the page left its sign-in: it is signed in."},"stuck":{"type":"string","description":"You looked: it is not signed in yet; what is left for the person to do there, in their language."},"name":{"type":"string","description":"With done: what it is kept by, as secret_save's name; default <site> 登录态."},"about":{"type":"string","description":"With done: what it is for and how it is used (how its site is reached, what to open), in the person's language; never a secret."}},"required":["site"],"additionalProperties":false}},{"name":"secret_list","description":"List vault secrets you may ask to use (name, about, delivery modes, hosts), your active grants, and vault status. Never returns values. Missing credential: use secret_save (never ask in chat); wrong or obsolete: secret_delete. Skill stillfail-vault.","inputSchema":{"type":"object","properties":{"person":{"type":"string","description":"Whose vault and approver (email of someone in this chat from the still.fail app). Default: chat starter."}},"additionalProperties":false}},{"name":"secret_use","description":"Request approval via card to use a secret from secret_list. Non-blocking: you are notified once approved in the app (gives a grant id for secret_run; chat replies never grant). Skill stillfail-vault.","inputSchema":{"type":"object","properties":{"item":{"type":"string","description":"The secret: its item id or name from secret_list."},"reason":{"type":"string","description":"Why you need it, for the person deciding, in the language they use (e.g. 重跑 PR #512 失败的 release job)."},"command":{"type":"string","description":"The exact command you will run with it, shown on the card: what the person approves. None for a sign-in (mode browser)."},"mode":{"type":"string","enum":["proxy","ssh","env","file","browser"],"description":"How it is given; default the item's first. Prefer proxy: the command never holds the value. browser: a sign-in, put into this chat's browser while the grant lasts."},"hosts":{"type":"array","items":{"type":"string"},"description":"By proxy: the hosts it goes to, among the item's (default all of them)."},"station":{"type":"string","description":"Another station of the workspace (its name or id) the commands run on, for what only it reaches; default this one."},"timeout":{"type":"object","properties":{"kind":{"type":"string","enum":["idle","fixed"]},"seconds":{"type":"integer","minimum":60,"maximum":2592000,"multipleOf":60}},"required":["kind","seconds"],"additionalProperties":false,"description":"Requested timeout: idle renews at each use; fixed ends that long after approval. Default idle one hour, at most 30 days. Ask what the task needs and say why in reason (a daily task: 24–36 hours)."},"person":{"type":"string","description":"Whose vault and approver (email of someone in this chat from the still.fail app). Default: chat starter."}},"required":["item","reason"],"additionalProperties":false}},{"name":"secret_save","description":"Request approval via card to save a credential or website sign-in (kind browser) to the vault; once approved this chat gets an immediate grant (request id). Prefer command over value; omit value/command/path so the person enters it on the card (or oauth to sign in). Non-blocking. Skill stillfail-vault.","inputSchema":{"type":"object","properties":{"name":{"type":"string","description":"What the person and agents know it by, plain at a glance: the service and the account or site, and where it is reached when that is not plain; never a bare host."},"about":{"type":"string","description":"What it is for and how it is used, in the person's language: what it opens, the steps to reach it, the tool or command that takes it. Shown to agents with its name: never a secret in it."},"kind":{"type":"string","enum":["token","login","ssh_key","file","browser"],"description":"token (an API key), login (a password, with username), ssh_key (a private key), file (a whole file, at most 64 KB), browser (a sign-in: the cookies and passkeys of hosts, read from a browser; no value, command or path)."},"reason":{"type":"string","description":"Why it is worth keeping, for the person deciding, in the language they use."},"command":{"type":"string","description":"A command run here (sh -c, in your workspace) that prints the secret on standard output and nothing else (op read 'op://Personal/Ui/password')."},"path":{"type":"string","description":"file: the file to keep (here, relative to your workspace or absolute; with station, there), read as its bytes."},"value":{"type":"string","description":"The secret itself, only when you already hold it (a token you were given or created)."},"username":{"type":"string","description":"login: the account's name (not secret: shown on the card)."},"public_key":{"type":"string","description":"ssh_key: its public half, if known."},"filename":{"type":"string","description":"file: the name it is written out under for commands (service-account.json); default path's."},"modes":{"type":"array","items":{"type":"string","enum":["proxy","ssh","env","file","browser"]},"description":"How agents may be given it later; default proxy with hosts, else env (ssh for an SSH key, file for a file)."},"hosts":{"type":"array","items":{"type":"string"},"description":"proxy: the hosts it may go to (api.github.com). browser: the sites the sign-in is for, each with its subdomains (github.com)."},"browser":{"type":"string","enum":["chat","station"],"description":"browser: where the sign-in is read from: this chat's browser (default), or the station's own (sign-ins made before each chat had its own)."},"env":{"type":"string","description":"The variable a command gets it in (GH_TOKEN; a file's path: KUBECONFIG)."},"oauth":{"type":"string","enum":["slack"]},"station":{"type":"string","description":"Another station of the workspace (its name or id) to run command on, where the password manager is signed in; default this one."},"scope":{"type":"string","enum":["personal","workspace"],"description":"Where to save it: personal (default, your own vault) or workspace (shared workspace vault)."},"person":{"type":"string","description":"Whose vault and approver (email of someone in this chat from the still.fail app). Default: chat starter."}},"required":["name","about","kind","reason"],"additionalProperties":false}},{"name":"secret_describe","description":"Request approval via card to rename a secret or update its about text (what it is for and how it is used; never include secrets). Give at least one of name or about. Non-blocking.","inputSchema":{"type":"object","properties":{"item":{"type":"string","description":"The secret: its item id or name from secret_list."},"name":{"type":"string","description":"Its new name (default: as it is)."},"about":{"type":"string","description":"Its new about: what it is for and how it is used (default: as it is; empty: none)."},"reason":{"type":"string","description":"Why, for the person deciding, in the language they use."},"person":{"type":"string","description":"Whose vault and approver (email of someone in this chat from the still.fail app). Default: chat starter."}},"required":["item","reason"],"additionalProperties":false}},{"name":"secret_delete","description":"Request approval via card to permanently delete a wrong, replaced or obsolete secret from its owner's vault across all chats. Non-blocking (only app approval deletes it).","inputSchema":{"type":"object","properties":{"item":{"type":"string","description":"The secret: its item id or name from secret_list."},"reason":{"type":"string","description":"Why it should go, for the person deciding, in the language they use."},"person":{"type":"string","description":"Whose vault and approver (email of someone in this chat from the still.fail app). Default: chat starter."}},"required":["item","reason"],"additionalProperties":false}},{"name":"secret_cancel","description":"Withdraw an undecided request of this chat (secret_use, secret_save, secret_describe, secret_delete) when no longer needed, closing its card and removing it from the person's pending list.","inputSchema":{"type":"object","properties":{"request":{"type":"string","description":"The pending request id (r_…) secret_use, secret_save, secret_describe or secret_delete answered."}},"required":["request"],"additionalProperties":false}},{"name":"secret_reask","description":"Post a new card for an existing secret_use or secret_save request whose card stopped waiting after a chat message, if the request is still needed. It reuses the same request and never reads the secret again. A different pending card is not replaced. Only this chat's own undecided request may be reasked.","inputSchema":{"type":"object","properties":{"request":{"type":"string","description":"The pending request id (r_…) from secret_use, secret_save, secret_describe, secret_delete or the card-state notice."}},"required":["request"],"additionalProperties":false}},{"name":"secret_run","description":"Run a shell command (sh -c, in your workspace) with a secret_use grant. Proxy swaps placeholder (item env / STILLFAIL_SECRET) on granted HTTPS hosts only; ssh sets SSH_AUTH_SOCK; env sets the variable; file writes a temp file path to env/STILLFAIL_SECRET; logins set STILLFAIL_USERNAME. Output redacts values (never try to extract them). Single-use grants expire after one run.","inputSchema":{"type":"object","properties":{"grant":{"type":"string","description":"The grant id (r_…) secret_use gave."},"command":{"type":"string","description":"The shell command (run by sh -c)."},"env":{"type":"string","description":"The variable to put the secret (proxy: its placeholder; file: its path) in; default the item's (e.g. GH_TOKEN)."},"cwd":{"type":"string","description":"Where it runs; default this session's workspace."},"timeout_seconds":{"type":"integer","minimum":1,"maximum":3600,"description":"Stopped after this long; default 600."},"station":{"type":"string","description":"The station the grant was asked for (secret_use station); default that one."}},"required":["grant","command"],"additionalProperties":false}}]
