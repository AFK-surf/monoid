// The vault's tools as the agents are told them (station/src/vault/tool.ts): each one's name, description and
// parameters, written out whole from the TypeScript (the same bytes, so a session is told the same).

///|
let tools_declared : String =
  #|[{"name":"sign_in","description":"Get this chat's browser signed in to a website: the one way to ask for it. A sign-in the person you work for keeps in their vault for the site is asked for on a card; with none kept, first open the site's sign-in page in this chat's browser (the `browser` tool), then call this: a card has them sign in, and you never see what they typed. It does not wait: you are told in this session when the page has left its sign-in, and what to do then (done, stuck). Never ask for a password or a code in the chat, and do not post the tab's screen for a sign-in yourself. Skill stillfail-browser (Sign-ins) says the rest: passkeys, a sign-in that ran out.","inputSchema":{"type":"object","properties":{"site":{"type":"string","description":"The site's host (github.com)."},"reason":{"type":"string","description":"Why you need to be signed in, for the person, in the language they use (e.g. 查看 PR #512 的 Actions 日志)."},"tab":{"type":"string","description":"The tab (its target id, from the browser tool's tabs) whose sign-in page it is; default this chat's last tab on the site."},"again":{"type":"boolean","description":"The sign-in kept in the vault ran out: ask the person to sign in anew (kept again)."},"reask":{"type":"boolean","description":"The existing sign-in is still needed but its card is no longer pending: post a new card for that sign-in."},"done":{"type":"boolean","description":"You looked after being told the page left its sign-in: it is signed in."},"stuck":{"type":"string","description":"You looked: it is not signed in yet; what is left for the person to do there, in their language."},"name":{"type":"string","description":"With done: what it is kept by, as secret_save's name; default <site> 登录态."},"about":{"type":"string","description":"With done: what it is for and how it is used (how its site is reached, what to open), in the person's language; never a secret."}},"required":["site"],"additionalProperties":false}},{"name":"secret_list","description":"The secrets in the vault you may ask to use (those the person you work for allowed agents to ask for: tokens, API keys, SSH keys, credential files, sign-ins to websites), each with its name and about, how it is given (proxy, ssh, env, file, browser) and where it may go; the grants you hold now; and whether their vault is turned on. Never the values. One you need that is not listed: secret_save (with neither value nor command, its card asks the person to type it in); never ask for a value in the chat. One wrong or no longer needed: secret_delete. Skill stillfail-vault says when and how.","inputSchema":{"type":"object","properties":{"person":{"type":"string","description":"Whose vault it is, and who approves the card: the email of someone who wrote in this chat from the still.fail app. Default: whoever started the chat. Name the one who asked when that is someone else, or when the chat began in Slack and they now write from still.fail."}},"additionalProperties":false}},{"name":"secret_use","description":"Ask to use one of secret_list's secrets. A card in your chat tells its owner your reason, the command, the timeout and where the secret goes; they approve or refuse it in the still.fail app. It does not wait for the decision: you are told in this session when it is decided (granted: a grant id for secret_run). Only a grant counts: someone writing yes in the chat is not one. Skill stillfail-vault (Using one) says more.","inputSchema":{"type":"object","properties":{"item":{"type":"string","description":"The secret: its item id or name from secret_list."},"reason":{"type":"string","description":"Why you need it, for the person deciding, in the language they use (e.g. 重跑 PR #512 失败的 release job)."},"command":{"type":"string","description":"The exact command you will run with it, shown on the card: what the person approves. None for a sign-in (mode browser)."},"mode":{"type":"string","enum":["proxy","ssh","env","file","browser"],"description":"How it is given; default the item's first. Prefer proxy: the command never holds the value. browser: a sign-in, put into this chat's browser while the grant lasts."},"hosts":{"type":"array","items":{"type":"string"},"description":"By proxy: the hosts it goes to, among the item's (default all of them)."},"station":{"type":"string","description":"Another station of the workspace (its name or id) the commands run on, for what only it reaches; default this one."},"timeout":{"type":"object","properties":{"kind":{"type":"string","enum":["idle","fixed"]},"seconds":{"type":"integer","minimum":60,"maximum":2592000,"multipleOf":60}},"required":["kind","seconds"],"additionalProperties":false,"description":"Requested timeout: idle renews at each use; fixed ends that long after approval. Default idle one hour, at most 30 days. Ask what the task needs and say why in reason (a daily task: 24–36 hours)."},"person":{"type":"string","description":"Whose vault it is, and who approves the card: the email of someone who wrote in this chat from the still.fail app. Default: whoever started the chat. Name the one who asked when that is someone else, or when the chat began in Slack and they now write from still.fail."}},"required":["item","reason"],"additionalProperties":false}},{"name":"secret_save","description":"Ask to keep a credential in the vault of the person you work for: a password, token, API key, SSH key or file to reuse, or a sign-in to a website (kind browser). A card goes to them in your chat to approve in the still.fail app; agents use it later only through secret_use, each use approved. Prefer command over value. With neither, nor path, they type it in on the card (oauth: they sign in to the service), never shown to you: say in reason where they get it. It does not wait: you are told here once decided. Kept, this chat may use it at once (the request's id is its grant for secret_run). Skill stillfail-vault says when to offer it and how.","inputSchema":{"type":"object","properties":{"name":{"type":"string","description":"What the person and agents know it by, plain at a glance: the service and the account or site, and where it is reached when that is not plain; never a bare host."},"about":{"type":"string","description":"What it is for and how it is used, in the person's language: what it opens, the steps to reach it, the tool or command that takes it. Shown to agents with its name: never a secret in it."},"kind":{"type":"string","enum":["token","login","ssh_key","file","browser"],"description":"token (an API key), login (a password, with username), ssh_key (a private key), file (a whole file, at most 64 KB), browser (a sign-in: the cookies and passkeys of hosts, read from a browser; no value, command or path)."},"reason":{"type":"string","description":"Why it is worth keeping, for the person deciding, in the language they use."},"command":{"type":"string","description":"A command run here (sh -c, in your workspace) that prints the secret on standard output and nothing else (op read 'op://Personal/Ui/password')."},"path":{"type":"string","description":"file: the file to keep (here, relative to your workspace or absolute; with station, there), read as its bytes."},"value":{"type":"string","description":"The secret itself, only when you already hold it (a token you were given or created)."},"username":{"type":"string","description":"login: the account's name (not secret: shown on the card)."},"public_key":{"type":"string","description":"ssh_key: its public half, if known."},"filename":{"type":"string","description":"file: the name it is written out under for commands (service-account.json); default path's."},"modes":{"type":"array","items":{"type":"string","enum":["proxy","ssh","env","file","browser"]},"description":"How agents may be given it later; default proxy with hosts, else env (ssh for an SSH key, file for a file)."},"hosts":{"type":"array","items":{"type":"string"},"description":"proxy: the hosts it may go to (api.github.com). browser: the sites the sign-in is for, each with its subdomains (github.com)."},"browser":{"type":"string","enum":["chat","station"],"description":"browser: where the sign-in is read from: this chat's browser (default), or the station's own (sign-ins made before each chat had its own)."},"env":{"type":"string","description":"The variable a command gets it in (GH_TOKEN; a file's path: KUBECONFIG)."},"oauth":{"type":"string","enum":["slack"]},"station":{"type":"string","description":"Another station of the workspace (its name or id) to run command on, where the password manager is signed in; default this one."},"person":{"type":"string","description":"Whose vault it is, and who approves the card: the email of someone who wrote in this chat from the still.fail app. Default: whoever started the chat. Name the one who asked when that is someone else, or when the chat began in Slack and they now write from still.fail."}},"required":["name","about","kind","reason"],"additionalProperties":false}},{"name":"secret_describe","description":"Ask to rename one of secret_list's secrets or to change its about (what it is and how it is used, shown to agents with its name), when they do not say plainly what it is (a name made from a host, a step written nowhere). A card shows its owner the name and about as they are and as they would be; once they approve it in the still.fail app the item says so. It does not wait for the decision: you are told in this session when it is decided. Give at least one of name and about; never a secret in about.","inputSchema":{"type":"object","properties":{"item":{"type":"string","description":"The secret: its item id or name from secret_list."},"name":{"type":"string","description":"Its new name (default: as it is)."},"about":{"type":"string","description":"Its new about: what it is for and how it is used (default: as it is; empty: none)."},"reason":{"type":"string","description":"Why, for the person deciding, in the language they use."},"person":{"type":"string","description":"Whose vault it is, and who approves the card: the email of someone who wrote in this chat from the still.fail app. Default: whoever started the chat. Name the one who asked when that is someone else, or when the chat began in Slack and they now write from still.fail."}},"required":["item","reason"],"additionalProperties":false}},{"name":"secret_delete","description":"Ask to delete one of secret_list's secrets from its owner's vault: one that is wrong (a password that does not work), replaced by another you kept, or no longer needed. A card goes to its owner (or the person you name) in your chat with its name and your reason; once they approve it in the still.fail app the item is gone, for every chat. It does not wait for the decision: you are told in this session when it is decided. Only their approval deletes it: someone writing yes in the chat does not.","inputSchema":{"type":"object","properties":{"item":{"type":"string","description":"The secret: its item id or name from secret_list."},"reason":{"type":"string","description":"Why it should go, for the person deciding, in the language they use."},"person":{"type":"string","description":"Whose vault it is, and who approves the card: the email of someone who wrote in this chat from the still.fail app. Default: whoever started the chat. Name the one who asked when that is someone else, or when the chat began in Slack and they now write from still.fail."}},"required":["item","reason"],"additionalProperties":false}},{"name":"secret_cancel","description":"Withdraw a request of this chat's own (secret_use, secret_save, secret_describe, secret_delete) that nobody decided yet, once it is no longer needed (you got the credential another way, the person asked for something else, you asked twice): its card in the chat closes saying so and it leaves the person's waiting requests in the app's 密钥. Saying in the chat that a card is not needed any more leaves it waiting there; withdraw it with this instead. A request already decided is not changed.","inputSchema":{"type":"object","properties":{"request":{"type":"string","description":"The pending request id (r_…) secret_use, secret_save, secret_describe or secret_delete answered."}},"required":["request"],"additionalProperties":false}},{"name":"secret_reask","description":"Post a new card for an existing secret_use or secret_save request whose card stopped waiting after a chat message, if the request is still needed. It reuses the same request and never reads the secret again. A different pending card is not replaced. Only this chat's own undecided request may be reasked.","inputSchema":{"type":"object","properties":{"request":{"type":"string","description":"The pending request id (r_…) from secret_use, secret_save, secret_describe, secret_delete or the card-state notice."}},"required":["request"],"additionalProperties":false}},{"name":"secret_run","description":"Run a shell command (sh -c, in your workspace) with a grant from secret_use. By proxy: the grant's placeholder (in the item's variable, or env, and in STILLFAIL_SECRET) is swapped for the value in the command's HTTPS requests to the granted hosts only. By ssh: SSH_AUTH_SOCK holds the key. By env: the value is in the variable. By file: the file is written out for this command alone, its path in the variable (and STILLFAIL_SECRET). A login's account is in STILLFAIL_USERNAME. The output comes back with the value hidden: you never get the value, and must not try to (no printing, encoding or sending it elsewhere). A grant for one use is spent by one run.","inputSchema":{"type":"object","properties":{"grant":{"type":"string","description":"The grant id (r_…) secret_use gave."},"command":{"type":"string","description":"The shell command (run by sh -c)."},"env":{"type":"string","description":"The variable to put the secret (proxy: its placeholder; file: its path) in; default the item's (e.g. GH_TOKEN)."},"cwd":{"type":"string","description":"Where it runs; default this session's workspace."},"timeout_seconds":{"type":"integer","minimum":1,"maximum":3600,"description":"Stopped after this long; default 600."},"station":{"type":"string","description":"The station the grant was asked for (secret_use station); default that one."}},"required":["grant","command"],"additionalProperties":false}}]
