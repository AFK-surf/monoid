  app : String?
  control : Bool
  tell : (@json.Json) -> Unit
  end : (String) -> Unit
  watch_only : (String?) -> Unit
}

pub(all) struct WayPath {
  selected : Bool
  relay : String?
  ip : String?
  rtt_ms : Double?
  tx_packets : Double
  lost_packets : Double
  cwnd : Double?
  congestion_events : Double?
}
pub fn WayPath::of_json(@json.Json) -> Self

#derive(Eq, @debug.Debug)
pub(all) enum WindowPick {
  NotOne
  Whole
  Window(Double)
}

// Type aliases
pub type Ask = async (String, String, String, @json.Json) -> @json.Json

pub type Said = (String, String, String, @json.Json) -> Unit

pub type Tell = (String, @json.Json, String, @json.Json) -> Unit

pub type Tr = (String, String, @json.Json) -> String

// Traits
