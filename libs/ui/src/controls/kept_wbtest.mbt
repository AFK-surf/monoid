1,4515]},"search":{}}]

///|
/// The kept answers by call, then by key.
let kept_wb_table : Map[String, Map[String, Json]] = {
  let t : Map[String, Map[String, Json]] = Map([])
  for line in kept_wb_answers.split("\n") {
    match (@json.parse(line.to_owned()) catch { _ => Json::null() }) {
      Array([String(call), String(key), answer]) =>
        match t.get(call) {
          Some(m) => m[key] = answer
          None => {
            let m : Map[String, Json] = Map([])
            m[key] = answer
            t[call] = m
          }
        }
      _ => ()
    }
  }
  t
}

///|
/// The books answered in this run, by the id each was answered with: its key.
let kept_wb_books : Map[Int, String] = Map([])

///|
/// As the app's kept answers (apps/mbui/src/sfkept/answer.mbt) answer `markdown` and `reader.book`; one not kept here, or
/// another of the core's pure calls, is said on the output (`kept-answers-ask`, scripts/check.sh) and an error.
fn kept_wb_answer(name : String, params : Json, bytes : Bytes?) -> Result[(Json, Bytes?), Json]? {
  let param = fn(k : String) -> Json? {
    match params {
      Object(m) => m.get(k)
      _ => None
    }
  }
  let flag = fn(k : String) { param(k) is Some(True) }
  let not_kept = fn(ask : Json) -> Result[(Json, Bytes?), Json]? {
    println("kept-answers-ask " + ask.stringify())
    Some(Err({ "code": "not_kept", "message": "the core's answer to \{name} is not kept: libs/ui/AGENTS.md" }))
  }
  let kept = fn(call : String, key : String) -> Json? {
    match kept_wb_table.get(call) {
      Some(m) => m.get(key)
      None => None
    }
  }
  match name {
    "markdown" => {
      let text = match param("text") {
        Some(String(s)) => s
        _ => ""
      }
      match kept("markdown", text) {
        Some(md) => Some(Ok(({ "md": md }, None)))
        None => not_kept({ "call": "markdown", "text": Json::string(text) })
      }
    }
    "reader.book" => {
      let text = match (param("text"), bytes) {
        (Some(String(s)), _) => s
        (_, Some(b)) => @utf8.decode_lossy(b[:])
        _ => ""
      }
      let markdown = flag("markdown")
      let key = (if markdown { "md" } else { "txt" }) + "\u{1}" + text
      match kept("reader.book", key) {
        Some(Object(entry)) => {
          let id = kept_wb_books.length() + 1
          kept_wb_books[id] = key
          let out : Map[String, Json] = Map([])
          if entry.get("answer") is Some(Object(a)) {
            for k, v in a {
              if k != "md" || flag("tree") {
                out[k] = v
              }
            }
          }
          out["id"] = Json::number(id.to_double())
          if flag("withText") {
            out["text"] = match entry.get("text") {
              Some(String(t)) => Json::string(t)
              _ => Json::string(text)
            }
          }
          Some(Ok((Json::object(out), None)))
        }
        _ => not_kept({ "call": "reader.book", "markdown": Json::boolean(markdown), "text": Json::string(text) })
      }
    }
    "code.ink" | "reader.text" | "reader.search" | "ref.words" => not_kept({ "call": Json::string(name), "params": params })
    _ => None
  }
}

///|
fn init {
  kept_call.val = Some(kept_wb_answer)
}
