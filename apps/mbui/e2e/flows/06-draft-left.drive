# Leave a draft for 07-draft-restart. The next app process must find these words on disk.
# The three client.focus replies confirm the workspace, the open chat, then leaving the chat.
# The last call writes pending drafts. The core trace lets the driver see its reply.
#env MBUI_PLATFORM=android
#env MBUI_CORE_TRACE=1
timeout 60000
answered client.focus
tap 端到端测试
until =willow
answered client.focus
tap 发消息
type 还没发出去的草稿 {T}
answered composer.text
tap icon:chevron-left
answered client.focus
tap icon:folder
until =文件
tap icon:chats
until 端到端测试
