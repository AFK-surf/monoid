{
  "mbt": {
    "roots": [
      "src"
    ],
    "framework": [
      "src/host",
      "src/core"
    ],
    "clock_sources": [
      "src/core",
      "src/host"
    ],
    "frame_core": [
      "src/host"
    ]
  },
  "globals": {
    "roots": [
      "src/sfapp",
      "src/sfbase",
      "src/sfdesk",
      "src/sfpages"
    ]
  },
  "flows": [
    "e2e/flows/*.drive",
    "e2e/win/*.drive"
  ],
  "scripts": [
    "scripts/*.sh",
    "scripts/*.mjs",
    "scripts/*.py",
    "e2e/*.sh",
    "e2e/*.ts",
    "e2e/*.py",
    "e2e/flows/*.check",
    "e2e/win/*"
  ],
  "skip": [
    "scripts/detlint*.py",
    "mbui",
    "out",
    "src/sfbase/web_assets.mbt"
  ],
  "style": {
    "tokens": [],
    "outside": [
      "src/sffilmcheck/main.mbt"
    ]
  },
  "library": {
    "roots": [],
    "imports": [
      "ui/",
      "moonbitlang/",
      "stillfail/sfkept"
    ]
  },
  "pages": {
    "roots": [
      "src/sfapp",
      "src/sfbase",
      "src/sfdesk",
      "src/sfpages"
    ],
    "frames": [
      "src/sfdesk/settings_page.mbt",
      "src/sfpages/settings_page.mbt",
      "src/sfdesk/tape_page.mbt"
    ],
    "one_look": [
      "Narrow",
      "Wide",
      "look_of",
      "desk_page",
      "desk_card",
      "desk_card_text",
      "desk_strong",
      "desk_words",
      "desk_muted",
      "desk_list",
      "desk_list_row",
      "desk_list_link",
      "desk_list_text",
      "desk_list_title",
      "desk_note",
      "desk_note_bad",
      "desk_hint",
      "desk_hint_inline",
      "desk_choice",
      "desk_chevron",
      "desk_mark",
      "narrow_lead_box",
      "narrow_lead",
      "narrow_card_room",
      "narrow_note_box",
      "narrow_note",
      "narrow_note_bad",
      "narrow_note_inline",
      "narrow_said_row",
      "narrow_row",
      "narrow_row_words",
      "narrow_row_title",
      "narrow_value",
      "narrow_chevron",
      "narrow_link_note",
      "wide_heading",
      "wide_value"
    ],
    "old_parts": [
      "button",
      "pick_row",
      "provider_mark",
      "quota_chips",
      "meter_chip"
    ],
    "old_sheets": [
      "open_sheet"
    ]
  },
  "shell": {
    "files": [
      "src/sfapp/app.mbt",
      "src/sfapp/bar.mbt",
      "src/sfapp/bar_node.mbt",
      "src/sfapp/bar_timing.mbt",
      "src/sfapp/bars.mbt",
      "src/sfapp/home_node.mbt",
      "src/sfapp/narrow_shell.mbt",
      "src/sfapp/sheet.mbt",
      "src/sfapp/sides.mbt",
      "src/sfapp/tabletop.mbt",
      "src/sfapp/tape_shell.mbt",
      "src/sfdesk/attention.mbt",
      "src/sfdesk/attention_node.mbt",
      "src/sfdesk/board.mbt",
      "src/sfdesk/brand.mbt",
      "src/sfdesk/chats.mbt",
      "src/sfdesk/context_menu.mbt",
      "src/sfdesk/desk.mbt",
      "src/sfdesk/frame.mbt",
      "src/sfdesk/keys.mbt",
      "src/sfdesk/overlays.mbt",
      "src/sfdesk/page_pane.mbt",
      "src/sfdesk/pane_page.mbt",
      "src/sfdesk/pane_view.mbt",
      "src/sfdesk/rail.mbt",
      "src/sfdesk/rail_native.mbt",
      "src/sfdesk/rail_node.mbt",
      "src/sfdesk/rail_overlays_node.mbt",
      "src/sfdesk/side.mbt",
      "src/sfdesk/side_node.mbt",
      "src/sfdesk/switch.mbt",
      "src/sfdesk/switcher.mbt",
      "src/sfdesk/tape_page.mbt",
      "src/sfdesk/tape_view.mbt"
    ],
    "reads": [
      "@sf.layout",
      "is_wide",
      "@sfdesk.is_wide",
      "status_top",
      "nav_foot",
      "side_folded",
      "@sfdesk.side_folded"
    ],
    "state": [
      "wide",
      "status_top",
      "nav_foot"
    ]
  },
  "fixture": {
    "package": "@sffixture",
    "openers": [
      "src/sfapp/fixture_open.mbt"
    ]
  },
  "build_effect": {
    "later": [
      "@sf.menu",
      "@sf.menu_item_of",
      "@sfbase.message_items",
      "@sf.pick",
      "@sf.panel",
      "@sf.confirm",
      "@sf.ask"
    ]
  },
  "run_first": {
    "starts": [
      "new_run",
      "fresh_app",
      "reset",
      "@sfapp.new_run",
      "@sfapp.fresh_app",
      "@sfapp.reset",
      "@sfbase.reset"
    ],
    "reads": [
      "@sf.t",
      "@sf.t_around",
      "@sf.language",
      "tr",
      "@sfbase.tr"
    ]
  },
  "reset_by_hand": {
    "names": [
      "new_run",
      "@sfapp.new_run"
    ]
  },
  "signals": {
    "scoped_ok": [
      "src/sfbase"
    ],
    "effect_ok": [
      "src/sfbase",
      "src/sffixture"
    ]
  },
  "counts_dir": "detlint.counts",
  "rules": [
    "frame-request",
    "settle",
    "flow-wait",
    "script-wait",
    "page-settle",
    "device-shot",
    "host-import",
    "frame-wait",
    "at-rest-wait",
    "frame-count",
    "literal-time",
    "stable-mode",
    "retired-api",
    "app-clock",
    "wall-clock",
    "engine-math",
    "poll",
    "host-read",
    "builtin-hash",
    "hash-order",
    "globals",
    "style-literal",
    "box-loose",
    "style-exact",
    "style-text",
    "build-effect",
    "after-build-input",
    "unsettled-ok",
    "host-delay",
    "library-import",
    "reset-wire",
    "page-hand",
    "page-screen",
    "page-look",
    "follow-layout",
    "motion-read",
    "page-old-part",
    "page-old-sheet",
    "corners-each",
    "cursor-hand",
    "tier-outside-shell",
    "fixture-import",
    "motion-spring",
    "built-by-hand",
    "layout-read-back",
    "motion-length",
    "tester-branch",
    "frame-number",
    "ui-current",
    "build-clock",
    "build-motion",
    "old-list",
    "list-comes-off",
    "old-island",
    "old-panel",
    "old-set-theme",
    "old-empty-around",
    "click-read",
    "key-read",
    "submitted-read",
    "part-place",
    "button-by-hand",
    "layout-told",
    "abort-unsaid",
    "empty-on-done",
    "panic-test",
    "read-before-run",
    "reset-by-hand",
    "app-word",
    "frame-walk",
    "scoped-computed",
    "raw-effect",
    "pick-loop",
    "each-min-height",
    "each-lookup",
    "layout-drawn-while",
    "shader-int",
    "raw-hover-ground",
    "width-structure",
    "reused-untracked-key",
    "manual-fade-way",
    "page-at-moment",
    "along-row-at-once",
    "headless-on-drag",
    "page-headless",
    "page-control-by-hand",
    "structure-box"
  ]
}
