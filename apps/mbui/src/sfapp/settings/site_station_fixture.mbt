// Bilingual (English / Chinese) station list and overview fixture for monoid.build (MBUI_FIXTURE=settings-station-site).
// Kept separate from test fixtures so existing snapshots and checks stay unchanged.

///|
fn fx_site_station(
  address : String,
  id : String,
  name : String,
  icon : String,
  identity : String,
  summary : String,
  face : String,
  cpu_left : Int,
  cpu_load : String,
  mem_left_pct : Int,
  mem_left_val : String,
  mem_total : String,
  disk_left_pct : Int,
  disk_left_val : String,
  disk_total : String,
  disk_level : String,
  via : String,
  path : String,
  rtt : String,
  en : Bool,
) -> Json {
  let profiles : Array[Json] = if id == "st1" {
    [
      fx_profile(
        "cc",
        "lin@acme.dev",
        "subscription",
        "green",
        if en { "Ready" } else { "可用" },
        "claude",
        if en { "Claude" } else { "Claude 订阅" },
        [
          ("kindText", str(if en { "Subscription" } else { "订阅账号" })),
          ("runtime", str("claude")),
          ("runtimes", [str("claude")]),
          ("email", str("lin@acme.dev")),
          ("models", [str("claude-opus-5-5"), str("claude-sonnet-5")]),
          ("usedBy", []),
          (
            "quota",
            obj([
              ("state", str("ok")),
              (
                "windows",
                [
                  obj([
                    ("label", str(if en { "5 hours" } else { "5 小时" })),
                    ("usedPercent", Json::number(18.0)),
                    ("mark", str("5H")),
                    ("left", Json::number(82.0)),
                    ("level", str("ok")),
                    ("refills", str(if en { "Resets in 2h" } else { "2 小时后恢复" })),
                  ]),
                  obj([
                    ("label", str(if en { "Weekly" } else { "本周" })),
                    ("usedPercent", Json::number(24.0)),
                    ("mark", str("W")),
                    ("left", Json::number(76.0)),
                    ("level", str("ok")),
                    ("refills", str(if en { "Resets Mon" } else { "星期一恢复" })),
                  ]),
                ],
              ),
              ("checkedAt", Json::number(0.0)),
            ]),
          ),
        ],
      ),
      fx_profile(
        "cx",
        "team@acme.dev",
        "subscription",
        "green",
        if en { "Ready" } else { "可用" },
        "chatgpt",
        if en { "ChatGPT" } else { "ChatGPT 订阅" },
        [
          ("kindText", str(if en { "Subscription" } else { "订阅账号" })),
          ("runtime", str("codex")),
          ("runtimes", [str("codex")]),
          ("email", str("team@acme.dev")),
          ("usedBy", []),
          ("quota", obj([("state", str("ok")), ("windows", []), ("checkedAt", Json::number(0.0))])),
        ],
      ),
    ]
  } else {
    []
  }
  obj([
    ("station", str(address)),
    ("id", str(id)),
    ("name", str(name)),
    ("icon", str(icon)),
    ("osIcon", Json::boolean(false)),
    ("summary", str(summary)),
    ("face", str(face)),
    ("line", str(identity)),
    ("online", Json::boolean(true)),
    ("mine", Json::boolean(true)),
    ("profileGroups", Json::array(fx_station_profile_groups(profiles))),
    ("profileStates", fx_station_profile_states(profiles)),
    ("link", obj([("state", str("online"))])),
    ("stateText", str("")),
    ("acceptAutoChats", Json::boolean(true)),
    ("problems", []),
    ("diag", Json::null()),
    ("unprotected", Json::boolean(false)),
    ("protect", Json::boolean(false)),
    ("runtimes", [obj([("runtime", str("claude")), ("models", [str("claude-opus-5-5"), str("claude-sonnet-5")])])]),
    (
      "models",
      [
        obj([("model", str("claude-opus-5-5")), ("name", str("Opus 5.5")), ("family", str("Opus")), ("maker", obj([("id", str("anthropic"))])), ("runtimes", ["claude"])]),
        obj([("model", str("claude-sonnet-5")), ("name", str("Sonnet 5")), ("family", str("Sonnet")), ("maker", obj([("id", str("anthropic"))])), ("runtimes", ["claude"])]),
      ],
    ),
    (
      "host",
      obj([
        ("identity", str(identity)),
        ("gpus", []),
        (
          "meters",
          [
            meter(
              "CPU",
              cpu_left,
              "ok",
              if en { "\{cpu_left}% idle" } else { "空闲 \{cpu_left}%" },
              cpu_left.to_string(),
              "%",
              if en { "CPU idle" } else { "CPU 空闲率" },
              if en { "Load \{cpu_load}" } else { "负载 \{cpu_load}" },
              title_short=if en { "CPU idle" } else { "CPU 空闲" },
            ),
            meter(
              if en { "Mem" } else { "内存" },
              mem_left_pct,
              "ok",
              if en { "\{mem_left_val}G left" } else { "剩 \{mem_left_val} G" },
              mem_left_val,
              "GB",
              if en { "Memory left" } else { "可用内存" },
              if en { "of \{mem_total}" } else { "总内存 \{mem_total}" },
              total_short=if en { "of \{mem_total}" } else { "总 \{mem_total}" },
            ),
            meter(
              if en { "Disk" } else { "磁盘" },
              disk_left_pct,
              disk_level,
              if en { "\{disk_left_val}G left" } else { "剩 \{disk_left_val} G" },
              disk_left_val,
              "GB",
              if en { "Disk left" } else { "可用磁盘" },
              if en { "of \{disk_total}" } else { "总磁盘 \{disk_total}" },
              total_short=if en { "of \{disk_total}" } else { "总 \{disk_total}" },
            ),
          ],
        ),
        ("uptimeText", str(if en { "Up 6d 4h" } else { "已运行 6 天 4 小时" })),
        ("madeOf", str(if en { "Apple M4 Max · 16 cores · arm64 · macOS 26.6 · willow" } else { "Apple M4 Max · 16 核 · arm64 · macOS 26.6 · willow" })),
        ("egressText", str(if en { "Egress US" } else { "出口 美国" })),
      ]),
    ),
    (
      "net",
      obj([
        ("path", str(path)),
        ("via", str(via)),
        ("rtt", obj([("text", str(rtt)), ("level", str("ok"))])),
        ("rttHistory", []),
        ("down", str("1.2 MB/s")),
        ("up", str("420 KB/s")),
        ("total", str("")),
        ("downTotal", str("212 MB")),
        ("upTotal", str("9.6 MB")),
      ]),
    ),
    (
      "overview",
      obj([
        ("connects", [fx_connect("k1", if en { "Acme Bot" } else { "星火助手" }, "online", if en { "Online" } else { "在线" }, "multi-session")]),
        ("profiles", Json::array(profiles)),
        ("logins", []),
        ("processesText", str(if en { "3 agent processes · 266 MB" } else { "3 个 agent 进程 · 266 MB" })),
        ("slackApps", []),
        ("drive", obj([("roots", [{ "path": "~/projects", "name": if en { "projects" } else { "项目" }, "state": "ok" }]), ("all", Json::boolean(false))])),
        ("disabledRuntimes", Json::array([])),
        ("updates", []),
        ("agentEnv", []),
        ("mcpServers", []),
        ("search", obj([("files", str("spotlight")), ("personal", Json::boolean(false))])),
        ("context", obj([("afreshWhenCold", Json::boolean(false)), ("afreshAbove", Json::number(0.0))])),
        ("diagnostics", obj([("logs", Json::boolean(false))])),
        ("autoChats", obj([("enabled", Json::boolean(true)), ("canEdit", Json::boolean(true))])),
        ("network", obj([("congestion", str("auto"))])),
        ("elevation", Json::null()),
        ("screenService", Json::null()),
        ("copies", Json::null()),
        ("move", Json::null()),
        ("features", fx_station_features()),
        ("sharing", Json::boolean(true)),
        ("shareAllowAuto", Json::boolean(true)),
        ("machineLogins", []),
      ]),
    ),
    ("betaOffered", Json::boolean(false)),
  ])
}

///|
fn fx_site_stations() -> Array[Json] {
  let en = @sf.language() == "en"
  [
    fx_site_station(
      "ws1/st1",
      "st1",
      "Willow",
      "glyph:desktop",
      "Apple M4 Max · 64 GB · macOS 26.6",
      if en { "1 running" } else { "1 个在运行" },
      "working",
      81,
      "3.1",
      57,
      "36.6",
      "64 GB",
      62,
      "612",
      "994 GB",
      "ok",
      "direct",
      if en { "Direct" } else { "直连" },
      "12 ms",
      en,
    ),
    fx_site_station(
      "ws1/st2",
      "st2",
      "Mini",
      "glyph:mini:blue",
      "Apple M4 · 16 GB · macOS 26.6",
      if en { "Idle" } else { "空闲" },
      "idle",
      88,
      "1.2",
      39,
      "6.2",
      "16 GB",
      42,
      "214",
      "512 GB",
      "ok",
      "direct",
      if en { "Direct" } else { "直连" },
      "18 ms",
      en,
    ),
    fx_site_station(
      "ws1/st3",
      "st3",
      if en { "Laptop" } else { "笔记本" },
      "glyph:laptop:purple",
      "Apple M3 Pro · 36 GB · macOS 26.6",
      if en { "Idle" } else { "空闲" },
      "idle",
      92,
      "0.8",
      39,
      "14.1",
      "36 GB",
      39,
      "388",
      "1 TB",
      "ok",
      "direct",
      if en { "Direct" } else { "直连" },
      "9 ms",
      en,
    ),
    fx_site_station(
      "ws1/st4",
      "st4",
      if en { "Server" } else { "服务器" },
      "glyph:rocket:teal",
      "AMD EPYC · 128 GB · Linux 6.12",
      if en { "1 running" } else { "1 个在运行" },
      "working",
      63,
      "4.8",
      55,
      "71.0",
      "128 GB",
      9,
      "1.4",
      "2 TB",
      "red",
      "relay",
      if en { "Relay" } else { "中继" },
      "46 ms",
      en,
    ),
  ]
}
