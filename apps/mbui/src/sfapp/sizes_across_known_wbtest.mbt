// What steps along a row in these tests (mbui's sizes_steady.mbt, `sizes_across`: a ground's left edge or width, where
// words start, in one frame, a speed off the frames round it, a dead stop, a turn back again soon), a file at a time: how
// many a Tester made in it may show, as they were found when the check came (2026-11-17). Each only falls: a jump
// mended takes its file's number down, and a file at 0 leaves the list.

///|
fn init {
  @ui.sizes_across_known([
    ("src/sfapp/board_wbtest.mbt", 1),
    ("src/sfapp/duo_wbtest.mbt", 14),
    ("src/sfapp/home_wbtest.mbt", 2),
    ("src/sfapp/newchat_crowded_wbtest.mbt", 2),
    ("src/sfapp/newchat_send_wbtest.mbt", 1),
    ("src/sfapp/open_whole_wbtest.mbt", 1),
    ("src/sfapp/press_waits_wbtest.mbt", 1),
    ("src/sfapp/preview_tree_wbtest.mbt", 1),
    ("src/sfapp/row_swipe_refused_wbtest.mbt", 1),
    ("src/sfapp/settings_wbtest.mbt", 3),
    ("src/sfapp/stations_now_wbtest.mbt", 5),
    ("src/sfapp/tape.mbt", 1),
    ("src/sfapp/tape_wbtest.mbt", 12),
    ("src/sfapp/whole_row_wbtest.mbt", 3),
    ("src/sfapp/desk_profile_wbtest.mbt", 1),
  ])
}
