///|
test "the one pulled over on the tape let go: over landing past its share on from its speed, or flung toward it; back flung away" {
  let s = @ui.move_stop_points(0.3)
  // (its way 250 over: a fifth of it, 50, short of tape_pull_far)
  assert_false(tape_goes_over(49.0 - s, 250.0, 300.0))
  assert_true(tape_goes_over(51.0 - s, 250.0, 300.0))
  assert_false(tape_goes_over(-49.0 + s, -250.0, -300.0))
  assert_true(tape_goes_over(-51.0 + s, -250.0, -300.0))
  // (its way 600 over: a fifth of it, 120, past tape_pull_far, so 72)
  assert_false(tape_goes_over(71.0 - s, 600.0, 300.0))
  assert_true(tape_goes_over(73.0 - s, 600.0, 300.0))
  assert_false(tape_goes_over(-71.0 + s, -600.0, -300.0))
  assert_true(tape_goes_over(-73.0 + s, -600.0, -300.0))
  // (let go still: as far as it was pulled alone)
  assert_false(tape_goes_over(71.0, 600.0, 0.0))
  assert_true(tape_goes_over(73.0, 600.0, 0.0))
  // (flung: faster than tape_fling, toward it over however short, away back however far)
  let f = @ui.move_stop_points((tape_fling - 1.0) / 1000.0)
  assert_false(tape_goes_over(70.0 - f, 400.0, tape_fling - 1.0))
  assert_true(tape_goes_over(70.0 - f, 400.0, tape_fling + 1.0))
  assert_false(tape_goes_over(-70.0 + f, -400.0, -tape_fling + 1.0))
  assert_true(tape_goes_over(-70.0 + f, -400.0, -tape_fling - 1.0))
  assert_false(tape_goes_over(200.0, 400.0, -tape_fling - 1.0))
  assert_false(tape_goes_over(-200.0, -400.0, tape_fling + 1.0))
}
