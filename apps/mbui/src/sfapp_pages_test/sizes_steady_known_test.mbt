// What changes size in these tests (mbui's sizes_steady.mbt), a file at a time: how many a Tester made in it may show.
// Each only falls: a jump mended takes its file's number down, and a file at 0 leaves the list.

///|
fn init {
  @ui.sizes_steady_known([
    ("src/sfapp_pages_test/desk_service_test.mbt", 1),
  ])
}
