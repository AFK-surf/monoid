///|
test "Android TV manual IP probe: probes host, enters pairing, and cancels cleanly on Escape" {
  let calls : Array[Made] = []
  let t = wide_tester(calls, mode="place-stations-devices")
  app.nav.replace(Place("stations"))
  t.run_for(@ui.move_most_ms)
  let (wx, wy) = t.find("Willow").unwrap()
  t.tap(wx, wy)
  t.run_for(@ui.move_most_ms)
  t.wheel(900.0, 500.0, 3000.0)
  t.run_for(@ui.move_most_ms)
  let (x, y) = t.find("添加设备").unwrap()
  t.tap(x, y)
  t.run_for(@ui.move_most_ms)
  t.click(MenuItem, label="安卓电视 / 盒子")
  t.run_for(@ui.move_most_ms)
  let (mx, my) = t.find_last("手动输入 IP").unwrap()
  t.tap(mx, my)
  t.run_for(@ui.move_most_ms)
  assert_true(t.find("探测设备") is Some(_))
  assert_eq(t.audit(), [])
  // Unreachable IP shows inline error
  t.type_text("192.168.1.99")
  t.frame()
  let (px, py) = t.find_last("探测设备").unwrap()
  t.tap(px, py)
  t.run_for(@ui.move_most_ms)
  assert_true(t.find("未在局域网内发现安卓电视或盒子") is Some(_))
  // Reachable IP probes and opens pairing panel
  t.click(TextField, label="例如 192.168.1.52 或 192.168.1.52:5555")
  t.frame()
  t.key(@ui.key_code_select_all)
  t.type_text("192.168.1.88")
  t.frame()
  let (px2, py2) = t.find_last("探测设备").unwrap()
  t.tap(px2, py2)
  t.run_for(@ui.move_most_ms)
  let probes = calls.iter().filter(fn(m) { m.name == "device.scan" && text(Some(m.params), "host") == "192.168.1.88" }).collect()
  assert_eq(probes.length(), 1)
  assert_true(t.find("与电视完成配对") is Some(_))
  // Closing pairing panel cancels active pairing session on station
  t.key(@ui.key_escape)
  t.run_for(@ui.move_most_ms)
  let cancels = calls.iter().filter(fn(m) { m.name == "device.pairCancel" }).collect()
  assert_eq(cancels.length(), 1)
  assert_eq(text(Some(cancels[0].params), "pairId"), "atv-pair-1")
}

///|
test "Android TV detail: re-pair / add protocol calls device.rebindPair" {
  let calls : Array[Made] = []
  let t = wide_tester(calls, mode="place-stations-devices")
  app.nav.replace(Place("stations"))
  t.run_for(@ui.move_most_ms)
  let (wx, wy) = t.find("Willow").unwrap()
  t.tap(wx, wy)
  t.run_for(@ui.move_most_ms)
  t.wheel(900.0, 500.0, 3000.0)
  t.run_for(@ui.move_most_ms)
  let (x, y) = t.find_last("影音室 Shield TV").unwrap()
  t.tap(x, y)
  t.run_for(@ui.move_most_ms)
  let (rx, ry) = t.find("补充 / 重配协议").unwrap()
  t.tap(rx, ry)
  t.run_for(@ui.move_most_ms)
  assert_eq(calls.iter().filter(fn(m) { m.name == "device.pairStart" }).count(), 1)
  let (sx1, sy1) = t.find_last("跳过此协议").unwrap()
  t.tap(sx1, sy1)
  t.run_for(@ui.move_most_ms)
  let (sx2, sy2) = t.find_last("跳过此协议").unwrap()
  t.tap(sx2, sy2)
  t.run_for(@ui.move_most_ms)
  let rebound = calls.iter().filter(fn(m) { m.name == "device.rebindPair" }).collect()
  assert_eq(rebound.length(), 1)
  assert_eq(text(Some(rebound[0].params), "device"), "4e5f60718293a4b5")
  assert_eq(text(Some(rebound[0].params), "pairId"), "atv-pair-1")
}

///|
test "小屏 1.3x: Android TV detail and scan panels pass audit without overflow or truncation" {
  let calls : Array[Made] = []
  let t = wide_tester(calls, mode="settings-stations-devices", w=390.0, h=844.0, platform=2)
  t.set_font_scale(1.3)
  app.nav.replace(Place("stations"))
  t.run_for(@ui.move_most_ms)
  t.wheel(195.0, 500.0, 2000.0)
  t.run_for(@ui.move_most_ms)
  let (x, y) = t.find("影音室 Shield TV").unwrap()
  t.tap(x, y)
  t.run_for(@ui.move_most_ms)
  assert_true(t.find("NVIDIA Shield TV") is Some(_))
  assert_true(t.find("补充 / 重配协议") is Some(_))
  assert_eq(t.audit(), [])
}
