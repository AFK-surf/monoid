///|
test "Android TV scan: dual-protocol candidate steps through Remote v2 hex PIN and wireless ADB PIN" {
  let calls : Array[Made] = []
  let t = wide_tester(calls, mode="place-stations-devices")
  app.nav.replace(Place("stations"))
  t.run_for(@ui.move_most_ms)
  let (wx, wy) = t.find("Willow").unwrap()
  t.tap(wx, wy)
  t.run_for(@ui.move_most_ms)
  t.wheel(900.0, 500.0, 3000.0)
  t.run_for(@ui.move_most_ms)
  let (x, y) = t.find("添加设备").unwrap()
  t.tap(x, y)
  t.run_for(@ui.move_most_ms)
  t.click(MenuItem, label="安卓电视 / 盒子")
  t.run_for(@ui.move_most_ms)
  let scans = calls.iter().filter(fn(m) { m.name == "device.scan" }).collect()
  assert_eq(scans.length(), 1)
  assert_eq(text(Some(scans[0].params), "kind"), "android_tv")
  assert_true(t.find("卧室 Google TV") is Some(_))
  assert_true(t.find("书房小米盒子") is Some(_))
  assert_true(t.find("已添加") is Some(_))
  assert_eq(t.audit(), [])
  let (cx, cy) = t.find("卧室 Google TV").unwrap()
  t.tap(cx, cy)
  t.run_for(@ui.move_most_ms)
  let starts = calls.iter().filter(fn(m) { m.name == "device.pairStart" }).collect()
  assert_eq(starts.length(), 1)
  assert_eq(text(Some(starts[0].params), "kind"), "android_tv")
  assert_true(t.find("与电视完成配对") is Some(_))
  assert_true(t.find("配对进度：1/2（Remote v2）") is Some(_))
  assert_eq(t.audit(), [])
  // Wrong 6-char PIN shows inline error without closing the panel
  t.type_text("000000")
  t.frame()
  let (nx, ny) = t.find_last("下一步").unwrap()
  t.tap(nx, ny)
  t.run_for(@ui.move_most_ms)
  assert_true(t.find("配对码不正确") is Some(_))
  assert_true(t.find("配对进度：1/2（Remote v2）") is Some(_))
  // Valid 6-char hex PIN advances to step 2 (wireless ADB)
  t.click(TextField, label="6 位配对码（如 A3F19C）")
  t.frame()
  t.key(@ui.key_code_select_all)
  t.type_text("A3F19C")
  t.frame()
  let (nx2, ny2) = t.find_last("下一步").unwrap()
  t.tap(nx2, ny2)
  t.run_for(@ui.move_most_ms)
  assert_true(t.find("配对进度：2/2（局域网 ADB）") is Some(_))
  assert_true(t.find("无线配对端口") is Some(_))
  assert_eq(t.audit(), [])
  // Wireless ADB pairing port is prefilled from mDNS; enter 6-digit code
  t.click(TextField, label="6 位数字配对码")
  t.frame()
  t.type_text("482910")
  t.frame()
  let (nx3, ny3) = t.find_last("下一步").unwrap()
  t.tap(nx3, ny3)
  t.run_for(@ui.move_most_ms)
  assert_true(t.find("给它起个名字") is Some(_))
  let (ax, ay) = t.find_last("添加设备").unwrap()
  t.tap(ax, ay)
  t.run_for(@ui.move_most_ms)
  let made = calls.iter().filter(fn(m) { m.name == "device.add" }).collect()
  assert_eq(made.length(), 1)
  assert_eq(text(Some(made[0].params), "kind"), "android_tv")
  assert_eq(text(Some(made[0].params), "name"), "卧室 Google TV")
  assert_eq(text(Some(made[0].params), "target"), "192.168.1.61")
  assert_eq(text(Some(made[0].params), "pairId"), "atv-pair-1")
  assert_eq(flag(Some(made[0].params), "paired"), true)
  assert_true(t.find("卧室 Google TV") is Some(_))
}

