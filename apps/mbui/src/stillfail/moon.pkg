import {
  "moonbitlang/core/string",
  "moonbitlang/core/json",
  "stillfail/core",
  "ui/host",
  "ui/hostapi",
  "ui/ui",
  "ui/view",
  "ui/svg",
  "ui/webpage",
  "ui/font",
  "stillfail/sfcore",
  "stillfail/sfbase",
  "stillfail/sfapp",
  "stillfail/sfpages",
  "ui/controls" @sf,
  "ui/wasmrt",
}

options(
  "is-main": true,
  targets: { "link_native.mbt": [ "native" ], "link_js.mbt": [ "js" ], "link_wasm.mbt": [ "wasm" ], "wasm_shell.mbt": [ "wasm" ], "reports_js_wbtest.mbt": [ "js" ] },
  "native-stub": [ "core_engine.m", "terminal_ghostty.c" ],
  link: {
    "js": { "format": "iife" },
    // (run by mbui's native shell, scripts/wasm-app.sh: what it calls of the program, wasm_shell.mbt)
    "wasm": { "exports": ["mbw_string", "mbw_bytes"], "export-memory-name": "memory" },
    "native": {
      "stub-cc-flags": "-fobjc-arc -O2 -Iout/core/ghostty-vt/include",
      "cc-link-flags": "-framework Cocoa -framework Metal -framework QuartzCore -framework CoreText -framework CoreGraphics -framework ImageIO -framework AVFoundation -framework CoreMedia -framework CoreVideo -framework WebKit -framework AuthenticationServices -framework SystemConfiguration -framework Security -framework LocalAuthentication -framework CoreFoundation -framework Foundation -weak_framework MetricKit -liconv out/core/aarch64-apple-darwin/libmbui_core.a out/core/aarch64-apple-darwin/libstillfail_shell.a out/core/aarch64-apple-darwin/libghostty-vt.a -Wl,-u,_sf_terminal_linked -Fout/core/hermes/Library/Frameworks/macosx -framework hermes -lc++ -Wl,-rpath,@executable_path/../../../../../../out/core/hermes/Library/Frameworks/macosx -Wl,-rpath,@executable_path/../Frameworks -Wl,-dead_strip",
    },
  },
)
