// Full byte-for-byte SSE conformance corpus generated from libs/base/src/wire/sse_made_test.mbt.

fn utf8_str_hex(h : String) -> String {
  let b = w_hex(h)
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

fn made(n : Int, hex_stream : String, want : Array[Event]) -> Unit {
  let stream = w_hex(hex_stream)
  let whole = fed(stream, [])
  debug_assert(evs_eq(whole, want), "made case " + n.to_string() + " whole")
  let one_cuts : Array[Int] = []
  if stream.length() > 1 {
    for i in 1..<stream.length() {
      one_cuts.push(i)
    }
  }
  debug_assert(evs_eq(fed(stream, one_cuts), want), "made case " + n.to_string() + " byte")
  if stream.length() > 1 {
    debug_assert(evs_eq(fed(stream, [stream.length() / 2]), want), "made case " + n.to_string() + " half")
  }
}

