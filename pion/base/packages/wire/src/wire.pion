// Pure stream framing (Carry, control hello_line, request head_line, reply_head), no transport.

import "base_codec"

pub fn utf8_decode_lossy(data : Bytes, ignore_bom : Bool = false) -> String {
  let n = data.length()
  let mut i = 0
  if ignore_bom && n >= 3 && data[0].to_int() == 0xEF && data[1].to_int() == 0xBB && data[2].to_int() == 0xBF {
    i = 3
  }
  let out = StringBuilder::new()
  while i < n {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      out.write_byte(b0 as Byte)
      i += 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 < n {
        let b1 = data[i + 1].to_int()
        if (b1 & 0xC0) == 0x80 {
          out.write_byte(b0 as Byte)
          out.write_byte(b1 as Byte)
          i += 2
          continue
        }
      }
      out.write_byte(0xEF as Byte)
      out.write_byte(0xBF as Byte)
      out.write_byte(0xBD as Byte)
      i += 1
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 1 < n {
        let b1 = data[i + 1].to_int()
        let valid_b1 = if b0 == 0xE0 {
          b1 >= 0xA0 && b1 <= 0xBF
        } else if b0 == 0xED {
          b1 >= 0x80 && b1 <= 0x9F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if valid_b1 {
          if i + 2 < n {
            let b2 = data[i + 2].to_int()
            if (b2 & 0xC0) == 0x80 {
              out.write_byte(b0 as Byte)
              out.write_byte(b1 as Byte)
              out.write_byte(b2 as Byte)
              i += 3
              continue
            }
          }
          out.write_byte(0xEF as Byte)
          out.write_byte(0xBF as Byte)
          out.write_byte(0xBD as Byte)
          i += 2
          continue
        }
      }
      out.write_byte(0xEF as Byte)
      out.write_byte(0xBF as Byte)
      out.write_byte(0xBD as Byte)
      i += 1
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 1 < n {
        let b1 = data[i + 1].to_int()
        let valid_b1 = if b0 == 0xF0 {
          b1 >= 0x90 && b1 <= 0xBF
        } else if b0 == 0xF4 {
          b1 >= 0x80 && b1 <= 0x8F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if valid_b1 {
          if i + 2 < n {
            let b2 = data[i + 2].to_int()
            if (b2 & 0xC0) == 0x80 {
              if i + 3 < n {
                let b3 = data[i + 3].to_int()
                if (b3 & 0xC0) == 0x80 {
                  out.write_byte(b0 as Byte)
                  out.write_byte(b1 as Byte)
                  out.write_byte(b2 as Byte)
                  out.write_byte(b3 as Byte)
                  i += 4
                  continue
                }
              }
              out.write_byte(0xEF as Byte)
              out.write_byte(0xBF as Byte)
              out.write_byte(0xBD as Byte)
              i += 3
              continue
            }
          }
          out.write_byte(0xEF as Byte)
          out.write_byte(0xBF as Byte)
          out.write_byte(0xBD as Byte)
          i += 2
          continue
        }
      }
      out.write_byte(0xEF as Byte)
      out.write_byte(0xBF as Byte)
      out.write_byte(0xBD as Byte)
      i += 1
    } else {
      out.write_byte(0xEF as Byte)
      out.write_byte(0xBF as Byte)
      out.write_byte(0xBD as Byte)
      i += 1
    }
  }
  out.to_string()
}

pub struct Carry {
  mut held : Bytes
}

pub fn Carry::new() -> Carry {
  Carry::{ held: Bytes::new(0) }
}

pub fn Carry::length(self : Carry) -> Int {
  self.held.length()
}

pub fn Carry::push(self : Carry, chunk : Bytes) -> Unit {
  if self.held.length() == 0 {
    self.held = chunk
  } else if chunk.length() > 0 {
    self.held = self.held.concat(chunk)
  }
}

pub fn Carry::line(self : Carry) -> Option[String] {
  let n = self.held.length()
  for i in 0..<n {
    if self.held[i].to_int() == 10 {
      let line = utf8_decode_lossy(self.held.slice(0, i))
      self.held = self.held.slice(i + 1, n)
      return Some(line)
    }
  }
  None
}

pub fn Carry::take(self : Carry) -> Bytes {
  let all = self.held
  self.held = Bytes::new(0)
  all
}

pub fn hello_line(
  credential : String,
  says : Array[(String, base_codec::Json)] = [],
  also : Array[(String, base_codec::Json)] = [],
  traceparent : String = "",
) -> String {
  let fields : Array[(String, base_codec::Json)] = [("credential", base_codec::json_str(credential))]
  for i in 0..<says.length() {
    let (k, v) = says[i]
    base_codec::json_obj_set(fields, k, v)
  }
  for i in 0..<also.length() {
    let (k, v) = also[i]
    base_codec::json_obj_set(fields, k, v)
  }
  if traceparent.length() > 0 {
    base_codec::json_obj_set(fields, "traceparent", base_codec::json_str(traceparent))
  }
  base_codec::json_stringify(base_codec::json_obj(fields)) + "\n"
}

pub fn head_line(
  method_name : String,
  path : String,
  headers : Array[(String, String)],
  more : Array[(String, base_codec::Json)] = [],
) -> String {
  let said : Array[(String, base_codec::Json)] = []
  for i in 0..<headers.length() {
    let (k, v) = headers[i]
    base_codec::json_obj_set(said, k, base_codec::json_str(v))
  }
  let fields : Array[(String, base_codec::Json)] = [
    ("method", base_codec::json_str(method_name)),
    ("path", base_codec::json_str(path)),
    ("headers", base_codec::json_obj(said)),
  ]
  for i in 0..<more.length() {
    let (k, v) = more[i]
    base_codec::json_obj_set(fields, k, v)
  }
  base_codec::json_stringify(base_codec::json_obj(fields)) + "\n"
}

pub enum Head {
  Head(Int, Array[(String, String)])
  Unreadable(String)
  NoStatus
}

pub fn reply_head(line : String) -> Head {
  let reply = match base_codec::json_parse(line) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(e) => return Head::Unreadable(e)
  }
  let fields = match reply {
    base_codec::Json::Obj(fs) => fs
    _ => return Head::NoStatus
  }
  let status = match base_codec::json_obj_get(fields, "status") {
    Some(base_codec::Json::Num(n, _)) => {
      let i = n.to_int()
      if i.to_double() == n && n >= 0.0 && n <= 65535.0 {
        i
      } else {
        return Head::NoStatus
      }
    }
    _ => return Head::NoStatus
  }
  let headers : Array[(String, String)] = []
  match base_codec::json_obj_get(fields, "headers") {
    Some(base_codec::Json::Obj(said)) => {
      for i in 0..<said.length() {
        let (k, v) = said[i]
        let vs = match v {
          base_codec::Json::Str(s) => s
          other => base_codec::json_stringify(other)
        }
        headers.push((k, vs))
      }
    }
    _ => ()
  }
  Head::Head(status, headers)
}
