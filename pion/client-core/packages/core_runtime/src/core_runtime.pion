// Real `core_api.h` runtime engine wiring `packages/core_abi/native/core_pion.c`
// directly to `sync::ClientCore` + `sync::CloudSync` + `shell_native::open`
// (real Rust `libstillfail_shell` SQLite WAL + Tokio async IO + HTTP/SSE/WS)
// on the dedicated core worker thread.

import "base_codec"
import "core_abi"
import "effect"
import "protocol"
import "shell"
import "shell_native"
import "sql"
import "store"
import "sync"
import "views"

extern "C" fn mb_core_emit(json : Ptr, len : Int64, bytes : Ptr, blen : Int64) -> Int
extern "C" fn pion_core_wall_now_ms() -> Int64
extern "C" fn pion_core_utc_offset_min(ms : Int64) -> Int
extern "C" fn pion_core_log_warn(msg : Ptr, len : Int64) -> Unit
extern "C" fn pion_core_dir_lock_try(dir : Ptr, dir_len : Int64) -> Int64
extern "C" fn pion_core_dir_lock_release(handle : Int64) -> Unit

struct AccountInfo {
  sub : String
  email : String
  name : String
  picture : String
  access : String
  refresh : String
  access_expires : Int64
  session : String
}

struct RuntimeSub {
  id : Int64
  topic : protocol::Topic
  keyed : Bool
  mut last_val : Option[base_codec::Json]
}

struct RuntimeSession {
  dir : String
  sh : shell::Shell
  mut db : sql::Sql
  core : sync::ClientCore
  refresh_coord : sync::AccountRefreshCoordinator
  accounts : Array[AccountInfo]
  prefs : Map[String, base_codec::Json]
  station_online : Map[String, Bool]
  runtime_subs : Array[RuntimeSub]
  kept_vals : Map[String, base_codec::Json]
  kept_topics : Map[String, protocol::Topic]
  kept_order : Array[String]
  md_stores : Map[String, store::MdStore]
  mesh_transports : Map[String, sync::MeshStationTransport]
  mut cloud : Option[sync::CloudSync]
  mut origin : String
  mut session_gen : Int64
  mut login_gen : Int64
  mut bearer_gen : Int64
  mut reconcile_requeue_pending : Bool
  mut device_conn_seq : Int64
  mut live_sync_enabled : Bool
  mut device_app : String
  mut device_locale : String
}

let g_session : Array[Option[RuntimeSession]] = [None]
let g_last_device_conn_seq : Array[Int64] = [0L]
let g_last_conn_seq_persist_err : Array[Option[String]] = [None]

fn log_runtime_warn(msg : String) -> Unit {
  let bs = msg.to_bytes()
  pion_core_log_warn(bytes_data_ptr(bs), bs.length().to_int64())
  let _ = bs.length()
}

fn bytes_to_str(b : Bytes) -> String {
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

fn ptr_to_string(p : Ptr, n : Int64) -> String {
  if ptr_is_null(p) || n <= 0.to_int64() {
    return ""
  }
  bytes_to_str(bytes_from_ptr(p, n.to_int()))
}

fn emit_wire(json_text : String, payload : Option[Bytes] = None) -> Unit {
  let jb = json_text.to_bytes()
  let jptr = bytes_data_ptr(jb)
  let jlen = jb.length().to_int64()
  match payload {
    Some(pb) => {
      let pptr = bytes_data_ptr(pb)
      let plen = pb.length().to_int64()
      let _ = mb_core_emit(jptr, jlen, pptr, plen)
      let _ = pb.length()
    }
    None => {
      let empty = Bytes::new(0)
      let _ = mb_core_emit(jptr, jlen, bytes_data_ptr(empty), 0.to_int64())
      let _ = empty.length()
    }
  }
  let _ = jb.length()
}

fn emit_fatal(reason : String) -> Unit {
  let frame = core_abi::make_fatal_frame(reason)
  emit_wire(frame.json, payload=frame.bytes)
}

fn offline_transport() -> sync::StationTransport {
  sync::StationTransport::{
    request_k: fn(
      _m : String,
      _p : String,
      _h : Array[(String, String)],
      _b : Bytes,
      k : (effect::Exit[sync::HttpReply]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Failed(effect::EffectError::Custom("offline")))
    },
    stream_k: fn(
      _p : String,
      _h : Array[(String, String)],
      _on_chunk : (Bytes) -> Unit,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Failed(effect::EffectError::Custom("offline")))
    },
  }
}

fn opt_str_param(params : base_codec::Json, key : String) -> Option[String] {
  match base_codec::json_get(params, key) {
    Some(base_codec::Json::Str(s)) => Some(s)
    _ => None
  }
}

fn effect_err_msg(e : effect::EffectError) -> String {
  match e {
    effect::EffectError::Custom(m) => m
    _ => "effect error"
  }
}

fn emit_core_event(ev : sync::CoreEvent) -> Unit {
  match ev {
    sync::CoreEvent::ConnectionChanged(st, state) => {
      let state_str = match state {
        sync::ConnectionState::Disconnected(_) => "disconnected"
        sync::ConnectionState::Connecting => "connecting"
        sync::ConnectionState::Connected => "connected"
        sync::ConnectionState::Reconnecting(_) => "reconnecting"
      }
      emit_wire(base_codec::json_stringify(base_codec::json_obj([
        ("event", base_codec::json_str("connection")),
        ("station", base_codec::json_str(st)),
        ("state", base_codec::json_str(state_str)),
      ])))
    }
    sync::CoreEvent::OutboxResolved(st, th, ck, server_n) => {
      emit_wire(base_codec::json_stringify(base_codec::json_obj([
        ("event", base_codec::json_str("outbox.resolved")),
        ("station", base_codec::json_str(st)),
        ("thread", base_codec::json_int(th)),
        ("clientKey", base_codec::json_str(ck)),
        ("n", base_codec::json_int(server_n)),
      ])))
    }
    sync::CoreEvent::EntryAdded(st, th, entry, ck) => {
      let ck_j = match ck {
        Some(k) => base_codec::json_str(k)
        None => base_codec::json_null()
      }
      emit_wire(base_codec::json_stringify(base_codec::json_obj([
        ("event", base_codec::json_str("entry")),
        ("station", base_codec::json_str(st)),
        ("thread", base_codec::json_int(th)),
        ("n", base_codec::json_int(entry.n)),
        ("text", base_codec::json_str(entry.text)),
        ("clientKey", ck_j),
      ])))
    }
    sync::CoreEvent::ChatsChanged(st, ids) => {
      let arr : Array[base_codec::Json] = []
      for i in 0..<ids.length() {
        arr.push(base_codec::json_str(ids[i]))
      }
      emit_wire(base_codec::json_stringify(base_codec::json_obj([
        ("event", base_codec::json_str("chats.changed")),
        ("station", base_codec::json_str(st)),
        ("chats", base_codec::json_arr(arr)),
      ])))
    }
    sync::CoreEvent::OverlayRolledBack(st, target, kind, code, recovery) => {
      emit_wire(base_codec::json_stringify(base_codec::json_obj([
        ("event", base_codec::json_str("overlay.rolledBack")),
        ("station", base_codec::json_str(st)),
        ("target", base_codec::json_str(target)),
        ("kind", base_codec::json_str(kind)),
        ("code", base_codec::json_str(code)),
        ("recovery", base_codec::json_str(recovery)),
      ])))
    }
    _ => ()
  }
}

fn emit_topic_refresh(
  sess : RuntimeSession,
  topic_name : String,
  changed_keys : Option[Array[(String, String)]] = None,
) -> Unit {
  let deltas = sess.core.refresh_topic_with_topics(topic_name)
  for i in 0..<deltas.length() {
    let (topic, ev) = deltas[i]
    let (dj, db) = sess.core.encode_sub_event(topic, ev)
    emit_wire(dj, payload=db)
  }
  for i in 0..<sess.runtime_subs.length() {
    let sub = sess.runtime_subs[i]
    if sub.topic.name != topic_name {
      continue
    }
    match evaluate_runtime_topic(sess, sub.id, sub.topic, changed_keys=changed_keys) {
      Some(protocol::CoreEvent::Value(_, new_val, _)) => {
        match sub.last_val {
          Some(prev_val) => {
            if !protocol::json_equal(prev_val, new_val) {
              sub.last_val = Some(new_val)
              if sub.keyed {
                let ops = protocol::diff_keyed(prev_val, new_val, protocol::spec_for_topic(topic_name))
                if ops.length() > 0 {
                  let (dj, db) = sess.core.encode_sub_event(sub.topic, protocol::CoreEvent::Delta(sub.id, ops, None, false))
                  emit_wire(dj, payload=db)
                }
              } else {
                let (vj, vb) = sess.core.encode_sub_event(sub.topic, protocol::CoreEvent::Value(sub.id, new_val, None))
                emit_wire(vj, payload=vb)
              }
            }
          }
          None => {
            sub.last_val = Some(new_val)
            let (vj, vb) = sess.core.encode_sub_event(sub.topic, protocol::CoreEvent::Value(sub.id, new_val, None))
            emit_wire(vj, payload=vb)
          }
        }
      }
      _ => ()
    }
  }
}

fn is_loopback_http_url(url : String) -> Bool {
  url.starts_with("http://127.0.0.1:") ||
  url.starts_with("http://127.0.0.1/") ||
  url.starts_with("http://localhost:") ||
  url.starts_with("http://localhost/") ||
  url.starts_with("http://[::1]:") ||
  url.starts_with("http://[::1]/")
}

fn accounts_file_lock_backoff_ms(attempt : Int) -> Int {
  if attempt <= 0 {
    10
  } else if attempt == 1 {
    20
  } else if attempt == 2 {
    40
  } else if attempt == 3 {
    80
  } else if attempt == 4 {
    160
  } else {
    250
  }
}

fn acquire_accounts_file_lock_retry_k(
  dir : String,
  attempt : Int,
  k : (Result[Int64, String]) -> Unit,
) -> Unit {
  let bs = dir.to_bytes()
  let fd = pion_core_dir_lock_try(bytes_data_ptr(bs), bs.length().to_int64())
  let _ = bs.length()
  if fd >= 0L {
    k(Ok(fd))
    return
  }
  if fd == -2L {
    k(Err("accounts lock file I/O error"))
    return
  }
  if attempt >= 16 {
    k(Err("accounts lock file busy timeout"))
    return
  }
  let delay = accounts_file_lock_backoff_ms(attempt)
  // timer: retry after a failure, with a backoff
  effect::sleep_k(delay, fn(sex : effect::Exit[Unit]) -> Unit {
    match sex {
      effect::Exit::Succeeded(_) => acquire_accounts_file_lock_retry_k(dir, attempt + 1, k)
      _ => k(Err("accounts lock acquire interrupted"))
    }
  })
}

fn drain_and_emit(sess : RuntimeSession) -> Option[Int64] {
  let captured_epoch = sess.core.account_epoch
  let next_due = sess.sh.turn()
  if sess.core.account_epoch != captured_epoch || sess.core.membership.is_unauthenticated() || sess.core.membership.is_session_invalidated() {
    sess.core.outbox.clear()
    return next_due
  }
  if sess.live_sync_enabled {
    let evs = sess.core.drain_frame()
    let mut refresh_chat = false
    let mut refresh_chats = false
    let mut refresh_stations = false
    let mut refresh_marks = false
    let mut refresh_lock = false
    let changed_chat_keys : Array[(String, String)] = []
    let mut all_chats_dirty = false
    for i in 0..<evs.length() {
      if sess.core.account_epoch != captured_epoch || sess.core.membership.is_unauthenticated() || sess.core.membership.is_session_invalidated() {
        break
      }
      match evs[i] {
        sync::CoreEvent::ConnectionChanged(st, state) => {
          let connected = match state {
            sync::ConnectionState::Connected => true
            _ => false
          }
          sess.station_online.set(st, connected)
          all_chats_dirty = true
          refresh_chats = true
          refresh_chat = true
          refresh_stations = true
          refresh_marks = true
        }
        sync::CoreEvent::EntryAdded(st, th, _, _) | sync::CoreEvent::OutboxResolved(st, th, _, _) => {
          refresh_chat = true
          refresh_chats = true
          refresh_marks = true
          match store::get_chat_by_thread(sess.db, st, th) {
            sql::SqlResult::Ok(Some(rec)) => changed_chat_keys.push((st, rec.id))
            _ => { all_chats_dirty = true }
          }
        }
        sync::CoreEvent::ChatsChanged(st, ids) => {
          refresh_chats = true
          refresh_marks = true
          if ids.length() == 0 {
            all_chats_dirty = true
          } else {
            for k in 0..<ids.length() {
              changed_chat_keys.push((st, ids[k]))
            }
          }
        }
        sync::CoreEvent::ThreadReadChanged(st, th, _, _) => {
          refresh_chats = true
          refresh_marks = true
          match store::get_chat_by_thread(sess.db, st, th) {
            sql::SqlResult::Ok(Some(rec)) => changed_chat_keys.push((st, rec.id))
            _ => { all_chats_dirty = true }
          }
        }
        sync::CoreEvent::LockUpdated(_, _, _, _) => {
          refresh_lock = true
        }
        _ => ()
      }
      emit_core_event(evs[i])
    }
    if refresh_chat {
      emit_topic_refresh(sess, "chat")
      emit_topic_refresh(sess, "chatOutline")
    }
    if refresh_chats {
      let ck_opt : Option[Array[(String, String)]] = if all_chats_dirty || changed_chat_keys.length() == 0 {
        None
      } else {
        Some(changed_chat_keys)
      }
      emit_topic_refresh(sess, "chats", changed_keys=ck_opt)
    }
    if refresh_stations {
      emit_topic_refresh(sess, "stations")
      emit_topic_refresh(sess, "settings")
    }
    if refresh_marks {
      emit_topic_refresh(sess, "workspaceMarks")
    }
    if refresh_lock {
      emit_topic_refresh(sess, "lock")
      emit_topic_refresh(sess, "vaults")
    }
    flush_session_md_stores(sess)
  }
  next_due
}

/// Native event-driven wake callback registered via `mb_core_register_wake`:
/// non-blockingly drains `shell_native` completions, advances `effect::Runtime` ready fibers/timers,
/// emits live `FrameOutbox` deltas, and returns the relative delay in ms until the next timer (`-1` if none).
pub extern "C" fn pion_core_runtime_on_wake() -> Int64 {
  match g_session[0] {
    None => (-1).to_int64()
    Some(sess) => {
      let next_due = drain_and_emit(sess)
      match next_due {
        None => (-1).to_int64()
        Some(due_ms) => {
          let rem = due_ms - sess.sh.rt.now()
          if rem <= 0.to_int64() { 0.to_int64() } else { rem }
        }
      }
    }
  }
}

fn flush_session_md_stores(sess : RuntimeSession) -> Unit {
  let _ = sess.core.md_store.flush_turn()
  let ks = sess.md_stores.keys()
  for i in 0..<ks.length() {
    match sess.md_stores.get(ks[i]) {
      Some(ms) => { let _ = ms.flush_turn() }
      None => ()
    }
  }
}

fn runtime_kept_key(topic : protocol::Topic, tok : String) -> String {
  protocol::topic_key(topic) + "\u{01}" + tok
}

fn kept_put(sess : RuntimeSession, tok : String, topic : protocol::Topic, v : base_codec::Json) -> Unit {
  let k = runtime_kept_key(topic, tok)
  let existed = sess.kept_vals.get(k).is_some()
  sess.kept_vals.set(k, v)
  sess.kept_topics.set(k, topic)
  if !existed {
    sess.kept_order.push(k)
    while sess.kept_vals.length() > 64 && sess.kept_order.length() > 0 {
      let oldest = sess.kept_order[0]
      let next_ord : Array[String] = []
      for i in 1..<sess.kept_order.length() {
        next_ord.push(sess.kept_order[i])
      }
      sess.kept_order.clear()
      for i in 0..<next_ord.length() {
        sess.kept_order.push(next_ord[i])
      }
      sess.kept_vals.remove(oldest)
      sess.kept_topics.remove(oldest)
    }
  }
}

fn kept_purge_where(sess : RuntimeSession, pred : (protocol::Topic) -> Bool) -> Unit {
  let next_ord : Array[String] = []
  for i in 0..<sess.kept_order.length() {
    let k = sess.kept_order[i]
    let drop = match sess.kept_topics.get(k) {
      Some(t) => pred(t)
      None => true
    }
    if drop {
      sess.kept_vals.remove(k)
      sess.kept_topics.remove(k)
    } else {
      next_ord.push(k)
    }
  }
  sess.kept_order.clear()
  for i in 0..<next_ord.length() {
    sess.kept_order.push(next_ord[i])
  }
}

fn handle_runtime_auth_boundary(sess : RuntimeSession, ev : sync::AuthBoundaryEvent) -> Unit {
  kept_purge_where(sess, fn(t : protocol::Topic) -> Bool {
    sess.core.auth.matches_topic(t, ev)
  })
  for i in 0..<sess.runtime_subs.length() {
    let sub = sess.runtime_subs[i]
    if sess.core.auth.matches_topic(sub.topic, ev) {
      sub.last_val = None
      match evaluate_runtime_topic(sess, sub.id, sub.topic) {
        Some(sev) => {
          match sev {
            protocol::CoreEvent::Value(_, new_val, _) => {
              sub.last_val = Some(new_val)
            }
            _ => ()
          }
          let (j, b) = sess.core.encode_sub_event(sub.topic, sev)
          emit_wire(j, payload=b)
        }
        None => ()
      }
    }
  }
}

fn remove_runtime_sub(sess : RuntimeSession, id : Int64) -> Option[RuntimeSub] {
  let mut found_idx = -1
  for i in 0..<sess.runtime_subs.length() {
    if sess.runtime_subs[i].id == id {
      found_idx = i
      break
    }
  }
  if found_idx < 0 {
    return None
  }
  let removed = sess.runtime_subs[found_idx]
  let next_subs : Array[RuntimeSub] = []
  for i in 0..<sess.runtime_subs.length() {
    if i != found_idx {
      next_subs.push(sess.runtime_subs[i])
    }
  }
  sess.runtime_subs.clear()
  for i in 0..<next_subs.length() {
    sess.runtime_subs.push(next_subs[i])
  }
  Some(removed)
}

fn hex_digit(n : Int) -> String {
  let chars = "0123456789abcdef"
  chars.slice(n, n + 1)
}

/// Match `client/core-ts/src/data.ts` `dbName(sub)`: `"account-"` + UTF-8 bytes
/// keeping `[A-Za-z0-9-]` and escaping others as `_xx`.
fn encode_account_db_name(sub : String) -> String {
  let bs = sub.to_bytes()
  let sb = StringBuilder::new()
  sb.write_string("account-")
  for i in 0..<bs.length() {
    let b = bs[i].to_int()
    let ok = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45
    if ok {
      sb.write_byte(bs[i])
    } else {
      sb.write_string("_")
      sb.write_string(hex_digit((b / 16) % 16))
      sb.write_string(hex_digit(b % 16))
    }
  }
  sb.to_string()
}

enum StorageRead {
  Found(base_codec::Json)
  Absent
  ReadError(String)
}

/// Read one JSON document from host storage (`storage.get`) synchronously during startup,
/// strictly distinguishing confirmed `Absent` (`{"none": true}`), valid `Found(Json)`, and
/// `ReadError` (I/O failure, timeout, empty payload, or corrupt JSON) so callers never
/// overwrite unreadable/damaged device records (such as TS `device/auth` `capRev:*` entries).
fn read_storage_json_state(sh : shell::Shell, key : String) -> StorageRead {
  let done_flag : Array[Bool] = [false]
  let raw_out : Array[Option[Bytes]] = [None]
  let none_out : Array[Bool] = [false]
  let err_out : Array[Option[String]] = [None]
  let _ = sh.rt.fork_quiet_named("startup:storage.get", fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    sh.call_k(
      "storage.get",
      base_codec::json_obj([("key", base_codec::json_str(key))]),
      fn(ex : effect::Exit[shell::Answer]) -> Unit {
        match ex {
          effect::Exit::Succeeded(ans) => {
            match base_codec::json_get(ans.json, "none") {
              Some(base_codec::Json::Bool(true)) => { none_out[0] = true }
              _ => { raw_out[0] = ans.bytes }
            }
          }
          effect::Exit::Failed(e) => { err_out[0] = Some("storage.get failed for " + key + ": " + effect_err_msg(e)) }
          effect::Exit::Interrupted => { err_out[0] = Some("storage.get interrupted for " + key) }
        }
        done_flag[0] = true
        fk(effect::Exit::Succeeded(()))
      },
    )
  })
  let _ = shell_native::drain_until(sh, fn() -> Bool { done_flag[0] }, timeout_ms=2000.to_int64())
  if !done_flag[0] {
    return StorageRead::ReadError("storage.get timed out for " + key)
  }
  match err_out[0] {
    Some(msg) => return StorageRead::ReadError(msg)
    None => ()
  }
  if none_out[0] {
    return StorageRead::Absent
  }
  match raw_out[0] {
    Some(bs) => {
      if bs.length() == 0 {
        return StorageRead::ReadError("empty storage payload for " + key)
      }
      match base_codec::json_parse(bytes_to_str(bs)) {
        base_codec::JsonParseResult::Ok(j) => StorageRead::Found(j)
        base_codec::JsonParseResult::Err(e) => StorageRead::ReadError("corrupt storage json for " + key + ": " + e)
      }
    }
    None => StorageRead::ReadError("storage.get returned neither bytes nor none for " + key)
  }
}

/// Read one JSON document from host storage (`storage.get`) synchronously during startup.
fn read_storage_json(sh : shell::Shell, key : String) -> Option[base_codec::Json] {
  match read_storage_json_state(sh, key) {
    StorageRead::Found(j) => Some(j)
    _ => None
  }
}

/// Write one JSON document to host storage (`storage.set`) synchronously, propagating errors.
fn write_storage_json(sh : shell::Shell, key : String, doc : base_codec::Json) -> Result[Unit, String] {
  let done_flag : Array[Bool] = [false]
  let err_out : Array[Option[String]] = [None]
  let payload = base_codec::json_stringify(doc).to_bytes()
  let _ = sh.rt.fork_quiet_named("prefs:storage.set", fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    sh.call_k(
      "storage.set",
      base_codec::json_obj([("key", base_codec::json_str(key))]),
      bytes=Some(payload),
      fn(ex : effect::Exit[shell::Answer]) -> Unit {
        match ex {
          effect::Exit::Succeeded(_) => ()
          effect::Exit::Failed(_) => { err_out[0] = Some("storage.set failed for key: " + key) }
          effect::Exit::Interrupted => { err_out[0] = Some("storage.set interrupted") }
        }
        done_flag[0] = true
        fk(effect::Exit::Succeeded(()))
      },
    )
  })
  let _ = shell_native::drain_until(sh, fn() -> Bool { done_flag[0] }, timeout_ms=2000.to_int64())
  if !done_flag[0] {
    return Err("storage.set timed out for key: " + key)
  }
  match err_out[0] {
    Some(msg) => Err(msg)
    None => Ok(())
  }
}

/// Pure non-blocking async read of one JSON document from host storage (`storage.get`),
/// NEVER pumping `shell_native::drain_until`.
fn read_storage_json_state_k(
  sh : shell::Shell,
  key : String,
  k : (sync::HostStorageRead) -> Unit,
) -> Unit {
  sh.call_k(
    "storage.get",
    base_codec::json_obj([("key", base_codec::json_str(key))]),
    fn(ex : effect::Exit[shell::Answer]) -> Unit {
      match ex {
        effect::Exit::Succeeded(ans) => {
          match base_codec::json_get(ans.json, "none") {
            Some(base_codec::Json::Bool(true)) => k(sync::HostStorageRead::Absent)
            _ => match ans.bytes {
              Some(bs) => {
                if bs.length() == 0 {
                  k(sync::HostStorageRead::ReadError("empty storage payload for " + key))
                } else {
                  match base_codec::json_parse(bytes_to_str(bs)) {
                    base_codec::JsonParseResult::Ok(j) => k(sync::HostStorageRead::Found(j))
                    base_codec::JsonParseResult::Err(e) => k(sync::HostStorageRead::ReadError("corrupt storage json for " + key + ": " + e))
                  }
                }
              }
              None => k(sync::HostStorageRead::ReadError("storage.get returned neither bytes nor none for " + key))
            }
          }
        }
        effect::Exit::Failed(e) => k(sync::HostStorageRead::ReadError("storage.get failed for " + key + ": " + effect_err_msg(e)))
        effect::Exit::Interrupted => k(sync::HostStorageRead::ReadError("storage.get interrupted for " + key))
      }
    },
  )
}

/// Pure non-blocking async write of one JSON document to host storage (`storage.set`),
/// NEVER pumping `shell_native::drain_until`.
fn write_storage_json_k(
  sh : shell::Shell,
  key : String,
  doc : base_codec::Json,
  k : (Result[Unit, String]) -> Unit,
) -> Unit {
  let payload = base_codec::json_stringify(doc).to_bytes()
  sh.call_k(
    "storage.set",
    base_codec::json_obj([("key", base_codec::json_str(key))]),
    bytes=Some(payload),
    fn(ex : effect::Exit[shell::Answer]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => k(Ok(()))
        effect::Exit::Failed(e) => k(Err("storage.set failed for key " + key + ": " + effect_err_msg(e)))
        effect::Exit::Interrupted => k(Err("storage.set interrupted for key " + key))
      }
    },
  )
}

/// Open and run all required schema migrations / covering indexes on an account DB (`:memory:` or `account-<sub>`).
fn open_and_migrate_account_db(sh : shell::Shell, db_name : String) -> Result[sql::Sql, String] {
  let acct = match store::open_account_db(sh, db_name) {
    sql::SqlResult::Ok(a) => a
    sql::SqlResult::Err(e) => return Err("open_account_db failed: " + e.to_string())
  }
  match store::ensure_md_kept(acct.db) {
    sql::SqlResult::Ok(_) => ()
    sql::SqlResult::Err(e) => {
      acct.db.close()
      return Err("ensure_md_kept failed: " + e.to_string())
    }
  }
  match store::ensure_kept(acct.db) {
    sql::SqlResult::Ok(_) => ()
    sql::SqlResult::Err(e) => {
      acct.db.close()
      return Err("ensure_kept failed: " + e.to_string())
    }
  }
  match store::ensure_moved(acct.db) {
    sql::SqlResult::Ok(_) => ()
    sql::SqlResult::Err(e) => {
      acct.db.close()
      return Err("ensure_moved failed: " + e.to_string())
    }
  }
  // Ensure derived `chat` columns (`hidden`, `led`, `watched`) and covering `chat_recent` index exist.
  match acct.db.all("PRAGMA table_info(chat)") {
    sql::SqlResult::Ok(cols) => {
      let mut has_hidden = false
      let mut has_led = false
      let mut has_watched = false
      for i in 0..<cols.length() {
        let cname = sql::col_text(cols[i], 1)
        if cname == "hidden" {
          has_hidden = true
        } else if cname == "led" {
          has_led = true
        } else if cname == "watched" {
          has_watched = true
        }
      }
      if !has_hidden {
        let _ = acct.db.exec("ALTER TABLE chat ADD COLUMN hidden INTEGER NOT NULL DEFAULT 0")
      }
      if !has_led {
        let _ = acct.db.exec("ALTER TABLE chat ADD COLUMN led INTEGER NOT NULL DEFAULT 0")
      }
      if !has_watched {
        let _ = acct.db.exec("ALTER TABLE chat ADD COLUMN watched INTEGER NOT NULL DEFAULT 0")
      }
      match acct.db.all("SELECT sql FROM sqlite_master WHERE type = 'index' AND name = 'chat_recent'") {
        sql::SqlResult::Ok(idx_rows) => {
          if idx_rows.length() > 0 {
            let idx_sql = sql::col_text(idx_rows[0], 0)
            if !idx_sql.contains("WHERE archived = 0") {
              let _ = acct.db.exec("DROP INDEX chat_recent")
            }
          }
        }
        sql::SqlResult::Err(_) => ()
      }
      let _ = acct.db.exec(
        "CREATE INDEX IF NOT EXISTS chat_recent ON chat (archived, pinned_at DESC, last_active DESC, station, ord, id, mine, hidden, led, watched, thread, session) WHERE archived = 0;\n" +
        "CREATE INDEX IF NOT EXISTS chat_client ON chat (station, client_key) WHERE client_key IS NOT NULL;\n" +
        "CREATE INDEX IF NOT EXISTS chat_marks ON chat (station, archived, id, tone, asks) WHERE archived = 0 AND (tone IS NOT NULL OR asks = 1);\n" +
        "DROP INDEX IF EXISTS chat_marked;"
      )
    }
    sql::SqlResult::Err(_) => ()
  }
  Ok(acct.db)
}

fn sync_mem_accounts_from_list(
  sess : RuntimeSession,
  list : Array[views::StoredAccount],
  sessions : Map[String, String],
) -> Unit {
  // Clone inputs BEFORE clearing live containers so passing `sess.core.auth_store.accounts`
  // or `sess.core.account_sessions` directly can NEVER alias and wipe them!
  let list_copy : Array[views::StoredAccount] = []
  for i in 0..<list.length() {
    list_copy.push(list[i])
  }
  let sessions_copy : Map[String, String] = Map::new()
  let sks = sessions.keys()
  for i in 0..<sks.length() {
    match sessions.get(sks[i]) {
      Some(v) => sessions_copy.set(sks[i], v)
      None => ()
    }
  }
  sess.core.auth_store.accounts.clear()
  sess.core.account_sessions.clear()
  sess.accounts.clear()
  for i in 0..<list_copy.length() {
    let a = list_copy[i]
    let sid = match sessions_copy.get(a.sub) { Some(s) => s; None => "" }
    if sid.length() > 0 {
      sess.core.account_sessions.set(a.sub, sid)
    }
    sess.core.auth_store.register_account(a)
    sess.accounts.push(AccountInfo::{
      sub: a.sub,
      email: a.email,
      name: a.name,
      picture: a.picture,
      access: a.access,
      refresh: a.refresh,
      access_expires: a.access_expires,
      session: sid,
    })
  }
}

struct StagedAccountDb {
  new_db : sql::Sql
  host_purges_read : sync::HostStorageRead
  host_purges_shared : Bool
  person_lock_opt : Option[base_codec::Json]
}

fn close_staged_db(staged_opt : Option[StagedAccountDb]) -> Unit {
  match staged_opt {
    Some(st) => st.new_db.close()
    None => ()
  }
}

fn clear_runtime_ephemeral_caches(sess : RuntimeSession) -> Unit {
  let mkeys = sess.mesh_transports.keys()
  for i in 0..<mkeys.length() {
    match sess.mesh_transports.get(mkeys[i]) {
      Some(ctrl) => ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit {})
      None => ()
    }
  }
  sess.mesh_transports.clear()
  let mdks = sess.md_stores.keys()
  for i in 0..<mdks.length() {
    match sess.md_stores.get(mdks[i]) {
      Some(ms) => ms.clear()
      None => ()
    }
  }
  sess.md_stores.clear()
  sess.station_online.clear()
  kept_purge_where(sess, fn(_ : protocol::Topic) -> Bool { true })
  for i in 0..<sess.runtime_subs.length() {
    sess.runtime_subs[i].last_val = None
  }
}

/// Stage candidate `account-<sanitized_sub>.db` (open + migrate) and asynchronously load host
/// `device/pending_purges/<sanitized_sub>` + `person_lock` BEFORE writing `accounts` to disk!
/// If opening or migrating the DB fails, returns `Err` with 0 disk writes to `accounts`.
fn runtime_stage_account_db_k(
  sess : RuntimeSession,
  subject : String,
  k : (Result[Option[StagedAccountDb], String]) -> Unit,
) -> Unit {
  if subject.length() == 0 {
    k(Err("account_sub_mismatch: empty subject"))
    return
  }
  match sess.core.db_account_sub {
    Some(existing) => {
      if existing != subject {
        k(Err("account_sub_mismatch: expected " + existing + ", got " + subject))
      } else {
        k(Ok(None))
      }
      return
    }
    None => ()
  }
  let db_name = encode_account_db_name(subject)
  let new_db = match open_and_migrate_account_db(sess.sh, db_name) {
    Ok(d) => d
    Err(e) => {
      k(Err(e))
      return
    }
  }
  let sub_host_key = sync::host_pending_purges_key_for_sub(subject)
  let finish_with_purges = fn(host_purges_read : sync::HostStorageRead, is_shared : Bool) -> Unit {
    read_storage_json_state_k(sess.sh, sync::person_lock_storage_key(subject), fn(prd : sync::HostStorageRead) -> Unit {
      let person_lock_opt = match prd {
        sync::HostStorageRead::Found(pj) => Some(pj)
        _ => None
      }
      k(Ok(Some(StagedAccountDb::{
        new_db: new_db,
        host_purges_read: host_purges_read,
        host_purges_shared: is_shared,
        person_lock_opt: person_lock_opt,
      })))
    })
  }
  read_storage_json_state_k(sess.sh, sub_host_key, fn(rd : sync::HostStorageRead) -> Unit {
    match rd {
      sync::HostStorageRead::Found(j) => finish_with_purges(sync::HostStorageRead::Found(j), false)
      sync::HostStorageRead::Absent => {
        read_storage_json_state_k(sess.sh, sync::HOST_PENDING_PURGES_KEY, fn(srd : sync::HostStorageRead) -> Unit {
          match srd {
            sync::HostStorageRead::Found(sj) => finish_with_purges(sync::HostStorageRead::Found(sj), true)
            sync::HostStorageRead::Absent => finish_with_purges(sync::HostStorageRead::Absent, false)
            sync::HostStorageRead::ReadError(reason) => {
              log_runtime_warn("shared pending purges unreadable (" + reason + "); falling back to SQLite meta")
              finish_with_purges(sync::HostStorageRead::ReadError(reason), true)
            }
          }
        })
      }
      sync::HostStorageRead::ReadError(reason) => {
        log_runtime_warn("per-account pending purges unreadable (" + reason + "); falling back to SQLite meta")
        finish_with_purges(sync::HostStorageRead::ReadError(reason), false)
      }
    }
  })
}

/// Atomically install an already-staged `StagedAccountDb` into `sess` & `sess.core` WITHOUT
/// firing the auth boundary yet (caller installs `sess.cloud`, `auth_store`, and `viewer` first,
/// then calls `sess.core.auth.bump_all()` as the very last step!).
fn runtime_install_staged_db_now(
  sess : RuntimeSession,
  subject : String,
  staged_opt : Option[StagedAccountDb],
) -> Result[Unit, String] {
  match staged_opt {
    None => {
      match sess.core.db_account_sub {
        Some(existing) => if existing != subject {
          return Err("account_sub_mismatch: expected " + existing + ", got " + subject)
        }
        None => return Err("account_sub_unbound: staged db missing")
      }
      sess.core.membership.set_unauthenticated(false)
      sess.core.membership.clear_session_invalidated()
      Ok(())
    }
    Some(st) => {
      let new_db = st.new_db
      let _ = store::put_account_doc(new_db, "conn_seq", sess.device_conn_seq.to_string())
      match store::get_device_prefs(new_db) {
        sql::SqlResult::Ok(base_codec::Json::Obj(existing_fs)) => {
          if existing_fs.length() == 0 && sess.prefs.keys().length() > 0 {
            let seed_pairs : Array[(String, base_codec::Json)] = []
            let pks = sess.prefs.keys()
            for i in 0..<pks.length() {
              match sess.prefs.get(pks[i]) {
                Some(v) => seed_pairs.push((pks[i], v))
                None => ()
              }
            }
            let _ = store::put_account_doc(new_db, "prefs", base_codec::json_stringify(base_codec::json_obj(seed_pairs)))
          }
        }
        _ => ()
      }
      match store::get_device_prefs(new_db) {
        sql::SqlResult::Ok(pj) => match base_codec::json_get(pj, "lang") {
          Some(base_codec::Json::Str(s)) => { sess.core.lang = if s == "en" { "en" } else { "zh" } }
          _ => ()
        }
        _ => ()
      }
      clear_runtime_ephemeral_caches(sess)
      let old_db = sess.db
      match sess.core.switch_account_db(
        new_db,
        subject,
        host_purges_shared=st.host_purges_shared,
        host_purges_read=Some(st.host_purges_read),
        emit_auth_boundary=false,
      ) {
        Err(e) => {
          new_db.close()
          return Err(e)
        }
        Ok(_) => ()
      }
      sess.db = new_db
      match sess.cloud {
        Some(cs) => cs.switch_db(new_db)
        None => ()
      }
      match st.person_lock_opt {
        Some(pjson) => { let _ = sess.core.load_person_lock_json(pjson, subject) }
        None => ()
      }
      if sess.core.workspace == "ws-default" {
        match store::list_workspaces(new_db) {
          sql::SqlResult::Ok(ws_rows) => {
            if ws_rows.length() > 0 {
              sess.core.switch_workspace(ws_rows[0].id)
            }
          }
          sql::SqlResult::Err(_) => ()
        }
      }
      old_db.close()
      Ok(())
    }
  }
}

/// Immediately tear down the signed-in account context and switch ALL runtime + core DB holders
/// back to a fresh unauthenticated `:memory:` DB (used when permanent 401 refresh removes the last
/// account). Ensures 0 cached data or outbound frame leakage without waiting for process restart,
/// and allows a fresh same-process `auth.complete` sign-in with any account afterwards.
fn runtime_switch_to_unauth_memory_db(sess : RuntimeSession) -> Unit {
  sess.login_gen += 1L
  let _ = bump_runtime_session_gen(sess)
  sess.bearer_gen += 1L
  match sess.cloud {
    Some(cs) => {
      cs.clear_all_credentials()
      cs.clear_token()
      cs.stop()
    }
    None => ()
  }
  sess.cloud = None
  sess.live_sync_enabled = false
  clear_runtime_ephemeral_caches(sess)

  let old_db = sess.db
  match open_and_migrate_account_db(sess.sh, ":memory:") {
    Ok(new_mem_db) => {
      let _ = store::put_account_doc(new_mem_db, "conn_seq", sess.device_conn_seq.to_string())
      sess.core.switch_to_unauthenticated_db(new_mem_db)
      sess.db = new_mem_db
      old_db.close()
    }
    Err(_) => {
      // Fail-closed even if `:memory:` open unexpectedly fails: keep session invalidated + unauthenticated!
      sess.core.clear_account_scoped_runtime_state()
      sess.core.db_account_sub = None
      sess.core.membership.set_unauthenticated(true)
      sess.core.membership.mark_session_invalidated()
      let _ = sess.core.auth.bump_all()
    }
  }
}

fn parse_stored_accounts(raw : base_codec::Json) -> Array[AccountInfo] {
  let out : Array[AccountInfo] = []
  let sessions = sync::parse_stored_account_sessions(raw)
  match sync::parse_stored_accounts_strict(raw) {
    Some(strict_list) => {
      for i in 0..<strict_list.length() {
        let a = strict_list[i]
        let sid = match sessions.get(a.sub) { Some(s) => s; None => "" }
        out.push(AccountInfo::{
          sub: a.sub,
          email: a.email,
          name: a.name,
          picture: a.picture,
          access: a.access,
          refresh: a.refresh,
          access_expires: a.access_expires,
          session: sid,
        })
      }
      return out
    }
    None => ()
  }
  match raw {
    base_codec::Json::Arr(xs) => {
      for i in 0..<xs.length() {
        let a = xs[i]
        let sub = match opt_str_param(a, "sub") {
          Some(s) => s
          None => match opt_str_param(a, "id") {
            Some(s) => s
            None => ""
          }
        }
        if sub.length() == 0 {
          continue
        }
        let email = match opt_str_param(a, "email") { Some(s) => s; None => "" }
        let name = match opt_str_param(a, "name") { Some(s) => s; None => email }
        let picture = match opt_str_param(a, "picture") { Some(s) => s; None => "" }
        let access = match opt_str_param(a, "access") { Some(s) => s; None => "" }
        let refresh = match opt_str_param(a, "refresh") { Some(s) => s; None => "" }
        let exp : Int64 = match base_codec::json_get(a, "access_expires") {
          Some(base_codec::Json::Num(n, repr)) => if repr.length() > 0 && !repr.contains(".") {
            match base_codec::parse_int64_str(repr) { Some(v) => v; None => n.to_int64() }
          } else { n.to_int64() }
          _ => 0L
        }
        let sid = match opt_str_param(a, "session") { Some(s) => s; None => "" }
        out.push(AccountInfo::{
          sub: sub,
          email: email,
          name: name,
          picture: picture,
          access: access,
          refresh: refresh,
          access_expires: exp,
          session: sid,
        })
      }
    }
    _ => ()
  }
  out
}

/// Convert runtime `StorageRead` to `sync::HostStorageRead` preserving strict `Absent` vs `ReadError`.
fn to_host_storage_read(sr : StorageRead) -> sync::HostStorageRead {
  match sr {
    StorageRead::Found(j) => sync::HostStorageRead::Found(j)
    StorageRead::Absent => sync::HostStorageRead::Absent
    StorageRead::ReadError(m) => sync::HostStorageRead::ReadError(m)
  }
}

fn strip_trailing_slash_rt(s : String) -> String {
  let mut end = s.length()
  while end > 0 && s.slice(end - 1, end) == "/" {
    end -= 1
  }
  s.slice(0, end)
}

fn bump_runtime_session_gen(sess : RuntimeSession) -> Int64 {
  sess.session_gen += 1L
  match sess.cloud {
    Some(cs) => { let _ = cs.bump_session_gen() }
    None => ()
  }
  sess.session_gen
}

/// Fail-open coalesced re-reconcile when a live Cloud commit hits `reentrant_membership_commit`
/// so membership updates are NEVER silently dropped.
fn schedule_deferred_me_reconcile(sess : RuntimeSession, cs : sync::CloudSync) -> Unit {
  if sess.reconcile_requeue_pending || sess.core.membership.is_unauthenticated() || sess.core.membership.is_session_invalidated() {
    return
  }
  sess.reconcile_requeue_pending = true
  let req_gen = sess.session_gen
  let _ = sess.core.rt.fork_quiet_named("requeue-me-reconcile", fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    sess.reconcile_requeue_pending = false
    if sess.session_gen == req_gen && !sess.core.membership.is_unauthenticated() && !sess.core.membership.is_session_invalidated() {
      cs.trigger_me_reconcile()
    }
    fk(effect::Exit::Succeeded(()))
  })
}

/// Bind and wire production commit hooks + dynamic `/v1/events` WebSocket on live `sess.cloud`
/// for the active DB account `(sub, session)`. Refuses cross-account binding with 0 side effects.
fn wire_live_cloud_sync(
  sess : RuntimeSession,
  cs : sync::CloudSync,
  sub : String,
  session_id : String,
) -> Unit {
  if sub.length() > 0 {
    let _ = cs.bind_account_context(sub, session=session_id)
  }
  cs.set_cred_epoch_getter(fn(ws : String) -> Int64 {
    sess.core.membership.cred_epoch_of(ws)
  })
  cs.set_seq_provider(fn() -> Int64 {
    sess.core.membership.next_cloud_seq()
  })
  cs.set_commit_hooks(
    on_me_fetched=Some(fn(me : sync::CloudMe, req_seq : Int64) -> Unit {
      if sess.core.membership.is_session_invalidated() {
        return
      }
      match sess.core.commit_cloud_me(me, req_seq=req_seq, now_ms=pion_core_wall_now_ms()) {
        Ok(true) => {
          emit_topic_refresh(sess, "workspaces")
          emit_topic_refresh(sess, "workspace")
          emit_topic_refresh(sess, "stations")
          emit_topic_refresh(sess, "chats")
        }
        Err(msg) => if msg == "reentrant_membership_commit" {
          schedule_deferred_me_reconcile(sess, cs)
        }
        _ => ()
      }
    }),
    on_workspace_fetched=Some(fn(ws : sync::CloudWorkspace, req_seq : Int64) -> Unit {
      if sess.core.membership.is_session_invalidated() {
        return
      }
      match sess.core.commit_cloud_workspace(ws, req_seq=req_seq, now_ms=pion_core_wall_now_ms()) {
        Ok(true) => {
          emit_topic_refresh(sess, "workspaces")
          emit_topic_refresh(sess, "workspace")
          emit_topic_refresh(sess, "stations")
          emit_topic_refresh(sess, "chats")
        }
        Err(msg) => if msg == "reentrant_membership_commit" {
          schedule_deferred_me_reconcile(sess, cs)
        }
        _ => ()
      }
    }),
    on_unauthorized_err=Some(fn(_herr : sync::CloudHttpError) -> Unit {
      let active_sub = sess.core.membership.effective_sub()
      if active_sub.length() > 0 {
        runtime_refresh_account_token(sess, active_sub, fn(_ : Result[String, String]) -> Unit {})
      }
    }),
  )
}

/// Shared production OAuth token refresh path aligned 1:1 with TS `accounts.ts:299, 398-419, 581-606, 641-681`:
/// - Uses `sess.refresh_coord` (`AccountRefreshCoordinator`) with pure async `storage.get`/`storage.set`.
/// - Pre-request `#adoptStored` reads disk BEFORE sending `POST /v1/auth/refresh`.
/// - 200 write-back & 401 removal both use serialized bidirectional disk CAS conditioned on `(sub, session, refresh)`.
/// - Preserves all sibling accounts; NEVER installs a sibling account's token into active `sess.cloud`!
/// - NEVER bumps station `cred_epoch`.
fn runtime_refresh_account_token(
  sess : RuntimeSession,
  sub : String,
  on_done : (Result[String, String]) -> Unit,
) -> Unit {
  let req_origin = match sess.cloud {
    Some(c) => c.origin()
    None => sess.origin
  }
  if req_origin.length() == 0 {
    on_done(Err("missing cloud origin"))
    return
  }
  let mut refresh_tok = ""
  for i in 0..<sess.core.auth_store.accounts.length() {
    if sess.core.auth_store.accounts[i].sub == sub {
      refresh_tok = sess.core.auth_store.accounts[i].refresh
      break
    }
  }
  if refresh_tok.length() == 0 {
    on_done(Err("missing refresh token"))
    return
  }
  let expected_session = match sess.core.account_sessions.get(sub) {
    Some(s) => s
    None => ""
  }
  let active_db_sub = sess.core.membership.effective_sub()
  let is_active_account = active_db_sub.length() > 0 && sub == active_db_sub
  let req_session_gen = sess.session_gen
  let host = sync::AccountRefreshHost::{
    read_accounts_k: fn(rk : (sync::HostStorageRead) -> Unit) -> Unit {
      read_storage_json_state_k(sess.sh, "accounts", rk)
    },
    write_accounts_k: fn(doc : base_codec::Json, wk : (Result[Unit, String]) -> Unit) -> Unit {
      write_storage_json_k(sess.sh, "accounts", doc, wk)
    },
    do_refresh_http_k: fn(rtok : String, now_ms : Int64, hk : (effect::Exit[Result[sync::RefreshedTokens, sync::RefreshTokenError]]) -> Unit) -> Unit {
      sync::refresh_token_k(sess.sh, req_origin, rtok, now_ms, hk)
    },
    get_mem_tuple: fn(target_sub : String) -> Option[(String, String)] {
      if is_active_account && sess.session_gen != req_session_gen {
        return None
      }
      for i in 0..<sess.core.auth_store.accounts.length() {
        if sess.core.auth_store.accounts[i].sub == target_sub {
          let sid = match sess.core.account_sessions.get(target_sub) { Some(s) => s; None => "" }
          return Some((sid, sess.core.auth_store.accounts[i].refresh))
        }
      }
      None
    },
    on_adopt_or_update: fn(
      updated : views::StoredAccount,
      _sid : String,
      all_accts : Array[views::StoredAccount],
      all_sessions : Map[String, String],
    ) -> Unit {
      sync_mem_accounts_from_list(sess, all_accts, all_sessions)
      let _ = store::put_account_doc(
        sess.db,
        "accounts",
        base_codec::json_stringify(views::project_accounts_topic(sess.core.auth_store)),
      )
      // ONLY install rotated token into live `sess.cloud` when `sub` is the active DB account!
      if updated.sub == sess.core.membership.effective_sub() && updated.access.length() > 0 {
        sess.bearer_gen += 1L
        match sess.cloud {
          Some(cs) => cs.set_origin_and_token("", updated.access)
          None => ()
        }
      }
      emit_topic_refresh(sess, "accounts")
    },
    on_invalidated: fn(
      inv_sub : String,
      inv_sid : String,
      inv_ref : String,
      remaining_accts : Array[views::StoredAccount],
      remaining_sessions : Map[String, String],
    ) -> Unit {
      let was_active_sub = inv_sub == sess.core.membership.effective_sub()
      let exp_sid_opt : Option[String] = if inv_sid.length() > 0 { Some(inv_sid) } else { None }
      let invalidated = sess.core.invalidate_session(
        inv_sub,
        expected_session=exp_sid_opt,
        expected_refresh=Some(inv_ref),
        persist_accounts=false,
      )
      sync_mem_accounts_from_list(sess, remaining_accts, remaining_sessions)
      if invalidated && remaining_accts.length() == 0 {
        // Last account removed: immediately switch ALL holders back to a clean unauthenticated `:memory:` DB
        // so 0 cached data can leak even BEFORE process restart, and allow fresh same-process sign-in!
        runtime_switch_to_unauth_memory_db(sess)
        emit_topic_refresh(sess, "accounts")
        emit_topic_refresh(sess, "workspaces")
        emit_topic_refresh(sess, "workspace")
        emit_topic_refresh(sess, "stations")
        emit_topic_refresh(sess, "chats")
      } else if invalidated && was_active_sub {
        let _ = store::put_account_doc(
          sess.db,
          "accounts",
          base_codec::json_stringify(views::project_accounts_topic(sess.core.auth_store)),
        )
        sess.login_gen += 1L
        let _ = bump_runtime_session_gen(sess)
        sess.bearer_gen += 1L
        sess.live_sync_enabled = false
        clear_runtime_ephemeral_caches(sess)
        match sess.cloud {
          Some(cs) => {
            cs.clear_all_credentials()
            cs.clear_token()
            cs.stop()
          }
          None => ()
        }
        emit_topic_refresh(sess, "accounts")
        emit_topic_refresh(sess, "workspaces")
        emit_topic_refresh(sess, "workspace")
        emit_topic_refresh(sess, "stations")
        emit_topic_refresh(sess, "chats")
      } else if invalidated {
        let _ = store::put_account_doc(
          sess.db,
          "accounts",
          base_codec::json_stringify(views::project_accounts_topic(sess.core.auth_store)),
        )
        emit_topic_refresh(sess, "accounts")
      }
    },
    now_ms: fn() -> Int64 { pion_core_wall_now_ms() },
  }
  let _ = sess.core.rt.fork_quiet_named("auth-refresh:" + sub, fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    sess.refresh_coord.refresh_k(host, sub, expected_session, refresh_tok, fn(outcome : sync::AccountRefreshOutcome) -> Unit {
      match outcome {
        sync::AccountRefreshOutcome::Ok(access, _) => on_done(Ok(access))
        sync::AccountRefreshOutcome::InvalidSession(_, msg, _) => on_done(Err(msg))
        sync::AccountRefreshOutcome::Stale(msg) => on_done(Err(msg))
        sync::AccountRefreshOutcome::Transient(msg) => on_done(Err(msg))
      }
      fk(effect::Exit::Succeeded(()))
    })
  })
}

fn sess_lang(sess : RuntimeSession) -> String {
  if sess.core.lang == "en" { "en" } else { "zh" }
}

fn sess_viewer_email(sess : RuntimeSession) -> String {
  if sess.accounts.length() > 0 && sess.accounts[0].email.length() > 0 {
    sess.accounts[0].email
  } else {
    sess.core.viewer_marks.me
  }
}

fn sess_viewer_sub(sess : RuntimeSession) -> String {
  if sess.accounts.length() > 0 {
    sess.accounts[0].sub
  } else {
    ""
  }
}

fn is_station_online(sess : RuntimeSession, addr : String) -> Bool {
  match sess.station_online.get(addr) {
    Some(b) => b
    None => false
  }
}

fn station_briefs_live(sess : RuntimeSession, ws_scope : String) -> Array[views::StationBrief] {
  let out : Array[views::StationBrief] = []
  if ws_scope.length() > 0 && !sess.core.can_read_workspace(ws_scope) {
    return out
  }
  let prefix = if ws_scope.length() > 0 { ws_scope + "/" } else { "" }
  let lang = sess_lang(sess)
  let overview_by_addr : Map[String, base_codec::Json] = Map::new()
  let overview_addrs : Array[String] = []
  match store::list_stations(sess.db, kind="overview") {
    sql::SqlResult::Ok(rows) => {
      for i in 0..<rows.length() {
        let r = rows[i]
        // Strict workspace isolation + unified MembershipAuthority O(1) read gate.
        if prefix.length() > 0 && !r.address.starts_with(prefix) {
          continue
        }
        if !sess.core.can_read_station(r.address) {
          continue
        }
        let doc = match base_codec::json_parse(r.json) {
          base_codec::JsonParseResult::Ok(j) => j
          base_codec::JsonParseResult::Err(_) => base_codec::json_null()
        }
        overview_by_addr.set(r.address, doc)
        overview_addrs.push(r.address)
      }
    }
    sql::SqlResult::Err(_) => ()
  }
  let seen : Map[String, Bool] = Map::new()
  // Base roster from `workspace.json` (`sync::list_workspace_stations`), merged with live `station(addr, "overview")` (#8369).
  if ws_scope.length() > 0 {
    let cloud_sts = sync::list_workspace_stations(sess.db, ws_scope)
    for i in 0..<cloud_sts.length() {
      let cs = cloud_sts[i]
      let addr = sync::canonical_station(ws_scope, cs.id)
      if !sess.core.can_read_station(addr) {
        continue
      }
      seen.set(addr, true)
      let doc = match overview_by_addr.get(addr) {
        Some(d) => d
        None => base_codec::json_null()
      }
      let sname = match opt_str_param(doc, "name") {
        Some(s) => s
        None => if cs.name.length() > 0 { cs.name } else { cs.id }
      }
      let is_online = is_station_online(sess, addr)
      let off_txt = if is_online {
        None
      } else {
        Some(if lang == "en" { sname + " offline" } else { sname + " 离线" })
      }
      out.push(views::StationBrief::{
        address: addr,
        id: cs.id,
        name: sname,
        emoji: opt_str_param(doc, "emoji"),
        icon: opt_str_param(doc, "icon"),
        online: is_online,
        updating: false,
        offline_text: off_txt,
        reconnecting_text: None,
        running: 0,
      })
    }
  }
  for i in 0..<overview_addrs.length() {
    let addr = overview_addrs[i]
    if seen.get(addr).is_some() {
      continue
    }
    let doc = match overview_by_addr.get(addr) {
      Some(d) => d
      None => base_codec::json_null()
    }
    let sid = match opt_str_param(doc, "id") {
      Some(s) => s
      None => if prefix.length() > 0 && addr.starts_with(prefix) {
        addr.slice(prefix.length(), addr.length())
      } else {
        addr
      }
    }
    let sname = match opt_str_param(doc, "name") {
      Some(s) => s
      None => sid
    }
    let is_online = is_station_online(sess, addr)
    let off_txt = if is_online {
      None
    } else {
      Some(if lang == "en" { sname + " offline" } else { sname + " 离线" })
    }
    out.push(views::StationBrief::{
      address: addr,
      id: sid,
      name: sname,
      emoji: opt_str_param(doc, "emoji"),
      icon: opt_str_param(doc, "icon"),
      online: is_online,
      updating: false,
      offline_text: off_txt,
      reconnecting_text: None,
      running: 0,
    })
  }
  out
}

fn resolve_thread_and_chat_meta(
  sess : RuntimeSession,
  st : String,
  thread_opt : Option[Int],
  session_opt : Option[String],
) -> (String, Option[Int], Option[base_codec::Json]) {
  let mut cur_st = st
  let mut cur_th = thread_opt
  // Resolve moved chats via `store::resolve_chat_now` before looking up thread/meta.
  match session_opt {
    Some(sk) => {
      if sk.length() > 0 {
        match store::resolve_chat_now(sess.db, cur_st, sk) {
          sql::SqlResult::Ok(Some(loc)) => {
            cur_st = loc.station
            match loc.thread {
              Some(mt) => {
                cur_th = Some(mt)
              }
              None => ()
            }
          }
          _ => ()
        }
      }
    }
    None => match cur_th {
      Some(th) => match store::resolve_chat_now_by_thread(sess.db, cur_st, th) {
        sql::SqlResult::Ok(Some(loc)) => {
          cur_st = loc.station
          match loc.thread {
            Some(mt) => {
              cur_th = Some(mt)
            }
            None => ()
          }
        }
        _ => ()
      }
      None => ()
    }
  }
  match cur_th {
    Some(th) => {
      let meta = match store::get_chat_by_thread(sess.db, cur_st, th) {
        sql::SqlResult::Ok(Some(rec)) => match base_codec::json_parse(rec.json) {
          base_codec::JsonParseResult::Ok(j) => Some(j)
          base_codec::JsonParseResult::Err(_) => None
        }
        _ => None
      }
      return (cur_st, Some(th), meta)
    }
    None => ()
  }
  match session_opt {
    Some(sk) => {
      if sk.length() == 0 {
        return (cur_st, None, None)
      }
      let rec_opt = match store::get_chat_by_session(sess.db, cur_st, sk) {
        sql::SqlResult::Ok(Some(r)) => Some(r)
        _ => match store::get_chat_by_key(sess.db, cur_st, 0, sk) {
          sql::SqlResult::Ok(Some(r)) => Some(r)
          _ => None
        }
      }
      match rec_opt {
        Some(rec) => match base_codec::json_parse(rec.json) {
          base_codec::JsonParseResult::Ok(j) => {
            let th_opt = match base_codec::json_get(j, "thread") {
              Some(base_codec::Json::Num(n, _)) => Some(n.to_int())
              _ => None
            }
            (cur_st, th_opt, Some(j))
          }
          base_codec::JsonParseResult::Err(_) => (cur_st, None, None)
        }
        None => (cur_st, None, None)
      }
    }
    None => (cur_st, None, None)
  }
}

fn build_new_chat_view() -> base_codec::Json {
  base_codec::json_obj([
    ("kept", base_codec::json_str("")),
    ("next", base_codec::json_str("new:chat-pion")),
    ("stations", base_codec::json_arr([])),
    ("any", base_codec::json_bool(true)),
    ("down", base_codec::json_bool(false)),
    ("waiting", base_codec::json_bool(false)),
    ("preset", base_codec::json_str("")),
    ("presetStation", base_codec::json_str("")),
    ("presetName", base_codec::json_str("")),
    ("presets", base_codec::json_arr([])),
    ("presetMarks", base_codec::json_arr([])),
    ("presetModel", base_codec::json_bool(false)),
    ("presetStations", base_codec::json_bool(false)),
    ("autoStation", base_codec::json_bool(false)),
    ("autoPoolCount", base_codec::json_int(0)),
  ])
}

/// Start the Pion `ClientCore` + real Rust `stillfail-shell` on `data_dir` (called on core thread).
pub extern "C" fn pion_core_runtime_start(
  data_dir : Ptr,
  data_dir_len : Int64,
  cloud_origin : Ptr,
  cloud_origin_len : Int64,
  beta : Int,
) -> Int {
  let dir = ptr_to_string(data_dir, data_dir_len)
  let origin = ptr_to_string(cloud_origin, cloud_origin_len)
  let _beta_flag = beta != 0
  if dir.length() == 0 {
    emit_fatal("missing data_dir")
    return 0
  }
  // Keep `effect::Runtime` on Unix wall-clock ms (`pion_core_wall_now_ms`) because `ClientCore` / `CloudSync`
  // use `rt.now()` as Unix epoch ms (`exp`, `createdAt`, day bucketing); `core_pion.c` sleeps on `CLOCK_MONOTONIC`
  // using the relative delay returned by `pion_core_runtime_on_wake()`.
  let rt = effect::Runtime::live(fn() -> Int64 { pion_core_wall_now_ms() })
  let sh = match shell_native::open(rt, dir) {
    Ok(s) => s
    Err(e) => {
      emit_fatal("shell_native::open failed: " + e)
      return 0
    }
  }
  // Load signed-in accounts and device prefs from host storage (matching `client/core-ts`).
  let accounts : Array[AccountInfo] = match read_storage_json(sh, "accounts") {
    Some(j) => parse_stored_accounts(j)
    None => []
  }
  let prefs_map : Map[String, base_codec::Json] = Map::new()
  match read_storage_json(sh, "device/prefs") {
    Some(j) => {
      let dev_obj = match base_codec::json_get(j, "device") {
        Some(d) => d
        None => j
      }
      match dev_obj {
        base_codec::Json::Obj(pairs) => {
          for i in 0..<pairs.length() {
            let (k, v) = pairs[i]
            prefs_map.set(k, v)
          }
        }
        _ => ()
      }
    }
    None => ()
  }
  // Account-owned DB lifecycle (Invariant 1):
  // - When signed out (`accounts` empty), NEVER open or touch `default.db`: open an isolated
  //   ephemeral `:memory:` DB with `unauthenticated = true` (0 leakage of any prior account data).
  // - When signed in, open `account-<sanitized_sub>.db` directly.
  let is_unauth = accounts.length() == 0
  let db_name = if is_unauth {
    ":memory:"
  } else {
    encode_account_db_name(accounts[0].sub)
  }
  let db = match open_and_migrate_account_db(sh, db_name) {
    Ok(d) => d
    Err(msg) => {
      emit_fatal(msg)
      return 0
    }
  }
  let mut default_ws = match prefs_map.get("workspace") {
    Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else { "" }
    _ => ""
  }
  if default_ws.length() == 0 {
    match store::list_workspaces(db) {
      sql::SqlResult::Ok(ws_rows) => {
        if ws_rows.length() > 0 {
          default_ws = ws_rows[0].id
        }
      }
      sql::SqlResult::Err(_) => ()
    }
  }
  if default_ws.length() == 0 {
    default_ws = "ws-default"
  }
  let mut default_st = "st-local"
  let cloud_default_sts = sync::list_workspace_stations(db, default_ws)
  if cloud_default_sts.length() > 0 {
    default_st = default_ws + "/" + cloud_default_sts[0].id
  } else {
    match store::list_stations(db, kind="overview") {
      sql::SqlResult::Ok(st_rows) => {
        let prefix = default_ws + "/"
        for i in 0..<st_rows.length() {
          if st_rows[i].address.starts_with(prefix) {
            default_st = st_rows[i].address
            break
          }
        }
      }
      sql::SqlResult::Err(_) => ()
    }
  }
  // Only loopback test HTTP station URLs (`http://127.0.0.1:...`) use `shell_http_transport`.
  // Production `cloud_origin` (e.g. `https://app.still.fail`) is NEVER used as a station HTTP URL;
  // production stations connect over `MeshStationTransport` (`shell_mesh_transport` + `attach_station_transport`).
  let transport = if is_loopback_http_url(origin) {
    sync::shell_http_transport(sh, origin)
  } else {
    offline_transport()
  }
  let active_access = if accounts.length() > 0 { accounts[0].access } else { "" }
  let active_sub = if accounts.length() > 0 { accounts[0].sub } else { "" }
  let active_session = if accounts.length() > 0 { accounts[0].session } else { "" }
  let cloud_opt : Option[sync::CloudSync] = if origin.length() > 0 {
    Some(sync::CloudSync::new(
      sh,
      db,
      origin,
      token=active_access,
      bound_sub=active_sub,
      bound_session=active_session,
    ))
  } else {
    None
  }
  // Fail-open device-level `connSeq` high-water mark (`device/conn_seq_floor`), aligned 1:1 with
  // TS `client/core-ts/src/core.ts:406-414` (`Effect.ignore(flushTable("auth"))`):
  // - In-process restart monotonicity (`apps/mbui/src/core/client.mbt` `min_restart_conn`) is
  //   strictly guaranteed by `g_last_device_conn_seq[0]`; cold processes start with `min_restart_conn == 0`.
  // - `parse_conn_seq_raw` rejects decimals, non-positive values, and `>= MAX_SAFE_CONN_SEQ` (`Int64::MAX`),
  //   preventing wraparound overflow.
  // - `device/auth` corrupt / `ReadError` / non-object: ALWAYS preserved byte-for-byte untouched (protects
  //   TS `capRev:*`), never fatal-bricks startup; repairs/writes `device/conn_seq_floor` and proceeds.
  // - `device/conn_seq_floor` corrupt / decimal / out-of-range: Pion-owned file, so warn and overwrite-repair
  //   from `max(other valid high-water marks + 1, g_last_device_conn_seq + 1, now_ms * 1000L)`.
  // - Storage write failures (disk full / read-only): warn and continue fail-open with in-memory floor + wall clock.
  let parse_conn_read = fn(st : StorageRead) -> Int64 {
    match st {
      StorageRead::Found(j) => store::parse_conn_seq_raw(base_codec::json_stringify(j))
      _ => 0L
    }
  }
  let floor_read = read_storage_json_state(sh, "device/conn_seq_floor")
  let auth_read = read_storage_json_state(sh, "device/auth")

  let floor_conn : Int64 = match floor_read {
    StorageRead::Absent => 0L
    StorageRead::ReadError(reason) => {
      log_runtime_warn("device/conn_seq_floor unreadable (" + reason + "); repairing from valid high-water marks")
      0L
    }
    StorageRead::Found(fj) => {
      let v = store::parse_conn_seq_raw(base_codec::json_stringify(fj))
      if v <= 0L {
        // Do not misreport our own in-process headroom (`MAX_PERSISTED_CONN_SEQ < g_last_device_conn_seq <= MAX_SAFE_CONN_SEQ`) as corruption.
        if g_last_device_conn_seq[0] <= store::MAX_PERSISTED_CONN_SEQ {
          log_runtime_warn("device/conn_seq_floor has invalid/out-of-range connSeq; repairing from valid high-water marks")
        }
        0L
      } else {
        v
      }
    }
  }

  let auth_conn = parse_conn_read(auth_read)
  let file_conn = parse_conn_read(read_storage_json_state(sh, "conn_seq"))
  let legacy_conn = parse_conn_read(read_storage_json_state(sh, "device/conn_seq"))
  let mut storage_device_conn = if auth_conn >= floor_conn { auth_conn } else { floor_conn }
  if file_conn > storage_device_conn {
    storage_device_conn = file_conn
  }
  if legacy_conn > storage_device_conn {
    storage_device_conn = legacy_conn
  }
  let db_conn : Int64 = match store::get_account_doc(db, "conn_seq") {
    sql::SqlResult::Ok(Some(raw)) => store::parse_conn_seq_raw(raw)
    _ => 0L
  }
  let prev_device_conn = if storage_device_conn >= db_conn { storage_device_conn } else { db_conn }
  let device_conn_seq = match store::next_monotonic_conn_seq_checked(
    prev_device_conn,
    now_ms=pion_core_wall_now_ms(),
    floor=g_last_device_conn_seq[0],
  ) {
    Ok(v) => v
    Err(_) => {
      // Only reachable if a single OS process exhausts all 1B headroom steps up to `MAX_SAFE_CONN_SEQ`.
      // Never emit a regressing `conn` (host `min_restart_conn` would reject it); instruct full app restart
      // (a cold OS process starts with `g_last_device_conn_seq[0] == 0` and automatically repairs disk).
      let err_msg = "connection sequence exhausted; restart the app to continue"
      g_last_conn_seq_persist_err[0] = Some(err_msg)
      log_runtime_warn(err_msg)
      db.close()
      shell_native::stop()
      emit_fatal(err_msg)
      return 0
    }
  }

  let mut persist_err : Option[String] = None
  let floor_doc = base_codec::json_obj([("connSeq", base_codec::json_int64(device_conn_seq))])
  // Always persist (or overwrite-repair) `device/conn_seq_floor` FIRST on every startup;
  // on disk-full/read-only failure, log warning and proceed fail-open.
  match write_storage_json(sh, "device/conn_seq_floor", floor_doc) {
    Ok(_) => ()
    Err(e) => {
      let err_msg = "device/conn_seq_floor persist failed (continuing fail-open): " + e
      persist_err = Some(err_msg)
      log_runtime_warn(err_msg)
    }
  }
  // When `device/auth` is writable (`Absent` or `Found(Obj)`), merge-write `device/auth`
  // preserving all sibling fields (such as TS `capRev:*`); when `device/auth` is unreadable/corrupt
  // or non-object, preserve `device/auth` byte-for-byte untouched and continue using `device/conn_seq_floor`.
  match auth_read {
    StorageRead::Absent => {
      match write_storage_json(sh, "device/auth", floor_doc) {
        Ok(_) => ()
        Err(e) => {
          let err_msg = "device/auth persist failed (continuing fail-open): " + e
          persist_err = Some(err_msg)
          log_runtime_warn(err_msg)
        }
      }
    }
    StorageRead::Found(base_codec::Json::Obj(pairs)) => {
      let merged_auth_fields : Array[(String, base_codec::Json)] = []
      for i in 0..<pairs.length() {
        let (k, v) = pairs[i]
        if k != "connSeq" {
          merged_auth_fields.push((k, v))
        }
      }
      merged_auth_fields.push(("connSeq", base_codec::json_int64(device_conn_seq)))
      match write_storage_json(sh, "device/auth", base_codec::json_obj(merged_auth_fields)) {
        Ok(_) => ()
        Err(e) => {
          let err_msg = "device/auth merge-write failed (continuing fail-open): " + e
          persist_err = Some(err_msg)
          log_runtime_warn(err_msg)
        }
      }
    }
    StorageRead::Found(_) => {
      log_runtime_warn("device/auth is non-object JSON; preserving device/auth untouched and continuing via device/conn_seq_floor")
    }
    StorageRead::ReadError(reason) => {
      log_runtime_warn("device/auth unreadable/corrupt (" + reason + "); preserving device/auth untouched and continuing via device/conn_seq_floor")
    }
  }
  g_last_device_conn_seq[0] = device_conn_seq
  g_last_conn_seq_persist_err[0] = persist_err
  match store::put_account_doc(db, "conn_seq", device_conn_seq.to_string()) {
    sql::SqlResult::Ok(_) => ()
    sql::SqlResult::Err(e) => {
      let err_msg = "conn_seq sqlite mirror failed: " + e.to_string()
      g_last_conn_seq_persist_err[0] = Some(err_msg)
      log_runtime_warn(err_msg)
    }
  }
  let core = sync::ClientCore::new(
    default_ws,
    default_st,
    rt,
    db,
    transport,
    fn() -> Unit {},
    conn_seq=Some(device_conn_seq),
  )
  core.utc_offset_min = pion_core_utc_offset_min(pion_core_wall_now_ms())
  // Seed SQLite `account_doc("prefs")` from host `device/prefs` on first boot if SQLite prefs are empty.
  match store::get_device_prefs(db) {
    sql::SqlResult::Ok(base_codec::Json::Obj(existing_fs)) => {
      if existing_fs.length() == 0 && prefs_map.keys().length() > 0 {
        let seed_pairs : Array[(String, base_codec::Json)] = []
        let pks = prefs_map.keys()
        for i in 0..<pks.length() {
          match prefs_map.get(pks[i]) {
            Some(v) => seed_pairs.push((pks[i], v))
            None => ()
          }
        }
        let _ = store::put_account_doc(db, "prefs", base_codec::json_stringify(base_codec::json_obj(seed_pairs)))
      }
    }
    _ => ()
  }
  match store::get_device_prefs(db) {
    sql::SqlResult::Ok(pj) => match base_codec::json_get(pj, "lang") {
      Some(base_codec::Json::Str(s)) => { core.lang = if s == "en" { "en" } else { "zh" } }
      _ => ()
    }
    _ => ()
  }
  core.set_on_prefs_saved(fn(next_prefs : base_codec::Json) -> Result[Unit, String] {
    write_storage_json(sh, "device/prefs", base_codec::json_obj([("device", next_prefs)]))
  })
  // Non-blocking single-in-flight async host purge mirror (Invariant 2: ZERO sync host reader or `drain_until` in commits!).
  core.membership.set_host_pending_purges_async_writer(fn(
    key : String,
    doc : base_codec::Json,
    done : (Result[Unit, String]) -> Unit,
  ) -> Unit {
    write_storage_json_k(sh, key, doc, done)
  })
  if origin.length() > 0 {
    core.set_cloud_origin(origin)
  }
  if is_unauth {
    core.membership.set_unauthenticated(true)
  } else {
    let a0 = accounts[0]
    let sub_host_key = sync::host_pending_purges_key_for_sub(a0.sub)
    let (host_purges_read, host_purges_shared) : (sync::HostStorageRead, Bool) = match read_storage_json_state(sh, sub_host_key) {
      StorageRead::Found(j) => (sync::HostStorageRead::Found(j), false)
      StorageRead::Absent => match read_storage_json_state(sh, sync::HOST_PENDING_PURGES_KEY) {
        StorageRead::Found(sj) => (sync::HostStorageRead::Found(sj), true)
        StorageRead::Absent => (sync::HostStorageRead::Absent, false)
        StorageRead::ReadError(reason) => {
          log_runtime_warn("shared pending purges unreadable (" + reason + "); falling back to SQLite meta")
          (sync::HostStorageRead::ReadError(reason), true)
        }
      }
      StorageRead::ReadError(reason) => {
        log_runtime_warn("per-account pending purges unreadable (" + reason + "); falling back to SQLite meta")
        (sync::HostStorageRead::ReadError(reason), false)
      }
    }
    let _ = core.set_db_account_sub(
      a0.sub,
      host_purges_shared=host_purges_shared,
      host_purges_read=Some(host_purges_read),
    )
    core.set_viewer(a0.email, sub=a0.sub, role="owner")
    match read_storage_json(sh, sync::person_lock_storage_key(a0.sub)) {
      Some(pjson) => {
        let _ = core.load_person_lock_json(pjson, a0.sub)
      }
      None => ()
    }
    for i in 0..<accounts.length() {
      let ai = accounts[i]
      if ai.session.length() > 0 {
        core.account_sessions.set(ai.sub, ai.session)
      }
      core.auth_store.register_account(views::StoredAccount::{
        sub: ai.sub,
        email: ai.email,
        name: ai.name,
        picture: ai.picture,
        access: ai.access,
        refresh: ai.refresh,
        access_expires: ai.access_expires,
      })
    }
    // Retry any persisted `(account_sub, ws)` pending purges on startup before serving views.
    let _ = core.retry_pending_purges()
  }
  let refresh_coord = sync::AccountRefreshCoordinator::for_storage_dir(dir)
  refresh_coord.set_external_file_lock(
    fn(lk : (Result[Int64, String]) -> Unit) -> Unit {
      acquire_accounts_file_lock_retry_k(dir, 0, lk)
    },
    fn(fd : Int64) -> Unit {
      pion_core_dir_lock_release(fd)
    },
  )
  let sess = RuntimeSession::{
    dir: dir,
    sh: sh,
    db: db,
    core: core,
    refresh_coord: refresh_coord,
    accounts: accounts,
    prefs: prefs_map,
    station_online: Map::new(),
    runtime_subs: [],
    kept_vals: Map::new(),
    kept_topics: Map::new(),
    kept_order: [],
    md_stores: Map::new(),
    mesh_transports: Map::new(),
    cloud: cloud_opt,
    origin: origin,
    session_gen: 1L,
    login_gen: 1L,
    bearer_gen: 1L,
    reconcile_requeue_pending: false,
    device_conn_seq: device_conn_seq,
    live_sync_enabled: false,
    device_app: "desktop",
    device_locale: "",
  }
  core.set_wire_sink(fn(j : String, b : Option[Bytes]) -> Unit {
    emit_wire(j, payload=b)
  })
  core.set_on_runtime_boundary(fn(ev : sync::AuthBoundaryEvent) -> Unit {
    handle_runtime_auth_boundary(sess, ev)
  })
  core.set_on_session_invalidated(fn(_sub : String) -> Unit {
    let _ = bump_runtime_session_gen(sess)
  })
  core.set_on_workspace_dropped(fn(_ws : String, stations : Array[String]) -> Unit {
    for i in 0..<stations.length() {
      let st = stations[i]
      match sess.mesh_transports.get(st) {
        Some(ctrl) => {
          sess.mesh_transports.remove(st)
          ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit {})
        }
        None => ()
      }
      match sess.md_stores.get(st) {
        Some(ms) => {
          ms.clear()
          sess.md_stores.remove(st)
        }
        None => ()
      }
      sess.station_online.remove(st)
    }
  })
  core.set_on_credential_refresh(fn(ws : String) -> Unit {
    match sess.cloud {
      Some(cs) => {
        cs.invalidate_workspace_credential(ws)
        let mkeys = sess.mesh_transports.keys()
        for i in 0..<mkeys.length() {
          let st = mkeys[i]
          if sess.core.membership.station_workspace(st, fallback_ws=sess.core.workspace) == ws {
            match sess.mesh_transports.get(st) {
              Some(ctrl) => {
                let dev_id = match ctrl.device_id() { Some(d) => d; None => "" }
                if dev_id.length() > 0 {
                  let captured_epoch = sess.core.membership.cred_epoch_of(ws)
                  let req_session_gen = sess.session_gen
                  let _ = sess.core.rt.fork_quiet_named("cred-refresh:" + st, fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
                    cs.fetch_member_credential_k(
                      ws,
                      dev_id,
                      pion_core_wall_now_ms() / 1000L,
                      fn(ex : effect::Exit[sync::MemberCredential]) -> Unit {
                        if sess.session_gen != req_session_gen || sess.core.membership.cred_epoch_of(ws) != captured_epoch || !sess.core.can_read_workspace(ws) {
                          ctrl.drop_link(reason="cred_epoch_changed")
                          fk(effect::Exit::Succeeded(()))
                          return
                        }
                        match ex {
                          effect::Exit::Succeeded(mc) => {
                            ctrl.refresh_credential_k(mc.credential, fn(rex : effect::Exit[sync::MeshAdmission]) -> Unit {
                              if sess.session_gen != req_session_gen || sess.core.membership.cred_epoch_of(ws) != captured_epoch || !sess.core.can_read_workspace(ws) {
                                ctrl.drop_link(reason="cred_epoch_changed")
                                fk(effect::Exit::Succeeded(()))
                                return
                              }
                              match rex {
                                effect::Exit::Succeeded(_) => {
                                  match sess.core.station_sync(st) {
                                    Some(sy) => sy.bump_epoch()
                                    None => ()
                                  }
                                }
                                _ => ctrl.drop_link(reason="cred_refresh")
                              }
                              fk(effect::Exit::Succeeded(()))
                            })
                          }
                          _ => {
                            ctrl.drop_link(reason="cred_refresh_failed")
                            fk(effect::Exit::Succeeded(()))
                          }
                        }
                      },
                      fresh=true,
                    )
                  })
                } else {
                  ctrl.drop_link(reason="cred_refresh")
                }
              }
              None => ()
            }
          }
        }
      }
      None => ()
    }
  })
  core.set_on_workspace_refresh(fn(ws : String) -> Unit {
    match sess.cloud {
      Some(cs) => {
        let req_seq = sess.core.membership.next_cloud_seq()
        let orig_sub = cs.bound_sub()
        let orig_session = cs.bound_session()
        let orig_gen = sess.session_gen
        let _ = sess.core.rt.fork_quiet_named("ws-refresh:" + ws, fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
          sync::fetch_workspace_structured_k(
            sess.sh,
            cs.origin(),
            cs.token(),
            ws,
            fn(ex : effect::Exit[Result[sync::CloudWorkspace, sync::CloudHttpError]]) -> Unit {
              if sess.session_gen != orig_gen || cs.bound_sub() != orig_sub || cs.bound_session() != orig_session {
                fk(effect::Exit::Succeeded(()))
                return
              }
              match ex {
                effect::Exit::Succeeded(Ok(cws)) => {
                  match sess.core.commit_cloud_workspace(cws, req_seq=req_seq, now_ms=pion_core_wall_now_ms()) {
                    Ok(true) => {
                      emit_topic_refresh(sess, "workspace")
                      emit_topic_refresh(sess, "stations")
                    }
                    _ => ()
                  }
                }
                effect::Exit::Succeeded(Err(herr)) => {
                  if herr.status == 403 || herr.status == 404 {
                    cs.trigger_me_reconcile()
                  } else if herr.status == 401 {
                    let sub_now = sess.core.membership.effective_sub()
                    if sub_now.length() > 0 {
                      runtime_refresh_account_token(sess, sub_now, fn(_ : Result[String, String]) -> Unit {})
                    }
                  }
                }
                _ => ()
              }
              fk(effect::Exit::Succeeded(()))
            },
          )
        })
      }
      None => ()
    }
  })
  // Wire production CloudSync commit hooks, monotonic seq provider, cred_epoch guard, and
  // dynamic-token `/v1/events` WebSocket consumption when signed in with an access token.
  match sess.cloud {
    Some(cs) => {
      wire_live_cloud_sync(sess, cs, active_sub, active_session)
      if !is_unauth && active_access.length() > 0 {
        cs.start_events_ws(fn(_ev : sync::CloudEvent) -> Unit {})
      }
    }
    None => ()
  }
  g_session[0] = Some(sess)
  // Emit authoritative startup handshake `{"id": 0, "auth": {"conn": N, ...}}` via host sink.
  let _ = core.emit_auth_handshake()
  1
}

fn affected_topic_for_call(call_name : String) -> Option[String] {
  if call_name == "settings.set" {
    return Some("settings")
  }
  if call_name == "prefs.set" || call_name == "client.device" {
    return Some("prefs")
  }
  if call_name == "notify.permission" || call_name == "notify.set" {
    return Some("notify")
  }
  if call_name == "chat.draft" || call_name == "draft.put" {
    return Some("draft")
  }
  if call_name.starts_with("composer.") {
    return Some("composer")
  }
  if call_name == "account.switch" || call_name == "auth.complete" {
    return Some("accounts")
  }
  if call_name == "vault.approve" || call_name == "vault.deny" || call_name == "vault.withdraw" {
    return Some("vaultApprovals")
  }
  if call_name == "preset.copy" {
    return Some("presets")
  }
  if call_name == "download.join" || call_name == "download.leave" {
    return Some("downloads")
  }
  if call_name == "chat.send" || call_name == "decision.answer" {
    return Some("chat")
  }
  if call_name == "chat.read" || call_name == "chat.rename" || call_name == "chat.pin" ||
  call_name == "chat.archive" || call_name == "chat.hide" || call_name == "chat.mute" ||
  call_name == "chat.keep" || call_name == "chat.delete" {
    return Some("chats")
  }
  None
}

fn handle_cloud_sync_call(sess : RuntimeSession, id : Int64, params : base_codec::Json) -> Unit {
  if sess.core.membership.is_unauthenticated() {
    let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
      code: "unauthenticated",
      message: "account not signed in",
    })
    let (out_j, out_b) = protocol::encode_core_event(ev)
    emit_wire(out_j, payload=out_b)
    return
  }
  let trusted_origin = if sess.origin.length() > 0 {
    sess.origin
  } else {
    match sess.cloud {
      Some(c) => c.origin()
      None => ""
    }
  }
  let param_origin = match opt_str_param(params, "origin") {
    Some(o) => o
    None => ""
  }
  // Pin trusted cloud origin: NEVER transmit this account's access_token to a different origin
  // or replace live `sess.origin` / `sess.cloud.origin`!
  if param_origin.length() > 0 && trusted_origin.length() > 0 &&
  strip_trailing_slash_rt(param_origin) != strip_trailing_slash_rt(trusted_origin) {
    let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
      code: "origin_mismatch",
      message: "origin_mismatch: cloud origin is pinned to " + trusted_origin,
    })
    let (out_j, out_b) = protocol::encode_core_event(ev)
    emit_wire(out_j, payload=out_b)
    return
  }
  let req_origin = if trusted_origin.length() > 0 { trusted_origin } else { param_origin }
  let candidate_token = match opt_str_param(params, "token") {
    Some(t) => t
    None => ""
  }
  let eff_token = if candidate_token.length() > 0 {
    candidate_token
  } else {
    match sess.cloud {
      Some(c) => c.token()
      None => ""
    }
  }
  let want_ws = opt_str_param(params, "workspace")
  match want_ws {
    Some(w) => if w.length() > 0 && !sync::is_valid_cloud_workspace_id(w) {
      let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
        code: "bad_params",
        message: "invalid workspace id: must be a 26-char Crockford Base32 ULID",
      })
      let (out_j, out_b) = protocol::encode_core_event(ev)
      emit_wire(out_j, payload=out_b)
      return
    }
    None => ()
  }
  if req_origin.length() == 0 {
    let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing cloud_origin" })
    let (out_j, out_b) = protocol::encode_core_event(ev)
    emit_wire(out_j, payload=out_b)
    return
  }
  // NEVER mutate live `sess.cloud` origin/token BEFORE verifying `me.sub == db_account_sub`!
  // Capture `req_session_gen` & `captured_bearer_gen` BEFORE async I/O so any invalidate/stop/replace
  // drops stale callbacks and a stale manual sync NEVER overwrites a newer refreshed bearer token!
  let me_seq = sess.core.membership.next_cloud_seq()
  let req_session_gen = sess.session_gen
  let captured_bearer_gen = sess.bearer_gen
  let _ = sess.core.rt.fork_quiet_named("runtime:cloud.sync", fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    sync::fetch_me_structured_k(
      sess.sh,
      req_origin,
      eff_token,
      fn(ex : effect::Exit[Result[sync::CloudMe, sync::CloudHttpError]]) -> Unit {
        if sess.session_gen != req_session_gen || sess.core.membership.is_session_invalidated() {
          let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "session_invalidated", message: "session invalidated during cloud.sync" })
          let (out_j, out_b) = protocol::encode_core_event(ev)
          emit_wire(out_j, payload=out_b)
          fk(effect::Exit::Succeeded(()))
          return
        }
        match ex {
          effect::Exit::Failed(e) => {
            let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "cloud_error", message: effect_err_msg(e) })
            let (out_j, out_b) = protocol::encode_core_event(ev)
            emit_wire(out_j, payload=out_b)
            fk(effect::Exit::Succeeded(()))
          }
          effect::Exit::Interrupted => fk(effect::Exit::Interrupted)
          effect::Exit::Succeeded(Err(herr)) => {
            if herr.status == 401 {
              let active_sub = sess.core.membership.effective_sub()
              if active_sub.length() > 0 {
                runtime_refresh_account_token(sess, active_sub, fn(_ : Result[String, String]) -> Unit {})
              }
            }
            let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "cloud_error", message: herr.message })
            let (out_j, out_b) = protocol::encode_core_event(ev)
            emit_wire(out_j, payload=out_b)
            fk(effect::Exit::Succeeded(()))
          }
          effect::Exit::Succeeded(Ok(me)) => {
            match sess.core.commit_cloud_me(me, req_seq=me_seq, now_ms=pion_core_wall_now_ms()) {
              Err(msg) => {
                // `account_sub_mismatch` or commit failure: live `sess.cloud` remains 100% untouched!
                let err_code = if msg.starts_with("account_sub_mismatch") { "account_sub_mismatch" } else if msg.starts_with("account_sub_unbound") { "unauthenticated" } else { "cloud_error" }
                let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: err_code, message: msg })
                let (out_j, out_b) = protocol::encode_core_event(ev)
                emit_wire(out_j, payload=out_b)
                fk(effect::Exit::Succeeded(()))
                return
              }
              Ok(false) => {
                // Stale `/v1/me` discarded: suppress ALL side effects (live `sess.cloud`, viewer, topics untouched).
                let ok_ev = protocol::CoreEvent::Ok(id, base_codec::json_obj([("stale", base_codec::json_bool(true))]), None)
                let (out_j, out_b) = protocol::encode_core_event(ok_ev)
                emit_wire(out_j, payload=out_b)
                fk(effect::Exit::Succeeded(()))
                return
              }
              Ok(true) => ()
            }
            // Verified `me.sub == db_account_sub`: bind live `sess.cloud` without overwriting a newer
            // live bearer rotated by `AccountRefreshCoordinator` or `auth.complete` while in flight!
            let sess_sid = match sess.core.account_sessions.get(me.sub) { Some(s) => s; None => "" }
            let live_acct_token = {
              let mut latest = ""
              for ai in 0..<sess.accounts.length() {
                if sess.accounts[ai].sub == me.sub {
                  latest = sess.accounts[ai].access
                  break
                }
              }
              latest
            }
            let cs = match sess.cloud {
              Some(existing) => {
                let _ = existing.bind_account_context(me.sub, session=sess_sid)
                if candidate_token.length() > 0 && sess.bearer_gen == captured_bearer_gen {
                  sess.bearer_gen += 1L
                  existing.set_origin_and_token("", candidate_token)
                }
                existing
              }
              None => {
                let init_tok = if sess.bearer_gen != captured_bearer_gen && live_acct_token.length() > 0 {
                  live_acct_token
                } else if candidate_token.length() > 0 {
                  candidate_token
                } else if live_acct_token.length() > 0 {
                  live_acct_token
                } else {
                  eff_token
                }
                let created = sync::CloudSync::new(
                  sess.sh,
                  sess.db,
                  req_origin,
                  token=init_tok,
                  bound_sub=me.sub,
                  bound_session=sess_sid,
                )
                wire_live_cloud_sync(sess, created, me.sub, sess_sid)
                sess.cloud = Some(created)
                created
              }
            }
            if cs.token().length() > 0 && !cs.is_events_ws_running() {
              cs.start_events_ws(fn(_ev : sync::CloudEvent) -> Unit {})
            }
            let viewer_role = if me.workspaces.length() > 0 && me.workspaces[0].role.length() > 0 {
              me.workspaces[0].role
            } else {
              "member"
            }
            sess.core.set_viewer(me.email, sub=me.sub, role=viewer_role)
            let ws_target : Option[String] = match want_ws {
              Some(w) => if w.length() > 0 { Some(w) } else if me.workspaces.length() > 0 { Some(me.workspaces[0].id) } else { None }
              None => if me.workspaces.length() > 0 { Some(me.workspaces[0].id) } else { None }
            }
            match ws_target {
              None => {
                let ok_ev = protocol::CoreEvent::Ok(id, base_codec::json_obj([
                  ("sub", base_codec::json_str(me.sub)),
                  ("email", base_codec::json_str(me.email)),
                  ("workspaces", base_codec::json_int(me.workspaces.length())),
                  ("relays", base_codec::json_int(me.relays.length())),
                ]), None)
                let (out_j, out_b) = protocol::encode_core_event(ok_ev)
                emit_wire(out_j, payload=out_b)
                emit_topic_refresh(sess, "workspaces")
                fk(effect::Exit::Succeeded(()))
              }
              Some(wid) => {
                let ws_seq = sess.core.membership.next_cloud_seq()
                sync::fetch_workspace_structured_k(
                  sess.sh,
                  cs.origin(),
                  cs.token(),
                  wid,
                  fn(wex : effect::Exit[Result[sync::CloudWorkspace, sync::CloudHttpError]]) -> Unit {
                    if sess.session_gen != req_session_gen || sess.core.membership.is_session_invalidated() {
                      let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "session_invalidated", message: "session invalidated during cloud.sync" })
                      let (out_j, out_b) = protocol::encode_core_event(ev)
                      emit_wire(out_j, payload=out_b)
                      fk(effect::Exit::Succeeded(()))
                      return
                    }
                    match wex {
                      effect::Exit::Failed(e) => {
                        let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "cloud_error", message: effect_err_msg(e) })
                        let (out_j, out_b) = protocol::encode_core_event(ev)
                        emit_wire(out_j, payload=out_b)
                      }
                      effect::Exit::Interrupted => ()
                      effect::Exit::Succeeded(Err(herr)) => {
                        if herr.status == 403 || herr.status == 404 {
                          // Reconcile via `/v1/me` on 403/404; NEVER directly call `drop_workspace`!
                          cs.trigger_me_reconcile()
                        } else if herr.status == 401 {
                          runtime_refresh_account_token(sess, me.sub, fn(_ : Result[String, String]) -> Unit {})
                        }
                        let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "cloud_error", message: herr.message })
                        let (out_j, out_b) = protocol::encode_core_event(ev)
                        emit_wire(out_j, payload=out_b)
                      }
                      effect::Exit::Succeeded(Ok(ws)) => {
                        match sess.core.commit_cloud_workspace(ws, req_seq=ws_seq, now_ms=pion_core_wall_now_ms()) {
                          Err(msg) => {
                            let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "cloud_error", message: msg })
                            let (out_j, out_b) = protocol::encode_core_event(ev)
                            emit_wire(out_j, payload=out_b)
                          }
                          Ok(false) => {
                            // Explicitly treat rejected/stale workspace commit as stale without returning rejected metadata!
                            let ok_ev = protocol::CoreEvent::Ok(id, base_codec::json_obj([
                              ("sub", base_codec::json_str(me.sub)),
                              ("email", base_codec::json_str(me.email)),
                              ("workspaces", base_codec::json_int(me.workspaces.length())),
                              ("relays", base_codec::json_int(me.relays.length())),
                              ("workspace", base_codec::json_str(ws.id)),
                              ("stale", base_codec::json_bool(true)),
                            ]), None)
                            let (out_j, out_b) = protocol::encode_core_event(ok_ev)
                            emit_wire(out_j, payload=out_b)
                            emit_topic_refresh(sess, "workspaces")
                          }
                          Ok(true) => {
                            let ok_ev = protocol::CoreEvent::Ok(id, base_codec::json_obj([
                              ("sub", base_codec::json_str(me.sub)),
                              ("email", base_codec::json_str(me.email)),
                              ("workspaces", base_codec::json_int(me.workspaces.length())),
                              ("relays", base_codec::json_int(me.relays.length())),
                              ("workspace", base_codec::json_str(ws.id)),
                              ("members", base_codec::json_int(ws.members.length())),
                              ("stations", base_codec::json_int(ws.stations.length())),
                            ]), None)
                            let (out_j, out_b) = protocol::encode_core_event(ok_ev)
                            emit_wire(out_j, payload=out_b)
                            emit_topic_refresh(sess, "workspaces")
                            emit_topic_refresh(sess, "workspace")
                            emit_topic_refresh(sess, "stations")
                            emit_topic_refresh(sess, "chats")
                          }
                        }
                      }
                    }
                    fk(effect::Exit::Succeeded(()))
                  },
                )
              }
            }
          }
        }
      },
    )
  })
}

/// Finalize a Cloud-verified OAuth token exchange (`POST <origin>/v1/auth/token`) with strict
/// transactional ordering and unified `login_gen` fencing:
/// 1. Stage candidate `account-<sanitized_sub>.db` (open + migrate) + async host pending purges
///    BEFORE writing `accounts` (if DB open/migrate fails, 0 bytes written to `accounts`!).
/// 2. Under both in-process dir semaphore and cross-process `flock`, re-verify `sess.login_gen`
///    and `db_account_sub` compatibility BEFORE persisting `accounts` CAS (if raced or write fails,
///    close staged DB and keep read gate CLOSED!).
/// 3. After disk write succeeds: increment `login_gen`/`session_gen`/`bearer_gen`, atomically
///    install ALL runtime holders (`sess.db`, `sess.core.db`, `sess.cloud`, `auth_store`, `viewer`,
///    `unauthenticated = false`), and ONLY AS THE FINAL STEP emit `sess.core.auth.bump_all()`!
fn finish_verified_auth_complete_k(
  sess : RuntimeSession,
  id : Int64,
  req_login_gen : Int64,
  req_origin : String,
  new_stored : views::StoredAccount,
  session_id : String,
  return_to : String,
  done : () -> Unit,
) -> Unit {
  if sess.login_gen != req_login_gen {
    let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
      code: "login_expired",
      message: "登录已过期，请重新登录",
    })
    let (out_j, out_b) = protocol::encode_core_event(ev)
    emit_wire(out_j, payload=out_b)
    done()
    return
  }
  match sess.core.db_account_sub {
    Some(existing) => if existing != new_stored.sub {
      let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
        code: "account_sub_mismatch",
        message: "account_sub_mismatch: expected " + existing + ", got " + new_stored.sub,
      })
      let (out_j, out_b) = protocol::encode_core_event(ev)
      emit_wire(out_j, payload=out_b)
      done()
      return
    }
    None => ()
  }
  // Step 1: Stage fallible DB open/migration + async host purge reads BEFORE touching disk `accounts`!
  runtime_stage_account_db_k(sess, new_stored.sub, fn(stage_res : Result[Option[StagedAccountDb], String]) -> Unit {
    let staged_opt = match stage_res {
      Err(msg) => {
        let err_code = if msg.starts_with("account_sub_mismatch") { "account_sub_mismatch" } else { "sql_error" }
        let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: err_code, message: msg })
        let (out_j, out_b) = protocol::encode_core_event(ev)
        emit_wire(out_j, payload=out_b)
        done()
        return
      }
      Ok(s) => s
    }
    if sess.login_gen != req_login_gen {
      close_staged_db(staged_opt)
      let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
        code: "login_expired",
        message: "登录已过期，请重新登录",
      })
      let (out_j, out_b) = protocol::encode_core_event(ev)
      emit_wire(out_j, payload=out_b)
      done()
      return
    }
    // Step 2: Acquire shared dir lock + cross-process `flock`, re-verify `login_gen` & `db_account_sub`
    // inside the lock BEFORE writing `accounts`!
    sess.refresh_coord.upsert_account_cas_k(
      fn(rk : (sync::HostStorageRead) -> Unit) -> Unit {
        read_storage_json_state_k(sess.sh, "accounts", rk)
      },
      fn(doc : base_codec::Json, wk : (Result[Unit, String]) -> Unit) -> Unit {
        write_storage_json_k(sess.sh, "accounts", doc, wk)
      },
      new_stored,
      session_id,
      fn(ures : Result[(Array[views::StoredAccount], Map[String, String]), String]) -> Unit {
        match ures {
          Err(msg) => {
            close_staged_db(staged_opt)
            let err_code = if msg == "login_expired" {
              "login_expired"
            } else if msg.starts_with("account_sub_mismatch") {
              "account_sub_mismatch"
            } else {
              "storage_error"
            }
            let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
              code: err_code,
              message: msg,
            })
            let (out_j, out_b) = protocol::encode_core_event(ev)
            emit_wire(out_j, payload=out_b)
            done()
            return
          }
          Ok((all_accts, all_sessions)) => {
            if sess.login_gen != req_login_gen {
              close_staged_db(staged_opt)
              let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "login_expired",
                message: "登录已过期，请重新登录",
              })
              let (out_j, out_b) = protocol::encode_core_event(ev)
              emit_wire(out_j, payload=out_b)
              done()
              return
            }
            // Step 3: Commit runtime state atomically BEFORE firing auth boundary!
            sess.login_gen += 1L
            let _ = bump_runtime_session_gen(sess)
            sess.bearer_gen += 1L
            match runtime_install_staged_db_now(sess, new_stored.sub, staged_opt) {
              Err(msg) => {
                let err_code = if msg.starts_with("account_sub_mismatch") { "account_sub_mismatch" } else { "sql_error" }
                let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: err_code, message: msg })
                let (out_j, out_b) = protocol::encode_core_event(ev)
                emit_wire(out_j, payload=out_b)
                done()
                return
              }
              Ok(_) => ()
            }
            sess.core.membership.clear_session_invalidated()
            sess.core.membership.set_unauthenticated(false)
            sync_mem_accounts_from_list(sess, all_accts, all_sessions)
            sess.core.set_viewer(new_stored.email, sub=new_stored.sub)
            sess.core.login_flow.mark_completed(new_stored.sub, return_to)
            let _ = store::put_account_doc(
              sess.db,
              "accounts",
              base_codec::json_stringify(views::project_accounts_topic(sess.core.auth_store)),
            )
            if new_stored.access.length() > 0 && req_origin.length() > 0 {
              let cs = match sess.cloud {
                Some(existing) => {
                  existing.switch_db(sess.db)
                  let _ = existing.bind_account_context(new_stored.sub, session=session_id)
                  existing.set_origin_and_token("", new_stored.access)
                  existing
                }
                None => {
                  let created = sync::CloudSync::new(
                    sess.sh,
                    sess.db,
                    req_origin,
                    token=new_stored.access,
                    bound_sub=new_stored.sub,
                    bound_session=session_id,
                  )
                  wire_live_cloud_sync(sess, created, new_stored.sub, session_id)
                  sess.cloud = Some(created)
                  created
                }
              }
              if cs.origin().length() > 0 {
                cs.restart_events_ws(fn(_ev : sync::CloudEvent) -> Unit {})
              }
            }
            // Step 4 (FINAL): Now that `sess.db`, `sess.core.db`, `sess.cloud`, `auth_store`, and
            // `viewer` are ALL installed, emit the authoritative auth boundary + `Ok` reply!
            let _ = sess.core.auth.bump_all()
            // NEVER expose `access_token`, `refresh_token`, `code`, or `verifier`!
            let account_view = base_codec::json_obj([
              ("sub", base_codec::json_str(new_stored.sub)),
              ("email", base_codec::json_str(new_stored.email)),
              ("name", base_codec::json_str(new_stored.name)),
              ("picture", base_codec::json_str(new_stored.picture)),
            ])
            let ok_ev = protocol::CoreEvent::Ok(id, base_codec::json_obj([
              ("ok", base_codec::json_bool(true)),
              ("account", account_view),
              ("returnTo", base_codec::json_str(return_to)),
            ]), None)
            let (out_j, out_b) = protocol::encode_core_event(ok_ev)
            emit_wire(out_j, payload=out_b)
            emit_topic_refresh(sess, "accounts")
            emit_topic_refresh(sess, "workspaces")
            done()
          }
        }
      },
      pre_write_check=Some(fn() -> Result[Unit, String] {
        if sess.login_gen != req_login_gen {
          return Err("login_expired")
        }
        match sess.core.db_account_sub {
          Some(existing) => if existing != new_stored.sub {
            return Err("account_sub_mismatch: expected " + existing + ", got " + new_stored.sub)
          }
          None => ()
        }
        Ok(())
      }),
    )
  })
}

/// Complete an OAuth PKCE callback in production native ABI (`apps/mbui/src/sfcore/signin.mbt:432`
/// & `client/core-ts/src/accounts.ts:230-252`):
/// ALWAYS verifies callback state and exchanges `(code, code_verifier, redirect_uri)` via real
/// Cloud `POST <origin>/v1/auth/token`! NEVER trusts caller-supplied `params.sub` / `params.email`
/// / `params.access` to bypass Cloud verification!
fn handle_auth_complete_call(sess : RuntimeSession, id : Int64, params : base_codec::Json) -> Unit {
  let outcome = match opt_str_param(params, "query") {
    Some(q) => sess.core.login_flow.complete_oauth_query(q)
    None => {
      let cb_state = match opt_str_param(params, "state") { Some(s) => s; None => "" }
      let code = opt_str_param(params, "code")
      let err_opt = opt_str_param(params, "error")
      sess.core.login_flow.complete_oauth_callback(cb_state, code, err_opt)
    }
  }
  if !outcome.ok {
    let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
      code: outcome.error_code,
      message: outcome.recovery_hint,
    })
    let (out_j, out_b) = protocol::encode_core_event(ev)
    emit_wire(out_j, payload=out_b)
    return
  }
  let req_origin = if sess.origin.length() > 0 { sess.origin } else { sess.core.cloud_origin }
  if outcome.code.length() == 0 || req_origin.length() == 0 {
    let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
      code: "login_expired",
      message: "登录已过期，请重新登录",
    })
    let (out_j, out_b) = protocol::encode_core_event(ev)
    emit_wire(out_j, payload=out_b)
    return
  }
  let req_login_gen = sess.login_gen
  let _ = sess.core.rt.fork_quiet_named("runtime:auth.complete", fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    sync::exchange_auth_code_k(
      sess.sh,
      req_origin,
      outcome.code,
      outcome.verifier,
      outcome.redirect_uri,
      fn(ex : effect::Exit[Result[sync::AuthTokenExchange, sync::CloudHttpError]]) -> Unit {
        if sess.login_gen != req_login_gen {
          let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
            code: "login_expired",
            message: "登录已过期，请重新登录",
          })
          let (out_j, out_b) = protocol::encode_core_event(ev)
          emit_wire(out_j, payload=out_b)
          fk(effect::Exit::Succeeded(()))
          return
        }
        match ex {
          effect::Exit::Succeeded(Ok(tok)) => {
            if tok.subject.length() == 0 || tok.access_token.length() == 0 {
              let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "login_expired",
                message: "登录已过期，请重新登录",
              })
              let (out_j, out_b) = protocol::encode_core_event(ev)
              emit_wire(out_j, payload=out_b)
              fk(effect::Exit::Succeeded(()))
              return
            }
            let session_id = sync::generate_ulid(pion_core_wall_now_ms(), sess.sh.random(16))
            let eff_name = if tok.name.length() > 0 { tok.name } else { tok.email }
            let new_stored = views::StoredAccount::{
              sub: tok.subject,
              email: tok.email,
              name: eff_name,
              picture: tok.picture,
              access: tok.access_token,
              refresh: tok.refresh_token,
              access_expires: tok.expires_at,
            }
            finish_verified_auth_complete_k(
              sess,
              id,
              req_login_gen,
              req_origin,
              new_stored,
              session_id,
              outcome.return_to,
              fn() -> Unit { fk(effect::Exit::Succeeded(())) },
            )
            return
          }
          _ => {
            let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
              code: "login_expired",
              message: "登录已过期，请重新登录",
            })
            let (out_j, out_b) = protocol::encode_core_event(ev)
            emit_wire(out_j, payload=out_b)
          }
        }
        fk(effect::Exit::Succeeded(()))
      },
    )
  })
}

fn evaluate_runtime_topic(
  sess : RuntimeSession,
  id : Int64,
  topic : protocol::Topic,
  changed_keys : Option[Array[(String, String)]] = None,
) -> Option[protocol::CoreEvent] {
  let tname = topic.name
  let lang = sess_lang(sess)
  let now_ms = pion_core_wall_now_ms()
  let utc_offset_min = pion_core_utc_offset_min(now_ms)

  if tname == "chats" {
    match sync::chats_unsupported_param(topic) {
      Some(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "unsupported", message: msg }))
      None => ()
    }
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => sess.core.workspace
    }
    let mine_only = match topic.param("mine") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let watching_only = match topic.param("watching") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let hidden_mode = match topic.param("hidden") {
      Some(base_codec::Json::Bool(true)) => 1
      _ => 0
    }
    let briefs = station_briefs_live(sess, ws_scope)
    match views::project_chats(
      sess.db,
      ws_scope,
      briefs,
      now_ms,
      sess.core.rows_memo,
      sess.core.viewer_marks,
      mine_only=mine_only,
      watching_only=watching_only,
      hidden_mode=hidden_mode,
      tz_offset_ms=utc_offset_min.to_int64() * 60000L,
      changed_keys=changed_keys,
      lang=lang,
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if tname == "chat" {
    let st = match topic.param("station") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else { sess.core.station }
      _ => sess.core.station
    }
    let th_param : Option[Int] = match topic.param("thread") {
      Some(base_codec::Json::Num(n, _)) => Some(n.to_int())
      _ => None
    }
    let sess_param : Option[String] = match topic.param("session") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => match topic.param("key") {
        Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
        _ => None
      }
    }
    if th_param.is_none() && sess_param.is_none() {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    let (consistent_st, consistent_th, consistent_sess) = match sess.core.resolve_consistent_chat_target(st, th_param, sess_param) {
      Ok(t) => t
      Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "chat_selector_mismatch", message: msg }))
    }
    let (resolved_st, resolved_th, chat_meta) = resolve_thread_and_chat_meta(sess, consistent_st, consistent_th, consistent_sess)
    // Authorize BOTH input AND final moved destination!
    if !sess.core.can_read_station(st) || !sess.core.can_read_station(resolved_st) {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    let compact = match topic.param("compact") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let online = is_station_online(sess, resolved_st)
    let ws_of_st = match resolved_st.index_of("/") {
      idx if idx > 0 => resolved_st.slice(0, idx)
      _ => sess.core.workspace
    }
    let briefs = station_briefs_live(sess, ws_of_st)
    let mut sname = resolved_st
    for i in 0..<briefs.length() {
      if briefs[i].address == resolved_st {
        sname = briefs[i].name
        break
      }
    }
    let rows_lim = sess.core.chat_sub_window_rows_for(id, resolved_st, resolved_th, consistent_sess)
    match views::project_chat_by_params(
      sess.db,
      resolved_st,
      resolved_th,
      consistent_sess,
      compact,
      sess_viewer_email(sess),
      now_ms,
      rows=rows_lim,
      at=None,
      at_offset=None,
      utc_offset_min=utc_offset_min,
      lang=lang,
      online=online,
      station_name=sname,
      chat_meta=chat_meta,
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if tname == "stations" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => sess.core.workspace
    }
    if sess.core.membership.is_unauthenticated() || sess.core.membership.is_session_invalidated() || (ws_scope.length() > 0 && !sess.core.can_read_workspace(ws_scope)) {
      return Some(protocol::CoreEvent::Value(id, base_codec::json_arr([]), None))
    }
    let prefix = if ws_scope.length() > 0 { ws_scope + "/" } else { "" }
    let overview_by_addr : Map[String, base_codec::Json] = Map::new()
    let overview_addrs : Array[String] = []
    match store::list_stations(sess.db, kind="overview") {
      sql::SqlResult::Ok(rows) => {
        for i in 0..<rows.length() {
          let r = rows[i]
          if prefix.length() > 0 && !r.address.starts_with(prefix) {
            continue
          }
          if !sess.core.can_read_station(r.address) {
            continue
          }
          let doc = match base_codec::json_parse(r.json) {
            base_codec::JsonParseResult::Ok(j) => j
            base_codec::JsonParseResult::Err(_) => base_codec::json_null()
          }
          overview_by_addr.set(r.address, doc)
          overview_addrs.push(r.address)
        }
      }
      sql::SqlResult::Err(_) => ()
    }
    let out : Array[base_codec::Json] = []
    let seen : Map[String, Bool] = Map::new()
    let push_station_item = fn(addr : String, sid : String, fallback_name : String, doc : base_codec::Json) -> Unit {
      let sname = match opt_str_param(doc, "name") {
        Some(s) => s
        None => if fallback_name.length() > 0 { fallback_name } else { sid }
      }
      let online = is_station_online(sess, addr)
      let st_txt = if online {
        if lang == "en" { "Online" } else { "在线" }
      } else {
        if lang == "en" { "Offline" } else { "离线" }
      }
      let joined = match base_codec::json_get(doc, "joined") { Some(base_codec::Json::Bool(b)) => b; _ => false }
      let mine = match base_codec::json_get(doc, "mine") { Some(base_codec::Json::Bool(b)) => b; _ => false }
      let accept_auto = match base_codec::json_get(doc, "acceptAutoChats") { Some(base_codec::Json::Bool(b)) => b; _ => false }
      let problems = match base_codec::json_get(doc, "problems") { Some(base_codec::Json::Arr(xs)) => base_codec::json_arr(xs); _ => base_codec::json_arr([]) }
      let sf : Array[(String, base_codec::Json)] = [
        ("station", base_codec::json_str(addr)),
        ("id", base_codec::json_str(sid)),
        ("name", base_codec::json_str(sname)),
        ("summary", base_codec::json_str(st_txt)),
        ("online", base_codec::json_bool(online)),
        ("reconnecting", base_codec::json_bool(false)),
        ("stateText", base_codec::json_str(st_txt)),
        ("stateBusy", base_codec::json_bool(false)),
        ("problems", problems),
        ("joined", base_codec::json_bool(joined)),
        ("mine", base_codec::json_bool(mine)),
        ("acceptAutoChats", base_codec::json_bool(accept_auto)),
      ]
      match opt_str_param(doc, "emoji") { Some(e) => sf.push(("emoji", base_codec::json_str(e))); None => () }
      match opt_str_param(doc, "icon") { Some(ic) => sf.push(("icon", base_codec::json_str(ic))); None => () }
      match opt_str_param(doc, "version") { Some(v) => sf.push(("version", base_codec::json_str(v))); None => () }
      match base_codec::json_get(doc, "counts") { Some(c) => sf.push(("counts", c)); None => () }
      out.push(base_codec::json_obj(sf))
    }
    if ws_scope.length() > 0 {
      let cloud_sts = sync::list_workspace_stations(sess.db, ws_scope)
      for i in 0..<cloud_sts.length() {
        let cs = cloud_sts[i]
        let addr = sync::canonical_station(ws_scope, cs.id)
        if addr.length() == 0 || !sess.core.can_read_station(addr) {
          continue
        }
        seen.set(addr, true)
        let doc = match overview_by_addr.get(addr) { Some(d) => d; None => base_codec::json_null() }
        push_station_item(addr, cs.id, cs.name, doc)
      }
    }
    for i in 0..<overview_addrs.length() {
      let addr = overview_addrs[i]
      if seen.get(addr).is_some() {
        continue
      }
      let doc = match overview_by_addr.get(addr) { Some(d) => d; None => base_codec::json_null() }
      let sid = match opt_str_param(doc, "id") {
        Some(s) => s
        None => if prefix.length() > 0 && addr.starts_with(prefix) { addr.slice(prefix.length(), addr.length()) } else { addr }
      }
      push_station_item(addr, sid, sid, doc)
    }
    return Some(protocol::CoreEvent::Value(id, base_codec::json_arr(out), None))
  }
  handle_runtime_subscribe(sess, id, topic)
}

fn handle_runtime_subscribe(_sess : RuntimeSession, id : Int64, topic : protocol::Topic) -> Option[protocol::CoreEvent] {
  let tname = topic.name
  let val_opt : Option[base_codec::Json] = if tname == "driveTransfers" {
    Some(base_codec::json_obj([
      ("supported", base_codec::json_bool(false)),
      ("loaded", base_codec::json_bool(false)),
      ("transfers", base_codec::json_arr([])),
    ]))
  } else if tname == "newChat" {
    Some(build_new_chat_view())
  } else if tname == "adbShare" {
    Some(base_codec::json_obj([
      ("sharing", base_codec::json_bool(false)),
      ("phase", base_codec::json_str("off")),
      ("tunnels", base_codec::json_int(0)),
      ("on", base_codec::json_bool(false)),
      ("grants", base_codec::json_arr([])),
      ("wanted", base_codec::json_arr([])),
      ("known", base_codec::json_bool(true)),
      ("lends", base_codec::json_arr([])),
      ("screens", base_codec::json_arr([])),
      ("personal", base_codec::json_arr([])),
      ("toConfirm", base_codec::json_int(0)),
    ]))
  } else if tname == "releases" {
    Some(base_codec::json_obj([("told", base_codec::json_int(0))]))
  } else if tname == "decisions" {
    Some(base_codec::json_obj([("items", base_codec::json_arr([]))]))
  } else {
    None
  }
  match val_opt {
    Some(v) => Some(protocol::CoreEvent::Value(id, v, None))
    None => None
  }
}

/// Dispatch one JSON + optional binary message from `mb_core_send` on the core thread.
pub extern "C" fn pion_core_runtime_send(
  json : Ptr,
  len : Int64,
  bytes : Ptr,
  blen : Int64,
) -> Unit {
  let sess = match g_session[0] {
    Some(s) => s
    None => {
      emit_fatal("core runtime not started")
      return
    }
  }
  let json_text = ptr_to_string(json, len)
  let payload = if !ptr_is_null(bytes) && blen > 0.to_int64() {
    Some(bytes_from_ptr(bytes, blen.to_int()))
  } else {
    None
  }
  let raw = match base_codec::json_parse(json_text) {
    base_codec::JsonParseResult::Err(_) => return
    base_codec::JsonParseResult::Ok(j) => j
  }
  let parsed = protocol::parse_client_message(raw, bytes=payload)
  match parsed {
    protocol::ParseRequestResult::Invalid(msg) => {
      match protocol::wire_error_id(raw) {
        Some(err_id) => {
          let ev = protocol::CoreEvent::Err(err_id, protocol::CoreError::{ code: "bad_message", message: msg })
          let (out_j, out_b) = if base_codec::json_get(raw, "subscribe").is_some() {
            protocol::encode_sub_event_with_auth(ev, sess.core.wire_out_gen_for_raw_subscribe(raw))
          } else {
            protocol::encode_core_event(ev)
          }
          emit_wire(out_j, payload=out_b)
        }
        None => ()
      }
    }
    protocol::ParseRequestResult::Ok(req) => {
      match req {
        protocol::CoreRequest::Subscribe(id, topic, keyed, _from_id, have) => {
          sess.core.drop_chat_sub_snapshot(id)
          match evaluate_runtime_topic(sess, id, topic) {
            Some(ev) => {
              let val_opt : Option[base_codec::Json] = match ev {
                protocol::CoreEvent::Value(_, v, _) => Some(v)
                _ => None
              }
              // Register live subscription in `sess.runtime_subs` (replacing any prior entry with same `id`).
              let mut replaced = false
              for i in 0..<sess.runtime_subs.length() {
                if sess.runtime_subs[i].id == id {
                  sess.runtime_subs[i] = RuntimeSub::{ id: id, topic: topic, keyed: keyed, last_val: val_opt }
                  replaced = true
                  break
                }
              }
              if !replaced {
                sess.runtime_subs.push(RuntimeSub::{ id: id, topic: topic, keyed: keyed, last_val: val_opt })
              }
              let allow_kept = !protocol::is_sensitive_topic(topic) && !sync::is_vault_topic(topic.name)
              let out_ev = if allow_kept {
                match (have, val_opt) {
                  (Some(tok), Some(cur_val)) => match sess.kept_vals.get(runtime_kept_key(topic, tok)) {
                    Some(prev_val) => {
                      if protocol::json_equal(prev_val, cur_val) {
                        protocol::CoreEvent::Same(id)
                      } else if keyed {
                        let ops = protocol::diff_keyed(prev_val, cur_val, protocol::spec_for_topic(topic.name))
                        protocol::CoreEvent::Delta(id, ops, None, true)
                      } else {
                        ev
                      }
                    }
                    None => ev
                  }
                  _ => ev
                }
              } else {
                ev
              }
              let (out_j, out_b) = sess.core.encode_sub_event(topic, out_ev)
              emit_wire(out_j, payload=out_b)
              let _ = drain_and_emit(sess)
              flush_session_md_stores(sess)
              return
            }
            None => {
              // Falling back to `sess.core`: drop any stale runtime subscription with the same `id`.
              let _ = remove_runtime_sub(sess, id)
            }
          }
        }
        protocol::CoreRequest::Unsubscribe(id, _, keep) => {
          match remove_runtime_sub(sess, id) {
            Some(removed) => {
              sess.core.close_chat_sub_snapshot(id)
              if keep {
                let allow_keep = !protocol::is_sensitive_topic(removed.topic) && !sync::is_vault_topic(removed.topic.name)
                if allow_keep {
                  match removed.last_val {
                    Some(v) => {
                      let tok = protocol::value_token(v)
                      kept_put(sess, tok, removed.topic, v)
                      let (uj, ub) = sess.core.encode_sub_event(removed.topic, protocol::CoreEvent::Unsubscribed(id, Some(tok)))
                      emit_wire(uj, payload=ub)
                    }
                    None => {
                      let (uj, ub) = sess.core.encode_sub_event(removed.topic, protocol::CoreEvent::Unsubscribed(id, None))
                      emit_wire(uj, payload=ub)
                    }
                  }
                } else {
                  let (uj, ub) = sess.core.encode_sub_event(removed.topic, protocol::CoreEvent::Unsubscribed(id, None))
                  emit_wire(uj, payload=ub)
                }
              }
              let _ = drain_and_emit(sess)
              return
            }
            None => ()
          }
        }
        protocol::CoreRequest::Call(id, call_name, params, _) => {
          if call_name == "cloud.sync" {
            handle_cloud_sync_call(sess, id, params)
            let _ = drain_and_emit(sess)
            return
          }
          if call_name == "auth.complete" {
            // Production native ABI ALWAYS requires real Cloud `/v1/auth/token` exchange:
            // NEVER trusts caller RPC `params.sub` / `params.email` / `params.access`!
            handle_auth_complete_call(sess, id, params)
            let _ = drain_and_emit(sess)
            return
          }
          if call_name == "auth.refresh" {
            let sub = match opt_str_param(params, "sub") {
              Some(s) => if s.length() > 0 { s } else { sess_viewer_sub(sess) }
              None => sess_viewer_sub(sess)
            }
            if sub.length() == 0 {
              let err_ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing sub" })
              let (out_j, out_b) = protocol::encode_core_event(err_ev)
              emit_wire(out_j, payload=out_b)
              return
            }
            runtime_refresh_account_token(sess, sub, fn(res : Result[String, String]) -> Unit {
              let ev = match res {
                Ok(_) => protocol::CoreEvent::Ok(id, base_codec::json_obj([("ok", base_codec::json_bool(true))]), None)
                Err(msg) => protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "auth_error", message: msg })
              }
              let (out_j, out_b) = protocol::encode_core_event(ev)
              emit_wire(out_j, payload=out_b)
            })
            let _ = drain_and_emit(sess)
            return
          }
          if call_name == "station.connect" {
            if sess.core.membership.is_unauthenticated() || sess.core.membership.is_session_invalidated() {
              let err_code = if sess.core.membership.is_unauthenticated() { "unauthenticated" } else { "access_revoked" }
              let err_msg = if sess.core.membership.is_unauthenticated() { "account not signed in" } else { "workspace access revoked" }
              let err_ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: err_code,
                message: err_msg,
              })
              let (out_j, out_b) = protocol::encode_core_event(err_ev)
              emit_wire(out_j, payload=out_b)
              return
            }
            let raw_target_st = match opt_str_param(params, "station") {
              Some(s) => if s.length() > 0 { s } else { sess.core.station }
              None => sess.core.station
            }
            let explicit_ws = match opt_str_param(params, "workspace") {
              Some(w) => w
              None => ""
            }
            if explicit_ws.length() == 0 && sess.core.membership.is_ambiguous_bare_station(raw_target_st) {
              let err_ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "station_workspace_mismatch",
                message: "ambiguous bare station requires explicit workspace",
              })
              let (out_j, out_b) = protocol::encode_core_event(err_ev)
              emit_wire(out_j, payload=out_b)
              return
            }
            let target_ws = if explicit_ws.length() > 0 {
              explicit_ws
            } else {
              sess.core.membership.station_workspace(raw_target_st, fallback_ws=sess.core.workspace)
            }
            if target_ws.length() == 0 {
              let err_ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "station_workspace_mismatch",
                message: "unresolved workspace for station",
              })
              let (out_j, out_b) = protocol::encode_core_event(err_ev)
              emit_wire(out_j, payload=out_b)
              return
            }
            if !sess.core.can_read_workspace(target_ws) || (explicit_ws.length() == 0 && !sess.core.can_read_station(raw_target_st)) {
              let err_ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "access_revoked",
                message: "workspace access revoked",
              })
              let (out_j, out_b) = protocol::encode_core_event(err_ev)
              emit_wire(out_j, payload=out_b)
              return
            }
            let target_st = match sess.core.membership.bind_station_checked(target_ws, raw_target_st) {
              Ok(canon) => canon
              Err(msg) => {
                let err_ev = protocol::CoreEvent::Err(id, protocol::CoreError::{
                  code: "station_workspace_mismatch",
                  message: msg,
                })
                let (out_j, out_b) = protocol::encode_core_event(err_ev)
                emit_wire(out_j, payload=out_b)
                return
              }
            }
            let _ = sess.core.membership.persist_station_bindings(sess.db)
            let peer_opt = match opt_str_param(params, "peerId") {
              Some(p) => if p.length() > 0 { Some(p) } else { None }
              None => match opt_str_param(params, "endpointId") {
                Some(p) => if p.length() > 0 { Some(p) } else { None }
                None => None
              }
            }
            let mut mode = "offline"
            match peer_opt {
              Some(peer_id) => {
                let relays : Array[String] = []
                match base_codec::json_get(params, "relays") {
                  Some(base_codec::Json::Arr(xs)) => {
                    for i in 0..<xs.length() {
                      match xs[i] {
                        base_codec::Json::Str(r) => if r.length() > 0 { relays.push(r) }
                        _ => ()
                      }
                    }
                  }
                  _ => ()
                }
                let static_cred = match opt_str_param(params, "credential") {
                  Some(c) => c
                  None => ""
                }
                if static_cred.length() > 0 {
                  // Only arms at initial `cred_epoch == 1`; NEVER re-arms stale static creds after epoch advance!
                  sess.core.membership.set_static_credential(target_ws, static_cred)
                }
                let cloud_ref = sess.cloud
                let core_ref = sess.core
                let get_cred = fn(dev_id : String, fresh : Bool, ck : (effect::Exit[String]) -> Unit) -> Unit {
                  if !core_ref.can_read_workspace(target_ws) {
                    ck(effect::Exit::Failed(effect::EffectError::Custom("workspace access revoked")))
                    return
                  }
                  if fresh {
                    let _ = core_ref.membership.bump_cred_epoch(target_ws)
                  } else {
                    match core_ref.membership.get_valid_static_credential(target_ws) {
                      Some(sc) => {
                        ck(effect::Exit::Succeeded(sc))
                        return
                      }
                      None => ()
                    }
                  }
                  let captured_epoch = core_ref.membership.cred_epoch_of(target_ws)
                  match cloud_ref {
                    Some(cs) => cs.fetch_member_credential_k(
                      target_ws,
                      dev_id,
                      pion_core_wall_now_ms() / 1000.to_int64(),
                      fn(ex : effect::Exit[sync::MemberCredential]) -> Unit {
                        if core_ref.membership.cred_epoch_of(target_ws) != captured_epoch || !core_ref.can_read_workspace(target_ws) {
                          ck(effect::Exit::Failed(effect::EffectError::Custom("cred_epoch_changed")))
                          return
                        }
                        match ex {
                          effect::Exit::Succeeded(mc) => ck(effect::Exit::Succeeded(mc.credential))
                          effect::Exit::Failed(e) => ck(effect::Exit::Failed(e))
                          effect::Exit::Interrupted => ck(effect::Exit::Interrupted)
                        }
                      },
                      fresh=fresh,
                    )
                    None => ck(effect::Exit::Failed(effect::EffectError::Custom("missing cloud client for credential")))
                  }
                }
                let cfg = sync::MeshStationConfig::new(
                  target_ws,
                  peer_id,
                  relays,
                  get_cred,
                  get_lock_carry=Some(fn() -> sync::MeshLockCarry {
                    sync::mesh_lock_carry_for_core(core_ref, workspace=target_ws)
                  }),
                )
                match sess.mesh_transports.get(target_st) {
                  Some(old_ctrl) => {
                    sess.core.detach_station_transport(target_st)
                    old_ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit {})
                  }
                  None => ()
                }
                let (ctrl, tr) = sync::shell_mesh_transport(sess.sh, cfg)
                sess.mesh_transports.set(target_st, ctrl)
                sess.core.attach_station_transport(target_st, tr, workspace=target_ws)
                mode = "mesh"
              }
              None => {
                if is_loopback_http_url(sess.origin) {
                  let http_tr = sync::shell_http_transport(sess.sh, sess.origin)
                  sess.core.events.set_transport(http_tr)
                  sess.core.sync.set_transport(http_tr)
                  mode = "loopback_http"
                }
              }
            }
            if !sess.live_sync_enabled {
              sess.live_sync_enabled = true
              sess.core.start()
            }
            let ok_ev = protocol::CoreEvent::Ok(id, base_codec::json_obj([
              ("connecting", base_codec::json_bool(true)),
              ("station", base_codec::json_str(target_st)),
              ("transport", base_codec::json_str(mode)),
            ]), None)
            let (out_j, out_b) = protocol::encode_core_event(ok_ev)
            emit_wire(out_j, payload=out_b)
            let _ = drain_and_emit(sess)
            return
          }
          if call_name == "station.disconnect" {
            let raw_target_st = match opt_str_param(params, "station") {
              Some(s) => if s.length() > 0 { s } else { sess.core.station }
              None => sess.core.station
            }
            let target_st = sess.core.membership.canonicalize(raw_target_st, fallback_ws=sess.core.workspace)
            let lookup_st = if sess.mesh_transports.get(target_st).is_some() { target_st } else { raw_target_st }
            match sess.mesh_transports.get(lookup_st) {
              Some(ctrl) => {
                sess.core.detach_station_transport(lookup_st)
                sess.mesh_transports.remove(lookup_st)
                ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit {})
              }
              None => ()
            }
            let ok_ev = protocol::CoreEvent::Ok(id, base_codec::json_obj([
              ("disconnected", base_codec::json_bool(true)),
              ("station", base_codec::json_str(lookup_st)),
            ]), None)
            let (out_j, out_b) = protocol::encode_core_event(ok_ev)
            emit_wire(out_j, payload=out_b)
            let _ = drain_and_emit(sess)
            return
          }
        }
        _ => ()
      }
      let refresh_info : Option[(String, Option[Array[(String, String)]])] = match req {
        protocol::CoreRequest::Call(_, call_name, params, _) => match affected_topic_for_call(call_name) {
          Some(tn) => {
            let ck : Option[Array[(String, String)]] = if tn == "chats" {
              match (opt_str_param(params, "station"), opt_str_param(params, "id")) {
                (Some(s), Some(cid)) => Some([(s, cid)])
                _ => match (opt_str_param(params, "station"), opt_str_param(params, "session")) {
                  (Some(s), Some(cid)) => Some([(s, cid)])
                  _ => match base_codec::json_get(params, "thread") {
                    Some(base_codec::Json::Num(n, _)) => {
                      let th = n.to_int()
                      let st_addr = match opt_str_param(params, "station") {
                        Some(s) => if s.length() > 0 { s } else { sess.core.station }
                        None => sess.core.station
                      }
                      match store::get_chat_by_thread(sess.db, st_addr, th) {
                        sql::SqlResult::Ok(Some(rec)) => Some([(st_addr, rec.id)])
                        _ => None
                      }
                    }
                    _ => None
                  }
                }
              }
            } else {
              None
            }
            Some((tn, ck))
          }
          None => None
        }
        _ => None
      }
      let sub_topic_opt : Option[protocol::Topic] = match req {
        protocol::CoreRequest::Subscribe(_, topic, _, _, _) => Some(topic)
        protocol::CoreRequest::Unsubscribe(id, _, _) => sess.core.router.active_sub_topic(id)
        _ => None
      }
      match sess.core.handle_request(req) {
        Some(ev) => {
          let (out_j, out_b) = match sub_topic_opt {
            Some(topic) => sess.core.encode_sub_event(topic, ev)
            None =>
            match ev {
              protocol::CoreEvent::Unsubscribed(_, _) =>
              protocol::encode_sub_event_with_auth(
                ev,
                protocol::WireOutGen::{ conn: sess.core.auth.conn_seq(), auth_gen: None, vault_gen: None },
              )
              _ => protocol::encode_core_event(ev)
            }
          }
          emit_wire(out_j, payload=out_b)
        }
        None => ()
      }
      let _ = drain_and_emit(sess)
      match refresh_info {
        Some((tname, ck)) => {
          emit_topic_refresh(sess, tname, changed_keys=ck)
          if tname == "chats" || tname == "chat" {
            emit_topic_refresh(sess, "workspaceMarks")
            emit_topic_refresh(sess, "chatRow")
          } else if tname == "prefs" {
            emit_topic_refresh(sess, "chats")
            emit_topic_refresh(sess, "workspaceMarks")
          } else if tname == "composer" {
            emit_topic_refresh(sess, "draft")
          } else if tname == "draft" {
            emit_topic_refresh(sess, "composer")
          } else if tname == "accounts" {
            emit_topic_refresh(sess, "workspaces")
          }
        }
        None => ()
      }
    }
  }
}

/// Stop the Pion `ClientCore`, `CloudSync`, all `MeshStationTransport` instances,
/// close SQLite, and stop the native Rust shell handle cleanly.
pub extern "C" fn pion_core_runtime_stop() -> Unit {
  match g_session[0] {
    Some(sess) => {
      let _ = bump_runtime_session_gen(sess)
      sess.live_sync_enabled = false
      let mkeys = sess.mesh_transports.keys()
      for i in 0..<mkeys.length() {
        let st = mkeys[i]
        match sess.mesh_transports.get(st) {
          Some(ctrl) => {
            sess.core.detach_station_transport(st)
            ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit {})
          }
          None => ()
        }
      }
      sess.mesh_transports.clear()
      match sess.cloud {
        Some(cs) => cs.stop()
        None => ()
      }
      sess.core.stop()
      sess.db.close()
      shell_native::stop()
      g_session[0] = None
    }
    None => ()
  }
}
