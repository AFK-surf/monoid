// High-frequency local store operations: draft persistence, thread read cursor updates,
// workspace preference settings (`workspace_pref`), indexed chat search (`chat_recent`),
// and message full-text search via the trigger-maintained `said` table.
// Never performs a full-table scan of `chat`.

import "base_codec"
import "sql"

pub fn sql_draft_put() -> String {
  "INSERT OR REPLACE INTO draft (station, chat, json) VALUES (?, ?, ?)"
}

pub fn sql_draft_delete() -> String {
  "DELETE FROM draft WHERE station = ? AND chat = ?"
}

pub fn sql_thread_set_read() -> String {
  "UPDATE thread SET read = ?, unread = ? WHERE station = ? AND id = ?"
}

pub fn sql_chat_set_unread() -> String {
  "UPDATE chat SET unread = ?1, tone = CASE WHEN ?1 = 0 AND tone = 'done' THEN NULL WHEN ?1 != 0 AND mine = 1 AND running = 0 AND tone IS NULL THEN 'done' ELSE tone END WHERE station = ?2 AND archived = 0 AND thread = ?3"
}

pub fn sql_pref_get() -> String {
  "SELECT json FROM workspace_pref WHERE workspace = ? AND key = ?"
}

pub fn sql_pref_all() -> String {
  "SELECT key, json FROM workspace_pref WHERE workspace = ? ORDER BY key"
}

pub fn sql_pref_put() -> String {
  "INSERT OR REPLACE INTO workspace_pref (workspace, key, json) VALUES (?, ?, ?)"
}

pub fn sql_pref_delete() -> String {
  "DELETE FROM workspace_pref WHERE workspace = ? AND key = ?"
}

pub fn sql_search_messages_station() -> String {
  "SELECT station, thread, seq, n, at, text FROM said WHERE station = ? AND instr(lower(text), lower(?)) > 0 ORDER BY at DESC, seq DESC LIMIT ?"
}

pub fn sql_search_messages_all() -> String {
  "SELECT station, thread, seq, n, at, text FROM said WHERE instr(lower(text), lower(?)) > 0 ORDER BY at DESC, seq DESC LIMIT ?"
}

/// Indexed chat search bounded by `chat_recent` (`archived = 0`, ordered by `pinned_at DESC, last_active DESC`).
pub fn sql_search_chats() -> String {
  "SELECT c.station, c.archived, c.id, c.thread, c.last_active, c.json " +
  "FROM chat AS c " +
  "WHERE c.archived = 0 AND instr(?1, char(1) || c.station || char(1)) > 0 " +
  "AND (?2 = '' OR instr(lower(coalesce(json_extract(c.json, '$.title'), c.id)), lower(?2)) > 0) " +
  "ORDER BY c.pinned_at DESC, c.last_active DESC LIMIT ?3"
}

pub struct PrefRow {
  pub workspace : String
  pub key : String
  pub json : String
}

pub struct SearchMessageHit {
  pub station : String
  pub thread : Int
  pub seq : Int
  pub n : Int
  pub at : Option[Int64]
  pub text : String
}

pub struct SearchChatHit {
  pub station : String
  pub archived : Int
  pub id : String
  pub thread : Option[Int]
  pub last_active : Int64
  pub json : String
}

/// Persist a local draft for `(station, chat)`.
pub fn put_draft(db : sql::Sql, station : String, chat : String, json : String) -> sql::SqlResult[Unit] {
  match db.run(sql_draft_put(), params=[
    base_codec::json_str(station),
    base_codec::json_str(chat),
    base_codec::json_str(json),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
  }
}

/// Remove a local draft for `(station, chat)`.
pub fn delete_draft(db : sql::Sql, station : String, chat : String) -> sql::SqlResult[Unit] {
  match db.run(sql_draft_delete(), params=[
    base_codec::json_str(station),
    base_codec::json_str(chat),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
  }
}

/// Update read cursor & unread count for `(station, thread)` atomically in one `Burst` transaction.
pub fn update_thread_read(
  db : sql::Sql,
  station : String,
  thread : Int,
  read_seq : Int,
  unread_count : Int,
) -> sql::SqlResult[Unit] {
  let burst = sql::Burst::new(db)
  burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
    match b.run(sql_thread_set_read(), params=[
      base_codec::json_int(read_seq),
      base_codec::json_int(unread_count),
      base_codec::json_str(station),
      base_codec::json_int(thread),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    match b.run(sql_chat_set_unread(), params=[
      base_codec::json_int(unread_count),
      base_codec::json_str(station),
      base_codec::json_int(thread),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    sql::SqlResult::Ok(())
  })
}

/// Read one workspace preference key from `workspace_pref`.
pub fn get_workspace_pref(db : sql::Sql, workspace : String, key : String) -> sql::SqlResult[Option[String]] {
  match db.all(sql_pref_get(), params=[base_codec::json_str(workspace), base_codec::json_str(key)]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      if rows.length() > 0 {
        sql::SqlResult::Ok(Some(sql::col_text(rows[0], 0)))
      } else {
        sql::SqlResult::Ok(None)
      }
    }
  }
}

/// List all workspace preferences for `workspace`, ordered by `key`.
pub fn list_workspace_prefs(db : sql::Sql, workspace : String) -> sql::SqlResult[Array[PrefRow]] {
  match db.all(sql_pref_all(), params=[base_codec::json_str(workspace)]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      let out : Array[PrefRow] = []
      for i in 0..<rows.length() {
        let r = rows[i]
        out.push(PrefRow::{
          workspace: workspace,
          key: sql::col_text(r, 0),
          json: sql::col_text(r, 1),
        })
      }
      sql::SqlResult::Ok(out)
    }
  }
}

/// Persist one workspace preference key in `workspace_pref`.
pub fn put_workspace_pref(db : sql::Sql, workspace : String, key : String, json : String) -> sql::SqlResult[Unit] {
  match db.run(sql_pref_put(), params=[
    base_codec::json_str(workspace),
    base_codec::json_str(key),
    base_codec::json_str(json),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
  }
}

/// Delete one workspace preference key from `workspace_pref`.
pub fn delete_workspace_pref(db : sql::Sql, workspace : String, key : String) -> sql::SqlResult[Unit] {
  match db.run(sql_pref_delete(), params=[
    base_codec::json_str(workspace),
    base_codec::json_str(key),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
  }
}

/// Search messages through the trigger-maintained SQLite `said` table.
pub fn search_messages(
  db : sql::Sql,
  query : String,
  station : Option[String] = None,
  limit : Int = 50,
) -> sql::SqlResult[Array[SearchMessageHit]] {
  if query.length() == 0 || limit <= 0 {
    return sql::SqlResult::Ok([])
  }
  let res = match station {
    Some(st) =>
    db.all(sql_search_messages_station(), params=[
      base_codec::json_str(st),
      base_codec::json_str(query),
      base_codec::json_int(limit),
    ])
    None =>
    db.all(sql_search_messages_all(), params=[
      base_codec::json_str(query),
      base_codec::json_int(limit),
    ])
  }
  match res {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      let out : Array[SearchMessageHit] = []
      for i in 0..<rows.length() {
        let r = rows[i]
        out.push(SearchMessageHit::{
          station: sql::col_text(r, 0),
          thread: sql::col_int(r, 1),
          seq: sql::col_int(r, 2),
          n: sql::col_int(r, 3),
          at: sql::col_opt_int64(r, 4),
          text: sql::col_text(r, 5),
        })
      }
      sql::SqlResult::Ok(out)
    }
  }
}

/// Search active chats across `stations` bounded by `chat_recent` index and `limit`.
pub fn search_chats(
  db : sql::Sql,
  stations : Array[String],
  query : String,
  limit : Int = 30,
) -> sql::SqlResult[Array[SearchChatHit]] {
  if stations.length() == 0 || limit <= 0 {
    return sql::SqlResult::Ok([])
  }
  match db.all(sql_search_chats(), params=[
    base_codec::json_str(in_order(stations)),
    base_codec::json_str(query),
    base_codec::json_int(limit),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      let out : Array[SearchChatHit] = []
      for i in 0..<rows.length() {
        let r = rows[i]
        let th = match sql::col_opt_int64(r, 3) {
          Some(v) => Some(v.to_int())
          None => None
        }
        out.push(SearchChatHit::{
          station: sql::col_text(r, 0),
          archived: sql::col_int(r, 1),
          id: sql::col_text(r, 2),
          thread: th,
          last_active: sql::col_int64(r, 4),
          json: sql::col_text(r, 5),
        })
      }
      sql::SqlResult::Ok(out)
    }
  }
}

/// Read `account_doc("conn_seq")`, increment monotonically (`1 -> 2 -> ...`), persist back, and return it.
pub fn load_and_bump_conn_seq(db : sql::Sql) -> Int64 {
  let prev : Int64 = match get_account_doc(db, "conn_seq") {
    sql::SqlResult::Ok(Some(raw)) => {
      let trimmed = raw.trim()
      match base_codec::parse_int64_str(trimmed) {
        Some(v) => if v > 0L { v } else { 0L }
        None =>
        match base_codec::json_parse(trimmed) {
          base_codec::JsonParseResult::Ok(base_codec::Json::Num(n, repr)) => {
            if repr.length() > 0 {
              match base_codec::parse_int64_str(repr) {
                Some(v) => if v > 0L { v } else { 0L }
                None => if n > 0.0 { n.to_int64() } else { 0L }
              }
            } else if n > 0.0 {
              n.to_int64()
            } else {
              0L
            }
          }
          base_codec::JsonParseResult::Ok(j) =>
          match base_codec::json_get(j, "conn") {
            Some(base_codec::Json::Num(n, repr)) => {
              if repr.length() > 0 {
                match base_codec::parse_int64_str(repr) {
                  Some(v) => if v > 0L { v } else { 0L }
                  None => if n > 0.0 { n.to_int64() } else { 0L }
                }
              } else if n > 0.0 {
                n.to_int64()
              } else {
                0L
              }
            }
            _ => 0L
          }
          _ => 0L
        }
      }
    }
    _ => 0L
  }
  let next = prev + 1L
  let _ = put_account_doc(db, "conn_seq", next.to_string())
  next
}

pub fn sql_drop_workspace_row() -> String {
  "DELETE FROM workspace WHERE id = ?"
}

pub fn sql_drop_workspace_prefs() -> String {
  "DELETE FROM workspace_pref WHERE workspace = ?"
}

pub fn sql_drop_workspace_vault_docs() -> String {
  "DELETE FROM account_doc WHERE name = ?1 OR substr(name, 1, length(?2)) = ?2 OR substr(name, 1, length(?3)) = ?3"
}

pub fn sql_drop_station_table_by_ws(table : String, col : String) -> String {
  "DELETE FROM " + table + " WHERE " + col + " = ?1 OR substr(" + col + ", 1, length(?2)) = ?2"
}

pub fn sql_drop_station_table_exact(table : String, col : String) -> String {
  "DELETE FROM " + table + " WHERE " + col + " = ?1"
}

pub fn sql_drop_moved_by_ws() -> String {
  "DELETE FROM moved WHERE station = ?1 OR substr(station, 1, length(?2)) = ?2 OR there_station = ?1 OR substr(there_station, 1, length(?2)) = ?2"
}

pub fn sql_drop_moved_exact() -> String {
  "DELETE FROM moved WHERE station = ?1 OR there_station = ?1"
}

fn delete_station_scoped_in_burst(
  b : sql::Burst,
  table : String,
  col : String,
  ws : String,
  ws_prefix : String,
  extra_stations : Array[String],
) -> sql::SqlResult[Unit] {
  match b.run(sql_drop_station_table_by_ws(table, col), params=[
    base_codec::json_str(ws),
    base_codec::json_str(ws_prefix),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  for i in 0..<extra_stations.length() {
    let st = extra_stations[i]
    if st.length() > 0 && st != ws && !st.starts_with(ws_prefix) {
      match b.run(sql_drop_station_table_exact(table, col), params=[base_codec::json_str(st)]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
  }
  sql::SqlResult::Ok(())
}

/// Atomically purge EVERY persisted row belonging to `ws` across all tables in `schema.pion`
/// (`workspace`, `station`, `slack_app`, `list`, `chat`, `session`, `thread`, `thread_member`,
/// `entry`, `transcript`, `job`, `outbox`, `pending`, `first`, `changing`, `draft`,
/// `workspace_pref`, `said`, `log_use`, `md_kept`, `moved`, `shared_sidecar`, `shared_mark`,
/// `shared_meta`, and workspace-scoped `account_doc` vault/me entries) in a single SQLite
/// transaction without altering any table or index definition (`chat_marks` untouched).
pub fn drop_workspace(
  db : sql::Sql,
  ws : String,
  extra_stations : Array[String] = [],
) -> sql::SqlResult[Unit] {
  if ws.length() == 0 {
    return sql::SqlResult::Ok(())
  }
  let ws_prefix = ws + "/"
  // Discover existing tables so optional ensured tables (`md_kept`, `shared_sidecar`, etc.)
  // never fail the atomic transaction on minimal DBs.
  let existing_tables : Map[String, Bool] = Map::new()
  let mut has_sqlite_master = false
  match db.all("SELECT name FROM sqlite_master WHERE type = 'table'") {
    sql::SqlResult::Ok(rows) => {
      if rows.length() > 0 {
        has_sqlite_master = true
        for i in 0..<rows.length() {
          existing_tables.set(sql::col_text(rows[i], 0), true)
        }
      }
    }
    sql::SqlResult::Err(_) => ()
  }
  let table_exists = fn(name : String) -> Bool {
    if !has_sqlite_master {
      true
    } else {
      existing_tables.get(name).is_some()
    }
  }

  // Pre-read `account_doc` documents that may embed workspace entries (`me`, `vault_status`, `vault_secrets`)
  // so scrubbing happens inside the exact same transaction.
  let next_me_raw : Option[String] = match get_account_doc(db, "me") {
    sql::SqlResult::Ok(Some(raw)) =>
    match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(base_codec::Json::Obj(fs)) => {
        let mut changed = false
        let next_fs : Array[(String, base_codec::Json)] = []
        for i in 0..<fs.length() {
          let (k, v) = fs[i]
          if k == "workspaces" {
            match v {
              base_codec::Json::Arr(xs) => {
                let kept : Array[base_codec::Json] = []
                for j in 0..<xs.length() {
                  let wid = match base_codec::json_get(xs[j], "id") {
                    Some(base_codec::Json::Str(s)) => s
                    _ => ""
                  }
                  if wid == ws {
                    changed = true
                  } else {
                    kept.push(xs[j])
                  }
                }
                next_fs.push((k, base_codec::json_arr(kept)))
              }
              _ => next_fs.push((k, v))
            }
          } else {
            next_fs.push((k, v))
          }
        }
        if changed { Some(base_codec::json_stringify(base_codec::json_obj(next_fs))) } else { None }
      }
      _ => None
    }
    _ => None
  }
  let drop_vault_status = match get_account_doc(db, "vault_status") {
    sql::SqlResult::Ok(Some(raw)) =>
    match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(j) =>
      match base_codec::json_get(j, "workspace") {
        Some(base_codec::Json::Str(w)) => w == ws
        _ => false
      }
      _ => false
    }
    _ => false
  }
  let next_vault_secrets_raw : Option[String] = match get_account_doc(db, "vault_secrets") {
    sql::SqlResult::Ok(Some(raw)) =>
    match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(base_codec::Json::Arr(xs)) => {
        let mut changed = false
        let kept : Array[base_codec::Json] = []
        for i in 0..<xs.length() {
          let item_ws = match base_codec::json_get(xs[i], "workspace") {
            Some(base_codec::Json::Str(s)) => s
            _ => ""
          }
          if item_ws == ws {
            changed = true
          } else {
            kept.push(xs[i])
          }
        }
        if changed { Some(base_codec::json_stringify(base_codec::json_arr(kept))) } else { None }
      }
      _ => None
    }
    _ => None
  }

  let burst = sql::Burst::new(db)
  burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
    // 1. Core workspace & preference rows
    if table_exists("workspace") {
      match b.run(sql_drop_workspace_row(), params=[base_codec::json_str(ws)]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
    if table_exists("workspace_pref") {
      match b.run(sql_drop_workspace_prefs(), params=[base_codec::json_str(ws)]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
    // 2. Station-scoped core tables (`station` uses column `address`; all others use `station`)
    if table_exists("station") {
      match delete_station_scoped_in_burst(b, "station", "address", ws, ws_prefix, extra_stations) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
    let core_station_tables = [
      "slack_app",
      "list",
      "chat",
      "session",
      "thread",
      "thread_member",
      "entry",
      "transcript",
      "job",
      "outbox",
      "pending",
      "first",
      "changing",
      "draft",
    ]
    for i in 0..<core_station_tables.length() {
      let tbl = core_station_tables[i]
      if table_exists(tbl) {
        match delete_station_scoped_in_burst(b, tbl, "station", ws, ws_prefix, extra_stations) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(_) => ()
        }
      }
    }
    // 3. Optional ensured tables (`said`, `log_use`, `md_kept`, `moved`, `shared_sidecar`, `shared_mark`, `shared_meta`)
    let opt_station_tables = [
      "said",
      "log_use",
      "md_kept",
      "shared_sidecar",
      "shared_mark",
      "shared_meta",
    ]
    for i in 0..<opt_station_tables.length() {
      let tbl = opt_station_tables[i]
      if table_exists(tbl) {
        match delete_station_scoped_in_burst(b, tbl, "station", ws, ws_prefix, extra_stations) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(_) => ()
        }
      }
    }
    if table_exists("moved") {
      match b.run(sql_drop_moved_by_ws(), params=[
        base_codec::json_str(ws),
        base_codec::json_str(ws_prefix),
      ]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
      for i in 0..<extra_stations.length() {
        let st = extra_stations[i]
        if st.length() > 0 && st != ws && !st.starts_with(ws_prefix) {
          match b.run(sql_drop_moved_exact(), params=[base_codec::json_str(st)]) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => ()
          }
        }
      }
    }
    // 4. Workspace-scoped `account_doc` vault documents and `me` workspace entry
    if table_exists("account_doc") {
      match b.run(sql_drop_workspace_vault_docs(), params=[
        base_codec::json_str("vaults:" + ws),
        base_codec::json_str("vault:" + ws + "/"),
        base_codec::json_str("vaults:" + ws + "/"),
      ]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
      if drop_vault_status {
        match b.run("DELETE FROM account_doc WHERE name = ?", params=[base_codec::json_str("vault_status")]) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(_) => ()
        }
      }
      match next_vault_secrets_raw {
        Some(raw) =>
        match b.run(sql_account_doc_put(), params=[
          base_codec::json_str("vault_secrets"),
          base_codec::json_str(raw),
          base_codec::json_null(),
        ]) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(_) => ()
        }
        None => ()
      }
      match next_me_raw {
        Some(raw) =>
        match b.run(sql_account_doc_put(), params=[
          base_codec::json_str("me"),
          base_codec::json_str(raw),
          base_codec::json_null(),
        ]) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(_) => ()
        }
        None => ()
      }
    }
    sql::SqlResult::Ok(())
  })
}
