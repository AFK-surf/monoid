// Indexed chat list window, keyed chat lookups, local overlays (`outbox`/`pending`/`draft`),
// and `account_doc` reads aligned with `client/core-ts/src/db/chat-reads.ts`.
// Never performs a full-table scan of `chat`.

import "base_codec"
import "sql"

/// Encode ordered stations as `\x01s1\x01s2\x01` (chat-reads.ts `inOrder`).
pub fn in_order(stations : Array[String]) -> String {
  let sb = StringBuilder::new()
  sb.write_byte(1 as Byte)
  for i in 0..<stations.length() {
    if i > 0 {
      sb.write_byte(1 as Byte)
    }
    sb.write_string(stations[i])
  }
  sb.write_byte(1 as Byte)
  sb.to_string()
}

/// Encode overlaid keys (`station\x01key`) as `\x01station\x02key\x01...` (chat-reads.ts `keyed`).
pub fn keyed_apart(apart : Array[String]) -> String {
  if apart.length() == 0 {
    return ""
  }
  let sb = StringBuilder::new()
  sb.write_byte(1 as Byte)
  for i in 0..<apart.length() {
    if i > 0 {
      sb.write_byte(1 as Byte)
    }
    let item = apart[i]
    let raw = item.to_bytes()
    let mut replaced = false
    for j in 0..<raw.length() {
      let b = raw[j].to_int()
      if b == 1 && !replaced {
        sb.write_byte(2 as Byte)
        replaced = true
      } else {
        sb.write_byte(b as Byte)
      }
    }
  }
  sb.write_byte(1 as Byte)
  sb.to_string()
}

pub fn sql_chat_window() -> String {
  "SELECT c.station, c.archived, c.id, c.pinned_at, c.last_active, c.ord " +
  "FROM chat AS c " +
  "WHERE c.archived = 0 AND instr(?1, char(1) || c.station || char(1)) > 0 " +
  "AND (?2 = 0 OR c.mine = 1) AND (?3 = 2 OR coalesce(c.hidden, 0) = ?3) " +
  "AND coalesce(c.led, 0) = 0 AND (?4 = 0 OR c.watched = 1) " +
  "AND (?5 = '' OR c.thread IS NULL OR instr(?5, char(1) || c.station || char(2) || c.thread || char(1)) = 0) " +
  "AND (?6 = '' OR c.session IS NULL OR instr(?6, char(1) || c.station || char(2) || c.session || char(1)) = 0) " +
  "ORDER BY c.pinned_at DESC, c.last_active DESC, instr(?1, char(1) || c.station || char(1)), c.ord, c.id LIMIT ?7"
}

pub fn sql_chat_by_key() -> String {
  "SELECT station, archived, id, json FROM chat WHERE station = ? AND archived = ? AND id = ?"
}

pub fn sql_chat_by_thread() -> String {
  "SELECT station, archived, id, json FROM chat WHERE station = ? AND +archived = 0 AND thread = ? ORDER BY ord, id LIMIT 1"
}

pub fn sql_chat_by_session() -> String {
  "SELECT station, archived, id, json FROM chat WHERE station = ? AND +archived = 0 AND session = ? ORDER BY ord, id LIMIT 1"
}

pub fn sql_outbox_one() -> String {
  "SELECT station, thread, json FROM outbox WHERE station = ? AND thread = ?"
}

pub fn sql_outbox_by_station() -> String {
  "SELECT station, thread, json FROM outbox WHERE station = ? ORDER BY thread"
}

pub fn sql_outbox_all() -> String {
  "SELECT station, thread, json FROM outbox ORDER BY station, thread"
}

pub fn sql_pending_by_station() -> String {
  "SELECT key, station, json FROM pending WHERE station = ? ORDER BY key"
}

pub fn sql_pending_all() -> String {
  "SELECT key, station, json FROM pending ORDER BY station, key"
}

pub fn sql_draft_one() -> String {
  "SELECT station, chat, json FROM draft WHERE station = ? AND chat = ?"
}

pub fn sql_draft_by_station() -> String {
  "SELECT station, chat, json FROM draft WHERE station = ? ORDER BY chat"
}

pub fn sql_changing_by_station() -> String {
  "SELECT station, id, json FROM changing WHERE station = ? ORDER BY id"
}

pub fn sql_changing_all() -> String {
  "SELECT station, id, json FROM changing ORDER BY station, id"
}

pub fn sql_entry_by_seq() -> String {
  "SELECT json FROM entry WHERE station = ? AND thread = ? AND n = ?"
}

pub fn sql_thread_one() -> String {
  "SELECT id, last, read, unread, sort_at, created_at, surface, first_member, json FROM thread WHERE station = ? AND id = ?"
}

pub fn sql_entry_exists_before() -> String {
  "SELECT 1 FROM entry WHERE station = ? AND thread = ? AND n < ? LIMIT 1"
}

pub fn sql_account_doc_one() -> String {
  "SELECT json FROM account_doc WHERE name = ?"
}

pub fn sql_account_doc_put() -> String {
  "INSERT OR REPLACE INTO account_doc (name, json, confirmed) VALUES (?, ?, ?)"
}

pub fn sql_workspace_put() -> String {
  "INSERT OR REPLACE INTO workspace (id, json, confirmed) VALUES (?, ?, ?)"
}

pub fn sql_workspace_all() -> String {
  "SELECT id, json, confirmed FROM workspace ORDER BY id"
}

pub fn sql_workspace_one() -> String {
  "SELECT id, json, confirmed FROM workspace WHERE id = ?"
}

pub fn sql_station_doc_put() -> String {
  "INSERT OR REPLACE INTO station (address, kind, json, confirmed) VALUES (?, ?, ?, ?)"
}

pub fn sql_station_doc_by_kind() -> String {
  "SELECT address, kind, json, confirmed FROM station WHERE kind = ? ORDER BY address"
}

pub fn sql_station_doc_one() -> String {
  "SELECT address, kind, json, confirmed FROM station WHERE address = ? AND kind = ?"
}

pub struct ChatWindowQuery {
  pub stations : Array[String]
  pub mine : Bool
  pub hidden : Int
  pub watching : Bool
  pub apart_threads : Array[String]
  pub apart_sessions : Array[String]
  pub limit : Int
}

pub struct ChatWindowRow {
  pub station : String
  pub archived : Int
  pub id : String
  pub pinned_at : Option[Int64]
  pub last_active : Int64
  pub ord : Double
}

pub struct ChatRecord {
  pub station : String
  pub archived : Int
  pub id : String
  pub json : String
}

pub struct OutboxRow {
  pub station : String
  pub thread : Int
  pub json : String
}

pub struct PendingRow {
  pub key : String
  pub station : String
  pub json : String
}

pub struct DraftRow {
  pub station : String
  pub chat : String
  pub json : String
}

pub struct ChangingRow {
  pub station : String
  pub id : Int
  pub json : String
}

pub struct ThreadRecord {
  pub id : Int
  pub last : Option[Int]
  pub read : Option[Int]
  pub unread : Option[Int]
  pub sort_at : Int64
  pub created_at : Int64
  pub surface : Option[String]
  pub first_member : Option[String]
  pub json : String
}

/// Query the first `limit` listed chats across `stations` via the `chat_recent` index.
pub fn query_chat_window(db : sql::Sql, q : ChatWindowQuery) -> sql::SqlResult[Array[ChatWindowRow]] {
  if q.stations.length() == 0 || q.limit <= 0 {
    return sql::SqlResult::Ok([])
  }
  let params = [
    base_codec::json_str(in_order(q.stations)),
    base_codec::json_int(if q.mine { 1 } else { 0 }),
    base_codec::json_int(q.hidden),
    base_codec::json_int(if q.watching { 1 } else { 0 }),
    base_codec::json_str(keyed_apart(q.apart_threads)),
    base_codec::json_str(keyed_apart(q.apart_sessions)),
    base_codec::json_int(q.limit),
  ]
  match db.all(sql_chat_window(), params=params) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      let out : Array[ChatWindowRow] = []
      for i in 0..<rows.length() {
        let r = rows[i]
        out.push(ChatWindowRow::{
          station: sql::col_text(r, 0),
          archived: sql::col_int(r, 1),
          id: sql::col_text(r, 2),
          pinned_at: sql::col_opt_int64(r, 3),
          last_active: sql::col_int64(r, 4),
          ord: sql::col_double(r, 5),
        })
      }
      sql::SqlResult::Ok(out)
    }
  }
}

/// Fetch one chat record by primary key `(station, archived, id)`.
pub fn get_chat_by_key(
  db : sql::Sql,
  station : String,
  archived : Int,
  id : String,
) -> sql::SqlResult[Option[ChatRecord]] {
  match db.all(sql_chat_by_key(), params=[
    base_codec::json_str(station),
    base_codec::json_int(archived),
    base_codec::json_str(id),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      if rows.length() > 0 {
        let r = rows[0]
        sql::SqlResult::Ok(Some(ChatRecord::{
          station: sql::col_text(r, 0),
          archived: sql::col_int(r, 1),
          id: sql::col_text(r, 2),
          json: sql::col_text(r, 3),
        }))
      } else {
        sql::SqlResult::Ok(None)
      }
    }
  }
}

