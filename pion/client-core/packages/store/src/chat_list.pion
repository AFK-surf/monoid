}

pub struct WorkspaceRow {
  pub id : String
  pub json : String
  pub confirmed : Option[Int64]
}

pub struct StationDocRow {
  pub address : String
  pub kind : String
  pub json : String
  pub confirmed : Option[Int64]
}

fn opt_i64_param(v : Option[Int64]) -> base_codec::Json {
  match v {
    Some(n) => base_codec::json_int64(n)
    None => base_codec::json_null()
  }
}

/// Upsert an `account_doc` row (`name`, `json`, optional `confirmed` timestamp).
pub fn put_account_doc(
  db : sql::Sql,
  name : String,
  json : String,
  confirmed : Option[Int64] = None,
) -> sql::SqlResult[Unit] {
  match db.run(sql_account_doc_put(), params=[
    base_codec::json_str(name),
    base_codec::json_str(json),
    opt_i64_param(confirmed),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
  }
}

/// Upsert a workspace roster record (`workspace` table).
pub fn upsert_workspace(
  db : sql::Sql,
