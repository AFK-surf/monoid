/// Read thread metadata row for `(station, thread)`.
pub fn get_thread(db : sql::Sql, station : String, thread : Int) -> sql::SqlResult[Option[ThreadRecord]] {
  match db.all(sql_thread_one(), params=[base_codec::json_str(station), base_codec::json_int(thread)]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      if rows.length() > 0 {
        let r = rows[0]
        let last_v = match sql::col_opt_int64(r, 1) {
          Some(v) => Some(v.to_int())
          None => None
        }
        let read_v = match sql::col_opt_int64(r, 2) {
          Some(v) => Some(v.to_int())
          None => None
        }
        let unread_v = match sql::col_opt_int64(r, 3) {
          Some(v) => Some(v.to_int())
          None => None
        }
        let surface_v = match r[6] {
          base_codec::Json::Str(s) => Some(s)
          _ => None
        }
        let first_m = match r[7] {
          base_codec::Json::Str(s) => Some(s)
          _ => None
        }
        sql::SqlResult::Ok(Some(ThreadRecord::{
          id: sql::col_int(r, 0),
          last: last_v,
          read: read_v,
          unread: unread_v,
          sort_at: sql::col_int64(r, 4),
          created_at: sql::col_int64(r, 5),
          surface: surface_v,
          first_member: first_m,
          json: sql::col_text(r, 8),
        }))
      } else {
        sql::SqlResult::Ok(None)
      }
    }
  }
}

/// Check if any entry exists strictly before `before_n` for `(station, thread)` (pure SELECT).
pub fn has_entries_before(db : sql::Sql, station : String, thread : Int, before_n : Int) -> sql::SqlResult[Bool] {
  match db.all(sql_entry_exists_before(), params=[
    base_codec::json_str(station),
    base_codec::json_int(thread),
    base_codec::json_int(before_n),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => sql::SqlResult::Ok(rows.length() > 0)
  }
}

