// Pion-side bridge types and wire helpers paired with `native/core_pion.c`
// (`apps/mbui/src/host/core_api.h` 6-function C ABI).

import "base_codec"
import "protocol"

pub struct BridgeConfig {
  pub data_dir : String
  pub cloud_origin : String
  pub beta : Bool
}

pub struct AbiFrame {
  pub json : String
  pub bytes : Option[Bytes]
}

pub fn make_fatal_frame(reason : String) -> AbiFrame {
  let (json, bytes) = protocol::encode_core_event(protocol::CoreEvent::Fatal(reason))
  AbiFrame::{ json: json, bytes: bytes }
}

pub fn frame_from_event(ev : protocol::CoreEvent) -> AbiFrame {
  let (json, bytes) = protocol::encode_core_event(ev)
  AbiFrame::{ json: json, bytes: bytes }
}

pub fn encode_config_json(cfg : BridgeConfig) -> String {
  base_codec::json_stringify(base_codec::json_obj([
    ("dataDir", base_codec::json_str(cfg.data_dir)),
    ("cloudOrigin", base_codec::json_str(cfg.cloud_origin)),
    ("beta", base_codec::json_bool(cfg.beta)),
  ]))
}

// Return value of the native wake driver (`mb_core_register_wake` in `native/core_pion.c`): a
// relative delay in milliseconds. `-1` sleeps until the next message, `mb_core_wake()` or stop;
// `0` runs the wake driver again at once; a positive value runs it again after that many
// milliseconds. `next_at_ms` is when the earliest timer is due and `now_ms` the current time, both
// on the same clock as `effect::Runtime` timers (absolute ms, e.g. epoch); `None` means no timer.
pub fn wake_delay_ms(next_at_ms : Option[Int64], now_ms : Int64) -> Int64 {
  match next_at_ms {
    None => 0.to_int64() - 1.to_int64()
    Some(at) => if at <= now_ms { 0.to_int64() } else { at - now_ms }
  }
}
