// In-memory SQLite stand-in (`ParitySimDb`) for `parity_cli` Layer 3 view & stateful `ClientCore`
// parity testing, with exact SQL statement and write counters (cold-open 0 SQL writes gate).

import "base_codec"
import "effect"
import "shell"
import "sql"
import "store"
import "sync"

pub struct ParityChatRow {
  pub station : String
  pub archived : Int
  pub id : String
  pub ord : Double
  pub thread : Option[Int]
  pub session : Option[String]
  pub pinned_at : Option[Int64]
  pub last_active : Int64
  pub json : String
}

pub struct ParitySimDb {
  pub sh : shell::Shell
  pub entries : Map[String, Array[(Int, String)]]
  pub chats : Map[String, ParityChatRow]
  pub chat_order : Array[String]
  pub threads : Map[String, String]
  pub thread_reads : Map[String, (Int, Int)]
  pub sessions : Map[String, String]
  pub jobs : Map[String, String]
  pub outbox_rows : Map[String, String]
  pub pending_rows : Map[String, String]
  pub changing_rows : Map[String, String]
  pub drafts : Map[String, String]
  pub prefs : Map[String, String]
  pub pref_order : Array[String]
  pub said : Array[(String, Int, Int, Int, Int64, String)]
  pub account_docs : Map[String, String]
  pub workspaces : Map[String, (String, Option[Int64])]
  pub workspace_order : Array[String]
  pub station_docs : Map[String, (String, String, String, Option[Int64])]
  pub station_doc_order : Array[String]
  pub log_use : Map[String, Int64]
  pub md : Map[String, (Int64, String)]
  pub ran : Array[String]
  pub mut writes : Int
}

pub fn ParitySimDb::new(rt : effect::Runtime) -> ParitySimDb {
  let holder : Array[ParitySimDb] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(_ : Int64, _ : String, _ : base_codec::Json, _ : Option[Bytes]) -> Unit {},
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      holder[0].answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = ParitySimDb::{
    sh: sh,
    entries: Map::new(),
    chats: Map::new(),
    chat_order: [],
    threads: Map::new(),
    thread_reads: Map::new(),
    sessions: Map::new(),
    jobs: Map::new(),
    outbox_rows: Map::new(),
    pending_rows: Map::new(),
    changing_rows: Map::new(),
    drafts: Map::new(),
    prefs: Map::new(),
    pref_order: [],
    said: [],
    account_docs: Map::new(),
    workspaces: Map::new(),
    workspace_order: [],
    station_docs: Map::new(),
    station_doc_order: [],
    log_use: Map::new(),
    md: Map::new(),
    ran: [],
    writes: 0,
  }
  holder.push(db)
  db
}

fn ps_str(params : Array[base_codec::Json], i : Int) -> String {
  if i < 0 || i >= params.length() { "" } else { sql::col_text(params, i) }
}

fn ps_int64(params : Array[base_codec::Json], i : Int) -> Int64 {
  if i < 0 || i >= params.length() { 0.to_int64() } else { sql::col_int64(params, i) }
}

fn ps_int(params : Array[base_codec::Json], i : Int) -> Int {
  ps_int64(params, i).to_int()
}

fn ps_opt_int(params : Array[base_codec::Json], i : Int) -> Option[Int] {
  if i < 0 || i >= params.length() {
    None
  } else {
    match sql::col_opt_int64(params, i) {
      Some(v) => Some(v.to_int())
      None => None
    }
  }
}

fn ps_opt_int64(params : Array[base_codec::Json], i : Int) -> Option[Int64] {
  if i < 0 || i >= params.length() { None } else { sql::col_opt_int64(params, i) }
}

fn ps_opt_str(params : Array[base_codec::Json], i : Int) -> Option[String] {
  if i < 0 || i >= params.length() { None } else { sql::col_opt_text(params, i) }
}

pub fn ParitySimDb::put_entry_row(self : ParitySimDb, station : String, thread : Int, n : Int, raw : String) -> Unit {
  let k = station + " " + thread.to_string()
  let arr = match self.entries.get(k) {
    Some(a) => a
    None => {
      let a : Array[(Int, String)] = []
      self.entries.set(k, a)
      a
    }
  }
  let mut replaced = false
  for i in 0..<arr.length() {
    if arr[i].0 == n {
      arr[i] = (n, raw)
      replaced = true
      break
    }
  }
  if !replaced {
    arr.push((n, raw))
  }
  // Mirror `said_put` SQLite trigger for message entries
  match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) => {
      let kind = match base_codec::json_get(j, "kind") {
        Some(base_codec::Json::Str(s)) => s
        _ => ""
      }
      if kind == "message" {
        let txt = match base_codec::json_get(j, "text") {
          Some(base_codec::Json::Str(s)) => s
          _ => ""
        }
        let at = match base_codec::json_get(j, "at") {
          Some(base_codec::Json::Num(v, _)) => v.to_int64()
          _ => 0.to_int64()
        }
        self.said.push((station, thread, n, n, at, txt))
      }
    }
    base_codec::JsonParseResult::Err(_) => ()
  }
}

pub fn ParitySimDb::put_chat_row(self : ParitySimDb, row : ParityChatRow) -> Unit {
  let key = row.station + ":" + row.archived.to_string() + ":" + row.id
  if self.chats.get(key).is_none() {
    self.chat_order.push(key)
  }
  self.chats.set(key, row)
}

pub fn ParitySimDb::put_station_doc(self : ParitySimDb, addr : String, kind : String, json_str : String) -> Unit {
  let k = addr + ":" + kind
  if self.station_docs.get(k).is_none() {
    self.station_doc_order.push(k)
  }
  self.station_docs.set(k, (addr, kind, json_str, None))
}

pub fn ParitySimDb::put_workspace(self : ParitySimDb, id : String, json_str : String) -> Unit {
  if self.workspaces.get(id).is_none() {
    self.workspace_order.push(id)
  }
  self.workspaces.set(id, (json_str, None))
}

fn is_write_stmt(stmt : String) -> Bool {
  stmt.starts_with("INSERT") ||
  stmt.starts_with("UPDATE") ||
  stmt.starts_with("DELETE") ||
  stmt.starts_with("REPLACE") ||
  stmt.starts_with("CREATE") ||
  stmt.starts_with("DROP") ||
  stmt.starts_with("ALTER")
}

fn ParitySimDb::answer(self : ParitySimDb, op : String, args : base_codec::Json) -> shell::AskResult {
  if op == "sql.open" {
    return shell::AskResult::Ok(base_codec::json_obj([("id", base_codec::json_int(1))]))
  }
  if op == "sql.close" {
    return shell::AskResult::Ok(base_codec::json_null())
  }
  let stmt = match base_codec::json_get(args, "sql") {
    Some(base_codec::Json::Str(s)) => s
    _ => return shell::AskResult::Err(shell::ShellError::{ message: "missing sql" })
  }
  let p = match base_codec::json_get(args, "params") {
    Some(base_codec::Json::Arr(a)) => a
    _ => []
  }
  self.ran.push(stmt)
  if op == "sql.exec" {
    if is_write_stmt(stmt) {
      self.writes += 1
    }
    return shell::AskResult::Ok(base_codec::json_null())
  }
  if op == "sql.run" || is_write_stmt(stmt) {
    self.writes += 1
  }
  let rows : Array[base_codec::Json] = []
  let mut changed = 0
  if stmt == store::sql_window_end() {
    let k = ps_str(p, 0) + " " + ps_str(p, 1)
    let most = ps_int(p, 2)
    match self.entries.get(k) {
      Some(all) => {
        let mut i = all.length() - 1
        while i >= 0 && rows.length() < most {
          let (en, ej) = all[i]
          rows.push(base_codec::json_arr([base_codec::json_int(en), base_codec::json_str(ej)]))
          i -= 1
        }
      }
      None => ()
    }
  } else if stmt.starts_with(store::sql_md_many_head()) {
    let st = ps_str(p, 0)
    for i in 1..<p.length() {
      let key = ps_str(p, i)
      match self.md.get(st + " " + key) {
        Some((used, j)) => rows.push(base_codec::json_arr([base_codec::json_str(key), base_codec::json_int64(used), base_codec::json_str(j)]))
        None => ()
      }
    }
  } else if stmt == store::sql_opened() {
    match self.log_use.get(ps_str(p, 0) + " " + ps_str(p, 1) + " " + ps_str(p, 2)) {
      Some(at) => rows.push(base_codec::json_arr([base_codec::json_int64(at)]))
      None => ()
    }
  } else if stmt == store::sql_note_opened() {
    self.log_use.set(ps_str(p, 0) + " " + ps_str(p, 1) + " " + ps_str(p, 2), ps_int64(p, 3))
    changed = 1
  } else if stmt == store::sql_chat_window() {
    let limit = ps_int(p, 6)
    for i in 0..<self.chat_order.length() {
      if rows.length() >= limit {
        break
      }
      match self.chats.get(self.chat_order[i]) {
        Some(c) => {
          if c.archived == 0 {
            let pj = match c.pinned_at {
              Some(ts) => base_codec::json_int64(ts)
              None => base_codec::json_null()
            }
            rows.push(base_codec::json_arr([
              base_codec::json_str(c.station),
              base_codec::json_int(c.archived),
              base_codec::json_str(c.id),
              pj,
              base_codec::json_int64(c.last_active),
              base_codec::json_num(c.ord),
            ]))
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_chat_by_key() {
    let key = ps_str(p, 0) + ":" + ps_int(p, 1).to_string() + ":" + ps_str(p, 2)
    match self.chats.get(key) {
      Some(c) => rows.push(base_codec::json_arr([
        base_codec::json_str(c.station),
        base_codec::json_int(c.archived),
        base_codec::json_str(c.id),
        base_codec::json_str(c.json),
      ]))
      None => ()
    }
  } else if stmt == store::sql_chat_by_thread() {
    let st = ps_str(p, 0)
    let th = ps_int(p, 1)
    for i in 0..<self.chat_order.length() {
      match self.chats.get(self.chat_order[i]) {
        Some(c) => {
          if c.station == st {
            match c.thread {
              Some(ct) => if ct == th {
                rows.push(base_codec::json_arr([
                  base_codec::json_str(c.station),
                  base_codec::json_int(c.archived),
                  base_codec::json_str(c.id),
                  base_codec::json_str(c.json),
                ]))
                break
              }
              None => ()
            }
          }
        }
        None => ()
      }
    }
  } else if stmt.contains("archived = 1") {
    let st = ps_str(p, 0)
    let lim = ps_int(p, 1)
    for i in 0..<self.chat_order.length() {
      if rows.length() >= lim {
        break
      }
      match self.chats.get(self.chat_order[i]) {
        Some(c) =>
        if c.station == st && c.archived == 1 {
          let th_j = match c.thread { Some(t) => base_codec::json_int(t); None => base_codec::json_null() }
          rows.push(base_codec::json_arr([
            base_codec::json_str(c.station),
            base_codec::json_int(c.archived),
            base_codec::json_str(c.id),
            th_j,
            base_codec::json_int64(c.last_active),
            base_codec::json_str(c.json),
          ]))
        }
        None => ()
      }
    }
  } else if stmt == store::sql_outbox_one() {
    let st = ps_str(p, 0)
    let th = ps_int(p, 1)
    match self.outbox_rows.get(st + ":" + th.to_string()) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_int(th), base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == store::sql_account_doc_put() {
    self.account_docs.set(ps_str(p, 0), ps_str(p, 1))
    changed = 1
  } else if stmt == store::sql_account_doc_one() {
    match self.account_docs.get(ps_str(p, 0)) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == store::sql_workspace_put() {
    self.put_workspace(ps_str(p, 0), ps_str(p, 1))
    changed = 1
  } else if stmt == store::sql_workspace_one() {
    let wid = ps_str(p, 0)
    match self.workspaces.get(wid) {
      Some((j, conf)) => {
        let cj = match conf { Some(ts) => base_codec::json_int64(ts); None => base_codec::json_null() }
        rows.push(base_codec::json_arr([base_codec::json_str(wid), base_codec::json_str(j), cj]))
      }
      None => ()
    }
  } else if stmt == store::sql_workspace_all() {
    for i in 0..<self.workspace_order.length() {
      let wid = self.workspace_order[i]
      match self.workspaces.get(wid) {
        Some((j, conf)) => {
          let cj = match conf { Some(ts) => base_codec::json_int64(ts); None => base_codec::json_null() }
          rows.push(base_codec::json_arr([base_codec::json_str(wid), base_codec::json_str(j), cj]))
        }
        None => ()
      }
    }
  } else if stmt == store::sql_station_doc_put() {
    self.put_station_doc(ps_str(p, 0), ps_str(p, 1), ps_str(p, 2))
    changed = 1
  } else if stmt == store::sql_station_doc_one() {
    let k = ps_str(p, 0) + ":" + ps_str(p, 1)
    match self.station_docs.get(k) {
      Some((addr, kind, j, conf)) => {
        let cj = match conf { Some(ts) => base_codec::json_int64(ts); None => base_codec::json_null() }
        rows.push(base_codec::json_arr([base_codec::json_str(addr), base_codec::json_str(kind), base_codec::json_str(j), cj]))
      }
      None => ()
    }
  } else if stmt == store::sql_station_doc_by_kind() {
    let want_kind = ps_str(p, 0)
    for i in 0..<self.station_doc_order.length() {
      match self.station_docs.get(self.station_doc_order[i]) {
        Some((addr, kind, j, conf)) => {
          if kind == want_kind {
            let cj = match conf { Some(ts) => base_codec::json_int64(ts); None => base_codec::json_null() }
            rows.push(base_codec::json_arr([base_codec::json_str(addr), base_codec::json_str(kind), base_codec::json_str(j), cj]))
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_draft_put() {
    self.drafts.set(ps_str(p, 0) + ":" + ps_str(p, 1), ps_str(p, 2))
    changed = 1
  } else if stmt == store::sql_draft_delete() {
    self.drafts.remove(ps_str(p, 0) + ":" + ps_str(p, 1))
    changed = 1
  } else if stmt == store::sql_draft_one() {
    let st = ps_str(p, 0)
    let ch = ps_str(p, 1)
    match self.drafts.get(st + ":" + ch) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_str(ch), base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == store::sql_thread_set_read() {
    self.thread_reads.set(ps_str(p, 2) + ":" + ps_int(p, 3).to_string(), (ps_int(p, 0), ps_int(p, 1)))
    changed = 1
  } else if stmt == store::sql_chat_set_unread() {
    changed = 1
  } else if stmt == store::sql_pref_put() {
    let k = ps_str(p, 0) + ":" + ps_str(p, 1)
    if self.prefs.get(k).is_none() {
      self.pref_order.push(k)
    }
    self.prefs.set(k, ps_str(p, 2))
    changed = 1
  } else if stmt == store::sql_pref_get() {
    match self.prefs.get(ps_str(p, 0) + ":" + ps_str(p, 1)) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == store::sql_pref_all() {
    let ws_prefix = ps_str(p, 0) + ":"
    for i in 0..<self.pref_order.length() {
      let fk = self.pref_order[i]
      if fk.starts_with(ws_prefix) {
        let key_only = fk.slice(ws_prefix.length(), fk.length())
        match self.prefs.get(fk) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(key_only), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == store::sql_search_messages_station() || stmt == store::sql_search_messages_all() {
    let filter_st = if stmt == store::sql_search_messages_station() { Some(ps_str(p, 0)) } else { None }
    let q = if stmt == store::sql_search_messages_station() { ps_str(p, 1) } else { ps_str(p, 0) }
    for i in 0..<self.said.length() {
      let (st, th, seq, n, at, txt) = self.said[i]
      let st_ok = match filter_st { Some(want) => st == want; None => true }
      if st_ok && txt.contains(q) {
        rows.push(base_codec::json_arr([
          base_codec::json_str(st),
          base_codec::json_int(th),
          base_codec::json_int(seq),
          base_codec::json_int(n),
          base_codec::json_int64(at),
          base_codec::json_str(txt),
        ]))
      }
    }
  } else if stmt == store::sql_search_chats() {
    let q = ps_str(p, 1)
    let limit = ps_int(p, 2)
    for i in 0..<self.chat_order.length() {
      if rows.length() >= limit {
        break
      }
      match self.chats.get(self.chat_order[i]) {
        Some(c) => {
          if c.archived == 0 && (q.length() == 0 || c.json.contains(q) || c.id.contains(q)) {
            let th_j = match c.thread { Some(t) => base_codec::json_int(t); None => base_codec::json_null() }
            rows.push(base_codec::json_arr([
              base_codec::json_str(c.station),
              base_codec::json_int(c.archived),
              base_codec::json_str(c.id),
              th_j,
              base_codec::json_int64(c.last_active),
              base_codec::json_str(c.json),
            ]))
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_moved_from() {
    let _ = ps_str(p, 0)
  } else if stmt == store::sql_pending_by_station() {
    let st = ps_str(p, 0)
    let prefix = st + ":"
    let ks = self.pending_rows.keys()
    for i in 0..<ks.length() {
      let k = ks[i]
      if k.starts_with(prefix) {
        let pkey = k.slice(prefix.length(), k.length())
        match self.pending_rows.get(k) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(pkey), base_codec::json_str(st), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == store::sql_draft_by_station() {
    let st = ps_str(p, 0)
    let prefix = st + ":"
    let ks = self.drafts.keys()
    for i in 0..<ks.length() {
      let k = ks[i]
      if k.starts_with(prefix) {
        let chat_k = k.slice(prefix.length(), k.length())
        match self.drafts.get(k) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_str(chat_k), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == store::sql_changing_by_station() {
    let st = ps_str(p, 0)
    let prefix = st + ":"
    let ks = self.changing_rows.keys()
    for i in 0..<ks.length() {
      let k = ks[i]
      if k.starts_with(prefix) {
        let id_str = k.slice(prefix.length(), k.length())
        let cid = match base_codec::parse_int64_str(id_str) { Some(v) => v.to_int(); None => 0 }
        match self.changing_rows.get(k) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_int(cid), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == store::sql_thread_one() {
    let st = ps_str(p, 0)
    let th = ps_int(p, 1)
    let tk = st + ":" + th.to_string()
    match self.threads.get(tk) {
      Some(tj) => {
        let (rd_j, un_j) = match self.thread_reads.get(tk) {
          Some((r, u)) => (base_codec::json_int(r), base_codec::json_int(u))
          None => (base_codec::json_null(), base_codec::json_int(0))
        }
        rows.push(base_codec::json_arr([
          base_codec::json_int(th),
          base_codec::json_null(),
          rd_j,
          un_j,
          base_codec::json_int(0),
          base_codec::json_int(0),
          base_codec::json_str("chat"),
          base_codec::json_null(),
          base_codec::json_str(tj),
        ]))
      }
      None => ()
    }
  } else if stmt == store::sql_entry_exists_before() {
    let k = ps_str(p, 0) + " " + ps_int(p, 1).to_string()
    let before_n = ps_int(p, 2)
    match self.entries.get(k) {
      Some(all) => {
        for i in 0..<all.length() {
          if all[i].0 < before_n {
            rows.push(base_codec::json_arr([base_codec::json_int(1)]))
            break
          }
        }
      }
      None => ()
    }
  } else if stmt.starts_with("INSERT OR REPLACE INTO outbox") {
    self.outbox_rows.set(ps_str(p, 0) + ":" + ps_int(p, 1).to_string(), ps_str(p, 2))
    changed = 1
  } else if stmt.starts_with("DELETE FROM outbox") {
    self.outbox_rows.remove(ps_str(p, 0) + ":" + ps_int(p, 1).to_string())
    changed = 1
  } else if stmt.starts_with("INSERT OR REPLACE INTO pending") {
    self.pending_rows.set(ps_str(p, 1) + ":" + ps_str(p, 0), ps_str(p, 2))
    changed = 1
  } else if stmt.starts_with("DELETE FROM pending") {
    self.pending_rows.remove(ps_str(p, 1) + ":" + ps_str(p, 0))
    changed = 1
  } else if stmt.starts_with("INSERT OR REPLACE INTO changing") {
    self.changing_rows.set(ps_str(p, 0) + ":" + ps_int(p, 1).to_string(), ps_str(p, 2))
    changed = 1
  } else if stmt.starts_with("DELETE FROM changing") {
    self.changing_rows.remove(ps_str(p, 0) + ":" + ps_int(p, 1).to_string())
    changed = 1
  }
  if op == "sql.run" {
    return shell::AskResult::Ok(base_codec::json_int(changed))
  }
  shell::AskResult::Ok(base_codec::json_arr(rows))
}

pub fn make_noop_transport() -> sync::StationTransport {
  sync::StationTransport::{
    request_k: fn(_method : String, _path : String, _headers : Array[(String, String)], _body : Bytes, k : (effect::Exit[sync::HttpReply]) -> Unit) -> Unit {
      k(effect::Exit::Succeeded(sync::HttpReply::{ status: 200, headers: [], body: "{}".to_bytes() }))
    },
    stream_k: fn(_path : String, _headers : Array[(String, String)], _on_chunk : (Bytes) -> Unit, k : (effect::Exit[Unit]) -> Unit) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
  }
}
