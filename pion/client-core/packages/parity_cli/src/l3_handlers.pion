pub fn handle_l3_op(
  op : String,
  args : base_codec::Json,
  sess : ParityCoreSession,
) -> Option[String] {
  // ── Sub-suite 1: Store schema & mdKey ──
  if op == "store.schemaVersion" {
    return Some(ok_resp(base_codec::json_int(store::schema_version())))
  }
  if op == "store.migrations" {
    let migs = store::migrations()
    let arr : Array[base_codec::Json] = []
    for i in 0..<migs.length() {
      arr.push(base_codec::json_str(migs[i]))
    }
    return Some(ok_resp(base_codec::json_arr(arr)))
  }
  if op == "store.ensureSaidDdl" {
    return Some(ok_resp(base_codec::json_str(store::sql_ensure_said_ddl())))
  }
  if op == "store.ensureMdKeptDdl" {
    return Some(ok_resp(base_codec::json_str(store::sql_ensure_md_kept())))
  }
  if op == "store.ensureKeptDdl" {
    return Some(ok_resp(base_codec::json_str(store::sql_ensure_kept())))
  }
  if op == "store.ensureMovedDdl" {
    return Some(ok_resp(base_codec::json_str(store::sql_ensure_moved())))
  }
  if op == "store.mdKey" {
    return Some(ok_resp(base_codec::json_str(store::md_key(j_s(args, "text")))))
  }
  if op == "store.olderMdKeys" {
    let from_v = match j_oi(args, "from") { Some(v) => v; None => 1 }
    let ks = store::older_md_keys(j_s(args, "key"), from=from_v)
    let out : Array[base_codec::Json] = []
    for i in 0..<ks.length() {
      out.push(base_codec::json_str(ks[i]))
    }
    return Some(ok_resp(base_codec::json_arr(out)))
  }

  // ── Sub-suite 2: Lock Fork Choice / againOf / vouchersIn / approvedIn / effectiveState ──
  if op == "lock.linksValid" {
    let entries = parse_form_entries(j_arr_l3(args, "entries"))
    let c = views::views_lock_crypto()
    return Some(ok_resp(base_codec::json_bool(views::links_valid(entries, c))))
  }
  if op == "lock.keepEntries" {
    let c = views::views_lock_crypto()
    let was_entries = parse_form_entries(j_arr_l3(args, "entries"))
    let was_aside = parse_form_entries(j_arr_l3(args, "aside"))
    let brought = parse_form_entries(j_arr_l3(args, "brought"))
    let root_hash = j_s(args, "rootHash")
    let is_person = j_b(args, "isPerson")
    let now_opt = j_onum(args, "now")
    let was_head = if was_entries.length() > 0 {
      match lock::entry_hash(was_entries[was_entries.length() - 1], c) {
        Ok(h) => h
        Err(_) => ""
      }
    } else {
      ""
    }
    let was_gen = if was_entries.length() > 0 {
      match lock::entry_hash(was_entries[0], c) {
        Ok(h) => h
        Err(_) => root_hash
      }
    } else {
      root_hash
    }
    let was = views::KeptLog::{
      entries: was_entries,
      aside: was_aside,
      head: was_head,
      genesis: was_gen,
    }
    match views::keep_entries(was, brought, root_hash, is_person, now_opt, c) {
      Err(e) => return Some(err_resp(e))
      Ok(out) => {
        let active_hashes : Array[base_codec::Json] = []
        for i in 0..<out.kept.entries.length() {
          match lock::entry_hash(out.kept.entries[i], c) {
            Ok(h) => active_hashes.push(base_codec::json_str(h))
            Err(_) => ()
          }
        }
        let aside_hashes : Array[base_codec::Json] = []
        for i in 0..<out.kept.aside.length() {
          match lock::entry_hash(out.kept.aside[i], c) {
            Ok(h) => aside_hashes.push(base_codec::json_str(h))
            Err(_) => ()
          }
        }
        return Some(ok_resp(base_codec::json_obj([
          ("entries", form_entries_to_base(out.kept.entries)),
          ("aside", form_entries_to_base(out.kept.aside)),
          ("activeHashes", base_codec::json_arr(active_hashes)),
          ("asideHashes", base_codec::json_arr(aside_hashes)),
          ("head", base_codec::json_str(out.kept.head)),
          ("moved", base_codec::json_bool(out.moved_head)),
          ("changed", base_codec::json_bool(out.changed)),
          ("rejected", base_codec::json_int(out.rejected)),
        ])))
      }
    }
  }
  if op == "lock.againOf" {
    let c = views::views_lock_crypto()
    let chain = parse_form_entries(j_arr_l3(args, "chain"))
    let aside = parse_form_entries(j_arr_l3(args, "aside"))
    let lost = base_to_form(get_json(args, "lost"))
    let tries = j_i(args, "tries")
    let dec = views::again_of(chain, aside, lost, lock_entry_subject, tries, c)
    let dec_str = match dec {
      views::AgainDecision::Done => "done"
      views::AgainDecision::Otherwise => "otherwise"
      views::AgainDecision::Unmoved => "unmoved"
      views::AgainDecision::ReSign => "sign"
      views::AgainDecision::Exhausted => "exhausted"
    }
    return Some(ok_resp(base_codec::json_str(dec_str)))
  }
  if op == "lock.vouchersIn" {
    let raw_locks = j_arr_l3(args, "locks")
    let locks : Array[views::OwnStandings] = []
    for i in 0..<raw_locks.length() {
      locks.push(parse_own_standings(raw_locks[i]))
    }
    let res = views::vouchers_in(locks, j_s(args, "sub"), j_s(args, "base"))
    let out : Array[base_codec::Json] = []
    for i in 0..<res.length() {
      out.push(base_codec::json_str(res[i]))
    }
    return Some(ok_resp(base_codec::json_arr(out)))
  }
  if op == "lock.approvedIn" {
    let raw_locks = j_arr_l3(args, "locks")
    let locks : Array[views::OwnStandings] = []
    for i in 0..<raw_locks.length() {
      locks.push(parse_own_standings(raw_locks[i]))
    }
    let res = views::approved_in(
      locks,
      j_s(args, "sub"),
      j_os(args, "meId"),
      j_os(args, "meSignKey"),
      str_set_from_arr(j_arr_l3(args, "chainSigners")),
      str_set_from_arr(j_arr_l3(args, "chainSigned")),
      str_set_from_arr(j_arr_l3(args, "everIds")),
      str_set_from_arr(j_arr_l3(args, "everKeys")),
    )
    let out : Array[base_codec::Json] = []
    for i in 0..<res.length() {
      let d = res[i]
      let fs : Array[(String, base_codec::Json)] = [
        ("key", base_codec::json_str(d.key)),
        ("id", base_codec::json_str(d.id)),
        ("label", base_codec::json_str(d.label)),
      ]
      match d.sign_key {
        Some(sk) => fs.push(("sign_key", base_codec::json_str(sk)))
        None => fs.push(("sign_key", base_codec::json_null()))
      }
      out.push(base_codec::json_obj(fs))
    }
    return Some(ok_resp(base_codec::json_arr(out)))
  }
  if op == "lock.effectiveState" {
    let c = views::views_lock_crypto()
    let ws = j_s(args, "ws")
    let chain = parse_form_entries(j_arr_l3(args, "chain"))
    let raw_pcs = j_arr_l3(args, "personChains")
    let pcs : Array[Array[form::Json]] = []
    for i in 0..<raw_pcs.length() {
      match raw_pcs[i] {
        base_codec::Json::Arr(a) => pcs.push(parse_form_entries(a))
        _ => ()
      }
    }
    let bodies = parse_form_entries(j_arr_l3(args, "bodies"))
    let now_s = match j_onum(args, "now") { Some(v) => v; None => 0.0 }
    match views::effective_state(ws, chain, pcs, bodies, now_s, c) {
      Err(e) => return Some(err_resp(e))
      Ok(ef) => {
        let member_subs = ef.state.members.keys()
        let members_j : Array[base_codec::Json] = []
        for i in 0..<member_subs.length() {
          members_j.push(base_codec::json_str(member_subs[i]))
        }
        let dev_ids = ef.state.devices.keys()
        let devs_j : Array[base_codec::Json] = []
        for i in 0..<dev_ids.length() {
          devs_j.push(base_codec::json_str(dev_ids[i]))
        }
        return Some(ok_resp(base_codec::json_obj([
          ("ws", base_codec::json_str(ef.ws)),
          ("moved", base_codec::json_bool(ef.moved)),
          ("on", base_codec::json_str(ef.on)),
          ("safeMode", base_codec::json_bool(ef.safe_mode)),
          ("rootIn", base_codec::json_bool(ef.root_in)),
          ("members", base_codec::json_arr(members_j)),
          ("devices", base_codec::json_arr(devs_j)),
        ])))
      }
    }
  }

  // ── Sub-suite 3: All 26 topic projections ──
  if op == "views.projectAll" {
    let now_ms = match j_oi64(args, "nowMs") { Some(v) => v; None => 1795442000000.to_int64() }
    let fresh = ParityCoreSession::new("ws1", "ws1/s1")
    seed_all_views_fixture(fresh, now_ms)
    let ws = "ws1"
    let st = "ws1/s1"
    let briefs = [
      views::StationBrief::{
        address: st,
        id: "s1",
        name: "Mac Studio",
        emoji: None,
        icon: None,
        online: true,
        updating: false,
        offline_text: None,
        reconnecting_text: None,
        running: 1,
      },
    ]
    let open_jobs = [
      base_codec::json_obj([
        ("id", base_codec::json_str("job-1")),
        ("name", base_codec::json_str("Dev server")),
        ("station", base_codec::json_str(st)),
        ("chat", base_codec::json_str("10")),
        ("thread", base_codec::json_int(10)),
        ("state", base_codec::json_str("running")),
        ("port", base_codec::json_int(3000)),
        ("startedAt", base_codec::json_int64(now_ms - 7200000.to_int64())),
        ("mine", base_codec::json_bool(true)),
      ]),
    ]

    let safe_mode = fresh.core.current_safe_mode_view()
    let out : Array[(String, base_codec::Json)] = []

    match views::project_accounts(fresh.db) {
      sql::SqlResult::Ok(v) => out.push(("accounts", v))
      sql::SqlResult::Err(e) => return Some(err_resp("accounts: " + e.to_string()))
    }
    match views::project_workspaces(fresh.db) {
      sql::SqlResult::Ok(v) => out.push(("workspaces", v))
      sql::SqlResult::Err(e) => return Some(err_resp("workspaces: " + e.to_string()))
    }
    match views::project_workspace(fresh.db, ws) {
      sql::SqlResult::Ok(Some(v)) => out.push(("workspace", v))
      _ => return Some(err_resp("workspace missing"))
    }
    match views::project_stations(fresh.db, ws) {
      sql::SqlResult::Ok(v) => out.push(("stations", v))
      sql::SqlResult::Err(e) => return Some(err_resp("stations: " + e.to_string()))
    }
    match views::project_chats(fresh.db, ws, briefs, now_ms, fresh.core.rows_memo, fresh.core.viewer_marks) {
      sql::SqlResult::Ok(v) => out.push(("chats", v))
      sql::SqlResult::Err(e) => return Some(err_resp("chats: " + e.to_string()))
    }
    match views::project_chat(fresh.db, fresh.core.md_store, st, 10, "alice@example.com", now_ms) {
      sql::SqlResult::Ok(v) => out.push(("chat", v))
      sql::SqlResult::Err(e) => return Some(err_resp("chat: " + e.to_string()))
    }
    out.push(("lock", safe_mode.to_json()))
    match views::project_vaults(fresh.db, ws, safe_mode, true, true) {
      sql::SqlResult::Ok(v) => out.push(("vaults", v))
      sql::SqlResult::Err(e) => return Some(err_resp("vaults: " + e.to_string()))
    }
    out.push(("presets", views::project_own_presets(fresh.core.presets_held, "user-alice")))
    out.push(("otherPresets", views::project_other_presets([fresh.core.other_presets_held], fresh.core.presets_held, "user-alice", false)))
    out.push(("boardDrafts", views::project_board_drafts(fresh.core.board_drafts_held, "user-alice")))
    out.push(("downloads", views::project_downloads(fresh.core.downloads_held)))
    match views::project_archive(fresh.db, ws, briefs, now_ms) {
      sql::SqlResult::Ok(v) => out.push(("archive", v))
      sql::SqlResult::Err(e) => return Some(err_resp("archive: " + e.to_string()))
    }
    match views::project_search(fresh.db, ws, briefs, "parity") {
      sql::SqlResult::Ok(v) => out.push(("search", v))
      sql::SqlResult::Err(e) => return Some(err_resp("search: " + e.to_string()))
    }
    match views::project_chat_search(fresh.db, ws, briefs, "parity") {
      sql::SqlResult::Ok(v) => out.push(("chatSearch", v))
      sql::SqlResult::Err(e) => return Some(err_resp("chatSearch: " + e.to_string()))
    }
    match views::project_profiles(fresh.db, ws) {
      sql::SqlResult::Ok(v) => out.push(("profiles", v))
      sql::SqlResult::Err(e) => return Some(err_resp("profiles: " + e.to_string()))
    }
    match views::project_profiles_overview(fresh.db, ws, now_ms) {
      sql::SqlResult::Ok(v) => out.push(("profilesOverview", v))
      sql::SqlResult::Err(e) => return Some(err_resp("profilesOverview: " + e.to_string()))
    }
    match views::project_models(fresh.db, ws, fresh.core.stars_held) {
      sql::SqlResult::Ok(v) => out.push(("models", v))
      sql::SqlResult::Err(e) => return Some(err_resp("models: " + e.to_string()))
    }
    match views::project_fleet(fresh.db, ws, briefs, now_ms, running_chats=1, open_jobs=open_jobs) {
      sql::SqlResult::Ok(v) => out.push(("fleet", v))
      sql::SqlResult::Err(e) => return Some(err_resp("fleet: " + e.to_string()))
    }
    match views::project_usage(fresh.db, ws, briefs, now_ms) {
      sql::SqlResult::Ok(v) => out.push(("usage", v))
      sql::SqlResult::Err(e) => return Some(err_resp("usage: " + e.to_string()))
    }
    match views::project_agent_rates(fresh.db, ws, briefs) {
      sql::SqlResult::Ok(v) => out.push(("agentRates", v))
      sql::SqlResult::Err(e) => return Some(err_resp("agentRates: " + e.to_string()))
    }
    match views::project_settings(fresh.db, ws) {
      sql::SqlResult::Ok(v) => out.push(("settings", v))
      sql::SqlResult::Err(e) => return Some(err_resp("settings: " + e.to_string()))
    }
    match views::project_station_updates(fresh.db, ws, now_ms) {
      sql::SqlResult::Ok(v) => out.push(("stationUpdates", v))
      sql::SqlResult::Err(e) => return Some(err_resp("stationUpdates: " + e.to_string()))
    }
    match views::project_rail_card(fresh.db, ws, "chats", briefs, 1, fresh.core.viewer_marks, now_ms) {
      sql::SqlResult::Ok(v) => out.push(("railCard", v))
      sql::SqlResult::Err(e) => return Some(err_resp("railCard: " + e.to_string()))
    }
    match views::project_chat_jobs(fresh.db, st, 10, open_jobs, now_ms) {
      sql::SqlResult::Ok(v) => out.push(("chatJobs", v))
      sql::SqlResult::Err(e) => return Some(err_resp("chatJobs: " + e.to_string()))
    }
    match views::project_long_jobs(fresh.db, ws, briefs, open_jobs, now_ms) {
      sql::SqlResult::Ok(v) => out.push(("longJobs", v))
      sql::SqlResult::Err(e) => return Some(err_resp("longJobs: " + e.to_string()))
    }

    return Some(ok_resp(base_codec::json_obj(out)))
  }

  // ── Sub-suite 4: Stateful `ClientCore` wire session driver ──
  if op == "core.reset" {
    let ws = match j_os(args, "workspace") { Some(s) => s; None => "ws1" }
    let st = match j_os(args, "station") { Some(s) => s; None => ws + "/s1" }
    let fresh = ParityCoreSession::new(ws, st)
    sess.rt = fresh.rt
    sess.sim = fresh.sim
    sess.db = fresh.db
    sess.core = fresh.core
    if j_b(args, "seedDefault") {
      let now_ms = match j_oi64(args, "nowMs") { Some(v) => v; None => 1795442000000.to_int64() }
      seed_all_views_fixture(sess, now_ms)
      sess.sim.writes = 0
    }
    return Some(ok_resp(base_codec::json_bool(true)))
  }
  if op == "core.reopen" {
    let ws = match j_os(args, "workspace") { Some(s) => s; None => sess.core.workspace }
    let st = match j_os(args, "station") { Some(s) => s; None => sess.core.station }
    sess.core.stop()
    let tr = sync::StationTransport::{
      request_k: fn(_m : String, _p : String, _h : Array[(String, String)], _b : Bytes, k : (effect::Exit[sync::HttpReply]) -> Unit) -> Unit {
        k(effect::Exit::Succeeded(sync::HttpReply::{ status: 200, headers: [], body: "{}".to_bytes() }))
      },
      stream_k: fn(_p : String, _h : Array[(String, String)], _c : (Bytes) -> Unit, k : (effect::Exit[Unit]) -> Unit) -> Unit {
        k(effect::Exit::Succeeded(()))
      },
    }
    sess.core = sync::ClientCore::new(ws, st, sess.rt, sess.db, tr, fn() -> Unit {})
    return Some(ok_resp(base_codec::json_obj([("conn", base_codec::json_int64(sess.core.auth.conn_seq()))])))
  }
  if op == "core.wire" {
    let raw_str = match base_codec::json_get(args, "rawText") {
      Some(base_codec::Json::Str(s)) => s
      _ => base_codec::json_stringify(get_json(args, "msg"))
    }
    match sess.core.handle_wire(raw_str) {
      None => return Some(ok_resp(base_codec::json_null()))
      Some((resp_json, _bytes)) => {
        match base_codec::json_parse(resp_json) {
          base_codec::JsonParseResult::Ok(j) => return Some(ok_resp(j))
          base_codec::JsonParseResult::Err(e) => return Some(err_resp("bad wire json: " + e))
        }
      }
    }
  }
  if op == "core.refreshTopic" {
    let frames = sess.core.refresh_topic_wire(j_s(args, "topic"))
    let out : Array[base_codec::Json] = []
    for i in 0..<frames.length() {
      let (s, _) = frames[i]
      match base_codec::json_parse(s) {
        base_codec::JsonParseResult::Ok(j) => out.push(j)
        base_codec::JsonParseResult::Err(_) => ()
      }
    }
    return Some(ok_resp(base_codec::json_arr(out)))
  }
  if op == "core.mutateChat" {
    let st = match j_os(args, "station") { Some(s) => s; None => sess.core.station }
    let id = j_s(args, "id")
    let arch = j_i(args, "archived")
    let key = st + ":" + arch.to_string() + ":" + id
    let raw_doc = get_json(args, "doc")
    let doc_str = base_codec::json_stringify(raw_doc)
    let pin = j_oi64(args, "pinnedAt")
    let last_act = j_i64(args, "lastActiveAt")
    let th = j_oi(args, "thread")
    let ses = j_os(args, "session")
    // If archiving an active chat, remove its archived=0 row so list drops it.
    if arch == 1 {
      sess.sim.chats.remove(st + ":0:" + id)
    }
    sess.sim.put_chat_row(ParityChatRow::{
      station: st,
      archived: arch,
      id: id,
      ord: 1.0,
      thread: th,
      session: ses,
      pinned_at: pin,
      last_active: last_act,
      json: doc_str,
    })
    let _ = key
    return Some(ok_resp(base_codec::json_bool(true)))
  }
  if op == "core.sqlWrites" {
    let w = sess.sim.writes
    if j_b(args, "reset") {
      sess.sim.writes = 0
    }
    return Some(ok_resp(base_codec::json_int(w)))
  }

  None
}
