// Layer 3 differential parity RPC handlers for `parity_cli`:
// - Sub-suite 1: `store.*` (SQLite schema DDLs + `md_key` + `older_md_keys`)
// - Sub-suite 2: `lock.*` (`links_valid`, `keep_entries`, `again_of`, `vouchers_in`, `approved_in`, `effective_state`)
// - Sub-suite 3: `views.projectAll` (all 26 topics projected from real `views::*` + `ClientCore`)
// - Sub-suite 4: `core.*` (stateful `sync::ClientCore` + `ParitySimDb` wire session driver)

import "base_codec"
import "effect"
import "form"
import "lock"
import "protocol"
import "sql"
import "store"
import "sync"
import "views"

pub struct ParityCoreSession {
  pub mut rt : effect::Runtime
  pub mut sim : ParitySimDb
  pub mut db : sql::Sql
  pub mut core : sync::ClientCore
}

pub fn ParityCoreSession::new(workspace : String, station : String) -> ParityCoreSession {
  let rt = effect::Runtime::new()
  let sim = ParitySimDb::new(rt)
  let db = match sql::Sql::open(sim.sh, "parity") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => panic("failed to open ParitySimDb")
  }
  let core = sync::ClientCore::new(workspace, station, rt, db, make_noop_transport(), fn() -> Unit {})
  ParityCoreSession::{ rt: rt, sim: sim, db: db, core: core }
}

fn j_s(j : base_codec::Json, k : String) -> String {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
}

fn j_os(j : base_codec::Json, k : String) -> Option[String] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Str(s)) => Some(s)
    _ => None
  }
}

fn j_b(j : base_codec::Json, k : String) -> Bool {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Bool(b)) => b
    _ => false
  }
}

fn j_i(j : base_codec::Json, k : String) -> Int {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, _)) => n.to_int()
    _ => 0
  }
}

fn j_i64(j : base_codec::Json, k : String) -> Int64 {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, _)) => n.to_int64()
    _ => 0.to_int64()
  }
}

fn j_oi(j : base_codec::Json, k : String) -> Option[Int] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, _)) => Some(n.to_int())
    _ => None
  }
}

fn j_oi64(j : base_codec::Json, k : String) -> Option[Int64] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, _)) => Some(n.to_int64())
    _ => None
  }
}

fn j_onum(j : base_codec::Json, k : String) -> Option[Double] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, _)) => Some(n)
    _ => None
  }
}

fn j_arr_l3(j : base_codec::Json, k : String) -> Array[base_codec::Json] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Arr(a)) => a
    _ => []
  }
}

fn parse_form_entries(arr : Array[base_codec::Json]) -> Array[form::Json] {
  let out : Array[form::Json] = []
  for i in 0..<arr.length() {
    out.push(base_to_form(arr[i]))
  }
  out
}

fn form_entries_to_base(arr : Array[form::Json]) -> base_codec::Json {
  let out : Array[base_codec::Json] = []
  for i in 0..<arr.length() {
    out.push(form_to_base(arr[i]))
  }
  base_codec::json_arr(out)
}

fn parse_own_standings(j : base_codec::Json) -> views::OwnStandings {
  let devs : Map[String, views::OwnDevice] = Map::new()
  let ids : Array[String] = []
  let arr = j_arr_l3(j, "devices")
  for i in 0..<arr.length() {
    let d = arr[i]
    let id = j_s(d, "id")
    ids.push(id)
    devs.set(id, views::OwnDevice::{
      id: id,
      sub: j_s(d, "sub"),
      label: j_s(d, "label"),
      sign_key: j_os(d, "sign_key"),
      said: j_os(d, "said"),
      by: j_os(d, "by"),
      by_sub: j_os(d, "bySub"),
      by_key: j_os(d, "byKey"),
      since: j_i(d, "since"),
    })
  }
  views::OwnStandings::{ devices: devs, device_ids: ids }
}

fn str_set_from_arr(arr : Array[base_codec::Json]) -> Map[String, Bool] {
  let m : Map[String, Bool] = Map::new()
  for i in 0..<arr.length() {
    match arr[i] {
      base_codec::Json::Str(s) => m.set(s, true)
      _ => ()
    }
  }
  m
}

/// Subject extractor matching `client/core-ts/src/views/lock.ts` / `personal-lock.ts`.
fn lock_entry_subject(e : form::Json) -> Option[String] {
  let kind = match form::json_field(Some(e), "kind") {
    Some(form::Json::Str(k)) => k
    _ => return None
  }
  let body = form::json_field(Some(e), "body")
  if kind == "device" || kind == "remove_device" || kind == "renew_device" || kind == "device.add" || kind == "device.remove" {
    match form::json_field(body, "id") {
      Some(form::Json::Str(id)) => Some("device:" + id)
      _ => None
    }
  } else if kind == "member" || kind == "remove_member" || kind == "role" || kind == "member.add" || kind == "member.remove" {
    match form::json_field(body, "sub") {
      Some(form::Json::Str(s)) => Some("member:" + s)
      _ => None
    }
  } else if kind == "station" || kind == "remove_station" || kind == "station.add" || kind == "station.remove" {
    match form::json_field(body, "key") {
      Some(form::Json::Str(k)) => Some("station:" + k)
      _ => None
    }
  } else if kind == "disable" || kind == "moved" {
    Some("lock")
  } else {
    None
  }
}

