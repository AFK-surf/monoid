// Typed, zero-serialization hand-off from the client core to the UI frame thread.
// Mirrors `libs/client-core/src/outbox/outbox.mbt`: multiple `tell` calls coalesce into
// one `wake` callback; `take(most=...)` drains up to `most` items and schedules the next
// frame if more remain. Nothing is polled when nothing is told.

pub struct OutboxMeta {
  pub ws : String
  pub station : String
  pub purge_gen : Int64
}

fn empty_outbox_meta() -> OutboxMeta {
  OutboxMeta::{ ws: "", station: "", purge_gen: 0L }
}

pub struct FrameOutbox[T] {
  mut queue : Array[T]
  mut metas : Array[OutboxMeta]
  mut meta_fn : Option[(T) -> OutboxMeta]
  wake_fn : () -> Unit
  mut asked : Bool
  mut wakes_count : Int
  mut takes_count : Int
}

pub fn FrameOutbox::new[T](wake : () -> Unit) -> FrameOutbox[T] {
  FrameOutbox::{
    queue: [],
    metas: [],
    meta_fn: None,
    wake_fn: wake,
    asked: false,
    wakes_count: 0,
    takes_count: 0,
  }
}

/// Configure an optional synchronous metadata stamper run at enqueue time (`tell`) so consumers
/// freeze `(ws, station, workspace_purge_gen)` at enqueue and reject pre-purge frames even across
/// same-turn revoke + rejoin without falsely dropping frames on normal lock `authGen` updates.
pub fn FrameOutbox::set_meta_fn[T](self : FrameOutbox[T], f : (T) -> OutboxMeta) -> Unit {
  self.meta_fn = Some(f)
}

fn FrameOutbox::ask[T](self : FrameOutbox[T]) -> Unit {
  if self.asked {
    return
  }
  self.asked = true
  self.wakes_count += 1
  let f = self.wake_fn
  f()
}

/// Enqueue a typed change for the next frame, coalescing wake requests.
pub fn FrameOutbox::tell[T](self : FrameOutbox[T], change : T) -> Unit {
  let m = match self.meta_fn {
    Some(f) => f(change)
    None => empty_outbox_meta()
  }
  self.queue.push(change)
  self.metas.push(m)
  self.ask()
}

/// Drain pending changes with their frozen enqueue-time metadata in FIFO order, taking at most `most`.
/// If items remain, immediately requests the next frame.
pub fn FrameOutbox::take_with_meta[T](self : FrameOutbox[T], most : Option[Int] = None) -> Array[(T, OutboxMeta)] {
  self.asked = false
  self.takes_count += 1
  match most {
    Some(raw_m) => {
      if raw_m < self.queue.length() {
        let m = if raw_m < 0 { 0 } else { raw_m }
        let out : Array[(T, OutboxMeta)] = []
        for i in 0..<m {
          let meta = if i < self.metas.length() { self.metas[i] } else { empty_outbox_meta() }
          out.push((self.queue[i], meta))
        }
        let rest_q : Array[T] = []
        let rest_m : Array[OutboxMeta] = []
        for i in m..<self.queue.length() {
          rest_q.push(self.queue[i])
          let meta = if i < self.metas.length() { self.metas[i] } else { empty_outbox_meta() }
          rest_m.push(meta)
        }
        self.queue = rest_q
        self.metas = rest_m
        self.ask()
        out
      } else {
        let out : Array[(T, OutboxMeta)] = []
        for i in 0..<self.queue.length() {
          let meta = if i < self.metas.length() { self.metas[i] } else { empty_outbox_meta() }
          out.push((self.queue[i], meta))
        }
        self.queue = []
        self.metas = []
        out
      }
    }
    None => {
      let out : Array[(T, OutboxMeta)] = []
      for i in 0..<self.queue.length() {
        let meta = if i < self.metas.length() { self.metas[i] } else { empty_outbox_meta() }
        out.push((self.queue[i], meta))
      }
      self.queue = []
      self.metas = []
      out
    }
  }
}

/// Drain pending changes in FIFO order, taking at most `most` when specified.
/// If items remain, immediately requests the next frame.
pub fn FrameOutbox::take[T](self : FrameOutbox[T], most : Option[Int] = None) -> Array[T] {
  let pairs = self.take_with_meta(most=most)
  let out : Array[T] = []
  for i in 0..<pairs.length() {
    out.push(pairs[i].0)
  }
  out
}

/// Keep only queued changes satisfying `keep(item, frozen_meta)`, dropping revoked/stale frames immediately.
pub fn FrameOutbox::retain_where_meta[T](self : FrameOutbox[T], keep : (T, OutboxMeta) -> Bool) -> Unit {
  let next_q : Array[T] = []
  let next_m : Array[OutboxMeta] = []
  for i in 0..<self.queue.length() {
    let meta = if i < self.metas.length() { self.metas[i] } else { empty_outbox_meta() }
    if keep(self.queue[i], meta) {
      next_q.push(self.queue[i])
      next_m.push(meta)
    }
  }
  self.queue = next_q
  self.metas = next_m
  if self.queue.length() == 0 {
    self.asked = false
  }
}

/// Keep only queued changes satisfying `keep`, dropping revoked/stale frames immediately.
pub fn FrameOutbox::retain_where[T](self : FrameOutbox[T], keep : (T) -> Bool) -> Unit {
  self.retain_where_meta(fn(ev : T, _ : OutboxMeta) -> Bool { keep(ev) })
}

/// Discard all queued changes without waking or delivering them (used on logout / account switch).
pub fn FrameOutbox::clear[T](self : FrameOutbox[T]) -> Unit {
  self.queue = []
  self.metas = []
  self.asked = false
}

/// Number of changes waiting to be taken.
pub fn FrameOutbox::waiting[T](self : FrameOutbox[T]) -> Int {
  self.queue.length()
}

/// Total number of frame wakes requested so far.
pub fn FrameOutbox::wakes[T](self : FrameOutbox[T]) -> Int {
  self.wakes_count
}

/// Total number of frame takes performed so far.
pub fn FrameOutbox::takes[T](self : FrameOutbox[T]) -> Int {
  self.takes_count
}
