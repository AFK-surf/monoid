// Priority sync scheduler (Rule 4: one sync engine owns all network traffic;
// UI subscriptions only read local SQLite and raise priority via `client.focus`).
// Built directly on `AFK-surf/pion-packages` `effect` (`Scheduler`, `urgent_room`, `prioritize`, `Preempt`).

import "base_codec"
import "effect"
import "sql"

pub struct SyncScheduler {
  pub workspace : String
  pub station : String
  pub lane : effect::Scheduler
  pub events : StationEvents
  pub mut transport : StationTransport
  mut transport_epoch : Int64
  mut auth : Option[AuthGenTracker]
  pending_refresh : Map[String, Bool]
  mut focused_thread : Option[Int]
  mut idle_preempted_count : Int
  mut completed_order : Array[String]
}

pub fn SyncScheduler::new(
  workspace : String,
  station : String,
  events : StationEvents,
  transport : StationTransport,
  width : Int = 2,
  urgent_room : Int = 2,
) -> SyncScheduler {
  SyncScheduler::{
    workspace: workspace,
    station: station,
    lane: effect::Scheduler::new(width=width, urgent_room=urgent_room),
    events: events,
    transport: transport,
    transport_epoch: 1L,
    auth: None,
    pending_refresh: Map::new(),
    focused_thread: None,
    idle_preempted_count: 0,
    completed_order: [],
  }
}

/// Bind an `AuthGenTracker` so non-lock station reads run through fail-open `guarded_read_k`.
pub fn SyncScheduler::set_auth_tracker(self : SyncScheduler, tracker : AuthGenTracker) -> Unit {
  self.auth = Some(tracker)
}

fn SyncScheduler::task_key(self : SyncScheduler, resource : String) -> String {
  self.workspace + "/" + self.station + "/" + resource
}

pub fn SyncScheduler::has_pending_refresh(self : SyncScheduler, resource : String) -> Bool {
  self.pending_refresh.get(self.task_key(resource)).is_some()
}

pub fn SyncScheduler::idle_preemptions(self : SyncScheduler) -> Int {
  self.idle_preempted_count
}

pub fn SyncScheduler::completed_tasks(self : SyncScheduler) -> Array[String] {
  self.completed_order
}

/// Bump the transport epoch so any in-flight reads from a prior transport are discarded
/// and any pending stale-refresh reschedules stop immediately.
pub fn SyncScheduler::bump_epoch(self : SyncScheduler) -> Unit {
  self.transport_epoch += 1L
  self.pending_refresh.clear()
}

/// Swap the underlying `StationTransport` for all scheduled sync reads (`GET /chats`, `GET /lock`, etc.).
pub fn SyncScheduler::set_transport(self : SyncScheduler, transport : StationTransport) -> Unit {
  self.transport_epoch += 1L
  self.pending_refresh.clear()
  self.transport = transport
}

/// Raise priority for the currently focused chat/thread (`client.focus`),
/// immediately preempting any running `idle` prefetch task.
pub fn SyncScheduler::focus_thread(self : SyncScheduler, thread : Option[Int]) -> Unit {
  self.focused_thread = thread
  match thread {
    Some(th) => {
      let prefix = self.task_key("thread:" + th.to_string())
      self.lane.prioritize("focus", Some(prefix), boost=effect::priority_focused())
    }
    None => {
      self.lane.prioritize("focus", None)
    }
  }
}

/// Schedule a workspace lock fetch (`GET /lock`) at the given priority.
/// Parses `{ head, entries, aside? }` and forwards it to `StationEvents::notify_lock_payload`
/// (`ClientCore::handle_lock_event` -> `ClientCore::apply_lock_chain`), preserving Gate #2
/// genesis pinning, anti-rollback, and SQLite `workspace_pref(ws, "lock")` persistence.
/// Never blocked by `authGen` (lock itself updates `authGen`), guarded by `transport_epoch`.
pub fn SyncScheduler::fetch_lock_k(
  self : SyncScheduler,
  priority : Int,
  k : (effect::Exit[Bool]) -> Unit,
) -> Unit {
  let key = self.task_key("lock")
  self.lane.run_k(
    key,
    priority,
    fn(_preempt : effect::Preempt, tk : (effect::Exit[Bool]) -> Unit) -> Unit {
      let ep = self.transport_epoch
      let req_fn = self.transport.request_k
      req_fn("GET", "/lock", [], Bytes::new(0), fn(ex : effect::Exit[HttpReply]) -> Unit {
        if self.transport_epoch != ep {
          tk(effect::Exit::Failed(effect::EffectError::Custom("transport_epoch_changed")))
          return
        }
        match ex {
          effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
          effect::Exit::Succeeded(reply) => {
            if reply.status == 404 {
              self.completed_order.push("lock")
              tk(effect::Exit::Succeeded(false))
              return
            }
            if reply.status < 200 || reply.status >= 300 {
              tk(effect::Exit::Failed(effect::EffectError::Custom("lock fetch status " + reply.status.to_string())))
              return
            }
            match base_codec::json_parse(bytes_to_str(reply.body)) {
              base_codec::JsonParseResult::Err(e) => tk(effect::Exit::Failed(effect::EffectError::Custom(e)))
              base_codec::JsonParseResult::Ok(j) => {
                if self.transport_epoch != ep {
                  tk(effect::Exit::Failed(effect::EffectError::Custom("transport_epoch_changed")))
                  return
                }
                let has_entries = match base_codec::json_get(j, "entries") {
                  Some(base_codec::Json::Arr(xs)) => xs.length() > 0
                  _ => false
                }
                if has_entries {
                  self.events.notify_lock_payload(j)
                }
                self.completed_order.push("lock")
                tk(effect::Exit::Succeeded(has_entries))
              }
            }
          }
        }
      })
    },
    k,
  )
}

/// Schedule a viewer marks fetch (`GET /chats?marks=1&own=1` with optional `&session=...&thread=...` scope),
/// strictly aligned with `client/core-ts/src/station/sync.ts` `#marksWhole` / `#marksRead`.
/// Atomically persists `reads`/`pins`/`kept`/`hidden`/`muted`/`dismissed` into SQLite `shared_mark`
/// and triggers targeted refresh callbacks for affected `(station, id)` / `thread` keys.
pub fn SyncScheduler::fetch_marks_k(
  self : SyncScheduler,
  priority : Int,
  k : (effect::Exit[Array[String]]) -> Unit,
  sessions : Array[String] = [],
  threads : Array[Int] = [],
) -> Unit {
  let is_whole = sessions.length() == 0 && threads.length() == 0
  let key = self.task_key(if is_whole { "marks:whole" } else { "marks:scoped" })
  let path_sb = StringBuilder::new()
  path_sb.write_string("/chats?marks=1&own=1")
  for i in 0..<sessions.length() {
    if sessions[i].length() > 0 {
      path_sb.write_string("&session=")
      path_sb.write_string(encode_uri_component(sessions[i]))
    }
  }
  for i in 0..<threads.length() {
    path_sb.write_string("&thread=")
    path_sb.write_string(threads[i].to_string())
  }
  let req_path = path_sb.to_string()
  let run_ep : Array[Int64] = [self.transport_epoch]
  self.lane.run_k(
    key,
    priority,
    fn(_preempt : effect::Preempt, tk : (effect::Exit[Array[String]]) -> Unit) -> Unit {
      let ep = self.transport_epoch
      run_ep[0] = ep
      let do_fetch_io = fn(fk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
        let req_fn = self.transport.request_k
        req_fn("GET", req_path, [], Bytes::new(0), fn(ex : effect::Exit[HttpReply]) -> Unit {
          if self.transport_epoch != ep {
            fk(effect::Exit::Failed(effect::EffectError::Custom("transport_epoch_changed")))
            return
          }
          match ex {
            effect::Exit::Interrupted => fk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => fk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(reply) => {
              if reply.status < 200 || reply.status >= 300 {
                fk(effect::Exit::Failed(effect::EffectError::Custom("marks fetch status " + reply.status.to_string())))
                return
              }
              match base_codec::json_parse(bytes_to_str(reply.body)) {
                base_codec::JsonParseResult::Err(e) => fk(effect::Exit::Failed(effect::EffectError::Custom(e)))
                base_codec::JsonParseResult::Ok(j) => fk(effect::Exit::Succeeded(j))
              }
            }
          }
        })
      }
      let apply_json = fn(j : base_codec::Json) -> Result[Array[String], String] {
        if self.transport_epoch != ep {
          return Err("transport_epoch_changed")
        }
        match self.events.apply_marks_to_db(j, is_whole, scoped_sessions=sessions, scoped_threads=threads) {
          sql::SqlResult::Err(e) => Err(e.to_string())
          sql::SqlResult::Ok(affected) => {
            self.pending_refresh.remove(key)
            self.completed_order.push("marks")
            Ok(affected)
          }
        }
      }
      match self.auth {
        Some(tracker) => {
          guarded_read_k(
            tracker,
            self.workspace,
            fn(_cap : WorkspaceCapability, io_done : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
              do_fetch_io(io_done)
            },
            fn(_cap : WorkspaceCapability, j : base_codec::Json) -> Result[Array[String], String] {
              apply_json(j)
            },
            tk,
            on_exhausted_stale=Some(fn() -> Unit {
              if self.transport_epoch == ep {
                self.pending_refresh.set(key, true)
              }
            }),
          )
        }
        None =>
        do_fetch_io(fn(ex : effect::Exit[base_codec::Json]) -> Unit {
          match ex {
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(j) =>
            match apply_json(j) {
              Ok(affected) => tk(effect::Exit::Succeeded(affected))
              Err(msg) => tk(effect::Exit::Failed(effect::EffectError::Custom(msg)))
            }
          }
        })
      }
    },
    fn(ex : effect::Exit[Array[String]]) -> Unit {
      match ex {
        effect::Exit::Failed(effect::EffectError::Custom("auth_stale")) => {
          if self.pending_refresh.get(key).is_some() && self.transport_epoch == run_ep[0] {
            self.pending_refresh.remove(key)
            self.fetch_marks_k(priority, k, sessions=sessions, threads=threads)
            return
          }
          self.pending_refresh.remove(key)
          k(ex)
        }
        other => {
          self.pending_refresh.remove(key)
          k(other)
        }
      }
    },
  )
}

/// Schedule a snapshot fetch (`GET /chats`) at `priority_shown()` (or `priority_focused()`).
pub fn SyncScheduler::fetch_snapshot_k(
  self : SyncScheduler,
  priority : Int,
  k : (effect::Exit[Int]) -> Unit,
) -> Unit {
  let key = self.task_key("snapshot")
  let run_ep : Array[Int64] = [self.transport_epoch]
  self.lane.run_k(
    key,
    priority,
    fn(_preempt : effect::Preempt, tk : (effect::Exit[Int]) -> Unit) -> Unit {
      let ep = self.transport_epoch
      run_ep[0] = ep
      let do_fetch_io = fn(fk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
        let req_fn = self.transport.request_k
        req_fn("GET", "/chats", [], Bytes::new(0), fn(ex : effect::Exit[HttpReply]) -> Unit {
          if self.transport_epoch != ep {
            fk(effect::Exit::Failed(effect::EffectError::Custom("transport_epoch_changed")))
            return
          }
          match ex {
            effect::Exit::Interrupted => fk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => fk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(reply) => {
              if reply.status < 200 || reply.status >= 300 {
                fk(effect::Exit::Failed(effect::EffectError::Custom("snapshot status " + reply.status.to_string())))
                return
              }
              match base_codec::json_parse(bytes_to_str(reply.body)) {
                base_codec::JsonParseResult::Err(e) => fk(effect::Exit::Failed(effect::EffectError::Custom(e)))
                base_codec::JsonParseResult::Ok(j) => fk(effect::Exit::Succeeded(j))
              }
            }
          }
        })
      }
      let apply_json = fn(j : base_codec::Json) -> Result[Int, String] {
        if self.transport_epoch != ep {
          return Err("transport_epoch_changed")
        }
        match self.events.apply_snapshot(j) {
          sql::SqlResult::Err(e) => Err(e.to_string())
          sql::SqlResult::Ok(n) => {
            self.pending_refresh.remove(key)
            self.completed_order.push("snapshot")
            Ok(n)
          }
        }
      }
      match self.auth {
        Some(tracker) => {
          guarded_read_k(
            tracker,
            self.workspace,
            fn(_cap : WorkspaceCapability, io_done : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
              do_fetch_io(io_done)
            },
            fn(_cap : WorkspaceCapability, j : base_codec::Json) -> Result[Int, String] {
              apply_json(j)
            },
            tk,
            on_exhausted_stale=Some(fn() -> Unit {
              if self.transport_epoch == ep {
                self.pending_refresh.set(key, true)
              }
            }),
          )
        }
        None =>
        do_fetch_io(fn(ex : effect::Exit[base_codec::Json]) -> Unit {
          match ex {
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(j) =>
            match apply_json(j) {
              Ok(n) => tk(effect::Exit::Succeeded(n))
              Err(msg) => tk(effect::Exit::Failed(effect::EffectError::Custom(msg)))
            }
          }
        })
      }
    },
    fn(ex : effect::Exit[Int]) -> Unit {
      match ex {
        effect::Exit::Failed(effect::EffectError::Custom("auth_stale")) => {
          if self.pending_refresh.get(key).is_some() && self.transport_epoch == run_ep[0] {
            self.pending_refresh.remove(key)
            self.fetch_snapshot_k(priority, k)
            return
          }
          self.pending_refresh.remove(key)
          k(ex)
        }
        other => {
          self.pending_refresh.remove(key)
          k(other)
        }
      }
    },
  )
}

/// Schedule a thread entry fetch (`GET /threads/<id>/entries`) at the given priority.
/// When `is_foreground` is true (`client.focus`), holds a foreground token so `idle` work yields immediately.
pub fn SyncScheduler::fetch_thread_k(
  self : SyncScheduler,
  thread : Int,
  priority : Int,
  is_foreground : Bool,
  k : (effect::Exit[Int]) -> Unit,
) -> Unit {
  let key = self.task_key("thread:" + thread.to_string())
  let end_fg = if is_foreground {
    Some(self.lane.foreground_begin())
  } else {
    None
  }
  let run_ep : Array[Int64] = [self.transport_epoch]
  self.lane.run_k(
    key,
    priority,
    fn(_preempt : effect::Preempt, tk : (effect::Exit[Int]) -> Unit) -> Unit {
      let ep = self.transport_epoch
      run_ep[0] = ep
      let path = "/threads/" + thread.to_string() + "/entries"
      let do_fetch_io = fn(fk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
        let req_fn = self.transport.request_k
        req_fn("GET", path, [], Bytes::new(0), fn(ex : effect::Exit[HttpReply]) -> Unit {
          if self.transport_epoch != ep {
            fk(effect::Exit::Failed(effect::EffectError::Custom("transport_epoch_changed")))
            return
          }
          match ex {
            effect::Exit::Interrupted => fk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => fk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(reply) => {
              if reply.status < 200 || reply.status >= 300 {
                fk(effect::Exit::Failed(effect::EffectError::Custom("thread fetch status " + reply.status.to_string())))
                return
              }
              match base_codec::json_parse(bytes_to_str(reply.body)) {
                base_codec::JsonParseResult::Err(e) => fk(effect::Exit::Failed(effect::EffectError::Custom(e)))
                base_codec::JsonParseResult::Ok(j) => fk(effect::Exit::Succeeded(j))
              }
            }
          }
        })
      }
      let apply_json = fn(j : base_codec::Json) -> Result[Int, String] {
        if self.transport_epoch != ep {
          return Err("transport_epoch_changed")
        }
        match self.events.apply_snapshot(j) {
          sql::SqlResult::Err(e) => Err(e.to_string())
          sql::SqlResult::Ok(n) => {
            self.pending_refresh.remove(key)
            self.completed_order.push("thread:" + thread.to_string())
            Ok(n)
          }
        }
      }
      match self.auth {
        Some(tracker) => {
          guarded_read_k(
            tracker,
            self.workspace,
            fn(_cap : WorkspaceCapability, io_done : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
              do_fetch_io(io_done)
            },
            fn(_cap : WorkspaceCapability, j : base_codec::Json) -> Result[Int, String] {
              apply_json(j)
            },
            tk,
            on_exhausted_stale=Some(fn() -> Unit {
              if self.transport_epoch == ep {
                self.pending_refresh.set(key, true)
              }
            }),
          )
        }
        None =>
        do_fetch_io(fn(ex : effect::Exit[base_codec::Json]) -> Unit {
          match ex {
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(j) =>
            match apply_json(j) {
              Ok(n) => tk(effect::Exit::Succeeded(n))
              Err(msg) => tk(effect::Exit::Failed(effect::EffectError::Custom(msg)))
            }
          }
        })
      }
    },
    fn(ex : effect::Exit[Int]) -> Unit {
      match end_fg {
        Some(f) => f()
        None => ()
      }
      match ex {
        effect::Exit::Failed(effect::EffectError::Custom("auth_stale")) => {
          if self.pending_refresh.get(key).is_some() && self.transport_epoch == run_ep[0] {
            self.pending_refresh.remove(key)
            self.fetch_thread_k(thread, priority, false, k)
            return
          }
          self.pending_refresh.remove(key)
          k(ex)
        }
        other => {
          self.pending_refresh.remove(key)
          k(other)
        }
      }
    },
  )
}

/// Schedule an `idle` prefetch task for `thread` that cooperates with `Preempt` AND routes
/// through fail-open `guarded_read_k` + `transport_epoch` (preventing stale authGen write-backs).
pub fn SyncScheduler::prefetch_idle_k(
  self : SyncScheduler,
  thread : Int,
  k : (effect::Exit[Int]) -> Unit,
) -> Unit {
  let key = self.task_key("idle:" + thread.to_string())
  let run_ep : Array[Int64] = [self.transport_epoch]
  self.lane.run_k(
    key,
    effect::priority_idle(),
    fn(preempt : effect::Preempt, tk : (effect::Exit[Int]) -> Unit) -> Unit {
      if preempt.is_preempted() {
        self.idle_preempted_count += 1
        tk(effect::Exit::Failed(effect::EffectError::Custom("preempted")))
        return
      }
      let ep = self.transport_epoch
      run_ep[0] = ep
      let path = "/threads/" + thread.to_string() + "/entries"
      let do_fetch_io = fn(fk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
        let req_fn = self.transport.request_k
        effect::race_first_k(
          fn(rk : (effect::Exit[Option[HttpReply]]) -> Unit) -> Unit {
            req_fn("GET", path, [], Bytes::new(0), fn(ex : effect::Exit[HttpReply]) -> Unit {
              match ex {
                effect::Exit::Succeeded(r) => rk(effect::Exit::Succeeded(Some(r)))
                effect::Exit::Failed(e) => rk(effect::Exit::Failed(e))
                effect::Exit::Interrupted => rk(effect::Exit::Interrupted)
              }
            })
          },
          fn(rk : (effect::Exit[Option[HttpReply]]) -> Unit) -> Unit {
            preempt.wait_k(fn(pex : effect::Exit[Unit]) -> Unit {
              match pex {
                effect::Exit::Succeeded(_) => rk(effect::Exit::Succeeded(None))
                effect::Exit::Failed(e) => rk(effect::Exit::Failed(e))
                effect::Exit::Interrupted => rk(effect::Exit::Interrupted)
              }
            })
          },
          fn(rex : effect::Exit[Option[HttpReply]]) -> Unit {
            if self.transport_epoch != ep {
              fk(effect::Exit::Failed(effect::EffectError::Custom("transport_epoch_changed")))
              return
            }
            match rex {
              effect::Exit::Interrupted => fk(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => fk(effect::Exit::Failed(e))
              effect::Exit::Succeeded(None) => {
                self.idle_preempted_count += 1
                fk(effect::Exit::Failed(effect::EffectError::Custom("preempted")))
              }
              effect::Exit::Succeeded(Some(reply)) => {
                if reply.status < 200 || reply.status >= 300 {
                  fk(effect::Exit::Failed(effect::EffectError::Custom("idle fetch status " + reply.status.to_string())))
                  return
                }
                match base_codec::json_parse(bytes_to_str(reply.body)) {
                  base_codec::JsonParseResult::Err(e) => fk(effect::Exit::Failed(effect::EffectError::Custom(e)))
                  base_codec::JsonParseResult::Ok(j) => fk(effect::Exit::Succeeded(j))
                }
              }
            }
          },
        )
      }
      let apply_idle = fn(j : base_codec::Json) -> Result[Int, String] {
        if self.transport_epoch != ep {
          return Err("transport_epoch_changed")
        }
        match self.events.apply_snapshot(j) {
          sql::SqlResult::Err(e) => Err(e.to_string())
          sql::SqlResult::Ok(n) => {
            self.pending_refresh.remove(key)
            self.completed_order.push("idle:" + thread.to_string())
            Ok(n)
          }
        }
      }
      match self.auth {
        Some(tracker) => {
          guarded_read_k(
            tracker,
            self.workspace,
            fn(_cap : WorkspaceCapability, io_done : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
              do_fetch_io(io_done)
            },
            fn(_cap : WorkspaceCapability, j : base_codec::Json) -> Result[Int, String] {
              apply_idle(j)
            },
            tk,
            on_exhausted_stale=Some(fn() -> Unit {
              if self.transport_epoch == ep {
                self.pending_refresh.set(key, true)
              }
            }),
          )
        }
        None =>
        do_fetch_io(fn(ex : effect::Exit[base_codec::Json]) -> Unit {
          match ex {
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(j) =>
            match apply_idle(j) {
              Ok(n) => tk(effect::Exit::Succeeded(n))
              Err(msg) => tk(effect::Exit::Failed(effect::EffectError::Custom(msg)))
            }
          }
        })
      }
    },
    fn(ex : effect::Exit[Int]) -> Unit {
      match ex {
        effect::Exit::Failed(effect::EffectError::Custom("preempted")) => {
          if self.transport_epoch == run_ep[0] {
            // Re-queue behind foreground work once the lane is idle again.
            self.prefetch_idle_k(thread, k)
          } else {
            self.pending_refresh.remove(key)
            k(effect::Exit::Failed(effect::EffectError::Custom("transport_epoch_changed")))
          }
        }
        effect::Exit::Failed(effect::EffectError::Custom("auth_stale")) => {
          if self.pending_refresh.get(key).is_some() && self.transport_epoch == run_ep[0] {
            self.pending_refresh.remove(key)
            self.prefetch_idle_k(thread, k)
            return
          }
          self.pending_refresh.remove(key)
          k(ex)
        }
        other => {
          self.pending_refresh.remove(key)
          k(other)
        }
      }
    },
  )
}
