// Deterministic end-to-end simulation tests for `pion/client-core/packages/sync`:
// `SimAccountDb` (in-memory SQLite stand-in with statement/write/tx counters) +
// `SimStation` (deterministic HTTP + SSE `/events` server on `effect::Runtime` virtual clock).

import "base_codec"
import "crypto"
import "effect"
import "form"
import "lock"
import "outbox"
import "protocol"
import "shell"
import "sql"
import "store"

// ── In-memory SimAccountDb with SQL statement/write/Burst counters ──

struct SimChatRow {
  station : String
  archived : Int
  id : String
  ord : Double
  thread : Option[Int]
  session : Option[String]
  pinned_at : Option[Int64]
  last_active : Int64
  unread : Int
  tone : Option[String]
  asks : Int
  json : String
}

struct SimAccountDb {
  sh : shell::Shell
  entries : Map[String, Array[(Int, String)]]
  chats : Map[String, SimChatRow]
  chat_order : Array[String]
  threads : Map[String, String]
  thread_reads : Map[String, (Int, Int)]
  sessions : Map[String, String]
  jobs : Map[String, String]
  outbox_rows : Map[String, String]
  pending_rows : Map[String, String]
  changing_rows : Map[String, String]
  drafts : Map[String, String]
  prefs : Map[String, String]
  pref_order : Array[String]
  said : Array[(String, Int, Int, Int, Int64, String)]
  account_docs : Map[String, String]
  workspaces : Map[String, (String, Option[Int64])]
  workspace_order : Array[String]
  station_docs : Map[String, (String, String, String, Option[Int64])]
  station_doc_order : Array[String]
  shared_marks : Map[String, String]
  log_use : Map[String, Int64]
  md : Map[String, (Int64, String)]
  transcripts : Array[(String, String, Int, String)]
  moved_rows : Map[String, (String, String, String, Option[Int], Option[Int], Option[Int64], Int)]
  meta : Map[String, String]
  mut fail_drop_sql : Bool
  mut fail_sqlite_master : Bool
  ran : Array[String]
}

fn SimAccountDb::new(rt : effect::Runtime) -> SimAccountDb {
  let holder : Array[SimAccountDb] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(_ : Int64, _ : String, _ : base_codec::Json, _ : Option[Bytes]) -> Unit {},
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      holder[0].answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = SimAccountDb::{
    sh: sh,
    entries: Map::new(),
    chats: Map::new(),
    chat_order: [],
    threads: Map::new(),
    thread_reads: Map::new(),
    sessions: Map::new(),
    jobs: Map::new(),
    outbox_rows: Map::new(),
    pending_rows: Map::new(),
    changing_rows: Map::new(),
    drafts: Map::new(),
    prefs: Map::new(),
    pref_order: [],
    said: [],
    account_docs: Map::new(),
    workspaces: Map::new(),
    workspace_order: [],
    station_docs: Map::new(),
    station_doc_order: [],
    shared_marks: Map::new(),
    log_use: Map::new(),
    md: Map::new(),
    transcripts: [],
    moved_rows: Map::new(),
    meta: Map::new(),
    fail_drop_sql: false,
    fail_sqlite_master: false,
    ran: [],
  }
  holder.push(db)
  db
}

fn p_str(params : Array[base_codec::Json], i : Int) -> String {
  if i < 0 || i >= params.length() { "" } else { sql::col_text(params, i) }
}

fn p_int64(params : Array[base_codec::Json], i : Int) -> Int64 {
  if i < 0 || i >= params.length() { 0.to_int64() } else { sql::col_int64(params, i) }
}

fn p_int(params : Array[base_codec::Json], i : Int) -> Int {
  p_int64(params, i).to_int()
}

fn p_opt_int(params : Array[base_codec::Json], i : Int) -> Option[Int] {
  if i < 0 || i >= params.length() {
    None
  } else {
    match sql::col_opt_int64(params, i) {
      Some(v) => Some(v.to_int())
      None => None
    }
  }
}

fn p_opt_int64(params : Array[base_codec::Json], i : Int) -> Option[Int64] {
  if i < 0 || i >= params.length() { None } else { sql::col_opt_int64(params, i) }
}

fn p_opt_str(params : Array[base_codec::Json], i : Int) -> Option[String] {
  if i < 0 || i >= params.length() { None } else { sql::col_opt_text(params, i) }
}

fn SimAccountDb::put_entry_row(self : SimAccountDb, station : String, thread : Int, n : Int, raw : String) -> Unit {
  let k = station + " " + thread.to_string()
  let arr = match self.entries.get(k) {
    Some(a) => a
    None => {
      let a : Array[(Int, String)] = []
      self.entries.set(k, a)
      a
    }
  }
  let mut replaced = false
  for i in 0..<arr.length() {
    if arr[i].0 == n {
      arr[i] = (n, raw)
      replaced = true
      break
    }
  }
  if !replaced {
    arr.push((n, raw))
  }
}

fn SimAccountDb::entry_count(self : SimAccountDb, station : String, thread : Int) -> Int {
  match self.entries.get(station + " " + thread.to_string()) {
    Some(a) => a.length()
    None => 0
  }
}

fn SimAccountDb::answer(self : SimAccountDb, op : String, args : base_codec::Json) -> shell::AskResult {
  if op == "sql.open" {
    return shell::AskResult::Ok(base_codec::json_obj([("id", base_codec::json_int(1))]))
  }
  if op == "sql.close" {
    return shell::AskResult::Ok(base_codec::json_null())
  }
  let stmt = match base_codec::json_get(args, "sql") {
    Some(base_codec::Json::Str(s)) => s
    _ => return shell::AskResult::Err(shell::ShellError::{ message: "missing sql" })
  }
  let p = match base_codec::json_get(args, "params") {
    Some(base_codec::Json::Arr(a)) => a
    _ => []
  }
  self.ran.push(stmt)
  if op == "sql.exec" {
    if stmt == "BEGIN IMMEDIATE" || stmt == "COMMIT" || stmt == "ROLLBACK" {
      return shell::AskResult::Ok(base_codec::json_null())
    }
    return shell::AskResult::Ok(base_codec::json_null())
  }
  let rows : Array[base_codec::Json] = []
  let mut changed = 0
  if stmt == store::sql_window_end() {
    let k = p_str(p, 0) + " " + p_str(p, 1)
    let most = p_int(p, 2)
    match self.entries.get(k) {
      Some(all) => {
        let mut i = all.length() - 1
        while i >= 0 && rows.length() < most {
          let (en, ej) = all[i]
          rows.push(base_codec::json_arr([base_codec::json_int(en), base_codec::json_str(ej)]))
          i -= 1
        }
      }
      None => ()
    }
  } else if stmt == "SELECT n, json FROM entry WHERE station = ? AND thread = ? AND n BETWEEN ? AND ? ORDER BY n" {
    let k = p_str(p, 0) + " " + p_str(p, 1)
    let lo = p_int(p, 2)
    let hi = p_int(p, 3)
    match self.entries.get(k) {
      Some(all) => {
        for i in 0..<all.length() {
          let (en, ej) = all[i]
          if en >= lo && en <= hi {
            rows.push(base_codec::json_arr([base_codec::json_int(en), base_codec::json_str(ej)]))
          }
        }
      }
      None => ()
    }
  } else if stmt.starts_with(store::sql_md_many_head()) {
    let st = p_str(p, 0)
    for i in 1..<p.length() {
      let key = p_str(p, i)
      match self.md.get(st + " " + key) {
        Some((used, j)) => rows.push(base_codec::json_arr([base_codec::json_str(key), base_codec::json_int64(used), base_codec::json_str(j)]))
        None => ()
      }
    }
  } else if stmt == store::sql_opened() {
    match self.log_use.get(p_str(p, 0) + " " + p_str(p, 1) + " " + p_str(p, 2)) {
      Some(at) => rows.push(base_codec::json_arr([base_codec::json_int64(at)]))
      None => ()
    }
  } else if stmt == store::sql_note_opened() {
    self.log_use.set(p_str(p, 0) + " " + p_str(p, 1) + " " + p_str(p, 2), p_int64(p, 3))
    changed = 1
  } else if stmt == sql_entry_put() {
    let st = p_str(p, 0)
    let th = p_int(p, 1)
    let n = p_int(p, 2)
    let raw = p_str(p, 3)
    self.put_entry_row(st, th, n, raw)
    // Mirror `said_put` SQLite trigger for message/edit entries
    match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(j) => {
        let kind = match base_codec::json_get(j, "kind") {
          Some(base_codec::Json::Str(s)) => s
          _ => ""
        }
        if kind == "message" {
          let txt = match base_codec::json_get(j, "text") {
            Some(base_codec::Json::Str(s)) => s
            _ => ""
          }
          let at = match base_codec::json_get(j, "at") {
            Some(base_codec::Json::Num(v, _)) => v.to_int64()
            _ => 0.to_int64()
          }
          self.said.push((st, th, n, n, at, txt))
        }
      }
      base_codec::JsonParseResult::Err(_) => ()
    }
    changed = 1
  } else if stmt == sql_chat_upsert() {
    let st = p_str(p, 0)
    let cid = p_str(p, 1)
    let arch = p_int(p, 2)
    let key = st + ":" + arch.to_string() + ":" + cid
    if self.chats.get(key).is_none() {
      self.chat_order.push(key)
    }
    self.chats.set(key, SimChatRow::{
      station: st,
      archived: arch,
      id: cid,
      ord: sql::col_double(p, 3),
      thread: p_opt_int(p, 4),
      session: p_opt_str(p, 5),
      pinned_at: p_opt_int64(p, 8),
      last_active: p_int64(p, 7),
      unread: p_int(p, 9),
      tone: p_opt_str(p, 12),
      asks: p_int(p, 13),
      json: p_str(p, 15),
    })
    changed = 1
  } else if stmt == store::sql_chat_window() {
    let limit = p_int(p, 6)
    for i in 0..<self.chat_order.length() {
      if rows.length() >= limit {
        break
      }
      match self.chats.get(self.chat_order[i]) {
        Some(c) => {
          if c.archived == 0 {
            let pj = match c.pinned_at {
              Some(ts) => base_codec::json_int64(ts)
              None => base_codec::json_null()
            }
            rows.push(base_codec::json_arr([
              base_codec::json_str(c.station),
              base_codec::json_int(c.archived),
              base_codec::json_str(c.id),
              pj,
              base_codec::json_int64(c.last_active),
              base_codec::json_num(c.ord),
            ]))
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_chat_by_key() {
    let key = p_str(p, 0) + ":" + p_int(p, 1).to_string() + ":" + p_str(p, 2)
    match self.chats.get(key) {
      Some(c) => rows.push(base_codec::json_arr([
        base_codec::json_str(c.station),
        base_codec::json_int(c.archived),
        base_codec::json_str(c.id),
        base_codec::json_str(c.json),
      ]))
      None => ()
    }
  } else if stmt == store::sql_chat_by_session() {
    let st = p_str(p, 0)
    let sess = p_str(p, 1)
    for i in 0..<self.chat_order.length() {
      match self.chats.get(self.chat_order[i]) {
        Some(c) => {
          let sess_match = match c.session {
            Some(s) => s == sess
            None => false
          }
          if c.station == st && sess_match {
            rows.push(base_codec::json_arr([
              base_codec::json_str(c.station),
              base_codec::json_int(c.archived),
              base_codec::json_str(c.id),
              base_codec::json_str(c.json),
            ]))
            break
          }
        }
        None => ()
      }
    }
  } else if stmt == "SELECT id, last_active, json, unread FROM chat WHERE station = ? AND archived = 0 AND (tone IS NOT NULL OR asks = 1)" {
    let st = p_str(p, 0)
    for i in 0..<self.chat_order.length() {
      match self.chats.get(self.chat_order[i]) {
        Some(c) => {
          if c.station == st && c.archived == 0 && (c.tone.is_some() || c.asks == 1) {
            rows.push(base_codec::json_arr([
              base_codec::json_str(c.id),
              base_codec::json_int64(c.last_active),
              base_codec::json_str(c.json),
              base_codec::json_int(c.unread),
            ]))
          }
        }
        None => ()
      }
    }
  } else if stmt == "SELECT thread, json FROM outbox WHERE station = ?" {
    let st = p_str(p, 0)
    let prefix = st + ":"
    let ks = self.outbox_rows.keys()
    for i in 0..<ks.length() {
      let k = ks[i]
      if k.starts_with(prefix) {
        let th_s = k.slice(prefix.length(), k.length())
        let th = match base_codec::parse_int64_str(th_s) { Some(v) => v.to_int(); None => 0 }
        match self.outbox_rows.get(k) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_int(th), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt.contains("archived = 1") {
    let st = p_str(p, 0)
    let lim = p_int(p, 1)
    for i in 0..<self.chat_order.length() {
      if rows.length() >= lim {
        break
      }
      match self.chats.get(self.chat_order[i]) {
        Some(c) =>
        if c.station == st && c.archived == 1 {
          let th_j = match c.thread { Some(t) => base_codec::json_int(t); None => base_codec::json_null() }
          rows.push(base_codec::json_arr([
            base_codec::json_str(c.station),
            base_codec::json_int(c.archived),
            base_codec::json_str(c.id),
            th_j,
            base_codec::json_int64(c.last_active),
            base_codec::json_str(c.json),
          ]))
        }
        None => ()
      }
    }
  } else if stmt == sql_thread_upsert() {
    self.threads.set(p_str(p, 0) + ":" + p_int(p, 1).to_string(), p_str(p, 10))
    changed = 1
  } else if stmt == sql_session_upsert() {
    self.sessions.set(p_str(p, 0) + ":" + p_str(p, 1), p_str(p, 9))
    changed = 1
  } else if stmt == sql_job_upsert() {
    self.jobs.set(p_str(p, 0) + ":" + p_str(p, 1), p_str(p, 6))
    changed = 1
  } else if stmt == sql_outbox_put() {
    self.outbox_rows.set(p_str(p, 0) + ":" + p_int(p, 1).to_string(), p_str(p, 2))
    changed = 1
  } else if stmt == sql_outbox_delete() {
    self.outbox_rows.remove(p_str(p, 0) + ":" + p_int(p, 1).to_string())
    changed = 1
  } else if stmt == store::sql_outbox_one() {
    let st = p_str(p, 0)
    let th = p_int(p, 1)
    match self.outbox_rows.get(st + ":" + th.to_string()) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_int(th), base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == store::sql_outbox_by_station() {
    let st = p_str(p, 0)
    let prefix = st + ":"
    let ks = self.outbox_rows.keys()
    for i in 0..<ks.length() {
      let k = ks[i]
      if k.starts_with(prefix) {
        let th_s = k.slice(prefix.length(), k.length())
        let th = match base_codec::parse_int64_str(th_s) { Some(v) => v.to_int(); None => 0 }
        match self.outbox_rows.get(k) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_int(th), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == "SELECT read, last FROM thread WHERE station = ? AND id = ?" {
    let st = p_str(p, 0)
    let th = p_int(p, 1)
    let tk = st + ":" + th.to_string()
    if self.threads.get(tk).is_some() {
      let (rd, _un) = match self.thread_reads.get(tk) { Some(v) => v; None => (0, 0) }
      rows.push(base_codec::json_arr([base_codec::json_int(rd), base_codec::json_int(rd)]))
    }
  } else if stmt == "UPDATE thread SET read = ?, unread = 0 WHERE station = ? AND id = ?" {
    self.thread_reads.set(p_str(p, 1) + ":" + p_int(p, 2).to_string(), (p_int(p, 0), 0))
    changed = 1
  } else if stmt == "SELECT ord, json, chat, open FROM job WHERE station = ? AND id = ?" {
    let k = p_str(p, 0) + ":" + p_str(p, 1)
    match self.jobs.get(k) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_num(0.0), base_codec::json_str(j), base_codec::json_null(), base_codec::json_int(1)]))
      None => ()
    }
  } else if stmt == "SELECT listed, json, last, read, unread FROM thread WHERE station = ? AND id = ?" {
    let tk = p_str(p, 0) + ":" + p_int(p, 1).to_string()
    match self.threads.get(tk) {
      Some(tj) => {
        let (rd, un) = match self.thread_reads.get(tk) { Some(v) => v; None => (0, 0) }
        rows.push(base_codec::json_arr([
          base_codec::json_int(1),
          base_codec::json_str(tj),
          base_codec::json_int(rd),
          base_codec::json_int(rd),
          base_codec::json_int(un),
        ]))
      }
      None => ()
    }
  } else if stmt == "UPDATE thread SET last = ? WHERE station = ? AND id = ?" ||
  stmt == "UPDATE thread SET read = ? WHERE station = ? AND id = ?" ||
  stmt == "SELECT id, json FROM chat WHERE station = ? AND archived = 0 AND thread = ? AND unread = 1" ||
  stmt == "SELECT ord, summary, listed FROM session WHERE station = ? AND key = ?" ||
  stmt == "SELECT 1 FROM list WHERE station = ? AND list = 'sessions'" ||
  stmt == "SELECT min(ord) FROM session WHERE station = ? AND listed = 1" {
    changed = 1
  } else if stmt == sql_pending_put() {
    self.pending_rows.set(p_str(p, 1) + ":" + p_str(p, 0), p_str(p, 2))
    changed = 1
  } else if stmt == sql_pending_delete() {
    self.pending_rows.remove(p_str(p, 1) + ":" + p_str(p, 0))
    changed = 1
  } else if stmt == sql_changing_put() {
    self.changing_rows.set(p_str(p, 0) + ":" + p_int(p, 1).to_string(), p_str(p, 2))
    changed = 1
  } else if stmt == sql_changing_delete() {
    self.changing_rows.remove(p_str(p, 0) + ":" + p_int(p, 1).to_string())
    changed = 1
  } else if stmt == store::sql_account_doc_put() {
    self.account_docs.set(p_str(p, 0), p_str(p, 1))
    changed = 1
  } else if stmt == store::sql_account_doc_one() {
    match self.account_docs.get(p_str(p, 0)) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == store::sql_workspace_put() {
    let wid = p_str(p, 0)
    if self.workspaces.get(wid).is_none() {
      self.workspace_order.push(wid)
    }
    self.workspaces.set(wid, (p_str(p, 1), p_opt_int64(p, 2)))
    changed = 1
  } else if stmt == store::sql_workspace_all() {
    for i in 0..<self.workspace_order.length() {
      let wid = self.workspace_order[i]
      match self.workspaces.get(wid) {
        Some((j, conf)) => {
          let cj = match conf {
            Some(ts) => base_codec::json_int64(ts)
            None => base_codec::json_null()
          }
          rows.push(base_codec::json_arr([base_codec::json_str(wid), base_codec::json_str(j), cj]))
        }
        None => ()
      }
    }
  } else if stmt == store::sql_station_doc_put() {
    let addr = p_str(p, 0)
    let kind = p_str(p, 1)
    let k = addr + ":" + kind
    if self.station_docs.get(k).is_none() {
      self.station_doc_order.push(k)
    }
    self.station_docs.set(k, (addr, kind, p_str(p, 2), p_opt_int64(p, 3)))
    changed = 1
  } else if stmt == store::sql_station_doc_one() {
    let addr = p_str(p, 0)
    let kind = p_str(p, 1)
    let k = addr + ":" + kind
    match self.station_docs.get(k) {
      Some((a, ki, j, conf)) => {
        let cj = match conf {
          Some(ts) => base_codec::json_int64(ts)
          None => base_codec::json_null()
        }
        rows.push(base_codec::json_arr([
          base_codec::json_str(a),
          base_codec::json_str(ki),
          base_codec::json_str(j),
          cj,
        ]))
      }
      None => ()
    }
  } else if stmt == store::sql_station_doc_by_kind() {
    let want_kind = p_str(p, 0)
    for i in 0..<self.station_doc_order.length() {
      match self.station_docs.get(self.station_doc_order[i]) {
        Some((addr, kind, j, conf)) => {
          if kind == want_kind {
            let cj = match conf {
              Some(ts) => base_codec::json_int64(ts)
              None => base_codec::json_null()
            }
            rows.push(base_codec::json_arr([
              base_codec::json_str(addr),
              base_codec::json_str(kind),
              base_codec::json_str(j),
              cj,
            ]))
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_draft_put() {
    self.drafts.set(p_str(p, 0) + ":" + p_str(p, 1), p_str(p, 2))
    changed = 1
  } else if stmt == store::sql_draft_delete() {
    self.drafts.remove(p_str(p, 0) + ":" + p_str(p, 1))
    changed = 1
  } else if stmt == store::sql_draft_one() {
    let st = p_str(p, 0)
    let ch = p_str(p, 1)
    match self.drafts.get(st + ":" + ch) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_str(ch), base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == store::sql_thread_set_read() {
    let read_seq = p_int(p, 0)
    let unread = p_int(p, 1)
    let st = p_str(p, 2)
    let th = p_int(p, 3)
    self.thread_reads.set(st + ":" + th.to_string(), (read_seq, unread))
    changed = 1
  } else if stmt == store::sql_chat_set_unread() {
    changed = 1
  } else if stmt == store::sql_pref_put() {
    let k = p_str(p, 0) + ":" + p_str(p, 1)
    if self.prefs.get(k).is_none() {
      self.pref_order.push(k)
    }
    self.prefs.set(k, p_str(p, 2))
    changed = 1
  } else if stmt == store::sql_pref_delete() {
    let k = p_str(p, 0) + ":" + p_str(p, 1)
    if self.prefs.get(k).is_some() {
      self.prefs.remove(k)
      let next_ord : Array[String] = []
      for i in 0..<self.pref_order.length() {
        if self.pref_order[i] != k {
          next_ord.push(self.pref_order[i])
        }
      }
      self.pref_order.clear()
      for i in 0..<next_ord.length() {
        self.pref_order.push(next_ord[i])
      }
      changed = 1
    }
  } else if stmt == store::sql_pref_get() {
    match self.prefs.get(p_str(p, 0) + ":" + p_str(p, 1)) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == store::sql_pref_all() {
    let ws_prefix = p_str(p, 0) + ":"
    for i in 0..<self.pref_order.length() {
      let fk = self.pref_order[i]
      if fk.starts_with(ws_prefix) {
        let key_only = fk.slice(ws_prefix.length(), fk.length())
        match self.prefs.get(fk) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(key_only), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == store::sql_search_messages_station() || stmt == store::sql_search_messages_all() {
    let filter_st = if stmt == store::sql_search_messages_station() { Some(p_str(p, 0)) } else { None }
    let q = if stmt == store::sql_search_messages_station() { p_str(p, 1) } else { p_str(p, 0) }
    for i in 0..<self.said.length() {
      let (st, th, seq, n, at, txt) = self.said[i]
      let st_ok = match filter_st {
        Some(want) => st == want
        None => true
      }
      if st_ok && txt.contains(q) {
        rows.push(base_codec::json_arr([
          base_codec::json_str(st),
          base_codec::json_int(th),
          base_codec::json_int(seq),
          base_codec::json_int(n),
          base_codec::json_int64(at),
          base_codec::json_str(txt),
        ]))
      }
    }
  } else if stmt == store::sql_search_chats() {
    let q = p_str(p, 1)
    let limit = p_int(p, 2)
    for i in 0..<self.chat_order.length() {
      if rows.length() >= limit {
        break
      }
      match self.chats.get(self.chat_order[i]) {
        Some(c) => {
          if c.archived == 0 && (q.length() == 0 || c.json.contains(q) || c.id.contains(q)) {
            let th_j = match c.thread {
              Some(t) => base_codec::json_int(t)
              None => base_codec::json_null()
            }
            rows.push(base_codec::json_arr([
              base_codec::json_str(c.station),
              base_codec::json_int(c.archived),
              base_codec::json_str(c.id),
              th_j,
              base_codec::json_int64(c.last_active),
              base_codec::json_str(c.json),
            ]))
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_moved_put() {
    let st = p_str(p, 0)
    let sk = p_str(p, 1)
    self.moved_rows.set(st + ":" + sk, (st, sk, p_str(p, 2), p_opt_int(p, 3), p_opt_int(p, 4), p_opt_int64(p, 5), p_int(p, 6)))
    changed = 1
  } else if stmt == store::sql_moved_get() {
    let k = p_str(p, 0) + ":" + p_str(p, 1)
    match self.moved_rows.get(k) {
      Some((_, _, there_st, th, there_th, at, came)) => {
        let th_j = match th { Some(v) => base_codec::json_int(v); None => base_codec::json_null() }
        let there_j = match there_th { Some(v) => base_codec::json_int(v); None => base_codec::json_null() }
        let at_j = match at { Some(v) => base_codec::json_int64(v); None => base_codec::json_null() }
        rows.push(base_codec::json_arr([
          base_codec::json_str(there_st),
          th_j,
          there_j,
          at_j,
          base_codec::json_int(came),
        ]))
      }
      None => ()
    }
  } else if stmt == store::sql_moved_by_thread() {
    let st = p_str(p, 0)
    let th = p_int(p, 1)
    let mks = self.moved_rows.keys()
    for i in 0..<mks.length() {
      match self.moved_rows.get(mks[i]) {
        Some((mst, msk, _, mth, _, _, _)) => if mst == st {
          match mth {
            Some(v) => if v == th {
              rows.push(base_codec::json_arr([base_codec::json_str(msk)]))
              break
            }
            None => ()
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_moved_from() {
    let st = p_str(p, 0)
    let mks = self.moved_rows.keys()
    for i in 0..<mks.length() {
      match self.moved_rows.get(mks[i]) {
        Some((mst, msk, _, _, _, _, _)) => if mst == st {
          rows.push(base_codec::json_arr([base_codec::json_str(msk)]))
        }
        None => ()
      }
    }
  } else if stmt == "SELECT archived, id, thread, session FROM chat WHERE station = ?" {
    let st = p_str(p, 0)
    for i in 0..<self.chat_order.length() {
      match self.chats.get(self.chat_order[i]) {
        Some(c) => if c.station == st {
          let th_j = match c.thread { Some(v) => base_codec::json_int(v); None => base_codec::json_null() }
          let sk_j = match c.session { Some(v) => base_codec::json_str(v); None => base_codec::json_null() }
          rows.push(base_codec::json_arr([
            base_codec::json_int(c.archived),
            base_codec::json_str(c.id),
            th_j,
            sk_j,
          ]))
        }
        None => ()
      }
    }
  } else if stmt == "SELECT id FROM thread WHERE station = ?" {
    let pref = p_str(p, 0) + ":"
    let tks = self.threads.keys()
    for i in 0..<tks.length() {
      if tks[i].starts_with(pref) {
        let id_s = tks[i].slice(pref.length(), tks[i].length())
        match base_codec::parse_int64_str(id_s) {
          Some(v) => rows.push(base_codec::json_arr([base_codec::json_int(v.to_int())]))
          None => ()
        }
      }
    }
  } else if stmt == "SELECT key FROM session WHERE station = ?" {
    let pref = p_str(p, 0) + ":"
    let sks = self.sessions.keys()
    for i in 0..<sks.length() {
      if sks[i].starts_with(pref) {
        rows.push(base_codec::json_arr([base_codec::json_str(sks[i].slice(pref.length(), sks[i].length()))]))
      }
    }
  } else if stmt == "SELECT session, thread FROM thread_member WHERE station = ?" {
    ()
  } else if stmt == "SELECT id, session, chat FROM job WHERE station = ?" {
    let pref = p_str(p, 0) + ":"
    let jks = self.jobs.keys()
    for i in 0..<jks.length() {
      if jks[i].starts_with(pref) {
        let jid = jks[i].slice(pref.length(), jks[i].length())
        rows.push(base_codec::json_arr([base_codec::json_str(jid), base_codec::json_null(), base_codec::json_null()]))
      }
    }
  } else if stmt == "SELECT DISTINCT thread FROM entry WHERE station = ?" {
    let pref = p_str(p, 0) + " "
    let eks = self.entries.keys()
    for i in 0..<eks.length() {
      if eks[i].starts_with(pref) {
        let id_s = eks[i].slice(pref.length(), eks[i].length())
        match base_codec::parse_int64_str(id_s) {
          Some(v) => rows.push(base_codec::json_arr([base_codec::json_int(v.to_int())]))
          None => ()
        }
      }
    }
  } else if stmt == "SELECT name FROM sqlite_master WHERE type = 'table'" {
    if self.fail_sqlite_master {
      return shell::AskResult::Err(shell::ShellError::{ message: "sqlite_master_io_error" })
    }
    rows.push(base_codec::json_arr([base_codec::json_str("moved")]))
    rows.push(base_codec::json_arr([base_codec::json_str("shared_mark")]))
    rows.push(base_codec::json_arr([base_codec::json_str("md_kept")]))
    rows.push(base_codec::json_arr([base_codec::json_str("log_use")]))
  } else if stmt == "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'md_kept'" {
    rows.push(base_codec::json_arr([base_codec::json_int(1)]))
  } else if stmt == store::sql_pending_by_station() {
    let st = p_str(p, 0)
    let prefix = st + ":"
    let ks = self.pending_rows.keys()
    for i in 0..<ks.length() {
      let k = ks[i]
      if k.starts_with(prefix) {
        let pkey = k.slice(prefix.length(), k.length())
        match self.pending_rows.get(k) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(pkey), base_codec::json_str(st), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == store::sql_draft_by_station() {
    let st = p_str(p, 0)
    let prefix = st + ":"
    let ks = self.drafts.keys()
    for i in 0..<ks.length() {
      let k = ks[i]
      if k.starts_with(prefix) {
        let chat_k = k.slice(prefix.length(), k.length())
        match self.drafts.get(k) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_str(chat_k), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == store::sql_changing_by_station() {
    let st = p_str(p, 0)
    let prefix = st + ":"
    let ks = self.changing_rows.keys()
    for i in 0..<ks.length() {
      let k = ks[i]
      if k.starts_with(prefix) {
        let id_str = k.slice(prefix.length(), k.length())
        let cid = match base_codec::parse_int64_str(id_str) {
          Some(v) => v.to_int()
          None => 0
        }
        match self.changing_rows.get(k) {
          Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(st), base_codec::json_int(cid), base_codec::json_str(j)]))
          None => ()
        }
      }
    }
  } else if stmt == store::sql_thread_one() {
    let st = p_str(p, 0)
    let th = p_int(p, 1)
    let tk = st + ":" + th.to_string()
    match self.threads.get(tk) {
      Some(tj) => {
        let (rd_j, un_j) = match self.thread_reads.get(tk) {
          Some((r, u)) => (base_codec::json_int(r), base_codec::json_int(u))
          None => (base_codec::json_null(), base_codec::json_int(0))
        }
        rows.push(base_codec::json_arr([
          base_codec::json_int(th),
          base_codec::json_null(),
          rd_j,
          un_j,
          base_codec::json_int(0),
          base_codec::json_int(0),
          base_codec::json_str("chat"),
          base_codec::json_null(),
          base_codec::json_str(tj),
        ]))
      }
      None => ()
    }
  } else if stmt == store::sql_entry_exists_before() {
    let k = p_str(p, 0) + " " + p_int(p, 1).to_string()
    let before_n = p_int(p, 2)
    match self.entries.get(k) {
      Some(all) => {
        for i in 0..<all.length() {
          if all[i].0 < before_n {
            rows.push(base_codec::json_arr([base_codec::json_int(1)]))
            break
          }
        }
      }
      None => ()
    }
  } else if stmt == store::sql_outbox_all() || stmt == store::sql_pending_all() || stmt == store::sql_changing_all() || stmt == store::sql_entry_by_seq() {
    ()
  } else if stmt == "INSERT OR REPLACE INTO shared_mark (station, kind, k, v) VALUES (?, ?, ?, ?)" {
    self.shared_marks.set(p_str(p, 0) + ":" + p_str(p, 1) + ":" + p_str(p, 2), p_str(p, 3))
    changed = 1
  } else if stmt == "DELETE FROM shared_mark WHERE station = ?" {
    let pref = p_str(p, 0) + ":"
    let ks = self.shared_marks.keys()
    for i in 0..<ks.length() {
      if ks[i].starts_with(pref) {
        self.shared_marks.remove(ks[i])
        changed += 1
      }
    }
  } else if stmt == "DELETE FROM shared_mark WHERE station = ? AND kind = ? AND k = ?" {
    self.shared_marks.remove(p_str(p, 0) + ":" + p_str(p, 1) + ":" + p_str(p, 2))
    changed = 1
  } else if stmt == "DELETE FROM shared_mark WHERE station = ? AND kind = 'pin' AND k = ?" {
    self.shared_marks.remove(p_str(p, 0) + ":pin:" + p_str(p, 1))
    changed = 1
  } else if stmt == "DELETE FROM shared_mark WHERE station = ? AND kind IN ('read', 'kept', 'hidden', 'muted') AND k = ?" {
    let st = p_str(p, 0)
    let k = p_str(p, 1)
    self.shared_marks.remove(st + ":read:" + k)
    self.shared_marks.remove(st + ":kept:" + k)
    self.shared_marks.remove(st + ":hidden:" + k)
    self.shared_marks.remove(st + ":muted:" + k)
    changed = 1
  } else if stmt == "DELETE FROM shared_mark WHERE station = ? AND kind = 'dismissed' AND k LIKE ?" {
    let st = p_str(p, 0)
    let pat = p_str(p, 1)
    let pref = st + ":dismissed:" + pat.slice(0, pat.length() - 1)
    let ks = self.shared_marks.keys()
    for i in 0..<ks.length() {
      if ks[i].starts_with(pref) {
        self.shared_marks.remove(ks[i])
        changed += 1
      }
    }
  } else if stmt == "SELECT kind, k FROM shared_mark WHERE station = ? AND kind IN ('hidden', 'muted')" {
    let st = p_str(p, 0)
    let hp = st + ":hidden:"
    let mp = st + ":muted:"
    let ks = self.shared_marks.keys()
    for i in 0..<ks.length() {
      if ks[i].starts_with(hp) {
        rows.push(base_codec::json_arr([base_codec::json_str("hidden"), base_codec::json_str(ks[i].slice(hp.length(), ks[i].length()))]))
      } else if ks[i].starts_with(mp) {
        rows.push(base_codec::json_arr([base_codec::json_str("muted"), base_codec::json_str(ks[i].slice(mp.length(), ks[i].length()))]))
      }
    }
  } else if stmt == "SELECT v FROM shared_mark WHERE station = ? AND kind = ? AND k = ?" {
    match self.shared_marks.get(p_str(p, 0) + ":" + p_str(p, 1) + ":" + p_str(p, 2)) {
      Some(v) => rows.push(base_codec::json_arr([base_codec::json_str(v)]))
      None => ()
    }
  } else if stmt == "SELECT id FROM chat WHERE station = ? AND thread = ?" {
    let st = p_str(p, 0)
    let th = p_int(p, 1)
    for i in 0..<self.chat_order.length() {
      match self.chats.get(self.chat_order[i]) {
        Some(c) =>
        if c.station == st {
          match c.thread {
            Some(ct) => if ct == th { rows.push(base_codec::json_arr([base_codec::json_str(c.id)])) }
            None => ()
          }
        }
        None => ()
      }
    }
  } else if stmt == "SELECT archived, id, json FROM chat WHERE station = ? AND thread = ?" {
    let st = p_str(p, 0)
    let th = p_int(p, 1)
    for i in 0..<self.chat_order.length() {
      match self.chats.get(self.chat_order[i]) {
        Some(c) =>
        if c.station == st {
          match c.thread {
            Some(ct) =>
            if ct == th {
              rows.push(base_codec::json_arr([base_codec::json_int(c.archived), base_codec::json_str(c.id), base_codec::json_str(c.json)]))
            }
            None => ()
          }
        }
        None => ()
      }
    }
  } else if stmt == "UPDATE chat SET json = ? WHERE station = ? AND archived = ? AND id = ?" {
    let new_j = p_str(p, 0)
    let key = p_str(p, 1) + ":" + p_int(p, 2).to_string() + ":" + p_str(p, 3)
    match self.chats.get(key) {
      Some(c) => {
        self.chats.set(key, SimChatRow::{
          station: c.station,
          archived: c.archived,
          id: c.id,
          ord: c.ord,
          thread: c.thread,
          session: c.session,
          pinned_at: c.pinned_at,
          last_active: c.last_active,
          unread: c.unread,
          tone: c.tone,
          asks: c.asks,
          json: new_j,
        })
        changed = 1
      }
      None => ()
    }
  } else if stmt == "INSERT OR REPLACE INTO transcript (station, session, i, json) VALUES (?, ?, ?, ?)" {
    self.transcripts.push((p_str(p, 0), p_str(p, 1), p_int(p, 2), p_str(p, 3)))
    changed = 1
  } else if stmt == "SELECT min(i), max(i), count(*) FROM transcript WHERE station = ? AND session = ?" {
    let st = p_str(p, 0)
    let sk = p_str(p, 1)
    let mut cnt = 0
    let mut min_i = 0
    let mut max_i = 0
    for ti in 0..<self.transcripts.length() {
      let (tst, tsk, idx, _) = self.transcripts[ti]
      if tst == st && tsk == sk {
        if cnt == 0 {
          min_i = idx
          max_i = idx
        } else {
          if idx < min_i { min_i = idx }
          if idx > max_i { max_i = idx }
        }
        cnt += 1
      }
    }
    rows.push(base_codec::json_arr([base_codec::json_int(min_i), base_codec::json_int(max_i), base_codec::json_int(cnt)]))
  } else if stmt == "SELECT i, json FROM transcript WHERE station = ? AND session = ? AND i >= ? AND i <= ? ORDER BY i" {
    let st = p_str(p, 0)
    let sk = p_str(p, 1)
    let lo = p_int(p, 2)
    let hi = p_int(p, 3)
    for ti in 0..<self.transcripts.length() {
      let (tst, tsk, idx, tjson) = self.transcripts[ti]
      if tst == st && tsk == sk && idx >= lo && idx <= hi {
        rows.push(base_codec::json_arr([base_codec::json_int(idx), base_codec::json_str(tjson)]))
      }
    }
  } else if stmt == "SELECT station, thread, coalesce(sum(length(json)), 0) FROM entry GROUP BY station, thread" ||
  stmt == "SELECT station, session, coalesce(sum(length(json)), 0) FROM transcript GROUP BY station, session" {
    ()
  } else if stmt == store::sql_meta_get() {
    match self.meta.get(p_str(p, 0)) {
      Some(v) => rows.push(base_codec::json_arr([base_codec::json_str(v)]))
      None => ()
    }
  } else if stmt == store::sql_meta_put() {
    self.meta.set(p_str(p, 0), p_str(p, 1))
    changed = 1
  } else if stmt == store::sql_meta_delete() {
    self.meta.remove(p_str(p, 0))
    changed = 1
  } else if stmt == store::sql_workspace_one() {
    let wid = p_str(p, 0)
    match self.workspaces.get(wid) {
      Some((j, conf)) => {
        let cj = match conf {
          Some(ts) => base_codec::json_int64(ts)
          None => base_codec::json_null()
        }
        rows.push(base_codec::json_arr([base_codec::json_str(wid), base_codec::json_str(j), cj]))
      }
      None => ()
    }
  } else if stmt.starts_with("DELETE FROM ") {
    if self.fail_drop_sql {
      return shell::AskResult::Err(shell::ShellError::{ message: "simulated sqlite drop_workspace error" })
    }
    let matches_st = fn(actual_st : String) -> Bool {
      if stmt.contains("substr(") {
        let pref = p_str(p, 0)
        pref.length() > 0 && actual_st.starts_with(pref)
      } else {
        actual_st == p_str(p, 0)
      }
    }
    if stmt == "DELETE FROM workspace WHERE id = ?" {
      let wid = p_str(p, 0)
      self.workspaces.remove(wid)
      let next_ord : Array[String] = []
      for i in 0..<self.workspace_order.length() {
        if self.workspace_order[i] != wid { next_ord.push(self.workspace_order[i]) }
      }
      self.workspace_order.clear()
      for i in 0..<next_ord.length() { self.workspace_order.push(next_ord[i]) }
      changed = 1
    } else if stmt == "DELETE FROM workspace_pref WHERE workspace = ?" {
      let wp = p_str(p, 0) + ":"
      let next_ord : Array[String] = []
      for i in 0..<self.pref_order.length() {
        let k = self.pref_order[i]
        if k.starts_with(wp) {
          self.prefs.remove(k)
          changed += 1
        } else {
          next_ord.push(k)
        }
      }
      self.pref_order.clear()
      for i in 0..<next_ord.length() { self.pref_order.push(next_ord[i]) }
    } else if stmt == "DELETE FROM account_doc WHERE name = ?" {
      self.account_docs.remove(p_str(p, 0))
      changed = 1
    } else if stmt.starts_with("DELETE FROM station WHERE ") {
      let next_ord : Array[String] = []
      for i in 0..<self.station_doc_order.length() {
        let k = self.station_doc_order[i]
        match self.station_docs.get(k) {
          Some((addr, _, _, _)) => if matches_st(addr) {
            self.station_docs.remove(k)
            changed += 1
          } else {
            next_ord.push(k)
          }
          None => ()
        }
      }
      self.station_doc_order.clear()
      for i in 0..<next_ord.length() { self.station_doc_order.push(next_ord[i]) }
    } else if stmt == "DELETE FROM chat WHERE station = ? AND archived = ? AND id = ?" {
      let key = p_str(p, 0) + ":" + p_int(p, 1).to_string() + ":" + p_str(p, 2)
      self.chats.remove(key)
      let next_ord : Array[String] = []
      for i in 0..<self.chat_order.length() {
        if self.chat_order[i] != key { next_ord.push(self.chat_order[i]) }
      }
      self.chat_order.clear()
      for i in 0..<next_ord.length() { self.chat_order.push(next_ord[i]) }
      changed = 1
    } else if stmt == "DELETE FROM chat WHERE station = ? AND session = ?" {
      let st = p_str(p, 0)
      let sk = p_str(p, 1)
      let next_ord : Array[String] = []
      for i in 0..<self.chat_order.length() {
        let k = self.chat_order[i]
        match self.chats.get(k) {
          Some(c) => {
            let sm = match c.session { Some(s) => s == sk; None => false }
            if c.station == st && (sm || c.id == sk) {
              self.chats.remove(k)
              changed += 1
            } else {
              next_ord.push(k)
            }
          }
          None => ()
        }
      }
      self.chat_order.clear()
      for i in 0..<next_ord.length() { self.chat_order.push(next_ord[i]) }
    } else if stmt.starts_with("DELETE FROM chat WHERE ") {
      let next_ord : Array[String] = []
      for i in 0..<self.chat_order.length() {
        let k = self.chat_order[i]
        match self.chats.get(k) {
          Some(c) => if matches_st(c.station) {
            self.chats.remove(k)
            changed += 1
          } else {
            next_ord.push(k)
          }
          None => ()
        }
      }
      self.chat_order.clear()
      for i in 0..<next_ord.length() { self.chat_order.push(next_ord[i]) }
    } else if stmt == "DELETE FROM entry WHERE station = ? AND thread = ?" {
      self.entries.remove(p_str(p, 0) + " " + p_int(p, 1).to_string())
      changed = 1
    } else if stmt.starts_with("DELETE FROM entry WHERE ") {
      let ks = self.entries.keys()
      for i in 0..<ks.length() {
        let k = ks[i]
        let st = match k.index_of(" ") { idx if idx > 0 => k.slice(0, idx); _ => k }
        if matches_st(st) {
          self.entries.remove(k)
          changed += 1
        }
      }
    } else if stmt == "DELETE FROM thread WHERE station = ? AND id = ?" {
      let k = p_str(p, 0) + ":" + p_int(p, 1).to_string()
      self.threads.remove(k)
      self.thread_reads.remove(k)
      changed = 1
    } else if stmt.starts_with("DELETE FROM thread WHERE ") {
      let ks = self.threads.keys()
      for i in 0..<ks.length() {
        let k = ks[i]
        let st = match k.index_of(":") { idx if idx > 0 => k.slice(0, idx); _ => k }
        if matches_st(st) {
          self.threads.remove(k)
          self.thread_reads.remove(k)
          changed += 1
        }
      }
    } else if stmt == "DELETE FROM said WHERE station = ? AND thread = ?" {
      let st = p_str(p, 0)
      let th = p_int(p, 1)
      let kept_s : Array[(String, Int, Int, Int, Int64, String)] = []
      for i in 0..<self.said.length() {
        if !(self.said[i].0 == st && self.said[i].1 == th) {
          kept_s.push(self.said[i])
        } else {
          changed += 1
        }
      }
      self.said.clear()
      for i in 0..<kept_s.length() { self.said.push(kept_s[i]) }
    } else if stmt == "DELETE FROM draft WHERE station = ? AND chat = 'new'" {
      self.drafts.remove(p_str(p, 0) + ":new")
      changed = 1
    } else if stmt.starts_with("DELETE FROM moved WHERE ") {
      let mks = self.moved_rows.keys()
      for i in 0..<mks.length() {
        match self.moved_rows.get(mks[i]) {
          Some((mst, _, _, _, _, _, _)) => if matches_st(mst) {
            self.moved_rows.remove(mks[i])
            changed += 1
          }
          None => ()
        }
      }
    } else if stmt.starts_with("DELETE FROM session WHERE ") {
      let ks = self.sessions.keys()
      for i in 0..<ks.length() {
        let k = ks[i]
        let st = match k.index_of(":") { idx if idx > 0 => k.slice(0, idx); _ => k }
        if matches_st(st) { self.sessions.remove(k); changed += 1 }
      }
    } else if stmt.starts_with("DELETE FROM job WHERE ") {
      let ks = self.jobs.keys()
      for i in 0..<ks.length() {
        let k = ks[i]
        let st = match k.index_of(":") { idx if idx > 0 => k.slice(0, idx); _ => k }
        if matches_st(st) { self.jobs.remove(k); changed += 1 }
      }
    } else if stmt.starts_with("DELETE FROM outbox WHERE ") {
      let ks = self.outbox_rows.keys()
      for i in 0..<ks.length() {
        let k = ks[i]
        let st = match k.index_of(":") { idx if idx > 0 => k.slice(0, idx); _ => k }
        if matches_st(st) { self.outbox_rows.remove(k); changed += 1 }
      }
    } else if stmt.starts_with("DELETE FROM pending WHERE ") {
      let ks = self.pending_rows.keys()
      for i in 0..<ks.length() {
        let k = ks[i]
        let st = match k.index_of(":") { idx if idx > 0 => k.slice(0, idx); _ => k }
        if matches_st(st) { self.pending_rows.remove(k); changed += 1 }
      }
    } else if stmt.starts_with("DELETE FROM changing WHERE ") {
      let ks = self.changing_rows.keys()
      for i in 0..<ks.length() {
        let k = ks[i]
        let st = match k.index_of(":") { idx if idx > 0 => k.slice(0, idx); _ => k }
        if matches_st(st) { self.changing_rows.remove(k); changed += 1 }
      }
    } else if stmt.starts_with("DELETE FROM draft WHERE ") {
      let ks = self.drafts.keys()
      for i in 0..<ks.length() {
        let k = ks[i]
        let st = match k.index_of(":") { idx if idx > 0 => k.slice(0, idx); _ => k }
        if matches_st(st) { self.drafts.remove(k); changed += 1 }
      }
    } else if stmt.starts_with("DELETE FROM said WHERE ") {
      let kept : Array[(String, Int, Int, Int, Int64, String)] = []
      for i in 0..<self.said.length() {
        let row = self.said[i]
        if matches_st(row.0) { changed += 1 } else { kept.push(row) }
      }
      self.said.clear()
      for i in 0..<kept.length() { self.said.push(kept[i]) }
    } else if stmt.starts_with("DELETE FROM transcript WHERE ") {
      let kept : Array[(String, String, Int, String)] = []
      for i in 0..<self.transcripts.length() {
        let row = self.transcripts[i]
        if matches_st(row.0) { changed += 1 } else { kept.push(row) }
      }
      self.transcripts.clear()
      for i in 0..<kept.length() { self.transcripts.push(kept[i]) }
    } else {
      changed = 1
    }
  } else if stmt == "SELECT coalesce(sum(size), 0), count(*) FROM md_kept" {
    let mut total = 0
    let mks = self.md.keys()
    for mi in 0..<mks.length() {
      match self.md.get(mks[mi]) {
        Some((_, mj)) => { total += mj.length() }
        None => ()
      }
    }
    rows.push(base_codec::json_arr([base_codec::json_int(total), base_codec::json_int(mks.length())]))
  } else if stmt.starts_with("INSERT OR REPLACE INTO shared_sidecar") || stmt.starts_with("DELETE FROM shared_sidecar") || stmt.starts_with("SELECT ord, unread, mine, pinned_at, running, tone, asks, desk, json FROM chat") || stmt.starts_with("DELETE FROM chat WHERE station = ? AND archived = 0 AND id = ?") || stmt.contains("FROM moved") {
    ()
  } else if stmt == store::sql_chat_by_thread() {
    let st = p_str(p, 0)
    let th = p_int(p, 1)
    for i in 0..<self.chat_order.length() {
      match self.chats.get(self.chat_order[i]) {
        Some(c) => if c.station == st && c.archived == 0 {
          match c.thread {
            Some(t) => if t == th {
              rows.push(base_codec::json_arr([base_codec::json_str(c.station), base_codec::json_int(c.archived), base_codec::json_str(c.id), base_codec::json_str(c.json)]))
              break
            }
            None => ()
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_chat_by_session() {
    let st = p_str(p, 0)
    let sk = p_str(p, 1)
    for i in 0..<self.chat_order.length() {
      match self.chats.get(self.chat_order[i]) {
        Some(c) => if c.station == st && c.archived == 0 {
          match c.session {
            Some(s) => if s == sk {
              rows.push(base_codec::json_arr([base_codec::json_str(c.station), base_codec::json_int(c.archived), base_codec::json_str(c.id), base_codec::json_str(c.json)]))
              break
            }
            None => ()
          }
        }
        None => ()
      }
    }
  } else if stmt == store::sql_workspace_one() {
    let wid = p_str(p, 0)
    match self.workspaces.get(wid) {
      Some((j, conf)) => {
        let cj = match conf {
          Some(ts) => base_codec::json_int64(ts)
          None => base_codec::json_null()
        }
        rows.push(base_codec::json_arr([base_codec::json_str(wid), base_codec::json_str(j), cj]))
      }
      None => ()
    }
  } else {
    return shell::AskResult::Err(shell::ShellError::{ message: "SimAccountDb unknown SQL: " + stmt })
  }
  if op == "sql.run" {
    shell::AskResult::Ok(base_codec::json_int(changed))
  } else {
    shell::AskResult::Ok(base_codec::json_arr(rows))
  }
}

fn sim_is_write(s : String) -> Bool {
  s.starts_with("INSERT") || s.starts_with("UPDATE") || s.starts_with("DELETE") || s.starts_with("BEGIN") || s.starts_with("COMMIT")
}

fn SimAccountDb::counts_since(self : SimAccountDb, from : Int) -> (Int, Int, Int) {
  let mut writes = 0
  let mut tx = 0
  for i in from..<self.ran.length() {
    let s = self.ran[i]
    if sim_is_write(s) {
      writes += 1
    }
    if s == "BEGIN IMMEDIATE" {
      tx += 1
    }
  }
  (self.ran.length() - from, writes, tx)
}

// ── Deterministic SimStation over effect::Runtime virtual clock ──

struct SimStation {
  rt : effect::Runtime
  mut offline : Bool
  mut reject_path_prefix : Option[String]
  mut reject_code : String
  mut reject_recovery : String
  mut next_entry_n : Int
  mut snapshot_json : base_codec::Json
  mut lock_json : Option[base_codec::Json]
  mut marks_json : base_codec::Json
  thread_entries : Map[Int, base_codec::Json]
  thread_delay_ms : Map[Int, Int]
  seen_client_keys : Map[String, Int]
  mut active_sse_chunk : Option[(Bytes) -> Unit]
  mut active_sse_done : Option[effect::Deferred[Unit]]
  mut cancel_count : Int
  requests_seen : Array[String]
}

fn SimStation::new(rt : effect::Runtime) -> SimStation {
  SimStation::{
    rt: rt,
    offline: false,
    reject_path_prefix: None,
    reject_code: "forbidden",
    reject_recovery: "Ask a workspace owner to grant permission and retry.",
    next_entry_n: 100,
    snapshot_json: base_codec::json_obj([("chats", base_codec::json_arr([])), ("entries", base_codec::json_arr([]))]),
    lock_json: None,
    marks_json: base_codec::json_obj([
      ("reads", base_codec::json_obj([])),
      ("pins", base_codec::json_obj([])),
      ("kept", base_codec::json_arr([])),
      ("hidden", base_codec::json_arr([])),
      ("muted", base_codec::json_arr([])),
      ("dismissed", base_codec::json_arr([])),
      ("selves", base_codec::json_arr([])),
    ]),
    thread_entries: Map::new(),
    thread_delay_ms: Map::new(),
    seen_client_keys: Map::new(),
    active_sse_chunk: None,
    active_sse_done: None,
    cancel_count: 0,
    requests_seen: [],
  }
}

fn SimStation::push_sse(self : SimStation, raw_sse : String) -> Unit {
  match self.active_sse_chunk {
    Some(cb) => cb(raw_sse.to_bytes())
    None => ()
  }
}

fn SimStation::drop_stream(self : SimStation) -> Unit {
  let done_opt = self.active_sse_done
  self.active_sse_chunk = None
  self.active_sse_done = None
  match done_opt {
    Some(d) => {
      let _ = d.fail(effect::EffectError::Custom("network cut"))
    }
    None => ()
  }
}

fn sleep_reply_k[T](delay : Int, outcome : effect::Exit[T], k : (effect::Exit[T]) -> Unit) -> Unit {
  effect::sleep_k(delay, fn(sex : effect::Exit[Unit]) -> Unit {
    match sex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(_) => k(outcome)
    }
  })
}

fn SimStation::transport(self : SimStation) -> StationTransport {
  StationTransport::{
    request_k: fn(
      method_name : String,
      path : String,
      _headers : Array[(String, String)],
      body : Bytes,
      k : (effect::Exit[HttpReply]) -> Unit,
    ) -> Unit {
      self.requests_seen.push(method_name + " " + path)
      if self.offline {
        sleep_reply_k(10, effect::Exit::Failed(effect::EffectError::Custom("offline")), k)
        return
      }
      match self.reject_path_prefix {
        Some(prefix) => {
          if path.starts_with(prefix) {
            let err_body = base_codec::json_stringify(base_codec::json_obj([
              ("code", base_codec::json_str(self.reject_code)),
              ("error", base_codec::json_str("operation refused by station")),
              ("recovery", base_codec::json_str(self.reject_recovery)),
            ])).to_bytes()
            sleep_reply_k(10, effect::Exit::Succeeded(HttpReply::{ status: 403, headers: [], body: err_body }), k)
            return
          }
        }
        None => ()
      }
      if method_name == "GET" && path == "/chats" {
        let out = base_codec::json_stringify(self.snapshot_json).to_bytes()
        sleep_reply_k(10, effect::Exit::Succeeded(HttpReply::{ status: 200, headers: [], body: out }), k)
        return
      }
      if method_name == "GET" && path.starts_with("/chats?marks=1&own=1") {
        let out = base_codec::json_stringify(self.marks_json).to_bytes()
        sleep_reply_k(10, effect::Exit::Succeeded(HttpReply::{ status: 200, headers: [], body: out }), k)
        return
      }
      if method_name == "GET" && path == "/lock" {
        match self.lock_json {
          Some(lj) => {
            let out = base_codec::json_stringify(lj).to_bytes()
            sleep_reply_k(10, effect::Exit::Succeeded(HttpReply::{ status: 200, headers: [], body: out }), k)
          }
          None => {
            sleep_reply_k(10, effect::Exit::Succeeded(HttpReply::{ status: 404, headers: [], body: "{}".to_bytes() }), k)
          }
        }
        return
      }
      if method_name == "GET" && path.starts_with("/threads/") && path.ends_with("/entries") {
        let mid = path.slice(9, path.length() - 8)
        let th = match base_codec::parse_int64_str(mid) {
          Some(v) => v.to_int()
          None => 0
        }
        let delay = match self.thread_delay_ms.get(th) {
          Some(d) => d
          None => 10
        }
        let payload = match self.thread_entries.get(th) {
          Some(j) => j
          None => base_codec::json_obj([("entries", base_codec::json_arr([]))])
        }
        let out = base_codec::json_stringify(payload).to_bytes()
        sleep_reply_k(delay, effect::Exit::Succeeded(HttpReply::{ status: 200, headers: [], body: out }), k)
        return
      }
      if method_name == "POST" && path.starts_with("/threads/") && path.ends_with("/messages") {
        let parsed = base_codec::json_parse(bytes_to_str(body))
        let ck = match parsed {
          base_codec::JsonParseResult::Ok(j) =>
          match base_codec::json_get(j, "clientKey") {
            Some(base_codec::Json::Str(s)) => s
            _ => ""
          }
          base_codec::JsonParseResult::Err(_) => ""
        }
        let assigned_n = match self.seen_client_keys.get(ck) {
          Some(existing) => existing
          None => {
            self.next_entry_n += 1
            let n = self.next_entry_n
            if ck.length() > 0 {
              self.seen_client_keys.set(ck, n)
            }
            n
          }
        }
        let ack = base_codec::json_stringify(base_codec::json_obj([
          ("n", base_codec::json_int(assigned_n)),
          ("clientKey", base_codec::json_str(ck)),
        ])).to_bytes()
        sleep_reply_k(10, effect::Exit::Succeeded(HttpReply::{ status: 200, headers: [], body: ack }), k)
        return
      }
      sleep_reply_k(10, effect::Exit::Succeeded(HttpReply::{ status: 200, headers: [], body: "{}".to_bytes() }), k)
    },
    stream_k: fn(
      path : String,
      _headers : Array[(String, String)],
      on_chunk : (Bytes) -> Unit,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      self.requests_seen.push("SSE " + path)
      if self.offline {
        sleep_reply_k(10, effect::Exit::Failed(effect::EffectError::Custom("offline")), k)
        return
      }
      let done : effect::Deferred[Unit] = effect::Deferred::new()
      self.active_sse_chunk = Some(on_chunk)
      self.active_sse_done = Some(done)
      // Deliver SSE hello comment on virtual clock, then stay open until dropped or interrupted.
      effect::sleep_k(5, fn(sex : effect::Exit[Unit]) -> Unit {
        match sex {
          effect::Exit::Interrupted => {
            self.cancel_count += 1
            k(effect::Exit::Interrupted)
          }
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(_) => {
            on_chunk(": connected\n\n".to_bytes())
            done.wait_k(fn(dex : effect::Exit[Unit]) -> Unit {
              match dex {
                effect::Exit::Interrupted => {
                  self.cancel_count += 1
                  k(effect::Exit::Interrupted)
                }
                _ => k(dex)
              }
            })
          }
        }
      })
    },
  }
}

fn make_seed(byte_val : Int) -> Bytes {
  let b = Bytes::new(32)
  for i in 0..<32 {
    b[i] = ((byte_val + i) & 0xFF) as Byte
  }
  b
}

fn hex_64(ch : String) -> String {
  let sb = StringBuilder::new()
  for _ in 0..<64 {
    sb.write_string(ch)
  }
  sb.to_string()
}

// ── Test 1: Cold open (0 writes, 3 statements) -> connect SimStation -> snapshot + SSE batch (1 wake) ──

test "E2E 1: cold open writes nothing (3 stmts), then SimStation snapshot + SSE batch coalesces to 1 wake" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-1") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  // Seed 2 cached messages + precomputed markdown tree in local SQLite before cold open.
  let m1 = base_codec::json_obj([
    ("kind", base_codec::json_str("message")),
    ("authorKind", base_codec::json_str("agent")),
    ("author", base_codec::json_str("bot")),
    ("text", base_codec::json_str("cached hello")),
  ])
  sim_db.put_entry_row("st1", 7, 1, base_codec::json_stringify(m1))
  let k1 = store::md_key("cached hello")
  sim_db.md.set("st1 " + k1, (1000.to_int64(), "{\"tree\":1}"))

  let station = SimStation::new(rt)
  station.snapshot_json = base_codec::json_obj([
    (
      "chats",
      base_codec::json_arr([
        base_codec::json_obj([
          ("id", base_codec::json_str("c-7")),
          ("archived", base_codec::json_int(0)),
          ("ord", base_codec::json_num(1.0)),
          ("thread", base_codec::json_int(7)),
          ("lastActive", base_codec::json_int64(2000.to_int64())),
          ("mine", base_codec::json_bool(true)),
          ("title", base_codec::json_str("Initial Chat")),
        ]),
      ]),
    ),
    ("entries", base_codec::json_arr([])),
  ])

  let wakes = [0]
  let core = ClientCore::new("ws-1", "st1", rt, db, station.transport(), fn() -> Unit {
    wakes[0] = wakes[0] + 1
  })

  // Step 1: Cold open chat 7 — must execute 0 writes and exactly 3 SQL statements, 0 network requests!
  let before_open = sim_db.ran.length()
  let view = match core.cold_open_chat(7, 5000.to_int64()) {
    sql::SqlResult::Ok(v) => v
    sql::SqlResult::Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  let (stmts, writes, _tx) = sim_db.counts_since(before_open)
  debug_assert(writes == 0, "cold open must do 0 SQL writes")
  debug_assert(stmts == 3, "cold open must take exactly 3 statements (entries, md_kept preload, last_opened)")
  debug_assert(view.entries.length() == 1, "cold open loaded 1 cached entry")
  debug_assert(station.requests_seen.length() == 0, "cold open must not touch network")

  // Step 2: Connect to SimStation -> receives initial snapshot.
  core.start()
  rt.advance(30)
  let snap_events = core.drain_frame()
  debug_assert(snap_events.length() >= 2, "received connection + snapshot events")
  match store::get_chat_by_key(db, "st1", 0, "c-7") {
    sql::SqlResult::Ok(Some(rec)) => debug_assert(rec.id == "c-7", "snapshot persisted chat c-7")
    _ => debug_assert(false, "chat c-7 missing after snapshot")
  }

  // Step 3: Push a multi-event SSE batch (real `thread` with 2 entries + `read`) in one chunk ->
  // must commit in 1 Burst transaction and trigger exactly 1 coalesced FrameOutbox wake!
  sim_db.threads.set("st1:7", "{\"id\":7,\"surface\":\"chat\"}")
  let wakes_before = wakes[0]
  let sql_before = sim_db.ran.length()
  let batch_sse =
  "id: ev-10\nevent: thread\ndata: {\"workspace\":\"ws-1\",\"id\":7,\"entries\":[{\"n\":2,\"thread\":7,\"kind\":\"message\",\"authorKind\":\"agent\",\"author\":\"bot\",\"text\":\"live 1\",\"at\":1001},{\"n\":3,\"thread\":7,\"kind\":\"message\",\"authorKind\":\"agent\",\"author\":\"bot\",\"text\":\"live 2\",\"at\":1002}]}\n\n" +
  "id: ev-12\nevent: read\ndata: {\"workspace\":\"ws-1\",\"thread\":7,\"n\":3}\n\n"
  station.push_sse(batch_sse)
  let (_s2, _w2, tx_count) = sim_db.counts_since(sql_before)
  debug_assert(tx_count == 1, "multi-event SSE batch must commit in 1 Burst transaction")
  debug_assert(wakes[0] - wakes_before == 1, "FrameOutbox must coalesce entire SSE batch into 1 frame wake")
  let drained = core.drain_frame()
  debug_assert(drained.length() == 3, "FrameOutbox drained 3 typed CoreEvents (2 EntryAdded + 1 ThreadReadChanged)")
  debug_assert(sim_db.entry_count("st1", 7) == 3, "thread 7 now has 3 entries in SQLite")
  core.stop()
}

// ── Test 2: Offline optimistic send -> immediate local outbox -> reconnect auto-flush -> exact client_key dedup ──

test "E2E 2: offline optimistic send_message -> auto-flush on reconnect -> exact client_key reconciliation with 0 duplicates" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-2") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  station.offline = true
  let core = ClientCore::new("ws-1", "st1", rt, db, station.transport(), fn() -> Unit {})

  // Send message while offline -> immediately persisted to local `outbox` and pushed to FrameOutbox.
  match core.send_message(42, "ck-offline-1", "alice", "hello while offline", 10000.to_int64()) {
    sql::SqlResult::Ok(_) => ()
    sql::SqlResult::Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  debug_assert(core.local_outbox.pending_message_count() == 1, "1 message queued in local outbox")
  match store::get_outbox(db, "st1", 42) {
    sql::SqlResult::Ok(Some(row)) => debug_assert(row.json.contains("ck-offline-1"), "outbox SQLite row holds ck-offline-1")
    _ => debug_assert(false, "outbox row missing in SQLite")
  }
  let queued_evs = core.drain_frame()
  debug_assert(queued_evs.length() == 1, "OutboxQueued emitted immediately with zero network wait")

  // Start stream while offline (enters Reconnecting backoff), then bring network back online.
  core.start()
  rt.advance(50)
  station.offline = false
  // Advance past first reconnect backoff (2000ms, matching link.ts RECONNECT_MS) + connect + POST flush.
  rt.advance(2200)

  // Verify auto-flush succeeded, outbox cleared, and NO synthetic entry row was fabricated on HTTP 2xx.
  debug_assert(core.local_outbox.pending_message_count() == 0, "outbox reconciled after reconnect")
  match store::get_outbox(db, "st1", 42) {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "SQLite outbox row must be deleted after exact client_key confirmation")
  }
  debug_assert(sim_db.entry_count("st1", 42) == 0, "HTTP 2xx must NOT fabricate a synthetic entry row")

  // Real entry arrives via SSE `thread` with exact `n` & `clientKey` -> stored once, 0 duplicates even on replay.
  station.push_sse(
    "id: ev-99\nevent: thread\ndata: {\"workspace\":\"ws-1\",\"id\":42,\"entries\":[{\"thread\":42,\"n\":101,\"kind\":\"message\",\"authorKind\":\"person\",\"author\":\"alice@still.fail\",\"text\":\"hello while offline\",\"clientKey\":\"ck-offline-1\",\"at\":10000}]}\n\n",
  )
  debug_assert(sim_db.entry_count("st1", 42) == 1, "SSE thread event stores real entry once")
  station.push_sse(
    "id: ev-99\nevent: thread\ndata: {\"workspace\":\"ws-1\",\"id\":42,\"entries\":[{\"thread\":42,\"n\":101,\"kind\":\"message\",\"authorKind\":\"person\",\"author\":\"alice@still.fail\",\"text\":\"hello while offline\",\"clientKey\":\"ck-offline-1\",\"at\":10000}]}\n\n",
  )
  debug_assert(sim_db.entry_count("st1", 42) == 1, "replayed SSE entry with same n & clientKey produces 0 duplicates")
  core.stop()
}

// ── Test 3: Station rejects mutation -> automatic rollback of local overlay + clear error & recovery hint ──

test "E2E 3: station rejects send_message and rename_chat -> automatic rollback + FrameOutbox error with recovery" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-3") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  station.snapshot_json = base_codec::json_obj([
    (
      "chats",
      base_codec::json_arr([
        base_codec::json_obj([
          ("id", base_codec::json_str("c-9")),
          ("archived", base_codec::json_int(0)),
          ("ord", base_codec::json_num(1.0)),
          ("thread", base_codec::json_int(9)),
          ("lastActive", base_codec::json_int64(500.to_int64())),
          ("title", base_codec::json_str("Original Title")),
        ]),
      ]),
    ),
    ("entries", base_codec::json_arr([])),
  ])

  let core = ClientCore::new("ws-1", "st1", rt, db, station.transport(), fn() -> Unit {})
  core.start()
  rt.advance(30)
  let _ = core.drain_frame()

  // Configure station to reject chat rename with 403 + explicit recovery hint (real route POST /sessions/c-9/title).
  station.reject_path_prefix = Some("/sessions/c-9/title")
  station.reject_code = "read_only_member"
  station.reject_recovery = "Ask an owner to upgrade your role before renaming."

  let _ = core.rename_chat("c-9", "Unauthorized Rename")
  debug_assert(core.local_outbox.pending_overlay_count() == 1, "overlay persisted optimistically")
  rt.advance(30)

  // Overlay must be rolled back, changing row deleted, original chat intact, and OverlayRolledBack emitted.
  debug_assert(core.local_outbox.pending_overlay_count() == 0, "overlay cleared on rollback")
  debug_assert(sim_db.changing_rows.length() == 0, "changing table cleared on rollback")
  match store::get_chat_by_key(db, "st1", 0, "c-9") {
    sql::SqlResult::Ok(Some(rec)) => debug_assert(rec.json.contains("Original Title"), "original chat record preserved")
    _ => debug_assert(false, "chat c-9 missing after rollback")
  }
  let evs = core.drain_frame()
  let mut saw_rollback = false
  for i in 0..<evs.length() {
    match evs[i] {
      CoreEvent::OverlayRolledBack(_st, target, kind, code, recovery) => {
        if target == "c-9" && kind == "chat.rename" && code == "read_only_member" && recovery.contains("upgrade") {
          saw_rollback = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_rollback, "FrameOutbox received OverlayRolledBack with exact code and recovery hint")
  core.stop()
}

// ── Test 4: Native pion/rules lock verification (real Ed25519 + SHA-256), fork choice & vault cert ──

test "E2E 4: SimStation pushes forked lock chain + forged entry -> lock_bridge rejects forgery, settles fork, verifies vault cert" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-4") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  let core = ClientCore::new("ws-lock", "st1", rt, db, station.transport(), fn() -> Unit {})

  // Real Ed25519 keypairs for Owner (Alice), Admin (Bob), and an unauthorized Attacker (Eve).
  let alice_seed = make_seed(11)
  let bob_seed = make_seed(22)
  let eve_seed = make_seed(33)
  let alice_key = ed25519_key_id(alice_seed)
  let bob_key = ed25519_key_id(bob_seed)
  let alice_dev_id = hex_64("1")
  let bob_dev_id = hex_64("2")

  // Genesis entry signed by Alice (owner), naming both Alice (owner) and Bob (admin) + their signing keys.
  let g_unsigned = form::Json::Obj([
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws-lock")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1790000000.0)),
    ("kind", form::Json::Str("genesis")),
    (
      "body",
      form::Json::Obj([
        ("owner", form::Json::Str("alice")),
        ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
        ("rp_id", form::Json::Str("app.still.fail")),
        ("cloud_keys", form::Json::Obj([])),
        (
          "members",
          form::Json::Arr([
            form::Json::Obj([
              ("sub", form::Json::Str("alice")),
              ("email", form::Json::Str("alice@example.com")),
              ("role", form::Json::Str("owner")),
            ]),
            form::Json::Obj([
              ("sub", form::Json::Str("bob")),
              ("email", form::Json::Str("bob@example.com")),
              ("role", form::Json::Str("admin")),
            ]),
          ]),
        ),
        (
          "devices",
          form::Json::Arr([
            form::Json::Obj([
              ("id", form::Json::Str(alice_dev_id)),
              ("sub", form::Json::Str("alice")),
              ("kind", form::Json::Str("app")),
              ("label", form::Json::Str("Alice Mac")),
              ("sign_key", form::Json::Str(alice_key)),
            ]),
            form::Json::Obj([
              ("id", form::Json::Str(bob_dev_id)),
              ("sub", form::Json::Str("bob")),
              ("kind", form::Json::Str("app")),
              ("label", form::Json::Str("Bob Linux")),
              ("sign_key", form::Json::Str(bob_key)),
            ]),
          ]),
        ),
        ("passkeys", form::Json::Arr([])),
        ("stations", form::Json::Arr([])),
        ("gateways", form::Json::Arr([])),
      ]),
    ),
  ])
  let g_signed = match sign_lock_entry(alice_seed, g_unsigned) {
    Ok(e) => e
    Err(e) => {
      debug_assert(false, "sign genesis failed: " + e)
      return
    }
  }
  let root_hash = match lock::entry_hash(g_signed, native_lock_crypto()) {
    Ok(h) => h
    Err(_) => ""
  }

  // Fork A (seq=1): Bob (admin, weight=2) adds Carol.
  let fork_bob = match sign_lock_entry(
    bob_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-lock")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_hash)),
      ("at", form::Json::Num(1790000010.0)),
      ("kind", form::Json::Str("member")),
      (
        "body",
        form::Json::Obj([
          ("sub", form::Json::Str("carol")),
          ("email", form::Json::Str("carol@example.com")),
          ("role", form::Json::Str("member")),
        ]),
      ),
    ]),
  ) {
    Ok(e) => e
    Err(_) => form::Json::Null
  }

  // Fork B (seq=1): Alice (owner, weight=3) adds Dave -> MUST WIN by role weight (3 > 2)!
  let fork_alice = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-lock")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_hash)),
      ("at", form::Json::Num(1790000011.0)),
      ("kind", form::Json::Str("member")),
      (
        "body",
        form::Json::Obj([
          ("sub", form::Json::Str("dave")),
          ("email", form::Json::Str("dave@example.com")),
          ("role", form::Json::Str("member")),
        ]),
      ),
    ]),
  ) {
    Ok(e) => e
    Err(_) => form::Json::Null
  }

  // Forged entry (seq=1): signed by Eve (not in lock) claiming Alice's key id -> MUST BE REJECTED!
  let forged_eve = match sign_lock_entry(
    eve_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-lock")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_hash)),
      ("at", form::Json::Num(1790000012.0)),
      ("kind", form::Json::Str("member")),
      (
        "body",
        form::Json::Obj([
          ("sub", form::Json::Str("mallory")),
          ("email", form::Json::Str("mallory@evil.test")),
          ("role", form::Json::Str("owner")),
        ]),
      ),
    ]),
  ) {
    Ok(e) => e
    Err(_) => form::Json::Null
  }

  // Verify natively (zero JSON boundary) via ClientCore::apply_lock_chain!
  let verified = match core.apply_lock_chain([g_signed, fork_bob, forged_eve, fork_alice], root_hash) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "verify_workspace_lock failed: " + e)
      return
    }
  }
  debug_assert(verified.rejected_count == 1, "forged Eve entry must be rejected as Off::NotValid")
  debug_assert(verified.beaten_count == 1, "Bob's lower-weight fork must be beaten by Alice's owner fork")
  debug_assert(verified.state.members.contains("dave"), "winning fork added dave")
  debug_assert(!verified.state.members.contains("carol"), "losing fork carol is not in active LockState")
  debug_assert(!verified.state.members.contains("mallory"), "forged mallory is not in active LockState")

  // Validate a real Ed25519-signed vault box certificate against the converged LockState.
  let box_cert = match sign_vault_record(
    alice_seed,
    "stillfail-vault-box/1",
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-lock")),
      ("device", form::Json::Str(alice_dev_id)),
      ("box", form::Json::Str("x25519:" + hex_64("a"))),
      ("at", form::Json::Num(1790000020.0)),
    ]),
  ) {
    Ok(c) => c
    Err(_) => form::Json::Null
  }
  debug_assert(verify_vault_cert(verified.state, box_cert).is_none(), "valid Ed25519 vault box cert must pass")

  // Tampered vault box cert signed by Eve must fail!
  let bad_cert = match sign_vault_record(
    eve_seed,
    "stillfail-vault-box/1",
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-lock")),
      ("device", form::Json::Str(alice_dev_id)),
      ("box", form::Json::Str("x25519:" + hex_64("b"))),
      ("at", form::Json::Num(1790000021.0)),
    ]),
  ) {
    Ok(c) => c
    Err(_) => form::Json::Null
  }
  debug_assert(verify_vault_cert(verified.state, bad_cert).is_some(), "forged vault box cert must be rejected")
}

// ── Test 5: Foreground client.focus preempts background idle prefetch ──

test "E2E 5: foreground client.focus preempts running idle sync task and finishes first" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-5") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  // Thread 99 (idle prefetch) takes 500ms; Thread 5 (foreground focus) takes 20ms.
  station.thread_delay_ms.set(99, 500)
  station.thread_delay_ms.set(5, 20)
  station.thread_entries.set(
    99,
    base_codec::json_obj([
      (
        "entries",
        base_codec::json_arr([
          base_codec::json_obj([
            ("thread", base_codec::json_int(99)),
            ("n", base_codec::json_int(1)),
            ("kind", base_codec::json_str("message")),
            ("authorKind", base_codec::json_str("agent")),
            ("author", base_codec::json_str("bot")),
            ("text", base_codec::json_str("idle prefetched")),
          ]),
        ]),
      ),
    ]),
  )
  station.thread_entries.set(
    5,
    base_codec::json_obj([
      (
        "entries",
        base_codec::json_arr([
          base_codec::json_obj([
            ("thread", base_codec::json_int(5)),
            ("n", base_codec::json_int(1)),
            ("kind", base_codec::json_str("message")),
            ("authorKind", base_codec::json_str("agent")),
            ("author", base_codec::json_str("bot")),
            ("text", base_codec::json_str("focused message")),
          ]),
        ]),
      ),
    ]),
  )

  let core = ClientCore::new("ws-1", "st1", rt, db, station.transport(), fn() -> Unit {})

  // Start idle prefetch of thread 99.
  let idle_done = [false]
  let _ = rt.fork_quiet_named("idle-prefetch-99", fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    core.sync.prefetch_idle_k(99, fn(ex : effect::Exit[Int]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => {
          idle_done[0] = true
        }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  // Advance 50ms so idle task is in-flight, then trigger foreground `client.focus` on thread 5.
  rt.advance(50)
  debug_assert(!idle_done[0], "idle task still in flight at 50ms")
  core.focus_chat(5)

  // Advance 40ms -> focused thread 5 completes while idle task 99 was preempted and requeued!
  rt.advance(40)
  debug_assert(core.sync.idle_preemptions() >= 1, "idle prefetch must be preempted by foreground client.focus")
  debug_assert(sim_db.entry_count("st1", 5) == 1, "focused thread 5 finished immediately")
  debug_assert(!idle_done[0], "preempted idle task waited behind foreground focus")

  // Advance 600ms -> idle task resumes and finishes after foreground focus.
  rt.advance(600)
  debug_assert(idle_done[0], "idle task completed after foreground finished")
  let order = core.sync.completed_tasks()
  debug_assert(order.length() == 2 && order[0] == "thread:5" && order[1] == "idle:99", "focused thread:5 completed strictly before idle:99")
}

// ── Test 6: Dual-channel JSON core_api.h wire protocol + workspace isolation ──

test "E2E 6: ClientCore::handle_wire serves core_api.h JSON protocol and isolates workspaces" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-6") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  let core = ClientCore::new("ws-alpha", "st1", rt, db, station.transport(), fn() -> Unit {})

  // SSE event tagged for a DIFFERENT workspace (`ws-beta`) must be ignored!
  core.start()
  rt.advance(20)
  station.push_sse(
    "id: ev-other\nevent: thread\ndata: {\"workspace\":\"ws-beta\",\"id\":1,\"entries\":[{\"thread\":1,\"n\":1,\"kind\":\"message\",\"authorKind\":\"agent\",\"author\":\"bot\",\"text\":\"leak\",\"at\":1}]}\n\n",
  )
  debug_assert(sim_db.entry_count("st1", 1) == 0, "workspace isolation drops cross-workspace events")

  // Send a message through the thin JSON `core_api.h` wire protocol (`chat.send`).
  let res = core.handle_wire("{\"id\":1,\"call\":\"chat.send\",\"params\":{\"thread\":1,\"idem\":\"ck-wire-1\",\"author\":\"bob\",\"text\":\"via wire\"}}")
  match res {
    Some((reply_json, _)) => debug_assert(reply_json.contains("\"queued\":true"), "wire chat.send queued optimistically")
    None => debug_assert(false, "expected wire response")
  }
  rt.advance(30)
  debug_assert(core.local_outbox.pending_message_count() == 0, "wire chat.send reconciled on 200")
  debug_assert(sim_db.entry_count("st1", 1) == 0, "HTTP 200 must not fabricate synthetic entry row")
  core.stop()
}

// ── Test 7: Real WebAuthn / Passkey P-256 verification (positive + negative cases) ──

fn encode_der_uint(raw : Bytes, off : Int, len : Int) -> Array[Byte] {
  let mut start = off
  let end = off + len
  while start < end - 1 && raw[start].to_int() == 0 {
    start += 1
  }
  let body : Array[Byte] = []
  if (raw[start].to_int() & 0x80) != 0 {
    body.push(0 as Byte)
  }
  for i in start..<end {
    body.push(raw[i])
  }
  let out : Array[Byte] = [0x02 as Byte, body.length() as Byte]
  for i in 0..<body.length() {
    out.push(body[i])
  }
  out
}

fn es256_raw_to_der(raw64 : Bytes) -> Bytes {
  let r_der = encode_der_uint(raw64, 0, 32)
  let s_der = encode_der_uint(raw64, 32, 32)
  let total = r_der.length() + s_der.length()
  let out = Bytes::new(2 + total)
  out[0] = 0x30 as Byte
  out[1] = total as Byte
  let mut at = 2
  for i in 0..<r_der.length() {
    out[at] = r_der[i]
    at += 1
  }
  for i in 0..<s_der.length() {
    out[at] = s_der[i]
    at += 1
  }
  out
}

fn make_auth_data(rp_id : String, flags : Int) -> Bytes {
  let rp_hash = crypto::sha256(rp_id.to_bytes())
  let out = Bytes::new(37)
  for i in 0..<32 {
    out[i] = rp_hash[i]
  }
  out[32] = flags as Byte
  // signCount = 1 (big-endian)
  out[36] = 1 as Byte
  out
}

fn build_passkey_sig(
  sk32 : Bytes,
  pk65 : Bytes,
  entry_hash_hex : String,
  origin : String,
  rp_id : String,
  webauthn_type : String,
  flags : Int,
  tamper_der : Bool,
) -> form::Json {
  let hash_bytes = match base_codec::hex_decode(entry_hash_hex) {
    Some(b) => b
    None => panic("bad hex")
  }
  let challenge = base_codec::base64url_encode(hash_bytes)
  let client_str = base_codec::json_stringify(base_codec::json_obj([
    ("type", base_codec::json_str(webauthn_type)),
    ("challenge", base_codec::json_str(challenge)),
    ("origin", base_codec::json_str(origin)),
  ]))
  let client_bytes = client_str.to_bytes()
  let auth_bytes = make_auth_data(rp_id, flags)
  let signed = Bytes::new(auth_bytes.length() + 32)
  let c_hash = crypto::sha256(client_bytes)
  for i in 0..<auth_bytes.length() {
    signed[i] = auth_bytes[i]
  }
  for i in 0..<32 {
    signed[auth_bytes.length() + i] = c_hash[i]
  }
  let raw_sig = match crypto::p256_sign_es256(sk32, signed) {
    Ok(s) => s
    Err(_) => panic("p256_sign_es256 failed")
  }
  let der = es256_raw_to_der(raw_sig)
  if tamper_der {
    let last = der.length() - 1
    der[last] = ((der[last].to_int() ^ 0xFF) & 0xFF) as Byte
  }
  let key_id = "p256:" + base_codec::base64url_encode(pk65)
  form::Json::Obj([
    ("key", form::Json::Str(key_id)),
    ("alg", form::Json::Str("webauthn")),
    ("authenticator_data", form::Json::Str(base_codec::base64url_encode(auth_bytes))),
    ("client_data", form::Json::Str(base_codec::base64url_encode(client_bytes))),
    ("sig", form::Json::Str(base_codec::base64url_encode(der))),
  ])
}

test "E2E 7: Passkey P-256 WebAuthn verification accepts valid assertion and rejects all tampered cases" {
  let sk = match base_codec::hex_decode("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721") {
    Some(b) => b
    None => panic("bad sk")
  }
  let pk = match crypto::p256_public_key(sk) {
    Ok(p) => p
    Err(_) => panic("p256_public_key failed")
  }
  let key_id = "p256:" + base_codec::base64url_encode(pk)
  debug_assert(valid_key_id(key_id), "p256 key id valid")

  let c = native_lock_crypto()
  let origins = ["https://app.still.fail", "https://still.fail"]
  let rp_id = "still.fail"
  let entry_hash = crypto::sha256_hex("lock-entry-canonical-body".to_bytes())
  let other_hash = crypto::sha256_hex("different-entry-body".to_bytes())

  // 1. Valid WebAuthn Passkey assertion -> ACCEPTED
  let valid_sig = build_passkey_sig(sk, pk, entry_hash, "https://app.still.fail", rp_id, "webauthn.get", 1, false)
  debug_assert((c.sig_valid)(valid_sig, entry_hash, origins, rp_id, true), "valid WebAuthn passkey accepted")

  // 2. passkey=false with alg="webauthn" -> REJECTED
  debug_assert(!(c.sig_valid)(valid_sig, entry_hash, origins, rp_id, false), "webauthn rejected when passkey=false")

  // 3. Wrong origin -> REJECTED
  let bad_origin = build_passkey_sig(sk, pk, entry_hash, "https://evil.example", rp_id, "webauthn.get", 1, false)
  debug_assert(!(c.sig_valid)(bad_origin, entry_hash, origins, rp_id, true), "wrong origin rejected")

  // 4. Wrong rpIdHash -> REJECTED
  let bad_rp = build_passkey_sig(sk, pk, entry_hash, "https://app.still.fail", "evil.example", "webauthn.get", 1, false)
  debug_assert(!(c.sig_valid)(bad_rp, entry_hash, origins, rp_id, true), "wrong rpIdHash rejected")

  // 5. Wrong challenge (signed for other_hash, verified against entry_hash) -> REJECTED
  let bad_chal = build_passkey_sig(sk, pk, other_hash, "https://app.still.fail", rp_id, "webauthn.get", 1, false)
  debug_assert(!(c.sig_valid)(bad_chal, entry_hash, origins, rp_id, true), "wrong challenge rejected")

  // 6. Tampered DER signature -> REJECTED
  let bad_der = build_passkey_sig(sk, pk, entry_hash, "https://app.still.fail", rp_id, "webauthn.get", 1, true)
  debug_assert(!(c.sig_valid)(bad_der, entry_hash, origins, rp_id, true), "tampered DER signature rejected")

  // 7. UP flag = 0 -> REJECTED
  let no_up = build_passkey_sig(sk, pk, entry_hash, "https://app.still.fail", rp_id, "webauthn.get", 0, false)
  debug_assert(!(c.sig_valid)(no_up, entry_hash, origins, rp_id, true), "UP=0 rejected")

  // 8. Wrong type ("webauthn.create") -> REJECTED
  let bad_type = build_passkey_sig(sk, pk, entry_hash, "https://app.still.fail", rp_id, "webauthn.create", 1, false)
  debug_assert(!(c.sig_valid)(bad_type, entry_hash, origins, rp_id, true), "wrong webauthn type rejected")
}

// ── Test 8: SessionChanged / JobChanged live tracking, account.doc / roster queries, and lock.status ──

test "E2E 8: SessionChanged/JobChanged live sync, account.doc & workspace/station roster, and lock.status" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-8") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  let wakes = [0]
  let core = ClientCore::new("ws-core", "st1", rt, db, station.transport(), fn() -> Unit {
    wakes[0] += 1
  })

  // 1. lock.status before pinning
  match core.handle_wire("{\"id\":1,\"call\":\"lock.status\",\"params\":{}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"locked\":false") && txt.contains("\"ws-core\""), "unlocked status")
    None => debug_assert(false, "expected lock.status")
  }

  // 2. Pin a real Ed25519-signed genesis lock and query lock.status again
  let owner_seed = make_seed(44)
  let owner_key = ed25519_key_id(owner_seed)
  let owner_dev_id = hex_64("4")
  let gen_unsigned = form::Json::Obj([
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws-core")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    (
      "body",
      form::Json::Obj([
        ("owner", form::Json::Str("u-owner")),
        ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
        ("rp_id", form::Json::Str("still.fail")),
        ("cloud_keys", form::Json::Obj([])),
        (
          "members",
          form::Json::Arr([
            form::Json::Obj([
              ("sub", form::Json::Str("u-owner")),
              ("email", form::Json::Str("owner@example.com")),
              ("role", form::Json::Str("owner")),
            ]),
          ]),
        ),
        (
          "devices",
          form::Json::Arr([
            form::Json::Obj([
              ("id", form::Json::Str(owner_dev_id)),
              ("sub", form::Json::Str("u-owner")),
              ("kind", form::Json::Str("app")),
              ("label", form::Json::Str("Mac")),
              ("sign_key", form::Json::Str(owner_key)),
            ]),
          ]),
        ),
        ("passkeys", form::Json::Arr([])),
        ("stations", form::Json::Arr([])),
        ("gateways", form::Json::Arr([])),
      ]),
    ),
  ])
  let gen_signed = match sign_lock_entry(owner_seed, gen_unsigned) {
    Ok(e) => e
    Err(why) => panic("sign genesis failed: " + why)
  }
  let root_hash = match lock::entry_hash(gen_signed, native_lock_crypto()) {
    Ok(h) => h
    Err(_) => panic("entry_hash failed")
  }
  match core.apply_lock_chain([gen_signed], root_hash) {
    Ok(_) => ()
    Err(e) => panic("apply_lock_chain failed: " + e)
  }
  match core.handle_wire("{\"id\":2,\"call\":\"lock.status\",\"params\":{}}") {
    Some((txt, _)) => {
      debug_assert(txt.contains("\"locked\":true"), "locked=true")
      debug_assert(txt.contains(root_hash), "genesis hash present")
      debug_assert(txt.contains("\"memberCount\":1"), "memberCount=1")
    }
    None => debug_assert(false, "expected lock.status after pin")
  }

  // 3. Real-time SessionChanged & JobChanged via SSE -> FrameOutbox + sessions.list / jobs.open
  sim_db.jobs.set("st1:job-1", "{\"id\":\"job-1\",\"session\":\"sess-a\",\"state\":\"running\"}")
  core.start()
  rt.advance(20)
  let _ = core.drain_frame()
  station.push_sse(
    "id: s-1\nevent: session\ndata: {\"key\":\"sess-a\",\"process\":\"running\",\"turns\":3}\n\n" +
    "id: j-1\nevent: job\ndata: {\"id\":\"job-1\",\"session\":\"sess-a\",\"state\":\"running\"}\n\n",
  )
  debug_assert(core.running_session_count() == 1, "1 running session")
  debug_assert(core.open_job_count() == 1, "1 open job")
  let evs1 = core.drain_frame()
  let mut saw_sess_ev = false
  let mut saw_job_ev = false
  for i in 0..<evs1.length() {
    match evs1[i] {
      CoreEvent::SessionChanged(s, k, r) => if s == "st1" && k == "sess-a" && r { saw_sess_ev = true }
      CoreEvent::JobChanged(s, jid, o) => if s == "st1" && jid == "job-1" && o { saw_job_ev = true }
      _ => ()
    }
  }
  debug_assert(saw_sess_ev && saw_job_ev, "SessionChanged and JobChanged emitted to FrameOutbox")

  match core.handle_wire("{\"id\":3,\"call\":\"sessions.list\",\"params\":{}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"sess-a\"") && txt.contains("\"running\":true"), "sessions.list")
    None => debug_assert(false, "expected sessions.list")
  }
  match core.handle_wire("{\"id\":4,\"call\":\"jobs.open\",\"params\":{}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"job-1\"") && txt.contains("\"open\":true"), "jobs.open")
    None => debug_assert(false, "expected jobs.open")
  }

  // Transition session to idle and job to closed
  station.push_sse(
    "id: s-2\nevent: session\ndata: {\"key\":\"sess-a\",\"process\":\"idle\",\"turns\":4}\n\n" +
    "id: j-2\nevent: job\ndata: {\"id\":\"job-1\",\"session\":\"sess-a\",\"state\":\"exited\"}\n\n",
  )
  debug_assert(core.running_session_count() == 0, "0 running sessions after idle")
  debug_assert(core.open_job_count() == 0, "0 open jobs after close")

  // 4. account.doc + workspace & station roster persistence & queries
  let _ = store::put_account_doc(db, "me", "{\"email\":\"alice@still.fail\"}", confirmed=Some(1000.to_int64()))
  let _ = store::upsert_workspace(db, "ws-core", "{\"name\":\"Core WS\"}", confirmed=Some(1000.to_int64()))
  let _ = store::upsert_station_doc(db, "st1", "overview", "{\"name\":\"Studio\"}", confirmed=Some(1000.to_int64()))

  match core.handle_wire("{\"id\":5,\"call\":\"account.doc\",\"params\":{\"name\":\"me\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("alice@still.fail"), "account.doc query")
    None => debug_assert(false, "expected account.doc")
  }
  match core.handle_wire("{\"id\":6,\"call\":\"workspaces.list\",\"params\":{}}") {
    Some((txt, _)) => debug_assert(txt.contains("ws-core") && txt.contains("Core WS"), "workspaces.list query")
    None => debug_assert(false, "expected workspaces.list")
  }
  match core.handle_wire("{\"id\":7,\"call\":\"stations.list\",\"params\":{\"kind\":\"overview\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("st1") && txt.contains("Studio"), "stations.list query")
    None => debug_assert(false, "expected stations.list")
  }
  match core.handle_wire("{\"id\":8,\"subscribe\":{\"topic\":\"workspaces\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"value\"") && txt.contains("ws-core"), "workspaces subscribe")
    None => debug_assert(false, "expected workspaces subscribe")
  }
  core.stop()
}

test "E2E 9: real ops (chat.hide, decision.dismiss, decision.answer, chat.read, chat.draft) with optimistic dispatch & rollback" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-interact") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  let core = ClientCore::new("ws-core", "st1", rt, db, station.transport(), fn() -> Unit {})

  core.start()
  rt.advance(20)
  let _ = core.drain_frame()

  // 1. chat.hide + decision.dismiss + decision.answer(close) succeed online via real ops.ts routes
  match core.handle_wire("{\"id\":1,\"call\":\"chat.hide\",\"params\":{\"thread\":42,\"hidden\":true}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"opId\""), "chat.hide ok")
    None => debug_assert(false, "expected chat.hide")
  }
  match core.handle_wire("{\"id\":2,\"call\":\"decision.dismiss\",\"params\":{\"thread\":42,\"seq\":2}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"opId\""), "decision.dismiss ok")
    None => debug_assert(false, "expected decision.dismiss")
  }
  match core.handle_wire("{\"id\":3,\"call\":\"decision.answer\",\"params\":{\"thread\":42,\"seq\":3,\"option\":\"Skip deploy\",\"action\":\"close\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"option\":\"Skip deploy\""), "decision.answer close ok")
    None => debug_assert(false, "expected decision.answer")
  }
  rt.advance(30)
  debug_assert(core.local_outbox.pending_overlay_count() == 0, "all 3 overlays confirmed and cleared")
  let mut saw_hide_req = false
  let mut saw_dismiss_req = false
  let mut saw_close_req = false
  for i in 0..<station.requests_seen.length() {
    let r = station.requests_seen[i]
    if r == "PUT /threads/42/hidden" { saw_hide_req = true }
    if r == "PUT /threads/42/dismissed" { saw_dismiss_req = true }
    if r == "PUT /threads/42/closed-card" { saw_close_req = true }
  }
  debug_assert(saw_hide_req && saw_dismiss_req && saw_close_req, "station received real ops.ts routes")

  // 2. Station 403 rejection on decision.close rolls back cleanly with recovery hint
  station.reject_path_prefix = Some("/threads/42/closed-card")
  station.reject_code = "card_closed"
  station.reject_recovery = "Card was already answered by another member."
  let _ = core.drain_frame()
  match core.handle_wire("{\"id\":4,\"call\":\"decision.close\",\"params\":{\"thread\":42,\"seq\":9,\"option\":\"Yes\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"opId\""), "optimistic decision.close accepted locally")
    None => debug_assert(false, "expected optimistic ok")
  }
  rt.advance(30)
  let evs = core.drain_frame()
  let mut saw_rollback = false
  for i in 0..<evs.length() {
    match evs[i] {
      CoreEvent::OverlayRolledBack(_, _, kind, code, rec) => {
        if kind == "decision.close" && code == "card_closed" && rec.contains("already answered") {
          saw_rollback = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_rollback && core.local_outbox.pending_overlay_count() == 0, "decision.close rolled back cleanly")

  // 3. chat.read updates local SQLite thread read cursor and sends PUT /threads/42/read
  station.reject_path_prefix = None
  match core.handle_wire("{\"id\":5,\"call\":\"chat.read\",\"params\":{\"thread\":42,\"seq\":12,\"unread\":0}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"read\":12") && txt.contains("\"unread\":0"), "chat.read ok")
    None => debug_assert(false, "expected chat.read")
  }
  rt.advance(20)
  let mut saw_put_read = false
  for i in 0..<station.requests_seen.length() {
    if station.requests_seen[i] == "PUT /threads/42/read" { saw_put_read = true }
  }
  debug_assert(saw_put_read, "chat.read dispatched PUT /threads/42/read")
  match sim_db.thread_reads.get("st1:42") {
    Some((r, u)) => debug_assert(r == 12 && u == 0, "thread read cursor persisted")
    None => debug_assert(false, "expected thread read cursor in DB")
  }

  // 4. chat.draft persists, reads back, and clears
  match core.handle_wire("{\"id\":6,\"call\":\"chat.draft\",\"params\":{\"chat\":\"c-42\",\"text\":\"work in progress\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"saved\":true"), "draft saved")
    None => debug_assert(false, "expected draft save")
  }
  match core.handle_wire("{\"id\":7,\"call\":\"chat.draft\",\"params\":{\"chat\":\"c-42\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("work in progress"), "draft read back")
    None => debug_assert(false, "expected draft read")
  }
  match core.handle_wire("{\"id\":8,\"call\":\"chat.draft\",\"params\":{\"chat\":\"c-42\",\"clear\":true}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"cleared\":true"), "draft cleared")
    None => debug_assert(false, "expected draft clear")
  }
  core.stop()
}

test "E2E 10: accounts, vault, said search, settings, and chats/chat keyed delta + have/keep token" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-biz") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  station.snapshot_json = base_codec::json_obj([
    (
      "chats",
      base_codec::json_arr([
        base_codec::json_obj([
          ("id", base_codec::json_str("c-alpha")),
          ("title", base_codec::json_str("Alpha Launch")),
          ("thread", base_codec::json_int(10)),
          ("lastActive", base_codec::json_int(1000)),
        ]),
      ]),
    ),
  ])
  let core = ClientCore::new("ws-biz", "st1", rt, db, station.transport(), fn() -> Unit {})

  // Seed account docs for accounts & vault
  let _ = core.set_db_account_sub("bob@still.fail")
  let _ = store::put_account_doc(db, "accounts", "[{\"email\":\"alice@still.fail\"},{\"email\":\"bob@still.fail\"}]")
  let _ = store::put_account_doc(db, "active_account", "\"alice@still.fail\"")
  let _ = store::put_account_doc(db, "vault_status", "{\"enabled\":true,\"unlocked\":true,\"vaultCount\":1,\"secretCount\":1}")
  let _ = store::put_account_doc(db, "vault_secrets", "[{\"id\":\"s1\",\"vault\":\"personal\",\"name\":\"OpenAI Key\",\"about\":\"API\"}]")

  core.start()
  rt.advance(30)
  // Push a real `thread` SSE message so `said` trigger populates searchable text
  station.push_sse(
    "id: e-1\nevent: thread\ndata: {\"id\":10,\"entries\":[{\"thread\":10,\"n\":1,\"kind\":\"message\",\"authorKind\":\"agent\",\"author\":\"bot\",\"text\":\"Pion Stage 2 core parity ready\",\"at\":1050}]}\n\n",
  )

  // 1. accounts + account.switch
  match core.handle_wire("{\"id\":1,\"call\":\"accounts\",\"params\":{}}") {
    Some((txt, _)) => debug_assert(txt.contains("alice@still.fail") && txt.contains("bob@still.fail"), "accounts")
    None => debug_assert(false, "expected accounts")
  }
  match core.handle_wire("{\"id\":2,\"call\":\"account.switch\",\"params\":{\"account\":\"bob@still.fail\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"switched\":true") && txt.contains("bob@still.fail"), "account.switch")
    None => debug_assert(false, "expected account.switch")
  }

  // 2. vault.status + vault.secrets
  match core.handle_wire("{\"id\":3,\"call\":\"vault.status\",\"params\":{}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"enabled\":true") && txt.contains("\"secretCount\":1"), "vault.status")
    None => debug_assert(false, "expected vault.status")
  }
  match core.handle_wire("{\"id\":4,\"call\":\"vault.secrets\",\"params\":{\"query\":\"OpenAI\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("OpenAI Key"), "vault.secrets")
    None => debug_assert(false, "expected vault.secrets")
  }

  // 3. search.chats + search.messages (using `said` table)
  match core.handle_wire("{\"id\":5,\"call\":\"search.chats\",\"params\":{\"query\":\"Alpha\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("c-alpha") && txt.contains("Alpha Launch"), "search.chats")
    None => debug_assert(false, "expected search.chats")
  }
  match core.handle_wire("{\"id\":6,\"call\":\"search.messages\",\"params\":{\"query\":\"Stage 2\",\"station\":\"st1\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("Pion Stage 2 core parity ready"), "search.messages via said")
    None => debug_assert(false, "expected search.messages")
  }

  // 4. settings.set + settings.get
  match core.handle_wire("{\"id\":7,\"call\":\"settings.set\",\"params\":{\"key\":\"locale\",\"value\":\"zh-CN\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"saved\":true"), "settings.set")
    None => debug_assert(false, "expected settings.set")
  }
  match core.handle_wire("{\"id\":8,\"call\":\"settings.get\",\"params\":{\"key\":\"locale\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"value\":\"zh-CN\""), "settings.get")
    None => debug_assert(false, "expected settings.get")
  }

  // 5. Keyed `chats` subscription delta + keep/have token negotiation
  match core.handle_wire("{\"id\":50,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-biz\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"value\"") && txt.contains("c-alpha"), "initial chats value")
    None => debug_assert(false, "expected chats subscribe")
  }
  // Push a second chat over SSE (`chat-shared`) -> refresh_topic("chats") emits keyed `put` delta containing ONLY c-beta
  station.push_sse(
    "id: c-2\nevent: chat-shared\ndata: {\"id\":\"c-beta\",\"title\":\"Beta Review\",\"thread\":11,\"lastActive\":2000}\n\n",
  )
  let deltas = core.refresh_topic("chats")
  debug_assert(deltas.length() == 1, "one chats delta emitted")
  let (delta_json, _) = protocol::encode_core_event(deltas[0])
  debug_assert(delta_json.contains("\"delta\"") && delta_json.contains("\"put\"") && delta_json.contains("c-beta") && !delta_json.contains("Alpha Launch") && delta_json.length() <= 4096, "incremental keyed delta only carries c-beta")

  // Unsubscribe with keep: true -> get `v` token -> re-subscribe with `have: v` -> `same: true`
  let v_tok = match core.handle_wire("{\"id\":50,\"unsubscribe\":true,\"keep\":true}") {
    Some((txt, _)) =>
    match base_codec::json_parse(txt) {
      base_codec::JsonParseResult::Ok(j) =>
      match base_codec::json_get(j, "v") {
        Some(base_codec::Json::Str(v)) => v
        _ => panic("missing v token")
      }
      _ => panic("bad json")
    }
    None => panic("expected unsub v")
  }
  let resub = "{\"id\":51,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-biz\"},\"keyed\":true,\"have\":\"" + v_tok + "\"}"
  match core.handle_wire(resub) {
    Some((txt, _)) => debug_assert(txt == "{\"id\":51,\"same\":true,\"conn\":1,\"authGen\":1}", "resubscribe with matching have returns same:true with WireOutGen")
    None => debug_assert(false, "expected same:true")
  }
  core.stop()
}

test "E2E 11: offline real ops (chat.rename, chat.mute, decision.close) flush_offline dispatches exact ops.ts routes" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-offline-mut") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  station.offline = true
  let core = ClientCore::new("ws-off", "st1", rt, db, station.transport(), fn() -> Unit {})

  // Queue real ops while offline
  match core.rename_chat("c-42", "Offline Title", thread=Some(42)) {
    sql::SqlResult::Ok(_) => ()
    sql::SqlResult::Err(_) => debug_assert(false, "offline chat.rename failed")
  }
  match core.perform_op("chat.mute", base_codec::json_obj([("thread", base_codec::json_int(42)), ("muted", base_codec::json_bool(true))])) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "offline chat.mute failed")
  }
  match core.perform_op("decision.close", base_codec::json_obj([("thread", base_codec::json_int(42)), ("seq", base_codec::json_int(3)), ("option", base_codec::json_str("Skip"))])) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "offline decision.close failed")
  }
  debug_assert(core.local_outbox.pending_overlay_count() == 3, "3 overlays queued offline")
  debug_assert(station.requests_seen.length() == 0, "0 requests while offline")

  // Come back online -> flush_offline must route to exact ops.ts endpoints
  station.offline = false
  core.set_online(true)
  rt.advance(40)

  let mut saw_title = false
  let mut saw_muted = false
  let mut saw_closed = false
  let mut saw_bad_chats_route = false
  for i in 0..<station.requests_seen.length() {
    let r = station.requests_seen[i]
    if r == "PUT /threads/42/title" { saw_title = true }
    if r == "PUT /threads/42/muted" { saw_muted = true }
    if r == "PUT /threads/42/closed-card" { saw_closed = true }
    if r.contains("/chats/thread:") { saw_bad_chats_route = true }
  }
  debug_assert(saw_title && saw_muted && saw_closed, "exact ops.ts thread routes dispatched on reconnect")
  debug_assert(!saw_bad_chats_route, "never misrouted to /chats/thread:...")
  debug_assert(core.local_outbox.pending_overlay_count() == 0, "all 3 overlays cleared from changing after confirmation")
}

test "E2E 12: ClientCore wired to packages/views projects chats, chat, workspaces, stations, accounts, vaults, lock with <=4KB keyed deltas" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-views") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  station.snapshot_json = base_codec::json_obj([
    (
      "chats",
      base_codec::json_arr([
        base_codec::json_obj([
          ("id", base_codec::json_str("c-v1")),
          ("title", base_codec::json_str("Views Chat 1")),
          ("thread", base_codec::json_int(7)),
          ("lastActive", base_codec::json_int(1000)),
        ]),
      ]),
    ),
  ])
  let core = ClientCore::new("ws-views", "st1", rt, db, station.transport(), fn() -> Unit {})
  core.set_viewer("alice@still.fail", sub="u-alice", role="owner", device_id="dev-1")

  let _ = store::upsert_workspace(db, "ws-views", "{\"name\":\"Views WS\",\"role\":\"owner\",\"members\":[{\"sub\":\"u-alice\",\"email\":\"alice@still.fail\",\"role\":\"owner\"}],\"stations\":[{\"id\":\"st1\"}]}", confirmed=Some(1000.to_int64()))
  let _ = store::upsert_station_doc(db, "ws-views/st1", "overview", "{\"id\":\"st1\",\"name\":\"Tokyo Studio\",\"online\":true,\"apiProviders\":[{\"secret\":\"strip-me\"}]}", confirmed=Some(1000.to_int64()))
  let _ = store::put_account_doc(db, "accounts", "[{\"id\":\"a1\",\"email\":\"alice@still.fail\",\"name\":\"Alice\",\"token\":\"secret-tok\"}]")
  let _ = store::put_account_doc(db, "active_account", "\"a1\"")
  let _ = store::put_account_doc(db, "vaults:ws-views", "{\"vaults\":[{\"id\":\"v1\",\"name\":\"Personal\",\"owner\":\"u-alice\",\"ownerName\":\"Alice\",\"mine\":true,\"members\":[],\"station\":\"ws-views/st1\",\"stationName\":\"Tokyo Studio\",\"items\":2,\"devices\":1,\"open\":true,\"keyed\":true,\"missing\":0,\"recoverable\":false}],\"requests\":[],\"refused\":[]}")

  core.start()
  rt.advance(30)

  // 1. workspaces / workspace / stations / accounts / lock / vaults all go through packages/views (stripping secrets, 0 个人锁 leakage)
  match core.handle_wire("{\"id\":101,\"subscribe\":{\"topic\":\"workspaces\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"workspaces\"") && txt.contains("Views WS") && txt.contains("\"stationsCount\":1"), "workspaces view")
    None => debug_assert(false, "expected workspaces")
  }
  match core.handle_wire("{\"id\":102,\"subscribe\":{\"topic\":\"workspace\",\"workspace\":\"ws-views\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"members\"") && txt.contains("Tokyo Studio") && !txt.contains("strip-me"), "workspace view strips detail fields")
    None => debug_assert(false, "expected workspace")
  }
  match core.handle_wire("{\"id\":103,\"subscribe\":{\"topic\":\"stations\",\"scope\":\"ws-views\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("Tokyo Studio") && !txt.contains("strip-me"), "stations view strips apiProviders")
    None => debug_assert(false, "expected stations")
  }
  match core.handle_wire("{\"id\":104,\"subscribe\":{\"topic\":\"accounts\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("alice@still.fail") && !txt.contains("secret-tok"), "accounts view strips token")
    None => debug_assert(false, "expected accounts")
  }
  match core.handle_wire("{\"id\":105,\"subscribe\":{\"topic\":\"lock\",\"workspace\":\"ws-views\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"locked\":false") && !txt.contains("个人锁"), "unified SafeModeView with zero personal-lock leakage")
    None => debug_assert(false, "expected lock")
  }
  match core.handle_wire("{\"id\":106,\"subscribe\":{\"topic\":\"vaults\",\"workspace\":\"ws-views\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"vaults\"") && txt.contains("Personal") && !txt.contains("个人锁"), "vaults view")
    None => debug_assert(false, "expected vaults")
  }

  // 2. chats view uses `days` bucketing + RowsMemo reuse + <= 4KB keyed delta
  match core.handle_wire("{\"id\":107,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-views\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"days\"") && txt.contains("\"glyph\"") && txt.contains("Views Chat 1"), "ChatsView shape")
    None => debug_assert(false, "expected chats")
  }
  let reused_before = core.rows_memo.rows_reused
  station.push_sse(
    "id: c-v2\nevent: chat-shared\ndata: {\"id\":\"c-v2\",\"title\":\"Views Chat 2\",\"thread\":8,\"lastActive\":2000}\n\n",
  )
  let chats_deltas = core.refresh_topic("chats")
  debug_assert(chats_deltas.length() == 1, "chats delta emitted")
  let (cd_json, _) = protocol::encode_core_event(chats_deltas[0])
  debug_assert(cd_json.length() <= 4096 && cd_json.contains("c-v2") && !cd_json.contains("Views Chat 1"), "chats delta <= 4KB and only carries c-v2")
  debug_assert(core.rows_memo.rows_reused > reused_before, "RowsMemo reused unchanged c-v1")

  // 3. chat view: 0 SQL writes on cold open, outbox clientKey dedup, and <= 4KB keyed delta on SSE arrival
  let ran_before = sim_db.ran.length()
  match core.handle_wire("{\"id\":108,\"subscribe\":{\"topic\":\"chat\",\"station\":\"st1\",\"thread\":7},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"messages\"") && txt.contains("\"outbox\"") && txt.contains("\"asks\""), "ChatView shape")
    None => debug_assert(false, "expected chat")
  }
  let (_, writes_on_open, _) = sim_db.counts_since(ran_before)
  debug_assert(writes_on_open == 0, "0 SQL writes on cold chat subscribe")

  // Optimistic chat.send -> outbox entry appears in delta -> SSE confirms -> outbox cleared & message added (0 duplicates)
  let _ = core.send_message(7, "ck-views-1", "alice@still.fail", "hello views", rt.now())
  let d_outbox = core.refresh_topic("chat")
  debug_assert(d_outbox.length() == 1, "chat delta for optimistic outbox")
  let (d_ob_json, _) = protocol::encode_core_event(d_outbox[0])
  debug_assert(d_ob_json.length() <= 4096 && d_ob_json.contains("ck-views-1"), "optimistic outbox delta <= 4KB")

  station.push_sse(
    "id: e-v1\nevent: thread\ndata: {\"id\":7,\"entries\":[{\"thread\":7,\"n\":1,\"kind\":\"message\",\"authorKind\":\"person\",\"author\":\"alice@still.fail\",\"text\":\"hello views\",\"clientKey\":\"ck-views-1\",\"at\":3000}]}\n\n",
  )
  let d_confirmed = core.refresh_topic("chat")
  debug_assert(d_confirmed.length() == 1, "chat delta for SSE confirmation")
  let (d_cf_json, _) = protocol::encode_core_event(d_confirmed[0])
  debug_assert(d_cf_json.length() <= 4096 && d_cf_json.contains("\"delta\"") && d_cf_json.contains("hello views") && d_cf_json.contains("\"drop\""), "SSE chat delta <= 4KB and drops reconciled outbox item")
  core.stop()
}

test "E2E 13: Batch 2 & Batch 3 wiring in ClientCore (auth.begin, accounts, presets, downloads, profiles, models, search, archive, fleet, usage)" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-b2b3") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  station.snapshot_json = base_codec::json_obj([
    (
      "chats",
      base_codec::json_arr([
        base_codec::json_obj([
          ("id", base_codec::json_str("c-live-1")),
          ("archived", base_codec::json_int(0)),
          ("title", base_codec::json_str("Active Sprint")),
          ("thread", base_codec::json_int(20)),
          ("lastActive", base_codec::json_int64(5000.to_int64())),
        ]),
        base_codec::json_obj([
          ("id", base_codec::json_str("c-arch-1")),
          ("archived", base_codec::json_int(1)),
          ("title", base_codec::json_str("Archived Sprint")),
          ("thread", base_codec::json_int(21)),
          ("lastActive", base_codec::json_int64(3000.to_int64())),
        ]),
      ]),
    ),
  ])
  let core = ClientCore::new("ws-b3", "ws-b3/st1", rt, db, station.transport(), fn() -> Unit {})
  core.set_cloud_origin("https://app.still.fail")
  core.set_viewer("alice@still.fail", sub="u-alice", role="owner", device_id="dev-1")

  let _ = store::upsert_station_doc(
    db,
    "ws-b3/st1",
    "overview",
    "{\"id\":\"st1\",\"name\":\"Studio\",\"online\":true,\"profiles\":[{\"id\":\"p1\",\"name\":\"Claude\",\"email\":\"alice@still.fail\",\"runtime\":\"claude\",\"runtimes\":[\"claude\"],\"models\":[\"claude-opus-5-5\"],\"enabled\":true,\"access\":{\"kind\":\"subscription\",\"token\":\"DO_NOT_LEAK\",\"apiKey\":\"sk-leak\"}}]}",
    confirmed=Some(1000.to_int64()),
  )
  let _ = store::upsert_station_doc(
    db,
    "ws-b3/st1",
    "usage",
    "{\"rows\":[{\"day\":\"2026-11-23\",\"person\":\"alice@still.fail\",\"chat\":\"c-live-1\",\"profile\":\"p1\",\"model\":\"claude-opus-5-5\",\"cost\":4.25,\"calls\":3,\"input\":10000,\"cacheRead\":5000,\"cacheWrite\":0,\"output\":2000}]}",
    confirmed=Some(1000.to_int64()),
  )
  core.other_presets_held.push(views::PresetRecord::live(
    "pr-bob",
    "u-bob",
    1,
    1000.to_int64(),
    1000.to_int64(),
    "bob@still.fail",
    "ws-b3/st1",
    "Bob Preset",
  ))
  core.stars_held.push(views::StarEntry::{ key: "claude-opus-5-5", on: true, rev: 1, at: 100.to_int64() })
  core.vault_approvals.enqueue(views::VaultApprovalRequest::{
    id: "vr-1",
    ws: "ws-b3",
    vault_id: "v1",
    item_id: "item-1",
    item_name: "Stripe Test Key",
    kind: views::VaultRequestKind::SecretUse,
    mode: "env",
    reason: "run tests",
    hosts: ["api.stripe.com"],
    max_scope: "hour",
    at_ms: 1000.to_int64(),
    status: views::VaultRequestStatus::Pending,
    granted_scope: None,
    decided_at_ms: None,
    decision_note: None,
  })

  core.start()
  rt.advance(30)

  // 1. auth.begin -> valid URL, S256 challenge, ZERO verifier leakage!
  let auth_state = match core.handle_wire("{\"id\":2,\"call\":\"auth.begin\",\"params\":{\"redirect_uri\":\"stillfail://auth/callback\",\"return_to\":\"/\"}}") {
    Some((txt, _)) => {
      debug_assert(txt.contains("https://app.still.fail/v1/auth/google/start?state="), "auth.begin url")
      debug_assert(txt.contains("code_challenge_method=S256"), "auth.begin PKCE S256")
      debug_assert(!txt.contains("verifier"), "auth.begin must NEVER leak verifier")
      match base_codec::json_parse(txt) {
        base_codec::JsonParseResult::Ok(j) =>
        match base_codec::json_get(j, "ok") {
          Some(ok_j) =>
          match base_codec::json_get(ok_j, "state") {
            Some(base_codec::Json::Str(s)) => s
            _ => ""
          }
          None => ""
        }
        _ => ""
      }
    }
    None => ""
  }
  debug_assert(auth_state.length() > 0, "auth.begin returned state")

  // 2. auth.complete registers account without leaking tokens -> accounts subscription reflects it
  let complete_req = "{\"id\":3,\"call\":\"auth.complete\",\"params\":{\"state\":\"" + auth_state + "\",\"code\":\"oauth-code-1\",\"sub\":\"u-alice\",\"email\":\"alice@still.fail\",\"name\":\"Alice\",\"access\":\"ACCESS_SECRET\",\"refresh\":\"REFRESH_SECRET\"}}"
  match core.handle_wire(complete_req) {
    Some((txt, _)) => debug_assert(txt.contains("\"ok\":true") && !txt.contains("ACCESS_SECRET") && !txt.contains("REFRESH_SECRET"), "auth.complete strips tokens")
    None => debug_assert(false, "expected auth.complete reply")
  }
  match core.handle_wire("{\"id\":201,\"subscribe\":{\"topic\":\"accounts\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("alice@still.fail") && !txt.contains("ACCESS_SECRET"), "accounts topic strips tokens")
    None => debug_assert(false, "expected accounts")
  }

  // 3. presets + preset.copy -> delta <= 4 KB
  match core.handle_wire("{\"id\":202,\"subscribe\":{\"topic\":\"presets\",\"station\":\"ws-b3/st-b3\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"presets\":[]"), "initially 0 own presets")
    None => debug_assert(false, "expected presets")
  }
  match core.handle_wire("{\"id\":4,\"call\":\"preset.copy\",\"params\":{\"id\":\"pr-bob\",\"newId\":\"pr-mine-1\",\"name\":\"My Copy\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("pr-mine-1") && txt.contains("\"editable\":true"), "preset.copy")
    None => debug_assert(false, "expected preset.copy")
  }
  let p_deltas = core.refresh_topic("presets")
  debug_assert(p_deltas.length() == 1, "presets delta emitted")
  let (pd_json, _) = protocol::encode_core_event(p_deltas[0])
  debug_assert(pd_json.length() <= 4096 && (pd_json.contains("\"put\"") || pd_json.contains("\"append\"")) && pd_json.contains("pr-mine-1"), "presets delta <= 4KB")

  // 4. downloads + download.join / download.leave
  match core.handle_wire("{\"id\":203,\"subscribe\":{\"topic\":\"downloads\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"downloads\":[]"), "initial downloads")
    None => debug_assert(false, "expected downloads")
  }
  match core.handle_wire("{\"id\":5,\"call\":\"download.join\",\"params\":{\"reader\":\"r1\",\"fileKey\":\"f1\",\"version\":\"v1\",\"start\":0,\"end\":1024,\"name\":\"report.pdf\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"readerId\":\"r1\"") && txt.contains("\"newRequests\""), "download.join")
    None => debug_assert(false, "expected download.join")
  }
  let dl_deltas = core.refresh_topic("downloads")
  debug_assert(dl_deltas.length() == 1, "downloads delta emitted")
  let (dl_json, _) = protocol::encode_core_event(dl_deltas[0])
  debug_assert(dl_json.length() <= 4096 && dl_json.contains("report.pdf"), "downloads keyed delta <= 4KB")
  match core.handle_wire("{\"id\":6,\"call\":\"download.leave\",\"params\":{\"reader\":\"r1\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"cancelledReqIds\""), "download.leave")
    None => debug_assert(false, "expected download.leave")
  }

  // 5. vault.approve
  match core.handle_wire("{\"id\":7,\"call\":\"vault.approve\",\"params\":{\"request\":\"vr-1\",\"scope\":\"once\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"status\":\"granted\""), "vault.approve")
    None => debug_assert(false, "expected vault.approve")
  }

  // 6. Batch 3 topics: profiles, search, archive, fleet, usage
  match core.handle_wire("{\"id\":205,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-b3\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("alice@still.fail") && !txt.contains("DO_NOT_LEAK") && !txt.contains("sk-leak"), "profiles strips secrets")
    None => debug_assert(false, "expected profiles")
  }
  match core.handle_wire("{\"id\":207,\"subscribe\":{\"topic\":\"search\",\"scope\":\"ws-b3\",\"query\":\"Active\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("Active Sprint"), "search topic")
    None => debug_assert(false, "expected search")
  }
  match core.handle_wire("{\"id\":208,\"subscribe\":{\"topic\":\"archive\",\"scope\":\"ws-b3\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("Archived Sprint") && !txt.contains("Active Sprint"), "archive topic only returns archived=1")
    None => debug_assert(false, "expected archive")
  }
  match core.handle_wire("{\"id\":209,\"subscribe\":{\"topic\":\"fleet\",\"scope\":\"ws-b3\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"devices\":1") && txt.contains("$4.25"), "fleet topic")
    None => debug_assert(false, "expected fleet")
  }
  match core.handle_wire("{\"id\":210,\"subscribe\":{\"topic\":\"usage\",\"scope\":\"ws-b3\",\"days\":7},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("$4.25") && txt.contains("\"empty\":false"), "usage topic")
    None => debug_assert(false, "expected usage")
  }
  core.stop()
}

test "E2E 14: SSE reconnect uses ?since=<eid> (never ?after=) and aborts stream on Burst failure" {
  let rt = effect::Runtime::new()
  let fail_next : Array[Bool] = [false]
  let sim_db = SimAccountDb::new(rt)
  let guarded_sh = shell::Shell::stood_in(
    rt,
    fn(_ : Int64, _ : String, _ : base_codec::Json, _ : Option[Bytes]) -> Unit {},
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      if fail_next[0] && op == "sql.run" {
        return shell::AskResult::Err(shell::ShellError::{ message: "injected burst failure" })
      }
      sim_db.answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(guarded_sh, "acct-sse-since") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  let core = ClientCore::new("ws-1", "st1", rt, db, station.transport(), fn() -> Unit {})
  core.start()
  rt.advance(20)
  // First batch commits -> last_event_id becomes "ev/42"
  station.push_sse(
    "id: ev/42\nevent: thread\ndata: {\"workspace\":\"ws-1\",\"id\":7,\"entries\":[{\"n\":1,\"thread\":7,\"kind\":\"message\",\"authorKind\":\"agent\",\"author\":\"bot\",\"text\":\"ok\",\"at\":1000}]}\n\n",
  )
  match core.events.last_id() {
    Some(eid) => debug_assert(eid == "ev/42", "committed event id must be ev/42")
    None => debug_assert(false, "expected last_event_id ev/42")
  }
  // Inject SQL failure on next batch ("ev/43"), then push a third chunk ("ev/44") on the same dead stream.
  // The stream MUST abort on ev/43, ignore ev/44, keep last_event_id == "ev/42", and reconnect with /events?since=ev%2F42!
  fail_next[0] = true
  station.push_sse(
    "id: ev/43\nevent: thread\ndata: {\"workspace\":\"ws-1\",\"id\":7,\"entries\":[{\"n\":2,\"thread\":7,\"kind\":\"message\",\"authorKind\":\"agent\",\"author\":\"bot\",\"text\":\"fail\",\"at\":1001}]}\n\n",
  )
  fail_next[0] = false
  station.push_sse(
    "id: ev/44\nevent: thread\ndata: {\"workspace\":\"ws-1\",\"id\":7,\"entries\":[{\"n\":3,\"thread\":7,\"kind\":\"message\",\"authorKind\":\"agent\",\"author\":\"bot\",\"text\":\"must-ignore\",\"at\":1002}]}\n\n",
  )
  match core.events.last_id() {
    Some(eid) => debug_assert(eid == "ev/42", "failed batch must abort stream and NOT advance to ev/43 or ev/44")
    None => debug_assert(false, "expected last_event_id ev/42")
  }
  rt.advance(1)
  debug_assert(station.cancel_count == 1, "Burst failure MUST cancel the underlying old stream (cancel_count == 1)")
  // Advance past reconnect backoff (2000ms) -> verify reconnect URL is strictly `/events?since=ev%2F42`
  rt.advance(2200)
  let mut saw_since = false
  let mut saw_after = false
  for i in 0..<station.requests_seen.length() {
    let r = station.requests_seen[i]
    if r == "SSE /events?since=ev%2F42" {
      saw_since = true
    }
    if r.contains("after=") {
      saw_after = true
    }
  }
  debug_assert(saw_since, "reconnect MUST use /events?since=ev%2F42")
  debug_assert(!saw_after, "reconnect MUST NEVER use ?after=")
  // Now drop stream into backoff and call stop() during backoff -> advance 120_000ms -> 0 new SSE connections!
  station.drop_stream()
  rt.advance(100)
  let reqs_at_stop = station.requests_seen.length()
  core.stop()
  rt.advance(120000)
  debug_assert(station.requests_seen.length() == reqs_at_stop, "stop() during backoff MUST produce 0 reconnects over 120s")
}

test "E2E 15: ClientCore wires missed -> fetch_snapshot_k, chat-mark -> viewer_marks/rows_memo, dirty thread -> fetch_thread_k" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-p15") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => {
      debug_assert(false, "sql open failed")
      return
    }
  }
  let station = SimStation::new(rt)
  station.thread_entries.set(
    7,
    base_codec::json_obj([
      (
        "entries",
        base_codec::json_arr([
          base_codec::json_obj([
            ("n", base_codec::json_int(5)),
            ("thread", base_codec::json_int(7)),
            ("kind", base_codec::json_str("message")),
            ("authorKind", base_codec::json_str("agent")),
            ("author", base_codec::json_str("bot")),
            ("text", base_codec::json_str("fetched after dirty")),
            ("at", base_codec::json_int64(5000.to_int64())),
          ]),
        ]),
      ),
    ]),
  )
  let core = ClientCore::new("ws-1", "st1", rt, db, station.transport(), fn() -> Unit {})
  core.set_viewer("alice@still.fail")
  core.start()
  rt.advance(30)
  // 1. Update snapshot on station and push `missed` SSE -> ClientCore MUST run fetch_snapshot_k and persist missed chat!
  station.snapshot_json = base_codec::json_obj([
    (
      "chats",
      base_codec::json_arr([
        base_codec::json_obj([
          ("id", base_codec::json_str("c-missed")),
          ("archived", base_codec::json_int(0)),
          ("ord", base_codec::json_num(1.0)),
          ("thread", base_codec::json_int(7)),
          ("lastActive", base_codec::json_int64(3000.to_int64())),
          ("title", base_codec::json_str("Recovered After Missed")),
        ]),
      ]),
    ),
    ("entries", base_codec::json_arr([])),
  ])
  station.push_sse("id: ev-m1\nevent: missed\ndata: {\"workspace\":\"ws-1\"}\n\n")
  rt.advance(50)
  match store::get_chat_by_key(db, "st1", 0, "c-missed") {
    sql::SqlResult::Ok(Some(rec)) => debug_assert(rec.json.contains("Recovered After Missed"), "missed triggered fetch_snapshot_k and persisted chat")
    _ => debug_assert(false, "expected c-missed persisted after missed SSE")
  }
  // 2. Push `chat-mark` SSE -> updates viewer_marks & invalidates rows_memo!
  station.push_sse("id: ev-m2\nevent: chat-mark\ndata: {\"workspace\":\"ws-1\",\"session\":\"sess-7\",\"thread\":7,\"read\":4,\"pinned\":8888}\n\n")
  match core.viewer_marks.reads.get("st1:7") {
    Some(r) => debug_assert(r == 4, "chat-mark updated viewer_marks.reads")
    None => debug_assert(false, "expected viewer_marks read updated")
  }
  match core.viewer_marks.pins.get("st1:sess-7") {
    Some(p) => debug_assert(p == 8888.to_int64(), "chat-mark updated viewer_marks.pins")
    None => debug_assert(false, "expected viewer_marks pin updated")
  }
  // 3. Push non-append `thread` SSE (gap -> thread_after returns None -> marks thread 7 dirty) -> ClientCore MUST trigger GET /threads/7/entries!
  let reqs_before = station.requests_seen.length()
  station.push_sse("id: ev-m3\nevent: thread\ndata: {\"workspace\":\"ws-1\",\"id\":7,\"entries\":[{\"n\":5,\"thread\":7,\"kind\":\"message\",\"authorKind\":\"agent\",\"author\":\"bot\",\"text\":\"gap\",\"at\":5000}]}\n\n")
  rt.advance(50)
  let mut saw_thread_fetch = false
  for i in reqs_before..<station.requests_seen.length() {
    if station.requests_seen[i] == "GET /threads/7/entries" {
      saw_thread_fetch = true
    }
  }
  debug_assert(saw_thread_fetch, "dirty thread MUST trigger ClientCore fetch_thread_k (GET /threads/7/entries)")
  core.stop()
}

// ── Test 14: Gate #2 (P0-10) — P-256 curve + strict base64url + Genesis Pin + Anti-Rollback + Restart + Fork Switch + Workspace Isolation ──

test "E2E 16: Gate #2 P-256 curve validation and strict unpadded canonical base64url in valid_key_id" {
  // 1. Valid NIST P-256 public key from real scalar -> ACCEPTED
  let sk = match base_codec::hex_decode("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721") {
    Some(b) => b
    None => panic("bad sk")
  }
  let pk = match crypto::p256_public_key(sk) {
    Ok(p) => p
    Err(_) => panic("p256_public_key failed")
  }
  let valid_b64 = base_codec::base64url_encode(pk)
  debug_assert(valid_key_id("p256:" + valid_b64), "valid P-256 point accepted")

  // 2. Off-curve point (y + 1) -> REJECTED
  let off_curve = Bytes::new(65)
  for i in 0..<65 {
    off_curve[i] = pk[i]
  }
  off_curve[64] = ((off_curve[64].to_int() + 1) & 0xFF) as Byte
  debug_assert(!valid_key_id("p256:" + base_codec::base64url_encode(off_curve)), "off-curve P-256 point rejected")

  // 3. Point at infinity (0x04 || 0..0 || 0..0) -> REJECTED
  let zero_pt = Bytes::new(65)
  zero_pt[0] = 4 as Byte
  debug_assert(!valid_key_id("p256:" + base_codec::base64url_encode(zero_pt)), "zero point (0,0) rejected")

  // 4. x >= p (x = p) -> REJECTED
  let p_bytes = match base_codec::hex_decode("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff") {
    Some(b) => b
    None => panic("bad p")
  }
  let x_ge_p = Bytes::new(65)
  x_ge_p[0] = 4 as Byte
  for i in 0..<32 {
    x_ge_p[1 + i] = p_bytes[i]
    x_ge_p[33 + i] = pk[33 + i]
  }
  debug_assert(!valid_key_id("p256:" + base_codec::base64url_encode(x_ge_p)), "x >= p rejected")

  // 5. y >= p (y = p) -> REJECTED
  let y_ge_p = Bytes::new(65)
  y_ge_p[0] = 4 as Byte
  for i in 0..<32 {
    y_ge_p[1 + i] = pk[1 + i]
    y_ge_p[33 + i] = p_bytes[i]
  }
  debug_assert(!valid_key_id("p256:" + base_codec::base64url_encode(y_ge_p)), "y >= p rejected")

  // 6. Padded base64url (`=`) -> REJECTED
  debug_assert(!valid_key_id("p256:" + valid_b64 + "="), "padded base64url rejected")

  // 7. Non-zero unused trailing 2 bits on char 86 -> ACCEPTED (1:1 parity with TS shared/lock.ts + Hermes fromB64url)
  //    while standard base64 `+`/`/` and whitespace -> REJECTED!
  let last_ch = valid_b64.code_unit_at(valid_b64.length() - 1)
  let last_val = b64url_val(last_ch)
  let alt_last_bytes = Bytes::new(1)
  alt_last_bytes[0] = b64url_char(last_val | 1)
  let alt_last_str = bytes_to_str(alt_last_bytes)
  let non_canon_tail = valid_b64.slice(0, valid_b64.length() - 1) + alt_last_str
  debug_assert(valid_key_id("p256:" + non_canon_tail), "unused trailing 2 bits match TS/Hermes fromB64url")
  debug_assert(!valid_key_id("p256:" + valid_b64.slice(0, 10) + "+" + valid_b64.slice(11, valid_b64.length())), "plus rejected")
  debug_assert(!valid_key_id("p256:" + valid_b64.slice(0, 10) + "/" + valid_b64.slice(11, valid_b64.length())), "slash rejected")
  debug_assert(!valid_key_id("p256:" + valid_b64.slice(0, 10) + " " + valid_b64.slice(10, valid_b64.length())), "space rejected")

  // 8. Overlong (> 200 chars) & invalid Ed25519 -> REJECTED
  debug_assert(valid_key_id("ed25519:" + hex_64("a")), "valid ed25519 accepted")
  debug_assert(!valid_key_id("ed25519:" + hex_64("A")), "uppercase ed25519 rejected")
  debug_assert(!valid_key_id("ed25519:abcd"), "short ed25519 rejected")
  let long_id = "p256:" + valid_b64 + hex_64("a") + hex_64("b")
  debug_assert(long_id.length() > 200 && !valid_key_id(long_id), "overlong key id > 200 rejected")
}

fn gate2_seed(tag : Int) -> Bytes {
  let b = Bytes::new(32)
  for i in 0..<32 {
    b[i] = ((tag + i * 7) & 0xFF) as Byte
  }
  b
}

test "E2E 17: Gate #2 lock root pinning, anti-hijack, anti-rollback, SQLite restart persistence, fork switch, and workspace isolation" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-gate2") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => panic("sql open failed")
  }
  let station = SimStation::new(rt)
  let core = ClientCore::new("ws-gate2", "st1", rt, db, station.transport(), fn() -> Unit {})

  let alice_seed = gate2_seed(21)
  let bob_seed = gate2_seed(22)
  let evil_seed = gate2_seed(23)
  let alice_key = ed25519_key_id(alice_seed)
  let bob_key = ed25519_key_id(bob_seed)
  let evil_key = ed25519_key_id(evil_seed)
  let alice_dev = hex_64("1")
  let bob_dev = hex_64("2")
  let evil_dev = hex_64("9")

  // Genesis G (Alice owner, Bob admin)
  let g_raw = form::Json::Obj([
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws-gate2")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1790000000.0)),
    ("kind", form::Json::Str("genesis")),
    (
      "body",
      form::Json::Obj([
        ("owner", form::Json::Str("alice")),
        ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
        ("rp_id", form::Json::Str("still.fail")),
        ("cloud_keys", form::Json::Obj([("keys", form::Json::Arr([]))])),
        (
          "members",
          form::Json::Arr([
            form::Json::Obj([("sub", form::Json::Str("alice")), ("email", form::Json::Str("alice@example.com")), ("role", form::Json::Str("owner"))]),
            form::Json::Obj([("sub", form::Json::Str("bob")), ("email", form::Json::Str("bob@example.com")), ("role", form::Json::Str("admin"))]),
          ]),
        ),
        (
          "devices",
          form::Json::Arr([
            form::Json::Obj([("id", form::Json::Str(alice_dev)), ("sub", form::Json::Str("alice")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Alice Mac")), ("sign_key", form::Json::Str(alice_key))]),
            form::Json::Obj([("id", form::Json::Str(bob_dev)), ("sub", form::Json::Str("bob")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Bob Mac")), ("sign_key", form::Json::Str(bob_key))]),
          ]),
        ),
        ("passkeys", form::Json::Arr([])),
        ("stations", form::Json::Arr([])),
        ("gateways", form::Json::Arr([])),
      ]),
    ),
  ])
  let e0 = match sign_lock_entry(alice_seed, g_raw) { Ok(e) => e; Err(m) => panic(m) }
  let c = native_lock_crypto()
  let root_g = match lock::entry_hash(e0, c) { Ok(h) => h; Err(_) => panic("hash e0") }

  // e1 (seq=1): Bob (admin, weight=2) adds Carol
  let e1 = match sign_lock_entry(
    bob_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-gate2")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_g)),
      ("at", form::Json::Num(1790000010.0)),
      ("kind", form::Json::Str("member")),
      ("body", form::Json::Obj([("sub", form::Json::Str("carol")), ("email", form::Json::Str("carol@example.com")), ("role", form::Json::Str("member"))])),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }
  let h1 = match lock::entry_hash(e1, c) { Ok(h) => h; Err(_) => panic("hash e1") }

  // e2 (seq=2): Bob adds Erin
  let e2 = match sign_lock_entry(
    bob_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-gate2")),
      ("seq", form::Json::Num(2.0)),
      ("prev", form::Json::Str(h1)),
      ("at", form::Json::Num(1790000020.0)),
      ("kind", form::Json::Str("member")),
      ("body", form::Json::Obj([("sub", form::Json::Str("erin")), ("email", form::Json::Str("erin@example.com")), ("role", form::Json::Str("member"))])),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }
  let h2 = match lock::entry_hash(e2, c) { Ok(h) => h; Err(_) => panic("hash e2") }

  // Pin G and apply [e0, e1, e2]
  core.pin_lock_root(root_g)
  match core.apply_lock_chain([e0, e1, e2], root_g) {
    Ok(v) => debug_assert(v.state.seq == 2.0 && v.state.head == h2, "initial chain at seq=2")
    Err(m) => panic("initial apply failed: " + m)
  }
  let _ = core.drain_frame()

  // Attack 1: Evil station sends a completely self-consistent, validly signed chain under G_evil != G
  let g_evil_raw = form::Json::Obj([
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws-gate2")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1790000001.0)),
    ("kind", form::Json::Str("genesis")),
    (
      "body",
      form::Json::Obj([
        ("owner", form::Json::Str("evil")),
        ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
        ("rp_id", form::Json::Str("still.fail")),
        ("cloud_keys", form::Json::Obj([("keys", form::Json::Arr([]))])),
        ("members", form::Json::Arr([form::Json::Obj([("sub", form::Json::Str("evil")), ("email", form::Json::Str("evil@evil.test")), ("role", form::Json::Str("owner"))])])),
        ("devices", form::Json::Arr([form::Json::Obj([("id", form::Json::Str(evil_dev)), ("sub", form::Json::Str("evil")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Evil")), ("sign_key", form::Json::Str(evil_key))])])),
        ("passkeys", form::Json::Arr([])),
        ("stations", form::Json::Arr([])),
        ("gateways", form::Json::Arr([])),
      ]),
    ),
  ])
  let e0_evil = match sign_lock_entry(evil_seed, g_evil_raw) { Ok(e) => e; Err(m) => panic(m) }
  let root_evil = match lock::entry_hash(e0_evil, c) { Ok(h) => h; Err(_) => panic("hash evil") }
  debug_assert(root_evil != root_g, "evil root differs from pinned G")

  match core.apply_lock_chain([e0_evil], root_evil) {
    Ok(_) => debug_assert(false, "hijack chain with G_evil MUST be rejected")
    Err(_) => ()
  }
  let evs1 = core.drain_frame()
  let mut saw_rej1 = false
  for i in 0..<evs1.length() {
    match evs1[i] {
      CoreEvent::LockRejected(ws, _) => if ws == "ws-gate2" { saw_rej1 = true }
      _ => ()
    }
  }
  debug_assert(saw_rej1, "LockRejected emitted on G_evil hijack")
  match core.current_lock() {
    Some(st) => debug_assert(st.genesis == root_g && st.seq == 2.0 && st.head == h2, "state untouched after hijack")
    None => debug_assert(false, "lock state missing")
  }

  // Attack 1b (spoofed root): Attacker claims `root = G` but sends a LONGER validly self-signed foreign chain
  // `[e0_evil, e1_evil, e2_evil, e3_evil]` -> MUST return Err, emit LockRejected, NEVER emit LockUpdated, and keep G/seq=2!
  let e1_evil = match sign_lock_entry(
    evil_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-gate2")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_evil)),
      ("at", form::Json::Num(1790000006.0)),
      ("kind", form::Json::Str("member")),
      ("body", form::Json::Obj([("sub", form::Json::Str("evil1")), ("email", form::Json::Str("e1@evil.test")), ("role", form::Json::Str("member"))])),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }
  let h1_evil = match lock::entry_hash(e1_evil, c) { Ok(h) => h; Err(_) => panic("hash e1_evil") }
  let e2_evil = match sign_lock_entry(
    evil_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-gate2")),
      ("seq", form::Json::Num(2.0)),
      ("prev", form::Json::Str(h1_evil)),
      ("at", form::Json::Num(1790000007.0)),
      ("kind", form::Json::Str("member")),
      ("body", form::Json::Obj([("sub", form::Json::Str("evil2")), ("email", form::Json::Str("e2@evil.test")), ("role", form::Json::Str("member"))])),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }
  let h2_evil = match lock::entry_hash(e2_evil, c) { Ok(h) => h; Err(_) => panic("hash e2_evil") }
  let e3_evil = match sign_lock_entry(
    evil_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-gate2")),
      ("seq", form::Json::Num(3.0)),
      ("prev", form::Json::Str(h2_evil)),
      ("at", form::Json::Num(1790000008.0)),
      ("kind", form::Json::Str("member")),
      ("body", form::Json::Obj([("sub", form::Json::Str("evil3")), ("email", form::Json::Str("e3@evil.test")), ("role", form::Json::Str("member"))])),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }

  match core.apply_lock_chain([e0_evil, e1_evil, e2_evil, e3_evil], root_g) {
    Ok(_) => debug_assert(false, "spoofed root G with foreign chain MUST be rejected")
    Err(_) => ()
  }
  let evs1b = core.drain_frame()
  let mut saw_rej1b = false
  let mut saw_upd1b = false
  for i in 0..<evs1b.length() {
    match evs1b[i] {
      CoreEvent::LockRejected(ws, _) => if ws == "ws-gate2" { saw_rej1b = true }
      CoreEvent::LockUpdated(_, _, _, _) => { saw_upd1b = true }
      _ => ()
    }
  }
  debug_assert(saw_rej1b && !saw_upd1b, "spoofed root foreign chain must emit LockRejected and NEVER LockUpdated")
  match core.current_lock() {
    Some(st) => debug_assert(st.genesis == root_g && st.seq == 2.0 && st.head == h2, "state untouched after spoofed-root foreign chain")
    None => debug_assert(false, "lock state missing")
  }

  // Attack 2: Malicious station replays old prefix [e0] -> MUST NOT rollback!
  match core.apply_lock_chain([e0], root_g) {
    Ok(_) => debug_assert(false, "prefix rollback [e0] MUST be rejected")
    Err(_) => ()
  }
  let evs2 = core.drain_frame()
  let mut saw_rej2 = false
  for i in 0..<evs2.length() {
    match evs2[i] {
      CoreEvent::LockRejected(ws, _) => if ws == "ws-gate2" { saw_rej2 = true }
      _ => ()
    }
  }
  debug_assert(saw_rej2, "LockRejected emitted on prefix rollback")
  match core.current_lock() {
    Some(st) => debug_assert(st.seq == 2.0 && st.head == h2, "high-water seq=2 head=h2 preserved")
    None => debug_assert(false, "lock state missing")
  }

  // Attack 2b (P2): Re-delivering the current high-water head alone `[e2]` MUST NOT emit LockRejected or LockUpdated!
  match core.apply_lock_chain([e2], root_g) {
    Ok(v) => debug_assert(v.state.seq == 2.0 && v.state.head == h2, "duplicate head [e2] returns Ok at seq=2")
    Err(m) => debug_assert(false, "duplicate head [e2] must not fail: " + m)
  }
  let evs2b = core.drain_frame()
  debug_assert(evs2b.length() == 0, "duplicate head [e2] emits neither LockRejected nor LockUpdated")

  // Attack 3: Restart ClientCore on the SAME SQLite DB -> pinned G MUST survive restart, G_evil still rejected!
  let core2 = ClientCore::new("ws-gate2", "st1", rt, db, station.transport(), fn() -> Unit {})
  match core2.pinned_lock_root() {
    Some(r) => debug_assert(r == root_g, "pinned G restored from SQLite across restart")
    None => debug_assert(false, "expected pinned G restored from SQLite")
  }
  match core2.current_lock() {
    Some(st) => debug_assert(st.genesis == root_g && st.seq == 2.0 && st.head == h2, "lock state restored across restart")
    None => debug_assert(false, "expected lock state restored from SQLite")
  }
  match core2.apply_lock_chain([e0_evil], root_evil) {
    Ok(_) => debug_assert(false, "G_evil MUST still be rejected after restart")
    Err(_) => ()
  }

  // Legitimate higher-weight competing fork under same genesis G: Alice (owner, weight=3) at seq=1 beats Bob (admin, weight=2)
  let e1_alice = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-gate2")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_g)),
      ("at", form::Json::Num(1790000030.0)),
      ("kind", form::Json::Str("member")),
      ("body", form::Json::Obj([("sub", form::Json::Str("dave")), ("email", form::Json::Str("dave@example.com")), ("role", form::Json::Str("member"))])),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }
  let h1_alice = match lock::entry_hash(e1_alice, c) { Ok(h) => h; Err(_) => panic("hash e1_alice") }

  match core2.apply_lock_chain([e1_alice], root_g) {
    Ok(v) => {
      debug_assert(v.state.head == h1_alice && v.state.members.contains("dave"), "switched to Alice owner fork")
      debug_assert(!v.state.members.contains("carol"), "Bob losing fork carol no longer active")
    }
    Err(m) => panic("legitimate fork switch failed: " + m)
  }
  // Bob's displaced branch [e1, e2] must be retained in lock_kept_aside (<= 256)
  debug_assert(core2.lock_kept_aside().length() == 2, "displaced branch [e1, e2] retained in lock_kept_aside")

  // Workspace isolation (Gate #9): querying lock.status or lock topic for another workspace leaks nothing!
  let other_status = core2.lock_status_json(workspace=Some("ws-other"))
  debug_assert(j_str(other_status, "workspace") == "ws-other" && !j_bool(other_status, "locked") && base_codec::json_get(other_status, "genesis").is_none(), "cross-workspace lock_status_json leaks nothing")
  let wire_other = core2.handle_wire("{\"id\":77,\"call\":\"lock.status\",\"params\":{\"workspace\":\"ws-other\"}}")
  match wire_other {
    Some((txt, _)) => debug_assert(txt.contains("\"locked\":false") && !txt.contains(root_g), "wire lock.status isolates workspaces")
    None => debug_assert(false, "expected wire response")
  }
  let sub_other = core2.handle_wire("{\"id\":78,\"subscribe\":{\"topic\":\"lock\",\"workspace\":\"ws-other\"}}")
  match sub_other {
    Some((txt, _)) => debug_assert(txt.contains("\"value\"") && !txt.contains("\"error\"") && !txt.contains("alice") && !txt.contains("dave") && !txt.contains(root_g), "lock topic isolates workspaces")
    None => debug_assert(false, "expected sub response")
  }

  // Corrupt persisted workspace_pref(ws, "lock") MUST NOT degrade to TOFU!
  let _ = store::put_workspace_pref(db, "ws-corrupt", "lock", "{corrupt json")
  let core_corrupt = ClientCore::new("ws-corrupt", "st1", rt, db, station.transport(), fn() -> Unit {})
  debug_assert(core_corrupt.is_lock_corrupt(), "corrupt persisted lock flagged")
  match core_corrupt.apply_lock_chain([e0_evil], root_evil) {
    Ok(_) => debug_assert(false, "corrupt lock core MUST reject TOFU chain")
    Err(_) => ()
  }
}

test "E2E 18: P1 Cloud station roster bootstrap from workspace.json, overview merge, and zero cross-workspace leakage" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-p1-stations") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => panic("sql open failed")
  }
  let station = SimStation::new(rt)
  let core = ClientCore::new("ws-a", "ws-a/st-self", rt, db, station.transport(), fn() -> Unit {})

  // 1. Fresh device: ONLY `workspace` table has Cloud stations (`station` table completely empty!)
  let ws_json = "{\"id\":\"ws-a\",\"name\":\"Alpha\",\"rev\":1,\"members\":[],\"stations\":[{\"id\":\"st-1\",\"name\":\"Tokyo\",\"online\":true,\"emoji\":\"🗼\",\"icon\":\"mac\"},{\"id\":\"st-2\",\"name\":\"Shanghai\",\"online\":false,\"emoji\":\"🏙️\"}]}"
  let _ = store::upsert_workspace(db, "ws-a", ws_json, confirmed=Some(1000.to_int64()))
  let briefs1 = core.station_briefs_for_scope("ws-a")
  let mut found_st1 = false
  let mut found_st2 = false
  for i in 0..<briefs1.length() {
    if briefs1[i].address == "ws-a/st-1" && briefs1[i].name == "Tokyo" {
      found_st1 = true
    }
    if briefs1[i].address == "ws-a/st-2" && briefs1[i].name == "Shanghai" && !briefs1[i].online {
      found_st2 = true
    }
  }
  debug_assert(found_st1 && found_st2, "fresh device bootstraps stations from workspace.json even when station table is empty")

  // 2. When live `station(addr, "overview")` exists for st-1, live fields overlay Cloud metadata cleanly
  let ov_json = "{\"id\":\"st-1\",\"name\":\"Tokyo Live\",\"online\":true,\"updating\":true,\"offlineText\":\"updating\"}"
  let _ = store::upsert_station_doc(db, "ws-a/st-1", "overview", ov_json, confirmed=Some(2000.to_int64()))
  let briefs2 = core.station_briefs_for_scope("ws-a")
  let mut merged_ok = false
  for i in 0..<briefs2.length() {
    if briefs2[i].address == "ws-a/st-1" && briefs2[i].name == "Tokyo Live" && briefs2[i].updating {
      merged_ok = true
    }
  }
  debug_assert(merged_ok, "live overview fields overlay Cloud station metadata")

  // 3. Querying ANOTHER workspace `ws-other` MUST NEVER leak `self.station` (`ws-a/st-self`) or `ws-a` stations!
  let briefs_other = core.station_briefs_for_scope("ws-other")
  debug_assert(briefs_other.length() == 0, "other workspace with no stations returns empty list (zero self.station leakage)")
}

test "E2E 19: W27c GET /lock + SSE event: lock end-to-end persistence and G_evil rejection" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-w27c-lock") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => panic("sql open failed")
  }
  let station = SimStation::new(rt)
  let alice_seed = make_seed(41)
  let evil_seed = make_seed(42)
  let alice_key = ed25519_key_id(alice_seed)
  let evil_key = ed25519_key_id(evil_seed)
  let c = native_lock_crypto()

  let e0 = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-lock-e2e")),
      ("seq", form::Json::Num(0.0)),
      ("prev", form::Json::Null),
      ("at", form::Json::Num(1790001000.0)),
      ("kind", form::Json::Str("genesis")),
      (
        "body",
        form::Json::Obj([
          ("owner", form::Json::Str("alice")),
          ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
          ("rp_id", form::Json::Str("still.fail")),
          ("cloud_keys", form::Json::Obj([("keys", form::Json::Arr([]))])),
          ("members", form::Json::Arr([form::Json::Obj([("sub", form::Json::Str("alice")), ("email", form::Json::Str("alice@example.com")), ("role", form::Json::Str("owner"))])])),
          ("devices", form::Json::Arr([form::Json::Obj([("id", form::Json::Str("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")), ("sub", form::Json::Str("alice")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Alice")), ("sign_key", form::Json::Str(alice_key))])])),
          ("passkeys", form::Json::Arr([])),
          ("stations", form::Json::Arr([])),
          ("gateways", form::Json::Arr([])),
        ]),
      ),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }
  let root_g = match lock::entry_hash(e0, c) { Ok(h) => h; Err(_) => panic("hash e0") }

  let e1 = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-lock-e2e")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_g)),
      ("at", form::Json::Num(1790001010.0)),
      ("kind", form::Json::Str("member")),
      ("body", form::Json::Obj([("sub", form::Json::Str("bob")), ("email", form::Json::Str("bob@example.com")), ("role", form::Json::Str("admin"))])),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }
  let h1 = match lock::entry_hash(e1, c) { Ok(h) => h; Err(_) => panic("hash e1") }

  let e0_evil = match sign_lock_entry(
    evil_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-lock-e2e")),
      ("seq", form::Json::Num(0.0)),
      ("prev", form::Json::Null),
      ("at", form::Json::Num(1790001001.0)),
      ("kind", form::Json::Str("genesis")),
      (
        "body",
        form::Json::Obj([
          ("owner", form::Json::Str("evil")),
          ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
          ("rp_id", form::Json::Str("still.fail")),
          ("cloud_keys", form::Json::Obj([("keys", form::Json::Arr([]))])),
          ("members", form::Json::Arr([form::Json::Obj([("sub", form::Json::Str("evil")), ("email", form::Json::Str("evil@evil.test")), ("role", form::Json::Str("owner"))])])),
          ("devices", form::Json::Arr([form::Json::Obj([("id", form::Json::Str("eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee")), ("sub", form::Json::Str("evil")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Evil")), ("sign_key", form::Json::Str(evil_key))])])),
          ("passkeys", form::Json::Arr([])),
          ("stations", form::Json::Arr([])),
          ("gateways", form::Json::Arr([])),
        ]),
      ),
    ]),
  ) { Ok(e) => e; Err(m) => panic(m) }
  let root_evil = match lock::entry_hash(e0_evil, c) { Ok(h) => h; Err(_) => panic("hash evil") }

  // 1. Station serves valid lock on GET /lock -> ClientCore::start triggers on_connected -> fetch_lock_k!
  station.lock_json = Some(base_codec::json_obj([
    ("head", base_codec::json_obj([("seq", base_codec::json_int(0)), ("hash", base_codec::json_str(root_g)), ("genesis", base_codec::json_str(root_g))])),
    ("entries", base_codec::json_arr([form_to_codec(e0)])),
  ]))
  let core = ClientCore::new("ws-lock-e2e", "st1", rt, db, station.transport(), fn() -> Unit {})
  core.start()
  let _ = rt.run_ready()
  station.push_sse(": hello\n\n")
  let _ = rt.run_ready()
  rt.advance(50)
  let _ = rt.run_ready()

  // Verify GET /lock was fetched, lock pinned to root_g, and persisted to workspace_pref(ws, "lock")
  let mut saw_get_lock = false
  for i in 0..<station.requests_seen.length() {
    if station.requests_seen[i] == "GET /lock" {
      saw_get_lock = true
    }
  }
  debug_assert(saw_get_lock, "on_connected issued GET /lock")
  match core.pinned_lock_root() {
    Some(r) => debug_assert(r == root_g, "GET /lock pinned genesis root_g")
    None => debug_assert(false, "expected pinned lock root")
  }
  debug_assert(sim_db.prefs.get("ws-lock-e2e:lock").is_some(), "valid lock persisted to workspace_pref(ws, \"lock\")")
  let _ = core.drain_frame()

  // 2. Station pushes valid seq=1 entry via SSE `event: lock` -> updates lock chain & workspace_pref!
  let valid_sse_data = base_codec::json_stringify(base_codec::json_obj([
    ("head", base_codec::json_obj([("seq", base_codec::json_int(1)), ("hash", base_codec::json_str(h1)), ("genesis", base_codec::json_str(root_g))])),
    ("entries", base_codec::json_arr([form_to_codec(e0), form_to_codec(e1)])),
  ]))
  station.push_sse("id: lock-1\nevent: lock\ndata: " + valid_sse_data + "\n\n")
  let _ = rt.run_ready()
  match core.current_lock() {
    Some(st) => debug_assert(st.seq == 1.0 && st.head == h1 && st.members.contains("bob"), "SSE event: lock applied seq=1")
    None => debug_assert(false, "expected updated lock state")
  }
  let _ = core.drain_frame()

  // 3. Malicious station pushes validly-signed G_evil chain via SSE `event: lock` -> MUST reject & emit LockRejected!
  let evil_sse_data = base_codec::json_stringify(base_codec::json_obj([
    ("head", base_codec::json_obj([("seq", base_codec::json_int(0)), ("hash", base_codec::json_str(root_evil)), ("genesis", base_codec::json_str(root_evil))])),
    ("entries", base_codec::json_arr([form_to_codec(e0_evil)])),
  ]))
  station.push_sse("id: lock-evil\nevent: lock\ndata: " + evil_sse_data + "\n\n")
  let _ = rt.run_ready()
  let evs = core.drain_frame()
  let mut saw_rejected = false
  for i in 0..<evs.length() {
    match evs[i] {
      CoreEvent::LockRejected(ws, _) => if ws == "ws-lock-e2e" { saw_rejected = true }
      _ => ()
    }
  }
  debug_assert(saw_rejected, "malicious G_evil via SSE event: lock MUST emit LockRejected")
  match core.current_lock() {
    Some(st) => debug_assert(st.genesis == root_g && st.seq == 1.0 && st.head == h1, "pinned lock untouched after G_evil SSE attack")
    None => debug_assert(false, "lock state missing")
  }
  core.stop()
  let _ = rt.run_ready()
}

test "E2E 20: W25b GET /chats?marks=1&own=1 re-read, targeted invalidation without wiping RowsMemo, and missed resync" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-w25b-marks") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => panic("sql open failed")
  }
  let station = SimStation::new(rt)
  let core = ClientCore::new("ws-marks", "st1", rt, db, station.transport(), fn() -> Unit {})
  core.set_viewer("alice@still.fail")

  // Pre-seed two chats and warm up RowsMemo by subscribing to `chats`
  let _ = core.events.apply_snapshot(base_codec::json_obj([
    ("chats", base_codec::json_arr([
      base_codec::json_obj([("id", base_codec::json_str("c-1")), ("session", base_codec::json_str("c-1")), ("thread", base_codec::json_int(11)), ("title", base_codec::json_str("Chat 1")), ("lastActiveAt", base_codec::json_int64(2000.to_int64()))]),
      base_codec::json_obj([("id", base_codec::json_str("c-2")), ("session", base_codec::json_str("c-2")), ("thread", base_codec::json_int(12)), ("title", base_codec::json_str("Chat 2")), ("lastActiveAt", base_codec::json_int64(1000.to_int64()))]),
    ])),
  ]))
  let _ = core.handle_wire("{\"id\":1,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-marks\"},\"keyed\":true}")
  debug_assert(core.rows_memo.cached_count() == 2, "RowsMemo warmed with 2 chats")

  // Configure Station's GET /chats?marks=1&own=1 response
  station.marks_json = base_codec::json_obj([
    ("reads", base_codec::json_obj([("11", base_codec::json_int(7))])),
    ("pins", base_codec::json_obj([("c-1", base_codec::json_int64(9999.to_int64()))])),
    ("kept", base_codec::json_arr([base_codec::json_int(11)])),
    ("hidden", base_codec::json_arr([base_codec::json_int(12)])),
    ("muted", base_codec::json_arr([base_codec::json_int(12)])),
    ("dismissed", base_codec::json_arr([base_codec::json_str("11:3")])),
    ("selves", base_codec::json_arr([base_codec::json_str("U12345")])),
  ])

  core.start()
  let _ = rt.run_ready()
  station.push_sse(": ok\n\n")
  let _ = rt.run_ready()
  rt.advance(30)
  let _ = rt.run_ready()

  // Push `event: chat-mark` -> triggers scoped GET /chats?marks=1&own=1 without wiping RowsMemo!
  station.push_sse("id: mk-1\nevent: chat-mark\ndata: {\"session\":\"c-1\",\"thread\":11,\"read\":7}\n\n")
  let _ = rt.run_ready()
  rt.advance(30)
  let _ = rt.run_ready()

  // RowsMemo must NOT have been wiped!
  debug_assert(core.rows_memo.cached_count() == 2, "marks_dirty must NOT wipe RowsMemo")
  // Verify GET /chats?marks=1&own=1 was called and SQLite shared_mark + viewer_marks updated
  let mut saw_scoped_marks = false
  for i in 0..<station.requests_seen.length() {
    if station.requests_seen[i].starts_with("GET /chats?marks=1&own=1&session=c-1&thread=11") {
      saw_scoped_marks = true
    }
  }
  debug_assert(saw_scoped_marks, "marks_dirty triggered real scoped GET /chats?marks=1&own=1")
  match sim_db.shared_marks.get("st1:read:11") { Some(v) => debug_assert(v == "7", "shared_mark read persisted"); None => debug_assert(false, "missing read mark") }
  match sim_db.shared_marks.get("st1:pin:c-1") { Some(v) => debug_assert(v == "9999", "shared_mark pin persisted"); None => debug_assert(false, "missing pin mark") }
  match sim_db.shared_marks.get("st1:kept:11") { Some(v) => debug_assert(v == "1", "shared_mark kept persisted"); None => debug_assert(false, "missing kept mark") }
  match sim_db.shared_marks.get("st1:hidden:12") { Some(v) => debug_assert(v == "1", "shared_mark hidden persisted"); None => debug_assert(false, "missing hidden mark") }
  match sim_db.shared_marks.get("st1:muted:12") { Some(v) => debug_assert(v == "1", "shared_mark muted persisted"); None => debug_assert(false, "missing muted mark") }
  match sim_db.shared_marks.get("st1:dismissed:11:3") { Some(v) => debug_assert(v == "1", "shared_mark dismissed persisted"); None => debug_assert(false, "missing dismissed mark") }
  match core.viewer_marks.reads.get("st1:11") { Some(v) => debug_assert(v == 7, "viewer_marks.reads synced"); None => debug_assert(false, "missing viewer read") }
  match core.viewer_marks.pins.get("st1:c-1") { Some(v) => debug_assert(v == 9999.to_int64(), "viewer_marks.pins synced"); None => debug_assert(false, "missing viewer pin") }

  // Push `event: missed` -> triggers snapshot + whole marks + lock!
  let reqs_before_missed = station.requests_seen.length()
  station.push_sse("id: ms-1\nevent: missed\ndata: {}\n\n")
  let _ = rt.run_ready()
  rt.advance(30)
  let _ = rt.run_ready()
  let mut saw_snap = false
  let mut saw_marks = false
  let mut saw_lock = false
  for i in reqs_before_missed..<station.requests_seen.length() {
    let r = station.requests_seen[i]
    if r == "GET /chats" { saw_snap = true }
    if r == "GET /chats?marks=1&own=1" { saw_marks = true }
    if r == "GET /lock" { saw_lock = true }
  }
  debug_assert(saw_snap && saw_marks && saw_lock, "missed hook schedules fetch_snapshot_k + fetch_marks_k + fetch_lock_k")
  core.stop()
  let _ = rt.run_ready()
}

test "E2E 21: W25b multi-station attach_station_transport auto-flush and clear recovery hints" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-w25b-multi") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => panic("sql open failed")
  }
  let st1 = SimStation::new(rt)
  let st2 = SimStation::new(rt)
  let core = ClientCore::new("ws-multi", "st1", rt, db, st1.transport(), fn() -> Unit {})
  core.set_online(true)

  // 1. Send message targeting unattached station `st2` -> marked unreached with clear user-actionable hint
  let _ = core.local_outbox.send_message(rt, 99, "ck-st2-1", "alice", "hello st2", 1000.to_int64(), station=Some("st2"))
  let _ = rt.run_ready()
  let evs1 = core.drain_frame()
  let mut saw_unreg_hint = false
  for i in 0..<evs1.length() {
    match evs1[i] {
      CoreEvent::OverlayRolledBack(st, _, _, code, recovery) => {
        if st == "st2" && code == "station_unregistered" && recovery.contains("st2") && recovery.contains("reconnect") {
          saw_unreg_hint = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_unreg_hint, "station_unregistered emits clear user-actionable recovery hint")
  debug_assert(core.local_outbox.has_unreached_for_station("st2"), "st2 has unreached backlog")
  debug_assert(st1.requests_seen.length() == 0, "st2 message MUST NOT leak to st1")

  // 2. Attach `st2` transport -> automatically flushes backlog to `st2`!
  core.attach_station_transport("st2", st2.transport())
  let _ = rt.run_ready()
  rt.advance(30)
  let _ = rt.run_ready()
  debug_assert(st2.requests_seen.length() == 1 && st2.requests_seen[0] == "POST /threads/99/messages", "attach_station_transport auto-flushed backlog to st2")
  debug_assert(!core.local_outbox.has_unreached_for_station("st2"), "st2 backlog cleared after flush")

  // 3. Detach `st2` transport -> subsequent send to `st2` queues as station_unregistered again
  core.detach_station_transport("st2")
  let _ = core.local_outbox.send_message(rt, 99, "ck-st2-2", "alice", "after detach", 2000.to_int64(), station=Some("st2"))
  let _ = rt.run_ready()
  debug_assert(core.local_outbox.has_unreached_for_station("st2"), "detached station queues as unreached")
}

test "E2E 22: P0 guardrails reject OpTarget::Cloud and GET read ops without touching station or changing table" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-p0-guards") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(_) => panic("sql open failed")
  }
  let st1 = SimStation::new(rt)
  let core = ClientCore::new("ws-guard", "st1", rt, db, st1.transport(), fn() -> Unit {})
  core.set_online(true)

  // 1. Cloud op `workspace.create` MUST be rejected by both perform_op and handle_wire
  match core.perform_op("workspace.create", base_codec::json_obj([("account", base_codec::json_str("acc-1")), ("name", base_codec::json_str("Team"))])) {
    Ok(_) => debug_assert(false, "workspace.create must not succeed via perform_op")
    Err(msg) => debug_assert(msg.contains("cloud_op_requires_cloud_transport"), "cloud error message")
  }
  match core.handle_wire("{\"id\":201,\"call\":\"workspace.create\",\"params\":{\"account\":\"acc-1\",\"name\":\"Team\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("cloud_transport_required"), "handle_wire rejects Cloud op with cloud_transport_required")
    None => debug_assert(false, "expected error event for workspace.create")
  }

  // 2. Read-only GET ops `file.peek` & `memory.get` MUST NOT be written to `changing` or sent as mutations
  match core.perform_op("file.peek", base_codec::json_obj([("key", base_codec::json_str("s-1")), ("path", base_codec::json_str("README.md"))])) {
    Ok(_) => debug_assert(false, "file.peek must not queue in LocalOutbox")
    Err(msg) => debug_assert(msg.contains("read_op_not_mutation"), "file.peek read_op_not_mutation")
  }
  match core.handle_wire("{\"id\":202,\"call\":\"file.peek\",\"params\":{\"key\":\"s-1\",\"path\":\"README.md\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("read_op_not_mutation"), "handle_wire rejects file.peek")
    None => debug_assert(false, "expected error event for file.peek")
  }
  match core.handle_wire("{\"id\":203,\"call\":\"memory.get\",\"params\":{}}") {
    Some((txt, _)) => debug_assert(txt.contains("read_op_not_mutation"), "handle_wire rejects memory.get")
    None => debug_assert(false, "expected error event for memory.get")
  }
  let _ = rt.run_ready()
  debug_assert(st1.requests_seen.length() == 0, "0 requests sent to st1 for Cloud/GET ops")
  debug_assert(core.local_outbox.pending_overlay_count() == 0, "0 overlays in LocalOutbox")
  debug_assert(sim_db.changing_rows.keys().length() == 0, "0 rows written to changing table")
}
