// Focused unit & integration tests for Slice 2A:
// 1. First-class immutable `AuthCapability` / `WorkspaceCapability` / `VaultCapability` /
//    `CompositeCapability` + `AuthGenTracker` (unique `owner_id`, monotonic `conn_seq`,
//    single-vault isolation, `lock_vault`/`unlock_vault`, `on_boundary`/`off_boundary`,
//    `AuthBoundaryEvent::Global`, topic-policy 1:1 parity).
// 2. Unified outbound `WireOutGen` envelope (`conn`, `authGen`, `vaultGen`) across `Value` /
//    `Delta` / `Same` / `Unsubscribed` / `Waiting` / recognizable subscribe `Err` frames,
//    `{"id":0,"auth":...}` handshake, `on_boundary` clearing `Slice1Router.kept` and re-anchoring
//    active subs without freezing, host `wire_sink` keeping `pending_wire_events == 0`, and
//    headless bounded `pending_wire_events <= 256` never evicting latest `{id:0,auth}`.
// 3. Full-set `canonical_lock_digest` (cold-start seed without spurious bump, startup DB seed
//    without bump, station-only change bumps `authGen` only, security-boundary changes including
//    `devices`/`endpoints`/`sign_keys`/`gateways`/`cloud_keys` bump `authGen` + `vaultGen`,
//    and newcomer absent from `lock.members` never triggers revocation).
// 4. Single fail-open `guarded_read_k` (bounded retry up to 2 on `auth_stale`, convergence with
//    fresh capability, `on_exhausted_stale` reschedule without freezing sync, wired into
//    `SyncScheduler` including idle prefetch while `fetch_lock_k` stays ungated by `authGen`,
//    and `StationEvents` `stream_epoch` gating).

import "base_codec"
import "effect"
import "form"
import "lock"
import "protocol"
import "shell"
import "sql"
import "store"

struct CapSimEnv {
  rt : effect::Runtime
  sim_db : SimAccountDb
  sh : shell::Shell
  db : sql::Sql
}

fn CapSimEnv::new() -> CapSimEnv {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let sh = shell::Shell::stood_in(
    rt,
    fn(_id : Int64, _op : String, _args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {},
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      sim_db.answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "acct-auth-cap") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("sql open failed: " + e.to_string())
  }
  CapSimEnv::{ rt: rt, sim_db: sim_db, sh: sh, db: db }
}

fn cap_json_int_eq(raw : String, key : String, want : Int) -> Bool {
  match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) =>
    match base_codec::json_get(j, key) {
      Some(base_codec::Json::Num(n, _)) => n.to_int() == want
      _ => false
    }
    _ => false
  }
}

fn cap_json_has_field(raw : String, key : String) -> Bool {
  match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) => base_codec::json_get(j, key).is_some()
    _ => false
  }
}

test "auth_cap 1: immutable AuthCapability cross-tracker fail-closed, persisted/device connSeq monotonicity, single-vault isolation, and topic-policy 1:1" {
  let env = CapSimEnv::new()

  // 1a. Persistent monotonic `connSeq` in SQLite `account_doc("conn_seq")`: 1 -> 2 -> 3 across restarts
  let t1 = AuthGenTracker::open_with_db(env.db)
  debug_assert(t1.conn_seq == 1L, "first open starts at connSeq = 1")
  let t2 = AuthGenTracker::open_with_db(env.db)
  debug_assert(t2.conn_seq == 2L, "second open increments connSeq to 2")
  let t3 = AuthGenTracker::open_with_db(env.db)
  debug_assert(t3.conn_seq == 3L, "third open increments connSeq to 3")
  debug_assert(t1.owner_id != t2.owner_id && t2.owner_id != t3.owner_id, "every tracker has a unique owner_id")

  // 1b. Device-level `connSeq`: strictly monotonic across same-ms calls and read-only storage fallback
  let persisted = [0L]
  let d1 = AuthGenTracker::open_with_device(
    fn() -> Int64 { persisted[0] },
    fn(v : Int64) -> Unit { persisted[0] = v },
    now_ms=1700000001000L,
  )
  let d2 = AuthGenTracker::open_with_device(
    fn() -> Int64 { persisted[0] },
    fn(v : Int64) -> Unit { persisted[0] = v },
    now_ms=1700000001000L,
    floor=d1.conn_seq,
  )
  let d3 = AuthGenTracker::open_with_device(
    fn() -> Int64 { 0L },
    fn(_v : Int64) -> Unit {},
    now_ms=1700000001000L,
    floor=d2.conn_seq,
  )
  debug_assert(d1.conn_seq >= 1700000001000000L, "d1 anchored at wall-clock microseconds")
  debug_assert(d2.conn_seq > d1.conn_seq, "d2 strictly > d1 within same ms")
  debug_assert(d3.conn_seq > d2.conn_seq, "d3 strictly > d2 via in-process floor even when persistence fails")

  // 1c. Cross-tracker fail-closed capability verification
  t1.ensure_workspace("ws-a")
  t2.ensure_workspace("ws-a")
  let snap1 = AuthCapability::capture(t1)
  let ws_cap = snap1.workspace("ws-a", sub=Some("alice"))
  debug_assert(ws_cap.is_valid(t1, current_sub=Some("alice")), "ws_cap valid on owning tracker")
  debug_assert(!ws_cap.is_valid(t1, current_sub=Some("bob")), "ws_cap fails closed on sub mismatch")
  debug_assert(!ws_cap.is_valid(t2, current_sub=Some("alice")), "ws_cap fails closed across different tracker owner_id")

  let v_cap1 = snap1.vault("ws-a", "v-1", sub=Some("alice"))
  let v_cap2 = snap1.vault("ws-a", "v-2", sub=Some("alice"))
  debug_assert(v_cap1.is_valid(t1, current_sub=Some("alice")), "vault_cap valid on owning tracker")
  debug_assert(!v_cap1.is_valid(t2, current_sub=Some("alice")), "vault_cap fails closed across tracker instances")

  let comp = snap1.composite([ws_cap], [v_cap1])
  debug_assert(comp.is_valid(t1, current_sub=Some("alice")), "composite cap valid before bump")
  debug_assert(!comp.is_valid(t2, current_sub=Some("alice")), "composite cap fails closed across trackers")

  // 1d. Single-vault lock/unlock isolates sibling vault v-2 and non-vault ws_cap
  let _ = t1.lock_vault("ws-a", vault_id="v-1")
  debug_assert(t1.is_vault_locked("ws-a", vault_id="v-1"), "v-1 marked locked")
  debug_assert(!t1.is_vault_locked("ws-a", vault_id="v-2"), "sibling v-2 stays unlocked")
  debug_assert(ws_cap.is_valid(t1, current_sub=Some("alice")), "lock_vault does not invalidate non-vault ws_cap")
  debug_assert(!v_cap1.is_valid(t1, current_sub=Some("alice")), "lock_vault invalidates v-1 cap")
  debug_assert(v_cap2.is_valid(t1, current_sub=Some("alice")), "lock_vault(v-1) MUST NOT invalidate sibling vault v-2")
  debug_assert(!comp.is_valid(t1, current_sub=Some("alice")), "composite cap fails closed when vault part invalidates")

  let _ = t1.unlock_vault("ws-a", vault_id="v-1")
  debug_assert(!t1.is_vault_locked("ws-a", vault_id="v-1"), "v-1 unlocked")
  let v_cap1_after = t1.capture_vault("ws-a", "v-1")
  debug_assert(v_cap1_after.vault_gen == 3, "vault_gen incremented 1 -> 2 (lock) -> 3 (unlock)")
  debug_assert(v_cap1_after.is_valid(t1), "fresh vault_cap valid after unlock")

  // 1e. `on_boundary` / `off_boundary` and `AuthBoundaryEvent::Global`
  let seen_events : Array[String] = []
  let lid = t1.on_boundary(fn(ev : AuthBoundaryEvent) -> Unit {
    match ev {
      AuthBoundaryEvent::Workspace(w, g) => seen_events.push("ws:" + w + ":" + g.to_string())
      AuthBoundaryEvent::Global(ag, vg) => seen_events.push("global:" + ag.to_string() + ":" + vg.to_string())
      _ => seen_events.push("other")
    }
  })
  let _ = t1.bump_workspace("ws-a")
  debug_assert(!ws_cap.is_valid(t1, current_sub=Some("alice")), "bump_workspace invalidates old ws_cap")
  debug_assert(!v_cap1_after.is_valid(t1), "bump_workspace also invalidates vault_cap")

  let (ag_all, vg_all) = t1.bump_all()
  debug_assert(ag_all >= 3 && vg_all >= 4, "bump_all advances both global authGen and vaultGen")
  debug_assert(seen_events.length() == 2, "listener saw workspace + global boundary events")
  debug_assert(seen_events[0] == "ws:ws-a:2", "workspace boundary payload matches")
  debug_assert(seen_events[1] == "global:" + ag_all.to_string() + ":" + vg_all.to_string(), "global boundary payload matches")

  t1.off_boundary(lid)
  let _ = t1.bump_workspace("ws-a")
  debug_assert(seen_events.length() == 2, "off_boundary stops further callbacks")

  // 1f. Exact 1:1 `is_device_global_topic`, `is_vault_topic`, `is_aggregate_topic`, `topic_workspace`, `topic_vault_id`
  let device_globals = [
    "releases", "fonts", "changelog", "prefs", "doing", "adbShare",
    "link", "connection", "way", "net",
  ]
  for i in 0..<device_globals.length() {
    debug_assert(is_device_global_topic(device_globals[i]), "must be device-global: " + device_globals[i])
  }
  let scoped = ["downloads", "chats", "chat", "workspaces", "workspace", "workspaceMarks", "profiles", "settings", "lock", "vaults", "accounts", "search"]
  for i in 0..<scoped.length() {
    debug_assert(!is_device_global_topic(scoped[i]), "must NOT be device-global: " + scoped[i])
  }
  debug_assert(is_vault_topic("vaults") && is_vault_topic("vaultItems") && is_vault_topic("vaultUses"), "vault topics recognized")
  debug_assert(!is_vault_topic("chats") && !is_vault_topic("prefs") && !is_vault_topic("vaultApprovals"), "non-vault topics excluded")
  debug_assert(is_aggregate_topic("workspaces") && is_aggregate_topic("lockPrompts") && is_aggregate_topic("downloads"), "aggregate topics recognized")
  let t_chat = protocol::Topic::{ name: "chat", params: [("station", base_codec::json_str("ws-x/st-1"))] }
  let chat_ws_ok = match topic_workspace(t_chat) {
    Some(w) => w == "ws-x"
    None => false
  }
  debug_assert(chat_ws_ok, "topic_workspace extracts ws prefix from station")
  let t_vault = protocol::Topic::{ name: "vaultItems", params: [("workspace", base_codec::json_str("ws-x")), ("vault", base_codec::json_str("v-9"))] }
  let vault_ws_ok = match topic_workspace(t_vault) {
    Some(w) => w == "ws-x"
    None => false
  }
  let vault_id_ok = match topic_vault_id(t_vault) {
    Some(v) => v == "v-9"
    None => false
  }
  debug_assert(vault_ws_ok && vault_id_ok, "topic_workspace + topic_vault_id exact")
}

test "auth_cap 2: WireOutGen stamps all sub frames, on_boundary clears kept & re-anchors active subs, host sink has 0 buildup, headless never evicts handshake" {
  let env = CapSimEnv::new()
  let station = SimStation::new(env.rt)
  let core = ClientCore::new("ws-wire", "ws-wire/st-1", env.rt, env.db, station.transport(), fn() -> Unit {}, conn_seq=Some(42L))

  let sink_frames : Array[String] = []
  core.set_wire_sink(fn(j : String, _b : Option[Bytes]) -> Unit {
    sink_frames.push(j)
  })
  debug_assert(core.pending_wire_event_count() == 0, "pending_wire_events drained on sink attach")

  // Startup authoritative handshake
  let hs = core.emit_auth_handshake()
  debug_assert(sink_frames.length() == 1 && sink_frames[0] == hs, "handshake delivered directly to host sink")
  debug_assert(core.pending_wire_event_count() == 0, "pending_wire_events stays 0 with host sink")
  debug_assert(
    hs.contains("\"id\":0") &&
    hs.contains("\"conn\":42") &&
    hs.contains("\"global\":1") &&
    hs.contains("\"aggregate\":1") &&
    hs.contains("\"vaultGlobal\":1") &&
    hs.contains("\"scopes\":{") &&
    hs.contains("\"workspaces\":{") &&
    hs.contains("\"vaults\":{"),
    "handshake JSON carries full client.mbt envelope",
  )

  // Device-global topic (`prefs`): `conn` only, no `authGen`/`vaultGen`
  match core.handle_wire("{\"id\":10,\"subscribe\":{\"topic\":\"prefs\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(cap_json_int_eq(txt, "conn", 42), "prefs Value has conn:42")
      debug_assert(!cap_json_has_field(txt, "authGen"), "prefs Value omits authGen")
      debug_assert(!cap_json_has_field(txt, "vaultGen"), "prefs Value omits vaultGen")
    }
    None => debug_assert(false, "expected prefs Value")
  }
  let prefs_tok = match core.handle_wire("{\"id\":10,\"unsubscribe\":true,\"keep\":true}") {
    Some((txt, _)) => {
      debug_assert(cap_json_int_eq(txt, "conn", 42) && !cap_json_has_field(txt, "authGen"), "prefs Unsubscribed has conn:42 only")
      match base_codec::json_parse(txt) {
        base_codec::JsonParseResult::Ok(j) => match base_codec::json_get(j, "v") { Some(base_codec::Json::Str(v)) => v; _ => "" }
        _ => ""
      }
    }
    None => ""
  }
  debug_assert(prefs_tok.length() > 0, "got prefs keep token")
  match core.handle_wire("{\"id\":11,\"subscribe\":{\"topic\":\"prefs\"},\"keyed\":true,\"have\":\"" + prefs_tok + "\"}") {
    Some((txt, _)) => {
      debug_assert(txt.contains("\"same\":true") && cap_json_int_eq(txt, "conn", 42) && !cap_json_has_field(txt, "authGen"), "prefs Same has conn:42 only")
    }
    None => debug_assert(false, "expected prefs Same")
  }

  // Workspace topic (`settings`): `conn` + `authGen` (no `vaultGen`), also test `kept` cleared on boundary
  match core.handle_wire("{\"id\":19,\"subscribe\":{\"topic\":\"settings\",\"scope\":\"ws-wire\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(cap_json_int_eq(txt, "conn", 42) && cap_json_int_eq(txt, "authGen", 1) && !cap_json_has_field(txt, "vaultGen"), "settings Value stamped")
    }
    None => debug_assert(false, "expected settings Value")
  }
  let settings_tok = match core.handle_wire("{\"id\":19,\"unsubscribe\":true,\"keep\":true}") {
    Some((txt, _)) => {
      debug_assert(cap_json_int_eq(txt, "conn", 42) && cap_json_int_eq(txt, "authGen", 1), "settings Unsubscribed stamped")
      match base_codec::json_parse(txt) {
        base_codec::JsonParseResult::Ok(j) => match base_codec::json_get(j, "v") { Some(base_codec::Json::Str(v)) => v; _ => "" }
        _ => ""
      }
    }
    None => ""
  }
  debug_assert(settings_tok.length() > 0 && core.router.kept_count() >= 1, "settings kept before boundary")

  // Active workspace + vault subscriptions before boundary
  let _ = core.handle_wire("{\"id\":20,\"subscribe\":{\"topic\":\"settings\",\"scope\":\"ws-wire\"},\"keyed\":true}")
  match core.handle_wire("{\"id\":30,\"subscribe\":{\"topic\":\"vaults\",\"workspace\":\"ws-wire\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(cap_json_int_eq(txt, "conn", 42) && cap_json_int_eq(txt, "authGen", 1) && cap_json_int_eq(txt, "vaultGen", 1), "vaults Value has conn+authGen+vaultGen")
    }
    None => debug_assert(false, "expected vaults Value")
  }

  // Boundary (`bump_workspace_and_vault`): emits new `{id:0,auth}`, clears ws-wire `kept`, re-anchors #20 & #30 without freezing!
  let before_cnt = sink_frames.length()
  let _ = core.auth.bump_workspace_and_vault("ws-wire")
  debug_assert(core.pending_wire_event_count() == 0, "sink keeps pending_wire_events at 0 across boundary")
  let mut saw_hs2 = false
  let mut saw_settings_g2 = false
  let mut saw_vaults_g2 = false
  for i in before_cnt..<sink_frames.length() {
    let f = sink_frames[i]
    if f.contains("\"id\":0") && f.contains("\"auth\":{") && f.contains("\"ws-wire\":2") {
      saw_hs2 = true
    }
    if cap_json_int_eq(f, "id", 20) && cap_json_int_eq(f, "authGen", 2) && f.contains("\"value\"") {
      saw_settings_g2 = true
    }
    if cap_json_int_eq(f, "id", 30) && cap_json_int_eq(f, "authGen", 2) && cap_json_int_eq(f, "vaultGen", 2) && f.contains("\"value\"") {
      saw_vaults_g2 = true
    }
  }
  debug_assert(saw_hs2, "boundary emitted updated {id:0, auth} snapshot")
  debug_assert(saw_settings_g2, "boundary re-anchored active settings sub at authGen:2")
  debug_assert(saw_vaults_g2, "boundary re-anchored active vaults sub at authGen:2, vaultGen:2")

  // Old kept token for `settings` was purged by `on_boundary` -> resubscribe with old `have` returns full `value`, NOT `same:true`
  match core.handle_wire("{\"id\":21,\"subscribe\":{\"topic\":\"settings\",\"scope\":\"ws-wire\"},\"keyed\":true,\"have\":\"" + settings_tok + "\"}") {
    Some((txt, _)) => {
      debug_assert(txt.contains("\"value\"") && !txt.contains("\"same\":true"), "purged kept token returns fresh value, not same:true")
      debug_assert(cap_json_int_eq(txt, "authGen", 2), "fresh value carries new authGen:2")
    }
    None => debug_assert(false, "expected fresh settings value")
  }

  // Active sub #20 continues receiving live updates after boundary (never frozen)
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-wire/st-1"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-1\",\"name\":\"St1\",\"automaticDecisions\":{\"enabled\":true}}"),
    base_codec::json_int64(2000L),
  ])
  let live_wire = core.refresh_topic_wire("settings")
  debug_assert(live_wire.length() >= 1, "active sub produces live updates after boundary")
  debug_assert(cap_json_int_eq(live_wire[0].0, "authGen", 2) && cap_json_int_eq(live_wire[0].0, "conn", 42), "live delta carries authGen:2 + conn:42")

  // Recognizable invalid subscribe error frame stamps full `conn` + `authGen` + `vaultGen`
  match core.handle_wire("{\"id\":701,\"subscribe\":{\"topic\":\"vaultItems\",\"workspace\":\"ws-wire\",\"vault\":123}}") {
    Some((txt, _)) => {
      debug_assert(txt.contains("\"error\""), "invalid subscribe emits error frame")
      debug_assert(cap_json_int_eq(txt, "conn", 42), "invalid subscribe carries conn:42")
      debug_assert(cap_json_int_eq(txt, "authGen", 2), "invalid subscribe carries authGen:2")
      debug_assert(cap_json_int_eq(txt, "vaultGen", 2), "invalid subscribe carries vaultGen:2")
    }
    None => debug_assert(false, "expected invalid subscribe error frame")
  }

  // Headless `pending_wire_events` bounded <= 256 and NEVER evicts latest `{"id":0,"auth":...}` handshake
  let core_hl = ClientCore::new("ws-evict", "ws-evict/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  let hl_hs = core_hl.emit_auth_handshake()
  for i in 0..<280 {
    core_hl.emit_wire_out("{\"id\":" + (i + 1).to_string() + ",\"delta\":[]}")
  }
  let drained = core_hl.drain_pending_wire_events()
  debug_assert(drained.length() == 256, "pending_wire_events bounded to 256")
  let mut kept_hs = false
  for i in 0..<drained.length() {
    if drained[i].0 == hl_hs {
      kept_hs = true
      break
    }
  }
  debug_assert(kept_hs, "latest {id:0, auth} handshake MUST NEVER be evicted from pending_wire_events")
  core_hl.stop()
  core.stop()
}

test "auth_cap 3: full-set canonical_lock_digest seeds cleanly on cold/warm start, splits station vs security bumps, covers endpoints/sign_keys/gateways/cloud_keys, never derives revoked" {
  let env = CapSimEnv::new()
  let station = SimStation::new(env.rt)

  let alice_seed = make_seed(11)
  let bob_seed = make_seed(22)
  let alice_key = ed25519_key_id(alice_seed)
  let bob_key = ed25519_key_id(bob_seed)
  let alice_dev_id = hex_64("a")
  let bob_dev_id = hex_64("b")

  let g_signed = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-ldig")),
      ("seq", form::Json::Num(0.0)),
      ("prev", form::Json::Null),
      ("at", form::Json::Num(1790000000.0)),
      ("kind", form::Json::Str("genesis")),
      (
        "body",
        form::Json::Obj([
          ("owner", form::Json::Str("alice")),
          ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
          ("rp_id", form::Json::Str("app.still.fail")),
          ("cloud_keys", form::Json::Obj([])),
          (
            "members",
            form::Json::Arr([
              form::Json::Obj([("sub", form::Json::Str("alice")), ("email", form::Json::Str("alice@example.com")), ("role", form::Json::Str("owner"))]),
              form::Json::Obj([("sub", form::Json::Str("bob")), ("email", form::Json::Str("bob@example.com")), ("role", form::Json::Str("admin"))]),
            ]),
          ),
          (
            "devices",
            form::Json::Arr([
              form::Json::Obj([("id", form::Json::Str(alice_dev_id)), ("sub", form::Json::Str("alice")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Alice Mac")), ("sign_key", form::Json::Str(alice_key))]),
              form::Json::Obj([("id", form::Json::Str(bob_dev_id)), ("sub", form::Json::Str("bob")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Bob Linux")), ("sign_key", form::Json::Str(bob_key))]),
            ]),
          ),
          ("passkeys", form::Json::Arr([])),
          ("stations", form::Json::Arr([])),
          ("gateways", form::Json::Arr([])),
        ]),
      ),
    ]),
  ) {
    Ok(e) => e
    Err(e) => panic("genesis sign: " + e)
  }
  let root_hash = match lock::entry_hash(g_signed, native_lock_crypto()) { Ok(h) => h; Err(_) => panic("root hash") }

  // 3a. Cold-start first valid lock chain seeds digest WITHOUT spuriously bumping authGen/vaultGen
  let core1 = ClientCore::new("ws-ldig", "ws-ldig/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  match core1.apply_lock_chain([g_signed], root_hash) {
    Ok(_) => ()
    Err(e) => panic("apply genesis failed: " + e)
  }
  debug_assert(core1.auth.workspace_auth_gen("ws-ldig") == 1, "cold-start first lock MUST NOT spuriously bump authGen")
  debug_assert(core1.auth.vault_workspace_gen("ws-ldig") == 1, "cold-start first lock MUST NOT spuriously bump vaultGen")
  core1.stop()

  // 3b. Warm restart on persisted DB as a newcomer ("charlie", absent from lock.members) -> no bump, SafeModeView works
  let core2 = ClientCore::new("ws-ldig", "ws-ldig/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  core2.set_viewer("charlie@example.com", sub="charlie", role="member")
  debug_assert(core2.auth.workspace_auth_gen("ws-ldig") == 1, "warm startup lock seed MUST NOT spuriously bump authGen")
  debug_assert(core2.auth.vault_workspace_gen("ws-ldig") == 1, "warm startup lock seed MUST NOT spuriously bump vaultGen")
  let sm = core2.current_safe_mode_view()
  debug_assert(sm.locked, "newcomer sees workspace locked state cleanly")

  // 3c. Station-only change -> bumps authGen ONLY (vaultGen unchanged)
  let st_add = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-ldig")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_hash)),
      ("at", form::Json::Num(1790000010.0)),
      ("kind", form::Json::Str("station")),
      ("body", form::Json::Obj([("key", form::Json::Str(hex_64("c"))), ("name", form::Json::Str("Tokyo Station"))])),
    ]),
  ) {
    Ok(e) => e
    Err(e) => panic("station entry sign: " + e)
  }
  let h1 = match lock::entry_hash(st_add, native_lock_crypto()) { Ok(h) => h; Err(_) => panic("h1") }
  match core2.apply_lock_chain([g_signed, st_add], root_hash) {
    Ok(_) => ()
    Err(e) => panic("apply station add failed: " + e)
  }
  debug_assert(core2.auth.workspace_auth_gen("ws-ldig") == 2, "station change bumps authGen 1 -> 2")
  debug_assert(core2.auth.vault_workspace_gen("ws-ldig") == 1, "station-only change keeps vaultGen at 1")

  // 3d. Device removal -> security boundary changes -> bumps BOTH authGen AND vaultGen
  let dev_rm = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-ldig")),
      ("seq", form::Json::Num(2.0)),
      ("prev", form::Json::Str(h1)),
      ("at", form::Json::Num(1790000020.0)),
      ("kind", form::Json::Str("device.remove")),
      ("body", form::Json::Obj([("id", form::Json::Str(bob_dev_id))])),
    ]),
  ) {
    Ok(e) => e
    Err(e) => panic("device_remove sign: " + e)
  }
  match core2.apply_lock_chain([g_signed, st_add, dev_rm], root_hash) {
    Ok(_) => ()
    Err(e) => panic("apply device_remove failed: " + e)
  }
  debug_assert(core2.auth.workspace_auth_gen("ws-ldig") == 3, "device removal bumps authGen 2 -> 3")
  debug_assert(core2.auth.vault_workspace_gen("ws-ldig") == 2, "device removal bumps vaultGen 1 -> 2")

  // 3e. `canonical_lock_digest` covers `device.endpoints`, `gateways`, `cloud_keys`, and `sign_keys`
  let make_st = fn(eps : Array[form::Json], gws : Array[form::Json], cks : Array[(String, form::Json)]) -> lock::LockState {
    let g = match sign_lock_entry(
      alice_seed,
      form::Json::Obj([
        ("v", form::Json::Num(1.0)),
        ("ws", form::Json::Str("ws-dig")),
        ("seq", form::Json::Num(0.0)),
        ("prev", form::Json::Null),
        ("at", form::Json::Num(1790000000.0)),
        ("kind", form::Json::Str("genesis")),
        ("body", form::Json::Obj([
          ("owner", form::Json::Str("alice")),
          ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
          ("rp_id", form::Json::Str("app.still.fail")),
          ("cloud_keys", form::Json::Obj(cks)),
          ("members", form::Json::Arr([form::Json::Obj([("sub", form::Json::Str("alice")), ("email", form::Json::Str("alice@example.com")), ("role", form::Json::Str("owner"))])])),
          ("devices", form::Json::Arr([form::Json::Obj([
            ("id", form::Json::Str(hex_64("a"))),
            ("sub", form::Json::Str("alice")),
            ("kind", form::Json::Str("app")),
            ("label", form::Json::Str("Mac")),
            ("sign_key", form::Json::Str(alice_key)),
            ("endpoints", form::Json::Arr(eps)),
          ])])),
          ("passkeys", form::Json::Arr([])),
          ("stations", form::Json::Arr([])),
          ("gateways", form::Json::Arr(gws)),
        ])),
      ]),
    ) {
      Ok(e) => e
      Err(e) => panic("sign: " + e)
    }
    let root = match lock::entry_hash(g, native_lock_crypto()) { Ok(h) => h; Err(_) => panic("root hash") }
    match verify_workspace_lock([g], root) { Ok(v) => v.state; Err(e) => panic("verify: " + e) }
  }
  let ep1 = hex_64("1")
  let ep2 = hex_64("2")
  let gw1 = hex_64("3")
  let gw2 = hex_64("4")
  let ck1 = ed25519_key_id(make_seed(78))
  let ck2 = ed25519_key_id(make_seed(79))
  let base_st = make_st([form::Json::Str(ep1)], [form::Json::Str(gw1)], [("k1", form::Json::Str(ck1))])
  let (full_base, sec_base) = canonical_lock_digest(base_st)
  let (_, sec_ep) = canonical_lock_digest(make_st([form::Json::Str(ep1), form::Json::Str(ep2)], [form::Json::Str(gw1)], [("k1", form::Json::Str(ck1))]))
  let (_, sec_gw) = canonical_lock_digest(make_st([form::Json::Str(ep1)], [form::Json::Str(gw2)], [("k1", form::Json::Str(ck1))]))
  let (_, sec_ck) = canonical_lock_digest(make_st([form::Json::Str(ep1)], [form::Json::Str(gw1)], [("k1", form::Json::Str(ck2))]))
  debug_assert(sec_ep != sec_base, "device.endpoints change MUST alter canonical_lock_digest")
  debug_assert(sec_gw != sec_base, "gateways change MUST alter canonical_lock_digest")
  debug_assert(sec_ck != sec_base, "cloud_keys change MUST alter canonical_lock_digest")
  base_st.sign_keys.set("alice", [alice_key, "ed25519:extra-sign-key"])
  let (full_sk, sec_sk) = canonical_lock_digest(base_st)
  debug_assert(full_sk != full_base && sec_sk != sec_base, "sign_keys mutation MUST alter canonical_lock_digest")
  core2.stop()
}

test "auth_cap 4: fail-open guarded_read_k retries bounded on auth_stale, reschedules on exhaustion, and fetch_lock_k stays ungated by authGen" {
  let rt = effect::Runtime::new()
  let tracker = AuthGenTracker::new()
  tracker.ensure_workspace("ws-g")

  // 4a. Concurrent `authGen` bump mid-I/O -> retries with fresh capability and converges without writing stale result
  let io_attempts = [0]
  let committed = [0]
  let final_res = [-1]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    guarded_read_k(
      tracker,
      "ws-g",
      fn(cap : WorkspaceCapability, io_k : (effect::Exit[Int]) -> Unit) -> Unit {
        io_attempts[0] = io_attempts[0] + 1
        if io_attempts[0] == 1 {
          let _ = tracker.bump_workspace("ws-g")
        }
        io_k(effect::Exit::Succeeded(cap.auth_gen * 100))
      },
      fn(cap : WorkspaceCapability, v : Int) -> Result[Int, String] {
        committed[0] = committed[0] + 1
        debug_assert(cap.auth_gen == 2, "commit only runs under converged fresh cap authGen=2")
        Ok(v + 1)
      },
      fn(ex : effect::Exit[Int]) -> Unit {
        match ex {
          effect::Exit::Succeeded(r) => { final_res[0] = r }
          _ => ()
        }
        k(effect::Exit::Succeeded(()))
      },
    )
  })
  let _ = rt.run_ready()
  debug_assert(io_attempts[0] == 2, "fail-open guarded_read_k retried once on auth_stale")
  debug_assert(committed[0] == 1, "stale first result was NOT committed; converged second result committed once")
  debug_assert(final_res[0] == 201, "converged with fresh cap value")

  // 4b. Exhausted retries (3 consecutive bumps > max_retries=2) -> invokes `on_exhausted_stale` reschedule, 0 commits
  let ex_attempts = [0]
  let ex_committed = [0]
  let ex_rescheduled = [0]
  let ex_failed_stale = [false]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    guarded_read_k(
      tracker,
      "ws-g",
      fn(_cap : WorkspaceCapability, io_k : (effect::Exit[Int]) -> Unit) -> Unit {
        ex_attempts[0] = ex_attempts[0] + 1
        let _ = tracker.bump_workspace("ws-g")
        io_k(effect::Exit::Succeeded(1))
      },
      fn(_cap : WorkspaceCapability, v : Int) -> Result[Int, String] {
        ex_committed[0] = ex_committed[0] + 1
        Ok(v)
      },
      fn(ex : effect::Exit[Int]) -> Unit {
        match ex {
          effect::Exit::Failed(effect::EffectError::Custom("auth_stale")) => { ex_failed_stale[0] = true }
          _ => ()
        }
        k(effect::Exit::Succeeded(()))
      },
      on_exhausted_stale=Some(fn() -> Unit {
        ex_rescheduled[0] = ex_rescheduled[0] + 1
      }),
    )
  })
  let _ = rt.run_ready()
  debug_assert(ex_attempts[0] == 3, "initial attempt + max_retries=2 = 3 total attempts")
  debug_assert(ex_committed[0] == 0, "stale results never committed when exhausted")
  debug_assert(ex_rescheduled[0] == 1, "on_exhausted_stale triggered to reschedule pipeline fail-open")
  debug_assert(ex_failed_stale[0], "exhausted guarded_read_k fails with auth_stale")

  // 4c. SyncScheduler `fetch_lock_k` is NOT blocked by concurrent `authGen` bumps
  let env = CapSimEnv::new()
  let station = SimStation::new(env.rt)
  let lock_calls = [0]
  let tr = StationTransport::{
    request_k: fn(method_s : String, path : String, _h : Array[(String, String)], _b : Bytes, rk : (effect::Exit[HttpReply]) -> Unit) -> Unit {
      if method_s == "GET" && path == "/lock" {
        lock_calls[0] = lock_calls[0] + 1
        rk(effect::Exit::Succeeded(HttpReply::{ status: 404, headers: [], body: Bytes::new(0) }))
      } else {
        rk(effect::Exit::Succeeded(HttpReply::{ status: 200, headers: [], body: "{}".to_bytes() }))
      }
    },
    stream_k: station.transport().stream_k,
  }
  let core = ClientCore::new("ws-lock-open", "ws-lock-open/st-1", env.rt, env.db, tr, fn() -> Unit {})
  let _ = core.auth.bump_workspace("ws-lock-open")
  let lock_ok = [false]
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    core.sync.fetch_lock_k(effect::priority_shown(), fn(ex : effect::Exit[Bool]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => { lock_ok[0] = true }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = env.rt.run_ready()
  debug_assert(lock_calls[0] == 1 && lock_ok[0], "fetch_lock_k runs ungated by authGen")
  core.stop()
}
