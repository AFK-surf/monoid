// Real-time station `/events` SSE consumer & single-transaction `sql::Burst` ingestion.
// Strictly 1:1 aligned with `client/core-ts/src/station/sync.ts:1848-2164`,
// `client/core-ts/src/station/thread-after.ts`, and `client/core-ts/src/db/{sessions-threads,jobs,docs,chats}.ts`.
// Never polls on a timer, never fabricates event names, never clobbers existing SQLite columns,
// and advances `last_event_id` ONLY after `sql::Burst` commits successfully.

import "base_codec"
import "effect"
import "mesh"
import "outbox"
import "sql"
import "store"
import "views"
import "wire"

pub enum ConnectionState {
  Disconnected(String)
  Connecting
  Connected
  Reconnecting(Int)
}

/// Strongly typed core-to-UI events pushed directly into `outbox::FrameOutbox[CoreEvent]`
/// without JSON serialization.
pub enum CoreEvent {
  ChatsChanged(String, Array[String])
  EntryAdded(String, Int, store::Entry, Option[String])
  ThreadReadChanged(String, Int, Int, Int)
  SessionChanged(String, String, Bool)
  JobChanged(String, String, Bool)
  ConnectionChanged(String, ConnectionState)
  OutboxQueued(String, Int, String, String)
  OutboxResolved(String, Int, String, Int)
  OverlayApplied(String, String, String)
  OverlayRolledBack(String, String, String, String, String)
  LockUpdated(String, String, Double, Int)
  LockRejected(String, String)
}

pub struct HttpReply {
  pub status : Int
  pub headers : Array[(String, String)]
  pub body : Bytes
}

fn bytes_to_str(b : Bytes) -> String {
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

/// Pluggable station request & SSE stream transport. Production uses `StationTransport::from_link`
/// backed by `mesh::Link`; deterministic tests inject `SimStation`.
pub struct StationTransport {
  pub request_k : (String, String, Array[(String, String)], Bytes, (effect::Exit[HttpReply]) -> Unit) -> Unit
  pub stream_k : (String, Array[(String, String)], (Bytes) -> Unit, (effect::Exit[Unit]) -> Unit) -> Unit
}

fn read_reply_chunks_k(
  reply : mesh::Reply,
  on_chunk : (Bytes) -> Unit,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if effect::is_interrupted() {
    reply.cancel()
    k(effect::Exit::Interrupted)
    return
  }
  reply.take_k(fn(ex : effect::Exit[Option[Bytes]]) -> Unit {
    match ex {
      effect::Exit::Interrupted => {
        reply.cancel()
        k(effect::Exit::Interrupted)
      }
      effect::Exit::Failed(e) => {
        reply.cancel()
        k(effect::Exit::Failed(e))
      }
      effect::Exit::Succeeded(opt) =>
      match opt {
        None => k(effect::Exit::Succeeded(()))
        Some(chunk) => {
          on_chunk(chunk)
          if effect::is_interrupted() {
            reply.cancel()
            k(effect::Exit::Interrupted)
            return
          }
          read_reply_chunks_k(reply, on_chunk, k)
        }
      }
    }
  })
}

/// Build a `StationTransport` directly on top of a live `mesh::Link`.
pub fn StationTransport::from_link(link : mesh::Link) -> StationTransport {
  StationTransport::{
    request_k: fn(
      method_name : String,
      path : String,
      headers : Array[(String, String)],
      body : Bytes,
      k : (effect::Exit[HttpReply]) -> Unit,
    ) -> Unit {
      link.request_k(
        method_name,
        path,
        fn(ex : effect::Exit[mesh::Reply]) -> Unit {
          match ex {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(reply) => {
              let status = reply.status
              let resp_headers = reply.headers
              reply.rest_k(fn(bex : effect::Exit[Bytes]) -> Unit {
                match bex {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(bytes) =>
                  k(effect::Exit::Succeeded(HttpReply::{ status: status, headers: resp_headers, body: bytes }))
                }
              })
            }
          }
        },
        headers=headers,
        body=body,
      )
    },
    stream_k: fn(
      path : String,
      headers : Array[(String, String)],
      on_chunk : (Bytes) -> Unit,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      link.request_k(
        "GET",
        path,
        fn(ex : effect::Exit[mesh::Reply]) -> Unit {
          match ex {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(reply) => {
              if reply.status < 200 || reply.status >= 300 {
                reply.cancel()
                k(effect::Exit::Failed(effect::EffectError::Custom("events stream status " + reply.status.to_string())))
                return
              }
              read_reply_chunks_k(reply, on_chunk, k)
            }
          }
        },
        headers=headers,
      )
    },
  }
}

// SQL statements used by single-transaction `Burst` ingestion (matching `client/core-ts/src/db/*.ts`).
pub fn sql_entry_put() -> String {
  "INSERT OR REPLACE INTO entry (station, thread, n, json) VALUES (?, ?, ?, ?)"
}

pub fn sql_chat_upsert() -> String {
  "INSERT OR REPLACE INTO chat (station, id, archived, ord, thread, session, client_key, last_active, pinned_at, unread, mine, running, tone, asks, desk, json) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
}

pub fn sql_thread_upsert() -> String {
  "INSERT OR REPLACE INTO thread (station, id, listed, last, read, unread, sort_at, created_at, surface, first_member, json) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
}

pub fn sql_session_upsert() -> String {
  "INSERT INTO session (station, key, listed, ord, last_active, process, connect, archived_at, turns, summary) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT (station, key) DO UPDATE SET listed = excluded.listed, ord = excluded.ord, last_active = excluded.last_active, process = excluded.process, connect = excluded.connect, archived_at = excluded.archived_at, turns = excluded.turns, summary = excluded.summary"
}

pub fn sql_job_upsert() -> String {
  "INSERT OR REPLACE INTO job (station, id, session, open, ord, chat, json) VALUES (?, ?, ?, ?, ?, ?, ?)"
}

pub fn sql_station_overview_upsert() -> String {
  "INSERT INTO station (address, kind, json, confirmed) VALUES (?, 'overview', ?, NULL) ON CONFLICT (address, kind) DO UPDATE SET json = excluded.json, confirmed = coalesce(excluded.confirmed, confirmed)"
}

fn j_str(j : base_codec::Json, k : String, fallback : String = "") -> String {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Str(s)) => s
    _ => fallback
  }
}

fn j_opt_str(j : base_codec::Json, k : String) -> Option[String] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Str(s)) => Some(s)
    _ => None
  }
}

fn j_id_text(j : base_codec::Json, k : String) -> Option[String] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
    Some(base_codec::Json::Num(n, repr)) => {
      if repr.length() > 0 { Some(repr) } else { Some(n.to_int64().to_string()) }
    }
    _ => None
  }
}

fn j_int64(j : base_codec::Json, k : String, fallback : Int64 = 0.to_int64()) -> Int64 {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, repr)) => {
      if repr.length() > 0 && !repr.contains(".") && !repr.contains("e") && !repr.contains("E") {
        match base_codec::parse_int64_str(repr) {
          Some(v) => v
          None => n.to_int64()
        }
      } else {
        n.to_int64()
      }
    }
    _ => fallback
  }
}

fn j_opt_int64(j : base_codec::Json, k : String) -> Option[Int64] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, repr)) => {
      if repr.length() > 0 && !repr.contains(".") && !repr.contains("e") && !repr.contains("E") {
        match base_codec::parse_int64_str(repr) {
          Some(v) => Some(v)
          None => Some(n.to_int64())
        }
      } else {
        Some(n.to_int64())
      }
    }
    _ => None
  }
}

fn j_opt_u64(j : base_codec::Json, k : String) -> Option[Int64] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, repr)) => {
      if n < 0.0 || n != n.floor() {
        return None
      }
      if repr.length() > 0 && !repr.contains(".") && !repr.contains("e") && !repr.contains("E") {
        match base_codec::parse_int64_str(repr) {
          Some(v) => if v >= 0.to_int64() { Some(v) } else { None }
          None => Some(n.to_int64())
        }
      } else {
        Some(n.to_int64())
      }
    }
    _ => None
  }
}

fn j_int(j : base_codec::Json, k : String, fallback : Int = 0) -> Int {
  j_int64(j, k, fallback=fallback.to_int64()).to_int()
}

fn j_bool(j : base_codec::Json, k : String, fallback : Bool = false) -> Bool {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Bool(b)) => b
    _ => fallback
  }
}

fn j_opt_bool(j : base_codec::Json, k : String) -> Option[Bool] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Bool(b)) => Some(b)
    _ => None
  }
}

fn j_double(j : base_codec::Json, k : String, fallback : Double = 0.0) -> Double {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, _)) => n
    _ => fallback
  }
}

fn j_has(j : base_codec::Json, k : String) -> Bool {
  match j {
    base_codec::Json::Obj(fs) => {
      for i in 0..<fs.length() {
        if fs[i].0 == k {
          return true
        }
      }
      false
    }
    _ => false
  }
}

fn j_is_null_or_absent(j : base_codec::Json, k : String) -> Bool {
  match base_codec::json_get(j, k) {
    None => true
    Some(base_codec::Json::Null) => true
    _ => false
  }
}

fn j_set_field(j : base_codec::Json, k : String, v : base_codec::Json) -> base_codec::Json {
  match j {
    base_codec::Json::Obj(fs) => {
      let out : Array[(String, base_codec::Json)] = []
      let mut replaced = false
      for i in 0..<fs.length() {
        if fs[i].0 == k {
          out.push((k, v))
          replaced = true
        } else {
          out.push(fs[i])
        }
      }
      if !replaced {
        out.push((k, v))
      }
      base_codec::json_obj(out)
    }
    _ => j
  }
}

fn j_without_keys(j : base_codec::Json, drop : Array[String]) -> base_codec::Json {
  match j {
    base_codec::Json::Obj(fs) => {
      let out : Array[(String, base_codec::Json)] = []
      for i in 0..<fs.length() {
        let k = fs[i].0
        let mut skip = false
        for di in 0..<drop.length() {
          if drop[di] == k {
            skip = true
            break
          }
        }
        if !skip {
          out.push(fs[i])
        }
      }
      base_codec::json_obj(out)
    }
    _ => j
  }
}

fn opt_str_json(v : Option[String]) -> base_codec::Json {
  match v {
    Some(s) => base_codec::json_str(s)
    None => base_codec::json_null()
  }
}

fn opt_i64_json(v : Option[Int64]) -> base_codec::Json {
  match v {
    Some(n) => base_codec::json_int64(n)
    None => base_codec::json_null()
  }
}

fn ascii_lower(s : String) -> String {
  let bytes = s.to_bytes()
  let sb = StringBuilder::new()
  for i in 0..<bytes.length() {
    let b = bytes[i].to_int()
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32) as Byte)
    } else {
      sb.write_byte(bytes[i])
    }
  }
  sb.to_string()
}

fn is_own_surface(surface : Option[String]) -> Bool {
  match surface {
    Some(s) => s == "chat" || s == "ember" || s == "stillfail"
    None => false
  }
}

fn members_of(view : base_codec::Json) -> Array[String] {
  let out : Array[String] = []
  match base_codec::json_get(view, "sessions") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match j_opt_str(xs[i], "session") {
          Some(s) => if s.length() > 0 { out.push(s) }
          None => ()
        }
      }
    }
    _ => ()
  }
  out
}

/// Truncate UTF-8 string to at most `max_chars` Unicode scalar values (matching JS `[...text].slice(0, 300).join("")`).
fn take_utf8_chars(s : String, max_chars : Int) -> String {
  let bytes = s.to_bytes()
  let mut count = 0
  let mut i = 0
  while i < bytes.length() && count < max_chars {
    let b = bytes[i].to_int()
    let step = if b < 128 { 1 } else if b < 224 { 2 } else if b < 240 { 3 } else { 4 }
    if i + step > bytes.length() {
      break
    }
    i += step
    count += 1
  }
  s.slice(0, i)
}

fn message_of_entry(e : base_codec::Json) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = [
    ("agentIdentity", match base_codec::json_get(e, "agentIdentity") { Some(v) => v; None => base_codec::json_null() }),
    ("seq", match base_codec::json_get(e, "n") { Some(v) => v; None => base_codec::json_null() }),
    ("thread", match base_codec::json_get(e, "thread") { Some(v) => v; None => base_codec::json_null() }),
    ("ts", match base_codec::json_get(e, "ts") { Some(v) => v; None => base_codec::json_null() }),
    ("authorKind", match base_codec::json_get(e, "authorKind") { Some(v) => v; None => base_codec::json_null() }),
    ("author", match base_codec::json_get(e, "author") { Some(v) => v; None => base_codec::json_null() }),
    ("authorName", match base_codec::json_get(e, "authorName") { Some(v) => v; None => base_codec::json_null() }),
    ("text", match base_codec::json_get(e, "text") { Some(v) => v; None => base_codec::json_null() }),
    ("attachments", match base_codec::json_get(e, "attachments") { Some(v) => v; None => base_codec::json_arr([]) }),
    ("quotes", match base_codec::json_get(e, "quotes") { Some(v) => v; None => base_codec::json_arr([]) }),
    ("declared", match base_codec::json_get(e, "declared") { Some(v) => v; None => base_codec::json_null() }),
    ("createdAt", match base_codec::json_get(e, "at") { Some(v) => v; None => base_codec::json_null() }),
    ("editedAt", base_codec::json_null()),
  ]
  match base_codec::json_get(e, "authorPicture") { Some(v) => fields.push(("authorPicture", v)); None => () }
  match base_codec::json_get(e, "authorModel") { Some(v) => fields.push(("authorModel", v)); None => () }
  match base_codec::json_get(e, "authorRuntime") { Some(v) => fields.push(("authorRuntime", v)); None => () }
  match base_codec::json_get(e, "ending") { Some(v) => fields.push(("ending", v)); None => () }
  base_codec::json_obj(fields)
}

/// 1:1 port of `client/core-ts/src/station/thread-after.ts` `threadAfter(held, entries, me)`.
pub fn thread_after(
  held : base_codec::Json,
  entries : Array[base_codec::Json],
  me : String,
) -> Option[base_codec::Json] {
  match held {
    base_codec::Json::Obj(_) => ()
    _ => return None
  }
  if !is_own_surface(j_opt_str(held, "surface")) {
    return None
  }
  let said : Array[(Int64, base_codec::Json)] = []
  for i in 0..<entries.length() {
    match entries[i] {
      base_codec::Json::Obj(_) => {
        match j_opt_u64(entries[i], "n") {
          Some(en) => said.push((en, entries[i]))
          None => return None
        }
      }
      _ => ()
    }
  }
  if said.length() == 0 {
    return None
  }
  let mut last = match j_opt_u64(held, "last") {
    Some(v) => v
    None => return None
  }
  let read = match j_opt_u64(held, "read") {
    Some(v) => v
    None => return None
  }
  // Sort ascending by `n` (insertion sort — deterministic & stable)
  for i in 1..<said.length() {
    let cur = said[i]
    let mut j = i - 1
    while j >= 0 && said[j].0 > cur.0 {
      said[j + 1] = said[j]
      j -= 1
    }
    said[j + 1] = cur
  }
  let mut unread = match j_opt_u64(held, "unread") {
    Some(v) => v
    None => 0.to_int64()
  }
  let mut last_message = match base_codec::json_get(held, "lastMessage") {
    Some(v) => v
    None => base_codec::json_null()
  }
  let people : Array[base_codec::Json] = []
  match base_codec::json_get(held, "people") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        people.push(xs[i])
      }
    }
    _ => ()
  }
  let mut first_text = match base_codec::json_get(held, "firstText") {
    Some(v) => v
    None => base_codec::json_null()
  }
  let mine = ascii_lower(me)
  for i in 0..<said.length() {
    let (at, e) = said[i]
    if at <= last {
      continue
    }
    if at != last + 1.to_int64() {
      return None
    }
    let kind = j_str(e, "kind")
    if kind == "message" {
      if !j_has(e, "letter") {
        let ak = j_str(e, "authorKind")
        let author = j_opt_str(e, "author")
        if ak == "person" {
          match author {
            Some(a) => {
              if a == "local" || !a.contains("@") {
                return None
              }
            }
            None => return None
          }
        }
        last_message = message_of_entry(e)
        let own = match author {
          Some(a) => ak == "person" && ascii_lower(a) == mine
          None => false
        }
        if at > read && !own {
          unread += 1.to_int64()
        }
        if ak == "person" {
          match author {
            Some(a) => {
              let mut has_person = false
              for pi in 0..<people.length() {
                match j_opt_str(people[pi], "id") {
                  Some(pid) => if pid == a {
                    has_person = true
                    break
                  }
                  None => ()
                }
              }
              if !has_person {
                let pname = match j_opt_str(e, "authorName") {
                  Some(nm) => nm
                  None => a
                }
                people.push(base_codec::json_obj([
                  ("id", base_codec::json_str(a)),
                  ("name", base_codec::json_str(pname)),
                  ("email", base_codec::json_str(a)),
                  ("via", base_codec::json_str("cloud")),
                ]))
              }
              match first_text {
                base_codec::Json::Null => {
                  match j_opt_str(e, "text") {
                    Some(t) => {
                      first_text = base_codec::json_str(take_utf8_chars(t, 300))
                    }
                    None => ()
                  }
                }
                _ => ()
              }
            }
            None => ()
          }
        }
      }
    } else if kind == "edit" {
      match last_message {
        base_codec::Json::Obj(_) => {
          let lm_seq = j_opt_u64(last_message, "seq")
          let target = j_opt_u64(e, "target")
          let seq_match = match (lm_seq, target) {
            (Some(a), Some(b)) => a == b
            _ => false
          }
          if seq_match {
            let mut updated = j_set_field(
              last_message,
              "text",
              match base_codec::json_get(e, "text") { Some(v) => v; None => base_codec::json_null() },
            )
            updated = j_set_field(
              updated,
              "attachments",
              match base_codec::json_get(e, "attachments") { Some(v) => v; None => base_codec::json_arr([]) },
            )
            updated = j_set_field(
              updated,
              "quotes",
              match base_codec::json_get(e, "quotes") { Some(v) => v; None => base_codec::json_arr([]) },
            )
            updated = j_set_field(
              updated,
              "editedAt",
              match base_codec::json_get(e, "at") { Some(v) => v; None => base_codec::json_null() },
            )
            last_message = updated
          }
        }
        _ => ()
      }
    } else {
      return None
    }
    last = at
  }
  let mut out = j_set_field(held, "last", base_codec::json_int64(last))
  out = j_set_field(out, "lastMessage", last_message)
  out = j_set_field(out, "unread", base_codec::json_int64(unread))
  out = j_set_field(out, "people", base_codec::json_arr(people))
  out = j_set_field(out, "firstText", first_text)
  Some(out)
}

/// Base reconnect delay in ms (matches `client/core-ts/src/station/link.ts RECONNECT_MS`).
pub fn reconnect_ms() -> Int {
  2000
}

/// Maximum reconnect backoff in ms (matches `client/core-ts/src/station/link.ts RECONNECT_MAX_MS`).
pub fn reconnect_max_ms() -> Int {
  60000
}

/// Base read retry delay in ms (matches `client/core-ts/src/station/sync.ts READ_RETRY_MS`).
pub fn read_retry_ms() -> Int {
  2000
}

/// Exponential reconnect backoff capped at 60s (1:1 parity with `client/core-ts/src/station/link.ts`
/// & `sync.ts retryAfter`: `min(2000 * 2^min(n, 10), 60000)` -> 2000, 4000, 8000, 16000, 32000, 60000).
pub fn reconnect_backoff_ms(attempt : Int) -> Int {
  let clamped = if attempt < 0 { 0 } else if attempt > 10 { 10 } else { attempt }
  let ms = 2000 << clamped
  if ms > 60000 { 60000 } else { ms }
}

/// Exponential read retry backoff matching `client/core-ts/src/station/sync.ts retryAfter(n)`.
pub fn retry_after_ms(n : Int) -> Int {
  reconnect_backoff_ms(n)
}

pub struct SessionStatus {
  pub key : String
  pub running : Bool
  pub listed : Bool
  pub last_active : Option[Int64]
  pub process : Option[String]
  pub connect : Option[String]
  pub turns : Option[Int64]
}

pub struct JobStatus {
  pub id : String
  pub session : Option[String]
  pub open : Bool
  pub chat : Option[String]
}

pub struct StationEvents {
  pub workspace : String
  pub station : String
  pub db : sql::Sql
  pub outbox : outbox::FrameOutbox[CoreEvent]
  pub mut transport : StationTransport
  pub mut viewer_email : String
  pub mut viewer_selves : Array[String]
  mut last_event_id : Option[String]
  mut state : ConnectionState
  mut attempts : Int
  mut stopped : Bool
  sessions : Map[String, SessionStatus]
  session_order : Array[String]
  jobs : Map[String, JobStatus]
  job_order : Array[String]
  dirty_threads : Map[Int, Bool]
  mut resync_needed : Int
  mut marks_dirty_count : Int
  mut on_entry_client_key : (sql::Burst, Int, Int, String) -> Unit
  mut on_chat_client_key : (sql::Burst, String, String) -> Unit
  mut on_connected : () -> Unit
  mut on_lock_payload : (base_codec::Json) -> Unit
  mut on_lock_apply : Option[(base_codec::Json) -> Result[Unit, String]]
  mut on_missed : () -> Unit
  mut on_marks_dirty : (String, base_codec::Json) -> Unit
  mut on_marks_applied : (base_codec::Json, Bool, Array[String], Array[String], Array[Int]) -> Unit
  mut on_thread_dirty : (Int) -> Unit
  mut auth : Option[AuthGenTracker]
  mut stream_epoch : Int64
  mut stream_fiber : Option[effect::Fiber[Unit]]
  mut active_stream_fiber : Option[effect::Fiber[Unit]]
  mut active_cancel : Option[() -> Unit]
}

pub fn StationEvents::new(
  workspace : String,
  station : String,
  db : sql::Sql,
  frame_outbox : outbox::FrameOutbox[CoreEvent],
  transport : StationTransport,
) -> StationEvents {
  StationEvents::{
    workspace: workspace,
    station: station,
    db: db,
    outbox: frame_outbox,
    transport: transport,
    viewer_email: "",
    viewer_selves: [],
    last_event_id: None,
    state: ConnectionState::Disconnected("initial"),
    attempts: 0,
    stopped: false,
    sessions: Map::new(),
    session_order: [],
    jobs: Map::new(),
    job_order: [],
    dirty_threads: Map::new(),
    resync_needed: 0,
    marks_dirty_count: 0,
    on_entry_client_key: fn(_b : sql::Burst, _th : Int, _n : Int, _ck : String) -> Unit {},
    on_chat_client_key: fn(_b : sql::Burst, _cid : String, _ck : String) -> Unit {},
    on_connected: fn() -> Unit {},
    on_lock_payload: fn(_j : base_codec::Json) -> Unit {},
    on_lock_apply: None,
    on_missed: fn() -> Unit {},
    on_marks_dirty: fn(_ev : String, _j : base_codec::Json) -> Unit {},
    on_marks_applied: fn(_j : base_codec::Json, _whole : Bool, _affected : Array[String], _sessions : Array[String], _threads : Array[Int]) -> Unit {},
    on_thread_dirty: fn(_th : Int) -> Unit {},
    auth: None,
    stream_epoch: 1L,
    stream_fiber: None,
    active_stream_fiber: None,
    active_cancel: None,
  }
}

pub fn StationEvents::set_auth_tracker(self : StationEvents, tracker : AuthGenTracker) -> Unit {
  self.auth = Some(tracker)
}

/// Reset all in-memory stream state (`sessions`, `jobs`, `dirty_threads`, `last_event_id`)
/// and bump `stream_epoch` so late callbacks from prior streams are discarded.
pub fn StationEvents::reset_state(self : StationEvents) -> Unit {
  self.stream_epoch += 1L
  self.last_event_id = None
  self.attempts = 0
  self.sessions.clear()
  self.session_order.clear()
  self.jobs.clear()
  self.job_order.clear()
  self.dirty_threads.clear()
  self.resync_needed = 0
  self.marks_dirty_count = 0
}

pub fn StationEvents::set_missed_hook(self : StationEvents, cb : () -> Unit) -> Unit {
  self.on_missed = cb
}

pub fn StationEvents::set_marks_dirty_hook(self : StationEvents, cb : (String, base_codec::Json) -> Unit) -> Unit {
  self.on_marks_dirty = cb
}

pub fn StationEvents::set_marks_applied_hook(
  self : StationEvents,
  cb : (base_codec::Json, Bool, Array[String], Array[String], Array[Int]) -> Unit,
) -> Unit {
  self.on_marks_applied = cb
}

pub fn StationEvents::set_lock_apply_hook(
  self : StationEvents,
  cb : (base_codec::Json) -> Result[Unit, String],
) -> Unit {
  self.on_lock_apply = Some(cb)
}

pub fn StationEvents::notify_lock_payload_result(
  self : StationEvents,
  payload : base_codec::Json,
) -> Result[Unit, String] {
  match self.on_lock_apply {
    Some(cb) => cb(payload)
    None => {
      let cb = self.on_lock_payload
      cb(payload)
      Ok(())
    }
  }
}

pub fn StationEvents::notify_lock_payload(self : StationEvents, payload : base_codec::Json) -> Unit {
  let _ = self.notify_lock_payload_result(payload)
}

pub fn StationEvents::set_thread_dirty_hook(self : StationEvents, cb : (Int) -> Unit) -> Unit {
  self.on_thread_dirty = cb
}

pub fn StationEvents::set_active_cancel(self : StationEvents, cb : () -> Unit) -> Unit {
  self.active_cancel = Some(cb)
}

fn StationEvents::cancel_active_stream(self : StationEvents) -> Unit {
  match self.active_cancel {
    Some(cb) => {
      self.active_cancel = None
      cb()
    }
    None => ()
  }
  match self.active_stream_fiber {
    Some(cf) => {
      self.active_stream_fiber = None
      cf.interrupt()
    }
    None => ()
  }
}

pub fn StationEvents::resync_count(self : StationEvents) -> Int {
  self.resync_needed
}

pub fn StationEvents::marks_dirty_count(self : StationEvents) -> Int {
  self.marks_dirty_count
}

pub fn StationEvents::is_thread_dirty(self : StationEvents, id : Int) -> Bool {
  match self.dirty_threads.get(id) {
    Some(true) => true
    _ => false
  }
}

pub fn StationEvents::dirty_thread_ids(self : StationEvents) -> Array[Int] {
  self.dirty_threads.keys()
}

pub fn StationEvents::set_viewer_email(self : StationEvents, email : String) -> Unit {
  self.viewer_email = email
}

pub fn StationEvents::set_viewer_selves(self : StationEvents, selves : Array[String]) -> Unit {
  self.viewer_selves = selves
}

pub fn StationEvents::session_status(self : StationEvents, key : String) -> Option[SessionStatus] {
  self.sessions.get(key)
}

pub fn StationEvents::all_sessions(self : StationEvents) -> Array[SessionStatus] {
  let out : Array[SessionStatus] = []
  for i in 0..<self.session_order.length() {
    match self.sessions.get(self.session_order[i]) {
      Some(s) => out.push(s)
      None => ()
    }
  }
  out
}

pub fn StationEvents::running_session_count(self : StationEvents) -> Int {
  let mut n = 0
  for i in 0..<self.session_order.length() {
    match self.sessions.get(self.session_order[i]) {
      Some(s) => if s.running { n += 1 }
      None => ()
    }
  }
  n
}

pub fn StationEvents::job_status(self : StationEvents, id : String) -> Option[JobStatus] {
  self.jobs.get(id)
}

pub fn StationEvents::open_jobs(self : StationEvents) -> Array[JobStatus] {
  let out : Array[JobStatus] = []
  for i in 0..<self.job_order.length() {
    match self.jobs.get(self.job_order[i]) {
      Some(j) => if j.open { out.push(j) }
      None => ()
    }
  }
  out
}

pub fn StationEvents::open_job_count(self : StationEvents) -> Int {
  let mut n = 0
  for i in 0..<self.job_order.length() {
    match self.jobs.get(self.job_order[i]) {
      Some(j) => if j.open { n += 1 }
      None => ()
    }
  }
  n
}

fn StationEvents::track_session(self : StationEvents, s : SessionStatus) -> Unit {
  if self.sessions.get(s.key).is_none() {
    self.session_order.push(s.key)
  }
  self.sessions.set(s.key, s)
}

fn StationEvents::track_job(self : StationEvents, j : JobStatus) -> Unit {
  if self.jobs.get(j.id).is_none() {
    self.job_order.push(j.id)
  }
  self.jobs.set(j.id, j)
}

pub fn StationEvents::set_hooks(
  self : StationEvents,
  on_entry_client_key : (sql::Burst, Int, Int, String) -> Unit,
  on_chat_client_key : (sql::Burst, String, String) -> Unit,
  on_connected : () -> Unit,
  on_lock_payload : (base_codec::Json) -> Unit,
) -> Unit {
  self.on_entry_client_key = on_entry_client_key
  self.on_chat_client_key = on_chat_client_key
  self.on_connected = on_connected
  self.on_lock_payload = on_lock_payload
  self.on_lock_apply = None
}

pub fn StationEvents::connection_state(self : StationEvents) -> ConnectionState {
  self.state
}

pub fn StationEvents::last_id(self : StationEvents) -> Option[String] {
  self.last_event_id
}

fn StationEvents::set_state(self : StationEvents, next : ConnectionState) -> Unit {
  self.state = next
  self.outbox.tell(CoreEvent::ConnectionChanged(self.station, next))
}

fn upsert_shared_mark_in_burst(
  b : sql::Burst,
  station : String,
  kind : String,
  k : String,
  v : Option[String],
) -> sql::SqlResult[Unit] {
  match v {
    Some(val_s) =>
    match b.run(
      "INSERT OR REPLACE INTO shared_mark (station, kind, k, v) VALUES (?, ?, ?, ?)",
      params=[
        base_codec::json_str(station),
        base_codec::json_str(kind),
        base_codec::json_str(k),
        base_codec::json_str(val_s),
      ],
    ) {
      sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
    }
    None =>
    match b.run(
      "DELETE FROM shared_mark WHERE station = ? AND kind = ? AND k = ?",
      params=[
        base_codec::json_str(station),
        base_codec::json_str(kind),
        base_codec::json_str(k),
      ],
    ) {
      sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
    }
  }
}

fn read_shared_mark_in_burst(
  b : sql::Burst,
  station : String,
  kind : String,
  k : String,
) -> Option[String] {
  match b.all(
    "SELECT v FROM shared_mark WHERE station = ? AND kind = ? AND k = ?",
    params=[
      base_codec::json_str(station),
      base_codec::json_str(kind),
      base_codec::json_str(k),
    ],
  ) {
    sql::SqlResult::Ok(rows) => if rows.length() > 0 { Some(sql::col_text(rows[0], 0)) } else { None }
    sql::SqlResult::Err(_) => None
  }
}

fn agents_has_running(payload : base_codec::Json) -> Bool {
  match base_codec::json_get(payload, "agents") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match j_opt_str(xs[i], "process") {
          Some(p) => if p == "running" { return true }
          None => ()
        }
      }
      false
    }
    _ => false
  }
}

fn opt_json_str_col(payload : base_codec::Json, key : String) -> base_codec::Json {
  match base_codec::json_get(payload, key) {
    None | Some(base_codec::Json::Null) => base_codec::json_null()
    Some(base_codec::Json::Str(s)) => base_codec::json_str(s)
    Some(v) => base_codec::json_str(base_codec::json_stringify(v))
  }
}

fn se_ascii_lower(s : String) -> String {
  let bs = s.to_bytes()
  let sb = StringBuilder::new()
  for i in 0..<bs.length() {
    let b = bs[i].to_int()
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32) as Byte)
    } else {
      sb.write_byte(bs[i])
    }
  }
  sb.to_string()
}

fn viewer_matches_str(viewer_email : String, viewer_selves : Array[String], cand : String) -> Bool {
  if cand.length() == 0 {
    return false
  }
  let lc = se_ascii_lower(cand)
  if viewer_email.length() > 0 && se_ascii_lower(viewer_email) == lc {
    return true
  }
  for i in 0..<viewer_selves.length() {
    if viewer_selves[i].length() > 0 && se_ascii_lower(viewer_selves[i]) == lc {
      return true
    }
  }
  false
}

fn se_slack_tail(pid : String) -> String {
  let mut last_colon = -1
  for i in 0..<pid.length() {
    if pid.code_unit_at(i) == 58 {
      last_colon = i
    }
  }
  if last_colon >= 0 {
    pid.slice(last_colon + 1, pid.length())
  } else {
    pid
  }
}

/// 1:1 parity with `client/core-ts/src/station/rows-made.ts mineFor(me, selves)` & `chat-row.ts`:
/// matches `id === me`, case-insensitive `email === me`, `via === "slack"` with `id` tail in `selves`,
/// and direct `id`/`email` membership in `selves`.
pub fn viewer_matches_person(viewer_email : String, viewer_selves : Array[String], p : base_codec::Json) -> Bool {
  if viewer_email.length() == 0 && viewer_selves.length() == 0 {
    return false
  }
  match p {
    base_codec::Json::Str(s) => viewer_matches_str(viewer_email, viewer_selves, s)
    base_codec::Json::Obj(_) => {
      let pid = j_str(p, "id")
      let pe = j_str(p, "email")
      let via = j_str(p, "via")
      if viewer_email.length() > 0 {
        if pid == viewer_email {
          return true
        }
        if pe.length() > 0 && se_ascii_lower(pe) == se_ascii_lower(viewer_email) {
          return true
        }
      }
      if via == "slack" && pid.length() > 0 {
        let tail = se_slack_tail(pid)
        for i in 0..<viewer_selves.length() {
          if viewer_selves[i].length() > 0 && viewer_selves[i] == tail {
            return true
          }
        }
      }
      for i in 0..<viewer_selves.length() {
        let sv = viewer_selves[i]
        if sv.length() > 0 && (pid == sv || (pe.length() > 0 && se_ascii_lower(pe) == se_ascii_lower(sv))) {
          return true
        }
      }
      false
    }
    _ => false
  }
}

/// Read local read cursor for `(station, thread)` from `thread.read` and `shared_mark('read', thread)`.
fn read_cursor_in_burst(b : sql::Burst, station : String, thread : Int) -> Int64 {
  let mut best = 0.to_int64()
  match b.all(
    "SELECT read FROM thread WHERE station = ? AND id = ?",
    params=[base_codec::json_str(station), base_codec::json_int(thread)],
  ) {
    sql::SqlResult::Ok(rows) =>
    if rows.length() > 0 {
      match sql::col_opt_int64(rows[0], 0) {
        Some(v) => if v > best { best = v }
        None => ()
      }
    }
    sql::SqlResult::Err(_) => ()
  }
  match read_shared_mark_in_burst(b, station, "read", thread.to_string()) {
    Some(s) =>
    match base_codec::parse_int64_str(s) {
      Some(v) => if v > best { best = v }
      None => ()
    }
    None => ()
  }
  best
}

/// Upsert a `chat-shared` row 1:1 with `client/core-ts/src/chat-row.ts` (`rowFor`):
/// - Projects viewer-specific `mine` (from `mineOf`), `unread` (from `said` vs local read cursor),
///   `dismissed` on `card`/`need`/`decision` (from `shared_mark('dismissed', '<th:seq>')`),
///   and `pin`/`hidden`/`muted`/`kept` from `shared_mark`;
/// - Writes `shared_sidecar` strictly with `schema.ts:570-578` columns ONLY when `digest` is provided;
/// - Never swallows any SQL error.
fn upsert_chat_shared_in_burst(
  b : sql::Burst,
  station : String,
  viewer_email : String,
  viewer_selves : Array[String],
  payload : base_codec::Json,
) -> sql::SqlResult[String] {
  let cid = j_str(payload, "id")
  match j_opt_str(payload, "digest") {
    Some(digest) => {
      if digest.length() > 0 {
        let quoted_only = if j_bool(payload, "quotedOnly") { 1 } else { j_int(payload, "quoted_only") }
        let local_admin = if j_bool(payload, "localAdmin") { 1 } else { j_int(payload, "local_admin") }
        match b.run(
          "INSERT OR REPLACE INTO shared_sidecar (station, id, digest, said, named, quoted_only, local_admin) VALUES (?, ?, ?, ?, ?, ?, ?)",
          params=[
            base_codec::json_str(station),
            base_codec::json_str(cid),
            base_codec::json_str(digest),
            opt_json_str_col(payload, "said"),
            opt_json_str_col(payload, "named"),
            base_codec::json_int(quoted_only),
            base_codec::json_int(local_admin),
          ],
        ) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(_) => ()
        }
      }
    }
    None => ()
  }
  let mut merged = payload
  // 1:1 `chat-row.ts:133`: project `mine` from `mineOf` array when present (never blindly trust shared `"mine": false`).
  match base_codec::json_get(payload, "mineOf") {
    Some(base_codec::Json::Arr(xs)) => {
      let mut is_mine = false
      for i in 0..<xs.length() {
        if viewer_matches_person(viewer_email, viewer_selves, xs[i]) {
          is_mine = true
          break
        }
      }
      merged = j_set_field(merged, "mine", base_codec::json_bool(is_mine))
    }
    _ => ()
  }
  // 1:1 `chat-row.ts:32-37, 132`: project `unread` from `said` vs local read cursor when present.
  let thread_opt = j_opt_int64(merged, "thread")
  match (base_codec::json_get(payload, "said"), thread_opt) {
    (Some(base_codec::Json::Obj(said_fields)), Some(th)) => {
      let said_obj = base_codec::json_obj(said_fields)
      let read_pos = read_cursor_in_burst(b, station, th.to_int())
      let by_viewer = j_str(said_obj, "authorKind") == "person" &&
      viewer_matches_str(viewer_email, viewer_selves, j_str(said_obj, "author"))
      let n_opt = if by_viewer { j_opt_int64(said_obj, "other") } else { j_opt_int64(said_obj, "n") }
      let is_unread = match n_opt {
        Some(n) => n > read_pos
        None => false
      }
      merged = j_set_field(merged, "unread", base_codec::json_bool(is_unread))
    }
    _ => ()
  }
  // Overlay persisted viewer `shared_mark` values (`pin`, `hidden`, `muted`, `kept`, `dismissed`).
  let pin_key = match j_opt_str(merged, "session") { Some(s) => s; None => cid }
  match read_shared_mark_in_burst(b, station, "pin", pin_key) {
    Some(ps) =>
    match base_codec::parse_int64_str(ps) {
      Some(pv) => { merged = j_set_field(merged, "pinned", base_codec::json_int64(pv)) }
      None => ()
    }
    None => ()
  }
  match thread_opt {
    Some(th) => {
      let th_k = th.to_string()
      match read_shared_mark_in_burst(b, station, "hidden", th_k) {
        Some(v) => if v == "1" { merged = j_set_field(merged, "hidden", base_codec::json_bool(true)) }
        None => ()
      }
      match read_shared_mark_in_burst(b, station, "muted", th_k) {
        Some(v) => if v == "1" { merged = j_set_field(merged, "muted", base_codec::json_bool(true)) }
        None => ()
      }
      match read_shared_mark_in_burst(b, station, "kept", th_k) {
        Some(v) => if v == "1" { merged = j_set_field(merged, "kept", base_codec::json_bool(true)) }
        None => ()
      }
      // 1:1 `chat-row.ts:138-142`: overlay `dismissed: true` on `card`, `need`, `decision`.
      let ask_keys = ["card", "need", "decision"]
      for ki in 0..<ask_keys.length() {
        let ak = ask_keys[ki]
        match base_codec::json_get(merged, ak) {
          Some(base_codec::Json::Obj(sub_fs)) => {
            let sub = base_codec::json_obj(sub_fs)
            match j_opt_u64(sub, "seq") {
              Some(seq_v) => {
                let dk = th_k + ":" + seq_v.to_string()
                match read_shared_mark_in_burst(b, station, "dismissed", dk) {
                  Some("1") => {
                    merged = j_set_field(merged, ak, j_set_field(sub, "dismissed", base_codec::json_bool(true)))
                  }
                  _ => ()
                }
              }
              None => ()
            }
          }
          _ => ()
        }
      }
    }
    None => ()
  }
  upsert_chat_in_burst(b, station, merged)
}

/// Upsert a `chat` row aligned 1:1 with `client/core-ts/src/db/chats.ts:125-149`:
/// - `unread` is stored ONLY in the `unread` SQL column and stripped from `chat.json`;
/// - Updating an existing row preserves any omitted columns (`ord`, `unread`, `mine`, `pinned_at`,
///   `running`, `tone`, `asks`, `desk`) and viewer JSON marks (`hidden`, `muted`, `kept`, `pinned`);
/// - Derives `running`, `tone`, and `asks` when omitted so `chat_marks` index stays accurate.
fn upsert_chat_in_burst(b : sql::Burst, station : String, payload : base_codec::Json) -> sql::SqlResult[String] {
  let cid = j_str(payload, "id")
  let archived = if j_bool(payload, "archived") { 1 } else { j_int(payload, "archived") }
  let existing = match b.all(
    "SELECT ord, unread, mine, pinned_at, running, tone, asks, desk, json FROM chat WHERE station = ? AND archived = ? AND id = ?",
    params=[base_codec::json_str(station), base_codec::json_int(archived), base_codec::json_str(cid)],
  ) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => if rows.length() > 0 { Some(rows[0]) } else { None }
  }
  let mut merged = payload
  match existing {
    Some(r) => {
      match base_codec::json_parse(sql::col_text(r, 8)) {
        base_codec::JsonParseResult::Ok(prev_j) => {
          if base_codec::json_get(merged, "hidden").is_none() {
            match base_codec::json_get(prev_j, "hidden") { Some(v) => { merged = j_set_field(merged, "hidden", v) }; None => () }
          }
          if base_codec::json_get(merged, "muted").is_none() {
            match base_codec::json_get(prev_j, "muted") { Some(v) => { merged = j_set_field(merged, "muted", v) }; None => () }
          }
          if base_codec::json_get(merged, "kept").is_none() {
            match base_codec::json_get(prev_j, "kept") { Some(v) => { merged = j_set_field(merged, "kept", v) }; None => () }
          }
          if base_codec::json_get(merged, "pinned").is_none() && base_codec::json_get(merged, "pinnedAt").is_none() {
            match sql::col_opt_int64(r, 3) { Some(p) => { merged = j_set_field(merged, "pinned", base_codec::json_int64(p)) }; None => () }
          }
        }
        base_codec::JsonParseResult::Err(_) => ()
      }
    }
    None => ()
  }
  let ord = match base_codec::json_get(merged, "ord") {
    Some(base_codec::Json::Num(v, _)) => v
    _ => match existing { Some(r) => sql::col_double(r, 0); None => 0.0 }
  }
  let thread = j_opt_int64(merged, "thread")
  let session = j_opt_str(merged, "session")
  let client_key = j_opt_str(merged, "clientKey")
  let last_active = match j_opt_int64(merged, "lastActiveAt") {
    Some(v) => v
    None => j_int64(merged, "lastActive")
  }
  let pinned_at = match j_opt_int64(merged, "pinned") {
    Some(v) => Some(v)
    None =>
    match j_opt_int64(merged, "pinnedAt") {
      Some(v) => Some(v)
      None => match existing { Some(r) => sql::col_opt_int64(r, 3); None => None }
    }
  }
  let unread = match base_codec::json_get(merged, "unread") {
    Some(base_codec::Json::Bool(true)) => Some(1.to_int64())
    Some(base_codec::Json::Bool(false)) => Some(0.to_int64())
    Some(base_codec::Json::Num(v, _)) => Some(v.to_int64())
    Some(base_codec::Json::Null) => None
    _ => match existing { Some(r) => sql::col_opt_int64(r, 1); None => None }
  }
  let mine = match base_codec::json_get(merged, "mine") {
    Some(base_codec::Json::Bool(b)) => if b { 1 } else { 0 }
    Some(base_codec::Json::Num(v, _)) => v.to_int()
    _ => match existing { Some(r) => sql::col_int(r, 2); None => 0 }
  }
  let running = match base_codec::json_get(merged, "running") {
    Some(base_codec::Json::Bool(b)) => if b { 1 } else { 0 }
    Some(base_codec::Json::Num(v, _)) => v.to_int()
    _ =>
    if base_codec::json_get(merged, "agents").is_some() {
      if agents_has_running(merged) { 1 } else { 0 }
    } else {
      match existing { Some(r) => sql::col_int(r, 4); None => 0 }
    }
  }
  // Single source of truth: reuse `views::{is_led_subchat, undecided_of_row, row_state}` directly
  // so write-path index columns (`tone`, `asks`) match read-path projections 100% (`chats.ts:144-145`).
  let is_led = views::is_led_subchat(merged)
  let unread_explicit = base_codec::json_get(merged, "unread").is_some()
  let agents_opt : Option[Array[base_codec::Json]] = match base_codec::json_get(merged, "agents") {
    Some(base_codec::Json::Arr(xs)) => Some(xs)
    _ => None
  }
  let has_agents = agents_opt.is_some()
  let has_ask_fields = base_codec::json_get(merged, "card").is_some() ||
  base_codec::json_get(merged, "decision").is_some() ||
  base_codec::json_get(merged, "need").is_some()
  let asks : Int = if archived != 0 || is_led {
    0
  } else {
    match base_codec::json_get(merged, "asks") {
      Some(base_codec::Json::Bool(b)) => if b { 1 } else { 0 }
      Some(base_codec::Json::Num(v, _)) => v.to_int()
      _ => {
        if views::undecided_of_row(merged).length() > 0 {
          1
        } else if has_ask_fields || has_agents {
          0
        } else {
          match existing { Some(r) => sql::col_int(r, 6); None => 0 }
        }
      }
    }
  }
  let tone : Option[String] = if archived != 0 || is_led {
    None
  } else {
    match base_codec::json_get(merged, "tone") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      Some(base_codec::Json::Null) => None
      _ => {
        let prev_tone : Option[String] = match existing { Some(r) => sql::col_opt_text(r, 5); None => None }
        let is_unread_one = match unread { Some(u) => u != 0.to_int64(); None => false }
        let st_opt = match agents_opt {
          Some(ags) => views::row_state(ags)
          None => None
        }
        let is_failed = match st_opt { Some("failed") => true; _ => false }
        let is_run_or_block = running != 0 || (match st_opt { Some("run") | Some("block") => true; _ => false })
        if mine != 1 {
          None
        } else if is_failed {
          Some("alert")
        } else if is_unread_one && !is_run_or_block {
          Some("done")
        } else if has_agents || unread_explicit || has_ask_fields {
          None
        } else {
          prev_tone
        }
      }
    }
  }
  let desk = match base_codec::json_get(merged, "desk") {
    Some(base_codec::Json::Bool(b)) => if b { 1 } else { 0 }
    Some(base_codec::Json::Num(v, _)) => v.to_int()
    _ => match existing { Some(r) => sql::col_int(r, 7); None => 0 }
  }
  // Strictly strip `"unread"` from `chat.json` (1:1 with `client/core-ts/src/db/chats.ts:128-129`).
  let raw = base_codec::json_stringify(j_without_keys(merged, ["unread"]))
  match b.run(sql_chat_upsert(), params=[
    base_codec::json_str(station),
    base_codec::json_str(cid),
    base_codec::json_int(archived),
    base_codec::json_num(ord),
    opt_i64_json(thread),
    opt_str_json(session),
    opt_str_json(client_key),
    base_codec::json_int64(last_active),
    opt_i64_json(pinned_at),
    opt_i64_json(unread),
    base_codec::json_int(mine),
    base_codec::json_int(running),
    opt_str_json(tone),
    base_codec::json_int(asks),
    base_codec::json_int(desk),
    base_codec::json_str(raw),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => sql::SqlResult::Ok(cid)
  }
}

/// Write a thread row 1:1 with `SessionsThreadsStore.#putThreadRow` (`sessions-threads.ts:395-439`).
fn put_thread_in_burst(
  b : sql::Burst,
  station : String,
  view : base_codec::Json,
  listed_override : Option[Int],
) -> sql::SqlResult[Unit] {
  let id = match j_opt_u64(view, "id") {
    Some(v) => v.to_int()
    None => return sql::SqlResult::Ok(())
  }
  let existing_listed = match b.all("SELECT listed FROM thread WHERE station = ? AND id = ?", params=[
    base_codec::json_str(station),
    base_codec::json_int(id),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => if rows.length() > 0 { Some(sql::col_int(rows[0], 0)) } else { None }
  }
  let is_listed = match listed_override {
    Some(l) => l
    None => match existing_listed { Some(l) => l; None => 0 }
  }
  let last_col = j_opt_u64(view, "last")
  let read_col = j_opt_u64(view, "read")
  let unread_col = j_opt_u64(view, "unread")
  let sort_at = match base_codec::json_get(view, "lastMessage") {
    Some(lm) => j_int64(lm, "createdAt")
    None => 0.to_int64()
  }
  let created_at = j_int64(view, "createdAt")
  let surface = j_opt_str(view, "surface")
  let members = members_of(view)
  let first_member = if members.length() > 0 { Some(members[0]) } else { None }
  let rest = j_without_keys(view, ["last", "read", "unread"])
  let raw_json = base_codec::json_stringify(rest)
  match b.run(sql_thread_upsert(), params=[
    base_codec::json_str(station),
    base_codec::json_int(id),
    base_codec::json_int(is_listed),
    opt_i64_json(last_col),
    opt_i64_json(read_col),
    opt_i64_json(unread_col),
    base_codec::json_int64(sort_at),
    base_codec::json_int64(created_at),
    opt_str_json(surface),
    opt_str_json(first_member),
    base_codec::json_str(raw_json),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  match b.run("DELETE FROM thread_member WHERE station = ? AND thread = ?", params=[
    base_codec::json_str(station),
    base_codec::json_int(id),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  let seen_m : Map[String, Bool] = Map::new()
  for i in 0..<members.length() {
    let m = members[i]
    if seen_m.get(m).is_none() {
      seen_m.set(m, true)
      match b.run("INSERT OR IGNORE INTO thread_member (station, session, thread) VALUES (?, ?, ?)", params=[
        base_codec::json_str(station),
        base_codec::json_str(m),
        base_codec::json_int(id),
      ]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
  }
  sql::SqlResult::Ok(())
}

/// Read an existing thread row and reconstruct its full JSON (merging `last`/`read`/`unread` columns).
fn read_thread_view_in_burst(b : sql::Burst, station : String, id : Int) -> sql::SqlResult[Option[(Int, base_codec::Json)]] {
  match b.all("SELECT listed, json, last, read, unread FROM thread WHERE station = ? AND id = ?", params=[
    base_codec::json_str(station),
    base_codec::json_int(id),
  ]) {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      if rows.length() == 0 {
        return sql::SqlResult::Ok(None)
      }
      let r = rows[0]
      let listed = sql::col_int(r, 0)
      let parsed = match base_codec::json_parse(sql::col_text(r, 1)) {
        base_codec::JsonParseResult::Ok(j) => j
        base_codec::JsonParseResult::Err(_) => return sql::SqlResult::Ok(None)
      }
      let mut merged = parsed
      match sql::col_opt_int64(r, 2) { Some(v) => { merged = j_set_field(merged, "last", base_codec::json_int64(v)) }; None => () }
      match sql::col_opt_int64(r, 3) { Some(v) => { merged = j_set_field(merged, "read", base_codec::json_int64(v)) }; None => () }
      match sql::col_opt_int64(r, 4) { Some(v) => { merged = j_set_field(merged, "unread", base_codec::json_int64(v)) }; None => () }
      sql::SqlResult::Ok(Some((listed, merged)))
    }
  }
}

/// 1:1 with `SessionsThreadsStore.putSummary` (`sessions-threads.ts:154-196`).
fn StationEvents::put_summary_in_burst(
  self : StationEvents,
  b : sql::Burst,
  summary : base_codec::Json,
) -> sql::SqlResult[Option[(String, Bool)]] {
  let key = match j_opt_str(summary, "key") {
    Some(k) => if k.length() > 0 { k } else { return sql::SqlResult::Ok(None) }
    None => return sql::SqlResult::Ok(None)
  }
  let existing = match b.all("SELECT ord, summary, listed FROM session WHERE station = ? AND key = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(key),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => if rows.length() > 0 { Some(rows[0]) } else { None }
  }
  let list_known = match b.all("SELECT 1 FROM list WHERE station = ? AND list = 'sessions'", params=[
    base_codec::json_str(self.station),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => rows.length() > 0
  }
  let shown = j_is_null_or_absent(summary, "archivedAt")
  let old_listed = match existing { Some(r) => sql::col_int(r, 2); None => 0 }
  let listed = if shown && list_known {
    1
  } else if existing.is_some() && !shown {
    0
  } else {
    old_listed
  }
  let mut ord = match existing { Some(r) => sql::col_double(r, 0); None => 0.0 }
  if listed == 1 && (existing.is_none() || old_listed != 1) {
    match b.all("SELECT min(ord) FROM session WHERE station = ? AND listed = 1", params=[base_codec::json_str(self.station)]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(mrows) => {
        let min_ord = if mrows.length() > 0 {
          match mrows[0][0] {
            base_codec::Json::Num(v, _) => v
            _ => 1.0
          }
        } else {
          1.0
        }
        ord = min_ord - 1.0
      }
    }
  }
  let raw_json = base_codec::json_stringify(summary)
  let unchanged = match existing {
    Some(r) => sql::col_text(r, 1) == raw_json && old_listed == listed
    None => false
  }
  let last_active = match j_opt_int64(summary, "lastActiveAt") {
    Some(v) => Some(v)
    None => j_opt_int64(summary, "lastActive")
  }
  let process = j_opt_str(summary, "process")
  let connect = j_opt_str(summary, "connect")
  let archived_at = j_opt_int64(summary, "archivedAt")
  let turns = j_opt_u64(summary, "turns")
  let running = match process { Some(p) => p == "running"; None => j_bool(summary, "running") }
  if !unchanged {
    match b.run(sql_session_upsert(), params=[
      base_codec::json_str(self.station),
      base_codec::json_str(key),
      base_codec::json_int(listed),
      base_codec::json_num(ord),
      opt_i64_json(last_active),
      opt_str_json(process),
      opt_str_json(connect),
      opt_i64_json(archived_at),
      opt_i64_json(turns),
      base_codec::json_str(raw_json),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
  }
  self.track_session(SessionStatus::{
    key: key,
    running: running,
    listed: listed == 1,
    last_active: last_active,
    process: process,
    connect: connect,
    turns: turns,
  })
  sql::SqlResult::Ok(Some((key, running)))
}

/// 1:1 with `SessionsThreadsStore.setRead` + `ChatsStore.readRows` (`sessions-threads.ts:524-540`, `chats.ts:581-591`).
/// Never inserts a synthetic/zeroed `thread` row if none exists.
fn set_read_in_burst(
  b : sql::Burst,
  station : String,
  thread : Int,
  n : Int,
) -> sql::SqlResult[Option[(Int, Int)]] {
  let mut result_pos : Option[(Int, Int)] = None
  match b.all("SELECT read, last FROM thread WHERE station = ? AND id = ?", params=[
    base_codec::json_str(station),
    base_codec::json_int(thread),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      if rows.length() > 0 {
        let cur_read = sql::col_opt_int64(rows[0], 0)
        let cur_last = sql::col_opt_int64(rows[0], 1)
        let already_past = match cur_read {
          Some(r) => r >= n.to_int64()
          None => false
        }
        if !already_past {
          let covers_last = match cur_last {
            None => true
            Some(l) => n.to_int64() >= l
          }
          if covers_last {
            match b.run("UPDATE thread SET read = ?, unread = 0 WHERE station = ? AND id = ?", params=[
              base_codec::json_int(n),
              base_codec::json_str(station),
              base_codec::json_int(thread),
            ]) {
              sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
              sql::SqlResult::Ok(_) => ()
            }
            result_pos = Some((n, 0))
          } else {
            match b.run("UPDATE thread SET read = ? WHERE station = ? AND id = ?", params=[
              base_codec::json_int(n),
              base_codec::json_str(station),
              base_codec::json_int(thread),
            ]) {
              sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
              sql::SqlResult::Ok(_) => ()
            }
            result_pos = Some((n, -1))
          }
        }
      }
    }
  }
  // Mirror `ChatsStore.readRows`: clear unread on matching active `chat` rows when `n >= last.seq`.
  match b.all("SELECT id, json FROM chat WHERE station = ? AND archived = 0 AND thread = ? AND unread = 1", params=[
    base_codec::json_str(station),
    base_codec::json_int(thread),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(crows) => {
      for i in 0..<crows.length() {
        let cid = sql::col_text(crows[i], 0)
        let cjson = sql::col_text(crows[i], 1)
        match base_codec::json_parse(cjson) {
          base_codec::JsonParseResult::Ok(cj) => {
            let last_seq = match base_codec::json_get(cj, "last") {
              Some(lm) => j_opt_u64(lm, "seq")
              None => None
            }
            let skip = match last_seq {
              Some(ls) => n.to_int64() < ls
              None => false
            }
            if !skip {
              let updated = j_without_keys(cj, ["unread"])
              match b.run("UPDATE chat SET unread = 0, json = ? WHERE station = ? AND archived = 0 AND id = ?", params=[
                base_codec::json_str(base_codec::json_stringify(updated)),
                base_codec::json_str(station),
                base_codec::json_str(cid),
              ]) {
                sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                sql::SqlResult::Ok(_) => ()
              }
            }
          }
          base_codec::JsonParseResult::Err(_) => ()
        }
      }
    }
  }
  sql::SqlResult::Ok(result_pos)
}

/// Update a boolean field (`hidden` or `muted`) on all `chat` rows of `(station, thread)`.
fn patch_chats_for_thread_bool_in_burst(
  b : sql::Burst,
  station : String,
  thread : Int,
  field : String,
  flag_val : Bool,
) -> sql::SqlResult[Array[String]] {
  let changed : Array[String] = []
  match b.all("SELECT archived, id, json FROM chat WHERE station = ? AND thread = ?", params=[
    base_codec::json_str(station),
    base_codec::json_int(thread),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      for i in 0..<rows.length() {
        let arch = sql::col_int(rows[i], 0)
        let cid = sql::col_text(rows[i], 1)
        match base_codec::json_parse(sql::col_text(rows[i], 2)) {
          base_codec::JsonParseResult::Ok(cj) => {
            let updated = j_set_field(cj, field, base_codec::json_bool(flag_val))
            match b.run("UPDATE chat SET json = ? WHERE station = ? AND archived = ? AND id = ?", params=[
              base_codec::json_str(base_codec::json_stringify(updated)),
              base_codec::json_str(station),
              base_codec::json_int(arch),
              base_codec::json_str(cid),
            ]) {
              sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
              sql::SqlResult::Ok(_) => changed.push(cid)
            }
          }
          base_codec::JsonParseResult::Err(_) => ()
        }
      }
    }
  }
  sql::SqlResult::Ok(changed)
}

/// Ingest an initial snapshot (`chats`, `threads`, `entries`, `sessions`, `jobs`) in a single `sql::Burst` transaction
/// and emit coalesced `CoreEvent` notifications to `FrameOutbox`.
pub fn StationEvents::apply_snapshot(self : StationEvents, snapshot : base_codec::Json) -> sql::SqlResult[Int] {
  let changed_chats : Array[String] = []
  let added_entries : Array[(Int, store::Entry, Option[String])] = []
  let snap_events : Array[CoreEvent] = []
  let burst = sql::Burst::new(self.db)
  let res = burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Int] {
    let mut count = 0
    match base_codec::json_get(snapshot, "chats") {
      Some(base_codec::Json::Arr(chats)) => {
        for i in 0..<chats.length() {
          match upsert_chat_in_burst(b, self.station, chats[i]) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(cid) => {
              changed_chats.push(cid)
              count += 1
              match j_opt_str(chats[i], "clientKey") {
                Some(ck) => {
                  let cb = self.on_chat_client_key
                  cb(b, cid, ck)
                }
                None => ()
              }
            }
          }
        }
      }
      _ => ()
    }
    match base_codec::json_get(snapshot, "threads") {
      Some(base_codec::Json::Arr(threads)) => {
        for i in 0..<threads.length() {
          match put_thread_in_burst(b, self.station, threads[i], Some(1)) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => count += 1
          }
        }
      }
      _ => ()
    }
    match base_codec::json_get(snapshot, "entries") {
      Some(base_codec::Json::Arr(entries)) => {
        for i in 0..<entries.length() {
          let item = entries[i]
          let th = j_int(item, "thread")
          let n = j_int(item, "n")
          let raw = base_codec::json_stringify(item)
          match b.run(sql_entry_put(), params=[
            base_codec::json_str(self.station),
            base_codec::json_int(th),
            base_codec::json_int(n),
            base_codec::json_str(raw),
          ]) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => {
              let ck = match j_opt_str(item, "clientKey") {
                Some(k) => Some(k)
                None => j_opt_str(item, "idem")
              }
              match ck {
                Some(key) => {
                  let cb = self.on_entry_client_key
                  cb(b, th, n, key)
                }
                None => ()
              }
              added_entries.push((th, store::Entry::of_json(n, item), ck))
              count += 1
            }
          }
        }
      }
      _ => ()
    }
    match base_codec::json_get(snapshot, "sessions") {
      Some(base_codec::Json::Arr(sessions)) => {
        for i in 0..<sessions.length() {
          match self.put_summary_in_burst(b, sessions[i]) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(Some((skey, running))) => {
              snap_events.push(CoreEvent::SessionChanged(self.station, skey, running))
              count += 1
            }
            sql::SqlResult::Ok(None) => ()
          }
        }
      }
      _ => ()
    }
    match base_codec::json_get(snapshot, "jobs") {
      Some(base_codec::Json::Arr(jobs)) => {
        for i in 0..<jobs.length() {
          let payload = jobs[i]
          let jid = match j_id_text(payload, "id") { Some(s) => s; None => continue }
          let sess = j_opt_str(payload, "session")
          let st = j_str(payload, "state")
          let open = st == "running" || (st == "exited" && !j_is_null_or_absent(payload, "port")) || j_bool(payload, "open")
          let ord = j_double(payload, "ord")
          let chat = match base_codec::json_get(payload, "chat") {
            Some(base_codec::Json::Null) | None => None
            Some(base_codec::Json::Str(s)) => Some(s)
            Some(v) => Some(base_codec::json_stringify(v))
          }
          let job_only = j_without_keys(payload, ["chat"])
          let raw = base_codec::json_stringify(job_only)
          match b.run(sql_job_upsert(), params=[
            base_codec::json_str(self.station),
            base_codec::json_str(jid),
            opt_str_json(sess),
            base_codec::json_int(if open { 1 } else { 0 }),
            base_codec::json_num(ord),
            opt_str_json(chat),
            base_codec::json_str(raw),
          ]) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => {
              self.track_job(JobStatus::{ id: jid, session: sess, open: open, chat: chat })
              snap_events.push(CoreEvent::JobChanged(self.station, jid, open))
              count += 1
            }
          }
        }
      }
      _ => ()
    }
    sql::SqlResult::Ok(count)
  })
  match res {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(count) => {
      if changed_chats.length() > 0 {
        self.outbox.tell(CoreEvent::ChatsChanged(self.station, changed_chats))
      }
      for i in 0..<added_entries.length() {
        let (th, entry, ck) = added_entries[i]
        self.outbox.tell(CoreEvent::EntryAdded(self.station, th, entry, ck))
      }
      for i in 0..<snap_events.length() {
        self.outbox.tell(snap_events[i])
      }
      sql::SqlResult::Ok(count)
    }
  }
}

fn StationEvents::apply_sse_thread(
  self : StationEvents,
  b : sql::Burst,
  payload : base_codec::Json,
  pending_events : Array[CoreEvent],
  newly_dirty : Array[Int],
) -> sql::SqlResult[Int] {
  let id = match j_opt_u64(payload, "id") {
    Some(v) => v.to_int()
    None => return sql::SqlResult::Ok(0)
  }
  let entries : Array[base_codec::Json] = match base_codec::json_get(payload, "entries") {
    Some(base_codec::Json::Arr(xs)) => xs
    _ => []
  }
  let existing_thread = match read_thread_view_in_burst(b, self.station, id) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(v) => v
  }
  let mut newest : Int = -1
  for ei in 0..<entries.length() {
    let item = entries[ei]
    let n = match j_opt_u64(item, "n") {
      Some(v) => v.to_int()
      None => continue
    }
    if n > newest {
      newest = n
    }
    let raw = base_codec::json_stringify(item)
    match b.run(sql_entry_put(), params=[
      base_codec::json_str(self.station),
      base_codec::json_int(id),
      base_codec::json_int(n),
      base_codec::json_str(raw),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => {
        let ck = match j_opt_str(item, "clientKey") {
          Some(k) => Some(k)
          None => j_opt_str(item, "idem")
        }
        match ck {
          Some(key) => {
            let cb = self.on_entry_client_key
            cb(b, id, n, key)
          }
          None => ()
        }
        pending_events.push(CoreEvent::EntryAdded(self.station, id, store::Entry::of_json(n, item), ck))
      }
    }
  }
  match existing_thread {
    Some((listed, before_view)) => {
      let mut updated_via_after = false
      if self.viewer_email.length() > 0 {
        match thread_after(before_view, entries, self.viewer_email) {
          Some(next_view) => {
            match put_thread_in_burst(b, self.station, next_view, Some(listed)) {
              sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
              sql::SqlResult::Ok(_) => {
                updated_via_after = true
                self.dirty_threads.remove(id)
              }
            }
          }
          None => ()
        }
      }
      // Strictly match `sync.ts:1888-1890`: when `thread_after` returns `None` (gap, card, delete, etc.),
      // NEVER blindly advance `thread.last`; only mark the thread dirty so its summary is refetched.
      if !updated_via_after && newest >= 0 {
        let cur_last = match j_opt_u64(before_view, "last") { Some(v) => v.to_int(); None => -1 }
        if newest > cur_last || cur_last < 0 {
          self.dirty_threads.set(id, true)
          newly_dirty.push(id)
        }
      }
    }
    None => {
      if newest >= 0 {
        self.dirty_threads.set(id, true)
        newly_dirty.push(id)
      }
    }
  }
  sql::SqlResult::Ok(1)
}

fn StationEvents::apply_sse_pin(
  self : StationEvents,
  b : sql::Burst,
  payload : base_codec::Json,
  changed_chats : Array[String],
) -> sql::SqlResult[Int] {
  let sess = match j_opt_str(payload, "session") { Some(s) => s; None => return sql::SqlResult::Ok(0) }
  let at_val = j_opt_u64(payload, "at")
  let mark_v = match at_val { Some(v) => Some(v.to_string()); None => None }
  match upsert_shared_mark_in_burst(b, self.station, "pin", sess, mark_v) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  match b.all("SELECT archived, id, json FROM chat WHERE station = ? AND (id = ? OR session = ?)", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(sess),
    base_codec::json_str(sess),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      for ri in 0..<rows.length() {
        let arch = sql::col_int(rows[ri], 0)
        let cid = sql::col_text(rows[ri], 1)
        match base_codec::json_parse(sql::col_text(rows[ri], 2)) {
          base_codec::JsonParseResult::Ok(cj) => {
            let updated = j_set_field(cj, "pinned", opt_i64_json(at_val))
            match b.run("UPDATE chat SET pinned_at = ?, json = ? WHERE station = ? AND archived = ? AND id = ?", params=[
              opt_i64_json(at_val),
              base_codec::json_str(base_codec::json_stringify(updated)),
              base_codec::json_str(self.station),
              base_codec::json_int(arch),
              base_codec::json_str(cid),
            ]) {
              sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
              sql::SqlResult::Ok(_) => changed_chats.push(cid)
            }
          }
          base_codec::JsonParseResult::Err(_) => ()
        }
      }
    }
  }
  sql::SqlResult::Ok(1)
}

fn StationEvents::apply_sse_session_pending(
  self : StationEvents,
  b : sql::Burst,
  payload : base_codec::Json,
  pending_events : Array[CoreEvent],
) -> sql::SqlResult[Int] {
  let key = match j_opt_str(payload, "key") { Some(s) => s; None => return sql::SqlResult::Ok(0) }
  let pending = match j_opt_u64(payload, "pending") { Some(v) => v; None => return sql::SqlResult::Ok(0) }
  match b.all("SELECT summary FROM session WHERE station = ? AND key = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(key),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => {
      if rows.length() > 0 {
        match base_codec::json_parse(sql::col_text(rows[0], 0)) {
          base_codec::JsonParseResult::Ok(held) => {
            let prev_pending = j_opt_u64(held, "pending")
            let same_pending = match prev_pending {
              Some(v) => v == pending
              None => false
            }
            if !same_pending {
              let prev_n = match prev_pending { Some(v) => v; None => 0.to_int64() }
              let taken = pending < prev_n
              let mut now_j = j_set_field(held, "pending", base_codec::json_int64(pending))
              if taken {
                now_j = j_set_field(now_j, "process", base_codec::json_str("running"))
              }
              now_j = j_set_field(now_j, "startFailed", base_codec::json_bool(false))
              match self.put_summary_in_burst(b, now_j) {
                sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                sql::SqlResult::Ok(Some((skey, running))) => {
                  pending_events.push(CoreEvent::SessionChanged(self.station, skey, running))
                }
                sql::SqlResult::Ok(None) => ()
              }
            }
          }
          base_codec::JsonParseResult::Err(_) => ()
        }
      }
    }
  }
  sql::SqlResult::Ok(1)
}

fn StationEvents::apply_sse_session_removed(
  self : StationEvents,
  b : sql::Burst,
  payload : base_codec::Json,
  pending_events : Array[CoreEvent],
) -> sql::SqlResult[Int] {
  let key = match j_opt_str(payload, "key") { Some(s) => s; None => return sql::SqlResult::Ok(0) }
  if key.length() == 0 {
    return sql::SqlResult::Ok(0)
  }
  match b.run("DELETE FROM session WHERE station = ? AND key = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(key),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  match b.all("SELECT thread FROM thread_member WHERE station = ? AND session = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(key),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(trows) => {
      for ti in 0..<trows.length() {
        let tid = sql::col_int(trows[ti], 0)
        match read_thread_view_in_burst(b, self.station, tid) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(Some((listed, tview))) => {
            let kept_sessions : Array[base_codec::Json] = []
            match base_codec::json_get(tview, "sessions") {
              Some(base_codec::Json::Arr(xs)) => {
                for si in 0..<xs.length() {
                  let is_removed = match j_opt_str(xs[si], "session") {
                    Some(s) => s == key
                    None => false
                  }
                  if !is_removed {
                    kept_sessions.push(xs[si])
                  }
                }
              }
              _ => ()
            }
            if kept_sessions.length() == 0 {
              match b.run("DELETE FROM thread WHERE station = ? AND id = ?", params=[
                base_codec::json_str(self.station),
                base_codec::json_int(tid),
              ]) {
                sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                sql::SqlResult::Ok(_) => ()
              }
              match b.run("DELETE FROM thread_member WHERE station = ? AND thread = ?", params=[
                base_codec::json_str(self.station),
                base_codec::json_int(tid),
              ]) {
                sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                sql::SqlResult::Ok(_) => ()
              }
            } else {
              let next_t = j_set_field(tview, "sessions", base_codec::json_arr(kept_sessions))
              match put_thread_in_burst(b, self.station, next_t, Some(listed)) {
                sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                sql::SqlResult::Ok(_) => ()
              }
            }
          }
          sql::SqlResult::Ok(None) => ()
        }
      }
    }
  }
  match b.run("DELETE FROM thread_member WHERE station = ? AND session = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(key),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  match b.run("DELETE FROM transcript WHERE station = ? AND session = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(key),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  match b.run("UPDATE job SET open = 0 WHERE station = ? AND open = 1 AND session = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(key),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  self.sessions.remove(key)
  pending_events.push(CoreEvent::SessionChanged(self.station, key, false))
  sql::SqlResult::Ok(1)
}

fn StationEvents::apply_sse_thread_removed(
  self : StationEvents,
  b : sql::Burst,
  payload : base_codec::Json,
  changed_chats : Array[String],
) -> sql::SqlResult[Int] {
  let id = match j_opt_u64(payload, "id") { Some(v) => v.to_int(); None => return sql::SqlResult::Ok(0) }
  match b.run("DELETE FROM thread WHERE station = ? AND id = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_int(id),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  match b.run("DELETE FROM thread_member WHERE station = ? AND thread = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_int(id),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  match b.run("DELETE FROM entry WHERE station = ? AND thread = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_int(id),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  match b.all("SELECT id FROM chat WHERE station = ? AND thread = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_int(id),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(crows) => {
      for ci in 0..<crows.length() {
        changed_chats.push(sql::col_text(crows[ci], 0))
      }
    }
  }
  match b.run("DELETE FROM chat WHERE station = ? AND thread = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_int(id),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => ()
  }
  sql::SqlResult::Ok(1)
}

fn StationEvents::apply_sse_job(
  self : StationEvents,
  b : sql::Burst,
  payload : base_codec::Json,
  pending_events : Array[CoreEvent],
) -> sql::SqlResult[Int] {
  let jid = match j_id_text(payload, "id") { Some(s) => s; None => return sql::SqlResult::Ok(0) }
  let sess = match j_opt_str(payload, "session") { Some(s) => s; None => return sql::SqlResult::Ok(0) }
  let st = j_str(payload, "state")
  let open = st == "running" || (st == "exited" && !j_is_null_or_absent(payload, "port"))
  let existing = match b.all("SELECT ord, json, chat, open FROM job WHERE station = ? AND id = ?", params=[
    base_codec::json_str(self.station),
    base_codec::json_str(jid),
  ]) {
    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
    sql::SqlResult::Ok(rows) => if rows.length() > 0 { Some(rows[0]) } else { None }
  }
  let was_open = match existing { Some(r) => sql::col_int(r, 3) == 1; None => false }
  let now_open = if open && was_open { 1 } else { 0 }
  let ord = match existing { Some(r) => sql::col_double(r, 0); None => 0.0 }
  let chat = match existing { Some(r) => sql::col_opt_text(r, 2); None => None }
  let raw = base_codec::json_stringify(payload)
  let unchanged = match existing {
    Some(r) => sql::col_text(r, 1) == raw && sql::col_int(r, 3) == now_open
    None => false
  }
  if !unchanged {
    match b.run(sql_job_upsert(), params=[
      base_codec::json_str(self.station),
      base_codec::json_str(jid),
      base_codec::json_str(sess),
      base_codec::json_int(now_open),
      base_codec::json_num(ord),
      opt_str_json(chat),
      base_codec::json_str(raw),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
  }
  self.track_job(JobStatus::{ id: jid, session: Some(sess), open: now_open == 1, chat: chat })
  pending_events.push(CoreEvent::JobChanged(self.station, jid, now_open == 1))
  sql::SqlResult::Ok(1)
}

fn StationEvents::apply_one_sse_event(
  self : StationEvents,
  b : sql::Burst,
  ev_name : String,
  payload : base_codec::Json,
  changed_chats : Array[String],
  pending_events : Array[CoreEvent],
  missed_flag : Array[Bool],
  marks_dirty : Array[(String, base_codec::Json)],
  newly_dirty : Array[Int],
  lock_payloads : Array[base_codec::Json],
) -> sql::SqlResult[Int] {
  if ev_name == "thread" {
    return self.apply_sse_thread(b, payload, pending_events, newly_dirty)
  }
  if ev_name == "read" {
    let th = match j_opt_u64(payload, "thread") { Some(v) => v.to_int(); None => return sql::SqlResult::Ok(0) }
    let n = match j_opt_u64(payload, "n") { Some(v) => v.to_int(); None => return sql::SqlResult::Ok(0) }
    match set_read_in_burst(b, self.station, th, n) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(pos_opt) => {
        match pos_opt {
          Some((rn, un)) => {
            let unread_ev = if un < 0 { 0 } else { un }
            pending_events.push(CoreEvent::ThreadReadChanged(self.station, th, rn, unread_ev))
          }
          None => ()
        }
        return sql::SqlResult::Ok(1)
      }
    }
  }
  if ev_name == "hidden" || ev_name == "muted" {
    let th = match j_opt_u64(payload, "thread") { Some(v) => v.to_int(); None => return sql::SqlResult::Ok(0) }
    let flag_v = match j_opt_bool(payload, ev_name) { Some(v) => v; None => return sql::SqlResult::Ok(0) }
    let mark_v = if flag_v { Some("1") } else { None }
    match upsert_shared_mark_in_burst(b, self.station, ev_name, th.to_string(), mark_v) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    match patch_chats_for_thread_bool_in_burst(b, self.station, th, ev_name, flag_v) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(ids) => {
        for ci in 0..<ids.length() { changed_chats.push(ids[ci]) }
        return sql::SqlResult::Ok(1)
      }
    }
  }
  if ev_name == "kept" {
    let th = match j_opt_u64(payload, "thread") { Some(v) => v.to_int(); None => return sql::SqlResult::Ok(0) }
    let flag_v = match j_opt_bool(payload, "kept") { Some(v) => v; None => return sql::SqlResult::Ok(0) }
    let mark_v = if flag_v { Some("1") } else { None }
    match upsert_shared_mark_in_burst(b, self.station, "kept", th.to_string(), mark_v) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    changed_chats.push("thread:" + th.to_string())
    return sql::SqlResult::Ok(1)
  }
  if ev_name == "pin" {
    return self.apply_sse_pin(b, payload, changed_chats)
  }
  if ev_name == "dismiss" {
    let th = match j_opt_u64(payload, "thread") { Some(v) => v.to_int(); None => return sql::SqlResult::Ok(0) }
    let n = match j_opt_u64(payload, "n") { Some(v) => v.to_int(); None => return sql::SqlResult::Ok(0) }
    let dk = th.to_string() + ":" + n.to_string()
    match upsert_shared_mark_in_burst(b, self.station, "dismissed", dk, Some("1")) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    // Synchronously mark matching `card`/`decision`/`need` (`seq == n`) dismissed in `chat.json`
    // and recompute `chat.asks` in the same transaction (1:1 `decisions.ts:339-345` `withLetGo`).
    let chat_rows = match b.all(
      "SELECT id, json FROM chat WHERE station = ? AND archived = 0 AND thread = ?",
      params=[base_codec::json_str(self.station), base_codec::json_int(th)],
    ) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(rs) => rs
    }
    for ci in 0..<chat_rows.length() {
      let cid = sql::col_text(chat_rows[ci], 0)
      match base_codec::json_parse(sql::col_text(chat_rows[ci], 1)) {
        base_codec::JsonParseResult::Ok(cj) => {
          let mut updated = cj
          let ask_keys = ["card", "decision", "need"]
          for ki in 0..<ask_keys.length() {
            let ak = ask_keys[ki]
            match base_codec::json_get(updated, ak) {
              Some(base_codec::Json::Obj(sub_fs)) => {
                let sub = base_codec::json_obj(sub_fs)
                match j_opt_u64(sub, "seq") {
                  Some(sv) =>
                  if sv.to_int() == n {
                    updated = j_set_field(updated, ak, j_set_field(sub, "dismissed", base_codec::json_bool(true)))
                  }
                  None => ()
                }
              }
              _ => ()
            }
          }
          let new_asks = if views::is_led_subchat(updated) { 0 } else if views::undecided_of_row(updated).length() > 0 { 1 } else { 0 }
          match b.run(
            "UPDATE chat SET json = ?, asks = ? WHERE station = ? AND archived = 0 AND id = ?",
            params=[
              base_codec::json_str(base_codec::json_stringify(updated)),
              base_codec::json_int(new_asks),
              base_codec::json_str(self.station),
              base_codec::json_str(cid),
            ],
          ) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => changed_chats.push(cid)
          }
        }
        base_codec::JsonParseResult::Err(_) => ()
      }
    }
    changed_chats.push("thread:" + th.to_string())
    return sql::SqlResult::Ok(1)
  }
  if ev_name == "session" {
    match self.put_summary_in_burst(b, payload) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(Some((skey, running))) => {
        pending_events.push(CoreEvent::SessionChanged(self.station, skey, running))
        return sql::SqlResult::Ok(1)
      }
      sql::SqlResult::Ok(None) => return sql::SqlResult::Ok(0)
    }
  }
  if ev_name == "session-pending" {
    return self.apply_sse_session_pending(b, payload, pending_events)
  }
  if ev_name == "session-removed" {
    return self.apply_sse_session_removed(b, payload, pending_events)
  }
  if ev_name == "thread-removed" {
    return self.apply_sse_thread_removed(b, payload, changed_chats)
  }
  if ev_name == "chat-shared" {
    let cid = match j_opt_str(payload, "id") { Some(s) => s; None => return sql::SqlResult::Ok(0) }
    match upsert_chat_shared_in_burst(b, self.station, self.viewer_email, self.viewer_selves, payload) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => {
        changed_chats.push(cid)
        match j_opt_str(payload, "clientKey") {
          Some(ck) => {
            let cb = self.on_chat_client_key
            cb(b, cid, ck)
          }
          None => ()
        }
        return sql::SqlResult::Ok(1)
      }
    }
  }
  if ev_name == "chat-shared-removed" {
    let cid = match j_opt_str(payload, "id") { Some(s) => s; None => return sql::SqlResult::Ok(0) }
    match b.run("DELETE FROM shared_sidecar WHERE station = ? AND id = ?", params=[
      base_codec::json_str(self.station),
      base_codec::json_str(cid),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    // NEVER delete archived=1 rows on `chat-shared-removed`!
    match b.run("DELETE FROM chat WHERE station = ? AND archived = 0 AND id = ?", params=[
      base_codec::json_str(self.station),
      base_codec::json_str(cid),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => {
        changed_chats.push(cid)
        return sql::SqlResult::Ok(1)
      }
    }
  }
  if ev_name == "missed" {
    missed_flag[0] = true
    return sql::SqlResult::Ok(1)
  }
  if ev_name == "chat-changed" || ev_name == "chat-mark" || ev_name == "said" || ev_name == "made" {
    if ev_name == "chat-changed" {
      match j_opt_u64(payload, "thread") {
        Some(th) => {
          let tid = th.to_int()
          self.dirty_threads.set(tid, true)
          newly_dirty.push(tid)
        }
        None => ()
      }
    }
    marks_dirty.push((ev_name, payload))
    let tag = match j_opt_str(payload, "session") {
      Some(s) => s
      None =>
      match j_opt_u64(payload, "thread") {
        Some(th) => "thread:" + th.to_string()
        None =>
        match j_opt_u64(payload, "id") {
          Some(th) => "thread:" + th.to_string()
          None => ev_name
        }
      }
    }
    changed_chats.push(tag)
    return sql::SqlResult::Ok(1)
  }
  if ev_name == "job" {
    return self.apply_sse_job(b, payload, pending_events)
  }
  if ev_name == "job-removed" {
    let jid = match j_id_text(payload, "id") { Some(s) => s; None => return sql::SqlResult::Ok(0) }
    match b.run("DELETE FROM job WHERE station = ? AND id = ?", params=[
      base_codec::json_str(self.station),
      base_codec::json_str(jid),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => {
        self.jobs.remove(jid)
        pending_events.push(CoreEvent::JobChanged(self.station, jid, false))
        return sql::SqlResult::Ok(1)
      }
    }
  }
  if ev_name == "lock" {
    if is_actionable_lock_payload(payload) {
      lock_payloads.push(payload)
      return sql::SqlResult::Ok(1)
    }
    return sql::SqlResult::Ok(0)
  }
  if ev_name == "overview" {
    let raw = base_codec::json_stringify(payload)
    match b.run(sql_station_overview_upsert(), params=[
      base_codec::json_str(self.station),
      base_codec::json_str(raw),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => return sql::SqlResult::Ok(1)
    }
  }
  sql::SqlResult::Ok(0)
}

fn push_unique_str(xs : Array[String], seen : Map[String, Bool], v : String) -> Unit {
  if v.length() > 0 && seen.get(v).is_none() {
    seen.set(v, true)
    xs.push(v)
  }
}

/// Apply a real `GET /chats?marks=1&own=1` payload atomically into SQLite `shared_mark`
/// (and patch matching `chat`/`thread` rows in the same `sql::Burst` transaction),
/// then invoke `on_marks_applied` so `ClientCore::viewer_marks` stays synchronized and
/// only affected `(station, id)` / `thread` entries refresh.
pub fn StationEvents::apply_marks_to_db(
  self : StationEvents,
  payload : base_codec::Json,
  is_whole : Bool,
  scoped_sessions : Array[String] = [],
  scoped_threads : Array[Int] = [],
) -> sql::SqlResult[Array[String]] {
  let affected : Array[String] = []
  let seen : Map[String, Bool] = Map::new()
  let burst = sql::Burst::new(self.db)
  let res = burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
    let old_hidden : Array[Int] = []
    let old_muted : Array[Int] = []
    if is_whole {
      match b.all("SELECT kind, k FROM shared_mark WHERE station = ? AND kind IN ('hidden', 'muted')", params=[base_codec::json_str(self.station)]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(rows) => {
          for i in 0..<rows.length() {
            let kind = sql::col_text(rows[i], 0)
            match base_codec::parse_int64_str(sql::col_text(rows[i], 1)) {
              Some(th_i64) => {
                if kind == "hidden" {
                  old_hidden.push(th_i64.to_int())
                } else if kind == "muted" {
                  old_muted.push(th_i64.to_int())
                }
              }
              None => ()
            }
          }
        }
      }
      match b.run("DELETE FROM shared_mark WHERE station = ?", params=[base_codec::json_str(self.station)]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    } else {
      for si in 0..<scoped_sessions.length() {
        let sess = scoped_sessions[si]
        if sess.length() > 0 {
          match b.run(
            "DELETE FROM shared_mark WHERE station = ? AND kind = 'pin' AND k = ?",
            params=[base_codec::json_str(self.station), base_codec::json_str(sess)],
          ) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => ()
          }
          push_unique_str(affected, seen, sess)
        }
      }
      for ti in 0..<scoped_threads.length() {
        let tid = scoped_threads[ti]
        let tk = tid.to_string()
        match b.run(
          "DELETE FROM shared_mark WHERE station = ? AND kind IN ('read', 'kept', 'hidden', 'muted') AND k = ?",
          params=[base_codec::json_str(self.station), base_codec::json_str(tk)],
        ) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(_) => ()
        }
        match b.run(
          "DELETE FROM shared_mark WHERE station = ? AND kind = 'dismissed' AND k LIKE ?",
          params=[base_codec::json_str(self.station), base_codec::json_str(tk + ":%")],
        ) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(_) => ()
        }
        match patch_chats_for_thread_bool_in_burst(b, self.station, tid, "hidden", false) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(ids) => {
            for ci in 0..<ids.length() {
              push_unique_str(affected, seen, ids[ci])
            }
          }
        }
        match patch_chats_for_thread_bool_in_burst(b, self.station, tid, "muted", false) {
          sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
          sql::SqlResult::Ok(ids) => {
            for ci in 0..<ids.length() {
              push_unique_str(affected, seen, ids[ci])
            }
          }
        }
        push_unique_str(affected, seen, "thread:" + tk)
      }
    }
    match base_codec::json_get(payload, "reads") {
      Some(base_codec::Json::Obj(fs)) => {
        for i in 0..<fs.length() {
          let (th_s, val_j) = fs[i]
          match val_j {
            base_codec::Json::Num(n, _) => {
              let rn = n.to_int()
              match upsert_shared_mark_in_burst(b, self.station, "read", th_s, Some(rn.to_string())) {
                sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                sql::SqlResult::Ok(_) => ()
              }
              match base_codec::parse_int64_str(th_s) {
                Some(th_i64) => {
                  match set_read_in_burst(b, self.station, th_i64.to_int(), rn) {
                    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                    sql::SqlResult::Ok(_) => ()
                  }
                  push_unique_str(affected, seen, "thread:" + th_i64.to_string())
                }
                None => ()
              }
            }
            _ => ()
          }
        }
      }
      _ => ()
    }
    match base_codec::json_get(payload, "pins") {
      Some(base_codec::Json::Obj(fs)) => {
        for i in 0..<fs.length() {
          let (sess, val_j) = fs[i]
          let at_opt : Option[Int64] = match val_j {
            base_codec::Json::Num(n, repr) =>
            if repr.length() > 0 && !repr.contains(".") {
              match base_codec::parse_int64_str(repr) {
                Some(v) => Some(v)
                None => Some(n.to_int64())
              }
            } else {
              Some(n.to_int64())
            }
            _ => None
          }
          match at_opt {
            Some(at_v) => {
              match upsert_shared_mark_in_burst(b, self.station, "pin", sess, Some(at_v.to_string())) {
                sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                sql::SqlResult::Ok(_) => ()
              }
              push_unique_str(affected, seen, sess)
            }
            None => ()
          }
        }
      }
      _ => ()
    }
    let new_hidden : Map[Int, Bool] = Map::new()
    let new_muted : Map[Int, Bool] = Map::new()
    let bool_lists : Array[(String, String)] = [
      ("kept", "kept"),
      ("hidden", "hidden"),
      ("muted", "muted"),
    ]
    for bi in 0..<bool_lists.length() {
      let (field, kind) = bool_lists[bi]
      match base_codec::json_get(payload, field) {
        Some(base_codec::Json::Arr(xs)) => {
          for i in 0..<xs.length() {
            match xs[i] {
              base_codec::Json::Num(n, _) => {
                let th = n.to_int()
                match upsert_shared_mark_in_burst(b, self.station, kind, th.to_string(), Some("1")) {
                  sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                  sql::SqlResult::Ok(_) => ()
                }
                if kind == "hidden" {
                  new_hidden.set(th, true)
                } else if kind == "muted" {
                  new_muted.set(th, true)
                }
                if kind == "hidden" || kind == "muted" {
                  match patch_chats_for_thread_bool_in_burst(b, self.station, th, kind, true) {
                    sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                    sql::SqlResult::Ok(ids) => {
                      for ci in 0..<ids.length() {
                        push_unique_str(affected, seen, ids[ci])
                      }
                    }
                  }
                }
                push_unique_str(affected, seen, "thread:" + th.to_string())
              }
              _ => ()
            }
          }
        }
        _ => ()
      }
    }
    if is_whole {
      for i in 0..<old_hidden.length() {
        let th = old_hidden[i]
        if new_hidden.get(th).is_none() {
          match patch_chats_for_thread_bool_in_burst(b, self.station, th, "hidden", false) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(ids) => {
              for ci in 0..<ids.length() {
                push_unique_str(affected, seen, ids[ci])
              }
            }
          }
          push_unique_str(affected, seen, "thread:" + th.to_string())
        }
      }
      for i in 0..<old_muted.length() {
        let th = old_muted[i]
        if new_muted.get(th).is_none() {
          match patch_chats_for_thread_bool_in_burst(b, self.station, th, "muted", false) {
            sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
            sql::SqlResult::Ok(ids) => {
              for ci in 0..<ids.length() {
                push_unique_str(affected, seen, ids[ci])
              }
            }
          }
          push_unique_str(affected, seen, "thread:" + th.to_string())
        }
      }
    }
    match base_codec::json_get(payload, "dismissed") {
      Some(base_codec::Json::Arr(xs)) => {
        for i in 0..<xs.length() {
          match xs[i] {
            base_codec::Json::Str(dk) => {
              if dk.length() > 0 {
                match upsert_shared_mark_in_burst(b, self.station, "dismissed", dk, Some("1")) {
                  sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
                  sql::SqlResult::Ok(_) => ()
                }
                push_unique_str(affected, seen, "dismissed:" + dk)
              }
            }
            _ => ()
          }
        }
      }
      _ => ()
    }
    sql::SqlResult::Ok(())
  })
  match res {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(_) => {
      let cb = self.on_marks_applied
      cb(payload, is_whole, affected, scoped_sessions, scoped_threads)
      if affected.length() > 0 {
        self.outbox.tell(CoreEvent::ChatsChanged(self.station, affected))
      }
      sql::SqlResult::Ok(affected)
    }
  }
}

/// Apply a batch of parsed real Station SSE events in a SINGLE `sql::Burst` transaction,
/// matching `client/core-ts/src/station/sync.ts:1848-2164`.
/// Advances `self.last_event_id` ONLY after the SQLite transaction commits successfully.
pub fn StationEvents::apply_sse_batch(self : StationEvents, events : Array[wire::Event]) -> sql::SqlResult[Int] {
  if events.length() == 0 {
    return sql::SqlResult::Ok(0)
  }
  let changed_chats : Array[String] = []
  let pending_events : Array[CoreEvent] = []
  let missed_flag : Array[Bool] = [false]
  let marks_dirty : Array[(String, base_codec::Json)] = []
  let newly_dirty : Array[Int] = []
  let lock_payloads : Array[base_codec::Json] = []
  let mut pending_last_event_id : Option[String] = None
  let burst = sql::Burst::new(self.db)
  let res = burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Int] {
    let mut applied = 0
    for i in 0..<events.length() {
      let ev = events[i]
      match ev.id {
        Some(eid) => {
          if eid.length() > 0 {
            pending_last_event_id = Some(eid)
          }
        }
        None => ()
      }
      if ev.data.length() == 0 {
        continue
      }
      let payload = match base_codec::json_parse(ev.data) {
        base_codec::JsonParseResult::Ok(j) => j
        base_codec::JsonParseResult::Err(_) => continue
      }
      match j_opt_str(payload, "workspace") {
        Some(ws) => {
          if ws.length() > 0 && ws != self.workspace {
            continue
          }
        }
        None => ()
      }
      match self.apply_one_sse_event(b, ev.name, payload, changed_chats, pending_events, missed_flag, marks_dirty, newly_dirty, lock_payloads) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(n) => { applied += n }
      }
    }
    sql::SqlResult::Ok(applied)
  })
  match res {
    sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
    sql::SqlResult::Ok(applied) => {
      match pending_last_event_id {
        Some(eid) => self.last_event_id = Some(eid)
        None => ()
      }
      if changed_chats.length() > 0 {
        self.outbox.tell(CoreEvent::ChatsChanged(self.station, changed_chats))
      }
      for i in 0..<pending_events.length() {
        self.outbox.tell(pending_events[i])
      }
      for i in 0..<lock_payloads.length() {
        let _ = self.notify_lock_payload_result(lock_payloads[i])
      }
      for i in 0..<marks_dirty.length() {
        self.marks_dirty_count += 1
        let cb = self.on_marks_dirty
        cb(marks_dirty[i].0, marks_dirty[i].1)
      }
      for i in 0..<newly_dirty.length() {
        let cb = self.on_thread_dirty
        cb(newly_dirty[i])
      }
      if missed_flag[0] {
        self.resync_needed += 1
        let cb = self.on_missed
        cb()
      }
      sql::SqlResult::Ok(applied)
    }
  }
}

/// Runs directly inside `self.stream_fiber` (NEVER spawns an orphan reconnect fiber!).
/// Double-checks `self.stopped || effect::is_interrupted()` before and after backoff sleep.
fn StationEvents::schedule_reconnect_k(self : StationEvents, rt : effect::Runtime, k : (effect::Exit[Unit]) -> Unit) -> Unit {
  if self.stopped || effect::is_interrupted() {
    self.set_state(ConnectionState::Disconnected("stopped"))
    k(effect::Exit::Interrupted)
    return
  }
  // timer: failure retry backoff on dropped or failed SSE stream (never periodic polling).
  let delay = reconnect_backoff_ms(self.attempts)
  self.attempts += 1
  self.set_state(ConnectionState::Reconnecting(delay))
  effect::sleep_k(delay, fn(sex : effect::Exit[Unit]) -> Unit {
    if self.stopped || effect::is_interrupted() {
      self.set_state(ConnectionState::Disconnected("stopped"))
      k(effect::Exit::Interrupted)
      return
    }
    match sex {
      effect::Exit::Interrupted => {
        self.set_state(ConnectionState::Disconnected("stopped"))
        k(effect::Exit::Interrupted)
      }
      _ => self.stream_loop_k(rt, k)
    }
  })
}

/// Whether an SSE `event: lock` payload carries either inline lock entries (`entries: [...]`)
/// or a real station change notification (`{ workspace, head }` per `station/src/mesh/lock-events.ts:27`).
/// Empty `{}` and `{"entries":[]}` payloads are silently ignored without triggering `LockRejected`.
fn is_actionable_lock_payload(payload : base_codec::Json) -> Bool {
  match base_codec::json_get(payload, "entries") {
    Some(base_codec::Json::Arr(xs)) => {
      if xs.length() > 0 {
        return true
      }
    }
    _ => ()
  }
  base_codec::json_get(payload, "head").is_some()
}

fn StationEvents::dispatch_lock_sse_event(self : StationEvents, ev : wire::Event) -> Unit {
  if ev.data.length() == 0 {
    return
  }
  let payload = match base_codec::json_parse(ev.data) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(_) => return
  }
  match j_opt_str(payload, "workspace") {
    Some(ws) => {
      if ws.length() > 0 && ws != self.workspace {
        return
      }
    }
    None => ()
  }
  if !is_actionable_lock_payload(payload) {
    return
  }
  let _ = self.notify_lock_payload_result(payload)
}

/// Process a parsed SSE chunk segmented at `event: lock` boundaries under `stream_cap`:
/// - `event: lock` control frames are ALWAYS dispatched immediately (never blocked by `authGen`),
///   including both inline `entries` and real station `{workspace, head}` notifications.
/// - Non-`lock` data segments before and after any `event: lock` are validated against
///   `stream_cap.is_valid(tracker)` right before commit: if `stream_cap` is stale (including
///   when an earlier `event: lock` in the SAME chunk bumped `authGen`), subsequent data events
///   are dropped with 0 SQLite writes and without advancing `last_event_id`, returning `Ok(false)`
///   so the stream immediately reconnects with a fresh `WorkspaceCapability`.
fn StationEvents::process_sse_chunk_with_cap(
  self : StationEvents,
  evs : Array[wire::Event],
  stream_cap : Option[WorkspaceCapability],
) -> Result[Bool, String] {
  let is_stale = fn() -> Bool {
    match (self.auth, stream_cap) {
      (Some(tracker), Some(cap)) => !cap.is_valid(tracker)
      _ => false
    }
  }
  let has_meaningful_data = fn(seg : Array[wire::Event]) -> Bool {
    for i in 0..<seg.length() {
      if seg[i].data.length() > 0 || seg[i].id.is_some() {
        return true
      }
    }
    false
  }
  let segment : Array[wire::Event] = []
  let mut need_reconnect = false
  let flush_segment = fn() -> Result[Unit, String] {
    if segment.length() == 0 {
      return Ok(())
    }
    if need_reconnect || is_stale() {
      if has_meaningful_data(segment) {
        need_reconnect = true
      }
      segment.clear()
      return Ok(())
    }
    match self.apply_sse_batch(segment) {
      sql::SqlResult::Ok(_) => {
        segment.clear()
        Ok(())
      }
      sql::SqlResult::Err(e) => {
        segment.clear()
        Err(e.to_string())
      }
    }
  }
  for i in 0..<evs.length() {
    let ev = evs[i]
    if ev.name == "lock" {
      match flush_segment() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      self.dispatch_lock_sse_event(ev)
    } else if need_reconnect {
      if ev.data.length() > 0 || ev.id.is_some() {
        need_reconnect = true
      }
    } else {
      segment.push(ev)
    }
  }
  match flush_segment() {
    Ok(_) => Ok(!need_reconnect)
    Err(e) => Err(e)
  }
}

fn StationEvents::stream_loop_k(self : StationEvents, rt : effect::Runtime, k : (effect::Exit[Unit]) -> Unit) -> Unit {
  if self.stopped || effect::is_interrupted() {
    self.set_state(ConnectionState::Disconnected("stopped"))
    k(effect::Exit::Interrupted)
    return
  }
  self.set_state(ConnectionState::Connecting)
  let headers : Array[(String, String)] = [("accept", "text/event-stream")]
  // Strictly match `station/src/api/routes/events.ts:37,51`: station ONLY reads `?since=<eid>`.
  let path = match self.last_event_id {
    Some(eid) => "/events?since=" + encode_uri_component(eid)
    None => "/events"
  }
  let my_epoch = self.stream_epoch
  let stream_cap : Option[WorkspaceCapability] = match self.auth {
    Some(tracker) => Some(tracker.capture_workspace(self.workspace))
    None => None
  }
  let parser = wire::Sse::new()
  let mut marked_connected = false
  let aborted : Array[Bool] = [false]
  let done_sig : effect::Deferred[Bool] = effect::Deferred::new()
  let stream_fn = self.transport.stream_k
  let child = rt.fork_quiet_named("sse-stream:" + self.station, fn(ck : (effect::Exit[Unit]) -> Unit) -> Unit {
    stream_fn(
      path,
      headers,
      fn(chunk : Bytes) -> Unit {
        if aborted[0] || self.stopped || self.stream_epoch != my_epoch {
          return
        }
        if !marked_connected {
          marked_connected = true
          self.attempts = 0
          self.set_state(ConnectionState::Connected)
          let on_conn = self.on_connected
          on_conn()
        }
        match parser.feed(chunk) {
          wire::FeedResult::Ok(evs) => {
            match self.process_sse_chunk_with_cap(evs, stream_cap) {
              Ok(true) => ()
              Ok(false) | Err(_) => {
                // Immediately cancel the underlying old stream so no further chunks arrive or advance
                // `last_event_id`, and wake the outer `stream_fiber` to reconnect via `?since=`.
                aborted[0] = true
                self.cancel_active_stream()
                let _ = done_sig.succeed(true)
              }
            }
          }
          wire::FeedResult::Err(_) => ()
        }
      },
      fn(ex : effect::Exit[Unit]) -> Unit {
        match ex {
          effect::Exit::Interrupted => {
            let _ = done_sig.succeed(aborted[0])
            ck(effect::Exit::Interrupted)
          }
          effect::Exit::Succeeded(_) | effect::Exit::Failed(_) => {
            let _ = done_sig.succeed(true)
            ck(effect::Exit::Succeeded(()))
          }
        }
      },
    )
  })
  if aborted[0] || self.stopped {
    child.interrupt()
  } else {
    self.active_stream_fiber = Some(child)
  }
  done_sig.wait_k(fn(wex : effect::Exit[Bool]) -> Unit {
    if self.stream_epoch != my_epoch {
      k(effect::Exit::Interrupted)
      return
    }
    self.active_stream_fiber = None
    self.active_cancel = None
    if self.stopped || effect::is_interrupted() {
      self.set_state(ConnectionState::Disconnected("stopped"))
      k(effect::Exit::Interrupted)
      return
    }
    match wex {
      effect::Exit::Interrupted => {
        self.set_state(ConnectionState::Disconnected("stopped"))
        k(effect::Exit::Interrupted)
      }
      effect::Exit::Succeeded(should_reconnect) => {
        if should_reconnect {
          self.schedule_reconnect_k(rt, k)
        } else {
          self.set_state(ConnectionState::Disconnected("stopped"))
          k(effect::Exit::Interrupted)
        }
      }
      effect::Exit::Failed(_) => self.schedule_reconnect_k(rt, k)
    }
  })
}

/// Whether the `/events` stream fiber is currently active.
pub fn StationEvents::is_running(self : StationEvents) -> Bool {
  self.stream_fiber.is_some()
}

/// Swap the underlying `StationTransport`. If the `/events` stream is currently running,
/// cleanly stops the old stream fiber and restarts on the new transport (when `rt` is given).
pub fn StationEvents::set_transport(
  self : StationEvents,
  transport : StationTransport,
  rt : Option[effect::Runtime] = None,
) -> Unit {
  let was_running = self.stream_fiber.is_some()
  if was_running {
    self.stop()
  }
  self.stream_epoch += 1L
  self.transport = transport
  self.attempts = 0
  if was_running {
    match rt {
      Some(r) => self.start(r)
      None => ()
    }
  }
}

/// Start consuming `GET /events` on a scoped fiber of `rt`.
pub fn StationEvents::start(self : StationEvents, rt : effect::Runtime) -> Unit {
  match self.stream_fiber {
    Some(_) => return
    None => ()
  }
  self.stopped = false
  self.state = ConnectionState::Connecting
  let f = rt.fork_quiet_named("station-events:" + self.station, fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    self.stream_loop_k(rt, k)
  })
  self.stream_fiber = Some(f)
}

/// Stop the `/events` stream fiber and immediately cancel any active underlying stream & backoff sleep.
pub fn StationEvents::stop(self : StationEvents) -> Unit {
  self.stopped = true
  self.stream_epoch += 1L
  self.cancel_active_stream()
  match self.stream_fiber {
    Some(f) => {
      self.stream_fiber = None
      f.interrupt()
    }
    None => ()
  }
  self.set_state(ConnectionState::Disconnected("stopped"))
}
