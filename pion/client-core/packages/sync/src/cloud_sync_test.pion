// Deterministic unit tests for `shell_http_transport` and `CloudSync` using mock `shell::Shell`
// and `effect::Runtime` virtual clock (zero real sockets, zero real sleeps).

import "base_codec"
import "crypto"
import "effect"
import "form"
import "mesh"
import "outbox"
import "shell"
import "sql"
import "store"
import "wire"

struct MockCloudDb {
  account_docs : Map[String, String]
  workspaces : Map[String, String]
  station_docs : Map[String, String]
  entries : Map[String, String]
  chats : Map[String, String]
}

fn MockCloudDb::new() -> MockCloudDb {
  MockCloudDb::{
    account_docs: Map::new(),
    workspaces: Map::new(),
    station_docs: Map::new(),
    entries: Map::new(),
    chats: Map::new(),
  }
}

fn MockCloudDb::handle_sql(self : MockCloudDb, op : String, args : base_codec::Json) -> shell::AskResult {
  if op == "sql.open" {
    return shell::AskResult::Ok(base_codec::json_obj([("id", base_codec::json_int(1))]))
  }
  if op == "sql.close" || op == "sql.exec" {
    return shell::AskResult::Ok(base_codec::json_obj([]))
  }
  if op == "sql.inTransaction" {
    return shell::AskResult::Ok(base_codec::json_bool(false))
  }
  if op == "sql.run" {
    let sql_text = match base_codec::json_get(args, "sql") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let params = match base_codec::json_get(args, "params") {
      Some(base_codec::Json::Arr(xs)) => xs
      _ => []
    }
    if sql_text.contains("INTO account_doc") && params.length() >= 2 {
      match (params[0], params[1]) {
        (base_codec::Json::Str(name), base_codec::Json::Str(raw)) => self.account_docs.set(name, raw)
        _ => ()
      }
    } else if sql_text.contains("INTO workspace") && params.length() >= 2 {
      match (params[0], params[1]) {
        (base_codec::Json::Str(wid), base_codec::Json::Str(raw)) => self.workspaces.set(wid, raw)
        _ => ()
      }
    } else if sql_text.contains("INTO station") && params.length() >= 3 {
      match (params[0], params[1], params[2]) {
        (base_codec::Json::Str(addr), base_codec::Json::Str(kind), base_codec::Json::Str(raw)) => {
          self.station_docs.set(addr + ":" + kind, raw)
        }
        _ => ()
      }
    } else if sql_text.contains("INTO entry") && params.length() >= 4 {
      match (params[0], params[3]) {
        (base_codec::Json::Str(st), base_codec::Json::Str(raw)) => self.entries.set(st + ":" + base_codec::json_stringify(params[1]) + ":" + base_codec::json_stringify(params[2]), raw)
        _ => ()
      }
    } else if sql_text.contains("INTO chat") && params.length() >= 2 {
      match (params[0], params[1]) {
        (base_codec::Json::Str(st), base_codec::Json::Str(cid)) => self.chats.set(st + ":" + cid, base_codec::json_stringify(params[params.length() - 1]))
        _ => ()
      }
    }
    return shell::AskResult::Ok(base_codec::json_obj([("changes", base_codec::json_int(1))]))
  }
  shell::AskResult::Ok(base_codec::json_arr([]))
}

test "CloudSync fetch_me, fetch_workspace, and credential caching/refresh" {
  let rt = effect::Runtime::new()
  let mock_db = MockCloudDb::new()
  let pending : Array[(Int64, String, base_codec::Json)] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {
      pending.push((id, op, args))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      mock_db.handle_sql(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "cloud-test") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic(e.to_string())
  }
  let cs = CloudSync::new(sh, db, "https://cloud.example", token="tok-123")

  // 1. fetch_me_k
  let mut got_me_email = ""
  let mut got_ws_count = 0
  let mut got_relay_count = 0
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_me_k(fn(ex : effect::Exit[CloudMe]) -> Unit {
      match ex {
        effect::Exit::Succeeded(me) => {
          got_me_email = me.email
          got_ws_count = me.workspaces.length()
          got_relay_count = me.relays.length()
        }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(pending.length() == 1, "1 fetch pending")
  let (id0, op0, args0) = pending[0]
  debug_assert(op0 == "fetch" && j_str(args0, "url") == "https://cloud.example/v1/me", "GET /v1/me")
  sh.answer(
    id0,
    base_codec::json_obj([("status", base_codec::json_int(200)), ("headers", base_codec::json_arr([])), ("redirected", base_codec::json_bool(false))]),
    bytes=Some("{\"user\":{\"sub\":\"u1\",\"email\":\"alice@still.fail\",\"name\":\"Alice\"},\"workspaces\":[{\"id\":\"ws-1\",\"name\":\"Core\",\"role\":\"owner\"}],\"relay_urls\":[\"https://r1.example\"]}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(got_me_email == "alice@still.fail" && got_ws_count == 1 && got_relay_count == 1, "parsed /v1/me")
  debug_assert(mock_db.account_docs.get("me").is_some(), "persisted account_doc me")

  // 2. fetch_workspace_k
  let mut got_station_name = ""
  let mut got_member_count = 0
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-1", fn(ex : effect::Exit[CloudWorkspace]) -> Unit {
      match ex {
        effect::Exit::Succeeded(ws) => {
          got_member_count = ws.members.length()
          if ws.stations.length() > 0 {
            got_station_name = ws.stations[0].name
          }
        }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  let (id1, op1, args1) = pending[1]
  debug_assert(op1 == "fetch" && j_str(args1, "url") == "https://cloud.example/v1/workspaces/ws-1", "GET /v1/workspaces/ws-1")
  sh.answer(
    id1,
    base_codec::json_obj([("status", base_codec::json_int(200)), ("headers", base_codec::json_arr([])), ("redirected", base_codec::json_bool(false))]),
    bytes=Some("{\"id\":\"ws-1\",\"name\":\"Core\",\"rev\":3,\"members\":[{\"sub\":\"u1\",\"email\":\"alice@still.fail\",\"role\":\"owner\"}],\"stations\":[{\"id\":\"st-1\",\"name\":\"Tokyo\",\"online\":true}]}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(got_member_count == 1 && got_station_name == "Tokyo", "parsed workspace")
  debug_assert(mock_db.workspaces.get("ws-1").is_some(), "persisted workspace ws-1")

  // 3. fetch_member_credential_k caching and expiry refresh
  let mut c1 = ""
  let mut c2 = ""
  let mut c3 = ""
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_member_credential_k("ws-1", "dev-1", 1000.to_int64(), fn(ex : effect::Exit[MemberCredential]) -> Unit {
      match ex {
        effect::Exit::Succeeded(c) => c1 = c.credential
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  let (id2, _, args2) = pending[2]
  debug_assert(j_str(args2, "url") == "https://cloud.example/v1/workspaces/ws-1/credential", "POST credential")
  sh.answer(
    id2,
    base_codec::json_obj([("status", base_codec::json_int(200)), ("headers", base_codec::json_arr([])), ("redirected", base_codec::json_bool(false))]),
    bytes=Some("{\"credential\":\"cred-v1\",\"issued_at\":1000,\"expires_at\":2000,\"relay_url\":\"https://r1.example\"}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(c1 == "cred-v1", "cred v1")

  // Still valid at now=1500 -> served from cache without network call
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_member_credential_k("ws-1", "dev-1", 1500.to_int64(), fn(ex : effect::Exit[MemberCredential]) -> Unit {
      match ex {
        effect::Exit::Succeeded(c) => c2 = c.credential
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(c2 == "cred-v1" && pending.length() == 3, "cache hit with 0 new fetches")

  // Near expiry at now=1950 (> 2000 - 60) -> refreshes from cloud
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_member_credential_k("ws-1", "dev-1", 1950.to_int64(), fn(ex : effect::Exit[MemberCredential]) -> Unit {
      match ex {
        effect::Exit::Succeeded(c) => c3 = c.credential
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(pending.length() == 4, "triggered refresh fetch")
  let (id3, _, _) = pending[3]
  sh.answer(
    id3,
    base_codec::json_obj([("status", base_codec::json_int(200)), ("headers", base_codec::json_arr([])), ("redirected", base_codec::json_bool(false))]),
    bytes=Some("{\"credential\":\"cred-v2\",\"issued_at\":1950,\"expires_at\":3000,\"relay_url\":\"https://r1.example\"}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(c3 == "cred-v2", "refreshed cred v2")
}

test "CloudSync /v1/events WebSocket event refresh and virtual-clock exponential backoff" {
  let rt = effect::Runtime::new()
  let mock_db = MockCloudDb::new()
  let calls : Array[(Int64, String, base_codec::Json)] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {
      calls.push((id, op, args))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      mock_db.handle_sql(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "ws-test") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic(e.to_string())
  }
  let cs = CloudSync::new(sh, db, "http://127.0.0.1:8080", token="tok-ws")
  let seen_events : Array[String] = []
  cs.start_events_ws(fn(ev : CloudEvent) -> Unit {
    match ev {
      CloudEvent::WorkspaceChanged(wid, _) => seen_events.push("ws:" + wid)
      CloudEvent::StationStatusChanged(wid, sid, on) => seen_events.push("st:" + wid + "/" + sid + ":" + on.to_string())
      CloudEvent::WorkspacesChanged(_) => seen_events.push("workspaces")
      CloudEvent::Release => seen_events.push("release")
      CloudEvent::Other(t, _) => seen_events.push("other:" + t)
    }
  })
  let _ = rt.run_ready()
  debug_assert(calls.length() == 1, "ws.open called")
  let (open_id1, open_op1, open_args1) = calls[0]
  debug_assert(open_op1 == "ws.open" && j_str(open_args1, "url") == "ws://127.0.0.1:8080/v1/events", "ws url")

  // First connect fails -> sleeps 1000ms before retry
  sh.refuse(open_id1, "connection refused")
  let _ = rt.run_ready()
  debug_assert(calls.length() == 1, "waiting for 1000ms backoff")
  rt.advance(999)
  debug_assert(calls.length() == 1, "not yet at 999ms")
  rt.advance(1)
  debug_assert(calls.length() == 2, "retried ws.open at 1000ms")

  // Second connect succeeds -> enters ws.next loop
  let (open_id2, _, _) = calls[1]
  sh.answer(open_id2, base_codec::json_obj([("id", base_codec::json_int(55))]))
  let _ = rt.run_ready()
  debug_assert(calls.length() == 3, "ws.next #1 issued")
  let (next_id1, next_op1, _) = calls[2]
  debug_assert(next_op1 == "ws.next", "ws.next")

  // Deliver workspace event -> triggers automatic GET /v1/workspaces/ws-live refresh
  sh.answer(next_id1, base_codec::json_obj([("text", base_codec::json_str("{\"type\":\"workspace\",\"id\":\"ws-live\"}"))]))
  let _ = rt.run_ready()
  debug_assert(seen_events.length() == 1 && seen_events[0] == "ws:ws-live", "received workspace event")
  let mut saw_ws_fetch = false
  let mut next_id2 = 0.to_int64()
  for i in 3..<calls.length() {
    let (cid, cop, cargs) = calls[i]
    if cop == "fetch" && j_str(cargs, "url") == "http://127.0.0.1:8080/v1/workspaces/ws-live" {
      saw_ws_fetch = true
    }
    if cop == "ws.next" {
      next_id2 = cid
    }
  }
  debug_assert(saw_ws_fetch && next_id2 > 0.to_int64(), "auto-refreshed workspace and continued ws.next")

  // Close socket -> backoff doubles to 2000ms (attempt=1)
  sh.answer(next_id2, base_codec::json_obj([("end", base_codec::json_bool(true))]))
  let _ = rt.run_ready()
  let count_before_backoff = calls.length()
  rt.advance(1999)
  debug_assert(calls.length() == count_before_backoff, "waiting 2000ms backoff")
  rt.advance(1)
  debug_assert(calls.length() == count_before_backoff + 1, "reconnected after 2000ms")
  cs.stop()
  let _ = rt.run_ready()
  debug_assert(cloud_ws_backoff_ms(0) == 1000 && cloud_ws_backoff_ms(6) == 60000 && cloud_ws_backoff_ms(10) == 60000, "backoff bounds")
}

test "shell_http_transport streams real SSE chunks into StationEvents and closes stream cleanly" {
  let rt = effect::Runtime::new()
  let mock_db = MockCloudDb::new()
  let calls : Array[(Int64, String, base_codec::Json)] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {
      calls.push((id, op, args))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      mock_db.handle_sql(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "sse-test") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic(e.to_string())
  }
  let transport = shell_http_transport(sh, "http://127.0.0.1:9999", auth_header=Some("Bearer test"))
  let fb : outbox::FrameOutbox[CoreEvent] = outbox::FrameOutbox::new(fn() -> Unit {})
  let evs = StationEvents::new("ws-1", "st-1", db, fb, transport)
  evs.start(rt)
  let _ = rt.run_ready()

  debug_assert(calls.length() == 1, "stream.open issued")
  let (open_id, open_op, open_args) = calls[0]
  debug_assert(open_op == "stream.open" && j_str(open_args, "url") == "http://127.0.0.1:9999/events", "SSE stream.open url")

  // Answer stream.open -> stream.read #1
  sh.answer(
    open_id,
    base_codec::json_obj([
      ("id", base_codec::json_int(77)),
      ("status", base_codec::json_int(200)),
      ("headers", base_codec::json_arr([])),
      ("redirected", base_codec::json_bool(false)),
    ]),
  )
  let _ = rt.run_ready()
  let (r1_id, r1_op, _) = calls[1]
  debug_assert(r1_op == "stream.read", "stream.read #1")

  // Deliver real SSE thread event in chunk
  let sse_chunk = "id: 1\nevent: thread\ndata: {\"id\":9,\"entries\":[{\"thread\":9,\"n\":1,\"kind\":\"message\",\"authorKind\":\"person\",\"author\":\"alice@still.fail\",\"text\":\"via shell sse\",\"clientKey\":\"ck-sse-1\",\"at\":1000}]}\n\n"
  sh.answer(r1_id, base_codec::json_obj([]), bytes=Some(sse_chunk.to_bytes()))
  let _ = rt.run_ready()
  debug_assert(mock_db.entries.get("st-1:9:1").is_some(), "SSE entry ingested into SQLite")

  // End stream -> stream.close must be sent
  let (r2_id, r2_op, _) = calls[2]
  debug_assert(r2_op == "stream.read", "stream.read #2")
  sh.answer(r2_id, base_codec::json_obj([("end", base_codec::json_bool(true))]))
  let _ = rt.run_ready()
  let mut saw_close = false
  for i in 0..<calls.length() {
    let (_, op, _) = calls[i]
    if op == "stream.close" {
      saw_close = true
    }
  }
  debug_assert(saw_close, "stream.close called on EOF")
  evs.stop()
  let _ = rt.run_ready()
}

test "P0-6: MeshStationTransport real pion/base/packages/mesh control handshake, claimBy Ed25519 proof, lock_unconfirmed, HTTP/SSE, cancel, and exchange" {
  let rt = effect::Runtime::new()
  let mock_db = MockCloudDb::new()
  let storage : Map[String, Bytes] = Map::new()
  let mut captured_alpn = ""
  let mut captured_hello_line = ""
  let mut captured_refresh_line = ""
  let mut captured_http_req = ""
  let mut saw_stream_reset = false
  let mut next_stream_id = 30
  let mut sse_stream_id = 0
  let mut sse_pending_read : Option[Int64] = None
  let mut ctrl_stream_id = 0
  let mut ctrl_write_count = 0
  let mut ctrl_pending_read : Option[Int64] = None
  let mut http_stream_id = 0
  let mut http_read_step = 0
  let mut local_ep_id = ""
  let mut admit_lock_unconfirmed = true
  let peer_id = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

  let holder : Array[shell::Shell] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, bytes : Option[Bytes]) -> Unit {
      let s = holder[0]
      if op == "storage.get" {
        let k = j_str(args, "key")
        s.answer(id, base_codec::json_obj([]), bytes=storage.get(k))
        return
      }
      if op == "storage.set" {
        let k = j_str(args, "key")
        match bytes {
          Some(b) => storage.set(k, b)
          None => ()
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "iroh.bind" {
        let seed = match bytes { Some(b) => b; None => Bytes::new(32) }
        local_ep_id = crypto::sha256_hex(seed)
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(10))]))
        return
      }
      if op == "iroh.connect" {
        captured_alpn = match bytes { Some(b) => bytes_to_str(b); None => "" }
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(20))]))
        return
      }
      if op == "conn.closed" {
        return
      }
      if op == "conn.close" || op == "iroh.close" {
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "conn.openBi" {
        let sid = next_stream_id
        next_stream_id += 1
        if ctrl_stream_id == 0 {
          ctrl_stream_id = sid
        } else if http_stream_id == 0 {
          http_stream_id = sid
        } else {
          sse_stream_id = sid
        }
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(sid))]))
        return
      }
      if op == "istream.write" {
        let sid = j_int(args, "id")
        let payload = match bytes { Some(b) => bytes_to_str(b); None => "" }
        if sid == ctrl_stream_id {
          ctrl_write_count += 1
          if ctrl_write_count == 1 {
            captured_hello_line = payload
          } else {
            captured_refresh_line = payload
          }
          s.answer(id, base_codec::json_obj([]))
          match ctrl_pending_read {
            Some(rid) => {
              ctrl_pending_read = None
              let ans = if ctrl_write_count == 1 {
                "{\"ok\":true,\"lock_unconfirmed\":" + admit_lock_unconfirmed.to_string() + ",\"station\":{\"id\":\"st-mesh-1\",\"name\":\"Tokyo Studio\"}}\n"
              } else {
                "{\"ok\":true,\"lock_unconfirmed\":false,\"station\":{\"id\":\"st-mesh-1\",\"name\":\"Tokyo Studio\"}}\n"
              }
              s.answer(rid, base_codec::json_obj([]), bytes=Some(ans.to_bytes()))
            }
            None => ()
          }
          return
        }
        if sid == http_stream_id {
          captured_http_req = captured_http_req + payload
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.finish" {
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.reset" {
        saw_stream_reset = true
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.read" {
        let sid = j_int(args, "id")
        if sid == ctrl_stream_id {
          if ctrl_write_count == 1 {
            let ans = "{\"ok\":true,\"lock_unconfirmed\":" + admit_lock_unconfirmed.to_string() + ",\"station\":{\"id\":\"st-mesh-1\",\"name\":\"Tokyo Studio\"}}\n"
            s.answer(id, base_codec::json_obj([]), bytes=Some(ans.to_bytes()))
          } else if ctrl_write_count >= 2 {
            let ans = "{\"ok\":true,\"lock_unconfirmed\":false,\"station\":{\"id\":\"st-mesh-1\",\"name\":\"Tokyo Studio\"}}\n"
            s.answer(id, base_codec::json_obj([]), bytes=Some(ans.to_bytes()))
          } else {
            ctrl_pending_read = Some(id)
          }
          return
        }
        if sid == http_stream_id {
          if http_read_step == 0 {
            http_read_step = 1
            s.answer(id, base_codec::json_obj([]), bytes=Some("{\"status\":201,\"headers\":{\"x-mesh\":\"1\"}}\n{\"ok\":true}".to_bytes()))
          } else {
            s.answer(id, base_codec::json_obj([]), bytes=None)
          }
          return
        }
        if sid == sse_stream_id {
          if sse_pending_read.is_none() {
            sse_pending_read = Some(0.to_int64())
            let sse_payload = "{\"status\":200,\"headers\":{\"content-type\":\"text/event-stream\"}}\nid: m-1\nevent: thread\ndata: {\"id\":5,\"entries\":[{\"thread\":5,\"n\":1,\"kind\":\"message\",\"authorKind\":\"person\",\"author\":\"alice@still.fail\",\"text\":\"via real mesh\",\"at\":1000}]}\n\n"
            s.answer(id, base_codec::json_obj([]), bytes=Some(sse_payload.to_bytes()))
          } else {
            // Keep SSE open until cancelled
            sse_pending_read = Some(id)
          }
          return
        }
        s.answer(id, base_codec::json_obj([]), bytes=None)
        return
      }
      s.answer(id, base_codec::json_obj([]))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      if op == "iroh.endpointId" {
        return shell::AskResult::Ok(base_codec::json_str(local_ep_id))
      }
      if op == "iroh.relayStatus" {
        return shell::AskResult::Ok(base_codec::json_arr([
          base_codec::json_obj([("url", base_codec::json_str("https://relay.still.fail/")), ("connected", base_codec::json_bool(true))]),
        ]))
      }
      if op == "conn.closeReason" {
        return shell::AskResult::Ok(base_codec::json_null())
      }
      if op == "conn.paths" {
        return shell::AskResult::Ok(base_codec::json_arr([
          base_codec::json_obj([("selected", base_codec::json_bool(true)), ("relay", base_codec::json_str("https://relay.still.fail/"))]),
        ]))
      }
      if op == "conn.stats" {
        return shell::AskResult::Ok(base_codec::json_obj([("rxBytes", base_codec::json_int(0)), ("txBytes", base_codec::json_int(0))]))
      }
      if op == "ed25519.sign" {
        return shell::AskResult::Err(shell::ShellError::{ message: "use pure pion ed25519" })
      }
      mock_db.handle_sql(op, args)
    },
    fn(n : Int) -> Bytes {
      let out = Bytes::new(n)
      for i in 0..<n {
        out[i] = ((0x21 + i * 7) & 0xFF) as Byte
      }
      out
    },
  )
  holder.push(sh)

  let db = match sql::Sql::open(sh, "real-mesh-test") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic(e.to_string())
  }
  let mut admissions_seen = 0
  let mut last_unconfirmed = false
  let cfg = MeshStationConfig::new(
    "ws-mesh-prod",
    peer_id,
    ["https://relay.still.fail/"],
    fn(_dev : String, _fresh : Bool, ck : (effect::Exit[String]) -> Unit) -> Unit {
      ck(effect::Exit::Succeeded("cloud-signed-cred-v1"))
    },
    device_kind="app",
    device_label="MacBook Pro",
    on_admission=Some(fn(adm : MeshAdmission) -> Unit {
      admissions_seen += 1
      last_unconfirmed = adm.lock_unconfirmed
    }),
  )
  let (ctrl, transport) = shell_mesh_transport(sh, cfg)

  // 1. Send HTTP POST over real `mesh::Link` + `StationTransport::from_link`
  let mut got_status = 0
  let mut got_body = ""
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    (transport.request_k)(
      "POST",
      "/threads/42/messages",
      [("content-type", "application/json")],
      "{\"text\":\"hi real mesh\"}".to_bytes(),
      fn(ex : effect::Exit[HttpReply]) -> Unit {
        match ex {
          effect::Exit::Succeeded(rep) => {
            got_status = rep.status
            got_body = bytes_to_str(rep.body)
          }
          _ => ()
        }
        k(effect::Exit::Succeeded(()))
      },
    )
  })
  let _ = rt.run_ready()

  // Verify ALPN == "stillfail/admin/1"
  debug_assert(captured_alpn == "stillfail/admin/1", "ALPN must be stillfail/admin/1")
  // Verify control-stream hello carries protocol==2, Cloud credential, and valid Ed25519 claimBy proof!
  let hello_json = match base_codec::json_parse(captured_hello_line) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(e) => panic("bad hello line: " + e)
  }
  debug_assert(j_str(hello_json, "credential") == "cloud-signed-cred-v1", "hello carries Cloud member credential")
  debug_assert(j_int(hello_json, "protocol") == 2, "hello carries protocol: 2")
  let lock_obj = match base_codec::json_get(hello_json, "lock") {
    Some(v) => v
    None => panic("hello missing lock claim")
  }
  let claim_dev = j_str(lock_obj, "device")
  let claim_proof = j_str(lock_obj, "proof")
  debug_assert(j_str(lock_obj, "kind") == "app" && j_str(lock_obj, "label") == "MacBook Pro", "lock claim metadata")
  let ep_id = match ctrl.device_id() { Some(id) => id; None => panic("missing device_id") }
  let proof_ok = (native_lock_crypto().endpoint_proof)("ws-mesh-prod", claim_dev, ep_id, claim_proof)
  debug_assert(proof_ok, "claimBy Ed25519 signature MUST verify via native_lock_crypto().endpoint_proof")
  // Verify lock_unconfirmed: true surfaced from admitted_k
  debug_assert(admissions_seen == 1 && last_unconfirmed && ctrl.is_lock_unconfirmed(), "lock_unconfirmed surfaced from admitted_k")
  match ctrl.admission() {
    Some(adm) =>
    match adm.station_id {
      Some(sid) => debug_assert(sid == "st-mesh-1", "station metadata parsed from admitted_k")
      None => debug_assert(false, "expected station_id")
    }
    None => debug_assert(false, "expected admission")
  }
  debug_assert(got_status == 201 && got_body == "{\"ok\":true}", "HTTP POST succeeded over real mesh::Link")

  // 2. Credential renewal via Link::exchange_k
  let mut renewed_unconfirmed = true
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.refresh_credential_k("cloud-signed-cred-v2", fn(ex : effect::Exit[MeshAdmission]) -> Unit {
      match ex {
        effect::Exit::Succeeded(adm) => { renewed_unconfirmed = adm.lock_unconfirmed }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(captured_refresh_line.contains("cloud-signed-cred-v2") && !renewed_unconfirmed && !ctrl.is_lock_unconfirmed(), "Link::exchange_k renewed credential and updated admission")

  // 3. SSE stream consumption over real mesh::Link + clean cancellation (`reply.cancel()` -> `istream.reset`)
  let fb : outbox::FrameOutbox[CoreEvent] = outbox::FrameOutbox::new(fn() -> Unit {})
  let evs = StationEvents::new("ws-mesh-prod", "st-mesh-1", db, fb, transport)
  evs.start(rt)
  let _ = rt.run_ready()
  debug_assert(mock_db.entries.get("st-mesh-1:5:1").is_some(), "SSE entry ingested over real mesh::Link")
  evs.stop()
  let _ = rt.run_ready()
  debug_assert(saw_stream_reset, "stopping SSE cancels mesh::Reply via istream.reset")

  // 4. Clean teardown via close_k
  let mut closed_ok = false
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.close_k(fn(ex : effect::Exit[Unit]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => { closed_ok = true }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(closed_ok && ctrl.link().is_none(), "close_k cleaned up mesh link and endpoint")
  let _ = admit_lock_unconfirmed
}

test "P0-7: CloudSync fetch_workspace_k never overwrites station overview and parses full CloudStation metadata" {
  let rt = effect::Runtime::new()
  let mock_db = MockCloudDb::new()
  let pending : Array[(Int64, String, base_codec::Json)] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {
      pending.push((id, op, args))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      mock_db.handle_sql(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "cloud-p0-7-test") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic(e.to_string())
  }

  // Pre-seed a rich station-owned `overview` document with version/counts/joined/problems.
  let rich_overview = "{\"id\":\"st-1\",\"name\":\"Tokyo Studio\",\"version\":\"0.1.9500\",\"counts\":{\"chats\":42,\"running\":3,\"jobs\":2},\"joined\":true,\"problems\":[{\"code\":\"disk_low\",\"detail\":\"12 GB free\"}]}"
  let _ = store::upsert_station_doc(db, "ws-1/st-1", "overview", rich_overview, confirmed=Some(1000.to_int64()))
  match mock_db.station_docs.get("ws-1/st-1:overview") {
    Some(before) => debug_assert(before == rich_overview, "pre-seeded station overview present")
    None => debug_assert(false, "expected pre-seeded station overview")
  }

  let cs = CloudSync::new(sh, db, "https://cloud.example", token="tok-p07")
  let mut got_ws : Option[CloudWorkspace] = None
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-1", fn(ex : effect::Exit[CloudWorkspace]) -> Unit {
      match ex {
        effect::Exit::Succeeded(ws) => {
          got_ws = Some(ws)
        }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(pending.length() == 1, "1 fetch_workspace_k pending")
  let (id0, _, _) = pending[0]
  let cloud_payload = "{\"id\":\"ws-1\",\"name\":\"Core\",\"rev\":9,\"members\":[{\"sub\":\"u1\",\"email\":\"alice@still.fail\",\"role\":\"owner\"}],\"stations\":[{\"id\":\"st-1\",\"name\":\"Tokyo\",\"online\":true,\"endpoint_id\":\"ep-snake-1\",\"relay\":\"https://relay-1.example\",\"ips\":[\"10.0.0.1:443\",\"192.168.1.2:443\"],\"mode\":\"full\",\"emoji\":\"🗼\",\"version\":\"0.1.9500\",\"joined\":true},{\"id\":\"st-2\",\"name\":\"Rig\",\"online\":false,\"endpointId\":\"ep-camel-2\",\"relayUrl\":\"https://relay-2.example\",\"ips\":[\"10.0.0.2:443\"],\"mode\":\"tasks\"}]}"
  sh.answer(
    id0,
    base_codec::json_obj([("status", base_codec::json_int(200)), ("headers", base_codec::json_arr([])), ("redirected", base_codec::json_bool(false))]),
    bytes=Some(cloud_payload.to_bytes()),
  )
  let _ = rt.run_ready()

  // 1. Station-owned `overview` row MUST remain byte-for-byte identical!
  match mock_db.station_docs.get("ws-1/st-1:overview") {
    Some(after) => debug_assert(after == rich_overview, "station overview must NOT be overwritten by CloudSync")
    None => debug_assert(false, "station overview disappeared")
  }
  debug_assert(mock_db.station_docs.get("ws-1/st-2:overview").is_none(), "CloudSync must not fabricate overview for st-2")

  // 2. Full raw workspace JSON persisted strictly in `workspace` table.
  match mock_db.workspaces.get("ws-1") {
    Some(ws_raw) => debug_assert(ws_raw.contains("ep-snake-1") && ws_raw.contains("ep-camel-2"), "workspace raw_json preserved")
    None => debug_assert(false, "expected workspace row")
  }

  // 3. CloudWorkspace.stations parsed endpoint_id / relay / ips / mode (both snake_case and camelCase).
  match got_ws {
    Some(ws) => {
      debug_assert(ws.stations.length() == 2, "parsed 2 stations")
      let s0 = ws.stations[0]
      debug_assert(s0.id == "st-1", "s0 id")
      match s0.endpoint_id { Some(v) => debug_assert(v == "ep-snake-1", "s0 endpoint_id"); None => debug_assert(false, "s0 endpoint_id") }
      match s0.relay { Some(v) => debug_assert(v == "https://relay-1.example", "s0 relay"); None => debug_assert(false, "s0 relay") }
      debug_assert(s0.ips.length() == 2 && s0.ips[0] == "10.0.0.1:443" && s0.ips[1] == "192.168.1.2:443", "s0 ips")
      match s0.mode { Some(v) => debug_assert(v == "full", "s0 mode"); None => debug_assert(false, "s0 mode") }
      debug_assert(s0.joined, "s0 joined")
      let s1 = ws.stations[1]
      debug_assert(s1.id == "st-2", "s1 id")
      match s1.endpoint_id { Some(v) => debug_assert(v == "ep-camel-2", "s1 camelCase endpointId"); None => debug_assert(false, "s1 endpointId") }
      match s1.relay { Some(v) => debug_assert(v == "https://relay-2.example", "s1 camelCase relayUrl"); None => debug_assert(false, "s1 relayUrl") }
      debug_assert(s1.ips.length() == 1 && s1.ips[0] == "10.0.0.2:443", "s1 ips")
      match s1.mode { Some(v) => debug_assert(v == "tasks", "s1 mode"); None => debug_assert(false, "s1 mode") }
    }
    None => debug_assert(false, "expected CloudWorkspace result")
  }
}

test "P0-6: MeshStationTransport preserves full lock_unconfirmed refusal payload (lock, entries, left, person)" {
  let rt = effect::Runtime::new()
  let storage : Map[String, Bytes] = Map::new()
  let mut local_ep_id = ""
  let mut ctrl_stream_id = 0
  let mut ctrl_wrote = false
  let mut ctrl_pending_read : Option[Int64] = None
  let refusal_line = "{\"ok\":false,\"code\":\"lock_unconfirmed\",\"error\":\"device not yet confirmed\",\"lock\":{\"head\":{\"seq\":3,\"genesis\":\"g-1\"}},\"entries\":[{\"seq\":0}],\"left\":2,\"person\":\"alice@still.fail\"}\n"
  let peer_id = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
  let holder : Array[shell::Shell] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, bytes : Option[Bytes]) -> Unit {
      let s = holder[0]
      if op == "storage.get" {
        s.answer(id, base_codec::json_obj([]), bytes=storage.get(j_str(args, "key")))
        return
      }
      if op == "storage.set" {
        match bytes { Some(b) => storage.set(j_str(args, "key"), b); None => () }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "iroh.bind" {
        let seed = match bytes { Some(b) => b; None => Bytes::new(32) }
        local_ep_id = crypto::sha256_hex(seed)
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(11))]))
        return
      }
      if op == "iroh.connect" {
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(21))]))
        return
      }
      if op == "conn.closed" {
        return
      }
      if op == "conn.openBi" {
        ctrl_stream_id = 31
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(31))]))
        return
      }
      if op == "istream.write" {
        if j_int(args, "id") == ctrl_stream_id {
          ctrl_wrote = true
          s.answer(id, base_codec::json_obj([]))
          match ctrl_pending_read {
            Some(rid) => {
              ctrl_pending_read = None
              s.answer(rid, base_codec::json_obj([]), bytes=Some(refusal_line.to_bytes()))
            }
            None => ()
          }
          return
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.read" {
        if j_int(args, "id") == ctrl_stream_id {
          if ctrl_wrote {
            s.answer(id, base_codec::json_obj([]), bytes=Some(refusal_line.to_bytes()))
          } else {
            ctrl_pending_read = Some(id)
          }
          return
        }
        s.answer(id, base_codec::json_obj([]), bytes=None)
        return
      }
      s.answer(id, base_codec::json_obj([]))
    },
    fn(op : String, _args : base_codec::Json) -> shell::AskResult {
      if op == "iroh.endpointId" { return shell::AskResult::Ok(base_codec::json_str(local_ep_id)) }
      if op == "iroh.relayStatus" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.closeReason" { return shell::AskResult::Ok(base_codec::json_null()) }
      if op == "conn.paths" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.stats" { return shell::AskResult::Ok(base_codec::json_obj([])) }
      if op == "ed25519.sign" { return shell::AskResult::Err(shell::ShellError::{ message: "pure pion" }) }
      shell::AskResult::Ok(base_codec::json_null())
    },
    fn(n : Int) -> Bytes {
      let out = Bytes::new(n)
      for i in 0..<n { out[i] = ((0x33 + i * 5) & 0xFF) as Byte }
      out
    },
  )
  holder.push(sh)
  let cfg = MeshStationConfig::new(
    "ws-refusal",
    peer_id,
    ["https://relay.still.fail/"],
    fn(_dev : String, _fresh : Bool, ck : (effect::Exit[String]) -> Unit) -> Unit {
      ck(effect::Exit::Succeeded("cred-refusal"))
    },
  )
  let (ctrl, _) = shell_mesh_transport(sh, cfg)
  let mut failed = false
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.connect_k(fn(ex : effect::Exit[mesh::Link]) -> Unit {
      match ex {
        effect::Exit::Failed(_) => { failed = true }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(failed, "lock_unconfirmed refusal fails connect_k")
  debug_assert(ctrl.is_lock_unconfirmed(), "ctrl.is_lock_unconfirmed() == true")
  match ctrl.admission() {
    Some(adm) => {
      debug_assert(base_codec::json_get(adm.raw, "lock").is_some(), "raw.lock preserved")
      debug_assert(base_codec::json_get(adm.raw, "entries").is_some(), "raw.entries preserved")
      debug_assert(j_int(adm.raw, "left") == 2, "raw.left preserved")
      debug_assert(j_str(adm.raw, "person") == "alice@still.fail", "raw.person preserved")
    }
    None => debug_assert(false, "expected admission payload")
  }
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
}

test "P0-6: MeshStationTransport close_k during pending connect_k closes link on handshake completion and leaves link() None" {
  let rt = effect::Runtime::new()
  let storage : Map[String, Bytes] = Map::new()
  let mut local_ep_id = ""
  let mut ctrl_stream_id = 0
  let mut ctrl_pending_read : Option[Int64] = None
  let mut conn_close_count = 0
  let peer_id = "111122223333444455556666777788889999aaaabbbbccccddddeeeeffff0000"
  let holder : Array[shell::Shell] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, bytes : Option[Bytes]) -> Unit {
      let s = holder[0]
      if op == "storage.get" {
        s.answer(id, base_codec::json_obj([]), bytes=storage.get(j_str(args, "key")))
        return
      }
      if op == "storage.set" {
        match bytes { Some(b) => storage.set(j_str(args, "key"), b); None => () }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "iroh.bind" {
        let seed = match bytes { Some(b) => b; None => Bytes::new(32) }
        local_ep_id = crypto::sha256_hex(seed)
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(12))]))
        return
      }
      if op == "iroh.connect" {
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(22))]))
        return
      }
      if op == "conn.closed" {
        return
      }
      if op == "conn.close" {
        conn_close_count += 1
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "conn.openBi" {
        ctrl_stream_id = 32
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(32))]))
        return
      }
      if op == "istream.read" {
        if j_int(args, "id") == ctrl_stream_id {
          // Hold admission read pending so close_k can race with connect_k!
          ctrl_pending_read = Some(id)
          return
        }
        s.answer(id, base_codec::json_obj([]), bytes=None)
        return
      }
      s.answer(id, base_codec::json_obj([]))
    },
    fn(op : String, _args : base_codec::Json) -> shell::AskResult {
      if op == "iroh.endpointId" { return shell::AskResult::Ok(base_codec::json_str(local_ep_id)) }
      if op == "iroh.relayStatus" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.closeReason" { return shell::AskResult::Ok(base_codec::json_null()) }
      if op == "conn.paths" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.stats" { return shell::AskResult::Ok(base_codec::json_obj([])) }
      if op == "ed25519.sign" { return shell::AskResult::Err(shell::ShellError::{ message: "pure pion" }) }
      shell::AskResult::Ok(base_codec::json_null())
    },
    fn(n : Int) -> Bytes {
      let out = Bytes::new(n)
      for i in 0..<n { out[i] = ((0x44 + i * 3) & 0xFF) as Byte }
      out
    },
  )
  holder.push(sh)
  let cfg = MeshStationConfig::new(
    "ws-close-race",
    peer_id,
    ["https://relay.still.fail/"],
    fn(_dev : String, _fresh : Bool, ck : (effect::Exit[String]) -> Unit) -> Unit {
      ck(effect::Exit::Succeeded("cred-race"))
    },
  )
  let (ctrl, _) = shell_mesh_transport(sh, cfg)
  let mut connect_outcome = ""
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.connect_k(fn(ex : effect::Exit[mesh::Link]) -> Unit {
      match ex {
        effect::Exit::Failed(e) => { connect_outcome = effect_error_text(e) }
        effect::Exit::Interrupted => { connect_outcome = "interrupted" }
        effect::Exit::Succeeded(_) => { connect_outcome = "succeeded" }
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(ctrl_pending_read.is_some(), "control stream admission read is pending")

  // Close transport while connect_k is awaiting admitted_k!
  let mut closed_done = false
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit {
      closed_done = true
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(closed_done, "close_k completed")

  // Now resolve the pending control stream admission read -> must auto-close link and NOT retain it!
  match ctrl_pending_read {
    Some(rid) => sh.answer(rid, base_codec::json_obj([]), bytes=Some("{\"ok\":true,\"station\":{\"id\":\"st-race\"}}\n".to_bytes()))
    None => ()
  }
  let _ = rt.run_ready()
  debug_assert(conn_close_count >= 1, "link closed on handshake completion after close_k")
  debug_assert(ctrl.link().is_none(), "ctrl.link() must remain None after close_k race")
  debug_assert(connect_outcome != "succeeded" && connect_outcome.length() > 0, "connect_k did not succeed after close_k")
}

test "W27a: MeshStationTransport fetches dynamic entries per handshake, always emits label, and enforces CARRY_BYTES budget" {
  let rt = effect::Runtime::new()
  let storage : Map[String, Bytes] = Map::new()
  let mut local_ep_id = ""
  let mut next_conn_id = 20
  let mut next_stream_id = 30
  let mut ctrl_stream_id = 0
  let mut ctrl_wrote = false
  let mut ctrl_pending_read : Option[Int64] = None
  let captured_hellos : Array[String] = []
  let peer_id = "22223333444455556666777788889999aaaabbbbccccddddeeeeffff11112222"
  let holder : Array[shell::Shell] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, bytes : Option[Bytes]) -> Unit {
      let s = holder[0]
      if op == "storage.get" {
        s.answer(id, base_codec::json_obj([]), bytes=storage.get(j_str(args, "key")))
        return
      }
      if op == "storage.set" {
        match bytes { Some(b) => storage.set(j_str(args, "key"), b); None => () }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "iroh.bind" {
        let seed = match bytes { Some(b) => b; None => Bytes::new(32) }
        local_ep_id = crypto::sha256_hex(seed)
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(13))]))
        return
      }
      if op == "iroh.connect" {
        let cid = next_conn_id
        next_conn_id += 1
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(cid))]))
        return
      }
      if op == "conn.closed" {
        return
      }
      if op == "conn.openBi" {
        ctrl_stream_id = next_stream_id
        next_stream_id += 1
        ctrl_wrote = false
        ctrl_pending_read = None
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(ctrl_stream_id))]))
        return
      }
      if op == "istream.write" {
        if j_int(args, "id") == ctrl_stream_id {
          let payload = match bytes { Some(b) => bytes_to_str(b); None => "" }
          captured_hellos.push(payload)
          ctrl_wrote = true
          s.answer(id, base_codec::json_obj([]))
          match ctrl_pending_read {
            Some(rid) => {
              ctrl_pending_read = None
              s.answer(rid, base_codec::json_obj([]), bytes=Some("{\"ok\":true,\"station\":{\"id\":\"st-dyn\"}}\n".to_bytes()))
            }
            None => ()
          }
          return
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.read" {
        if j_int(args, "id") == ctrl_stream_id {
          if ctrl_wrote {
            s.answer(id, base_codec::json_obj([]), bytes=Some("{\"ok\":true,\"station\":{\"id\":\"st-dyn\"}}\n".to_bytes()))
          } else {
            ctrl_pending_read = Some(id)
          }
          return
        }
        s.answer(id, base_codec::json_obj([]), bytes=None)
        return
      }
      s.answer(id, base_codec::json_obj([]))
    },
    fn(op : String, _args : base_codec::Json) -> shell::AskResult {
      if op == "iroh.endpointId" { return shell::AskResult::Ok(base_codec::json_str(local_ep_id)) }
      if op == "iroh.relayStatus" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.closeReason" { return shell::AskResult::Ok(base_codec::json_null()) }
      if op == "conn.paths" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.stats" { return shell::AskResult::Ok(base_codec::json_obj([])) }
      if op == "ed25519.sign" { return shell::AskResult::Err(shell::ShellError::{ message: "pure pion" }) }
      shell::AskResult::Ok(base_codec::json_null())
    },
    fn(n : Int) -> Bytes {
      let out = Bytes::new(n)
      for i in 0..<n { out[i] = ((0x55 + i * 3) & 0xFF) as Byte }
      out
    },
  )
  holder.push(sh)

  let mut round = 0
  let big_pad = StringBuilder::new()
  for _ in 0..<7000 {
    big_pad.write_string("x")
  }
  let pad_str = big_pad.to_string()

  let cfg = MeshStationConfig::new(
    "ws-dyn",
    peer_id,
    ["https://relay.still.fail/"],
    fn(_dev : String, _fresh : Bool, ck : (effect::Exit[String]) -> Unit) -> Unit {
      ck(effect::Exit::Succeeded("cred-dyn"))
    },
    device_label="",
    get_lock_carry=Some(fn() -> MeshLockCarry {
      round += 1
      if round == 1 {
        MeshLockCarry::new(
          entries=[base_codec::json_obj([("seq", base_codec::json_int(1))])],
          person=Some(base_codec::json_arr([base_codec::json_obj([("pseq", base_codec::json_int(10))])])),
        )
      } else {
        // Round 2: entries updated to seq 2 AND entries+person exceed CARRY_BYTES (12 KiB) -> keep entries, drop person!
        MeshLockCarry::new(
          entries=[base_codec::json_obj([("seq", base_codec::json_int(2)), ("pad", base_codec::json_str(pad_str))])],
          person=Some(base_codec::json_arr([base_codec::json_obj([("pseq", base_codec::json_int(20)), ("pad", base_codec::json_str(pad_str))])])),
        )
      }
    }),
  )
  let (ctrl, _) = shell_mesh_transport(sh, cfg)

  // Handshake #1
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.connect_k(fn(_ : effect::Exit[mesh::Link]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  debug_assert(captured_hellos.length() == 1, "handshake #1 sent")
  let h1 = match base_codec::json_parse(captured_hellos[0]) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(e) => panic("bad h1: " + e)
  }
  let l1 = match base_codec::json_get(h1, "lock") { Some(v) => v; None => panic("missing lock in h1") }
  debug_assert(base_codec::json_get(l1, "label").is_some() && j_str(l1, "label") == "", "empty label always emitted")
  debug_assert(base_codec::json_stringify(l1).contains("\"seq\":1"), "handshake #1 carried seq 1")
  debug_assert(base_codec::json_get(l1, "person").is_some(), "handshake #1 carried person when within CARRY_BYTES")

  // Drop link and reconnect -> Handshake #2 must fetch updated entries dynamically!
  ctrl.drop_link()
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.connect_k(fn(_ : effect::Exit[mesh::Link]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  debug_assert(captured_hellos.length() == 2, "handshake #2 sent")
  let h2 = match base_codec::json_parse(captured_hellos[1]) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(e) => panic("bad h2: " + e)
  }
  let l2 = match base_codec::json_get(h2, "lock") { Some(v) => v; None => panic("missing lock in h2") }
  debug_assert(base_codec::json_stringify(l2).contains("\"seq\":2"), "handshake #2 dynamically fetched updated seq 2")
  debug_assert(base_codec::json_get(l2, "person").is_none(), "CARRY_BYTES budget drops person when entries+person > 12288 while keeping entries")

  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
}

test "W27a: moved workspace station refuses hello missing lock.person with lock_unconfirmed and admits hello carrying lock.person" {
  let rt = effect::Runtime::new()
  let storage : Map[String, Bytes] = Map::new()
  let mut local_ep_id = ""
  let mut next_conn_id = 40
  let mut next_stream_id = 50
  let mut ctrl_stream_id = 0
  let mut ctrl_last_reply = ""
  let mut ctrl_pending_read : Option[Int64] = None
  let peer_id = "3333444455556666777788889999aaaabbbbccccddddeeeeffff000011112222"
  let holder : Array[shell::Shell] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, bytes : Option[Bytes]) -> Unit {
      let s = holder[0]
      if op == "storage.get" {
        s.answer(id, base_codec::json_obj([]), bytes=storage.get(j_str(args, "key")))
        return
      }
      if op == "storage.set" {
        match bytes { Some(b) => storage.set(j_str(args, "key"), b); None => () }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "iroh.bind" {
        let seed = match bytes { Some(b) => b; None => Bytes::new(32) }
        local_ep_id = crypto::sha256_hex(seed)
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(14))]))
        return
      }
      if op == "iroh.connect" {
        let cid = next_conn_id
        next_conn_id += 1
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(cid))]))
        return
      }
      if op == "conn.closed" {
        return
      }
      if op == "conn.openBi" {
        ctrl_stream_id = next_stream_id
        next_stream_id += 1
        ctrl_last_reply = ""
        ctrl_pending_read = None
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(ctrl_stream_id))]))
        return
      }
      if op == "istream.write" {
        if j_int(args, "id") == ctrl_stream_id {
          let payload = match bytes { Some(b) => bytes_to_str(b); None => "" }
          // Simulated moved-workspace Station (`serve.ts:709-739`): require non-empty `lock.person` array!
          let has_person = match base_codec::json_parse(payload) {
            base_codec::JsonParseResult::Ok(hj) => match base_codec::json_get(hj, "lock") {
              Some(lj) => match base_codec::json_get(lj, "person") {
                Some(base_codec::Json::Arr(xs)) => xs.length() > 0
                _ => false
              }
              None => false
            }
            base_codec::JsonParseResult::Err(_) => false
          }
          ctrl_last_reply = if has_person {
            "{\"ok\":true,\"station\":{\"id\":\"st-moved\"}}\n"
          } else {
            "{\"ok\":false,\"code\":\"lock_unconfirmed\",\"error\":\"personal lock chain required for moved workspace\"}\n"
          }
          s.answer(id, base_codec::json_obj([]))
          match ctrl_pending_read {
            Some(rid) => {
              ctrl_pending_read = None
              s.answer(rid, base_codec::json_obj([]), bytes=Some(ctrl_last_reply.to_bytes()))
            }
            None => ()
          }
          return
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.read" {
        if j_int(args, "id") == ctrl_stream_id {
          if ctrl_last_reply.length() > 0 {
            s.answer(id, base_codec::json_obj([]), bytes=Some(ctrl_last_reply.to_bytes()))
          } else {
            ctrl_pending_read = Some(id)
          }
          return
        }
        s.answer(id, base_codec::json_obj([]), bytes=None)
        return
      }
      s.answer(id, base_codec::json_obj([]))
    },
    fn(op : String, _args : base_codec::Json) -> shell::AskResult {
      if op == "iroh.endpointId" { return shell::AskResult::Ok(base_codec::json_str(local_ep_id)) }
      if op == "iroh.relayStatus" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.closeReason" { return shell::AskResult::Ok(base_codec::json_null()) }
      if op == "conn.paths" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.stats" { return shell::AskResult::Ok(base_codec::json_obj([])) }
      if op == "ed25519.sign" { return shell::AskResult::Err(shell::ShellError::{ message: "pure pion" }) }
      shell::AskResult::Ok(base_codec::json_null())
    },
    fn(n : Int) -> Bytes {
      let out = Bytes::new(n)
      for i in 0..<n { out[i] = ((0x66 + i * 7) & 0xFF) as Byte }
      out
    },
  )
  holder.push(sh)

  let mut supply_person = false
  let cfg = MeshStationConfig::new(
    "ws-moved",
    peer_id,
    ["https://relay.still.fail/"],
    fn(_dev : String, _fresh : Bool, ck : (effect::Exit[String]) -> Unit) -> Unit {
      ck(effect::Exit::Succeeded("cred-moved"))
    },
    get_lock_carry=Some(fn() -> MeshLockCarry {
      if supply_person {
        MeshLockCarry::new(
          entries=[],
          person=Some(base_codec::json_arr([
            base_codec::json_obj([
              ("seq", base_codec::json_int(0)),
              ("genesis", base_codec::json_str("person-root-1")),
            ]),
          ])),
        )
      } else {
        MeshLockCarry::new()
      }
    }),
  )
  let (ctrl, _) = shell_mesh_transport(sh, cfg)

  // Attempt #1 without `person`: station refuses with `lock_unconfirmed`!
  let mut attempt1_ok = false
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.connect_k(fn(ex : effect::Exit[mesh::Link]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => { attempt1_ok = true }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(!attempt1_ok && ctrl.is_lock_unconfirmed(), "missing lock.person must be rejected with lock_unconfirmed")

  // Attempt #2 with `person` chain supplied dynamically: station admits!
  supply_person = true
  ctrl.drop_link()
  let mut attempt2_ok = false
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.connect_k(fn(ex : effect::Exit[mesh::Link]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => { attempt2_ok = true }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(attempt2_ok && !ctrl.is_lock_unconfirmed(), "hello carrying lock.person must be admitted by moved workspace station")
  match ctrl.admission() {
    Some(adm) => match adm.station_id {
      Some(sid) => debug_assert(sid == "st-moved", "admitted by st-moved")
      None => debug_assert(false, "expected station_id")
    }
    None => debug_assert(false, "expected admission")
  }

  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
}

test "W27a-P0: ClientCore constructed with offline_transport routes SSE chat-shared, GET /lock, and GET /chats?marks=1&own=1 over attached MeshStationTransport and stops on detach" {
  let rt = effect::Runtime::new()
  let mock_db = MockCloudDb::new()
  let storage : Map[String, Bytes] = Map::new()
  let mut local_ep_id = ""
  let mut next_stream_id = 100
  let mut ctrl_stream_id = 0
  let mut ctrl_wrote = false
  let mut ctrl_pending_read : Option[Int64] = None
  let stream_req_buf : Map[Int, String] = Map::new()
  let stream_read_step : Map[Int, Int] = Map::new()
  let stream_resp : Map[Int, String] = Map::new()
  let mut sse_stream_id = 0
  let mut sse_pending_read : Option[Int64] = None
  let mut saw_sse_reset = false
  let mut mesh_get_events_count = 0
  let mut mesh_get_chats_count = 0
  let mut mesh_get_lock_count = 0
  let mut mesh_get_marks_count = 0
  let peer_id = "444455556666777788889999aaaabbbbccccddddeeeeffff0000111122223333"

  let holder : Array[shell::Shell] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, bytes : Option[Bytes]) -> Unit {
      let s = holder[0]
      if op == "storage.get" {
        s.answer(id, base_codec::json_obj([]), bytes=storage.get(j_str(args, "key")))
        return
      }
      if op == "storage.set" {
        match bytes { Some(b) => storage.set(j_str(args, "key"), b); None => () }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "iroh.bind" {
        let seed = match bytes { Some(b) => b; None => Bytes::new(32) }
        local_ep_id = crypto::sha256_hex(seed)
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(15))]))
        return
      }
      if op == "iroh.connect" {
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(25))]))
        return
      }
      if op == "conn.closed" {
        return
      }
      if op == "conn.openBi" {
        let sid = next_stream_id
        next_stream_id += 1
        if ctrl_stream_id == 0 {
          ctrl_stream_id = sid
        }
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(sid))]))
        return
      }
      if op == "istream.write" {
        let sid = j_int(args, "id")
        let payload = match bytes { Some(b) => bytes_to_str(b); None => "" }
        if sid == ctrl_stream_id {
          ctrl_wrote = true
          s.answer(id, base_codec::json_obj([]))
          match ctrl_pending_read {
            Some(rid) => {
              ctrl_pending_read = None
              s.answer(rid, base_codec::json_obj([]), bytes=Some("{\"ok\":true,\"station\":{\"id\":\"st-prod-1\",\"name\":\"Prod Station\"}}\n".to_bytes()))
            }
            None => ()
          }
          return
        }
        let prev = match stream_req_buf.get(sid) { Some(p) => p; None => "" }
        let full = prev + payload
        stream_req_buf.set(sid, full)
        if full.contains("\"/events") {
          sse_stream_id = sid
          mesh_get_events_count += 1
          let sse_body = "{\"status\":200,\"headers\":{\"content-type\":\"text/event-stream\"}}\n" +
          "id: ev-1\nevent: chat-shared\ndata: {\"id\":\"c-mesh-1\",\"station\":\"st-prod-1\",\"thread\":11,\"title\":\"From Mesh SSE\",\"lastActive\":1700000001000}\n\n" +
          "id: ev-2\nevent: chat-mark\ndata: {\"session\":\"c-mesh-1\",\"thread\":11,\"read\":3}\n\n"
          stream_resp.set(sid, sse_body)
        } else if full.contains("\"/lock\"") {
          mesh_get_lock_count += 1
          stream_resp.set(sid, "{\"status\":404,\"headers\":{}}\n{\"error\":\"no_lock\"}")
        } else if full.contains("/chats?marks=1&own=1") {
          mesh_get_marks_count += 1
          stream_resp.set(sid, "{\"status\":200,\"headers\":{}}\n{\"chats\":[]}")
        } else if full.contains("\"/chats") {
          mesh_get_chats_count += 1
          stream_resp.set(sid, "{\"status\":200,\"headers\":{}}\n{\"chats\":[],\"entries\":[]}")
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.reset" {
        if j_int(args, "id") == sse_stream_id {
          saw_sse_reset = true
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.read" {
        let sid = j_int(args, "id")
        if sid == ctrl_stream_id {
          if ctrl_wrote {
            s.answer(id, base_codec::json_obj([]), bytes=Some("{\"ok\":true,\"station\":{\"id\":\"st-prod-1\",\"name\":\"Prod Station\"}}\n".to_bytes()))
          } else {
            ctrl_pending_read = Some(id)
          }
          return
        }
        let step = match stream_read_step.get(sid) { Some(n) => n; None => 0 }
        if sid == sse_stream_id {
          if step == 0 {
            stream_read_step.set(sid, 1)
            let body = match stream_resp.get(sid) { Some(b) => b; None => "" }
            s.answer(id, base_codec::json_obj([]), bytes=Some(body.to_bytes()))
          } else {
            sse_pending_read = Some(id)
          }
          return
        }
        if step == 0 {
          stream_read_step.set(sid, 1)
          let body = match stream_resp.get(sid) { Some(b) => b; None => "{\"status\":200,\"headers\":{}}\n{}" }
          s.answer(id, base_codec::json_obj([]), bytes=Some(body.to_bytes()))
        } else {
          s.answer(id, base_codec::json_obj([]), bytes=None)
        }
        return
      }
      s.answer(id, base_codec::json_obj([]))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      if op == "iroh.endpointId" { return shell::AskResult::Ok(base_codec::json_str(local_ep_id)) }
      if op == "iroh.relayStatus" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.closeReason" { return shell::AskResult::Ok(base_codec::json_null()) }
      if op == "conn.paths" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.stats" { return shell::AskResult::Ok(base_codec::json_obj([])) }
      if op == "ed25519.sign" { return shell::AskResult::Err(shell::ShellError::{ message: "pure pion" }) }
      mock_db.handle_sql(op, args)
    },
    fn(n : Int) -> Bytes {
      let out = Bytes::new(n)
      for i in 0..<n { out[i] = ((0x77 + i * 5) & 0xFF) as Byte }
      out
    },
  )
  holder.push(sh)

  let db = match sql::Sql::open(sh, "p0-mesh-attach-test") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic(e.to_string())
  }
  // Construct ClientCore with offline_transport (production cold-start path)!
  let core = ClientCore::new("ws-prod", "ws-prod/st-prod-1", rt, db, core_offline_transport(), fn() -> Unit {})
  let cfg = MeshStationConfig::new(
    "ws-prod",
    peer_id,
    ["https://relay.still.fail/"],
    fn(_dev : String, _fresh : Bool, ck : (effect::Exit[String]) -> Unit) -> Unit {
      ck(effect::Exit::Succeeded("cred-p0-live"))
    },
  )
  let (ctrl, tr) = shell_mesh_transport(sh, cfg)

  // Attach MeshStationTransport and start live sync!
  core.attach_station_transport("ws-prod/st-prod-1", tr)
  core.start()
  let _ = rt.run_ready()

  // 1. SSE chat-shared arrived over mesh link and persisted into SQLite `chat` table!
  debug_assert(mesh_get_events_count == 1, "GET /events opened over mesh link")
  debug_assert(mock_db.chats.get("ws-prod/st-prod-1:c-mesh-1").is_some(), "SSE chat-shared ingested into SQLite over mesh link")
  // 2. Initial GET /chats, GET /lock, and chat-mark-triggered GET /chats?marks=1&own=1 all went over mesh link!
  debug_assert(mesh_get_chats_count >= 1, "GET /chats snapshot went over mesh link")
  debug_assert(mesh_get_lock_count >= 1, "GET /lock went over mesh link")
  debug_assert(mesh_get_marks_count >= 1, "GET /chats?marks=1&own=1 went over mesh link")

  // 3. Detach transport -> SSE stream cancelled (`istream.reset`), state Disconnected, zero further mesh requests!
  let events_before = mesh_get_events_count
  let lock_before = mesh_get_lock_count
  let marks_before = mesh_get_marks_count
  core.detach_station_transport("ws-prod/st-prod-1")
  let _ = rt.run_ready()
  debug_assert(saw_sse_reset, "detach_station_transport cancels active mesh SSE stream")
  debug_assert(!core.events.is_running(), "events fiber stopped after detach")
  rt.advance(5000)
  let _ = rt.run_ready()
  debug_assert(
    mesh_get_events_count == events_before && mesh_get_lock_count == lock_before && mesh_get_marks_count == marks_before,
    "no further mesh requests after detach_station_transport",
  )

  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  let _ = sse_pending_read
}

test "W27a-P1: ClientCore loads personal-lock-<hex(sub)>, rejects corrupt chains, and mesh_lock_carry_for_core automatically carries hello.lock.person" {
  let rt = effect::Runtime::new()
  let mock_db = MockCloudDb::new()
  let storage : Map[String, Bytes] = Map::new()
  let mut local_ep_id = ""
  let mut ctrl_stream_id = 0
  let mut ctrl_last_reply = ""
  let mut ctrl_pending_read : Option[Int64] = None
  let peer_id = "55556666777788889999aaaabbbbccccddddeeeeffff00001111222233334444"
  let sub = "u-alice"

  // Verify storage key parity with `client/core-ts/src/personal-lock.ts:41` (`keptAs(sub)`).
  debug_assert(person_lock_storage_key(sub) == "personal-lock-752d616c696365", "person_lock_storage_key matches TS keptAs(sub)")

  // Sign a real Ed25519 genesis entry for `person:u-alice` that passes `lock::fold_person`!
  let seed = Bytes::new(32)
  for i in 0..<32 {
    seed[i] = ((0xA1 + i) & 0xFF) as Byte
  }
  let (pub_bytes, _) = mesh::ed25519_sign(seed, Bytes::new(0))
  let key_id = "ed25519:" + base_codec::hex_encode(pub_bytes)
  let dev_base_hex = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  let unsigned_codec = base_codec::json_obj([
    ("v", base_codec::json_int(1)),
    ("ws", base_codec::json_str("person:" + sub)),
    ("seq", base_codec::json_int(0)),
    ("prev", base_codec::json_null()),
    ("at", base_codec::json_int(1700000000)),
    ("kind", base_codec::json_str("genesis")),
    (
      "body",
      base_codec::json_obj([
        ("sub", base_codec::json_str(sub)),
        (
          "device",
          base_codec::json_obj([
            ("key", base_codec::json_str(key_id)),
            ("id", base_codec::json_str(dev_base_hex)),
            ("label", base_codec::json_str("Alice Mac")),
          ]),
        ),
      ]),
    ),
  ])
  let canonical_text = match form::entry_text(codec_to_form(unsigned_codec)) {
    Ok(t) => t
    Err(e) => panic("entry_text failed: " + e)
  }
  let entry_hash = crypto::sha256_hex(canonical_text.to_bytes())
  let to_sign = match lock_signed_bytes(entry_hash) {
    Some(b) => b
    None => panic("bad entry_hash")
  }
  let (_, sig_bytes) = mesh::ed25519_sign(seed, to_sign)
  let signed_entry = base_codec::json_obj([
    ("v", base_codec::json_int(1)),
    ("ws", base_codec::json_str("person:" + sub)),
    ("seq", base_codec::json_int(0)),
    ("prev", base_codec::json_null()),
    ("at", base_codec::json_int(1700000000)),
    ("kind", base_codec::json_str("genesis")),
    (
      "body",
      base_codec::json_obj([
        ("sub", base_codec::json_str(sub)),
        (
          "device",
          base_codec::json_obj([
            ("key", base_codec::json_str(key_id)),
            ("id", base_codec::json_str(dev_base_hex)),
            ("label", base_codec::json_str("Alice Mac")),
          ]),
        ),
      ]),
    ),
    (
      "sig",
      base_codec::json_obj([
        ("alg", base_codec::json_str("Ed25519")),
        ("key", base_codec::json_str(key_id)),
        ("sig", base_codec::json_str(base_codec::hex_encode(sig_bytes))),
      ]),
    ),
  ])
  let valid_chain = base_codec::json_arr([signed_entry])

  let holder : Array[shell::Shell] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, bytes : Option[Bytes]) -> Unit {
      let s = holder[0]
      if op == "storage.get" {
        s.answer(id, base_codec::json_obj([]), bytes=storage.get(j_str(args, "key")))
        return
      }
      if op == "storage.set" {
        match bytes { Some(b) => storage.set(j_str(args, "key"), b); None => () }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "iroh.bind" {
        let bseed = match bytes { Some(b) => b; None => Bytes::new(32) }
        local_ep_id = crypto::sha256_hex(bseed)
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(16))]))
        return
      }
      if op == "iroh.connect" {
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(26))]))
        return
      }
      if op == "conn.closed" {
        return
      }
      if op == "conn.openBi" {
        ctrl_stream_id = 60
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(60))]))
        return
      }
      if op == "istream.write" {
        if j_int(args, "id") == ctrl_stream_id {
          let payload = match bytes { Some(b) => bytes_to_str(b); None => "" }
          let has_valid_person = match base_codec::json_parse(payload) {
            base_codec::JsonParseResult::Ok(hj) => match base_codec::json_get(hj, "lock") {
              Some(lj) => match base_codec::json_get(lj, "person") {
                Some(base_codec::Json::Arr(xs)) => xs.length() == 1 && base_codec::json_stringify(xs[0]).contains("person:" + sub)
                _ => false
              }
              None => false
            }
            base_codec::JsonParseResult::Err(_) => false
          }
          ctrl_last_reply = if has_valid_person {
            "{\"ok\":true,\"station\":{\"id\":\"st-moved-prod\"}}\n"
          } else {
            "{\"ok\":false,\"code\":\"lock_unconfirmed\",\"error\":\"missing personal lock\"}\n"
          }
          s.answer(id, base_codec::json_obj([]))
          match ctrl_pending_read {
            Some(rid) => {
              ctrl_pending_read = None
              s.answer(rid, base_codec::json_obj([]), bytes=Some(ctrl_last_reply.to_bytes()))
            }
            None => ()
          }
          return
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "istream.read" {
        if j_int(args, "id") == ctrl_stream_id {
          if ctrl_last_reply.length() > 0 {
            s.answer(id, base_codec::json_obj([]), bytes=Some(ctrl_last_reply.to_bytes()))
          } else {
            ctrl_pending_read = Some(id)
          }
          return
        }
        s.answer(id, base_codec::json_obj([]), bytes=None)
        return
      }
      s.answer(id, base_codec::json_obj([]))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      if op == "iroh.endpointId" { return shell::AskResult::Ok(base_codec::json_str(local_ep_id)) }
      if op == "iroh.relayStatus" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.closeReason" { return shell::AskResult::Ok(base_codec::json_null()) }
      if op == "conn.paths" { return shell::AskResult::Ok(base_codec::json_arr([])) }
      if op == "conn.stats" { return shell::AskResult::Ok(base_codec::json_obj([])) }
      if op == "ed25519.sign" { return shell::AskResult::Err(shell::ShellError::{ message: "pure pion" }) }
      mock_db.handle_sql(op, args)
    },
    fn(n : Int) -> Bytes {
      let out = Bytes::new(n)
      for i in 0..<n { out[i] = ((0x88 + i * 3) & 0xFF) as Byte }
      out
    },
  )
  holder.push(sh)

  let db = match sql::Sql::open(sh, "p1-person-lock-test") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic(e.to_string())
  }
  let core = ClientCore::new("ws-moved-prod", "ws-moved-prod/st-moved-prod", rt, db, core_offline_transport(), fn() -> Unit {})

  // Reject corrupt / unsigned personal lock data!
  let corrupt = base_codec::json_arr([base_codec::json_obj([("ws", base_codec::json_str("person:" + sub))])])
  debug_assert(!core.load_person_lock_json(corrupt, sub), "corrupt personal lock chain must be rejected")
  debug_assert(core.person_lock_kept_entries().length() == 0, "corrupt load leaves kept entries empty")

  // Load valid signed personal lock chain into ClientCore!
  debug_assert(core.load_person_lock_json(valid_chain, sub), "valid Ed25519 personal lock chain accepted")
  debug_assert(core.person_lock_kept_entries().length() == 1, "kept 1 personal lock entry")

  // Do NOT pass `person` manually: `mesh_lock_carry_for_core(core)` must populate `hello.lock.person` automatically!
  let cfg = MeshStationConfig::new(
    "ws-moved-prod",
    peer_id,
    ["https://relay.still.fail/"],
    fn(_dev : String, _fresh : Bool, ck : (effect::Exit[String]) -> Unit) -> Unit {
      ck(effect::Exit::Succeeded("cred-moved-prod"))
    },
    get_lock_carry=Some(fn() -> MeshLockCarry { mesh_lock_carry_for_core(core) }),
  )
  let (ctrl, _) = shell_mesh_transport(sh, cfg)
  let mut admitted = false
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.connect_k(fn(ex : effect::Exit[mesh::Link]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => { admitted = true }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  debug_assert(admitted && !ctrl.is_lock_unconfirmed(), "moved workspace station automatically admitted hello.lock.person from ClientCore")

  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
}
