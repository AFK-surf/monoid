// Real `StationTransport` backed by `shell::Shell` (`fetch` + `stream.open`/`stream.read`/`stream.close`).
// Consumes station `/events` as a true streaming SSE response with zero polling and cleans up
// the stream handle on EOF, error, or fiber interruption.

import "base_codec"
import "effect"
import "mesh"
import "shell"
import "wire"

fn strip_trailing_slash(s : String) -> String {
  if s.length() > 0 && s.ends_with("/") {
    s.slice(0, s.length() - 1)
  } else {
    s
  }
}

fn join_base_url(base_url : String, path : String) -> String {
  let base = strip_trailing_slash(base_url)
  if path.length() == 0 {
    base
  } else if path.starts_with("/") {
    base + path
  } else {
    base + "/" + path
  }
}

fn with_auth_headers(headers : Array[(String, String)], auth_header : Option[String]) -> Array[(String, String)] {
  let out : Array[(String, String)] = []
  let mut has_auth = false
  for i in 0..<headers.length() {
    let (k, v) = headers[i]
    if k == "authorization" || k == "Authorization" {
      has_auth = true
    }
    out.push((k, v))
  }
  if !has_auth {
    match auth_header {
      Some(auth) => {
        if auth.length() > 0 {
          out.push(("authorization", auth))
        }
      }
      None => ()
    }
  }
  out
}

fn pump_stream_reads_k(
  sh : shell::Shell,
  stream_id : Int64,
  on_chunk : (Bytes) -> Unit,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if effect::is_interrupted() {
    sh.stream_close(stream_id)
    k(effect::Exit::Interrupted)
    return
  }
  let mut call_id = 0.to_int64()
  sh.stream_read_k(
    stream_id,
    fn(ex : effect::Exit[Option[Bytes]]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          if call_id > 0.to_int64() {
            sh.give_up(call_id)
          }
          sh.stream_close(stream_id)
          k(effect::Exit::Interrupted)
        }
        effect::Exit::Failed(e) => {
          sh.stream_close(stream_id)
          k(effect::Exit::Failed(e))
        }
        effect::Exit::Succeeded(opt) =>
        match opt {
          None => {
            sh.stream_close(stream_id)
            k(effect::Exit::Succeeded(()))
          }
          Some(chunk) => {
            if chunk.length() > 0 {
              on_chunk(chunk)
            }
            pump_stream_reads_k(sh, stream_id, on_chunk, k)
          }
        }
      }
    },
    called=fn(id : Int64) -> Unit { call_id = id },
  )
}

/// Build a live HTTP/SSE `StationTransport` on top of `shell::Shell`.
pub fn shell_http_transport(
  sh : shell::Shell,
  base_url : String,
  auth_header : Option[String] = None,
) -> StationTransport {
  StationTransport::{
    request_k: fn(
      method_name : String,
      path : String,
      headers : Array[(String, String)],
      body : Bytes,
      k : (effect::Exit[HttpReply]) -> Unit,
    ) -> Unit {
      let url = join_base_url(base_url, path)
      let req_headers = with_auth_headers(headers, auth_header)
      let body_opt : Option[Bytes] = if body.length() > 0 { Some(body) } else { None }
      let mut call_id = 0.to_int64()
      sh.fetch_k(
        method_name,
        url,
        req_headers,
        body_opt,
        fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
          match ex {
            effect::Exit::Interrupted => {
              if call_id > 0.to_int64() {
                sh.give_up(call_id)
              }
              k(effect::Exit::Interrupted)
            }
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(resp) =>
            k(effect::Exit::Succeeded(HttpReply::{
              status: resp.status,
              headers: resp.headers,
              body: resp.body,
            }))
          }
        },
        called=fn(id : Int64) -> Unit { call_id = id },
      )
    },
    stream_k: fn(
      path : String,
      headers : Array[(String, String)],
      on_chunk : (Bytes) -> Unit,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      let url = join_base_url(base_url, path)
      let req_headers = with_auth_headers(headers, auth_header)
      let mut open_call_id = 0.to_int64()
      sh.stream_open_k(
        "GET",
        url,
        req_headers,
        None,
        fn(ex : effect::Exit[shell::StreamHead]) -> Unit {
          match ex {
            effect::Exit::Interrupted => {
              if open_call_id > 0.to_int64() {
                sh.give_up(open_call_id)
              }
              k(effect::Exit::Interrupted)
            }
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(head) => {
              if head.status < 200 || head.status >= 300 {
                sh.stream_close(head.id)
                k(effect::Exit::Failed(effect::EffectError::Custom("events stream status " + head.status.to_string())))
                return
              }
              pump_stream_reads_k(sh, head.id, on_chunk, k)
            }
          }
        },
        called=fn(id : Int64) -> Unit { open_call_id = id },
      )
    },
  }
}

// ── Production `pion/base/packages/mesh` `StationTransport` ──
// Strictly aligned with `client/core-ts/src/station/mesh-wire.ts` & `client/core-ts/src/lock.ts`:
//   - ALPN: `"stillfail/admin/1"`
//   - Control stream hello: `{ credential, protocol: 2, lock: { device, proof, kind?, label?, entries? } }`
//     where `proof` is an Ed25519 signature over `stillfail-lock-endpoint/1\0<ws>\0<endpoint>` via `Mesh::sign`
//   - Parses `Link::admitted_k` metadata (`lock_unconfirmed`, `station`, refusal codes)
//   - Delegates all HTTP requests & `/events` SSE streams directly to `StationTransport::from_link(link)`
//   - Supports credential renewal (`Link::exchange_k`) and clean teardown (`Link::close` / `Mesh::drop_link` / `Mesh::close_k`).

pub fn station_mesh_alpn() -> String {
  "stillfail/admin/1"
}

pub fn station_mesh_protocol() -> Int {
  2
}

pub fn station_mesh_addresses_key() -> String {
  "station-addresses"
}

/// Byte budget for carrying `entries` + `person` in a station hello (`client/core-ts/src/lock.ts:25` `CARRY_BYTES`).
pub fn carry_bytes_limit() -> Int {
  12 * 1024
}

/// Dynamic lock carry payload fetched fresh on each handshake (`client/core-ts/src/sync/cloud.ts:624-631`).
pub struct MeshLockCarry {
  pub entries : Array[base_codec::Json]
  pub person : Option[base_codec::Json]
}

pub fn MeshLockCarry::new(
  entries : Array[base_codec::Json] = [],
  person : Option[base_codec::Json] = None,
) -> MeshLockCarry {
  MeshLockCarry::{ entries: entries, person: person }
}

/// Storage key for a person's own lock chain (`client/core-ts/src/personal-lock.ts:41` `keptAs(sub)`).
pub fn person_lock_storage_key(sub : String) -> String {
  "personal-lock-" + base_codec::hex_encode(sub.to_bytes())
}

/// Build a fresh `MeshLockCarry` from `ClientCore`'s kept lock entries (for `workspace`, defaulting
/// to `core.workspace`) and personal lock chain.
/// When `person` is `None` and `core` has a validated personal lock chain loaded, populates `person` automatically.
pub fn mesh_lock_carry_for_core(
  core : ClientCore,
  person : Option[base_codec::Json] = None,
  workspace : String = "",
) -> MeshLockCarry {
  let target_ws = if workspace.length() > 0 { workspace } else { core.workspace }
  let kept = core.lock_kept_entries_for(target_ws)
  let entries : Array[base_codec::Json] = []
  for i in 0..<kept.length() {
    entries.push(form_to_codec(kept[i]))
  }
  let person_opt = match person {
    Some(p) => Some(p)
    None => {
      let pchain = core.person_lock_kept_entries()
      if pchain.length() > 0 {
        Some(base_codec::json_arr(pchain))
      } else {
        None
      }
    }
  }
  MeshLockCarry::{ entries: entries, person: person_opt }
}

/// Build the device's endpoint lock claim (`client/core-ts/src/lock.ts:58-72` `claimBy` + `cloud.ts:624-631`),
/// signed with the mesh's Ed25519 device base key (`Mesh::sign`) over
/// `stillfail-lock-endpoint/1\0<workspace>\0<endpoint>`.
/// Always includes `label` (even when empty) and applies `CARRY_BYTES` budget trimming to `entries` and `person`.
pub fn build_lock_claim(
  m : mesh::Mesh,
  workspace : String,
  endpoint : String,
  kind : String = "",
  label : String = "",
  entries : Array[base_codec::Json] = [],
  person : Option[base_codec::Json] = None,
) -> base_codec::Json {
  let msg = endpoint_signed_bytes(workspace, endpoint)
  let (pk, sig) = m.sign(msg)
  let fields : Array[(String, base_codec::Json)] = [
    ("device", base_codec::json_str(base_codec::hex_encode(pk))),
    ("proof", base_codec::json_str(base_codec::hex_encode(sig))),
  ]
  if kind.length() > 0 {
    fields.push(("kind", base_codec::json_str(kind)))
  }
  fields.push(("label", base_codec::json_str(label)))
  let mut entries_bytes = 0
  if entries.length() > 0 {
    let ej = base_codec::json_arr(entries)
    let elen = base_codec::json_stringify(ej).length()
    if elen <= carry_bytes_limit() {
      fields.push(("entries", ej))
      entries_bytes = elen
    }
  }
  match person {
    Some(pj) => {
      let non_empty = match pj {
        base_codec::Json::Arr(xs) => xs.length() > 0
        base_codec::Json::Null => false
        _ => true
      }
      if non_empty {
        let plen = base_codec::json_stringify(pj).length()
        if plen <= carry_bytes_limit() && entries_bytes + plen <= carry_bytes_limit() {
          fields.push(("person", pj))
        }
      }
    }
    None => ()
  }
  base_codec::json_obj(fields)
}

/// Parse station lock-refusal control answers identically to `client/core-ts/src/station/mesh-wire.ts:518-525`.
pub fn station_mesh_refusal(answer : base_codec::Json, reason : String) -> Option[effect::EffectError] {
  match j_opt_str(answer, "code") {
    Some(code) => {
      if code == "lock_unconfirmed" {
        return Some(effect::EffectError::Custom("lock_unconfirmed:" + reason))
      }
      if code == "lock_station" {
        let why = match j_opt_str(answer, "why") {
          Some(w) => if w.length() > 0 { w } else { reason }
          None => reason
        }
        return Some(effect::EffectError::Custom("lock_station:" + why))
      }
      None
    }
    None => None
  }
}

/// Structured admission state parsed from `Link::admitted_k` or `Link::exchange_k`.
pub struct MeshAdmission {
  pub raw : base_codec::Json
  pub lock_unconfirmed : Bool
  pub station_id : Option[String]
  pub station_name : Option[String]
  pub error_code : Option[String]
  pub error_reason : Option[String]
}

pub fn parse_mesh_admission(ans : base_codec::Json) -> MeshAdmission {
  let code = j_opt_str(ans, "code")
  let err_reason = j_opt_str(ans, "error")
  let lock_unconfirmed = j_bool(ans, "lock_unconfirmed") || match code {
    Some(c) => c == "lock_unconfirmed"
    None => false
  }
  let (station_id, station_name) = match base_codec::json_get(ans, "station") {
    Some(base_codec::Json::Str(s)) => (Some(s), None)
    Some(st_obj) => (j_opt_str(st_obj, "id"), j_opt_str(st_obj, "name"))
    None => (j_opt_str(ans, "stationId"), j_opt_str(ans, "stationName"))
  }
  MeshAdmission::{
    raw: ans,
    lock_unconfirmed: lock_unconfirmed,
    station_id: station_id,
    station_name: station_name,
    error_code: code,
    error_reason: err_reason,
  }
}

fn effect_error_text(e : effect::EffectError) -> String {
  match e {
    effect::EffectError::Custom(s) => s
    effect::EffectError::IoError(s) => s
    effect::EffectError::Interrupt => "interrupted"
    effect::EffectError::QueueShutdown => "queue_shutdown"
    effect::EffectError::BothFailed(a, _) => effect_error_text(a)
  }
}

fn admission_from_error(e : effect::EffectError) -> MeshAdmission {
  let msg = effect_error_text(e)
  if msg.contains("lock_unconfirmed") {
    MeshAdmission::{
      raw: base_codec::json_obj([
        ("code", base_codec::json_str("lock_unconfirmed")),
        ("error", base_codec::json_str(msg)),
      ]),
      lock_unconfirmed: true,
      station_id: None,
      station_name: None,
      error_code: Some("lock_unconfirmed"),
      error_reason: Some(msg),
    }
  } else if msg.contains("lock_station") {
    MeshAdmission::{
      raw: base_codec::json_obj([
        ("code", base_codec::json_str("lock_station")),
        ("error", base_codec::json_str(msg)),
      ]),
      lock_unconfirmed: false,
      station_id: None,
      station_name: None,
      error_code: Some("lock_station"),
      error_reason: Some(msg),
    }
  } else {
    MeshAdmission::{
      raw: base_codec::json_obj([("error", base_codec::json_str(msg))]),
      lock_unconfirmed: false,
      station_id: None,
      station_name: None,
      error_code: Some("mesh_refused"),
      error_reason: Some(msg),
    }
  }
}

/// Configuration for a production `MeshStationTransport` connecting over `pion/base/packages/mesh`.
pub struct MeshStationConfig {
  pub workspace : String
  pub peer_id : String
  pub relays : Array[String]
  pub relay_only : Bool
  pub device_kind : String
  pub device_label : String
  pub lock_entries : Array[base_codec::Json]
  pub get_lock_carry : Option[() -> MeshLockCarry]
  pub link_scope : String
  pub theirs : Option[Array[String]]
  pub off : Option[Array[String]]
  pub get_credential_k : (String, Bool, (effect::Exit[String]) -> Unit) -> Unit
  pub on_admission : Option[(MeshAdmission) -> Unit]
  pub get_cred_epoch : Option[() -> Int64]
  pub on_admitted_epoch : Option[(Int64) -> Unit]
}

pub fn MeshStationConfig::new(
  workspace : String,
  peer_id : String,
  relays : Array[String],
  get_credential_k : (String, Bool, (effect::Exit[String]) -> Unit) -> Unit,
  relay_only : Bool = false,
  device_kind : String = "app",
  device_label : String = "",
  lock_entries : Array[base_codec::Json] = [],
  get_lock_carry : Option[() -> MeshLockCarry] = None,
  link_scope : String = "",
  theirs : Option[Array[String]] = None,
  off : Option[Array[String]] = None,
  on_admission : Option[(MeshAdmission) -> Unit] = None,
  get_cred_epoch : Option[() -> Int64] = None,
  on_admitted_epoch : Option[(Int64) -> Unit] = None,
) -> MeshStationConfig {
  MeshStationConfig::{
    workspace: workspace,
    peer_id: peer_id,
    relays: relays,
    relay_only: relay_only,
    device_kind: device_kind,
    device_label: device_label,
    lock_entries: lock_entries,
    get_lock_carry: get_lock_carry,
    link_scope: link_scope,
    theirs: theirs,
    off: off,
    get_credential_k: get_credential_k,
    on_admission: on_admission,
    get_cred_epoch: get_cred_epoch,
    on_admitted_epoch: on_admitted_epoch,
  }
}

/// Production `StationTransport` controller backed by `pion/base/packages/mesh` (`Mesh`, `Link`,
/// `Presented`, `Link::admitted_k`, `Link::exchange_k`, `Mesh::sign`, `StationTransport::from_link`).
/// Tracks monotonic real station-side admission evidence (`admitted_cred_epoch`) that advances ONLY
/// after `Link::admitted_k` (initial or reconnect) or `Link::exchange_k` succeeds and NEVER resets to 1.
pub struct MeshStationTransport {
  sh : shell::Shell
  config : MeshStationConfig
  gate : effect::Semaphore
  mut mesh_inst : Option[mesh::Mesh]
  mut active_link : Option[mesh::Link]
  mut active_transport : Option[StationTransport]
  mut last_admission : Option[MeshAdmission]
  mut admitted_cred_epoch : Int64
  mut live_link_admitted_epoch : Int64
  link_admitted_epochs : Map[Int, Int64]
  mut on_admitted_epoch_cb : Option[(Int64) -> Unit]
  mut admission_drive_fiber : Option[effect::Fiber[Unit]]
  mut admission_drive_target : Int64
  mut admission_drive_gen : Int64
  mut admission_drive_sleeping : Bool
  mut admission_blocked_by_lock : Bool
  mut lock_gen : Int64
  mut lock_catchup_tries : Int
  mut closed : Bool
}

let LOCK_BEHIND_TRIES : Int = 4

pub fn MeshStationTransport::new(
  sh : shell::Shell,
  config : MeshStationConfig,
) -> MeshStationTransport {
  MeshStationTransport::{
    sh: sh,
    config: config,
    gate: effect::Semaphore::new(1),
    mesh_inst: None,
    active_link: None,
    active_transport: None,
    last_admission: None,
    admitted_cred_epoch: 0L,
    live_link_admitted_epoch: 0L,
    link_admitted_epochs: Map::new(),
    on_admitted_epoch_cb: config.on_admitted_epoch,
    admission_drive_fiber: None,
    admission_drive_target: 0L,
    admission_drive_gen: 0L,
    admission_drive_sleeping: false,
    admission_blocked_by_lock: false,
    lock_gen: 0L,
    lock_catchup_tries: 0,
    closed: false,
  }
}

/// Monotonic credential epoch genuinely admitted by the station on this transport instance
/// (`Link::admitted_k` or `Link::exchange_k`). Starts at `0L` and NEVER resets to 1 on reconnect.
pub fn MeshStationTransport::admitted_cred_epoch(self : MeshStationTransport) -> Int64 {
  self.admitted_cred_epoch
}

/// Exact `(link.uid, admitted_cred_epoch)` identity of the CURRENT usable serving `active_link`.
/// Clears `active_link` / `active_transport` / `live_link_admitted_epoch` immediately if the link is
/// closed or no longer usable, and strictly looks up `link.uid` in `link_admitted_epochs` (0L if absent).
pub fn MeshStationTransport::live_link_identity(self : MeshStationTransport) -> (Int, Int64) {
  if self.closed {
    return (0, 0L)
  }
  match self.active_link {
    None => (0, 0L)
    Some(link) => {
      if !link.usable() {
        self.active_link = None
        self.active_transport = None
        self.live_link_admitted_epoch = 0L
        return (0, 0L)
      }
      let ep = match self.link_admitted_epochs.get(link.uid) {
        Some(v) => v
        None => 0L
      }
      self.live_link_admitted_epoch = ep
      (link.uid, ep)
    }
  }
}

/// Credential epoch genuinely admitted on the CURRENT live `active_link` serving requests/SSE.
/// Starts at `0L`, strictly bound to the active `link.uid`, and resets to `0L` when dropped/unusable.
pub fn MeshStationTransport::live_admitted_cred_epoch(self : MeshStationTransport) -> Int64 {
  self.live_link_identity().1
}

/// Register/replace the callback fired whenever a real station admission (`admitted_k`/`exchange_k`) completes.
pub fn MeshStationTransport::set_on_admitted_epoch(
  self : MeshStationTransport,
  cb : (Int64) -> Unit,
) -> Unit {
  self.on_admitted_epoch_cb = Some(cb)
}

fn MeshStationTransport::current_cred_epoch(self : MeshStationTransport) -> Int64 {
  match self.config.get_cred_epoch {
    Some(g) => g()
    None => 1L
  }
}

/// Whether the latest admission result was a lock refusal (`lock_unconfirmed` or `lock_station`,
/// aligned with `client/core-ts/src/station/link.ts:119`).
pub fn MeshStationTransport::is_lock_refusal(self : MeshStationTransport) -> Bool {
  match self.last_admission {
    Some(adm) => {
      if adm.lock_unconfirmed {
        return true
      }
      match adm.error_code {
        Some(c) => c == "lock_unconfirmed" || c == "lock_station"
        None => false
      }
    }
    None => false
  }
}

/// Current lock-change generation counter (incremented only when lock state actually advances or
/// Cloud workspace detail confirms, waking lock-blocked stations without spinning on duplicate refusals).
pub fn MeshStationTransport::lock_gen(self : MeshStationTransport) -> Int64 {
  self.lock_gen
}

/// Whether the admission reconnect driver stopped because the station refused with a lock error
/// after exhausting bounded catchup retries under the same `lock_gen`.
pub fn MeshStationTransport::is_admission_blocked_by_lock(self : MeshStationTransport) -> Bool {
  self.admission_blocked_by_lock
}

/// Advance `lock_gen`, reset bounded catchup retries, and clear any lock-refusal admission block
/// when workspace/personal lock state or Cloud confirmation updates. If the driver is currently
/// sleeping in a retry timer, cancels the sleep immediately so the caller's re-trigger dials now.
pub fn MeshStationTransport::clear_lock_admission_block(self : MeshStationTransport) -> Unit {
  self.lock_gen += 1L
  self.lock_catchup_tries = 0
  self.admission_blocked_by_lock = false
  if self.is_lock_refusal() {
    self.last_admission = None
  }
  if self.admission_drive_sleeping {
    self.cancel_admission_drive()
  }
}

/// Cancel any active scoped admission reconnect driver fiber.
pub fn MeshStationTransport::cancel_admission_drive(self : MeshStationTransport) -> Unit {
  self.admission_drive_gen += 1L
  self.admission_drive_target = 0L
  self.admission_drive_sleeping = false
  match self.admission_drive_fiber {
    Some(f) => {
      self.admission_drive_fiber = None
      f.interrupt()
    }
    None => ()
  }
}

/// Deduplicated, scoped post-downgrade admission reconnect driver:
/// dials ONLY `connect_k` -> `Link::admitted_k` (never business reads) until the live serving link
/// reaches `admitted_cred_epoch >= required_epoch`.
/// - On `lock_unconfirmed` / `lock_station` refusal:
///   - If `lock_gen` advanced during the dial (external lock change or `on_admission` evidence),
///     resets `lock_catchup_tries` and redials immediately without blocking;
///   - Otherwise performs at most `LOCK_BEHIND_TRIES` (4) bounded catchup retries (`1500ms * try`)
///     to absorb station lock propagation lag (matching `views/lock.ts:1441-1455`);
///   - After 4 refusals at the same `lock_gen`, sets `admission_blocked_by_lock = true` and stops.
/// - On transient network/credential failure, uses bounded exponential backoff `500ms..15000ms`.
pub fn MeshStationTransport::ensure_admitted_for_epoch(
  self : MeshStationTransport,
  rt : effect::Runtime,
  required_epoch : Int64,
  can_continue : () -> Bool,
) -> Unit {
  if self.closed || self.admission_blocked_by_lock || required_epoch <= 0L || !can_continue() {
    return
  }
  if self.live_admitted_cred_epoch() >= required_epoch {
    return
  }
  if required_epoch > self.admission_drive_target {
    self.admission_drive_target = required_epoch
  }
  if self.admission_drive_fiber.is_some() {
    return
  }
  self.admission_drive_gen += 1L
  let drive_gen = self.admission_drive_gen
  let mut step : (Int, (effect::Exit[Unit]) -> Unit) -> Unit = fn(_d : Int, _fk : (effect::Exit[Unit]) -> Unit) -> Unit {}
  step = fn(delay_ms : Int, fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    if self.closed || self.admission_blocked_by_lock || effect::is_interrupted() || self.admission_drive_gen != drive_gen || !can_continue() {
      if self.admission_drive_gen == drive_gen {
        self.admission_drive_fiber = None
        self.admission_drive_sleeping = false
      }
      fk(effect::Exit::Succeeded(()))
      return
    }
    let target = self.admission_drive_target
    if target <= 0L || self.live_admitted_cred_epoch() >= target {
      if self.admission_drive_gen == drive_gen {
        self.admission_drive_fiber = None
        self.admission_drive_sleeping = false
      }
      fk(effect::Exit::Succeeded(()))
      return
    }
    if self.active_link.is_some() && self.live_admitted_cred_epoch() < target {
      self.drop_link(reason="admission_stale")
    }
    let dial_lock_gen = self.lock_gen
    self.connect_k(fn(cex : effect::Exit[mesh::Link]) -> Unit {
      if self.closed || effect::is_interrupted() || self.admission_drive_gen != drive_gen || !can_continue() {
        if self.admission_drive_gen == drive_gen {
          self.admission_drive_fiber = None
          self.admission_drive_sleeping = false
        }
        fk(effect::Exit::Succeeded(()))
        return
      }
      let cur_target = self.admission_drive_target
      if cur_target <= 0L || self.live_admitted_cred_epoch() >= cur_target {
        if self.admission_drive_gen == drive_gen {
          self.admission_drive_fiber = None
          self.admission_drive_sleeping = false
        }
        fk(effect::Exit::Succeeded(()))
        return
      }
      if self.lock_gen != dial_lock_gen {
        // Lock advanced while dial was in-flight (or via `on_admission` signed evidence):
        // NEVER block — immediately redial with the updated lock state!
        self.lock_catchup_tries = 0
        self.admission_blocked_by_lock = false
        step(500, fk)
        return
      }
      if self.is_lock_refusal() {
        if self.lock_catchup_tries < LOCK_BEHIND_TRIES {
          self.lock_catchup_tries += 1
          let catchup_ms = 1500 * self.lock_catchup_tries
          self.admission_drive_sleeping = true
          // timer: retry after a failure (lock refusal), bounded at most 4 tries
          effect::sleep_k(catchup_ms, fn(sex : effect::Exit[Unit]) -> Unit {
            if self.admission_drive_gen == drive_gen {
              self.admission_drive_sleeping = false
            }
            match sex {
              effect::Exit::Interrupted => {
                if self.admission_drive_gen == drive_gen {
                  self.admission_drive_fiber = None
                }
                fk(effect::Exit::Interrupted)
              }
              _ => step(500, fk)
            }
          })
          return
        }
        // Exhausted 4 bounded catchup retries under the same `lock_gen`: stop until lock changes.
        self.admission_blocked_by_lock = true
        if self.admission_drive_gen == drive_gen {
          self.admission_drive_fiber = None
          self.admission_drive_sleeping = false
        }
        fk(effect::Exit::Succeeded(()))
        return
      }
      match cex {
        effect::Exit::Interrupted => {
          if self.admission_drive_gen == drive_gen {
            self.admission_drive_fiber = None
            self.admission_drive_sleeping = false
          }
          fk(effect::Exit::Interrupted)
        }
        _ => {
          let next_delay = if delay_ms * 2 > 15000 { 15000 } else { delay_ms * 2 }
          self.admission_drive_sleeping = true
          // timer: retry after a failure, with a backoff
          effect::sleep_k(delay_ms, fn(sex : effect::Exit[Unit]) -> Unit {
            if self.admission_drive_gen == drive_gen {
              self.admission_drive_sleeping = false
            }
            match sex {
              effect::Exit::Interrupted => {
                if self.admission_drive_gen == drive_gen {
                  self.admission_drive_fiber = None
                }
                fk(effect::Exit::Interrupted)
              }
              _ => step(next_delay, fk)
            }
          })
        }
      }
    })
  }
  let f = rt.fork_quiet_named("mesh-admit-drive:" + self.config.peer_id, fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    step(500, fk)
  })
  if self.admission_drive_gen == drive_gen && !self.closed && !self.admission_blocked_by_lock && self.live_admitted_cred_epoch() < self.admission_drive_target {
    self.admission_drive_fiber = Some(f)
  }
}

pub fn MeshStationTransport::admission(self : MeshStationTransport) -> Option[MeshAdmission] {
  self.last_admission
}

pub fn MeshStationTransport::is_lock_unconfirmed(self : MeshStationTransport) -> Bool {
  match self.last_admission {
    Some(adm) => adm.lock_unconfirmed
    None => false
  }
}

pub fn MeshStationTransport::device_id(self : MeshStationTransport) -> Option[String] {
  match self.mesh_inst {
    Some(m) => Some(m.device_id())
    None => None
  }
}

pub fn MeshStationTransport::link(self : MeshStationTransport) -> Option[mesh::Link] {
  self.active_link
}

fn MeshStationTransport::record_failed_admission(
  self : MeshStationTransport,
  e : effect::EffectError,
) -> Unit {
  let fallback = admission_from_error(e)
  let preserve = match (self.last_admission, fallback.error_code) {
    (Some(prev), Some(fc)) =>
    match prev.error_code {
      Some(pc) =>
      pc == fc && (
        base_codec::json_get(prev.raw, "lock").is_some() ||
        base_codec::json_get(prev.raw, "entries").is_some() ||
        base_codec::json_get(prev.raw, "person").is_some() ||
        base_codec::json_get(prev.raw, "out").is_some() ||
        base_codec::json_get(prev.raw, "left").is_some() ||
        base_codec::json_get(prev.raw, "why").is_some()
      )
      None => false
    }
    _ => false
  }
  if !preserve {
    self.last_admission = Some(fallback)
    match self.config.on_admission { Some(cb) => cb(fallback); None => () }
  }
}

fn MeshStationTransport::ensure_mesh_k(
  self : MeshStationTransport,
  k : (effect::Exit[mesh::Mesh]) -> Unit,
) -> Unit {
  if self.closed {
    k(effect::Exit::Failed(effect::EffectError::Custom("mesh transport closed")))
    return
  }
  match self.mesh_inst {
    Some(m) => {
      k(effect::Exit::Succeeded(m))
      return
    }
    None => ()
  }
  let opts = mesh::Options::new(
    station_mesh_alpn(),
    self.config.relays,
    relay_only=self.config.relay_only,
    says=[("protocol", base_codec::json_int(station_mesh_protocol()))],
    refusal=Some(fn(ans : base_codec::Json, reason : String) -> Option[effect::EffectError] {
      match station_mesh_refusal(ans, reason) {
        Some(err) => {
          let adm = parse_mesh_admission(ans)
          self.last_admission = Some(adm)
          match self.config.on_admission { Some(cb) => cb(adm); None => () }
          Some(err)
        }
        None => None
      }
    }),
  )
  let store = mesh::shell_store(self.sh)
  mesh::Mesh::make_k(
    self.sh,
    store,
    opts,
    fn(ex : effect::Exit[mesh::Mesh]) -> Unit {
      match ex {
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
        effect::Exit::Succeeded(m) => {
          if self.closed {
            m.close_k(fn(_ : effect::Exit[Unit]) -> Unit {})
            k(effect::Exit::Failed(effect::EffectError::Custom("mesh transport closed")))
            return
          }
          self.mesh_inst = Some(m)
          k(effect::Exit::Succeeded(m))
        }
      }
    },
    addresses=station_mesh_addresses_key(),
  )
}

/// Dial or reuse the authenticated `mesh::Link` for this station, awaiting control-stream
/// admission (`Link::admitted_k`) and surfacing `lock_unconfirmed` / station metadata.
pub fn MeshStationTransport::connect_k(
  self : MeshStationTransport,
  k : (effect::Exit[mesh::Link]) -> Unit,
) -> Unit {
  if self.closed {
    k(effect::Exit::Failed(effect::EffectError::Custom("mesh transport closed")))
    return
  }
  match self.active_link {
    Some(link) =>
    if link.usable() {
      k(effect::Exit::Succeeded(link))
      return
    } else {
      self.active_link = None
      self.active_transport = None
      self.live_link_admitted_epoch = 0L
    }
    None => ()
  }
  self.gate.with_permit_k(
    fn(pk : (effect::Exit[mesh::Link]) -> Unit) -> Unit {
      if self.closed {
        pk(effect::Exit::Failed(effect::EffectError::Custom("mesh transport closed")))
        return
      }
      match self.active_link {
        Some(link) =>
        if link.usable() {
          pk(effect::Exit::Succeeded(link))
          return
        } else {
          self.active_link = None
          self.active_transport = None
          self.live_link_admitted_epoch = 0L
        }
        None => ()
      }
      self.ensure_mesh_k(fn(mex : effect::Exit[mesh::Mesh]) -> Unit {
        match mex {
          effect::Exit::Interrupted => pk(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => pk(effect::Exit::Failed(e))
          effect::Exit::Succeeded(m) => {
            if self.closed {
              pk(effect::Exit::Failed(effect::EffectError::Custom("mesh transport closed")))
              return
            }
            let ws = self.config.workspace
            let dev_kind = self.config.device_kind
            let dev_label = self.config.device_label
            let fallback_entries = self.config.lock_entries
            let get_carry = self.config.get_lock_carry
            let get_cred = self.config.get_credential_k
            // Capture `cred_epoch` BEFORE fetching each credential; `admitted_cred_epoch` advances
            // ONLY AFTER `Link::admitted_k` confirms real station admission (never on cred fetch!).
            let presented_epoch_box : Array[Int64] = [0L]
            let cred_source = fn(device_id : String, fresh : Bool, ck : (effect::Exit[mesh::Presented]) -> Unit) -> Unit {
              let captured_ep = self.current_cred_epoch()
              get_cred(device_id, fresh, fn(cex : effect::Exit[String]) -> Unit {
                match cex {
                  effect::Exit::Interrupted => ck(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => ck(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(cred) => {
                    presented_epoch_box[0] = captured_ep
                    let carry = match get_carry {
                      Some(fetch_carry) => fetch_carry()
                      None => MeshLockCarry::{ entries: fallback_entries, person: None }
                    }
                    let claim = build_lock_claim(
                      m,
                      ws,
                      device_id,
                      kind=dev_kind,
                      label=dev_label,
                      entries=carry.entries,
                      person=carry.person,
                    )
                    ck(effect::Exit::Succeeded(mesh::Presented::new(cred, also=[("lock", claim)])))
                  }
                }
              })
            }
            m.link_k(
              self.config.peer_id,
              cred_source,
              fn(lex : effect::Exit[mesh::Link]) -> Unit {
                match lex {
                  effect::Exit::Interrupted => pk(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => {
                    self.record_failed_admission(e)
                    pk(effect::Exit::Failed(e))
                  }
                  effect::Exit::Succeeded(link) => {
                    if self.closed {
                      link.close(reason="closed")
                      pk(effect::Exit::Failed(effect::EffectError::Custom("mesh transport closed")))
                      return
                    }
                    link.admitted_k(fn(aex : effect::Exit[base_codec::Json]) -> Unit {
                      match aex {
                        effect::Exit::Interrupted => {
                          link.close(reason="interrupted")
                          pk(effect::Exit::Interrupted)
                        }
                        effect::Exit::Failed(e) => {
                          self.record_failed_admission(e)
                          link.close(reason="admission_refused")
                          pk(effect::Exit::Failed(e))
                        }
                        effect::Exit::Succeeded(ans) => {
                          if self.closed {
                            link.close(reason="closed")
                            pk(effect::Exit::Failed(effect::EffectError::Custom("mesh transport closed")))
                            return
                          }
                          let adm = parse_mesh_admission(ans)
                          self.last_admission = Some(adm)
                          self.active_link = Some(link)
                          self.active_transport = Some(StationTransport::from_link(link))
                          let uid = link.uid
                          if adm.error_code.is_none() && !adm.lock_unconfirmed {
                            self.admission_blocked_by_lock = false
                            self.lock_catchup_tries = 0
                            if presented_epoch_box[0] > 0L {
                              let prev = match self.link_admitted_epochs.get(uid) { Some(v) => v; None => 0L }
                              let next_ep = if presented_epoch_box[0] > prev { presented_epoch_box[0] } else { prev }
                              self.link_admitted_epochs.set(uid, next_ep)
                              self.live_link_admitted_epoch = next_ep
                              if next_ep > self.admitted_cred_epoch {
                                self.admitted_cred_epoch = next_ep
                              }
                              match self.on_admitted_epoch_cb {
                                Some(cb) => cb(next_ep)
                                None => ()
                              }
                            } else {
                              // Reused underlying link without fresh `get_cred`: strictly look up ONLY
                              // this exact `link.uid`'s recorded epoch (0L if unknown — NEVER inherit!).
                              let known_ep = match self.link_admitted_epochs.get(uid) { Some(v) => v; None => 0L }
                              self.live_link_admitted_epoch = known_ep
                              if known_ep > 0L {
                                match self.on_admitted_epoch_cb {
                                  Some(cb) => cb(known_ep)
                                  None => ()
                                }
                              }
                            }
                          } else {
                            self.link_admitted_epochs.remove(uid)
                            self.live_link_admitted_epoch = 0L
                          }
                          match self.config.on_admission { Some(cb) => cb(adm); None => () }
                          pk(effect::Exit::Succeeded(link))
                        }
                      }
                    })
                  }
                }
              },
              link_scope=self.config.link_scope,
              theirs=self.config.theirs,
              off=self.config.off,
            )
          }
        }
      })
    },
    k,
  )
}

/// Renew the Cloud member credential on the live control stream via `Link::exchange_k`.
/// Advances `link_admitted_epochs[target_uid]` ONLY after `Link::exchange_k` succeeds, and updates
/// `live_link_admitted_epoch` / callback ONLY if `active_link` still has `uid == target_uid`.
pub fn MeshStationTransport::refresh_credential_k(
  self : MeshStationTransport,
  credential : String,
  k : (effect::Exit[MeshAdmission]) -> Unit,
  cred_epoch : Option[Int64] = None,
) -> Unit {
  let presented_epoch = match cred_epoch {
    Some(ep) => ep
    None => self.current_cred_epoch()
  }
  match self.active_link {
    None => {
      self.live_link_admitted_epoch = 0L
      k(effect::Exit::Failed(effect::EffectError::Custom("no active mesh link to refresh")))
    }
    Some(link) => {
      if !link.usable() {
        self.active_link = None
        self.active_transport = None
        self.live_link_admitted_epoch = 0L
        k(effect::Exit::Failed(effect::EffectError::Custom("active mesh link is not usable")))
        return
      }
      let target_uid = link.uid
      link.exchange_k(credential, fn(ex : effect::Exit[base_codec::Json]) -> Unit {
        match ex {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => {
            self.record_failed_admission(e)
            k(effect::Exit::Failed(e))
          }
          effect::Exit::Succeeded(ans) => {
            let adm = parse_mesh_admission(ans)
            self.last_admission = Some(adm)
            if adm.error_code.is_none() && !adm.lock_unconfirmed && presented_epoch > 0L {
              let prev = match self.link_admitted_epochs.get(target_uid) { Some(v) => v; None => 0L }
              let next_ep = if presented_epoch > prev { presented_epoch } else { prev }
              self.link_admitted_epochs.set(target_uid, next_ep)
              if next_ep > self.admitted_cred_epoch {
                self.admitted_cred_epoch = next_ep
              }
              let still_current = match self.active_link {
                Some(cur) => cur.uid == target_uid && cur.usable()
                None => false
              }
              if still_current {
                self.live_link_admitted_epoch = next_ep
                match self.on_admitted_epoch_cb {
                  Some(cb) => cb(next_ep)
                  None => ()
                }
              }
            }
            match self.config.on_admission { Some(cb) => cb(adm); None => () }
            k(effect::Exit::Succeeded(adm))
          }
        }
      })
    }
  }
}

/// Drop the current peer link without closing the underlying `Mesh` endpoint.
pub fn MeshStationTransport::drop_link(self : MeshStationTransport, reason : String = "closed") -> Unit {
  self.live_link_admitted_epoch = 0L
  match self.active_link {
    Some(link) => {
      self.link_admitted_epochs.remove(link.uid)
      link.close(reason=reason)
      self.active_link = None
    }
    None => ()
  }
  self.active_transport = None
  match self.mesh_inst {
    Some(m) => m.drop_link(self.config.peer_id, link_scope=self.config.link_scope, reason=reason)
    None => ()
  }
}

/// Close the active link and tear down the underlying `Mesh` instance cleanly.
pub fn MeshStationTransport::close_k(
  self : MeshStationTransport,
  k : (effect::Exit[Unit]) -> Unit,
  reason : String = "closed",
) -> Unit {
  self.closed = true
  self.admission_blocked_by_lock = false
  self.lock_catchup_tries = 0
  self.cancel_admission_drive()
  self.link_admitted_epochs.clear()
  self.drop_link(reason=reason)
  match self.mesh_inst {
    Some(m) => {
      self.mesh_inst = None
      m.close_k(k)
    }
    None => k(effect::Exit::Succeeded(()))
  }
}

/// Expose this `MeshStationTransport` as a standard `StationTransport` backed by
/// `StationTransport::from_link(link)` (with real `reply.cancel()` on interruption/error).
pub fn MeshStationTransport::transport(self : MeshStationTransport) -> StationTransport {
  StationTransport::{
    request_k: fn(
      method_name : String,
      path : String,
      headers : Array[(String, String)],
      body : Bytes,
      k : (effect::Exit[HttpReply]) -> Unit,
    ) -> Unit {
      self.connect_k(fn(cex : effect::Exit[mesh::Link]) -> Unit {
        match cex {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(link) => {
            let tr = match self.active_transport {
              Some(t) => t
              None => {
                let t = StationTransport::from_link(link)
                self.active_transport = Some(t)
                t
              }
            }
            (tr.request_k)(method_name, path, headers, body, k)
          }
        }
      })
    },
    stream_k: fn(
      path : String,
      headers : Array[(String, String)],
      on_chunk : (Bytes) -> Unit,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      self.connect_k(fn(cex : effect::Exit[mesh::Link]) -> Unit {
        match cex {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(link) => {
            let tr = match self.active_transport {
              Some(t) => t
              None => {
                let t = StationTransport::from_link(link)
                self.active_transport = Some(t)
                t
              }
            }
            (tr.stream_k)(path, headers, on_chunk, k)
          }
        }
      })
    },
  }
}

/// Build a production `StationTransport` backed by `pion/base/packages/mesh` (`MeshStationTransport`).
pub fn shell_mesh_transport(
  sh : shell::Shell,
  config : MeshStationConfig,
) -> (MeshStationTransport, StationTransport) {
  let controller = MeshStationTransport::new(sh, config)
  (controller, controller.transport())
}
