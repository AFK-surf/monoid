// Real Cloud Sync engine mirroring `client/core-ts/src/sync/cloud.ts` & `src/cloud.ts`.
// Fetches `/v1/me`, `/v1/workspaces/<ws>`, `/v1/workspaces/<ws>/credential` over `shell::Shell`,
// persists into local SQLite (`account_doc`, `workspace`) in `sql::Burst` transactions,
// and consumes `/v1/events` WebSocket with exponential backoff (1000ms..60000ms, zero polling).

import "base_codec"
import "effect"
import "shell"
import "sql"
import "store"

pub fn sql_account_doc_put() -> String {
  "INSERT OR REPLACE INTO account_doc (name, json, confirmed) VALUES (?, ?, ?)"
}

pub fn sql_workspace_put() -> String {
  "INSERT OR REPLACE INTO workspace (id, json, confirmed) VALUES (?, ?, ?)"
}

/// Exponential reconnect backoff for cloud `/v1/events` WebSocket (1000ms..60000ms).
pub fn cloud_ws_backoff_ms(attempt : Int) -> Int {
  let clamped = if attempt < 0 { 0 } else if attempt > 6 { 6 } else { attempt }
  let ms = 1000 << clamped
  if ms > 60000 { 60000 } else { ms }
}

pub fn cloud_events_ws_url(origin : String) -> String {
  let clean = strip_trailing_slash(origin)
  if clean.starts_with("https://") {
    "wss://" + clean.slice(8, clean.length()) + "/v1/events"
  } else if clean.starts_with("http://") {
    "ws://" + clean.slice(7, clean.length()) + "/v1/events"
  } else if clean.starts_with("wss://") || clean.starts_with("ws://") {
    clean + "/v1/events"
  } else {
    "ws://" + clean + "/v1/events"
  }
}

pub struct CloudWorkspaceRef {
  pub id : String
  pub name : String
  pub role : String
}

pub struct CloudMe {
  pub sub : String
  pub email : String
  pub name : String
  pub workspaces : Array[CloudWorkspaceRef]
  pub raw_workspace_ids : Array[String]
  pub retain_handled : Bool
  pub relays : Array[String]
  pub raw : base_codec::Json
}

pub struct CloudMember {
  pub sub : String
  pub email : String
  pub role : String
}

pub struct CloudStation {
  pub id : String
  pub name : String
  pub online : Bool
  pub url : Option[String]
  pub endpoint_id : Option[String]
  pub relay : Option[String]
  pub ips : Array[String]
  pub mode : Option[String]
  pub emoji : Option[String]
  pub icon : Option[String]
  pub version : Option[String]
  pub joined : Bool
}

pub struct CloudWorkspace {
  pub id : String
  pub name : String
  pub rev : Int
  pub members : Array[CloudMember]
  pub stations : Array[CloudStation]
  pub raw : base_codec::Json
}

pub struct MemberCredential {
  pub credential : String
  pub issued_at : Int64
  pub expires_at : Int64
  pub relay_url : String
}

pub enum CloudEvent {
  WorkspacesChanged(base_codec::Json)
  WorkspaceChanged(String, base_codec::Json)
  StationStatusChanged(String, String, Bool)
  Release
  Other(String, base_codec::Json)
}

fn cloud_auth_headers(token : String, json_body : Bool = false) -> Array[(String, String)] {
  let headers : Array[(String, String)] = []
  if token.length() > 0 {
    headers.push(("authorization", "Bearer " + token))
  }
  if json_body {
    headers.push(("content-type", "application/json"))
  }
  headers
}

fn parse_cloud_error(status : Int, body : Bytes) -> String {
  let text = bytes_to_str(body)
  match base_codec::json_parse(text) {
    base_codec::JsonParseResult::Ok(j) =>
    match j_opt_str(j, "error") {
      Some(code) => code + " (" + status.to_string() + ")"
      None => "http_" + status.to_string()
    }
    base_codec::JsonParseResult::Err(_) => "http_" + status.to_string()
  }
}

fn parse_cloud_me(j : base_codec::Json) -> CloudMe {
  let user = match base_codec::json_get(j, "user") {
    Some(u) => u
    None => j
  }
  let sub = j_str(user, "sub")
  let email = j_str(user, "email")
  let name = j_str(user, "name")
  let workspaces : Array[CloudWorkspaceRef] = []
  match base_codec::json_get(j, "workspaces") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        let w = xs[i]
        let wid = j_str(w, "id")
        if wid.length() > 0 {
          workspaces.push(CloudWorkspaceRef::{
            id: wid,
            name: j_str(w, "name"),
            role: j_str(w, "role"),
          })
        }
      }
    }
    _ => ()
  }
  let relays : Array[String] = []
  match base_codec::json_get(j, "relay_urls") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match xs[i] {
          base_codec::Json::Str(u) => if u.length() > 0 { relays.push(u) }
          _ => ()
        }
      }
    }
    _ => ()
  }
  if relays.length() == 0 {
    match base_codec::json_get(j, "relays") {
      Some(base_codec::Json::Arr(xs)) => {
        for i in 0..<xs.length() {
          match xs[i] {
            base_codec::Json::Str(u) => if u.length() > 0 { relays.push(u) }
            _ => ()
          }
        }
      }
      _ => ()
    }
  }
  if relays.length() == 0 {
    match j_opt_str(j, "relay_url") {
      Some(u) => if u.length() > 0 { relays.push(u) }
      None => ()
    }
  }
  let raw_workspace_ids : Array[String] = []
  for i in 0..<workspaces.length() {
    raw_workspace_ids.push(workspaces[i].id)
  }
  CloudMe::{
    sub: sub,
    email: email,
    name: name,
    workspaces: workspaces,
    raw_workspace_ids: raw_workspace_ids,
    retain_handled: false,
    relays: relays,
    raw: j,
  }
}

fn parse_cloud_workspace(ws_id : String, j : base_codec::Json) -> CloudWorkspace {
  let id = {
    let parsed_id = j_str(j, "id")
    if parsed_id.length() > 0 { parsed_id } else { ws_id }
  }
  let name = j_str(j, "name")
  let rev = j_int(j, "rev")
  let members : Array[CloudMember] = []
  match base_codec::json_get(j, "members") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        let m = xs[i]
        members.push(CloudMember::{
          sub: j_str(m, "sub"),
          email: j_str(m, "email"),
          role: j_str(m, "role"),
        })
      }
    }
    _ => ()
  }
  let stations : Array[CloudStation] = []
  match base_codec::json_get(j, "stations") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        let s = xs[i]
        let sid = j_str(s, "id")
        if sid.length() > 0 {
          let endpoint_id = match j_opt_str(s, "endpoint_id") {
            Some(v) => Some(v)
            None => j_opt_str(s, "endpointId")
          }
          let relay = match j_opt_str(s, "relay") {
            Some(v) => Some(v)
            None =>
            match j_opt_str(s, "relay_url") {
              Some(v) => Some(v)
              None => j_opt_str(s, "relayUrl")
            }
          }
          let ips : Array[String] = []
          match base_codec::json_get(s, "ips") {
            Some(base_codec::Json::Arr(ip_xs)) => {
              for k in 0..<ip_xs.length() {
                match ip_xs[k] {
                  base_codec::Json::Str(ip) => if ip.length() > 0 { ips.push(ip) }
                  _ => ()
                }
              }
            }
            _ => ()
          }
          stations.push(CloudStation::{
            id: sid,
            name: j_str(s, "name"),
            online: j_bool(s, "online"),
            url: j_opt_str(s, "url"),
            endpoint_id: endpoint_id,
            relay: relay,
            ips: ips,
            mode: j_opt_str(s, "mode"),
            emoji: j_opt_str(s, "emoji"),
            icon: j_opt_str(s, "icon"),
            version: j_opt_str(s, "version"),
            joined: j_bool(s, "joined"),
          })
        }
      }
    }
    _ => ()
  }
  CloudWorkspace::{
    id: id,
    name: name,
    rev: rev,
    members: members,
    stations: stations,
    raw: j,
  }
}

/// Read the persisted Cloud workspace JSON from SQLite `workspace` table and return its stations.
pub fn list_workspace_stations(db : sql::Sql, ws_id : String) -> Array[CloudStation] {
  if ws_id.length() == 0 {
    return []
  }
  match store::get_workspace(db, ws_id) {
    sql::SqlResult::Ok(Some(row)) =>
    match base_codec::json_parse(row.json) {
      base_codec::JsonParseResult::Ok(j) => parse_cloud_workspace(ws_id, j).stations
      base_codec::JsonParseResult::Err(_) => []
    }
    _ => []
  }
}

fn parse_member_credential(j : base_codec::Json) -> Result[MemberCredential, String] {
  let cred = match j_opt_str(j, "credential") {
    Some(s) => s
    None => return Err("missing field credential")
  }
  let issued_at = match j_opt_int64(j, "issued_at") {
    Some(v) => v
    None => return Err("missing field issued_at")
  }
  let expires_at = match j_opt_int64(j, "expires_at") {
    Some(v) => v
    None => return Err("missing field expires_at")
  }
  let relay_url = match j_opt_str(j, "relay_url") {
    Some(s) => s
    None => ""
  }
  Ok(MemberCredential::{
    credential: cred,
    issued_at: issued_at,
    expires_at: expires_at,
    relay_url: relay_url,
  })
}

fn parse_cloud_event(text : String) -> Option[CloudEvent] {
  if text == "pong" || text.length() == 0 {
    return None
  }
  let j = match base_codec::json_parse(text) {
    base_codec::JsonParseResult::Ok(v) => v
    base_codec::JsonParseResult::Err(_) => return None
  }
  let ev_type = j_str(j, "type")
  if ev_type == "workspaces" {
    Some(CloudEvent::WorkspacesChanged(j))
  } else if ev_type == "workspace" {
    let wid = j_str(j, "id")
    if wid.length() > 0 {
      Some(CloudEvent::WorkspaceChanged(wid, j))
    } else {
      None
    }
  } else if ev_type == "station" {
    let wid = j_str(j, "workspace")
    let sid = j_str(j, "id")
    if wid.length() > 0 && sid.length() > 0 {
      Some(CloudEvent::StationStatusChanged(wid, sid, j_bool(j, "online")))
    } else {
      None
    }
  } else if ev_type == "release" {
    Some(CloudEvent::Release)
  } else if ev_type.length() > 0 {
    Some(CloudEvent::Other(ev_type, j))
  } else {
    None
  }
}

/// Fetch `GET <origin>/v1/me`, parse account/workspaces/relays, and persist to SQLite `account_doc`.
pub fn fetch_me_k(
  sh : shell::Shell,
  origin : String,
  token : String,
  db : sql::Sql,
  k : (effect::Exit[CloudMe]) -> Unit,
) -> Unit {
  let url = join_base_url(origin, "/v1/me")
  sh.fetch_k("GET", url, cloud_auth_headers(token), None, fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed /v1/me json: " + e)))
            return
          }
        }
        let me = parse_cloud_me(j)
        let raw_json = base_codec::json_stringify(j)
        let now_ms = sh.rt.now()
        let burst = sql::Burst::new(db)
        match burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
          match b.run(sql_account_doc_put(), params=[
            base_codec::json_str("me"),
            base_codec::json_str(raw_json),
            base_codec::json_int64(now_ms),
          ]) {
            sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
          }
        }) {
          sql::SqlResult::Err(e) => k(effect::Exit::Failed(effect::EffectError::Custom(e.to_string())))
          sql::SqlResult::Ok(_) => k(effect::Exit::Succeeded(me))
        }
      }
    }
  })
}

/// Fetch `GET <origin>/v1/workspaces/<ws_id>`, parse members & stations, and persist to SQLite `workspace`.
pub fn fetch_workspace_k(
  sh : shell::Shell,
  origin : String,
  token : String,
  ws_id : String,
  db : sql::Sql,
  k : (effect::Exit[CloudWorkspace]) -> Unit,
) -> Unit {
  let url = join_base_url(origin, "/v1/workspaces/" + ws_id)
  sh.fetch_k("GET", url, cloud_auth_headers(token), None, fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed workspace json: " + e)))
            return
          }
        }
        let ws = parse_cloud_workspace(ws_id, j)
        let raw_json = base_codec::json_stringify(j)
        let now_ms = sh.rt.now()
        let burst = sql::Burst::new(db)
        match burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
          // Cloud MUST NEVER overwrite station-owned `station(address, "overview")` rows;
          // full Cloud workspace metadata (including station roster) lives strictly in `workspace.json`.
          match b.run(sql_workspace_put(), params=[
            base_codec::json_str(ws.id),
            base_codec::json_str(raw_json),
            base_codec::json_int64(now_ms),
          ]) {
            sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
          }
        }) {
          sql::SqlResult::Err(e) => k(effect::Exit::Failed(effect::EffectError::Custom(e.to_string())))
          sql::SqlResult::Ok(_) => k(effect::Exit::Succeeded(ws))
        }
      }
    }
  })
}

/// Request a signed member credential (`POST <origin>/v1/workspaces/<ws_id>/credential`).
pub fn fetch_member_credential_k(
  sh : shell::Shell,
  origin : String,
  token : String,
  ws_id : String,
  device : String,
  k : (effect::Exit[MemberCredential]) -> Unit,
) -> Unit {
  let url = join_base_url(origin, "/v1/workspaces/" + ws_id + "/credential")
  let body = base_codec::json_stringify(base_codec::json_obj([("device", base_codec::json_str(device))])).to_bytes()
  sh.fetch_k("POST", url, cloud_auth_headers(token, json_body=true), Some(body), fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed credential json: " + e)))
            return
          }
        }
        match parse_member_credential(j) {
          Ok(c) => k(effect::Exit::Succeeded(c))
          Err(e) => k(effect::Exit::Failed(effect::EffectError::Custom(e)))
        }
      }
    }
  })
}

fn ws_read_loop_k(
  sh : shell::Shell,
  ws_id : Int64,
  on_event : (CloudEvent) -> Unit,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if effect::is_interrupted() {
    sh.ws_close(ws_id)
    k(effect::Exit::Interrupted)
    return
  }
  sh.ws_next_k(ws_id, fn(ex : effect::Exit[shell::WsMessage]) -> Unit {
    match ex {
      effect::Exit::Interrupted => {
        sh.ws_close(ws_id)
        k(effect::Exit::Interrupted)
      }
      effect::Exit::Failed(e) => {
        sh.ws_close(ws_id)
        k(effect::Exit::Failed(e))
      }
      effect::Exit::Succeeded(msg) =>
      match msg {
        shell::WsMessage::Text(txt) => {
          match parse_cloud_event(txt) {
            Some(ev) => on_event(ev)
            None => ()
          }
          ws_read_loop_k(sh, ws_id, on_event, k)
        }
        shell::WsMessage::Ping | shell::WsMessage::Pong | shell::WsMessage::Binary(_) => {
          ws_read_loop_k(sh, ws_id, on_event, k)
        }
        shell::WsMessage::Close(_, _) => {
          sh.ws_close(ws_id)
          k(effect::Exit::Succeeded(()))
        }
      }
    }
  })
}

fn events_ws_loop_k(
  sh : shell::Shell,
  origin : String,
  get_token : () -> String,
  can_refresh : () -> Bool,
  refresh_token_k : ((effect::Exit[Bool]) -> Unit) -> Unit,
  on_open : () -> Unit,
  on_event : (CloudEvent) -> Unit,
  attempt : Int,
  k : (effect::Exit[Unit]) -> Unit,
  refreshed_this_cycle : Bool = false,
) -> Unit {
  if effect::is_interrupted() {
    k(effect::Exit::Interrupted)
    return
  }
  let url = cloud_events_ws_url(origin)
  let token = get_token()
  let protocols : Array[String] = if token.length() > 0 {
    ["stillfail-events", "stillfail-token." + token]
  } else {
    ["stillfail-events"]
  }
  let schedule_backoff = fn(next_attempt : Int) -> Unit {
    // timer: exponential backoff on failed/closed cloud `/v1/events` WebSocket (1000ms..60000ms).
    let delay = cloud_ws_backoff_ms(next_attempt)
    effect::sleep_k(delay, fn(sex : effect::Exit[Unit]) -> Unit {
      match sex {
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
        _ => events_ws_loop_k(sh, origin, get_token, can_refresh, refresh_token_k, on_open, on_event, next_attempt + 1, k, refreshed_this_cycle=false)
      }
    })
  }
  let mut open_call_id = 0.to_int64()
  sh.ws_open_k(
    url,
    [],
    protocols,
    fn(ex : effect::Exit[Int64]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          if open_call_id > 0.to_int64() {
            sh.give_up(open_call_id)
          }
          k(effect::Exit::Interrupted)
        }
        effect::Exit::Failed(_) => {
          if !refreshed_this_cycle && can_refresh() {
            refresh_token_k(fn(rex : effect::Exit[Bool]) -> Unit {
              match rex {
                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                effect::Exit::Succeeded(true) =>
                events_ws_loop_k(sh, origin, get_token, can_refresh, refresh_token_k, on_open, on_event, 0, k, refreshed_this_cycle=true)
                _ => schedule_backoff(attempt)
              }
            })
            return
          }
          schedule_backoff(attempt)
        }
        effect::Exit::Succeeded(ws_id) => {
          let opened_at = sh.rt.now()
          on_open()
          ws_read_loop_k(sh, ws_id, on_event, fn(rex : effect::Exit[Unit]) -> Unit {
            match rex {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              _ => {
                let held_ms = sh.rt.now() - opened_at
                if held_ms < 5000.to_int64() && !refreshed_this_cycle && can_refresh() {
                  refresh_token_k(fn(rfx : effect::Exit[Bool]) -> Unit {
                    match rfx {
                      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                      effect::Exit::Succeeded(true) =>
                      events_ws_loop_k(sh, origin, get_token, can_refresh, refresh_token_k, on_open, on_event, 0, k, refreshed_this_cycle=true)
                      _ => schedule_backoff(attempt)
                    }
                  })
                  return
                }
                let next_attempt = if held_ms >= 60000.to_int64() { 0 } else { attempt }
                schedule_backoff(next_attempt)
              }
            }
          })
        }
      }
    },
    called=fn(id : Int64) -> Unit { open_call_id = id },
  )
}

/// Start consuming `/v1/events` WebSocket on a scoped fiber of `sh.rt` with exponential backoff (`1000ms..60000ms`).
pub fn start_events_ws(
  sh : shell::Shell,
  origin : String,
  token : String,
  on_event : (CloudEvent) -> Unit,
) -> effect::Fiber[Unit] {
  sh.rt.fork_quiet_named("cloud-events-ws", fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    events_ws_loop_k(
      sh,
      origin,
      fn() -> String { token },
      fn() -> Bool { false },
      fn(rk : (effect::Exit[Bool]) -> Unit) -> Unit { rk(effect::Exit::Succeeded(false)) },
      fn() -> Unit {},
      on_event,
      0,
      k,
    )
  })
}

/// Generate a valid 26-character Crockford Base32 ULID matching `cloud/src/auth.ts:95`
/// (`^[0-7][0-9A-HJKMNP-TV-Z]{25}$`): 48-bit millisecond timestamp (10 chars) + 80-bit random (16 chars).
pub fn generate_ulid(now_ms : Int64, rand10 : Bytes) -> String {
  let alpha = "0123456789ABCDEFGHJKMNPQRSTVWXYZ".to_bytes()
  let sb = StringBuilder::new()
  let ts = (if now_ms < 0L { 0L } else { now_ms }) & 281474976710655L
  let shifts : Array[Int] = [45, 40, 35, 30, 25, 20, 15, 10, 5, 0]
  for i in 0..<shifts.length() {
    let idx = ((ts >> shifts[i]) & 31L).to_int()
    sb.write_byte(alpha[idx])
  }
  let rb = fn(idx : Int) -> Int {
    if idx < rand10.length() {
      rand10[idx].to_int() & 255
    } else {
      0
    }
  }
  for chunk in 0..<2 {
    let off = chunk * 5
    let b0 = rb(off)
    let b1 = rb(off + 1)
    let b2 = rb(off + 2)
    let b3 = rb(off + 3)
    let b4 = rb(off + 4)
    sb.write_byte(alpha[(b0 >> 3) & 31])
    sb.write_byte(alpha[((b0 & 7) << 2) | ((b1 >> 6) & 3)])
    sb.write_byte(alpha[(b1 >> 1) & 31])
    sb.write_byte(alpha[((b1 & 1) << 4) | ((b2 >> 4) & 15)])
    sb.write_byte(alpha[((b2 & 15) << 1) | ((b3 >> 7) & 1)])
    sb.write_byte(alpha[(b3 >> 2) & 31])
    sb.write_byte(alpha[((b3 & 3) << 3) | ((b4 >> 5) & 7)])
    sb.write_byte(alpha[b4 & 31])
  }
  sb.to_string()
}

/// Stateful Cloud Sync coordinator holding credential cache, unified monotonic `cloud_req_seq`
/// across `/v1/me` and `/v1/workspaces/<ws>` (preventing bidirectional stale 403/200 inversions),
/// authority hooks, refresh-token renewal, and `/v1/events` WebSocket fiber.
pub struct CloudSync {
  pub sh : shell::Shell
  pub db : sql::Sql
  mut origin : String
  mut token : String
  mut refresh_token : String
  mut refresh_seq : Int64
  cred_cache : Map[String, MemberCredential]
  mut ws_fiber : Option[effect::Fiber[Unit]]
  mut next_global_req_seq : Int64
  ws_last_applied_seq : Map[String, Int64]
  ws_membership_epoch : Map[String, Int64]
  mut me_last_applied_seq : Int64
  known_workspaces : Map[String, Bool]
  mut is_workspace_revoked : Option[(String) -> Bool]
  mut on_me_fetched : Option[(CloudMe) -> Unit]
  mut on_workspace_fetched : Option[(String, CloudWorkspace) -> Unit]
  mut on_workspace_revoked : Option[(String, Int) -> Unit]
  mut on_token_refreshed : Option[(String, String) -> Unit]
}

pub fn CloudSync::new(sh : shell::Shell, db : sql::Sql, origin : String, token : String = "") -> CloudSync {
  let known : Map[String, Bool] = Map::new()
  match store::list_workspaces(db) {
    sql::SqlResult::Ok(rows) => {
      for i in 0..<rows.length() {
        if rows[i].id.length() > 0 {
          known.set(rows[i].id, true)
        }
      }
    }
    sql::SqlResult::Err(_) => ()
  }
  CloudSync::{
    sh: sh,
    db: db,
    origin: origin,
    token: token,
    refresh_token: "",
    refresh_seq: 1L,
    cred_cache: Map::new(),
    ws_fiber: None,
    next_global_req_seq: 1L,
    ws_last_applied_seq: Map::new(),
    ws_membership_epoch: Map::new(),
    me_last_applied_seq: 0L,
    known_workspaces: known,
    is_workspace_revoked: None,
    on_me_fetched: None,
    on_workspace_fetched: None,
    on_workspace_revoked: None,
    on_token_refreshed: None,
  }
}

pub fn CloudSync::set_origin_and_token(self : CloudSync, origin : String, token : String) -> Unit {
  if origin.length() > 0 {
    self.origin = origin
  }
  if token.length() > 0 {
    self.token = token
  }
}

pub fn CloudSync::set_refresh_token(self : CloudSync, refresh_token : String) -> Unit {
  self.refresh_token = refresh_token
}

pub fn CloudSync::set_token_refreshed_hook(self : CloudSync, cb : (String, String) -> Unit) -> Unit {
  self.on_token_refreshed = Some(cb)
}

pub fn CloudSync::origin(self : CloudSync) -> String {
  self.origin
}

pub fn CloudSync::token(self : CloudSync) -> String {
  self.token
}

pub fn CloudSync::is_events_ws_running(self : CloudSync) -> Bool {
  self.ws_fiber.is_some()
}

pub fn CloudSync::set_authority_hooks(
  self : CloudSync,
  on_me : (CloudMe) -> Unit,
  on_workspace : (String, CloudWorkspace) -> Unit,
  on_revoked : (String, Int) -> Unit,
) -> Unit {
  self.on_me_fetched = Some(on_me)
  self.on_workspace_fetched = Some(on_workspace)
  self.on_workspace_revoked = Some(on_revoked)
}

pub fn CloudSync::clear_workspace_credentials(self : CloudSync, ws_id : String) -> Unit {
  if ws_id.length() == 0 {
    return
  }
  let prefix = ws_id + "/"
  let ks = self.cred_cache.keys()
  for i in 0..<ks.length() {
    if ks[i] == ws_id || ks[i].starts_with(prefix) {
      self.cred_cache.remove(ks[i])
    }
  }
}

/// Allocate the next globally monotonic Cloud request sequence number shared across
/// `/v1/me` and `/v1/workspaces/<ws>` before issuing any Cloud HTTP request.
pub fn CloudSync::alloc_req_seq(self : CloudSync) -> Int64 {
  let seq = self.next_global_req_seq
  self.next_global_req_seq += 1L
  seq
}

/// Allocate the next monotonic request sequence number for `ws_id` (backed by the unified
/// Cloud sequence counter so `/v1/me` and `/v1/workspaces/<ws>` are totally ordered).
pub fn CloudSync::next_req_seq(self : CloudSync, _ws_id : String) -> Int64 {
  self.alloc_req_seq()
}

/// Last applied monotonic sequence number for `ws_id` (`0` if none applied yet).
pub fn CloudSync::last_applied_seq(self : CloudSync, ws_id : String) -> Int64 {
  match self.ws_last_applied_seq.get(ws_id) {
    Some(n) => n
    None => 0L
  }
}

/// Attempt to apply a Cloud response carrying `req_seq` for `ws_id`.
/// Drops any stale response where `req_seq < last_applied_seq` (returns `false`).
fn CloudSync::try_apply_ws_seq(self : CloudSync, ws_id : String, req_seq : Int64) -> Bool {
  let last = self.last_applied_seq(ws_id)
  if req_seq < last {
    return false
  }
  self.ws_last_applied_seq.set(ws_id, req_seq)
  true
}

pub fn CloudSync::set_revoked_checker(self : CloudSync, cb : (String) -> Bool) -> Unit {
  self.is_workspace_revoked = Some(cb)
}

fn CloudSync::ws_epoch(self : CloudSync, ws_id : String) -> Int64 {
  match self.ws_membership_epoch.get(ws_id) {
    Some(e) => e
    None => 0L
  }
}

fn CloudSync::bump_ws_epoch(self : CloudSync, ws_id : String) -> Int64 {
  let next = self.ws_epoch(ws_id) + 1L
  self.ws_membership_epoch.set(ws_id, next)
  next
}

fn CloudSync::is_ws_revoked(self : CloudSync, ws_id : String) -> Bool {
  match self.is_workspace_revoked {
    Some(cb) => cb(ws_id)
    None => false
  }
}

fn CloudSync::notify_revoked(self : CloudSync, ws_id : String, status : Int) -> Unit {
  let _ = self.bump_ws_epoch(ws_id)
  self.clear_workspace_credentials(ws_id)
  self.known_workspaces.remove(ws_id)
  match self.on_workspace_revoked {
    Some(cb) => cb(ws_id, status)
    None => ()
  }
}

/// Attempt to renew the access token via `POST /v1/auth/refresh` (Bearer refresh_token) on 401.
fn CloudSync::refresh_access_token_k(self : CloudSync, k : (effect::Exit[Bool]) -> Unit) -> Unit {
  if self.refresh_token.length() == 0 {
    k(effect::Exit::Succeeded(false))
    return
  }
  let seq = self.refresh_seq
  self.refresh_seq += 1L
  let drawn = self.sh.random(10)
  let rand10 = if drawn.length() >= 10 {
    drawn
  } else {
    let b = Bytes::new(10)
    for i in 0..<10 {
      if i < drawn.length() {
        b[i] = drawn[i]
      } else {
        b[i] = (((seq >> ((i - drawn.length()) * 4)) ^ (i.to_int64() * 37L)) & 255L).to_int() as Byte
      }
    }
    b
  }
  let rid = generate_ulid(self.sh.rt.now(), rand10)
  let url = join_base_url(self.origin, "/v1/auth/refresh")
  let body = base_codec::json_stringify(base_codec::json_obj([("request_id", base_codec::json_str(rid))])).to_bytes()
  self.sh.fetch_k("POST", url, cloud_auth_headers(self.refresh_token, json_body=true), Some(body), fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(_) => k(effect::Exit::Succeeded(false))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Succeeded(false))
          return
        }
        match base_codec::json_parse(bytes_to_str(resp.body)) {
          base_codec::JsonParseResult::Ok(j) => {
            let new_access = j_str(j, "access_token")
            if new_access.length() == 0 {
              k(effect::Exit::Succeeded(false))
              return
            }
            self.token = new_access
            let new_refresh = j_str(j, "refresh_token")
            if new_refresh.length() > 0 {
              self.refresh_token = new_refresh
            }
            match self.on_token_refreshed {
              Some(cb) => cb(self.token, self.refresh_token)
              None => ()
            }
            k(effect::Exit::Succeeded(true))
          }
          base_codec::JsonParseResult::Err(_) => k(effect::Exit::Succeeded(false))
        }
      }
    }
  })
}

fn filter_me_json_workspaces(raw : base_codec::Json, excluded : Map[String, Bool]) -> base_codec::Json {
  if excluded.keys().length() == 0 {
    return raw
  }
  match base_codec::json_get(raw, "workspaces") {
    Some(base_codec::Json::Arr(xs)) => {
      let kept : Array[base_codec::Json] = []
      for i in 0..<xs.length() {
        let wid = j_str(xs[i], "id")
        if wid.length() == 0 || excluded.get(wid).is_none() {
          kept.push(xs[i])
        }
      }
      j_set_field(raw, "workspaces", base_codec::json_arr(kept))
    }
    _ => raw
  }
}

pub fn CloudSync::fetch_me_k(
  self : CloudSync,
  k : (effect::Exit[CloudMe]) -> Unit,
  allow_refresh : Bool = true,
) -> Unit {
  let req_seq = self.alloc_req_seq()
  let url = join_base_url(self.origin, "/v1/me")
  self.sh.fetch_k("GET", url, cloud_auth_headers(self.token), None, fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status == 401 && allow_refresh && self.refresh_token.length() > 0 {
          self.refresh_access_token_k(fn(rex : effect::Exit[Bool]) -> Unit {
            match rex {
              effect::Exit::Succeeded(true) => self.fetch_me_k(k, allow_refresh=false)
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              _ => k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
            }
          })
          return
        }
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        if req_seq < self.me_last_applied_seq {
          k(effect::Exit::Failed(effect::EffectError::Custom("stale_cloud_response")))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed /v1/me json: " + e)))
            return
          }
        }
        let parsed_me = parse_cloud_me(j)
        // Collect all existing workspaces from BOTH in-memory `known_workspaces` and SQLite `workspace`
        // (1:1 TS `Data.retain(me_ws_ids)` so offline-revoked workspaces are purged on first `/v1/me`).
        let existing_set : Map[String, Bool] = Map::new()
        let prev_known = self.known_workspaces.keys()
        for i in 0..<prev_known.length() {
          existing_set.set(prev_known[i], true)
        }
        match store::list_workspaces(self.db) {
          sql::SqlResult::Ok(rows) => {
            for i in 0..<rows.length() {
              if rows[i].id.length() > 0 {
                existing_set.set(rows[i].id, true)
              }
            }
          }
          sql::SqlResult::Err(_) => ()
        }
        // Separate `raw_workspace_ids` (all workspaces returned by `/v1/me`) from `accepted_workspaces`
        // (subset not superseded by a newer `/v1/workspaces/<ws>` response). Do NOT advance watermarks
        // or `known_workspaces` until SQLite `Burst::in_tx` succeeds!
        let raw_workspace_ids : Array[String] = []
        let accepted_workspaces : Array[CloudWorkspaceRef] = []
        let present_in_me : Map[String, Bool] = Map::new()
        let scrub_from_me_doc : Map[String, Bool] = Map::new()
        for i in 0..<parsed_me.workspaces.length() {
          let wref = parsed_me.workspaces[i]
          raw_workspace_ids.push(wref.id)
          present_in_me.set(wref.id, true)
          if req_seq >= self.last_applied_seq(wref.id) {
            accepted_workspaces.push(wref)
          } else {
            // Superseded by a newer `/v1/workspaces/<ws>` response.
            // Only scrub from `account_doc("me")` if the newer response actually revoked `wref.id`
            // (absent from `known_workspaces` or currently revoked); NEVER scrub a workspace the
            // user still belongs to with a newer 200!
            if self.known_workspaces.get(wref.id).is_none() || self.is_ws_revoked(wref.id) {
              scrub_from_me_doc.set(wref.id, true)
            }
          }
        }
        let clean_j = filter_me_json_workspaces(j, scrub_from_me_doc)
        let raw_json = base_codec::json_stringify(clean_j)
        let now_ms = self.sh.rt.now()
        let burst = sql::Burst::new(self.db)
        match burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
          match b.run(sql_account_doc_put(), params=[
            base_codec::json_str("me"),
            base_codec::json_str(raw_json),
            base_codec::json_int64(now_ms),
          ]) {
            sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
          }
        }) {
          sql::SqlResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom(e.to_string())))
            return
          }
          sql::SqlResult::Ok(_) => ()
        }
        // Commit watermarks ONLY AFTER SQLite transaction succeeded.
        self.me_last_applied_seq = req_seq
        for i in 0..<accepted_workspaces.length() {
          let wref = accepted_workspaces[i]
          self.ws_last_applied_seq.set(wref.id, req_seq)
          self.known_workspaces.set(wref.id, true)
        }
        // Any existing/DB workspace absent from `raw_workspace_ids` (`present_in_me`) is revoked
        // ONLY if `try_apply_ws_seq(wid, req_seq)` succeeds (a newer `/v1/workspaces/<ws>` 200 wins).
        let existing_keys = existing_set.keys()
        for i in 0..<existing_keys.length() {
          let wid = existing_keys[i]
          if present_in_me.get(wid).is_none() {
            if self.try_apply_ws_seq(wid, req_seq) {
              self.notify_revoked(wid, 403)
            }
          }
        }
        let effective_me = CloudMe::{
          sub: parsed_me.sub,
          email: parsed_me.email,
          name: parsed_me.name,
          workspaces: accepted_workspaces,
          raw_workspace_ids: raw_workspace_ids,
          retain_handled: true,
          relays: parsed_me.relays,
          raw: clean_j,
        }
        match self.on_me_fetched {
          Some(cb) => cb(effective_me)
          None => ()
        }
        k(effect::Exit::Succeeded(effective_me))
      }
    }
  })
}

pub fn CloudSync::fetch_workspace_k(
  self : CloudSync,
  ws_id : String,
  k : (effect::Exit[CloudWorkspace]) -> Unit,
  allow_refresh : Bool = true,
) -> Unit {
  let req_seq = self.alloc_req_seq()
  let url = join_base_url(self.origin, "/v1/workspaces/" + ws_id)
  self.sh.fetch_k("GET", url, cloud_auth_headers(self.token), None, fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status == 401 && allow_refresh && self.refresh_token.length() > 0 {
          self.refresh_access_token_k(fn(rex : effect::Exit[Bool]) -> Unit {
            match rex {
              effect::Exit::Succeeded(true) => self.fetch_workspace_k(ws_id, k, allow_refresh=false)
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              _ => k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
            }
          })
          return
        }
        if resp.status == 403 || resp.status == 404 {
          if self.try_apply_ws_seq(ws_id, req_seq) {
            self.notify_revoked(ws_id, resp.status)
            k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          } else {
            k(effect::Exit::Failed(effect::EffectError::Custom("stale_cloud_response")))
          }
          return
        }
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        if req_seq < self.last_applied_seq(ws_id) {
          k(effect::Exit::Failed(effect::EffectError::Custom("stale_cloud_response")))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed workspace json: " + e)))
            return
          }
        }
        let ws = parse_cloud_workspace(ws_id, j)
        let raw_json = base_codec::json_stringify(j)
        let now_ms = self.sh.rt.now()
        let burst = sql::Burst::new(self.db)
        match burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
          match b.run(sql_workspace_put(), params=[
            base_codec::json_str(ws.id),
            base_codec::json_str(raw_json),
            base_codec::json_int64(now_ms),
          ]) {
            sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
          }
        }) {
          sql::SqlResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom(e.to_string())))
            return
          }
          sql::SqlResult::Ok(_) => ()
        }
        // Advance watermark ONLY AFTER JSON parse and SQLite commit succeed.
        self.ws_last_applied_seq.set(ws_id, req_seq)
        self.known_workspaces.set(ws.id, true)
        match self.on_workspace_fetched {
          Some(cb) => cb(ws.id, ws)
          None => ()
        }
        k(effect::Exit::Succeeded(ws))
      }
    }
  })
}

/// Get a cached member credential or fetch & cache a fresh one when missing/expired (`expires_at <= now_sec + 60`).
/// Aligned 1:1 with `client/core-ts/src/sync/cloud.ts:1466`: credential 403/404 NEVER revokes directly
/// and credential 200 NEVER advances workspace membership watermarks; on 403/404 it clears cached creds
/// and triggers an authoritative `fetch_workspace_k(ws_id)` check.
/// Guards `cred_cache.set` with `!is_ws_revoked(ws_id)` and `ws_membership_epoch[ws_id] == captured_epoch`
/// so an in-flight credential fetch never repopulates credentials after concurrent revocation.
pub fn CloudSync::fetch_member_credential_k(
  self : CloudSync,
  ws_id : String,
  device : String,
  now_sec : Int64,
  k : (effect::Exit[MemberCredential]) -> Unit,
  fresh : Bool = false,
) -> Unit {
  if self.is_ws_revoked(ws_id) {
    k(effect::Exit::Failed(effect::EffectError::Custom("workspace_revoked")))
    return
  }
  let cache_key = ws_id + "/" + device
  if !fresh {
    match self.cred_cache.get(cache_key) {
      Some(c) => {
        if c.expires_at > now_sec + 60.to_int64() {
          k(effect::Exit::Succeeded(c))
          return
        }
      }
      None => ()
    }
  }
  let captured_epoch = self.ws_epoch(ws_id)
  let url = join_base_url(self.origin, "/v1/workspaces/" + ws_id + "/credential")
  let body = base_codec::json_stringify(base_codec::json_obj([("device", base_codec::json_str(device))])).to_bytes()
  self.sh.fetch_k("POST", url, cloud_auth_headers(self.token, json_body=true), Some(body), fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status == 403 || resp.status == 404 {
          self.clear_workspace_credentials(ws_id)
          let _ = self.sh.rt.fork_quiet_named("cloud-verify-ws:" + ws_id, fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
            self.fetch_workspace_k(ws_id, fn(_ : effect::Exit[CloudWorkspace]) -> Unit { fk(effect::Exit::Succeeded(())) })
          })
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        if self.is_ws_revoked(ws_id) || self.ws_epoch(ws_id) != captured_epoch {
          k(effect::Exit::Failed(effect::EffectError::Custom("workspace_revoked")))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed credential json: " + e)))
            return
          }
        }
        match parse_member_credential(j) {
          Ok(c) => {
            if self.is_ws_revoked(ws_id) || self.ws_epoch(ws_id) != captured_epoch {
              k(effect::Exit::Failed(effect::EffectError::Custom("workspace_revoked")))
              return
            }
            self.cred_cache.set(cache_key, c)
            k(effect::Exit::Succeeded(c))
          }
          Err(e) => k(effect::Exit::Failed(effect::EffectError::Custom(e)))
        }
      }
    }
  })
}

/// Start `/v1/events` WebSocket strictly aligned with `cloud/src/types.ts:49-63` `AccountEvent`
/// (`workspaces`, `workspace`, `release`, `relays`, `admin`, `feedback`):
/// - Reads `self.token` dynamically on every connect/reconnect and refreshes via `refresh_token` on auth reject;
/// - Reconciles `/v1/me` automatically on every WebSocket open/reconnect (`retain`);
/// - Refreshes `/v1/me` on `workspaces` and `/v1/workspaces/<ws>` on `workspace` (single owner).
pub fn CloudSync::start_events_ws(self : CloudSync, on_event : (CloudEvent) -> Unit) -> Unit {
  match self.ws_fiber {
    Some(_) => return
    None => ()
  }
  let fiber = self.sh.rt.fork_quiet_named("cloud-events-ws", fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    events_ws_loop_k(
      self.sh,
      self.origin,
      fn() -> String { self.token },
      fn() -> Bool { self.refresh_token.length() > 0 },
      fn(rk : (effect::Exit[Bool]) -> Unit) -> Unit { self.refresh_access_token_k(rk) },
      fn() -> Unit {
        let _ = self.sh.rt.fork_quiet_named("cloud-ws-open-me", fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
          self.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { fk(effect::Exit::Succeeded(())) })
        })
      },
      fn(ev : CloudEvent) -> Unit {
        match ev {
          CloudEvent::WorkspacesChanged(_) => {
            let _ = self.sh.rt.fork_quiet_named("cloud-refresh-me", fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
              self.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { fk(effect::Exit::Succeeded(())) })
            })
          }
          CloudEvent::WorkspaceChanged(wid, _) => {
            let _ = self.sh.rt.fork_quiet_named("cloud-refresh-ws:" + wid, fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
              self.fetch_workspace_k(wid, fn(_ : effect::Exit[CloudWorkspace]) -> Unit { fk(effect::Exit::Succeeded(())) })
            })
          }
          _ => ()
        }
        on_event(ev)
      },
      0,
      k,
    )
  })
  self.ws_fiber = Some(fiber)
}

pub fn CloudSync::stop(self : CloudSync) -> Unit {
  match self.ws_fiber {
    Some(f) => {
      self.ws_fiber = None
      f.interrupt()
    }
    None => ()
  }
}
