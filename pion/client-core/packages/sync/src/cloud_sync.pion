// Real Cloud Sync engine mirroring `client/core-ts/src/sync/cloud.ts` & `src/cloud.ts`.
// Fetches `/v1/me`, `/v1/workspaces/<ws>`, `/v1/workspaces/<ws>/credential` over `shell::Shell`,
// persists into local SQLite (`account_doc`, `workspace`) in `sql::Burst` transactions,
// and consumes `/v1/events` WebSocket with exponential backoff (1000ms..60000ms, zero polling).

import "base_codec"
import "effect"
import "shell"
import "sql"
import "store"

pub fn sql_account_doc_put() -> String {
  "INSERT OR REPLACE INTO account_doc (name, json, confirmed) VALUES (?, ?, ?)"
}

pub fn sql_workspace_put() -> String {
  "INSERT OR REPLACE INTO workspace (id, json, confirmed) VALUES (?, ?, ?)"
}

/// Exponential reconnect backoff for cloud `/v1/events` WebSocket (1000ms..60000ms).
pub fn cloud_ws_backoff_ms(attempt : Int) -> Int {
  let clamped = if attempt < 0 { 0 } else if attempt > 6 { 6 } else { attempt }
  let ms = 1000 << clamped
  if ms > 60000 { 60000 } else { ms }
}

pub fn cloud_events_ws_url(origin : String) -> String {
  let clean = strip_trailing_slash(origin)
  if clean.starts_with("https://") {
    "wss://" + clean.slice(8, clean.length()) + "/v1/events"
  } else if clean.starts_with("http://") {
    "ws://" + clean.slice(7, clean.length()) + "/v1/events"
  } else if clean.starts_with("wss://") || clean.starts_with("ws://") {
    clean + "/v1/events"
  } else {
    "ws://" + clean + "/v1/events"
  }
}

pub struct CloudWorkspaceRef {
  pub id : String
  pub name : String
  pub role : String
}

pub struct CloudMe {
  pub sub : String
  pub email : String
  pub name : String
  pub workspaces : Array[CloudWorkspaceRef]
  pub relays : Array[String]
  pub raw : base_codec::Json
}

pub struct CloudMember {
  pub sub : String
  pub email : String
  pub role : String
}

pub struct CloudStation {
  pub id : String
  pub name : String
  pub online : Bool
  pub url : Option[String]
  pub endpoint_id : Option[String]
  pub relay : Option[String]
  pub ips : Array[String]
  pub mode : Option[String]
  pub emoji : Option[String]
  pub icon : Option[String]
  pub version : Option[String]
  pub joined : Bool
}

pub struct CloudWorkspace {
  pub id : String
  pub name : String
  pub rev : Int
  pub members : Array[CloudMember]
  pub stations : Array[CloudStation]
  pub raw : base_codec::Json
}

pub struct MemberCredential {
  pub credential : String
  pub issued_at : Int64
  pub expires_at : Int64
  pub relay_url : String
}

pub struct RefreshedTokens {
  pub access : String
  pub refresh : String
  pub access_expires : Int64
  pub name : Option[String]
}

/// Parsed response of `POST /v1/auth/token` matching `client/core-ts/src/accounts.ts:71-79`.
pub struct AuthTokenExchange {
  pub access_token : String
  pub refresh_token : String
  pub subject : String
  pub email : String
  pub name : String
  pub picture : String
  pub expires_at : Int64
}

pub enum RefreshTokenError {
  InvalidSession(Int, String)
  Transient(String)
}

/// Structured HTTP error carrying exact status code (no fragile substring parsing).
pub struct CloudHttpError {
  pub status : Int
  pub code : String
  pub message : String
}

/// Real `AccountEvent` variants strictly matching `cloud/src/types.ts:49-63`
/// (`workspaces`, `workspace`, `release`, `relays`, `admin`, `feedback`),
/// plus `Other` for unknown future types. NEVER fabricates nonexistent event names.
pub enum CloudEvent {
  WorkspacesChanged(base_codec::Json)
  WorkspaceChanged(String, base_codec::Json)
  Release
  Relays
  Admin(base_codec::Json)
  Feedback(base_codec::Json)
  Other(String, base_codec::Json)
}

fn cloud_auth_headers(token : String, json_body : Bool = false) -> Array[(String, String)] {
  let headers : Array[(String, String)] = []
  if token.length() > 0 {
    headers.push(("authorization", "Bearer " + token))
  }
  if json_body {
    headers.push(("content-type", "application/json"))
  }
  headers
}

fn parse_cloud_http_error(status : Int, body : Bytes) -> CloudHttpError {
  let text = bytes_to_str(body)
  let code = match base_codec::json_parse(text) {
    base_codec::JsonParseResult::Ok(j) =>
    match j_opt_str(j, "error") {
      Some(c) => c
      None => "http_" + status.to_string()
    }
    base_codec::JsonParseResult::Err(_) => "http_" + status.to_string()
  }
  let message = code + " (" + status.to_string() + ")"
  CloudHttpError::{ status: status, code: code, message: message }
}

fn parse_cloud_error(status : Int, body : Bytes) -> String {
  parse_cloud_http_error(status, body).message
}

fn is_non_neg_json_int(n : Double, repr : String) -> Bool {
  if n < 0.0 {
    return false
  }
  if repr.contains(".") || repr.contains("e") || repr.contains("E") {
    return false
  }
  n.to_int64().to_double() == n
}

fn check_opt_str_field(obj : base_codec::Json, key : String, idx : Int) -> Result[Unit, String] {
  match base_codec::json_get(obj, key) {
    None | Some(base_codec::Json::Null) | Some(base_codec::Json::Str(_)) => Ok(())
    _ => Err("malformed /v1/me: workspaces[" + idx.to_string() + "]." + key + " must be string or null")
  }
}

fn check_opt_str_array_field(obj : base_codec::Json, key : String, idx : Int) -> Result[Unit, String] {
  match base_codec::json_get(obj, key) {
    None | Some(base_codec::Json::Null) => Ok(())
    Some(base_codec::Json::Arr(xs)) => {
      for j in 0..<xs.length() {
        match xs[j] {
          base_codec::Json::Str(_) => ()
          _ => return Err("malformed /v1/me: workspaces[" + idx.to_string() + "]." + key + "[" + j.to_string() + "] must be string")
        }
      }
      Ok(())
    }
    _ => Err("malformed /v1/me: workspaces[" + idx.to_string() + "]." + key + " must be string array")
  }
}

/// Strictly validate `/v1/me` payload before any membership diff or persistence:
/// - Root MUST be a JSON object.
/// - `sub` MUST be a non-empty string (on `user.sub` or root `sub`).
/// - `workspaces` MUST be a JSON array with NO duplicate workspace `id`s.
/// - EVERY element of `workspaces` MUST be a JSON object with a non-empty string `id`,
///   valid string `name`, AND a valid `role` strictly in `{"owner", "admin", "member"}`.
/// Returns `Err` on ANY malformed element — NEVER silently skips malformed elements or roles!
pub fn parse_cloud_me_strict(j : base_codec::Json) -> Result[CloudMe, String] {
  match j {
    base_codec::Json::Obj(_) => ()
    _ => return Err("malformed /v1/me: root must be object")
  }
  let user = match base_codec::json_get(j, "user") {
    Some(base_codec::Json::Obj(fs)) => base_codec::json_obj(fs)
    Some(base_codec::Json::Null) | None => j
    Some(_) => return Err("malformed /v1/me: user must be object")
  }
  let sub = match base_codec::json_get(user, "sub") {
    Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else {
      return Err("malformed /v1/me: sub is empty")
    }
    _ => return Err("malformed /v1/me: missing non-empty string sub")
  }
  let email = match base_codec::json_get(user, "email") {
    None | Some(base_codec::Json::Null) => ""
    Some(base_codec::Json::Str(s)) => s
    _ => return Err("malformed /v1/me: email must be string")
  }
  let name = match base_codec::json_get(user, "name") {
    None | Some(base_codec::Json::Null) => ""
    Some(base_codec::Json::Str(s)) => s
    _ => return Err("malformed /v1/me: name must be string")
  }
  let ws_arr = match base_codec::json_get(j, "workspaces") {
    Some(base_codec::Json::Arr(xs)) => xs
    _ => return Err("malformed /v1/me: workspaces must be array")
  }
  let seen_ws : Map[String, Bool] = Map::new()
  let workspaces : Array[CloudWorkspaceRef] = []
  for i in 0..<ws_arr.length() {
    let w = ws_arr[i]
    match w {
      base_codec::Json::Obj(_) => ()
      _ => return Err("malformed /v1/me: workspaces[" + i.to_string() + "] must be object")
    }
    let wid = match base_codec::json_get(w, "id") {
      Some(base_codec::Json::Str(s)) => if is_valid_cloud_workspace_id(s) { s } else {
        return Err("malformed /v1/me: workspaces[" + i.to_string() + "].id must be a 26-char Crockford Base32 ULID")
      }
      _ => return Err("malformed /v1/me: workspaces[" + i.to_string() + "].id must be a 26-char Crockford Base32 ULID")
    }
    if seen_ws.get(wid).is_some() {
      return Err("malformed /v1/me: duplicate workspace id " + wid)
    }
    seen_ws.set(wid, true)
    let wname = match base_codec::json_get(w, "name") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else {
        return Err("malformed /v1/me: workspaces[" + i.to_string() + "].name is empty")
      }
      _ => return Err("malformed /v1/me: workspaces[" + i.to_string() + "].name must be non-empty string")
    }
    let wrole = match base_codec::json_get(w, "role") {
      Some(base_codec::Json::Str(s)) => if is_valid_workspace_role(s) { s } else {
        return Err("malformed /v1/me: workspaces[" + i.to_string() + "].role must be owner|admin|member")
      }
      _ => return Err("malformed /v1/me: workspaces[" + i.to_string() + "].role must be owner|admin|member")
    }
    match base_codec::json_get(w, "created_at") {
      Some(base_codec::Json::Num(_, _)) => ()
      _ => return Err("malformed /v1/me: workspaces[" + i.to_string() + "].created_at must be number")
    }
    match base_codec::json_get(w, "stations") {
      Some(base_codec::Json::Num(n, repr)) => if !is_non_neg_json_int(n, repr) {
        return Err("malformed /v1/me: workspaces[" + i.to_string() + "].stations must be non-negative integer")
      }
      _ => return Err("malformed /v1/me: workspaces[" + i.to_string() + "].stations must be non-negative integer")
    }
    match base_codec::json_get(w, "members") {
      Some(base_codec::Json::Num(n, repr)) => if !is_non_neg_json_int(n, repr) {
        return Err("malformed /v1/me: workspaces[" + i.to_string() + "].members must be non-negative integer")
      }
      _ => return Err("malformed /v1/me: workspaces[" + i.to_string() + "].members must be non-negative integer")
    }
    match check_opt_str_field(w, "emoji", i) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match check_opt_str_field(w, "icon", i) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match check_opt_str_array_field(w, "relays", i) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match check_opt_str_array_field(w, "ways_off", i) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    workspaces.push(CloudWorkspaceRef::{
      id: wid,
      name: wname,
      role: wrole,
    })
  }
  let relays : Array[String] = []
  match base_codec::json_get(j, "relay_urls") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match xs[i] {
          base_codec::Json::Str(u) => if u.length() > 0 { relays.push(u) }
          _ => ()
        }
      }
    }
    _ => ()
  }
  if relays.length() == 0 {
    match base_codec::json_get(j, "relays") {
      Some(base_codec::Json::Arr(xs)) => {
        for i in 0..<xs.length() {
          match xs[i] {
            base_codec::Json::Str(u) => if u.length() > 0 { relays.push(u) }
            _ => ()
          }
        }
      }
      _ => ()
    }
  }
  if relays.length() == 0 {
    match j_opt_str(j, "relay_url") {
      Some(u) => if u.length() > 0 { relays.push(u) }
      None => ()
    }
  }
  Ok(CloudMe::{
    sub: sub,
    email: email,
    name: name,
    workspaces: workspaces,
    relays: relays,
    raw: j,
  })
}

/// Strictly validate `/v1/workspaces/<requested_ws>` payload:
/// - Root MUST be a JSON object.
/// - `id` MUST be a non-empty string AND MUST equal `requested_ws` when `requested_ws` is non-empty
///   (preventing cross-workspace spoofing / mixup).
/// - `stations` and `members`, if present and non-null, MUST be arrays of objects (every station having non-empty string `id`).
pub fn parse_cloud_workspace_strict(
  j : base_codec::Json,
  requested_ws : String,
) -> Result[CloudWorkspace, String] {
  match j {
    base_codec::Json::Obj(_) => ()
    _ => return Err("malformed workspace: root must be object")
  }
  let parsed_id = match base_codec::json_get(j, "id") {
    Some(base_codec::Json::Str(s)) => if is_valid_cloud_workspace_id(s) { s } else {
      return Err("malformed workspace: id must be a 26-char Crockford Base32 ULID")
    }
    _ => return Err("malformed workspace: missing string id")
  }
  if requested_ws.length() > 0 && parsed_id != requested_ws {
    return Err("workspace id mismatch: expected " + requested_ws + ", got " + parsed_id)
  }
  let name = match base_codec::json_get(j, "name") {
    None | Some(base_codec::Json::Null) => ""
    Some(base_codec::Json::Str(s)) => s
    _ => return Err("malformed workspace: name must be string")
  }
  let rev = j_int(j, "rev")
  let members : Array[CloudMember] = []
  match base_codec::json_get(j, "members") {
    None | Some(base_codec::Json::Null) => ()
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        let m = xs[i]
        match m {
          base_codec::Json::Obj(_) => ()
          _ => return Err("malformed workspace: members[" + i.to_string() + "] must be object")
        }
        members.push(CloudMember::{
          sub: j_str(m, "sub"),
          email: j_str(m, "email"),
          role: j_str(m, "role"),
        })
      }
    }
    _ => return Err("malformed workspace: members must be array")
  }
  let stations : Array[CloudStation] = []
  match base_codec::json_get(j, "stations") {
    None | Some(base_codec::Json::Null) => ()
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        let s = xs[i]
        match s {
          base_codec::Json::Obj(_) => ()
          _ => return Err("malformed workspace: stations[" + i.to_string() + "] must be object")
        }
        let sid = match base_codec::json_get(s, "id") {
          Some(base_codec::Json::Str(v)) => if v.length() > 0 { v } else {
            return Err("malformed workspace: stations[" + i.to_string() + "].id is empty")
          }
          _ => return Err("malformed workspace: stations[" + i.to_string() + "].id must be non-empty string")
        }
        match resolve_station_for_workspace(parsed_id, sid) {
          Err(msg) => return Err("malformed workspace: " + msg)
          Ok(_) => ()
        }
        let endpoint_id = match j_opt_str(s, "endpoint_id") {
          Some(v) => Some(v)
          None => j_opt_str(s, "endpointId")
        }
        let relay = match j_opt_str(s, "relay") {
          Some(v) => Some(v)
          None =>
          match j_opt_str(s, "relay_url") {
            Some(v) => Some(v)
            None => j_opt_str(s, "relayUrl")
          }
        }
        let ips : Array[String] = []
        match base_codec::json_get(s, "ips") {
          Some(base_codec::Json::Arr(ip_xs)) => {
            for k in 0..<ip_xs.length() {
              match ip_xs[k] {
                base_codec::Json::Str(ip) => if ip.length() > 0 { ips.push(ip) }
                _ => ()
              }
            }
          }
          _ => ()
        }
        stations.push(CloudStation::{
          id: sid,
          name: j_str(s, "name"),
          online: j_bool(s, "online"),
          url: j_opt_str(s, "url"),
          endpoint_id: endpoint_id,
          relay: relay,
          ips: ips,
          mode: j_opt_str(s, "mode"),
          emoji: j_opt_str(s, "emoji"),
          icon: j_opt_str(s, "icon"),
          version: j_opt_str(s, "version"),
          joined: j_bool(s, "joined"),
        })
      }
    }
    _ => return Err("malformed workspace: stations must be array")
  }
  Ok(CloudWorkspace::{
    id: parsed_id,
    name: name,
    rev: rev,
    members: members,
    stations: stations,
    raw: j,
  })
}

fn parse_cloud_workspace(ws_id : String, j : base_codec::Json) -> CloudWorkspace {
  match parse_cloud_workspace_strict(j, ws_id) {
    Ok(ws) => ws
    Err(_) => {
      let id = {
        let parsed_id = j_str(j, "id")
        if parsed_id.length() > 0 { parsed_id } else { ws_id }
      }
      let stations : Array[CloudStation] = []
      match base_codec::json_get(j, "stations") {
        Some(base_codec::Json::Arr(xs)) => {
          for i in 0..<xs.length() {
            let s = xs[i]
            let sid = j_str(s, "id")
            if sid.length() > 0 {
              stations.push(CloudStation::{
                id: sid,
                name: j_str(s, "name"),
                online: j_bool(s, "online"),
                url: j_opt_str(s, "url"),
                endpoint_id: match j_opt_str(s, "endpoint_id") { Some(v) => Some(v); None => j_opt_str(s, "endpointId") },
                relay: match j_opt_str(s, "relay") { Some(v) => Some(v); None => match j_opt_str(s, "relay_url") { Some(v) => Some(v); None => j_opt_str(s, "relayUrl") } },
                ips: [],
                mode: j_opt_str(s, "mode"),
                emoji: j_opt_str(s, "emoji"),
                icon: j_opt_str(s, "icon"),
                version: j_opt_str(s, "version"),
                joined: j_bool(s, "joined"),
              })
            }
          }
        }
        _ => ()
      }
      CloudWorkspace::{
        id: id,
        name: j_str(j, "name"),
        rev: j_int(j, "rev"),
        members: [],
        stations: stations,
        raw: j,
      }
    }
  }
}

/// Read the persisted Cloud workspace JSON from SQLite `workspace` table and return its stations.
pub fn list_workspace_stations(db : sql::Sql, ws_id : String) -> Array[CloudStation] {
  if ws_id.length() == 0 {
    return []
  }
  match store::get_workspace(db, ws_id) {
    sql::SqlResult::Ok(Some(row)) =>
    match base_codec::json_parse(row.json) {
      base_codec::JsonParseResult::Ok(j) => parse_cloud_workspace(ws_id, j).stations
      base_codec::JsonParseResult::Err(_) => []
    }
    _ => []
  }
}

fn parse_member_credential(j : base_codec::Json) -> Result[MemberCredential, String] {
  let cred = match j_opt_str(j, "credential") {
    Some(s) => s
    None => return Err("missing field credential")
  }
  let issued_at = match j_opt_int64(j, "issued_at") {
    Some(v) => v
    None => return Err("missing field issued_at")
  }
  let expires_at = match j_opt_int64(j, "expires_at") {
    Some(v) => v
    None => return Err("missing field expires_at")
  }
  let relay_url = match j_opt_str(j, "relay_url") {
    Some(s) => s
    None => ""
  }
  Ok(MemberCredential::{
    credential: cred,
    issued_at: issued_at,
    expires_at: expires_at,
    relay_url: relay_url,
  })
}

pub fn parse_cloud_event(text : String) -> Option[CloudEvent] {
  if text == "pong" || text.length() == 0 {
    return None
  }
  let j = match base_codec::json_parse(text) {
    base_codec::JsonParseResult::Ok(v) => v
    base_codec::JsonParseResult::Err(_) => return None
  }
  let ev_type = j_str(j, "type")
  if ev_type == "workspaces" {
    Some(CloudEvent::WorkspacesChanged(j))
  } else if ev_type == "workspace" {
    let wid = j_str(j, "id")
    if wid.length() > 0 {
      Some(CloudEvent::WorkspaceChanged(wid, j))
    } else {
      None
    }
  } else if ev_type == "release" {
    Some(CloudEvent::Release)
  } else if ev_type == "relays" {
    Some(CloudEvent::Relays)
  } else if ev_type == "admin" {
    Some(CloudEvent::Admin(j))
  } else if ev_type == "feedback" {
    Some(CloudEvent::Feedback(j))
  } else if ev_type.length() > 0 {
    Some(CloudEvent::Other(ev_type, j))
  } else {
    None
  }
}

/// Fetch `GET <origin>/v1/me`, strictly validate with `parse_cloud_me_strict`, and optionally persist
/// (`persist=false` lets `ClientCore::commit_cloud_me` execute the atomic 5-step commit order).
pub fn fetch_me_k(
  sh : shell::Shell,
  origin : String,
  token : String,
  db : sql::Sql,
  k : (effect::Exit[CloudMe]) -> Unit,
  persist : Bool = true,
) -> Unit {
  let url = join_base_url(origin, "/v1/me")
  sh.fetch_k("GET", url, cloud_auth_headers(token), None, fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed /v1/me json: " + e)))
            return
          }
        }
        let me = match parse_cloud_me_strict(j) {
          Ok(m) => m
          Err(msg) => {
            k(effect::Exit::Failed(effect::EffectError::Custom(msg)))
            return
          }
        }
        if !persist {
          k(effect::Exit::Succeeded(me))
          return
        }
        let raw_json = base_codec::json_stringify(j)
        let now_ms = sh.rt.now()
        let burst = sql::Burst::new(db)
        match burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
          match b.run(sql_account_doc_put(), params=[
            base_codec::json_str("me"),
            base_codec::json_str(raw_json),
            base_codec::json_int64(now_ms),
          ]) {
            sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
          }
        }) {
          sql::SqlResult::Err(e) => k(effect::Exit::Failed(effect::EffectError::Custom(e.to_string())))
          sql::SqlResult::Ok(_) => k(effect::Exit::Succeeded(me))
        }
      }
    }
  })
}

/// Fetch `GET <origin>/v1/workspaces/<ws_id>`, strictly validate `id == ws_id`, and optionally persist.
pub fn fetch_workspace_k(
  sh : shell::Shell,
  origin : String,
  token : String,
  ws_id : String,
  db : sql::Sql,
  k : (effect::Exit[CloudWorkspace]) -> Unit,
  persist : Bool = true,
) -> Unit {
  let url = join_base_url(origin, "/v1/workspaces/" + ws_id)
  sh.fetch_k("GET", url, cloud_auth_headers(token), None, fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed workspace json: " + e)))
            return
          }
        }
        let ws = match parse_cloud_workspace_strict(j, ws_id) {
          Ok(w) => w
          Err(msg) => {
            k(effect::Exit::Failed(effect::EffectError::Custom(msg)))
            return
          }
        }
        if !persist {
          k(effect::Exit::Succeeded(ws))
          return
        }
        let raw_json = base_codec::json_stringify(j)
        let now_ms = sh.rt.now()
        let burst = sql::Burst::new(db)
        match burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
          // Cloud MUST NEVER overwrite station-owned `station(address, "overview")` rows;
          // full Cloud workspace metadata (including station roster) lives strictly in `workspace.json`.
          match b.run(sql_workspace_put(), params=[
            base_codec::json_str(ws.id),
            base_codec::json_str(raw_json),
            base_codec::json_int64(now_ms),
          ]) {
            sql::SqlResult::Err(e) => sql::SqlResult::Err(e)
            sql::SqlResult::Ok(_) => sql::SqlResult::Ok(())
          }
        }) {
          sql::SqlResult::Err(e) => k(effect::Exit::Failed(effect::EffectError::Custom(e.to_string())))
          sql::SqlResult::Ok(_) => k(effect::Exit::Succeeded(ws))
        }
      }
    }
  })
}

/// Rotate OAuth tokens via `POST <origin>/v1/auth/refresh` carrying a valid 26-char Crockford Base32
/// ULID `request_id` (`client/core-ts/src/accounts.ts:711-723`), strictly distinguishing permanent
/// `401` / `invalid_grant` session invalidation from transient network/5xx errors.
pub fn refresh_token_k(
  sh : shell::Shell,
  origin : String,
  refresh_token : String,
  now_ms : Int64,
  k : (effect::Exit[Result[RefreshedTokens, RefreshTokenError]]) -> Unit,
) -> Unit {
  let url = join_base_url(origin, "/v1/auth/refresh")
  let req_id = generate_ulid(now_ms, sh.random(16))
  let body = base_codec::json_stringify(base_codec::json_obj([
    ("request_id", base_codec::json_str(req_id)),
    ("refresh_token", base_codec::json_str(refresh_token)),
  ])).to_bytes()
  sh.fetch_k("POST", url, cloud_auth_headers(refresh_token, json_body=true), Some(body), fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        let err_text = bytes_to_str(resp.body)
        if resp.status < 200 || resp.status >= 300 {
          let err_code = match base_codec::json_parse(err_text) {
            base_codec::JsonParseResult::Ok(ej) => match j_opt_str(ej, "error") {
              Some(c) => c
              None => ""
            }
            base_codec::JsonParseResult::Err(_) => ""
          }
          let is_invalid = resp.status == 401 ||
          err_code == "invalid_grant" ||
          err_code == "invalid_token" ||
          err_code == "session_expired" ||
          err_code == "unauthorized"
          let msg = parse_cloud_error(resp.status, resp.body)
          if is_invalid {
            k(effect::Exit::Succeeded(Err(RefreshTokenError::InvalidSession(resp.status, msg))))
          } else {
            k(effect::Exit::Succeeded(Err(RefreshTokenError::Transient(msg))))
          }
          return
        }
        let j = match base_codec::json_parse(err_text) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Succeeded(Err(RefreshTokenError::Transient("malformed refresh json: " + e))))
            return
          }
        }
        let access = match j_opt_str(j, "access") {
          Some(s) => s
          None => match j_opt_str(j, "access_token") {
            Some(s) => s
            None => ""
          }
        }
        if access.length() == 0 {
          k(effect::Exit::Succeeded(Err(RefreshTokenError::Transient("refresh response missing access token"))))
          return
        }
        let next_refresh = match j_opt_str(j, "refresh") {
          Some(s) => if s.length() > 0 { s } else { refresh_token }
          None => match j_opt_str(j, "refresh_token") {
            Some(s) => if s.length() > 0 { s } else { refresh_token }
            None => refresh_token
          }
        }
        // TS `client/core-ts/src/accounts.ts:10, 299` stores `access_expires` in Unix epoch SECONDS.
        let now_sec = now_ms / 1000L
        let access_expires = match j_opt_int64(j, "access_expires") {
          Some(v) => v
          None => match j_opt_int64(j, "expires_at") {
            Some(v) => v
            None => match j_opt_int64(j, "expires_in") {
              Some(sec) => now_sec + sec
              None => now_sec + 3600L
            }
          }
        }
        let name_opt = match base_codec::json_get(j, "user") {
          Some(u) => j_opt_str(u, "name")
          None => j_opt_str(j, "name")
        }
        k(effect::Exit::Succeeded(Ok(RefreshedTokens::{
          access: access,
          refresh: next_refresh,
          access_expires: access_expires,
          name: name_opt,
        })))
      }
    }
  })
}

/// Exchange an OAuth PKCE authorization code via `POST <origin>/v1/auth/token` matching
/// `client/core-ts/src/accounts.ts:71-79, 244-248`.
pub fn exchange_auth_code_k(
  sh : shell::Shell,
  origin : String,
  code : String,
  code_verifier : String,
  redirect_uri : String,
  k : (effect::Exit[Result[AuthTokenExchange, CloudHttpError]]) -> Unit,
) -> Unit {
  let url = join_base_url(origin, "/v1/auth/token")
  let body = base_codec::json_stringify(base_codec::json_obj([
    ("code", base_codec::json_str(code)),
    ("code_verifier", base_codec::json_str(code_verifier)),
    ("redirect_uri", base_codec::json_str(redirect_uri)),
  ])).to_bytes()
  sh.fetch_k("POST", url, [("content-type", "application/json")], Some(body), fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Succeeded(Err(parse_cloud_http_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Succeeded(Err(CloudHttpError::{ status: resp.status, code: "login_expired", message: "malformed auth token json: " + e })))
            return
          }
        }
        let access_token = match j_opt_str(j, "access_token") {
          Some(s) => if s.length() > 0 { s } else { "" }
          None => ""
        }
        let refresh_token = match j_opt_str(j, "refresh_token") {
          Some(s) => if s.length() > 0 { s } else { "" }
          None => ""
        }
        let subject = match j_opt_str(j, "subject") {
          Some(s) => if s.length() > 0 { s } else { "" }
          None => ""
        }
        let email = match j_opt_str(j, "email") {
          Some(s) => if s.length() > 0 { s } else { "" }
          None => ""
        }
        let expires_at = match j_opt_int64(j, "expires_at") {
          Some(v) => v
          None => {
            k(effect::Exit::Succeeded(Err(CloudHttpError::{ status: resp.status, code: "login_expired", message: "auth token missing expires_at" })))
            return
          }
        }
        if access_token.length() == 0 || refresh_token.length() == 0 || subject.length() == 0 || email.length() == 0 {
          k(effect::Exit::Succeeded(Err(CloudHttpError::{ status: resp.status, code: "login_expired", message: "auth token response missing required fields" })))
          return
        }
        let name = match base_codec::json_get(j, "name") {
          None | Some(base_codec::Json::Null) => ""
          Some(base_codec::Json::Str(s)) => s
          _ => {
            k(effect::Exit::Succeeded(Err(CloudHttpError::{ status: resp.status, code: "login_expired", message: "auth token name must be string" })))
            return
          }
        }
        let picture = match base_codec::json_get(j, "picture") {
          None | Some(base_codec::Json::Null) => ""
          Some(base_codec::Json::Str(s)) => s
          _ => ""
        }
        k(effect::Exit::Succeeded(Ok(AuthTokenExchange::{
          access_token: access_token,
          refresh_token: refresh_token,
          subject: subject,
          email: email,
          name: name,
          picture: picture,
          expires_at: expires_at,
        })))
      }
    }
  })
}

/// Request a signed member credential (`POST <origin>/v1/workspaces/<ws_id>/credential`).
pub fn fetch_member_credential_k(
  sh : shell::Shell,
  origin : String,
  token : String,
  ws_id : String,
  device : String,
  k : (effect::Exit[MemberCredential]) -> Unit,
) -> Unit {
  let url = join_base_url(origin, "/v1/workspaces/" + ws_id + "/credential")
  let body = base_codec::json_stringify(base_codec::json_obj([("device", base_codec::json_str(device))])).to_bytes()
  sh.fetch_k("POST", url, cloud_auth_headers(token, json_body=true), Some(body), fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Failed(effect::EffectError::Custom(parse_cloud_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed credential json: " + e)))
            return
          }
        }
        match parse_member_credential(j) {
          Ok(c) => k(effect::Exit::Succeeded(c))
          Err(e) => k(effect::Exit::Failed(effect::EffectError::Custom(e)))
        }
      }
    }
  })
}

fn ws_read_loop_k(
  sh : shell::Shell,
  ws_id : Int64,
  on_event : (CloudEvent) -> Unit,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if effect::is_interrupted() {
    sh.ws_close(ws_id)
    k(effect::Exit::Interrupted)
    return
  }
  sh.ws_next_k(ws_id, fn(ex : effect::Exit[shell::WsMessage]) -> Unit {
    match ex {
      effect::Exit::Interrupted => {
        sh.ws_close(ws_id)
        k(effect::Exit::Interrupted)
      }
      effect::Exit::Failed(e) => {
        sh.ws_close(ws_id)
        k(effect::Exit::Failed(e))
      }
      effect::Exit::Succeeded(msg) =>
      match msg {
        shell::WsMessage::Text(txt) => {
          match parse_cloud_event(txt) {
            Some(ev) => on_event(ev)
            None => ()
          }
          ws_read_loop_k(sh, ws_id, on_event, k)
        }
        shell::WsMessage::Ping | shell::WsMessage::Pong | shell::WsMessage::Binary(_) => {
          ws_read_loop_k(sh, ws_id, on_event, k)
        }
        shell::WsMessage::Close(_, _) => {
          sh.ws_close(ws_id)
          k(effect::Exit::Succeeded(()))
        }
      }
    }
  })
}

fn is_ws_unauthorized_err(e : effect::EffectError) -> Bool {
  match e {
    effect::EffectError::Custom(m) => {
      let low = ascii_lower(m)
      low.contains("401") || low.contains("unauthorized")
    }
    _ => false
  }
}

fn events_ws_loop_k(
  sh : shell::Shell,
  origin_getter : () -> String,
  token_getter : () -> String,
  on_event : (CloudEvent) -> Unit,
  attempt : Int,
  on_open : Option[() -> Unit],
  on_unauthorized : Option[() -> Unit],
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if effect::is_interrupted() {
    k(effect::Exit::Interrupted)
    return
  }
  let cur_origin = origin_getter()
  let cur_token = token_getter()
  if cur_origin.length() == 0 {
    k(effect::Exit::Succeeded(()))
    return
  }
  let url = cloud_events_ws_url(cur_origin)
  let protocols : Array[String] = if cur_token.length() > 0 {
    ["stillfail-events", "stillfail-token." + cur_token]
  } else {
    ["stillfail-events"]
  }
  let mut open_call_id = 0.to_int64()
  sh.ws_open_k(
    url,
    [],
    protocols,
    fn(ex : effect::Exit[Int64]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          if open_call_id > 0.to_int64() {
            sh.give_up(open_call_id)
          }
          k(effect::Exit::Interrupted)
        }
        effect::Exit::Failed(e) => {
          if is_ws_unauthorized_err(e) {
            match on_unauthorized {
              Some(cb) => cb()
              None => ()
            }
          }
          // timer: exponential backoff on failed cloud `/v1/events` WebSocket connect (1000ms..60000ms).
          let delay = cloud_ws_backoff_ms(attempt)
          effect::sleep_k(delay, fn(sex : effect::Exit[Unit]) -> Unit {
            match sex {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              _ => events_ws_loop_k(sh, origin_getter, token_getter, on_event, attempt + 1, on_open, on_unauthorized, k)
            }
          })
        }
        effect::Exit::Succeeded(ws_id) => {
          // Reconcile `/v1/me` on BOTH initial WS connect AND every reconnect!
          match on_open {
            Some(cb) => cb()
            None => ()
          }
          let opened_at = sh.rt.now()
          ws_read_loop_k(sh, ws_id, on_event, fn(rex : effect::Exit[Unit]) -> Unit {
            match rex {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              _ => {
                let held_ms = sh.rt.now() - opened_at
                let next_attempt = if held_ms >= 60000.to_int64() { 0 } else { attempt }
                // timer: exponential backoff on closed cloud `/v1/events` WebSocket (1000ms..60000ms).
                let delay = cloud_ws_backoff_ms(next_attempt)
                effect::sleep_k(delay, fn(sex : effect::Exit[Unit]) -> Unit {
                  match sex {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    _ => events_ws_loop_k(sh, origin_getter, token_getter, on_event, next_attempt + 1, on_open, on_unauthorized, k)
                  }
                })
              }
            }
          })
        }
      }
    },
    called=fn(id : Int64) -> Unit { open_call_id = id },
  )
}

/// Start consuming `/v1/events` WebSocket with dynamic origin/token getters evaluated on EVERY
/// connect and reconnect, invoking `on_open` on initial connect and every reconnect, and
/// `on_unauthorized` when connect fails with 401.
pub fn start_events_ws_dynamic(
  sh : shell::Shell,
  origin_getter : () -> String,
  token_getter : () -> String,
  on_event : (CloudEvent) -> Unit,
  on_open : Option[() -> Unit] = None,
  on_unauthorized : Option[() -> Unit] = None,
) -> effect::Fiber[Unit] {
  sh.rt.fork_quiet_named("cloud-events-ws", fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    events_ws_loop_k(sh, origin_getter, token_getter, on_event, 0, on_open, on_unauthorized, k)
  })
}

/// Start consuming `/v1/events` WebSocket on a scoped fiber of `sh.rt` with exponential backoff (`1000ms..60000ms`).
pub fn start_events_ws(
  sh : shell::Shell,
  origin : String,
  token : String,
  on_event : (CloudEvent) -> Unit,
  on_reconnect : Option[() -> Unit] = None,
) -> effect::Fiber[Unit] {
  start_events_ws_dynamic(
    sh,
    fn() -> String { origin },
    fn() -> String { token },
    on_event,
    on_open=on_reconnect,
  )
}

/// Structured-error fetch for `GET <origin>/v1/me`, returning exact HTTP status in `CloudHttpError`
/// so 401 triggers session-conditioned token refresh and never gets silently dropped.
pub fn fetch_me_structured_k(
  sh : shell::Shell,
  origin : String,
  token : String,
  k : (effect::Exit[Result[CloudMe, CloudHttpError]]) -> Unit,
) -> Unit {
  let url = join_base_url(origin, "/v1/me")
  sh.fetch_k("GET", url, cloud_auth_headers(token), None, fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Succeeded(Err(parse_cloud_http_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed /v1/me json: " + e)))
            return
          }
        }
        match parse_cloud_me_strict(j) {
          Ok(me) => k(effect::Exit::Succeeded(Ok(me)))
          Err(msg) => k(effect::Exit::Failed(effect::EffectError::Custom(msg)))
        }
      }
    }
  })
}

/// Structured-error fetch for `GET <origin>/v1/workspaces/<ws_id>`, returning exact HTTP status
/// in `CloudHttpError` without fragile error-string matching.
pub fn fetch_workspace_structured_k(
  sh : shell::Shell,
  origin : String,
  token : String,
  ws_id : String,
  k : (effect::Exit[Result[CloudWorkspace, CloudHttpError]]) -> Unit,
) -> Unit {
  let url = join_base_url(origin, "/v1/workspaces/" + ws_id)
  sh.fetch_k("GET", url, cloud_auth_headers(token), None, fn(ex : effect::Exit[shell::FetchResponse]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(resp) => {
        if resp.status < 200 || resp.status >= 300 {
          k(effect::Exit::Succeeded(Err(parse_cloud_http_error(resp.status, resp.body))))
          return
        }
        let body_str = bytes_to_str(resp.body)
        let j = match base_codec::json_parse(body_str) {
          base_codec::JsonParseResult::Ok(v) => v
          base_codec::JsonParseResult::Err(e) => {
            k(effect::Exit::Failed(effect::EffectError::Custom("malformed workspace json: " + e)))
            return
          }
        }
        match parse_cloud_workspace_strict(j, ws_id) {
          Ok(w) => k(effect::Exit::Succeeded(Ok(w)))
          Err(msg) => k(effect::Exit::Failed(effect::EffectError::Custom(msg)))
        }
      }
    }
  })
}

/// Stateful Cloud Sync coordinator bound immutably to one account DB `(bound_sub, bound_session)`
/// with a monotonic `session_gen` guard invalidated on logout, session replacement, and `stop()`.
pub struct CloudSync {
  pub sh : shell::Shell
  pub mut db : sql::Sql
  mut origin : String
  mut token : String
  mut bound_sub : String
  mut bound_session : String
  mut session_gen : Int64
  cred_cache : Map[String, (MemberCredential, Int64)]
  mut ws_fiber : Option[effect::Fiber[Unit]]
  mut cred_epoch_getter : Option[(String) -> Int64]
  mut seq_provider : Option[() -> Int64]
  mut has_pending_auth_confirm_getter : Option[(String) -> Bool]
  mut bearer_gen_getter : Option[() -> Int64]
  mut boundary_id_getter : Option[(String) -> Int64]
  mut on_me_fetched : Option[(CloudMe, Int64) -> Unit]
  mut on_workspace_fetched : Option[(CloudWorkspace, Int64) -> Unit]
  mut on_workspace_fetched_with_epoch : Option[(CloudWorkspace, Int64, Int64) -> Unit]
  mut on_unauthorized_err : Option[(CloudHttpError) -> Unit]
  mut on_workspace_unauthorized : Option[(String, Int64, Int64, Int64, CloudHttpError) -> Unit]
}

pub fn CloudSync::new(
  sh : shell::Shell,
  db : sql::Sql,
  origin : String,
  token : String = "",
  bound_sub : String = "",
  bound_session : String = "",
) -> CloudSync {
  CloudSync::{
    sh: sh,
    db: db,
    origin: origin,
    token: token,
    bound_sub: bound_sub,
    bound_session: bound_session,
    session_gen: 1L,
    cred_cache: Map::new(),
    ws_fiber: None,
    cred_epoch_getter: None,
    seq_provider: None,
    has_pending_auth_confirm_getter: None,
    bearer_gen_getter: None,
    boundary_id_getter: None,
    on_me_fetched: None,
    on_workspace_fetched: None,
    on_workspace_fetched_with_epoch: None,
    on_unauthorized_err: None,
    on_workspace_unauthorized: None,
  }
}

/// Immutably bind this live `CloudSync` to `(sub, session)`.
/// Refuses switching to a different `sub` (returns `Err("account_sub_mismatch")`, 0 side effects).
pub fn CloudSync::bind_account_context(
  self : CloudSync,
  sub : String,
  session : String = "",
) -> Result[Unit, String] {
  if sub.length() == 0 {
    return Err("account_sub_mismatch: empty account sub")
  }
  if self.bound_sub.length() > 0 && self.bound_sub != sub {
    return Err("account_sub_mismatch: expected " + self.bound_sub + ", got " + sub)
  }
  self.bound_sub = sub
  if session.length() > 0 && session != self.bound_session {
    self.bound_session = session
    self.session_gen += 1L
    self.stop_events_ws()
  }
  Ok(())
}

/// Stop only the active `/v1/events` WebSocket fiber so `is_events_ws_running()` becomes `false`.
pub fn CloudSync::stop_events_ws(self : CloudSync) -> Unit {
  match self.ws_fiber {
    Some(f) => {
      self.ws_fiber = None
      f.interrupt()
    }
    None => ()
  }
}

pub fn CloudSync::session_gen(self : CloudSync) -> Int64 {
  self.session_gen
}

/// Monotonically advance `session_gen` BEFORE invalidating, stopping, or replacing a session
/// so any already-forked `/v1/me`, `/v1/workspaces/<id>`, credential, or WS callback is dropped.
pub fn CloudSync::bump_session_gen(self : CloudSync) -> Int64 {
  self.session_gen += 1L
  self.session_gen
}

pub fn CloudSync::bound_sub(self : CloudSync) -> String {
  self.bound_sub
}

pub fn CloudSync::bound_session(self : CloudSync) -> String {
  self.bound_session
}

pub fn CloudSync::token(self : CloudSync) -> String {
  self.token
}

pub fn CloudSync::is_events_ws_running(self : CloudSync) -> Bool {
  self.ws_fiber.is_some()
}

fn CloudSync::context_matches(self : CloudSync, orig_sub : String, orig_session : String, orig_gen : Int64) -> Bool {
  self.bound_sub == orig_sub && self.bound_session == orig_session && self.session_gen == orig_gen
}

pub fn CloudSync::set_cred_epoch_getter(self : CloudSync, getter : (String) -> Int64) -> Unit {
  self.cred_epoch_getter = Some(getter)
}

pub fn CloudSync::set_seq_provider(self : CloudSync, provider : () -> Int64) -> Unit {
  self.seq_provider = Some(provider)
}

pub fn CloudSync::set_has_pending_auth_confirm_getter(
  self : CloudSync,
  getter : (String) -> Bool,
) -> Unit {
  self.has_pending_auth_confirm_getter = Some(getter)
}

/// True iff `ws_id` currently has an active `PendingAuthConfirm` gate, so Cloud partial in-place
/// patches (lock head, station online/offline, workspace rev delta) MUST be suppressed in favor of
/// a full `/v1/workspaces/<ws_id>` reread (aligned with `cloud.ts:2336, 2353, 2394`).
pub fn CloudSync::should_suppress_cloud_patch(self : CloudSync, ws_id : String) -> Bool {
  match self.has_pending_auth_confirm_getter {
    Some(g) => g(ws_id)
    None => false
  }
}

fn CloudSync::current_cred_epoch(self : CloudSync, ws_id : String) -> Int64 {
  match self.cred_epoch_getter {
    Some(g) => g(ws_id)
    None => 1L
  }
}

fn CloudSync::next_req_seq(self : CloudSync) -> Int64 {
  match self.seq_provider {
    Some(p) => p()
    None => 0L
  }
}

pub fn CloudSync::set_workspace_auth_context_getters(
  self : CloudSync,
  get_bearer_gen : () -> Int64,
  get_boundary_id : (String) -> Int64,
) -> Unit {
  self.bearer_gen_getter = Some(get_bearer_gen)
  self.boundary_id_getter = Some(get_boundary_id)
}

fn CloudSync::current_bearer_gen(self : CloudSync) -> Int64 {
  match self.bearer_gen_getter {
    Some(g) => g()
    None => 0L
  }
}

fn CloudSync::current_boundary_id(self : CloudSync, ws_id : String) -> Int64 {
  match self.boundary_id_getter {
    Some(g) => g(ws_id)
    None => 0L
  }
}

pub fn CloudSync::set_commit_hooks(
  self : CloudSync,
  on_me_fetched : Option[(CloudMe, Int64) -> Unit] = None,
  on_workspace_fetched : Option[(CloudWorkspace, Int64) -> Unit] = None,
  on_unauthorized_err : Option[(CloudHttpError) -> Unit] = None,
  on_workspace_fetched_with_epoch : Option[(CloudWorkspace, Int64, Int64) -> Unit] = None,
  on_workspace_unauthorized : Option[(String, Int64, Int64, Int64, CloudHttpError) -> Unit] = None,
) -> Unit {
  self.on_me_fetched = on_me_fetched
  self.on_workspace_fetched = on_workspace_fetched
  self.on_unauthorized_err = on_unauthorized_err
  self.on_workspace_fetched_with_epoch = on_workspace_fetched_with_epoch
  self.on_workspace_unauthorized = on_workspace_unauthorized
}

pub fn CloudSync::set_origin_and_token(self : CloudSync, origin : String, token : String) -> Unit {
  if origin.length() > 0 {
    self.origin = origin
  }
  if token.length() > 0 {
    self.token = token
  }
}

pub fn CloudSync::origin(self : CloudSync) -> String {
  self.origin
}

/// Evict cached member credentials for workspace `ws_id` so the next connection fetches a fresh one.
pub fn CloudSync::invalidate_workspace_credential(self : CloudSync, ws_id : String) -> Unit {
  let prefix = ws_id + "/"
  let ks = self.cred_cache.keys()
  for i in 0..<ks.length() {
    if ks[i].starts_with(prefix) {
      self.cred_cache.remove(ks[i])
    }
  }
}

/// Evict all cached member credentials (e.g. on session invalidation / sign-out).
pub fn CloudSync::clear_all_credentials(self : CloudSync) -> Unit {
  self.cred_cache.clear()
}

/// Clear the in-memory bearer token on logout / session invalidation.
pub fn CloudSync::clear_token(self : CloudSync) -> Unit {
  self.token = ""
}

/// Atomically switch the SQLite DB handle when transitioning from unauthenticated startup
/// (`:memory:`) to the signed-in account's dedicated DB. Stops any WS, bumps `session_gen`,
/// and clears cached credentials.
pub fn CloudSync::switch_db(self : CloudSync, new_db : sql::Sql) -> Unit {
  self.stop()
  self.cred_cache.clear()
  self.db = new_db
}

pub fn CloudSync::fetch_me_k(
  self : CloudSync,
  k : (effect::Exit[CloudMe]) -> Unit,
  persist : Bool = true,
) -> Unit {
  let eff_persist = persist && self.on_me_fetched.is_none()
  fetch_me_k(self.sh, self.origin, self.token, self.db, k, persist=eff_persist)
}

pub fn CloudSync::fetch_workspace_k(
  self : CloudSync,
  ws_id : String,
  k : (effect::Exit[CloudWorkspace]) -> Unit,
  persist : Bool = true,
) -> Unit {
  let eff_persist = persist && self.on_workspace_fetched.is_none()
  fetch_workspace_k(self.sh, self.origin, self.token, ws_id, self.db, k, persist=eff_persist)
}

pub fn CloudSync::refresh_token_k(
  self : CloudSync,
  refresh_token : String,
  now_ms : Int64,
  k : (effect::Exit[Result[RefreshedTokens, RefreshTokenError]]) -> Unit,
) -> Unit {
  refresh_token_k(self.sh, self.origin, refresh_token, now_ms, k)
}

/// Get a cached member credential or fetch & cache a fresh one when missing/expired (`expires_at <= now_sec + 60`).
/// Captures `(cred_epoch(ws_id), bound_sub, bound_session)` BEFORE async I/O and rejects if changed in-flight!
pub fn CloudSync::fetch_member_credential_k(
  self : CloudSync,
  ws_id : String,
  device : String,
  now_sec : Int64,
  k : (effect::Exit[MemberCredential]) -> Unit,
  fresh : Bool = false,
) -> Unit {
  let cache_key = ws_id + "/" + device
  let captured_epoch = self.current_cred_epoch(ws_id)
  let orig_sub = self.bound_sub
  let orig_session = self.bound_session
  let orig_gen = self.session_gen
  if fresh {
    self.cred_cache.remove(cache_key)
  } else {
    match self.cred_cache.get(cache_key) {
      Some((c, cached_ep)) => {
        if cached_ep == captured_epoch && c.expires_at > now_sec + 60.to_int64() {
          k(effect::Exit::Succeeded(c))
          return
        }
      }
      None => ()
    }
  }
  fetch_member_credential_k(self.sh, self.origin, self.token, ws_id, device, fn(ex : effect::Exit[MemberCredential]) -> Unit {
    if !self.context_matches(orig_sub, orig_session, orig_gen) {
      k(effect::Exit::Failed(effect::EffectError::Custom("account_context_changed")))
      return
    }
    match ex {
      effect::Exit::Succeeded(c) => {
        if self.current_cred_epoch(ws_id) != captured_epoch {
          k(effect::Exit::Failed(effect::EffectError::Custom("cred_epoch_changed")))
          return
        }
        self.cred_cache.set(cache_key, (c, captured_epoch))
        k(effect::Exit::Succeeded(c))
      }
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

/// Reconcile `/v1/me` through the single atomic commit hook, capturing `(orig_sub, orig_session, orig_gen, req_seq)`
/// BEFORE async I/O and routing HTTP 401 to `on_unauthorized_err` (never silently dropped).
pub fn CloudSync::trigger_me_reconcile(self : CloudSync) -> Unit {
  let req_seq = self.next_req_seq()
  let orig_sub = self.bound_sub
  let orig_session = self.bound_session
  let orig_gen = self.session_gen
  let cur_origin = self.origin
  let cur_token = self.token
  let _ = self.sh.rt.fork_quiet_named("cloud-refresh-me", fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    fetch_me_structured_k(
      self.sh,
      cur_origin,
      cur_token,
      fn(ex : effect::Exit[Result[CloudMe, CloudHttpError]]) -> Unit {
        if !self.context_matches(orig_sub, orig_session, orig_gen) {
          fk(effect::Exit::Succeeded(()))
          return
        }
        match ex {
          effect::Exit::Succeeded(Ok(me)) => match self.on_me_fetched {
            Some(cb) => cb(me, req_seq)
            None => ()
          }
          effect::Exit::Succeeded(Err(herr)) => {
            if herr.status == 401 {
              match self.on_unauthorized_err {
                Some(cb) => cb(herr)
                None => ()
              }
            }
          }
          _ => ()
        }
        fk(effect::Exit::Succeeded(()))
      },
    )
  })
}

/// Start `/v1/events` WebSocket with dynamic `self.origin`/`self.token` reading on every connect/reconnect:
/// - Initial connect & every reconnect trigger `/v1/me` reconcile.
/// - WS 401 and `/v1/me` 401 invoke `on_unauthorized_err`.
/// - `WorkspaceChanged` 403/404 triggers `/v1/me` reconcile (NEVER directly calls `drop_workspace`!).
/// - Every callback verifies `(orig_sub, orig_session, orig_gen)` still matches before mutating state or reporting errors.
pub fn CloudSync::start_events_ws(
  self : CloudSync,
  on_event : (CloudEvent) -> Unit,
  on_reconnect : Option[() -> Unit] = None,
) -> Unit {
  match self.ws_fiber {
    Some(_) => return
    None => ()
  }
  let orig_sub = self.bound_sub
  let orig_session = self.bound_session
  let orig_gen = self.session_gen
  let fiber = start_events_ws_dynamic(
    self.sh,
    fn() -> String { self.origin },
    fn() -> String { self.token },
    fn(ev : CloudEvent) -> Unit {
      if !self.context_matches(orig_sub, orig_session, orig_gen) {
        return
      }
      match ev {
        CloudEvent::WorkspacesChanged(_) => {
          self.trigger_me_reconcile()
        }
        CloudEvent::WorkspaceChanged(wid, _) => {
          let req_seq = self.next_req_seq()
          let captured_cred_epoch = self.current_cred_epoch(wid)
          let captured_bearer_gen = self.current_bearer_gen()
          let captured_boundary_id = self.current_boundary_id(wid)
          let cur_origin = self.origin
          let cur_token = self.token
          let _ = self.sh.rt.fork_quiet_named("cloud-refresh-ws:" + wid, fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
            fetch_workspace_structured_k(
              self.sh,
              cur_origin,
              cur_token,
              wid,
              fn(ex : effect::Exit[Result[CloudWorkspace, CloudHttpError]]) -> Unit {
                if !self.context_matches(orig_sub, orig_session, orig_gen) {
                  fk(effect::Exit::Succeeded(()))
                  return
                }
                match ex {
                  effect::Exit::Succeeded(Ok(ws)) => match self.on_workspace_fetched_with_epoch {
                    Some(cb) => cb(ws, req_seq, captured_cred_epoch)
                    None => match self.on_workspace_fetched {
                      Some(cb) => cb(ws, req_seq)
                      None => ()
                    }
                  }
                  effect::Exit::Succeeded(Err(herr)) => {
                    if herr.status == 403 || herr.status == 404 {
                      // NEVER drop_workspace directly on 403/404 (prevents stale 403/404 from wiping rejoined
                      // workspaces or account-level `403 not_beta` from wiping valid workspaces): reconcile `/v1/me`!
                      self.trigger_me_reconcile()
                    } else if herr.status == 401 {
                      match self.on_workspace_unauthorized {
                        Some(cb) => cb(wid, captured_boundary_id, captured_bearer_gen, req_seq, herr)
                        None => match self.on_unauthorized_err {
                          Some(cb) => cb(herr)
                          None => ()
                        }
                      }
                    }
                  }
                  _ => ()
                }
                fk(effect::Exit::Succeeded(()))
              },
            )
          })
        }
        CloudEvent::Other("station", j) => {
          // Aligned with `cloud.ts:2353`: when `workspace` is pending auth confirmation, suppress
          // in-place station online/offline patching and force a full `/v1/workspaces/<ws>` reread.
          let wid = j_str(j, "workspace")
          if wid.length() > 0 && self.should_suppress_cloud_patch(wid) {
            let req_seq = self.next_req_seq()
            let captured_cred_epoch = self.current_cred_epoch(wid)
            let captured_bearer_gen = self.current_bearer_gen()
            let captured_boundary_id = self.current_boundary_id(wid)
            let cur_origin = self.origin
            let cur_token = self.token
            let _ = self.sh.rt.fork_quiet_named("cloud-refresh-ws:" + wid, fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
              fetch_workspace_structured_k(
                self.sh,
                cur_origin,
                cur_token,
                wid,
                fn(ex : effect::Exit[Result[CloudWorkspace, CloudHttpError]]) -> Unit {
                  if !self.context_matches(orig_sub, orig_session, orig_gen) {
                    fk(effect::Exit::Succeeded(()))
                    return
                  }
                  match ex {
                    effect::Exit::Succeeded(Ok(ws)) => match self.on_workspace_fetched_with_epoch {
                      Some(cb) => cb(ws, req_seq, captured_cred_epoch)
                      None => match self.on_workspace_fetched {
                        Some(cb) => cb(ws, req_seq)
                        None => ()
                      }
                    }
                    effect::Exit::Succeeded(Err(herr)) => {
                      if herr.status == 403 || herr.status == 404 {
                        self.trigger_me_reconcile()
                      } else if herr.status == 401 {
                        match self.on_workspace_unauthorized {
                          Some(cb) => cb(wid, captured_boundary_id, captured_bearer_gen, req_seq, herr)
                          None => match self.on_unauthorized_err {
                            Some(cb) => cb(herr)
                            None => ()
                          }
                        }
                      }
                    }
                    _ => ()
                  }
                  fk(effect::Exit::Succeeded(()))
                },
              )
            })
          }
        }
        _ => ()
      }
      on_event(ev)
    },
    on_open=Some(fn() -> Unit {
      if !self.context_matches(orig_sub, orig_session, orig_gen) {
        return
      }
      self.trigger_me_reconcile()
      match on_reconnect {
        Some(cb) => cb()
        None => ()
      }
    }),
    on_unauthorized=Some(fn() -> Unit {
      if !self.context_matches(orig_sub, orig_session, orig_gen) {
        return
      }
      match self.on_unauthorized_err {
        Some(cb) => cb(CloudHttpError::{ status: 401, code: "unauthorized", message: "events ws unauthorized" })
        None => ()
      }
    }),
  )
  self.ws_fiber = Some(fiber)
}

pub fn CloudSync::restart_events_ws(
  self : CloudSync,
  on_event : (CloudEvent) -> Unit,
  on_reconnect : Option[() -> Unit] = None,
) -> Unit {
  self.stop()
  self.start_events_ws(on_event, on_reconnect=on_reconnect)
}

pub fn CloudSync::stop(self : CloudSync) -> Unit {
  // Immediately advance `session_gen` BEFORE interrupting WS so any in-flight forked
  // `/v1/me`, `/v1/workspaces/<id>`, or credential callback is guaranteed to be discarded.
  self.session_gen += 1L
  match self.ws_fiber {
    Some(f) => {
      self.ws_fiber = None
      f.interrupt()
    }
    None => ()
  }
}
