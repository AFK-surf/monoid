            base_codec::Json::Obj(_) => {
              let cur = self.notify_kinds
              let next_done = match proto_str(kj, "done") {
                Some(s) => if s == "off" || s == "away" || s == "always" { s } else { cur.done }
                None => cur.done
              }
              self.notify_kinds = views::NotifyKindsInput::{
                wait: match base_codec::json_get(kj, "wait") { Some(base_codec::Json::Bool(b)) => b; _ => cur.wait },
                failed: match base_codec::json_get(kj, "failed") { Some(base_codec::Json::Bool(b)) => b; _ => cur.failed },
                done: next_done,
                message: match base_codec::json_get(kj, "message") { Some(base_codec::Json::Bool(b)) => b; _ => cur.message },
                billed: match base_codec::json_get(kj, "billed") { Some(base_codec::Json::Bool(b)) => b; _ => cur.billed },
              }
            }
            _ => ()
          }
          None => ()
        }
        let muted_j : Array[base_codec::Json] = []
        for i in 0..<self.notify_muted.length() {
          muted_j.push(base_codec::json_str(self.notify_muted[i]))
        }
        let kinds_j = base_codec::json_obj([
          ("wait", base_codec::json_bool(self.notify_kinds.wait)),
          ("failed", base_codec::json_bool(self.notify_kinds.failed)),
          ("done", base_codec::json_str(self.notify_kinds.done)),
          ("message", base_codec::json_bool(self.notify_kinds.message)),
          ("billed", base_codec::json_bool(self.notify_kinds.billed)),
        ])
        let persist_j = base_codec::json_obj([
          ("on", base_codec::json_bool(self.notify_on)),
          ("asked", base_codec::json_bool(self.notify_asked)),
          ("kinds", kinds_j),
          ("preview", base_codec::json_bool(self.notify_preview)),
          ("muted", base_codec::json_arr(muted_j)),
        ])
        let _ = store::put_account_doc(self.db, "notify", base_codec::json_stringify(persist_j))
        match views::project_notify(self.db, self.current_notify_state(), self.notices_held, lang=self.lang) {
          sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Ok(id, j, None))
          sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
        }
      }
      if call_name == "chat.place" {
        // 1:1 with `client/core-ts/src/core/calls.ts:743-751`, `station/topics.ts:710-760`, & `data.ts:1776`:
        // 256-entry bounded in-memory LRU (caching `None` too) + SQLite `workspace_pref(ws, "place:<st>/<th>")` restart persistence.
        let st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        let th = match proto_int(params, "thread") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing thread" }))
        }
        let seq_opt = proto_int(params, "seq")
        let off_opt : Option[Double] = match base_codec::json_get(params, "offset") {
          Some(base_codec::Json::Num(n, _)) => Some(n)
          _ => None
        }
        self.set_chat_place_mem(st, th, seq_opt, off_opt)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
      }
      if call_name == "chat.window" {
        // 1:1 with `client/core-ts/src/core/calls.ts:787-796`: `rows` required, clamped to `[1, 200]`.
        let st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        let raw_rows = match proto_int(params, "rows") {
          Some(r) => r
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing rows" }))
        }
        if raw_rows <= 0 {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "rows must be positive" }))
        }
        let clamped_rows = if raw_rows > 200 { 200 } else { raw_rows }
        let th_opt = proto_int(params, "thread")
        let sess_opt = match proto_str(params, "session") {
          Some(s) => if s.length() > 0 { Some(s) } else { None }
          None => None
        }
        if th_opt.is_none() && sess_opt.is_none() {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing thread or session" }))
        }
        match th_opt {
          Some(th) => self.chat_windows.set(st + ":t:" + th.to_string(), clamped_rows)
          None => ()
        }
        match sess_opt {
          Some(s) => self.chat_windows.set(st + ":s:" + s, clamped_rows)
          None => ()
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
      }
      if call_name == "draft.get" {
        // 1:1 with `client/core-ts/src/core/calls.ts:901-913`: accepts `{ key }` OR `{ station, chat }`.
        let (st, chat) = match proto_str(params, "key") {
          Some(k) => match draft_at_key(k) {
            Some(pair) => pair
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "invalid draft key" }))
          }
          None => {
            let s = match proto_str(params, "station") {
              Some(v) => if v.length() > 0 { v } else { "" }
              None => ""
            }
            let c = match proto_str(params, "chat") {
              Some(v) => if v.length() > 0 { v } else { "" }
              None => ""
            }
            if s.length() == 0 || c.length() == 0 {
              return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key or station+chat" }))
            }
            (s, c)
          }
        }
        return Some(protocol::CoreEvent::Ok(id, self.composers.read_draft(st, chat), None))
      }
      if call_name == "draft.put" {
        // 1:1 with `client/core-ts/src/core/calls.ts:901-921`: accepts `{ key }` OR `{ station, chat }`.
        let (st, chat) = match proto_str(params, "key") {
          Some(k) => match draft_at_key(k) {
            Some(pair) => pair
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "invalid draft key" }))
          }
          None => {
            let s = match proto_str(params, "station") {
              Some(v) => if v.length() > 0 { v } else { "" }
              None => ""
            }
            let c = match proto_str(params, "chat") {
              Some(v) => if v.length() > 0 { v } else { "" }
              None => ""
            }
            if s.length() == 0 || c.length() == 0 {
              return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key or station+chat" }))
            }
            (s, c)
          }
        }
        let draft_val = match base_codec::json_get(params, "value") {
          Some(v) => v
          None => params
        }
        return Some(protocol::CoreEvent::Ok(id, self.composers.put_draft(st, chat, draft_val), None))
      }
      if call_name == "markdown" {
        let text = match proto_str(params, "text") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing text" }))
        }
        let mk = store::md_key(text)
        let now = self.rt.now()
        let md_json = match self.md_store.get(mk, now) {
          Some(raw) => match base_codec::json_parse(raw) {
            base_codec::JsonParseResult::Ok(j) => j
            base_codec::JsonParseResult::Err(_) => {
              let parsed = views::parse_md_ast(text)
              self.md_store.put_prepared(mk, base_codec::json_stringify(parsed), "markdown", now)
              parsed
            }
          }
          None => {
            let parsed = views::parse_md_ast(text)
            self.md_store.put_prepared(mk, base_codec::json_stringify(parsed), "markdown", now)
            parsed
          }
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("md", md_json)]), None))
      }
      if call_name == "link.parse" {
        let url = match proto_str(params, "url") {
          Some(u) => u
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing url" }))
        }
        let parsed = views::parse_link_target(self.db, url, self.cloud_origin)
        return Some(protocol::CoreEvent::Ok(id, parsed, None))
      }
      if call_name == "composer.text" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let txt = match proto_str(params, "text") { Some(s) => s; None => "" }
        let v = self.composers.text(key, txt)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.append" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let words = match proto_str(params, "words") {
          Some(w) => w
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing words" }))
        }
        let v = self.composers.append(key, words)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.take" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let st_opt = proto_str(params, "station")
        return Some(protocol::CoreEvent::Ok(id, self.composers.take(key, station=st_opt, lang=self.lang), None))
      }
      if call_name == "composer.add" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        let files = match base_codec::json_get(params, "files") {
          Some(base_codec::Json::Arr(xs)) => xs
          _ => []
        }
        match self.composers.add(key, st, files, bytes=bytes) {
          Ok(v) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
          Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "unsupported", message: msg }))
        }
      }
      if call_name == "composer.mode" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let fid = match proto_str(params, "id") {
          Some(f) => f
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let mode = match proto_str(params, "mode") { Some(m) => m; None => "path" }
        match self.composers.mode(key, fid, mode) {
          Ok(v) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
          Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "unsupported", message: msg }))
        }
      }
      if call_name == "composer.quote" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let qj = match base_codec::json_get(params, "quote") {
          Some(base_codec::Json::Obj(fs)) => base_codec::json_obj(fs)
          _ => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing quote" }))
        }
        let qid = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let focus = match base_codec::json_get(params, "focus") {
          Some(base_codec::Json::Bool(b)) => b
          _ => false
        }
        let att = base_codec::json_get(params, "attachment")
        let fid = proto_str(params, "fileId")
        let v = self.composers.quote(key, qj, qid, focus, attachment=att, file_id=fid)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.comment" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let qid = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let words = match proto_str(params, "comment") { Some(s) => s; None => "" }
        let v = self.composers.comment(key, qid, words)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.unquote" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let qid = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let v = self.composers.unquote(key, qid)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.focused" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let v = self.composers.focused(key)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.error" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let v = self.composers.error(key, proto_str(params, "error"))
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.remove" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let fid = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let v = self.composers.remove(key, fid)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.restore" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let uw = match base_codec::json_get(params, "unlessWritten") {
          Some(base_codec::Json::Bool(b)) => b
          _ => false
        }
        return Some(protocol::CoreEvent::Ok(id, self.composers.restore(key, proto_str(params, "error"), uw), None))
      }
      if call_name == "composer.carry" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let to = match proto_str(params, "to") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing to" }))
        }
        let v = self.composers.carry(key, to)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.starting" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let st_flag = match base_codec::json_get(params, "starting") {
          Some(base_codec::Json::Bool(b)) => b
          _ => false
        }
        let v = self.composers.starting(key, st_flag)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "account.switch" {
        let acct = match proto_str(params, "account") {
          Some(s) => s
          None => match proto_str(params, "id") {
            Some(s) => s
            None => match proto_str(params, "email") {
              Some(s) => s
              None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing account" }))
            }
          }
        }
        if acct.length() == 0 {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "empty account" }))
        }
        if self.auth_store.accounts.length() > 0 {
          // Resolve by `sub` or `email` against signed-in accounts; refuse unknown accounts without writing `active_account`.
          let mut found_account = false
          let mut target_sub = ""
          let mut target_email = ""
          for i in 0..<self.auth_store.accounts.length() {
            let a = self.auth_store.accounts[i]
            if a.sub == acct || a.email == acct {
              found_account = true
              target_sub = a.sub
              target_email = a.email
              break
            }
          }
          if !found_account {
            return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "not_found", message: "account not found: " + acct }))
          }
          // Multi-account SQLite DB re-open is not yet wired: refuse cross-account DB switch honestly
          // without mutating `active_sub`, `viewer_sub`, or `active_account` (preventing cross-account data mix!).
          match self.db_account_sub {
            Some(open_sub) => {
              if open_sub != target_sub {
                return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
                  code: "unsupported",
                  message: "multi-account db switch not yet wired",
                }))
              }
            }
            None => ()
          }
          match self.auth_store.switch_account(target_sub) {
            Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "not_found", message: msg }))
            Ok(_) => {
              if target_email.length() > 0 {
                self.set_viewer(target_email, sub=target_sub)
              }
            }
          }
        } else {
          // When `auth_store` is empty, verify against persisted `account_doc("accounts")` if populated.
          let mut resolved_sub = acct
          match store::get_account_doc(self.db, "accounts") {
            sql::SqlResult::Ok(Some(raw)) => match base_codec::json_parse(raw) {
              base_codec::JsonParseResult::Ok(j) => {
                let items = match j {
                  base_codec::Json::Arr(xs) => xs
                  base_codec::Json::Obj(_) => match base_codec::json_get(j, "accounts") {
                    Some(base_codec::Json::Arr(xs)) => xs
                    _ => []
                  }
                  _ => []
                }
                if items.length() > 0 {
                  let mut found = false
                  for i in 0..<items.length() {
                    let it = items[i]
                    let s = match proto_str(it, "sub") { Some(v) => v; None => match proto_str(it, "id") { Some(v) => v; None => "" } }
                    let e = match proto_str(it, "email") { Some(v) => v; None => "" }
                    if s == acct || e == acct {
                      found = true
                      if s.length() > 0 { resolved_sub = s }
                      break
                    }
                  }
                  if !found {
                    return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "not_found", message: "account not found: " + acct }))
                  }
                }
              }
              base_codec::JsonParseResult::Err(_) => ()
            }
            _ => ()
          }
          match self.db_account_sub {
            Some(open_sub) => {
              if open_sub != resolved_sub {
                return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
                  code: "unsupported",
                  message: "multi-account db switch not yet wired",
                }))
              }
            }
            None => ()
          }
        }
        return self.router.handle(req)
      }
      self.router.handle(req)
    }
    protocol::CoreRequest::Subscribe(id, topic, _keyed, _from, _have) => {
      // Rule 4: subscribing NEVER starts a network request; only reads local SQLite.
      // If subscribing to a specific chat thread, only raises priority without opening a new fetch.
      self.drop_chat_sub_snapshot(id)
      if topic.name == "chat" {
        match topic.param("thread") {
          Some(base_codec::Json::Num(n, _)) => self.sync.focus_thread(Some(n.to_int()))
          _ => ()
        }
      }
      self.router.handle(req)
    }
    protocol::CoreRequest::Unsubscribe(id, _, _) => {
      self.close_chat_sub_snapshot(id)
      self.router.handle(req)
    }
    _ => self.router.handle(req)
  }
}

/// Thin JSON wire adapter compatible with `core_api.h` (`mb_core_send` -> callback).
/// Matches `client/core-ts/src/core.ts` `receiveJson` / `receiveRaw`.
pub fn ClientCore::handle_wire(self : ClientCore, json_text : String, bytes : Option[Bytes] = None) -> Option[(String, Option[Bytes])] {
  let raw = match base_codec::json_parse(json_text) {
    base_codec::JsonParseResult::Err(_) => return None
    base_codec::JsonParseResult::Ok(j) => j
  }
  match protocol::parse_client_message(raw, bytes=bytes) {
    protocol::ParseRequestResult::Invalid(msg) =>
    match protocol::wire_error_id(raw) {
      Some(id) => {
        let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_message", message: msg })
        Some(protocol::encode_core_event(ev))
      }
      None => None
    }
    protocol::ParseRequestResult::Ok(req) =>
    match self.handle_request(req) {
      Some(ev) => Some(protocol::encode_core_event(ev))
      None => None
    }
  }
}
