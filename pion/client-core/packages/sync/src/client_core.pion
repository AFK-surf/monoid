// Dual-channel unified `ClientCore` facade combining:
// 1. Zero-serialization strongly typed `FrameOutbox[CoreEvent]` + typed commands for Invar UI;
// 2. Thin JSON `packages/protocol` wire adapter compatible with `apps/mbui/src/host/core_api.h`.

import "base_codec"
import "crypto"
import "effect"
import "form"
import "lock"
import "outbox"
import "protocol"
import "shell"
import "sql"
import "store"
import "views"

struct MarksWanted {
  mut in_flight : Bool
  mut whole : Bool
  sessions : Array[String]
  threads : Array[Int]
}

struct PendingWireEvent {
  json : String
  bytes : Option[Bytes]
  is_handshake : Bool
}

struct WorkspaceLockSlot {
  mut lock_state : Option[lock::LockState]
  mut lock_root : Option[String]
  mut lock_kept_entries : Array[form::Json]
  mut lock_kept_aside : Array[form::Json]
  mut lock_seen : Option[base_codec::Json]
  mut lock_corrupt : Bool
  mut lock_effective : Option[views::EffectiveLockState]
}

fn empty_lock_slot() -> WorkspaceLockSlot {
  WorkspaceLockSlot::{
    lock_state: None,
    lock_root: None,
    lock_kept_entries: [],
    lock_kept_aside: [],
    lock_seen: None,
    lock_corrupt: false,
    lock_effective: None,
  }
}

let PENDING_WIRE_MAX : Int = 256

pub struct ClientCore {
  pub mut workspace : String
  pub mut station : String
  pub rt : effect::Runtime
  pub mut db : sql::Sql
  pub md_store : store::MdStore
  pub outbox : outbox::FrameOutbox[CoreEvent]
  pub mut events : StationEvents
  pub local_outbox : LocalOutbox
  pub mut sync : SyncScheduler
  pub auth : AuthGenTracker
  pub membership : MembershipAuthority
  pub doing : DoingTracker
  pub composers : ComposerManager
  extra_events : Map[String, StationEvents]
  extra_sync : Map[String, SyncScheduler]
  extra_locks : Map[String, WorkspaceLockSlot]
  marks_wanted : Map[String, MarksWanted]
  mut live : Bool
  pub router : protocol::Slice1Router
  pub mut rows_memo : views::RowsMemo
  pub mut viewer_marks : views::ViewerMarks
  pending_dirty_rows : Array[(String, String)]
  mut wire_sink : Option[(String, Option[Bytes]) -> Unit]
  pending_wire_events : Array[PendingWireEvent]
  lock_digest_by_ws : Map[String, String]
  lock_sec_digest_by_ws : Map[String, String]
  mut on_runtime_boundary : Option[(AuthBoundaryEvent) -> Unit]
  mut on_credential_refresh : Option[(String) -> Unit]
  mut on_workspace_refresh : Option[(String) -> Unit]
  mut on_workspace_dropped : Option[(String, Array[String]) -> Unit]
  mut on_accounts_persisted : Option[(base_codec::Json) -> Result[Unit, String]]
  mut on_session_invalidated : Option[(String) -> Unit]
  pub lock_pending : views::LockPendingQueue
  pub auth_store : views::AccountStore
  pub account_sessions : Map[String, String]
  pub login_flow : views::LoginFlowMachine
  pub vault_approvals : views::VaultApprovalQueue
  pub file_reads : views::SharedFileReads
  pub mut cloud_origin : String
  pub presets_held : Array[views::PresetRecord]
  pub other_presets_held : Array[views::PresetRecord]
  pub stars_held : Array[views::StarEntry]
  pub board_drafts_held : Array[views::BoardDraftRecord]
  pub downloads_held : Array[views::DownloadEntry]
  pub status_waits : Array[views::StatusWaitEntry]
  pub status_downs : Array[views::StatusDownSocket]
  pub status_db_notes : Array[views::StatusDbNote]
  pub notices_held : Array[views::NoticeItemInput]
  pub lock_pairing_prompts : Array[views::LockPairingPromptInput]
  pub vault_key_asks : Array[views::VaultKeyAskInput]
  pub mut notify_on : Bool
  pub mut notify_asked : Bool
  pub mut notify_push : Bool
  pub mut notify_preview : Bool
  pub mut notify_permission : String
  pub mut notify_in_front : Bool
  pub notify_muted : Array[String]
  pub mut notify_kinds : views::NotifyKindsInput
  pub mut lang : String
  pub mut device_app : String
  pub mut device_locale : String
  pub mut device_build : String
  pub mut device_phone : Bool
  pub mut utc_offset_min : Int
  pub mut db_account_sub : Option[String]
  pub mut account_epoch : Int64
  chat_windows : Map[String, Int]
  chat_places : Map[String, Option[(Int, Option[Double])]]
  chat_place_order : Array[String]
  chat_sub_snapshots : Map[Int64, ChatSubSnapshot]
  chat_row_dest_ws : Map[Int64, String]
  mut on_prefs_saved : Option[(base_codec::Json) -> Result[Unit, String]]
  mut auth_seq : Int
  mut lock_state : Option[lock::LockState]
  mut lock_root : Option[String]
  mut lock_kept_entries : Array[form::Json]
  mut lock_kept_aside : Array[form::Json]
  mut person_lock_entries : Array[base_codec::Json]
  mut lock_seen : Option[base_codec::Json]
  mut lock_corrupt : Bool
  mut lock_read_pending : Bool
  mut lock_effective : Option[views::EffectiveLockState]
  mut viewer_sub : String
  mut viewer_role : String
  mut device_id : String
  mut device_kind : String
  mut device_sign_key : Option[String]
  mut lock_available : Bool
  mut vaults_set_up : Bool
}

fn default_notify_kinds() -> views::NotifyKindsInput {
  views::NotifyKindsInput::{
    wait: true,
    failed: true,
    done: "away",
    message: true,
    billed: false,
  }
}

pub fn ClientCore::new(
  workspace : String,
  station : String,
  rt : effect::Runtime,
  db : sql::Sql,
  transport : StationTransport,
  on_frame_wake : () -> Unit,
  conn_seq : Option[Int64] = None,
) -> ClientCore {
  let frame_outbox : outbox::FrameOutbox[CoreEvent] = outbox::FrameOutbox::new(on_frame_wake)
  let md_store = store::MdStore::new(db, station)
  let events = StationEvents::new(workspace, station, db, frame_outbox, transport)
  let local_outbox = LocalOutbox::new(station, db, frame_outbox, transport)
  let sync = SyncScheduler::new(workspace, station, events, transport)
  let auth = match conn_seq {
    Some(c) => AuthGenTracker::new(conn_seq=c)
    None => AuthGenTracker::open_with_db(db)
  }
  auth.ensure_workspace(workspace)
  let membership = MembershipAuthority::new()
  membership.load_from_db(db)
  if workspace.length() > 0 && workspace != "ws-default" && station.length() > 0 {
    let _ = membership.bind_station(workspace, station)
  }
  let router = protocol::Slice1Router::new(db, md_store, workspace=workspace)
  let core = ClientCore::{
    workspace: workspace,
    station: station,
    rt: rt,
    db: db,
    md_store: md_store,
    outbox: frame_outbox,
    events: events,
    local_outbox: local_outbox,
    sync: sync,
    auth: auth,
    membership: membership,
    doing: DoingTracker::new(),
    composers: ComposerManager::new(db),
    extra_events: Map::new(),
    extra_sync: Map::new(),
    extra_locks: Map::new(),
    marks_wanted: Map::new(),
    live: false,
    router: router,
    rows_memo: views::RowsMemo::new(),
    viewer_marks: views::ViewerMarks::new(""),
    pending_dirty_rows: [],
    wire_sink: None,
    pending_wire_events: [],
    lock_digest_by_ws: Map::new(),
    lock_sec_digest_by_ws: Map::new(),
    on_runtime_boundary: None,
    on_credential_refresh: None,
    on_workspace_refresh: None,
    on_workspace_dropped: None,
    on_accounts_persisted: None,
    on_session_invalidated: None,
    lock_pending: views::LockPendingQueue::new(),
    auth_store: views::AccountStore::new(),
    account_sessions: Map::new(),
    login_flow: views::LoginFlowMachine::new(),
    vault_approvals: views::VaultApprovalQueue::new(),
    file_reads: views::SharedFileReads::new(),
    cloud_origin: "https://app.still.fail",
    presets_held: [],
    other_presets_held: [],
    stars_held: [],
    board_drafts_held: [],
    downloads_held: [],
    status_waits: [],
    status_downs: [],
    status_db_notes: [],
    notices_held: [],
    lock_pairing_prompts: [],
    vault_key_asks: [],
    notify_on: true,
    notify_asked: false,
    notify_push: true,
    notify_preview: true,
    notify_permission: "unknown",
    notify_in_front: false,
    notify_muted: [],
    notify_kinds: default_notify_kinds(),
    lang: "zh",
    device_app: "desktop",
    device_locale: "",
    device_build: "",
    device_phone: false,
    utc_offset_min: 0,
    db_account_sub: None,
    account_epoch: 1L,
    chat_windows: Map::new(),
    chat_places: Map::new(),
    chat_place_order: [],
    chat_sub_snapshots: Map::new(),
    chat_row_dest_ws: Map::new(),
    on_prefs_saved: None,
    auth_seq: 0,
    lock_state: None,
    lock_root: None,
    lock_kept_entries: [],
    lock_kept_aside: [],
    person_lock_entries: [],
    lock_seen: None,
    lock_corrupt: false,
    lock_read_pending: false,
    lock_effective: None,
    viewer_sub: "",
    viewer_role: "member",
    device_id: "",
    device_kind: "app",
    device_sign_key: None,
    lock_available: true,
    vaults_set_up: false,
  }
  router.set_topic_evaluator(fn(id : Int64, topic : protocol::Topic) -> Option[protocol::CoreEvent] {
    core.evaluate_view_topic(id, topic)
  })
  auth.set_station_ws_resolver(fn(st : String) -> String {
    core.membership.station_workspace(st, fallback_ws=core.workspace)
  })
  auth.set_default_workspace_resolver(fn() -> String {
    core.workspace
  })
  let _ = auth.on_boundary(fn(ev : AuthBoundaryEvent) -> Unit {
    core.handle_auth_boundary(ev)
  })
  core.outbox.set_meta_fn(fn(ev : CoreEvent) -> outbox::OutboxMeta {
    let (exp_ws, st) = core_event_scope(ev)
    let ws = if exp_ws.length() > 0 {
      exp_ws
    } else if st.length() > 0 {
      core.membership.station_workspace(st, fallback_ws=core.workspace)
    } else {
      ""
    }
    let pgen = if ws.length() > 0 { core.membership.workspace_purge_gen_of(ws) } else { 0L }
    outbox::OutboxMeta::{ ws: ws, station: st, purge_gen: pgen }
  })
  core.wire_station_hooks(station, events, sync)
  core.restore_lock_state()
  core.restore_notify_state()
  core
}

fn core_offline_transport() -> StationTransport {
  StationTransport::{
    request_k: fn(
      _m : String,
      _p : String,
      _h : Array[(String, String)],
      _b : Bytes,
      k : (effect::Exit[HttpReply]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Failed(effect::EffectError::Custom("offline")))
    },
    stream_k: fn(
      _p : String,
      _h : Array[(String, String)],
      _on_chunk : (Bytes) -> Unit,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Failed(effect::EffectError::Custom("offline")))
    },
  }
}

fn ClientCore::wire_station_hooks(
  self : ClientCore,
  station : String,
  events : StationEvents,
  sync : SyncScheduler,
) -> Unit {
  let rt = self.rt
  let local_outbox = self.local_outbox
  let target_ws = events.workspace
  self.auth.ensure_workspace(target_ws)
  events.set_auth_tracker(self.auth)
  sync.set_auth_tracker(self.auth)
  events.set_hooks(
    fn(b : sql::Burst, th : Int, n : Int, ck : String) -> Unit {
      local_outbox.reconcile_entry_in_burst(b, th, n, ck, station=Some(station))
    },
    fn(b : sql::Burst, cid : String, ck : String) -> Unit {
      local_outbox.reconcile_pending_chat_in_burst(b, cid, ck, station=Some(station))
    },
    fn() -> Unit {
      local_outbox.set_online(true)
      let _ = rt.fork_quiet_named("initial-snapshot:" + station, fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
        sync.fetch_snapshot_k(effect::priority_shown(), fn(_ex : effect::Exit[Int]) -> Unit {
          k(effect::Exit::Succeeded(()))
        })
      })
      sync.schedule_lock_refresh(rt)
      local_outbox.flush_station_offline(rt, station)
    },
    fn(lock_payload : base_codec::Json) -> Unit {
      let _ = self.handle_lock_event_for_workspace(target_ws, lock_payload, sync_opt=Some(sync), station=station)
    },
  )
  events.set_lock_apply_hook(fn(lock_payload : base_codec::Json) -> Result[Unit, String] {
    self.handle_lock_event_for_workspace(target_ws, lock_payload, sync_opt=Some(sync), station=station)
  })
  events.set_missed_hook(fn() -> Unit {
    let _ = rt.fork_quiet_named("missed-snapshot:" + station, fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
      sync.fetch_snapshot_k(effect::priority_shown(), fn(_ex : effect::Exit[Int]) -> Unit {
        k(effect::Exit::Succeeded(()))
      })
    })
    self.schedule_marks_read(station, sync, [], [], true)
    sync.schedule_lock_refresh(rt)
  })
  events.set_marks_applied_hook(fn(
    payload : base_codec::Json,
    is_whole : Bool,
    affected : Array[String],
    scoped_sessions : Array[String],
    scoped_threads : Array[Int],
  ) -> Unit {
    self.sync_viewer_marks_from_payload(station, payload, is_whole, affected, scoped_sessions, scoped_threads)
  })
  events.set_marks_dirty_hook(fn(ev_name : String, payload : base_codec::Json) -> Unit {
    let scoped_sessions : Array[String] = []
    let scoped_threads : Array[Int] = []
    if ev_name == "chat-mark" {
      match (j_opt_u64(payload, "thread"), j_opt_u64(payload, "read")) {
        (Some(th), Some(r)) => self.viewer_marks.set_read(station, th.to_int(), r.to_int())
        _ => ()
      }
      match j_opt_str(payload, "session") {
        Some(sess) => {
          if base_codec::json_get(payload, "pinned").is_some() {
            self.viewer_marks.set_pin(station, sess, j_opt_int64(payload, "pinned"))
          }
        }
        None => ()
      }
      match (j_opt_u64(payload, "thread"), j_opt_bool(payload, "quoted")) {
        (Some(th), Some(q)) => self.viewer_marks.set_quoted(station, th.to_int(), q)
        _ => ()
      }
    }
    match j_opt_str(payload, "session") {
      Some(sess) => {
        if sess.length() > 0 {
          scoped_sessions.push(sess)
          self.mark_row_dirty(station, sess)
        }
      }
      None => ()
    }
    match j_opt_u64(payload, "thread") {
      Some(th) => {
        let tid = th.to_int()
        scoped_threads.push(tid)
        self.mark_thread_rows_dirty(station, tid)
      }
      None => ()
    }
    let want_whole = scoped_sessions.length() == 0 && scoped_threads.length() == 0
    self.schedule_marks_read(station, sync, scoped_sessions, scoped_threads, want_whole)
  })
  events.set_thread_dirty_hook(fn(th : Int) -> Unit {
    let _ = rt.fork_quiet_named("dirty-thread:" + station + ":" + th.to_string(), fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
      sync.fetch_thread_k(th, effect::priority_shown(), false, fn(_ex : effect::Exit[Int]) -> Unit {
        k(effect::Exit::Succeeded(()))
      })
    })
  })
  sync.set_cred_epoch_getter(fn() -> Int64 {
    self.membership.cred_epoch_of(target_ws)
  })
}

fn push_unique_str_cc(xs : Array[String], v : String) -> Unit {
  if v.length() == 0 {
    return
  }
  for i in 0..<xs.length() {
    if xs[i] == v {
      return
    }
  }
  xs.push(v)
}

fn push_unique_int_cc(xs : Array[Int], v : Int) -> Unit {
  for i in 0..<xs.length() {
    if xs[i] == v {
      return
    }
  }
  xs.push(v)
}

fn str_arrays_equal_cc(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

/// Coalesce concurrent `marksDirty` / `missed` requests per station into a single in-flight
/// `GET /chats?marks=1&own=1` (`client/core-ts/src/station/sync.ts #marksRead`).
fn ClientCore::schedule_marks_read(
  self : ClientCore,
  station : String,
  sync : SyncScheduler,
  sessions : Array[String],
  threads : Array[Int],
  whole : Bool,
) -> Unit {
  let mw = match self.marks_wanted.get(station) {
    Some(existing) => existing
    None => {
      let created = MarksWanted::{ in_flight: false, whole: false, sessions: [], threads: [] }
      self.marks_wanted.set(station, created)
      created
    }
  }
  if whole {
    mw.whole = true
  }
  for i in 0..<sessions.length() {
    push_unique_str_cc(mw.sessions, sessions[i])
  }
  for i in 0..<threads.length() {
    push_unique_int_cc(mw.threads, threads[i])
  }
  if mw.in_flight {
    return
  }
  mw.in_flight = true
  self.drain_marks_wanted(station, sync, mw)
}

fn ClientCore::drain_marks_wanted(
  self : ClientCore,
  station : String,
  sync : SyncScheduler,
  mw : MarksWanted,
) -> Unit {
  let _ = self.rt.fork_quiet_named("marks-reread:" + station, fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    let want_whole = mw.whole
    let batch_sessions : Array[String] = []
    let batch_threads : Array[Int] = []
    if !want_whole {
      for i in 0..<mw.sessions.length() {
        batch_sessions.push(mw.sessions[i])
      }
      for i in 0..<mw.threads.length() {
        batch_threads.push(mw.threads[i])
      }
    }
    mw.whole = false
    mw.sessions.clear()
    mw.threads.clear()
    if !want_whole && batch_sessions.length() == 0 && batch_threads.length() == 0 {
      mw.in_flight = false
      k(effect::Exit::Succeeded(()))
      return
    }
    sync.fetch_marks_k(
      effect::priority_shown(),
      fn(_ex : effect::Exit[Array[String]]) -> Unit {
        if mw.whole || mw.sessions.length() > 0 || mw.threads.length() > 0 {
          self.drain_marks_wanted(station, sync, mw)
        } else {
          mw.in_flight = false
        }
        k(effect::Exit::Succeeded(()))
      },
      sessions=batch_sessions,
      threads=batch_threads,
    )
  })
}

fn ClientCore::mark_row_dirty(self : ClientCore, station : String, chat_id : String) -> Unit {
  if chat_id.length() == 0 {
    return
  }
  for i in 0..<self.pending_dirty_rows.length() {
    if self.pending_dirty_rows[i].0 == station && self.pending_dirty_rows[i].1 == chat_id {
      return
    }
  }
  self.pending_dirty_rows.push((station, chat_id))
}

fn ClientCore::mark_thread_rows_dirty(self : ClientCore, station : String, thread : Int) -> Unit {
  match self.db.all("SELECT id FROM chat WHERE station = ? AND thread = ?", params=[
    base_codec::json_str(station),
    base_codec::json_int(thread),
  ]) {
    sql::SqlResult::Ok(rows) => {
      for i in 0..<rows.length() {
        self.mark_row_dirty(station, sql::col_text(rows[i], 0))
      }
    }
    sql::SqlResult::Err(_) => ()
  }
}

fn ClientCore::sync_viewer_marks_from_payload(
  self : ClientCore,
  station : String,
  payload : base_codec::Json,
  is_whole : Bool,
  affected : Array[String],
  scoped_sessions : Array[String],
  scoped_threads : Array[Int],
) -> Unit {
  let prefix = station + ":"
  if is_whole {
    let clear_prefix = fn(m : Map[String, Bool]) -> Unit {
      let ks = m.keys()
      for i in 0..<ks.length() {
        if ks[i].starts_with(prefix) {
          m.remove(ks[i])
        }
      }
    }
    let rks = self.viewer_marks.reads.keys()
    for i in 0..<rks.length() {
      if rks[i].starts_with(prefix) {
        self.viewer_marks.reads.remove(rks[i])
      }
    }
    let pks = self.viewer_marks.pins.keys()
    for i in 0..<pks.length() {
      if pks[i].starts_with(prefix) {
        self.viewer_marks.pins.remove(pks[i])
      }
    }
    clear_prefix(self.viewer_marks.kept)
    clear_prefix(self.viewer_marks.hidden)
    clear_prefix(self.viewer_marks.muted)
    clear_prefix(self.viewer_marks.dismissed)
  } else {
    for ti in 0..<scoped_threads.length() {
      let tid = scoped_threads[ti]
      let tk = prefix + tid.to_string()
      self.viewer_marks.reads.remove(tk)
      self.viewer_marks.kept.remove(tk)
      self.viewer_marks.hidden.remove(tk)
      self.viewer_marks.muted.remove(tk)
      let dpref = tk + ":"
      let dks = self.viewer_marks.dismissed.keys()
      for di in 0..<dks.length() {
        if dks[di].starts_with(dpref) {
          self.viewer_marks.dismissed.remove(dks[di])
        }
      }
      self.mark_thread_rows_dirty(station, tid)
    }
    for si in 0..<scoped_sessions.length() {
      let sess = scoped_sessions[si]
      if sess.length() > 0 {
        self.viewer_marks.pins.remove(prefix + sess)
        self.mark_row_dirty(station, sess)
      }
    }
  }
  match base_codec::json_get(payload, "reads") {
    Some(base_codec::Json::Obj(fs)) => {
      for i in 0..<fs.length() {
        let (th_s, val_j) = fs[i]
        match (base_codec::parse_int64_str(th_s), val_j) {
          (Some(th_i64), base_codec::Json::Num(n, _)) => {
            let tid = th_i64.to_int()
            self.viewer_marks.set_read(station, tid, n.to_int())
            self.mark_thread_rows_dirty(station, tid)
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  match base_codec::json_get(payload, "pins") {
    Some(base_codec::Json::Obj(fs)) => {
      for i in 0..<fs.length() {
        let (sess, val_j) = fs[i]
        match val_j {
          base_codec::Json::Num(n, repr) => {
            let at_v = if repr.length() > 0 && !repr.contains(".") {
              match base_codec::parse_int64_str(repr) {
                Some(v) => v
                None => n.to_int64()
              }
            } else {
              n.to_int64()
            }
            self.viewer_marks.set_pin(station, sess, Some(at_v))
            self.mark_row_dirty(station, sess)
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  match base_codec::json_get(payload, "kept") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match xs[i] {
          base_codec::Json::Num(n, _) => {
            let tid = n.to_int()
            self.viewer_marks.kept.set(prefix + tid.to_string(), true)
            self.mark_thread_rows_dirty(station, tid)
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  match base_codec::json_get(payload, "hidden") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match xs[i] {
          base_codec::Json::Num(n, _) => {
            let tid = n.to_int()
            self.viewer_marks.hidden.set(prefix + tid.to_string(), true)
            self.mark_thread_rows_dirty(station, tid)
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  match base_codec::json_get(payload, "muted") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match xs[i] {
          base_codec::Json::Num(n, _) => {
            let tid = n.to_int()
            self.viewer_marks.muted.set(prefix + tid.to_string(), true)
            self.mark_thread_rows_dirty(station, tid)
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  match base_codec::json_get(payload, "dismissed") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match xs[i] {
          base_codec::Json::Str(dk) => {
            if dk.length() > 0 {
              self.viewer_marks.dismissed.set(prefix + dk, true)
            }
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  match base_codec::json_get(payload, "selves") {
    Some(base_codec::Json::Arr(xs)) => {
      let next_selves : Array[String] = []
      for i in 0..<xs.length() {
        match xs[i] {
          base_codec::Json::Str(s) => if s.length() > 0 { next_selves.push(s) }
          _ => ()
        }
      }
      if next_selves.length() > 0 && !str_arrays_equal_cc(self.viewer_marks.selves, next_selves) {
        let prev = self.viewer_marks
        self.viewer_marks = views::ViewerMarks::{
          me: prev.me,
          selves: next_selves,
          reads: prev.reads,
          pins: prev.pins,
          kept: prev.kept,
          hidden: prev.hidden,
          muted: prev.muted,
          dismissed: prev.dismissed,
          quoted_threads: prev.quoted_threads,
        }
        self.events.set_viewer_selves(next_selves)
        let eks = self.extra_events.keys()
        for i in 0..<eks.length() {
          match self.extra_events.get(eks[i]) {
            Some(ev) => ev.set_viewer_selves(next_selves)
            None => ()
          }
        }
      }
    }
    _ => ()
  }
  for i in 0..<affected.length() {
    let tag = affected[i]
    if !tag.starts_with("thread:") && !tag.starts_with("dismissed:") {
      self.mark_row_dirty(station, tag)
    }
  }
}

fn ClientCore::resolve_station_workspace(
  self : ClientCore,
  station : String,
  explicit_ws : String = "",
) -> String {
  if explicit_ws.length() > 0 {
    return explicit_ws
  }
  self.membership.station_workspace(station, fallback_ws=self.workspace)
}

/// Attach a station-specific `StationTransport` to `local_outbox`, `StationEvents`, and `SyncScheduler`,
/// binding extra stations to their own workspace (explicit `workspace` -> `MembershipAuthority` ->
/// `self.workspace`), persisting canonical station bindings, enforcing the unified read gate, restarting
/// SSE + sync on the new transport, and automatically flushing any queued backlog targeting that station.
pub fn ClientCore::attach_station_transport(
  self : ClientCore,
  station : String,
  transport : StationTransport,
  workspace : String = "",
) -> Unit {
  let target_ws = self.resolve_station_workspace(station, explicit_ws=workspace)
  if !self.membership.is_workspace_readable(target_ws) {
    return
  }
  match self.membership.bind_station_checked(target_ws, station) {
    Err(_) => return
    Ok(_) => ()
  }
  let _ = self.membership.persist_station_bindings(self.db)
  self.auth.ensure_workspace(target_ws)
  self.local_outbox.register_station_transport(station, transport)
  if station == self.station {
    self.sync.set_transport(transport)
    self.events.set_transport(transport, rt=Some(self.rt))
    if self.live && !self.events.is_running() {
      self.events.start(self.rt)
    }
  } else {
    let mut reuse_existing = false
    match (self.extra_events.get(station), self.extra_sync.get(station)) {
      (Some(ev), Some(sy)) => {
        if ev.workspace == target_ws && sy.workspace == target_ws {
          reuse_existing = true
          sy.set_transport(transport)
          ev.set_transport(transport, rt=Some(self.rt))
          if self.live && !ev.is_running() {
            ev.start(self.rt)
          }
        } else {
          ev.stop()
          ev.reset_state()
          sy.bump_epoch()
        }
      }
      _ => ()
    }
    if !reuse_existing {
      let ev = StationEvents::new(target_ws, station, self.db, self.outbox, transport)
      ev.viewer_email = self.events.viewer_email
      ev.viewer_selves = self.events.viewer_selves
      let sy = SyncScheduler::new(target_ws, station, ev, transport)
      self.wire_station_hooks(station, ev, sy)
      self.extra_events.set(station, ev)
      self.extra_sync.set(station, sy)
      if self.live {
        ev.start(self.rt)
      }
    }
  }
  if self.local_outbox.has_unreached_for_station(station) {
    self.local_outbox.flush_station_offline(self.rt, station)
  }
}

/// Look up the `SyncScheduler` bound to `station` (primary or extra attached station).
pub fn ClientCore::station_sync(self : ClientCore, station : String) -> Option[SyncScheduler] {
  if station == self.station {
    Some(self.sync)
  } else {
    self.extra_sync.get(station)
  }
}

/// Look up the `StationEvents` bound to `station` (primary or extra attached station).
pub fn ClientCore::station_events(self : ClientCore, station : String) -> Option[StationEvents] {
  if station == self.station {
    Some(self.events)
  } else {
    self.extra_events.get(station)
  }
}

/// Detach a station-specific `StationTransport` from `local_outbox`, stop its SSE `/events` stream,
/// and revert it to offline transport (removing extra stations from `extra_events`/`extra_sync`).
pub fn ClientCore::detach_station_transport(self : ClientCore, station : String) -> Unit {
  self.local_outbox.unregister_station_transport(station)
  if station == self.station {
    self.events.stop()
    self.events.reset_state()
    let off = core_offline_transport()
    self.events.set_transport(off)
    self.sync.set_transport(off)
  } else {
    match self.extra_events.get(station) {
      Some(ev) => {
        ev.stop()
        ev.reset_state()
        self.extra_events.remove(station)
      }
      None => ()
    }
    match self.extra_sync.get(station) {
      Some(sy) => {
        sy.bump_epoch()
        self.extra_sync.remove(station)
      }
      None => ()
    }
  }
}

/// Register a station-specific `StationTransport` for multi-station routing.
pub fn ClientCore::register_station_transport(
  self : ClientCore,
  station : String,
  transport : StationTransport,
  workspace : String = "",
) -> Unit {
  self.attach_station_transport(station, transport, workspace=workspace)
}

/// Unregister a station-specific `StationTransport` when a station disconnects.
pub fn ClientCore::unregister_station_transport(self : ClientCore, station : String) -> Unit {
  self.detach_station_transport(station)
}

/// Start live SSE `/events` consumption on the default station and all attached extra stations (never polls).
pub fn ClientCore::start(self : ClientCore) -> Unit {
  self.live = true
  self.events.start(self.rt)
  let ks = self.extra_events.keys()
  for i in 0..<ks.length() {
    match self.extra_events.get(ks[i]) {
      Some(ev) => ev.start(self.rt)
      None => ()
    }
  }
}

/// Stop live SSE `/events` consumption across all stations and mark outbox offline.
pub fn ClientCore::stop(self : ClientCore) -> Unit {
  self.live = false
  self.local_outbox.set_online(false)
  self.sync.bump_epoch()
  self.events.stop()
  let ks = self.extra_events.keys()
  for i in 0..<ks.length() {
    match self.extra_events.get(ks[i]) {
      Some(ev) => ev.stop()
      None => ()
    }
  }
  let sks = self.extra_sync.keys()
  for i in 0..<sks.length() {
    match self.extra_sync.get(sks[i]) {
      Some(sy) => sy.bump_epoch()
      None => ()
    }
  }
}

/// Explicitly set online/offline state (used on network drop / recovery).
pub fn ClientCore::set_online(self : ClientCore, online : Bool) -> Unit {
  self.local_outbox.set_online(online)
  if online {
    self.local_outbox.flush_offline(self.rt)
  }
}

/// Cold-open a chat from local SQLite only: 0 SQL writes, constant statements, 0 network requests.
pub fn ClientCore::cold_open_chat(
  self : ClientCore,
  thread : Int,
  now : Int64,
  rows : Int = 30,
  at : Option[Int] = None,
) -> sql::SqlResult[store::ChatOpenView] {
  store::open_chat(self.md_store, thread, now, rows=rows, at=at)
}

/// Focus a chat (`client.focus`): raises sync priority and preempts any `idle` prefetch.
pub fn ClientCore::focus_chat(
  self : ClientCore,
  thread : Int,
  fetch : Bool = true,
) -> Unit {
  self.sync.focus_thread(Some(thread))
  if fetch {
    let _ = self.rt.fork_quiet_named("focus-thread:" + thread.to_string(), fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
      self.sync.fetch_thread_k(thread, effect::priority_focused(), true, fn(_ex : effect::Exit[Int]) -> Unit {
        k(effect::Exit::Succeeded(()))
      })
    })
  }
}

/// Optimistically send a message (writes local `outbox` immediately, zero network wait).
pub fn ClientCore::send_message(
  self : ClientCore,
  thread : Int,
  client_key : String,
  author : String,
  text : String,
  now : Int64,
) -> sql::SqlResult[Unit] {
  self.local_outbox.send_message(self.rt, thread, client_key, author, text, now)
}

/// Optimistically create a pending chat.
pub fn ClientCore::create_pending_chat(
  self : ClientCore,
  client_key : String,
  title : String,
  now : Int64,
) -> sql::SqlResult[Unit] {
  self.local_outbox.create_pending_chat(self.rt, client_key, title, now)
}

/// Optimistically rename a chat via real `ops.ts` `chat.rename` (`PUT /threads/<t>/title` or `POST /sessions/<s>/title`).
pub fn ClientCore::rename_chat(
  self : ClientCore,
  chat_id : String,
  title : String,
  thread : Option[Int] = None,
) -> sql::SqlResult[Int] {
  let fields : Array[(String, base_codec::Json)] = [
    ("station", base_codec::json_str(self.station)),
    ("session", base_codec::json_str(chat_id)),
    ("title", base_codec::json_str(title)),
  ]
  match thread {
    Some(th) => fields.push(("thread", base_codec::json_int(th)))
    None => ()
  }
  match ops_request("chat.rename", base_codec::json_obj(fields)) {
    OpResult::Ok(req) => self.local_outbox.apply_op(self.rt, req, chat_id, "chat.rename")
    _ => sql::SqlResult::Err(shell::ShellError::{ message: "invalid chat.rename params" })
  }
}

/// Optimistically pin/unpin a chat via real `ops.ts` `chat.pin` (`PUT`/`DELETE /sessions/<s>/pin`).
pub fn ClientCore::pin_chat(self : ClientCore, chat_id : String, pinned_at : Option[Int64]) -> sql::SqlResult[Int] {
  self.viewer_marks.set_pin(self.station, chat_id, pinned_at)
  let params = base_codec::json_obj([
    ("station", base_codec::json_str(self.station)),
    ("session", base_codec::json_str(chat_id)),
    ("pinned", base_codec::json_bool(pinned_at.is_some())),
  ])
  match ops_request("chat.pin", params) {
    OpResult::Ok(req) => self.local_outbox.apply_op(self.rt, req, chat_id, "chat.pin")
    _ => sql::SqlResult::Err(shell::ShellError::{ message: "invalid chat.pin params" })
  }
}

/// Optimistically archive/unarchive a chat via real `ops.ts` `chat.archive` (`POST`/`DELETE /threads/<t>/archive` with `/sessions/<s>/archive` fallback).
pub fn ClientCore::archive_chat(
  self : ClientCore,
  chat_id : String,
  archived : Bool = true,
  thread : Option[Int] = None,
) -> sql::SqlResult[Int] {
  let fields : Array[(String, base_codec::Json)] = [
    ("station", base_codec::json_str(self.station)),
    ("session", base_codec::json_str(chat_id)),
    ("archived", base_codec::json_bool(archived)),
  ]
  match thread {
    Some(th) => fields.push(("thread", base_codec::json_int(th)))
    None => ()
  }
  match ops_request("chat.archive", base_codec::json_obj(fields)) {
    OpResult::Ok(req) => self.local_outbox.apply_op(self.rt, req, chat_id, "chat.archive")
    _ => sql::SqlResult::Err(shell::ShellError::{ message: "invalid chat.archive params" })
  }
}

/// Execute any real `ops.ts` station operation by name, routing strictly to `params.station` (fallback `self.station`).
pub fn ClientCore::perform_op(
  self : ClientCore,
  name : String,
  params : base_codec::Json,
  chat_id : String = "",
) -> Result[Int, String] {
  let enriched = match base_codec::json_get(params, "station") {
    Some(base_codec::Json::Str(s)) => if s.length() > 0 { params } else { j_set_field(params, "station", base_codec::json_str(self.station)) }
    _ => j_set_field(params, "station", base_codec::json_str(self.station))
  }
  match ops_request(name, enriched) {
    OpResult::Unknown => Err("unknown op: " + name)
    OpResult::Invalid(msg) => Err(msg)
    OpResult::Ok(req) => {
      let target_st = match req.target {
        OpTarget::Cloud(acc) => return Err("cloud_op_requires_cloud_transport: " + name + " (account=" + acc + ")")
        OpTarget::Station(s) => if s.length() > 0 { s } else { self.station }
      }
      if req.method == "GET" {
        return Err("read_op_not_mutation: " + name)
      }
      match self.local_outbox.apply_op(self.rt, req, chat_id, name, station=Some(target_st)) {
        sql::SqlResult::Ok(op_id) => Ok(op_id)
        sql::SqlResult::Err(e) => Err(e.to_string())
      }
    }
  }
}

/// Update read cursor locally in SQLite and notify station via `PUT /threads/<thread>/read` `{ n }`.
pub fn ClientCore::mark_chat_read(
  self : ClientCore,
  thread : Int,
  read_seq : Int,
  unread_count : Int = 0,
  station : Option[String] = None,
) -> sql::SqlResult[Unit] {
  let target_st = match station {
    Some(s) => if s.length() > 0 { s } else { self.station }
    None => self.station
  }
  self.viewer_marks.set_read(target_st, thread, read_seq)
  self.local_outbox.mark_read(self.rt, thread, read_seq, unread_count, station=Some(target_st))
}

/// Configure viewer identity & device metadata used by `views::project_*` and `views::project_safe_mode`.
pub fn ClientCore::set_viewer(
  self : ClientCore,
  email : String,
  sub : String = "",
  role : String = "member",
  device_id : String = "",
  device_kind : String = "app",
  device_sign_key : Option[String] = None,
  selves : Option[Array[String]] = None,
) -> Unit {
  // Enforce immutable account/DB binding BEFORE mutating any viewer state!
  if sub.length() > 0 {
    match self.db_account_sub {
      Some(existing) => if existing != sub { return }
      None => ()
    }
  }
  let mut viewer_changed = false
  let next_me = if email.length() > 0 { email } else { self.viewer_marks.me }
  if next_me != self.viewer_marks.me {
    viewer_changed = true
  }
  let next_selves = match selves {
    Some(xs) => {
      let copy : Array[String] = []
      for i in 0..<xs.length() {
        if xs[i].length() > 0 {
          copy.push(xs[i])
        }
      }
      copy
    }
    None => if sub.length() > 0 && self.viewer_marks.selves.length() == 0 { [sub] } else { self.viewer_marks.selves }
  }
  if !str_arrays_equal_cc(self.viewer_marks.selves, next_selves) {
    viewer_changed = true
  }
  if viewer_changed {
    self.events.set_viewer_email(next_me)
    self.events.set_viewer_selves(next_selves)
    let eks = self.extra_events.keys()
    for i in 0..<eks.length() {
      match self.extra_events.get(eks[i]) {
        Some(ev) => {
          ev.set_viewer_email(next_me)
          ev.set_viewer_selves(next_selves)
        }
        None => ()
      }
    }
    let prev = self.viewer_marks
    self.viewer_marks = views::ViewerMarks::{
      me: next_me,
      selves: next_selves,
      reads: prev.reads,
      pins: prev.pins,
      kept: prev.kept,
      hidden: prev.hidden,
      muted: prev.muted,
      dismissed: prev.dismissed,
      quoted_threads: prev.quoted_threads,
    }
    // Full row cache invalidation whenever viewer identity or Slack selves change.
    self.rows_memo = views::RowsMemo::new()
    self.pending_dirty_rows.clear()
  }
  if sub.length() > 0 {
    match self.set_db_account_sub(sub) {
      Err(_) => return
      Ok(_) => { self.viewer_sub = sub }
    }
  }
  if role.length() > 0 {
    self.viewer_role = role
  }
  if device_id.length() > 0 {
    self.device_id = device_id
  }
  if device_kind.length() > 0 {
    self.device_kind = device_kind
  }
  if device_sign_key.is_some() {
    self.device_sign_key = device_sign_key
  }
}

/// Build `views::StationBrief` list for `ws_scope`, bootstrapping from persisted Cloud
/// `workspace.json` (`list_workspace_stations`) and merging live `station(addr, "overview")`
/// fields without leaking `self.station` across workspace boundaries.
/// Enforces the single unified `MembershipAuthority` O(1) read gate.
pub fn ClientCore::station_briefs_for_scope(self : ClientCore, ws_scope : String) -> Array[views::StationBrief] {
  let out : Array[views::StationBrief] = []
  if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
    return out
  }
  if ws_scope.length() > 0 && !self.can_read_workspace(ws_scope) {
    return out
  }
  let prefix = if ws_scope.length() > 0 { ws_scope + "/" } else { "" }
  let is_own_scope = ws_scope.length() == 0 || ws_scope == self.workspace

  // 1. Collect live `station(addr, "overview")` documents strictly matching `ws_scope`.
  let overview_by_addr : Map[String, base_codec::Json] = Map::new()
  let overview_addrs : Array[String] = []
  match store::list_stations(self.db, kind="overview") {
    sql::SqlResult::Ok(rows) => {
      for i in 0..<rows.length() {
        let r = rows[i]
        let matches_scope = if prefix.length() == 0 {
          true
        } else if r.address.starts_with(prefix) {
          true
        } else if is_own_scope && r.address == self.station && !self.station.contains("/") {
          true
        } else {
          false
        }
        if !matches_scope {
          continue
        }
        if !self.can_read_station(r.address) {
          continue
        }
        let doc = match base_codec::json_parse(r.json) {
          base_codec::JsonParseResult::Ok(j) => j
          base_codec::JsonParseResult::Err(_) => base_codec::json_null()
        }
        if overview_by_addr.get(r.address).is_none() {
          overview_addrs.push(r.address)
        }
        overview_by_addr.set(r.address, doc)
      }
    }
    sql::SqlResult::Err(_) => ()
  }

  let seen_addrs : Map[String, Bool] = Map::new()
  let mut has_self = false

  // 2. Bootstrap from Cloud `workspace.json` station roster and overlay any live `overview` fields.
  let cloud_stations = list_workspace_stations(self.db, ws_scope)
  for i in 0..<cloud_stations.length() {
    let cs = cloud_stations[i]
    let addr = canonical_station(ws_scope, cs.id)
    if addr.length() == 0 || !self.can_read_station(addr) {
      continue
    }
    seen_addrs.set(addr, true)
    if addr == self.station {
      has_self = true
    }
    match overview_by_addr.get(addr) {
      Some(doc) => {
        let sid = match j_opt_str(doc, "id") {
          Some(s) => s
          None => cs.id
        }
        let sname = match j_opt_str(doc, "name") {
          Some(s) => s
          None => if cs.name.length() > 0 { cs.name } else { sid }
        }
        let is_online = match base_codec::json_get(doc, "online") {
          Some(base_codec::Json::Bool(b)) => b
          _ => cs.online
        }
        let emoji = match j_opt_str(doc, "emoji") {
          Some(v) => Some(v)
          None => cs.emoji
        }
        let icon = match j_opt_str(doc, "icon") {
          Some(v) => Some(v)
          None => cs.icon
        }
        out.push(views::StationBrief::{
          address: addr,
          id: sid,
          name: sname,
          emoji: emoji,
          icon: icon,
          online: is_online,
          updating: j_bool(doc, "updating"),
          offline_text: j_opt_str(doc, "offlineText"),
          reconnecting_text: j_opt_str(doc, "reconnectingText"),
          running: if addr == self.station { self.running_session_count() } else { 0 },
        })
      }
      None => {
        let sname = if cs.name.length() > 0 { cs.name } else { cs.id }
        out.push(views::StationBrief::{
          address: addr,
          id: cs.id,
          name: sname,
          emoji: cs.emoji,
          icon: cs.icon,
          online: cs.online,
          updating: false,
          offline_text: None,
          reconnecting_text: None,
          running: if addr == self.station { self.running_session_count() } else { 0 },
        })
      }
    }
  }

  // 3. Include any live `overview`-only stations matching `ws_scope`.
  for i in 0..<overview_addrs.length() {
    let addr = overview_addrs[i]
    if seen_addrs.get(addr).is_some() {
      continue
    }
    if addr == self.station {
      has_self = true
    }
    let doc = match overview_by_addr.get(addr) {
      Some(j) => j
      None => base_codec::json_null()
    }
    let sid = match j_opt_str(doc, "id") {
      Some(s) => s
      None => addr
    }
    let sname = match j_opt_str(doc, "name") {
      Some(s) => s
      None => sid
    }
    let is_online = match base_codec::json_get(doc, "online") {
      Some(base_codec::Json::Bool(b)) => b
      _ => true
    }
    out.push(views::StationBrief::{
      address: addr,
      id: sid,
      name: sname,
      emoji: j_opt_str(doc, "emoji"),
      icon: j_opt_str(doc, "icon"),
      online: is_online,
      updating: j_bool(doc, "updating"),
      offline_text: j_opt_str(doc, "offlineText"),
      reconnecting_text: j_opt_str(doc, "reconnectingText"),
      running: if addr == self.station { self.running_session_count() } else { 0 },
    })
  }

  // 4. Fallback to `self.station` ONLY for this workspace's own scope (never inject into another workspace!).
  if is_own_scope && !has_self && self.can_read_station(self.station) {
    let self_in_scope = !self.station.contains("/") || prefix.length() == 0 || self.station.starts_with(prefix)
    if self_in_scope {
      out.push(views::StationBrief::{
        address: self.station,
        id: self.station,
        name: self.station,
        emoji: None,
        icon: None,
        online: true,
        updating: false,
        offline_text: None,
        reconnecting_text: None,
        running: self.running_session_count(),
      })
    }
  }
  out
}

/// Project unified `views::SafeModeView` for this workspace (zero 「个人锁」 leakage).
pub fn ClientCore::current_safe_mode_view(self : ClientCore) -> views::SafeModeView {
  let station_names : Map[String, String] = Map::new()
  let online_stations : Map[String, Bool] = Map::new()
  let briefs = self.station_briefs_for_scope(self.workspace)
  for i in 0..<briefs.length() {
    let b = briefs[i]
    station_names.set(b.id, b.name)
    if b.online {
      online_stations.set(b.id, true)
    }
  }
  let inp = views::SafeModeInput::{
    available: self.lock_available,
    viewer_sub: self.viewer_sub,
    viewer_role: self.viewer_role,
    device_id: self.device_id,
    device_kind: self.device_kind,
    device_sign_key: self.device_sign_key,
    personal_standing: "",
    signer_unsaid: false,
    no_device_answered: false,
    rebound_admins: [],
    station_names: station_names,
    online_stations: online_stations,
    pending: self.lock_pending,
  }
  views::project_safe_mode(self.lock_effective, inp, lock_corrupt=self.lock_corrupt)
}

/// Build current `views::NotifyStateInput` from live `ClientCore` notification preferences.
pub fn ClientCore::current_notify_state(self : ClientCore) -> views::NotifyStateInput {
  let muted_copy : Array[String] = []
  for i in 0..<self.notify_muted.length() {
    muted_copy.push(self.notify_muted[i])
  }
  views::NotifyStateInput::{
    on: self.notify_on,
    asked: self.notify_asked,
    push: self.notify_push,
    kinds: self.notify_kinds,
    preview: self.notify_preview,
    muted: muted_copy,
    permission: self.notify_permission,
    in_front: self.notify_in_front,
  }
}

/// Project `doing` topic items from `self.doing` into `views::DoingItemInput`.
pub fn ClientCore::current_doing_inputs(self : ClientCore) -> Array[views::DoingItemInput] {
  let raw = self.doing.entries_snapshot()
  let out : Array[views::DoingItemInput] = []
  for i in 0..<raw.length() {
    let e = raw[i]
    let stage = match e.failed {
      Some(_) => "failed"
      None => "running"
    }
    out.push(views::DoingItemInput::{
      call: e.call,
      params: e.params,
      since: e.since,
      stage: stage,
      error: e.failed,
      note: None,
    })
  }
  out
}

/// Configure optional host persistence hook invoked after `prefs.set` persists to SQLite.
pub fn ClientCore::set_on_prefs_saved(
  self : ClientCore,
  hook : (base_codec::Json) -> Result[Unit, String],
) -> Unit {
  self.on_prefs_saved = Some(hook)
}

/// Routine workspace switch (A -> B): updates `self.workspace` and swaps the active
/// per-workspace lock slot without altering any attached station's own workspace binding.
pub fn ClientCore::switch_workspace(self : ClientCore, ws : String) -> Unit {
  if ws.length() == 0 {
    return
  }
  self.auth.ensure_workspace(ws)
  if ws == self.workspace {
    return
  }
  if !self.lock_read_pending {
    self.extra_locks.set(self.workspace, WorkspaceLockSlot::{
      lock_state: self.lock_state,
      lock_root: self.lock_root,
      lock_kept_entries: self.lock_kept_entries,
      lock_kept_aside: self.lock_kept_aside,
      lock_seen: self.lock_seen,
      lock_corrupt: self.lock_corrupt,
      lock_effective: self.lock_effective,
    })
  }
  self.workspace = ws
  match self.membership.role_of(ws) {
    Some(r) => { self.viewer_role = r }
    None => if self.db_account_sub.is_some() { self.viewer_role = "member" }
  }
  match self.extra_locks.get(ws) {
    Some(slot) => {
      self.extra_locks.remove(ws)
      self.lock_state = slot.lock_state
      self.lock_root = slot.lock_root
      self.lock_kept_entries = slot.lock_kept_entries
      self.lock_kept_aside = slot.lock_kept_aside
      self.lock_seen = slot.lock_seen
      self.lock_corrupt = slot.lock_corrupt
      self.lock_read_pending = false
      self.lock_effective = slot.lock_effective
    }
    None => {
      self.lock_state = None
      self.lock_root = None
      self.lock_kept_entries = []
      self.lock_kept_aside = []
      self.lock_seen = None
      self.lock_corrupt = false
      self.lock_read_pending = false
      self.lock_effective = None
      self.restore_lock_state()
    }
  }
}

/// Immutably bind the primary account `sub` whose SQLite database is currently open in `self.db`,
/// binding `MembershipAuthority` to that account's isolated purge scope.
/// Once bound, attempting to bind a different `sub` returns `Err("account_sub_mismatch")` with 0 side effects!
pub fn ClientCore::set_db_account_sub(
  self : ClientCore,
  sub : String,
  host_purges_doc : Option[base_codec::Json] = None,
  host_purges_shared : Bool = false,
  host_purges_read : Option[HostStorageRead] = None,
) -> Result[Unit, String] {
  if sub.length() == 0 {
    return Err("account_sub_mismatch: empty account sub")
  }
  match self.db_account_sub {
    Some(existing) => if existing != sub {
      return Err("account_sub_mismatch: expected " + existing + ", got " + sub)
    }
    None => ()
  }
  match self.membership.bind_account_sub(
    sub,
    db=Some(self.db),
    host_purges_doc=host_purges_doc,
    host_purges_shared=host_purges_shared,
    host_purges_read=host_purges_read,
  ) {
    Err(msg) => Err(msg)
    Ok(_) => {
      self.db_account_sub = Some(sub)
      Ok(())
    }
  }
}

/// Discard all pending outbound frames and clear EVERY account-scoped in-memory registry
/// (`outbox`, `pending_wire_events`, `downloads_held`, `presets_held`, `notices_held`,
/// `lock_pairing_prompts`, `vault_key_asks`, `rows_memo`, `sub_cache`, `chat_sub_snapshots`,
/// `chat_row_dest_ws`, `doing`, `md_store`, etc.) and advance `account_epoch`.
pub fn ClientCore::clear_account_scoped_runtime_state(self : ClientCore) -> Unit {
  self.account_epoch += 1L
  self.outbox.clear()
  self.pending_wire_events.clear()
  self.rows_memo = views::RowsMemo::new()
  self.pending_dirty_rows.clear()
  self.viewer_marks = views::ViewerMarks::new("")
  self.chat_windows.clear()
  self.chat_places.clear()
  self.chat_place_order.clear()
  self.chat_sub_snapshots.clear()
  self.chat_row_dest_ws.clear()
  self.marks_wanted.clear()
  self.extra_locks.clear()
  self.lock_digest_by_ws.clear()
  self.lock_sec_digest_by_ws.clear()
  self.lock_state = None
  self.lock_root = None
  self.lock_kept_entries = []
  self.lock_kept_aside = []
  self.person_lock_entries = []
  self.lock_seen = None
  self.lock_corrupt = false
  self.lock_read_pending = false
  self.lock_effective = None
  self.downloads_held.clear()
  self.presets_held.clear()
  self.other_presets_held.clear()
  self.stars_held.clear()
  self.board_drafts_held.clear()
  self.status_waits.clear()
  self.status_downs.clear()
  self.status_db_notes.clear()
  self.notices_held.clear()
  self.notify_on = true
  self.notify_asked = false
  self.notify_push = true
  self.notify_preview = true
  self.notify_muted.clear()
  self.notify_kinds = default_notify_kinds()
  self.lock_pairing_prompts.clear()
  self.vault_key_asks.clear()
  self.lock_pending.items.clear()
  self.vault_approvals.requests.clear()
  self.file_reads.kept.clear()
  self.file_reads.in_flight.clear()
  self.file_reads.dispatched.clear()
  self.doing.clear()
  self.md_store.clear()
  self.router.invalidate_kept_where(fn(_ : protocol::Topic) -> Bool { true })
  self.router.invalidate_sub_cache_where(fn(_ : protocol::Topic) -> Bool { true })
}

pub fn ClientCore::viewer_role(self : ClientCore) -> String {
  self.viewer_role
}

/// Rebind the default `(station, workspace)` across `ClientCore` and ALL station/workspace consumers
/// (`self.station`, `self.workspace`, `self.md_store`, `self.local_outbox`, `self.router`, `self.events`,
/// `self.sync`, and `wire_station_hooks`), AND hydrate the target workspace's lock root & viewer role
/// when `new_ws` changes so verified logins NEVER skip `restore_lock_state()`!
pub fn ClientCore::rebind_default_station(
  self : ClientCore,
  new_station : String,
  new_ws : String,
) -> Unit {
  let off = core_offline_transport()
  self.events.stop()
  self.events.reset_state()
  self.events.set_transport(off)
  self.sync.bump_epoch()
  self.sync.set_transport(off)
  let prev_ws = self.workspace
  let eff_ws = if new_ws.length() > 0 { new_ws } else { "ws-default" }
  let eff_st = if new_station.length() > 0 { new_station } else { "st-local" }
  let prev_email = self.events.viewer_email
  let prev_selves = self.events.viewer_selves
  self.workspace = eff_ws
  self.station = eff_st
  self.md_store.set_station(eff_st)
  self.local_outbox.set_station(eff_st)
  self.router.workspace = eff_ws
  let next_events = StationEvents::new(eff_ws, eff_st, self.db, self.outbox, off)
  if !self.membership.is_unauthenticated() && prev_email.length() > 0 {
    next_events.set_viewer_email(prev_email)
    next_events.set_viewer_selves(prev_selves)
  }
  let next_sync = SyncScheduler::new(eff_ws, eff_st, next_events, off)
  self.events = next_events
  self.sync = next_sync
  self.wire_station_hooks(eff_st, next_events, next_sync)
  self.auth.ensure_workspace(eff_ws)
  if eff_ws != prev_ws {
    self.lock_state = None
    self.lock_root = None
    self.lock_kept_entries = []
    self.lock_kept_aside = []
    self.lock_seen = None
    self.lock_corrupt = false
    self.lock_read_pending = false
    self.lock_effective = None
    if !self.membership.is_unauthenticated() {
      self.viewer_role = match self.membership.role_of(eff_ws) {
        Some(r) => if is_valid_workspace_role(r) { r } else { "member" }
        None => "member"
      }
      self.restore_lock_state()
    }
  }
}

/// Atomically switch ALL DB holders (`self.db`, `md_store`, `router`, `events`, `local_outbox`,
/// `composers`, `membership`) from unauthenticated startup (`:memory:`) to `sub`'s dedicated SQLite DB.
/// Refuses switching if already bound to a different account (`account_sub_mismatch`).
/// Pass `emit_auth_boundary=false` when the host needs to install `sess.db`, `sess.cloud`, `auth_store`,
/// and `viewer` before firing `auth.bump_all()` as the final step!
pub fn ClientCore::switch_account_db(
  self : ClientCore,
  new_db : sql::Sql,
  sub : String,
  host_purges_doc : Option[base_codec::Json] = None,
  host_purges_shared : Bool = false,
  host_purges_read : Option[HostStorageRead] = None,
  emit_auth_boundary : Bool = true,
  target_workspace : Option[String] = None,
  target_station : Option[String] = None,
) -> Result[Unit, String] {
  if sub.length() == 0 {
    return Err("account_sub_mismatch: empty account sub")
  }
  match self.db_account_sub {
    Some(existing) => if existing != sub {
      return Err("account_sub_mismatch: expected " + existing + ", got " + sub)
    }
    None => ()
  }
  // Stop all active station streams and clear extra stations BEFORE swapping DB handles.
  self.events.stop()
  self.events.reset_state()
  let off = core_offline_transport()
  self.events.set_transport(off)
  self.sync.bump_epoch()
  self.sync.set_transport(off)
  let eks = self.extra_events.keys()
  for i in 0..<eks.length() {
    match self.extra_events.get(eks[i]) {
      Some(ev) => {
        ev.stop()
        ev.reset_state()
      }
      None => ()
    }
    match self.extra_sync.get(eks[i]) {
      Some(sy) => {
        sy.bump_epoch()
        sy.set_transport(core_offline_transport())
      }
      None => ()
    }
  }
  self.extra_events.clear()
  self.extra_sync.clear()

  // Atomically switch every DB holder to `new_db`.
  self.db = new_db
  self.md_store.switch_db(new_db)
  self.router.switch_db(new_db)
  self.events.switch_db(new_db)
  self.local_outbox.switch_db(new_db)
  self.composers.switch_db(new_db)

  // Clear ALL outbound queues (including any `Disconnected` frame from `events.switch_db`)
  // and every account-scoped in-memory registry AFTER swapping DB handles.
  self.clear_account_scoped_runtime_state()

  // Hydrate `MembershipAuthority` from `new_db` + per-account host pending purges, then retry pending purges.
  self.db_account_sub = None
  self.membership.reset_for_db_switch()
  match self.set_db_account_sub(
    sub,
    host_purges_doc=host_purges_doc,
    host_purges_shared=host_purges_shared,
    host_purges_read=host_purges_read,
  ) {
    Err(msg) => return Err(msg)
    Ok(_) => ()
  }
  let _ = self.retry_pending_purges(emit_boundary=emit_auth_boundary)
  let next_ws = match target_workspace {
    Some(w) => if w.length() > 0 { w } else { "ws-default" }
    None => self.workspace
  }
  let next_st = match target_station {
    Some(s) => if s.length() > 0 { s } else { "st-local" }
    None => self.station
  }
  self.rebind_default_station(next_st, next_ws)
  self.outbox.clear()
  self.restore_lock_state()
  self.restore_notify_state()
  self.viewer_role = match self.membership.role_of(self.workspace) {
    Some(r) => if is_valid_workspace_role(r) { r } else { "member" }
    None => "member"
  }
  if emit_auth_boundary {
    let _ = self.auth.bump_all()
  }
  Ok(())
}

/// Atomically transition ALL DB holders back to a clean unauthenticated `:memory:` DB
/// (e.g. when the last signed-in account is permanently removed on 401 refresh failure).
/// Clears `db_account_sub`, stops all station streams, rebinds default station/workspace to
/// `("st-local", "ws-default")`, discards all outbound frames and account-scoped registries,
/// and leaves the runtime ready for a fresh same-process sign-in!
pub fn ClientCore::switch_to_unauthenticated_db(self : ClientCore, new_mem_db : sql::Sql) -> Unit {
  self.events.stop()
  self.events.reset_state()
  let off = core_offline_transport()
  self.events.set_transport(off)
  self.sync.bump_epoch()
  self.sync.set_transport(off)
  let eks = self.extra_events.keys()
  for i in 0..<eks.length() {
    match self.extra_events.get(eks[i]) {
      Some(ev) => {
        ev.stop()
        ev.reset_state()
      }
      None => ()
    }
    match self.extra_sync.get(eks[i]) {
      Some(sy) => {
        sy.bump_epoch()
        sy.set_transport(core_offline_transport())
      }
      None => ()
    }
  }
  self.extra_events.clear()
  self.extra_sync.clear()

  self.db = new_mem_db
  self.md_store.switch_db(new_mem_db)
  self.router.switch_db(new_mem_db)
  self.events.switch_db(new_mem_db)
  self.local_outbox.switch_db(new_mem_db)
  self.composers.switch_db(new_mem_db)

  self.clear_account_scoped_runtime_state()
  self.viewer_sub = ""
  self.viewer_role = "member"

  self.db_account_sub = None
  self.membership.reset_for_db_switch()
  self.membership.set_unauthenticated(true)
  self.rebind_default_station("st-local", "ws-default")
  self.outbox.clear()
  let _ = self.auth.bump_all()
}

// ── Single Authoritative Membership & Lifecycle Coordination (`MembershipAuthority`) ──

pub fn ClientCore::set_on_credential_refresh(self : ClientCore, cb : (String) -> Unit) -> Unit {
  self.on_credential_refresh = Some(cb)
}

pub fn ClientCore::set_on_workspace_refresh(self : ClientCore, cb : (String) -> Unit) -> Unit {
  self.on_workspace_refresh = Some(cb)
}

pub fn ClientCore::set_on_workspace_dropped(
  self : ClientCore,
  cb : (String, Array[String]) -> Unit,
) -> Unit {
  self.on_workspace_dropped = Some(cb)
}

pub fn ClientCore::set_on_accounts_persisted(
  self : ClientCore,
  cb : (base_codec::Json) -> Result[Unit, String],
) -> Unit {
  self.on_accounts_persisted = Some(cb)
}

pub fn ClientCore::set_on_session_invalidated(self : ClientCore, cb : (String) -> Unit) -> Unit {
  self.on_session_invalidated = Some(cb)
}

fn ClientCore::gate_err(self : ClientCore) -> protocol::CoreError {
  if self.membership.is_unauthenticated() {
    protocol::CoreError::{ code: "unauthenticated", message: "account not signed in" }
  } else {
    protocol::CoreError::{ code: "access_revoked", message: "workspace access revoked" }
  }
}

pub fn ClientCore::can_read_workspace(self : ClientCore, ws : String) -> Bool {
  self.membership.is_workspace_readable(ws)
}

pub fn ClientCore::can_read_station(self : ClientCore, st : String) -> Bool {
  self.membership.is_station_readable(st, fallback_ws=self.workspace)
}

fn ClientCore::lookup_session_for_thread(self : ClientCore, station : String, th : Int) -> Option[String] {
  let mut sess_opt : Option[String] = None
  match store::get_chat_by_thread(self.db, station, th) {
    sql::SqlResult::Ok(Some(rec)) => {
      if rec.id.length() > 0 {
        sess_opt = Some(rec.id)
      }
      match base_codec::json_parse(rec.json) {
        base_codec::JsonParseResult::Ok(cj) => match proto_str(cj, "session") {
          Some(sk) => if sk.length() > 0 { sess_opt = Some(sk) }
          None => ()
        }
        base_codec::JsonParseResult::Err(_) => ()
      }
    }
    _ => ()
  }
  sess_opt
}

fn ClientCore::lookup_thread_for_session(self : ClientCore, station : String, sk : String) -> Option[Int] {
  if sk.length() == 0 {
    return None
  }
  let rec_opt = match store::get_chat_by_session(self.db, station, sk) {
    sql::SqlResult::Ok(Some(r)) => Some(r)
    _ => match store::get_chat_by_key(self.db, station, 0, sk) {
      sql::SqlResult::Ok(Some(r)) => Some(r)
      _ => None
    }
  }
  match rec_opt {
    Some(rec) => match base_codec::json_parse(rec.json) {
      base_codec::JsonParseResult::Ok(cj) => proto_int(cj, "thread")
      base_codec::JsonParseResult::Err(_) => None
    }
    None => None
  }
}

/// Resolve moved chat destination via `store::resolve_chat_now` / `resolve_chat_now_by_thread`
/// so callers authorize BOTH input and final resolved station/workspace!
pub fn ClientCore::resolve_moved_chat_target(
  self : ClientCore,
  st : String,
  thread : Option[Int],
  session : Option[String],
) -> (String, Option[Int], Option[String]) {
  let mut cur_st = st
  let mut cur_th = thread
  let mut cur_sess = session
  match session {
    Some(sk) => if sk.length() > 0 {
      match store::resolve_chat_now(self.db, cur_st, sk) {
        sql::SqlResult::Ok(Some(loc)) => {
          cur_st = loc.station
          cur_sess = Some(loc.session)
          match loc.thread {
            Some(mt) => { cur_th = Some(mt) }
            None => ()
          }
        }
        _ => ()
      }
    }
    None => match thread {
      Some(th) => match store::resolve_chat_now_by_thread(self.db, cur_st, th) {
        sql::SqlResult::Ok(Some(loc)) => {
          cur_st = loc.station
          if loc.session.length() > 0 {
            cur_sess = Some(loc.session)
          }
          match loc.thread {
            Some(mt) => { cur_th = Some(mt) }
            None => ()
          }
        }
        _ => ()
      }
      None => ()
    }
  }
  (cur_st, cur_th, cur_sess)
}

/// Unified draft/composer authorization:
/// - `new:<ws>` (or `chat == "new"`): authorizes workspace `<ws>` directly via `can_read_workspace(ws)`
///   (NEVER treats `<ws>` as a bare station falling back to `self.workspace`!).
/// - `<station>:<chat>`: resolves moved chat target and authorizes BOTH input AND final resolved station!
pub fn ClientCore::can_read_draft_target(
  self : ClientCore,
  key_opt : Option[String],
  raw_st : String,
  chat : String,
) -> Bool {
  if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
    return false
  }
  match key_opt {
    Some(k) => {
      if k.starts_with("new:") {
        let ws = k.slice(4, k.length())
        return ws.length() > 0 && self.can_read_workspace(ws)
      }
      match draft_at_key(k) {
        Some((st, ch)) => {
          if ch == "new" {
            return st.length() > 0 && self.can_read_workspace(st)
          }
          if !self.can_read_station(st) {
            return false
          }
          let (final_st, _, _) = self.resolve_moved_chat_target(st, None, Some(ch))
          if final_st != st && !self.can_read_station(final_st) {
            return false
          }
          let canon = self.membership.canonicalize(st, fallback_ws=self.workspace)
          if canon.length() > 0 && canon != st {
            let (canon_final, _, _) = self.resolve_moved_chat_target(canon, None, Some(ch))
            if canon_final != canon && !self.can_read_station(canon_final) {
              return false
            }
          }
          return true
        }
        None => return false
      }
    }
    None => ()
  }
  if chat == "new" {
    return raw_st.length() > 0 && self.can_read_workspace(raw_st)
  }
  if raw_st.length() == 0 {
    return false
  }
  if !self.can_read_station(raw_st) {
    return false
  }
  if chat.length() > 0 {
    let (final_st, _, _) = self.resolve_moved_chat_target(raw_st, None, Some(chat))
    if final_st != raw_st && !self.can_read_station(final_st) {
      return false
    }
  }
  true
}

/// Validate single-chat selector consistency when BOTH `thread` and `session` are provided,
/// and return the single resolved `(final_station, final_thread, final_session)` target across
/// `moved` redirections so gate checks and view projection use the exact same target.
pub fn ClientCore::resolve_consistent_chat_target(
  self : ClientCore,
  st : String,
  thread : Option[Int],
  session : Option[String],
) -> Result[(String, Option[Int], Option[String]), String] {
  match (thread, session) {
    (Some(th), Some(sk)) if sk.length() > 0 => {
      let (st_by_th, th_by_th, sess_by_th) = self.resolve_moved_chat_target(st, Some(th), None)
      let (st_by_sk, th_by_sk, sess_by_sk) = self.resolve_moved_chat_target(st, None, Some(sk))
      if st_by_th != st_by_sk {
        return Err("chat_selector_mismatch: thread and session resolve to different stations")
      }
      let db_th_for_sk = match th_by_sk {
        Some(t) => Some(t)
        None => self.lookup_thread_for_session(st_by_sk, sk)
      }
      let eff_th = match th_by_th {
        Some(t) => t
        None => th
      }
      match db_th_for_sk {
        Some(t2) => if t2 != eff_th {
          return Err("chat_selector_mismatch: thread " + eff_th.to_string() + " disagrees with session " + sk)
        }
        None => ()
      }
      let db_sk_for_th = match sess_by_th {
        Some(s) => Some(s)
        None => self.lookup_session_for_thread(st_by_th, eff_th)
      }
      let eff_sk = match sess_by_sk {
        Some(s) => s
        None => sk
      }
      match db_sk_for_th {
        Some(s2) => if s2.length() > 0 && s2 != eff_sk {
          return Err("chat_selector_mismatch: session " + eff_sk + " disagrees with thread " + eff_th.to_string())
        }
        None => ()
      }
      Ok((st_by_th, Some(eff_th), Some(eff_sk)))
    }
    _ => Ok(self.resolve_moved_chat_target(st, thread, session))
  }
}

fn ClientCore::collect_attached_stations_for_workspace(self : ClientCore, ws : String) -> Array[String] {
  let out : Array[String] = []
  if self.events.workspace == ws && self.station.length() > 0 {
    push_unique_str_cc(out, self.station)
  }
  let eks = self.extra_events.keys()
  for i in 0..<eks.length() {
    let st = eks[i]
    match self.extra_events.get(st) {
      Some(ev) => if ev.workspace == ws { push_unique_str_cc(out, st) }
      None => ()
    }
  }
  out
}

fn ClientCore::collect_stations_to_purge(self : ClientCore, ws : String) -> Array[String] {
  let stations = self.membership.stations_to_purge(ws, db=Some(self.db))
  let attached = self.collect_attached_stations_for_workspace(ws)
  for i in 0..<attached.length() {
    let st = attached[i]
    if st.contains("/") {
      if st.starts_with(ws + "/") {
        push_unique_str_cc(stations, st)
      }
    } else if self.membership.is_bare_station_exclusive_to(ws, st) {
      push_unique_str_cc(stations, st)
    }
    match resolve_station_for_workspace(ws, st) {
      Ok(canon) => if canon.starts_with(ws + "/") { push_unique_str_cc(stations, canon) }
      Err(_) => ()
    }
  }
  stations
}

/// Pure in-memory purge of all caches, transports, outbox, composers, locks, marks, and notices
/// belonging to `ws` / `stations` (zero SQLite or host I/O).
fn ClientCore::purge_workspace_memory(self : ClientCore, ws : String, stations : Array[String]) -> Unit {
  self.md_store.clear()
  self.composers.clear_station(ws)
  if self.events.workspace == ws {
    self.events.stop()
    self.events.reset_state()
    let off = core_offline_transport()
    self.events.set_transport(off)
    self.sync.bump_epoch()
    self.sync.set_transport(off)
  }
  let eks = self.extra_events.keys()
  for i in 0..<eks.length() {
    let st = eks[i]
    let belongs = match self.extra_events.get(st) {
      Some(ev) => ev.workspace == ws
      None => false
    }
    if belongs {
      match self.extra_events.get(st) {
        Some(ev) => {
          ev.stop()
          ev.reset_state()
        }
        None => ()
      }
      self.extra_events.remove(st)
      match self.extra_sync.get(st) {
        Some(sy) => {
          sy.bump_epoch()
          sy.set_transport(core_offline_transport())
        }
        None => ()
      }
      self.extra_sync.remove(st)
    }
  }
  for i in 0..<stations.length() {
    let st = stations[i]
    self.local_outbox.clear_station(st)
    self.composers.clear_station(st)
    self.marks_wanted.remove(st)
    let spref = st + ":"
    let rks = self.viewer_marks.reads.keys()
    for k in 0..<rks.length() { if rks[k].starts_with(spref) { self.viewer_marks.reads.remove(rks[k]) } }
    let pks = self.viewer_marks.pins.keys()
    for k in 0..<pks.length() { if pks[k].starts_with(spref) { self.viewer_marks.pins.remove(pks[k]) } }
    let kks = self.viewer_marks.kept.keys()
    for k in 0..<kks.length() { if kks[k].starts_with(spref) { self.viewer_marks.kept.remove(kks[k]) } }
    let hks = self.viewer_marks.hidden.keys()
    for k in 0..<hks.length() { if hks[k].starts_with(spref) { self.viewer_marks.hidden.remove(hks[k]) } }
    let mks = self.viewer_marks.muted.keys()
    for k in 0..<mks.length() { if mks[k].starts_with(spref) { self.viewer_marks.muted.remove(mks[k]) } }
    let dks = self.viewer_marks.dismissed.keys()
    for k in 0..<dks.length() { if dks[k].starts_with(spref) { self.viewer_marks.dismissed.remove(dks[k]) } }
    let qks = self.viewer_marks.quoted_threads.keys()
    for k in 0..<qks.length() { if qks[k].starts_with(spref) { self.viewer_marks.quoted_threads.remove(qks[k]) } }
    let w_t = st + ":t:"
    let w_s = st + ":s:"
    let cwks = self.chat_windows.keys()
    for k in 0..<cwks.length() {
      if cwks[k].starts_with(w_t) || cwks[k].starts_with(w_s) {
        self.chat_windows.remove(cwks[k])
      }
    }
    let cp_pref = st + "\u{01}"
    let cpks = self.chat_places.keys()
    for k in 0..<cpks.length() {
      if cpks[k].starts_with(cp_pref) {
        self.chat_places.remove(cpks[k])
      }
    }
  }
  self.rows_memo = views::RowsMemo::new()
  self.pending_dirty_rows.clear()
  self.extra_locks.remove(ws)
  self.lock_digest_by_ws.remove(ws)
  self.lock_sec_digest_by_ws.remove(ws)
  if self.workspace == ws {
    self.lock_state = None
    self.lock_root = None
    self.lock_kept_entries = []
    self.lock_kept_aside = []
    self.lock_seen = None
    self.lock_corrupt = false
    self.lock_read_pending = false
    self.lock_effective = None
  }
  let kept_notices : Array[views::NoticeItemInput] = []
  for i in 0..<self.notices_held.length() {
    if self.notices_held[i].workspace != ws {
      kept_notices.push(self.notices_held[i])
    }
  }
  self.notices_held.clear()
  for i in 0..<kept_notices.length() { self.notices_held.push(kept_notices[i]) }
  let kept_prompts : Array[views::LockPairingPromptInput] = []
  for i in 0..<self.lock_pairing_prompts.length() {
    let pr = self.lock_pairing_prompts[i]
    let mut targets_dropped = false
    for j in 0..<pr.workspaces.length() {
      let wj = pr.workspaces[j]
      let wid = match wj {
        base_codec::Json::Str(s) => s
        _ => j_str(wj, "id")
      }
      if wid == ws {
        targets_dropped = true
        break
      }
    }
    if !targets_dropped {
      kept_prompts.push(pr)
    }
  }
  self.lock_pairing_prompts.clear()
  for i in 0..<kept_prompts.length() { self.lock_pairing_prompts.push(kept_prompts[i]) }
  let kept_asks : Array[views::VaultKeyAskInput] = []
  for i in 0..<self.vault_key_asks.length() {
    if self.vault_key_asks[i].workspace != ws {
      kept_asks.push(self.vault_key_asks[i])
    }
  }
  self.vault_key_asks.clear()
  for i in 0..<kept_asks.length() { self.vault_key_asks.push(kept_asks[i]) }
  // Advance purge-only generation counter for `ws` (NEVER bumped by normal lock/role updates!)
  // and immediately evict ALL queued outbound frames belonging to `ws` (including `LockUpdated(ws)` /
  // `LockRejected(ws)` even when `self.workspace != ws`!) so no pre-purge frame can ever survive
  // even across a same-turn revoke + rejoin.
  let _ = self.membership.bump_workspace_purge_gen(ws)
  self.outbox.retain_where_meta(fn(_ev : CoreEvent, meta : outbox::OutboxMeta) -> Bool {
    if meta.ws == ws {
      return false
    }
    if meta.station.length() > 0 {
      for i in 0..<stations.length() {
        if stations[i] == meta.station {
          return false
        }
      }
    }
    true
  })
}

/// Internal synchronous single-tx `drop_workspace` executed ONLY while `in_commit_guard` is held.
/// Zero host I/O! Atomically commits ALL DDL deletes + `revoked` + cleared `pending_purges` +
/// `completed_purge_gen` + `station_bindings` inside ONE `Burst::in_tx` transaction.
/// Pass `emit_boundary=false` during staged DB installation so internal `auth` generations advance
/// silently until the final `auth.bump_all()` publishes the single consistent boundary.
fn ClientCore::drop_workspace_locked(
  self : ClientCore,
  ws : String,
  emit_boundary : Bool = true,
) -> Result[Array[String], String] {
  let stations = self.collect_stations_to_purge(ws)
  let snap = self.membership.snapshot_for_tx()
  let op_gen = self.membership.latch_purge(ws, stations)

  // Always purge in-memory caches (including immediate outbox eviction) & advance cred/auth gens.
  self.purge_workspace_memory(ws, stations)
  let _ = self.membership.bump_cred_epoch(ws)
  self.membership.clear_role(ws)
  let _ = self.auth.bump_workspace_and_vault(ws, emit=emit_boundary)

  let opt_tables = match detect_existing_optional_tables(self.db) {
    sql::SqlResult::Ok(ts) => ts
    sql::SqlResult::Err(e) => {
      let _ = self.membership.persist_pending_purges_sqlite(self.db)
      return Err(e.to_string())
    }
  }
  let plan = drop_workspace_sql_plan(ws, stations, optional_tables=opt_tables)

  // Prepare final post-drop meta state before opening the single atomic SQLite tx.
  self.membership.unbind_workspace_stations(ws)
  let _ = self.membership.complete_purge(ws, op_gen)
  let has_bound_sub = self.membership.effective_sub().length() > 0

  let burst = sql::Burst::new(self.db)
  let tx_res = burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
    match run_drop_plan_in_burst(b, plan) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    if has_bound_sub {
      match self.membership.persist_meta_state_in_burst(b, include_bindings=true) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    } else {
      match self.membership.persist_station_bindings_in_burst(b) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
    sql::SqlResult::Ok(())
  })
  match tx_res {
    sql::SqlResult::Ok(_) => Ok(stations)
    sql::SqlResult::Err(e) => {
      // Roll back bindings & completed_purge_gen while keeping `revoked[ws]` + `pending_purges[ws]` latched!
      self.membership.restore_from_snapshot(snap)
      self.membership.restore_pending_purge(ws, op_gen, stations)
      let _ = self.membership.persist_pending_purges_sqlite(self.db)
      Err(e.to_string())
    }
  }
}

/// Complete non-reentrant single-transaction revocation & purge of workspace `ws`:
/// - Acquires `in_commit_guard` (rejects re-entrancy immediately).
/// - Zero blocking/pumping host I/O inside the critical section.
/// - Commits ALL real TS DDL cleanup + `revoked` + `pending_purges` + `completed_purge_gen` +
///   `station_bindings` in ONE SQLite `Burst::in_tx` transaction.
/// - ONLY AFTER releasing the guard: enqueues non-blocking async host mirror (`device/pending_purges/<sub >`)
///   and fires `on_workspace_dropped`.
pub fn ClientCore::drop_workspace(
  self : ClientCore,
  ws : String,
  emit_boundary : Bool = true,
) -> Result[Unit, String] {
  if ws.length() == 0 {
    return Ok(())
  }
  match self.membership.enter_commit_guard() {
    Err(msg) => return Err(msg)
    Ok(_) => ()
  }
  let stations_hint = self.collect_stations_to_purge(ws)
  let res = self.drop_workspace_locked(ws, emit_boundary=emit_boundary)
  self.membership.leave_commit_guard()
  // Asynchronous host mirror & runtime callbacks run strictly OUTSIDE the commit critical section!
  self.membership.enqueue_host_pending_purges_sync()
  match res {
    Ok(dropped_stations) => {
      match self.on_workspace_dropped {
        Some(cb) => cb(ws, dropped_stations)
        None => ()
      }
      Ok(())
    }
    Err(msg) => {
      match self.on_workspace_dropped {
        Some(cb) => cb(ws, stations_hint)
        None => ()
      }
      Err(msg)
    }
  }
}

/// Retry all persisted `(account_sub, ws)` pending purges on startup or before Cloud sync.
pub fn ClientCore::retry_pending_purges(
  self : ClientCore,
  emit_boundary : Bool = true,
) -> Result[Int, String] {
  let pending = self.membership.pending_purge_workspaces()
  let mut cleared = 0
  let mut first_err : Option[String] = None
  for i in 0..<pending.length() {
    match self.drop_workspace(pending[i], emit_boundary=emit_boundary) {
      Ok(_) => { cleared += 1 }
      Err(msg) => {
        if first_err.is_none() {
          first_err = Some(msg)
        }
      }
    }
  }
  match first_err {
    Some(e) => Err(e)
    None => Ok(cleared)
  }
}

/// Single non-reentrant atomic Cloud `/v1/me` commit point:
/// - Validates non-empty `me.sub` matches immutable `db_account_sub` BEFORE any mutation.
/// - Rejects stale out-of-order responses (`req_seq <= cloud_commit_seq`).
/// - Synthesizes the merged effective `account_doc("me")` JSON preserving newer `/v1/workspaces/<ws>`
///   details/roles (`ws_commit_seq[ws] >= req_seq`) so `account.doc("me")` and `workspace` never disagree.
/// - Executes ALL removed-workspace DDL drops + pending-rejoin DDL purges + merged `account_doc("me")` +
///   `revoked` / `pending_purges` / `completed_purge_gen` / `station_bindings` inside ONE single SQLite
///   `Burst::in_tx` transaction with ZERO blocking host I/O inside the critical section.
/// - Role changes update `ws_roles` + `auth.bump_workspace(ws)` + `cred_epoch` (evicting cached creds &
///   triggering `fresh=true` credential refresh).
pub fn ClientCore::commit_cloud_me(
  self : ClientCore,
  me : CloudMe,
  req_seq : Int64 = 0L,
  now_ms : Int64 = 0L,
) -> Result[Bool, String] {
  if me.sub.length() == 0 {
    return Err("account_sub_mismatch: empty /v1/me sub")
  }
  if self.membership.is_unauthenticated() {
    return Err("unauthenticated")
  }
  if self.membership.is_session_invalidated() {
    return Err("session_invalidated")
  }
  // Pure account-binding validation: NEVER call `set_db_account_sub` or trigger host I/O here!
  match self.db_account_sub {
    None => return Err("account_sub_unbound: db account sub not bound")
    Some(existing) => if existing != me.sub {
      return Err("account_sub_mismatch: expected " + existing + ", got " + me.sub)
    }
  }
  if !self.membership.can_commit_cloud_me(req_seq) {
    return Ok(false)
  }
  match self.membership.enter_commit_guard() {
    Err(msg) => return Err(msg)
    Ok(_) => ()
  }

  let raw_me_ws_ids : Map[String, CloudWorkspaceRef] = Map::new()
  for i in 0..<me.workspaces.length() {
    raw_me_ws_ids.set(me.workspaces[i].id, me.workspaces[i])
  }
  let raw_me_ws_items : Map[String, base_codec::Json] = Map::new()
  match base_codec::json_get(me.raw, "workspaces") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        let wid = j_str(xs[i], "id")
        if wid.length() > 0 {
          raw_me_ws_items.set(wid, xs[i])
        }
      }
    }
    _ => ()
  }

  // Collect all currently existing workspaces (SQLite `workspace` + `pending_purges` + active bindings).
  let existing_ws : Array[String] = []
  let existing_ws_rows : Map[String, base_codec::Json] = Map::new()
  match store::list_workspaces(self.db) {
    sql::SqlResult::Ok(rows) => {
      for i in 0..<rows.length() {
        let r = rows[i]
        push_unique_str_cc(existing_ws, r.id)
        match base_codec::json_parse(r.json) {
          base_codec::JsonParseResult::Ok(j) => existing_ws_rows.set(r.id, j)
          base_codec::JsonParseResult::Err(_) => ()
        }
      }
    }
    sql::SqlResult::Err(_) => ()
  }
  let pend_ws = self.membership.pending_purge_workspaces()
  for i in 0..<pend_ws.length() {
    push_unique_str_cc(existing_ws, pend_ws[i])
  }
  let known_ws = self.membership.known_workspaces()
  for i in 0..<known_ws.length() {
    let wid = known_ws[i]
    if !self.membership.is_revoked(wid) {
      push_unique_str_cc(existing_ws, wid)
    }
  }

  // Classify removed workspaces (`to_drop`) and rejoined workspaces (`rejoin_pending` + `rejoined`).
  let to_drop : Array[(String, Array[String])] = []
  for i in 0..<existing_ws.length() {
    let wid = existing_ws[i]
    if raw_me_ws_ids.get(wid).is_none() && self.membership.should_apply_me_workspace(wid, req_seq) {
      to_drop.push((wid, self.collect_stations_to_purge(wid)))
    }
  }
  let rejoin_pending : Array[(String, Array[String])] = []
  let rejoined : Array[String] = []
  for i in 0..<me.workspaces.length() {
    let wid = me.workspaces[i].id
    if !self.membership.should_apply_me_workspace(wid, req_seq) {
      continue
    }
    let was_pending = self.membership.has_pending_purge(wid)
    let was_revoked = self.membership.is_revoked(wid)
    if was_pending {
      rejoin_pending.push((wid, self.collect_stations_to_purge(wid)))
    }
    if was_pending || was_revoked {
      rejoined.push(wid)
    }
  }

  // Synthesize merged effective `account_doc("me")` BEFORE mutating `workspace` rows so surviving
  // newer detail workspaces (`ws_commit_seq[ws] >= req_seq`) retain their newer role/summary!
  let effective_me_json = build_merged_effective_me_json(self.db, me, self.membership, req_seq)
  let raw_json = base_codec::json_stringify(effective_me_json)
  let eff_now = if now_ms > 0L { now_ms } else { self.rt.now() }

  // Prepare `workspace` table summary upserts for workspaces where `should_apply_me_workspace(wid, req_seq)`
  // so fresh DBs immediately show all workspaces after first `/v1/me` without overwriting newer details.
  let ws_upserts : Array[(String, String)] = []
  for i in 0..<me.workspaces.length() {
    let wid = me.workspaces[i].id
    if !self.membership.should_apply_me_workspace(wid, req_seq) {
      continue
    }
    match raw_me_ws_items.get(wid) {
      Some(me_item) => {
        let existing_opt = if contains_str_ma(rejoined, wid) { None } else { existing_ws_rows.get(wid) }
        let merged_row = merge_me_summary_into_workspace_row(existing_opt, me_item)
        ws_upserts.push((wid, base_codec::json_stringify(merged_row)))
      }
      None => ()
    }
  }

  let need_ddl = to_drop.length() > 0 || rejoin_pending.length() > 0
  let opt_tables = if need_ddl {
    match detect_existing_optional_tables(self.db) {
      sql::SqlResult::Ok(ts) => ts
      sql::SqlResult::Err(e) => {
        // Fail-closed on schema probe error: latch `revoked` + `pending_purges` and purge memory
        // for all removed / rejoin-pending workspaces before returning `Err`!
        let latched_events : Array[(String, Array[String])] = []
        for i in 0..<to_drop.length() {
          let (wid, sts) = to_drop[i]
          let _ = self.membership.latch_purge(wid, sts)
          self.purge_workspace_memory(wid, sts)
          let _ = self.membership.bump_cred_epoch(wid)
          self.membership.clear_role(wid)
          let _ = self.auth.bump_workspace_and_vault(wid)
          latched_events.push((wid, sts))
        }
        for i in 0..<rejoin_pending.length() {
          let (wid, sts) = rejoin_pending[i]
          let _ = self.membership.latch_purge(wid, sts)
          self.purge_workspace_memory(wid, sts)
          let _ = self.membership.bump_cred_epoch(wid)
          self.membership.clear_role(wid)
          let _ = self.auth.bump_workspace_and_vault(wid)
          latched_events.push((wid, sts))
        }
        if latched_events.length() > 0 {
          let _ = self.membership.persist_pending_purges_sqlite(self.db)
        }
        self.membership.leave_commit_guard()
        if latched_events.length() > 0 {
          self.membership.enqueue_host_pending_purges_sync()
          match self.on_workspace_dropped {
            Some(cb) => {
              for i in 0..<latched_events.length() {
                cb(latched_events[i].0, latched_events[i].1)
              }
            }
            None => ()
          }
        }
        return Err(e.to_string())
      }
    }
  } else {
    []
  }

  // Snapshot membership state for atomic rollback on SQLite error.
  let snap = self.membership.snapshot_for_tx()
  let drop_op_gens : Array[(String, Int64, Array[String])] = []
  let drop_plans : Array[Array[(String, Array[base_codec::Json])]] = []
  for i in 0..<to_drop.length() {
    let (wid, sts) = to_drop[i]
    let og = self.membership.latch_purge(wid, sts)
    drop_op_gens.push((wid, og, sts))
    drop_plans.push(drop_workspace_sql_plan(wid, sts, optional_tables=opt_tables))
    self.membership.unbind_workspace_stations(wid)
    let _ = self.membership.complete_purge(wid, og)
  }
  for i in 0..<rejoin_pending.length() {
    let (wid, sts) = rejoin_pending[i]
    let og = self.membership.latch_purge(wid, sts)
    drop_op_gens.push((wid, og, sts))
    drop_plans.push(drop_workspace_sql_plan(wid, sts, optional_tables=opt_tables))
    self.membership.unbind_workspace_stations(wid)
    let _ = self.membership.complete_purge(wid, og)
  }
  for i in 0..<rejoined.length() {
    let _ = self.membership.record_rejoin_completed_gen(rejoined[i])
  }

  let meta_changed = need_ddl || rejoined.length() > 0
  let burst = sql::Burst::new(self.db)
  let tx_res = burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
    for i in 0..<drop_plans.length() {
      match run_drop_plan_in_burst(b, drop_plans[i]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
    for i in 0..<ws_upserts.length() {
      let (wid, wjson) = ws_upserts[i]
      match b.run(sql_workspace_put(), params=[
        base_codec::json_str(wid),
        base_codec::json_str(wjson),
        base_codec::json_int64(eff_now),
      ]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
    match b.run(sql_account_doc_put(), params=[
      base_codec::json_str("me"),
      base_codec::json_str(raw_json),
      base_codec::json_int64(eff_now),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    if meta_changed {
      match self.membership.persist_meta_state_in_burst(b, include_bindings=need_ddl) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
    }
    sql::SqlResult::Ok(())
  })

  match tx_res {
    sql::SqlResult::Err(e) => {
      // Restore snapshot, re-latch failed drops/rejoin purges, purge their memory, and fail closed!
      self.membership.restore_from_snapshot(snap)
      for i in 0..<drop_op_gens.length() {
        let (wid, og, sts) = drop_op_gens[i]
        self.membership.restore_pending_purge(wid, og, sts)
        self.purge_workspace_memory(wid, sts)
        let _ = self.membership.bump_cred_epoch(wid)
        self.membership.clear_role(wid)
        let _ = self.auth.bump_workspace_and_vault(wid)
      }
      if drop_op_gens.length() > 0 {
        let _ = self.membership.persist_pending_purges_sqlite(self.db)
      }
      self.membership.leave_commit_guard()
      if drop_op_gens.length() > 0 {
        self.membership.enqueue_host_pending_purges_sync()
        match self.on_workspace_dropped {
          Some(cb) => {
            for i in 0..<drop_op_gens.length() {
              cb(drop_op_gens[i].0, drop_op_gens[i].2)
            }
          }
          None => ()
        }
      }
      return Err(e.to_string())
    }
    sql::SqlResult::Ok(_) => ()
  }

  // SQLite transaction committed atomically! Now update in-memory caches, cred/auth gens, and roles.
  let dropped_events : Array[(String, Array[String])] = []
  for i in 0..<to_drop.length() {
    let (wid, sts) = to_drop[i]
    self.purge_workspace_memory(wid, sts)
    let _ = self.membership.bump_cred_epoch(wid)
    self.membership.clear_role(wid)
    let _ = self.auth.bump_workspace_and_vault(wid)
    dropped_events.push((wid, sts))
  }
  for i in 0..<rejoin_pending.length() {
    let (wid, sts) = rejoin_pending[i]
    self.purge_workspace_memory(wid, sts)
    self.membership.clear_role(wid)
    dropped_events.push((wid, sts))
  }
  let cred_refresh_ws : Array[String] = []
  for i in 0..<rejoined.length() {
    let wid = rejoined[i]
    let _ = self.membership.bump_cred_epoch(wid)
    let _ = self.auth.bump_workspace_and_vault(wid)
    push_unique_str_cc(cred_refresh_ws, wid)
  }

  // Role updates ONLY for workspaces where `should_apply_me_workspace(wid, req_seq)`:
  // on any role change, update `ws_roles` + bump `auth.bump_workspace(ws)` + bump `cred_epoch`
  // + trigger `fresh=true` credential refresh (no Slice 2B-2 confirmation latch).
  for i in 0..<me.workspaces.length() {
    let wref = me.workspaces[i]
    if !self.membership.should_apply_me_workspace(wref.id, req_seq) {
      continue
    }
    let was_rejoined = contains_str_ma(rejoined, wref.id)
    if !was_rejoined {
      match self.membership.role_of(wref.id) {
        Some(prev_role) => {
          if prev_role != wref.role && is_valid_workspace_role(wref.role) {
            self.membership.set_role(wref.id, wref.role)
            let _ = self.membership.bump_cred_epoch(wref.id)
            let _ = self.auth.bump_workspace(wref.id)
            push_unique_str_cc(cred_refresh_ws, wref.id)
          } else if is_valid_workspace_role(wref.role) {
            self.membership.set_role(wref.id, wref.role)
          }
        }
        None => if is_valid_workspace_role(wref.role) { self.membership.set_role(wref.id, wref.role) }
      }
    } else if is_valid_workspace_role(wref.role) {
      self.membership.set_role(wref.id, wref.role)
    }
  }

  // Advance `cloud_commit_seq` and per-workspace `ws_commit_seq` monotonically (never regressing newer ws commits!).
  self.membership.advance_cloud_me_seq(req_seq)
  for i in 0..<me.workspaces.length() {
    self.membership.advance_workspace_seq(me.workspaces[i].id, req_seq)
  }
  for i in 0..<existing_ws.length() {
    self.membership.advance_workspace_seq(existing_ws[i], req_seq)
  }
  match self.membership.role_of(self.workspace) {
    Some(r) => { self.viewer_role = r }
    None => ()
  }

  self.membership.leave_commit_guard()

  // Post-critical-section async host mirror & runtime callbacks.
  if meta_changed {
    self.membership.enqueue_host_pending_purges_sync()
  }
  match self.on_workspace_dropped {
    Some(cb) => {
      for i in 0..<dropped_events.length() {
        cb(dropped_events[i].0, dropped_events[i].1)
      }
    }
    None => ()
  }
  match self.on_credential_refresh {
    Some(cb) => {
      for i in 0..<cred_refresh_ws.length() {
        cb(cred_refresh_ws[i])
      }
    }
    None => ()
  }
  Ok(true)
}

/// Single non-reentrant atomic Cloud `/v1/workspaces/<id>` commit point:
/// - Rejects stale out-of-order responses (`req_seq <= ws_commit_seq[ws.id]` or `< cloud_commit_seq`).
/// - Refuses writes into revoked or pending-purge workspaces (0 resurrection of stale data).
/// - Validates all station addresses against `ws.id` BEFORE persisting.
/// - Atomically persists `workspace(id)` row + canonical `station_bindings` in ONE SQLite tx.
/// - On role change, updates `ws_roles`, bumps `auth.bump_workspace(ws)` + `cred_epoch`, and
///   triggers `fresh=true` credential refresh.
pub fn ClientCore::commit_cloud_workspace(
  self : ClientCore,
  ws : CloudWorkspace,
  req_seq : Int64 = 0L,
  now_ms : Int64 = 0L,
) -> Result[Bool, String] {
  if self.membership.is_unauthenticated() {
    return Err("unauthenticated")
  }
  if self.membership.is_session_invalidated() {
    return Err("session_invalidated")
  }
  if !self.membership.can_commit_workspace(ws.id, req_seq) {
    return Ok(false)
  }
  // Strictly validate EVERY station address belongs to `ws.id` BEFORE entering guard or writing SQLite!
  for i in 0..<ws.stations.length() {
    match resolve_station_for_workspace(ws.id, ws.stations[i].id) {
      Err(msg) => return Err(msg)
      Ok(_) => ()
    }
  }
  match self.membership.enter_commit_guard() {
    Err(msg) => return Err(msg)
    Ok(_) => ()
  }
  if self.membership.has_pending_purge(ws.id) {
    let drop_res = self.drop_workspace_locked(ws.id)
    self.membership.leave_commit_guard()
    self.membership.enqueue_host_pending_purges_sync()
    match drop_res {
      Err(msg) => return Err(msg)
      Ok(dropped_sts) => {
        match self.on_workspace_dropped {
          Some(cb) => cb(ws.id, dropped_sts)
          None => ()
        }
        return Ok(false)
      }
    }
  }
  if self.membership.is_revoked(ws.id) {
    self.membership.leave_commit_guard()
    return Ok(false)
  }

  // Determine viewer's effective role from `ws.raw.role` or matching member entry BEFORE SQLite tx
  // so `account_doc("me")` is bidirectionally merged in the EXACT same atomic transaction!
  let mut new_role = j_str(ws.raw, "role")
  if new_role.length() == 0 {
    for i in 0..<ws.members.length() {
      let m = ws.members[i]
      let sub_match = self.viewer_sub.length() > 0 && m.sub == self.viewer_sub
      let email_match = self.viewer_marks.me.length() > 0 && m.email == self.viewer_marks.me
      if sub_match || email_match {
        new_role = m.role
        break
      }
    }
  }
  let merged_role_opt : Option[String] = if is_valid_workspace_role(new_role) {
    Some(new_role)
  } else {
    self.membership.role_of(ws.id)
  }
  let merged_me_json_opt : Option[String] = match store::get_account_doc(self.db, "me") {
    sql::SqlResult::Ok(Some(me_raw)) => match base_codec::json_parse(me_raw) {
      base_codec::JsonParseResult::Ok(me_doc) => match merge_workspace_detail_into_me_json(me_doc, ws, merged_role_opt) {
        Some(updated_me) => Some(base_codec::json_stringify(updated_me))
        None => None
      }
      base_codec::JsonParseResult::Err(_) => None
    }
    _ => None
  }

  let snap = self.membership.snapshot_for_tx()
  for i in 0..<ws.stations.length() {
    let _ = self.membership.bind_station_checked(ws.id, ws.stations[i].id)
  }
  let eff_now = if now_ms > 0L { now_ms } else { self.rt.now() }
  let raw_json = base_codec::json_stringify(ws.raw)
  let burst = sql::Burst::new(self.db)
  let tx_res = burst.in_tx(fn(b : sql::Burst) -> sql::SqlResult[Unit] {
    match b.run(sql_workspace_put(), params=[
      base_codec::json_str(ws.id),
      base_codec::json_str(raw_json),
      base_codec::json_int64(eff_now),
    ]) {
      sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
      sql::SqlResult::Ok(_) => ()
    }
    match merged_me_json_opt {
      Some(me_str) => match b.run(sql_account_doc_put(), params=[
        base_codec::json_str("me"),
        base_codec::json_str(me_str),
        base_codec::json_int64(eff_now),
      ]) {
        sql::SqlResult::Err(e) => return sql::SqlResult::Err(e)
        sql::SqlResult::Ok(_) => ()
      }
      None => ()
    }
    self.membership.persist_station_bindings_in_burst(b)
  })
  match tx_res {
    sql::SqlResult::Err(e) => {
      self.membership.restore_from_snapshot(snap)
      self.membership.leave_commit_guard()
      return Err(e.to_string())
    }
    sql::SqlResult::Ok(_) => ()
  }
  self.membership.advance_workspace_seq(ws.id, req_seq)

  let mut role_changed = false
  if is_valid_workspace_role(new_role) {
    match self.membership.role_of(ws.id) {
      Some(prev_role) => {
        if prev_role != new_role {
          self.membership.set_role(ws.id, new_role)
          let _ = self.membership.bump_cred_epoch(ws.id)
          let _ = self.auth.bump_workspace(ws.id)
          role_changed = true
        }
      }
      None => self.membership.set_role(ws.id, new_role)
    }
    if ws.id == self.workspace {
      self.viewer_role = new_role
    }
  }
  self.membership.leave_commit_guard()
  if role_changed {
    match self.on_credential_refresh {
      Some(cb) => cb(ws.id)
      None => ()
    }
  }
  Ok(true)
}

/// Apply rotated OAuth tokens for `sub`, conditioned on `(sub, expected_session, expected_refresh)`
/// so a stale refresh response NEVER overwrites a newer re-login or rotated refresh token!
/// Persists ALL accounts with TS `accounts.ts:50` `"access_expires"` (epoch seconds) and `"session"` IDs.
/// NEVER bumps station `cred_epoch` (Cloud OAuth tokens and station mesh credentials are decoupled!).
pub fn ClientCore::apply_refreshed_tokens(
  self : ClientCore,
  sub : String,
  tokens : RefreshedTokens,
  expected_session : Option[String] = None,
  expected_refresh : Option[String] = None,
) -> Result[String, String] {
  match expected_session {
    Some(es) => if es.length() > 0 {
      let cur_sess = match self.account_sessions.get(sub) { Some(s) => s; None => "" }
      if cur_sess != es {
        return Err("stale_session")
      }
    }
    None => ()
  }
  match expected_refresh {
    Some(er) => if er.length() > 0 {
      let mut found = false
      for i in 0..<self.auth_store.accounts.length() {
        if self.auth_store.accounts[i].sub == sub {
          found = true
          if self.auth_store.accounts[i].refresh != er {
            return Err("stale_refresh")
          }
          break
        }
      }
      if !found {
        return Err("signed_out")
      }
    }
    None => ()
  }
  match self.auth_store.complete_refresh(
    sub,
    tokens.access,
    tokens.refresh,
    tokens.access_expires,
    new_name=tokens.name,
  ) {
    Err(e) => Err(e)
    Ok(access) => {
      let persisted = serialize_stored_accounts(self.auth_store.accounts, sessions=Some(self.account_sessions))
      match self.on_accounts_persisted {
        Some(hook) => match hook(persisted) {
          Err(msg) => return Err(msg)
          Ok(_) => ()
        }
        None => ()
      }
      let _ = store::put_account_doc(
        self.db,
        "accounts",
        base_codec::json_stringify(views::project_accounts_topic(self.auth_store)),
      )
      Ok(access)
    }
  }
}

/// Handle permanent refresh failure (`401` / `invalid_grant` / session expired), strictly conditioned
/// on `(sub, expected_session, expected_refresh)` so a stale 401 from an old session NEVER kicks out
/// a newer re-login or rotated session!
/// Returns `true` if `sub` was actually invalidated, `false` if skipped as stale.
pub fn ClientCore::invalidate_session(
  self : ClientCore,
  sub : String,
  expected_session : Option[String] = None,
  expected_refresh : Option[String] = None,
  persist_accounts : Bool = true,
) -> Bool {
  match expected_session {
    Some(es) => if es.length() > 0 {
      let cur_sess = match self.account_sessions.get(sub) { Some(s) => s; None => "" }
      if cur_sess != es {
        return false
      }
    }
    None => ()
  }
  match expected_refresh {
    Some(er) => if er.length() > 0 {
      let mut matches = false
      for i in 0..<self.auth_store.accounts.length() {
        if self.auth_store.accounts[i].sub == sub {
          if self.auth_store.accounts[i].refresh == er {
            matches = true
          }
          break
        }
      }
      if !matches {
        return false
      }
    }
    None => ()
  }
  let _ = self.auth_store.fail_refresh(sub, 401)
  self.account_sessions.remove(sub)
  let affects_active_db = match self.db_account_sub {
    Some(active) => active == sub
    None => true
  }
  if affects_active_db {
    match self.on_session_invalidated {
      Some(cb) => cb(sub)
      None => ()
    }
    self.membership.mark_session_invalidated()
    if self.auth_store.accounts.length() == 0 {
      self.membership.set_unauthenticated(true)
    }
    self.stop()
    self.events.reset_state()
    let eks = self.extra_events.keys()
    for i in 0..<eks.length() {
      match self.extra_events.get(eks[i]) {
        Some(ev) => ev.reset_state()
        None => ()
      }
    }
    // Always scrub outbound frames and account-scoped registries on active account 401
    // (whether sibling accounts remain or not!).
    self.clear_account_scoped_runtime_state()
    let _ = self.auth.bump_all()
  }
  if persist_accounts {
    let persisted = serialize_stored_accounts(self.auth_store.accounts, sessions=Some(self.account_sessions))
    match self.on_accounts_persisted {
      Some(hook) => { let _ = hook(persisted) }
      None => ()
    }
  }
  let _ = store::put_account_doc(
    self.db,
    "accounts",
    base_codec::json_stringify(views::project_accounts_topic(self.auth_store)),
  )
  true
}

pub fn station_workspace_prefix(addr : String) -> String {
  match addr.index_of("/") {
    idx if idx > 0 => addr.slice(0, idx)
    _ => ""
  }
}

/// Detect unimplemented `chats` topic filter/groupBy params (pending SQLite `project` / `chat_tag` schema sync)
/// so callers get an explicit `unsupported` error instead of an unfiltered list.
pub fn chats_unsupported_param(topic : protocol::Topic) -> Option[String] {
  match topic.param("project") {
    Some(base_codec::Json::Str(s)) => if s.length() > 0 {
      return Some("chats project filter requires schema project column (not yet wired)")
    }
    _ => ()
  }
  match topic.param("tag") {
    Some(base_codec::Json::Str(s)) => if s.length() > 0 {
      return Some("chats tag filter requires schema chat_tag table (not yet wired)")
    }
    _ => ()
  }
  match topic.param("unclassified") {
    Some(base_codec::Json::Bool(true)) => {
      return Some("chats unclassified filter requires schema project column (not yet wired)")
    }
    _ => ()
  }
  match topic.param("groupBy") {
    Some(base_codec::Json::Str(g)) => if g == "project" {
      return Some("chats groupBy=project requires schema project column (not yet wired)")
    }
    _ => ()
  }
  None
}

/// Restore persisted notification settings (`on`, `asked`, `preview`, `kinds`, `muted`) from SQLite.
fn ClientCore::restore_notify_state(self : ClientCore) -> Unit {
  match store::get_account_doc(self.db, "notify") {
    sql::SqlResult::Ok(Some(raw)) => match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(j) => {
        match base_codec::json_get(j, "on") {
          Some(base_codec::Json::Bool(b)) => {
            self.notify_on = b
            self.notify_push = b
          }
          _ => ()
        }
        match base_codec::json_get(j, "asked") {
          Some(base_codec::Json::Bool(b)) => { self.notify_asked = b }
          _ => ()
        }
        match base_codec::json_get(j, "preview") {
          Some(base_codec::Json::Bool(b)) => { self.notify_preview = b }
          _ => ()
        }
        match base_codec::json_get(j, "muted") {
          Some(base_codec::Json::Arr(xs)) => {
            self.notify_muted.clear()
            for i in 0..<xs.length() {
              match xs[i] {
                base_codec::Json::Str(s) => if s.length() > 0 { self.notify_muted.push(s) }
                _ => ()
              }
            }
          }
          _ => ()
        }
        match base_codec::json_get(j, "kinds") {
          Some(kj) => match kj {
            base_codec::Json::Obj(_) => {
              let cur = self.notify_kinds
              let next_done = match proto_str(kj, "done") {
                Some(s) => if s == "off" || s == "away" || s == "always" { s } else { cur.done }
                None => cur.done
              }
              self.notify_kinds = views::NotifyKindsInput::{
                wait: match base_codec::json_get(kj, "wait") { Some(base_codec::Json::Bool(b)) => b; _ => cur.wait },
                failed: match base_codec::json_get(kj, "failed") { Some(base_codec::Json::Bool(b)) => b; _ => cur.failed },
                done: next_done,
                message: match base_codec::json_get(kj, "message") { Some(base_codec::Json::Bool(b)) => b; _ => cur.message },
                billed: match base_codec::json_get(kj, "billed") { Some(base_codec::Json::Bool(b)) => b; _ => cur.billed },
              }
            }
            _ => ()
          }
          None => ()
        }
      }
      base_codec::JsonParseResult::Err(_) => ()
    }
    _ => ()
  }
}

struct ChatSubSnapshot {
  station : String
  thread : Option[Int]
  session : Option[String]
  rows : Int
}

/// Drop any stale per-subscription chat window snapshot when starting a fresh subscription on `id`.
pub fn ClientCore::drop_chat_sub_snapshot(self : ClientCore, id : Int64) -> Unit {
  self.chat_sub_snapshots.remove(id)
  self.chat_row_dest_ws.remove(id)
}

/// Snapshot `rows` (`chat.window`) once when a `chat` subscription opens and reuse it for every
/// refresh (`EntryAdded` / `ConnectionChanged` / `chat.send`) on that subscription (`views.ts:1453`),
/// so mid-subscription `chat.window` calls never reshape the active view.
pub fn ClientCore::chat_sub_window_rows_for(
  self : ClientCore,
  id : Int64,
  station : String,
  thread : Option[Int],
  session : Option[String],
) -> Int {
  match self.chat_sub_snapshots.get(id) {
    Some(snap) => snap.rows
    None => {
      let rows = self.chat_window_for(station, thread, session)
      self.chat_sub_snapshots.set(id, ChatSubSnapshot::{
        station: station,
        thread: thread,
        session: session,
        rows: rows,
      })
      rows
    }
  }
}

/// Drop a `chat` subscription's open snapshot on `Unsubscribe` and reclaim its `chat_windows` entry
/// when no other live subscription targets the same chat (`views.ts:1453`).
pub fn ClientCore::close_chat_sub_snapshot(self : ClientCore, id : Int64) -> Unit {
  self.chat_row_dest_ws.remove(id)
  match self.chat_sub_snapshots.get(id) {
    None => ()
    Some(snap) => {
      self.chat_sub_snapshots.remove(id)
      let rem_ids = self.chat_sub_snapshots.keys()
      match snap.thread {
        Some(th) => {
          let mut in_use = false
          for i in 0..<rem_ids.length() {
            match self.chat_sub_snapshots.get(rem_ids[i]) {
              Some(other) => {
                if other.station == snap.station {
                  match other.thread {
                    Some(oth) => if oth == th { in_use = true }
                    None => ()
                  }
                }
              }
              None => ()
            }
          }
          if !in_use {
            self.chat_windows.remove(snap.station + ":t:" + th.to_string())
          }
        }
        None => ()
      }
      match snap.session {
        Some(sk) => if sk.length() > 0 {
          let mut in_use = false
          for i in 0..<rem_ids.length() {
            match self.chat_sub_snapshots.get(rem_ids[i]) {
              Some(other) => {
                if other.station == snap.station {
                  match other.session {
                    Some(osk) => if osk == sk { in_use = true }
                    None => ()
                  }
                }
              }
              None => ()
            }
          }
          if !in_use {
            self.chat_windows.remove(snap.station + ":s:" + sk)
          }
        }
        None => ()
      }
    }
  }
}

/// Look up effective `chat.window` row count for `(station, thread?, session?)` (`views.ts:5023`).
pub fn ClientCore::chat_window_for(
  self : ClientCore,
  station : String,
  thread : Option[Int],
  session : Option[String],
) -> Int {
  let mut best = 0
  match thread {
    Some(th) => match self.chat_windows.get(station + ":t:" + th.to_string()) {
      Some(n) => if n > best { best = n }
      None => ()
    }
    None => ()
  }
  match session {
    Some(sk) => if sk.length() > 0 {
      match self.chat_windows.get(station + ":s:" + sk) {
        Some(n) => if n > best { best = n }
        None => ()
      }
    }
    None => ()
  }
  if best > 0 { best } else { 30 }
}

fn chat_place_pref_key(station : String, thread : Int) -> String {
  "place:" + station + "/" + thread.to_string()
}

fn ClientCore::chat_place_workspace(self : ClientCore, station : String) -> String {
  let ws = station_workspace_prefix(station)
  if ws.length() > 0 { ws } else { self.workspace }
}

fn ClientCore::cache_chat_place_lru(
  self : ClientCore,
  pk : String,
  entry : Option[(Int, Option[Double])],
) -> Unit {
  self.chat_places.set(pk, entry)
  let next : Array[String] = []
  for i in 0..<self.chat_place_order.length() {
    if self.chat_place_order[i] != pk {
      next.push(self.chat_place_order[i])
    }
  }
  next.push(pk)
  self.chat_place_order.clear()
  for i in 0..<next.length() {
    self.chat_place_order.push(next[i])
  }
  while self.chat_place_order.length() > 256 {
    let oldest = self.chat_place_order[0]
    let trimmed : Array[String] = []
    for i in 1..<self.chat_place_order.length() {
      trimmed.push(self.chat_place_order[i])
    }
    self.chat_place_order.clear()
    for i in 0..<trimmed.length() {
      self.chat_place_order.push(trimmed[i])
    }
    self.chat_places.remove(oldest)
  }
}

/// Look up scroll position `(at, atOffset)` for `(station, thread)` (`topics.ts:712-721`, `data.ts:1776`):
/// hits bounded 256-entry in-memory LRU first (caching `None` misses too so repeated reads avoid SQL),
/// lazily hydrating from SQLite `workspace_pref(ws, "place:<st>/<th>")` across restarts.
pub fn ClientCore::chat_place_for(
  self : ClientCore,
  station : String,
  thread : Option[Int],
) -> (Option[Int], Option[Double]) {
  match thread {
    None => (None, None)
    Some(th) => {
      let pk = station + "\u{01}" + th.to_string()
      match self.chat_places.get(pk) {
        Some(Some((seq, off))) => (Some(seq), off)
        Some(None) => (None, None)
        None => {
          let ws = self.chat_place_workspace(station)
          let loaded : Option[(Int, Option[Double])] = match store::get_workspace_pref(self.db, ws, chat_place_pref_key(station, th)) {
            sql::SqlResult::Ok(Some(raw)) => match base_codec::json_parse(raw) {
              base_codec::JsonParseResult::Ok(j) => match proto_int(j, "at") {
                Some(seq) => {
                  let off_opt : Option[Double] = match base_codec::json_get(j, "offset") {
                    Some(base_codec::Json::Num(n, _)) => Some(n)
                    _ => None
                  }
                  Some((seq, off_opt))
                }
                None => None
              }
              base_codec::JsonParseResult::Err(_) => None
            }
            _ => None
          }
          self.cache_chat_place_lru(pk, loaded)
          match loaded {
            Some((seq, off)) => (Some(seq), off)
            None => (None, None)
          }
        }
      }
    }
  }
}

fn chat_place_equal(
  a_seq : Option[Int],
  a_off : Option[Double],
  b_seq : Option[Int],
  b_off : Option[Double],
) -> Bool {
  let seq_eq = match (a_seq, b_seq) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
  if !seq_eq {
    return false
  }
  match (a_off, b_off) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn ClientCore::set_chat_place_mem(
  self : ClientCore,
  station : String,
  thread : Int,
  seq_opt : Option[Int],
  offset_opt : Option[Double],
) -> Unit {
  let eff_off : Option[Double] = match seq_opt {
    Some(_) => offset_opt
    None => None
  }
  let (cur_seq, cur_off) = self.chat_place_for(station, Some(thread))
  if chat_place_equal(cur_seq, cur_off, seq_opt, eff_off) {
    return
  }
  let pk = station + "\u{01}" + thread.to_string()
  let ws = self.chat_place_workspace(station)
  let dk = chat_place_pref_key(station, thread)
  match seq_opt {
    None => {
      self.cache_chat_place_lru(pk, None)
      let _ = store::delete_workspace_pref(self.db, ws, dk)
    }
    Some(seq) => {
      self.cache_chat_place_lru(pk, Some((seq, eff_off)))
      let off_j = match eff_off {
        Some(off) => base_codec::json_num(off)
        None => base_codec::json_null()
      }
      let fields : Array[(String, base_codec::Json)] = [
        ("at", base_codec::json_int(seq)),
        ("offset", off_j),
      ]
      let _ = store::put_workspace_pref(self.db, ws, dk, base_codec::json_stringify(base_codec::json_obj(fields)))
    }
  }
}

/// Configure the cloud origin used by `auth.begin` (e.g. `"https://app.still.fail"`).
pub fn ClientCore::set_cloud_origin(self : ClientCore, origin : String) -> Unit {
  if origin.length() > 0 {
    self.cloud_origin = origin
  }
}

fn ClientCore::open_jobs_json_list_for_scope(self : ClientCore, ws_scope : String) -> Array[base_codec::Json] {
  if ws_scope.length() > 0 && !self.can_read_workspace(ws_scope) {
    return []
  }
  if !self.can_read_station(self.station) {
    return []
  }
  let open_list = self.events.open_jobs()
  let out : Array[base_codec::Json] = []
  for i in 0..<open_list.length() {
    let j = open_list[i]
    let fields : Array[(String, base_codec::Json)] = [
      ("id", base_codec::json_str(j.id)),
      ("station", base_codec::json_str(self.station)),
      ("state", base_codec::json_str(if j.open { "running" } else { "exited" })),
      ("startedAt", base_codec::json_int64(0.to_int64())),
    ]
    match j.chat {
      Some(c) => fields.push(("chat", base_codec::json_str(c)))
      None => ()
    }
    out.push(base_codec::json_obj(fields))
  }
  out
}

fn ClientCore::open_jobs_json_list(self : ClientCore) -> Array[base_codec::Json] {
  self.open_jobs_json_list_for_scope(self.workspace)
}

/// Evaluate subscription topics through `packages/views` projections so `Slice1Router`
/// delivers `shapes/`-conforming payloads and ≤ 4 KB keyed deltas.
/// Enforces the single unified `MembershipAuthority` O(1) read gate across EVERY topic and aggregate.
fn ClientCore::evaluate_view_topic(self : ClientCore, id : Int64, topic : protocol::Topic) -> Option[protocol::CoreEvent] {
  if topic.name == "chats" {
    match chats_unsupported_param(topic) {
      Some(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "unsupported", message: msg }))
      None => ()
    }
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let mine_only = match topic.param("mine") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let watching_only = match topic.param("watching") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let hidden_mode = match topic.param("hidden") {
      Some(base_codec::Json::Bool(true)) => 1
      _ => 0
    }
    let briefs = self.station_briefs_for_scope(ws_scope)
    let dirty_opt : Option[Array[(String, String)]] = if self.pending_dirty_rows.length() > 0 {
      let copy : Array[(String, String)] = []
      for di in 0..<self.pending_dirty_rows.length() {
        copy.push(self.pending_dirty_rows[di])
      }
      self.pending_dirty_rows.clear()
      Some(copy)
    } else {
      None
    }
    match views::project_chats(
      self.db,
      ws_scope,
      briefs,
      self.rt.now(),
      self.rows_memo,
      self.viewer_marks,
      mine_only=mine_only,
      watching_only=watching_only,
      hidden_mode=hidden_mode,
      changed_keys=dirty_opt,
      lang=self.lang,
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "chat" {
    let st = match topic.param("station") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else { self.station }
      _ => self.station
    }
    let th_opt : Option[Int] = match topic.param("thread") {
      Some(base_codec::Json::Num(n, _)) => Some(n.to_int())
      _ => None
    }
    let sess_opt : Option[String] = match topic.param("session") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => match topic.param("key") {
        Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
        _ => None
      }
    }
    if th_opt.is_none() && sess_opt.is_none() {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    // Validate selector consistency (`thread` vs `session`) and resolve moved destination ONCE,
    // using that single target across gate checks and view projection!
    let (final_st, final_th, final_sess) = match self.resolve_consistent_chat_target(st, th_opt, sess_opt) {
      Ok(t) => t
      Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "chat_selector_mismatch", message: msg }))
    }
    if !self.can_read_station(st) || !self.can_read_station(final_st) {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    let compact = match topic.param("compact") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let rows_lim = self.chat_sub_window_rows_for(id, final_st, final_th, final_sess)
    match views::project_chat_by_params(
      self.db,
      final_st,
      final_th,
      final_sess,
      compact,
      self.viewer_marks.me,
      self.rt.now(),
      rows=rows_lim,
      at=None,
      at_offset=None,
      utc_offset_min=self.utc_offset_min,
      lang=self.lang,
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "workspaces" {
    if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
      return Some(protocol::CoreEvent::Value(id, base_codec::json_arr([]), None))
    }
    match views::project_workspaces(
      self.db,
      accounts=self.auth_store.accounts,
      viewer_sub=self.viewer_sub,
      viewer_email=self.viewer_marks.me,
      allow_workspace=Some(fn(w : String) -> Bool { self.can_read_workspace(w) }),
      active_sub=self.membership.effective_sub(),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "workspace" {
    let ws = match topic.param("workspace") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    if !self.can_read_workspace(ws) {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    match views::project_workspace(self.db, ws) {
      sql::SqlResult::Ok(Some(j)) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Ok(None) => return Some(protocol::CoreEvent::Waiting(id))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "stations" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    match views::project_stations(
      self.db,
      ws_scope,
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "accounts" {
    if self.auth_store.accounts.length() > 0 {
      return Some(protocol::CoreEvent::Value(id, views::project_accounts_topic(self.auth_store), None))
    }
    match views::project_accounts(self.db) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "lock" {
    let req_ws = match topic.param("workspace") {
      Some(base_codec::Json::Str(s)) => s
      _ =>
      match topic.param("scope") {
        Some(base_codec::Json::Str(s)) => s
        _ => self.workspace
      }
    }
    if !self.can_read_workspace(req_ws) || (req_ws.length() > 0 && req_ws != self.workspace) {
      let empty_inp = views::SafeModeInput::{
        available: self.lock_available,
        viewer_sub: "",
        viewer_role: "viewer",
        device_id: "",
        device_kind: "app",
        device_sign_key: None,
        personal_standing: "",
        signer_unsaid: false,
        no_device_answered: false,
        rebound_admins: [],
        station_names: Map::new(),
        online_stations: Map::new(),
        pending: views::LockPendingQueue::new(),
      }
      let sm = views::project_safe_mode(None, empty_inp)
      return Some(protocol::CoreEvent::Value(id, sm.to_json(), None))
    }
    let sm = self.current_safe_mode_view()
    return Some(protocol::CoreEvent::Value(id, sm.to_json(), None))
  }
  if topic.name == "vaults" {
    let ws = match topic.param("workspace") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    if !self.can_read_workspace(ws) {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    let sm = if ws.length() > 0 && ws != self.workspace {
      let empty_inp = views::SafeModeInput::{
        available: self.lock_available,
        viewer_sub: "",
        viewer_role: "viewer",
        device_id: "",
        device_kind: "app",
        device_sign_key: None,
        personal_standing: "",
        signer_unsaid: false,
        no_device_answered: false,
        rebound_admins: [],
        station_names: Map::new(),
        online_stations: Map::new(),
        pending: views::LockPendingQueue::new(),
      }
      views::project_safe_mode(None, empty_inp)
    } else {
      self.current_safe_mode_view()
    }
    match views::project_vaults(self.db, ws, sm, self.lock_available, self.vaults_set_up) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "vaultItems" || topic.name == "vaultUses" || topic.name == "vaultSecrets" {
    let ws = match topic.param("workspace") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    if !self.can_read_workspace(ws) {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    let vault_id = match topic.param("vault") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    if topic.name == "vaultUses" {
      let item_id = match topic.param("item") {
        Some(base_codec::Json::Str(s)) => s
        _ => ""
      }
      return Some(protocol::CoreEvent::Value(id, base_codec::json_obj([
        ("workspace", base_codec::json_str(ws)),
        ("vault", base_codec::json_str(vault_id)),
        ("item", base_codec::json_str(item_id)),
        ("uses", base_codec::json_arr([])),
      ]), None))
    }
    let locked = self.auth.is_vault_locked(ws, vault_id=vault_id)
    let items_out : Array[base_codec::Json] = []
    if !locked {
      match store::get_account_doc(self.db, "vault_secrets") {
        sql::SqlResult::Ok(Some(raw)) => match base_codec::json_parse(raw) {
          base_codec::JsonParseResult::Ok(doc) => {
            let arr = match doc {
              base_codec::Json::Arr(xs) => xs
              base_codec::Json::Obj(_) => match base_codec::json_get(doc, "secrets") {
                Some(base_codec::Json::Arr(xs)) => xs
                _ => []
              }
              _ => []
            }
            for i in 0..<arr.length() {
              let it = arr[i]
              let it_ws = j_str(it, "workspace")
              let it_vault = j_str(it, "vault")
              let ws_ok = it_ws.length() > 0 && it_ws == ws && self.can_read_workspace(it_ws)
              let vault_ok = vault_id.length() == 0 || it_vault == vault_id
              if ws_ok && vault_ok {
                items_out.push(it)
              }
            }
          }
          base_codec::JsonParseResult::Err(_) => ()
        }
        _ => ()
      }
    }
    if topic.name == "vaultItems" {
      return Some(protocol::CoreEvent::Value(id, base_codec::json_obj([
        ("workspace", base_codec::json_str(ws)),
        ("vault", base_codec::json_str(vault_id)),
        ("locked", base_codec::json_bool(locked)),
        ("items", base_codec::json_arr(items_out)),
      ]), None))
    }
    return Some(protocol::CoreEvent::Value(id, base_codec::json_obj([
      ("secrets", base_codec::json_arr(items_out)),
    ]), None))
  }
  // ── Batch 2 view topics ──
  if topic.name == "presets" {
    if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
      return Some(protocol::CoreEvent::Value(id, views::project_own_presets([], ""), None))
    }
    return Some(protocol::CoreEvent::Value(id, views::project_own_presets(self.presets_held, self.viewer_sub), None))
  }
  if topic.name == "otherPresets" {
    if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
      return Some(protocol::CoreEvent::Value(id, views::project_other_presets([], [], "", false), None))
    }
    return Some(protocol::CoreEvent::Value(
      id,
      views::project_other_presets([self.other_presets_held], self.presets_held, self.viewer_sub, false),
      None,
    ))
  }
  if topic.name == "stars" {
    if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
      return Some(protocol::CoreEvent::Value(id, base_codec::json_obj([("starred", base_codec::json_arr([]))]), None))
    }
    let keys = views::starred_keys(self.stars_held)
    let arr : Array[base_codec::Json] = []
    for i in 0..<keys.length() {
      arr.push(base_codec::json_str(keys[i]))
    }
    return Some(protocol::CoreEvent::Value(id, base_codec::json_obj([("starred", base_codec::json_arr(arr))]), None))
  }
  if topic.name == "boardDrafts" {
    if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
      return Some(protocol::CoreEvent::Value(id, views::project_board_drafts([], ""), None))
    }
    return Some(protocol::CoreEvent::Value(id, views::project_board_drafts(self.board_drafts_held, self.viewer_sub), None))
  }
  if topic.name == "downloads" {
    if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
      return Some(protocol::CoreEvent::Value(id, views::project_downloads([]), None))
    }
    return Some(protocol::CoreEvent::Value(id, views::project_downloads(self.downloads_held), None))
  }
  if topic.name == "vaultApprovals" {
    let ws = match topic.param("workspace") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    if !self.can_read_workspace(ws) {
      return Some(protocol::CoreEvent::Value(id, base_codec::json_obj([("pending", base_codec::json_arr([]))]), None))
    }
    return Some(protocol::CoreEvent::Value(id, views::project_vault_approvals(self.vault_approvals, ws), None))
  }
  // ── Batch 3 view topics ──
  if topic.name == "models" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    match views::project_models(
      self.db,
      ws_scope,
      self.stars_held,
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "profiles" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    match views::project_profiles(
      self.db,
      ws_scope,
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "profilesOverview" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    match views::project_profiles_overview(
      self.db,
      ws_scope,
      self.rt.now(),
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "search" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let q = match topic.param("query") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let lim = match topic.param("limit") {
      Some(base_codec::Json::Num(n, _)) => n.to_int()
      _ => 20
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    let briefs = self.station_briefs_for_scope(ws_scope)
    match views::project_search(self.db, ws_scope, briefs, q, limit=lim, include_workspace_doc=scope_ok) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "chatSearch" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let q = match topic.param("query") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let lim = match topic.param("limit") {
      Some(base_codec::Json::Num(n, _)) => n.to_int()
      _ => 20
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    let briefs = self.station_briefs_for_scope(ws_scope)
    match views::project_chat_search(self.db, ws_scope, briefs, q, limit=lim, include_workspace_doc=scope_ok) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "settings" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    match views::project_settings(
      self.db,
      ws_scope,
      viewer_sub=self.viewer_sub,
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
      include_workspace_doc=scope_ok,
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "stationUpdates" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    match views::project_station_updates(
      self.db,
      ws_scope,
      self.rt.now(),
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "archive" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let q = match topic.param("query") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let lim = match topic.param("limit") {
      Some(base_codec::Json::Num(n, _)) => n.to_int()
      _ => 50
    }
    let briefs = self.station_briefs_for_scope(ws_scope)
    match views::project_archive(self.db, ws_scope, briefs, self.rt.now(), query=q, limit=lim) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "fleet" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    let briefs = self.station_briefs_for_scope(ws_scope)
    let running = if scope_ok && self.can_read_station(self.station) { self.running_session_count() } else { 0 }
    match views::project_fleet(
      self.db,
      ws_scope,
      briefs,
      self.rt.now(),
      running_chats=running,
      open_jobs=self.open_jobs_json_list_for_scope(ws_scope),
      include_workspace_doc=scope_ok,
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "usage" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let days = match topic.param("days") {
      Some(base_codec::Json::Num(n, _)) => n.to_int()
      _ => 7
    }
    let split = match topic.param("split") {
      Some(base_codec::Json::Str(s)) => Some(s)
      _ => None
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    let ws_doc_ok = ws_scope.length() > 0 && self.can_read_workspace(ws_scope)
    let briefs = self.station_briefs_for_scope(ws_scope)
    match views::project_usage(
      self.db,
      ws_scope,
      briefs,
      self.rt.now(),
      days_asked=days,
      split=split,
      include_workspace_doc=ws_doc_ok,
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "agentRates" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let briefs = self.station_briefs_for_scope(ws_scope)
    match views::project_agent_rates(self.db, ws_scope, briefs) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "railCard" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let place = match topic.param("place") {
      Some(base_codec::Json::Str(s)) => s
      _ => "chats"
    }
    let scope_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated() && (ws_scope.length() == 0 || self.can_read_workspace(ws_scope))
    let ws_doc_ok = ws_scope.length() > 0 && self.can_read_workspace(ws_scope)
    let briefs = self.station_briefs_for_scope(ws_scope)
    let running = if scope_ok && self.can_read_station(self.station) { self.running_session_count() } else { 0 }
    match views::project_rail_card(
      self.db,
      ws_scope,
      place,
      briefs,
      running,
      self.viewer_marks,
      self.rt.now(),
      include_workspace_doc=ws_doc_ok,
      allow_station=Some(fn(st : String) -> Bool { scope_ok && self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "chatJobs" {
    let st = match topic.param("station") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else { self.station }
      _ => self.station
    }
    let th = match topic.param("thread") {
      Some(base_codec::Json::Num(n, _)) => n.to_int()
      _ => return Some(protocol::CoreEvent::Waiting(id))
    }
    let sess_opt : Option[String] = match topic.param("session") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => None
    }
    let (final_st, final_th_opt, _) = match self.resolve_consistent_chat_target(st, Some(th), sess_opt) {
      Ok(t) => t
      Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "chat_selector_mismatch", message: msg }))
    }
    let eff_th = match final_th_opt { Some(t) => t; None => th }
    if !self.can_read_station(st) || !self.can_read_station(final_st) {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    let summary = match topic.param("summary") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    match views::project_chat_jobs(self.db, final_st, eff_th, self.open_jobs_json_list_for_scope(self.membership.station_workspace(final_st, fallback_ws=self.workspace)), self.rt.now(), summary=summary) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "longJobs" {
    let ws_scope = match topic.param("scope") {
      Some(base_codec::Json::Str(s)) => s
      _ => self.workspace
    }
    let briefs = self.station_briefs_for_scope(ws_scope)
    match views::project_long_jobs(self.db, ws_scope, briefs, self.open_jobs_json_list_for_scope(ws_scope), self.rt.now()) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  // ── W28a runtime topic projectors (zero static empty stubs) ──
  if topic.name == "status" {
    let j = views::project_status(
      self.status_waits,
      self.status_downs,
      self.status_db_notes,
      0L,
      views::status_rate_window_ms(),
      self.rt.now(),
      lang=self.lang,
    )
    return Some(protocol::CoreEvent::Value(id, j, None))
  }
  if topic.name == "lockPrompts" {
    let filt_prompts : Array[views::LockPairingPromptInput] = []
    for i in 0..<self.lock_pairing_prompts.length() {
      let pr = self.lock_pairing_prompts[i]
      let mut all_ok = !self.membership.is_unauthenticated() && !self.membership.is_session_invalidated()
      if all_ok {
        for j in 0..<pr.workspaces.length() {
          let wj = pr.workspaces[j]
          let wid = match wj {
            base_codec::Json::Str(s) => s
            _ => j_str(wj, "id")
          }
          if wid.length() > 0 && !self.can_read_workspace(wid) {
            all_ok = false
            break
          }
        }
      }
      if all_ok {
        filt_prompts.push(pr)
      }
    }
    let filt_asks : Array[views::VaultKeyAskInput] = []
    for i in 0..<self.vault_key_asks.length() {
      if self.can_read_workspace(self.vault_key_asks[i].workspace) {
        filt_asks.push(self.vault_key_asks[i])
      }
    }
    let j = views::project_lock_prompts(filt_prompts, filt_asks, self.rt.now())
    return Some(protocol::CoreEvent::Value(id, j, None))
  }
  if topic.name == "notices" {
    let ws_filter : Option[String] = match topic.param("workspace") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => None
    }
    let filt_notices : Array[views::NoticeItemInput] = []
    for i in 0..<self.notices_held.length() {
      if self.can_read_workspace(self.notices_held[i].workspace) {
        filt_notices.push(self.notices_held[i])
      }
    }
    let j = views::project_notices(filt_notices, workspace_filter=ws_filter, lang=self.lang)
    return Some(protocol::CoreEvent::Value(id, j, None))
  }
  if topic.name == "notify" {
    if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
      let empty_state = views::NotifyStateInput::{
        on: self.notify_on,
        asked: self.notify_asked,
        push: self.notify_push,
        kinds: self.notify_kinds,
        preview: self.notify_preview,
        muted: [],
        permission: self.notify_permission,
        in_front: self.notify_in_front,
      }
      match views::project_notify(
        self.db,
        empty_state,
        [],
        lang=self.lang,
        allow_workspace=Some(fn(_w : String) -> Bool { false }),
      ) {
        sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
        sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
      }
    }
    let filt_notices : Array[views::NoticeItemInput] = []
    for i in 0..<self.notices_held.length() {
      if self.can_read_workspace(self.notices_held[i].workspace) {
        filt_notices.push(self.notices_held[i])
      }
    }
    match views::project_notify(
      self.db,
      self.current_notify_state(),
      filt_notices,
      lang=self.lang,
      allow_workspace=Some(fn(w : String) -> Bool { self.can_read_workspace(w) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "doing" {
    let j = views::project_doing(self.current_doing_inputs())
    return Some(protocol::CoreEvent::Value(id, j, None))
  }
  // ── Phase 1 sfreplay & runtime-unshadowed real topic projectors ──
  if topic.name == "prefs" {
    match views::project_prefs(
      self.db,
      default_workspace=self.workspace,
      device_app=self.device_app,
      device_locale=self.device_locale,
      device_phone=self.device_phone,
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "workspaceMarks" {
    let prefs_opt : Option[base_codec::Json] = match views::project_prefs(
      self.db,
      default_workspace=self.workspace,
      device_app=self.device_app,
      device_locale=self.device_locale,
      device_phone=self.device_phone,
    ) {
      sql::SqlResult::Ok(pj) => Some(pj)
      sql::SqlResult::Err(_) => None
    }
    match views::project_workspace_marks(
      self.db,
      self.viewer_marks.me,
      viewer_id=self.viewer_sub,
      lang=self.lang,
      prefs=prefs_opt,
      allow_workspace=Some(fn(w : String) -> Bool { self.can_read_workspace(w) }),
      allow_station=Some(fn(st : String) -> Bool { self.can_read_station(st) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  if topic.name == "composer" {
    let key = match topic.param("key") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    if !self.can_read_draft_target(Some(key), "", "") {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    return Some(protocol::CoreEvent::Value(id, self.composers.value(key), None))
  }
  if topic.name == "draft" {
    let st = match topic.param("station") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else { self.station }
      _ => self.station
    }
    let ch = match topic.param("chat") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    if !self.can_read_draft_target(None, st, ch) {
      return Some(protocol::CoreEvent::Waiting(id))
    }
    return None
  }
  if topic.name == "chatRow" {
    let st = match topic.param("station") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else { self.station }
      _ => self.station
    }
    let sess = match topic.param("session") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let mut final_st = st
    match store::resolve_chat_now(self.db, st, sess) {
      sql::SqlResult::Ok(Some(loc)) => {
        final_st = loc.station
      }
      _ => ()
    }
    let src_ws = self.membership.station_workspace(st, fallback_ws=self.workspace)
    let dest_ws = self.membership.station_workspace(final_st, fallback_ws=self.workspace)
    if dest_ws.length() > 0 && dest_ws != src_ws {
      self.chat_row_dest_ws.set(id, dest_ws)
    } else {
      self.chat_row_dest_ws.remove(id)
    }
    // Authorize BOTH source station AND moved destination station!
    // Emit `Value(Json::Null)` (not `Waiting`) so `client.mbt` immediately clears any previously held row.
    if !self.can_read_station(st) || !self.can_read_station(final_st) {
      return Some(protocol::CoreEvent::Value(id, base_codec::json_null(), None))
    }
    let briefs = self.station_briefs_for_scope(dest_ws)
    match views::project_chat_row(
      self.db,
      st,
      sess,
      briefs,
      self.viewer_marks,
      self.rt.now(),
      lang=self.lang,
      allow_station=Some(fn(s : String) -> Bool { self.can_read_station(s) }),
    ) {
      sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Value(id, j, None))
      sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
    }
  }
  None
}

/// Refresh an active subscription and emit incremental keyed `CoreEvent::Delta` if changed.
pub fn ClientCore::refresh_subscription(self : ClientCore, id : Int64) -> Option[protocol::CoreEvent] {
  self.router.refresh_sub(id)
}

/// Refresh all active subscriptions matching `topic_name` (`"chats"`, `"chat"`, etc.).
pub fn ClientCore::refresh_topic(self : ClientCore, topic_name : String) -> Array[protocol::CoreEvent] {
  self.router.refresh_topic_name(topic_name)
}

/// Refresh all active subscriptions matching `topic_name`, returning `(Topic, CoreEvent)` pairs
/// so outbound callers can stamp exact `WireOutGen` envelopes.
pub fn ClientCore::refresh_topic_with_topics(
  self : ClientCore,
  topic_name : String,
) -> Array[(protocol::Topic, protocol::CoreEvent)] {
  self.router.refresh_topic_with_topics(topic_name)
}

/// Refresh all active subscriptions matching `topic_name` and encode each with unified `WireOutGen`.
pub fn ClientCore::refresh_topic_wire(
  self : ClientCore,
  topic_name : String,
) -> Array[(String, Option[Bytes])] {
  let pairs = self.router.refresh_topic_with_topics(topic_name)
  let out : Array[(String, Option[Bytes])] = []
  for i in 0..<pairs.length() {
    let (topic, ev) = pairs[i]
    out.push(self.encode_sub_event(topic, ev))
  }
  out
}

/// Register a real host outbound wire sink (used by `core_runtime`).
/// When registered, outbound wire frames go directly to the host sink and NEVER accumulate
/// in `pending_wire_events`.
pub fn ClientCore::set_wire_sink(
  self : ClientCore,
  sink : (String, Option[Bytes]) -> Unit,
) -> Unit {
  self.wire_sink = Some(sink)
  if self.pending_wire_events.length() > 0 {
    let drained : Array[PendingWireEvent] = []
    for i in 0..<self.pending_wire_events.length() {
      drained.push(self.pending_wire_events[i])
    }
    self.pending_wire_events.clear()
    for i in 0..<drained.length() {
      sink(drained[i].json, drained[i].bytes)
    }
  }
}

/// Emit one outbound wire frame directly to the host sink if registered, or buffer it in
/// bounded `pending_wire_events` (`<= 256`) in headless unit-test mode, NEVER evicting the
/// latest `{"id":0,"auth":...}` handshake frame (tracked via explicit `is_handshake` flag).
pub fn ClientCore::emit_wire_out(
  self : ClientCore,
  json_text : String,
  bytes : Option[Bytes] = None,
  is_handshake : Bool = false,
) -> Unit {
  match self.wire_sink {
    Some(sink) => sink(json_text, bytes)
    None => {
      self.pending_wire_events.push(PendingWireEvent::{
        json: json_text,
        bytes: bytes,
        is_handshake: is_handshake,
      })
      while self.pending_wire_events.length() > PENDING_WIRE_MAX {
        let mut latest_hs_idx = -1
        for i in 0..<self.pending_wire_events.length() {
          if self.pending_wire_events[i].is_handshake {
            latest_hs_idx = i
          }
        }
        let drop_idx = if latest_hs_idx == 0 && self.pending_wire_events.length() > 1 { 1 } else { 0 }
        let trimmed : Array[PendingWireEvent] = []
        for i in 0..<self.pending_wire_events.length() {
          if i != drop_idx {
            trimmed.push(self.pending_wire_events[i])
          }
        }
        self.pending_wire_events.clear()
        for i in 0..<trimmed.length() {
          self.pending_wire_events.push(trimmed[i])
        }
      }
    }
  }
}

pub fn ClientCore::drain_pending_wire_events(self : ClientCore) -> Array[(String, Option[Bytes])] {
  let out : Array[(String, Option[Bytes])] = []
  for i in 0..<self.pending_wire_events.length() {
    let ev = self.pending_wire_events[i]
    out.push((ev.json, ev.bytes))
  }
  self.pending_wire_events.clear()
  out
}

pub fn ClientCore::pending_wire_event_count(self : ClientCore) -> Int {
  self.pending_wire_events.length()
}

/// Emit the authoritative `{"id": 0, "auth": {"conn": N, ...}}` handshake/boundary snapshot.
pub fn ClientCore::emit_auth_handshake(self : ClientCore) -> String {
  let json_text = base_codec::json_stringify(self.auth.handshake_json())
  self.emit_wire_out(json_text, is_handshake=true)
  json_text
}

/// Encode any subscription `protocol::CoreEvent` with the single unified `WireOutGen` envelope
/// (`conn`, plus `authGen` for non-device-global topics and `vaultGen` for vault topics).
pub fn ClientCore::encode_sub_event(
  self : ClientCore,
  topic : protocol::Topic,
  ev : protocol::CoreEvent,
) -> (String, Option[Bytes]) {
  let gen = self.auth.wire_out_gen(topic)
  protocol::encode_sub_event_with_auth(ev, gen)
}

pub fn ClientCore::set_on_runtime_boundary(
  self : ClientCore,
  cb : (AuthBoundaryEvent) -> Unit,
) -> Unit {
  self.on_runtime_boundary = Some(cb)
}

/// Build the full `WireOutGen` envelope for a raw JSON `subscribe` request whose full parse failed
/// (`Invalid`), preserving `conn` + `authGen` + `vaultGen` whenever `subscribe.topic` is recognizable.
pub fn ClientCore::wire_out_gen_for_raw_subscribe(
  self : ClientCore,
  raw : base_codec::Json,
) -> protocol::WireOutGen {
  match base_codec::json_get(raw, "subscribe") {
    Some(base_codec::Json::Obj(fs)) => {
      let mut tname = ""
      let params : Array[(String, base_codec::Json)] = []
      for i in 0..<fs.length() {
        let (k, v) = fs[i]
        if k == "topic" {
          match v {
            base_codec::Json::Str(s) => { tname = s }
            _ => ()
          }
        } else {
          params.push((k, v))
        }
      }
      if tname.length() > 0 {
        return self.auth.wire_out_gen(protocol::Topic::{ name: tname, params: params })
      }
    }
    _ => ()
  }
  protocol::WireOutGen::{ conn: self.auth.conn_seq(), auth_gen: None, vault_gen: None }
}

fn ClientCore::sub_matches_auth_boundary(self : ClientCore, sid : Int64, topic : protocol::Topic, ev : AuthBoundaryEvent) -> Bool {
  if self.auth.matches_topic(topic, ev) {
    return true
  }
  match self.chat_row_dest_ws.get(sid) {
    Some(dest_ws) => match ev {
      AuthBoundaryEvent::Global(_, _) => true
      AuthBoundaryEvent::Workspace(ws, _) => ws == dest_ws
      AuthBoundaryEvent::WorkspaceAndVault(ws, _, _) => ws == dest_ws
      _ => false
    }
    None => false
  }
}

fn ClientCore::handle_auth_boundary(self : ClientCore, ev : AuthBoundaryEvent) -> Unit {
  // 1. Always emit the authoritative `{id: 0, auth: ...}` boundary snapshot first.
  let _ = self.emit_auth_handshake()
  // 2. Purge affected `kept` cache & reset cached `last_value` on active subs strictly per `auth.matches_topic`
  //    PLUS any opened `chatRow` subscription dynamically depending on a moved destination workspace!
  let matches = fn(t : protocol::Topic) -> Bool {
    self.auth.matches_topic(t, ev)
  }
  self.router.invalidate_kept_where(matches)
  self.router.invalidate_sub_cache_where(matches)
  // 3. Re-anchor affected active subscriptions in `self.router` immediately (never freeze subs!).
  let subs = self.router.active_subs_snapshot()
  for i in 0..<subs.length() {
    let (sid, st) = subs[i]
    if self.sub_matches_auth_boundary(sid, st, ev) {
      self.router.invalidate_sub_cache_by_id(sid)
      match self.router.refresh_sub_force(sid) {
        Some((topic, sev)) => {
          let (j, b) = self.encode_sub_event(topic, sev)
          self.emit_wire_out(j, bytes=b)
        }
        None => ()
      }
    }
  }
  // 4. Notify runtime host (`core_runtime`) to re-anchor `runtime_subs` and scrub `kept_vals`.
  match self.on_runtime_boundary {
    Some(cb) => cb(ev)
    None => ()
  }
}

fn lock_aside_most() -> Int { 256 }

fn lock_entry_hash(e : form::Json, c : lock::Crypto) -> String {
  match lock::entry_hash(e, c) {
    Ok(h) => h
    Err(_) => ""
  }
}

fn lock_entry_seq(e : form::Json) -> Int {
  match form::json_field(Some(e), "seq") {
    Some(form::Json::Num(n)) => n.to_int()
    _ => -1
  }
}

fn lock_entry_prev(e : form::Json) -> Option[String] {
  match form::json_field(Some(e), "prev") {
    Some(form::Json::Str(s)) => Some(s)
    _ => None
  }
}

fn lock_is_aside_off(o : lock::Off) -> Bool {
  match o {
    lock::Off::Beaten(_, _) => true
    lock::Off::Below(_) => true
    _ => false
  }
}

fn lock_sort_by_seq(xs : Array[form::Json]) -> Unit {
  for i in 1..<xs.length() {
    let cur = xs[i]
    let cur_seq = lock_entry_seq(cur)
    let mut j = i - 1
    while j >= 0 && lock_entry_seq(xs[j]) > cur_seq {
      xs[j + 1] = xs[j]
      j -= 1
    }
    xs[j + 1] = cur
  }
}

fn lock_same_hash_seq(a : Array[form::Json], b : Array[form::Json], c : lock::Crypto) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if lock_entry_hash(a[i], c) != lock_entry_hash(b[i], c) {
      return false
    }
  }
  true
}

fn serialize_lock_pref_json(
  state : Option[lock::LockState],
  root : Option[String],
  kept_entries : Array[form::Json],
  kept_aside : Array[form::Json],
  seen : Option[base_codec::Json],
) -> Option[String] {
  let head_j = match state {
    Some(st) =>
    base_codec::json_obj([
      ("seq", base_codec::json_num(st.seq)),
      ("hash", base_codec::json_str(st.head)),
      ("genesis", base_codec::json_str(st.genesis)),
    ])
    None =>
    match root {
      Some(g) =>
      base_codec::json_obj([
        ("seq", base_codec::json_int(-1)),
        ("hash", base_codec::json_str("")),
        ("genesis", base_codec::json_str(g)),
      ])
      None => return None
    }
  }
  let entries_j : Array[base_codec::Json] = []
  for i in 0..<kept_entries.length() {
    entries_j.push(form_to_codec(kept_entries[i]))
  }
  let fields : Array[(String, base_codec::Json)] = [
    ("head", head_j),
    ("entries", base_codec::json_arr(entries_j)),
  ]
  if kept_aside.length() > 0 {
    let aside_j : Array[base_codec::Json] = []
    for i in 0..<kept_aside.length() {
      aside_j.push(form_to_codec(kept_aside[i]))
    }
    fields.push(("aside", base_codec::json_arr(aside_j)))
  }
  match seen {
    Some(seen_v) => fields.push(("seen", seen_v))
    None => ()
  }
  Some(base_codec::json_stringify(base_codec::json_obj(fields)))
}

/// Persist lock state into `workspace_pref(target_ws, "lock")` using the exact TS schema
/// (`client/core-ts/src/views/lock.ts:1249`): `{ head: { seq, hash, genesis }, entries, aside?, seen? }`.
fn ClientCore::persist_lock_state_for_workspace(
  self : ClientCore,
  target_ws : String,
  state : Option[lock::LockState],
  root : Option[String],
  kept_entries : Array[form::Json],
  kept_aside : Array[form::Json],
  seen : Option[base_codec::Json],
) -> Result[Unit, String] {
  let raw = match serialize_lock_pref_json(state, root, kept_entries, kept_aside, seen) {
    Some(s) => s
    None => return Ok(())
  }
  match store::put_workspace_pref(self.db, target_ws, "lock", raw) {
    sql::SqlResult::Ok(_) => Ok(())
    sql::SqlResult::Err(e) => {
      let msg = "failed to persist lock state: " + e.to_string()
      self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
      Err(msg)
    }
  }
}

fn ClientCore::load_lock_slot_from_db(self : ClientCore, target_ws : String) -> Result[WorkspaceLockSlot, String] {
  let slot = empty_lock_slot()
  let mark_corrupt = fn(detail : String) -> Unit {
    slot.lock_corrupt = true
    self.outbox.tell(CoreEvent::LockRejected(target_ws, "corrupt persisted lock state; refusing TOFU reset (" + detail + ")"))
  }
  let raw = match store::get_workspace_pref(self.db, target_ws, "lock") {
    sql::SqlResult::Ok(Some(s)) => if s.length() > 0 { s } else { return Ok(slot) }
    sql::SqlResult::Ok(None) => return Ok(slot)
    sql::SqlResult::Err(e) => return Err("failed to read persisted lock state: " + e.to_string())
  }
  let doc = match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(e) => {
      mark_corrupt("invalid json: " + e)
      return Ok(slot)
    }
  }
  let root : String = match base_codec::json_get(doc, "head") {
    Some(base_codec::Json::Null) => {
      // Valid TS unlocked workspace record: `{"head": null, "entries": [], "seen": [...]}` (`views/lock.ts:1249`).
      match base_codec::json_get(doc, "entries") {
        None => {
          slot.lock_seen = base_codec::json_get(doc, "seen")
          return Ok(slot)
        }
        Some(base_codec::Json::Arr(xs)) => {
          if xs.length() == 0 {
            slot.lock_seen = base_codec::json_get(doc, "seen")
            return Ok(slot)
          }
          mark_corrupt("head is null with non-empty entries")
          return Ok(slot)
        }
        _ => {
          mark_corrupt("head is null with non-array entries")
          return Ok(slot)
        }
      }
    }
    Some(head_j) =>
    match proto_str(head_j, "genesis") {
      Some(g) => if g.length() > 0 { g } else {
        mark_corrupt("empty head.genesis")
        return Ok(slot)
      }
      None => {
        mark_corrupt("missing head.genesis")
        return Ok(slot)
      }
    }
    None => {
      mark_corrupt("missing head")
      return Ok(slot)
    }
  }
  let kept_entries : Array[form::Json] = []
  match base_codec::json_get(doc, "entries") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        kept_entries.push(codec_to_form(xs[i]))
      }
    }
    None => ()
    _ => {
      mark_corrupt("entries is not an array")
      return Ok(slot)
    }
  }
  let kept_aside : Array[form::Json] = []
  match base_codec::json_get(doc, "aside") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        kept_aside.push(codec_to_form(xs[i]))
      }
    }
    None => ()
    _ => {
      mark_corrupt("aside is not an array")
      return Ok(slot)
    }
  }
  slot.lock_seen = base_codec::json_get(doc, "seen")
  if kept_entries.length() == 0 {
    slot.lock_root = Some(root)
    return Ok(slot)
  }
  let all : Array[form::Json] = []
  for i in 0..<kept_entries.length() {
    all.push(kept_entries[i])
  }
  for i in 0..<kept_aside.length() {
    all.push(kept_aside[i])
  }
  match verify_workspace_lock(all, root, votes=lock::Votes::Roles, now=None) {
    Ok(v) => {
      if v.state.ws != target_ws || v.state.genesis != root {
        mark_corrupt("persisted chain workspace/genesis mismatch")
        return Ok(slot)
      }
      slot.lock_root = Some(root)
      slot.lock_state = Some(v.state)
      slot.lock_kept_entries = v.chain.entries
      slot.lock_kept_aside = kept_aside
      // Seed canonical lock digests from SQLite at startup without bumping `authGen` / `vaultGen`.
      let (full_dig, sec_dig) = canonical_lock_digest(v.state)
      self.lock_digest_by_ws.set(target_ws, full_dig)
      self.lock_sec_digest_by_ws.set(target_ws, sec_dig)
      let now_secs = self.rt.now().to_double() / 1000.0
      match views::effective_state(target_ws, v.chain.entries, [], [], now_secs, native_lock_crypto()) {
        Ok(eff) => {
          slot.lock_effective = Some(eff)
        }
        Err(_) => ()
      }
      Ok(slot)
    }
    Err(why) => {
      mark_corrupt("persisted chain verification failed: " + why)
      Ok(slot)
    }
  }
}

/// Restore or look up an extra workspace's lock slot. On transient SQLite `Err`, NEVER cache an
/// empty unpinned slot so a future retry reads the true persisted pin from SQLite.
fn ClientCore::get_or_restore_extra_lock(self : ClientCore, target_ws : String) -> Result[WorkspaceLockSlot, String] {
  match self.extra_locks.get(target_ws) {
    Some(slot) => Ok(slot)
    None =>
    match self.load_lock_slot_from_db(target_ws) {
      Ok(loaded) => {
        self.extra_locks.set(target_ws, loaded)
        Ok(loaded)
      }
      Err(msg) => Err(msg)
    }
  }
}

fn ClientCore::restore_lock_state(self : ClientCore) -> Unit {
  match self.load_lock_slot_from_db(self.workspace) {
    Ok(slot) => {
      self.lock_state = slot.lock_state
      self.lock_root = slot.lock_root
      self.lock_kept_entries = slot.lock_kept_entries
      self.lock_kept_aside = slot.lock_kept_aside
      self.lock_seen = slot.lock_seen
      self.lock_corrupt = slot.lock_corrupt
      self.lock_read_pending = false
      self.lock_effective = slot.lock_effective
    }
    Err(_) => {
      self.lock_read_pending = true
    }
  }
}

/// Pin this workspace's lock genesis hash and persist it to SQLite `workspace_pref(ws, "lock")`.
/// Once pinned to `G` (or if persisted state is corrupt or unreadable), any attempt to re-pin is rejected.
pub fn ClientCore::pin_lock_root(self : ClientCore, genesis : String) -> Unit {
  if self.lock_read_pending {
    self.restore_lock_state()
    if self.lock_read_pending {
      self.outbox.tell(CoreEvent::LockRejected(self.workspace, "persisted lock state unreadable; refusing TOFU pin"))
      return
    }
  }
  if self.lock_corrupt {
    self.outbox.tell(CoreEvent::LockRejected(self.workspace, "corrupt persisted lock state; refusing TOFU reset"))
    return
  }
  if genesis.length() == 0 {
    return
  }
  match self.lock_root {
    Some(pinned) => {
      if pinned != genesis {
        self.outbox.tell(CoreEvent::LockRejected(self.workspace, "lock root already pinned to " + pinned + ", refusing " + genesis))
        return
      }
    }
    None => {
      match self.persist_lock_state_for_workspace(self.workspace, None, Some(genesis), [], [], self.lock_seen) {
        Ok(_) => {
          self.lock_root = Some(genesis)
        }
        Err(_) => ()
      }
    }
  }
}

pub fn ClientCore::is_lock_corrupt(self : ClientCore) -> Bool {
  self.lock_corrupt
}

pub fn ClientCore::pinned_lock_root(self : ClientCore) -> Option[String] {
  self.lock_root
}

pub fn ClientCore::lock_kept_entries(self : ClientCore) -> Array[form::Json] {
  self.lock_kept_entries
}

pub fn ClientCore::lock_kept_entries_for(self : ClientCore, workspace : String) -> Array[form::Json] {
  if workspace.length() == 0 || workspace == self.workspace {
    if self.lock_read_pending {
      self.restore_lock_state()
    }
    self.lock_kept_entries
  } else {
    match self.get_or_restore_extra_lock(workspace) {
      Ok(sl) => sl.lock_kept_entries
      Err(_) => []
    }
  }
}

pub fn ClientCore::lock_kept_aside(self : ClientCore) -> Array[form::Json] {
  self.lock_kept_aside
}

/// Validate and store the viewer's personal lock chain (`personal-lock-<hex(sub)>`) via `lock::fold_person`.
/// Rejects malformed or cryptographically invalid chains without overwriting existing state.
pub fn ClientCore::load_person_lock_json(
  self : ClientCore,
  raw : base_codec::Json,
  sub : String,
) -> Bool {
  if sub.length() == 0 {
    return false
  }
  match raw {
    base_codec::Json::Arr(xs) => {
      if xs.length() == 0 {
        return false
      }
      let form_entries : Array[form::Json] = []
      for i in 0..<xs.length() {
        form_entries.push(codec_to_form(xs[i]))
      }
      match lock::fold_person(form_entries, sub, native_lock_crypto()) {
        Ok(_) => {
          self.person_lock_entries = xs
          true
        }
        Err(_) => false
      }
    }
    _ => false
  }
}

/// Return the validated personal lock chain entries kept for `hello.lock.person`.
pub fn ClientCore::person_lock_kept_entries(self : ClientCore) -> Array[base_codec::Json] {
  self.person_lock_entries
}

/// Verify and apply a workspace lock chain natively via `pion/rules` (0 JSON boundary),
/// enforcing genesis root pinning, fork-choice merge (`lock::lock_chain` + `ASIDE_MOST = 256`),
/// anti-rollback protection, and persist-first TS-compatible `workspace_pref(ws, "lock")` persistence
/// (memory & `authGen`/`vaultGen` commit ONLY after SQLite write returns `Ok`).
pub fn ClientCore::apply_lock_chain(
  self : ClientCore,
  entries : Array[form::Json],
  root_hash : String,
  now : Option[Double] = None,
  workspace : String = "",
) -> Result[VerifiedWorkspaceLock, String] {
  let target_ws = if workspace.length() > 0 { workspace } else { self.workspace }
  self.apply_lock_chain_for_workspace(target_ws, entries, root_hash, now=now)
}

fn ClientCore::apply_lock_chain_for_workspace(
  self : ClientCore,
  target_ws : String,
  entries : Array[form::Json],
  root_hash : String,
  now : Option[Double] = None,
) -> Result[VerifiedWorkspaceLock, String] {
  let is_primary = target_ws == self.workspace
  let extra_slot_opt : Option[WorkspaceLockSlot] = if is_primary {
    if self.lock_read_pending {
      self.restore_lock_state()
      if self.lock_read_pending {
        let msg = "persisted lock state unreadable; refusing lock update"
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }
    }
    None
  } else {
    match self.get_or_restore_extra_lock(target_ws) {
      Ok(sl) => Some(sl)
      Err(msg) => {
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }
    }
  }
  let cur_corrupt = match extra_slot_opt {
    Some(sl) => sl.lock_corrupt
    None => self.lock_corrupt
  }
  let cur_root = match extra_slot_opt {
    Some(sl) => sl.lock_root
    None => self.lock_root
  }
  let cur_state = match extra_slot_opt {
    Some(sl) => sl.lock_state
    None => self.lock_state
  }
  let cur_kept_entries = match extra_slot_opt {
    Some(sl) => sl.lock_kept_entries
    None => self.lock_kept_entries
  }
  let cur_kept_aside = match extra_slot_opt {
    Some(sl) => sl.lock_kept_aside
    None => self.lock_kept_aside
  }
  let cur_seen = match extra_slot_opt {
    Some(sl) => sl.lock_seen
    None => self.lock_seen
  }

  // Law 0: Never degrade to TOFU when persisted lock state is corrupt.
  if cur_corrupt {
    let msg = "corrupt persisted lock state; refusing TOFU reset"
    self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
    return Err(msg)
  }
  // Law 1: Genesis root pinning (anti-hijack). Once pinned to `G`, never accept any other root.
  match cur_root {
    Some(pinned) => {
      if pinned != root_hash {
        let msg = "lock root mismatch: pinned to " + pinned + ", got " + root_hash
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }
    }
    None => ()
  }
  if entries.length() == 0 {
    let msg = "empty lock chain"
    self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
    return Err(msg)
  }

  let c = native_lock_crypto()
  let kept_hashes : Map[String, Bool] = Map::new()
  for i in 0..<cur_kept_entries.length() {
    let h = lock_entry_hash(cur_kept_entries[i], c)
    if h.length() > 0 {
      kept_hashes.set(h, true)
    }
  }
  for i in 0..<cur_kept_aside.length() {
    let h = lock_entry_hash(cur_kept_aside[i], c)
    if h.length() > 0 {
      kept_hashes.set(h, true)
    }
  }

  let seen : Map[String, Bool] = Map::new()
  let fresh : Array[form::Json] = []
  let mut max_incoming_seq = -1
  for i in 0..<entries.length() {
    let s = lock_entry_seq(entries[i])
    if s > max_incoming_seq {
      max_incoming_seq = s
    }
    let h = lock_entry_hash(entries[i], c)
    if h.length() == 0 || kept_hashes.get(h).is_some() || seen.get(h).is_some() {
      continue
    }
    seen.set(h, true)
    fresh.push(entries[i])
  }

  // Law 2a: Prefix rollback detection when all incoming entries are already known.
  // Re-delivering the current high-water head (e.g. `[e2]` with `max_incoming_seq == cur_seq`)
  // is a benign duplicate and returns `Ok` silently without emitting `LockRejected` or `LockUpdated`.
  if fresh.length() == 0 {
    match cur_state {
      Some(cur_st) => {
        let cur_seq = cur_st.seq.to_int()
        if max_incoming_seq < cur_seq {
          let msg = "lock rollback rejected: incoming max seq " + max_incoming_seq.to_string() + " < held seq " + cur_seq.to_string()
          self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
          return Err(msg)
        }
        return verify_workspace_lock(cur_kept_entries, root_hash, votes=lock::Votes::Roles, now=now)
      }
      None => {
        let msg = "no valid lock entries"
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }
    }
  }

  // Law 2b: Merge kept entries + kept aside + fresh entries and run `lock::lock_chain` fork choice.
  let all : Array[form::Json] = []
  for i in 0..<cur_kept_entries.length() {
    all.push(cur_kept_entries[i])
  }
  for i in 0..<cur_kept_aside.length() {
    all.push(cur_kept_aside[i])
  }
  for i in 0..<fresh.length() {
    all.push(fresh[i])
  }

  match verify_workspace_lock(all, root_hash, votes=lock::Votes::Roles, now=now) {
    Err(why) => {
      self.outbox.tell(CoreEvent::LockRejected(target_ws, why))
      Err(why)
    }
    Ok(v) => {
      if v.state.ws != target_ws {
        let msg = "lock workspace mismatch: expected " + target_ws + ", got " + v.state.ws
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }
      if v.state.genesis != root_hash {
        let msg = "lock genesis mismatch: expected " + root_hash + ", got " + v.state.genesis
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }

      let on_set : Map[String, Bool] = Map::new()
      for i in 0..<v.chain.hashes.length() {
        on_set.set(v.chain.hashes[i], true)
      }
      let off_by_hash : Map[String, lock::Off] = Map::new()
      for i in 0..<v.chain.off.length() {
        let (idx, why) = v.chain.off[i]
        let h = lock_entry_hash(all[idx], c)
        if h.length() > 0 {
          off_by_hash.set(h, why)
        }
      }
      let is_aside = fn(e : form::Json) -> Bool {
        let h = lock_entry_hash(e, c)
        match off_by_hash.get(h) {
          Some(o) => lock_is_aside_off(o)
          None => false
        }
      }

      // Align with `lock-keep.ts:89`: held chain entries may only leave for a rules-beaten branch.
      for i in 0..<cur_kept_entries.length() {
        let e = cur_kept_entries[i]
        let h = lock_entry_hash(e, c)
        if on_set.get(h).is_none() && !is_aside(e) {
          let msg = "the chain held does not hold by the rules"
          self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
          return Err(msg)
        }
      }

      // Retain aside entries up to ASIDE_MOST (256), pruning descendants of dropped entries (`lock-keep.ts:91-104`).
      let old_aside : Array[form::Json] = []
      for i in 0..<cur_kept_aside.length() {
        if is_aside(cur_kept_aside[i]) {
          old_aside.push(cur_kept_aside[i])
        }
      }
      for i in 0..<cur_kept_entries.length() {
        let e = cur_kept_entries[i]
        let h = lock_entry_hash(e, c)
        if on_set.get(h).is_none() && is_aside(e) {
          old_aside.push(e)
        }
      }

      let fresh_sorted : Array[form::Json] = []
      for i in 0..<fresh.length() {
        fresh_sorted.push(fresh[i])
      }
      lock_sort_by_seq(fresh_sorted)

      let mut room = lock_aside_most() - old_aside.length()
      let side_raw : Array[form::Json] = []
      for i in 0..<old_aside.length() {
        side_raw.push(old_aside[i])
      }
      for i in 0..<fresh_sorted.length() {
        let e = fresh_sorted[i]
        let h = lock_entry_hash(e, c)
        if on_set.get(h).is_some() || !is_aside(e) || room <= 0 {
          continue
        }
        side_raw.push(e)
        room -= 1
      }

      let side_trimmed : Array[form::Json] = []
      let start_idx = if side_raw.length() > lock_aside_most() { side_raw.length() - lock_aside_most() } else { 0 }
      for i in start_idx..<side_raw.length() {
        side_trimmed.push(side_raw[i])
      }

      let side_by_seq : Array[form::Json] = []
      for i in 0..<side_trimmed.length() {
        side_by_seq.push(side_trimmed[i])
      }
      lock_sort_by_seq(side_by_seq)
      let kept_now : Map[String, Bool] = Map::new()
      for i in 0..<v.chain.hashes.length() {
        kept_now.set(v.chain.hashes[i], true)
      }
      for i in 0..<side_by_seq.length() {
        let e = side_by_seq[i]
        match lock_entry_prev(e) {
          Some(p) => {
            if kept_now.get(p).is_some() {
              let h = lock_entry_hash(e, c)
              if h.length() > 0 {
                kept_now.set(h, true)
              }
            }
          }
          None => ()
        }
      }
      let final_aside : Array[form::Json] = []
      for i in 0..<side_trimmed.length() {
        let h = lock_entry_hash(side_trimmed[i], c)
        if kept_now.get(h).is_some() {
          final_aside.push(side_trimmed[i])
        }
      }

      // If we already hold a lock state and NONE of the fresh incoming entries entered the active
      // chain or aside (e.g. forged signatures `NotValid` OR spoofed `root: G` carrying a foreign
      // chain `NoParent`), emit LockRejected and return Err — NEVER emit LockUpdated!
      let active_same = lock_same_hash_seq(v.chain.entries, cur_kept_entries, c)
      let aside_same = lock_same_hash_seq(final_aside, cur_kept_aside, c)
      if cur_state.is_some() && active_same && aside_same {
        let msg = "incoming lock entries rejected (" + fresh.length().to_string() + " unaccepted, " + v.rejected_count.to_string() + " invalid)"
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }

      let now_secs = match now {
        Some(t) => t
        None => self.rt.now().to_double() / 1000.0
      }
      let eff_opt : Option[views::EffectiveLockState] = match views::effective_state(target_ws, v.chain.entries, [], [], now_secs, c) {
        Ok(eff) => Some(eff)
        Err(_) => None
      }

      // Persist to SQLite FIRST before mutating in-memory lock state, digests, or bumping authGen/vaultGen.
      // If SQLite fails, memory stays at the prior committed state so retrying the same head succeeds cleanly.
      match self.persist_lock_state_for_workspace(target_ws, Some(v.state), Some(v.state.genesis), v.chain.entries, final_aside, cur_seen) {
        Ok(_) => ()
        Err(msg) => return Err(msg)
      }

      match extra_slot_opt {
        Some(sl) => {
          sl.lock_root = Some(v.state.genesis)
          sl.lock_state = Some(v.state)
          sl.lock_kept_entries = v.chain.entries
          sl.lock_kept_aside = final_aside
          match eff_opt {
            Some(eff) => { sl.lock_effective = Some(eff) }
            None => ()
          }
        }
        None => {
          self.lock_root = Some(v.state.genesis)
          self.lock_state = Some(v.state)
          self.lock_kept_entries = v.chain.entries
          self.lock_kept_aside = final_aside
          match eff_opt {
            Some(eff) => { self.lock_effective = Some(eff) }
            None => ()
          }
        }
      }
      // Full-set canonical lock digest (disabled + rp_id + origins + sorted members + devices +
      // sign_keys + passkeys + signed + persons + gateways + cloud_keys + moved + stations,
      // excluding volatile `head`/`seq`).
      // Cold-start first verified lock seeds the digest without spuriously bumping `authGen`/`vaultGen`;
      // NEVER derive `revoked` from `lock.members`.
      let (new_full, new_sec) = canonical_lock_digest(v.state)
      let prev_full = self.lock_digest_by_ws.get(target_ws)
      let prev_sec = self.lock_sec_digest_by_ws.get(target_ws)
      self.lock_digest_by_ws.set(target_ws, new_full)
      self.lock_sec_digest_by_ws.set(target_ws, new_sec)
      let full_changed = match prev_full {
        Some(pf) => pf != new_full
        None => false
      }
      let sec_changed = match prev_sec {
        Some(ps) => ps != new_sec
        None => false
      }
      if full_changed {
        if sec_changed {
          let _ = self.auth.bump_workspace_and_vault(target_ws)
        } else {
          let _ = self.auth.bump_workspace(target_ws)
        }
      }
      self.outbox.tell(CoreEvent::LockUpdated(
        target_ws,
        v.state.head,
        v.state.seq,
        v.state.members.length(),
      ))
      Ok(v)
    }
  }
}

pub fn ClientCore::current_lock(self : ClientCore) -> Option[lock::LockState] {
  self.lock_state
}

/// Build the structured `lock.status` JSON payload for `workspace` (defaulting to `self.workspace`).
/// Law 3 (workspace isolation) + MembershipAuthority read gate: never leaks gated or foreign lock state.
pub fn ClientCore::lock_status_json(self : ClientCore, workspace : Option[String] = None) -> base_codec::Json {
  let target_ws = match workspace {
    Some(ws) => if ws.length() > 0 { ws } else { self.workspace }
    None => self.workspace
  }
  if !self.can_read_workspace(target_ws) {
    return base_codec::json_obj([
      ("workspace", base_codec::json_str(target_ws)),
      ("revoked", base_codec::json_bool(true)),
      ("gated", base_codec::json_bool(true)),
    ])
  }
  let state_opt = if target_ws == self.workspace {
    self.lock_state
  } else {
    match self.extra_locks.get(target_ws) {
      Some(sl) => sl.lock_state
      None => None
    }
  }
  match state_opt {
    None =>
    base_codec::json_obj([
      ("workspace", base_codec::json_str(target_ws)),
      ("locked", base_codec::json_bool(false)),
    ])
    Some(st) => {
      let moved_j = match st.moved {
        Some(m) => base_codec::json_str(m)
        None => base_codec::json_null()
      }
      base_codec::json_obj([
        ("workspace", base_codec::json_str(st.ws)),
        ("locked", base_codec::json_bool(!st.disabled)),
        ("disabled", base_codec::json_bool(st.disabled)),
        ("genesis", base_codec::json_str(st.genesis)),
        ("head", base_codec::json_str(st.head)),
        ("seq", base_codec::json_num(st.seq)),
        ("memberCount", base_codec::json_int(st.members.length())),
        ("deviceCount", base_codec::json_int(st.devices.length())),
        ("passkeyCount", base_codec::json_int(st.passkeys.length())),
        ("stationCount", base_codec::json_int(st.stations.length())),
        ("moved", moved_j),
      ])
    }
  }
}

pub fn ClientCore::running_session_count(self : ClientCore) -> Int {
  self.events.running_session_count()
}

pub fn ClientCore::open_job_count(self : ClientCore) -> Int {
  self.events.open_job_count()
}

fn ClientCore::handle_lock_event(self : ClientCore, payload : base_codec::Json) -> Unit {
  let _ = self.handle_lock_event_for_workspace(self.workspace, payload, sync_opt=Some(self.sync), station=self.station)
}

fn ClientCore::handle_lock_event_for_workspace(
  self : ClientCore,
  target_ws : String,
  payload : base_codec::Json,
  sync_opt : Option[SyncScheduler] = None,
  station : String = "",
) -> Result[Unit, String] {
  let _ = station
  match proto_str(payload, "workspace") {
    Some(ws) => {
      if ws.length() > 0 && ws != target_ws {
        return Ok(())
      }
    }
    None => ()
  }
  let raw_entries = match base_codec::json_get(payload, "entries") {
    Some(base_codec::Json::Arr(xs)) => xs
    _ => []
  }
  if raw_entries.length() == 0 {
    // Real station SSE `event: lock` notification (`station/src/mesh/lock-events.ts:27`) carries
    // `{ workspace, head }` without `entries`: trigger coalesced ungated `GET /lock` retry loop.
    if base_codec::json_get(payload, "head").is_some() {
      let target_sync : Option[SyncScheduler] = match sync_opt {
        Some(sy) => Some(sy)
        None => if target_ws == self.workspace { Some(self.sync) } else { None }
      }
      match target_sync {
        Some(sy) => sy.schedule_lock_refresh(self.rt)
        None => ()
      }
    }
    return Ok(())
  }
  let form_entries : Array[form::Json] = []
  for i in 0..<raw_entries.length() {
    form_entries.push(codec_to_form(raw_entries[i]))
  }
  match base_codec::json_get(payload, "aside") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        form_entries.push(codec_to_form(xs[i]))
      }
    }
    _ => ()
  }
  let head_genesis : Option[String] = match base_codec::json_get(payload, "head") {
    Some(hj) => proto_str(hj, "genesis")
    None => None
  }
  let existing_root = if target_ws == self.workspace {
    if self.lock_read_pending {
      self.restore_lock_state()
      if self.lock_read_pending {
        let msg = "persisted lock state unreadable; refusing lock event"
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }
    }
    self.lock_root
  } else {
    match self.get_or_restore_extra_lock(target_ws) {
      Ok(sl) => sl.lock_root
      Err(msg) => {
        self.outbox.tell(CoreEvent::LockRejected(target_ws, msg))
        return Err(msg)
      }
    }
  }
  let root = match proto_str(payload, "root") {
    Some(r) => if r.length() > 0 { r } else { "" }
    None =>
    match head_genesis {
      Some(g) => if g.length() > 0 { g } else { "" }
      None =>
      match existing_root {
        Some(r) => r
        None => {
          // Derive genesis root hash from seq=0 genesis entry on initial fetch/event
          let mut derived = ""
          let c = native_lock_crypto()
          for i in 0..<form_entries.length() {
            if lock_entry_seq(form_entries[i]) == 0 {
              match lock::entry_hash(form_entries[i], c) {
                Ok(h) => {
                  derived = h
                  break
                }
                Err(_) => ()
              }
            }
          }
          derived
        }
      }
    }
  }
  if root.length() == 0 {
    return Err("missing lock root")
  }
  match self.apply_lock_chain_for_workspace(target_ws, form_entries, root) {
    Ok(_) => Ok(())
    Err(msg) => Err(msg)
  }
}

/// Verify frozen enqueue-time outbox metadata against current workspace/station authorization
/// and purge-only generation counter (`workspace_purge_gen`):
/// - Rejects unauthenticated / invalidated sessions.
/// - Rejects any revoked workspace (`can_read_workspace(meta.ws)`) or revoked station (`can_read_station(meta.station)`).
/// - Rejects any pre-purge frame (`meta.purge_gen != workspace_purge_gen_of(meta.ws)`) even after same-turn rejoin,
///   while allowing frames enqueued before a normal lock/role `authGen` bump to deliver normally!
pub fn ClientCore::can_deliver_outbox_meta(self : ClientCore, meta : outbox::OutboxMeta) -> Bool {
  if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
    return false
  }
  if meta.ws.length() > 0 {
    if !self.can_read_workspace(meta.ws) {
      return false
    }
    if self.membership.workspace_purge_gen_of(meta.ws) != meta.purge_gen {
      return false
    }
  }
  if meta.station.length() > 0 && !self.can_read_station(meta.station) {
    return false
  }
  true
}

/// Drain strongly typed `CoreEvent`s for the UI render thread (zero serialization).
/// Never emits queued events while unauthenticated, session-invalidated, for any
/// revoked workspace/station (including workspace-scoped `LockUpdated`/`LockRejected`),
/// or for any frame enqueued before a workspace purge (`workspace_purge_gen` mismatch).
pub fn ClientCore::drain_frame(self : ClientCore, most : Option[Int] = None) -> Array[CoreEvent] {
  if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
    self.outbox.clear()
    return []
  }
  let raw = self.outbox.take_with_meta(most=most)
  let out : Array[CoreEvent] = []
  for i in 0..<raw.length() {
    let (ev, meta) = raw[i]
    if self.can_deliver_outbox_meta(meta) {
      out.push(ev)
    }
  }
  out
}

// ── Thin JSON `core_api.h` protocol adapter ──

fn proto_str(j : base_codec::Json, k : String) -> Option[String] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Str(s)) => Some(s)
    _ => None
  }
}

fn proto_int(j : base_codec::Json, k : String) -> Option[Int] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, _)) => Some(n.to_int())
    _ => None
  }
}

/// Handle a `protocol::CoreRequest` across both Slice 1 read-only queries and Slice 2 sync/outbox commands.
/// Enforces the single unified `MembershipAuthority` O(1) read gate on ALL direct-read and mutation RPCs.
pub fn ClientCore::handle_request(self : ClientCore, req : protocol::CoreRequest) -> Option[protocol::CoreEvent] {
  match req {
    protocol::CoreRequest::Call(id, call_name, params, bytes) => {
      // Unified O(1) read gate for `composer.*` RPCs:
      // - Handles `new:<ws>` as workspace-scoped (NEVER as bare station falling back to `self.workspace`!).
      // - Resolves moved chat destinations and authorizes BOTH input and final target.
      // - For `composer.carry(key, to)`: authorizes BOTH `key` (source) AND `to` (destination)!
      // - For `composer.add(key, station, files)`: authorizes `key`, `station`, and file `ref.station`.
      if call_name.starts_with("composer.") {
        match proto_str(params, "key") {
          Some(k) => if !self.can_read_draft_target(Some(k), "", "") {
            return Some(protocol::CoreEvent::Err(id, self.gate_err()))
          }
          None => if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
            return Some(protocol::CoreEvent::Err(id, self.gate_err()))
          }
        }
        match proto_str(params, "station") {
          Some(s) => if s.length() > 0 && !self.can_read_station(s) {
            return Some(protocol::CoreEvent::Err(id, self.gate_err()))
          }
          None => ()
        }
        if call_name == "composer.carry" {
          match proto_str(params, "to") {
            Some(to_k) => if !self.can_read_draft_target(Some(to_k), "", "") {
              return Some(protocol::CoreEvent::Err(id, self.gate_err()))
            }
            None => ()
          }
        }
        if call_name == "composer.add" {
          match base_codec::json_get(params, "files") {
            Some(base_codec::Json::Arr(xs)) => {
              for fi in 0..<xs.length() {
                match base_codec::json_get(xs[fi], "ref") {
                  Some(rj) => match proto_str(rj, "station") {
                    Some(rst) => if rst.length() > 0 && !self.can_read_station(rst) {
                      return Some(protocol::CoreEvent::Err(id, self.gate_err()))
                    }
                    None => ()
                  }
                  None => ()
                }
              }
            }
            _ => ()
          }
        }
      }
      if call_name == "workspace.get" {
        let ws = match proto_str(params, "workspace") {
          Some(s) => if s.length() > 0 { s } else { self.workspace }
          None => match proto_str(params, "id") {
            Some(s) => if s.length() > 0 { s } else { self.workspace }
            None => match proto_str(params, "scope") {
              Some(s) => if s.length() > 0 { s } else { self.workspace }
              None => self.workspace
            }
          }
        }
        if !self.can_read_workspace(ws) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
        match store::get_workspace(self.db, ws) {
          sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
          sql::SqlResult::Ok(None) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
          sql::SqlResult::Ok(Some(row)) => {
            let doc = match base_codec::json_parse(row.json) {
              base_codec::JsonParseResult::Ok(j) => j
              base_codec::JsonParseResult::Err(_) => base_codec::json_str(row.json)
            }
            let conf = match row.confirmed {
              Some(ts) => base_codec::json_int64(ts)
              None => base_codec::json_null()
            }
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
              ("id", base_codec::json_str(row.id)),
              ("doc", doc),
              ("confirmed", conf),
            ]), None))
          }
        }
      }
      if call_name == "workspaces.list" {
        if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("workspaces", base_codec::json_arr([]))]), None))
        }
        match store::list_workspaces(self.db) {
          sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
          sql::SqlResult::Ok(rows) => {
            let items : Array[base_codec::Json] = []
            for i in 0..<rows.length() {
              let r = rows[i]
              if !self.can_read_workspace(r.id) {
                continue
              }
              let doc = match base_codec::json_parse(r.json) {
                base_codec::JsonParseResult::Ok(j) => j
                base_codec::JsonParseResult::Err(_) => base_codec::json_str(r.json)
              }
              let conf = match r.confirmed {
                Some(ts) => base_codec::json_int64(ts)
                None => base_codec::json_null()
              }
              items.push(base_codec::json_obj([
                ("id", base_codec::json_str(r.id)),
                ("doc", doc),
                ("confirmed", conf),
              ]))
            }
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("workspaces", base_codec::json_arr(items))]), None))
          }
        }
      }
      if call_name == "chat.open" {
        let req_st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        let req_th = proto_int(params, "thread")
        let req_sess = proto_str(params, "session")
        let (final_st, _, _) = match self.resolve_consistent_chat_target(req_st, req_th, req_sess) {
          Ok(t) => t
          Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "chat_selector_mismatch", message: msg }))
        }
        if !self.can_read_station(req_st) || !self.can_read_station(final_st) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
      }
      if call_name == "chats.window" {
        let allowed_sts : Array[base_codec::Json] = []
        match base_codec::json_get(params, "stations") {
          Some(base_codec::Json::Arr(arr)) => {
            for i in 0..<arr.length() {
              match arr[i] {
                base_codec::Json::Str(s) => if self.can_read_station(s) {
                  allowed_sts.push(base_codec::json_str(s))
                }
                _ => ()
              }
            }
          }
          _ => {
            if self.can_read_station(self.station) {
              allowed_sts.push(base_codec::json_str(self.station))
            }
          }
        }
        if allowed_sts.length() == 0 {
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("rows", base_codec::json_arr([]))]), None))
        }
        let gated_params = j_set_field(params, "stations", base_codec::json_arr(allowed_sts))
        return self.router.handle(protocol::CoreRequest::Call(id, call_name, gated_params, bytes))
      }
      if call_name == "stations.list" {
        let ws_scope = match proto_str(params, "workspace") {
          Some(w) => w
          None => match proto_str(params, "scope") {
            Some(sc) => sc
            None => ""
          }
        }
        if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() || (ws_scope.length() > 0 && !self.can_read_workspace(ws_scope)) {
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("stations", base_codec::json_arr([]))]), None))
        }
        match self.router.handle(req) {
          Some(protocol::CoreEvent::Ok(_, payload, b)) => {
            let filtered : Array[base_codec::Json] = []
            match base_codec::json_get(payload, "stations") {
              Some(base_codec::Json::Arr(xs)) => {
                for i in 0..<xs.length() {
                  let addr = j_str(xs[i], "address")
                  if self.can_read_station(addr) {
                    filtered.push(xs[i])
                  }
                }
              }
              _ => ()
            }
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("stations", base_codec::json_arr(filtered))]), b))
          }
          other => return other
        }
      }
      if call_name == "vault.secrets" {
        let explicit_ws = proto_str(params, "workspace")
        match explicit_ws {
          Some(ws) => if ws.length() > 0 && !self.can_read_workspace(ws) {
            return Some(protocol::CoreEvent::Err(id, self.gate_err()))
          }
          None => if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
            return Some(protocol::CoreEvent::Err(id, self.gate_err()))
          }
        }
        match self.router.handle(req) {
          Some(protocol::CoreEvent::Ok(_, payload, b)) => {
            let filtered : Array[base_codec::Json] = []
            match base_codec::json_get(payload, "secrets") {
              Some(base_codec::Json::Arr(xs)) => {
                for i in 0..<xs.length() {
                  let item = xs[i]
                  let item_ws = match proto_str(item, "workspace") { Some(w) => w; None => "" }
                  let item_vault = match proto_str(item, "vault") { Some(v) => v; None => "" }
                  let allowed = if item_ws.length() > 0 {
                    self.can_read_workspace(item_ws) &&
                    match explicit_ws {
                      Some(want_w) => want_w.length() == 0 || item_ws == want_w
                      None => true
                    }
                  } else {
                    item_vault == "personal" &&
                    !self.membership.is_unauthenticated() &&
                    !self.membership.is_session_invalidated() &&
                    match explicit_ws {
                      Some(want_w) => want_w.length() == 0
                      None => true
                    }
                  }
                  if allowed {
                    filtered.push(item)
                  }
                }
              }
              _ => ()
            }
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("secrets", base_codec::json_arr(filtered))]), b))
          }
          other => return other
        }
      }
      if call_name == "account.doc" {
        let doc_name = match proto_str(params, "name") {
          Some(s) => s
          None => ""
        }
        if self.membership.is_unauthenticated() {
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
        }
        if self.membership.is_session_invalidated() {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "access_revoked", message: "session invalidated" }))
        }
        if doc_name.starts_with("usage:") {
          let ws = doc_name.slice(6, doc_name.length())
          if !self.can_read_workspace(ws) {
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
          }
        } else if doc_name.starts_with("vaults:") {
          let ws = doc_name.slice(7, doc_name.length())
          if !self.can_read_workspace(ws) {
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
          }
        } else if doc_name == "vault_secrets" {
          match store::get_account_doc(self.db, "vault_secrets") {
            sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
            sql::SqlResult::Ok(None) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
            sql::SqlResult::Ok(Some(raw)) => match base_codec::json_parse(raw) {
              base_codec::JsonParseResult::Ok(doc) => {
                let filter_arr = fn(xs : Array[base_codec::Json]) -> Array[base_codec::Json] {
                  let kept : Array[base_codec::Json] = []
                  for i in 0..<xs.length() {
                    let it_ws = j_str(xs[i], "workspace")
                    let it_vault = j_str(xs[i], "vault")
                    let allowed = if it_ws.length() > 0 {
                      self.can_read_workspace(it_ws)
                    } else {
                      it_vault == "personal" && !self.membership.is_session_invalidated()
                    }
                    if allowed {
                      kept.push(xs[i])
                    }
                  }
                  kept
                }
                match doc {
                  base_codec::Json::Arr(xs) => {
                    return Some(protocol::CoreEvent::Ok(id, base_codec::json_arr(filter_arr(xs)), None))
                  }
                  base_codec::Json::Obj(fs) => {
                    let out_fs : Array[(String, base_codec::Json)] = []
                    for i in 0..<fs.length() {
                      let (k, v) = fs[i]
                      if k == "secrets" {
                        match v {
                          base_codec::Json::Arr(xs) => out_fs.push((k, base_codec::json_arr(filter_arr(xs))))
                          _ => out_fs.push((k, base_codec::json_arr([])))
                        }
                      } else {
                        out_fs.push((k, v))
                      }
                    }
                    return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj(out_fs), None))
                  }
                  _ => return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
                }
              }
              base_codec::JsonParseResult::Err(_) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
            }
          }
        } else if doc_name == "me" {
          match store::get_account_doc(self.db, "me") {
            sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
            sql::SqlResult::Ok(None) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
            sql::SqlResult::Ok(Some(raw)) => match base_codec::json_parse(raw) {
              base_codec::JsonParseResult::Ok(base_codec::Json::Obj(fs)) => {
                let out_fs : Array[(String, base_codec::Json)] = []
                for i in 0..<fs.length() {
                  let (k, v) = fs[i]
                  if k == "workspaces" {
                    match v {
                      base_codec::Json::Arr(xs) => {
                        let kept_ws : Array[base_codec::Json] = []
                        for j in 0..<xs.length() {
                          let wid = j_str(xs[j], "id")
                          if wid.length() == 0 || self.can_read_workspace(wid) {
                            kept_ws.push(xs[j])
                          }
                        }
                        out_fs.push((k, base_codec::json_arr(kept_ws)))
                      }
                      _ => out_fs.push((k, v))
                    }
                  } else {
                    out_fs.push((k, v))
                  }
                }
                return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj(out_fs), None))
              }
              base_codec::JsonParseResult::Ok(other) => return Some(protocol::CoreEvent::Ok(id, other, None))
              base_codec::JsonParseResult::Err(_) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_str(raw), None))
            }
          }
        }
      }
      if call_name == "chat.draft" {
        let raw_st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        let chat = match proto_str(params, "chat") {
          Some(c) => c
          None => ""
        }
        if !self.can_read_draft_target(None, raw_st, chat) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
      }
      if call_name == "settings.get" || call_name == "settings.set" {
        let explicit_ws = match proto_str(params, "workspace") {
          Some(w) => if w.length() > 0 { Some(w) } else { None }
          None => match proto_str(params, "scope") {
            Some(sc) => if sc.length() > 0 { Some(sc) } else { None }
            None => None
          }
        }
        match explicit_ws {
          Some(ws) => if !self.can_read_workspace(ws) {
            return Some(protocol::CoreEvent::Err(id, self.gate_err()))
          }
          None => {
            // Unscoped device-level settings on ephemeral `:memory:` DB during unauthenticated smoke boot
            // remain allowed (zero on-disk private data); invalidated/revoked workspaces stay blocked!
            if !self.membership.is_unauthenticated() && !self.can_read_workspace(self.workspace) {
              return Some(protocol::CoreEvent::Err(id, self.gate_err()))
            }
          }
        }
      }
      if call_name == "search.chats" {
        let allowed_sts : Array[base_codec::Json] = []
        match base_codec::json_get(params, "stations") {
          Some(base_codec::Json::Arr(arr)) => {
            for i in 0..<arr.length() {
              match arr[i] {
                base_codec::Json::Str(s) => if self.can_read_station(s) {
                  allowed_sts.push(base_codec::json_str(s))
                }
                _ => ()
              }
            }
          }
          _ => {
            let st = match proto_str(params, "station") {
              Some(s) => if s.length() > 0 { s } else { self.station }
              None => self.station
            }
            if self.can_read_station(st) {
              allowed_sts.push(base_codec::json_str(st))
            }
          }
        }
        if allowed_sts.length() == 0 {
          let q = match proto_str(params, "query") { Some(s) => s; None => match proto_str(params, "q") { Some(s) => s; None => "" } }
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
            ("query", base_codec::json_str(q)),
            ("items", base_codec::json_arr([])),
          ]), None))
        }
        let gated_params = j_set_field(params, "stations", base_codec::json_arr(allowed_sts))
        return self.router.handle(protocol::CoreRequest::Call(id, call_name, gated_params, bytes))
      }
      if call_name == "search.messages" {
        if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
          let q = match proto_str(params, "query") { Some(s) => s; None => match proto_str(params, "q") { Some(s) => s; None => "" } }
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
            ("query", base_codec::json_str(q)),
            ("messages", base_codec::json_arr([])),
          ]), None))
        }
        match proto_str(params, "station") {
          Some(st) => if st.length() > 0 && !self.can_read_station(st) {
            let q = match proto_str(params, "query") { Some(s) => s; None => match proto_str(params, "q") { Some(s) => s; None => "" } }
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
              ("query", base_codec::json_str(q)),
              ("messages", base_codec::json_arr([])),
            ]), None))
          }
          None => ()
        }
        match self.router.handle(req) {
          Some(protocol::CoreEvent::Ok(_, payload, b)) => {
            let q = j_str(payload, "query")
            let filtered : Array[base_codec::Json] = []
            match base_codec::json_get(payload, "messages") {
              Some(base_codec::Json::Arr(xs)) => {
                for i in 0..<xs.length() {
                  if self.can_read_station(j_str(xs[i], "station")) {
                    filtered.push(xs[i])
                  }
                }
              }
              _ => ()
            }
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
              ("query", base_codec::json_str(q)),
              ("messages", base_codec::json_arr(filtered)),
            ]), b))
          }
          other => return other
        }
      }
      if call_name == "client.focus" {
        match proto_int(params, "thread") {
          Some(th) => {
            self.focus_chat(th)
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_bool(true), None))
          }
          None => {
            self.sync.focus_thread(None)
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_bool(true), None))
          }
        }
      }
      if call_name == "chat.send" {
        let target_st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        if !self.can_read_station(target_st) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
        let th = match proto_int(params, "thread") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing thread" }))
        }
        let ck = match proto_str(params, "idem") {
          Some(s) => s
          None =>
          match proto_str(params, "clientKey") {
            Some(s) => s
            None => "idem-" + id.to_string() + "-" + self.rt.now().to_string()
          }
        }
        let author = match proto_str(params, "author") {
          Some(s) => s
          None => if self.viewer_marks.me.length() > 0 { self.viewer_marks.me } else { "me" }
        }
        let text = match proto_str(params, "text") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing text" }))
        }
        let attachments = base_codec::json_get(params, "attachments")
        let quotes = base_codec::json_get(params, "quotes")
        let client_opt = base_codec::json_get(params, "client")
        let cc_opt = base_codec::json_get(params, "cc")
        match self.local_outbox.send_message(
          self.rt,
          th,
          ck,
          author,
          text,
          self.rt.now(),
          station=Some(target_st),
          attachments=attachments,
          quotes=quotes,
          client=client_opt,
          cc=cc_opt,
        ) {
          sql::SqlResult::Ok(_) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("station", base_codec::json_str(target_st)), ("queued", base_codec::json_bool(true)), ("clientKey", base_codec::json_str(ck)), ("idem", base_codec::json_str(ck))]), None))
          sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
        }
      }
      if call_name == "decision.answer" {
        let target_st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        if !self.can_read_station(target_st) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
        let th = match proto_int(params, "thread") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing thread" }))
        }
        let seq = match proto_int(params, "seq") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing seq" }))
        }
        let option = match proto_str(params, "option") {
          Some(o) => o
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing option" }))
        }
        let action = match proto_str(params, "action") {
          Some(a) => a
          None => "reply"
        }
        if action == "close" {
          let close_params = base_codec::json_obj([
            ("station", base_codec::json_str(target_st)),
            ("thread", base_codec::json_int(th)),
            ("seq", base_codec::json_int(seq)),
            ("option", base_codec::json_str(option)),
          ])
          match self.perform_op("decision.close", close_params, chat_id="thread:" + th.to_string()) {
            Ok(op_id) =>
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
              ("station", base_codec::json_str(target_st)),
              ("opId", base_codec::json_int(op_id)),
              ("thread", base_codec::json_int(th)),
              ("seq", base_codec::json_int(seq)),
              ("option", base_codec::json_str(option)),
              ("action", base_codec::json_str("close")),
            ]), None))
            Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "op_error", message: msg }))
          }
        }
        // Station `hub.ts:758-776` recognizes a card answer ONLY via `quotes: [{ ts }]`!
        let card_ts = match proto_str(params, "ts") {
          Some(s) => if s.length() > 0 { Some(s) } else { None }
          None =>
          match store::get_entry_json(self.db, target_st, th, seq) {
            sql::SqlResult::Ok(Some(raw_e)) =>
            match base_codec::json_parse(raw_e) {
              base_codec::JsonParseResult::Ok(ej) => proto_str(ej, "ts")
              base_codec::JsonParseResult::Err(_) => None
            }
            _ => None
          }
        }
        let quotes_opt = match card_ts {
          Some(ts_s) => Some(base_codec::json_arr([base_codec::json_obj([("ts", base_codec::json_str(ts_s))])]))
          None => base_codec::json_get(params, "quotes")
        }
        let ck = match proto_str(params, "idem") {
          Some(s) => s
          None => "card-" + th.to_string() + "-" + seq.to_string() + "-" + id.to_string()
        }
        let author = if self.viewer_marks.me.length() > 0 { self.viewer_marks.me } else { "me" }
        match self.local_outbox.send_message(
          self.rt,
          th,
          ck,
          author,
          option,
          self.rt.now(),
          station=Some(target_st),
          quotes=quotes_opt,
        ) {
          sql::SqlResult::Ok(_) =>
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
            ("station", base_codec::json_str(target_st)),
            ("queued", base_codec::json_bool(true)),
            ("thread", base_codec::json_int(th)),
            ("seq", base_codec::json_int(seq)),
            ("option", base_codec::json_str(option)),
            ("action", base_codec::json_str("reply")),
          ]), None))
          sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
        }
      }
      if call_name == "chat.read" {
        let target_st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        if !self.can_read_station(target_st) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
        let th = match proto_int(params, "thread") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing thread" }))
        }
        let read_seq = match proto_int(params, "seq") {
          Some(s) => s
          None =>
          match proto_int(params, "n") {
            Some(n) => n
            None =>
            match proto_int(params, "read") {
              Some(r) => r
              None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing seq" }))
            }
          }
        }
        let unread = match proto_int(params, "unread") {
          Some(u) => u
          None => 0
        }
        match self.mark_chat_read(th, read_seq, unread_count=unread, station=Some(target_st)) {
          sql::SqlResult::Ok(_) =>
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
            ("station", base_codec::json_str(target_st)),
            ("thread", base_codec::json_int(th)),
            ("read", base_codec::json_int(read_seq)),
            ("unread", base_codec::json_int(unread)),
          ]), None))
          sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
        }
      }
      let op_probe = {
        let enriched = match base_codec::json_get(params, "station") {
          Some(base_codec::Json::Str(s)) => if s.length() > 0 { params } else { j_set_field(params, "station", base_codec::json_str(self.station)) }
          _ => j_set_field(params, "station", base_codec::json_str(self.station))
        }
        ops_request(call_name, enriched)
      }
      match op_probe {
        OpResult::Invalid(msg) =>
        return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: msg }))
        OpResult::Ok(req) => {
          match req.target {
            OpTarget::Cloud(acc) =>
            return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
              code: "cloud_transport_required",
              message: "cloud_op_requires_cloud_transport: " + call_name + " (account=" + acc + ")",
            }))
            OpTarget::Station(st_target) => {
              if !self.can_read_station(st_target) {
                return Some(protocol::CoreEvent::Err(id, self.gate_err()))
              }
            }
          }
          if req.method == "GET" {
            return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
              code: "read_op_not_mutation",
              message: "read-only GET op cannot be queued in local_outbox: " + call_name,
            }))
          }
          let chat_id = match proto_str(params, "session") {
            Some(s) => s
            None =>
            match proto_str(params, "key") {
              Some(s) => s
              None =>
              match proto_str(params, "id") {
                Some(s) => s
                None =>
                match proto_int(params, "thread") {
                  Some(th) => "thread:" + th.to_string()
                  None => ""
                }
              }
            }
          }
          match self.perform_op(call_name, params, chat_id=chat_id) {
            Ok(op_id) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("opId", base_codec::json_int(op_id))]), None))
            Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: msg }))
          }
        }
        OpResult::Unknown => ()
      }
      if call_name == "lock.status" {
        let req_ws = match proto_str(params, "workspace") {
          Some(s) => Some(s)
          None => proto_str(params, "scope")
        }
        let eff_ws = match req_ws {
          Some(w) => if w.length() > 0 { w } else { self.workspace }
          None => self.workspace
        }
        if !self.can_read_workspace(eff_ws) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
        return Some(protocol::CoreEvent::Ok(id, self.lock_status_json(workspace=req_ws), None))
      }
      if call_name == "sessions.list" {
        if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() || !self.can_read_station(self.station) {
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("sessions", base_codec::json_arr([]))]), None))
        }
        let all = self.events.all_sessions()
        let items : Array[base_codec::Json] = []
        for i in 0..<all.length() {
          let s = all[i]
          items.push(base_codec::json_obj([
            ("key", base_codec::json_str(s.key)),
            ("running", base_codec::json_bool(s.running)),
            ("listed", base_codec::json_bool(s.listed)),
          ]))
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("sessions", base_codec::json_arr(items))]), None))
      }
      if call_name == "jobs.open" {
        if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() || !self.can_read_station(self.station) {
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("jobs", base_codec::json_arr([]))]), None))
        }
        let open_list = self.events.open_jobs()
        let items : Array[base_codec::Json] = []
        for i in 0..<open_list.length() {
          let j = open_list[i]
          let chat_j = match j.chat {
            Some(c) => base_codec::json_str(c)
            None => base_codec::json_null()
          }
          items.push(base_codec::json_obj([
            ("id", base_codec::json_str(j.id)),
            ("open", base_codec::json_bool(j.open)),
            ("chat", chat_j),
          ]))
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("jobs", base_codec::json_arr(items))]), None))
      }
      // ── Batch 2 calls: auth / vault / preset / download ──
      if call_name == "auth.begin" {
        self.auth_seq += 1
        let redirect_uri = match proto_str(params, "redirect_uri") {
          Some(s) => s
          None =>
          match proto_str(params, "redirectUri") {
            Some(s) => s
            None => "stillfail://auth/callback"
          }
        }
        let return_to = match proto_str(params, "return_to") {
          Some(s) => s
          None =>
          match proto_str(params, "returnTo") {
            Some(s) => s
            None => "/"
          }
        }
        let origin = match proto_str(params, "cloud_origin") {
          Some(s) => if s.length() > 0 { s } else { self.cloud_origin }
          None =>
          match proto_str(params, "origin") {
            Some(s) => if s.length() > 0 { s } else { self.cloud_origin }
            None => self.cloud_origin
          }
        }
        let device_name = match proto_str(params, "device_name") {
          Some(s) => s
          None =>
          match proto_str(params, "name") {
            Some(s) => s
            None => "still.fail"
          }
        }
        let seed_str = self.workspace + ":" + self.station + ":" + self.auth_seq.to_string() + ":" + self.rt.now().to_string() + ":" + redirect_uri
        let entropy_hex = base_codec::hex_encode(self.db.shell.random(32))
        let state_tok = crypto::sha256_hex(("state:" + entropy_hex + ":" + seed_str).to_bytes()).slice(0, 32)
        let verifier = base_codec::base64url_encode(crypto::sha256(("pkce:" + entropy_hex + ":" + seed_str).to_bytes()))
        let url = self.login_flow.begin_oauth(origin, state_tok, verifier, redirect_uri, return_to, device_name)
        // NEVER expose PKCE `verifier`!
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
          ("url", base_codec::json_str(url)),
          ("state", base_codec::json_str(state_tok)),
        ]), None))
      }
      if call_name == "auth.complete" {
        let outcome = match proto_str(params, "query") {
          Some(q) => self.login_flow.complete_oauth_query(q)
          None => {
            let cb_state = match proto_str(params, "state") {
              Some(s) => s
              None => ""
            }
            let code = proto_str(params, "code")
            let err_opt = proto_str(params, "error")
            self.login_flow.complete_oauth_callback(cb_state, code, err_opt)
          }
        }
        if !outcome.ok {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
            code: outcome.error_code,
            message: outcome.recovery_hint,
          }))
        }
        let sub = match proto_str(params, "sub") { Some(s) => s; None => "" }
        let email = match proto_str(params, "email") { Some(s) => s; None => "" }
        if sub.length() > 0 && email.length() > 0 {
          // Enforce immutable account/DB binding BEFORE mutating auth_store, viewer, or account_doc!
          match self.db_account_sub {
            Some(existing) => if existing != sub {
              return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "account_sub_mismatch",
                message: "account_sub_mismatch: expected " + existing + ", got " + sub,
              }))
            }
            None => ()
          }
          let name = match proto_str(params, "name") { Some(s) => s; None => email }
          let picture = match proto_str(params, "picture") { Some(s) => s; None => "" }
          let access = match proto_str(params, "access") { Some(s) => s; None => "" }
          let refresh = match proto_str(params, "refresh") { Some(s) => s; None => "" }
          // TS `accounts.ts:10, 299` stores `access_expires` in Unix epoch SECONDS.
          let exp = match base_codec::json_get(params, "access_expires") {
            Some(base_codec::Json::Num(n, _)) => n.to_int64()
            _ => match base_codec::json_get(params, "accessExpires") {
              Some(base_codec::Json::Num(n, _)) => n.to_int64()
              _ => (self.rt.now() / 1000L) + 3600L
            }
          }
          let new_acct = views::StoredAccount::{
            sub: sub,
            email: email,
            name: name,
            picture: picture,
            access: access,
            refresh: refresh,
            access_expires: exp,
          }
          // Build candidate accounts snapshot with the active signed-in account at index 0
          // and persist BEFORE mutating auth_store or opening gate!
          let cand_accounts : Array[views::StoredAccount] = [new_acct]
          for i in 0..<self.auth_store.accounts.length() {
            if self.auth_store.accounts[i].sub != sub {
              cand_accounts.push(self.auth_store.accounts[i])
            }
          }
          let cand_sessions : Map[String, String] = Map::new()
          let sks = self.account_sessions.keys()
          for i in 0..<sks.length() {
            match self.account_sessions.get(sks[i]) {
              Some(v) => cand_sessions.set(sks[i], v)
              None => ()
            }
          }
          match proto_str(params, "session") {
            Some(sid) => if sid.length() > 0 { cand_sessions.set(sub, sid) }
            None => ()
          }
          let persisted = serialize_stored_accounts(cand_accounts, sessions=Some(cand_sessions))
          match self.on_accounts_persisted {
            Some(hook) => match hook(persisted) {
              Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "storage_error",
                message: msg,
              }))
              Ok(_) => ()
            }
            None => ()
          }
          match proto_str(params, "session") {
            Some(sid) => if sid.length() > 0 { self.account_sessions.set(sub, sid) }
            None => ()
          }
          if access.length() > 0 {
            self.membership.clear_session_invalidated()
            self.membership.set_unauthenticated(false)
          }
          self.auth_store.register_account(new_acct)
          self.set_viewer(email, sub=sub)
          self.login_flow.mark_completed(sub, outcome.return_to)
          let _ = store::put_account_doc(self.db, "accounts", base_codec::json_stringify(views::project_accounts_topic(self.auth_store)))
        }
        // NEVER expose `verifier`, `access`, or `refresh`!
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
          ("ok", base_codec::json_bool(true)),
          ("returnTo", base_codec::json_str(outcome.return_to)),
          ("state", self.login_flow.to_json()),
        ]), None))
      }
      if call_name == "auth.cancel" {
        self.login_flow.cancel()
        return Some(protocol::CoreEvent::Ok(id, self.login_flow.to_json(), None))
      }
      if call_name == "vault.approve" {
        let req_id = match proto_str(params, "request") {
          Some(s) => s
          None =>
          match proto_str(params, "id") {
            Some(s) => s
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing request" }))
          }
        }
        let grant_scope = match proto_str(params, "scope") {
          Some(s) => s
          None => "once"
        }
        match self.vault_approvals.approve(req_id, grant_scope, self.rt.now()) {
          Ok(_) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
            ("id", base_codec::json_str(req_id)),
            ("status", base_codec::json_str("granted")),
            ("scope", base_codec::json_str(grant_scope)),
          ]), None))
          Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "vault_error", message: msg }))
        }
      }
      if call_name == "vault.deny" {
        let req_id = match proto_str(params, "request") {
          Some(s) => s
          None =>
          match proto_str(params, "id") {
            Some(s) => s
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing request" }))
          }
        }
        let note = match proto_str(params, "note") {
          Some(s) => Some(s)
          None => proto_str(params, "reason")
        }
        match self.vault_approvals.deny(req_id, self.rt.now(), note=note) {
          Ok(_) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
            ("id", base_codec::json_str(req_id)),
            ("status", base_codec::json_str("denied")),
          ]), None))
          Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "vault_error", message: msg }))
        }
      }
      if call_name == "vault.withdraw" {
        let req_id = match proto_str(params, "request") {
          Some(s) => s
          None =>
          match proto_str(params, "id") {
            Some(s) => s
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing request" }))
          }
        }
        let ok = self.vault_approvals.withdraw(req_id)
        if ok {
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
            ("id", base_codec::json_str(req_id)),
            ("status", base_codec::json_str("withdrawn")),
          ]), None))
        }
        return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "not_found", message: "pending request not found" }))
      }
      if call_name == "preset.copy" {
        let src_id = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let mut found : Option[views::PresetRecord] = None
        for i in 0..<self.other_presets_held.length() {
          if self.other_presets_held[i].id == src_id {
            found = Some(self.other_presets_held[i])
            break
          }
        }
        if found.is_none() {
          for i in 0..<self.presets_held.length() {
            if self.presets_held[i].id == src_id {
              found = Some(self.presets_held[i])
              break
            }
          }
        }
        match found {
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "not_found", message: "preset not found" }))
          Some(src) => {
            let new_id = match proto_str(params, "newId") {
              Some(s) => s
              None => src.id + "-copy-" + self.rt.now().to_string()
            }
            let new_name = proto_str(params, "name")
            let copied = views::copy_preset(
              src,
              new_id,
              self.viewer_sub,
              self.viewer_marks.me,
              self.station,
              self.rt.now(),
              new_name=new_name,
            )
            self.presets_held.push(copied)
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
              ("id", base_codec::json_str(copied.id)),
              ("name", base_codec::json_str(copied.name)),
              ("mine", base_codec::json_bool(true)),
              ("editable", base_codec::json_bool(true)),
            ]), None))
          }
        }
      }
      if call_name == "download.join" {
        let reader_id = match proto_str(params, "reader") {
          Some(s) => s
          None =>
          match proto_str(params, "readerId") {
            Some(s) => s
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing reader" }))
          }
        }
        let file_key = match proto_str(params, "fileKey") {
          Some(s) => s
          None =>
          match proto_str(params, "file") {
            Some(s) => s
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing fileKey" }))
          }
        }
        let version = match proto_str(params, "version") {
          Some(s) => s
          None => "v1"
        }
        let start = match proto_int(params, "start") { Some(n) => n.to_int64(); None => 0.to_int64() }
        let end = match proto_int(params, "end") { Some(n) => n.to_int64(); None => 0.to_int64() }
        let plan = self.file_reads.join_reader(reader_id, file_key, version, start, end)
        let dname = match proto_str(params, "name") { Some(s) => s; None => file_key }
        let dsize = match proto_int(params, "size") { Some(n) => n.to_int64(); None => end }
        let mut exists = false
        for i in 0..<self.downloads_held.length() {
          if self.downloads_held[i].id == reader_id {
            exists = true
            break
          }
        }
        if !exists {
          self.downloads_held.push(views::DownloadEntry::{
            id: reader_id,
            station: self.station,
            name: dname,
            size: dsize,
            loaded: 0.to_int64(),
            state: "going",
            error: None,
            started_at: self.rt.now(),
          })
        }
        let new_reqs_j : Array[base_codec::Json] = []
        for i in 0..<plan.new_requests.length() {
          let nr = plan.new_requests[i]
          new_reqs_j.push(base_codec::json_obj([
            ("reqId", base_codec::json_int(nr.req_id)),
            ("start", base_codec::json_int64(nr.start)),
            ("end", base_codec::json_int64(nr.end)),
          ]))
        }
        let att_j : Array[base_codec::Json] = []
        for i in 0..<plan.attached_req_ids.length() {
          att_j.push(base_codec::json_int(plan.attached_req_ids[i]))
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
          ("readerId", base_codec::json_str(plan.reader_id)),
          ("newRequests", base_codec::json_arr(new_reqs_j)),
          ("attachedReqIds", base_codec::json_arr(att_j)),
        ]), None))
      }
      if call_name == "download.leave" {
        let reader_id = match proto_str(params, "reader") {
          Some(s) => s
          None =>
          match proto_str(params, "readerId") {
            Some(s) => s
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing reader" }))
          }
        }
        let cancelled = self.file_reads.leave_reader(reader_id)
        let canc_j : Array[base_codec::Json] = []
        for i in 0..<cancelled.length() {
          canc_j.push(base_codec::json_int(cancelled[i]))
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([
          ("readerId", base_codec::json_str(reader_id)),
          ("cancelledReqIds", base_codec::json_arr(canc_j)),
        ]), None))
      }
      // ── Phase 1 real sfreplay & unshadowed calls ──
      if call_name == "prefs.get" {
        match views::project_prefs(
          self.db,
          default_workspace=self.workspace,
          device_app=self.device_app,
          device_locale=self.device_locale,
          device_phone=self.device_phone,
        ) {
          sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Ok(id, j, None))
          sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
        }
      }
      if call_name == "prefs.set" {
        let mut fill_flag = false
        let patch_pairs : Array[(String, base_codec::Json)] = []
        match params {
          base_codec::Json::Obj(pairs) => {
            for i in 0..<pairs.length() {
              let (k, v) = pairs[i]
              if k == "fill" {
                match v {
                  base_codec::Json::Bool(b) => { fill_flag = b }
                  _ => ()
                }
              } else {
                patch_pairs.push((k, v))
              }
            }
          }
          _ => ()
        }
        match store::set_device_prefs(self.db, base_codec::json_obj(patch_pairs), fill_flag, self.rt.now()) {
          Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: msg }))
          Ok(next_prefs) => {
            match self.on_prefs_saved {
              Some(hook) => match hook(next_prefs) {
                Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "storage_error", message: msg }))
                Ok(_) => ()
              }
              None => ()
            }
            match base_codec::json_get(next_prefs, "lang") {
              Some(base_codec::Json::Str(s)) => { self.lang = if s == "en" { "en" } else { "zh" } }
              _ => ()
            }
            match base_codec::json_get(next_prefs, "workspace") {
              Some(base_codec::Json::Str(ws)) => if ws.length() > 0 { self.switch_workspace(ws) }
              _ => ()
            }
            return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
          }
        }
      }
      if call_name == "client.device" {
        // 1:1 with `client/core-ts/src/prefs.ts:518-560` (`device`)
        let trim_str = fn(k : String) -> String {
          match proto_str(params, k) {
            Some(s) => s.trim()
            None => ""
          }
        }
        let app = trim_str("app")
        if app != "web" && app != "desktop" && app != "android" && app != "ios" {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "invalid app: expected web|desktop|android|ios" }))
        }
        let build = trim_str("build")
        let agent = trim_str("userAgent")
        let model = trim_str("model")
        let machine_raw = trim_str("machine")
        let machine = if machine_raw.length() > 60 { machine_raw.slice(0, 60) } else { machine_raw }
        let locale = trim_str("locale")
        let client_raw = trim_str("client")
        let client_name = if client_raw.length() > 40 { client_raw.slice(0, 40) } else { client_raw }
        let agent_lc = {
          let bs = agent.to_bytes()
          let sb = StringBuilder::new()
          for i in 0..<bs.length() {
            let c = bs[i].to_int()
            if c >= 65 && c <= 90 { sb.write_byte((c + 32) as Byte) } else { sb.write_byte(bs[i]) }
          }
          sb.to_string()
        }
        let phone = app == "android" || app == "ios" || (app == "web" && (agent_lc.contains("android") || agent_lc.contains("iphone") || agent_lc.contains("ipad")))
        let handoff = app == "web" && !phone
        let is_mac = app == "ios" || agent_lc.contains("mac os x") || agent_lc.contains("iphone") || agent_lc.contains("ipad")
        let os_s = if agent_lc.contains("iphone") || agent_lc.contains("ipad") {
          "iOS"
        } else if agent.contains("Mac OS X") {
          "macOS"
        } else if agent.contains("Windows") {
          "Windows"
        } else if agent.contains("Android") {
          "Android"
        } else if agent.contains("Linux") {
          "Linux"
        } else {
          ""
        }
        let browser_s = if agent.contains("Edg/") {
          "Edge"
        } else if agent.contains("Chrome/") {
          "Chrome"
        } else if agent.contains("Firefox/") {
          "Firefox"
        } else if agent.contains("Safari/") {
          "Safari"
        } else {
          ""
        }
        let b_suffix = if build.length() == 0 { "" } else { " " + build }
        let sent_from = if app == "web" {
          "web" + b_suffix + " (" + (if phone { "phone" } else { "pc" }) + ")"
        } else {
          app + b_suffix
        }
        self.device_app = app
        self.device_build = build
        self.device_phone = phone
        if locale.length() > 0 {
          self.device_locale = locale
        }
        let cur_prefs = match store::get_device_prefs(self.db) {
          sql::SqlResult::Ok(j) => j
          sql::SqlResult::Err(_) => base_codec::json_obj([])
        }
        let eff_lang = match proto_str(cur_prefs, "language") {
          Some(l) => if l == "en" { "en" } else { "zh" }
          None => if locale.length() > 0 {
            if locale.starts_with("zh") || locale.starts_with("ZH") || locale.starts_with("Zh") { "zh" } else { "en" }
          } else {
            self.lang
          }
        }
        self.lang = eff_lang
        let brand = if client_name.length() > 0 { client_name } else { "still.fail" }
        let more_str = fn(s : String) -> String { if s.length() == 0 { "" } else { " · " + s } }
        let dev_name = if app == "android" {
          let extra = if machine.length() > 0 { machine } else { model }
          brand + " Android" + more_str(extra)
        } else if app == "ios" {
          let extra = if machine.length() > 0 { machine } else { model }
          brand + " iOS" + more_str(extra)
        } else if app == "desktop" {
          let extra = if machine.length() > 0 { machine } else { os_s }
          brand + (if eff_lang == "en" { " Desktop" } else { " 桌面版" }) + more_str(extra)
        } else {
          let br = if browser_s.length() > 0 { browser_s } else if eff_lang == "en" { "Browser" } else { "浏览器" }
          brand + " Web · " + br + more_str(os_s)
        }
        let told_fields : Array[(String, base_codec::Json)] = [
          ("app", base_codec::json_str(app)),
          ("phone", base_codec::json_bool(phone)),
          ("handoff", base_codec::json_bool(handoff)),
          ("sentFrom", base_codec::json_str(sent_from)),
          ("mac", base_codec::json_bool(is_mac)),
          ("name", base_codec::json_str(dev_name)),
        ]
        if locale.length() > 0 {
          told_fields.push(("locale", base_codec::json_str(locale)))
        }
        if client_name.length() > 0 {
          told_fields.push(("client", base_codec::json_str(client_name)))
        }
        let next_prefs = j_set_field(
          j_set_field(cur_prefs, "device", base_codec::json_obj(told_fields)),
          "lang",
          base_codec::json_str(eff_lang),
        )
        let _ = store::put_account_doc(self.db, "prefs", base_codec::json_stringify(next_prefs))
        match self.on_prefs_saved {
          Some(hook) => { let _ = hook(next_prefs) }
          None => ()
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
      }
      if call_name == "notify.permission" {
        let st = match proto_str(params, "state") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing state" }))
        }
        if st != "granted" && st != "denied" && st != "default" && st != "unknown" {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "invalid permission state" }))
        }
        self.notify_permission = st
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
      }
      if call_name == "notify.set" {
        // 1:1 with `client/core-ts/src/attend-parse.ts:58-68` & `attend.ts:155-162`
        match base_codec::json_get(params, "kinds") {
          Some(base_codec::Json::Null) | None => ()
          Some(base_codec::Json::Obj(_)) => ()
          _ => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "kinds must be an object" }))
        }
        match base_codec::json_get(params, "workspaces") {
          Some(base_codec::Json::Null) | None => ()
          Some(base_codec::Json::Obj(_)) => ()
          _ => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "workspaces must be an object" }))
        }
        match base_codec::json_get(params, "asked") {
          Some(base_codec::Json::Bool(b)) => { self.notify_asked = b }
          _ => ()
        }
        match base_codec::json_get(params, "on") {
          Some(base_codec::Json::Bool(b)) => {
            self.notify_on = b
            self.notify_push = b
          }
          _ => ()
        }
        match base_codec::json_get(params, "push") {
          Some(base_codec::Json::Bool(b)) => { self.notify_push = b }
          _ => ()
        }
        match base_codec::json_get(params, "preview") {
          Some(base_codec::Json::Bool(b)) => { self.notify_preview = b }
          _ => ()
        }
        match base_codec::json_get(params, "inFront") {
          Some(base_codec::Json::Bool(b)) => { self.notify_in_front = b }
          _ => ()
        }
        // Support both `workspaces: { wsId: boolean }` patch (`true` = heard/unmuted, `false` = muted)
        // and explicit `muted: [wsId]` array.
        let muted_set : Map[String, Bool] = Map::new()
        for i in 0..<self.notify_muted.length() {
          muted_set.set(self.notify_muted[i], true)
        }
        match base_codec::json_get(params, "muted") {
          Some(base_codec::Json::Arr(xs)) => {
            muted_set.clear()
            for i in 0..<xs.length() {
              match xs[i] {
                base_codec::Json::Str(s) => if s.length() > 0 { muted_set.set(s, true) }
                _ => ()
              }
            }
          }
          _ => ()
        }
        match base_codec::json_get(params, "workspaces") {
          Some(base_codec::Json::Obj(ws_entries)) => {
            for i in 0..<ws_entries.length() {
              let (wid, v) = ws_entries[i]
              match v {
                base_codec::Json::Bool(heard) => {
                  if heard {
                    muted_set.remove(wid)
                  } else {
                    muted_set.set(wid, true)
                  }
                }
                _ => ()
              }
            }
          }
          _ => ()
        }
        let sorted_muted = muted_set.keys()
        for i in 1..<sorted_muted.length() {
          let cur = sorted_muted[i]
          let mut j = i - 1
          while j >= 0 && sorted_muted[j] > cur {
            sorted_muted[j + 1] = sorted_muted[j]
            j -= 1
          }
          sorted_muted[j + 1] = cur
        }
        self.notify_muted.clear()
        for i in 0..<sorted_muted.length() {
          self.notify_muted.push(sorted_muted[i])
        }
        match base_codec::json_get(params, "kinds") {
          Some(kj) => match kj {
            base_codec::Json::Obj(_) => {
              let cur = self.notify_kinds
              let next_done = match proto_str(kj, "done") {
                Some(s) => if s == "off" || s == "away" || s == "always" { s } else { cur.done }
                None => cur.done
              }
              self.notify_kinds = views::NotifyKindsInput::{
                wait: match base_codec::json_get(kj, "wait") { Some(base_codec::Json::Bool(b)) => b; _ => cur.wait },
                failed: match base_codec::json_get(kj, "failed") { Some(base_codec::Json::Bool(b)) => b; _ => cur.failed },
                done: next_done,
                message: match base_codec::json_get(kj, "message") { Some(base_codec::Json::Bool(b)) => b; _ => cur.message },
                billed: match base_codec::json_get(kj, "billed") { Some(base_codec::Json::Bool(b)) => b; _ => cur.billed },
              }
            }
            _ => ()
          }
          None => ()
        }
        let muted_j : Array[base_codec::Json] = []
        for i in 0..<self.notify_muted.length() {
          muted_j.push(base_codec::json_str(self.notify_muted[i]))
        }
        let kinds_j = base_codec::json_obj([
          ("wait", base_codec::json_bool(self.notify_kinds.wait)),
          ("failed", base_codec::json_bool(self.notify_kinds.failed)),
          ("done", base_codec::json_str(self.notify_kinds.done)),
          ("message", base_codec::json_bool(self.notify_kinds.message)),
          ("billed", base_codec::json_bool(self.notify_kinds.billed)),
        ])
        let persist_j = base_codec::json_obj([
          ("on", base_codec::json_bool(self.notify_on)),
          ("asked", base_codec::json_bool(self.notify_asked)),
          ("kinds", kinds_j),
          ("preview", base_codec::json_bool(self.notify_preview)),
          ("muted", base_codec::json_arr(muted_j)),
        ])
        let _ = store::put_account_doc(self.db, "notify", base_codec::json_stringify(persist_j))
        let filt_notices : Array[views::NoticeItemInput] = []
        for i in 0..<self.notices_held.length() {
          if self.can_read_workspace(self.notices_held[i].workspace) {
            filt_notices.push(self.notices_held[i])
          }
        }
        match views::project_notify(
          self.db,
          self.current_notify_state(),
          filt_notices,
          lang=self.lang,
          allow_workspace=Some(fn(w : String) -> Bool { self.can_read_workspace(w) }),
        ) {
          sql::SqlResult::Ok(j) => return Some(protocol::CoreEvent::Ok(id, j, None))
          sql::SqlResult::Err(e) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "sql_error", message: e.to_string() }))
        }
      }
      if call_name == "chat.place" {
        // 1:1 with `client/core-ts/src/core/calls.ts:743-751`, `station/topics.ts:710-760`, & `data.ts:1776`:
        // 256-entry bounded in-memory LRU (caching `None` too) + SQLite `workspace_pref(ws, "place:<st>/<th>")` restart persistence.
        let st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        let th = match proto_int(params, "thread") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing thread" }))
        }
        let seq_opt = proto_int(params, "seq")
        let off_opt : Option[Double] = match base_codec::json_get(params, "offset") {
          Some(base_codec::Json::Num(n, _)) => Some(n)
          _ => None
        }
        self.set_chat_place_mem(st, th, seq_opt, off_opt)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
      }
      if call_name == "chat.window" {
        // 1:1 with `client/core-ts/src/core/calls.ts:787-796`: `rows` required, clamped to `[1, 200]`.
        let st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        let raw_rows = match proto_int(params, "rows") {
          Some(r) => r
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing rows" }))
        }
        if raw_rows <= 0 {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "rows must be positive" }))
        }
        let clamped_rows = if raw_rows > 200 { 200 } else { raw_rows }
        let th_opt = proto_int(params, "thread")
        let sess_opt = match proto_str(params, "session") {
          Some(s) => if s.length() > 0 { Some(s) } else { None }
          None => None
        }
        if th_opt.is_none() && sess_opt.is_none() {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing thread or session" }))
        }
        match th_opt {
          Some(th) => self.chat_windows.set(st + ":t:" + th.to_string(), clamped_rows)
          None => ()
        }
        match sess_opt {
          Some(s) => self.chat_windows.set(st + ":s:" + s, clamped_rows)
          None => ()
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
      }
      if call_name == "draft.get" {
        // 1:1 with `client/core-ts/src/core/calls.ts:901-913`: accepts `{ key }` OR `{ station, chat }`.
        let key_param = proto_str(params, "key")
        let (raw_st, chat) = match key_param {
          Some(k) => match draft_at_key(k) {
            Some(pair) => pair
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "invalid draft key" }))
          }
          None => {
            let s = match proto_str(params, "station") {
              Some(v) => if v.length() > 0 { v } else { "" }
              None => ""
            }
            let c = match proto_str(params, "chat") {
              Some(v) => if v.length() > 0 { v } else { "" }
              None => ""
            }
            if s.length() == 0 || c.length() == 0 {
              return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key or station+chat" }))
            }
            (s, c)
          }
        }
        if !self.can_read_draft_target(key_param, raw_st, chat) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
        let target_st = if chat == "new" {
          raw_st
        } else {
          let canon = self.membership.canonicalize(raw_st, fallback_ws=self.workspace)
          if canon.length() > 0 { canon } else { raw_st }
        }
        return Some(protocol::CoreEvent::Ok(id, self.composers.read_draft(target_st, chat), None))
      }
      if call_name == "draft.put" {
        // 1:1 with `client/core-ts/src/core/calls.ts:901-921`: accepts `{ key }` OR `{ station, chat }`.
        let key_param = proto_str(params, "key")
        let (raw_st, chat) = match key_param {
          Some(k) => match draft_at_key(k) {
            Some(pair) => pair
            None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "invalid draft key" }))
          }
          None => {
            let s = match proto_str(params, "station") {
              Some(v) => if v.length() > 0 { v } else { "" }
              None => ""
            }
            let c = match proto_str(params, "chat") {
              Some(v) => if v.length() > 0 { v } else { "" }
              None => ""
            }
            if s.length() == 0 || c.length() == 0 {
              return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key or station+chat" }))
            }
            (s, c)
          }
        }
        if !self.can_read_draft_target(key_param, raw_st, chat) {
          return Some(protocol::CoreEvent::Err(id, self.gate_err()))
        }
        let target_st = if chat == "new" {
          raw_st
        } else {
          let canon = self.membership.canonicalize(raw_st, fallback_ws=self.workspace)
          if canon.length() > 0 { canon } else { raw_st }
        }
        let draft_val = match base_codec::json_get(params, "value") {
          Some(v) => v
          None => params
        }
        return Some(protocol::CoreEvent::Ok(id, self.composers.put_draft(target_st, chat, draft_val), None))
      }
      if call_name == "markdown" {
        let text = match proto_str(params, "text") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing text" }))
        }
        let mk = store::md_key(text)
        let now = self.rt.now()
        let md_json = match self.md_store.get(mk, now) {
          Some(raw) => match base_codec::json_parse(raw) {
            base_codec::JsonParseResult::Ok(j) => j
            base_codec::JsonParseResult::Err(_) => {
              let parsed = views::parse_md_ast(text)
              self.md_store.put_prepared(mk, base_codec::json_stringify(parsed), "markdown", now)
              parsed
            }
          }
          None => {
            let parsed = views::parse_md_ast(text)
            self.md_store.put_prepared(mk, base_codec::json_stringify(parsed), "markdown", now)
            parsed
          }
        }
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("md", md_json)]), None))
      }
      if call_name == "link.parse" {
        let url = match proto_str(params, "url") {
          Some(u) => u
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing url" }))
        }
        if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
          return Some(protocol::CoreEvent::Ok(id, base_codec::json_null(), None))
        }
        let parsed = views::parse_link_target(
          self.db,
          url,
          self.cloud_origin,
          allow_workspace=Some(fn(w : String) -> Bool { self.can_read_workspace(w) }),
          allow_station=Some(fn(s : String) -> Bool { self.can_read_station(s) }),
        )
        return Some(protocol::CoreEvent::Ok(id, parsed, None))
      }
      if call_name == "composer.text" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let txt = match proto_str(params, "text") { Some(s) => s; None => "" }
        let v = self.composers.text(key, txt)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.append" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let words = match proto_str(params, "words") {
          Some(w) => w
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing words" }))
        }
        let v = self.composers.append(key, words)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.take" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let st_opt = proto_str(params, "station")
        return Some(protocol::CoreEvent::Ok(id, self.composers.take(key, station=st_opt, lang=self.lang), None))
      }
      if call_name == "composer.add" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let st = match proto_str(params, "station") {
          Some(s) => if s.length() > 0 { s } else { self.station }
          None => self.station
        }
        let files = match base_codec::json_get(params, "files") {
          Some(base_codec::Json::Arr(xs)) => xs
          _ => []
        }
        match self.composers.add(key, st, files, bytes=bytes) {
          Ok(v) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
          Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "unsupported", message: msg }))
        }
      }
      if call_name == "composer.mode" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let fid = match proto_str(params, "id") {
          Some(f) => f
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let mode = match proto_str(params, "mode") { Some(m) => m; None => "path" }
        match self.composers.mode(key, fid, mode) {
          Ok(v) => return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
          Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "unsupported", message: msg }))
        }
      }
      if call_name == "composer.quote" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let qj = match base_codec::json_get(params, "quote") {
          Some(base_codec::Json::Obj(fs)) => base_codec::json_obj(fs)
          _ => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing quote" }))
        }
        let qid = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let focus = match base_codec::json_get(params, "focus") {
          Some(base_codec::Json::Bool(b)) => b
          _ => false
        }
        let att = base_codec::json_get(params, "attachment")
        let fid = proto_str(params, "fileId")
        let v = self.composers.quote(key, qj, qid, focus, attachment=att, file_id=fid)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.comment" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let qid = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let words = match proto_str(params, "comment") { Some(s) => s; None => "" }
        let v = self.composers.comment(key, qid, words)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.unquote" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let qid = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let v = self.composers.unquote(key, qid)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.focused" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let v = self.composers.focused(key)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.error" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let v = self.composers.error(key, proto_str(params, "error"))
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.remove" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let fid = match proto_str(params, "id") {
          Some(s) => s
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing id" }))
        }
        let v = self.composers.remove(key, fid)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.restore" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let uw = match base_codec::json_get(params, "unlessWritten") {
          Some(base_codec::Json::Bool(b)) => b
          _ => false
        }
        return Some(protocol::CoreEvent::Ok(id, self.composers.restore(key, proto_str(params, "error"), uw), None))
      }
      if call_name == "composer.carry" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let to = match proto_str(params, "to") {
          Some(t) => t
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing to" }))
        }
        let v = self.composers.carry(key, to)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "composer.starting" {
        let key = match proto_str(params, "key") {
          Some(k) => k
          None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing key" }))
        }
        let st_flag = match base_codec::json_get(params, "starting") {
          Some(base_codec::Json::Bool(b)) => b
          _ => false
        }
        let v = self.composers.starting(key, st_flag)
        return Some(protocol::CoreEvent::Ok(id, base_codec::json_obj([("version", base_codec::json_int(v))]), None))
      }
      if call_name == "account.switch" {
        let acct = match proto_str(params, "account") {
          Some(s) => s
          None => match proto_str(params, "id") {
            Some(s) => s
            None => match proto_str(params, "email") {
              Some(s) => s
              None => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "missing account" }))
            }
          }
        }
        if acct.length() == 0 {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_params", message: "empty account" }))
        }
        if self.membership.is_unauthenticated() || self.membership.is_session_invalidated() {
          return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
            code: "account_sub_mismatch",
            message: "account switch requires reopening the target account database",
          }))
        }
        if self.auth_store.accounts.length() > 0 {
          // Resolve by `sub` or `email` against signed-in accounts; refuse unknown accounts without writing `active_account`.
          let mut found_account = false
          let mut target_sub = ""
          let mut target_email = ""
          for i in 0..<self.auth_store.accounts.length() {
            let a = self.auth_store.accounts[i]
            if a.sub == acct || a.email == acct {
              found_account = true
              target_sub = a.sub
              target_email = a.email
              break
            }
          }
          if !found_account {
            return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "not_found", message: "account not found: " + acct }))
          }
          // Strictly require `self.db_account_sub == Some(target_sub)` (NEVER bind `:memory:` or a mismatched DB!).
          match self.db_account_sub {
            Some(open_sub) => {
              if open_sub != target_sub {
                return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
                  code: "account_sub_mismatch",
                  message: "account switch requires reopening the target account database",
                }))
              }
            }
            None => {
              return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "account_sub_mismatch",
                message: "account switch requires reopening the target account database",
              }))
            }
          }
          match self.auth_store.switch_account(target_sub) {
            Err(msg) => return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "not_found", message: msg }))
            Ok(_) => {
              if target_email.length() > 0 {
                self.set_viewer(target_email, sub=target_sub)
              }
            }
          }
        } else {
          // When `auth_store` is empty, verify against persisted `account_doc("accounts")` if populated.
          let mut resolved_sub = acct
          match store::get_account_doc(self.db, "accounts") {
            sql::SqlResult::Ok(Some(raw)) => match base_codec::json_parse(raw) {
              base_codec::JsonParseResult::Ok(j) => {
                let items = match j {
                  base_codec::Json::Arr(xs) => xs
                  base_codec::Json::Obj(_) => match base_codec::json_get(j, "accounts") {
                    Some(base_codec::Json::Arr(xs)) => xs
                    _ => []
                  }
                  _ => []
                }
                if items.length() > 0 {
                  let mut found = false
                  for i in 0..<items.length() {
                    let it = items[i]
                    let s = match proto_str(it, "sub") { Some(v) => v; None => match proto_str(it, "id") { Some(v) => v; None => "" } }
                    let e = match proto_str(it, "email") { Some(v) => v; None => "" }
                    if s == acct || e == acct {
                      found = true
                      if s.length() > 0 { resolved_sub = s }
                      break
                    }
                  }
                  if !found {
                    return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "not_found", message: "account not found: " + acct }))
                  }
                }
              }
              base_codec::JsonParseResult::Err(_) => ()
            }
            _ => ()
          }
          match self.db_account_sub {
            Some(open_sub) => {
              if open_sub != resolved_sub {
                return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
                  code: "account_sub_mismatch",
                  message: "account switch requires reopening the target account database",
                }))
              }
            }
            None => {
              return Some(protocol::CoreEvent::Err(id, protocol::CoreError::{
                code: "account_sub_mismatch",
                message: "account switch requires reopening the target account database",
              }))
            }
          }
        }
        return self.router.handle(req)
      }
      self.router.handle(req)
    }
    protocol::CoreRequest::Subscribe(id, topic, _keyed, _from, _have) => {
      // Rule 4: subscribing NEVER starts a network request; only reads local SQLite.
      // If subscribing to a specific chat thread, only raises priority without opening a new fetch.
      self.drop_chat_sub_snapshot(id)
      if topic.name == "chat" {
        match topic.param("thread") {
          Some(base_codec::Json::Num(n, _)) => self.sync.focus_thread(Some(n.to_int()))
          _ => ()
        }
      }
      self.router.handle(req)
    }
    protocol::CoreRequest::Unsubscribe(id, _, _) => {
      self.close_chat_sub_snapshot(id)
      self.router.handle(req)
    }
    _ => self.router.handle(req)
  }
}

/// Thin JSON wire adapter compatible with `core_api.h` (`mb_core_send` -> callback).
/// Matches `client/core-ts/src/core.ts` `receiveJson` / `receiveRaw`.
pub fn ClientCore::handle_wire(self : ClientCore, json_text : String, bytes : Option[Bytes] = None) -> Option[(String, Option[Bytes])] {
  let raw = match base_codec::json_parse(json_text) {
    base_codec::JsonParseResult::Err(_) => return None
    base_codec::JsonParseResult::Ok(j) => j
  }
  match protocol::parse_client_message(raw, bytes=bytes) {
    protocol::ParseRequestResult::Invalid(msg) =>
    match protocol::wire_error_id(raw) {
      Some(id) => {
        let ev = protocol::CoreEvent::Err(id, protocol::CoreError::{ code: "bad_message", message: msg })
        if base_codec::json_get(raw, "subscribe").is_some() {
          Some(protocol::encode_sub_event_with_auth(ev, self.wire_out_gen_for_raw_subscribe(raw)))
        } else {
          Some(protocol::encode_core_event(ev))
        }
      }
      None => None
    }
    protocol::ParseRequestResult::Ok(req) => {
      let sub_topic_opt : Option[protocol::Topic] = match req {
        protocol::CoreRequest::Subscribe(_, topic, _, _, _) => Some(topic)
        protocol::CoreRequest::Unsubscribe(id, _, _) => self.router.active_sub_topic(id)
        _ => None
      }
      match self.handle_request(req) {
        Some(ev) =>
        match sub_topic_opt {
          Some(topic) => Some(self.encode_sub_event(topic, ev))
          None =>
          match ev {
            protocol::CoreEvent::Unsubscribed(_, _) =>
            Some(protocol::encode_sub_event_with_auth(
              ev,
              protocol::WireOutGen::{ conn: self.auth.conn_seq(), auth_gen: None, vault_gen: None },
            ))
            _ => Some(protocol::encode_core_event(ev))
          }
        }
        None => None
      }
    }
  }
}
