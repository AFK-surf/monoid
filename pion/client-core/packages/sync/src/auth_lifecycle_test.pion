// Dedicated end-to-end & unit tests for Direction 2B Part 2:
// 1. First-class immutable `AuthCapability` + `AuthGenTracker` (unique `owner_id`, persistent `connSeq`)
// 2. Unified outbound `WireOutGen` envelope (`conn`, `authGen`, `vaultGen`) + host sink zero-accumulation
// 3. Real Cloud `/v1/events` WS + per-workspace monotonic `cloud_req_seq` + atomic SQLite `drop_workspace`
//    + offline restart zero-leakage across all read entry points + recovery on newer Cloud 200
// 4. Full-set canonical Lock digest (startup seed no spurious bump, device removal bumps auth+vault,
//    station-only change bumps auth only, newcomer absent from `lock.members` NEVER triggers `revoked`)
// 5. Role downgrade per-`(workspace, topic)` confirmation latch (`owner -> member` never leaks stale `manages: true`)
// 6. Single fail-open `guarded_read_k` (`auth_stale` bounded retry convergence + `revoked` immediate abort)

import "base_codec"
import "effect"
import "form"
import "lock"
import "protocol"
import "shell"
import "sql"
import "store"

struct AuthSimEnv {
  rt : effect::Runtime
  sim_db : SimAccountDb
  sh : shell::Shell
  db : sql::Sql
  pending : Array[(Int64, String, base_codec::Json)]
}

fn AuthSimEnv::new() -> AuthSimEnv {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let pending : Array[(Int64, String, base_codec::Json)] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {
      pending.push((id, op, args))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      sim_db.answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "acct-auth-lifecycle") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("sql open failed: " + e.to_string())
  }
  AuthSimEnv::{
    rt: rt,
    sim_db: sim_db,
    sh: sh,
    db: db,
    pending: pending,
  }
}

fn AuthSimEnv::answer_http(self : AuthSimEnv, req_id : Int64, status : Int, body : String) -> Unit {
  self.sh.answer(
    req_id,
    base_codec::json_obj([
      ("status", base_codec::json_int(status)),
      ("headers", base_codec::json_arr([])),
      ("redirected", base_codec::json_bool(false)),
    ]),
    bytes=Some(body.to_bytes()),
  )
}

fn json_int_eq(raw : String, key : String, want : Int) -> Bool {
  match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) =>
    match base_codec::json_get(j, key) {
      Some(base_codec::Json::Num(n, _)) => n.to_int() == want
      _ => false
    }
    _ => false
  }
}

fn json_has_field(raw : String, key : String) -> Bool {
  match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) => base_codec::json_get(j, key).is_some()
    _ => false
  }
}

// ── Test 1: AuthCapability & AuthGenTracker (owner_id isolation, persisted connSeq, topic-policy 1:1) ──

test "auth_lifecycle 1: immutable AuthCapability cross-tracker fail-closed, persisted connSeq 1->2->3, and topic-policy 1:1" {
  let env = AuthSimEnv::new()

  // 1a. Persistent monotonic `connSeq` in SQLite `account_doc("conn_seq")`: 1 -> 2 -> 3 across restarts
  let t1 = AuthGenTracker::open_with_db(env.db)
  debug_assert(t1.conn_seq == 1L, "first open starts at connSeq = 1")
  let t2 = AuthGenTracker::open_with_db(env.db)
  debug_assert(t2.conn_seq == 2L, "second open increments connSeq to 2")
  let t3 = AuthGenTracker::open_with_db(env.db)
  debug_assert(t3.conn_seq == 3L, "third open increments connSeq to 3")
  debug_assert(t1.owner_id != t2.owner_id && t2.owner_id != t3.owner_id, "every tracker has a unique owner_id")

  // 1b. Cross-tracker fail-closed capability verification
  t1.ensure_workspace("ws-a")
  t2.ensure_workspace("ws-a")
  let snap1 = AuthCapability::capture(t1)
  let ws_cap = snap1.workspace("ws-a", sub=Some("alice"))
  debug_assert(ws_cap.is_valid(t1, current_sub=Some("alice")), "ws_cap valid on owning tracker")
  debug_assert(!ws_cap.is_valid(t1, current_sub=Some("bob")), "ws_cap fails closed on sub mismatch")
  debug_assert(!ws_cap.is_valid(t2, current_sub=Some("alice")), "ws_cap fails closed across different tracker owner_id")

  let v_cap = snap1.vault("ws-a", "v-1", sub=Some("alice"))
  debug_assert(v_cap.is_valid(t1, current_sub=Some("alice")), "vault_cap valid on owning tracker")
  debug_assert(!v_cap.is_valid(t2, current_sub=Some("alice")), "vault_cap fails closed across tracker instances")

  let comp = CompositeCapability::{ owner_id: t1.owner_id, workspaces: [ws_cap], vaults: [v_cap] }
  debug_assert(comp.is_valid(t1, current_sub=Some("alice")), "composite cap valid before bump")
  debug_assert(!comp.is_valid(t2, current_sub=Some("alice")), "composite cap fails closed across trackers")

  let _ = t1.lock_vault("ws-a", vault_id="v-1")
  debug_assert(t1.is_vault_locked("ws-a", vault_id="v-1"), "vault marked locked")
  debug_assert(ws_cap.is_valid(t1, current_sub=Some("alice")), "lock_vault does not invalidate non-vault ws_cap")
  debug_assert(!v_cap.is_valid(t1, current_sub=Some("alice")), "lock_vault invalidates vault_cap")
  debug_assert(!comp.is_valid(t1, current_sub=Some("alice")), "composite cap fails closed when vault part invalidates")

  let _ = t1.unlock_vault("ws-a", vault_id="v-1")
  debug_assert(!t1.is_vault_locked("ws-a", vault_id="v-1"), "vault unlocked")
  let snap2 = AuthCapability::capture(t1)
  let v_cap2 = snap2.vault("ws-a", "v-1")
  debug_assert(v_cap2.vault_gen == 3, "vault_gen incremented 1 -> 2 (lock) -> 3 (unlock)")
  debug_assert(v_cap2.is_valid(t1), "fresh vault_cap valid after unlock")

  let _ = t1.bump_workspace("ws-a")
  debug_assert(!ws_cap.is_valid(t1, current_sub=Some("alice")), "bump_workspace invalidates old ws_cap")
  debug_assert(!v_cap2.is_valid(t1), "bump_workspace also invalidates vault_cap (workspace auth boundary)")

  let (ag_all, vg_all) = t1.bump_all()
  debug_assert(ag_all >= 3 && vg_all >= 4, "bump_all advances both global authGen and vaultGen")

  // 1c. Exact 1:1 `is_device_global_topic` & `is_vault_topic` parity with `client/core-ts/src/topic-policy.ts`
  let device_globals = [
    "releases", "fonts", "changelog", "prefs", "doing", "adbShare",
    "link", "connection", "way", "net",
  ]
  for i in 0..<device_globals.length() {
    debug_assert(is_device_global_topic(device_globals[i]), "must be device-global: " + device_globals[i])
  }
  let scoped = ["downloads", "chats", "chat", "workspaces", "workspace", "workspaceMarks", "profiles", "settings", "lock", "vaults", "accounts", "search"]
  for i in 0..<scoped.length() {
    debug_assert(!is_device_global_topic(scoped[i]), "must NOT be device-global: " + scoped[i])
  }
  debug_assert(is_vault_topic("vaults") && is_vault_topic("vaultItems") && is_vault_topic("vaultUses"), "vault topics recognized")
  debug_assert(!is_vault_topic("chats") && !is_vault_topic("prefs") && !is_vault_topic("vaultApprovals"), "non-vault topics excluded")
}

// ── Test 2: WireOutGen envelope + handshake + zero pending_wire_events with host sink ──

test "auth_lifecycle 2: WireOutGen stamps conn/authGen/vaultGen on every sub frame & host sink keeps pending_wire_events at 0" {
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let core = ClientCore::new("ws-wire", "ws-wire/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})

  let sink_frames : Array[String] = []
  core.set_wire_sink(fn(j : String, _b : Option[Bytes]) -> Unit {
    sink_frames.push(j)
  })
  debug_assert(core.pending_wire_event_count() == 0, "pending_wire_events drained on sink attach")

  // Emit startup handshake `{"id": 0, "auth": {"conn": 1, "scopes": {...}, "workspaces": {...}, "vaults": {...}}}`
  let hs = core.emit_auth_handshake()
  debug_assert(sink_frames.length() == 1 && sink_frames[0] == hs, "handshake went directly to host sink")
  debug_assert(core.pending_wire_event_count() == 0, "pending_wire_events stays 0 with host sink")
  debug_assert(hs.contains("\"id\":0") && hs.contains("\"conn\":1") && hs.contains("\"scopes\":{") && hs.contains("\"workspaces\":{") && hs.contains("\"vaults\":{"), "handshake format matches client.mbt")

  // Device-global topic (`prefs`): MUST carry `conn`, MUST NOT carry `authGen` or `vaultGen`
  match core.handle_wire("{\"id\":10,\"subscribe\":{\"topic\":\"prefs\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(json_int_eq(txt, "conn", 1), "prefs Value has conn:1")
      debug_assert(!json_has_field(txt, "authGen"), "prefs Value omits authGen")
      debug_assert(!json_has_field(txt, "vaultGen"), "prefs Value omits vaultGen")
    }
    None => debug_assert(false, "expected prefs Value")
  }
  // Unsubscribe `prefs` with `keep: true` -> `Unsubscribed` carries `conn:1` only
  let prefs_tok = match core.handle_wire("{\"id\":10,\"unsubscribe\":true,\"keep\":true}") {
    Some((txt, _)) => {
      debug_assert(json_int_eq(txt, "conn", 1) && !json_has_field(txt, "authGen"), "prefs Unsubscribed has conn:1 only")
      match base_codec::json_parse(txt) {
        base_codec::JsonParseResult::Ok(j) => match base_codec::json_get(j, "v") { Some(base_codec::Json::Str(v)) => v; _ => "" }
        _ => ""
      }
    }
    None => ""
  }
  debug_assert(prefs_tok.length() > 0, "got prefs keep token")
  match core.handle_wire("{\"id\":11,\"subscribe\":{\"topic\":\"prefs\"},\"keyed\":true,\"have\":\"" + prefs_tok + "\"}") {
    Some((txt, _)) => {
      debug_assert(txt.contains("\"same\":true") && json_int_eq(txt, "conn", 1) && !json_has_field(txt, "authGen"), "prefs Same carries conn:1 only")
    }
    None => debug_assert(false, "expected prefs Same")
  }

  // Workspace topic (`settings`): MUST carry `conn:1` + `authGen:1` (no `vaultGen`)
  match core.handle_wire("{\"id\":20,\"subscribe\":{\"topic\":\"settings\",\"scope\":\"ws-wire\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(json_int_eq(txt, "conn", 1), "settings has conn:1")
      debug_assert(json_int_eq(txt, "authGen", 1), "settings has authGen:1")
      debug_assert(!json_has_field(txt, "vaultGen"), "settings omits vaultGen")
    }
    None => debug_assert(false, "expected settings Value")
  }

  // Vault topic (`vaults`): MUST carry `conn:1` + `authGen:1` + `vaultGen:1`
  match core.handle_wire("{\"id\":30,\"subscribe\":{\"topic\":\"vaults\",\"workspace\":\"ws-wire\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(json_int_eq(txt, "conn", 1), "vaults has conn:1")
      debug_assert(json_int_eq(txt, "authGen", 1), "vaults has authGen:1")
      debug_assert(json_int_eq(txt, "vaultGen", 1), "vaults has vaultGen:1")
    }
    None => debug_assert(false, "expected vaults Value")
  }

  // Trigger boundary (`bump_workspace_and_vault`): emits new handshake + re-anchors active subs (`#20` and `#30`) with authGen:2 / vaultGen:2 without freezing!
  let before_cnt = sink_frames.length()
  let _ = core.auth.bump_workspace_and_vault("ws-wire")
  debug_assert(core.pending_wire_event_count() == 0, "sink keeps pending_wire_events at 0 even across boundaries")
  let mut saw_hs2 = false
  let mut saw_settings_g2 = false
  let mut saw_vaults_g2 = false
  for i in before_cnt..<sink_frames.length() {
    let f = sink_frames[i]
    if f.contains("\"id\":0") && f.contains("\"auth\":{") && f.contains("\"ws-wire\":2") {
      saw_hs2 = true
    }
    if json_int_eq(f, "id", 20) && json_int_eq(f, "authGen", 2) && f.contains("\"value\"") {
      saw_settings_g2 = true
    }
    if json_int_eq(f, "id", 30) && json_int_eq(f, "authGen", 2) && json_int_eq(f, "vaultGen", 2) && f.contains("\"value\"") {
      saw_vaults_g2 = true
    }
  }
  debug_assert(saw_hs2, "boundary emitted updated {id:0, auth} snapshot")
  debug_assert(saw_settings_g2, "boundary re-anchored active settings sub at authGen:2")
  debug_assert(saw_vaults_g2, "boundary re-anchored active vaults sub at authGen:2, vaultGen:2")

  // Active sub #20 MUST continue receiving live deltas after boundary (never frozen!).
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-wire/st-1"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-1\",\"name\":\"St1\",\"automaticDecisions\":{\"enabled\":true}}"),
    base_codec::json_int64(2000L),
  ])
  let live_wire = core.refresh_topic_wire("settings")
  debug_assert(live_wire.length() == 1, "active sub still produces live updates after boundary")
  debug_assert(json_int_eq(live_wire[0].0, "authGen", 2) && json_int_eq(live_wire[0].0, "conn", 1), "live delta stamped with new authGen:2")
  core.stop()
}

// ── Test 3: Cloud 403 revocation -> atomic drop_workspace -> offline restart 0-leak -> Cloud 200 recovery ──

test "auth_lifecycle 3: Cloud 403 revocation atomically drops SQLite + caches, offline restart has 0 leaks across all read entry points, and newer 200 recovers" {
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let core = ClientCore::new("ws-1", "ws-1/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  core.set_viewer("alice@still.fail", sub="u-alice", role="owner")
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-alice")
  core.bind_cloud_sync(cs)

  // Seed ws-1 AND sibling ws-10 (prefix-collision guard!) in SQLite + in-memory caches
  let _ = store::put_account_doc(
    env.db,
    "me",
    "{\"user\":{\"sub\":\"u-alice\",\"email\":\"alice@still.fail\"},\"workspaces\":[{\"id\":\"ws-1\",\"name\":\"Secret WS\",\"role\":\"owner\"},{\"id\":\"ws-10\",\"name\":\"Sibling WS\",\"role\":\"owner\"}]}",
  )
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-1"),
    base_codec::json_str("{\"id\":\"ws-1\",\"name\":\"Secret WS\",\"role\":\"owner\",\"stations\":[{\"id\":\"st-1\",\"name\":\"St1\",\"online\":true}],\"members\":[{\"sub\":\"u-alice\",\"email\":\"alice@still.fail\",\"role\":\"owner\"}]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-10"),
    base_codec::json_str("{\"id\":\"ws-10\",\"name\":\"Sibling WS\",\"role\":\"owner\",\"stations\":[{\"id\":\"st-10\",\"name\":\"St10\",\"online\":true}],\"members\":[{\"sub\":\"u-alice\",\"email\":\"alice@still.fail\",\"role\":\"owner\"}]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-1/st-1"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-1\",\"name\":\"Secret Station\",\"profiles\":[{\"name\":\"sec-prof\"}]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-10/st-10"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-10\",\"name\":\"Sibling Station\"}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(sql_chat_upsert(), params=[
    base_codec::json_str("ws-1/st-1"), base_codec::json_str("c-sec"), base_codec::json_int(0),
    base_codec::json_num(1.0), base_codec::json_int(77), base_codec::json_str("sess-sec"),
    base_codec::json_int(1), base_codec::json_int64(5000L), base_codec::json_null(),
    base_codec::json_int(1), base_codec::json_int(0), base_codec::json_null(),
    base_codec::json_str("wait"), base_codec::json_int(1), base_codec::json_int(0),
    base_codec::json_str("{\"id\":\"c-sec\",\"title\":\"TOP SECRET PROJECT\",\"thread\":77,\"unread\":1,\"asks\":true,\"lastActive\":5000}"),
  ])
  let _ = env.db.run(sql_chat_upsert(), params=[
    base_codec::json_str("ws-10/st-10"), base_codec::json_str("c-sib"), base_codec::json_int(0),
    base_codec::json_num(1.0), base_codec::json_int(88), base_codec::json_str("sess-sib"),
    base_codec::json_int(1), base_codec::json_int64(5000L), base_codec::json_null(),
    base_codec::json_int(1), base_codec::json_int(0), base_codec::json_null(),
    base_codec::json_null(), base_codec::json_int(0), base_codec::json_int(0),
    base_codec::json_str("{\"id\":\"c-sib\",\"title\":\"Sibling Chat\",\"thread\":88,\"unread\":1,\"lastActive\":5000}"),
  ])
  let _ = env.db.run(sql_entry_put(), params=[
    base_codec::json_str("ws-1/st-1"), base_codec::json_int(77), base_codec::json_int(1),
    base_codec::json_str("{\"n\":1,\"thread\":77,\"kind\":\"message\",\"author\":\"alice\",\"text\":\"CONFIDENTIAL_PAYLOAD_XYZ\",\"at\":5000}"),
  ])
  let _ = store::put_workspace_pref(env.db, "ws-1", "theme", "\"secret-theme\"")
  let _ = store::put_workspace_pref(env.db, "ws-10", "theme", "\"sibling-theme\"")
  let _ = store::put_account_doc(env.db, "vaults:ws-1", "[{\"id\":\"v-sec\",\"name\":\"SecretVault\"}]")
  let _ = core.handle_wire("{\"id\":1,\"call\":\"composer.text\",\"params\":{\"key\":\"ws-1/st-1:c-sec\",\"text\":\"SECRET_COMPOSER_DRAFT\"}}")
  let _ = core.handle_wire("{\"id\":2,\"call\":\"draft.put\",\"params\":{\"station\":\"ws-1/st-1\",\"chat\":\"c-sec\",\"value\":{\"text\":\"SECRET_RAW_DRAFT\"}}}")
  let _ = core.handle_wire("{\"id\":3,\"call\":\"chat.place\",\"params\":{\"station\":\"ws-1/st-1\",\"thread\":77,\"seq\":1}}")
  let _ = core.handle_wire("{\"id\":4,\"call\":\"chat.window\",\"params\":{\"station\":\"ws-1/st-1\",\"thread\":77,\"rows\":45}}")

  // Trigger Cloud 403 revocation on `ws-1` via `CloudSync::fetch_workspace_k`
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-1", fn(_ex : effect::Exit[CloudWorkspace]) -> Unit {
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = env.rt.run_ready()
  debug_assert(env.pending.length() == 1, "CloudSync dispatched GET /v1/workspaces/ws-1")
  env.answer_http(env.pending[0].0, 403, "{\"error\":\"forbidden\"}")
  let _ = env.rt.run_ready()

  debug_assert(core.auth.is_revoked("ws-1"), "ws-1 marked revoked on Cloud 403")
  debug_assert(core.auth.workspace_auth_gen("ws-1") == 2, "ws-1 authGen bumped to 2")
  debug_assert(core.auth.vault_workspace_gen("ws-1") == 2, "ws-1 vaultGen bumped to 2")
  debug_assert(!core.auth.is_revoked("ws-10"), "sibling ws-10 NOT revoked")

  // Simulate OFFLINE RESTART on the exact same SQLite database (`env.db`)!
  core.stop()
  let restarted = ClientCore::new("ws-1", "ws-1/st-1", env.rt, env.db, core_offline_transport(), fn() -> Unit {})
  debug_assert(restarted.auth.conn_seq == 2L, "restarted ClientCore strictly incremented conn_seq to 2")

  // Audit EVERY read entry point after offline restart -> ZERO leakage of ws-1 data!
  let check_zero_leak = fn(label : String, wire_req : String) -> Unit {
    match restarted.handle_wire(wire_req) {
      Some((txt, _)) => {
        debug_assert(!txt.contains("TOP SECRET PROJECT"), label + " leaked chat title")
        debug_assert(!txt.contains("CONFIDENTIAL_PAYLOAD_XYZ"), label + " leaked message text")
        debug_assert(!txt.contains("SECRET_COMPOSER_DRAFT"), label + " leaked composer text")
        debug_assert(!txt.contains("SECRET_RAW_DRAFT"), label + " leaked raw draft")
        debug_assert(!txt.contains("Secret Station"), label + " leaked station name")
        debug_assert(!txt.contains("Secret WS"), label + " leaked workspace name")
        debug_assert(!txt.contains("sec-prof"), label + " leaked profile")
        debug_assert(!txt.contains("secret-theme"), label + " leaked settings pref")
        debug_assert(!txt.contains("SecretVault"), label + " leaked vault")
      }
      None => debug_assert(false, label + " returned None")
    }
  }
  check_zero_leak("chats", "{\"id\":101,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-1\"},\"keyed\":true}")
  check_zero_leak("chat", "{\"id\":102,\"subscribe\":{\"topic\":\"chat\",\"station\":\"ws-1/st-1\",\"thread\":77},\"keyed\":true}")
  check_zero_leak("composer", "{\"id\":103,\"subscribe\":{\"topic\":\"composer\",\"key\":\"ws-1/st-1:c-sec\"},\"keyed\":true}")
  check_zero_leak("draft.get", "{\"id\":104,\"call\":\"draft.get\",\"params\":{\"station\":\"ws-1/st-1\",\"chat\":\"c-sec\"}}")
  check_zero_leak("workspaceMarks", "{\"id\":105,\"subscribe\":{\"topic\":\"workspaceMarks\"},\"keyed\":true}")
  check_zero_leak("workspaces", "{\"id\":106,\"subscribe\":{\"topic\":\"workspaces\"},\"keyed\":true}")
  check_zero_leak("profiles", "{\"id\":107,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-1\"},\"keyed\":true}")
  check_zero_leak("settings", "{\"id\":108,\"subscribe\":{\"topic\":\"settings\",\"scope\":\"ws-1\"},\"keyed\":true}")
  check_zero_leak("search", "{\"id\":109,\"subscribe\":{\"topic\":\"search\",\"scope\":\"ws-1\",\"query\":\"CONFIDENTIAL\"},\"keyed\":true}")
  check_zero_leak("stations", "{\"id\":110,\"subscribe\":{\"topic\":\"stations\",\"scope\":\"ws-1\"},\"keyed\":true}")
  check_zero_leak("vaults", "{\"id\":111,\"subscribe\":{\"topic\":\"vaults\",\"workspace\":\"ws-1\"},\"keyed\":true}")
  check_zero_leak("lock", "{\"id\":112,\"subscribe\":{\"topic\":\"lock\",\"workspace\":\"ws-1\"},\"keyed\":true}")

  // Verify sibling `ws-10` survived 100% intact (no prefix bug `ws-1` vs `ws-10`)!
  match restarted.handle_wire("{\"id\":120,\"subscribe\":{\"topic\":\"workspaces\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("Sibling WS") && !txt.contains("Secret WS"), "sibling ws-10 intact while ws-1 purged")
    None => debug_assert(false, "expected workspaces")
  }
  match restarted.handle_wire("{\"id\":121,\"call\":\"settings.get\",\"params\":{\"workspace\":\"ws-10\",\"key\":\"theme\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("sibling-theme"), "sibling ws-10 pref intact")
    None => debug_assert(false, "expected ws-10 settings.get")
  }

  // Subsequent newer Cloud 200 (re-join) clears `revoked`, bumps `authGen`, and restores workspace!
  restarted.auth.set_revoked("ws-1", true)
  let ag_before = restarted.auth.workspace_auth_gen("ws-1")
  restarted.bind_cloud_sync(cs)
  let req_idx = env.pending.length()
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-1", fn(_ex : effect::Exit[CloudWorkspace]) -> Unit {
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = env.rt.run_ready()
  env.answer_http(
    env.pending[req_idx].0,
    200,
    "{\"id\":\"ws-1\",\"name\":\"Rejoined WS\",\"role\":\"member\",\"members\":[{\"sub\":\"u-alice\",\"email\":\"alice@still.fail\",\"role\":\"member\"}],\"stations\":[{\"id\":\"st-1\",\"name\":\"St1\",\"online\":true}]}",
  )
  let _ = env.rt.run_ready()
  debug_assert(!restarted.auth.is_revoked("ws-1"), "newer Cloud 200 clears revoked")
  debug_assert(restarted.auth.workspace_auth_gen("ws-1") == ag_before + 1, "rejoin bumps authGen")
  match restarted.handle_wire("{\"id\":130,\"subscribe\":{\"topic\":\"workspace\",\"workspace\":\"ws-1\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("Rejoined WS"), "rejoined workspace data visible")
    None => debug_assert(false, "expected rejoined workspace")
  }
  restarted.stop()
}

// ── Test 4: Out-of-order concurrent Cloud 403 / 200 (`cloud_req_seq` anti-inversion) ──

test "auth_lifecycle 4: per-workspace monotonic cloud_req_seq drops stale 403 after new 200 and stale 200 after new 403" {
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let core = ClientCore::new("ws-race", "ws-race/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  core.set_viewer("alice@still.fail", sub="u-alice", role="owner")
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-race")
  core.bind_cloud_sync(cs)

  // Case A: Request #1 (seq 1) and Request #2 (seq 2) in flight concurrently.
  // Seq 2 succeeds with 200 FIRST; then stale seq 1 returns 403 -> MUST BE DROPPED (must NOT revoke!).
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-race", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-race", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  debug_assert(env.pending.length() == 2, "2 concurrent workspace fetches in flight")
  let req1 = env.pending[0].0
  let req2 = env.pending[1].0

  env.answer_http(req2, 200, "{\"id\":\"ws-race\",\"name\":\"Fresh WS\",\"role\":\"owner\",\"members\":[],\"stations\":[]}")
  let _ = env.rt.run_ready()
  debug_assert(!core.auth.is_revoked("ws-race"), "seq 2 succeeded")

  env.answer_http(req1, 403, "{\"error\":\"stale_forbidden\"}")
  let _ = env.rt.run_ready()
  debug_assert(!core.auth.is_revoked("ws-race"), "stale seq 1 403 MUST NOT revoke ws-race after seq 2 200")
  match store::get_workspace(env.db, "ws-race") {
    sql::SqlResult::Ok(Some(rec)) => debug_assert(rec.json.contains("Fresh WS"), "Fresh WS row preserved")
    _ => debug_assert(false, "stale 403 must not drop workspace row")
  }

  // Case B: Request #3 (seq 3) and Request #4 (seq 4) in flight concurrently.
  // Seq 4 returns 403 FIRST (revokes & drops); then stale seq 3 returns 200 -> MUST BE DROPPED (never resurrects!).
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-race", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-race", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  let req3 = env.pending[2].0
  let req4 = env.pending[3].0

  env.answer_http(req4, 403, "{\"error\":\"revoked_now\"}")
  let _ = env.rt.run_ready()
  debug_assert(core.auth.is_revoked("ws-race"), "seq 4 403 revoked ws-race")
  match store::get_workspace(env.db, "ws-race") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "seq 4 403 dropped workspace row")
  }

  env.answer_http(req3, 200, "{\"id\":\"ws-race\",\"name\":\"Zombie WS\",\"role\":\"owner\",\"members\":[],\"stations\":[]}")
  let _ = env.rt.run_ready()
  debug_assert(core.auth.is_revoked("ws-race"), "stale seq 3 200 MUST NOT clear revoked")
  match store::get_workspace(env.db, "ws-race") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "stale seq 3 200 MUST NOT resurrect Zombie WS in SQLite")
  }
  core.stop()
}

// ── Test 5: Real AccountEvent-driven role downgrade auto-unlock + per-station isolation + non-held topics unblocked ──

test "auth_lifecycle 5: real AccountEvent downgrade updates workspace.json.role, isolates two stations, rejects pre-downgrade SSE overview, never stalls non-held topics, and auto-unlocks" {
  let env = AuthSimEnv::new()
  let st1 = SimStation::new(env.rt)
  let st2 = SimStation::new(env.rt)
  st1.snapshot_json = base_codec::json_obj([("chats", base_codec::json_arr([]))])
  st2.snapshot_json = base_codec::json_obj([("chats", base_codec::json_arr([]))])

  // Seed owner workspace + two stations' overviews BEFORE ClientCore initializes
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-role"),
    base_codec::json_str("{\"id\":\"ws-role\",\"name\":\"Team\",\"role\":\"owner\",\"members\":[{\"sub\":\"u1\",\"email\":\"alice@still.fail\",\"role\":\"owner\"}],\"stations\":[{\"id\":\"st-1\",\"name\":\"St1\",\"online\":true},{\"id\":\"st-2\",\"name\":\"St2\",\"online\":true}]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-role/st-1"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-1\",\"name\":\"St1\",\"profiles\":[{\"name\":\"p1\",\"provider\":\"anthropic\"}]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-role/st-2"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-2\",\"name\":\"St2\",\"profiles\":[{\"name\":\"p2\",\"provider\":\"openai\"}]}"),
    base_codec::json_int64(1000L),
  ])

  let core = ClientCore::new("ws-role", "ws-role/st-1", env.rt, env.db, st1.transport(), fn() -> Unit {})
  core.set_viewer("alice@still.fail", sub="u1", role="owner")
  core.attach_station_transport("ws-role/st-2", st2.transport(), workspace="ws-role")
  core.start()
  let _ = env.rt.run_ready()
  // Open pre-downgrade SSE streams on both stations (`opened_auth_gen = 1`)
  st1.push_sse("id: e1\nevent: overview\ndata: {\"id\":\"st-1\",\"name\":\"St1\",\"profiles\":[{\"name\":\"p1\",\"provider\":\"anthropic\"}]}\n\n")
  st2.push_sse("id: e2\nevent: overview\ndata: {\"id\":\"st-2\",\"name\":\"St2\",\"profiles\":[{\"name\":\"p2\",\"provider\":\"openai\"}]}\n\n")
  let _ = env.rt.run_ready()

  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-role")
  core.bind_cloud_sync(cs)
  let frames : Array[String] = []
  core.set_wire_sink(fn(j : String, _b : Option[Bytes]) -> Unit {
    frames.push(j)
  })

  // Before downgrade: subscribe to `profiles` (workspace-wide) and per-station `chatRow` for st-1 and st-2
  match core.handle_wire("{\"id\":60,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-role\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(json_int_eq(txt, "authGen", 1), "initial profiles at authGen:1")
      debug_assert(txt.contains("\"manages\":true"), "owner sees manages:true before downgrade")
    }
    None => debug_assert(false, "expected profiles Value")
  }
  match core.handle_wire("{\"id\":61,\"subscribe\":{\"topic\":\"chatRow\",\"station\":\"ws-role/st-1\",\"session\":\"s1\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(json_int_eq(txt, "authGen", 1) && txt.contains("\"value\""), "initial st-1 chatRow")
    None => debug_assert(false, "expected st-1 chatRow")
  }
  match core.handle_wire("{\"id\":62,\"subscribe\":{\"topic\":\"chatRow\",\"station\":\"ws-role/st-2\",\"session\":\"s2\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(json_int_eq(txt, "authGen", 1) && txt.contains("\"value\""), "initial st-2 chatRow")
    None => debug_assert(false, "expected st-2 chatRow")
  }

  // Start real `/v1/events` WebSocket and deliver real AccountEvent `{"type":"workspaces"}`
  cs.start_events_ws(fn(_ev : CloudEvent) -> Unit {})
  let _ = env.rt.run_ready()
  let ws_open_id = env.pending[0].0
  env.sh.answer(ws_open_id, base_codec::json_obj([("id", base_codec::json_int(88))]))
  let _ = env.rt.run_ready()
  // Answer the automatic `on_open` `/v1/me` reconciliation with current owner role first
  let mut ws_next_id = 0L
  for i in 1..<env.pending.length() {
    if env.pending[i].1 == "ws.next" { ws_next_id = env.pending[i].0 }
    if env.pending[i].1 == "fetch" && j_str(env.pending[i].2, "url").ends_with("/v1/me") {
      env.answer_http(env.pending[i].0, 200, "{\"user\":{\"sub\":\"u1\",\"email\":\"alice@still.fail\"},\"workspaces\":[{\"id\":\"ws-role\",\"name\":\"Team\",\"role\":\"owner\"}]}")
    }
  }
  let _ = env.rt.run_ready()
  debug_assert(ws_next_id > 0L, "ws.next active")

  // Keep BOTH st-1 and st-2 online during downgrade so workspace-wide `profiles` waits for BOTH online stations
  // (st-1 confirms its post-downgrade `overview` first while st-2 is still connected & awaiting its `overview`).
  // Deliver real `AccountEvent` `{"type":"workspaces"}` -> CloudSync fetches `/v1/me` -> downgraded to `member`!
  let before_down = frames.length()
  let pend_mark = env.pending.length()
  env.sh.answer(ws_next_id, base_codec::json_obj([("text", base_codec::json_str("{\"type\":\"workspaces\"}"))]))
  let _ = env.rt.run_ready()
  let mut me_down_id = 0L
  for i in pend_mark..<env.pending.length() {
    if env.pending[i].1 == "fetch" && j_str(env.pending[i].2, "url").ends_with("/v1/me") {
      me_down_id = env.pending[i].0
    }
  }
  debug_assert(me_down_id > 0L, "AccountEvent workspaces triggered /v1/me")
  env.answer_http(me_down_id, 200, "{\"user\":{\"sub\":\"u1\",\"email\":\"alice@still.fail\"},\"workspaces\":[{\"id\":\"ws-role\",\"name\":\"Team\",\"role\":\"member\"}]}")
  let _ = env.rt.run_ready()

  // Verify SQLite `workspace.json.role` was updated immediately BEFORE releasing views
  match store::get_workspace(env.db, "ws-role") {
    sql::SqlResult::Ok(Some(row)) => debug_assert(row.json.contains("\"role\":\"member\""), "apply_cloud_me updated workspace.json.role to member")
    _ => debug_assert(false, "workspace row should exist")
  }
  debug_assert(core.auth.workspace_auth_gen("ws-role") == 2, "downgrade bumped authGen 1 -> 2")
  debug_assert(core.is_workspace_downgrade_gated("ws-role"), "downgrade latch active")

  // Active sub #60 MUST emit Waiting at authGen:2 and NEVER leak manages:true!
  let mut saw_waiting_60 = false
  for i in before_down..<frames.length() {
    let f = frames[i]
    if json_int_eq(f, "id", 60) {
      debug_assert(!f.contains("\"manages\":true"), "MUST NEVER leak stale manages:true with authGen:2")
      if f.contains("\"waiting\":true") && json_int_eq(f, "authGen", 2) {
        saw_waiting_60 = true
      }
    }
  }
  debug_assert(saw_waiting_60, "downgrade emitted Waiting at authGen:2")

  // Parameterless & non-held topics MUST NOT be stalled by downgrade latch!
  let unblocked = [
    "{\"id\":70,\"subscribe\":{\"topic\":\"accounts\"},\"keyed\":true}",
    "{\"id\":71,\"subscribe\":{\"topic\":\"workspaces\"},\"keyed\":true}",
    "{\"id\":72,\"subscribe\":{\"topic\":\"workspaceMarks\"},\"keyed\":true}",
    "{\"id\":73,\"subscribe\":{\"topic\":\"status\"},\"keyed\":true}",
    "{\"id\":74,\"subscribe\":{\"topic\":\"notices\"},\"keyed\":true}",
    "{\"id\":75,\"subscribe\":{\"topic\":\"notify\"},\"keyed\":true}",
    "{\"id\":76,\"subscribe\":{\"topic\":\"presets\"},\"keyed\":true}",
    "{\"id\":77,\"subscribe\":{\"topic\":\"lock\",\"workspace\":\"ws-role\"},\"keyed\":true}",
    "{\"id\":78,\"subscribe\":{\"topic\":\"vaults\",\"workspace\":\"ws-role\"},\"keyed\":true}",
  ]
  for i in 0..<unblocked.length() {
    match core.handle_wire(unblocked[i]) {
      Some((txt, _)) => debug_assert(!txt.contains("\"waiting\":true"), "non-held topic must NOT be stalled by downgrade: " + unblocked[i])
      None => debug_assert(false, "expected Value for non-held topic")
    }
  }

  // Answer the actively triggered `/v1/workspaces/ws-role` refetch so workspace doc is confirmed
  let mut ws_refetch_id = 0L
  for i in pend_mark..<env.pending.length() {
    if env.pending[i].1 == "fetch" && j_str(env.pending[i].2, "url").ends_with("/v1/workspaces/ws-role") {
      ws_refetch_id = env.pending[i].0
    }
  }
  debug_assert(ws_refetch_id > 0L, "downgrade actively triggered GET /v1/workspaces/ws-role")
  env.answer_http(ws_refetch_id, 200, "{\"id\":\"ws-role\",\"name\":\"Team\",\"role\":\"member\",\"members\":[{\"sub\":\"u1\",\"email\":\"alice@still.fail\",\"role\":\"member\"}],\"stations\":[{\"id\":\"st-1\",\"name\":\"St1\",\"online\":true},{\"id\":\"st-2\",\"name\":\"St2\",\"online\":true}]}")
  let _ = env.rt.run_ready()

  // Stale `overview` carrying pre-downgrade `stream_auth_gen = 1` MUST be rejected!
  // With per-station record filtering, workspace-wide `profiles` is unblocked once workspace doc confirms
  // (`manages: false`), while unconfirmed `st-1`/`st-2` stale profiles (`p1`, `p2`) are strictly excluded!
  let stale_ev = wire::Event::{
    name: "overview",
    data: "{\"id\":\"st-1\",\"name\":\"St1 Stale\",\"profiles\":[{\"name\":\"p1-stale\",\"provider\":\"anthropic\"}]}",
    id: Some("e-stale"),
  }
  let _ = core.events.apply_sse_batch([stale_ev], stream_auth_gen=Some(1))
  debug_assert(!core.is_station_confirmed_for_projection("ws-role", "ws-role/st-1", "overview"), "pre-downgrade SSE overview (gen=1) MUST NOT confirm st-1")
  match core.handle_wire("{\"id\":63,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-role\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(txt.contains("\"manages\":false"), "confirmed workspace doc shows manages:false")
      debug_assert(!txt.contains("p1") && !txt.contains("p2") && !txt.contains("p1-stale"), "unconfirmed stations' stale profiles MUST be excluded at projection time")
    }
    None => debug_assert(false, "expected filtered profiles Value")
  }

  // Now advance virtual clock so st-1's actively triggered snapshot finishes AND st-1 pushes fresh post-downgrade `overview` (gen=2):
  // `st-1` (#61) unlocks AND workspace-wide `profiles` (#60) updates incrementally with ONLY `p1` (ZERO stale `p2` from unconfirmed `st-2`)!
  let before_st1 = frames.length()
  env.rt.advance(100)
  st1.push_sse("id: e-post-1\nevent: overview\ndata: {\"id\":\"st-1\",\"name\":\"St1 Post\",\"profiles\":[{\"name\":\"p1\",\"provider\":\"anthropic\"}]}\n\n")
  let _ = env.rt.run_ready()
  let mut st1_released = false
  let mut prof_has_p1_only = false
  let mut prof_leaked_p2 = false
  for i in before_st1..<frames.length() {
    let f = frames[i]
    if json_int_eq(f, "id", 61) && json_int_eq(f, "authGen", 2) && f.contains("\"value\"") {
      st1_released = true
    }
    if json_int_eq(f, "id", 60) && json_int_eq(f, "authGen", 2) {
      if f.contains("\"p1\"") {
        prof_has_p1_only = true
      }
      if f.contains("\"p2\"") {
        prof_leaked_p2 = true
      }
    }
  }
  debug_assert(st1_released, "st-1 auto-unlocked after post-downgrade snapshot at gen=2")
  debug_assert(prof_has_p1_only && !prof_leaked_p2, "st-1 confirmation emits ONLY st-1's p1 while excluding unconfirmed st-2's stale p2")

  // Now online st-2 pushes its post-downgrade `overview`:
  // Workspace-wide `profiles` (#60) incrementally emits `p2` via Delta/Value at `authGen: 2` (ZERO Waiting flicker)!
  let before_st2 = frames.length()
  st2.push_sse("id: e-post-2\nevent: overview\ndata: {\"id\":\"st-2\",\"name\":\"St2 Post\",\"profiles\":[{\"name\":\"p2\",\"provider\":\"openai\"}]}\n\n")
  env.rt.advance(100)
  let _ = env.rt.run_ready()
  let mut prof_added_p2 = false
  for i in before_st2..<frames.length() {
    let f = frames[i]
    if json_int_eq(f, "id", 60) && json_int_eq(f, "authGen", 2) && f.contains("\"p2\"") {
      debug_assert(!f.contains("\"waiting\":true"), "st-2 confirmation MUST NOT flicker Waiting")
      prof_added_p2 = true
    }
  }
  debug_assert(prof_added_p2, "profiles incrementally added st-2's p2 once st-2 confirmed at gen=2")
  cs.stop()
  core.stop()
}

// ── Test 6: Full-set canonical Lock digest (startup seed, device removal, station change, newcomer safe) ──

test "auth_lifecycle 6: canonical lock digest seeds on startup without bump, bumps on device removal, and newcomer absent from lock.members is NEVER revoked" {
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)

  let alice_seed = make_seed(11)
  let bob_seed = make_seed(22)
  let alice_key = ed25519_key_id(alice_seed)
  let bob_key = ed25519_key_id(bob_seed)
  let alice_dev_id = hex_64("a")
  let bob_dev_id = hex_64("b")

  let g_signed = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-ldig")),
      ("seq", form::Json::Num(0.0)),
      ("prev", form::Json::Null),
      ("at", form::Json::Num(1790000000.0)),
      ("kind", form::Json::Str("genesis")),
      (
        "body",
        form::Json::Obj([
          ("owner", form::Json::Str("alice")),
          ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
          ("rp_id", form::Json::Str("app.still.fail")),
          ("cloud_keys", form::Json::Obj([])),
          (
            "members",
            form::Json::Arr([
              form::Json::Obj([
                ("sub", form::Json::Str("alice")),
                ("email", form::Json::Str("alice@example.com")),
                ("role", form::Json::Str("owner")),
              ]),
              form::Json::Obj([
                ("sub", form::Json::Str("bob")),
                ("email", form::Json::Str("bob@example.com")),
                ("role", form::Json::Str("admin")),
              ]),
            ]),
          ),
          (
            "devices",
            form::Json::Arr([
              form::Json::Obj([
                ("id", form::Json::Str(alice_dev_id)),
                ("sub", form::Json::Str("alice")),
                ("kind", form::Json::Str("app")),
                ("label", form::Json::Str("Alice Mac")),
                ("sign_key", form::Json::Str(alice_key)),
              ]),
              form::Json::Obj([
                ("id", form::Json::Str(bob_dev_id)),
                ("sub", form::Json::Str("bob")),
                ("kind", form::Json::Str("app")),
                ("label", form::Json::Str("Bob Linux")),
                ("sign_key", form::Json::Str(bob_key)),
              ]),
            ]),
          ),
          ("passkeys", form::Json::Arr([])),
          ("stations", form::Json::Arr([])),
          ("gateways", form::Json::Arr([])),
        ]),
      ),
    ]),
  ) {
    Ok(e) => e
    Err(e) => panic("genesis sign: " + e)
  }
  let root_hash = match lock::entry_hash(g_signed, native_lock_crypto()) { Ok(h) => h; Err(_) => panic("root hash") }

  // 6a. Apply initial genesis on core1 -> persisted in SQLite `workspace_pref("ws-ldig", "lock")`
  let core1 = ClientCore::new("ws-ldig", "ws-ldig/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  match core1.apply_lock_chain([g_signed], root_hash) {
    Ok(_) => ()
    Err(e) => panic("apply genesis failed: " + e)
  }
  core1.stop()

  // 6b. Restart on same SQLite DB as a NEWCOMER ("charlie", NOT in `lock.members`!)
  // Startup seeding MUST NOT bump authGen/vaultGen AND newcomer MUST NEVER be marked `revoked`!
  let core2 = ClientCore::new("ws-ldig", "ws-ldig/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  core2.set_viewer("charlie@example.com", sub="charlie", role="member")
  debug_assert(core2.auth.workspace_auth_gen("ws-ldig") == 1, "startup lock seed must NOT spuriously bump authGen")
  debug_assert(core2.auth.vault_workspace_gen("ws-ldig") == 1, "startup lock seed must NOT spuriously bump vaultGen")
  debug_assert(!core2.auth.is_revoked("ws-ldig"), "newcomer absent from lock.members MUST NEVER trigger revoked!")

  // Re-delivering identical genesis chain does NOT bump authGen or vaultGen
  match core2.apply_lock_chain([g_signed], root_hash) {
    Ok(_) => ()
    Err(e) => panic("re-deliver genesis failed: " + e)
  }
  debug_assert(core2.auth.workspace_auth_gen("ws-ldig") == 1, "duplicate lock chain does not bump authGen")
  debug_assert(core2.auth.vault_workspace_gen("ws-ldig") == 1, "duplicate lock chain does not bump vaultGen")

  // SafeModeView projects cleanly for newcomer without revocation
  let sm = core2.current_safe_mode_view()
  debug_assert(sm.locked, "newcomer sees workspace locked state cleanly")

  // 6c. Add a station (seq=1): full canonical digest changes, security (member/device) digest unchanged -> bumps authGen ONLY!
  let st_add = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-ldig")),
      ("seq", form::Json::Num(1.0)),
      ("prev", form::Json::Str(root_hash)),
      ("at", form::Json::Num(1790000010.0)),
      ("kind", form::Json::Str("station")),
      (
        "body",
        form::Json::Obj([
          ("key", form::Json::Str(hex_64("c"))),
          ("name", form::Json::Str("Tokyo Station")),
        ]),
      ),
    ]),
  ) {
    Ok(e) => e
    Err(e) => panic("station entry sign: " + e)
  }
  let h1 = match lock::entry_hash(st_add, native_lock_crypto()) { Ok(h) => h; Err(_) => panic("h1") }
  match core2.apply_lock_chain([g_signed, st_add], root_hash) {
    Ok(_) => ()
    Err(e) => panic("apply station add failed: " + e)
  }
  debug_assert(core2.auth.workspace_auth_gen("ws-ldig") == 2, "station change bumps authGen 1 -> 2")
  debug_assert(core2.auth.vault_workspace_gen("ws-ldig") == 1, "station-only change keeps vaultGen at 1")
  debug_assert(!core2.auth.is_revoked("ws-ldig"), "still NOT revoked for newcomer")

  // 6d. Remove Bob's device (seq=2): security digest changes -> bumps BOTH authGen AND vaultGen!
  let dev_rm = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-ldig")),
      ("seq", form::Json::Num(2.0)),
      ("prev", form::Json::Str(h1)),
      ("at", form::Json::Num(1790000020.0)),
      ("kind", form::Json::Str("device.remove")),
      ("body", form::Json::Obj([("id", form::Json::Str(bob_dev_id))])),
    ]),
  ) {
    Ok(e) => e
    Err(e) => panic("device_remove sign: " + e)
  }
  match core2.apply_lock_chain([g_signed, st_add, dev_rm], root_hash) {
    Ok(_) => ()
    Err(e) => panic("apply device_remove failed: " + e)
  }
  debug_assert(core2.auth.workspace_auth_gen("ws-ldig") == 3, "device removal bumps authGen 2 -> 3")
  debug_assert(core2.auth.vault_workspace_gen("ws-ldig") == 2, "device removal bumps vaultGen 1 -> 2")
  debug_assert(!core2.auth.is_revoked("ws-ldig"), "lock changes NEVER derive revoked")
  core2.stop()
}

// ── Test 7: guarded_read_k fail-open retry on auth_stale + immediate abort on revoked ──

test "auth_lifecycle 7: guarded_read_k retries bounded on auth_stale and converges, while revoked aborts with 0 writes and 0 retries" {
  let rt = effect::Runtime::new()
  let tracker = AuthGenTracker::new()
  tracker.ensure_workspace("ws-g")

  // 7a. Concurrent `authGen` bump mid-I/O (`auth_stale`, `!revoked`) -> retries with fresh cap and converges!
  let io_attempts = [0]
  let committed = [0]
  let final_res = [-1]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    guarded_read_k(
      tracker,
      "ws-g",
      fn(cap : WorkspaceCapability, io_k : (effect::Exit[Int]) -> Unit) -> Unit {
        io_attempts[0] = io_attempts[0] + 1
        if io_attempts[0] == 1 {
          // Simulate concurrent non-revoking authGen bump (e.g. role change or lock update) during I/O
          let _ = tracker.bump_workspace("ws-g")
        }
        io_k(effect::Exit::Succeeded(cap.auth_gen * 100))
      },
      fn(cap : WorkspaceCapability, v : Int) -> Result[Int, String] {
        committed[0] = committed[0] + 1
        debug_assert(cap.auth_gen == 2, "commit only runs under converged fresh cap authGen=2")
        Ok(v + 1)
      },
      fn(ex : effect::Exit[Int]) -> Unit {
        match ex {
          effect::Exit::Succeeded(r) => { final_res[0] = r }
          _ => ()
        }
        k(effect::Exit::Succeeded(()))
      },
    )
  })
  let _ = rt.run_ready()
  debug_assert(io_attempts[0] == 2, "fail-open guarded_read_k retried once on auth_stale")
  debug_assert(committed[0] == 1, "stale first result was NOT committed; converged second result committed once")
  debug_assert(final_res[0] == 201, "converged with fresh cap value")

  // 7b. Revocation mid-I/O -> immediate clean abort with 0 commits and 0 retries!
  let rev_io_attempts = [0]
  let rev_committed = [0]
  let rev_failed = [false]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    guarded_read_k(
      tracker,
      "ws-g",
      fn(_cap : WorkspaceCapability, io_k : (effect::Exit[Int]) -> Unit) -> Unit {
        rev_io_attempts[0] = rev_io_attempts[0] + 1
        tracker.set_revoked("ws-g", true)
        let _ = tracker.bump_workspace_and_vault("ws-g")
        io_k(effect::Exit::Succeeded(999))
      },
      fn(_cap : WorkspaceCapability, v : Int) -> Result[Int, String] {
        rev_committed[0] = rev_committed[0] + 1
        Ok(v)
      },
      fn(ex : effect::Exit[Int]) -> Unit {
        match ex {
          effect::Exit::Failed(_) => { rev_failed[0] = true }
          _ => ()
        }
        k(effect::Exit::Succeeded(()))
      },
    )
  })
  let _ = rt.run_ready()
  debug_assert(rev_io_attempts[0] == 1, "revoked mid-I/O does NOT retry")
  debug_assert(rev_committed[0] == 0, "revoked mid-I/O writes 0 rows")
  debug_assert(rev_failed[0], "revoked guarded_read_k fails cleanly")

  // 7c. Already-revoked workspace -> aborted BEFORE starting any I/O!
  let pre_io = [0]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    guarded_read_k(
      tracker,
      "ws-g",
      fn(_cap : WorkspaceCapability, io_k : (effect::Exit[Int]) -> Unit) -> Unit {
        pre_io[0] = pre_io[0] + 1
        io_k(effect::Exit::Succeeded(1))
      },
      fn(_cap : WorkspaceCapability, v : Int) -> Result[Int, String] { Ok(v) },
      fn(_ex : effect::Exit[Int]) -> Unit { k(effect::Exit::Succeeded(())) },
    )
  })
  let _ = rt.run_ready()
  debug_assert(pre_io[0] == 0, "pre-revoked guarded_read_k executes 0 I/O")
}

// ── Test 8: Real Cloud `/v1/events` WebSocket AccountEvent (`workspace`) drives revocation to ClientCore ──

test "auth_lifecycle 8: CloudSync /v1/events WebSocket delivers real AccountEvent workspace -> 403 triggers atomic drop_workspace" {
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-ws"),
    base_codec::json_str("{\"id\":\"ws-ws\",\"name\":\"Live WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let core = ClientCore::new("ws-ws", "ws-ws/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-ws")
  core.bind_cloud_sync(cs)

  let ws_events_seen : Array[String] = []
  cs.start_events_ws(fn(ev : CloudEvent) -> Unit {
    match ev {
      CloudEvent::WorkspaceChanged(wid, _) => ws_events_seen.push("ws:" + wid)
      CloudEvent::WorkspacesChanged(_) => ws_events_seen.push("workspaces")
      _ => ()
    }
  })
  let _ = env.rt.run_ready()
  debug_assert(cs.is_events_ws_running(), "events WS loop active")
  debug_assert(env.pending.length() == 1 && env.pending[0].1 == "ws.open", "opened /v1/events WebSocket")

  // Complete ws.open -> triggers automatic `on_open` `/v1/me` reconciliation + `ws.next`
  env.sh.answer(env.pending[0].0, base_codec::json_obj([("id", base_codec::json_int(77))]))
  let _ = env.rt.run_ready()
  let mut ws_next_id = 0L
  let mut open_me_id = 0L
  for i in 1..<env.pending.length() {
    if env.pending[i].1 == "ws.next" { ws_next_id = env.pending[i].0 }
    if env.pending[i].1 == "fetch" && j_str(env.pending[i].2, "url") == "https://cloud.example/v1/me" { open_me_id = env.pending[i].0 }
  }
  debug_assert(ws_next_id > 0L && open_me_id > 0L, "ws.open triggered both ws.next and /v1/me reconciliation")
  env.answer_http(open_me_id, 200, "{\"user\":{\"sub\":\"u1\",\"email\":\"a@b.c\"},\"workspaces\":[{\"id\":\"ws-ws\",\"name\":\"Live WS\",\"role\":\"owner\"}]}")
  let _ = env.rt.run_ready()

  // Push REAL `AccountEvent` `{"type":"workspace","id":"ws-ws"}` (cloud/src/types.ts:49-63) -> triggers GET /v1/workspaces/ws-ws -> 403!
  let pend_mark = env.pending.length()
  env.sh.answer(
    ws_next_id,
    base_codec::json_obj([("text", base_codec::json_str("{\"type\":\"workspace\",\"id\":\"ws-ws\"}"))]),
  )
  let _ = env.rt.run_ready()
  debug_assert(ws_events_seen.length() == 1 && ws_events_seen[0] == "ws:ws-ws", "WS real workspace event callback invoked")
  let mut fetch_id = 0L
  for i in pend_mark..<env.pending.length() {
    if env.pending[i].1 == "fetch" && j_str(env.pending[i].2, "url") == "https://cloud.example/v1/workspaces/ws-ws" {
      fetch_id = env.pending[i].0
      break
    }
  }
  debug_assert(fetch_id > 0L, "WS workspace event triggered authoritative GET /v1/workspaces/ws-ws")
  env.answer_http(fetch_id, 403, "{\"error\":\"forbidden\"}")
  let _ = env.rt.run_ready()
  debug_assert(core.auth.is_revoked("ws-ws"), "Cloud /v1/events WS -> 403 revoked ws-ws in real time")
  match store::get_workspace(env.db, "ws-ws") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "WS revocation atomically dropped ws-ws from SQLite")
  }
  cs.stop()
  core.stop()
}

// ── Test 9 (Block 6 #1): Revocation vs late LocalOutbox 4xx rollback, late fetch_lock_k, MdStore pending, usage:<ws> ──

test "auth_lifecycle 9: revocation seals late LocalOutbox 4xx overlay rollback, late fetch_lock_k, MdStore pending writes, and usage:<ws>" {
  let env = AuthSimEnv::new()
  let mut held_overlay_k : Option[(effect::Exit[HttpReply]) -> Unit] = None
  let mut held_lock_k : Option[(effect::Exit[HttpReply]) -> Unit] = None
  let held_transport = StationTransport::{
    request_k: fn(
      _m : String,
      path : String,
      _h : Array[(String, String)],
      _b : Bytes,
      k : (effect::Exit[HttpReply]) -> Unit,
    ) -> Unit {
      if path == "/lock" {
        held_lock_k = Some(k)
      } else {
        held_overlay_k = Some(k)
      }
    },
    stream_k: fn(_p : String, _h : Array[(String, String)], _cb : (Bytes) -> Unit, _k : (effect::Exit[Unit]) -> Unit) -> Unit {},
  }
  let core = ClientCore::new("ws-late", "ws-late/st-1", env.rt, env.db, held_transport, fn() -> Unit {})
  core.local_outbox.set_online(true)

  // Seed chat, usage:<ws>, and pending MdStore write for ws-late
  let _ = env.db.run(sql_chat_upsert(), params=[
    base_codec::json_str("ws-late/st-1"), base_codec::json_str("c-late"), base_codec::json_int(0),
    base_codec::json_num(1.0), base_codec::json_int(11), base_codec::json_str("s-late"),
    base_codec::json_int(1), base_codec::json_int64(1000L), base_codec::json_null(),
    base_codec::json_int(0), base_codec::json_int(0), base_codec::json_null(),
    base_codec::json_null(), base_codec::json_int(0), base_codec::json_int(0),
    base_codec::json_str("{\"id\":\"c-late\",\"title\":\"Original Secret\",\"thread\":11}"),
  ])
  let _ = store::put_account_doc(env.db, "usage:ws-late", "{\"tokens\":99999}")
  core.md_store.put_prepared("md-k1", "{\"text\":\"secret md\"}", "chat", 1000L)

  // Fire an optimistic overlay (captures previous_chat_json!) AND an in-flight `fetch_lock_k`
  let req = OpRequest::{
    target: OpTarget::Station("ws-late/st-1"),
    method: "PATCH",
    path: "/threads/11",
    body: Some(base_codec::json_obj([("title", base_codec::json_str("Renamed"))])),
    fallback: None,
  }
  match core.local_outbox.apply_op(env.rt, req, "c-late", "chat.rename", station=Some("ws-late/st-1")) {
    sql::SqlResult::Ok(_) => ()
    sql::SqlResult::Err(e) => panic("apply_op failed: " + e.to_string())
  }
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    core.sync.fetch_lock_k(effect::priority_shown(), fn(_ : effect::Exit[Bool]) -> Unit {
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = env.rt.run_ready()
  debug_assert(held_overlay_k.is_some() && held_lock_k.is_some(), "both overlay HTTP and lock HTTP in flight")

  // Revoke ws-late while BOTH requests are in flight!
  core.revoke_workspace("ws-late")
  debug_assert(core.auth.is_revoked("ws-late"), "ws-late revoked")
  match store::get_account_doc(env.db, "usage:ws-late") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "usage:ws-late MUST be purged by drop_workspace")
  }

  // Deliver late 403 overlay reply (which would normally roll back `previous_chat_json` into SQLite `chat`!),
  // late 200 lock reply, and `md_store.flush()` -> ZERO SQLite write-backs allowed!
  let ran_before = env.sim_db.ran.length()
  match held_overlay_k {
    Some(cb) => cb(effect::Exit::Succeeded(HttpReply::{ status: 403, headers: [], body: "{\"error\":\"denied\"}".to_bytes() }))
    None => ()
  }
  match held_lock_k {
    Some(cb) => cb(effect::Exit::Succeeded(HttpReply::{ status: 200, headers: [], body: "{\"entries\":[{\"seq\":0}]}".to_bytes() }))
    None => ()
  }
  let _ = core.md_store.flush_turn()
  let _ = env.rt.run_ready()
  debug_assert(env.sim_db.ran.length() == ran_before, "late overlay 4xx + late lock + cleared MdStore must execute ZERO SQL statements")
  match store::get_chat_by_key(env.db, "ws-late/st-1", 0, "c-late") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "late 4xx overlay rollback MUST NOT resurrect chat row in SQLite")
  }
  core.stop()
}

// ── Test 10 (Block 6 #2): Failed drop_workspace -> immediate refusal + persistent revoked_pending:<ws> -> startup retry ──

test "auth_lifecycle 10: failed drop_workspace refuses reads immediately, persists revoked_pending marker, and auto-retries drop on restart" {
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-fail"),
    base_codec::json_str("{\"id\":\"ws-fail\",\"name\":\"FailDrop WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(sql_chat_upsert(), params=[
    base_codec::json_str("ws-fail/st-1"), base_codec::json_str("c-fail"), base_codec::json_int(0),
    base_codec::json_num(1.0), base_codec::json_int(55), base_codec::json_str("s-fail"),
    base_codec::json_int(1), base_codec::json_int64(1000L), base_codec::json_null(),
    base_codec::json_int(0), base_codec::json_int(0), base_codec::json_null(),
    base_codec::json_null(), base_codec::json_int(0), base_codec::json_int(0),
    base_codec::json_str("{\"id\":\"c-fail\",\"title\":\"STILL_IN_DB_SECRET\",\"thread\":55}"),
  ])
  let core = ClientCore::new("ws-fail", "ws-fail/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})

  // Inject one SQLite failure during `drop_workspace`
  env.sim_db.fail_drop_once = true
  core.revoke_workspace("ws-fail")
  debug_assert(core.auth.is_revoked("ws-fail"), "ws-fail marked revoked even when drop_workspace fails")

  // Marker MUST remain in SQLite because drop_workspace failed
  match store::get_account_doc(env.db, "revoked_pending:ws-fail") {
    sql::SqlResult::Ok(Some(_)) => ()
    _ => debug_assert(false, "revoked_pending:ws-fail MUST remain persisted after failed drop_workspace")
  }
  // Even though SQLite still has rows, EVERY topic for ws-fail MUST refuse immediately (`waiting:true`, 0 secret leak)!
  let blocked_subs = [
    "{\"id\":201,\"subscribe\":{\"topic\":\"workspace\",\"workspace\":\"ws-fail\"},\"keyed\":true}",
    "{\"id\":202,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-fail\"},\"keyed\":true}",
    "{\"id\":203,\"subscribe\":{\"topic\":\"chat\",\"station\":\"ws-fail/st-1\",\"thread\":55},\"keyed\":true}",
    "{\"id\":204,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-fail\"},\"keyed\":true}",
    "{\"id\":205,\"subscribe\":{\"topic\":\"vaults\",\"workspace\":\"ws-fail\"},\"keyed\":true}",
  ]
  for i in 0..<blocked_subs.length() {
    match core.handle_wire(blocked_subs[i]) {
      Some((txt, _)) => {
        debug_assert(txt.contains("\"waiting\":true"), "revoked ws-fail must return Waiting even if DB drop failed")
        debug_assert(!txt.contains("FailDrop WS") && !txt.contains("STILL_IN_DB_SECRET"), "0 secret leak on failed drop")
      }
      None => debug_assert(false, "expected Waiting")
    }
  }
  core.stop()

  // Restart ClientCore on same DB (now DB succeeds): startup scans `revoked_pending:ws-fail`,
  // retries `drop_workspace`, purges all rows, and deletes the marker!
  let restarted = ClientCore::new("ws-fail", "ws-fail/st-1", env.rt, env.db, core_offline_transport(), fn() -> Unit {})
  debug_assert(restarted.auth.is_revoked("ws-fail"), "startup recovery marks ws-fail revoked")
  match store::get_account_doc(env.db, "revoked_pending:ws-fail") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "revoked_pending:ws-fail deleted once retry drop_workspace succeeded")
  }
  match store::get_workspace(env.db, "ws-fail") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "ws-fail workspace row dropped on startup retry")
  }
  match store::get_chat_by_key(env.db, "ws-fail/st-1", 0, "c-fail") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "ws-fail chat row dropped on startup retry")
  }
  restarted.stop()
}

// ── Test 11 (Block 6 #3): Offline revocation + restart Data.retain() reconciliation ──

test "auth_lifecycle 11: offline revocation purged on restart by CloudSync /v1/me retain() against SQLite workspaces" {
  let env = AuthSimEnv::new()
  // Seed two workspaces in SQLite before restart
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-keep"),
    base_codec::json_str("{\"id\":\"ws-keep\",\"name\":\"Keep WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-gone"),
    base_codec::json_str("{\"id\":\"ws-gone\",\"name\":\"Offline Revoked WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = store::put_account_doc(env.db, "usage:ws-gone", "{\"cost\":42}")
  let _ = store::put_workspace_pref(env.db, "ws-gone", "theme", "\"secret\"")

  // Cold restart: fresh ClientCore + fresh CloudSync (seeds `known_workspaces` from SQLite!)
  let core = ClientCore::new("ws-keep", "ws-keep/st-1", env.rt, env.db, core_offline_transport(), fn() -> Unit {}, has_live_transport=false)
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-retain")
  core.bind_cloud_sync(cs)

  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  debug_assert(env.pending.length() == 1, "fetched /v1/me")
  // Server returns ONLY ws-keep (ws-gone was revoked while client was offline!)
  env.answer_http(env.pending[0].0, 200, "{\"user\":{\"sub\":\"u1\",\"email\":\"a@b.c\"},\"workspaces\":[{\"id\":\"ws-keep\",\"name\":\"Keep WS\",\"role\":\"owner\"}]}")
  let _ = env.rt.run_ready()

  debug_assert(core.auth.is_revoked("ws-gone"), "retain() revoked offline-removed ws-gone")
  debug_assert(!core.auth.is_revoked("ws-keep"), "ws-keep remains active")
  match store::get_workspace(env.db, "ws-gone") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "ws-gone dropped from SQLite")
  }
  match store::get_account_doc(env.db, "usage:ws-gone") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "usage:ws-gone dropped from SQLite")
  }
  match store::get_workspace(env.db, "ws-keep") {
    sql::SqlResult::Ok(Some(_)) => ()
    _ => debug_assert(false, "ws-keep preserved")
  }
  core.stop()
}

// ── Test 12 (Block 6 #4): Bidirectional /v1/me vs /v1/workspaces out-of-order + credential 403 indirect check ──

test "auth_lifecycle 12: unified monotonic cloud_req_seq blocks bidirectional /v1/me vs /v1/workspaces inversions & cred 403 delegates to workspace GET" {
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let core = ClientCore::new("ws-bi", "ws-bi/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-bi")
  core.bind_cloud_sync(cs)

  // Subcase A: `/v1/workspaces/ws-bi` (seq 1) and `/v1/me` (seq 2) in flight concurrently.
  // `/v1/me` (seq 2) returns 200 with `ws-bi` FIRST -> stale `/v1/workspaces/ws-bi` (seq 1) 403 MUST be dropped!
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-bi", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  let ws_req1 = env.pending[0].0
  let me_req2 = env.pending[1].0

  env.answer_http(me_req2, 200, "{\"user\":{\"sub\":\"u1\",\"email\":\"a@b.c\"},\"workspaces\":[{\"id\":\"ws-bi\",\"name\":\"Bi WS\",\"role\":\"owner\"}]}")
  let _ = env.rt.run_ready()
  env.answer_http(ws_req1, 403, "{\"error\":\"stale_403\"}")
  let _ = env.rt.run_ready()
  debug_assert(!core.auth.is_revoked("ws-bi"), "stale seq-1 workspace 403 MUST NOT override newer seq-2 /v1/me 200")

  // Subcase B: `/v1/me` (seq 3) and `/v1/workspaces/ws-bi` (seq 4) in flight concurrently.
  // `/v1/workspaces/ws-bi` (seq 4) returns 403 FIRST (revokes ws-bi!) -> stale `/v1/me` (seq 3) 200 listing ws-bi MUST NOT resurrect it!
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-bi", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  let me_req3 = env.pending[2].0
  let ws_req4 = env.pending[3].0

  env.answer_http(ws_req4, 403, "{\"error\":\"revoked_now\"}")
  let _ = env.rt.run_ready()
  debug_assert(core.auth.is_revoked("ws-bi"), "seq-4 workspace 403 revoked ws-bi")

  env.answer_http(me_req3, 200, "{\"user\":{\"sub\":\"u1\",\"email\":\"a@b.c\"},\"workspaces\":[{\"id\":\"ws-bi\",\"name\":\"Zombie Bi WS\",\"role\":\"owner\"}]}")
  let _ = env.rt.run_ready()
  debug_assert(core.auth.is_revoked("ws-bi"), "stale seq-3 /v1/me 200 MUST NOT un-revoke ws-bi")
  match store::get_account_doc(env.db, "me") {
    sql::SqlResult::Ok(Some(me_raw)) => debug_assert(!me_raw.contains("ws-bi"), "stale ws-bi scrubbed from persisted account_doc(me)")
    _ => debug_assert(false, "me doc expected")
  }

  // Subcase C: `fetch_member_credential_k` 403 NEVER directly revokes; it clears cred cache & triggers GET /v1/workspaces/<ws>
  let pend_c = env.pending.length()
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_member_credential_k("ws-cred", "dev-1", 1000L, fn(_ : effect::Exit[MemberCredential]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  let cred_req = env.pending[pend_c].0
  env.answer_http(cred_req, 403, "{\"error\":\"cred_denied\"}")
  let _ = env.rt.run_ready()
  debug_assert(!core.auth.is_revoked("ws-cred"), "cred 403 alone MUST NOT directly revoke ws-cred")
  let mut verify_ws_req = 0L
  for i in (pend_c + 1)..<env.pending.length() {
    if env.pending[i].1 == "fetch" && j_str(env.pending[i].2, "url").ends_with("/v1/workspaces/ws-cred") {
      verify_ws_req = env.pending[i].0
    }
  }
  debug_assert(verify_ws_req > 0L, "cred 403 triggered authoritative GET /v1/workspaces/ws-cred")
  env.answer_http(verify_ws_req, 403, "{\"error\":\"confirmed_revoked\"}")
  let _ = env.rt.run_ready()
  debug_assert(core.auth.is_revoked("ws-cred"), "authoritative workspace GET 403 revoked ws-cred")
  core.stop()
}

// ── Test 13 (Block 6 #6): Cross-workspace attached station isolation ──

test "auth_lifecycle 13: cross-workspace attach_station_transport binds true workspace, isolates revocation, and never unlocks another workspace latch" {
  let env = AuthSimEnv::new()
  let st_a = SimStation::new(env.rt)
  let st_b = SimStation::new(env.rt)
  st_a.snapshot_json = base_codec::json_obj([("chats", base_codec::json_arr([]))])
  st_b.snapshot_json = base_codec::json_obj([("chats", base_codec::json_arr([]))])

  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-A"),
    base_codec::json_str("{\"id\":\"ws-A\",\"name\":\"WS A\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-B"),
    base_codec::json_str("{\"id\":\"ws-B\",\"name\":\"WS B\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])

  let core = ClientCore::new("ws-A", "ws-A/st-a", env.rt, env.db, st_a.transport(), fn() -> Unit {})
  core.attach_station_transport("ws-B/st-b", st_b.transport())
  core.start()
  let _ = env.rt.run_ready()

  // Seed stale overview for ws-A/st-a before downgrade
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-A/st-a"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-a\",\"name\":\"St A\",\"profiles\":[{\"name\":\"stale-prof-a\"}]}"),
    base_codec::json_int64(1000L),
  ])
  // Downgrade ws-A (`owner -> member`) while ws-B/st-b sends fresh `overview` at high authGen:
  // ws-B/st-b reads MUST NOT confirm ws-A/st-a or unlock ws-A's single-station latch!
  let _ = core.update_workspace_role("ws-A", "member", confirm_workspace_doc=true)
  debug_assert(core.is_workspace_downgrade_gated("ws-A"), "ws-A latch active")
  match core.extra_events.get("ws-B/st-b") {
    Some(ev_b) => {
      debug_assert(ev_b.workspace == "ws-B", "extra_events bound to true workspace ws-B (NOT self.workspace ws-A!)")
      let ov = wire::Event::{ name: "overview", data: "{\"id\":\"st-b\",\"name\":\"St B\"}", id: Some("eb1") }
      let _ = ev_b.apply_sse_batch([ov], stream_auth_gen=Some(core.auth.workspace_auth_gen("ws-A")))
    }
    None => debug_assert(false, "expected ws-B/st-b extra_events")
  }
  debug_assert(!core.is_station_confirmed_for_projection("ws-A", "ws-A/st-a", "overview"), "ws-B/st-b overview MUST NOT confirm ws-A/st-a")
  match core.handle_wire("{\"id\":301,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-A\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(!txt.contains("stale-prof-a"), "ws-B/st-b overview MUST NOT expose stale ws-A/st-a profiles")
    None => debug_assert(false, "expected filtered profiles")
  }
  match core.handle_wire("{\"id\":302,\"subscribe\":{\"topic\":\"chatRow\",\"station\":\"ws-A/st-a\",\"session\":\"s-a\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"waiting\":true"), "ws-B/st-b overview MUST NOT unlock ws-A/st-a single-station topic")
    None => debug_assert(false, "expected Waiting for ws-A/st-a chatRow")
  }

  // Revoke ws-B -> blocks ws-B/st-b writes immediately while leaving ws-A completely intact!
  core.revoke_workspace("ws-B")
  debug_assert(core.auth.is_revoked("ws-B"), "ws-B revoked")
  debug_assert(!core.auth.is_revoked("ws-A"), "ws-A unaffected by ws-B revocation")
  match core.local_outbox.send_message(env.rt, 9, "ck-b1", "alice", "blocked", 2000L, station=Some("ws-B/st-b")) {
    sql::SqlResult::Err(_) => ()
    sql::SqlResult::Ok(_) => debug_assert(false, "revoked ws-B/st-b must refuse send_message")
  }
  core.stop()
}

// ── Test 14 (Block 6 #7 + Block 5): Device-level monotonic connSeq, single-vault isolation, headless handshake preservation, cold-start lock ──

test "auth_lifecycle 14: device-level monotonic connSeq across accounts & read-only DB, single-vault isolation, handshake eviction guard, and cold-start lock" {
  // 14a. Device-level connSeq strictly monotonic across different account DBs AND when persistence is read-only
  let persisted = [0L]
  let d1 = AuthGenTracker::open_with_device(
    fn() -> Int64 { persisted[0] },
    fn(v : Int64) -> Unit { persisted[0] = v },
    now_ms=1700000001000L,
  )
  let d2 = AuthGenTracker::open_with_device(
    fn() -> Int64 { persisted[0] },
    fn(v : Int64) -> Unit { persisted[0] = v },
    now_ms=1700000001000L,
  )
  // Simulate read-only persistence failure (save no-ops) with advancing wall clock -> STILL strictly monotonic!
  let d3 = AuthGenTracker::open_with_device(
    fn() -> Int64 { persisted[0] },
    fn(_v : Int64) -> Unit {},
    now_ms=1700000002000L,
  )
  debug_assert(d1.conn_seq >= 1700000001000000L, "d1 anchored at wall-clock microseconds")
  debug_assert(d2.conn_seq > d1.conn_seq, "d2 strictly > d1 even within same ms")
  debug_assert(d3.conn_seq > d2.conn_seq, "d3 strictly > d2 even if persistence is read-only")

  // 14b. Single-vault `bump_vault(ws, "v1")` does NOT invalidate sibling vault `"v2"`
  d1.ensure_workspace("ws-v")
  let snap = AuthCapability::capture(d1)
  let cap_v1 = snap.vault("ws-v", "v1")
  let cap_v2 = snap.vault("ws-v", "v2")
  let _ = d1.bump_vault("ws-v", vault_id="v1")
  debug_assert(!cap_v1.is_valid(d1), "v1 invalidated by bump_vault(v1)")
  debug_assert(cap_v2.is_valid(d1), "sibling vault v2 MUST NOT be invalidated by bump_vault(v1)")

  // 14c. Headless `pending_wire_events` (>256) NEVER evicts the latest `{"id":0,"auth":...}` handshake
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let core = ClientCore::new("ws-evict", "ws-evict/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  let hs = core.emit_auth_handshake()
  for i in 0..<280 {
    core.emit_wire_out("{\"id\":" + (i + 1).to_string() + ",\"delta\":[]}")
  }
  let drained = core.drain_pending_wire_events()
  debug_assert(drained.length() == 256, "pending_wire_events bounded to 256")
  let mut kept_hs = false
  for i in 0..<drained.length() {
    if drained[i].0 == hs {
      kept_hs = true
      break
    }
  }
  debug_assert(kept_hs, "latest {id:0, auth} handshake MUST NEVER be evicted from pending_wire_events")

  // 14d. Cold-start first verified lock chain seeds digest WITHOUT spuriously bumping authGen/vaultGen
  let alice_seed = make_seed(33)
  let alice_key = ed25519_key_id(alice_seed)
  let g_cold = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-evict")),
      ("seq", form::Json::Num(0.0)),
      ("prev", form::Json::Null),
      ("at", form::Json::Num(1790000000.0)),
      ("kind", form::Json::Str("genesis")),
      ("body", form::Json::Obj([
        ("owner", form::Json::Str("alice")),
        ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
        ("rp_id", form::Json::Str("app.still.fail")),
        ("cloud_keys", form::Json::Obj([])),
        ("members", form::Json::Arr([form::Json::Obj([("sub", form::Json::Str("alice")), ("email", form::Json::Str("alice@example.com")), ("role", form::Json::Str("owner"))])])),
        ("devices", form::Json::Arr([form::Json::Obj([("id", form::Json::Str(hex_64("d"))), ("sub", form::Json::Str("alice")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Mac")), ("sign_key", form::Json::Str(alice_key))])])),
        ("passkeys", form::Json::Arr([])),
        ("stations", form::Json::Arr([])),
        ("gateways", form::Json::Arr([])),
      ])),
    ]),
  ) {
    Ok(e) => e
    Err(e) => panic("cold genesis sign: " + e)
  }
  let cold_root = match lock::entry_hash(g_cold, native_lock_crypto()) { Ok(h) => h; Err(_) => panic("cold root") }
  match core.apply_lock_chain([g_cold], cold_root) {
    Ok(_) => ()
    Err(e) => panic("cold apply_lock_chain: " + e)
  }
  debug_assert(core.auth.workspace_auth_gen("ws-evict") == 1, "cold-start first lock MUST NOT spuriously bump authGen")
  debug_assert(core.auth.vault_workspace_gen("ws-evict") == 1, "cold-start first lock MUST NOT spuriously bump vaultGen")
  core.stop()
}

// ── Test 15 (R3 P0-1): Stale /v1/me MUST NEVER drop a workspace kept by a newer /v1/workspaces 200 + cred_cache epoch guard ──

test "auth_lifecycle 15: stale /v1/me (seq N) after newer /v1/workspaces 200 (seq N+1) preserves workspace & in-flight cred cannot poison revoked cache" {
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let core = ClientCore::new("ws-live", "ws-live/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-r3")
  core.bind_cloud_sync(cs)

  // Seed ws-live in SQLite so `apply_cloud_me` would have dropped it if it used filtered `accepted_workspaces`!
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-live"),
    base_codec::json_str("{\"id\":\"ws-live\",\"name\":\"Live WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])

  // Start `/v1/me` (seq 1) FIRST, then `/v1/workspaces/ws-live` (seq 2) SECOND.
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-live", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  let me_req1 = env.pending[0].0
  let ws_req2 = env.pending[1].0

  // Newer seq-2 `/v1/workspaces/ws-live` 200 returns FIRST (role=member).
  env.answer_http(ws_req2, 200, "{\"id\":\"ws-live\",\"name\":\"Live WS\",\"role\":\"member\",\"members\":[],\"stations\":[]}")
  let _ = env.rt.run_ready()
  debug_assert(!core.auth.is_revoked("ws-live"), "ws-live active after seq-2 200")

  // Now older seq-1 `/v1/me` 200 returns listing `ws-live` (with old role=owner):
  // MUST NOT revoke or drop `ws-live`, and MUST NOT scrub `ws-live` from `account_doc("me")`!
  env.answer_http(me_req1, 200, "{\"user\":{\"sub\":\"u1\",\"email\":\"a@b.c\"},\"workspaces\":[{\"id\":\"ws-live\",\"name\":\"Live WS\",\"role\":\"owner\"}]}")
  let _ = env.rt.run_ready()
  debug_assert(!core.auth.is_revoked("ws-live"), "stale /v1/me MUST NEVER revoke workspace still present in raw /v1/me")
  match store::get_workspace(env.db, "ws-live") {
    sql::SqlResult::Ok(Some(_)) => ()
    _ => debug_assert(false, "ws-live row MUST remain intact in SQLite after stale /v1/me")
  }
  match store::get_account_doc(env.db, "me") {
    sql::SqlResult::Ok(Some(me_raw)) => debug_assert(me_raw.contains("ws-live"), "ws-live MUST NOT be scrubbed from account_doc(me) when user still belongs to it")
    _ => debug_assert(false, "account_doc(me) expected")
  }

  // In-flight `fetch_member_credential_k` 200 arriving AFTER concurrent revocation MUST NOT populate cred_cache!
  let pend_cred = env.pending.length()
  let cred_failed : Array[Bool] = [false]
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_member_credential_k("ws-live", "dev-1", 1000L, fn(ex : effect::Exit[MemberCredential]) -> Unit {
      match ex {
        effect::Exit::Failed(_) => { cred_failed[0] = true }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = env.rt.run_ready()
  let cred_req_id = env.pending[pend_cred].0

  // Revoke ws-live via newer workspace 403 while credential request is in flight.
  let pend_rev = env.pending.length()
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-live", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  env.answer_http(env.pending[pend_rev].0, 403, "{\"error\":\"revoked\"}")
  let _ = env.rt.run_ready()
  debug_assert(core.auth.is_revoked("ws-live"), "ws-live revoked")

  // Now the stale in-flight credential 200 returns -> MUST fail & MUST NOT populate cache!
  env.answer_http(cred_req_id, 200, "{\"credential\":\"jwt-stale\",\"issued_at\":1000,\"expires_at\":999999,\"relay_url\":\"\"}")
  let _ = env.rt.run_ready()
  debug_assert(cred_failed[0], "stale credential 200 after concurrent revocation MUST fail")
  let pend_after = env.pending.length()
  let second_failed : Array[Bool] = [false]
  let _ = env.rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_member_credential_k("ws-live", "dev-1", 1000L, fn(ex : effect::Exit[MemberCredential]) -> Unit {
      match ex {
        effect::Exit::Failed(_) => { second_failed[0] = true }
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  let _ = env.rt.run_ready()
  debug_assert(second_failed[0] && env.pending.length() == pend_after, "revoked workspace refuses credential fetch without cache hit or HTTP")
  core.stop()
}

// ── Test 16 (R3 P0-2): Failed drop_workspace refuses workspaces/draft.get AND blocks Cloud 200 rejoin until drop succeeds ──

test "auth_lifecycle 16: failed drop_workspace blocks workspaces view, draft.get/put, and refuses Cloud 200 rejoin until drop succeeds" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let fail_drops : Array[Bool] = [false]
  let sh = shell::Shell::stood_in(
    rt,
    fn(_id : Int64, _op : String, _args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {},
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      if fail_drops[0] && op == "sql.run" {
        let q = j_str(args, "sql")
        if q.starts_with("DELETE FROM workspace ") {
          return shell::AskResult::Err(shell::ShellError::{ message: "simulated SQLITE_BUSY during drop_workspace" })
        }
      }
      sim_db.answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "acct-fail-drop") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("open failed: " + e.to_string())
  }
  let station = SimStation::new(rt)
  let core = ClientCore::new("ws-bad", "ws-bad/st-1", rt, db, station.transport(), fn() -> Unit {})

  // Seed ws-bad + ws-ok + draft for ws-bad/st-1
  let _ = db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-bad"),
    base_codec::json_str("{\"id\":\"ws-bad\",\"name\":\"Secret WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-ok"),
    base_codec::json_str("{\"id\":\"ws-ok\",\"name\":\"OK WS\",\"role\":\"member\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = core.composers.put_draft("ws-bad/st-1", "c-secret", base_codec::json_obj([("text", base_codec::json_str("top-secret-draft"))]))

  // Simulate DB failure during `drop_workspace` on revocation
  fail_drops[0] = true
  core.revoke_workspace("ws-bad")
  debug_assert(core.auth.is_revoked("ws-bad"), "ws-bad marked revoked")
  debug_assert(core.is_workspace_revoked_or_pending("ws-bad"), "ws-bad flagged revoked_or_pending")

  // 1. `workspaces` view MUST exclude ws-bad even though its SQLite row survived the failed drop!
  match core.handle_wire("{\"id\":401,\"subscribe\":{\"topic\":\"workspaces\"},\"keyed\":true}") {
    Some((txt, _)) => {
      debug_assert(!txt.contains("ws-bad") && !txt.contains("Secret WS"), "workspaces view MUST hide failed-drop workspace")
      debug_assert(txt.contains("ws-ok"), "workspaces view still exposes healthy sibling ws-ok")
    }
    None => debug_assert(false, "expected workspaces value")
  }

  // 2. `draft.get` and `draft.put` MUST refuse ws-bad/st-1!
  match core.handle_wire("{\"id\":402,\"call\":\"draft.get\",\"params\":{\"station\":\"ws-bad/st-1\",\"chat\":\"c-secret\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"error\"") && txt.contains("workspace_revoked") && !txt.contains("top-secret-draft"), "draft.get MUST refuse failed-drop workspace")
    None => debug_assert(false, "expected draft.get error")
  }
  match core.handle_wire("{\"id\":403,\"call\":\"draft.put\",\"params\":{\"station\":\"ws-bad/st-1\",\"chat\":\"c-secret\",\"value\":{\"text\":\"x\"}}}") {
    Some((txt, _)) => debug_assert(txt.contains("\"error\"") && txt.contains("workspace_revoked"), "draft.put MUST refuse failed-drop workspace")
    None => debug_assert(false, "expected draft.put error")
  }

  // 3. Cloud 200 rejoin while DB drop STILL fails MUST refuse to clear `revoked`!
  let rejoin_raw = base_codec::json_obj([
    ("id", base_codec::json_str("ws-bad")),
    ("name", base_codec::json_str("Rejoined WS")),
    ("role", base_codec::json_str("member")),
    ("members", base_codec::json_arr([])),
    ("stations", base_codec::json_arr([])),
  ])
  let rejoin_ws = CloudWorkspace::{ id: "ws-bad", name: "Rejoined WS", rev: 2, members: [], stations: [], raw: rejoin_raw }
  core.apply_cloud_workspace("ws-bad", rejoin_ws)
  debug_assert(core.auth.is_revoked("ws-bad"), "rejoin MUST stay revoked while pre-revocation drop_workspace still fails")

  // 4. Heal DB -> next Cloud 200 rejoin completes `drop_workspace` FIRST, clears marker & opens cleanly!
  fail_drops[0] = false
  core.apply_cloud_workspace("ws-bad", rejoin_ws)
  debug_assert(!core.auth.is_revoked("ws-bad"), "rejoin succeeds once pre-revocation drop_workspace completes")
  debug_assert(!core.is_workspace_revoked_or_pending("ws-bad"), "pending marker cleared after clean drop")
  match core.handle_wire("{\"id\":404,\"call\":\"draft.get\",\"params\":{\"station\":\"ws-bad/st-1\",\"chat\":\"c-secret\"}}") {
    Some((txt, _)) => debug_assert(!txt.contains("top-secret-draft"), "pre-revocation secret draft purged before rejoin opened")
    None => debug_assert(false, "expected clean draft.get after rejoin")
  }
  core.stop()
}

// ── Test 17 (R3 P1-1): Downgrade + lock digest bump re-arms refresh; 1 online + 1 offline station does NOT wedge; per-thread chat & marks granularity ──

test "auth_lifecycle 17: downgrade + lock bump re-arms refresh, offline station never wedges aggregate views, and per-thread/marks granularity holds" {
  let env = AuthSimEnv::new()
  let st1 = SimStation::new(env.rt)
  let st2_offline = SimStation::new(env.rt)
  st1.snapshot_json = base_codec::json_obj([("chats", base_codec::json_arr([]))])
  st2_offline.snapshot_json = base_codec::json_obj([("chats", base_codec::json_arr([]))])

  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-dg"),
    base_codec::json_str("{\"id\":\"ws-dg\",\"name\":\"DG WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])

  let core = ClientCore::new("ws-dg", "ws-dg/st-1", env.rt, env.db, st1.transport(), fn() -> Unit {})
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-dg")
  core.bind_cloud_sync(cs)

  // Attach st-1 (online) and st-2 (offline: never started / Disconnected).
  core.attach_station_transport("ws-dg/st-2", st2_offline.transport(), workspace="ws-dg")
  // Mark st-1 as Connected by starting only st-1's SSE stream.
  core.events.start(env.rt)
  let _ = env.rt.run_ready()
  debug_assert(core.events.is_online_or_connecting(), "st-1 is online")
  match core.extra_events.get("ws-dg/st-2") {
    Some(ev2) => debug_assert(!ev2.is_online_or_connecting(), "st-2 is offline (Disconnected)")
    None => debug_assert(false, "expected st-2 events")
  }

  // Subscribe to aggregate `profiles`, `chats`, and two distinct `chat` threads (10 and 20).
  let _ = core.handle_wire("{\"id\":501,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-dg\"},\"keyed\":true}")
  let _ = core.handle_wire("{\"id\":502,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-dg\"},\"keyed\":true}")
  let _ = core.handle_wire("{\"id\":503,\"subscribe\":{\"topic\":\"chat\",\"station\":\"ws-dg/st-1\",\"thread\":10},\"keyed\":true}")
  let _ = core.handle_wire("{\"id\":504,\"subscribe\":{\"topic\":\"chat\",\"station\":\"ws-dg/st-1\",\"thread\":20},\"keyed\":true}")
  let _ = core.drain_pending_wire_events()

  // Trigger role downgrade `owner -> member` (`gen = 2`).
  let _ = core.update_workspace_role("ws-dg", "member", confirm_workspace_doc=false)
  let gen_after_dg = core.auth.workspace_auth_gen("ws-dg")
  debug_assert(gen_after_dg == 2, "downgrade bumped authGen to 2")

  // Immediately bump `authGen` again (`2 -> 3`, simulating a concurrent lock digest change during downgrade!):
  // `handle_auth_boundary` MUST re-arm `pending.gen = 3` and schedule fresh Cloud workspace + station refresh!
  let pend_before_rearm = env.pending.length()
  let _ = core.auth.bump_workspace("ws-dg")
  let gen_after_lock = core.auth.workspace_auth_gen("ws-dg")
  debug_assert(gen_after_lock == 3, "second bump advanced authGen to 3")
  let _ = env.rt.run_ready()
  let mut rearm_ws_req = 0L
  for i in pend_before_rearm..<env.pending.length() {
    if env.pending[i].1 == "fetch" && j_str(env.pending[i].2, "url").ends_with("/v1/workspaces/ws-dg") {
      rearm_ws_req = env.pending[i].0
    }
  }
  debug_assert(rearm_ws_req > 0L, "subsequent authGen bump re-armed and triggered fresh GET /v1/workspaces/ws-dg")

  // Confirm ONLY thread 10 -> thread 10 unlocks, while thread 20 and `chats` MUST stay gated!
  core.handle_confirmed_station_read("ws-dg", "ws-dg/st-1", "thread", gen_after_lock, Some(10))
  debug_assert(core.is_topic_authorized(protocol::Topic::{ name: "chat", params: [("station", base_codec::json_str("ws-dg/st-1")), ("thread", base_codec::json_int(10))] }), "thread 10 unlocked")
  debug_assert(!core.is_topic_authorized(protocol::Topic::{ name: "chat", params: [("station", base_codec::json_str("ws-dg/st-1")), ("thread", base_codec::json_int(20))] }), "thread 20 MUST NOT unlock when only thread 10 confirmed")

  // Confirm `marks:whole` -> MUST NOT unlock full-snapshot `chats` or `longJobs`!
  core.handle_confirmed_station_read("ws-dg", "ws-dg/st-1", "marks:whole", gen_after_lock, None)
  debug_assert(!core.is_topic_authorized(protocol::Topic::{ name: "chats", params: [("scope", base_codec::json_str("ws-dg"))] }), "marks alone MUST NOT unlock snapshot-held chats")
  debug_assert(!core.is_topic_authorized(protocol::Topic::{ name: "longJobs", params: [("scope", base_codec::json_str("ws-dg"))] }), "marks alone MUST NOT unlock snapshot-held longJobs")

  // Answer re-armed Cloud workspace doc + st-1 overview + st-1 snapshot (st-2 remains OFFLINE!).
  env.answer_http(rearm_ws_req, 200, "{\"id\":\"ws-dg\",\"name\":\"DG WS\",\"role\":\"member\",\"members\":[],\"stations\":[]}")
  let _ = env.rt.run_ready()
  let ov1 = wire::Event::{ name: "overview", data: "{\"id\":\"st-1\",\"name\":\"St 1\"}", id: Some("ov-r3") }
  let _ = core.events.apply_sse_batch([ov1], stream_auth_gen=Some(gen_after_lock))
  core.handle_confirmed_station_read("ws-dg", "ws-dg/st-1", "snapshot", gen_after_lock, None)

  // All aggregate views (`profiles`, `chats`, `longJobs`) MUST now unlock automatically despite st-2 being offline!
  debug_assert(core.is_topic_authorized(protocol::Topic::{ name: "profiles", params: [("scope", base_codec::json_str("ws-dg"))] }), "profiles unlocked despite offline st-2")
  debug_assert(core.is_topic_authorized(protocol::Topic::{ name: "chats", params: [("scope", base_codec::json_str("ws-dg"))] }), "chats unlocked despite offline st-2")
  debug_assert(core.is_topic_authorized(protocol::Topic::{ name: "longJobs", params: [("scope", base_codec::json_str("ws-dg"))] }), "longJobs unlocked after snapshot")
  core.stop()
}

// ── Test 18 (R3 P1-3): LocalOutbox transport replacement clears stale in-flight state & auto-retries on new transport ──

test "auth_lifecycle 18: LocalOutbox transport replacement blocks stale reply by epoch and retries cleanly without freezing" {
  let env = AuthSimEnv::new()
  let frame_ob : outbox::FrameOutbox[CoreEvent] = outbox::FrameOutbox::new(fn() -> Unit {})

  let held_reply_k : Array[Option[(effect::Exit[HttpReply]) -> Unit]] = [None]
  let tr1 = StationTransport::{
    request_k: fn(_m : String, _p : String, _h : Array[(String, String)], _b : Bytes, k : (effect::Exit[HttpReply]) -> Unit) -> Unit {
      held_reply_k[0] = Some(k)
    },
    stream_k: fn(_p : String, _h : Array[(String, String)], _on : (Bytes) -> Unit, k : (effect::Exit[Unit]) -> Unit) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
  }
  let tr2_calls : Array[String] = []
  let tr2 = StationTransport::{
    request_k: fn(m : String, p : String, _h : Array[(String, String)], _b : Bytes, k : (effect::Exit[HttpReply]) -> Unit) -> Unit {
      tr2_calls.push(m + " " + p)
      k(effect::Exit::Succeeded(HttpReply::{
        status: 200,
        headers: [],
        body: "{\"n\":7,\"clientKey\":\"ck-swap-1\"}".to_bytes(),
      }))
    },
    stream_k: fn(_p : String, _h : Array[(String, String)], _on : (Bytes) -> Unit, k : (effect::Exit[Unit]) -> Unit) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
  }

  let ob = LocalOutbox::new("ws-sw/st-1", env.db, frame_ob, tr1)
  ob.set_online(true)
  let _ = ob.send_message(env.rt, 77, "ck-swap-1", "alice", "hello across transport swap", 1000L)
  let _ = env.rt.run_ready()
  debug_assert(held_reply_k[0].is_some(), "request is in-flight on transport 1")

  // Replace transport with tr2 while tr1's reply is still in flight!
  ob.register_station_transport("ws-sw/st-1", tr2)
  // Stale reply from tr1 arrives late (500 error) -> MUST be ignored by epoch check!
  match held_reply_k[0] {
    Some(k1) => k1(effect::Exit::Succeeded(HttpReply::{ status: 500, headers: [], body: "{\"error\":\"stale\"}".to_bytes() }))
    None => ()
  }
  let _ = env.rt.run_ready()

  // Flushing on tr2 MUST NOT be frozen by stale `in_flight_threads` and MUST deliver cleanly!
  ob.flush_station_offline(env.rt, "ws-sw/st-1")
  let _ = env.rt.run_ready()
  debug_assert(tr2_calls.length() == 1 && tr2_calls[0] == "POST /threads/77/messages", "new transport retried and delivered without freezing")
  debug_assert(ob.pending_message_count() == 0, "outbox reconciled cleanly on replacement transport")
}

// ── Test 19 (R3 P1-2): /v1/auth/refresh emits valid 26-char Crockford Base32 ULID request_id matching cloud validId ──

fn is_valid_ulid_id(s : String) -> Bool {
  if s.length() != 26 {
    return false
  }
  let bs = s.to_bytes()
  let c0 = bs[0].to_int()
  if c0 < 48 || c0 > 55 {
    // First char must be [0-7]
    return false
  }
  let valid_chars = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
  for i in 1..<26 {
    let ch = s.slice(i, i + 1)
    if !valid_chars.contains(ch) {
      return false
    }
  }
  true
}

test "auth_lifecycle 19: /v1/auth/refresh generates valid 26-char Crockford Base32 ULID request_id" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let pending_req : Array[(Int64, String, base_codec::Json, Option[Bytes])] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, body_bytes : Option[Bytes]) -> Unit {
      pending_req.push((id, op, args, body_bytes))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      sim_db.answer(op, args)
    },
    fn(n : Int) -> Bytes {
      let b = Bytes::new(n)
      for i in 0..<n {
        b[i] = ((i * 29 + 7) & 255) as Byte
      }
      b
    },
  )
  let db = match sql::Sql::open(sh, "acct-ulid-refresh") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("open failed: " + e.to_string())
  }
  let u1 = generate_ulid(1795800000000L, Bytes::new(10))
  debug_assert(is_valid_ulid_id(u1), "generate_ulid matches ^[0-7][0-9A-HJKMNP-TV-Z]{25}$: " + u1)

  let cs = CloudSync::new(sh, db, "https://cloud.example", token="expired-access")
  cs.set_refresh_token("rt-valid-1")
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { k(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  let me_req = pending_req[0].0
  sh.answer(
    me_req,
    base_codec::json_obj([("status", base_codec::json_int(401)), ("headers", base_codec::json_arr([])), ("redirected", base_codec::json_bool(false))]),
    bytes=Some("{\"error\":\"token_expired\"}".to_bytes()),
  )
  let _ = rt.run_ready()

  // Verify ACTUAL HTTP body sent to POST /v1/auth/refresh carries valid 26-char ULID `request_id`!
  debug_assert(pending_req.length() >= 2, "401 triggered POST /v1/auth/refresh")
  let (ref_id, ref_op, ref_args, ref_bytes) = pending_req[1]
  debug_assert(ref_op == "fetch" && j_str(ref_args, "url").ends_with("/v1/auth/refresh"), "refresh endpoint hit")
  match ref_bytes {
    Some(bs) => {
      let body_txt = bytes_to_str(bs)
      match base_codec::json_parse(body_txt) {
        base_codec::JsonParseResult::Ok(bj) => {
          let rid = j_str(bj, "request_id")
          debug_assert(is_valid_ulid_id(rid), "POST /v1/auth/refresh request_id MUST be valid 26-char Crockford Base32 ULID, got: " + rid)
        }
        base_codec::JsonParseResult::Err(e) => debug_assert(false, "refresh body parse error: " + e)
      }
    }
    None => debug_assert(false, "expected POST /v1/auth/refresh JSON body")
  }
  sh.answer(
    ref_id,
    base_codec::json_obj([("status", base_codec::json_int(200)), ("headers", base_codec::json_arr([])), ("redirected", base_codec::json_bool(false))]),
    bytes=Some("{\"access_token\":\"fresh-access-2\",\"refresh_token\":\"rt-valid-2\"}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(cs.token() == "fresh-access-2", "access token updated after refresh")
}

// ── Test 20 (R3 P1-4): Same-ms strictly monotonic connSeq, full WireOutGen on invalid subscribe, canonical_lock_digest endpoints/gateways/cloud_keys ──

test "auth_lifecycle 20: same-ms connSeq strictly monotonic even on write failure, invalid subscribe stamps full WireOutGen, and canonical_lock_digest covers endpoints/gateways/cloud_keys" {
  // 20a. Two consecutive same-ms connSeq allocations with floor tracking (even when persisted=0 / write fails) -> c2 > c1!
  let same_ms = 1795800001234L
  let c1 = store::next_monotonic_conn_seq(0L, now_ms=same_ms, floor=0L)
  let c2 = store::next_monotonic_conn_seq(0L, now_ms=same_ms, floor=c1)
  debug_assert(c2 > c1, "same-ms consecutive connSeq MUST be strictly increasing even without persistence")

  // 20b. Invalid subscribe wire error frame stamps full conn + authGen + vaultGen when topic is recognizable!
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let core = ClientCore::new("ws-err", "ws-err/st-1", env.rt, env.db, station.transport(), fn() -> Unit {}, conn_seq=Some(42L))
  core.auth.ensure_workspace("ws-err")
  let _ = core.auth.bump_workspace("ws-err")
  let _ = core.auth.bump_vault("ws-err", vault_id="v1")
  // Pass invalid `vault: 123` (expected string) so parse_client_message returns Invalid while `subscribe.topic` + `workspace` are recognizable!
  match core.handle_wire("{\"id\":701,\"subscribe\":{\"topic\":\"vaultItems\",\"workspace\":\"ws-err\",\"vault\":123}}") {
    Some((txt, _)) => {
      debug_assert(txt.contains("\"error\""), "invalid subscribe emits error frame")
      debug_assert(json_int_eq(txt, "conn", 42), "invalid subscribe carries conn")
      debug_assert(json_int_eq(txt, "authGen", 2), "invalid subscribe carries authGen")
      debug_assert(json_int_eq(txt, "vaultGen", 2), "invalid subscribe carries vaultGen")
    }
    None => debug_assert(false, "expected invalid subscribe error frame")
  }

  // 20c. `canonical_lock_digest` reflects changes to `device.endpoints`, `gateways`, and `cloud_keys`!
  let alice_seed = make_seed(77)
  let alice_key = ed25519_key_id(alice_seed)
  let make_st = fn(eps : Array[form::Json], gws : Array[form::Json], cks : Array[(String, form::Json)]) -> lock::LockState {
    let g = match sign_lock_entry(
      alice_seed,
      form::Json::Obj([
        ("v", form::Json::Num(1.0)),
        ("ws", form::Json::Str("ws-dig")),
        ("seq", form::Json::Num(0.0)),
        ("prev", form::Json::Null),
        ("at", form::Json::Num(1790000000.0)),
        ("kind", form::Json::Str("genesis")),
        ("body", form::Json::Obj([
          ("owner", form::Json::Str("alice")),
          ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
          ("rp_id", form::Json::Str("app.still.fail")),
          ("cloud_keys", form::Json::Obj(cks)),
          ("members", form::Json::Arr([form::Json::Obj([("sub", form::Json::Str("alice")), ("email", form::Json::Str("alice@example.com")), ("role", form::Json::Str("owner"))])])),
          ("devices", form::Json::Arr([form::Json::Obj([
            ("id", form::Json::Str(hex_64("a"))),
            ("sub", form::Json::Str("alice")),
            ("kind", form::Json::Str("app")),
            ("label", form::Json::Str("Mac")),
            ("sign_key", form::Json::Str(alice_key)),
            ("endpoints", form::Json::Arr(eps)),
          ])])),
          ("passkeys", form::Json::Arr([])),
          ("stations", form::Json::Arr([])),
          ("gateways", form::Json::Arr(gws)),
        ])),
      ]),
    ) {
      Ok(e) => e
      Err(e) => panic("sign: " + e)
    }
    let root = match lock::entry_hash(g, native_lock_crypto()) {
      Ok(h) => h
      Err(_) => panic("root hash")
    }
    match verify_workspace_lock([g], root) {
      Ok(v) => v.state
      Err(e) => panic("verify: " + e)
    }
  }
  let ep1 = hex_64("1")
  let ep2 = hex_64("2")
  let gw1 = hex_64("3")
  let gw2 = hex_64("4")
  let ck1 = ed25519_key_id(make_seed(78))
  let ck2 = ed25519_key_id(make_seed(79))
  let base_st = make_st([form::Json::Str(ep1)], [form::Json::Str(gw1)], [("k1", form::Json::Str(ck1))])
  let (_, sec_base) = canonical_lock_digest(base_st)
  let (_, sec_ep) = canonical_lock_digest(make_st([form::Json::Str(ep1), form::Json::Str(ep2)], [form::Json::Str(gw1)], [("k1", form::Json::Str(ck1))]))
  let (_, sec_gw) = canonical_lock_digest(make_st([form::Json::Str(ep1)], [form::Json::Str(gw2)], [("k1", form::Json::Str(ck1))]))
  let (_, sec_ck) = canonical_lock_digest(make_st([form::Json::Str(ep1)], [form::Json::Str(gw1)], [("k1", form::Json::Str(ck2))]))
  debug_assert(sec_ep != sec_base, "device.endpoints change MUST alter canonical_lock_digest")
  debug_assert(sec_gw != sec_base, "gateways change MUST alter canonical_lock_digest")
  debug_assert(sec_ck != sec_base, "cloud_keys change MUST alter canonical_lock_digest")
  core.stop()
}

// ── Test 21 (R4 Fix 1): Per-station record filtering during downgrade projection + single-chat precision ──

test "auth_lifecycle 21: post-downgrade offline/reconnecting station rows excluded from profiles/stations/chats, confirmed station renders without wedge, and GET /chats never unlocks unread chat" {
  let env = AuthSimEnv::new()
  let st1 = SimStation::new(env.rt)
  let st2 = SimStation::new(env.rt)
  st1.snapshot_json = base_codec::json_obj([
    ("chats", base_codec::json_arr([
      base_codec::json_obj([
        ("id", base_codec::json_str("c-fresh-1")),
        ("title", base_codec::json_str("Fresh St1 Chat")),
        ("thread", base_codec::json_int(11)),
        ("lastActive", base_codec::json_int64(6000L)),
      ]),
    ])),
  ])
  st2.snapshot_json = base_codec::json_obj([
    ("chats", base_codec::json_arr([
      base_codec::json_obj([
        ("id", base_codec::json_str("c-fresh-2")),
        ("title", base_codec::json_str("Fresh St2 Chat")),
        ("thread", base_codec::json_int(22)),
        ("lastActive", base_codec::json_int64(7000L)),
      ]),
    ])),
  ])

  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-r4"),
    base_codec::json_str("{\"id\":\"ws-r4\",\"name\":\"R4 Team\",\"role\":\"owner\",\"stations\":[{\"id\":\"st-1\",\"name\":\"St1\",\"online\":true},{\"id\":\"st-2\",\"name\":\"St2\",\"online\":false}]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-r4/st-1"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-1\",\"name\":\"St1 Stale\",\"profiles\":[{\"name\":\"p-stale-1\"}]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("ws-r4/st-2"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"st-2\",\"name\":\"St2 Stale\",\"profiles\":[{\"name\":\"p-stale-2\"}]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = env.db.run(sql_chat_upsert(), params=[
    base_codec::json_str("ws-r4/st-1"), base_codec::json_str("c-stale-1"), base_codec::json_int(0),
    base_codec::json_num(1.0), base_codec::json_int(11), base_codec::json_str("s-11"),
    base_codec::json_int(1), base_codec::json_int64(4000L), base_codec::json_null(),
    base_codec::json_int(0), base_codec::json_int(0), base_codec::json_null(),
    base_codec::json_null(), base_codec::json_int(0), base_codec::json_int(0),
    base_codec::json_str("{\"id\":\"c-stale-1\",\"title\":\"STALE_CHAT_ST1\",\"thread\":11,\"lastActive\":4000}"),
  ])
  let _ = env.db.run(sql_chat_upsert(), params=[
    base_codec::json_str("ws-r4/st-2"), base_codec::json_str("c-stale-2"), base_codec::json_int(0),
    base_codec::json_num(1.0), base_codec::json_int(22), base_codec::json_str("s-22"),
    base_codec::json_int(1), base_codec::json_int64(4000L), base_codec::json_null(),
    base_codec::json_int(0), base_codec::json_int(0), base_codec::json_null(),
    base_codec::json_null(), base_codec::json_int(0), base_codec::json_int(0),
    base_codec::json_str("{\"id\":\"c-stale-2\",\"title\":\"STALE_CHAT_ST2\",\"thread\":22,\"lastActive\":4000}"),
  ])
  let _ = env.db.run(sql_entry_put(), params=[
    base_codec::json_str("ws-r4/st-1"), base_codec::json_int(11), base_codec::json_int(1),
    base_codec::json_str("{\"n\":1,\"thread\":11,\"kind\":\"message\",\"author\":\"alice\",\"text\":\"PRIVATE_THREAD_11\",\"at\":4000}"),
  ])
  let _ = store::put_account_doc(env.db, "usage:ws-r4", "{\"days\":[{\"day\":\"2026-11-27\",\"cost\":99.5}]}")

  let core = ClientCore::new("ws-r4", "ws-r4/st-1", env.rt, env.db, st1.transport(), fn() -> Unit {})
  core.attach_station_transport("ws-r4/st-2", st2.transport(), workspace="ws-r4")
  core.events.start(env.rt) // ONLY st-1 online; st-2 stays OFFLINE
  let _ = env.rt.run_ready()

  let frames : Array[String] = []
  core.set_wire_sink(fn(j : String, _b : Option[Bytes]) -> Unit { frames.push(j) })
  let _ = core.handle_wire("{\"id\":801,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-r4\"},\"keyed\":true}")
  let _ = core.handle_wire("{\"id\":802,\"subscribe\":{\"topic\":\"stations\",\"scope\":\"ws-r4\"},\"keyed\":true}")
  let _ = core.handle_wire("{\"id\":803,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-r4\"},\"keyed\":true}")
  let _ = core.handle_wire("{\"id\":804,\"subscribe\":{\"topic\":\"chat\",\"station\":\"ws-r4/st-1\",\"thread\":11},\"keyed\":true}")

  // Downgrade ws-r4 (`owner -> member`) with workspace doc confirmed (`authGen = 2`).
  let before_dg = frames.length()
  let _ = core.update_workspace_role("ws-r4", "member", confirm_workspace_doc=true)
  let _ = env.rt.run_ready()
  debug_assert(core.auth.workspace_auth_gen("ws-r4") == 2, "downgrade bumped authGen to 2")

  // Immediately after downgrade (before any station confirms): ZERO stale pre-downgrade station data leaked!
  for i in before_dg..<frames.length() {
    let f = frames[i]
    debug_assert(!f.contains("p-stale-1") && !f.contains("p-stale-2"), "profiles MUST NOT leak unconfirmed stale profiles under authGen:2")
    debug_assert(!f.contains("St1 Stale") && !f.contains("St2 Stale"), "stations MUST NOT leak unconfirmed stale stations under authGen:2")
    debug_assert(!f.contains("STALE_CHAT_ST1") && !f.contains("STALE_CHAT_ST2"), "chats MUST NOT leak unconfirmed stale chats under authGen:2")
    debug_assert(!f.contains("PRIVATE_THREAD_11"), "single-chat MUST NOT leak thread 11 before per-thread confirmation")
  }
  match core.handle_wire("{\"id\":805,\"subscribe\":{\"topic\":\"usage\",\"scope\":\"ws-r4\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(!txt.contains("99.5"), "usage MUST exclude stale account_doc usage:<ws> while downgrade gated")
    None => debug_assert(false, "expected usage value")
  }

  // Now online `st-1` confirms fresh `overview` AND fresh `GET /chats` snapshot at `authGen = 2`,
  // while `st-2` stays OFFLINE:
  // - `profiles`/`stations`/`chats` render `st-1` cleanly (NO wedge!) and STILL exclude `st-2` (NO stale leak!).
  // - Single-chat `{ topic: "chat", station: "ws-r4/st-1", thread: 11 }` MUST STAY `Waiting`!
  let before_st1 = frames.length()
  st1.push_sse("id: r4-ov-1\nevent: overview\ndata: {\"id\":\"st-1\",\"name\":\"St1 Fresh\",\"profiles\":[{\"name\":\"p-fresh-1\"}]}\n\n")
  env.rt.advance(100)
  let _ = env.rt.run_ready()
  debug_assert(core.is_station_confirmed_for_projection("ws-r4", "ws-r4/st-1", "overview"), "st-1 overview confirmed")
  debug_assert(core.is_station_confirmed_for_projection("ws-r4", "ws-r4/st-1", "snapshot"), "st-1 snapshot confirmed")
  debug_assert(!core.is_station_confirmed_for_projection("ws-r4", "ws-r4/st-2", "overview"), "offline st-2 overview stays unconfirmed")
  debug_assert(!core.is_station_confirmed_for_projection("ws-r4", "ws-r4/st-2", "snapshot"), "offline st-2 snapshot stays unconfirmed")

  match core.handle_wire("{\"id\":811,\"subscribe\":{\"topic\":\"profiles\",\"scope\":\"ws-r4\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("p-fresh-1") && !txt.contains("p-stale-2") && txt.contains("\"manages\":false"), "profiles includes fresh st-1 ONLY")
    None => debug_assert(false, "expected profiles")
  }
  match core.handle_wire("{\"id\":812,\"subscribe\":{\"topic\":\"stations\",\"scope\":\"ws-r4\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("St1 Fresh") && !txt.contains("St2 Stale"), "stations includes fresh st-1 ONLY")
    None => debug_assert(false, "expected stations")
  }
  match core.handle_wire("{\"id\":813,\"subscribe\":{\"topic\":\"chats\",\"scope\":\"ws-r4\"},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("Fresh St1 Chat") && !txt.contains("STALE_CHAT_ST2"), "chats includes fresh st-1 ONLY")
    None => debug_assert(false, "expected chats")
  }
  // CRITICAL: `GET /chats` snapshot MUST NEVER unlock single-chat `chat` thread 11!
  debug_assert(!core.is_topic_authorized(protocol::Topic::{ name: "chat", params: [("station", base_codec::json_str("ws-r4/st-1")), ("thread", base_codec::json_int(11))] }), "GET /chats snapshot MUST NEVER unlock unread single-chat thread 11")
  match core.handle_wire("{\"id\":814,\"subscribe\":{\"topic\":\"chat\",\"station\":\"ws-r4/st-1\",\"thread\":11},\"keyed\":true}") {
    Some((txt, _)) => debug_assert(txt.contains("\"waiting\":true") && !txt.contains("PRIVATE_THREAD_11"), "single-chat stays Waiting until GET /threads/11/entries confirms")
    None => debug_assert(false, "expected Waiting for thread 11")
  }
  // Confirming exact thread 11 at authGen=2 unlocks thread 11!
  core.handle_confirmed_station_read("ws-r4", "ws-r4/st-1", "thread", 2, Some(11))
  debug_assert(core.is_topic_authorized(protocol::Topic::{ name: "chat", params: [("station", base_codec::json_str("ws-r4/st-1")), ("thread", base_codec::json_int(11))] }), "exact thread 11 confirmation unlocks chat")

  // Finally, `st-2` comes online and confirms fresh overview + snapshot -> incremental deltas appear with ZERO Waiting flicker!
  let before_st2 = frames.length()
  match core.extra_events.get("ws-r4/st-2") {
    Some(ev2) => ev2.start(env.rt)
    None => debug_assert(false, "expected st-2 events")
  }
  let _ = env.rt.run_ready()
  st2.push_sse("id: r4-ov-2\nevent: overview\ndata: {\"id\":\"st-2\",\"name\":\"St2 Fresh\",\"profiles\":[{\"name\":\"p-fresh-2\"}]}\n\n")
  env.rt.advance(100)
  let _ = env.rt.run_ready()
  let mut saw_p2 = false
  let mut saw_c2 = false
  for i in before_st2..<frames.length() {
    let f = frames[i]
    if json_int_eq(f, "id", 801) {
      debug_assert(!f.contains("\"waiting\":true"), "no Waiting flicker on profiles when st-2 confirms")
      if f.contains("p-fresh-2") { saw_p2 = true }
    }
    if json_int_eq(f, "id", 803) {
      debug_assert(!f.contains("\"waiting\":true"), "no Waiting flicker on chats when st-2 confirms")
      if f.contains("Fresh St2 Chat") { saw_c2 = true }
    }
  }
  debug_assert(saw_p2 && saw_c2, "st-2 rows appeared via incremental updates after reconnect confirmation")
  let _ = before_st1
  core.stop()
}

// ── Test 22 (R4 Fix 2): Bare station purge + ALL direct read/RPC guards ──

test "auth_lifecycle 22: explicitly bound bare station is purged by drop_workspace (incl. draft) and ALL direct RPCs block revoked workspace with 0 leaks" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let fail_drops : Array[Bool] = [false]
  let sh = shell::Shell::stood_in(
    rt,
    fn(_id : Int64, _op : String, _args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {},
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      if fail_drops[0] && op == "sql.run" && j_str(args, "sql").starts_with("DELETE FROM workspace ") {
        return shell::AskResult::Err(shell::ShellError::{ message: "simulated SQLITE_BUSY" })
      }
      sim_db.answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "acct-bare") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("open failed: " + e.to_string())
  }
  let st_main = SimStation::new(rt)
  let st_bare = SimStation::new(rt)
  let core = ClientCore::new("ws-main", "ws-main/st-main", rt, db, st_main.transport(), fn() -> Unit {})
  // Bind a BARE station name (`"bare-st-99"`, NO `<ws>/` prefix!) explicitly to `"ws-bare"`
  core.attach_station_transport("bare-st-99", st_bare.transport(), workspace="ws-bare")
  debug_assert(core.station_workspace_of("bare-st-99") == "ws-bare", "bare station resolves to explicit ws-bare")

  // Seed ws-bare + bare-st-99 data across workspace, station, chat, entry, draft, composer, pref, account_doc
  let _ = db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-bare"),
    base_codec::json_str("{\"id\":\"ws-bare\",\"name\":\"BARE_SECRET_WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-main"),
    base_codec::json_str("{\"id\":\"ws-main\",\"name\":\"MAIN_OK_WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = db.run(store::sql_station_doc_put(), params=[
    base_codec::json_str("bare-st-99"),
    base_codec::json_str("overview"),
    base_codec::json_str("{\"id\":\"bare-st-99\",\"name\":\"BARE_SECRET_ST\"}"),
    base_codec::json_int64(1000L),
  ])
  let _ = db.run(sql_chat_upsert(), params=[
    base_codec::json_str("bare-st-99"), base_codec::json_str("c-55"), base_codec::json_int(0),
    base_codec::json_num(1.0), base_codec::json_int(55), base_codec::json_str("sess-55"),
    base_codec::json_int(1), base_codec::json_int64(5000L), base_codec::json_null(),
    base_codec::json_int(0), base_codec::json_int(0), base_codec::json_null(),
    base_codec::json_null(), base_codec::json_int(0), base_codec::json_int(0),
    base_codec::json_str("{\"id\":\"c-55\",\"title\":\"BARE_SECRET_CHAT\",\"thread\":55,\"lastActive\":5000}"),
  ])
  let _ = db.run(sql_entry_put(), params=[
    base_codec::json_str("bare-st-99"), base_codec::json_int(55), base_codec::json_int(1),
    base_codec::json_str("{\"n\":1,\"thread\":55,\"kind\":\"message\",\"author\":\"alice\",\"text\":\"BARE_SECRET_MSG\",\"at\":5000}"),
  ])
  let _ = store::put_draft(db, "bare-st-99", "c-55", "{\"text\":\"BARE_SECRET_DRAFT\"}")
  let _ = store::put_workspace_pref(db, "ws-bare", "theme", "\"BARE_SECRET_PREF\"")
  let _ = store::put_account_doc(db, "vaults:ws-bare", "[{\"id\":\"v-b\",\"name\":\"BARE_SECRET_VAULT\"}]")
  let _ = core.handle_wire("{\"id\":1,\"call\":\"composer.text\",\"params\":{\"key\":\"bare-st-99:c-55\",\"text\":\"BARE_SECRET_COMP\"}}")

  // Phase A: fail `drop_workspace` so SQLite rows STILL exist, then revoke `ws-bare` -> ALL direct RPCs MUST have 0 leaks!
  fail_drops[0] = true
  core.revoke_workspace("ws-bare")
  let assert_no_bare_leak = fn(label : String, req : String, expect_err : Bool) -> Unit {
    match core.handle_wire(req) {
      Some((txt, _)) => {
        if expect_err {
          debug_assert(txt.contains("\"error\"") && txt.contains("workspace_revoked"), label + " must fail with workspace_revoked")
        }
        debug_assert(!txt.contains("BARE_SECRET"), label + " leaked bare station/workspace secret: " + txt)
      }
      None => debug_assert(false, label + " returned None")
    }
  }
  assert_no_bare_leak("chat.open", "{\"id\":10,\"call\":\"chat.open\",\"params\":{\"station\":\"bare-st-99\",\"thread\":55}}", true)
  assert_no_bare_leak("chats.window", "{\"id\":11,\"call\":\"chats.window\",\"params\":{\"stations\":[\"bare-st-99\"]}}", true)
  assert_no_bare_leak("workspaces.list", "{\"id\":12,\"call\":\"workspaces.list\",\"params\":{}}", false)
  assert_no_bare_leak("stations.list", "{\"id\":13,\"call\":\"stations.list\",\"params\":{\"workspace\":\"ws-bare\"}}", true)
  assert_no_bare_leak("draft.get", "{\"id\":14,\"call\":\"draft.get\",\"params\":{\"station\":\"bare-st-99\",\"chat\":\"c-55\"}}", true)
  assert_no_bare_leak("draft.put", "{\"id\":15,\"call\":\"draft.put\",\"params\":{\"station\":\"bare-st-99\",\"chat\":\"c-55\",\"value\":{\"text\":\"x\"}}}", true)
  assert_no_bare_leak("chat.draft", "{\"id\":16,\"call\":\"chat.draft\",\"params\":{\"station\":\"bare-st-99\",\"chat\":\"c-55\"}}", true)
  assert_no_bare_leak("composer.text", "{\"id\":17,\"call\":\"composer.text\",\"params\":{\"key\":\"bare-st-99:c-55\",\"text\":\"x\"}}", true)
  assert_no_bare_leak("composer.take", "{\"id\":18,\"call\":\"composer.take\",\"params\":{\"key\":\"bare-st-99:c-55\"}}", true)
  assert_no_bare_leak("settings.get", "{\"id\":19,\"call\":\"settings.get\",\"params\":{\"workspace\":\"ws-bare\",\"key\":\"theme\"}}", true)
  assert_no_bare_leak("settings.set", "{\"id\":20,\"call\":\"settings.set\",\"params\":{\"workspace\":\"ws-bare\",\"key\":\"theme\",\"value\":\"x\"}}", true)
  assert_no_bare_leak("search.chats", "{\"id\":21,\"call\":\"search.chats\",\"params\":{\"station\":\"bare-st-99\",\"query\":\"BARE\"}}", false)
  assert_no_bare_leak("search.messages", "{\"id\":22,\"call\":\"search.messages\",\"params\":{\"station\":\"bare-st-99\",\"query\":\"BARE\"}}", true)
  assert_no_bare_leak("account.doc", "{\"id\":23,\"call\":\"account.doc\",\"params\":{\"name\":\"vaults:ws-bare\"}}", true)

  // Phase B: heal DB and run revoke/drop -> verify EVERY SQLite row for bare-st-99 (incl. draft!) is purged!
  fail_drops[0] = false
  core.revoke_workspace("ws-bare")
  match store::get_workspace(db, "ws-bare") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "ws-bare workspace row must be dropped")
  }
  match store::get_draft(db, "bare-st-99", "c-55") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "bare-st-99 draft row must be dropped")
  }
  match store::get_chat_by_thread(db, "bare-st-99", 55) {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "bare-st-99 chat row must be dropped")
  }
  match store::get_station_doc(db, "bare-st-99", "overview") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "bare-st-99 overview row must be dropped")
  }
  core.stop()
}

// ── Test 23 (R4 Fix 2): SQLite marker write failure + drop failure -> device fallback blocks offline restart & retries purge ──

test "auth_lifecycle 23: SQLite pending-marker write failure + drop_workspace failure still blocks offline restart via device fallback and retries purge" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let fail_sql_writes : Array[Bool] = [false]
  let sh = shell::Shell::stood_in(
    rt,
    fn(_id : Int64, _op : String, _args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {},
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      if fail_sql_writes[0] && op == "sql.run" {
        let q = j_str(args, "sql")
        if q.contains("account_doc") || q.starts_with("DELETE FROM workspace ") {
          return shell::AskResult::Err(shell::ShellError::{ message: "simulated SQLITE_FULL" })
        }
      }
      sim_db.answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "acct-devfb") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("open failed: " + e.to_string())
  }
  let device_pending : Array[String] = []
  let save_device_pending = fn(wss : Array[String]) -> Result[Unit, String] {
    device_pending.clear()
    for i in 0..<wss.length() {
      device_pending.push(wss[i])
    }
    Ok(())
  }
  let st = SimStation::new(rt)
  let core = ClientCore::new(
    "ws-devfb",
    "ws-devfb/st-1",
    rt,
    db,
    st.transport(),
    fn() -> Unit {},
    initial_pending_revocations=[],
    save_pending_revocations=Some(save_device_pending),
  )
  let _ = db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-devfb"),
    base_codec::json_str("{\"id\":\"ws-devfb\",\"name\":\"DEVFB_SECRET\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let _ = store::put_draft(db, "ws-devfb/st-1", "c-1", "{\"text\":\"DEVFB_DRAFT\"}")

  // Fail BOTH SQLite `account_doc` pending-marker write AND `drop_workspace`!
  fail_sql_writes[0] = true
  core.revoke_workspace("ws-devfb")
  debug_assert(device_pending.length() == 1 && device_pending[0] == "ws-devfb", "device fallback stored ws-devfb even though SQLite marker write failed")
  debug_assert(core.is_workspace_revoked_or_pending("ws-devfb"), "O(1) memory mirror flags ws-devfb pending")
  core.stop()

  // Offline restart #1 (DB STILL failing): device fallback MUST block stale cache!
  let restart1 = ClientCore::new(
    "ws-devfb",
    "ws-devfb/st-1",
    rt,
    db,
    core_offline_transport(),
    fn() -> Unit {},
    initial_pending_revocations=device_pending,
    save_pending_revocations=Some(save_device_pending),
  )
  debug_assert(restart1.is_workspace_revoked_or_pending("ws-devfb"), "restart1 blocked ws-devfb from device fallback")
  match restart1.handle_wire("{\"id\":1,\"call\":\"workspaces.list\",\"params\":{}}") {
    Some((txt, _)) => debug_assert(!txt.contains("DEVFB_SECRET"), "restart1 workspaces.list has 0 leaks")
    None => debug_assert(false, "expected workspaces.list")
  }
  match restart1.handle_wire("{\"id\":2,\"call\":\"draft.get\",\"params\":{\"station\":\"ws-devfb/st-1\",\"chat\":\"c-1\"}}") {
    Some((txt, _)) => debug_assert(txt.contains("workspace_revoked") && !txt.contains("DEVFB_DRAFT"), "restart1 draft.get refused")
    None => debug_assert(false, "expected draft.get err")
  }
  debug_assert(device_pending.length() == 1, "device fallback marker retained while drop still fails")
  restart1.stop()

  // Offline restart #2 (DB healed): startup recovery retries & completes drop_workspace AND clears device fallback!
  fail_sql_writes[0] = false
  let restart2 = ClientCore::new(
    "ws-devfb",
    "ws-devfb/st-1",
    rt,
    db,
    core_offline_transport(),
    fn() -> Unit {},
    initial_pending_revocations=device_pending,
    save_pending_revocations=Some(save_device_pending),
  )
  debug_assert(device_pending.length() == 0, "device fallback cleared once drop_workspace succeeded on restart2")
  match store::get_workspace(db, "ws-devfb") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "ws-devfb workspace row purged on restart2")
  }
  match store::get_draft(db, "ws-devfb/st-1", "c-1") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "ws-devfb draft row purged on restart2")
  }
  restart2.stop()
}

// ── Test 24 (R4 Fix 3): Mesh force_fresh_cred preserved on first failure + downgrade cred_epoch rejects in-flight /credential 200 ──

test "auth_lifecycle 24: force_fresh_cred persists across first get_cred failure and downgrade bumps cred_epoch rejecting in-flight /credential 200" {
  // 24a. Mesh `force_fresh_cred` MUST NOT clear before `get_cred` succeeds!
  let rt = effect::Runtime::new()
  let storage : Map[String, Bytes] = Map::new()
  let local_ep = hex_64("c")
  let holder : Array[shell::Shell] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, bytes : Option[Bytes]) -> Unit {
      let s = holder[0]
      if op == "storage.get" {
        s.answer(id, base_codec::json_obj([]), bytes=storage.get(j_str(args, "key")))
        return
      }
      if op == "storage.set" {
        match bytes {
          Some(b) => storage.set(j_str(args, "key"), b)
          None => ()
        }
        s.answer(id, base_codec::json_obj([]))
        return
      }
      if op == "iroh.bind" {
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(10))]))
        return
      }
      if op == "iroh.connect" {
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(20))]))
        return
      }
      if op == "conn.openBi" {
        s.answer(id, base_codec::json_obj([("id", base_codec::json_int(30))]))
        return
      }
      if op == "conn.closed" {
        return
      }
      if op == "istream.write" {
        s.refuse(id, "stream_reset_after_cred")
        return
      }
      s.answer(id, base_codec::json_obj([]))
    },
    fn(op : String, _args : base_codec::Json) -> shell::AskResult {
      if op == "iroh.endpointId" {
        return shell::AskResult::Ok(base_codec::json_str(local_ep))
      }
      if op == "iroh.relayStatus" {
        return shell::AskResult::Ok(base_codec::json_arr([
          base_codec::json_obj([("url", base_codec::json_str("https://relay.still.fail/")), ("connected", base_codec::json_bool(true))]),
        ]))
      }
      if op == "conn.closeReason" {
        return shell::AskResult::Ok(base_codec::json_null())
      }
      if op == "conn.paths" {
        return shell::AskResult::Ok(base_codec::json_arr([
          base_codec::json_obj([("selected", base_codec::json_bool(true)), ("relay", base_codec::json_str("https://relay.still.fail/"))]),
        ]))
      }
      if op == "conn.stats" {
        return shell::AskResult::Ok(base_codec::json_obj([("rxBytes", base_codec::json_int(0)), ("txBytes", base_codec::json_int(0))]))
      }
      shell::AskResult::Err(shell::ShellError::{ message: "unused: " + op })
    },
    fn(n : Int) -> Bytes {
      let b = Bytes::new(n)
      for i in 0..<n {
        b[i] = ((i * 19 + 7) & 255) as Byte
      }
      b
    },
  )
  holder.push(sh)
  let fresh_calls : Array[Bool] = []
  let fail_first : Array[Bool] = [true]
  let cfg = MeshStationConfig::new(
    "ws-m",
    hex_64("b"),
    ["https://relay.still.fail/"],
    fn(_dev : String, fresh : Bool, k : (effect::Exit[String]) -> Unit) -> Unit {
      fresh_calls.push(fresh)
      if fail_first[0] {
        fail_first[0] = false
        k(effect::Exit::Failed(effect::EffectError::Custom("transient_cloud_503")))
      } else {
        k(effect::Exit::Succeeded("fresh-jwt-ok"))
      }
    },
  )
  let (ctrl, tr) = shell_mesh_transport(sh, cfg)
  ctrl.reconnect_with_fresh_cred()
  // Call #1 fails during `get_cred` -> `force_fresh_cred` MUST stay true!
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    (tr.request_k)("GET", "/overview", [], Bytes::new(0), fn(_ : effect::Exit[HttpReply]) -> Unit { fk(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  debug_assert(fresh_calls.length() == 1 && fresh_calls[0] == true, "attempt #1 passed fresh=true")
  // Call #2 retries -> MUST STILL pass fresh=true (and succeeds get_cred, clearing force_fresh_cred)!
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    (tr.request_k)("GET", "/overview", [], Bytes::new(0), fn(_ : effect::Exit[HttpReply]) -> Unit { fk(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  debug_assert(fresh_calls.length() == 2 && fresh_calls[1] == true, "retry attempt #2 MUST STILL pass fresh=true after attempt #1 failed")
  // Call #3 after `get_cred` succeeded -> `force_fresh_cred` is now cleared (`fresh=false`)!
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    (tr.request_k)("GET", "/overview", [], Bytes::new(0), fn(_ : effect::Exit[HttpReply]) -> Unit { fk(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  debug_assert(fresh_calls.length() == 3 && fresh_calls[2] == false, "attempt #3 reverts to fresh=false after get_cred succeeded")
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    ctrl.close_k(fn(_ : effect::Exit[Unit]) -> Unit { fk(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()

  // 24b. Downgrade bumps `cred_epoch` on `CloudSync`, rejecting pre-downgrade in-flight `/credential` 200!
  let env = AuthSimEnv::new()
  let station = SimStation::new(env.rt)
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-ce"),
    base_codec::json_str("{\"id\":\"ws-ce\",\"name\":\"CE WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let core = ClientCore::new("ws-ce", "ws-ce/st-1", env.rt, env.db, station.transport(), fn() -> Unit {})
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-ce")
  core.bind_cloud_sync(cs)

  // Start pre-downgrade `/credential` fetch
  let cred1_failed : Array[Bool] = [false]
  let _ = env.rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_member_credential_k("ws-ce", "dev-1", 1000L, fn(ex : effect::Exit[MemberCredential]) -> Unit {
      match ex {
        effect::Exit::Failed(_) => { cred1_failed[0] = true }
        _ => ()
      }
      fk(effect::Exit::Succeeded(()))
    })
  })
  let _ = env.rt.run_ready()
  let cred1_req = env.pending[0].0

  // Trigger role downgrade `owner -> member` BEFORE pre-downgrade `/credential` responds!
  let _ = core.update_workspace_role("ws-ce", "member", confirm_workspace_doc=true)
  let _ = env.rt.run_ready()

  // Pre-downgrade `/credential` 200 arrives late -> MUST fail by `cred_epoch` mismatch & MUST NOT populate cache!
  env.answer_http(cred1_req, 200, "{\"credential\":\"stale-owner-jwt\",\"issued_at\":1000,\"expires_at\":999999,\"relay_url\":\"\"}")
  let _ = env.rt.run_ready()
  debug_assert(cred1_failed[0], "pre-downgrade in-flight /credential 200 MUST be rejected after downgrade bumped cred_epoch")

  // Next credential fetch MUST issue a fresh HTTP request (not hit poisoned cache)!
  let before_c2 = env.pending.length()
  let _ = env.rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_member_credential_k("ws-ce", "dev-1", 1000L, fn(_ : effect::Exit[MemberCredential]) -> Unit { fk(effect::Exit::Succeeded(())) })
  })
  let _ = env.rt.run_ready()
  debug_assert(env.pending.length() == before_c2 + 1, "stale pre-downgrade credential did NOT poison cred_cache")
  core.stop()
}

// ── Test 25 (R4 Fix 4): Rotated refresh_token persisted across restart ──

test "auth_lifecycle 25: rotated refresh_token from /v1/auth/refresh is persisted via hook and reused after restart" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let pending : Array[(Int64, String, base_codec::Json)] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {
      pending.push((id, op, args))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult { sim_db.answer(op, args) },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "acct-rot") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("open failed: " + e.to_string())
  }
  let persisted_access : Array[String] = ["expired-a1"]
  let persisted_refresh : Array[String] = ["rt-1"]
  let persisted_exp : Array[Int64] = [0L]

  let cs1 = CloudSync::new(sh, db, "https://cloud.example", token=persisted_access[0])
  cs1.set_refresh_token(persisted_refresh[0])
  cs1.set_token_refreshed_hook(fn(a : String, r : String, exp : Int64) -> Unit {
    persisted_access[0] = a
    persisted_refresh[0] = r
    persisted_exp[0] = exp
  })

  let me_ok : Array[Bool] = [false]
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs1.fetch_me_k(fn(ex : effect::Exit[CloudMe]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => { me_ok[0] = true }
        _ => ()
      }
      fk(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  // Answer /v1/me with 401 -> triggers /v1/auth/refresh with rt-1
  sh.answer(pending[0].0, base_codec::json_obj([("status", base_codec::json_int(401))]), bytes=Some("{\"error\":\"expired\"}".to_bytes()))
  let _ = rt.run_ready()
  debug_assert(pending.length() == 2 && j_str(pending[1].2, "url").ends_with("/v1/auth/refresh"), "401 triggered refresh")
  sh.answer(
    pending[1].0,
    base_codec::json_obj([("status", base_codec::json_int(200))]),
    bytes=Some("{\"access_token\":\"access-2\",\"refresh_token\":\"rt-2\",\"expires_in\":3600}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(persisted_access[0] == "access-2" && persisted_refresh[0] == "rt-2" && persisted_exp[0] > 0L, "rotated tokens persisted via hook")
  sh.answer(
    pending[2].0,
    base_codec::json_obj([("status", base_codec::json_int(200))]),
    bytes=Some("{\"user\":{\"sub\":\"u1\",\"email\":\"a@b.c\"},\"workspaces\":[]}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(me_ok[0], "retry /v1/me succeeded with rotated access-2")

  // Simulate restart: new CloudSync initialized from persisted tokens -> next 401 refresh MUST send `Bearer rt-2`!
  let cs2 = CloudSync::new(sh, db, "https://cloud.example", token=persisted_access[0])
  cs2.set_refresh_token(persisted_refresh[0])
  let mark2 = pending.length()
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs2.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { fk(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  sh.answer(pending[mark2].0, base_codec::json_obj([("status", base_codec::json_int(401))]), bytes=Some("{\"error\":\"expired\"}".to_bytes()))
  let _ = rt.run_ready()
  let ref2_json = base_codec::json_stringify(pending[mark2 + 1].2)
  debug_assert(ref2_json.contains("Bearer rt-2") && !ref2_json.contains("Bearer rt-1"), "restarted CloudSync MUST use rotated rt-2, never stale rt-1")
}

// ── Test 26 (R4 Fix 5): Malformed Cloud responses rejected + Atomic 4-step Rejoin ordering ──

test "auth_lifecycle 26: malformed /v1/me & mismatched /v1/workspaces rejected with 0 deletes/writes/watermark-advance, and rejoin enforces atomic 4-step order" {
  let rt = effect::Runtime::new()
  let sim_db = SimAccountDb::new(rt)
  let fail_marker_del : Array[Bool] = [false]
  let fail_drop : Array[Bool] = [false]
  let pending : Array[(Int64, String, base_codec::Json)] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(id : Int64, op : String, args : base_codec::Json, _bytes : Option[Bytes]) -> Unit {
      pending.push((id, op, args))
    },
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      if op == "sql.run" {
        let q = j_str(args, "sql")
        if fail_drop[0] && q.starts_with("DELETE FROM workspace ") {
          return shell::AskResult::Err(shell::ShellError::{ message: "simulated drop fail" })
        }
        if fail_marker_del[0] && q.starts_with("DELETE FROM account_doc ") {
          return shell::AskResult::Err(shell::ShellError::{ message: "simulated marker delete fail" })
        }
      }
      sim_db.answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = match sql::Sql::open(sh, "acct-strict") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("open failed: " + e.to_string())
  }
  let st = SimStation::new(rt)
  let core = ClientCore::new("ws-good", "ws-good/st-1", rt, db, st.transport(), fn() -> Unit {})
  let cs = CloudSync::new(sh, db, "https://cloud.example", token="tok-strict")
  core.bind_cloud_sync(cs)

  let _ = db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-good"),
    base_codec::json_str("{\"id\":\"ws-good\",\"name\":\"Good WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])

  // 26a. Malformed `/v1/me` missing `workspaces` array -> MUST fail, 0 deletes, 0 watermark advance!
  let me_err : Array[Bool] = [false]
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_me_k(fn(ex : effect::Exit[CloudMe]) -> Unit {
      match ex {
        effect::Exit::Failed(_) => { me_err[0] = true }
        _ => ()
      }
      fk(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  sh.answer(pending[0].0, base_codec::json_obj([("status", base_codec::json_int(200))]), bytes=Some("{\"user\":{\"sub\":\"u1\"}}".to_bytes()))
  let _ = rt.run_ready()
  debug_assert(me_err[0], "malformed /v1/me missing workspaces MUST fail")
  debug_assert(!core.auth.is_revoked("ws-good"), "malformed /v1/me MUST NOT revoke ws-good")
  debug_assert(cs.last_applied_seq("ws-good") == 0L, "malformed /v1/me MUST NOT advance watermark")
  match store::get_workspace(db, "ws-good") {
    sql::SqlResult::Ok(Some(_)) => ()
    _ => debug_assert(false, "ws-good row preserved after malformed /v1/me")
  }

  // 26b. Mismatched `/v1/workspaces/ws-good` returning `id: "ws-other"` -> MUST fail, 0 writes, 0 watermark advance!
  let ws_err : Array[Bool] = [false]
  let idx_b = pending.length()
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-good", fn(ex : effect::Exit[CloudWorkspace]) -> Unit {
      match ex {
        effect::Exit::Failed(_) => { ws_err[0] = true }
        _ => ()
      }
      fk(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  sh.answer(
    pending[idx_b].0,
    base_codec::json_obj([("status", base_codec::json_int(200))]),
    bytes=Some("{\"id\":\"ws-other\",\"name\":\"Wrong WS\",\"role\":\"owner\",\"stations\":[]}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(ws_err[0], "mismatched workspace id MUST fail")
  debug_assert(cs.last_applied_seq("ws-good") == 0L, "mismatched workspace MUST NOT advance ws-good watermark")
  match store::get_workspace(db, "ws-other") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "mismatched ws-other MUST NOT be written to SQLite")
  }

  // 26c. Atomic Rejoin Ordering: marker delete failure keeps workspace revoked & does NOT advance watermark!
  fail_drop[0] = true
  core.revoke_workspace("ws-good")
  fail_drop[0] = false
  fail_marker_del[0] = true
  let seq_before_rej = cs.last_applied_seq("ws-good")
  let rej1_failed : Array[Bool] = [false]
  let idx_c = pending.length()
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-good", fn(ex : effect::Exit[CloudWorkspace]) -> Unit {
      match ex {
        effect::Exit::Failed(_) => { rej1_failed[0] = true }
        _ => ()
      }
      fk(effect::Exit::Succeeded(()))
    })
  })
  let _ = rt.run_ready()
  sh.answer(
    pending[idx_c].0,
    base_codec::json_obj([("status", base_codec::json_int(200))]),
    bytes=Some("{\"id\":\"ws-good\",\"name\":\"Rejoined Good\",\"role\":\"member\",\"members\":[],\"stations\":[]}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(rej1_failed[0] && core.is_workspace_revoked_or_pending("ws-good"), "failed marker delete keeps ws-good revoked/pending")
  debug_assert(cs.last_applied_seq("ws-good") == seq_before_rej, "failed marker delete MUST NOT advance watermark")

  // Heal marker delete -> next rejoin succeeds atomically and advances watermark!
  fail_marker_del[0] = false
  let idx_c2 = pending.length()
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_workspace_k("ws-good", fn(_ : effect::Exit[CloudWorkspace]) -> Unit { fk(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  sh.answer(
    pending[idx_c2].0,
    base_codec::json_obj([("status", base_codec::json_int(200))]),
    bytes=Some("{\"id\":\"ws-good\",\"name\":\"Rejoined Good\",\"role\":\"member\",\"members\":[],\"stations\":[]}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(!core.is_workspace_revoked_or_pending("ws-good"), "healed rejoin clears revoked & pending")
  debug_assert(cs.last_applied_seq("ws-good") > seq_before_rej, "healed rejoin advances watermark")

  // 26d. `/v1/me` rejoin on previously revoked workspace writes minimal row AND forks `/v1/workspaces/<ws>`!
  core.revoke_workspace("ws-good")
  match store::get_workspace(db, "ws-good") {
    sql::SqlResult::Ok(None) => ()
    _ => debug_assert(false, "ws-good dropped before /v1/me rejoin")
  }
  let idx_d = pending.length()
  let _ = rt.fork(fn(fk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cs.fetch_me_k(fn(_ : effect::Exit[CloudMe]) -> Unit { fk(effect::Exit::Succeeded(())) })
  })
  let _ = rt.run_ready()
  sh.answer(
    pending[idx_d].0,
    base_codec::json_obj([("status", base_codec::json_int(200))]),
    bytes=Some("{\"user\":{\"sub\":\"u1\",\"email\":\"a@b.c\"},\"workspaces\":[{\"id\":\"ws-good\",\"name\":\"Me Rejoined\",\"role\":\"member\"}]}".to_bytes()),
  )
  let _ = rt.run_ready()
  debug_assert(!core.is_workspace_revoked_or_pending("ws-good"), "/v1/me rejoin cleared revoked")
  match store::get_workspace(db, "ws-good") {
    sql::SqlResult::Ok(Some(rec)) => debug_assert(rec.json.contains("Me Rejoined"), "/v1/me rejoin wrote minimal workspace row")
    _ => debug_assert(false, "/v1/me rejoin MUST create minimal workspace row")
  }
  let mut forked_ws_fetch = false
  for i in (idx_d + 1)..<pending.length() {
    if pending[i].1 == "fetch" && j_str(pending[i].2, "url").ends_with("/v1/workspaces/ws-good") {
      forked_ws_fetch = true
    }
  }
  debug_assert(forked_ws_fetch, "/v1/me rejoin automatically forked GET /v1/workspaces/ws-good")
  core.stop()
}

// ── Test 27 (R4 Fix 5 P2s): AuthBoundaryEvent::Global re-arms active downgrade latch + LockState.sign_keys in canonical_lock_digest ──

test "auth_lifecycle 27: AuthBoundaryEvent::Global(new_gen, _) re-arms active downgrade latch and sign_keys mutation changes canonical_lock_digest" {
  // 27a. `AuthBoundaryEvent::Global` (`bump_all`) re-arms active downgrade latch & triggers fresh `/v1/workspaces/<ws>`
  let env = AuthSimEnv::new()
  let st = SimStation::new(env.rt)
  let _ = env.db.run(sql_workspace_put(), params=[
    base_codec::json_str("ws-glob"),
    base_codec::json_str("{\"id\":\"ws-glob\",\"name\":\"Global WS\",\"role\":\"owner\",\"stations\":[]}"),
    base_codec::json_int64(1000L),
  ])
  let core = ClientCore::new("ws-glob", "ws-glob/st-1", env.rt, env.db, st.transport(), fn() -> Unit {})
  let cs = CloudSync::new(env.sh, env.db, "https://cloud.example", token="tok-glob")
  core.bind_cloud_sync(cs)

  let _ = core.update_workspace_role("ws-glob", "member", confirm_workspace_doc=false)
  let _ = env.rt.run_ready()
  debug_assert(core.auth.workspace_auth_gen("ws-glob") == 2, "downgrade bumped authGen to 2")

  let pend_before = env.pending.length()
  let _ = core.auth.bump_all()
  let _ = env.rt.run_ready()
  debug_assert(core.auth.workspace_auth_gen("ws-glob") == 3, "bump_all advanced authGen to 3")
  let mut rearm_req = 0L
  for i in pend_before..<env.pending.length() {
    if env.pending[i].1 == "fetch" && j_str(env.pending[i].2, "url").ends_with("/v1/workspaces/ws-glob") {
      rearm_req = env.pending[i].0
    }
  }
  debug_assert(rearm_req > 0L, "AuthBoundaryEvent::Global re-armed active downgrade latch and triggered fresh workspace refetch")

  // 27b. `LockState.sign_keys` mutation changes BOTH `full_digest` and `sec_digest` of `canonical_lock_digest`
  let alice_seed = make_seed(81)
  let alice_key = ed25519_key_id(alice_seed)
  let g = match sign_lock_entry(
    alice_seed,
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("ws-sk")),
      ("seq", form::Json::Num(0.0)),
      ("prev", form::Json::Null),
      ("at", form::Json::Num(1790000000.0)),
      ("kind", form::Json::Str("genesis")),
      ("body", form::Json::Obj([
        ("owner", form::Json::Str("alice")),
        ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
        ("rp_id", form::Json::Str("app.still.fail")),
        ("cloud_keys", form::Json::Obj([])),
        ("members", form::Json::Arr([form::Json::Obj([("sub", form::Json::Str("alice")), ("email", form::Json::Str("alice@example.com")), ("role", form::Json::Str("owner"))])])),
        ("devices", form::Json::Arr([form::Json::Obj([
          ("id", form::Json::Str(hex_64("a"))),
          ("sub", form::Json::Str("alice")),
          ("kind", form::Json::Str("app")),
          ("label", form::Json::Str("Mac")),
          ("sign_key", form::Json::Str(alice_key)),
        ])])),
        ("passkeys", form::Json::Arr([])),
        ("stations", form::Json::Arr([])),
        ("gateways", form::Json::Arr([])),
      ])),
    ]),
  ) {
    Ok(e) => e
    Err(e) => panic("sign: " + e)
  }
  let root = match lock::entry_hash(g, native_lock_crypto()) { Ok(h) => h; Err(_) => panic("root") }
  let st_base = match verify_workspace_lock([g], root) { Ok(v) => v.state; Err(e) => panic("verify: " + e) }
  let (full1, sec1) = canonical_lock_digest(st_base)
  st_base.sign_keys.set("alice", [alice_key, "ed25519:extra-sign-key-r4"])
  let (full2, sec2) = canonical_lock_digest(st_base)
  debug_assert(full2 != full1 && sec2 != sec1, "LockState.sign_keys mutation MUST change canonical_lock_digest")
  core.stop()
}
