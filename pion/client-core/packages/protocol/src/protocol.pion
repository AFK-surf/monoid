  name == "workspaces" ||
  name == "prefs" ||
  name == "doing" ||
  name == "adbShare" ||
  name == "releases" ||
  name == "fonts" ||
  name == "workspaceMarks" ||
  name == "lockPrompts" ||
  name == "downloads" {
    return Some([])
  }
  if name == "workspace" ||
  name == "rigs" ||
  name == "devices" ||
  name == "workspaceWays" ||
  name == "lock" ||
  name == "joinable" ||
  name == "lockDraft" ||
  name == "vaults" ||
  name == "driveTransfers" ||
  name == "filesTabs" {
    return Some([("workspace", req_s.0, req_s.1)])
  }
  if name == "link" ||
  name == "overview" ||
  name == "sessions" ||
  name == "host" ||
  name == "memory" ||
  name == "presets" ||
  name == "profilePace" ||
