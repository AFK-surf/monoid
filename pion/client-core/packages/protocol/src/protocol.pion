    ])
  }
  if name == "search" {
    return Some([
      ("scope", ParamKind::PStr, ParamHow::HReq),
      ("query", ParamKind::PStr, ParamHow::HDef),
      ("kind", ParamKind::PStr, ParamHow::HSkip),
      ("limit", ParamKind::PU32, ParamHow::HSkip),
    ])
  }
  if name == "stationSearch" {
    return Some([
      ("station", ParamKind::PStr, ParamHow::HReq),
      ("q", ParamKind::PStr, ParamHow::HReq),
      ("kind", ParamKind::PStr, ParamHow::HSkip),
      ("limit", ParamKind::PU32, ParamHow::HSkip),
