  if name == "machineLogin" || name == "machineLoginScreen" || name == "job" {
    return Some([("station", req_s.0, req_s.1), ("id", req_s.0, req_s.1)])
  }
  if name == "loginSessions" || name == "adminOverview" {
    return Some([("account", req_s.0, req_s.1)])
