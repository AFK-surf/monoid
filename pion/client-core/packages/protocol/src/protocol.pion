// Strongly typed CoreRequest / CoreEvent domain protocol plus removable thin JSON wire adapter
// compatible with `client/core-ts/src/protocol.ts`, wired to Slice 1 local read-only store queries.

import "base_codec"
import "sql"
import "store"

pub struct Topic {
  pub name : String
  pub params : Array[(String, base_codec::Json)]
}

pub fn Topic::param(self : Topic, key : String) -> Option[base_codec::Json] {
  base_codec::json_obj_get(self.params, key)
}

pub fn Topic::to_json(self : Topic) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = [("topic", base_codec::json_str(self.name))]
  for i in 0..<self.params.length() {
    fields.push(self.params[i])
  }
  base_codec::json_obj(fields)
}

pub fn topic_key(t : Topic) -> String {
  to_sorted_json_str(t.to_json())
}

pub fn same_topic(a : Topic, b : Topic) -> Bool {
  topic_key(a) == topic_key(b)
}

fn opt_str_field(j : base_codec::Json, k : String) -> Option[String] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Str(s)) => Some(s)
    _ => None
  }
}

fn opt_bool_field(j : base_codec::Json, k : String) -> Option[Bool] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Bool(b)) => Some(b)
    _ => None
  }
}

fn opt_nonneg_int64(j : base_codec::Json, k : String) -> Option[Int64] {
  match base_codec::json_get(j, k) {
    Some(base_codec::Json::Num(n, repr)) => {
      if n < 0.0 || n != n || n.floor() != n {
        return None
      }
      if repr.length() > 0 {
        match base_codec::parse_int64_str(repr) {
          Some(v) => if v >= 0.to_int64() { return Some(v) } else { return None }
          None => ()
        }
      }
      if n > 9223372036854774784.0 {
        return None
      }
      Some(n.to_int64())
    }
    _ => None
  }
}

enum ParamKind {
  PStr
  PU64
  PU32
  PU16
  PBool
  PObj
}

enum ParamHow {
  HReq
  HDef
  HOpt
  HSkip
  HSkipFalse
}

fn param_fits(v : base_codec::Json, kind : ParamKind) -> Bool {
  match kind {
    ParamKind::PStr => match v {
      base_codec::Json::Str(_) => true
      _ => false
    }
    ParamKind::PBool => match v {
      base_codec::Json::Bool(_) => true
      _ => false
    }
    ParamKind::PObj => match v {
      base_codec::Json::Obj(_) => true
      _ => false
    }
    ParamKind::PU16 => match v {
      base_codec::Json::Num(n, _) => n == n && n >= 0.0 && n <= 65535.0 && n.floor() == n
      _ => false
    }
    ParamKind::PU32 => match v {
      base_codec::Json::Num(n, _) => n == n && n >= 0.0 && n <= 4294967295.0 && n.floor() == n
      _ => false
    }
    ParamKind::PU64 => match v {
      base_codec::Json::Num(n, _) => n == n && n >= 0.0 && n <= 18446744073709551616.0 && n.floor() == n
      _ => false
    }
  }
}

fn is_valid_station_part(part : String) -> Bool {
  part == "archiving" ||
  part == "automaticDecisions" ||
  part == "profiles" ||
  part == "machineLogins" ||
  part == "logins" ||
  part == "updates" ||
  part == "copies"
}

fn topic_spec_fields(name : String) -> Option[Array[(String, ParamKind, ParamHow)]] {
  let req_s = (ParamKind::PStr, ParamHow::HReq)
