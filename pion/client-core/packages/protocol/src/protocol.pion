  name == "memberships" ||
  name == "screens" ||
  name == "terminals" {
    return Some([("station", req_s.0, req_s.1)])
  }
  if name == "session" || name == "live" || name == "history" || name == "agentCard" {
    return Some([("station", req_s.0, req_s.1), ("key", req_s.0, req_s.1)])
  }
  if name == "stationMove" {
    return Some([
      ("station", ParamKind::PStr, ParamHow::HReq),
      ("to", ParamKind::PStr, ParamHow::HDef),
      ("module", ParamKind::PStr, ParamHow::HDef),
      ("limit", ParamKind::PU32, ParamHow::HSkip),
