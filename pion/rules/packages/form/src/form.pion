///| Canonical JSON encoding and entry text (`rules/src/form/form.mbt`).

let max_safe : Double = 9007199254740991.0

fn write_canonical(sb : StringBuilder, v : Json) -> Result[Unit, String] {
  match v {
    Json::Null => {
      sb.write_string("null")
      Ok(())
    }
    Json::Bool(true) => {
      sb.write_string("true")
      Ok(())
    }
    Json::Bool(false) => {
      sb.write_string("false")
      Ok(())
    }
    Json::Num(n) => {
      if !(n >= -max_safe && n <= max_safe && n.to_int64().to_double() == n) {
        return Err("lock entries hold integers only")
      }
      sb.write_string(n.to_int64().to_string())
      Ok(())
    }
    Json::Str(s) => {
      write_quoted(sb, s)
      Ok(())
    }
    Json::Arr(xs) => {
      sb.write_byte(91.to_byte())
      let n = xs.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte(44.to_byte())
        }
        match write_canonical(sb, xs[i]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      sb.write_byte(93.to_byte())
      Ok(())
    }
    Json::Obj(entries) => {
      let n = entries.length()
      let mut sorted_already = true
      let mut ci = 1
      while ci < n {
        if utf16_cmp(entries[ci - 1].0, entries[ci].0) > 0 {
          sorted_already = false
          break
        }
        ci = ci + 1
      }
      sb.write_byte(123.to_byte())
      if sorted_already {
        let mut j = 0
        while j < n {
          if j > 0 {
            sb.write_byte(44.to_byte())
          }
          write_quoted(sb, entries[j].0)
          sb.write_byte(58.to_byte())
          match write_canonical(sb, entries[j].1) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          j = j + 1
        }
      } else {
        let pairs : Array[(String, Json)] = []
        let mut i = 0
        while i < n {
          pairs.push(entries[i])
          i = i + 1
        }
        if n <= 16 {
          let mut si = 1
          while si < n {
            let cur = pairs[si]
            let mut sj = si - 1
            while sj >= 0 && utf16_cmp(pairs[sj].0, cur.0) > 0 {
              pairs[sj + 1] = pairs[sj]
              sj = sj - 1
            }
            pairs[sj + 1] = cur
            si = si + 1
          }
        } else {
          let tmp : Array[(String, Json)] = []
          let mut k = 0
          while k < n {
            tmp.push(pairs[k])
            k = k + 1
          }
          let mut width = 1
          while width < n {
            let mut left = 0
            while left < n {
              let mid = if left + width < n { left + width } else { n }
              let right = if left + width * 2 < n { left + width * 2 } else { n }
              let mut li = left
              let mut ri = mid
              let mut out = left
              while li < mid && ri < right {
                if utf16_cmp(pairs[li].0, pairs[ri].0) <= 0 {
                  tmp[out] = pairs[li]
                  li = li + 1
                } else {
                  tmp[out] = pairs[ri]
                  ri = ri + 1
                }
                out = out + 1
              }
              while li < mid {
                tmp[out] = pairs[li]
                li = li + 1
                out = out + 1
              }
              while ri < right {
                tmp[out] = pairs[ri]
                ri = ri + 1
                out = out + 1
              }
              let mut p = left
              while p < right {
                pairs[p] = tmp[p]
                p = p + 1
              }
              left = left + width * 2
            }
            width = width * 2
          }
        }
        let mut j = 0
        while j < n {
          if j > 0 {
            sb.write_byte(44.to_byte())
          }
          write_quoted(sb, pairs[j].0)
          sb.write_byte(58.to_byte())
          match write_canonical(sb, pairs[j].1) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          j = j + 1
        }
      }
      sb.write_byte(125.to_byte())
      Ok(())
    }
  }
}

///| JSON with object keys sorted by UTF-16 code unit and no whitespace.
pub fn canonical(v : Json) -> Result[String, String] {
  let sb = StringBuilder::new()
  match write_canonical(sb, v) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///| What an entry's hash is of: everything but its signature, tagged.
pub fn entry_text(e : Json) -> Result[String, String] {
  let entries = match e {
    Json::Obj(m) => m
    _ => return Err("an entry is an object")
  }
  let hashed : Array[(String, Json)] = []
  let fields = ["at", "body", "kind", "prev", "seq", "v", "ws"]
  let mut i = 0
  while i < fields.length() {
    let k = fields[i]
    match json_obj_get(entries, k) {
      Some(x) => hashed.push((k, x))
      None => ()
    }
    i = i + 1
  }
  let sb = StringBuilder::new()
  sb.write_string("stillfail-lock/1\n")
  match write_canonical(sb, Json::Obj(hashed)) {
    Ok(_) => Ok(sb.to_string())
    Err(why) => Err(why)
  }
}
