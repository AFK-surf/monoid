///| Pure Pion JSON AST, parser (preserving lone surrogates via WTF-8), equality, and serializer.

pub enum Json {
  Null
  Bool(Bool)
  Num(Double)
  Str(String)
  Arr(Array[Json])
  Obj(Array[(String, Json)])
}

pub fn json_obj_get(entries : Array[(String, Json)], key : String) -> Option[Json] {
  let n = entries.length()
  let mut i = 0
  while i < n {
    if entries[i].0 == key {
      return Some(entries[i].1)
    }
    i = i + 1
  }
  None
}

pub fn json_obj_set(entries : Array[(String, Json)], key : String, v : Json) -> Unit {
  let n = entries.length()
  let mut i = 0
  while i < n {
    if entries[i].0 == key {
      entries[i] = (key, v)
      return
    }
    i = i + 1
  }
  entries.push((key, v))
}

pub fn json_field(v : Option[Json], key : String) -> Option[Json] {
  match v {
    Some(Json::Obj(entries)) => json_obj_get(entries, key)
    _ => None
  }
}

pub fn json_eq(a : Json, b : Json) -> Bool {
  match (a, b) {
    (Json::Null, Json::Null) => true
    (Json::Bool(x), Json::Bool(y)) => x == y
    (Json::Num(x), Json::Num(y)) => x == y
    (Json::Str(x), Json::Str(y)) => x == y
    (Json::Arr(xs), Json::Arr(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        if !json_eq(xs[i], ys[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (Json::Obj(xs), Json::Obj(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        let (k, v) = xs[i]
        match json_obj_get(ys, k) {
          Some(v2) => if !json_eq(v, v2) { return false }
          None => return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

pub fn opt_json_eq(a : Option[Json], b : Option[Json]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => json_eq(x, y)
    _ => false
  }
}

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    -1
  }
}

struct Parser {
  src : String
  len : Int
  mut pos : Int
}

fn Parser::skip_ws(self : Parser) -> Unit {
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
}

fn Parser::parse_hex4(self : Parser) -> Result[Int, String] {
  if self.pos + 4 > self.len {
    return Err("truncated unicode escape")
  }
  let mut v = 0
  let mut i = 0
  while i < 4 {
    let d = hex_val(self.src.code_unit_at(self.pos + i))
    if d < 0 {
      return Err("invalid hex digit in unicode escape")
    }
    v = (v << 4) | d
    i = i + 1
  }
  self.pos = self.pos + 4
  Ok(v)
}

fn Parser::parse_string(self : Parser) -> Result[String, String] {
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 34 {
    return Err("expected '\"'")
  }
  self.pos = self.pos + 1
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 34 {
      self.pos = self.pos + 1
      return Ok(sb.to_string())
    }
    if b == 92 {
      self.pos = self.pos + 1
      if self.pos >= self.len {
        return Err("unterminated escape")
      }
      let esc = self.src.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if esc == 34 {
        sb.write_byte(34.to_byte())
      } else if esc == 92 {
        sb.write_byte(92.to_byte())
      } else if esc == 47 {
        sb.write_byte(47.to_byte())
      } else if esc == 98 {
        sb.write_byte(8.to_byte())
      } else if esc == 102 {
        sb.write_byte(12.to_byte())
      } else if esc == 110 {
        sb.write_byte(10.to_byte())
      } else if esc == 114 {
        sb.write_byte(13.to_byte())
      } else if esc == 116 {
        sb.write_byte(9.to_byte())
      } else if esc == 117 {
        let u1 = match self.parse_hex4() {
          Ok(u) => u
          Err(e) => return Err(e)
        }
        if u1 >= 0xD800 && u1 <= 0xDBFF {
          // Check for following low surrogate \uXXXX
          if self.pos + 6 <= self.len && self.src.code_unit_at(self.pos) == 92 && self.src.code_unit_at(self.pos + 1) == 117 {
            let saved = self.pos
            self.pos = self.pos + 2
            match self.parse_hex4() {
              Ok(u2) => {
                if u2 >= 0xDC00 && u2 <= 0xDFFF {
                  let cp = 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00)
                  write_wtf8(sb, cp)
                } else {
                  self.pos = saved
                  write_wtf8(sb, u1)
                }
              }
              Err(_) => {
                self.pos = saved
                write_wtf8(sb, u1)
              }
            }
          } else {
            write_wtf8(sb, u1)
          }
        } else {
          write_wtf8(sb, u1)
        }
      } else {
        return Err("invalid escape")
      }
    } else {
      sb.write_byte(b.to_byte())
      self.pos = self.pos + 1
    }
  }
  Err("unterminated string")
}

fn Parser::parse_number(self : Parser) -> Result[Json, String] {
  let start = self.pos
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 45 {
    self.pos = self.pos + 1
  }
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if (b >= 48 && b <= 57) || b == 46 || b == 101 || b == 69 || b == 43 || b == 45 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  if self.pos == start {
    return Err("expected number")
  }
  let slice = self.src.slice(start, self.pos)
  match slice.to_double() {
    Some(d) => Ok(Json::Num(d))
    None => Err("invalid number: " + slice)
  }
}

fn Parser::parse_array(self : Parser) -> Result[Json, String] {
  self.pos = self.pos + 1
  self.skip_ws()
  let items : Array[Json] = []
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 93 {
    self.pos = self.pos + 1
    return Ok(Json::Arr(items))
  }
  while true {
    self.skip_ws()
    match self.parse_value() {
      Ok(v) => items.push(v)
      Err(e) => return Err(e)
    }
    self.skip_ws()
    if self.pos >= self.len {
      return Err("unterminated array")
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 93 {
      self.pos = self.pos + 1
      return Ok(Json::Arr(items))
    } else if b == 44 {
      self.pos = self.pos + 1
    } else {
      return Err("expected ',' or ']' in array")
    }
  }
  Ok(Json::Arr(items))
}

fn Parser::parse_object(self : Parser) -> Result[Json, String] {
  self.pos = self.pos + 1
  self.skip_ws()
  let entries : Array[(String, Json)] = []
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 125 {
    self.pos = self.pos + 1
    return Ok(Json::Obj(entries))
  }
  while true {
    self.skip_ws()
    let key = match self.parse_string() {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    self.skip_ws()
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 58 {
      return Err("expected ':' after object key")
    }
    self.pos = self.pos + 1
    self.skip_ws()
    let v = match self.parse_value() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    json_obj_set(entries, key, v)
    self.skip_ws()
    if self.pos >= self.len {
      return Err("unterminated object")
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 125 {
      self.pos = self.pos + 1
      // Decode special non-finite number sentinel from JS wrapper
      if entries.length() == 1 && entries[0].0 == "$__pion_num__" {
        match entries[0].1 {
          Json::Str("NaN") => return Ok(Json::Num(0.0 / 0.0))
          Json::Str("Inf") => return Ok(Json::Num(1.0 / 0.0))
          Json::Str("-Inf") => return Ok(Json::Num(-1.0 / 0.0))
          _ => ()
        }
      }
      return Ok(Json::Obj(entries))
    } else if b == 44 {
      self.pos = self.pos + 1
    } else {
      return Err("expected ',' or '}' in object")
    }
  }
  Ok(Json::Obj(entries))
}

fn Parser::parse_value(self : Parser) -> Result[Json, String] {
  self.skip_ws()
  if self.pos >= self.len {
    return Err("unexpected end of JSON")
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 110 {
    if self.pos + 4 <= self.len && self.src.slice(self.pos, self.pos + 4) == "null" {
      self.pos = self.pos + 4
      Ok(Json::Null)
    } else {
      Err("invalid literal")
    }
  } else if b == 116 {
    if self.pos + 4 <= self.len && self.src.slice(self.pos, self.pos + 4) == "true" {
      self.pos = self.pos + 4
      Ok(Json::Bool(true))
    } else {
      Err("invalid literal")
    }
  } else if b == 102 {
    if self.pos + 5 <= self.len && self.src.slice(self.pos, self.pos + 5) == "false" {
      self.pos = self.pos + 5
      Ok(Json::Bool(false))
    } else {
      Err("invalid literal")
    }
  } else if b == 34 {
    match self.parse_string() {
      Ok(s) => Ok(Json::Str(s))
      Err(e) => Err(e)
    }
  } else if b == 91 {
    self.parse_array()
  } else if b == 123 {
    self.parse_object()
  } else if b == 45 || (b >= 48 && b <= 57) {
    self.parse_number()
  } else {
    Err("unexpected character in JSON")
  }
}

pub fn parse_json(src : String) -> Result[Json, String] {
  let p = Parser::{ src: src, len: src.length(), pos: 0 }
  let v = match p.parse_value() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  p.skip_ws()
  if p.pos != p.len {
    return Err("trailing characters after JSON")
  }
  Ok(v)
}

fn hex_nibble(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (87 + n).to_byte()
  }
}

pub fn write_unicode_escape(sb : StringBuilder, c : Int) -> Unit {
  sb.write_string("\\u")
  sb.write_byte(hex_nibble((c >> 12) & 0xF))
  sb.write_byte(hex_nibble((c >> 8) & 0xF))
  sb.write_byte(hex_nibble((c >> 4) & 0xF))
  sb.write_byte(hex_nibble(c & 0xF))
}

///| Quote a WTF-8 string as JSON.stringify writes it (lone surrogates escaped as `\udxxx`).
pub fn write_quoted(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte(34.to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      if b0 == 0x22 {
        sb.write_string("\\\"")
      } else if b0 == 0x5C {
        sb.write_string("\\\\")
      } else if b0 == 0x08 {
        sb.write_string("\\b")
      } else if b0 == 0x0C {
        sb.write_string("\\f")
      } else if b0 == 0x0A {
        sb.write_string("\\n")
      } else if b0 == 0x0D {
        sb.write_string("\\r")
      } else if b0 == 0x09 {
        sb.write_string("\\t")
      } else if b0 < 0x20 {
        write_unicode_escape(sb, b0)
      } else {
        sb.write_byte(b0.to_byte())
      }
      i = i + 1
    } else if b0 < 0xE0 && i + 1 < n {
      sb.write_byte(b0.to_byte())
      sb.write_byte(s.code_unit_at(i + 1).to_byte())
      i = i + 2
    } else if b0 < 0xF0 && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      if cp >= 0xD800 && cp <= 0xDFFF {
        write_unicode_escape(sb, cp)
      } else {
        sb.write_byte(b0.to_byte())
        sb.write_byte(b1.to_byte())
        sb.write_byte(b2.to_byte())
      }
      i = i + 3
    } else if i + 3 < n {
      sb.write_byte(b0.to_byte())
      sb.write_byte(s.code_unit_at(i + 1).to_byte())
      sb.write_byte(s.code_unit_at(i + 2).to_byte())
      sb.write_byte(s.code_unit_at(i + 3).to_byte())
      i = i + 4
    } else {
      sb.write_byte(b0.to_byte())
      i = i + 1
    }
  }
  sb.write_byte(34.to_byte())
}

fn write_json_impl(sb : StringBuilder, v : Json) -> Unit {
  match v {
    Json::Null => sb.write_string("null")
    Json::Bool(true) => sb.write_string("true")
    Json::Bool(false) => sb.write_string("false")
    Json::Num(d) => {
      if d == d.floor() && d.abs() <= 9007199254740991.0 {
        sb.write_string(d.to_int64().to_string())
      } else if d != d || d == 1.0 / 0.0 || d == -1.0 / 0.0 {
        sb.write_string("null")
      } else {
        sb.write_string(d.to_string())
      }
    }
    Json::Str(s) => write_quoted(sb, s)
    Json::Arr(xs) => {
      sb.write_byte(91.to_byte())
      let n = xs.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte(44.to_byte())
        }
        write_json_impl(sb, xs[i])
        i = i + 1
      }
      sb.write_byte(93.to_byte())
    }
    Json::Obj(entries) => {
      sb.write_byte(123.to_byte())
      let n = entries.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte(44.to_byte())
        }
        write_quoted(sb, entries[i].0)
        sb.write_byte(58.to_byte())
        write_json_impl(sb, entries[i].1)
        i = i + 1
      }
      sb.write_byte(125.to_byte())
    }
  }
}

pub fn json_stringify(v : Json) -> String {
  let sb = StringBuilder::new()
  write_json_impl(sb, v)
  sb.to_string()
}
