///| Unit tests for `fork`.

test "fork ahead and step" {
  debug_assert(ahead(3, false, 9, 9, 2, true, 0, 0), "weight wins")
  debug_assert(!ahead(2, true, 0, 0, 3, false, 9, 9), "lower weight loses")
  debug_assert(ahead(2, true, 9, 9, 2, false, 0, 0), "removal wins on equal weight")
  debug_assert(ahead(2, false, 1, 9, 2, false, 2, 0), "lower tie wins")
  debug_assert(ahead(2, false, 1, 0, 2, false, 1, 1), "lower hash wins")
  debug_assert(!ahead(2, false, 1, 0, 2, false, 1, 0), "irreflexive")

  let sw = match step(3, false, 0, 0, 2, false, 0, 0) {
    Some(Step::Weight) => true
    _ => false
  }
  debug_assert(sw, "step weight")
  let sr = match step(2, true, 0, 0, 2, false, 0, 0) {
    Some(Step::Removal) => true
    _ => false
  }
  debug_assert(sr, "step removal")
  let st = match step(2, false, 0, 0, 2, false, 1, 0) {
    Some(Step::Tie) => true
    _ => false
  }
  debug_assert(st, "step tie")
  let sh = match step(2, false, 0, 0, 2, false, 0, 1) {
    Some(Step::Hash) => true
    _ => false
  }
  debug_assert(sh, "step hash")
  let sn = match step(2, false, 0, 1, 2, false, 0, 0) {
    None => true
    _ => false
  }
  debug_assert(sn, "step none")
}

test "fork best picks winner regardless of order" {
  let ws = [1, 3, 2, 3]
  let rs = [true, false, true, true]
  let ts = [0, 0, 0, 5]
  let hs = [0, 1, 2, 3]
  debug_assert(best(ws, rs, ts, hs) == 3, "weight 3 + removal wins")
}
