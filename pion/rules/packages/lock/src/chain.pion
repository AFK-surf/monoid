///| Log active chain selection by fork choice (`rules/src/lock/chain.mbt`).

pub enum Off {
  NotValid(String)
  NoParent
  Beaten(String, fork::Step)
  Below(String)
  Again
}

pub struct Chain {
  entries : Array[form::Json]
  at : Array[Int]
  hashes : Array[String]
  off : Array[(Int, Off)]
}

pub enum Votes {
  Flat
  Roles
}

struct LogOps[S] {
  start : (form::Json, String) -> Result[S, LockError]
  next : (S, form::Json, String) -> Result[S, LockError]
  next_in : (S, form::Json, String) -> Result[S, LockError]
  weight : (S, form::Json) -> Int
  removal : (S, form::Json) -> Bool
}

struct Node[S] {
  at : Int
  hash : String
  state : S
}

pub fn tie_of(parent : String, key : String, c : Crypto) -> String {
  let sb = StringBuilder::new()
  sb.write_string(parent)
  sb.write_byte(0.to_byte())
  sb.write_string(key)
  (c.sha256_hex)(sb.to_string())
}

pub fn before(
  wa : Int,
  ra : Bool,
  ta : String,
  ha : String,
  wb : Int,
  rb : Bool,
  tb : String,
  hb : String,
) -> Option[fork::Step] {
  let ct = form::mbt_str_cmp(ta, tb)
  let (pta, ptb) = if ct < 0 { (0, 1) } else if ct > 0 { (1, 0) } else { (0, 0) }
  let ch = form::mbt_str_cmp(ha, hb)
  let (pha, phb) = if ch < 0 { (0, 1) } else if ch > 0 { (1, 0) } else { (0, 0) }
  fork::step(wa, ra, pta, pha, wb, rb, ptb, phb)
}

fn places(xs : Array[String]) -> Array[Int] {
  let n = xs.length()
  let sorted : Array[String] = []
  let mut i = 0
  while i < n {
    sorted.push(xs[i])
    i = i + 1
  }
  form::sort_strings_mbt(sorted)
  let at : Map[String, Int] = Map::new()
  let mut count = 0
  let mut j = 0
  while j < n {
    let x = sorted[j]
    if !at.contains(x) {
      at.set(x, count)
      count = count + 1
    }
    j = j + 1
  }
  let out : Array[Int] = []
  let mut k = 0
  while k < n {
    let p = match at.get(xs[k]) {
      Some(v) => v
      None => 0
    }
    out.push(p)
    k = k + 1
  }
  out
}

fn sort_ints_by(xs : Array[Int], cmp : (Int, Int) -> Int) -> Unit {
  let n = xs.length()
  if n <= 1 {
    return
  }
  let tmp : Array[Int] = []
  let mut k = 0
  while k < n {
    tmp.push(xs[k])
    k = k + 1
  }
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut i = left
      let mut j = mid
      let mut out = left
      while i < mid && j < right {
        if cmp(xs[i], xs[j]) <= 0 {
          tmp[out] = xs[i]
          i = i + 1
        } else {
          tmp[out] = xs[j]
          j = j + 1
        }
        out = out + 1
      }
      while i < mid {
        tmp[out] = xs[i]
        i = i + 1
        out = out + 1
      }
      while j < right {
        tmp[out] = xs[j]
        j = j + 1
        out = out + 1
      }
      let mut p = left
      while p < right {
        xs[p] = tmp[p]
        p = p + 1
      }
      left = left + width * 2
    }
    width = width * 2
  }
}

fn active[S](entries : Array[form::Json], genesis_hash : String, log : LogOps[S], c : Crypto) -> Result[Chain, LockError] {
  let n_entries = entries.length()
  let off : Map[Int, Off] = Map::new()
  let hashes : Array[String] = []
  let mut i = 0
  while i < n_entries {
    let h = match entry_hash(entries[i], c) {
      Ok(x) => x
      Err(err) => {
        off.set(i, Off::NotValid(error_msg(err)))
        ""
      }
    }
    hashes.push(h)
    i = i + 1
  }
  let by_hash : form::OrderedMap[Array[Int]] = form::OrderedMap::new()
  let kids : Map[String, Array[String]] = Map::new()
  let mut hi = 0
  while hi < n_entries {
    let h = hashes[hi]
    if h != "" {
      match by_hash.get(h) {
        Some(xs) => xs.push(hi)
        None => {
          by_hash.set(h, [hi])
          match text_of(field(Some(entries[hi]), "prev")) {
            Some(p) => {
              match kids.get(p) {
                Some(ks) => ks.push(h)
                None => kids.set(p, [h])
              }
            }
            None => ()
          }
        }
      }
    }
    hi = hi + 1
  }
  let bh_vals = by_hash.values()
  let mut bi = 0
  while bi < bh_vals.length() {
    let bucket = bh_vals[bi]
    if bucket.length() > 1 {
      let sig_map : Map[Int, String] = Map::new()
      let mut sbi = 0
      while sbi < bucket.length() {
        let idx = bucket[sbi]
        let st = match form::canonical(sig_of(entries[idx])) {
          Ok(s) => s
          Err(_) => ""
        }
        sig_map.set(idx, st)
        sbi = sbi + 1
      }
      sort_ints_by(bucket, fn(a : Int, b : Int) -> Int {
        let sa = match sig_map.get(a) {
          Some(x) => x
          None => ""
        }
        let sb = match sig_map.get(b) {
          Some(x) => x
          None => ""
        }
        form::mbt_str_cmp(sa, sb)
      })
    }
    bi = bi + 1
  }
  let first = fn(h : String, take : (form::Json, String) -> Result[S, LockError]) -> Option[Node[S]] {
    let mut got : Option[Node[S]] = None
    let idxs = match by_hash.get(h) {
      Some(xs) => xs
      None => []
    }
    let mut k = 0
    while k < idxs.length() {
      let idx = idxs[k]
      let already = match got {
        Some(_) => true
        None => false
      }
      if already {
        off.set(idx, Off::Again)
      } else {
        match take(entries[idx], h) {
          Ok(st) => {
            got = Some(Node::{ at: idx, hash: h, state: st })
          }
          Err(err) => off.set(idx, Off::NotValid(error_msg(err)))
        }
      }
      k = k + 1
    }
    got
  }
  if !by_hash.contains(genesis_hash) {
    return Err(LockError::Refused("no lock"))
  }
  let root = match first(genesis_hash, log.start) {
    Some(r) => r
    None => {
      let g_idxs = match by_hash.get(genesis_hash) {
        Some(xs) => xs
        None => []
      }
      if g_idxs.length() > 0 {
        match off.get(g_idxs[0]) {
          Some(Off::NotValid(why)) => return Err(LockError::Refused(why))
          _ => return Err(LockError::Refused("no lock"))
        }
      }
      return Err(LockError::Refused("no lock"))
    }
  }
  let nodes : Map[String, Node[S]] = Map::new()
  nodes.set(genesis_hash, root)
  let children : Map[String, Array[Node[S]]] = Map::new()
  let todo : Array[Node[S]] = [root]
  while todo.length() > 0 {
    let p = match todo.pop() {
      Some(x) => x
      None => break
    }
    let ks : Array[Node[S]] = []
    let hs = match kids.get(p.hash) {
      Some(xs) => xs
      None => []
    }
    let alone = hs.length() == 1 && match by_hash.get(hs[0]) {
      Some(xs) => xs.length() == 1
      None => false
    }
    let mut ki = 0
    while ki < hs.length() {
      let h = hs[ki]
      let take_fn = fn(e : form::Json, eh : String) -> Result[S, LockError] {
        if alone {
          (log.next_in)(p.state, e, eh)
        } else {
          (log.next)(p.state, e, eh)
        }
      }
      match first(h, take_fn) {
        Some(n) => {
          nodes.set(h, n)
          ks.push(n)
          todo.push(n)
        }
        None => ()
      }
      ki = ki + 1
    }
    children.set(p.hash, ks)
  }
  let chain : Array[Node[S]] = [root]
  let beaten : Array[String] = []
  while true {
    let p = chain[chain.length() - 1]
    let ks = match children.get(p.hash) {
      Some(xs) => {
        if xs.length() == 0 {
          break
        }
        xs
      }
      None => break
    }
    let klen = ks.length()
    if klen == 1 {
      chain.push(ks[0])
      continue
    }
    let ws : Array[Int] = []
    let rs : Array[Bool] = []
    let ties : Array[String] = []
    let khs : Array[String] = []
    let mut j = 0
    while j < klen {
      let k = ks[j]
      ws.push((log.weight)(p.state, entries[k.at]))
      rs.push((log.removal)(p.state, entries[k.at]))
      ties.push(tie_of(p.hash, sig_key(entries[k.at]), c))
      khs.push(k.hash)
      j = j + 1
    }
    let ts = places(ties)
    let hs = places(khs)
    let b = fork::best(ws, rs, ts, hs)
    let mut m = 0
    while m < klen {
      if m != b {
        let by = match fork::step(ws[b], rs[b], ts[b], hs[b], ws[m], rs[m], ts[m], hs[m]) {
          Some(st) => st
          None => fork::Step::Hash
        }
        off.set(ks[m].at, Off::Beaten(ks[b].hash, by))
        beaten.push(ks[m].hash)
      }
      m = m + 1
    }
    chain.push(ks[b])
  }
  let mut bti = 0
  while bti < beaten.length() {
    let top = beaten[bti]
    let below : Array[Node[S]] = []
    match children.get(top) {
      Some(xs) => {
        let mut xj = 0
        while xj < xs.length() {
          below.push(xs[xj])
          xj = xj + 1
        }
      }
      None => ()
    }
    while below.length() > 0 {
      let n = match below.pop() {
        Some(x) => x
        None => break
      }
      off.set(n.at, Off::Below(top))
      match children.get(n.hash) {
        Some(xs) => {
          let mut xj = 0
          while xj < xs.length() {
            below.push(xs[xj])
            xj = xj + 1
          }
        }
        None => ()
      }
    }
    bti = bti + 1
  }
  let mut ri = 0
  while ri < n_entries {
    let h = hashes[ri]
    if h != "" && !off.contains(ri) {
      let is_node = match nodes.get(h) {
        Some(n) => n.at == ri
        None => false
      }
      if !is_node {
        let is_gen = match field(Some(entries[ri]), "prev") {
          Some(form::Json::Null) => true
          _ => false
        }
        if is_gen {
          off.set(ri, Off::NotValid("not the genesis this log is pinned to"))
        } else {
          off.set(ri, Off::NoParent)
        }
      }
    }
    ri = ri + 1
  }
  let out_off : Array[(Int, Off)] = []
  let mut oi = 0
  while oi < n_entries {
    match off.get(oi) {
      Some(o) => out_off.push((oi, o))
      None => ()
    }
    oi = oi + 1
  }
  let out_entries : Array[form::Json] = []
  let out_at : Array[Int] = []
  let out_hashes : Array[String] = []
  let mut ci = 0
  while ci < chain.length() {
    let n = chain[ci]
    out_entries.push(entries[n.at])
    out_at.push(n.at)
    out_hashes.push(n.hash)
    ci = ci + 1
  }
  Ok(Chain::{ entries: out_entries, at: out_at, hashes: out_hashes, off: out_off })
}

pub fn lock_chain(entries : Array[form::Json], root : String, votes : Votes, now : Option[Double], c : Crypto) -> Result[Chain, LockError] {
  let ops : LogOps[LockState] = LogOps::{
    start: fn(e : form::Json, h : String) -> Result[LockState, LockError] { genesis_hashed(e, Some(h), c) },
    next: fn(s : LockState, e : form::Json, h : String) -> Result[LockState, LockError] { step_hashed(s, e, now, c, false, Some(h)) },
    next_in: fn(s : LockState, e : form::Json, h : String) -> Result[LockState, LockError] { step_hashed(s, e, now, c, true, Some(h)) },
    weight: fn(s : LockState, e : form::Json) -> Int {
      match votes {
        Votes::Flat => 1
        Votes::Roles => {
          match signer(s, sig_key(e), None) {
            Some(w) => if w.role == "owner" { 3 } else if w.role == "admin" { 2 } else { 1 }
            None => 0
          }
        }
      }
    },
    removal: fn(s : LockState, e : form::Json) -> Bool {
      let v = Some(e)
      if !opt_str_eq(text_of(field(v, "kind")), "device.remove") {
        return false
      }
      let id = match text_of(field(field(v, "body"), "id")) {
        Some(x) => x
        None => ""
      }
      match s.devices.get(id) {
        Some(d) => {
          match d.sign_key {
            Some(_) => true
            None => false
          }
        }
        None => false
      }
    },
  }
  active(entries, root, ops, c)
}

pub fn person_chain(entries : Array[form::Json], root : String, c : Crypto) -> Result[Chain, LockError] {
  let ops : LogOps[Person] = LogOps::{
    start: fn(e : form::Json, h : String) -> Result[Person, LockError] {
      let sub = match text_of(field(field(Some(e), "body"), "sub")) {
        Some(s) => s
        None => ""
      }
      match person_step_hashed(None, e, sub, c, Some(h), false) {
        Ok((p, _)) => Ok(p)
        Err(err) => Err(err)
      }
    },
    next: fn(p : Person, e : form::Json, h : String) -> Result[Person, LockError] {
      match person_step_hashed(Some(p), e, p.sub, c, Some(h), false) {
        Ok((np, _)) => Ok(np)
        Err(err) => Err(err)
      }
    },
    next_in: fn(p : Person, e : form::Json, h : String) -> Result[Person, LockError] {
      match person_step_hashed(Some(p), e, p.sub, c, Some(h), false) {
        Ok((np, _)) => Ok(np)
        Err(err) => Err(err)
      }
    },
    weight: fn(_p : Person, _e : form::Json) -> Int { 1 },
    removal: fn(_p : Person, e : form::Json) -> Bool { opt_str_eq(text_of(field(Some(e), "kind")), "device.remove") },
  }
  active(entries, root, ops, c)
}
