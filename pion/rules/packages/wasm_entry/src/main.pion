///| WebAssembly (wasm32) entry point exporting all `rules/js/rules.js` functions.

import "role"
import "form"
import "fork"
import "history"
import "lock"
import "vault"

// ── Host I/O and Crypto callbacks (provided by js/rules-wasm.mjs) ─────────────────────────────────────────────────

extern "C" fn rules_in_len() -> Int
extern "C" fn rules_in_copy(dst : Ptr) -> Unit
extern "C" fn rules_out_set(src : Ptr, len : Int) -> Unit
extern "C" fn rules_cb_copy(dst : Ptr) -> Unit

extern "C" fn rules_sha256_hex_into(ptr : Ptr, len : Int, dst : Ptr) -> Int
extern "C" fn rules_sig_valid(
  sig_ptr : Ptr,
  sig_len : Int,
  hash_ptr : Ptr,
  hash_len : Int,
  origins_ptr : Ptr,
  origins_len : Int,
  rp_ptr : Ptr,
  rp_len : Int,
  passkey : Int,
) -> Int
extern "C" fn rules_sig_valid_ed(
  key_ptr : Ptr,
  key_len : Int,
  alg_ptr : Ptr,
  alg_len : Int,
  sig_ptr : Ptr,
  sig_len : Int,
  hash_ptr : Ptr,
  hash_len : Int,
  origins_ptr : Ptr,
  origins_len : Int,
  rp_ptr : Ptr,
  rp_len : Int,
  passkey : Int,
) -> Int
extern "C" fn rules_valid_key_id(ptr : Ptr, len : Int) -> Int
extern "C" fn rules_endpoint_proof(
  ws_ptr : Ptr,
  ws_len : Int,
  base_ptr : Ptr,
  base_len : Int,
  ep_ptr : Ptr,
  ep_len : Int,
  proof_ptr : Ptr,
  proof_len : Int,
) -> Int
extern "C" fn rules_tagged_sig_valid(
  key_ptr : Ptr,
  key_len : Int,
  sig_ptr : Ptr,
  sig_len : Int,
  tag_ptr : Ptr,
  tag_len : Int,
  dig_ptr : Ptr,
  dig_len : Int,
) -> Int
extern "C" fn rules_record_sig_valid(
  sig_ptr : Ptr,
  sig_len : Int,
  tag_ptr : Ptr,
  tag_len : Int,
  text_ptr : Ptr,
  text_len : Int,
) -> Int

fn read_in_str() -> String {
  let n = rules_in_len()
  if n <= 0 {
    return ""
  }
  let s = Bytes::new(n).to_string()
  rules_in_copy(s.as_cstr())
  s
}

fn read_cb_str(n : Int) -> String {
  if n <= 0 {
    return ""
  }
  let s = Bytes::new(n).to_string()
  rules_cb_copy(s.as_cstr())
  s
}

fn write_out_str(s : String) -> Int {
  let n = s.length()
  rules_out_set(s.as_cstr(), n)
  n
}

fn write_out_json(j : form::Json) -> Int {
  write_out_str(form::json_stringify(j))
}

fn host_lock_crypto() -> lock::Crypto {
  lock::Crypto::{
    sha256_hex: fn(s : String) -> String {
      let out = Bytes::new(64).to_string()
      let n = rules_sha256_hex_into(s.as_cstr(), s.length(), out.as_cstr())
      if n == 64 {
        out
      } else if n < 0 {
        read_cb_str(0 - n - 1)
      } else {
        read_cb_str(n)
      }
    },
    sig_valid: fn(sig : form::Json, hash : String, origins : Array[String], rp_id : String, passkey : Bool) -> Bool {
      let orig_s = if origins.length() == 0 {
        ""
      } else {
        let orig_arr : Array[form::Json] = []
        let mut i = 0
        while i < origins.length() {
          orig_arr.push(form::Json::Str(origins[i]))
          i = i + 1
        }
        form::json_stringify(form::Json::Arr(orig_arr))
      }
      let pk = if passkey { 1 } else { 0 }
      match sig {
        form::Json::Obj(entries) => {
          if entries.length() == 3 {
            match (
              form::json_obj_get(entries, "key"),
              form::json_obj_get(entries, "alg"),
              form::json_obj_get(entries, "sig"),
            ) {
              (Some(form::Json::Str(k)), Some(form::Json::Str(a)), Some(form::Json::Str(sg))) => {
                return rules_sig_valid_ed(
                  k.as_cstr(),
                  k.length(),
                  a.as_cstr(),
                  a.length(),
                  sg.as_cstr(),
                  sg.length(),
                  hash.as_cstr(),
                  hash.length(),
                  orig_s.as_cstr(),
                  orig_s.length(),
                  rp_id.as_cstr(),
                  rp_id.length(),
                  pk,
                ) != 0
              }
              _ => ()
            }
          }
        }
        _ => ()
      }
      let sig_s = form::json_stringify(sig)
      rules_sig_valid(sig_s.as_cstr(), sig_s.length(), hash.as_cstr(), hash.length(), orig_s.as_cstr(), orig_s.length(), rp_id.as_cstr(), rp_id.length(), pk) != 0
    },
    valid_key_id: fn(id : String) -> Bool { rules_valid_key_id(id.as_cstr(), id.length()) != 0 },
    endpoint_proof: fn(ws : String, base : String, ep : String, proof : String) -> Bool {
      rules_endpoint_proof(ws.as_cstr(), ws.length(), base.as_cstr(), base.length(), ep.as_cstr(), ep.length(), proof.as_cstr(), proof.length()) != 0
    },
    tagged_sig_valid: fn(key : String, sig : String, tag : String, digest : String) -> Bool {
      rules_tagged_sig_valid(key.as_cstr(), key.length(), sig.as_cstr(), sig.length(), tag.as_cstr(), tag.length(), digest.as_cstr(), digest.length()) != 0
    },
  }
}

fn host_vault_crypto() -> vault::Crypto {
  vault::Crypto::{
    record_sig_valid: fn(sig : form::Json, tag : String, text : String) -> Bool {
      let sig_s = form::json_stringify(sig)
      rules_record_sig_valid(sig_s.as_cstr(), sig_s.length(), tag.as_cstr(), tag.length(), text.as_cstr(), text.length()) != 0
    },
  }
}

// ── Handle tables for opaque LockState and CarriedHandle ──────────────────────────────────────────────────────────

struct CarriedHandle {
  moved : Option[lock::Moved]
  invalid : String
}

let lock_handles : Array[Option[lock::LockState]] = []
let lock_free_ids : Array[Int] = []
let carried_handles : Array[Option[CarriedHandle]] = []
let carried_free_ids : Array[Int] = []

fn alloc_lock_handle(s : lock::LockState) -> Int {
  match lock_free_ids.pop() {
    Some(id) => {
      lock_handles[id] = Some(s)
      id
    }
    None => {
      let id = lock_handles.length()
      lock_handles.push(Some(s))
      id
    }
  }
}

fn get_lock_handle(id : Int) -> Option[lock::LockState] {
  if id < 0 || id >= lock_handles.length() {
    None
  } else {
    lock_handles[id]
  }
}

pub extern "C" fn free_lock_handle(id : Int) -> Unit {
  if id >= 0 && id < lock_handles.length() {
    match lock_handles[id] {
      Some(_) => {
        lock_handles[id] = None
        lock_free_ids.push(id)
      }
      None => ()
    }
  }
}

pub extern "C" fn lock_handle_table_len() -> Int {
  lock_handles.length()
}

pub extern "C" fn lock_handle_live_count() -> Int {
  lock_handles.length() - lock_free_ids.length()
}

fn alloc_carried_handle(h : CarriedHandle) -> Int {
  match carried_free_ids.pop() {
    Some(id) => {
      carried_handles[id] = Some(h)
      id
    }
    None => {
      let id = carried_handles.length()
      carried_handles.push(Some(h))
      id
    }
  }
}

fn get_carried_handle(id : Int) -> Option[CarriedHandle] {
  if id < 0 || id >= carried_handles.length() {
    None
  } else {
    carried_handles[id]
  }
}

pub extern "C" fn free_carried_handle(id : Int) -> Unit {
  if id >= 0 && id < carried_handles.length() {
    match carried_handles[id] {
      Some(_) => {
        carried_handles[id] = None
        carried_free_ids.push(id)
      }
      None => ()
    }
  }
}

pub extern "C" fn carried_handle_table_len() -> Int {
  carried_handles.length()
}

pub extern "C" fn carried_handle_live_count() -> Int {
  carried_handles.length() - carried_free_ids.length()
}

// ── JSON conversion helpers ───────────────────────────────────────────────────────────────────────────────────────

fn j_str(v : Option[form::Json]) -> String {
  match v {
    Some(form::Json::Str(s)) => s
    _ => ""
  }
}

fn j_opt_str(v : Option[form::Json]) -> Option[String] {
  match v {
    Some(form::Json::Str(s)) => Some(s)
    _ => None
  }
}

fn j_opt_num(v : Option[form::Json]) -> Option[Double] {
  match v {
    Some(form::Json::Num(n)) => Some(n)
    _ => None
  }
}

fn j_num(v : Option[form::Json]) -> Double {
  match v {
    Some(form::Json::Num(n)) => n
    _ => 0.0
  }
}

fn j_bool(v : Option[form::Json]) -> Bool {
  match v {
    Some(form::Json::Bool(b)) => b
    _ => false
  }
}

fn j_arr(v : Option[form::Json]) -> Array[form::Json] {
  match v {
    Some(form::Json::Arr(xs)) => xs
    _ => []
  }
}

fn j_str_arr(v : Option[form::Json]) -> Array[String] {
  let xs = j_arr(v)
  let out : Array[String] = []
  let mut i = 0
  while i < xs.length() {
    match xs[i] {
      form::Json::Str(s) => out.push(s)
      _ => ()
    }
    i = i + 1
  }
  out
}

fn j_chains(v : Option[form::Json]) -> Array[Array[form::Json]] {
  let xs = j_arr(v)
  let out : Array[Array[form::Json]] = []
  let mut i = 0
  while i < xs.length() {
    out.push(j_arr(Some(xs[i])))
    i = i + 1
  }
  out
}

fn opt_str_json(s : Option[String]) -> form::Json {
  match s {
    Some(x) => form::Json::Str(x)
    None => form::Json::Null
  }
}

fn err_json(why : String) -> form::Json {
  form::Json::Obj([("error", form::Json::Str(why))])
}

fn step_name(s : fork::Step) -> String {
  match s {
    fork::Step::Weight => "weight"
    fork::Step::Removal => "removal"
    fork::Step::Tie => "tie"
    fork::Step::Hash => "hash"
  }
}

fn state_json(s : lock::LockState) -> form::Json {
  let j_origins : Array[form::Json] = []
  let mut oi = 0
  while oi < s.origins.length() {
    j_origins.push(form::Json::Str(s.origins[oi]))
    oi = oi + 1
  }
  let j_members : Array[form::Json] = []
  let ms = s.members.entries()
  let mut mi = 0
  while mi < ms.length() {
    let (k, m) = ms[mi]
    j_members.push(form::Json::Arr([
      form::Json::Str(k),
      form::Json::Obj([
        ("sub", form::Json::Str(m.sub)),
        ("email", form::Json::Str(m.email)),
        ("role", form::Json::Str(m.role)),
      ]),
    ]))
    mi = mi + 1
  }
  let j_devices : Array[form::Json] = []
  let ds = s.devices.entries()
  let mut di = 0
  while di < ds.length() {
    let (k, d) = ds[di]
    let dm : Array[(String, form::Json)] = [
      ("id", form::Json::Str(d.id)),
      ("sub", form::Json::Str(d.sub)),
      ("kind", form::Json::Str(d.kind)),
      ("label", form::Json::Str(d.label)),
      ("own", form::Json::Bool(d.own)),
    ]
    match d.sign_key {
      Some(sk) => dm.push(("sign_key", form::Json::Str(sk)))
      None => ()
    }
    match d.endpoints {
      Some(es) => {
        let jes : Array[form::Json] = []
        let mut ei = 0
        while ei < es.length() {
          jes.push(form::Json::Str(es[ei]))
          ei = ei + 1
        }
        dm.push(("endpoints", form::Json::Arr(jes)))
      }
      None => ()
    }
    match d.exp {
      Some(x) => dm.push(("exp", form::Json::Num(x)))
      None => ()
    }
    match d.by {
      Some(b) => dm.push(("by", form::Json::Str(b)))
      None => ()
    }
    j_devices.push(form::Json::Arr([form::Json::Str(k), form::Json::Obj(dm)]))
    di = di + 1
  }
  let j_sign_keys : Array[form::Json] = []
  let sks = s.sign_keys.entries()
  let mut ski = 0
  while ski < sks.length() {
    let (k, xs) = sks[ski]
    let jxs : Array[form::Json] = []
    let mut xi = 0
    while xi < xs.length() {
      jxs.push(form::Json::Str(xs[xi]))
      xi = xi + 1
    }
    j_sign_keys.push(form::Json::Arr([form::Json::Str(k), form::Json::Arr(jxs)]))
    ski = ski + 1
  }
  let j_passkeys : Array[form::Json] = []
  let pks = s.passkeys.entries()
  let mut pi = 0
  while pi < pks.length() {
    let (k, p) = pks[pi]
    j_passkeys.push(form::Json::Arr([
      form::Json::Str(k),
      form::Json::Obj([
        ("id", form::Json::Str(p.id)),
        ("sub", form::Json::Str(p.sub)),
        ("key", form::Json::Str(p.key)),
        ("label", form::Json::Str(p.label)),
        ("own", form::Json::Bool(p.own)),
      ]),
    ]))
    pi = pi + 1
  }
  let j_signed : Array[form::Json] = []
  let sgn = s.signed.keys()
  let mut sgi = 0
  while sgi < sgn.length() {
    j_signed.push(form::Json::Str(sgn[sgi]))
    sgi = sgi + 1
  }
  let j_stations : Array[form::Json] = []
  let sts = s.stations.entries()
  let mut sti = 0
  while sti < sts.length() {
    let (k, st) = sts[sti]
    j_stations.push(form::Json::Arr([
      form::Json::Str(k),
      form::Json::Obj([("key", form::Json::Str(st.key)), ("name", form::Json::Str(st.name))]),
    ]))
    sti = sti + 1
  }
  let j_gateways : Array[form::Json] = []
  let gws = s.gateways.keys()
  let mut gi = 0
  while gi < gws.length() {
    j_gateways.push(form::Json::Str(gws[gi]))
    gi = gi + 1
  }
  let j_persons : Array[form::Json] = []
  let ps = s.persons.entries()
  let mut psi = 0
  while psi < ps.length() {
    j_persons.push(form::Json::Arr([form::Json::Str(ps[psi].0), form::Json::Str(ps[psi].1)]))
    psi = psi + 1
  }
  let out : Array[(String, form::Json)] = [
    ("ws", form::Json::Str(s.ws)),
    ("seq", form::Json::Num(s.seq)),
    ("head", form::Json::Str(s.head)),
    ("genesis", form::Json::Str(s.genesis)),
    ("origins", form::Json::Arr(j_origins)),
    ("rp_id", form::Json::Str(s.rp_id)),
    ("cloud_keys", s.cloud_keys),
    ("members", form::Json::Arr(j_members)),
    ("devices", form::Json::Arr(j_devices)),
    ("signKeys", form::Json::Arr(j_sign_keys)),
    ("passkeys", form::Json::Arr(j_passkeys)),
    ("signed", form::Json::Arr(j_signed)),
    ("stations", form::Json::Arr(j_stations)),
    ("gateways", form::Json::Arr(j_gateways)),
    ("persons", form::Json::Arr(j_persons)),
    ("disabled", form::Json::Bool(s.disabled)),
  ]
  match s.moved {
    Some(root) => out.push(("moved", form::Json::Str(root)))
    None => ()
  }
  form::Json::Obj(out)
}

fn person_json(p : lock::Person) -> form::Json {
  let j_devs : Array[form::Json] = []
  let ds = p.devices.values()
  let mut di = 0
  while di < ds.length() {
    let d = ds[di]
    let sks : Array[form::Json] = []
    let mut si = 0
    while si < d.sign_keys.length() {
      sks.push(form::Json::Str(d.sign_keys[si]))
      si = si + 1
    }
    let dm : Array[(String, form::Json)] = [
      ("key", form::Json::Str(d.key)),
      ("id", form::Json::Str(d.id)),
      ("label", form::Json::Str(d.label)),
      ("sign_keys", form::Json::Arr(sks)),
    ]
    match d.sign_key {
      Some(k) => dm.push(("sign_key", form::Json::Str(k)))
      None => ()
    }
    j_devs.push(form::Json::Obj(dm))
    di = di + 1
  }
  let j_webs : Array[form::Json] = []
  let ws = p.webs.values()
  let mut wi = 0
  while wi < ws.length() {
    let w = ws[wi]
    j_webs.push(form::Json::Obj([
      ("id", form::Json::Str(w.id)),
      ("label", form::Json::Str(w.label)),
      ("at", form::Json::Num(w.at)),
      ("exp", form::Json::Num(w.exp)),
    ]))
    wi = wi + 1
  }
  form::Json::Obj([
    ("sub", form::Json::Str(p.sub)),
    ("genesis", form::Json::Str(p.genesis)),
    ("head", form::Json::Str(p.head)),
    ("seq", form::Json::Num(p.seq)),
    ("devices", form::Json::Arr(j_devs)),
    ("webs", form::Json::Arr(j_webs)),
  ])
}

fn chain_json(ch : lock::Chain) -> form::Json {
  let j_at : Array[form::Json] = []
  let mut ai = 0
  while ai < ch.at.length() {
    j_at.push(form::Json::Num(ch.at[ai].to_double()))
    ai = ai + 1
  }
  let j_hashes : Array[form::Json] = []
  let mut hi = 0
  while hi < ch.hashes.length() {
    j_hashes.push(form::Json::Str(ch.hashes[hi]))
    hi = hi + 1
  }
  let j_off : Array[form::Json] = []
  let mut oi = 0
  while oi < ch.off.length() {
    let (idx, o) = ch.off[oi]
    let m : Array[(String, form::Json)] = [("at", form::Json::Num(idx.to_double()))]
    match o {
      lock::Off::NotValid(why) => {
        m.push(("why", form::Json::Str("refused")))
        m.push(("refusal", form::Json::Str(why)))
      }
      lock::Off::NoParent => m.push(("why", form::Json::Str("no parent")))
      lock::Off::Beaten(winner, step) => {
        m.push(("why", form::Json::Str("beaten")))
        m.push(("winner", form::Json::Str(winner)))
        m.push(("step", form::Json::Str(step_name(step))))
      }
      lock::Off::Below(top) => {
        m.push(("why", form::Json::Str("below")))
        m.push(("under", form::Json::Str(top)))
      }
      lock::Off::Again => m.push(("why", form::Json::Str("again")))
    }
    j_off.push(form::Json::Obj(m))
    oi = oi + 1
  }
  form::Json::Obj([
    ("at", form::Json::Arr(j_at)),
    ("hashes", form::Json::Arr(j_hashes)),
    ("off", form::Json::Arr(j_off)),
  ])
}

fn roster_json(r : lock::Roster) -> form::Json {
  let j_members : Array[form::Json] = []
  let mut mi = 0
  while mi < r.members.length() {
    let m = r.members[mi]
    let j_keys = match m.keys {
      Some(ks) => {
        let out : Array[form::Json] = []
        let mut ki = 0
        while ki < ks.length() {
          out.push(form::Json::Str(ks[ki]))
          ki = ki + 1
        }
        form::Json::Arr(out)
      }
      None => form::Json::Null
    }
    j_members.push(form::Json::Obj([
      ("sub", form::Json::Str(m.sub)),
      ("role", form::Json::Str(m.role)),
      ("lock", form::Json::Str(m.lock)),
      ("admit", opt_str_json(m.admit)),
      ("keys", j_keys),
    ]))
    mi = mi + 1
  }
  let j_stations : Array[form::Json] = []
  let mut si = 0
  while si < r.stations.length() {
    j_stations.push(form::Json::Str(r.stations[si]))
    si = si + 1
  }
  let j_pairs : Array[form::Json] = []
  let mut pi = 0
  while pi < r.pairs.length() {
    let p = r.pairs[pi]
    j_pairs.push(form::Json::Obj([
      ("sub", form::Json::Str(p.0)),
      ("lock", form::Json::Str(p.1)),
      ("role", form::Json::Str(p.2)),
    ]))
    pi = pi + 1
  }
  let j_undec : Array[form::Json] = []
  let mut ui = 0
  while ui < r.undecided.length() {
    let u = r.undecided[ui]
    j_undec.push(form::Json::Obj([("sub", form::Json::Str(u.0)), ("lock", form::Json::Str(u.1))]))
    ui = ui + 1
  }
  let j_canc : Array[form::Json] = []
  let mut ci = 0
  while ci < r.cancelled.length() {
    j_canc.push(form::Json::Str(r.cancelled[ci]))
    ci = ci + 1
  }
  let j_stmts : Array[form::Json] = []
  let mut sti = 0
  while sti < r.statements.length() {
    let x = r.statements[sti]
    j_stmts.push(form::Json::Obj([
      ("hash", form::Json::Str(x.hash)),
      ("kind", form::Json::Str(x.kind)),
      ("log", form::Json::Str(x.log)),
      ("by", form::Json::Str(x.by)),
      ("label", form::Json::Str(x.label)),
      ("why", opt_str_json(x.why)),
      ("decided", opt_str_json(x.decided)),
    ]))
    sti = sti + 1
  }
  let j_labels : Array[form::Json] = []
  let mut li = 0
  while li < r.labels.length() {
    let l = r.labels[li]
    j_labels.push(form::Json::Arr([form::Json::Str(l.0), form::Json::Str(l.1)]))
    li = li + 1
  }
  let j_refused : Array[form::Json] = []
  let mut ri = 0
  while ri < r.refused.length() {
    let x = r.refused[ri]
    j_refused.push(form::Json::Obj([("genesis", form::Json::Str(x.0)), ("why", form::Json::Str(x.1))]))
    ri = ri + 1
  }
  let j_inf : Array[form::Json] = []
  let mut fi = 0
  while fi < r.in_force.length() {
    let x = r.in_force[fi]
    j_inf.push(form::Json::Obj([("entry", form::Json::Str(x.0)), ("body", form::Json::Str(x.1))]))
    fi = fi + 1
  }
  let j_lack : Array[form::Json] = []
  let mut ki2 = 0
  while ki2 < r.lacking.length() {
    j_lack.push(form::Json::Str(r.lacking[ki2]))
    ki2 = ki2 + 1
  }
  let j_ck : Array[form::Json] = []
  let mut cki = 0
  while cki < r.carried_keys.length() {
    let x = r.carried_keys[cki]
    j_ck.push(form::Json::Obj([("key", form::Json::Str(x.0)), ("sub", form::Json::Str(x.1))]))
    cki = cki + 1
  }
  let j_settings = match r.settings {
    Some(s) => s
    None => form::Json::Null
  }
  form::Json::Obj([
    ("rooted", form::Json::Bool(r.rooted)),
    ("members", form::Json::Arr(j_members)),
    ("stations", form::Json::Arr(j_stations)),
    ("pairs", form::Json::Arr(j_pairs)),
    ("undecided", form::Json::Arr(j_undec)),
    ("cancelled", form::Json::Arr(j_canc)),
    ("statements", form::Json::Arr(j_stmts)),
    ("labels", form::Json::Arr(j_labels)),
    ("refused", form::Json::Arr(j_refused)),
    ("in_force", form::Json::Arr(j_inf)),
    ("lacking", form::Json::Arr(j_lack)),
    ("newest", opt_str_json(r.newest)),
    ("settings", j_settings),
    ("carried_keys", form::Json::Arr(j_ck)),
  ])
}

fn parse_lock_view(v : Option[form::Json]) -> vault::LockView {
  let ws = j_str(form::json_field(v, "ws"))
  let members : form::OrderedMap[Bool] = form::OrderedMap::new()
  let roles : form::OrderedMap[String] = form::OrderedMap::new()
  let ms = j_arr(form::json_field(v, "members"))
  let mut mi = 0
  while mi < ms.length() {
    let pair = j_arr(Some(ms[mi]))
    if pair.length() >= 2 {
      let sub = j_str(Some(pair[0]))
      let r = j_str(Some(pair[1]))
      members.set(sub, true)
      roles.set(sub, r)
    }
    mi = mi + 1
  }
  let devices : form::OrderedMap[vault::Device] = form::OrderedMap::new()
  let ds = j_arr(form::json_field(v, "devices"))
  let mut di = 0
  while di < ds.length() {
    let pair = j_arr(Some(ds[di]))
    if pair.length() >= 2 {
      let id = j_str(Some(pair[0]))
      let d = Some(pair[1])
      devices.set(id, vault::Device::{
        sub: j_str(form::json_field(d, "sub")),
        kind: j_str(form::json_field(d, "kind")),
        sign_key: j_opt_str(form::json_field(d, "sign_key")),
        own: j_bool(form::json_field(d, "own")),
      })
    }
    di = di + 1
  }
  let sign_keys : form::OrderedMap[Array[String]] = form::OrderedMap::new()
  let sks = j_arr(form::json_field(v, "signKeys"))
  let mut si = 0
  while si < sks.length() {
    let pair = j_arr(Some(sks[si]))
    if pair.length() >= 2 {
      sign_keys.set(j_str(Some(pair[0])), j_str_arr(Some(pair[1])))
    }
    si = si + 1
  }
  vault::LockView::{ ws: ws, members: members, roles: roles, devices: devices, sign_keys: sign_keys }
}

fn parse_in_json() -> Result[form::Json, String] {
  form::parse_json(read_in_str())
}

// ── Exported wasm32 functions ─────────────────────────────────────────────────────────────────────────────────────

pub extern "C" fn wasm_canonical_of() -> Int {
  let j = match parse_in_json() {
    Ok(v) => v
    Err(e) => return write_out_str("!" + e)
  }
  match form::canonical(j) {
    Ok(s) => write_out_str(s)
    Err(why) => write_out_str("!" + why)
  }
}

