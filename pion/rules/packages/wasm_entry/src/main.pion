      ]))
    }
  }
}

pub extern "C" fn wasm_admit() -> Int {
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(e) => return write_out_json(err_json(e))
  }
  let entries = j_arr(form::json_field(j, "entries"))
  let fold_now = j_opt_num(form::json_field(j, "fold_now"))
  let queries = j_arr(form::json_field(j, "queries"))
  let c = host_lock_crypto()
  let s = match lock::fold(entries, fold_now, c) {
    Ok(st) => st
    Err(e) => return write_out_json(err_json(lock::error_msg(e)))
  }
  let out : Array[form::Json] = []
  let mut i = 0
  while i < queries.length() {
    let q = Some(queries[i])
    let ans = match lock::admit(s, j_str(form::json_field(q, "sub")), j_str(form::json_field(q, "endpoint")), j_opt_str(form::json_field(q, "base")), j_opt_str(form::json_field(q, "proof")), j_num(form::json_field(q, "now")), c) {
      Ok((d, r)) => form::Json::Obj([("device", form::Json::Str(d.id)), ("role", form::Json::Str(r))])
      Err(e) => form::Json::Obj([("refusal", form::Json::Str(lock::error_msg(e)))])
    }
    out.push(ans)
    i = i + 1
  }
  write_out_json(form::Json::Arr(out))
}

