fn supersedes_impl(a : form::Json, b : form::Json, number_field : String) -> Bool {
  let get_n = fn(v : form::Json, k : String) -> Int64 {
    match form::json_field(Some(v), k) {
      Some(form::Json::Num(x)) => x.to_int64()
      _ => 0.to_int64()
    }
  }
  let is_del = fn(v : form::Json) -> Bool {
    match form::json_field(Some(v), "deleted") {
      Some(form::Json::Bool(true)) => true
      _ => false
    }
  }
  let ca = match form::canonical(a) {
    Ok(s) => s
    Err(_) => return false
  }
  let cb = match form::canonical(b) {
    Ok(s) => s
    Err(_) => return false
  }
  let cmp = form::mbt_str_cmp(ca, cb)
  history::supersedes(get_n(a, number_field), is_del(a), get_n(a, "epoch"), get_n(b, number_field), is_del(b), get_n(b, "epoch"), cmp)
}

pub extern "C" fn wasm_vault_supersedes() -> Int {
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(_) => return 0
  }
  let a = match form::json_field(j, "a") {
    Some(x) => x
    None => return 0
  }
  let b = match form::json_field(j, "b") {
    Some(x) => x
    None => return 0
  }
  if supersedes_impl(a, b, "seq") { 1 } else { 0 }
}

