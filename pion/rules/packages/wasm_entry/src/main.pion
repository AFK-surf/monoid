  }
  match j_opt_str(form::json_field(j, "invalid")) {
    Some(why) => return alloc_carried_handle(CarriedHandle::{ moved: None, invalid: why })
    None => ()
  }
  let chain = j_arr(form::json_field(j, "chain"))
  let m = lock::moved_of(chain, host_lock_crypto())
  alloc_carried_handle(CarriedHandle::{ moved: Some(m), invalid: "" })
}

