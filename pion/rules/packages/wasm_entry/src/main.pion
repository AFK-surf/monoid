pub extern "C" fn wasm_apply(prev_h : Int) -> Int {
  let prev = match get_lock_handle(prev_h) {
    Some(s) => s
    None => return write_out_json(err_json("invalid lock handle"))
  }
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(e) => return write_out_json(err_json(e))
  }
  let entry = match form::json_field(j, "entry") {
    Some(x) => x
    None => form::Json::Null
  }
  let now = j_opt_num(form::json_field(j, "now"))
  match lock::apply(prev, entry, now, host_lock_crypto()) {
    Ok(s) => {
      let h = alloc_lock_handle(s)
      write_out_json(form::Json::Obj([("state", state_json(s)), ("handle", form::Json::Num(h.to_double()))]))
    }
    Err(e) => write_out_json(err_json(lock::error_msg(e)))
  }
}

