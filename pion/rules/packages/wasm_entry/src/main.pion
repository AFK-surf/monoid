    Ok(s) => write_out_str(s)
    Err(why) => write_out_str("!" + why)
  }
}

fn role_of_str(s : String) -> role::Role {
  if s == "owner" {
    role::Role::Owner
  } else if s == "admin" {
    role::Role::Admin
  } else if s == "member" {
    role::Role::Member
  } else {
    role::Role::Viewer
  }
}

fn role_to_str(r : role::Role) -> String {
  match r {
    role::Role::Owner => "owner"
    role::Role::Admin => "admin"
    role::Role::Member => "member"
    role::Role::Viewer => "viewer"
  }
}

pub extern "C" fn wasm_lower_role() -> Int {
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(_) => None
  }
  let a = j_str(form::json_field(j, "a"))
  let b = j_str(form::json_field(j, "b"))
  write_out_str(role_to_str(role::lower(role_of_str(a), role_of_str(b))))
}

