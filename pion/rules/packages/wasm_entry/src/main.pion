  let m = match h.moved {
    Some(mv) => mv
    None => return write_out_json(err_json(h.invalid))
  }
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(e) => return write_out_json(err_json(e))
  }
  let ws = j_str(form::json_field(j, "ws"))
  let chains = j_chains(form::json_field(j, "chains"))
  let bodies = j_arr(form::json_field(j, "bodies"))
  let now = j_num(form::json_field(j, "now"))
  let st = lock::state4_carried(ws, m, chains, bodies, now, host_lock_crypto())
  let lh = alloc_lock_handle(st.lock)
  write_out_json(form::Json::Obj([
    ("on", form::Json::Str(st.on)),
    ("state", state_json(st.lock)),
    ("handle", form::Json::Num(lh.to_double())),
    ("root_in", form::Json::Bool(st.root_in)),
  ]))
}

pub extern "C" fn wasm_state4_moved() -> Int {
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(e) => return write_out_json(err_json(e))
  }
  let ws = j_str(form::json_field(j, "ws"))
  let chain = j_arr(form::json_field(j, "chain"))
  let chains = j_chains(form::json_field(j, "chains"))
  let bodies = j_arr(form::json_field(j, "bodies"))
  let now = j_num(form::json_field(j, "now"))
  let st = lock::state4_moved(ws, chain, chains, bodies, now, host_lock_crypto())
  let lh = alloc_lock_handle(st.lock)
  write_out_json(form::Json::Obj([
    ("on", form::Json::Str(st.on)),
    ("state", state_json(st.lock)),
    ("handle", form::Json::Num(lh.to_double())),
    ("root_in", form::Json::Bool(st.root_in)),
  ]))
}

pub extern "C" fn wasm_bind_digest() -> Int {
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(_) => return write_out_json(form::Json::Null)
  }
  let ws = j_str(form::json_field(j, "ws"))
  let sub = j_str(form::json_field(j, "sub"))
  let log = j_str(form::json_field(j, "log"))
  let moved = j_str(form::json_field(j, "moved"))
  let dig = lock::bind_digest(ws, sub, log, moved, host_lock_crypto())
  write_out_json(form::Json::Obj([("tag", form::Json::Str(lock::bind_tag)), ("digest", form::Json::Str(dig))]))
}

pub extern "C" fn wasm_ws_tag() -> Int {
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(_) => return write_out_str("")
  }
  let ws = j_str(form::json_field(j, "ws"))
  let genesis = j_str(form::json_field(j, "genesis"))
  write_out_str(lock::ws_tag(ws, genesis, host_lock_crypto()))
}

pub extern "C" fn wasm_body_hash() -> Int {
  let j = match parse_in_json() {
    Ok(v) => v
    Err(e) => return write_out_str("!" + e)
  }
  match lock::body_hash(j, host_lock_crypto()) {
    Ok(h) => write_out_str(h)
    Err(e) => write_out_str("!" + lock::error_msg(e))
  }
}

pub extern "C" fn wasm_body_refusal() -> Int {
  let j = match parse_in_json() {
    Ok(v) => Some(v)
    Err(e) => return write_out_json(form::Json::Str("a body is {ws, kind, …, salt}: " + e))
  }
  let ws = j_str(form::json_field(j, "ws"))
  let body = match form::json_field(j, "body") {
    Some(b) => b
    None => form::Json::Null
  }
  let raw_commits = j_arr(form::json_field(j, "commits"))
  let commits : Array[lock::Commit] = []
  let mut i = 0
  while i < raw_commits.length() {
    let x = Some(raw_commits[i])
    commits.push(lock::Commit::{
      genesis: j_str(form::json_field(x, "genesis")),
      chain: j_arr(form::json_field(x, "chain")),
    })
    i = i + 1
  }
  write_out_json(opt_str_json(lock::body_refusal(ws, body, commits, host_lock_crypto())))
}

fn main() -> Unit {
  ()
}
