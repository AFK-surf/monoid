// Root entry for the real `still.fail` client UI on Invar (`sf_app_root`).
// Combines `<lg::SplitShell>` (Chats List sidebar + `<lg::PageShell>` chat pane)
// with real `SettingsSheet` and `SearchSheet`, driven 100% by `app_state::AppController`.

import "app_state"
import "lg"
import "ui"
import "view"

/// Mount the full `still.fail` client application root onto `root`,
/// bound directly to `ctrl` (`ClientCore` + `packages/views` signals).
pub fn sf_app_root(root : view::View, ctrl : app_state::AppController) -> Unit {
  ctrl.mount()
  lg::set_dark(Some(ctrl.dark_sig.untracked()))
  root.reacts(fn() { ctrl.dark_sig.get() }, fn(d : Bool) -> Unit {
    lg::set_dark(Some(d))
  })
  let composer_field = ui::Field::new()

  let _ = root.fill().ground(view::Live::By(fn() { lg::surface().canvas }))

  let _ = <lg::SplitShell
    in={root}
    sidebar_width={296.0}
    breakpoint={760.0}
    show_detail_by=>{ctrl.show_detail_sig.get()}
    sidebar={fn(sb : view::View) -> Unit { render_sidebar(sb, ctrl) }}
    detail={fn(dt : view::View) -> Unit { render_chat_pane(dt, ctrl, composer_field) }}
  />

  render_settings_sheet(root, ctrl)
  render_search_sheet(root, ctrl)
}
