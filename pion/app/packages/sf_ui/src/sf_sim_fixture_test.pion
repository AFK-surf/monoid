  sim_db.stations_docs.push((st2, "overview", base_codec::json_stringify(st2_overview)))
  sim_db.stations_docs.push((st1, "usage", base_codec::json_stringify(usage_doc)))

  // 2. Seed day-grouped real chats across Today & Yesterday
  let c1_json = base_codec::json_stringify(base_codec::json_obj([
    ("id", base_codec::json_str("c-invar")),
    ("session", base_codec::json_str("c-invar")),
    ("thread", base_codec::json_int(101)),
