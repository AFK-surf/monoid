  ])))

  // Agent message with interactive decision card (recommended option auto-sorted last)
  sim_db.put_entry(st1, 101, 6, base_codec::json_stringify(base_codec::json_obj([
    ("kind", base_codec::json_str("message")),
    ("authorKind", base_codec::json_str("agent")),
    ("author", base_codec::json_str("Builder")),
    ("authorName", base_codec::json_str("Antigravity")),
    ("authorModel", base_codec::json_str("gemini-4-neon")),
    ("text", base_codec::json_str("全量 `lg::assert_apple_ui` 与 4 档 FPS 确定性测试已通过，请选择下一步：")),
    ("card", base_codec::json_obj([
      ("type", base_codec::json_str("options")),
      ("assignee", base_codec::json_str("alice@afk.surf")),
      ("options", base_codec::json_arr([
        base_codec::json_obj([
          ("label", base_codec::json_str("先保留过渡适配层")),
