// Deterministic in-memory SQLite + SimStation + signed Ed25519 lock-chain fixture
// for `sf_ui` tests and native Apple Metal offscreen rendering.
// Feeds 100% real `pion/client-core` (`ClientCore` + `packages/views`) projections.

import "app_state"
import "base_codec"
import "effect"
import "form"
import "lock"
import "shell"
import "sql"
import "store"
import "sync"
import "views"

struct SfChatRow {
  station : String
  archived : Int
  id : String
  ord : Double
  thread : Option[Int]
  session : Option[String]
  pinned_at : Option[Int64]
  last_active : Int64
  mine : Int
  hidden : Int
  led : Int
  watched : Int
  json : String
}

struct SfThreadRow {
  id : Int
  last : Option[Int]
  read : Option[Int]
  unread : Option[Int]
  sort_at : Int64
  created_at : Int64
  surface : Option[String]
  first_member : Option[String]
  json : String
}

struct SfSimDb {
  sh : shell::Shell
  chats : Array[SfChatRow]
  threads : Map[String, SfThreadRow]
  entries : Map[String, Array[(Int, String)]]
  outbox_rows : Map[String, String]
  pending_rows : Map[String, String]
  changing_rows : Array[(String, Int, String)]
  stations_docs : Array[(String, String, String)]
  account_docs : Map[String, String]
  md : Map[String, (Int64, String)]
  log_use : Map[String, Int64]
  ran : Array[String]
}

fn SfSimDb::new(rt : effect::Runtime) -> SfSimDb {
  let holder : Array[SfSimDb] = []
  let sh = shell::Shell::stood_in(
    rt,
    fn(_ : Int64, _ : String, _ : base_codec::Json, _ : Option[Bytes]) -> Unit {},
    fn(op : String, args : base_codec::Json) -> shell::AskResult {
      holder[0].answer(op, args)
    },
    fn(n : Int) -> Bytes { Bytes::new(n) },
  )
  let db = SfSimDb::{
    sh: sh,
    chats: [],
    threads: Map::new(),
    entries: Map::new(),
    outbox_rows: Map::new(),
    pending_rows: Map::new(),
    changing_rows: [],
    stations_docs: [],
    account_docs: Map::new(),
    md: Map::new(),
    log_use: Map::new(),
    ran: [],
  }
  holder.push(db)
  db
}

fn sf_p_str(p : Array[base_codec::Json], i : Int) -> String {
  if i < 0 || i >= p.length() { "" } else { sql::col_text(p, i) }
}

fn sf_p_i64(p : Array[base_codec::Json], i : Int) -> Int64 {
  if i < 0 || i >= p.length() { 0.to_int64() } else { sql::col_int64(p, i) }
}

fn sf_p_int(p : Array[base_codec::Json], i : Int) -> Int {
  sf_p_i64(p, i).to_int()
}

fn sf_p_opt_i64(p : Array[base_codec::Json], i : Int) -> Option[Int64] {
  if i < 0 || i >= p.length() { None } else { sql::col_opt_int64(p, i) }
}

fn sf_p_opt_int(p : Array[base_codec::Json], i : Int) -> Option[Int] {
  match sf_p_opt_i64(p, i) {
    Some(v) => Some(v.to_int())
    None => None
  }
}

fn sf_p_opt_str(p : Array[base_codec::Json], i : Int) -> Option[String] {
  if i < 0 || i >= p.length() { None } else { sql::col_opt_text(p, i) }
}

fn sf_station_pos(in_ord : String, st : String) -> Int {
  let sb = StringBuilder::new()
  sb.write_byte(1 as Byte)
  sb.write_string(st)
  sb.write_byte(1 as Byte)
  let idx = in_ord.index_of(sb.to_string())
  if idx < 0 { 0 } else { idx + 1 }
}

fn sf_chat_before(a : SfChatRow, b : SfChatRow, in_ord : String) -> Bool {
  let ap = match a.pinned_at { Some(v) => v; None => -1.to_int64() }
  let bp = match b.pinned_at { Some(v) => v; None => -1.to_int64() }
  if ap != bp { return ap > bp }
  if a.last_active != b.last_active { return a.last_active > b.last_active }
  let apos = sf_station_pos(in_ord, a.station)
  let bpos = sf_station_pos(in_ord, b.station)
  if apos != bpos { return apos < bpos }
  if a.ord != b.ord { return a.ord < b.ord }
  a.id < b.id
}

fn SfSimDb::put_entry(self : SfSimDb, station : String, thread : Int, n : Int, raw : String) -> Unit {
  let k = station + " " + thread.to_string()
  let arr = match self.entries.get(k) {
    Some(a) => a
    None => {
      let a : Array[(Int, String)] = []
      self.entries.set(k, a)
      a
    }
  }
  let mut replaced = false
  for i in 0..<arr.length() {
    if arr[i].0 == n {
      arr[i] = (n, raw)
      replaced = true
      break
    }
  }
  if !replaced {
    arr.push((n, raw))
  }
}

fn SfSimDb::put_chat(self : SfSimDb, row : SfChatRow) -> Unit {
  for i in 0..<self.chats.length() {
    let c = self.chats[i]
    if c.station == row.station && c.archived == row.archived && c.id == row.id {
      self.chats[i] = row
      return
    }
  }
  self.chats.push(row)
}

fn SfSimDb::answer(self : SfSimDb, op : String, args : base_codec::Json) -> shell::AskResult {
  if op == "sql.open" {
    return shell::AskResult::Ok(base_codec::json_obj([("id", base_codec::json_int(1))]))
  }
  if op == "sql.close" || op == "sql.exec" {
    return shell::AskResult::Ok(base_codec::json_null())
  }
  let stmt = match base_codec::json_get(args, "sql") {
    Some(base_codec::Json::Str(s)) => s
    _ => return shell::AskResult::Err(shell::ShellError::{ message: "missing sql" })
  }
  let p = match base_codec::json_get(args, "params") {
    Some(base_codec::Json::Arr(a)) => a
    _ => []
  }
  self.ran.push(stmt)
  let rows : Array[base_codec::Json] = []
  let mut changed = 0

  if stmt == store::sql_chat_window() {
    let in_ord = sf_p_str(p, 0)
    let mine = sf_p_int(p, 1)
    let hidden = sf_p_int(p, 2)
    let watching = sf_p_int(p, 3)
    let limit = sf_p_int(p, 6)
    let matched : Array[SfChatRow] = []
    for i in 0..<self.chats.length() {
      let c = self.chats[i]
      if c.archived != 0 { continue }
      if sf_station_pos(in_ord, c.station) == 0 { continue }
      if mine != 0 && c.mine != 1 { continue }
      if hidden != 2 && c.hidden != hidden { continue }
      if c.led != 0 { continue }
      if watching != 0 && c.watched != 1 { continue }
      matched.push(c)
    }
    for i in 1..<matched.length() {
      let cur = matched[i]
      let mut j = i - 1
      while j >= 0 && sf_chat_before(cur, matched[j], in_ord) {
        matched[j + 1] = matched[j]
        j -= 1
      }
      matched[j + 1] = cur
    }
    let take_n = if limit > 0 && limit < matched.length() { limit } else { matched.length() }
    for i in 0..<take_n {
      let c = matched[i]
      let pj = match c.pinned_at { Some(v) => base_codec::json_int64(v); None => base_codec::json_null() }
      rows.push(base_codec::json_arr([
        base_codec::json_str(c.station),
        base_codec::json_int(c.archived),
        base_codec::json_str(c.id),
        pj,
        base_codec::json_int64(c.last_active),
        base_codec::json_num(c.ord),
      ]))
    }
  } else if stmt == store::sql_chat_by_key() {
    let st = sf_p_str(p, 0)
    let arch = sf_p_int(p, 1)
    let cid = sf_p_str(p, 2)
    for i in 0..<self.chats.length() {
      let c = self.chats[i]
      if c.station == st && c.archived == arch && c.id == cid {
        rows.push(base_codec::json_arr([
          base_codec::json_str(c.station),
          base_codec::json_int(c.archived),
          base_codec::json_str(c.id),
          base_codec::json_str(c.json),
        ]))
        break
      }
    }
  } else if stmt == store::sql_chat_by_thread() {
    let st = sf_p_str(p, 0)
    let th = sf_p_int(p, 1)
    for i in 0..<self.chats.length() {
      let c = self.chats[i]
      match c.thread {
        Some(t) =>
        if c.station == st && t == th {
          rows.push(base_codec::json_arr([
            base_codec::json_str(c.station),
            base_codec::json_int(c.archived),
            base_codec::json_str(c.id),
            base_codec::json_str(c.json),
          ]))
          break
        }
        None => ()
      }
    }
  } else if stmt == store::sql_moved_from() || stmt == store::sql_pending_by_station() || stmt == store::sql_draft_by_station() {
    // Empty lists for these optional overlay tables
    ()
  } else if stmt == store::sql_changing_by_station() {
    let st = sf_p_str(p, 0)
    for i in 0..<self.changing_rows.length() {
      let (cst, cid, cjson) = self.changing_rows[i]
      if cst == st {
        rows.push(base_codec::json_arr([
          base_codec::json_str(cst),
          base_codec::json_int(cid),
          base_codec::json_str(cjson),
        ]))
      }
    }
  } else if stmt == store::sql_thread_one() {
    let k = sf_p_str(p, 0) + ":" + sf_p_int(p, 1).to_string()
    match self.threads.get(k) {
      Some(t) =>
      rows.push(base_codec::json_arr([
        base_codec::json_int(t.id),
        match t.last { Some(v) => base_codec::json_int(v); None => base_codec::json_null() },
        match t.read { Some(v) => base_codec::json_int(v); None => base_codec::json_null() },
        match t.unread { Some(v) => base_codec::json_int(v); None => base_codec::json_null() },
        base_codec::json_int64(t.sort_at),
        base_codec::json_int64(t.created_at),
        match t.surface { Some(v) => base_codec::json_str(v); None => base_codec::json_null() },
        match t.first_member { Some(v) => base_codec::json_str(v); None => base_codec::json_null() },
        base_codec::json_str(t.json),
      ]))
      None => ()
    }
  } else if stmt == store::sql_entry_exists_before() {
    let k = sf_p_str(p, 0) + " " + sf_p_int(p, 1).to_string()
    let before_n = sf_p_int(p, 2)
    match self.entries.get(k) {
      Some(all) => {
        for i in 0..<all.length() {
          if all[i].0 < before_n {
            rows.push(base_codec::json_arr([base_codec::json_int(1)]))
            break
          }
        }
      }
      None => ()
    }
  } else if stmt == store::sql_window_end() {
    let k = sf_p_str(p, 0) + " " + sf_p_str(p, 1)
    let most = sf_p_int(p, 2)
    match self.entries.get(k) {
      Some(all) => {
        let mut i = all.length() - 1
        while i >= 0 && rows.length() < most {
          let (en, ej) = all[i]
          rows.push(base_codec::json_arr([base_codec::json_int(en), base_codec::json_str(ej)]))
          i -= 1
        }
      }
      None => ()
    }
  } else if stmt.starts_with(store::sql_md_many_head()) {
    let st = sf_p_str(p, 0)
    for i in 1..<p.length() {
      let key = sf_p_str(p, i)
      match self.md.get(st + " " + key) {
        Some((used, j)) =>
        rows.push(base_codec::json_arr([
          base_codec::json_str(key),
          base_codec::json_int64(used),
          base_codec::json_str(j),
        ]))
        None => ()
      }
    }
  } else if stmt == store::sql_opened() {
    match self.log_use.get(sf_p_str(p, 0) + " " + sf_p_str(p, 1) + " " + sf_p_str(p, 2)) {
      Some(at) => rows.push(base_codec::json_arr([base_codec::json_int64(at)]))
      None => ()
    }
  } else if stmt == store::sql_note_opened() {
    self.log_use.set(sf_p_str(p, 0) + " " + sf_p_str(p, 1) + " " + sf_p_str(p, 2), sf_p_i64(p, 3))
    changed = 1
  } else if stmt == store::sql_outbox_one() {
    let st = sf_p_str(p, 0)
    let th = sf_p_int(p, 1)
    match self.outbox_rows.get(st + ":" + th.to_string()) {
      Some(j) =>
      rows.push(base_codec::json_arr([
        base_codec::json_str(st),
        base_codec::json_int(th),
        base_codec::json_str(j),
      ]))
      None => ()
    }
  } else if stmt == store::sql_station_doc_by_kind() {
    let kind = sf_p_str(p, 0)
    for i in 0..<self.stations_docs.length() {
      let (addr, k, j) = self.stations_docs[i]
      if k == kind {
        rows.push(base_codec::json_arr([
          base_codec::json_str(addr),
          base_codec::json_str(k),
          base_codec::json_str(j),
        ]))
      }
    }
  } else if stmt == store::sql_station_doc_one() {
    let addr = sf_p_str(p, 0)
    let kind = sf_p_str(p, 1)
    for i in 0..<self.stations_docs.length() {
      let (a, k, j) = self.stations_docs[i]
      if a == addr && k == kind {
        rows.push(base_codec::json_arr([
          base_codec::json_str(a),
          base_codec::json_str(k),
          base_codec::json_str(j),
        ]))
        break
      }
    }
  } else if stmt == store::sql_account_doc_one() {
    match self.account_docs.get(sf_p_str(p, 0)) {
      Some(j) => rows.push(base_codec::json_arr([base_codec::json_str(j)]))
      None => ()
    }
  } else if stmt == sync::sql_entry_put() {
    self.put_entry(sf_p_str(p, 0), sf_p_int(p, 1), sf_p_int(p, 2), sf_p_str(p, 3))
    changed = 1
  } else if stmt == sync::sql_chat_upsert() {
    self.put_chat(SfChatRow::{
      station: sf_p_str(p, 0),
      archived: sf_p_int(p, 2),
      id: sf_p_str(p, 1),
      ord: sql::col_double(p, 3),
      thread: sf_p_opt_int(p, 4),
      session: sf_p_opt_str(p, 5),
      pinned_at: sf_p_opt_i64(p, 8),
      last_active: sf_p_i64(p, 7),
      mine: sf_p_int(p, 9),
      hidden: sf_p_int(p, 10),
      led: sf_p_int(p, 11),
      watched: sf_p_int(p, 12),
      json: sf_p_str(p, 15),
    })
    changed = 1
  } else if stmt == sync::sql_thread_upsert() {
    let st = sf_p_str(p, 0)
    let th = sf_p_int(p, 1)
    self.threads.set(st + ":" + th.to_string(), SfThreadRow::{
      id: th,
      last: sf_p_opt_int(p, 2),
      read: sf_p_opt_int(p, 3),
      unread: sf_p_opt_int(p, 4),
      sort_at: sf_p_i64(p, 5),
      created_at: sf_p_i64(p, 6),
      surface: sf_p_opt_str(p, 7),
      first_member: sf_p_opt_str(p, 8),
      json: sf_p_str(p, 10),
    })
    changed = 1
  } else if stmt == sync::sql_outbox_put() {
    self.outbox_rows.set(sf_p_str(p, 0) + ":" + sf_p_int(p, 1).to_string(), sf_p_str(p, 2))
    changed = 1
  } else if stmt == sync::sql_outbox_delete() {
    self.outbox_rows.remove(sf_p_str(p, 0) + ":" + sf_p_int(p, 1).to_string())
    changed = 1
  } else if stmt == sync::sql_changing_put() {
    let st = sf_p_str(p, 0)
    let id = sf_p_int(p, 1)
    let js = sf_p_str(p, 2)
    let mut updated = false
    for i in 0..<self.changing_rows.length() {
      if self.changing_rows[i].0 == st && self.changing_rows[i].1 == id {
        self.changing_rows[i] = (st, id, js)
        updated = true
        break
      }
    }
    if !updated {
      self.changing_rows.push((st, id, js))
    }
    changed = 1
  } else if stmt == sync::sql_changing_delete() {
    let st = sf_p_str(p, 0)
    let id = sf_p_int(p, 1)
    let next : Array[(String, Int, String)] = []
    for i in 0..<self.changing_rows.length() {
      if !(self.changing_rows[i].0 == st && self.changing_rows[i].1 == id) {
        next.push(self.changing_rows[i])
      }
    }
    self.changing_rows.clear()
    for i in 0..<next.length() {
      self.changing_rows.push(next[i])
    }
    changed = 1
  } else if stmt == sync::sql_session_upsert() || stmt == sync::sql_job_upsert() ||
  stmt == sync::sql_pending_put() || stmt == sync::sql_pending_delete() {
    changed = 1
  } else {
    // Unknown optional read queries return empty rows cleanly
    ()
  }

  if op == "sql.run" {
    shell::AskResult::Ok(base_codec::json_int(changed))
  } else {
    shell::AskResult::Ok(base_codec::json_arr(rows))
  }
}

// ---------------------------------------------------------------------------
// Deterministic SimStation for sf_ui E2E tests
// ---------------------------------------------------------------------------

fn sf_bytes_to_str(b : Bytes) -> String {
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

struct SfSimStation {
  rt : effect::Runtime
  mut next_entry_n : Int
  seen_client_keys : Map[String, Int]
  mut active_sse_chunk : Option[(Bytes) -> Unit]
  mut active_sse_done : Option[effect::Deferred[Unit]]
}

fn SfSimStation::new(rt : effect::Runtime) -> SfSimStation {
  SfSimStation::{
    rt: rt,
    next_entry_n: 500,
    seen_client_keys: Map::new(),
    active_sse_chunk: None,
    active_sse_done: None,
  }
}

fn SfSimStation::push_entry_sse(
  self : SfSimStation,
  workspace : String,
  thread : Int,
  n : Int,
  author_kind : String,
  author : String,
  text : String,
  client_key~ : Option[String] = None,
) -> Unit {
  let fields : Array[(String, base_codec::Json)] = [
    ("workspace", base_codec::json_str(workspace)),
    ("thread", base_codec::json_int(thread)),
    ("n", base_codec::json_int(n)),
    ("kind", base_codec::json_str("message")),
    ("authorKind", base_codec::json_str(author_kind)),
    ("author", base_codec::json_str(author)),
    ("text", base_codec::json_str(text)),
  ]
  match client_key {
    Some(ck) => fields.push(("clientKey", base_codec::json_str(ck)))
    None => ()
  }
  let payload = base_codec::json_stringify(base_codec::json_obj(fields))
  match self.active_sse_chunk {
    Some(cb) => cb(("id: ev-\{n}\nevent: entry\ndata: \{payload}\n\n").to_bytes())
    None => ()
  }
}

fn SfSimStation::transport(self : SfSimStation) -> sync::StationTransport {
  sync::StationTransport::{
    request_k: fn(
      method_name : String,
      path : String,
      _headers : Array[(String, String)],
      body : Bytes,
      k : (effect::Exit[sync::HttpReply]) -> Unit,
    ) -> Unit {
      if method_name == "POST" && path.starts_with("/threads/") && path.ends_with("/messages") {
        let ck = match base_codec::json_parse(sf_bytes_to_str(body)) {
          base_codec::JsonParseResult::Ok(j) =>
          match base_codec::json_get(j, "clientKey") {
            Some(base_codec::Json::Str(s)) => s
            _ => ""
          }
          base_codec::JsonParseResult::Err(_) => ""
        }
        let assigned_n = match self.seen_client_keys.get(ck) {
          Some(existing) => existing
          None => {
            self.next_entry_n += 1
            let n = self.next_entry_n
            if ck.length() > 0 {
              self.seen_client_keys.set(ck, n)
            }
            n
          }
        }
        let ack = base_codec::json_stringify(base_codec::json_obj([
          ("n", base_codec::json_int(assigned_n)),
          ("clientKey", base_codec::json_str(ck)),
        ])).to_bytes()
        effect::sleep_k(10, fn(_ex : effect::Exit[Unit]) -> Unit {
          k(effect::Exit::Succeeded(sync::HttpReply::{ status: 200, headers: [], body: ack }))
        })
        return
      }
      effect::sleep_k(10, fn(_ex : effect::Exit[Unit]) -> Unit {
        k(effect::Exit::Succeeded(sync::HttpReply::{ status: 200, headers: [], body: "{}".to_bytes() }))
      })
    },
    stream_k: fn(
      _path : String,
      _headers : Array[(String, String)],
      on_chunk : (Bytes) -> Unit,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      let done : effect::Deferred[Unit] = effect::Deferred::new()
      self.active_sse_chunk = Some(on_chunk)
      self.active_sse_done = Some(done)
      effect::sleep_k(5, fn(sex : effect::Exit[Unit]) -> Unit {
        match sex {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(_) => {
            on_chunk(": connected\n\n".to_bytes())
            done.wait_k(k)
          }
        }
      })
    },
  }
}

// ---------------------------------------------------------------------------
// Real Ed25519 lock chain + full realistic `still.fail` workspace seed
// ---------------------------------------------------------------------------

fn sf_seed_bytes(v : Int) -> Bytes {
  let b = Bytes::new(32)
  for i in 0..<32 {
    b[i] = ((v + i * 7) & 0xFF) as Byte
  }
  b
}

fn sf_hex64(ch : String) -> String {
  let sb = StringBuilder::new()
  for _ in 0..<64 {
    sb.write_string(ch)
  }
  sb.to_string()
}

struct SfTestEnv {
  rt : effect::Runtime
  db : SfSimDb
  station : SfSimStation
  ctrl : app_state::AppController
}

fn make_real_sf_env(dark~ : Bool = false) -> SfTestEnv {
  let rt = effect::Runtime::new()
  let day_ms = 86400000.to_int64()
  rt.advance(86400000 * 3)
  let now_ms = rt.now()
  let sim_db = SfSimDb::new(rt)
  let db = match sql::Sql::open(sim_db.sh, "acct-sf-ui") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("sql open failed: " + e.to_string())
  }
  let station = SfSimStation::new(rt)
  let ws = "ws-afk"
  let st1 = "ws-afk/tokyo-studio"
  let st2 = "ws-afk/pvg-linux-1"

  // 1. Seed station overview docs (stations, sanitized profiles with secret stripped, models, usage)
  let st1_overview = base_codec::json_obj([
    ("id", base_codec::json_str("tokyo-studio")),
    ("name", base_codec::json_str("Tokyo Mac Studio")),
