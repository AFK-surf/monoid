        ]),
        base_codec::json_obj([
          ("label", base_codec::json_str("切到纯 Pion-JSX 视图")),
          ("detail", base_codec::json_str("直接以 Invar 原生客户端为主链路")),
          ("recommended", base_codec::json_bool(true)),
        ]),
      ])),
    ])),
  ])))

  // Thread 102 entries
  sim_db.put_entry(st1, 102, 1, base_codec::json_stringify(base_codec::json_obj([
    ("kind", base_codec::json_str("message")),
    ("authorKind", base_codec::json_str("person")),
    ("author", base_codec::json_str("alice@afk.surf")),
    ("authorName", base_codec::json_str("Alice")),
    ("text", base_codec::json_str("确认下双通道 QUIC 备路切换的 P99 延迟。")),
  ])))
  sim_db.put_entry(st1, 102, 2, base_codec::json_stringify(base_codec::json_obj([
    ("kind", base_codec::json_str("message")),
    ("authorKind", base_codec::json_str("agent")),
    ("author", base_codec::json_str("MeshBot")),
    ("authorName", base_codec::json_str("MeshBot")),
    ("authorModel", base_codec::json_str("claude-opus-5-5")),
    ("text", base_codec::json_str("55 项双通道弱网回归全部通过，备路切换 P99 稳定在 14ms。")),
  ])))

  // 4. Construct AppController & wire real Ed25519 lock chain, stars, and VaultApprovalQueue
  let ctrl = app_state::AppController::new(ws, st1, rt, db, station.transport())
  ctrl.set_workspace_name("AFK Engineering")
  ctrl.set_dark_mode(dark)

  let alice_seed = sf_seed_bytes(11)
  let bob_seed = sf_seed_bytes(22)
  let alice_key = sync::ed25519_key_id(alice_seed)
  let bob_key = sync::ed25519_key_id(bob_seed)
  let alice_dev_id = sf_hex64("a")
  let bob_dev_id = sf_hex64("b")

  ctrl.core.set_viewer(
    "alice@afk.surf",
    sub="alice",
    role="owner",
    device_id=alice_dev_id,
    device_kind="app",
    device_sign_key=Some(alice_key),
  )

  let g_unsigned = form::Json::Obj([
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str(ws)),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1795000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("owner", form::Json::Str("alice")),
      ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
      ("rp_id", form::Json::Str("app.still.fail")),
      ("cloud_keys", form::Json::Obj([])),
      ("members", form::Json::Arr([
        form::Json::Obj([("sub", form::Json::Str("alice")), ("email", form::Json::Str("alice@afk.surf")), ("role", form::Json::Str("owner"))]),
        form::Json::Obj([("sub", form::Json::Str("bob")), ("email", form::Json::Str("bob@afk.surf")), ("role", form::Json::Str("admin"))]),
      ])),
      ("devices", form::Json::Arr([
        form::Json::Obj([("id", form::Json::Str(alice_dev_id)), ("sub", form::Json::Str("alice")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Alice Studio")), ("sign_key", form::Json::Str(alice_key))]),
        form::Json::Obj([("id", form::Json::Str(bob_dev_id)), ("sub", form::Json::Str("bob")), ("kind", form::Json::Str("app")), ("label", form::Json::Str("Bob Linux")), ("sign_key", form::Json::Str(bob_key))]),
      ])),
      ("passkeys", form::Json::Arr([])),
      ("stations", form::Json::Arr([
        form::Json::Obj([("key", form::Json::Str(sf_hex64("c"))), ("name", form::Json::Str("Tokyo Mac Studio"))]),
        form::Json::Obj([("key", form::Json::Str(sf_hex64("d"))), ("name", form::Json::Str("PVG Linux Builder"))]),
      ])),
      ("gateways", form::Json::Arr([])),
    ])),
  ])
  let g_signed = match sync::sign_lock_entry(alice_seed, g_unsigned) {
    Ok(e) => e
    Err(err) => panic("sign_lock_entry failed: " + err)
  }
  let root_hash = match lock::entry_hash(g_signed, sync::native_lock_crypto()) {
    Ok(h) => h
    Err(_) => panic("entry_hash failed")
  }
  match ctrl.core.apply_lock_chain([g_signed], root_hash) {
    Ok(_) => ()
    Err(why) => panic("apply_lock_chain failed: " + why)
  }

  // Starred models
  ctrl.core.stars_held.push(views::StarEntry::{ key: "google/gemini-4-neon", on: true, rev: 1, at: now_ms })
  ctrl.core.stars_held.push(views::StarEntry::{ key: "anthropic/claude-opus-5-5", on: true, rev: 1, at: now_ms })

  // Pending vault approval requests
  ctrl.core.vault_approvals.enqueue(views::VaultApprovalRequest::{
    id: "req-stripe",
    ws: ws,
    vault_id: "v-team",
    item_id: "item-stripe",
    item_name: "Stripe 测试环境密钥",
    kind: views::VaultRequestKind::SecretUse,
    mode: "proxy",
    reason: "运行支付回调集成测试，仅允许经本机代理访问 Stripe 测试接口",
    hosts: ["api.stripe.com"],
    max_scope: "hour",
    at_ms: now_ms,
    status: views::VaultRequestStatus::Pending,
    granted_scope: None,
    decided_at_ms: None,
    decision_note: None,
  })
  ctrl.core.vault_approvals.enqueue(views::VaultApprovalRequest::{
    id: "req-gh",
    ws: ws,
    vault_id: "v-team",
    item_id: "item-gh",
    item_name: "GitHub Release Token",
    kind: views::VaultRequestKind::SecretUse,
    mode: "proxy",
    reason: "拉取私有子模块发布元数据并校验构建产物摘要",
    hosts: ["api.github.com"],
    max_scope: "once",
    at_ms: now_ms - 60000.to_int64(),
    status: views::VaultRequestStatus::Pending,
    granted_scope: None,
    decided_at_ms: None,
    decision_note: None,
  })

  // Open thread 101 and populate all 8 real `packages/views` signals
  let _ = ctrl.open_initial(101, now_ms)
  ctrl.refresh_all_views()

  SfTestEnv::{ rt: rt, db: sim_db, station: station, ctrl: ctrl }
}
