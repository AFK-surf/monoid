  // 3. Seed thread metadata & rich real entries (Markdown, CodeBlock, toolGroups, interactive card, blue bubbles)
  sim_db.threads.set(st1 + ":101", SfThreadRow::{
    id: 101,
    last: Some(5),
    read: Some(5),
    unread: Some(0),
    sort_at: now_ms,
    created_at: now_ms - 7200000.to_int64(),
    surface: Some("chat"),
    first_member: Some("alice@afk.surf"),
    json: base_codec::json_stringify(base_codec::json_obj([("title", base_codec::json_str("Invar 原生客户端架构迁移"))])),
  })
  sim_db.threads.set(st1 + ":102", SfThreadRow::{
    id: 102,
    last: Some(2),
    read: Some(2),
    unread: Some(0),
    sort_at: now_ms - 1800000.to_int64(),
    created_at: now_ms - 9000000.to_int64(),
    surface: Some("chat"),
    first_member: Some("alice@afk.surf"),
    json: base_codec::json_stringify(base_codec::json_obj([("title", base_codec::json_str("双通道 Mesh 传输压测"))])),
  })

  // Thread 101 entries
  sim_db.put_entry(st1, 101, 1, base_codec::json_stringify(base_codec::json_obj([
    ("kind", base_codec::json_str("message")),
    ("authorKind", base_codec::json_str("person")),
    ("author", base_codec::json_str("alice@afk.surf")),
    ("authorName", base_codec::json_str("Alice")),
    ("text", base_codec::json_str("帮我把 pion/app 接到真实 ClientCore 和 packages/views，并跑通 Metal 离屏出图与 Apple UI 门禁。")),
  ])))

  sim_db.put_entry(st1, 101, 2, base_codec::json_stringify(base_codec::json_obj([
    ("kind", base_codec::json_str("message")),
    ("authorKind", base_codec::json_str("agent")),
    ("author", base_codec::json_str("Builder")),
    ("authorName", base_codec::json_str("Antigravity")),
    ("authorModel", base_codec::json_str("gemini-4-neon")),
    ("text", base_codec::json_str("## 阶段 3a 架构接线已完成\n\n- 左侧栏直接订阅真实 `ChatsView.days` 与 `glyph` 状态\n- 主对话流使用 `<lg::PageShell>` 全高穿透滚动与 `<lg::ComposerBar>`\n\n```pion\n<lg::SplitShell\n  sidebar={fn(sb) {\n    render_sidebar(sb, ctrl)\n  }}\n  detail={fn(dt) {\n    render_chat_pane(dt, ctrl)\n  }}\n/>\n```")),
  ])))

  // Folded tool_call / tool_result pair after seq 2
  sim_db.put_entry(st1, 101, 3, base_codec::json_stringify(base_codec::json_obj([
    ("kind", base_codec::json_str("tool_call")),
