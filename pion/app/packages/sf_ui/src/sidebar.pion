// Left sidebar (Chats List) driven 100% by real `ChatsView` (`ctrl.chats_days_sig`).
// Quiet, restrained macOS Tahoe / iOS 26 sidebar:
// - Zero colorful badge soup in header or rows
// - Minimal 2-row header: workspace title + quiet online status dot/text, and full-width flat Segmented
// - First-line aligned 6pt status dots on chat rows + quiet tertiary status text on the right
// - Zero pointer cursor on static headers/spacers, bounded `<ui::Scroll>` (0 scroll faults)

import "app_state"
import "headless"
import "lg"
import "motion"
import "signals"
import "ui"
import "view"

fn filter_to_idx(f : app_state::ChatFilter) -> Int {
  match f {
    app_state::ChatFilter::All => 0
    app_state::ChatFilter::Asks => 1
    app_state::ChatFilter::Running => 2
  }
}

fn idx_to_filter(i : Int) -> app_state::ChatFilter {
  if i == 1 {
    app_state::ChatFilter::Asks
  } else if i == 2 {
    app_state::ChatFilter::Running
  } else {
    app_state::ChatFilter::All
  }
}

fn chat_matches_filter(item : app_state::ListedChatItem, f : app_state::ChatFilter) -> Bool {
  match f {
    app_state::ChatFilter::All => true
    app_state::ChatFilter::Asks => item.state == "block" || item.tone == "wait" || item.tone == "alert"
    app_state::ChatFilter::Running => item.state == "run" || item.tone == "busy"
  }
}

fn status_dot_color(item : app_state::ListedChatItem) -> Int64 {
  let s = lg::surface()
  if item.tone == "alert" || item.state == "failed" {
    s.danger
  } else if item.tone == "wait" || item.state == "block" {
    s.warning
  } else if item.tone == "busy" || item.state == "run" || item.unread {
    s.accent
  } else {
    lg::clear
  }
}

fn row_meta_text(item : app_state::ListedChatItem) -> String {
  if item.state == "block" || item.tone == "wait" {
    "待确认"
  } else if item.state == "run" || item.tone == "busy" {
    "运行中"
  } else if item.unread {
    "未读"
  } else {
    ""
  }
}

fn find_day_label(days : Array[app_state::ChatDayGroup], key : String) -> String {
  for i in 0..<days.length() {
    if days[i].days_ago.to_string() == key {
      return days[i].label
    }
  }
  ""
}

fn find_chat_in_days(
  days : Array[app_state::ChatDayGroup],
  chat_key : String,
) -> Option[app_state::ListedChatItem] {
  for i in 0..<days.length() {
    let items = days[i].items
    for k in 0..<items.length() {
      let it = items[k]
      if it.station + ":" + it.id == chat_key {
        return Some(it)
      }
    }
  }
  None
}

fn render_chat_row(
  parent : view::View,
  ctrl : app_state::AppController,
  chat_key_sig : signals::Signal[String],
) -> Unit {
  let item_of = fn() -> Option[app_state::ListedChatItem] {
    find_chat_in_days(ctrl.chats_days_sig.get().days, chat_key_sig.get())
  }
  let _ = headless::button(
    parent,
    fn() {
      match item_of() {
        Some(it) => it.title
        None => "对话"
      }
    },
    fn(_e) -> Unit {
      match item_of() {
        Some(it) => {
          let _ = ctrl.select_station_chat(it.station, it.thread)
        }
        None => ()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = motion::hover_fade(b, fn() { btn.hovered() })
      let is_selected = fn() -> Bool {
        match item_of() {
          Some(it) => it.thread == ctrl.active_thread_sig.get()
          None => false
        }
      }
      let _ = b
      .width_share(view::Live::Is(1.0))
      .min_width(view::Live::Is(Some(0.0)))
      .padding(view::Live::Is((10.0, 9.0, 10.0, 9.0)))
      .radius(view::Live::Is(10.0))
      .ground(view::Live::By(fn() {
        let s = lg::surface()
        if is_selected() {
          s.row_selected
        } else if hover_t() > 0.001 {
          lg::alpha(s.row_hover, hover_t())
        } else {
          lg::clear
        }
      }))

      // Outer row: Align Start so 6pt status dot aligns to the first line of title text.
      let _ = b.box(fn(row : view::View) -> Unit {
        let _ = row
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Start)))
        .gap(view::Live::Is(8.0))
        .min_width(view::Live::Is(Some(0.0)))

        // First-line 6pt status dot (matches 13.5pt * 1.4 = 18.9pt first line height)
        let _ = row.box(fn(dot_wrap : view::View) -> Unit {
          let _ = dot_wrap
          .width(view::Live::Is(Some(8.0)))
          .height(view::Live::Is(Some(19.0)))
          .shrink(view::Live::Is(0.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          let _ = dot_wrap.box(fn(dot : view::View) -> Unit {
            let _ = dot
            .width(view::Live::Is(Some(6.0)))
            .height(view::Live::Is(Some(6.0)))
            .radius(view::Live::Is(3.0))
            .ground(view::Live::By(fn() {
              match item_of() {
                Some(it) => status_dot_color(it)
                None => lg::clear
              }
            }))
          })
        })

        // Text column (title + quiet right meta text, preview below)
        let _ = row.box(fn(col : view::View) -> Unit {
          let _ = col
          .grow(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .shrink(view::Live::Is(1.0))
          .min_width(view::Live::Is(Some(0.0)))
          .gap(view::Live::Is(3.0))

          let _ = col.box(fn(top_row : view::View) -> Unit {
            let _ = top_row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Start)))
            .gap(view::Live::Is(8.0))
            .min_width(view::Live::Is(Some(0.0)))
            let _ = top_row.box(fn(ttl : view::View) -> Unit {
              let _ = ttl
              .grow(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .shrink(view::Live::Is(1.0))
              .min_width(view::Live::Is(Some(0.0)))
              .words(
                view::Live::By(fn() {
                  match item_of() {
                    Some(it) => it.title
                    None => ""
                  }
                }),
                look=lg::words_at(13.5, weight=500, lines=1),
              )
              .ink(view::Live::By(fn() { lg::surface().ink }))
            })
            let _ = top_row.box(fn(meta : view::View) -> Unit {
              let _ = meta
              .padding(view::Live::Is((0.0, 1.5, 0.0, 0.0)))
              .shrink(view::Live::Is(0.0))
              .words(
                view::Live::By(fn() {
                  match item_of() {
                    Some(it) => row_meta_text(it)
                    None => ""
                  }
                }),
                look=lg::words_at(11.5, weight=400, lines=1),
              )
              .ink(view::Live::By(fn() { lg::surface().ink_tertiary }))
            })
          })

          // Preview line (left-aligned with title)
          let _ = col.box(fn(prev : view::View) -> Unit {
            let _ = prev
            .min_width(view::Live::Is(Some(0.0)))
            .words(
              view::Live::By(fn() {
                match item_of() {
                  Some(it) => if it.preview.length() > 0 { it.preview } else { it.station_name }
                  None => ""
                }
              }),
              look=lg::words_at(12.0, weight=400, lines=1),
            )
            .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
          })
        })
      })
    },
  )
}

fn SidebarChatDays(parent : view::View, ctrl~ : app_state::AppController) -> view::View {
  let _ = parent.box(fn(inner : view::View) -> Unit {
    let _ = inner
    .width_share(view::Live::Is(1.0))
    .padding(view::Live::Is((8.0, 2.0, 8.0, 14.0)))
    .gap(view::Live::Is(12.0))

    inner.each(
      fn() -> Array[String] {
        let filter = ctrl.chat_filter_sig.get()
        let days = ctrl.chats_days_sig.get().days
        let keys : Array[String] = []
        for i in 0..<days.length() {
          let mut has_any = false
          for k in 0..<days[i].items.length() {
            if chat_matches_filter(days[i].items[k], filter) {
              has_any = true
              break
            }
          }
          if has_any {
            keys.push(days[i].days_ago.to_string())
          }
        }
        keys
      },
      fn(k : String) -> String { k },
      fn(day_box : view::View, day_key_sig : signals::Signal[String]) -> Unit {
        let _ = day_box.gap(view::Live::Is(2.0)).min_width(view::Live::Is(Some(0.0)))
        // Static group header (no pointer cursor)
        let _ = day_box.box(fn(hdr : view::View) -> Unit {
          let _ = hdr
          .padding(view::Live::Is((10.0, 4.0, 10.0, 3.0)))
          .words(
            view::Live::By(fn() { find_day_label(ctrl.chats_days_sig.get().days, day_key_sig.get()) }),
            look=lg::words_at(11.5, weight=600, lines=1),
          )
          .ink(view::Live::By(fn() { lg::surface().ink_tertiary }))
        })
        let _ = day_box.box(fn(items_col : view::View) -> Unit {
          let _ = items_col.gap(view::Live::Is(2.0)).min_width(view::Live::Is(Some(0.0)))
          items_col.each(
            fn() -> Array[String] {
              let filter = ctrl.chat_filter_sig.get()
              let dk = day_key_sig.get()
              let days = ctrl.chats_days_sig.get().days
              let out : Array[String] = []
              for i in 0..<days.length() {
                if days[i].days_ago.to_string() == dk {
                  let items = days[i].items
                  for k in 0..<items.length() {
                    if chat_matches_filter(items[k], filter) {
                      out.push(items[k].station + ":" + items[k].id)
                    }
                  }
                  break
                }
              }
              out
            },
            fn(k : String) -> String { k },
            fn(row_slot : view::View, key_sig : signals::Signal[String]) -> Unit {
              render_chat_row(row_slot, ctrl, key_sig)
            },
            at_once=true,
          )
        })
      },
      at_once=true,
    )
  })
  parent
}

/// Render the quiet macOS-style Chats List sidebar inside `<lg::SplitShell>`.
pub fn render_sidebar(parent : view::View, ctrl : app_state::AppController) -> Unit {
  let _ = <ui::Col in={parent} fill clip>
    // Quiet 2-row header: workspace title + plain dot/text status, and full-width flat Segmented
    <ui::Col pad_x={14.0} pad_y={14.0} gap={12.0} rigid>
      <ui::Row align={.Middle} gap={8.0} rigid>
        <ui::Text
          size={16.0}
          weight={600}
          lines={1}
          color_by=>{lg::surface().ink}
          text_by=>{ctrl.workspace_name_sig.get()}
        />
        <ui::Spacer />
        <ui::Row align={.Middle} gap={5.0} rigid>
          <ui::Box width={6.0} height={6.0} radius={3.0} bg_by=>{lg::surface().positive} rigid />
          <ui::Text
            size={12.0}
            weight={400}
            lines={1}
            color_by=>{lg::surface().ink_secondary}
            text_by=>{ctrl.chats_days_sig.get().glyph.summary}
          />
        </ui::Row>
      </ui::Row>
      <lg::Segmented
        flat
        labels={["全部", "待处理", "运行中"]}
        selected_by=>{filter_to_idx(ctrl.chat_filter_sig.get())}
        on_select={fn(i : Int) -> Unit { ctrl.set_chat_filter(idx_to_filter(i)) }}
        width={268.0}
        height={30.0}
      />
    </ui::Col>
    <ui::Scroll>
      <SidebarChatDays ctrl={ctrl} />
    </ui::Scroll>
  </ui::Col>
}
