  let ok4 = film::picture(
    fn(root : view::View) -> Unit { sf_app_root(root, env4.ctrl) },
    path="/tmp/sf_ui_shots_3b/sf-3b-signin-light.png",
    w=1280.0,
    h=820.0,
    scale=2.0,
    dark=false,
    at=150.0,
    theme=lg::ui_theme,
  )
  debug_assert(ok4, "sf-3b-signin-light.png Metal snapshot must succeed")
}
