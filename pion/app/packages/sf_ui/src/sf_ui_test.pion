// Automated Apple Two-Layer UI + Craft gates, E2E interactive closed-loop tests,
// and native Apple Metal offscreen 2x PNG snapshot generation for `sf_ui`.

import "app_state"
import "film"
import "lg"
import "ui"
import "view"

test "sf_ui_1_wide_light_dark_narrow_and_sheet_apple_ui_gates" {
  // 1. Wide 1280x820 Light
  let env_wl = make_real_sf_env(dark=false)
  let t_wl = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env_wl.ctrl) },
    width=1280.0,
    height=820.0,
    theme=lg::ui_theme,
  )
  t_wl.run_shown(100.0)
  debug_assert(t_wl.find("AFK Engineering").is_some(), "workspace title rendered in sidebar")
  debug_assert(t_wl.find("Invar 原生客户端架构迁移").is_some(), "active chat title rendered")
  debug_assert(t_wl.find("切到纯 Pion-JSX 视图").is_some(), "interactive decision card rendered")
  debug_assert(t_wl.find("已完成 1 次工具调用").is_some(), "folded toolGroups disclosure rendered")
  debug_assert(t_wl.scroll_faults().length() == 0, "wide light must have 0 scroll faults")
  lg::assert_no_nested_glass(t_wl, label="sf_wide_light")
  lg::assert_apple_ui(t_wl, label="sf_wide_light")
  t_wl.dispose()

  // 2. Wide 1280x820 Dark
  let env_wd = make_real_sf_env(dark=true)
  let t_wd = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env_wd.ctrl) },
    width=1280.0,
    height=820.0,
    theme=lg::ui_theme,
    dark=true,
  )
  t_wd.run_shown(100.0)
  debug_assert(t_wd.scroll_faults().length() == 0, "wide dark must have 0 scroll faults")
  lg::assert_no_nested_glass(t_wd, label="sf_wide_dark")
  lg::assert_apple_ui(t_wd, label="sf_wide_dark")
  t_wd.dispose()

  // 3. Narrow 390x844 Light (chat detail with BackButton)
  let env_nl = make_real_sf_env(dark=false)
  let t_nl = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env_nl.ctrl) },
    width=390.0,
    height=844.0,
    theme=lg::ui_theme,
  )
  t_nl.run_shown(100.0)
  debug_assert(t_nl.scroll_faults().length() == 0, "narrow light must have 0 scroll faults")
  lg::assert_no_nested_glass(t_nl, label="sf_narrow_light")
  lg::assert_apple_ui(t_nl, label="sf_narrow_light")
  t_nl.press("Back")
  t_nl.run_shown(80.0)
  debug_assert(!env_nl.ctrl.show_detail_sig.untracked(), "pressing BackButton switches narrow view to sidebar")
  t_nl.dispose()

  // 4. Settings / Safe Mode / Vault Approvals Sheet (flat=true Segmented, zero 「个人锁」)
  let env_sh = make_real_sf_env(dark=false)
  env_sh.ctrl.set_sheet(app_state::ActiveSheet::Settings)
  let t_sh = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env_sh.ctrl) },
    width=1280.0,
    height=820.0,
    theme=lg::ui_theme,
  )
  t_sh.run_shown(120.0)
  debug_assert(t_sh.find("已开启").is_some(), "unified safe mode status rendered")
  debug_assert(t_sh.find("Stripe 测试环境密钥").is_some(), "vault approval request rendered")
  debug_assert(t_sh.find("端到端加密").is_some(), "plainMode: false encrypted value rendered")
  debug_assert(t_sh.find("个人锁").is_none(), "must NEVER display legacy personal-lock wording")
  debug_assert(t_sh.scroll_faults().length() == 0, "settings sheet must have 0 scroll faults")
  lg::assert_no_nested_glass(t_sh, label="sf_settings_sheet", allow_large_overlay=true)
  lg::assert_apple_ui(t_sh, label="sf_settings_sheet", allow_large_overlay=true)
  t_sh.dispose()
}

test "sf_ui_2_e2e_interactive_closed_loop" {
  let env = make_real_sf_env(dark=false)
  env.ctrl.start_live()
  env.rt.advance(30)

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env.ctrl) },
    width=1280.0,
    height=820.0,
    theme=lg::ui_theme,
  )
  t.run_shown(100.0)

  // 1. Click sidebar chat row to switch to thread 102
  t.press("双通道 Mesh 传输压测")
  t.run_shown(80.0)
  debug_assert(env.ctrl.active_thread_sig.untracked() == 102, "clicked sidebar chat switched to thread 102")
  debug_assert(t.find("55 项双通道弱网回归全部通过").is_some(), "thread 102 message rendered")

  // Switch back to thread 101
  t.press("Invar 原生客户端架构迁移")
  t.run_shown(80.0)
  debug_assert(env.ctrl.active_thread_sig.untracked() == 101, "switched back to thread 101")

  // 2. Send message -> optimistic outbox bubble appears immediately
  let ck = env.ctrl.send_message("确认通过，开始切流验证", author="alice@afk.surf")
  debug_assert(ck.length() > 0, "client_key assigned")
  t.run_shown(80.0)
  debug_assert(env.ctrl.active_chat_sig.untracked().outbox.length() == 1, "optimistic outbox has 1 item")
  debug_assert(t.find("确认通过，开始切流验证").is_some(), "optimistic bubble visible in UI")
  debug_assert(t.find("发送中").is_some(), "sending badge visible on optimistic bubble")

  // 3. Station POST ack + SSE confirmation with exact clientKey -> outbox cleared & 0 duplicates
  env.rt.advance(30)
  let assigned_n = match env.station.seen_client_keys.get(ck) {
    Some(n) => n
    None => 501
  }
  env.station.push_entry_sse(
    "ws-afk",
    101,
    assigned_n,
    "person",
    "alice@afk.surf",
    "确认通过，开始切流验证",
    client_key=Some(ck),
  )
  t.run_shown(100.0)
  debug_assert(env.ctrl.active_chat_sig.untracked().outbox.length() == 0, "outbox cleared after SSE confirm")
  let mut match_count = 0
  let msgs = env.ctrl.active_chat_sig.untracked().messages
  for i in 0..<msgs.length() {
    if msgs[i].text == "确认通过，开始切流验证" {
      match_count += 1
    }
  }
  debug_assert(match_count == 1, "confirmed message appears exactly once (0 duplicates)")

  // 4. Open Settings sheet -> click Approve on Vault request -> pending count decreases
  t.press("安全模式与设置")
  t.run_shown(120.0)
  debug_assert(env.ctrl.sheet_sig.untracked() == app_state::ActiveSheet::Settings, "settings sheet opened")
  let before_pending = env.ctrl.vault_approvals_sig.untracked().pending.length()
  debug_assert(before_pending == 2, "starts with 2 pending vault approvals")
  t.press("批准")
  t.run_shown(80.0)
  let after_pending = env.ctrl.vault_approvals_sig.untracked().pending.length()
  debug_assert(after_pending == 1, "approving vault request removed it from pending list")

  // 5. Verify profiles sanitization: zero secrets leaked in projected profiles
  let profs = env.ctrl.profiles_sig.untracked()
  debug_assert(profs.length() >= 3, "sanitized profiles loaded from real stations")
  let models = env.ctrl.models_sig.untracked()
  debug_assert(models.length() >= 3 && models[0].starred, "starred models sorted first")

  env.ctrl.stop_live()
  t.dispose()
}

test "sf_ui_3_metal_offscreen_4_shots" {
  debug_assert(film::is_supported(), "Apple macOS Metal offscreen rendering must be supported")

  // Shot 1: Wide 1280x820 Light (2x -> 2560x1640)
  let env1 = make_real_sf_env(dark=false)
  let ok1 = film::picture(
    fn(root : view::View) -> Unit { sf_app_root(root, env1.ctrl) },
    path="/tmp/sf_ui_shots/sf-wide-light.png",
    w=1280.0,
    h=820.0,
    scale=2.0,
    dark=false,
    at=100.0,
    theme=lg::ui_theme,
  )
  debug_assert(ok1, "sf-wide-light.png Metal snapshot must succeed")

  // Shot 2: Wide 1280x820 Dark (2x -> 2560x1640)
  let env2 = make_real_sf_env(dark=true)
  let ok2 = film::picture(
    fn(root : view::View) -> Unit { sf_app_root(root, env2.ctrl) },
    path="/tmp/sf_ui_shots/sf-wide-dark.png",
    w=1280.0,
    h=820.0,
    scale=2.0,
    dark=true,
    at=100.0,
    theme=lg::ui_theme,
  )
  debug_assert(ok2, "sf-wide-dark.png Metal snapshot must succeed")

  // Shot 3: Narrow 390x844 Light (2x -> 780x1688)
  let env3 = make_real_sf_env(dark=false)
  let ok3 = film::picture(
    fn(root : view::View) -> Unit { sf_app_root(root, env3.ctrl) },
    path="/tmp/sf_ui_shots/sf-narrow-light.png",
    w=390.0,
    h=844.0,
    scale=2.0,
    dark=false,
    at=100.0,
    theme=lg::ui_theme,
  )
  debug_assert(ok3, "sf-narrow-light.png Metal snapshot must succeed")

  // Shot 4: Settings / Safe Mode / Vault Approvals Sheet 1280x820 Light (2x -> 2560x1640)
  let env4 = make_real_sf_env(dark=false)
  env4.ctrl.set_sheet(app_state::ActiveSheet::Settings)
  let ok4 = film::picture(
    fn(root : view::View) -> Unit { sf_app_root(root, env4.ctrl) },
    path="/tmp/sf_ui_shots/sf-settings-sheet-light.png",
    w=1280.0,
    h=820.0,
    scale=2.0,
    dark=false,
    at=150.0,
    theme=lg::ui_theme,
  )
  debug_assert(ok4, "sf-settings-sheet-light.png Metal snapshot must succeed")
}

test "sf_ui_4_stage3b_pages_interactive_and_apple_ui_gates" {
  // 1. Settings -> Models & Profiles tab: sanitized profiles + star toggle closed loop
  let env_m = make_real_sf_env(dark=false)
  env_m.ctrl.set_sheet(app_state::ActiveSheet::Settings)
  env_m.ctrl.set_settings_tab(1)
  let t_m = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env_m.ctrl) },
    width=1280.0,
    height=820.0,
    theme=lg::ui_theme,
  )
  t_m.run_shown(120.0)
  debug_assert(t_m.find("已接入账号与额度").is_some(), "profiles section rendered")
  debug_assert(t_m.find("alice@afk.surf").is_some(), "sanitized profile email rendered")
  debug_assert(t_m.find("sk-secret-must-be-stripped").is_none(), "API key MUST NEVER leak into UI")
  debug_assert(t_m.find("tok-secret-must-be-stripped").is_none(), "token MUST NEVER leak into UI")
  debug_assert(t_m.find("个人锁").is_none(), "zero personal-lock wording")
  debug_assert(t_m.scroll_faults().length() == 0, "models tab must have 0 scroll faults")
  lg::assert_no_nested_glass(t_m, label="sf_3b_models", allow_large_overlay=true)
  lg::assert_apple_ui(t_m, label="sf_3b_models", allow_large_overlay=true)

  // Toggle star on an unstarred model (`openai/gpt-6.2-sol`)
  let mut was_starred = true
  let ms_before = env_m.ctrl.models_sig.untracked()
  for i in 0..<ms_before.length() {
    if ms_before[i].id == "openai/gpt-6.2-sol" {
      was_starred = ms_before[i].starred
    }
  }
  debug_assert(!was_starred, "gpt-6.2-sol starts unstarred")
  let toggled_on = env_m.ctrl.toggle_model_star("openai/gpt-6.2-sol")
  debug_assert(toggled_on, "toggle_model_star returns true")
  t_m.run_shown(80.0)
  let mut now_starred = false
  let ms_after = env_m.ctrl.models_sig.untracked()
  for i in 0..<ms_after.length() {
    if ms_after[i].id == "openai/gpt-6.2-sol" {
      now_starred = ms_after[i].starred
    }
  }
  debug_assert(now_starred, "gpt-6.2-sol is now starred in models_sig")
  t_m.dispose()

  // 2. Settings -> Fleet & Stations tab: workspace summary + online/offline stations + downloads
  let env_f = make_real_sf_env(dark=false)
  env_f.ctrl.set_sheet(app_state::ActiveSheet::Settings)
  env_f.ctrl.set_settings_tab(2)
  let t_f = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env_f.ctrl) },
    width=1280.0,
    height=820.0,
    theme=lg::ui_theme,
  )
  t_f.run_shown(120.0)
  debug_assert(t_f.find("工作区概览").is_some(), "fleet overview section rendered")
  debug_assert(t_f.find("站点状态").is_some(), "stations status section rendered")
  debug_assert(t_f.find("Tokyo Mac Studio").is_some(), "online station rendered")
  debug_assert(t_f.find("SGP Standby Node").is_some(), "offline station rendered")
  debug_assert(t_f.find("文件下载").is_some(), "active downloads section rendered")
  debug_assert(t_f.find("metal-frame-trace.gputrace.zip").is_some(), "download title stripped of prefix")
  debug_assert(t_f.scroll_faults().length() == 0, "fleet tab must have 0 scroll faults")
  lg::assert_no_nested_glass(t_f, label="sf_3b_fleet", allow_large_overlay=true)
  lg::assert_apple_ui(t_f, label="sf_3b_fleet", allow_large_overlay=true)
  t_f.dispose()

  // 3. SearchSheet -> Search / Archive (only archived=1) / Presets (`copy_preset`)
  let env_s = make_real_sf_env(dark=false)
  env_s.ctrl.set_sheet(app_state::ActiveSheet::Search)
  let t_s = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env_s.ctrl) },
    width=1280.0,
    height=820.0,
    theme=lg::ui_theme,
  )
  t_s.run_shown(120.0)
  debug_assert(t_s.find("搜索与归档").is_some(), "search modal header rendered")
  debug_assert(t_s.find("Invar 原生客户端架构迁移").is_some(), "active chat found in search")
  debug_assert(t_s.scroll_faults().length() == 0, "search tab must have 0 scroll faults")
  lg::assert_no_nested_glass(t_s, label="sf_3b_search", allow_large_overlay=true)
  lg::assert_apple_ui(t_s, label="sf_3b_search", allow_large_overlay=true)

  // Switch to Archive tab (only archived=1 chats)
  env_s.ctrl.set_search_tab(1)
  t_s.run_shown(80.0)
  debug_assert(t_s.find("阶段 2 协议边界冻结复盘").is_some(), "archived chat rendered in Archive tab")
  debug_assert(t_s.find("Invar 原生客户端架构迁移").is_none() || env_s.ctrl.archive_sig.untracked().total == 2, "archive strictly contains only archived=1 chats")
  debug_assert(env_s.ctrl.archive_sig.untracked().total == 2, "exactly 2 archived chats")

  // Switch to Presets tab -> click `复制为个人预设`
  env_s.ctrl.set_search_tab(2)
  t_s.run_shown(80.0)
  debug_assert(t_s.find("Invar Apple HIG 严审助手").is_some(), "own preset rendered")
  debug_assert(t_s.find("Mesh 弱网压测与回归套件").is_some(), "team shared preset rendered")
  debug_assert(env_s.ctrl.presets_sig.untracked().own.length() == 1, "starts with 1 own preset")
  t_s.press("复制为个人预设")
  t_s.run_shown(80.0)
  debug_assert(env_s.ctrl.presets_sig.untracked().own.length() == 2, "copy_preset added preset to viewer own presets")
  t_s.dispose()

  // 4. SignInView -> OAuth PKCE `auth.begin` (zero verifier exposure) + `auth.cancel` recovery
  let env_a = make_real_sf_env(dark=false)
  env_a.ctrl.set_signed_in(false)
  let t_a = ui::Tester::tree(
    fn(root : view::View) -> Unit { sf_app_root(root, env_a.ctrl) },
    width=1280.0,
    height=820.0,
    theme=lg::ui_theme,
  )
  t_a.run_shown(120.0)
  debug_assert(t_a.find("登录 still.fail").is_some(), "sign-in title rendered")
  debug_assert(t_a.find("使用浏览器登录（OAuth PKCE）").is_some(), "OAuth PKCE capsule button rendered")
  debug_assert(t_a.find("使用通行密钥（Passkey）").is_some(), "Passkey capsule button rendered")
  debug_assert(t_a.scroll_faults().length() == 0, "sign-in view must have 0 scroll faults")
  lg::assert_no_nested_glass(t_a, label="sf_3b_signin")
  lg::assert_apple_ui(t_a, label="sf_3b_signin")

  t_a.press("使用浏览器登录（OAuth PKCE）")
  t_a.run_shown(80.0)
  debug_assert(env_a.ctrl.auth_flow_sig.untracked().phase == "pending_oauth", "auth.begin transitioned to pending_oauth")
  debug_assert(t_a.find("等待浏览器完成授权").is_some(), "pending OAuth status displayed")
  debug_assert(t_a.find("code_verifier").is_none(), "PKCE verifier must NEVER appear in UI")
  debug_assert(t_a.find("verifier").is_none(), "verifier wording must NEVER appear in UI")

  t_a.press("取消登录")
  t_a.run_shown(80.0)
  debug_assert(env_a.ctrl.auth_flow_sig.untracked().phase == "failed", "auth.cancel transitioned to failed/cancelled")
  debug_assert(t_a.find("登录已取消").is_some(), "cancel message displayed")
  debug_assert(t_a.find("可随时重新发起登录").is_some(), "recovery hint displayed")
  t_a.dispose()
}

test "sf_ui_5_stage3b_metal_offscreen_4_shots" {
  debug_assert(film::is_supported(), "Apple macOS Metal offscreen rendering must be supported")

  // Shot 1: Settings -> Models & Profiles (1280x820 @2x)
  let env1 = make_real_sf_env(dark=false)
  env1.ctrl.set_sheet(app_state::ActiveSheet::Settings)
  env1.ctrl.set_settings_tab(1)
  let ok1 = film::picture(
    fn(root : view::View) -> Unit { sf_app_root(root, env1.ctrl) },
    path="/tmp/sf_ui_shots_3b/sf-3b-models-light.png",
    w=1280.0,
    h=820.0,
    scale=2.0,
    dark=false,
    at=150.0,
    theme=lg::ui_theme,
  )
  debug_assert(ok1, "sf-3b-models-light.png Metal snapshot must succeed")

  // Shot 2: Settings -> Fleet & Stations (1280x820 @2x)
  let env2 = make_real_sf_env(dark=false)
  env2.ctrl.set_sheet(app_state::ActiveSheet::Settings)
  env2.ctrl.set_settings_tab(2)
  let ok2 = film::picture(
    fn(root : view::View) -> Unit { sf_app_root(root, env2.ctrl) },
    path="/tmp/sf_ui_shots_3b/sf-3b-fleet-light.png",
    w=1280.0,
    h=820.0,
    scale=2.0,
    dark=false,
    at=150.0,
    theme=lg::ui_theme,
  )
  debug_assert(ok2, "sf-3b-fleet-light.png Metal snapshot must succeed")

  // Shot 3: Search / Archive / Presets Modal (1280x820 @2x)
  let env3 = make_real_sf_env(dark=false)
  env3.ctrl.set_sheet(app_state::ActiveSheet::Search)
  let ok3 = film::picture(
