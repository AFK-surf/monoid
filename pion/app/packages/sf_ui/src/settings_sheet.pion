      fn() -> Array[String] {
        let ps = ctrl.presets_sig.get().own
        let ks : Array[String] = []
        for i in 0..<ps.length() {
          ks.push(ps[i].id)
        }
        ks
      },
      fn(k : String) -> String { k },
      fn(row_slot : view::View, id_sig : signals::Signal[String]) -> Unit {
        let pid = id_sig.untracked()
        let ps = ctrl.presets_sig.untracked().own
        let mut idx = -1
        for i in 0..<ps.length() {
          if ps[i].id == pid {
            idx = i
            break
          }
        }
        if idx < 0 {
          return
        }
        let p = ps[idx]
        if idx > 0 {
          let _ = HairlineSep(row_slot)
        }
        let _ = <ui::Row in={row_slot} pad_x={16.0} pad_y={10.0} align={.Middle} gap={10.0} rigid>
          <ui::Col grow={1.0} min_width={0.0} gap={2.0}>
            <ui::Text size={14.0} weight={500} lines={1} color_by=>{lg::surface().ink} text={p.name} />
