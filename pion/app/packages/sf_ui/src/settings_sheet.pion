            prominent
            height={32.0}
            pad_x={14.0}
            on_press=>{ let _ = ctrl.copy_preset(pid) }
          />
        </ui::Row>
      },
      at_once=true,
    )
  })
  parent
}

fn PresetsTab(parent : view::View, ctrl~ : app_state::AppController) -> view::View {
  let _ = <ui::Col in={parent} gap={18.0} min_width={0.0}>
    <lg::SurfaceSection header="我的个人预设" radius={14.0}>
      <ui::Show when=>{ctrl.presets_sig.get().own.length() == 0} at_once>
        <ui::Row pad_x={16.0} pad_y={14.0} align={.Middle} gap={8.0}>
          <ui::Text size={13.5} color_by=>{lg::surface().ink_secondary} text="暂未创建个人预设，可从下方团队预设复制" />
        </ui::Row>
      </ui::Show>
      <OwnPresetRows ctrl={ctrl} />
    </lg::SurfaceSection>

    <ui::Show when=>{ctrl.presets_sig.get().others.length() > 0} at_once>
      <lg::SurfaceSection header="工作区其他预设（只读，可复制）" radius={14.0}>
        <OtherPresetRows ctrl={ctrl} />
      </lg::SurfaceSection>
    </ui::Show>
  </ui::Col>
  parent
}

/// Mount the Apple HIG Search / Archive / Personal Presets Modal Sheet.
/// Uses flat SearchBar + flat full-width Segmented (zero nested glass, no mobile grabber on desktop).
pub fn render_search_sheet(parent : view::View, ctrl : app_state::AppController) -> Unit {
  let open_fn = fn() -> Bool { ctrl.sheet_sig.get() == app_state::ActiveSheet::Search }
  let on_close = fn() -> Unit { ctrl.set_sheet(app_state::ActiveSheet::None) }
  let search_field = ui::Field::new()

  let _ = parent.box(fn(host : view::View) -> Unit {
    let _ = host.over(view::Live::Is(true)).points(view::Live::By(open_fn))
    host.show(
      open_fn,
      fn(overlay : view::View) -> Unit {
        let is_wide = fn() -> Bool {
          let ww = overlay.window_w()
          ww <= 0.0 || ww >= 760.0
        }
        let _ = overlay
        .over(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::By(fn() { if is_wide() { view::Lies::Middle } else { view::Lies::End } }))

        let _ = overlay.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::By(fn() { lg::colors().scrim }))
        })

        let _ = headless::dialog(
          overlay,
          fn() { "搜索与归档" },
          open_fn,
          on_close,
          fn(dlg : view::View, _d : headless::Dialog) -> Unit {
            let _ = dlg
            .width(view::Live::By(fn() { if is_wide() { Some(600.0) } else { Some(overlay.window_w() - 16.0) } }))
            .max_width(view::Live::Is(Some(600.0)), within=true)
            .max_height(view::Live::Is(Some(680.0)))
            .clips(view::Live::Is(true))
            .ground(view::Live::By(fn() { lg::surface().grouped_bg }))
            let _ = lg::liquid_sheet_surface_decorate(
              dlg,
              radius=lg::r_sheet,
              active=open_fn,
              solid=fn() { lg::surface().grouped_bg },
            )

            // Mobile-only top grabber
            dlg.show(
              fn() { !is_wide() },
              fn(grab_wrap : view::View) -> Unit {
                let _ = grab_wrap
                .padding(view::Live::Is((0.0, 8.0, 0.0, 0.0)))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .rigid()
                let _ = grab_wrap.box(fn(bar : view::View) -> Unit {
                  let _ = bar
                  .width(view::Live::Is(Some(36.0)))
                  .height(view::Live::Is(Some(4.5)))
                  .radius(view::Live::Is(2.25))
                  .ground(view::Live::By(fn() { lg::surface().separator_strong }))
                })
              },
              at_once=true,
            )

            // Header bar + flat SearchBar + full-width flat Segmented
            let _ = dlg.box(fn(hdr_col : view::View) -> Unit {
              let _ = hdr_col
              .padding(view::Live::Is((16.0, 14.0, 16.0, 12.0)))
              .gap(view::Live::Is(12.0))
              .rigid()
              let _ = <ui::Row in={hdr_col} align={.Middle} gap={10.0} rigid>
                <ui::Col grow={1.0} min_width={0.0} gap={2.0}>
                  <ui::Text size={18.0} weight={600} lines={1} color_by=>{lg::surface().ink} text="搜索与归档" />
                  <ui::Text size={12.5} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{ctrl.workspace_name_sig.get()} />
                </ui::Col>
                <SheetCloseBtn on_close={on_close} />
              </ui::Row>
              let _ = lg::liquid_search_bar_node(
                hdr_col,
                search_field,
                placeholder="搜索对话、消息或归档记录…",
                height_by=fn() { 36.0 },
                label=fn() { "搜索" },
                edited=fn(s : String) -> Unit { ctrl.set_search_query(s) },
                submitted=fn(s : String) -> Unit { ctrl.set_search_query(s) },
                on_clear=fn() -> Unit { ctrl.set_search_query("") },
                flat=true,
              )
              let _ = <lg::Segmented
                in={hdr_col}
                flat
                labels={["搜索对话", "已归档", "个人预设"]}
                selected_by=>{ctrl.search_tab_sig.get()}
                on_select={fn(i : Int) -> Unit { ctrl.set_search_tab(i) }}
                width={568.0}
                height={32.0}
              />
            })

            // Scrollable Inset Grouped content
            let _ = dlg.box(fn(body_wrap : view::View) -> Unit {
              let _ = body_wrap
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .min_height(view::Live::Is(Some(0.0)))
              let sc = ui::scroll_box(
                body_wrap,
                fn(inner : view::View) -> Unit {
                  let _ = inner
                  .width_share(view::Live::Is(1.0))
                  .padding(view::Live::Is((16.0, 2.0, 16.0, 16.0)))
                  let _ = <ui::Show in={inner} when=>{ctrl.search_tab_sig.get() == 0} at_once>
                    <SearchChatsTab ctrl={ctrl} />
                  </ui::Show>
                  let _ = <ui::Show in={inner} when=>{ctrl.search_tab_sig.get() == 1} at_once>
                    <ArchiveTab ctrl={ctrl} />
                  </ui::Show>
                  let _ = <ui::Show in={inner} when=>{ctrl.search_tab_sig.get() == 2} at_once>
                    <PresetsTab ctrl={ctrl} />
                  </ui::Show>
                },
                fill=true,
              )
              let _ = sc.min_height(view::Live::Is(Some(0.0)))
            })
          },
        )
      },
      at_once=true,
    )
  })
}
