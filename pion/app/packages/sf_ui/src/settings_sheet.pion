          <lg::Button
            label="复制副本"
            flat
            height={32.0}
            pad_x={14.0}
            on_press=>{ let _ = ctrl.copy_preset(pid) }
          />
        </ui::Row>
      },
      at_once=true,
    )
  })
  parent
}

