fn demo_card_chat_json(st : String, now : Int64) -> String {
  base_codec::json_stringify(base_codec::json_obj([
    ("id", base_codec::json_str("c-1")),
    ("station", base_codec::json_str(st)),
    ("thread", base_codec::json_int(101)),
    ("title", base_codec::json_str("原生客户端预览版发布")),
    ("lastActive", base_codec::json_int64(now)),
    (
      "card",
      base_codec::json_obj([
        ("seq", base_codec::json_int(4)),
        ("ts", base_codec::json_str("1795458000.000004")),
        ("prompt", base_codec::json_str("确认是否发布本次原生客户端预览版？")),
        (
          "card",
          base_codec::json_obj([
            ("type", base_codec::json_str("options")),
            ("assignee", base_codec::json_str("alice@example.com")),
            (
              "options",
              base_codec::json_arr([
                base_codec::json_obj([
                  ("label", base_codec::json_str("立即发布预览版")),
                  ("action", base_codec::json_str("reply")),
                ]),
                base_codec::json_obj([
                  ("label", base_codec::json_str("暂缓并继续观察")),
                  ("action", base_codec::json_str("close")),
                ]),
              ]),
            ),
          ]),
        ),
      ]),
    ),
  ]))
}

pub struct DemoApp {
  pub rt : effect::Runtime
  pub db : DemoDb
  pub station : DemoStation
  pub ctrl : app_state::AppController
}

pub fn DemoApp::new(verify_lock~ : Bool = true, live~ : Bool = true) -> DemoApp {
  let rt = effect::Runtime::new()
  let demo_db = DemoDb::new(rt)
  let db = match sql::Sql::open(demo_db.sh, "acct-demo") {
    sql::SqlResult::Ok(d) => d
    sql::SqlResult::Err(e) => panic("sql open failed: " + e.to_string())
  }
  let station = DemoStation::new(rt)
  let st = "tokyo-mac-studio-0"
  let now = 5000.to_int64()

  // Seed real `chat` row with pending card for thread 101 so `AppController` projects it from SQLite
  demo_db.put_chat(DemoChatRow::{
    station: st,
    archived: 0,
    id: "c-1",
    ord: 1.0,
    thread: Some(101),
    pinned_at: Some(now),
    last_active: now,
    json: demo_card_chat_json(st, now),
  })

  demo_db.put_entry(
    st,
    101,
    1,
    entry_json(1, "person", "alice@example.com", "请帮我核对新客户端的桌面双栏、移动单栏与安全模式页面，确认交互和视觉都已就绪。"),
  )
  demo_db.put_entry(
    st,
    101,
    2,
    entry_json(
      2,
      "agent",
      "Gemini 4",
      "已完成桌面双栏与移动单栏适配，侧边栏分组搜索、消息气泡与设置面板均已联通实时状态并完成多帧率校验。",
    ),
  )
  demo_db.put_entry(
    st,
    101,
    3,
    entry_json(3, "system", "系统", "工作区安全模式锁链已在本地完成校验。"),
  )
  demo_db.put_entry(
    st,
    101,
    4,
    entry_json(
      4,
      "agent",
      "Gemini 4",
      "全部自动化校验与原生离屏样张均已通过，请确认是否立即发布本次预览版。",
    ),
  )

  demo_db.put_entry(
    st,
    102,
    1,
    entry_json(1, "person", "alice@example.com", "检查双活备用链路切换耗时与断线重连日志。"),
  )
  demo_db.put_entry(
    st,
    102,
    2,
    entry_json(2, "agent", "Claude Opus", "双活备用竞速 55 项基础测试全部通过，首包延迟稳定在 18ms 内。"),
  )

  demo_db.put_entry(
    st,
    103,
    1,
    entry_json(1, "person", "bob@example.com", "确认本周发版前的核心闭环测试覆盖率。"),
  )
  demo_db.put_entry(
    st,
    103,
    2,
    entry_json(2, "agent", "Codex", "所有核心状态闭环均已在多帧率下全部通过。"),
  )

  demo_db.put_entry(
    st,
    104,
    1,
    entry_json(1, "system", "系统", "edge-backup-0 当前离线，展示本地缓存历史记录。"),
  )

  let ctrl = app_state::AppController::new(
    "Monoid Studio",
    st,
    rt,
    db,
    station.transport(),
    initial_chats=demo_chats(),
    viewer="alice@example.com",
  )
  let _ = ctrl.open_initial(101, now)
  ctrl.refresh_decision_from_store(101)
  ctrl.unread_divider_before_sig.set(4)
  if live {
    ctrl.start_live()
    rt.advance(30)
  }
  if verify_lock {
    let (entries, root_hash) = build_demo_lock("Monoid Studio")
    let _ = ctrl.core.apply_lock_chain(entries, root_hash)
  }
  ctrl.drain_core_events()
  DemoApp::{ rt, db: demo_db, station, ctrl }
}
