// Station storage manifest, in-place log rotation, upkeep-state persistence, and bounded
// Upkeep governance (`station/src/ops/storage.ts` & `station/src/ops/upkeep-state.ts`).
//
// Invariants (`station/src/ops/AGENTS.md`):
// - Never rename or unlink a log held open with O_APPEND; truncate in place (`rotate_in_place`).
// - Worktree pruning strictly respects `<data>/sessions` boundaries and `ARCHIVE_WORKTREE_LOCK_PREFIX`.

import "base_codec"
import "nodepath"

pub let MIB : Int64 = (1024 * 1024).to_int64()
pub let HOUR_MS : Int64 = 3600000.to_int64()
pub let DAY_MS : Int64 = (24 * 3600000).to_int64()

pub let STATION_LOG_CAP : Int64 = 64.to_int64() * MIB
pub let UPDATE_LOG_CAP : Int64 = 16.to_int64() * MIB
pub let JOB_LOG_CAP : Int64 = 64.to_int64() * MIB
pub let WAL_CAP : Int64 = 128.to_int64() * MIB
pub let THUMBS_CAP : Int64 = 512.to_int64() * MIB
pub let CONFIG_BACKUPS_KEPT : Int = 3
pub let NODE_PART_MS : Int64 = DAY_MS
pub let BOARD_FILES_GONE_MS : Int64 = DAY_MS
pub let ORPHAN_ROOM_MS : Int64 = DAY_MS
pub let ORPHAN_ROOM_EVERY_MS : Int64 = DAY_MS
pub let REPO_BRANCHES_EVERY_MS : Int64 = DAY_MS
pub let REPO_BUNDLE_MS : Int64 = 30.to_int64() * DAY_MS
pub let UPKEEP_EVERY_MS : Int64 = (10 * 60000).to_int64()
pub let UPKEEP_FIRST_MS : Int64 = (2 * 60000).to_int64()

pub let UPKEEP_STATE_FILE : String = "upkeep-state.json"
pub let IDLE_MEASURED_MAX : Int = 4096
pub let IDLE_MEASURED_VERSION : Int = 2
pub let ARCHIVE_WORKTREE_LOCK_PREFIX : String = "archived workspace: "

// ---------------------------------------------------------------------------
// STORAGE_MANIFEST
// ---------------------------------------------------------------------------

pub enum StorageClass {
  Authoritative
  SessionBound
  BoundedEphemeral
}

pub fn storage_class_name(c : StorageClass) -> String {
  match c {
    StorageClass::Authoritative => "authoritative"
    StorageClass::SessionBound => "session-bound"
    StorageClass::BoundedEphemeral => "bounded-ephemeral"
  }
}

pub struct StorageEntry {
  pub name : String
  pub class : StorageClass
  pub what : String
  pub max_bytes : Option[Int64]
  pub max_age_ms : Option[Int64]
  pub reclaim : String
}

fn se_auth(name : String, what : String, reclaim : String = "") -> StorageEntry {
  StorageEntry::{
    name: name,
    class: StorageClass::Authoritative,
    what: what,
    max_bytes: None,
    max_age_ms: None,
    reclaim: reclaim,
  }
}

fn se_sess(name : String, what : String, reclaim : String) -> StorageEntry {
  StorageEntry::{
    name: name,
    class: StorageClass::SessionBound,
    what: what,
    max_bytes: None,
    max_age_ms: None,
    reclaim: reclaim,
  }
}

fn se_eph(
  name : String,
  what : String,
  max_bytes : Option[Int64],
  max_age_ms : Option[Int64],
  reclaim : String,
) -> StorageEntry {
  StorageEntry::{
    name: name,
    class: StorageClass::BoundedEphemeral,
    what: what,
    max_bytes: max_bytes,
    max_age_ms: max_age_ms,
    reclaim: reclaim,
  }
}

