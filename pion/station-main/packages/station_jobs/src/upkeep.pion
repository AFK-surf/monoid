/// Glob matching supporting `*` wildcards (for `config.json.bak-*`, `comma-stats.db-*`, etc.).
pub fn glob_match(pattern : String, text : String) -> Bool {
  let pr = pattern.to_bytes()
  let tr = text.to_bytes()
  let pn = pr.length()
  let tn = tr.length()
  let mut pi = 0
  let mut ti = 0
  let mut star_pi = -1
  let mut star_ti = 0
  while ti < tn {
    if pi < pn && (pr[pi].to_int() & 0xFF) == 42 { // '*'
      star_pi = pi
      star_ti = ti
      pi = pi + 1
    } else if pi < pn && pr[pi] == tr[ti] {
      pi = pi + 1
      ti = ti + 1
    } else if star_pi >= 0 {
      pi = star_pi + 1
      star_ti = star_ti + 1
      ti = star_ti
    } else {
      return false
    }
  }
  while pi < pn && (pr[pi].to_int() & 0xFF) == 42 {
    pi = pi + 1
  }
  pi == pn
}

/// Looks up the manifest entry for a top-level `<data>` name.
pub fn storage_entry(name : String) -> Option[StorageEntry] {
  let entries = storage_manifest()
  for i in 0..<entries.length() {
    let e = entries[i]
    if glob_match(e.name, name) {
      return Some(e)
    }
  }
  None
}

// ---------------------------------------------------------------------------
// Streaming 1 MiB chunked 2-pass in-place log rotation (`rotateInPlace`)
// ---------------------------------------------------------------------------

/// Copies the tail `keep` bytes of `path` in `chunk_size` (default 1 MiB) chunks across 2 passes
/// to `<path>.1.tmp` (mode 0600) so concurrent O_APPEND writers' tail writes are captured,
/// renames `<path>.1.tmp` -> `<path>.1`, and truncates `path` in place (same inode).
pub fn rotate_in_place(
  fs : FsPort,
  path : String,
  cap : Int64,
  keep : Int64 = -1.to_int64(),
  chunk_size : Int64 = ROTATE_COPY_CHUNK,
) -> Result[Bool, String] {
  let keep_bytes = if keep < 0.to_int64() { cap } else { keep }
  let step_chunk = if chunk_size > 0.to_int64() { chunk_size } else { ROTATE_COPY_CHUNK }
  let initial_st = match (fs.stat)(path) {
    Some(s) => s
    None => return Ok(false)
  }
  let mut size = initial_st.size
  if size <= cap {
    return Ok(false)
  }
  let tmp = path + ".1.tmp"
  let dst = path + ".1"
  // Create/truncate temp file with mode 0600.
  if !(fs.write_file_mode)(tmp, Bytes::new(0), 384, false) {
    let _ = (fs.remove_file)(tmp)
    return Err("failed to create rotation temp file: " + tmp)
  }
  let mut at = if size > keep_bytes { size - keep_bytes } else { 0.to_int64() }
  // Pass 0 copies up to initial size; pass 1 catches bytes appended while pass 0 ran.
  for _pass in 0..<2 {
    while at < size {
      let rem = size - at
      let to_read = if rem > step_chunk { step_chunk } else { rem }
      let chunk = match (fs.read_range)(path, at, to_read) {
        Some(b) => b
        None => {
          let _ = (fs.remove_file)(tmp)
          return Err("failed to read chunk during rotation: " + path)
        }
      }
      if chunk.length() == 0 {
        break
      }
      if !(fs.write_file_mode)(tmp, chunk, 384, true) {
        let _ = (fs.remove_file)(tmp)
        return Err("failed to append rotation chunk: " + tmp)
      }
      at = at + chunk.length().to_int64()
    }
    match (fs.stat)(path) {
      Some(st2) => size = st2.size
      None => break
    }
  }
  if !(fs.rename)(tmp, dst) {
    let _ = (fs.remove_file)(tmp)
    return Err("failed to rename rotation temp file: " + tmp)
  }
  if !(fs.truncate_in_place)(path) {
    return Err("failed to truncate log in place: " + path)
  }
  Ok(true)
}

// ---------------------------------------------------------------------------
// Bounded cleanup primitives (`keepNewest`, `removeStale`, `capByAge`, etc.)
// ---------------------------------------------------------------------------

struct DatedName {
  name : String
  mtime_ms : Int64
}

pub fn keep_newest(fs : FsPort, dir : String, prefix : String, kept : Int) -> Array[String] {
  let names = match (fs.read_dir)(dir) {
    Some(ns) => ns
    None => return []
  }
  let dated : Array[DatedName] = []
  for i in 0..<names.length() {
    let n = names[i]
    if !sj_starts_with(n, prefix) {
      continue
    }
    let p = nodepath::join(fs.sep, [dir, n])
    let mtime = match (fs.stat)(p) {
      Some(st) => st.mtime_ms
      None => 0.to_int64()
    }
    dated.push(DatedName::{ name: n, mtime_ms: mtime })
  }
  for i in 1..<dated.length() {
    let cur = dated[i]
    let mut j = i - 1
    while j >= 0 && dated[j].mtime_ms < cur.mtime_ms {
      dated[j + 1] = dated[j]
      j = j - 1
    }
    dated[j + 1] = cur
  }
  let gone : Array[String] = []
  let start = if kept < 0 { 0 } else { kept }
  for i in start..<dated.length() {
    let n = dated[i].name
    let p = nodepath::join(fs.sep, [dir, n])
    let _ = (fs.remove_dir_all)(p)
    gone.push(n)
  }
  gone
}

pub fn remove_stale(
  fs : FsPort,
  dir : String,
  prefix : String,
  max_age_ms : Int64,
  now_ms : Int64,
) -> Array[String] {
  let names = match (fs.read_dir)(dir) {
    Some(ns) => ns
    None => return []
  }
  let gone : Array[String] = []
  for i in 0..<names.length() {
    let n = names[i]
    if !sj_starts_with(n, prefix) {
      continue
    }
    let p = nodepath::join(fs.sep, [dir, n])
    let st = match (fs.lstat)(p) {
      Some(s) => s
      None => continue
    }
    if now_ms - st.mtime_ms < max_age_ms {
      continue
    }
    let _ = (fs.remove_dir_all)(p)
    gone.push(n)
  }
  gone
}

struct AgedFile {
  path : String
  bytes : Int64
  mtime_ms : Int64
}

pub fn cap_by_age(fs : FsPort, dir : String, max_bytes : Int64) -> Int64 {
  let names = match (fs.read_dir)(dir) {
    Some(ns) => ns
    None => return 0.to_int64()
  }
  let files : Array[AgedFile] = []
  let mut total : Int64 = 0.to_int64()
  for i in 0..<names.length() {
    let p = nodepath::join(fs.sep, [dir, names[i]])
    let st = match (fs.lstat)(p) {
      Some(s) => s
      None => continue
    }
    if !st.is_file() || st.is_symlink() {
      continue
    }
    total = total + st.size
    files.push(AgedFile::{ path: p, bytes: st.size, mtime_ms: st.mtime_ms })
  }
  if total <= max_bytes {
    return 0.to_int64()
  }
  for i in 1..<files.length() {
    let cur = files[i]
    let mut j = i - 1
    while j >= 0 && files[j].mtime_ms > cur.mtime_ms {
      files[j + 1] = files[j]
      j = j - 1
    }
    files[j + 1] = cur
  }
  let mut freed : Int64 = 0.to_int64()
  for i in 0..<files.length() {
    if total <= max_bytes {
      break
    }
    let f = files[i]
    let _ = (fs.remove_file)(f.path)
    total = total - f.bytes
    freed = freed + f.bytes
  }
  freed
}

pub fn gone_board_files(
  fs : FsPort,
  dir : String,
  max_age_ms : Int64,
  now_ms : Int64,
) -> Array[String] {
  let people = match (fs.read_dir)(dir) {
    Some(ns) => ns
    None => return []
  }
  let gone : Array[String] = []
  for pi in 0..<people.length() {
    let person = people[pi]
    let aside = nodepath::join(fs.sep, [dir, person, ".gone"])
    let drafts = match (fs.read_dir)(aside) {
      Some(ds) => ds
      None => continue
    }
    for di in 0..<drafts.length() {
      let draft = drafts[di]
      let draft_dir = nodepath::join(fs.sep, [aside, draft])
      let files = match (fs.read_dir)(draft_dir) {
        Some(fs_list) => fs_list
        None => continue
      }
      let mut left = files.length()
      for fi in 0..<files.length() {
        let f = files[fi]
        let fp = nodepath::join(fs.sep, [draft_dir, f])
        let st = match (fs.lstat)(fp) {
          Some(s) => s
          None => continue
        }
        if now_ms - st.mtime_ms < max_age_ms {
          continue
        }
        let _ = (fs.remove_dir_all)(fp)
        gone.push(person + "/" + draft + "/" + f)
        left = left - 1
      }
      if left == 0 {
        let _ = (fs.rmdir)(draft_dir)
      }
    }
  }
  gone
}

pub fn orphan_marks(fs : FsPort, dir : String) -> Array[String] {
  let names = match (fs.read_dir)(dir) {
    Some(ns) => ns
    None => return []
  }
  let gone : Array[String] = []
  for i in 0..<names.length() {
    let n = names[i]
    if !sj_ends_with(n, ".json") {
      continue
    }
    let file = nodepath::join(fs.sep, [dir, n])
    let target_opt : Option[String] = match (fs.read_file)(file) {
      Some(text) => {
        match base_codec::json_parse(text) {
          base_codec::JsonParseResult::Ok(j) => {
            match base_codec::json_get(j, "state") {
              Some(st) => {
                match base_codec::json_get(st, "path") {
                  Some(base_codec::Json::Str(p)) => Some(p)
                  _ => None
                }
              }
              None => None
            }
          }
          _ => None
        }
      }
      None => None
    }
    let still_there = match target_opt {
      Some(tp) => (fs.exists)(tp)
      None => false
    }
    if !still_there {
      let _ = (fs.remove_file)(file)
      gone.push(n)
    }
  }
  gone
}

/// Removes `.bundle` and `.txt` regular files under `<data>/repo-bundles/<clone>` older than
/// `max_age_ms`, skipping symlinks and dot-prefixed entries, and removing `<clone>` only when empty
/// (`station/src/ops/repo-branches.ts:382-412`).
pub fn prune_expired_repo_bundles(
  fs : FsPort,
  data_dir : String,
  now_ms : Int64,
  max_age_ms : Int64 = REPO_BUNDLE_MS,
) -> Array[String] {
  let real_data = match (fs.realpath)(data_dir) {
    Some(r) => r
    None => data_dir
  }
  let bundles_dir = nodepath::join(fs.sep, [real_data, "repo-bundles"])
  match (fs.lstat)(bundles_dir) {
    Some(st) => {
      if !st.is_dir() || st.is_symlink() {
        return []
      }
    }
    None => return []
  }
  let clones = match (fs.read_dir)(bundles_dir) {
    Some(cs) => cs
    None => return []
  }
  let gone : Array[String] = []
  for ci in 0..<clones.length() {
    let clone_name = clones[ci]
    if sj_starts_with(clone_name, ".") {
      continue
    }
    let clone_dir = nodepath::join(fs.sep, [bundles_dir, clone_name])
    match (fs.lstat)(clone_dir) {
      Some(st) => {
        if !st.is_dir() || st.is_symlink() {
          continue
        }
      }
      None => continue
    }
    let entries = match (fs.read_dir)(clone_dir) {
      Some(es) => es
      None => continue
    }
    let mut remaining = entries.length()
    for ei in 0..<entries.length() {
      let fname = entries[ei]
      if !sj_ends_with(fname, ".bundle") && !sj_ends_with(fname, ".txt") {
        continue
      }
      let fpath = nodepath::join(fs.sep, [clone_dir, fname])
      let st = match (fs.lstat)(fpath) {
        Some(s) => s
        None => continue
      }
      if !st.is_file() || st.is_symlink() {
        continue
      }
      if now_ms - st.mtime_ms < max_age_ms {
        continue
      }
      if (fs.remove_file)(fpath) {
        gone.push(clone_name + "/" + fname)
        remaining = remaining - 1
      }
    }
    if remaining <= 0 {
      match (fs.read_dir)(clone_dir) {
        Some(after) => {
          if after.length() == 0 {
            let _ = (fs.rmdir)(clone_dir)
          }
        }
        None => ()
      }
    }
  }
  gone
}

// ---------------------------------------------------------------------------
// Safe worktree registration pruning (`pruneRepoWorktrees`)
// ---------------------------------------------------------------------------

fn path_is_inside(sep : String, child : String, parent : String) -> Bool {
  let c = nodepath::join(sep, [child])
  let p = nodepath::join(sep, [parent])
  if c == p {
    return false
  }
  let prefix = if sj_ends_with(p, sep) { p } else { p + sep }
  sj_starts_with(c, prefix)
}

fn path_is_within(sep : String, child : String, parent : String) -> Bool {
  let c = nodepath::join(sep, [child])
  let p = nodepath::join(sep, [parent])
  c == p || path_is_inside(sep, c, p)
}

/// Resolves `raw_path` (or its longest existing ancestor when the leaf is gone) via `fs.realpath`
/// so macOS `/var` -> `/private/var` or symlinked data dirs are normalized accurately.
fn normalize_realpath_prefix(fs : FsPort, raw_path : String) -> Option[String] {
  let norm = nodepath::join(fs.sep, [raw_path])
  match (fs.realpath)(norm) {
    Some(rp) => return Some(rp)
    None => ()
  }
  // Walk up to the nearest existing ancestor and re-attach remaining suffix.
  let tail : Array[String] = []
  let mut cur = norm
  for _ in 0..<32 {
    let parent = nodepath::dirname(fs.sep, cur)
    if parent == cur || parent.length() == 0 {
      break
    }
    tail.push(nodepath::basename(fs.sep, cur))
    cur = parent
    match (fs.realpath)(cur) {
      Some(rp) => {
        let mut out = rp
        let mut i = tail.length() - 1
        while i >= 0 {
          out = nodepath::join(fs.sep, [out, tail[i]])
          i = i - 1
        }
        return Some(out)
      }
      None => ()
    }
  }
  None
}

/// Removes stale `<data>/repos/*/.git/worktrees/*` registrations pointing to gone paths:
/// - unlocked registrations whose `gitdir` target lies strictly inside local `<data>/sessions`;
/// - locked registrations whose `locked` file starts with `ARCHIVE_WORKTREE_LOCK_PREFIX`
///   (`"still.fail archived workspace: "`), where BOTH the archived room path and `gitdir` target
///   lie outside `realpath`-normalized local `<data>/sessions`.
pub fn prune_repo_worktrees(fs : FsPort, data_dir : String) -> Array[String] {
  let repos_raw = nodepath::join(fs.sep, [data_dir, "repos"])
  let real_repos = match (fs.realpath)(repos_raw) {
    Some(r) => r
    None => repos_raw
  }
  let raw_sessions = nodepath::join(fs.sep, [data_dir, "sessions"])
  let real_sessions = normalize_realpath_prefix(fs, raw_sessions)

  let within_local_sessions = fn(raw_p : String) -> Bool {
    let norm = nodepath::join(fs.sep, [raw_p])
    if path_is_within(fs.sep, norm, raw_sessions) {
      return true
    }
    match real_sessions {
      Some(rs) => {
        if path_is_within(fs.sep, norm, rs) {
          return true
        }
      }
      None => ()
    }
    match normalize_realpath_prefix(fs, norm) {
      Some(rp) => {
        if path_is_within(fs.sep, rp, raw_sessions) {
          return true
        }
        match real_sessions {
          Some(rs) => path_is_within(fs.sep, rp, rs)
          None => false
        }
      }
      None => false
    }
  }

  let inside_local_sessions = fn(raw_p : String) -> Bool {
    let norm = nodepath::join(fs.sep, [raw_p])
    if path_is_inside(fs.sep, norm, raw_sessions) {
      return true
    }
    match real_sessions {
      Some(rs) => {
        if path_is_inside(fs.sep, norm, rs) {
          return true
        }
      }
      None => ()
    }
    match normalize_realpath_prefix(fs, norm) {
      Some(rp) => {
        if path_is_inside(fs.sep, rp, raw_sessions) {
          return true
        }
        match real_sessions {
          Some(rs) => path_is_inside(fs.sep, rp, rs)
          None => false
        }
      }
      None => false
    }
  }

  let repos = match (fs.read_dir)(real_repos) {
    Some(rs) => rs
    None => return []
  }
  let gone : Array[String] = []
  for ri in 0..<repos.length() {
    let repo_name = repos[ri]
    if sj_starts_with(repo_name, ".") {
      continue
    }
    let repo_path = nodepath::join(fs.sep, [real_repos, repo_name])
    let repo_st = match (fs.lstat)(repo_path) {
      Some(s) => s
      None => continue
    }
    if !repo_st.is_dir() || repo_st.is_symlink() {
      continue
    }
    let wt_root = nodepath::join(fs.sep, [repo_path, ".git", "worktrees"])
    let wt_root_st = match (fs.lstat)(wt_root) {
      Some(s) => s
      None => continue
    }
    if !wt_root_st.is_dir() || wt_root_st.is_symlink() {
      continue
    }
    let wts = match (fs.read_dir)(wt_root) {
      Some(ws) => ws
      None => continue
    }
    for wi in 0..<wts.length() {
      let wt_name = wts[wi]
      let admin_dir = nodepath::join(fs.sep, [wt_root, wt_name])
      let admin_st = match (fs.lstat)(admin_dir) {
        Some(s) => s
        None => continue
      }
      if !admin_st.is_dir() || admin_st.is_symlink() {
        continue
      }
      let raw_target = match (fs.read_file)(nodepath::join(fs.sep, [admin_dir, "gitdir"])) {
        Some(t) => sj_trim(t)
        None => continue
      }
      if raw_target.length() == 0 || !nodepath::is_absolute(fs.sep, raw_target) {
        continue
      }
      let target = nodepath::join(fs.sep, [raw_target])
      let locked_path = nodepath::join(fs.sep, [admin_dir, "locked"])
      match (fs.lstat)(locked_path) {
        None => {
          if !inside_local_sessions(target) {
            continue
          }
        }
        Some(lst) => {
          if !lst.is_file() || lst.is_symlink() {
            continue
          }
          let locked_text = match (fs.read_file)(locked_path) {
            Some(t) => t
            None => continue
          }
          if !sj_starts_with(locked_text, ARCHIVE_WORKTREE_LOCK_PREFIX) {
            continue
          }
          let locked_room = sj_trim(
            sj_slice_str(locked_text, ARCHIVE_WORKTREE_LOCK_PREFIX.length(), locked_text.length()),
          )
          if locked_room.length() == 0 || !nodepath::is_absolute(fs.sep, locked_room) {
            continue
          }
          if within_local_sessions(locked_room) {
            continue
          }
          if within_local_sessions(raw_target) {
            continue
          }
        }
      }
      match (fs.lstat)(target) {
        Some(_) => continue
        None => ()
      }
      if (fs.remove_dir_all)(admin_dir) {
        gone.push(repo_name + "/" + wt_name)
      }
    }
  }
  gone
}

// ---------------------------------------------------------------------------
// `upkeep-state.json` persistence (`station/src/ops/upkeep-state.ts`)
// ---------------------------------------------------------------------------

pub struct UpkeepState {
  pub idle_measured_version : Int
  pub idle_measured_keys : Array[String]
  pub idle_measured_vals : Array[Int64]
  pub last_repo_branches_at : Option[Int64]
  pub last_orphan_rooms_at : Option[Int64]
  pub last_full_relieve_at : Option[Int64]
  pub last_archive_upkeep_at : Option[Int64]
}

pub struct UpkeepStatePatch {
  pub idle_measured : Option[(Array[String], Array[Int64])]
  pub last_repo_branches_at : Option[Option[Int64]]
  pub last_orphan_rooms_at : Option[Option[Int64]]
  pub last_full_relieve_at : Option[Option[Int64]]
  pub last_archive_upkeep_at : Option[Option[Int64]]
}

pub fn empty_upkeep_state() -> UpkeepState {
  UpkeepState::{
    idle_measured_version: IDLE_MEASURED_VERSION,
    idle_measured_keys: [],
    idle_measured_vals: [],
    last_repo_branches_at: None,
    last_orphan_rooms_at: None,
    last_full_relieve_at: None,
    last_archive_upkeep_at: None,
  }
}

pub fn empty_upkeep_patch() -> UpkeepStatePatch {
  UpkeepStatePatch::{
    idle_measured: None,
    last_repo_branches_at: None,
    last_orphan_rooms_at: None,
    last_full_relieve_at: None,
    last_archive_upkeep_at: None,
  }
}

fn json_opt_i64(j : base_codec::Json, key : String) -> Option[Int64] {
  match base_codec::json_get(j, key) {
    Some(base_codec::Json::Num(n, repr)) => {
      if repr.length() > 0 {
        match base_codec::parse_int64_str(repr) {
          Some(v) => Some(v)
          None => Some(n.to_int64())
        }
      } else {
        Some(n.to_int64())
      }
    }
    _ => None
  }
}

fn trim_idle_measured(
  keys : Array[String],
  vals : Array[Int64],
) -> (Array[String], Array[Int64]) {
  let n = if keys.length() < vals.length() { keys.length() } else { vals.length() }
  let start = if n > IDLE_MEASURED_MAX { n - IDLE_MEASURED_MAX } else { 0 }
  let ok : Array[String] = []
  let ov : Array[Int64] = []
  for i in start..<n {
    ok.push(keys[i])
    ov.push(vals[i])
  }
  (ok, ov)
}

pub fn parse_upkeep_state(text : String) -> UpkeepState {
  match base_codec::json_parse(text) {
    base_codec::JsonParseResult::Ok(j) => {
      match j {
        base_codec::Json::Obj(_) => {
          let ver = match json_opt_i64(j, "idleMeasuredVersion") {
            Some(v) => v.to_int()
            None => 1
          }
          let current_ver = ver == IDLE_MEASURED_VERSION
          let keys : Array[String] = []
          let vals : Array[Int64] = []
          if current_ver {
            match base_codec::json_get(j, "idleMeasured") {
              Some(base_codec::Json::Obj(fields)) => {
                for i in 0..<fields.length() {
                  let (k, v) = fields[i]
                  match v {
                    base_codec::Json::Num(num, repr) => {
                      let iv = if repr.length() > 0 {
                        match base_codec::parse_int64_str(repr) {
                          Some(x) => x
                          None => num.to_int64()
                        }
                      } else {
                        num.to_int64()
                      }
                      keys.push(k)
                      vals.push(iv)
                    }
                    _ => ()
                  }
                }
              }
              _ => ()
            }
          }
          let (tk, tv) = trim_idle_measured(keys, vals)
          UpkeepState::{
            idle_measured_version: if current_ver { IDLE_MEASURED_VERSION } else { 1 },
            idle_measured_keys: tk,
            idle_measured_vals: tv,
            last_repo_branches_at: json_opt_i64(j, "lastRepoBranchesAt"),
            last_orphan_rooms_at: json_opt_i64(j, "lastOrphanRoomsAt"),
            last_full_relieve_at: json_opt_i64(j, "lastFullRelieveAt"),
            last_archive_upkeep_at: json_opt_i64(j, "lastArchiveUpkeepAt"),
          }
        }
        _ => empty_upkeep_state()
      }
    }
    _ => empty_upkeep_state()
  }
}

fn opt_i64_json(v : Option[Int64]) -> base_codec::Json {
  match v {
    Some(n) => base_codec::json_int64(n)
    None => base_codec::json_null()
  }
}

pub fn serialize_upkeep_state(s : UpkeepState) -> String {
  let idle_fields : Array[(String, base_codec::Json)] = []
  let n = if s.idle_measured_keys.length() < s.idle_measured_vals.length() {
    s.idle_measured_keys.length()
  } else {
    s.idle_measured_vals.length()
  }
  for i in 0..<n {
    idle_fields.push((s.idle_measured_keys[i], base_codec::json_int64(s.idle_measured_vals[i])))
  }
  let obj = base_codec::json_obj([
    ("idleMeasuredVersion", base_codec::json_int(s.idle_measured_version)),
    ("idleMeasured", base_codec::json_obj(idle_fields)),
    ("lastRepoBranchesAt", opt_i64_json(s.last_repo_branches_at)),
    ("lastOrphanRoomsAt", opt_i64_json(s.last_orphan_rooms_at)),
    ("lastFullRelieveAt", opt_i64_json(s.last_full_relieve_at)),
    ("lastArchiveUpkeepAt", opt_i64_json(s.last_archive_upkeep_at)),
  ])
  base_codec::json_stringify(obj)
}

fn opt_i64_eq(a : Option[Int64], b : Option[Int64]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

pub fn same_upkeep_state(a : UpkeepState, b : UpkeepState) -> Bool {
  if a.idle_measured_version != b.idle_measured_version {
    return false
  }
  if !opt_i64_eq(a.last_repo_branches_at, b.last_repo_branches_at) {
    return false
  }
  if !opt_i64_eq(a.last_orphan_rooms_at, b.last_orphan_rooms_at) {
    return false
  }
  if !opt_i64_eq(a.last_full_relieve_at, b.last_full_relieve_at) {
    return false
  }
  if !opt_i64_eq(a.last_archive_upkeep_at, b.last_archive_upkeep_at) {
    return false
  }
  if a.idle_measured_keys.length() != b.idle_measured_keys.length() {
    return false
  }
  for i in 0..<a.idle_measured_keys.length() {
    if a.idle_measured_keys[i] != b.idle_measured_keys[i] {
      return false
    }
    if a.idle_measured_vals[i] != b.idle_measured_vals[i] {
      return false
    }
  }
  true
}

pub fn read_upkeep_state(fs : FsPort, data_dir : String) -> UpkeepState {
  let path = nodepath::join(fs.sep, [data_dir, UPKEEP_STATE_FILE])
  match (fs.read_file)(path) {
    Some(text) => parse_upkeep_state(text)
    None => empty_upkeep_state()
  }
}

pub fn patch_upkeep_state(
  fs : FsPort,
  data_dir : String,
  patch : UpkeepStatePatch,
  pid : Int,
) -> Bool {
  let path = nodepath::join(fs.sep, [data_dir, UPKEEP_STATE_FILE])
  let current = read_upkeep_state(fs, data_dir)
  let (next_keys, next_vals) = match patch.idle_measured {
    Some((ks, vs)) => trim_idle_measured(ks, vs)
    None => (current.idle_measured_keys, current.idle_measured_vals)
  }
  let next = UpkeepState::{
    idle_measured_version: IDLE_MEASURED_VERSION,
    idle_measured_keys: next_keys,
    idle_measured_vals: next_vals,
    last_repo_branches_at: match patch.last_repo_branches_at {
      Some(v) => v
      None => current.last_repo_branches_at
    },
    last_orphan_rooms_at: match patch.last_orphan_rooms_at {
      Some(v) => v
      None => current.last_orphan_rooms_at
    },
    last_full_relieve_at: match patch.last_full_relieve_at {
      Some(v) => v
      None => current.last_full_relieve_at
    },
    last_archive_upkeep_at: match patch.last_archive_upkeep_at {
      Some(v) => v
      None => current.last_archive_upkeep_at
    },
  }
  if same_upkeep_state(current, next) {
    return false
  }
  let tmp = path + "." + pid.to_string() + ".tmp"
  if !(fs.write_file_mode)(tmp, serialize_upkeep_state(next).to_bytes(), 384, false) {
    let _ = (fs.remove_file)(tmp)
    return false
  }
  if !(fs.rename)(tmp, path) {
    let _ = (fs.remove_file)(tmp)
    return false
  }
  true
}

// ---------------------------------------------------------------------------
// `Upkeep` coordinator
// ---------------------------------------------------------------------------

pub struct UpkeepHooks {
  pub on_runners : Option[(Int64) -> Unit]
  pub on_jobs : Option[(Int64) -> Unit]
  /// `(now_ms, disk_free_opt, disk_total_opt)` so remote upkeep can enforce `remote_budget`.
  pub on_remote : Option[(Int64, Option[Int64], Option[Int64]) -> Unit]
  pub on_checkpoint : Option[() -> Unit]
  pub on_repo_branches : Option[(Int64) -> Unit]
  pub on_orphan_rooms : Option[(Int64) -> Unit]
  pub disk_probe : Option[(String) -> ParsedDisk]
}

pub fn empty_upkeep_hooks() -> UpkeepHooks {
  UpkeepHooks::{
    on_runners: None,
    on_jobs: None,
    on_remote: None,
    on_checkpoint: None,
    on_repo_branches: None,
    on_orphan_rooms: None,
    disk_probe: None,
  }
}

/// Removes stale or orphaned `<data>/jobs/state/*.json` and `*.json.tmp` files whose job is
/// no longer active and past retention (`JOB_LOGS_KEPT_MS` for terminal records, `JOB_FILES_ORPHAN_MS`
/// for `.tmp` or unreadable files).
pub fn prune_stale_job_states(
  fs : FsPort,
  data_dir : String,
  now_ms : Int64,
  keep_ms : Int64 = 1209600000.to_int64(),
  orphan_ms : Int64 = 3600000.to_int64(),
) -> Array[String] {
  let state_dir = nodepath::join(fs.sep, [data_dir, "jobs", "state"])
  let names = match (fs.read_dir)(state_dir) {
    Some(ns) => ns
    None => return []
  }
  let gone : Array[String] = []
  for i in 0..<names.length() {
    let n = names[i]
    let full = nodepath::join(fs.sep, [state_dir, n])
    if sj_ends_with(n, ".json.tmp") {
      match (fs.lstat)(full) {
        Some(st) => {
          if now_ms - st.mtime_ms >= orphan_ms && (fs.remove_file)(full) {
            gone.push(n)
          }
        }
        None => ()
      }
      continue
    }
    if !sj_ends_with(n, ".json") {
      continue
    }
    let st = match (fs.lstat)(full) {
      Some(s) => s
      None => continue
    }
    if !st.is_file() || st.is_symlink() {
      continue
    }
    let should_remove = match (fs.read_file)(full) {
      Some(text) => {
        match base_codec::json_parse(text) {
          base_codec::JsonParseResult::Ok(j) => {
            let state_s = match base_codec::json_get(j, "state") {
              Some(base_codec::Json::Str(s)) => s
              _ => ""
            }
            if state_s == "queued" || state_s == "running" || state_s == "stopping" {
              false
            } else {
              let ref_ts = match json_opt_i64(j, "endedAt") {
                Some(t) => t
                None => st.mtime_ms
              }
              now_ms - ref_ts >= keep_ms
            }
          }
          _ => now_ms - st.mtime_ms >= orphan_ms
        }
      }
      None => now_ms - st.mtime_ms >= orphan_ms
    }
    if should_remove && (fs.remove_file)(full) {
      gone.push(n)
    }
  }
  gone
}

pub struct UpkeepReport {
  pub station_log_rotated : Bool
  pub update_log_rotated : Bool
  pub wal_checkpointed : Bool
  pub thumbs_freed : Int64
  pub node_parts_removed : Int
  pub config_backups_removed : Int
  pub orphan_marks_removed : Int
  pub board_files_removed : Int
  pub repo_worktrees_pruned : Int
  pub repo_bundles_pruned : Int
  pub job_states_pruned : Int
  pub state_persisted : Bool
}

pub enum UpkeepStep {
  Yielded(Int)
  Done(UpkeepReport)
}

/// Resumable cooperative cursor for `Upkeep::step_upkeep`, slicing directory scans & deletions
/// into chunks of at most `budget` entries (default `WALK_YIELD_EVERY = 256`) per event-loop turn.
pub struct UpkeepCursor {
  now_ms : Int64
  hooks : UpkeepHooks
  mut phase : Int
  mut thumbs_cursor : Option[WalkCursor]
  thumbs_files : Array[AgedFile]
  mut thumbs_total : Int64
  mut thumbs_freed : Int64
  mut station_log_rotated : Bool
  mut update_log_rotated : Bool
  mut wal_checkpointed : Bool
  mut node_parts_removed : Int
  mut config_backups_removed : Int
  mut orphan_marks_removed : Int
  mut board_files_removed : Int
  mut repo_worktrees_pruned : Int
  mut repo_bundles_pruned : Int
  mut job_states_pruned : Int
  pub mut processed : Int
  mut finished : Option[UpkeepReport]
}

pub struct Upkeep {
  pub data_dir : String
  pub pid : Int
  pub fs : FsPort
  pub mut state_loaded : Bool
  pub mut last_repo_branches_at : Option[Int64]
  pub mut last_orphan_rooms_at : Option[Int64]
}

pub fn Upkeep::new(data_dir : String, pid : Int, fs : FsPort) -> Upkeep {
  Upkeep::{
    data_dir: data_dir,
    pid: pid,
    fs: fs,
    state_loaded: false,
    last_repo_branches_at: None,
    last_orphan_rooms_at: None,
  }
}

/// Reclaims rebuildable caches more aggressively when disk is getting full.
pub fn Upkeep::renewables(self : Upkeep, now_ms : Int64) -> UpkeepReport {
  let thumbs_freed = cap_by_age(
    self.fs,
    nodepath::join(self.fs.sep, [self.data_dir, "thumbs"]),
    THUMBS_CAP / 4.to_int64(),
  )
  let node_parts = remove_stale(
    self.fs,
    nodepath::join(self.fs.sep, [self.data_dir, "node"]),
    ".part-",
    HOUR_MS,
    now_ms,
  )
  let cfg_baks = keep_newest(self.fs, self.data_dir, "config.json.bak-", CONFIG_BACKUPS_KEPT)
  let marks = orphan_marks(
    self.fs,
    nodepath::join(self.fs.sep, [self.data_dir, "transcript-marks"]),
  )
  UpkeepReport::{
    station_log_rotated: false,
    update_log_rotated: false,
    wal_checkpointed: false,
    thumbs_freed: thumbs_freed,
    node_parts_removed: node_parts.length(),
    config_backups_removed: cfg_baks.length(),
    orphan_marks_removed: marks.length(),
    board_files_removed: 0,
    repo_worktrees_pruned: 0,
    repo_bundles_pruned: 0,
    job_states_pruned: 0,
    state_persisted: false,
  }
}

/// Starts a cooperative upkeep round. Drive with `Upkeep::step_upkeep(cur, budget)` on each tick.
pub fn Upkeep::begin_round(self : Upkeep, now_ms : Int64, hooks : UpkeepHooks) -> UpkeepCursor {
  if !self.state_loaded {
    let saved = read_upkeep_state(self.fs, self.data_dir)
    match self.last_repo_branches_at {
      None => self.last_repo_branches_at = saved.last_repo_branches_at
      Some(_) => ()
    }
    match self.last_orphan_rooms_at {
      None => self.last_orphan_rooms_at = saved.last_orphan_rooms_at
      Some(_) => ()
    }
    self.state_loaded = true
  }
  UpkeepCursor::{
    now_ms: now_ms,
    hooks: hooks,
    phase: 0,
    thumbs_cursor: None,
    thumbs_files: [],
    thumbs_total: 0.to_int64(),
    thumbs_freed: 0.to_int64(),
    station_log_rotated: false,
    update_log_rotated: false,
    wal_checkpointed: false,
    node_parts_removed: 0,
    config_backups_removed: 0,
    orphan_marks_removed: 0,
    board_files_removed: 0,
    repo_worktrees_pruned: 0,
    repo_bundles_pruned: 0,
    job_states_pruned: 0,
    processed: 0,
    finished: None,
  }
}

/// Advances one upkeep round by at most `budget` entries (default `WALK_YIELD_EVERY = 256`) before
/// returning `UpkeepStep::Yielded` so the main event loop stays responsive.
pub fn Upkeep::step_upkeep(
  self : Upkeep,
  cur : UpkeepCursor,
  budget : Int = WALK_YIELD_EVERY,
) -> UpkeepStep {
  match cur.finished {
    Some(rep) => return UpkeepStep::Done(rep)
    None => ()
  }
  let limit = if budget > 0 { budget } else { WALK_YIELD_EVERY }
  let mut used = 0

  while true {
    if used >= limit {
      return UpkeepStep::Yielded(cur.processed)
    }
    if cur.phase == 0 {
      // Phase 0: log rotation + WAL checkpoint + callbacks
      cur.station_log_rotated = match rotate_in_place(
        self.fs,
        nodepath::join(self.fs.sep, [self.data_dir, "stillfail.log"]),
        STATION_LOG_CAP,
      ) {
        Ok(v) => v
        Err(_) => false
      }
      cur.update_log_rotated = match rotate_in_place(
        self.fs,
        nodepath::join(self.fs.sep, [self.data_dir, "run", "update.log"]),
        UPDATE_LOG_CAP,
      ) {
        Ok(v) => v
        Err(_) => false
      }
      match cur.hooks.on_runners {
        Some(f) => f(cur.now_ms)
        None => ()
      }
      match cur.hooks.on_jobs {
        Some(f) => f(cur.now_ms)
        None => ()
      }
      match cur.hooks.on_remote {
        Some(f) => {
          let disk = match cur.hooks.disk_probe {
            Some(dp) => dp(self.data_dir)
            None => ParsedDisk::{ free: None, total: None }
          }
          f(cur.now_ms, disk.free, disk.total)
        }
        None => ()
      }
      match cur.hooks.on_checkpoint {
        Some(f) => {
          let wal_path = nodepath::join(self.fs.sep, [self.data_dir, "stillfail.db-wal"])
          match (self.fs.stat)(wal_path) {
            Some(st) => {
              if st.size > WAL_CAP {
                f()
                cur.wal_checkpointed = true
              }
            }
            None => ()
          }
        }
        None => ()
      }
      cur.phase = 1
      used = used + 1
      cur.processed = cur.processed + 1
    } else if cur.phase == 1 {
      // Phase 1: cooperative WalkCursor scan of `<data>/thumbs`
      let wc = match cur.thumbs_cursor {
        Some(c) => c
        None => {
          let thumbs_dir = nodepath::join(self.fs.sep, [self.data_dir, "thumbs"])
          let opts = WalkOptions::{
            same_device: true,
            max_entries: WALK_MAX_ENTRIES,
            max_depth: 1,
            max_duration_ms: WALK_MAX_DURATION_MS,
            yield_every: limit,
            need_stat: true,
            follow_root: false,
            follow_links: false,
          }
          let c = WalkCursor::new(self.fs, [thumbs_dir], opts)
          cur.thumbs_cursor = Some(c)
          c
        }
      }
      let before = wc.visited
      let rem = limit - used
      match wc.step(fn(e : WalkEntry) -> VisitAction {
        if e.depth == 1 && e.file && !e.symlink {
          match e.stats {
            Some(st) => {
              cur.thumbs_total = cur.thumbs_total + st.size
              cur.thumbs_files.push(AgedFile::{ path: e.path, bytes: st.size, mtime_ms: st.mtime_ms })
            }
            None => ()
          }
        }
        VisitAction::Continue
      }, rem, false) {
        WalkStep::Yielded(_) => {
          let delta = wc.visited - before
          let inc = if delta > 0 { delta } else { 1 }
          used = used + inc
          cur.processed = cur.processed + inc
          return UpkeepStep::Yielded(cur.processed)
        }
        WalkStep::Done(_) => {
          let delta = wc.visited - before
          let inc = if delta > 0 { delta } else { 1 }
          used = used + inc
          cur.processed = cur.processed + inc
          if cur.thumbs_total > THUMBS_CAP {
            for i in 1..<cur.thumbs_files.length() {
              let item = cur.thumbs_files[i]
              let mut j = i - 1
              while j >= 0 && cur.thumbs_files[j].mtime_ms > item.mtime_ms {
                cur.thumbs_files[j + 1] = cur.thumbs_files[j]
                j = j - 1
              }
              cur.thumbs_files[j + 1] = item
            }
            for i in 0..<cur.thumbs_files.length() {
              if cur.thumbs_total <= THUMBS_CAP {
                break
              }
              let f = cur.thumbs_files[i]
              let _ = (self.fs.remove_file)(f.path)
              cur.thumbs_total = cur.thumbs_total - f.bytes
              cur.thumbs_freed = cur.thumbs_freed + f.bytes
            }
          }
          cur.thumbs_cursor = None
          cur.phase = 2
        }
      }
    } else if cur.phase == 2 {
      // Phase 2: node parts + config backups + orphan marks + board files
      let node_parts = remove_stale(
        self.fs,
        nodepath::join(self.fs.sep, [self.data_dir, "node"]),
        ".part-",
        NODE_PART_MS,
        cur.now_ms,
      )
      cur.node_parts_removed = node_parts.length()
      let cfg_baks = keep_newest(self.fs, self.data_dir, "config.json.bak-", CONFIG_BACKUPS_KEPT)
      cur.config_backups_removed = cfg_baks.length()
      let marks = orphan_marks(
        self.fs,
        nodepath::join(self.fs.sep, [self.data_dir, "transcript-marks"]),
      )
      cur.orphan_marks_removed = marks.length()
      let board_gone = gone_board_files(
        self.fs,
        nodepath::join(self.fs.sep, [self.data_dir, "board-files"]),
        BOARD_FILES_GONE_MS,
        cur.now_ms,
      )
      cur.board_files_removed = board_gone.length()
      cur.phase = 3
      let inc = 1 + cur.node_parts_removed + cur.config_backups_removed + cur.orphan_marks_removed + cur.board_files_removed
      used = used + inc
      cur.processed = cur.processed + inc
    } else if cur.phase == 3 {
      // Phase 3: repo worktrees + repo bundles + stale jobs/state/*.json
      let wt_pruned = prune_repo_worktrees(self.fs, self.data_dir)
      cur.repo_worktrees_pruned = wt_pruned.length()
      let bundles_pruned = prune_expired_repo_bundles(self.fs, self.data_dir, cur.now_ms, REPO_BUNDLE_MS)
      cur.repo_bundles_pruned = bundles_pruned.length()
      let job_states = prune_stale_job_states(self.fs, self.data_dir, cur.now_ms)
      cur.job_states_pruned = job_states.length()
      cur.phase = 4
      let inc = 1 + cur.repo_worktrees_pruned + cur.repo_bundles_pruned + cur.job_states_pruned
      used = used + inc
      cur.processed = cur.processed + inc
    } else {
      // Phase 4: daily cadence + upkeep-state persistence
      let mut state_changed = false
      let mut patch_branches : Option[Option[Int64]] = None
      let mut patch_orphans : Option[Option[Int64]] = None

      let due_branches = match self.last_repo_branches_at {
        None => true
        Some(last) => cur.now_ms - last >= REPO_BRANCHES_EVERY_MS
      }
      if due_branches {
        self.last_repo_branches_at = Some(cur.now_ms)
        patch_branches = Some(Some(cur.now_ms))
        state_changed = true
        match cur.hooks.on_repo_branches {
          Some(f) => f(cur.now_ms)
          None => ()
        }
      }

      let due_orphans = match self.last_orphan_rooms_at {
        None => true
        Some(last) => cur.now_ms - last >= ORPHAN_ROOM_EVERY_MS
      }
      if due_orphans {
        match cur.hooks.on_orphan_rooms {
          Some(f) => {
            self.last_orphan_rooms_at = Some(cur.now_ms)
            patch_orphans = Some(Some(cur.now_ms))
            state_changed = true
            f(cur.now_ms)
          }
          None => ()
        }
      }

      let persisted = if state_changed {
        patch_upkeep_state(
          self.fs,
          self.data_dir,
          UpkeepStatePatch::{
            idle_measured: None,
            last_repo_branches_at: patch_branches,
            last_orphan_rooms_at: patch_orphans,
            last_full_relieve_at: None,
            last_archive_upkeep_at: None,
          },
          self.pid,
        )
      } else {
        false
      }

      let rep = UpkeepReport::{
        station_log_rotated: cur.station_log_rotated,
        update_log_rotated: cur.update_log_rotated,
        wal_checkpointed: cur.wal_checkpointed,
        thumbs_freed: cur.thumbs_freed,
        node_parts_removed: cur.node_parts_removed,
        config_backups_removed: cur.config_backups_removed,
        orphan_marks_removed: cur.orphan_marks_removed,
        board_files_removed: cur.board_files_removed,
        repo_worktrees_pruned: cur.repo_worktrees_pruned,
        repo_bundles_pruned: cur.repo_bundles_pruned,
        job_states_pruned: cur.job_states_pruned,
        state_persisted: persisted,
      }
      cur.phase = 5
      cur.finished = Some(rep)
      return UpkeepStep::Done(rep)
    }
  }
  UpkeepStep::Yielded(cur.processed)
}

/// Runs one full upkeep round, enforcing every bounded-ephemeral cap and daily cadence.
/// Convenience wrapper over `begin_round` + `step_upkeep`; main-loop callers should step per tick.
pub fn Upkeep::run_round(self : Upkeep, now_ms : Int64, hooks : UpkeepHooks) -> UpkeepReport {
  let cur = self.begin_round(now_ms, hooks)
  while true {
    match self.step_upkeep(cur, WALK_YIELD_EVERY) {
      UpkeepStep::Yielded(_) => ()
      UpkeepStep::Done(rep) => return rep
    }
  }
  UpkeepReport::{
    station_log_rotated: false,
    update_log_rotated: false,
    wal_checkpointed: false,
    thumbs_freed: 0.to_int64(),
    node_parts_removed: 0,
    config_backups_removed: 0,
    orphan_marks_removed: 0,
    board_files_removed: 0,
    repo_worktrees_pruned: 0,
    repo_bundles_pruned: 0,
    job_states_pruned: 0,
    state_persisted: false,
  }
}
