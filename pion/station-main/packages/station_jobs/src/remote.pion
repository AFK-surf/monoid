// Remote task preparation, queuing, execution, log/stop/release, restart adoption,
// disk budget eviction, and dirsync mirror state machine
// (`station/src/jobs/remote.ts` & `station/src/jobs/dirsync.ts`).
// Abstracts mesh & store callbacks so `station_jobs` does not couple to unmerged packages.

import "admit"
import "base_codec"
import "crypto"
import "nodepath"

pub let REMOTE_CHUNK : Int = 256 * 1024
pub let REMOTE_MAX_FILE : Int64 = (1024 * 1024 * 1024).to_int64()
pub let REMOTE_IDLE_MS : Int64 = 1209600000.to_int64() // 14 days
pub let REMOTE_GIVE_UP_MS : Int64 = 600000.to_int64() // 10 min
pub let MIRROR_IDLE_MS : Int64 = 86400000.to_int64() // 24 hours
pub let MIRROR_RECENT_MS : Int64 = 3600000.to_int64() // 1 hour
pub let ROOM_RECENT_MS : Int64 = 3600000.to_int64() // 1 hour
pub let TASKS_KEPT_MS : Int64 = 604800000.to_int64() // 7 days
pub let REMOTE_BUDGET_UNKNOWN : Int64 = 32.to_int64() * (1024 * 1024 * 1024).to_int64()

pub let DIRSYNC_FILE_MODE : String = "100644"
pub let DIRSYNC_EXEC_MODE : String = "100755"
pub let DIRSYNC_LINK_MODE : String = "120000"
pub let DIRSYNC_RAW_MAX : Int = 16 * 1024 * 1024
pub let DIRSYNC_PACKED_MAX : Int = DIRSYNC_RAW_MAX + (1024 * 1024)

/// Computes the remote rooms byte budget (15% of disk total, or `REMOTE_BUDGET_UNKNOWN`).
pub fn remote_budget(total_bytes : Option[Int64]) -> Int64 {
  match total_bytes {
    Some(t) => if t > 0.to_int64() { (t * 15.to_int64()) / 100.to_int64() } else { REMOTE_BUDGET_UNKNOWN }
    None => REMOTE_BUDGET_UNKNOWN
  }
}

/// Computes a Git-compatible SHA-1 blob id (`"blob <len>\0" + content`).
pub fn dirsync_blob_id(content : Bytes) -> String {
  let header = ("blob " + content.length().to_string()).to_bytes()
  let buf = Bytes::new(header.length() + 1 + content.length())
  for i in 0..<header.length() {
    buf[i] = header[i]
  }
  buf[header.length()] = 0 as Byte
  for i in 0..<content.length() {
    buf[header.length() + 1 + i] = content[i]
  }
  crypto::sha1_hex(buf)
}

/// Validates and resolves a relative transfer path under `root`, rejecting absolute paths,
/// `.`/`..` traversal, and any symlink component along the path (`remote.ts` `filePath`).
pub fn safe_transfer_path(
  fs : FsPort,
  root : String,
  relative : String,
  create_parent : Bool = false,
) -> Result[String, String] {
  match (fs.lstat)(root) {
    Some(st) => {
      if st.is_symlink() {
        return Err("transfer root is a symbolic link")
      }
    }
    None => return Err("transfer root does not exist")
  }
  let parts = match nodepath::relative_parts(fs.sep, relative) {
    Some(ps) => ps
    None => return Err("file path must be relative, without . or ..")
  }
  let clean_parts : Array[String] = []
  for i in 0..<parts.length() {
    let p = parts[i]
    if p.length() == 0 {
      continue
    }
    if p == "." {
      if i == 0 {
        return Err("file path must be relative, without . or ..")
      }
      continue
    }
    if p == ".." {
      return Err("file path must be relative, without . or ..")
    }
    clean_parts.push(p)
  }
  if clean_parts.length() == 0 {
    return Err("file path must be relative, without . or ..")
  }
  let mut cur = root
  for i in 0..<clean_parts.length() {
    cur = nodepath::join(fs.sep, [cur, clean_parts[i]])
    match (fs.lstat)(cur) {
      Some(st) => {
        if st.is_symlink() {
          return Err("file path contains a symbolic link")
        }
      }
      None => ()
    }
  }
  if create_parent {
    let _ = (fs.mkdir_p)(nodepath::dirname(fs.sep, cur))
  }
  Ok(cur)
}

pub enum RemoteTaskState {
  Prepared
  Syncing
  Queued
  Running
  Stopping
  Exited
  Stopped
  Failed
  Released
}

pub fn remote_task_state_str(s : RemoteTaskState) -> String {
  match s {
    RemoteTaskState::Prepared => "prepared"
    RemoteTaskState::Syncing => "syncing"
    RemoteTaskState::Queued => "queued"
    RemoteTaskState::Running => "running"
    RemoteTaskState::Stopping => "stopping"
    RemoteTaskState::Exited => "exited"
    RemoteTaskState::Stopped => "stopped"
    RemoteTaskState::Failed => "failed"
    RemoteTaskState::Released => "released"
  }
}

pub fn remote_task_is_done(s : RemoteTaskState) -> Bool {
  match s {
    RemoteTaskState::Exited => true
    RemoteTaskState::Stopped => true
    RemoteTaskState::Failed => true
    RemoteTaskState::Released => true
    _ => false
  }
}

pub enum MirrorState {
  Idle
  Syncing
  InUse
  PendingRelease
  Cleaned
}

pub fn mirror_state_str(s : MirrorState) -> String {
  match s {
    MirrorState::Idle => "idle"
    MirrorState::Syncing => "syncing"
    MirrorState::InUse => "in_use"
    MirrorState::PendingRelease => "pending_release"
    MirrorState::Cleaned => "cleaned"
  }
}

pub struct RemoteTaskRecord {
  pub task_id : String
  pub key : String
  pub room_id : String
  pub workspace : String
  pub source_station : String
  pub source_session : String
  pub name : String
  pub command : String
  pub mirror_name : Option[String]
  pub dir_source : Option[String]
  pub spec_json : String
  pub back_paths : Array[String]
  pub screen : Bool
  pub small : Bool
  pub mut push_ref : Option[String]
  pub uploads : Map[String, Bool]
  pub mut synced : Bool
  pub mut collected : Bool
  pub mut state : RemoteTaskState
  pub mut job_id : Option[String]
  pub mut exit_code : Option[Int]
  pub created_at : Int64
  pub mut queued_at : Option[Int64]
  pub mut started_at : Option[Int64]
  pub mut ended_at : Option[Int64]
  pub mut pending_results : Bool
}

pub struct MirrorRecord {
  pub name : String
  pub room_id : String
  pub path : String
  pub mut state : MirrorState
  pub mut active_task : Option[String]
  pub mut last_used_at : Int64
  pub mut bytes : Int64
  pub mut manifest_hash : String
}

pub struct RemoteRoomRecord {
  pub room_id : String
  pub workspace : String
  pub source_station : String
  pub source_session : String
  pub work_dir : String
  pub mut last_used_at : Int64
  pub mut closed : Bool
}

pub struct RemotePrepareRequest {
  pub key : String
  pub workspace : String
  pub source_station : String
  pub source_session : String
  pub name : String
  pub command : String
  pub mirror_name : Option[String]
  pub back_paths : Array[String]
  pub screen : Bool
  pub small : Bool
}

pub struct RemoteCallbacks {
  pub on_task_changed : (RemoteTaskRecord) -> Unit
}

pub fn noop_remote_callbacks() -> RemoteCallbacks {
  RemoteCallbacks::{ on_task_changed: fn(_t : RemoteTaskRecord) -> Unit {} }
}

pub struct RemoteSweepReport {
  pub rooms_removed : Array[String]
  pub mirrors_removed : Array[String]
  pub tasks_expired : Array[String]
  pub budget_evicted_rooms : Array[String]
}

pub struct RemoteManager {
  pub root : String
  pub fs : FsPort
  pub jobs : JobManager
  pub callbacks : RemoteCallbacks
  pub rooms : Map[String, RemoteRoomRecord]
  pub room_ids : Array[String]
  pub tasks : Map[String, RemoteTaskRecord]
  pub mut task_keys : Array[String]
  pub mirrors_map : Map[String, MirrorRecord]
  pub mirror_keys : Array[String]
  pub job_to_task : Map[String, String]
  pub mut can_start : Option[(String, String, String) -> Bool]
  mut tombstone_seq : Int64
}

pub fn RemoteManager::new(
  data_dir : String,
  fs : FsPort,
  jobs : JobManager,
  callbacks : RemoteCallbacks,
) -> RemoteManager {
  let root = nodepath::join(fs.sep, [data_dir, "remote"])
  let _ = (fs.mkdir_p)(nodepath::join(fs.sep, [root, "incoming"]))
  let _ = (fs.mkdir_p)(nodepath::join(fs.sep, [root, "outgoing"]))
  let _ = (fs.mkdir_p)(nodepath::join(fs.sep, [root, "sessions"]))
  let _ = (fs.mkdir_p)(nodepath::join(fs.sep, [root, "tombstones"]))
  let _ = (fs.mkdir_p)(nodepath::join(fs.sep, [root, "used"]))
  let _ = (fs.mkdir_p)(nodepath::join(fs.sep, [root, "prepared"]))
  RemoteManager::{
    root: root,
    fs: fs,
    jobs: jobs,
    callbacks: callbacks,
    rooms: Map::new(),
    room_ids: [],
    tasks: Map::new(),
    task_keys: [],
    mirrors_map: Map::new(),
    mirror_keys: [],
    job_to_task: Map::new(),
    can_start: None,
    tombstone_seq: 0.to_int64(),
  }
}

enum TombstoneOutcome {
  Missing
  Renamed(String)
  Failed
}

/// Atomically renames `dir_path` into the dedicated Station-owned same-volume `<root>/tombstones`
/// directory (`.gone-<base>-<ts>-<seq>`) before cooperative multi-tick deletion, so both `prepare`
/// (`sessions/<rid>/mirrors/<name>`) and `prepare_scoped` (`sessions/<rid>/work/<name>`) mirror
/// tombstones and room tombstones share one exclusive recovery home without colliding with manifest files.
fn RemoteManager::tombstone_dir(self : RemoteManager, dir_path : String, now_ms : Int64) -> TombstoneOutcome {
  match self.fs.lstat_err {
    Some(f) => match f(dir_path) {
      Ok(_) => ()
      Err(-2) => return TombstoneOutcome::Missing
      Err(_) => return TombstoneOutcome::Failed
    }
    None => match (self.fs.lstat)(dir_path) {
      None => return TombstoneOutcome::Missing
      Some(_) => ()
    }
  }
  let tomb_root = nodepath::join(self.fs.sep, [self.root, "tombstones"])
  let _ = (self.fs.mkdir_p)(tomb_root)
  self.tombstone_seq = self.tombstone_seq + 1.to_int64()
  let base = nodepath::basename(self.fs.sep, dir_path)
  let tomb = nodepath::join(
    self.fs.sep,
    [tomb_root, ".gone-" + base + "-" + now_ms.to_string() + "-" + self.tombstone_seq.to_string()],
  )
  if (self.fs.rename)(dir_path, tomb) {
    TombstoneOutcome::Renamed(tomb)
  } else {
    TombstoneOutcome::Failed
  }
}

fn remote_room_id(workspace : String, source_station : String, source_session : String) -> String {
  let raw = (workspace + ":" + source_station + ":" + source_session).to_bytes()
  sj_slice_str(crypto::sha256_hex(raw), 0, 16)
}

/// Computes the Node/MB-compatible full 64-char SHA-256 hex room ID (`rhash([workspace, peer, session])`).
pub fn remote_room_id_v2(workspace : String, source_station : String, source_session : String) -> String {
  let arr = base_codec::json_arr([
    base_codec::json_str(workspace),
    base_codec::json_str(source_station),
    base_codec::json_str(source_session),
  ])
  crypto::sha256_hex(base_codec::json_stringify(arr).to_bytes())
}

/// Computes the Node/MB-compatible full 64-char SHA-256 hex incoming task ID
/// (`rhash([workspace, peer, session, key])`, matching `remote_target.mbt:136`).
pub fn remote_task_id(
  workspace : String,
  source_station : String,
  source_session : String,
  key : String,
) -> String {
  let arr = base_codec::json_arr([
    base_codec::json_str(workspace),
    base_codec::json_str(source_station),
    base_codec::json_str(source_session),
    base_codec::json_str(key),
  ])
  crypto::sha256_hex(base_codec::json_stringify(arr).to_bytes())
}

/// Returns `true` iff `s` is a 64-char lowercase hex string (`remote_target.mbt:444`).
pub fn is_hex64(s : String) -> Bool {
  if s.length() != 64 {
    return false
  }
  for i in 0..<64 {
    let b = s.code_unit_at(i) & 0xFF
    if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102)) {
      return false
    }
  }
  true
}

/// Deep structural JSON equality (key-order independent for objects).
pub fn json_deep_eq(a : base_codec::Json, b : base_codec::Json) -> Bool {
  match (a, b) {
    (base_codec::Json::Null, base_codec::Json::Null) => true
    (base_codec::Json::Bool(x), base_codec::Json::Bool(y)) => x == y
    (base_codec::Json::Num(x, _), base_codec::Json::Num(y, _)) => x == y
    (base_codec::Json::Str(x), base_codec::Json::Str(y)) => x == y
    (base_codec::Json::Arr(xs), base_codec::Json::Arr(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      for i in 0..<xs.length() {
        if !json_deep_eq(xs[i], ys[i]) {
          return false
        }
      }
      true
    }
    (base_codec::Json::Obj(fs1), base_codec::Json::Obj(fs2)) => {
      if fs1.length() != fs2.length() {
        return false
      }
      for i in 0..<fs1.length() {
        let (k, v1) = fs1[i]
        match base_codec::json_get(b, k) {
          Some(v2) => if !json_deep_eq(v1, v2) { return false }
          None => return false
        }
      }
      true
    }
    _ => false
  }
}

/// Derives a safe mirror directory name from a caller-provided source `dir` path
/// (`remote_target.mbt:667` `mirror_name`), capping at 100 UTF-16 code units and
/// disambiguating collisions with `-2`, `-3`, ...
pub fn derive_mirror_name(dir : String, claimed : Map[String, String]) -> String {
  let slash_parts = dir.split("/")
  let mut last = ""
  for i in 0..<slash_parts.length() {
    let sub = slash_parts[i].split("\\")
    for j in 0..<sub.length() {
      if sub[j].length() > 0 {
        last = sub[j]
      }
    }
  }
  let sb = StringBuilder::new()
  let raw = last.to_bytes()
  let mut idx = 0
  let mut utf16_units = 0
  while idx < raw.length() {
    let b0 = raw[idx].to_int() & 0xFF
    let (seq_len, units) = if b0 < 0x80 {
      (1, 1)
    } else if (b0 & 0xE0) == 0xC0 && idx + 1 < raw.length() {
      (2, 1)
    } else if (b0 & 0xF0) == 0xE0 && idx + 2 < raw.length() {
      (3, 1)
    } else if (b0 & 0xF8) == 0xF0 && idx + 3 < raw.length() {
      (4, 2)
    } else {
      (1, 1)
    }
    if utf16_units >= 100 {
      break
    }
    if seq_len == 1 && b0 < 0x80 {
      let ok = (b0 >= 65 && b0 <= 90)
      || (b0 >= 97 && b0 <= 122)
      || (b0 >= 48 && b0 <= 57)
      || b0 == 46
      || b0 == 95
      || b0 == 32
      || b0 == 45
      sb.write_byte(if ok { raw[idx] } else { 95 as Byte })
    } else {
      for k in 0..<seq_len {
        sb.write_byte(raw[idx + k])
      }
    }
    utf16_units = utf16_units + units
    idx = idx + seq_len
  }
  let mut base = sb.to_string()
  if base.length() == 0 || base == "." || base == ".." {
    base = "dir"
  }
  match claimed.get(base) {
    None => return base
    Some(prev) => if prev == dir { return base }
  }
  let mut n = 2
  while n < 10000 {
    let cand = base + "-" + n.to_string()
    match claimed.get(cand) {
      None => return cand
      Some(prev) => if prev == dir { return cand }
    }
    n = n + 1
  }
  base + "-" + sj_slice_str(crypto::sha256_hex(dir.to_bytes()), 0, 8)
}

fn mirror_compound_key(room_id : String, mirror_name : String) -> String {
  room_id + "/" + mirror_name
}

fn RemoteManager::path_has_live_remote_job(self : RemoteManager, dir : String) -> Bool {
  for i in 0..<self.jobs.job_ids.length() {
    match self.jobs.jobs.get(self.jobs.job_ids[i]) {
      Some(j) => {
        if job_state_is_up(j.state)
        && (sj_starts_with(j.id, "remote_") || sj_starts_with(j.session, "remote:"))
        && j.cwd.length() > 0
        && path_is_within(self.fs.sep, j.cwd, dir)
        {
          return true
        }
      }
      None => ()
    }
  }
  false
}

fn RemoteManager::room_has_live_job(self : RemoteManager, rid : String) -> Bool {
  let room_dir = nodepath::join(self.fs.sep, [self.root, "sessions", rid])
  self.path_has_live_remote_job(room_dir)
}

/// Scans `<data>/remote/sessions/*` and `<room>/mirrors/*` on startup to adopt rooms & mirrors
/// created before a station restart so `sweep` and `remote_budget` govern them.
/// - When `latest_in_checked` truncates past `latest_limit`, preserves the room/mirror (`last_used_at = now_ms`,
///   aligned with TS `Infinity`) rather than falling back to a stale directory mtime.
/// - Cross-checks `self.jobs` for any active `remote_*` job whose `cwd` lies inside a room or mirror
///   so live remote work is never evicted.
pub fn RemoteManager::adopt_existing(
  self : RemoteManager,
  now_ms : Int64,
  latest_limit : Int = 4096,
) -> Int {
  let sessions_root = nodepath::join(self.fs.sep, [self.root, "sessions"])
  let dirs = match (self.fs.read_dir)(sessions_root) {
    Some(ds) => ds
    None => return 0
  }
  let mut count = 0
  for i in 0..<dirs.length() {
    let rid = dirs[i]
    if sj_starts_with(rid, ".") || is_stray_tombstone_name(rid) {
      continue
    }
    let room_dir = nodepath::join(self.fs.sep, [sessions_root, rid])
    let st = match (self.fs.lstat)(room_dir) {
      Some(s) => s
      None => continue
    }
    if !st.is_dir() || st.is_symlink() {
      continue
    }
    let live_in_room = self.path_has_live_remote_job(room_dir)
    let last_used = if live_in_room {
      now_ms
    } else {
      match latest_in_checked(self.fs, room_dir, latest_limit) {
        LatestInStatus::Found(ts) => ts
        LatestInStatus::Truncated => now_ms
        LatestInStatus::Empty => if st.mtime_ms > 0.to_int64() { st.mtime_ms } else { now_ms }
      }
    }
    if !self.rooms.contains(rid) {
      let work_dir = nodepath::join(self.fs.sep, [room_dir, "work"])
      self.rooms.set(
        rid,
        RemoteRoomRecord::{
          room_id: rid,
          workspace: "",
          source_station: "",
          source_session: "",
          work_dir: work_dir,
          last_used_at: last_used,
          closed: false,
        },
      )
      self.room_ids.push(rid)
      count = count + 1
    } else if live_in_room {
      match self.rooms.get(rid) {
        Some(r) => r.last_used_at = now_ms
        None => ()
      }
    }
    let mirrors_dir = nodepath::join(self.fs.sep, [room_dir, "mirrors"])
    match (self.fs.read_dir)(mirrors_dir) {
      Some(mnames) => {
        for mi in 0..<mnames.length() {
          let mname = mnames[mi]
          if sj_starts_with(mname, ".") || is_stray_tombstone_name(mname) {
            continue
          }
          let mpath = nodepath::join(self.fs.sep, [mirrors_dir, mname])
          let mst = match (self.fs.lstat)(mpath) {
            Some(s) => s
            None => continue
          }
          if !mst.is_dir() || mst.is_symlink() {
            continue
          }
          let mk = mirror_compound_key(rid, mname)
          let live_in_mirror = self.path_has_live_remote_job(mpath)
          if !self.mirrors_map.contains(mk) {
            let m_used = if live_in_mirror {
              now_ms
            } else {
              match latest_in_checked(self.fs, mpath, latest_limit) {
                LatestInStatus::Found(ts) => ts
                LatestInStatus::Truncated => now_ms
                LatestInStatus::Empty => if mst.mtime_ms > 0.to_int64() { mst.mtime_ms } else { now_ms }
              }
            }
            self.mirrors_map.set(
              mk,
              MirrorRecord::{
                name: mname,
                room_id: rid,
                path: mpath,
                state: if live_in_mirror { MirrorState::InUse } else { MirrorState::Idle },
                active_task: None,
                last_used_at: m_used,
                bytes: 0.to_int64(),
                manifest_hash: "",
              },
            )
            self.mirror_keys.push(mk)
          } else if live_in_mirror {
            match self.mirrors_map.get(mk) {
              Some(m) => {
                m.state = MirrorState::InUse
                m.last_used_at = now_ms
              }
              None => ()
            }
          }
        }
      }
      None => ()
    }
  }
  count
}

fn RemoteManager::ensure_room(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  now_ms : Int64,
) -> RemoteRoomRecord {
  let rid = remote_room_id(workspace, source_station, source_session)
  match self.rooms.get(rid) {
    Some(r) => {
      if r.closed {
        let _ = (self.fs.mkdir_p)(r.work_dir)
      }
      r.last_used_at = now_ms
      r.closed = false
      r
    }
    None => {
      let work_dir = nodepath::join(self.fs.sep, [self.root, "sessions", rid, "work"])
      let _ = (self.fs.mkdir_p)(work_dir)
      let room = RemoteRoomRecord::{
        room_id: rid,
        workspace: workspace,
        source_station: source_station,
        source_session: source_session,
        work_dir: work_dir,
        last_used_at: now_ms,
        closed: false,
      }
      self.rooms.set(rid, room)
      self.room_ids.push(rid)
      room
    }
  }
}

fn is_valid_mirror_name(mname : String) -> Bool {
  if mname.length() == 0 || mname == "." || mname == ".." {
    return false
  }
  // Reject both POSIX '/' and Windows '\\' separators.
  if sj_index_of(mname, "/", 0) >= 0 || sj_index_of(mname, "\\", 0) >= 0 {
    return false
  }
  true
}

/// Prepares a remote task under `req.key`. Idempotent when `req.key` already exists.
fn RemoteManager::prepare(
  self : RemoteManager,
  req : RemotePrepareRequest,
  now_ms : Int64,
) -> Result[RemoteTaskRecord, String] {
  if req.key.length() == 0 {
    return Err("task key is required")
  }
  if req.command.length() == 0 {
    return Err("task command is required")
  }
  match self.tasks.get(req.key) {
    Some(existing) => return Ok(existing)
    None => ()
  }
  let room = self.ensure_room(req.workspace, req.source_station, req.source_session, now_ms)
  match req.mirror_name {
    Some(mname) => {
      if !is_valid_mirror_name(mname) {
        return Err("invalid mirror name: " + mname)
      }
      let mk = mirror_compound_key(room.room_id, mname)
      if !self.mirrors_map.contains(mk) {
        let mpath = nodepath::join(self.fs.sep, [self.root, "sessions", room.room_id, "mirrors", mname])
        let _ = (self.fs.mkdir_p)(mpath)
        self.mirrors_map.set(
          mk,
          MirrorRecord::{
            name: mname,
            room_id: room.room_id,
            path: mpath,
            state: MirrorState::Idle,
            active_task: None,
            last_used_at: now_ms,
            bytes: 0.to_int64(),
            manifest_hash: "",
          },
        )
        self.mirror_keys.push(mk)
      }
    }
    None => ()
  }
  let task = RemoteTaskRecord::{
    task_id: req.key,
    key: req.key,
    room_id: room.room_id,
    workspace: req.workspace,
    source_station: req.source_station,
    source_session: req.source_session,
    name: if req.name.length() > 0 { req.name } else { req.key },
    command: req.command,
    mirror_name: req.mirror_name,
    dir_source: req.mirror_name,
    spec_json: "",
    back_paths: req.back_paths,
    screen: req.screen,
    small: req.small,
    push_ref: None,
    uploads: Map::new(),
    synced: false,
    collected: false,
    state: RemoteTaskState::Prepared,
    job_id: None,
    exit_code: None,
    created_at: now_ms,
    queued_at: None,
    started_at: None,
    ended_at: None,
    pending_results: false,
  }
  self.tasks.set(req.key, task)
  self.task_keys.push(req.key)
  Ok(task)
}

fn RemoteManager::spawn_task_job(
  self : RemoteManager,
  task : RemoteTaskRecord,
  now_ms : Int64,
) -> Result[RemoteTaskRecord, String] {
  let cwd = match task.mirror_name {
    Some(mname) => {
      let mk = mirror_compound_key(task.room_id, mname)
      match self.mirrors_map.get(mk) {
        Some(m) => {
          m.state = MirrorState::InUse
          m.active_task = Some(task.task_id)
          m.last_used_at = now_ms
          m.path
        }
        None => return Err("mirror missing: " + mname)
      }
    }
    None => {
      match self.rooms.get(task.room_id) {
        Some(r) => {
          r.last_used_at = now_ms
          r.work_dir
        }
        None => return Err("room missing: " + task.room_id)
      }
    }
  }
  let session_owner = "remote:" + task.workspace + ":" + task.source_station + ":" + task.source_session
  let jid = "remote_" + task.task_id
  let req = JobStartRequest::{
    session: session_owner,
    name: task.name,
    command: task.command,
    cwd: cwd,
    port: None,
    watch: false,
    id: Some(jid),
    queued: false,
    screen: task.screen,
    small: task.small,
    pipe_stdio: false,
  }
  match self.jobs.start(req, now_ms) {
    Ok(job) => {
      task.job_id = Some(job.id)
      task.state = RemoteTaskState::Running
      task.started_at = Some(now_ms)
      self.job_to_task.set(job.id, task.task_id)
      let _ = self.persist_incoming_task(task)
      (self.callbacks.on_task_changed)(task)
      Ok(task)
    }
    Err(e) => {
      task.state = RemoteTaskState::Failed
      task.ended_at = Some(now_ms)
      let _ = self.persist_incoming_task(task)
      (self.callbacks.on_task_changed)(task)
      Err(e)
    }
  }
}

/// Returns `true` if any recorded file upload for `task` has not yet been finalized (`final: true`).
pub fn RemoteManager::has_incomplete_uploads(self : RemoteManager, task : RemoteTaskRecord) -> Bool {
  let _ = self.root.length()
  let ks = task.uploads.keys()
  for i in 0..<ks.length() {
    match task.uploads.get(ks[i]) {
      Some(false) => return true
      _ => ()
    }
  }
  false
}

/// Starts a prepared remote task.
fn RemoteManager::start(
  self : RemoteManager,
  key : String,
  now_ms : Int64,
  needs_sync : Bool = false,
  pressure : Option[Pressure] = None,
  person_present : Bool = false,
) -> Result[RemoteTaskRecord, String] {
  let task = match self.tasks.get(key) {
    Some(t) => t
    None => return Err("unknown remote task: " + key)
  }
  match task.state {
    RemoteTaskState::Prepared => ()
    _ => return Ok(task)
  }
  if self.has_incomplete_uploads(task) {
    return Err("input upload is incomplete; finish it before starting")
  }
  match task.mirror_name {
    Some(mname) => {
      let mk = mirror_compound_key(task.room_id, mname)
      match self.mirrors_map.get(mk) {
        Some(m) => {
          match m.state {
            MirrorState::Idle => ()
            MirrorState::Cleaned => {
              let _ = (self.fs.mkdir_p)(m.path)
              m.state = MirrorState::Idle
            }
            _ => return Err("mirror busy (" + mirror_state_str(m.state) + "): " + mname)
          }
          if needs_sync {
            m.state = MirrorState::Syncing
            m.active_task = Some(task.task_id)
            m.last_used_at = now_ms
            task.state = RemoteTaskState::Syncing
            let _ = self.persist_incoming_task(task)
            (self.callbacks.on_task_changed)(task)
            return Ok(task)
          }
        }
        None => return Err("mirror missing: " + mname)
      }
    }
    None => ()
  }
  task.state = RemoteTaskState::Queued
  task.queued_at = Some(now_ms)
  let _ = self.drain_queue(now_ms, pressure, person_present)
  Ok(task)
}

/// Marks a mirror dirsync as complete and advances the task into the admission queue.
fn RemoteManager::sync_complete(
  self : RemoteManager,
  key : String,
  manifest_hash : String,
  now_ms : Int64,
  pressure : Option[Pressure] = None,
  person_present : Bool = false,
) -> Result[RemoteTaskRecord, String] {
  let task = match self.tasks.get(key) {
    Some(t) => t
    None => return Err("unknown remote task: " + key)
  }
  match task.state {
    RemoteTaskState::Syncing => ()
    _ => return Err("task is not syncing: " + key)
  }
  match task.mirror_name {
    Some(mname) => {
      let mk = mirror_compound_key(task.room_id, mname)
      match self.mirrors_map.get(mk) {
        Some(m) => {
          m.manifest_hash = manifest_hash
          m.last_used_at = now_ms
        }
        None => ()
      }
    }
    None => ()
  }
  task.state = RemoteTaskState::Queued
  task.queued_at = Some(now_ms)
  let _ = self.drain_queue(now_ms, pressure, person_present)
  Ok(task)
}

/// Admits queued remote tasks using `admit::pick`. Returns task keys started in this drain.
pub fn RemoteManager::drain_queue(
  self : RemoteManager,
  now_ms : Int64,
  pressure : Option[Pressure] = None,
  person_present : Bool = false,
) -> Array[String] {
  let started_keys : Array[String] = []
  let pressure_str = match pressure {
    Some(p) => Some(pressure_to_str(p))
    None => None
  }
  let mut rounds = 0
  while rounds < 64 {
    rounds = rounds + 1
    let waiting : Array[admit::Waiting] = []
    let running : Array[admit::Started] = []
    for i in 0..<self.task_keys.length() {
      match self.tasks.get(self.task_keys[i]) {
        Some(t) => {
          match t.state {
            RemoteTaskState::Queued => {
              let qat = match t.queued_at {
                Some(q) => q.to_double()
                None => t.created_at.to_double()
              }
              waiting.push(admit::Waiting::{
                id: t.task_id,
                session: t.room_id,
                screen: t.screen,
                queued_at: qat,
                small: t.small,
              })
            }
            RemoteTaskState::Running => {
              running.push(admit::Started::{
                id: t.task_id,
                screen: t.screen,
                small: t.small,
              })
            }
            RemoteTaskState::Stopping => {
              running.push(admit::Started::{
                id: t.task_id,
                screen: t.screen,
                small: t.small,
              })
            }
            _ => ()
          }
        }
        None => ()
      }
    }
    let claims = admit::claims_held(self.jobs.screen_claims)
    match admit::pick(
      waiting,
      running,
      pressure_str,
      person_present,
      fn(_sess : String) -> Option[Double] { None },
      claims,
    ) {
      Some(admit::Picked::Start(w)) => {
        match self.tasks.get(w.id) {
          Some(task) => {
            let allowed = match self.can_start {
              Some(check) => check(task.workspace, task.source_station, task.source_session)
              None => true
            }
            if !allowed {
              task.state = RemoteTaskState::Stopped
              task.ended_at = Some(now_ms)
              self.release_task_mirror_idle(task)
              let _ = self.persist_incoming_task(task)
              (self.callbacks.on_task_changed)(task)
              continue
            }
            match self.spawn_task_job(task, now_ms) {
              Ok(_) => started_keys.push(task.task_id)
              Err(_) => ()
            }
          }
          None => break
        }
      }
      _ => break
    }
  }
  started_keys
}

/// Synchronizes a `JobRecord` terminal state back into its `RemoteTaskRecord` and mirror.
/// Mirror is released to `Idle` only once the underlying child process has actually exited.
pub fn RemoteManager::on_job_event(
  self : RemoteManager,
  job : JobRecord,
  now_ms : Int64,
  results_saved : Bool = true,
) -> Bool {
  let key = match self.job_to_task.get(job.id) {
    Some(k) => k
    None => return false
  }
  let task = match self.tasks.get(key) {
    Some(t) => t
    None => return false
  }
  match job.state {
    JobState::Exited => {
      task.state = RemoteTaskState::Exited
      task.exit_code = job.exit_code
      task.ended_at = Some(now_ms)
    }
    JobState::Failed => {
      task.state = RemoteTaskState::Failed
      task.exit_code = job.exit_code
      task.ended_at = Some(now_ms)
    }
    JobState::Stopped => {
      task.state = RemoteTaskState::Stopped
      task.exit_code = job.exit_code
      task.ended_at = Some(now_ms)
    }
    _ => return true
  }
  match task.mirror_name {
    Some(mname) => {
      let mk = mirror_compound_key(task.room_id, mname)
      match self.mirrors_map.get(mk) {
        Some(m) => {
          m.last_used_at = now_ms
          let was_stopped = match job.state {
            JobState::Stopped => true
            _ => false
          }
          if was_stopped || results_saved || task.back_paths.length() == 0 {
            m.state = MirrorState::Idle
            m.active_task = None
            task.pending_results = false
          } else {
            m.state = MirrorState::PendingRelease
            task.pending_results = true
          }
        }
        None => ()
      }
    }
    None => ()
  }
  let _ = self.persist_incoming_task(task)
  (self.callbacks.on_task_changed)(task)
  true
}

fn RemoteManager::get(self : RemoteManager, key : String) -> Option[RemoteTaskRecord] {
  self.tasks.get(key)
}

fn RemoteManager::log(
  self : RemoteManager,
  key : String,
  lines : Int = JOB_LOG_LINES_DEFAULT,
) -> Result[String, String] {
  let task = match self.tasks.get(key) {
    Some(t) => t
    None => return Err("unknown remote task: " + key)
  }
  match task.job_id {
    Some(jid) => self.jobs.log(jid, lines)
    None => Ok("")
  }
}

/// Stops a remote task. If an underlying job process is still alive (`JobState::Stopping`),
/// transitions task to `Stopping` and keeps its mirror locked (`InUse`) until `on_job_event`
/// confirms actual process exit so no concurrent task can corrupt the mirror.
fn RemoteManager::stop(
  self : RemoteManager,
  key : String,
  now_ms : Int64,
) -> Result[RemoteTaskRecord, String] {
  let task = match self.tasks.get(key) {
    Some(t) => t
    None => return Err("unknown remote task: " + key)
  }
  let mut still_stopping = false
  match task.job_id {
    Some(jid) => {
      match self.jobs.stop(jid, now_ms) {
        Ok(j) => {
          match j.state {
            JobState::Stopping => still_stopping = true
            _ => ()
          }
        }
        Err(_) => ()
      }
    }
    None => ()
  }
  if still_stopping {
    task.state = RemoteTaskState::Stopping
    (self.callbacks.on_task_changed)(task)
    return Ok(task)
  }
  task.state = RemoteTaskState::Stopped
  task.ended_at = Some(now_ms)
  match task.mirror_name {
    Some(mname) => {
      let mk = mirror_compound_key(task.room_id, mname)
      match self.mirrors_map.get(mk) {
        Some(m) => {
          if match m.active_task {
            Some(ak) => ak == task.task_id
            None => false
          } {
            m.state = MirrorState::Idle
            m.active_task = None
          }
        }
        None => ()
      }
    }
    None => ()
  }
  let _ = self.persist_incoming_task(task)
  (self.callbacks.on_task_changed)(task)
  Ok(task)
}

/// Releases a mirror held in `PendingRelease` after partial result download.
fn RemoteManager::release(self : RemoteManager, key : String) -> Result[RemoteTaskRecord, String] {
  let task = match self.tasks.get(key) {
    Some(t) => t
    None => return Err("unknown remote task: " + key)
  }
  task.pending_results = false
  if remote_task_is_done(task.state) {
    task.state = RemoteTaskState::Released
  }
  match task.mirror_name {
    Some(mname) => {
      let mk = mirror_compound_key(task.room_id, mname)
      match self.mirrors_map.get(mk) {
        Some(m) => {
          match m.state {
            MirrorState::PendingRelease => {
              m.state = MirrorState::Idle
              m.active_task = None
            }
            _ => ()
          }
        }
        None => ()
      }
    }
    None => ()
  }
  (self.callbacks.on_task_changed)(task)
  Ok(task)
}

fn RemoteManager::list(
  self : RemoteManager,
  room_id_opt : Option[String] = None,
) -> Array[RemoteTaskRecord] {
  let out : Array[RemoteTaskRecord] = []
  for i in 0..<self.task_keys.length() {
    match self.tasks.get(self.task_keys[i]) {
      Some(t) => {
        let keep = match room_id_opt {
          Some(rid) => t.room_id == rid
          None => true
        }
        if keep {
          out.push(t)
        }
      }
      None => ()
    }
  }
  out
}

fn RemoteManager::mirrors(
  self : RemoteManager,
  room_id_opt : Option[String] = None,
) -> Array[MirrorRecord] {
  let out : Array[MirrorRecord] = []
  for i in 0..<self.mirror_keys.length() {
    match self.mirrors_map.get(self.mirror_keys[i]) {
      Some(m) => {
        let keep = match room_id_opt {
          Some(rid) => m.room_id == rid
          None => true
        }
        if keep {
          match m.state {
            MirrorState::Cleaned => ()
            _ => out.push(m)
          }
        }
      }
      None => ()
    }
  }
  out
}

/// Removes an idle mirror directory and marks it cleaned. Refuses if busy or pending release.
fn RemoteManager::clean_mirror(
  self : RemoteManager,
  room_id : String,
  mirror_name : String,
) -> Result[Bool, String] {
  let mk = mirror_compound_key(room_id, mirror_name)
  let m = match self.mirrors_map.get(mk) {
    Some(rec) => rec
    None => return Err("unknown mirror: " + mirror_name)
  }
  match m.state {
    MirrorState::Idle => ()
    MirrorState::Cleaned => return Ok(false)
    _ => return Err("cannot clean mirror while " + mirror_state_str(m.state))
  }
  let _ = (self.fs.remove_dir_all)(m.path)
  m.state = MirrorState::Cleaned
  m.bytes = 0.to_int64()
  Ok(true)
}

fn RemoteManager::room_has_active_tasks(self : RemoteManager, rid : String) -> Bool {
  if self.room_has_live_job(rid) {
    return true
  }
  for ti in 0..<self.task_keys.length() {
    match self.tasks.get(self.task_keys[ti]) {
      Some(t) => {
        if t.room_id == rid && (!remote_task_is_done(t.state) || t.pending_results) {
          return true
        }
      }
      None => ()
    }
  }
  false
}

struct RoomUsage {
  room_id : String
  last_used_at : Int64
  bytes : Int64
}

pub enum SweepStep {
  Yielded(Int)
  Done(RemoteSweepReport)
}

fn is_hex_lower_byte(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 97 && b <= 102)
}

fn is_ascii_digits_slice(bytes : Bytes, start : Int, end : Int) -> Bool {
  if end <= start {
    return false
  }
  for i in start..<end {
    let b = bytes[i].to_int() & 0xFF
    if b < 48 || b > 57 {
      return false
    }
  }
  true
}

/// Returns true for legacy tombstone directory names in `remote/sessions/` or `mirrors/`:
/// - `<64hex>(.gone-<8hex>)+` (Node/MB/Pion reader `closeRoom` format), or
/// - `.gone-<prefix>-<ts_digits>-<seq_digits>` / `.gone-<ts_digits>-<seq_digits>` (legacy sibling `tombstone_dir` format).
/// Never matches `<name>.json` manifests or arbitrary dot-prefixed names like `.gone-project`.
fn is_stray_tombstone_name(name : String) -> Bool {
  let bytes = name.to_bytes()
  let len = bytes.length()
  if name.starts_with(".gone-") {
    if len <= 8 {
      return false
    }
    let mut dash2 = -1
    let mut k = len - 1
    while k >= 6 {
      if (bytes[k].to_int() & 0xFF) == 45 {
        dash2 = k
        break
      }
      k = k - 1
    }
    if dash2 <= 6 || !is_ascii_digits_slice(bytes, dash2 + 1, len) {
      return false
    }
    let mut dash1 = -1
    let mut m = dash2 - 1
    while m >= 5 {
      if (bytes[m].to_int() & 0xFF) == 45 {
        dash1 = m
        break
      }
      m = m - 1
    }
    if dash1 < 5 || !is_ascii_digits_slice(bytes, dash1 + 1, dash2) {
      return false
    }
    return true
  }
  if len <= 64 || (len - 64) % 14 != 0 {
    return false
  }
  for i in 0..<64 {
    if !is_hex_lower_byte(bytes[i].to_int()) {
      return false
    }
  }
  let mut i = 64
  while i < len {
    if bytes[i] != (46 as Byte) || bytes[i + 1] != (103 as Byte) || bytes[i + 2] != (111 as Byte) || bytes[i + 3] != (110 as Byte) || bytes[i + 4] != (101 as Byte) || bytes[i + 5] != (45 as Byte) {
      return false
    }
    for j in (i + 6)..<(i + 14) {
      if !is_hex_lower_byte(bytes[j].to_int()) {
        return false
      }
    }
    i = i + 14
  }
  true
}

/// Resumable cooperative cursor for `RemoteManager::step_sweep` so directory traversal and
/// recursive deletion yield back to the single-threaded event loop every `budget` entries (default 256).
pub struct RemoteSweepCursor {
  now_ms : Int64
  low_disk : Bool
  disk_total : Option[Int64]
  mut phase : Int // 0=mirrors, 1=idle_rooms, 2=measure_rooms, 3=budget_evict, 4=expire_tasks, 5=stray_tombstones, 6=done
  mut idx : Int
  mut rm_cursor : Option[RemoveTreeCursor]
  mut walk_cursor : Option[WalkCursor]
  mut cur_room_bytes : Int64
  mut pending_evict_bytes : Int64
  usages : Array[RoomUsage]
  mut total_bytes : Int64
  budget : Int64
  rooms_removed : Array[String]
  mirrors_removed : Array[String]
  tasks_expired : Array[String]
  budget_evicted_rooms : Array[String]
  stray_tombstones : Array[String]
  pub mut processed : Int
  mut finished : Option[RemoteSweepReport]
}

pub fn RemoteManager::begin_sweep(
  self : RemoteManager,
  now_ms : Int64,
  low_disk : Bool = false,
  disk_total : Option[Int64] = None,
) -> RemoteSweepCursor {
  let _ = self.root.length()
  RemoteSweepCursor::{
    now_ms: now_ms,
    low_disk: low_disk,
    disk_total: disk_total,
    phase: 0,
    idx: 0,
    rm_cursor: None,
    walk_cursor: None,
    cur_room_bytes: 0.to_int64(),
    pending_evict_bytes: 0.to_int64(),
    usages: [],
    total_bytes: 0.to_int64(),
    budget: remote_budget(disk_total),
    rooms_removed: [],
    mirrors_removed: [],
    tasks_expired: [],
    budget_evicted_rooms: [],
    stray_tombstones: [],
    processed: 0,
    finished: None,
  }
}

/// Advances a remote sweep by at most `budget` filesystem entries (default `WALK_YIELD_EVERY = 256`)
/// before returning `SweepStep::Yielded` so the main event loop is never blocked.
pub fn RemoteManager::step_sweep(
  self : RemoteManager,
  cur : RemoteSweepCursor,
  budget : Int = WALK_YIELD_EVERY,
) -> SweepStep {
  match cur.finished {
    Some(rep) => return SweepStep::Done(rep)
    None => ()
  }
  let limit = if budget > 0 { budget } else { WALK_YIELD_EVERY }
  let mut used = 0

  while true {
    if used >= limit {
      return SweepStep::Yielded(cur.processed)
    }
    if cur.phase == 0 {
      // Phase 0: atomically tombstone idle mirrors past mirror_age, mark Cleaned immediately,
      // then cooperatively delete the tombstone via RemoveTreeCursor.
      match cur.rm_cursor {
        Some(rmc) => {
          let before = rmc.visited
          let rem = limit - used
          match rmc.step(rem) {
            RemoveTreeStep::Yielded(_) => {
              let delta = rmc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              return SweepStep::Yielded(cur.processed)
            }
            RemoveTreeStep::Done(_) => {
              let delta = rmc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              cur.rm_cursor = None
            }
          }
          continue
        }
        None => ()
      }
      if cur.idx >= self.mirror_keys.length() {
        cur.phase = 1
        cur.idx = 0
        continue
      }
      let mirror_age = if cur.low_disk { MIRROR_RECENT_MS } else { MIRROR_IDLE_MS }
      let mk = self.mirror_keys[cur.idx]
      cur.idx = cur.idx + 1
      match self.mirrors_map.get(mk) {
        Some(m) => {
          let can_clean = match m.state {
            MirrorState::Idle => {
              cur.now_ms - m.last_used_at >= mirror_age && !self.path_has_live_remote_job(m.path)
            }
            _ => false
          }
          if can_clean {
            match self.tombstone_dir(m.path, cur.now_ms) {
              TombstoneOutcome::Renamed(tomb) => {
                m.state = MirrorState::Cleaned
                m.bytes = 0.to_int64()
                cur.mirrors_removed.push(mk)
                cur.rm_cursor = Some(RemoveTreeCursor::new(self.fs, tomb))
              }
              TombstoneOutcome::Missing => {
                m.state = MirrorState::Cleaned
                m.bytes = 0.to_int64()
                cur.mirrors_removed.push(mk)
              }
              TombstoneOutcome::Failed => ()
            }
          }
          used = used + 1
          cur.processed = cur.processed + 1
        }
        None => {
          used = used + 1
          cur.processed = cur.processed + 1
        }
      }
    } else if cur.phase == 1 {
      // Phase 1: atomically tombstone expired idle rooms past REMOTE_IDLE_MS, mark closed immediately,
      // then cooperatively delete the tombstone via RemoveTreeCursor.
      match cur.rm_cursor {
        Some(rmc) => {
          let before = rmc.visited
          let rem = limit - used
          match rmc.step(rem) {
            RemoveTreeStep::Yielded(_) => {
              let delta = rmc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              return SweepStep::Yielded(cur.processed)
            }
            RemoveTreeStep::Done(_) => {
              let delta = rmc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              cur.rm_cursor = None
            }
          }
          continue
        }
        None => ()
      }
      if cur.idx >= self.room_ids.length() {
        cur.phase = 2
        cur.idx = 0
        continue
      }
      let rid = self.room_ids[cur.idx]
      cur.idx = cur.idx + 1
      match self.rooms.get(rid) {
        Some(r) => {
          if !r.closed && cur.now_ms - r.last_used_at >= REMOTE_IDLE_MS && !self.room_has_active_tasks(rid) {
            let room_dir = nodepath::join(self.fs.sep, [self.root, "sessions", rid])
            match self.tombstone_dir(room_dir, cur.now_ms) {
              TombstoneOutcome::Renamed(tomb) => {
                r.closed = true
                cur.rooms_removed.push(rid)
                cur.rm_cursor = Some(RemoveTreeCursor::new(self.fs, tomb))
              }
              TombstoneOutcome::Missing => {
                r.closed = true
                cur.rooms_removed.push(rid)
              }
              TombstoneOutcome::Failed => ()
            }
          }
          used = used + 1
          cur.processed = cur.processed + 1
        }
        None => {
          used = used + 1
          cur.processed = cur.processed + 1
        }
      }
    } else if cur.phase == 2 {
      // Phase 2: measure remaining open rooms cooperatively via WalkCursor
      match cur.walk_cursor {
        Some(wc) => {
          let before = wc.visited
          let rem = limit - used
          match wc.step(fn(e : WalkEntry) -> VisitAction {
            match e.stats {
              Some(st) => {
                if st.size > 0.to_int64() {
                  cur.cur_room_bytes = cur.cur_room_bytes + st.size
                }
              }
              None => ()
            }
            VisitAction::Continue
          }, rem, false) {
            WalkStep::Yielded(_) => {
              let delta = wc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              return SweepStep::Yielded(cur.processed)
            }
            WalkStep::Done(_) => {
              let delta = wc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              cur.walk_cursor = None
              let rid = self.room_ids[cur.idx]
              match self.rooms.get(rid) {
                Some(r) => {
                  cur.total_bytes = cur.total_bytes + cur.cur_room_bytes
                  cur.usages.push(RoomUsage::{
                    room_id: rid,
                    last_used_at: r.last_used_at,
                    bytes: cur.cur_room_bytes,
                  })
                }
                None => ()
              }
              cur.cur_room_bytes = 0.to_int64()
              cur.idx = cur.idx + 1
            }
          }
          continue
        }
        None => ()
      }
      if cur.idx >= self.room_ids.length() {
        // Sort oldest last_used_at first for phase 3 budget eviction.
        for i in 1..<cur.usages.length() {
          let item = cur.usages[i]
          let mut j = i - 1
          while j >= 0 && cur.usages[j].last_used_at > item.last_used_at {
            cur.usages[j + 1] = cur.usages[j]
            j = j - 1
          }
          cur.usages[j + 1] = item
        }
        cur.phase = 3
        cur.idx = 0
        continue
      }
      let rid = self.room_ids[cur.idx]
      match self.rooms.get(rid) {
        Some(r) => {
          if r.closed {
            cur.idx = cur.idx + 1
            used = used + 1
            cur.processed = cur.processed + 1
          } else {
            let room_dir = nodepath::join(self.fs.sep, [self.root, "sessions", rid])
            let opts = WalkOptions::{
              same_device: true,
              max_entries: 200000,
              max_depth: 256,
              max_duration_ms: 60000.to_int64(),
              yield_every: limit,
              need_stat: true,
              follow_root: false,
              follow_links: false,
            }
            cur.cur_room_bytes = 0.to_int64()
            cur.walk_cursor = Some(WalkCursor::new(self.fs, [room_dir], opts))
          }
        }
        None => {
          cur.idx = cur.idx + 1
          used = used + 1
          cur.processed = cur.processed + 1
        }
      }
    } else if cur.phase == 3 {
      // Phase 3: atomically tombstone oldest idle rooms exceeding remote_budget(disk_total),
      // mark closed immediately, then cooperatively delete the tombstone via RemoveTreeCursor.
      match cur.rm_cursor {
        Some(rmc) => {
          let before = rmc.visited
          let rem = limit - used
          match rmc.step(rem) {
            RemoveTreeStep::Yielded(_) => {
              let delta = rmc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              return SweepStep::Yielded(cur.processed)
            }
            RemoveTreeStep::Done(ok) => {
              let delta = rmc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              cur.rm_cursor = None
              if ok {
                cur.total_bytes = cur.total_bytes - cur.pending_evict_bytes
              }
              cur.pending_evict_bytes = 0.to_int64()
            }
          }
          continue
        }
        None => ()
      }
      if cur.total_bytes <= cur.budget || cur.idx >= cur.usages.length() {
        cur.phase = 4
        cur.idx = 0
        continue
      }
      let u = cur.usages[cur.idx]
      cur.idx = cur.idx + 1
      if cur.now_ms - u.last_used_at >= ROOM_RECENT_MS && !self.room_has_active_tasks(u.room_id) {
        match self.rooms.get(u.room_id) {
          Some(r) => {
            if !r.closed {
              let room_dir = nodepath::join(self.fs.sep, [self.root, "sessions", u.room_id])
              match self.tombstone_dir(room_dir, cur.now_ms) {
                TombstoneOutcome::Renamed(tomb) => {
                  r.closed = true
                  cur.budget_evicted_rooms.push(u.room_id)
                  cur.pending_evict_bytes = u.bytes
                  cur.rm_cursor = Some(RemoveTreeCursor::new(self.fs, tomb))
                }
                TombstoneOutcome::Missing => {
                  r.closed = true
                  cur.budget_evicted_rooms.push(u.room_id)
                  cur.total_bytes = cur.total_bytes - u.bytes
                }
                TombstoneOutcome::Failed => ()
              }
            }
          }
          None => ()
        }
      }
      used = used + 1
      cur.processed = cur.processed + 1
    } else if cur.phase == 4 {
      // Phase 4: expire old finished tasks and compact `task_keys` + `job_to_task`
      let kept_keys : Array[String] = []
      for i in 0..<self.task_keys.length() {
        let k = self.task_keys[i]
        match self.tasks.get(k) {
          Some(t) => {
            let expired = if remote_task_is_done(t.state) && !t.pending_results {
              match t.ended_at {
                Some(ended) => cur.now_ms - ended >= TASKS_KEPT_MS
                None => false
              }
            } else {
              false
            }
            if expired {
              match t.job_id {
                Some(jid) => self.job_to_task.remove(jid)
                None => ()
              }
              self.tasks.remove(k)
              cur.tasks_expired.push(k)
            } else {
              kept_keys.push(k)
            }
          }
          None => ()
        }
      }
      self.task_keys = kept_keys
      let tomb_root = nodepath::join(self.fs.sep, [self.root, "tombstones"])
      match (self.fs.read_dir)(tomb_root) {
        Some(tnames) => {
          for ti in 0..<tnames.length() {
            if tnames[ti] != "." && tnames[ti] != ".." {
              cur.stray_tombstones.push(nodepath::join(self.fs.sep, [tomb_root, tnames[ti]]))
            }
          }
        }
        None => ()
      }
      let sessions_dir = nodepath::join(self.fs.sep, [self.root, "sessions"])
      match (self.fs.read_dir)(sessions_dir) {
        Some(names) => {
          for i in 0..<names.length() {
            if is_stray_tombstone_name(names[i]) {
              let cand = nodepath::join(self.fs.sep, [sessions_dir, names[i]])
              match (self.fs.lstat)(cand) {
                Some(st) => if st.is_dir() && !st.is_symlink() {
                  cur.stray_tombstones.push(cand)
                }
                None => ()
              }
            }
          }
        }
        None => ()
      }
      cur.phase = 5
      cur.idx = 0
      continue
    } else {
      // Phase 5: cooperatively remove stray `.gone-*` / `<64hex>.gone-<8hex>` tombstones left across restarts.
      match cur.rm_cursor {
        Some(rmc) => {
          let before = rmc.visited
          let rem = limit - used
          match rmc.step(rem) {
            RemoveTreeStep::Yielded(_) => {
              let delta = rmc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              return SweepStep::Yielded(cur.processed)
            }
            RemoveTreeStep::Done(_) => {
              let delta = rmc.visited - before
              let inc = if delta > 0 { delta } else { 1 }
              used = used + inc
              cur.processed = cur.processed + inc
              cur.rm_cursor = None
            }
          }
          continue
        }
        None => ()
      }
      if cur.idx < cur.stray_tombstones.length() {
        let tomb = cur.stray_tombstones[cur.idx]
        cur.idx = cur.idx + 1
        cur.rm_cursor = Some(RemoveTreeCursor::new(self.fs, tomb))
        used = used + 1
        cur.processed = cur.processed + 1
        continue
      }
      let rep = RemoteSweepReport::{
        rooms_removed: cur.rooms_removed,
        mirrors_removed: cur.mirrors_removed,
        tasks_expired: cur.tasks_expired,
        budget_evicted_rooms: cur.budget_evicted_rooms,
      }
      cur.phase = 6
      cur.finished = Some(rep)
      return SweepStep::Done(rep)
    }
  }
  SweepStep::Yielded(cur.processed)
}

/// Convenience wrapper driving `begin_sweep` + `step_sweep` to completion.
/// Main event-loop callers should drive `step_sweep(cursor, WALK_YIELD_EVERY)` per tick.
pub fn RemoteManager::sweep(
  self : RemoteManager,
  now_ms : Int64,
  low_disk : Bool = false,
  disk_total : Option[Int64] = None,
) -> RemoteSweepReport {
  let cur = self.begin_sweep(now_ms, low_disk, disk_total)
  while true {
    match self.step_sweep(cur, WALK_YIELD_EVERY) {
      SweepStep::Yielded(_) => ()
      SweepStep::Done(rep) => return rep
    }
  }
  RemoteSweepReport::{
    rooms_removed: [],
    mirrors_removed: [],
    tasks_expired: [],
    budget_evicted_rooms: [],
  }
}

fn remote_task_state_from_str(s : String) -> RemoteTaskState {
  if s == "prepared" {
    RemoteTaskState::Prepared
  } else if s == "syncing" {
    RemoteTaskState::Syncing
  } else if s == "queued" {
    RemoteTaskState::Queued
  } else if s == "running" {
    RemoteTaskState::Running
  } else if s == "stopping" {
    RemoteTaskState::Stopping
  } else if s == "exited" {
    RemoteTaskState::Exited
  } else if s == "stopped" {
    RemoteTaskState::Stopped
  } else if s == "released" {
    RemoteTaskState::Released
  } else {
    RemoteTaskState::Failed
  }
}

fn RemoteManager::release_task_mirror_idle(self : RemoteManager, task : RemoteTaskRecord) -> Unit {
  match task.mirror_name {
    Some(mname) => {
      let mk = mirror_compound_key(task.room_id, mname)
      match self.mirrors_map.get(mk) {
        Some(m) => {
          if match m.active_task {
            Some(ak) => ak == task.task_id
            None => false
          } {
            m.state = MirrorState::Idle
            m.active_task = None
          }
        }
        None => ()
      }
    }
    None => ()
  }
}

fn RemoteManager::ensure_room_v2(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  now_ms : Int64,
) -> RemoteRoomRecord {
  let rid = remote_room_id_v2(workspace, source_station, source_session)
  match self.rooms.get(rid) {
    Some(r) => {
      if r.closed {
        let _ = (self.fs.mkdir_p)(r.work_dir)
      }
      r.last_used_at = now_ms
      r.closed = false
      r
    }
    None => {
      let work_dir = nodepath::join(self.fs.sep, [self.root, "sessions", rid, "work"])
      let _ = (self.fs.mkdir_p)(work_dir)
      let room = RemoteRoomRecord::{
        room_id: rid,
        workspace: workspace,
        source_station: source_station,
        source_session: source_session,
        work_dir: work_dir,
        last_used_at: now_ms,
        closed: false,
      }
      self.rooms.set(rid, room)
      self.room_ids.push(rid)
      room
    }
  }
}

fn RemoteManager::persist_incoming_task(self : RemoteManager, task : RemoteTaskRecord) -> Result[Unit, String] {
  if task.task_id.length() == 0 || task.workspace.length() == 0 || task.source_station.length() == 0 || task.source_session.length() == 0 {
    return Ok(())
  }
  let dir = nodepath::join(self.fs.sep, [self.root, "incoming", task.task_id])
  if !(self.fs.mkdir_p)(dir) {
    return Err("failed to create incoming task dir")
  }
  let back_arr : Array[base_codec::Json] = []
  for i in 0..<task.back_paths.length() {
    back_arr.push(base_codec::json_str(task.back_paths[i]))
  }
  let spec_obj = match base_codec::json_parse(task.spec_json) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(_) => {
      let sf : Array[(String, base_codec::Json)] = [
        ("name", base_codec::json_str(task.name)),
        ("command", base_codec::json_str(task.command)),
        ("back", base_codec::json_arr(back_arr)),
        ("screen", base_codec::json_bool(task.screen)),
        ("small", base_codec::json_bool(task.small)),
      ]
      match task.dir_source {
        Some(ds) => sf.push(("dir", base_codec::json_str(ds)))
        None => ()
      }
      base_codec::json_obj(sf)
    }
  }
  let upload_fields : Array[(String, base_codec::Json)] = []
  let ukeys = task.uploads.keys()
  for ui in 0..<ukeys.length() {
    let uk = ukeys[ui]
    match task.uploads.get(uk) {
      Some(done) => upload_fields.push((uk, base_codec::json_bool(done)))
      None => ()
    }
  }
  // 1:1 Node/MB `remote_target.mbt:166` field names (`spec`, `workspace`, `station`, `session`, `key`, `layout`, `mirror`, `push`, `uploads`, `synced`, `collected`).
  let fields : Array[(String, base_codec::Json)] = [
    ("spec", spec_obj),
    ("workspace", base_codec::json_str(task.workspace)),
    ("station", base_codec::json_str(task.source_station)),
    ("session", base_codec::json_str(task.source_session)),
    ("key", base_codec::json_str(task.key)),
    ("layout", base_codec::json_str("session")),
    ("state", base_codec::json_str(remote_task_state_str(task.state))),
    ("created_at", base_codec::json_int64(task.created_at)),
    ("uploads", base_codec::json_obj(upload_fields)),
    ("synced", base_codec::json_bool(task.synced)),
    ("collected", base_codec::json_bool(task.collected)),
    ("pending_results", base_codec::json_bool(task.pending_results)),
  ]
  match task.mirror_name {
    Some(m) => fields.push(("mirror", base_codec::json_str(m)))
    None => ()
  }
  match task.push_ref {
    Some(p) => fields.push(("push", base_codec::json_str(p)))
    None => ()
  }
  match task.job_id {
    Some(j) => fields.push(("job_id", base_codec::json_str(j)))
    None => ()
  }
  match task.exit_code {
    Some(c) => fields.push(("exit_code", base_codec::json_int(c)))
    None => ()
  }
  match task.queued_at {
    Some(q) => fields.push(("queued_at", base_codec::json_int64(q)))
    None => ()
  }
  match task.started_at {
    Some(s) => fields.push(("started_at", base_codec::json_int64(s)))
    None => ()
  }
  match task.ended_at {
    Some(e) => fields.push(("ended_at", base_codec::json_int64(e)))
    None => ()
  }
  let path = nodepath::join(self.fs.sep, [dir, "task.json"])
  let tmp = path + ".tmp"
  let data = (base_codec::json_stringify(base_codec::json_obj(fields)) + "\n").to_bytes()
  if !(self.fs.write_file_mode)(tmp, data, 384, false) {
    return Err("failed to write task.json")
  }
  if !(self.fs.rename)(tmp, path) {
    let _ = (self.fs.remove_file)(tmp)
    return Err("failed to rename task.json")
  }
  Ok(())
}

/// Reloads persisted `<data>/remote/incoming/<task_id>/task.json` records (both Node/MB and Pion format)
/// and reconciles them against adopted `self.jobs` records.
pub fn RemoteManager::adopt_incoming_tasks(self : RemoteManager, now_ms : Int64) -> Int {
  let inc_root = nodepath::join(self.fs.sep, [self.root, "incoming"])
  let dirs = match (self.fs.read_dir)(inc_root) {
    Some(ds) => ds
    None => return 0
  }
  let mut count = 0
  for i in 0..<dirs.length() {
    let tid = dirs[i]
    if sj_starts_with(tid, ".") {
      continue
    }
    let path = nodepath::join(self.fs.sep, [inc_root, tid, "task.json"])
    let raw = match (self.fs.read_file)(path) {
      Some(s) => s
      None => continue
    }
    let parsed = match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(j) => j
      base_codec::JsonParseResult::Err(_) => continue
    }
    let task_id = tid
    if self.tasks.contains(task_id) {
      continue
    }
    let key = match base_codec::json_get(parsed, "key") {
      Some(base_codec::Json::Str(s)) => s
      _ => continue
    }
    let ws = match base_codec::json_get(parsed, "workspace") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let src_st = match base_codec::json_get(parsed, "station") {
      Some(base_codec::Json::Str(s)) => s
      _ => match base_codec::json_get(parsed, "source_station") {
        Some(base_codec::Json::Str(s)) => s
        _ => ""
      }
    }
    let src_sess = match base_codec::json_get(parsed, "session") {
      Some(base_codec::Json::Str(s)) => s
      _ => match base_codec::json_get(parsed, "source_session") {
        Some(base_codec::Json::Str(s)) => s
        _ => ""
      }
    }
    let spec_v = match base_codec::json_get(parsed, "spec") {
      Some(s) => s
      None => parsed
    }
    let spec_json = base_codec::json_stringify(spec_v)
    let name = match base_codec::json_get(spec_v, "name") {
      Some(base_codec::Json::Str(s)) => s
      _ => key
    }
    let command = match base_codec::json_get(spec_v, "command") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let dir_source : Option[String] = match base_codec::json_get(spec_v, "dir") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => None
    }
    let mirror_name : Option[String] = match base_codec::json_get(parsed, "mirror") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => match base_codec::json_get(parsed, "mirror_name") {
        Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
        _ => None
      }
    }
    let push_ref : Option[String] = match base_codec::json_get(parsed, "push") {
      Some(base_codec::Json::Str(s)) => if is_hex64(s) { Some(s) } else { None }
      _ => None
    }
    let back_paths : Array[String] = []
    match base_codec::json_get(spec_v, "back") {
      Some(base_codec::Json::Arr(arr)) => {
        for ai in 0..<arr.length() {
          match arr[ai] {
            base_codec::Json::Str(s) => back_paths.push(s)
            _ => ()
          }
        }
      }
      _ => ()
    }
    let screen = match base_codec::json_get(spec_v, "screen") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let small = match base_codec::json_get(spec_v, "small") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let synced = match base_codec::json_get(parsed, "synced") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let collected = match base_codec::json_get(parsed, "collected") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let mut state = match base_codec::json_get(parsed, "state") {
      Some(base_codec::Json::Str(s)) => remote_task_state_from_str(s)
      _ => RemoteTaskState::Prepared
    }
    let default_jid = "remote_" + task_id
    let mut job_id : Option[String] = match base_codec::json_get(parsed, "job_id") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => if self.jobs.get(default_jid) is Some(_) { Some(default_jid) } else { None }
    }
    let mut exit_code : Option[Int] = match base_codec::json_get(parsed, "exit_code") {
      Some(base_codec::Json::Num(d, _)) => Some(d.to_int())
      _ => None
    }
    let created_at = match base_codec::json_get(parsed, "created_at") {
      Some(base_codec::Json::Num(d, _)) => d.to_int64()
      _ => now_ms
    }
    let queued_at : Option[Int64] = match base_codec::json_get(parsed, "queued_at") {
      Some(base_codec::Json::Num(d, _)) => Some(d.to_int64())
      _ => None
    }
    let started_at : Option[Int64] = match base_codec::json_get(parsed, "started_at") {
      Some(base_codec::Json::Num(d, _)) => Some(d.to_int64())
      _ => None
    }
    let mut ended_at : Option[Int64] = match base_codec::json_get(parsed, "ended_at") {
      Some(base_codec::Json::Num(d, _)) => Some(d.to_int64())
      _ => None
    }
    let pending_results = match base_codec::json_get(parsed, "pending_results") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let room = self.ensure_room_v2(ws, src_st, src_sess, now_ms)
    match job_id {
      Some(jid) => {
        self.job_to_task.set(jid, task_id)
        match self.jobs.get(jid) {
          Some(j) => {
            match j.state {
              JobState::Running => state = RemoteTaskState::Running
              JobState::Stopping => state = RemoteTaskState::Stopping
              JobState::Exited => {
                state = RemoteTaskState::Exited
                exit_code = j.exit_code
                ended_at = j.ended_at
              }
              JobState::Stopped => {
                state = RemoteTaskState::Stopped
                exit_code = j.exit_code
                ended_at = j.ended_at
              }
              JobState::Failed => {
                state = RemoteTaskState::Failed
                exit_code = j.exit_code
                ended_at = j.ended_at
              }
              _ => ()
            }
          }
          None => ()
        }
      }
      None => ()
    }
    let uploads_map : Map[String, Bool] = Map::new()
    match base_codec::json_get(parsed, "uploads") {
      Some(base_codec::Json::Obj(ufs)) => {
        for ui in 0..<ufs.length() {
          let (uk, uv) = ufs[ui]
          match uv {
            base_codec::Json::Bool(b) => uploads_map.set(uk, b)
            _ => ()
          }
        }
      }
      _ => ()
    }
    let rec = RemoteTaskRecord::{
      task_id: task_id,
      key: key,
      room_id: room.room_id,
      workspace: ws,
      source_station: src_st,
      source_session: src_sess,
      name: name,
      command: command,
      mirror_name: mirror_name,
      dir_source: dir_source,
      spec_json: spec_json,
      back_paths: back_paths,
      screen: screen,
      small: small,
      push_ref: push_ref,
      uploads: uploads_map,
      synced: synced,
      collected: collected,
      state: state,
      job_id: job_id,
      exit_code: exit_code,
      created_at: created_at,
      queued_at: queued_at,
      started_at: started_at,
      ended_at: ended_at,
      pending_results: pending_results,
    }
    self.tasks.set(task_id, rec)
    self.task_keys.push(task_id)
    count = count + 1
  }
  count
}

/// Prepares a scoped remote task keyed by full 64-char `remote_task_id(ws, peer, session, key)`.
/// Rejects conflicting re-prepare of the same key with different `spec_json`, and derives safe
/// mirror names from `spec.dir` (never using raw `spec.dir` as a directory name).
pub fn RemoteManager::prepare_scoped(
  self : RemoteManager,
  req : RemotePrepareRequest,
  now_ms : Int64,
  spec_json : String = "",
) -> Result[RemoteTaskRecord, String] {
  if req.workspace.length() == 0 || req.source_station.length() == 0 || req.source_session.length() == 0 {
    return Err("workspace, peer, and session are required")
  }
  if req.key.length() == 0 || req.key.length() > 128 {
    return Err("task key is required (max 128 chars)")
  }
  if req.command.length() == 0 {
    return Err("task command is required")
  }
  let tid = remote_task_id(req.workspace, req.source_station, req.source_session, req.key)
  match self.tasks.get(tid) {
    Some(existing) => {
      if spec_json.length() > 0 && existing.spec_json.length() > 0 {
        let eq = match (base_codec::json_parse(existing.spec_json), base_codec::json_parse(spec_json)) {
          (base_codec::JsonParseResult::Ok(ja), base_codec::JsonParseResult::Ok(jb)) => json_deep_eq(ja, jb)
          _ => existing.spec_json == spec_json
        }
        if !eq {
          return Err("task key already used with different inputs; choose a new key for new work")
        }
      }
      if existing.command != req.command || existing.name != (if req.name.length() > 0 { req.name } else { req.key }) {
        return Err("task key already used with different inputs; choose a new key for new work")
      }
      return Ok(existing)
    }
    None => ()
  }
  let room = self.ensure_room_v2(req.workspace, req.source_station, req.source_session, now_ms)
  let mut derived_mirror : Option[String] = None
  match req.mirror_name {
    Some(raw_dir) => {
      let claimed : Map[String, String] = Map::new()
      for ti in 0..<self.task_keys.length() {
        match self.tasks.get(self.task_keys[ti]) {
          Some(other) => {
            if other.room_id == room.room_id {
              match (other.mirror_name, other.dir_source) {
                (Some(om), Some(od)) => claimed.set(om, od)
                _ => ()
              }
            }
          }
          None => ()
        }
      }
      let mname = derive_mirror_name(raw_dir, claimed)
      let mk = mirror_compound_key(room.room_id, mname)
      if !self.mirrors_map.contains(mk) {
        let mpath = nodepath::join(self.fs.sep, [room.work_dir, mname])
        let _ = (self.fs.mkdir_p)(mpath)
        self.mirrors_map.set(
          mk,
          MirrorRecord::{
            name: mname,
            room_id: room.room_id,
            path: mpath,
            state: MirrorState::Idle,
            active_task: None,
            last_used_at: now_ms,
            bytes: 0.to_int64(),
            manifest_hash: "",
          },
        )
        self.mirror_keys.push(mk)
      }
      derived_mirror = Some(mname)
    }
    None => ()
  }
  let task = RemoteTaskRecord::{
    task_id: tid,
    key: req.key,
    room_id: room.room_id,
    workspace: req.workspace,
    source_station: req.source_station,
    source_session: req.source_session,
    name: if req.name.length() > 0 { req.name } else { req.key },
    command: req.command,
    mirror_name: derived_mirror,
    dir_source: req.mirror_name,
    spec_json: spec_json,
    back_paths: req.back_paths,
    screen: req.screen,
    small: req.small,
    push_ref: None,
    uploads: Map::new(),
    synced: false,
    collected: false,
    state: RemoteTaskState::Prepared,
    job_id: None,
    exit_code: None,
    created_at: now_ms,
    queued_at: None,
    started_at: None,
    ended_at: None,
    pending_results: false,
  }
  match self.persist_incoming_task(task) {
    Ok(_) => {
      self.tasks.set(tid, task)
      self.task_keys.push(tid)
      Ok(task)
    }
    Err(e) => Err(e)
  }
}

pub fn RemoteManager::get_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  key : String,
) -> Option[RemoteTaskRecord] {
  self.tasks.get(remote_task_id(workspace, source_station, source_session, key))
}

pub fn RemoteManager::set_task_push_ref(
  self : RemoteManager,
  task : RemoteTaskRecord,
  push_ref : String,
) -> Result[Unit, String] {
  if is_hex64(push_ref) {
    task.push_ref = Some(push_ref)
    self.persist_incoming_task(task)
  } else {
    Ok(())
  }
}

pub fn RemoteManager::record_task_upload(
  self : RemoteManager,
  task : RemoteTaskRecord,
  rel_path : String,
  complete : Bool,
) -> Result[Unit, String] {
  let prev = task.uploads.get(rel_path)
  task.uploads.set(rel_path, complete)
  match self.persist_incoming_task(task) {
    Ok(_) => Ok(())
    Err(e) => {
      match prev {
        Some(v) => task.uploads.set(rel_path, v)
        None => task.uploads.remove(rel_path)
      }
      Err(e)
    }
  }
}

pub fn RemoteManager::mark_task_synced(
  self : RemoteManager,
  task : RemoteTaskRecord,
) -> Result[Unit, String] {
  let prev = task.synced
  task.synced = true
  match self.persist_incoming_task(task) {
    Ok(_) => Ok(())
    Err(e) => {
      task.synced = prev
      Err(e)
    }
  }
}

pub fn RemoteManager::mark_task_collected(
  self : RemoteManager,
  task : RemoteTaskRecord,
) -> Result[Unit, String] {
  let prev_c = task.collected
  let prev_p = task.pending_results
  task.collected = true
  task.pending_results = false
  match self.persist_incoming_task(task) {
    Ok(_) => Ok(())
    Err(e) => {
      task.collected = prev_c
      task.pending_results = prev_p
      Err(e)
    }
  }
}

pub fn RemoteManager::start_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  key : String,
  now_ms : Int64,
  needs_sync : Bool = false,
  pressure : Option[Pressure] = None,
  person_present : Bool = false,
) -> Result[RemoteTaskRecord, String] {
  let tid = remote_task_id(workspace, source_station, source_session, key)
  if !self.tasks.contains(tid) {
    return Err("unknown remote task: " + key)
  }
  self.start(tid, now_ms, needs_sync=needs_sync, pressure=pressure, person_present=person_present)
}

pub fn RemoteManager::sync_complete_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  key : String,
  manifest_hash : String,
  now_ms : Int64,
  pressure : Option[Pressure] = None,
  person_present : Bool = false,
) -> Result[RemoteTaskRecord, String] {
  let tid = remote_task_id(workspace, source_station, source_session, key)
  if !self.tasks.contains(tid) {
    return Err("unknown remote task: " + key)
  }
  self.sync_complete(tid, manifest_hash, now_ms, pressure=pressure, person_present=person_present)
}

pub fn RemoteManager::log_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  key : String,
  lines : Int = JOB_LOG_LINES_DEFAULT,
) -> Result[String, String] {
  let tid = remote_task_id(workspace, source_station, source_session, key)
  if !self.tasks.contains(tid) {
    return Err("unknown remote task: " + key)
  }
  self.log(tid, lines=lines)
}

pub fn RemoteManager::stop_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  key : String,
  now_ms : Int64,
) -> Result[RemoteTaskRecord, String] {
  let tid = remote_task_id(workspace, source_station, source_session, key)
  if !self.tasks.contains(tid) {
    return Err("unknown remote task: " + key)
  }
  self.stop(tid, now_ms)
}

pub fn RemoteManager::release_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  key : String,
) -> Result[RemoteTaskRecord, String] {
  let tid = remote_task_id(workspace, source_station, source_session, key)
  if !self.tasks.contains(tid) {
    return Err("unknown remote task: " + key)
  }
  match self.release(tid) {
    Ok(t) => {
      let _ = self.persist_incoming_task(t)
      Ok(t)
    }
    Err(e) => Err(e)
  }
}

pub fn RemoteManager::list_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
) -> Array[RemoteTaskRecord] {
  let rid = remote_room_id_v2(workspace, source_station, source_session)
  self.list(room_id_opt=Some(rid))
}

pub fn RemoteManager::mirrors_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
) -> Array[MirrorRecord] {
  let rid = remote_room_id_v2(workspace, source_station, source_session)
  self.mirrors(room_id_opt=Some(rid))
}

pub fn RemoteManager::clean_mirror_scoped(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  mirror_name : String,
) -> Result[Bool, String] {
  let rid = remote_room_id_v2(workspace, source_station, source_session)
  self.clean_mirror(rid, mirror_name)
}

pub fn RemoteManager::task_base_dir(self : RemoteManager, task : RemoteTaskRecord) -> String {
  match task.mirror_name {
    Some(mname) => {
      let mk = mirror_compound_key(task.room_id, mname)
      match self.mirrors_map.get(mk) {
        Some(m) => m.path
        None => nodepath::join(self.fs.sep, [self.root, "sessions", task.room_id, "work", mname])
      }
    }
    None => {
      match self.rooms.get(task.room_id) {
        Some(r) => r.work_dir
        None => nodepath::join(self.fs.sep, [self.root, "sessions", task.room_id, "work"])
      }
    }
  }
}

pub fn RemoteManager::session_work_dir(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  now_ms : Int64,
) -> String {
  let room = self.ensure_room_v2(workspace, source_station, source_session, now_ms)
  room.work_dir
}

pub fn RemoteManager::session_work_size(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
) -> (Bool, Int64) {
  let rid = remote_room_id_v2(workspace, source_station, source_session)
  let room_dir = nodepath::join(self.fs.sep, [self.root, "sessions", rid])
  match (self.fs.lstat)(room_dir) {
    None => (false, 0L)
    Some(_) => {
      let sz = tree_bytes(self.fs, room_dir)
      (true, sz.bytes)
    }
  }
}

/// Recursively lists files under `rel` relative to `cwd` (`remote_target.mbt:460` `visit_files`),
/// sorting directory entries lexicographically and capping at 1000 files.
pub fn visit_files_recursive(
  fs : FsPort,
  cwd : String,
  rel : String,
  out : Array[(String, Option[Int64])],
) -> Result[Unit, String] {
  if out.length() >= 1000 {
    return Err("more than 1000 files to bring back")
  }
  let full = match safe_transfer_path(fs, cwd, rel, false) {
    Ok(p) => p
    Err(_) => {
      out.push((rel, None))
      return Ok(())
    }
  }
  match (fs.lstat)(full) {
    None => {
      out.push((rel, None))
      Ok(())
    }
    Some(st) => {
      if st.is_file() {
        out.push((rel, Some(st.size)))
        Ok(())
      } else if st.is_dir() && !st.is_symlink() {
        let names = match (fs.read_dir)(full) {
          Some(ns) => ns
          None => return Ok(())
        }
        // Sort names lexicographically (insertion sort).
        for i in 1..<names.length() {
          let cur = names[i]
          let mut j = i - 1
          while j >= 0 && names[j] > cur {
            names[j + 1] = names[j]
            j = j - 1
          }
          names[j + 1] = cur
        }
        let mut base = rel
        while base.ends_with("/") && base.length() > 0 {
          base = sj_slice_str(base, 0, base.length() - 1)
        }
        for i in 0..<names.length() {
          let child_rel = if base.length() > 0 { base + "/" + names[i] } else { names[i] }
          match visit_files_recursive(fs, cwd, child_rel, out) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        Ok(())
      } else {
        Ok(())
      }
    }
  }
}

/// Cancels all queued, syncing, running, or stopping tasks & jobs for `(workspace, peer, session)`.
pub fn RemoteManager::cancel_session_tasks(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  now_ms : Int64,
) -> Int {
  let rid = remote_room_id_v2(workspace, source_station, source_session)
  let mut count = 0
  for i in 0..<self.task_keys.length() {
    let tid = self.task_keys[i]
    match self.tasks.get(tid) {
      Some(t) => {
        if t.room_id == rid && !remote_task_is_done(t.state) {
          let _ = self.stop(tid, now_ms)
          count = count + 1
        }
      }
      None => ()
    }
  }
  let owner = "remote:" + workspace + ":" + source_station + ":" + source_session
  let js = self.jobs.list(session_opt=Some(owner))
  for ji in 0..<js.length() {
    if job_state_is_up(js[ji].state) {
      let _ = self.jobs.stop(js[ji].id, now_ms, false)
      count = count + 1
    }
  }
  count
}

/// Cancels all active tasks & jobs owned by `(workspace, peer)` (e.g. peer left roster).
pub fn RemoteManager::cancel_peer_tasks(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  now_ms : Int64,
) -> Int {
  let mut count = 0
  for i in 0..<self.task_keys.length() {
    let tid = self.task_keys[i]
    match self.tasks.get(tid) {
      Some(t) => {
        if t.workspace == workspace && t.source_station == source_station && !remote_task_is_done(t.state) {
          let _ = self.stop(tid, now_ms)
          count = count + 1
        }
      }
      None => ()
    }
  }
  let prefix = "remote:" + workspace + ":" + source_station + ":"
  let js = self.jobs.list()
  for ji in 0..<js.length() {
    if job_state_is_up(js[ji].state) && sj_starts_with(js[ji].session, prefix) {
      let _ = self.jobs.stop(js[ji].id, now_ms, false)
      count = count + 1
    }
  }
  count
}

/// Cancels all active tasks & jobs for `workspace` (e.g. rig removed from workspace).
pub fn RemoteManager::cancel_workspace_tasks(
  self : RemoteManager,
  workspace : String,
  now_ms : Int64,
) -> Int {
  let mut count = 0
  for i in 0..<self.task_keys.length() {
    let tid = self.task_keys[i]
    match self.tasks.get(tid) {
      Some(t) => {
        if t.workspace == workspace && !remote_task_is_done(t.state) {
          let _ = self.stop(tid, now_ms)
          count = count + 1
        }
      }
      None => ()
    }
  }
  let prefix = "remote:" + workspace + ":"
  let js = self.jobs.list()
  for ji in 0..<js.length() {
    if job_state_is_up(js[ji].state) && sj_starts_with(js[ji].session, prefix) {
      let _ = self.jobs.stop(js[ji].id, now_ms, false)
      count = count + 1
    }
  }
  count
}

/// Stops all tasks/jobs in `(workspace, peer, session)` and removes its room directory.
pub fn RemoteManager::close_session_room(
  self : RemoteManager,
  workspace : String,
  source_station : String,
  source_session : String,
  now_ms : Int64,
) -> Bool {
  let _ = self.cancel_session_tasks(workspace, source_station, source_session, now_ms)
  let rid = remote_room_id_v2(workspace, source_station, source_session)
  let room_dir = nodepath::join(self.fs.sep, [self.root, "sessions", rid])
  match self.tombstone_dir(room_dir, now_ms) {
    TombstoneOutcome::Renamed(tomb) => {
      match self.rooms.get(rid) {
        Some(r) => r.closed = true
        None => ()
      }
      let _ = (self.fs.remove_dir_all)(tomb)
      true
    }
    TombstoneOutcome::Missing => {
      match self.rooms.get(rid) {
        Some(r) => r.closed = true
        None => ()
      }
      true
    }
    TombstoneOutcome::Failed => false
  }
}
