// Comprehensive unit tests for `station_jobs`:
// - Bounded `walk_bounded` (symlinks, cycles, same_device, max_depth, max_entries, max_duration)
// - `STORAGE_MANIFEST`, `rotate_in_place` (inode preserved), `UpkeepState`, `Upkeep` & `prune_repo_worktrees` safety boundaries
// - `load::measure`, PSI, CPU busy delta, `load_summary`, `NetRelay`
// - `memory::units_of` (self & agent exclusion), `kmsg_kill`, `MemoryWatch` (normal/high/critical/close)
// - `JobManager` (start, stdout/stderr log, tail, stop, web-service restart backoff, `notify` & `screen` protocols, upkeep)
// - `RemoteManager` (prepare, dirsync Syncing -> Queued -> Running -> Exited/PendingRelease -> release, clean_mirror, sweep, `safe_transfer_path`)
// - Preview target & WebSocket framing

import "base_codec"
import "station_sys"

fn expect(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic(msg)
  }
}

// ---------------------------------------------------------------------------
// Deterministic in-memory FsPort for unit tests (tracks inodes & truncations)
// ---------------------------------------------------------------------------

struct MemNode {
  mut kind : String // "file" | "dir" | "link"
  mut data : Bytes
  mut link_target : String
  mut mtime_ms : Int64
  mut dev : Int64
  ino : Int64
  mut truncated_in_place_count : Int
}

struct MemFs {
  nodes : Map[String, MemNode]
  paths : Array[String]
  mut next_ino : Int64
  mut now_ms : Int64
}

fn MemFs::new(now_ms : Int64 = 1000000.to_int64()) -> MemFs {
  let m = MemFs::{
    nodes: Map::new(),
    paths: [],
    next_ino: 100.to_int64(),
    now_ms: now_ms,
  }
  m.put_dir("/", 1.to_int64(), now_ms)
  m
}

fn norm_mem_path(p : String) -> String {
  let n = nodepath::join("/", [p])
  if n.length() > 1 && sj_ends_with(n, "/") {
    sj_slice_str(n, 0, n.length() - 1)
  } else {
    n
  }
}

fn MemFs::ensure_parents(self : MemFs, p : String, dev : Int64) -> Unit {
  let norm = norm_mem_path(p)
  let parent = nodepath::dirname("/", norm)
  if parent != norm && parent.length() > 0 && !self.nodes.contains(parent) {
    self.ensure_parents(parent, dev)
    self.put_dir(parent, dev, self.now_ms)
  }
}

fn MemFs::put_dir(self : MemFs, p : String, dev : Int64 = 1.to_int64(), mtime_ms : Int64 = -1.to_int64()) -> Unit {
  let norm = norm_mem_path(p)
  if self.nodes.contains(norm) {
    return
  }
  if norm != "/" {
    self.ensure_parents(norm, dev)
  }
  let ino = self.next_ino
  self.next_ino = self.next_ino + 1.to_int64()
  let mt = if mtime_ms < 0.to_int64() { self.now_ms } else { mtime_ms }
  self.nodes.set(
    norm,
    MemNode::{
      kind: "dir",
      data: Bytes::new(0),
      link_target: "",
      mtime_ms: mt,
      dev: dev,
      ino: ino,
      truncated_in_place_count: 0,
    },
  )
  self.paths.push(norm)
}

fn MemFs::put_file(
  self : MemFs,
  p : String,
  content : String,
  mtime_ms : Int64 = -1.to_int64(),
  dev : Int64 = 1.to_int64(),
) -> Unit {
  let norm = norm_mem_path(p)
  self.ensure_parents(norm, dev)
  let mt = if mtime_ms < 0.to_int64() { self.now_ms } else { mtime_ms }
  match self.nodes.get(norm) {
    Some(existing) => {
      existing.kind = "file"
      existing.data = content.to_bytes()
      existing.mtime_ms = mt
    }
    None => {
      let ino = self.next_ino
      self.next_ino = self.next_ino + 1.to_int64()
      self.nodes.set(
        norm,
        MemNode::{
          kind: "file",
          data: content.to_bytes(),
          link_target: "",
          mtime_ms: mt,
          dev: dev,
          ino: ino,
          truncated_in_place_count: 0,
        },
      )
      self.paths.push(norm)
    }
  }
}

fn MemFs::put_link(self : MemFs, p : String, target : String, dev : Int64 = 1.to_int64()) -> Unit {
  let norm = norm_mem_path(p)
  self.ensure_parents(norm, dev)
  let ino = self.next_ino
  self.next_ino = self.next_ino + 1.to_int64()
  self.nodes.set(
    norm,
    MemNode::{
      kind: "link",
      data: Bytes::new(0),
      link_target: target,
      mtime_ms: self.now_ms,
      dev: dev,
      ino: ino,
      truncated_in_place_count: 0,
    },
  )
  self.paths.push(norm)
}

fn MemFs::to_port(self : MemFs) -> FsPort {
  let node_stat = fn(n : MemNode) -> FsStat {
    FsStat::{
      kind: n.kind,
      size: n.data.length().to_int64(),
      executable: false,
      mtime_ms: n.mtime_ms,
      dev: n.dev,
      ino: n.ino,
    }
  }
  let lstat_fn = fn(p : String) -> Option[FsStat] {
    match self.nodes.get(norm_mem_path(p)) {
      Some(n) => Some(node_stat(n))
      None => None
    }
  }
  let stat_fn = fn(p : String) -> Option[FsStat] {
    let mut cur = norm_mem_path(p)
    for _ in 0..<8 {
      match self.nodes.get(cur) {
        Some(n) => {
          if n.kind == "link" {
            cur = norm_mem_path(n.link_target)
          } else {
            return Some(node_stat(n))
          }
        }
        None => return None
      }
    }
    None
  }
  let read_dir_fn = fn(p : String) -> Option[Array[String]] {
    let norm = norm_mem_path(p)
    match self.nodes.get(norm) {
      Some(n) => {
        if n.kind != "dir" {
          return None
        }
      }
      None => return None
    }
    let out : Array[String] = []
    let seen : Map[String, Bool] = Map::new()
    for i in 0..<self.paths.length() {
      let cand = self.paths[i]
      if !self.nodes.contains(cand) || cand == norm {
        continue
      }
      if nodepath::dirname("/", cand) == norm {
        let b = nodepath::basename("/", cand)
        if !seen.contains(b) {
          seen.set(b, true)
          out.push(b)
        }
      }
    }
    Some(out)
  }
  FsPort::{
    sep: "/",
    lstat: lstat_fn,
    stat: stat_fn,
    read_dir: read_dir_fn,
    read_file: fn(p : String) -> Option[String] {
      match self.nodes.get(norm_mem_path(p)) {
        Some(n) => if n.kind == "file" { Some(sj_bytes_to_str(n.data)) } else { None }
        None => None
      }
    },
    read_bytes: fn(p : String) -> Option[Bytes] {
      match self.nodes.get(norm_mem_path(p)) {
        Some(n) => if n.kind == "file" { Some(n.data) } else { None }
        None => None
      }
    },
    write_file: fn(p : String, content : String) -> Bool {
      self.put_file(p, content)
      true
    },
    write_bytes: fn(p : String, data : Bytes) -> Bool {
      let norm = norm_mem_path(p)
      self.ensure_parents(norm, 1.to_int64())
      match self.nodes.get(norm) {
        Some(n) => {
          n.kind = "file"
          n.data = data
          n.mtime_ms = self.now_ms
        }
        None => {
          let ino = self.next_ino
          self.next_ino = self.next_ino + 1.to_int64()
          self.nodes.set(
            norm,
            MemNode::{
              kind: "file",
              data: data,
              link_target: "",
              mtime_ms: self.now_ms,
              dev: 1.to_int64(),
              ino: ino,
              truncated_in_place_count: 0,
            },
          )
          self.paths.push(norm)
        }
      }
      true
    },
    append_file: fn(p : String, content : String) -> Bool {
      let norm = norm_mem_path(p)
      match self.nodes.get(norm) {
        Some(n) => {
          let prev = sj_bytes_to_str(n.data)
          n.data = (prev + content).to_bytes()
          n.mtime_ms = self.now_ms
          true
        }
        None => {
          self.put_file(norm, content)
          true
        }
      }
    },
    truncate_in_place: fn(p : String) -> Bool {
      match self.nodes.get(norm_mem_path(p)) {
        Some(n) => {
          n.data = Bytes::new(0)
          n.mtime_ms = self.now_ms
          n.truncated_in_place_count = n.truncated_in_place_count + 1
          true
        }
        None => false
      }
    },
    rename: fn(old_p : String, new_p : String) -> Bool {
      let o = norm_mem_path(old_p)
      let n = norm_mem_path(new_p)
      match self.nodes.get(o) {
        Some(node) => {
          self.nodes.remove(o)
          self.nodes.set(n, node)
          self.paths.push(n)
          true
        }
        None => false
      }
    },
    remove_file: fn(p : String) -> Bool {
      let norm = norm_mem_path(p)
      if self.nodes.contains(norm) {
        self.nodes.remove(norm)
        true
      } else {
        false
      }
    },
    remove_dir_all: fn(p : String) -> Bool {
      let norm = norm_mem_path(p)
      let prefix = norm + "/"
      let to_del : Array[String] = []
      for i in 0..<self.paths.length() {
        let cand = self.paths[i]
        if cand == norm || sj_starts_with(cand, prefix) {
          to_del.push(cand)
        }
      }
      for i in 0..<to_del.length() {
        self.nodes.remove(to_del[i])
      }
      true
    },
    mkdir_p: fn(p : String) -> Bool {
      self.put_dir(p)
      true
    },
    readlink: fn(p : String) -> Option[String] {
      match self.nodes.get(norm_mem_path(p)) {
        Some(n) => if n.kind == "link" { Some(n.link_target) } else { None }
        None => None
      }
    },
    exists: fn(p : String) -> Bool {
      self.nodes.contains(norm_mem_path(p))
    },
    now_ms: fn() -> Int64 {
      self.now_ms
    },
  }
}

// ---------------------------------------------------------------------------
// 1. Bounded Walk Tests
// ---------------------------------------------------------------------------

test "walk_bounded enforces symlink skip, same_device, max_depth, and max_entries" {
  let mfs = MemFs::new(5000.to_int64())
  mfs.put_dir("/root", 1.to_int64())
  mfs.put_file("/root/a.txt", "hello")
  mfs.put_dir("/root/sub", 1.to_int64())
  mfs.put_file("/root/sub/b.txt", "world")
  mfs.put_dir("/root/sub/deep", 1.to_int64())
  mfs.put_file("/root/sub/deep/c.txt", "deep")
  mfs.put_dir("/root/mount", 2.to_int64()) // different device
  mfs.put_file("/root/mount/ext.txt", "external", -1.to_int64(), 2.to_int64())
  mfs.put_link("/root/loop", "/root")

  let fs = mfs.to_port()
  let seen : Array[String] = []
  let opts = WalkOptions::{
    same_device: true,
    max_entries: 100,
    max_depth: 2,
    max_duration_ms: 10000.to_int64(),
    need_stat: true,
    follow_root: false,
    follow_links: false,
  }
  let res = walk_bounded(fs, ["/root"], opts, fn(e : WalkEntry) -> VisitAction {
    seen.push(e.rel)
    VisitAction::Continue
  })
  expect(res.truncated, "expected depth truncation")
  expect(
    match res.reason {
      Some(WalkReason::Depth) => true
      _ => false
    },
    "expected WalkReason::Depth",
  )
  expect(res.crossed == 1, "expected 1 crossed mount")
  let mut saw_ext = false
  let mut saw_c = false
  for i in 0..<seen.length() {
    if seen[i] == "mount/ext.txt" {
      saw_ext = true
    }
    if seen[i] == "sub/deep/c.txt" {
      saw_c = true
    }
  }
  expect(!saw_ext, "must not descend into another filesystem")
  expect(!saw_c, "must not descend past max_depth")

  // max_entries limit
  let opts_cap = WalkOptions::{
    same_device: true,
    max_entries: 3,
    max_depth: 32,
    max_duration_ms: 10000.to_int64(),
    need_stat: false,
    follow_root: false,
    follow_links: false,
  }
  let res_cap = walk_bounded(fs, ["/root"], opts_cap, fn(_e : WalkEntry) -> VisitAction {
    VisitAction::Continue
  })
  expect(res_cap.truncated && res_cap.visited == 3, "expected entry cap at 3")
  expect(
    match res_cap.reason {
      Some(WalkReason::Entries) => true
      _ => false
    },
    "expected WalkReason::Entries",
  )

  // follow_links = true must not infinite-loop on `/root/loop -> /root`
  let opts_links = WalkOptions::{
    same_device: true,
    max_entries: 50,
    max_depth: 32,
    max_duration_ms: 10000.to_int64(),
    need_stat: false,
    follow_root: false,
    follow_links: true,
  }
  let res_links = walk_bounded(fs, ["/root"], opts_links, fn(_e : WalkEntry) -> VisitAction {
    VisitAction::Continue
  })
  expect(!res_links.truncated, "symlink cycle must terminate cleanly without hitting entry cap")
}

// ---------------------------------------------------------------------------
// 2. Upkeep, STORAGE_MANIFEST, rotate_in_place, Worktree Safety Tests
// ---------------------------------------------------------------------------

test "STORAGE_MANIFEST resolves exact and wildcard entries" {
  match storage_entry("stillfail.db") {
    Some(e) => expect(storage_class_name(e.class) == "authoritative", "db authoritative")
    None => panic("missing stillfail.db")
  }
  match storage_entry("config.json.bak-20261126") {
    Some(e) => expect(storage_class_name(e.class) == "bounded-ephemeral", "bak wildcard")
    None => panic("missing config.json.bak-*")
  }
  match storage_entry("sessions") {
    Some(e) => expect(storage_class_name(e.class) == "session-bound", "sessions class")
    None => panic("missing sessions")
  }
  expect(
    match storage_entry("totally-unknown-top-entry") {
      None => true
      Some(_) => false
    },
    "unknown entry returns None",
  )
}

test "rotate_in_place copies tail to .1 and truncates original inode in place" {
  let mfs = MemFs::new(10000.to_int64())
  mfs.put_file("/data/stillfail.log", "0123456789ABCDEF")
  let orig_ino = match mfs.nodes.get("/data/stillfail.log") {
    Some(n) => n.ino
    None => panic("missing log")
  }
  let fs = mfs.to_port()
  match rotate_in_place(fs, "/data/stillfail.log", 8.to_int64(), 6.to_int64()) {
    Ok(rotated) => expect(rotated, "expected rotation")
    Err(e) => panic("rotate failed: " + e)
  }
  match mfs.nodes.get("/data/stillfail.log") {
    Some(n) => {
      expect(n.ino == orig_ino, "must preserve inode (never rename/unlink O_APPEND log)")
      expect(n.data.length() == 0, "original log must be truncated to 0")
      expect(n.truncated_in_place_count == 1, "must call truncate_in_place")
    }
    None => panic("log disappeared")
  }
  match (fs.read_file)("/data/stillfail.log.1") {
    Some(s) => expect(s == "ABCDEF", "tail 6 bytes copied to .1")
    None => panic("missing .1 archive")
  }
}

test "prune_repo_worktrees enforces local sessions and foreign archive lock safety boundaries" {
  let mfs = MemFs::new(20000.to_int64())
  // 1. Unlocked worktree pointing to gone local session -> MUST PRUNE
  mfs.put_file("/data/repos/app/.git/worktrees/wt-stale-local/gitdir", "/data/sessions/chat/gone-1/workspace/.git\n")
  // 2. Unlocked worktree pointing to gone user path outside <data>/sessions -> MUST KEEP
  mfs.put_file("/data/repos/app/.git/worktrees/wt-user-outside/gitdir", "/home/user/projects/gone/.git\n")
  // 3. Locked worktree with manual lock -> MUST KEEP
  mfs.put_file("/data/repos/app/.git/worktrees/wt-manual-lock/gitdir", "/other/sessions/c1/.git\n")
  mfs.put_file("/data/repos/app/.git/worktrees/wt-manual-lock/locked", "user locked this\n")
  // 4. Locked worktree with archive prefix pointing to local session -> MUST KEEP
  mfs.put_file("/data/repos/app/.git/worktrees/wt-local-arch/gitdir", "/data/sessions/chat/arch1/.git\n")
  mfs.put_file(
    "/data/repos/app/.git/worktrees/wt-local-arch/locked",
    ARCHIVE_WORKTREE_LOCK_PREFIX + "/data/sessions/chat/arch1\n",
  )
  // 5. Foreign archived-workspace lock (both room and target outside local sessions, target gone) -> MUST PRUNE
  mfs.put_file("/data/repos/app/.git/worktrees/wt-foreign-arch/gitdir", "/old-mac/sessions/chat/c9/.git\n")
  mfs.put_file(
    "/data/repos/app/.git/worktrees/wt-foreign-arch/locked",
    ARCHIVE_WORKTREE_LOCK_PREFIX + "/old-mac/sessions/chat/c9\n",
  )

  let fs = mfs.to_port()
  let pruned = prune_repo_worktrees(fs, "/data")
  expect(pruned.length() == 2, "expected exactly 2 pruned worktrees")
  expect(!(fs.exists)("/data/repos/app/.git/worktrees/wt-stale-local"), "stale local pruned")
  expect(!(fs.exists)("/data/repos/app/.git/worktrees/wt-foreign-arch"), "foreign archive pruned")
  expect((fs.exists)("/data/repos/app/.git/worktrees/wt-user-outside"), "user outside kept")
  expect((fs.exists)("/data/repos/app/.git/worktrees/wt-manual-lock"), "manual lock kept")
  expect((fs.exists)("/data/repos/app/.git/worktrees/wt-local-arch"), "local archive kept")
}

test "Upkeep run_round caps caches, cleans stale files, and persists upkeep-state.json" {
  let now : Int64 = 100.to_int64() * DAY_MS
  let mfs = MemFs::new(now)
  let fs = mfs.to_port()
  mfs.put_file("/data/config.json.bak-1", "a", now - 5000.to_int64())
  mfs.put_file("/data/config.json.bak-2", "b", now - 4000.to_int64())
  mfs.put_file("/data/config.json.bak-3", "c", now - 3000.to_int64())
  mfs.put_file("/data/config.json.bak-4", "d", now - 2000.to_int64())
  mfs.put_file("/data/config.json.bak-5", "e", now - 1000.to_int64())
  mfs.put_file("/data/node/.part-old", "part", now - (2.to_int64() * DAY_MS))
  mfs.put_file("/data/node/.part-new", "part", now - 1000.to_int64())
  mfs.put_file("/data/transcript-marks/m1.json", "{\"state\":{\"path\":\"/data/missing.jsonl\"}}")

  let up = Upkeep::new("/data", 42, fs)
  let rep = up.run_round(now, empty_upkeep_hooks())
  expect(rep.config_backups_removed == 2, "keep newest 3 config backups")
  expect(rep.node_parts_removed == 1, "remove 1 stale node part")
  expect(rep.orphan_marks_removed == 1, "remove 1 orphan transcript mark")
  expect(rep.state_persisted, "persisted upkeep-state.json")

  let st = read_upkeep_state(fs, "/data")
  expect(st.idle_measured_version == IDLE_MEASURED_VERSION, "state version 2")
  expect(
    match st.last_repo_branches_at {
      Some(t) => t == now
      None => false
    },
    "saved lastRepoBranchesAt",
  )
}

// ---------------------------------------------------------------------------
// 3. Load & Memory Watch Tests
// ---------------------------------------------------------------------------

test "measure computes CPU busy delta, memory, disk, PSI, and summary" {
  let mut call_n = 0
  let net = NetRelay::new()
  net.attach(Some("relay-tyo"))
  net.pinged("relay-tyo", 18)

  let probe = SysLoadProbe::{
    os_name: fn() -> String { "linux" },
    arch_name: fn() -> String { "x64" },
    machine_stats_json: fn() -> String {
      call_n = call_n + 1
      if call_n == 1 {
        "{\"cpus\":[{\"model\":\"EPYC\",\"times\":{\"user\":1000,\"nice\":0,\"sys\":500,\"idle\":8500,\"irq\":0}}],\"totalmem\":17179869184,\"freemem\":8589934592,\"loadavg\":[1.5,1.0,0.5]}"
      } else {
        "{\"cpus\":[{\"model\":\"EPYC\",\"times\":{\"user\":1500,\"nice\":0,\"sys\":1000,\"idle\":9500,\"irq\":0}}],\"totalmem\":17179869184,\"freemem\":8589934592,\"loadavg\":[1.5,1.0,0.5]}"
      }
    },
    disk_of_json: fn(_p : String) -> Option[String] {
      Some("{\"free\":107374182400,\"total\":214748364800}")
    },
    psi_pressure_json: fn() -> Option[String] {
      Some("{\"cpuSome\":100,\"memorySome\":200,\"memoryFull\":50,\"compactStalls\":1,\"allocStalls\":2}")
    },
    wall_ms: fn() -> Int64 { if call_n <= 1 { 10000.to_int64() } else { 20000.to_int64() } },
    gpus: fn() -> Option[Array[GpuLoad]] { None },
    running: fn() -> RunningCounts {
      RunningCounts::{ remote_tasks: 1, jobs: 2, services: 1, turns: 0 }
    },
    relay: fn() -> Option[RelayLoad] { net.seen() },
  }

  let (l1, s1) = measure(probe, "/data", None)
  expect(l1.os == "linux" && l1.arch == "x64", "os/arch")
  expect(
    match l1.cpus {
      Some(1) => true
      _ => false
    },
    "1 cpu",
  )
  expect(
    match l1.psi {
      Some(p) => p.memory_some == 200.to_int64() && p.memory_full == 50.to_int64()
      None => false
    },
    "psi parsed",
  )

  let (l2, _s2) = measure(probe, "/data", s1)
  match l2.cpu_busy {
    Some(cb) => {
      // delta total = 2000, delta idle = 1000 => 0.50 busy
      expect(cb.share > 0.49 && cb.share < 0.51, "50% cpu busy")
    }
    None => panic("expected cpu_busy on second sample")
  }
  let line = load_summary(l2)
  expect(sj_index_of(line, "x64 linux", 0) >= 0, "summary has arch os")
  expect(sj_index_of(line, "CPU 50% busy", 0) >= 0, "summary has cpu busy")
  expect(sj_index_of(line, "relay ping 18 ms", 0) >= 0, "summary has relay ping")
}

test "memory units_of excludes station self and agents, groups jobs and orphans, and MemoryWatch stops largest on critical" {
  let gib = (1024 * 1024 * 1024).to_int64()
  let table : Array[ProcessInfo] = [
    ProcessInfo::{ pid: 10, ppid: 1, pgid: 10, command: "stillfail-station", bytes: 4.to_int64() * gib },
    ProcessInfo::{ pid: 20, ppid: 10, pgid: 20, command: "claude", bytes: 2.to_int64() * gib },
    ProcessInfo::{ pid: 30, ppid: 20, pgid: 30, command: "/usr/bin/cargo", bytes: 3.to_int64() * gib },
    ProcessInfo::{ pid: 31, ppid: 30, pgid: 30, command: "rustc", bytes: 1.to_int64() * gib },
    ProcessInfo::{ pid: 40, ppid: 1, pgid: 40, command: "/bin/sh", bytes: 1.to_int64() * gib },
  ]
  let jobs = [WatchedJob::{ id: "job_1", session: "s1", pgid: 40, label: "Job \"build\" (job_1)" }]
  let agents = [WatchedAgent::{ pid: 20, session: Some("s1") }]

  let units = units_of(table, jobs, agents, 10)
  expect(units.length() == 2, "self (10) and agent (20) must be excluded")
  expect(units[0].key == "pid:30" && units[0].bytes == 4.to_int64() * gib, "cargo + rustc grouped")
  expect(units[1].key == "job:job_1" && units[1].bytes == 1.to_int64() * gib, "job_1 grouped")

  let watch = MemoryWatch::new(10, 16.to_int64() * gib)
  let actions = watch.look(10000.to_int64(), Some(Pressure::Critical), table, jobs, agents)
  let mut saw_term = false
  for i in 0..<actions.length() {
    match actions[i] {
      MemoryAction::Signal(pid, sig) => {
        if (pid == 30 || pid == 31) && sig == station_sys::SIG_TERM {
          saw_term = true
        }
      }
      _ => ()
    }
  }
  expect(saw_term, "critical pressure must SIGTERM largest unit")

  // Linux /dev/kmsg OOM kill parsing
  match kmsg_kill("3,104,987654321,-;Out of memory: Killed process 31337 (rustc) total-vm:100kB") {
    Some(k) => expect(k.pid == 31337 && k.name == "rustc" && k.usec == 987654321.to_int64(), "kmsg parsed")
    None => panic("expected kmsg kill parse")
  }
}

// ---------------------------------------------------------------------------
// 4. JobManager + notify/screen + RemoteManager State Machine Tests
// ---------------------------------------------------------------------------

test "JobManager lifecycle: start, log capture, tail, notify, screen, service restart, and stop" {
  let mfs = MemFs::new(1000.to_int64())
  let fs = mfs.to_port()
  let notices : Array[(String, String)] = []
  let killed_sigs : Array[(Int, Int)] = []
  let mut next_pid = 500
  let mut last_event_id : Int64 = 0.to_int64()

  let backend = ProcBackend::{
    spawn_proc: fn(ev_id : Int64, _opts : station_sys::SpawnOptions) -> Result[station_sys::ChildProcess, String] {
      last_event_id = ev_id
      let pid = next_pid
      next_pid = next_pid + 1
      Ok(station_sys::ChildProcess::{ handle: pid.to_int64(), pid: pid })
    },
    kill_handle: fn(cp : station_sys::ChildProcess, sig : Int, _group : Bool) -> Int {
      killed_sigs.push((cp.pid, sig))
      0
    },
    close_handle: fn(_cp : station_sys::ChildProcess) -> Bool { true },
    kill_pid: fn(pid : Int, sig : Int, _group : Bool) -> Int {
      killed_sigs.push((pid, sig))
      0
    },
  }

  let jm = JobManager::new(
    "/data",
    fs,
    backend,
    "http://127.0.0.1:4750/jobs/notify",
    fn(sess : String, text : String) -> Unit { notices.push((sess, text)) },
    fn(_j : JobRecord) -> Unit {},
  )

  // Start a web service job (port 8080)
  let job = match jm.start(
    JobStartRequest::{
      session: "chat:1",
      name: "web",
      command: "echo hi",
      cwd: "/work",
      port: Some(8080),
      watch: false,
      id: None,
      queued: false,
      screen: false,
      small: false,
    },
    1000.to_int64(),
  ) {
    Ok(j) => j
    Err(e) => panic("start failed: " + e)
  }
  let ev1 = last_event_id

  // Deliver stdout + stderr events
  expect(
    jm.handle_sys_event(ev1, station_sys::SysEvent::ProcStdout("line1\nline2\n".to_bytes()), 1100.to_int64()),
    "stdout handled",
  )
  expect(
    jm.handle_sys_event(ev1, station_sys::SysEvent::ProcStderr("line3\n".to_bytes()), 1200.to_int64()),
    "stderr handled",
  )
  match jm.log(job.id, 2) {
    Ok(t) => expect(t == "line2\nline3", "tail 2 lines: got " + t)
    Err(e) => panic("log failed: " + e)
  }

  // `stillfail-job notify` protocol
  let auth = "Bearer " + job.token
  let n_ok = jm.handle_notify(auth, "ready on 8080".to_bytes(), 1300.to_int64())
  expect(n_ok.status == 200 && notices.length() == 1, "notify delivered")
  let n_bad = jm.handle_notify("Bearer wrong", "x".to_bytes(), 1300.to_int64())
  expect(n_bad.status == 400, "wrong token rejected")

  // `stillfail-job screen` protocol
  let s1 = jm.handle_screen(auth, "take 500", 1400.to_int64(), false)
  expect(s1.status == 200, "screen take 200")
  match base_codec::json_get(s1.body, "screen") {
    Some(base_codec::Json::Str(v)) => expect(v == "yours", "screen yours")
    _ => panic("expected screen yours")
  }
  let s2 = jm.handle_screen(auth, "give 500", 1500.to_int64(), false)
  expect(s2.status == 200, "screen give 200")

  // Unexpected exit of web service schedules restart backoff (`admit::restart_pause`)
  let _ = jm.handle_sys_event(
    ev1,
    station_sys::SysEvent::ProcExit(station_sys::ExitStatus::{ code: 1, signal: 0, signal_name: "" }),
    2000.to_int64(),
  )
  expect(job.restarts == 1 && job_state_to_str(job.state) == "queued", "service queued for restart")
  let restarted = jm.tick_restarts(3500.to_int64())
  expect(restarted.length() == 1 && job_state_to_str(job.state) == "running", "service restarted after backoff")

  // Stop cancels restarts and sends SIGTERM
  match jm.stop(job.id, 4000.to_int64()) {
    Ok(stopped) => {
      expect(job_state_to_str(stopped.state) == "stopped", "stopped")
      expect(killed_sigs.length() == 1, "SIGTERM sent")
    }
    Err(e) => panic("stop failed: " + e)
  }
}

test "RemoteManager full state machine: prepare, sync, queue, run, pending release, release, clean, sweep" {
  let mfs = MemFs::new(1000.to_int64())
  let fs = mfs.to_port()
  let mut last_ev : Int64 = 0.to_int64()
  let mut pid_seq = 700
  let backend = ProcBackend::{
    spawn_proc: fn(ev_id : Int64, _opts : station_sys::SpawnOptions) -> Result[station_sys::ChildProcess, String] {
      last_ev = ev_id
      let p = pid_seq
      pid_seq = pid_seq + 1
      Ok(station_sys::ChildProcess::{ handle: p.to_int64(), pid: p })
    },
    kill_handle: fn(_cp : station_sys::ChildProcess, _sig : Int, _group : Bool) -> Int { 0 },
    close_handle: fn(_cp : station_sys::ChildProcess) -> Bool { true },
    kill_pid: fn(_pid : Int, _sig : Int, _group : Bool) -> Int { 0 },
  }
  let changed : Array[String] = []
  let jm = JobManager::new(
    "/data",
    fs,
    backend,
    "",
    fn(_s : String, _t : String) -> Unit {},
    fn(_j : JobRecord) -> Unit {},
  )
  let rm = RemoteManager::new(
    "/data",
    fs,
    jm,
    RemoteCallbacks::{ on_task_changed: fn(t : RemoteTaskRecord) -> Unit { changed.push(remote_task_state_str(t.state)) } },
  )

  let t = match rm.prepare(
    RemotePrepareRequest::{
      key: "build-1",
      workspace: "ws1",
      source_station: "st1",
      source_session: "chat:9",
      name: "cargo test",
      command: "echo ok",
      mirror_name: Some("repo-m1"),
      back_paths: ["out.bin"],
      screen: false,
      small: false,
    },
    1000.to_int64(),
  ) {
    Ok(rec) => rec
    Err(e) => panic("prepare failed: " + e)
  }
  expect(remote_task_state_str(t.state) == "prepared", "prepared")

  // Start with dirsync needed -> Syncing
  let _ = match rm.start("build-1", 1100.to_int64(), true, None, false) {
    Ok(rec) => expect(remote_task_state_str(rec.state) == "syncing", "syncing")
    Err(e) => panic("start sync failed: " + e)
  }
  // Cannot clean mirror while syncing
  expect(
    match rm.clean_mirror(t.room_id, "repo-m1") {
      Err(_) => true
      Ok(_) => false
    },
    "cannot clean syncing mirror",
  )

  // Sync complete under High pressure -> stays Queued
  let _ = match rm.sync_complete("build-1", "abc123", 1200.to_int64(), Some(Pressure::High), false) {
    Ok(rec) => expect(remote_task_state_str(rec.state) == "queued", "queued under high pressure")
    Err(e) => panic("sync_complete failed: " + e)
  }

  // Pressure clears -> drain_queue starts task
  let started = rm.drain_queue(1300.to_int64(), Some(Pressure::Normal), false)
  expect(started.length() == 1 && remote_task_state_str(t.state) == "running", "running after drain")

  // Underlying job exits, results_saved = false -> mirror enters PendingRelease
  let _ = jm.handle_sys_event(
    last_ev,
    station_sys::SysEvent::ProcExit(station_sys::ExitStatus::{ code: 0, signal: 0, signal_name: "" }),
    1400.to_int64(),
  )
  let jid = match t.job_id {
    Some(id) => id
    None => panic("missing job_id")
  }
  let job = match jm.get(jid) {
    Some(j) => j
    None => panic("missing job")
  }
  expect(rm.on_job_event(job, 1400.to_int64(), false), "on_job_event handled")
  expect(t.pending_results, "pending_results set")
  expect(
    match rm.clean_mirror(t.room_id, "repo-m1") {
      Err(_) => true
      Ok(_) => false
    },
    "cannot clean pending_release mirror",
  )

  // Release mirror -> now cleanable
  let _ = match rm.release("build-1") {
    Ok(rec) => expect(remote_task_state_str(rec.state) == "released" && !rec.pending_results, "released")
    Err(e) => panic("release failed: " + e)
  }
  expect(
    match rm.clean_mirror(t.room_id, "repo-m1") {
      Ok(true) => true
      _ => false
    },
    "clean_mirror succeeds when idle",
  )

  // Sweep after REMOTE_IDLE_MS + TASKS_KEPT_MS removes expired room and task
  let sw = rm.sweep(1400.to_int64() + REMOTE_IDLE_MS + 1000.to_int64(), false)
  expect(sw.rooms_removed.length() == 1 && sw.tasks_expired.length() == 1, "sweep removed expired room and task")

  // safe_transfer_path rejects traversal and symlinks
  mfs.put_dir("/transfer")
  mfs.put_link("/transfer/evil", "/etc")
  expect(
    match safe_transfer_path(fs, "/transfer", "../etc/passwd") {
      Err(_) => true
      Ok(_) => false
    },
    "rejects .. traversal",
  )
  expect(
    match safe_transfer_path(fs, "/transfer", "evil/passwd") {
      Err(_) => true
      Ok(_) => false
    },
    "rejects symlink component",
  )
  expect(
    match safe_transfer_path(fs, "/transfer", "sub/ok.txt", true) {
      Ok(p) => p == "/transfer/sub/ok.txt"
      Err(_) => false
    },
    "accepts clean relative path",
  )
}

test "preview_target and WebSocket frame codec roundtrip" {
  match preview_target("/preview/8080/index.html") {
    Some((port, target)) => expect(port == 8080 && target == "/index.html", "preview target")
    None => panic("expected valid preview target")
  }
  expect(
    match preview_target("/preview/99999/bad") {
      None => true
      Some(_) => false
    },
    "rejects port > 65535",
  )
  let raw = preview_frame_encode(PREVIEW_FRAME_TEXT, "hello".to_bytes())
  match preview_frame_decode(raw) {
    Some((kind, payload)) => {
      expect(kind == PREVIEW_FRAME_TEXT && sj_bytes_to_str(payload) == "hello", "frame roundtrip")
    }
    None => panic("expected decoded frame")
  }
}

test "dirsync_blob_id matches Git SHA-1 and remote_budget computes 15 percent share" {
  // `printf 'hello' | git hash-object --stdin` == b6fc4c620b67d95f953a5c1c1230aaab5db5a1b0
  let bid = dirsync_blob_id("hello".to_bytes())
  expect(bid == "b6fc4c620b67d95f953a5c1c1230aaab5db5a1b0", "git blob sha1 mismatch: " + bid)
  expect(remote_budget(None) == REMOTE_BUDGET_UNKNOWN, "unknown disk budget")
  expect(remote_budget(Some(1000.to_int64())) == 150.to_int64(), "15% disk budget")
}

test "walk_bounded enforces max_duration_ms, Skip, Stop, tree_bytes, and latest_in" {
  let mfs = MemFs::new(5000.to_int64())
  mfs.put_file("/t/a.txt", "12345", 1000.to_int64())
  mfs.put_file("/t/skip_me/secret.txt", "999999", 9000.to_int64())
  mfs.put_file("/t/keep/b.txt", "67890", 3000.to_int64())
  let fs = mfs.to_port()

  let saw : Array[String] = []
  let res_skip = walk_bounded(fs, ["/t"], default_walk_options(), fn(e : WalkEntry) -> VisitAction {
    saw.push(e.rel)
    if e.name == "skip_me" {
      VisitAction::Skip
    } else {
      VisitAction::Continue
    }
  })
  expect(!res_skip.truncated, "skip walk completes")
  let mut saw_secret = false
  for i in 0..<saw.length() {
    if saw[i] == "skip_me/secret.txt" {
      saw_secret = true
    }
  }
  expect(!saw_secret, "VisitAction::Skip must not descend")

  let res_stop = walk_bounded(fs, ["/t"], default_walk_options(), fn(_e : WalkEntry) -> VisitAction {
    VisitAction::Stop
  })
  expect(
    res_stop.truncated
    && res_stop.visited == 1
    && match res_stop.reason {
      Some(WalkReason::Stopped) => true
      _ => false
    },
    "VisitAction::Stop halts immediately",
  )

  // max_duration_ms = -1 triggers immediate duration truncation
  let opts_dur = WalkOptions::{
    same_device: true,
    max_entries: 100,
    max_depth: 32,
    max_duration_ms: -1.to_int64(),
    need_stat: false,
    follow_root: false,
    follow_links: false,
  }
  let res_dur = walk_bounded(fs, ["/t"], opts_dur, fn(_e : WalkEntry) -> VisitAction {
    VisitAction::Continue
  })
  expect(
    res_dur.truncated
    && match res_dur.reason {
      Some(WalkReason::Duration) => true
      _ => false
    },
    "duration limit truncates",
  )

  let sz = tree_bytes(fs, "/t")
  expect(!sz.partial && sz.bytes == 16.to_int64(), "tree_bytes sums all files")
  match latest_in(fs, "/t") {
    Some(ts) => expect(ts == 9000.to_int64(), "latest_in finds newest mtime")
    None => panic("expected latest_in timestamp")
  }
}

test "Upkeep cap_by_age, gone_board_files, upkeep-state version migration, and JobManager watch/upkeep" {
  let now : Int64 = 50.to_int64() * DAY_MS
  let mfs = MemFs::new(now)
  let fs = mfs.to_port()

  // cap_by_age evicts oldest files first
  mfs.put_file("/data/thumbs/old.png", "1234567890", now - 5000.to_int64())
  mfs.put_file("/data/thumbs/mid.png", "1234567890", now - 3000.to_int64())
  mfs.put_file("/data/thumbs/new.png", "1234567890", now - 1000.to_int64())
  let freed = cap_by_age(fs, "/data/thumbs", 15.to_int64())
  expect(freed == 20.to_int64(), "evicted 2 oldest thumbs")
  expect(!(fs.exists)("/data/thumbs/old.png") && !(fs.exists)("/data/thumbs/mid.png"), "oldest evicted")
  expect((fs.exists)("/data/thumbs/new.png"), "newest kept")

  // gone_board_files removes expired .gone files and empty draft folder
  mfs.put_file("/data/board-files/alice/.gone/d1/f.txt", "x", now - (2.to_int64() * DAY_MS))
  let bg = gone_board_files(fs, "/data/board-files", BOARD_FILES_GONE_MS, now)
  expect(bg.length() == 1 && bg[0] == "alice/d1/f.txt", "gone board file removed")

  // upkeep-state v1 drops idleMeasured while preserving cadence timestamps
  let v1 = parse_upkeep_state("{\"idleMeasuredVersion\":1,\"idleMeasured\":{\"a\":1},\"lastRepoBranchesAt\":12345}")
  expect(v1.idle_measured_keys.length() == 0, "v1 idleMeasured dropped")
  expect(
    match v1.last_repo_branches_at {
      Some(t) => t == 12345.to_int64()
      None => false
    },
    "v1 cadence timestamp preserved",
  )

  // JobManager rejects watch + port, supports watch mode, and collects expired/orphan logs
  let mut pid_seq = 900
  let backend = ProcBackend::{
    spawn_proc: fn(_ev : Int64, _opts : station_sys::SpawnOptions) -> Result[station_sys::ChildProcess, String] {
      let p = pid_seq
      pid_seq = pid_seq + 1
      Ok(station_sys::ChildProcess::{ handle: p.to_int64(), pid: p })
    },
    kill_handle: fn(_cp : station_sys::ChildProcess, _sig : Int, _group : Bool) -> Int { 0 },
    close_handle: fn(_cp : station_sys::ChildProcess) -> Bool { true },
    kill_pid: fn(_pid : Int, _sig : Int, _group : Bool) -> Int { 0 },
  }
  let jm = JobManager::new(
    "/data",
    fs,
    backend,
    "",
    fn(_s : String, _t : String) -> Unit {},
    fn(_j : JobRecord) -> Unit {},
  )
  expect(
    match jm.start(
      JobStartRequest::{
        session: "s1",
        name: "bad",
        command: "true",
        cwd: "/",
        port: Some(3000),
        watch: true,
        id: None,
        queued: false,
        screen: false,
        small: false,
      },
      now,
    ) {
      Err(_) => true
      Ok(_) => false
    },
    "watch + port must be rejected",
  )
  mfs.put_file("/data/jobs/logs/orphan_99.log", "old", now - (2.to_int64() * HOUR_MS))
  let jup = jm.upkeep(now)
  expect(jup.collected.length() == 1 && jup.collected[0] == "orphan_99", "orphan job log collected")
}

test "MemoryWatch enriches process_usage footprints, detects orphans, and resumes paused pids on close" {
  let gib = (1024 * 1024 * 1024).to_int64()
  let raw_table = [
    ProcessInfo::{ pid: 100, ppid: 1, pgid: 100, command: "/usr/bin/node", bytes: 0.to_int64() },
  ]
  let enriched = enrich_table_with_usage(
    raw_table,
    "[{\"cpuNs\":1000,\"footprint\":1073741824,\"wakeups\":0,\"energyNj\":0,\"diskRead\":0,\"diskWritten\":0}]",
  )
  expect(enriched[0].bytes == gib, "footprint enriched from process_usage_json")

  let rem : Map[Int, RememberedProc] = Map::new()
  rem.set(100, RememberedProc::{ session: Some("s1"), command: "/usr/bin/node", label: "command node (pid 100)" })
  let units = units_of(enriched, [], [], 1, rem)
  expect(units.length() == 1 && units[0].orphan && units[0].key == "orphan:100", "orphan detected")

  let mw = MemoryWatch::new(1, 8.to_int64() * gib)
  mw.paused.set("pid:200", [200, 201])
  mw.paused_keys.push("pid:200")
  let close_acts = mw.close()
  let mut cont_count = 0
  for i in 0..<close_acts.length() {
    match close_acts[i] {
      MemoryAction::Signal(_, sig) => {
        if sig == SIG_CONT_PORTABLE {
          cont_count = cont_count + 1
        }
      }
      _ => ()
    }
  }
  expect(cont_count == 2, "close must SIGCONT all paused pids")
}
