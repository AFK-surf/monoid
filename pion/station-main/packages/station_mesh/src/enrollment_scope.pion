// Relay enrollment door (`enrollment-door.ts`), leaf attachments (`leaf.ts`),
// scope sync (`scope-sync.ts`), peer TCP forwards (`peer-forward.ts`),
// and front/direct link client (`front.ts` / `links`).

import "base_codec"
import "crypto"
import "mesh_wire"
import "mesh_door"

// ── Workspace scope derivation (`enrollment-door.ts`) ──

pub fn workspace_scope(origin : String, workspace : String) -> String {
  let b = origin.to_bytes()
  let mut end = b.length()
  while end > 0 && (b[end - 1].to_int() & 0xFF) == 47 {
    end = end - 1
  }
  let trimmed = str_slice_bytes(origin, 0, end)
  let cloud = if trimmed == "https://app.monoid.build" {
    "https://app.still.fail"
  } else {
    trimmed
  }
  let prefix = "mesh-workspace/v1".to_bytes()
  let cb = cloud.to_bytes()
  let wb = workspace.to_bytes()
  let buf = Bytes::new(prefix.length() + 1 + cb.length() + 1 + wb.length())
  let mut pos = 0
  for i in 0..<prefix.length() {
    buf[pos] = prefix[i]
    pos = pos + 1
  }
  buf[pos] = 0 as Byte
  pos = pos + 1
  for i in 0..<cb.length() {
    buf[pos] = cb[i]
    pos = pos + 1
  }
  buf[pos] = 0 as Byte
  pos = pos + 1
  for i in 0..<wb.length() {
    buf[pos] = wb[i]
    pos = pos + 1
  }
  crypto::sha256_hex(buf)
}

pub let ENROLLMENT_MAX_ACTIVE : Int = 32

pub struct EnrollmentError {
  pub message : String
  pub code : String
}

pub struct EnrollmentDoorState {
  pub max_active : Int
  mut active : Int
}

pub fn EnrollmentDoorState::new(max_active : Int = ENROLLMENT_MAX_ACTIVE) -> EnrollmentDoorState {
  EnrollmentDoorState::{ max_active: max_active, active: 0 }
}

pub fn EnrollmentDoorState::try_enter(self : EnrollmentDoorState) -> Bool {
  if self.active >= self.max_active {
    return false
  }
  self.active = self.active + 1
  true
}

pub fn EnrollmentDoorState::leave(self : EnrollmentDoorState) -> Unit {
  if self.active > 0 {
    self.active = self.active - 1
  }
}

pub fn validate_enrollment_request(
  request : base_codec::Json,
  allowed_scope : (String) -> Bool,
) -> Result[(String, String, Option[String]), EnrollmentError] {
  let op = match base_codec::json_get(request, "op") {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
  let scope_id = match base_codec::json_get(request, "scope") {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
  let token : Option[String] = match base_codec::json_get(request, "token") {
    Some(base_codec::Json::Str(t)) => Some(t)
    _ => None
  }
  if (op != "enroll" && op != "resume" && op != "watch") || scope_id.length() == 0 ||
  (op == "enroll" && (token is None)) || !allowed_scope(scope_id) {
    return Err(
      EnrollmentError::{
        message: "relay enrollment is not available for this scope",
        code: "relay_scope_unavailable",
      },
    )
  }
  Ok((op, scope_id, token))
}

// ── Leaf attachments & ScopeSync directory (`leaf.ts`, `scope-sync.ts`) ──

pub struct LeafAuth {
  pub workspace : String
  pub expires_unix : Int64
}

pub struct LeafAttachmentManager {
  mut members : Map[Int64, LeafAuth]
}

pub fn LeafAttachmentManager::new() -> LeafAttachmentManager {
  LeafAttachmentManager::{ members: Map::new() }
}

/// Record member authentication for `conn_id`. Returns `true` if workspace or expiry changed.
pub fn LeafAttachmentManager::authenticated(
  self : LeafAttachmentManager,
  conn_id : Int64,
  workspace : String,
  expires_unix : Int64,
) -> Bool {
  match self.members.get(conn_id) {
    Some(cur) => {
      if cur.workspace == workspace && cur.expires_unix == expires_unix {
        return false
      }
    }
    None => ()
  }
  self.members.set(conn_id, LeafAuth::{ workspace: workspace, expires_unix: expires_unix })
  true
}

pub fn LeafAttachmentManager::forget(self : LeafAttachmentManager, conn_id : Int64) -> Unit {
  self.members.remove(conn_id)
}

pub fn validate_leaf_attach(
  mgr : LeafAttachmentManager,
  cloud : CloudRoster,
  conn_id : Int64,
  workspace : String,
  target : String,
  descriptor_transit : Bool,
) -> Result[LeafAuth, String] {
  if descriptor_transit {
    return Err("a device cannot provide transit")
  }
  let auth = match mgr.members.get(conn_id) {
    Some(a) => a
    None => return Err("leaf member connection ended")
  }
  if auth.workspace != workspace {
    return Err("leaf member connection ended")
  }
  let m = match cloud.membership(workspace) {
    Some(mem) => mem
    None => return Err("leaf workspace removed")
  }
  if target != cloud.station_id && !CloudRoster::has_peer(m, target) {
    return Err("leaf target is not a workspace station")
  }
  Ok(auth)
}

pub struct ScopePolicy {
  pub scope_id : String
  pub relay_urls : Array[String]
  pub global_relays : Array[String]
  pub nodes : Array[String]
}

pub struct ScopeDirectory {
  mut scopes : Map[String, ScopePolicy]
}

pub fn ScopeDirectory::new() -> ScopeDirectory {
  ScopeDirectory::{ scopes: Map::new() }
}

pub fn ScopeDirectory::set_policy(self : ScopeDirectory, policy : ScopePolicy) -> Unit {
  self.scopes.set(policy.scope_id, policy)
}

pub fn ScopeDirectory::scope_for(self : ScopeDirectory, origin : String, workspace : String) -> Option[String] {
  let sc = workspace_scope(origin, workspace)
  if self.scopes.contains(sc) { Some(sc) } else { None }
}

// ── Peer TCP forwards table (`peer-forward.ts`) ──

pub let FORWARD_IDLE_MS : Int64 = 1800000.to_int64()
pub let FORWARD_DOWN_MS : Int64 = 10000.to_int64()

pub struct ForwardEntry {
  pub session : String
  pub station_id : String
  pub station_name : String
  pub remote_port : Int
  pub local_port : Int
  pub job_id : Option[String]
  pub device_name : Option[String]
  pub mut connections : Int
  pub mut served : Int
  pub mut quiet_since_ms : Int64
  pub mut down_until_ms : Int64
  pub mut last_error : Option[String]
}

pub struct ForwardsTable {
  pub idle_ms : Int64
  pub down_ms : Int64
  mut by_local : Map[Int, ForwardEntry]
}

pub fn ForwardsTable::new(
  idle_ms : Int64 = FORWARD_IDLE_MS,
  down_ms : Int64 = FORWARD_DOWN_MS,
) -> ForwardsTable {
  ForwardsTable::{ idle_ms: idle_ms, down_ms: down_ms, by_local: Map::new() }
}

pub fn ForwardsTable::is_forwarded_port(self : ForwardsTable, port : Int) -> Bool {
  self.by_local.contains(port)
}

pub fn ForwardsTable::register(self : ForwardsTable, entry : ForwardEntry) -> Unit {
  self.by_local.set(entry.local_port, entry)
}

pub fn ForwardsTable::remove_port(self : ForwardsTable, local_port : Int) -> Bool {
  if self.by_local.contains(local_port) {
    self.by_local.remove(local_port)
    true
  } else {
    false
  }
}

pub fn ForwardsTable::is_station_down(self : ForwardsTable, local_port : Int, now_ms : Int64) -> Bool {
  match self.by_local.get(local_port) {
    Some(f) => now_ms < f.down_until_ms
    None => false
  }
}

pub fn ForwardsTable::mark_down(
  self : ForwardsTable,
  local_port : Int,
  now_ms : Int64,
  why : String,
) -> Unit {
  match self.by_local.get(local_port) {
    Some(f) => {
      f.down_until_ms = now_ms + self.down_ms
      f.last_error = Some(why)
    }
    None => ()
  }
}

pub fn ForwardsTable::evict_idle(self : ForwardsTable, now_ms : Int64) -> Array[Int] {
  let evicted : Array[Int] = []
  let keys = self.by_local.keys()
  for i in 0..<keys.length() {
    let port = keys[i]
    match self.by_local.get(port) {
      Some(f) => {
        if f.connections == 0 && now_ms - f.quiet_since_ms >= self.idle_ms {
          evicted.push(port)
        }
      }
      None => ()
    }
  }
  for i in 0..<evicted.length() {
    self.by_local.remove(evicted[i])
  }
  evicted
}

pub fn ForwardsTable::close_session(self : ForwardsTable, session : String) -> Array[Int] {
  let closed : Array[Int] = []
  let keys = self.by_local.keys()
  for i in 0..<keys.length() {
    let port = keys[i]
    match self.by_local.get(port) {
      Some(f) => {
        if f.session == session {
          closed.push(port)
        }
      }
      None => ()
    }
  }
  for i in 0..<closed.length() {
    self.by_local.remove(closed[i])
  }
  closed
}

pub fn forward_view_json(f : ForwardEntry) -> base_codec::Json {
  let local_addr = "127.0.0.1:" + f.local_port.to_string()
  let fields : Array[(String, base_codec::Json)] = [
    ("local", base_codec::json_str(local_addr)),
    ("url", base_codec::json_str("http://" + local_addr + "/")),
    ("station", base_codec::json_str(f.station_name)),
    ("port", base_codec::json_int(f.remote_port)),
    ("connections", base_codec::json_int(f.connections)),
    ("served", base_codec::json_int(f.served)),
  ]
  match f.device_name {
    Some(d) => fields.push(("device", base_codec::json_str(d)))
    None => ()
  }
  match f.job_id {
    Some(j) => fields.push(("job", base_codec::json_str(j)))
    None => ()
  }
  match f.last_error {
    Some(e) => fields.push(("last_error", base_codec::json_str(e)))
    None => ()
  }
  base_codec::json_obj(fields)
}

// ── Front client & Direct iroh transport link (`front_client`, `links`) ──

pub enum TransportMode {
  UnixFront(String)
  DirectIroh
}

pub enum LinkHealth {
  Ok
  Reconnecting
}

pub struct FrontClient {
  pub mode : TransportMode
  pub control : mesh_door::FrontControlClient
  mut incoming : Map[Int64, mesh_door::IncomingOrder]
  mut forgotten : Map[Int64, Bool]
  mut linked : Bool
}

pub fn FrontClient::new(mode : TransportMode) -> FrontClient {
  FrontClient::{
    mode: mode,
    control: mesh_door::FrontControlClient::new(),
    incoming: Map::new(),
    forgotten: Map::new(),
    linked: true,
  }
}

pub fn FrontClient::health(self : FrontClient) -> LinkHealth {
  if self.linked && !self.control.is_gone() {
    LinkHealth::Ok
  } else {
    LinkHealth::Reconnecting
  }
}

pub fn FrontClient::incoming_of(self : FrontClient, conn_id : Int64) -> mesh_door::IncomingOrder {
  match self.incoming.get(conn_id) {
    Some(ord) => ord
    None => {
      let fresh = mesh_door::IncomingOrder::new()
      self.incoming.set(conn_id, fresh)
      fresh
    }
  }
}

/// Process a decoded stream handoff header (`mesh_wire::StreamHandHeader`) from the front socket.
pub fn FrontClient::on_stream_hand(
  self : FrontClient,
  header : mesh_wire::StreamHandHeader,
  carry : Bytes,
) -> Bool {
  if self.forgotten.contains(header.conn_id) {
    return false
  }
  let ord = self.incoming_of(header.conn_id)
  match header.kind {
    mesh_wire::StreamHandKind::IncomingUnordered => {
      ord.give(mesh_door::IncomingStreamItem::{ stream_id: header.stream_id, carry: carry }, None)
    }
    mesh_wire::StreamHandKind::IncomingOrdered(idx) => {
      ord.give(
        mesh_door::IncomingStreamItem::{ stream_id: header.stream_id, carry: carry },
        Some(idx),
      )
    }
    mesh_wire::StreamHandKind::Skipped(idx) => {
      ord.skip(idx)
      true
    }
    mesh_wire::StreamHandKind::Outgoing => true
  }
}

pub fn FrontClient::forget_conn(self : FrontClient, conn_id : Int64) -> Unit {
  self.forgotten.set(conn_id, true)
  match self.incoming.get(conn_id) {
    Some(ord) => {
      ord.end()
      self.incoming.remove(conn_id)
    }
    None => ()
  }
}

pub fn FrontClient::disconnect(self : FrontClient, reason : String) -> Array[Int64] {
  self.linked = false
  let keys = self.incoming.keys()
  for i in 0..<keys.length() {
    match self.incoming.get(keys[i]) {
      Some(ord) => ord.end()
      None => ()
    }
  }
  self.incoming = Map::new()
  self.control.close(reason)
}
