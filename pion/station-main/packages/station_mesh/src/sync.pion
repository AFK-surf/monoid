// Workspace lock sync (`lock-sync.ts`), person lock & body sync (`person-sync.ts`),
// and station name/mark sync (`station-marks.ts`).

import "base_codec"
import "js_json"
import "jscase"
import "mesh_wire"

pub let SYNC_RETRY_MS : Int64 = 5000.to_int64()
pub let SYNC_RETRY_MOST_MS : Int64 = 600000.to_int64()
pub let BODIES_OFFERED_MAX : Int = 4096

pub fn next_sync_retry_ms(prev_ms : Option[Int64]) -> Int64 {
  match prev_ms {
    None => SYNC_RETRY_MS
    Some(w) => {
      let doubled = w * 2.to_int64()
      if doubled > SYNC_RETRY_MOST_MS { SYNC_RETRY_MOST_MS } else { doubled }
    }
  }
}

// ── Lock sync (`lock.head`, `lock.kept`, `lock.get`, `lock.put`, `lock.offer`) ──

pub struct LockEntryItem {
  pub hash : String
  pub seq : Int
  pub raw : base_codec::Json
}

pub struct LockWriteResult {
  pub taken : Int
  pub seq : Int
  pub hash : Option[String]
}

pub struct LockDiff {
  pub offer_to_peer : Array[LockEntryItem]
  pub want_from_peer : Array[String]
}

pub fn compute_lock_diff(
  mine : Array[LockEntryItem],
  theirs_hashes : Array[String],
) -> LockDiff {
  let their_set : Map[String, Bool] = Map::new()
  for i in 0..<theirs_hashes.length() {
    their_set.set(theirs_hashes[i], true)
  }
  let my_set : Map[String, Bool] = Map::new()
  let offer : Array[LockEntryItem] = []
  for i in 0..<mine.length() {
    my_set.set(mine[i].hash, true)
    if !their_set.contains(mine[i].hash) {
      offer.push(mine[i])
    }
  }
  let want : Array[String] = []
  for i in 0..<theirs_hashes.length() {
    if !my_set.contains(theirs_hashes[i]) {
      want.push(theirs_hashes[i])
    }
  }
  LockDiff::{ offer_to_peer: offer, want_from_peer: want }
}

/// Answer all 5 workspace lock sync methods (`lock.head`, `lock.kept`, `lock.get`, `lock.put`, `lock.offer`).
/// Write methods (`lock.put`, `lock.offer`) MUST go through caller-provided verification & persistence callbacks.
pub fn answer_lock(
  seq : Int,
  head : Option[String],
  genesis : Option[String],
  kept : Array[LockEntryItem],
  request : base_codec::Json,
  on_put : (Array[base_codec::Json]) -> Result[LockWriteResult, String],
  on_offer : (Array[base_codec::Json]) -> Result[LockWriteResult, String],
) -> Result[base_codec::Json, String] {
  let method = match base_codec::json_get(request, "method") {
    Some(base_codec::Json::Str(m)) => m
    _ => ""
  }
  let head_json = match head {
    Some(h) => base_codec::json_str(h)
    None => base_codec::json_null()
  }
  let gen_json = match genesis {
    Some(g) => base_codec::json_str(g)
    None => base_codec::json_null()
  }
  if method == "lock.head" {
    return Ok(
      base_codec::json_obj([
        ("seq", base_codec::json_int(seq)),
        ("hash", head_json),
      ]),
    )
  }
  if method == "lock.kept" {
    let hs : Array[base_codec::Json] = []
    for i in 0..<kept.length() {
      hs.push(base_codec::json_str(kept[i].hash))
    }
    return Ok(
      base_codec::json_obj([
        ("seq", base_codec::json_int(seq)),
        ("hash", head_json),
        ("genesis", gen_json),
        ("hashes", base_codec::json_arr(hs)),
      ]),
    )
  }
  if method == "lock.get" {
    match base_codec::json_get(request, "hashes") {
      Some(base_codec::Json::Arr(want_arr)) => {
        let want : Map[String, Bool] = Map::new()
        for i in 0..<want_arr.length() {
          match want_arr[i] {
            base_codec::Json::Str(h) => want.set(h, true)
            _ => ()
          }
        }
        let entries : Array[base_codec::Json] = []
        for i in 0..<kept.length() {
          if want.contains(kept[i].hash) {
            entries.push(kept[i].raw)
          }
        }
        return Ok(base_codec::json_obj([("entries", base_codec::json_arr(entries))]))
      }
      _ => {
        let after = match base_codec::json_get(request, "after") {
          Some(base_codec::Json::Num(n, _)) => n.to_int()
          _ => -1
        }
        let entries : Array[base_codec::Json] = []
        for i in 0..<kept.length() {
          if kept[i].seq > after {
            entries.push(kept[i].raw)
          }
        }
        return Ok(base_codec::json_obj([("entries", base_codec::json_arr(entries))]))
      }
    }
  }
  if method == "lock.put" {
    let entries = match base_codec::json_get(request, "entries") {
      Some(base_codec::Json::Arr(arr)) => arr
      _ => return Err("a malformed lock entry")
    }
    match on_put(entries) {
      Ok(wr) => return Ok(
        base_codec::json_obj([
          ("taken", base_codec::json_int(wr.taken)),
          ("seq", base_codec::json_int(wr.seq)),
        ]),
      )
      Err(e) => return Err(e)
    }
  }
  if method == "lock.offer" {
    let entries = match base_codec::json_get(request, "entries") {
      Some(base_codec::Json::Arr(arr)) => arr
      _ => return Err("a malformed lock entry")
    }
    match on_offer(entries) {
      Ok(wr) => {
        let h = match wr.hash {
          Some(s) => base_codec::json_str(s)
          None => base_codec::json_null()
        }
        return Ok(
          base_codec::json_obj([
            ("taken", base_codec::json_int(wr.taken)),
            ("seq", base_codec::json_int(wr.seq)),
            ("hash", h),
          ]),
        )
      }
      Err(e) => return Err(e)
    }
  }
  Err("unknown lock method")
}

// ── Person lock & bodies sync (`lock.person.*`, `lock.bodies.*`) ──

pub struct PersonChainView {
  pub genesis : String
  pub chain : Array[base_codec::Json]
  pub all_entries : Array[LockEntryItem]
}

/// Answer all 5 person lock sync methods (`lock.person.heads`, `kept`, `get`, `put`, `offer`).
pub fn answer_person(
  heard : Array[PersonChainView],
  request : base_codec::Json,
  on_put : (Array[base_codec::Json]) -> Result[Int, String],
  on_offer : (String, Array[base_codec::Json]) -> Result[LockWriteResult, String],
) -> Result[base_codec::Json, String] {
  let method = match base_codec::json_get(request, "method") {
    Some(base_codec::Json::Str(m)) => m
    _ => ""
  }
  if method == "lock.person.heads" {
    let fields : Array[(String, base_codec::Json)] = []
    for i in 0..<heard.length() {
      fields.push((heard[i].genesis, base_codec::json_int(heard[i].chain.length())))
    }
    return Ok(base_codec::json_obj([("heads", base_codec::json_obj(fields))]))
  }
  if method == "lock.person.kept" {
    let fields : Array[(String, base_codec::Json)] = []
    for i in 0..<heard.length() {
      let hs : Array[base_codec::Json] = []
      for j in 0..<heard[i].all_entries.length() {
        hs.push(base_codec::json_str(heard[i].all_entries[j].hash))
      }
      fields.push((heard[i].genesis, base_codec::json_arr(hs)))
    }
    return Ok(base_codec::json_obj([("logs", base_codec::json_obj(fields))]))
  }
  if method == "lock.person.get" {
    let gen = match base_codec::json_get(request, "genesis") {
      Some(base_codec::Json::Str(g)) => g
      _ => ""
    }
    let mut found : Option[PersonChainView] = None
    for i in 0..<heard.length() {
      if heard[i].genesis == gen {
        found = Some(heard[i])
        break
      }
    }
    match base_codec::json_get(request, "hashes") {
      Some(base_codec::Json::Arr(want_arr)) => {
        let want : Map[String, Bool] = Map::new()
        for i in 0..<want_arr.length() {
          match want_arr[i] {
            base_codec::Json::Str(h) => want.set(h, true)
            _ => ()
          }
        }
        let entries : Array[base_codec::Json] = []
        match found {
          Some(v) => {
            for i in 0..<v.all_entries.length() {
              if want.contains(v.all_entries[i].hash) {
                entries.push(v.all_entries[i].raw)
              }
            }
          }
          None => ()
        }
        return Ok(base_codec::json_obj([("entries", base_codec::json_arr(entries))]))
      }
      _ => {
        let ch = match found {
          Some(v) => base_codec::json_arr(v.chain)
          None => base_codec::json_null()
        }
        return Ok(base_codec::json_obj([("chain", ch)]))
      }
    }
  }
  if method == "lock.person.put" {
    let chain = match base_codec::json_get(request, "chain") {
      Some(base_codec::Json::Arr(c)) => c
      _ => return Err("a person's lock: its entries")
    }
    match on_put(chain) {
      Ok(len) => return Ok(base_codec::json_obj([("length", base_codec::json_int(len))]))
      Err(e) => return Err(e)
    }
  }
  if method == "lock.person.offer" {
    let gen = match base_codec::json_get(request, "genesis") {
      Some(base_codec::Json::Str(g)) => g
      _ => ""
    }
    let entries = match base_codec::json_get(request, "entries") {
      Some(base_codec::Json::Arr(arr)) => arr
      _ => return Err("a malformed lock entry")
    }
    if entries.length() == 0 {
      return Err("a malformed lock entry")
    }
    match on_offer(gen, entries) {
      Ok(wr) => {
        let h = match wr.hash {
          Some(s) => base_codec::json_str(s)
          None => base_codec::json_null()
        }
        let head_obj = base_codec::json_obj([
          ("seq", base_codec::json_int(wr.seq)),
          ("hash", h),
        ])
        return Ok(
          base_codec::json_obj([
            ("taken", base_codec::json_int(wr.taken)),
            ("head", head_obj),
          ]),
        )
      }
      Err(e) => return Err(e)
    }
  }
  Err("unknown lock method")
}

/// Answer `lock.bodies.kept`, `lock.bodies.get`, and `lock.bodies.offer`.
/// `lock.bodies.offer` delegates verification & persistence to `take_bodies` and returns
/// ONLY the actual verified/persisted count — never fabricates `taken = bodies.length()`.
pub fn answer_bodies(
  given : Map[String, base_codec::Json],
  request : base_codec::Json,
  take_bodies : (Array[base_codec::Json]) -> Result[Int, String],
) -> Result[base_codec::Json, String] {
  let method = match base_codec::json_get(request, "method") {
    Some(base_codec::Json::Str(m)) => m
    _ => ""
  }
  if method == "lock.bodies.kept" {
    let hs : Array[base_codec::Json] = []
    let keys = given.keys()
    for i in 0..<keys.length() {
      hs.push(base_codec::json_str(keys[i]))
    }
    return Ok(base_codec::json_obj([("hashes", base_codec::json_arr(hs))]))
  }
  if method == "lock.bodies.get" {
    let out : Array[base_codec::Json] = []
    match base_codec::json_get(request, "hashes") {
      Some(base_codec::Json::Arr(want)) => {
        for i in 0..<want.length() {
          match want[i] {
            base_codec::Json::Str(h) => {
              match given.get(h) {
                Some(b) => out.push(b)
                None => ()
              }
            }
            _ => ()
          }
        }
      }
      _ => ()
    }
    return Ok(base_codec::json_obj([("bodies", base_codec::json_arr(out))]))
  }
  if method == "lock.bodies.offer" {
    let bodies = match base_codec::json_get(request, "bodies") {
      Some(base_codec::Json::Arr(arr)) => arr
      _ => return Err("a malformed bodies offer")
    }
    if bodies.length() > BODIES_OFFERED_MAX {
      return Err("too many bodies")
    }
    match take_bodies(bodies) {
      Ok(taken) => return Ok(base_codec::json_obj([("taken", base_codec::json_int(taken))]))
      Err(e) => return Err(e)
    }
  }
  Err("unknown lock method")
}

// ── Station marks (`station-marks.ts`) ──

pub struct MarkRecord {
  pub name : String
  pub emoji : String
  pub icon : String
  pub at : Int64
}

pub fn mark_name(raw : String) -> Option[String] {
  let trimmed = jscase::trim(raw)
  if trimmed.length() == 0 {
    return None
  }
  let b = trimmed.to_bytes()
  let sb = StringBuilder::new()
  let mut prev_space = false
  let mut i = 0
  while i < b.length() {
    match decode_utf8_at(b, i) {
      Some((cp, nxt)) => {
        if jscase::is_space(cp) {
          if !prev_space {
            sb.write_byte(32 as Byte)
            prev_space = true
          }
        } else {
          for k in i..<nxt {
            sb.write_byte(b[k])
          }
          prev_space = false
        }
        i = nxt
      }
      None => {
        sb.write_byte(b[i])
        prev_space = false
        i = i + 1
      }
    }
  }
  let clean = sb.to_string()
  let u16_len = js_json::utf16_len(clean)
  if u16_len == 0 || u16_len > 80 {
    None
  } else {
    Some(clean)
  }
}

fn decode_utf8_at(b : Bytes, pos : Int) -> Option[(Int, Int)] {
  if pos >= b.length() {
    return None
  }
  let b0 = b[pos].to_int() & 0xFF
  if b0 < 0x80 {
    return Some((b0, pos + 1))
  }
  if (b0 & 0xE0) == 0xC0 && pos + 1 < b.length() {
    let b1 = b[pos + 1].to_int() & 0xFF
    if (b1 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
    if cp < 0x80 {
      return None
    }
    return Some((cp, pos + 2))
  }
  if (b0 & 0xF0) == 0xE0 && pos + 2 < b.length() {
    let b1 = b[pos + 1].to_int() & 0xFF
    let b2 = b[pos + 2].to_int() & 0xFF
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    if cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF) {
      return None
    }
    return Some((cp, pos + 3))
  }
  if (b0 & 0xF8) == 0xF0 && pos + 3 < b.length() {
    let b1 = b[pos + 1].to_int() & 0xFF
    let b2 = b[pos + 2].to_int() & 0xFF
    let b3 = b[pos + 3].to_int() & 0xFF
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    if cp < 0x10000 || cp > 0x10FFFF {
      return None
    }
    return Some((cp, pos + 4))
  }
  None
}

fn in_cp_ranges(cp : Int, table : Array[Int]) -> Bool {
  let mut lo = 0
  let mut hi = table.length() / 2 - 1
  while lo <= hi {
    let mid = lo + (hi - lo) / 2
    let a = table[mid * 2]
    let b = table[mid * 2 + 1]
    if cp < a {
      hi = mid - 1
    } else if cp > b {
      lo = mid + 1
    } else {
      return true
    }
  }
  false
}

/// Exact Unicode 17.0 / Node 24.22.1 `/\p{Extended_Pictographic}/u` code-point range table (156 ranges).
fn is_extended_pictographic(cp : Int) -> Bool {
  let ep : Array[Int] = [
    0xA9, 0xA9, 0xAE, 0xAE, 0x203C, 0x203C, 0x2049, 0x2049, 0x2122, 0x2122, 0x2139, 0x2139,
    0x2194, 0x2199, 0x21A9, 0x21AA, 0x231A, 0x231B, 0x2328, 0x2328, 0x23CF, 0x23CF, 0x23E9, 0x23F3,
    0x23F8, 0x23FA, 0x24C2, 0x24C2, 0x25AA, 0x25AB, 0x25B6, 0x25B6, 0x25C0, 0x25C0, 0x25FB, 0x25FE,
    0x2600, 0x2604, 0x260E, 0x260E, 0x2611, 0x2611, 0x2614, 0x2615, 0x2618, 0x2618, 0x261D, 0x261D,
    0x2620, 0x2620, 0x2622, 0x2623, 0x2626, 0x2626, 0x262A, 0x262A, 0x262E, 0x262F, 0x2638, 0x263A,
    0x2640, 0x2640, 0x2642, 0x2642, 0x2648, 0x2653, 0x265F, 0x2660, 0x2663, 0x2663, 0x2665, 0x2666,
    0x2668, 0x2668, 0x267B, 0x267B, 0x267E, 0x267F, 0x2692, 0x2697, 0x2699, 0x2699, 0x269B, 0x269C,
    0x26A0, 0x26A1, 0x26A7, 0x26A7, 0x26AA, 0x26AB, 0x26B0, 0x26B1, 0x26BD, 0x26BE, 0x26C4, 0x26C5,
    0x26C8, 0x26C8, 0x26CE, 0x26CF, 0x26D1, 0x26D1, 0x26D3, 0x26D4, 0x26E9, 0x26EA, 0x26F0, 0x26F5,
    0x26F7, 0x26FA, 0x26FD, 0x26FD, 0x2702, 0x2702, 0x2705, 0x2705, 0x2708, 0x270D, 0x270F, 0x270F,
    0x2712, 0x2712, 0x2714, 0x2714, 0x2716, 0x2716, 0x271D, 0x271D, 0x2721, 0x2721, 0x2728, 0x2728,
    0x2733, 0x2734, 0x2744, 0x2744, 0x2747, 0x2747, 0x274C, 0x274C, 0x274E, 0x274E, 0x2753, 0x2755,
    0x2757, 0x2757, 0x2763, 0x2764, 0x2795, 0x2797, 0x27A1, 0x27A1, 0x27B0, 0x27B0, 0x27BF, 0x27BF,
    0x2934, 0x2935, 0x2B05, 0x2B07, 0x2B1B, 0x2B1C, 0x2B50, 0x2B50, 0x2B55, 0x2B55, 0x3030, 0x3030,
    0x303D, 0x303D, 0x3297, 0x3297, 0x3299, 0x3299, 0x1F004, 0x1F004, 0x1F02C, 0x1F02F, 0x1F094, 0x1F09F,
    0x1F0AF, 0x1F0B0, 0x1F0C0, 0x1F0C0, 0x1F0CF, 0x1F0D0, 0x1F0F6, 0x1F0FF, 0x1F170, 0x1F171, 0x1F17E, 0x1F17F,
    0x1F18E, 0x1F18E, 0x1F191, 0x1F19A, 0x1F1AE, 0x1F1E5, 0x1F201, 0x1F20F, 0x1F21A, 0x1F21A, 0x1F22F, 0x1F22F,
    0x1F232, 0x1F23A, 0x1F23C, 0x1F23F, 0x1F249, 0x1F25F, 0x1F266, 0x1F321, 0x1F324, 0x1F393, 0x1F396, 0x1F397,
    0x1F399, 0x1F39B, 0x1F39E, 0x1F3F0, 0x1F3F3, 0x1F3F5, 0x1F3F7, 0x1F3FA, 0x1F400, 0x1F4FD, 0x1F4FF, 0x1F53D,
    0x1F549, 0x1F54E, 0x1F550, 0x1F567, 0x1F56F, 0x1F570, 0x1F573, 0x1F57A, 0x1F587, 0x1F587, 0x1F58A, 0x1F58D,
    0x1F590, 0x1F590, 0x1F595, 0x1F596, 0x1F5A4, 0x1F5A5, 0x1F5A8, 0x1F5A8, 0x1F5B1, 0x1F5B2, 0x1F5BC, 0x1F5BC,
    0x1F5C2, 0x1F5C4, 0x1F5D1, 0x1F5D3, 0x1F5DC, 0x1F5DE, 0x1F5E1, 0x1F5E1, 0x1F5E3, 0x1F5E3, 0x1F5E8, 0x1F5E8,
    0x1F5EF, 0x1F5EF, 0x1F5F3, 0x1F5F3, 0x1F5FA, 0x1F64F, 0x1F680, 0x1F6C5, 0x1F6CB, 0x1F6D2, 0x1F6D5, 0x1F6E5,
    0x1F6E9, 0x1F6E9, 0x1F6EB, 0x1F6F0, 0x1F6F3, 0x1F6FF, 0x1F7DA, 0x1F7FF, 0x1F80C, 0x1F80F, 0x1F848, 0x1F84F,
    0x1F85A, 0x1F85F, 0x1F888, 0x1F88F, 0x1F8AE, 0x1F8AF, 0x1F8BC, 0x1F8BF, 0x1F8C2, 0x1F8CF, 0x1F8D9, 0x1F8FF,
    0x1F90C, 0x1F93A, 0x1F93C, 0x1F945, 0x1F947, 0x1F9FF, 0x1FA58, 0x1FA5F, 0x1FA6E, 0x1FAFF, 0x1FC00, 0x1FFFD,
  ]
  in_cp_ranges(cp, ep)
}

fn is_regional_indicator(cp : Int) -> Bool {
  cp >= 0x1F1E6 && cp <= 0x1F1FF
}

/// Exact Unicode 17.0 / Node 24.22.1 Grapheme_Extend + SpacingMark (`Mc`) + Emoji_Modifier (`1F3FB..1F3FF`).
fn is_emoji_extend(cp : Int) -> Bool {
  if cp >= 0x1F3FB && cp <= 0x1F3FF {
    return true
  }
  let ext : Array[Int] = [
    0x300, 0x36F, 0x483, 0x489, 0x591, 0x5BD, 0x5BF, 0x5BF, 0x5C1, 0x5C2, 0x5C4, 0x5C5,
    0x5C7, 0x5C7, 0x610, 0x61A, 0x64B, 0x65F, 0x670, 0x670, 0x6D6, 0x6DC, 0x6DF, 0x6E4,
    0x6E7, 0x6E8, 0x6EA, 0x6ED, 0x711, 0x711, 0x730, 0x74A, 0x7A6, 0x7B0, 0x7EB, 0x7F3,
    0x7FD, 0x7FD, 0x816, 0x819, 0x81B, 0x823, 0x825, 0x827, 0x829, 0x82D, 0x859, 0x85B,
    0x897, 0x89F, 0x8CA, 0x8E1, 0x8E3, 0x903, 0x93A, 0x93C, 0x93E, 0x94F, 0x951, 0x957,
    0x962, 0x963, 0x981, 0x983, 0x9BC, 0x9BC, 0x9BE, 0x9C4, 0x9C7, 0x9C8, 0x9CB, 0x9CD,
