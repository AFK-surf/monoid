///| Pure Pion port of `client/core-ts/src/rig-form.ts`:
///| Rig signed statement shapes, canonical signing bytes, validation, and default crypto adapter.

import "base64"
import "crypto"
import "form"
import "jscase"
import "lock"

pub let timeout_min : Int64 = 60.to_int64()
pub let timeout_max : Int64 = 2592000.to_int64() // 30 * 86400
pub let full_for : Int64 = 3600.to_int64()
let max_safe_double : Double = 9007199254740991.0

pub enum TimeoutKind {
  Idle
  Fixed
}

pub struct Timeout {
  pub kind : TimeoutKind
  pub seconds : Int64
}

pub fn timeout_default() -> Timeout {
  Timeout::{ kind: TimeoutKind::Idle, seconds: 3600.to_int64() }
}

pub fn timeout_kind_str(k : TimeoutKind) -> String {
  match k {
    TimeoutKind::Idle => "idle"
    TimeoutKind::Fixed => "fixed"
  }
}

pub fn timeout_kind_eq(a : TimeoutKind, b : TimeoutKind) -> Bool {
  match (a, b) {
    (TimeoutKind::Idle, TimeoutKind::Idle) => true
    (TimeoutKind::Fixed, TimeoutKind::Fixed) => true
    _ => false
  }
}

pub fn timeout_eq(a : Timeout, b : Timeout) -> Bool {
  timeout_kind_eq(a.kind, b.kind) && a.seconds == b.seconds
}

pub fn timeout_to_json(t : Timeout) -> form::Json {
  form::Json::Obj([
    ("kind", form::Json::Str(timeout_kind_str(t.kind))),
    ("seconds", form::Json::Num(t.seconds.to_double())),
  ])
}

pub fn timeout_val_refusal(t : Timeout) -> Option[String] {
  if t.seconds < timeout_min || t.seconds > timeout_max || t.seconds % 60.to_int64() != 0.to_int64() {
    return Some("timeout must be idle or fixed, in whole minutes from 1 minute to 30 days")
  }
  None
}

pub fn parse_timeout(v : form::Json) -> Result[Timeout, String] {
  let msg = "timeout must be idle or fixed, in whole minutes from 1 minute to 30 days"
  let entries = match v {
    form::Json::Obj(m) => m
    _ => return Err(msg)
  }
  let kind = match form::json_obj_get(entries, "kind") {
    Some(form::Json::Str("idle")) => TimeoutKind::Idle
    Some(form::Json::Str("fixed")) => TimeoutKind::Fixed
    _ => return Err(msg)
  }
  let seconds = match form::json_obj_get(entries, "seconds") {
    Some(form::Json::Num(n)) => {
      if !(n >= -max_safe_double && n <= max_safe_double && n.to_int64().to_double() == n) {
        return Err(msg)
      }
      n.to_int64()
    }
    _ => return Err(msg)
  }
  let t = Timeout::{ kind: kind, seconds: seconds }
  match timeout_val_refusal(t) {
    Some(why) => Err(why)
    None => Ok(t)
  }
}

///| Why `v` is no timeout a grant may have, or `None`: idle or fixed, whole minutes, 1 min to 30 days.
pub fn timeout_refusal(v : form::Json) -> Option[String] {
  match parse_timeout(v) {
    Ok(_) => None
    Err(why) => Some(why)
  }
}

///| Until when a grant signed at `at` holds at the latest: a fixed one its length, an idle one 30 days.
pub fn latest(at : Int64, timeout : Timeout) -> Int64 {
  match timeout.kind {
    TimeoutKind::Fixed => at + timeout.seconds
    TimeoutKind::Idle => at + timeout_max
  }
}

pub enum DeviceKind {
  Adb
  Tcp
  Serial
  AirPlay
}

pub fn device_kind_str(k : DeviceKind) -> String {
  match k {
    DeviceKind::Adb => "adb"
    DeviceKind::Tcp => "tcp"
    DeviceKind::Serial => "serial"
    DeviceKind::AirPlay => "airplay"
  }
}

pub fn parse_device_kind(s : String) -> Option[DeviceKind] {
  if s == "adb" {
    Some(DeviceKind::Adb)
  } else if s == "tcp" {
    Some(DeviceKind::Tcp)
  } else if s == "serial" {
    Some(DeviceKind::Serial)
  } else if s == "airplay" {
    Some(DeviceKind::AirPlay)
  } else {
    None
  }
}

pub struct Device {
  pub id : String
  pub name : String
  pub kind : DeviceKind
  pub target : String
  pub baud : Option[Int64]
  pub model : Option[String]
  pub protocols : Option[Array[String]]
  pub paired : Option[Bool]
}

pub fn device_to_json(d : Device) -> form::Json {
  let out : Array[(String, form::Json)] = [
    ("id", form::Json::Str(d.id)),
    ("name", form::Json::Str(d.name)),
    ("kind", form::Json::Str(device_kind_str(d.kind))),
    ("target", form::Json::Str(d.target)),
  ]
  match d.baud {
    Some(b) => out.push(("baud", form::Json::Num(b.to_double())))
    None => ()
  }
  match d.model {
    Some(m) => out.push(("model", form::Json::Str(m)))
    None => ()
  }
  match d.protocols {
    Some(ps) => {
      let arr : Array[form::Json] = []
      let mut i = 0
      while i < ps.length() {
        arr.push(form::Json::Str(ps[i]))
        i = i + 1
      }
      out.push(("protocols", form::Json::Arr(arr)))
    }
    None => ()
  }
  match d.paired {
    Some(p) => out.push(("paired", form::Json::Bool(p)))
    None => ()
  }
  form::Json::Obj(out)
}

pub struct Sig {
  pub key : String
  pub sig : String
}

pub fn sig_to_json(s : Sig) -> form::Json {
  form::Json::Obj([
    ("key", form::Json::Str(s.key)),
    ("sig", form::Json::Str(s.sig)),
  ])
}

