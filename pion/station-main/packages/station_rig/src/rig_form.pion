pub enum Kind {
  Grant
  Revoke
  Settings
  Add
  Full
  Device
  Join
}

pub fn kind_name(kind : Kind) -> String {
  match kind {
    Kind::Grant => "grant"
    Kind::Revoke => "revoke"
    Kind::Settings => "settings"
    Kind::Add => "add"
    Kind::Full => "full"
    Kind::Device => "device"
    Kind::Join => "join"
  }
}

pub fn kind_tag(kind : Kind) -> String {
  match kind {
    Kind::Grant => "stillfail-rig-grant/1"
    Kind::Revoke => "stillfail-rig-revoke/1"
    Kind::Settings => "stillfail-rig-settings/1"
    Kind::Add => "stillfail-rig-add/1"
    Kind::Full => "stillfail-rig-full/1"
    Kind::Device => "stillfail-rig-device/1"
    Kind::Join => "stillfail-rig-join/1"
  }
}

pub fn is_hex_lower_len(s : String, expected : Int) -> Bool {
  if s.length() != expected {
    return false
  }
  let mut i = 0
  while i < expected {
    let c = s.code_unit_at(i)
    if !((c >= 0x30 && c <= 0x39) || (c >= 0x61 && c <= 0x66)) {
      return false
    }
    i = i + 1
  }
  true
}

pub fn is_hex32(s : String) -> Bool {
  is_hex_lower_len(s, 64)
}

pub fn is_device_id(s : String) -> Bool {
  is_hex_lower_len(s, 16)
}

pub fn is_even_hex_lower(s : String) -> Bool {
  let n = s.length()
  if n == 0 || n % 2 != 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if !((c >= 0x30 && c <= 0x39) || (c >= 0x61 && c <= 0x66)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Trim JS whitespace (including Unicode spaces like NBSP and U+3000) via `jscase::trim`.
pub fn trim_js(s : String) -> String {
  jscase::trim(s)
}

///| Whether `s` contains any JS `\s` whitespace code point (Unicode White_Space / LineTerminator) or NUL (`\0`).
fn has_ws_or_nul(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    let (cp, step) = if b0 < 0x80 {
      (b0, 1)
    } else if b0 < 0xE0 && i + 1 < n {
      let b1 = s.code_unit_at(i + 1)
      (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
    } else if b0 < 0xF0 && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
    } else if i + 3 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), 4)
    } else {
      (b0, 1)
    }
    if cp == 0 || jscase::is_space(cp) {
      return true
    }
    i = i + step
  }
  false
}

fn has_ctrl(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if (c >= 0x00 && c <= 0x1F) || c == 0x7F {
      return true
    }
    i = i + 1
  }
  false
}

fn is_valid_tcp_target(s : String) -> Bool {
  // ^(\[[0-9a-fA-F:.]+\]|[A-Za-z0-9.-]+):([1-9][0-9]{0,4})$ and port <= 65535
  let n = s.length()
  let mut colon = -1
  let mut i = n - 1
  while i >= 0 {
    if s.code_unit_at(i) == 0x3A {
      colon = i
      break
    }
    i = i - 1
  }
  if colon <= 0 || colon >= n - 1 {
    return false
  }
  let host = s.slice(0, colon)
  let port_s = s.slice(colon + 1, n)
  let hlen = host.length()
  if hlen >= 3 && host.code_unit_at(0) == 0x5B && host.code_unit_at(hlen - 1) == 0x5D {
    let mut j = 1
    while j < hlen - 1 {
      let c = host.code_unit_at(j)
      let ok = (c >= 0x30 && c <= 0x39)
      || (c >= 0x61 && c <= 0x66)
      || (c >= 0x41 && c <= 0x46)
      || c == 0x3A
      || c == 0x2E
      if !ok {
        return false
      }
      j = j + 1
    }
  } else {
    let mut j = 0
    while j < hlen {
      let c = host.code_unit_at(j)
      let ok = (c >= 0x30 && c <= 0x39)
      || (c >= 0x41 && c <= 0x5A)
      || (c >= 0x61 && c <= 0x7A)
      || c == 0x2E
      || c == 0x2D
      if !ok {
        return false
      }
      j = j + 1
    }
  }
  let plen = port_s.length()
  if plen < 1 || plen > 5 {
    return false
  }
  let first = port_s.code_unit_at(0)
  if first < 0x31 || first > 0x39 {
    return false
  }
  let mut port = 0
  let mut k = 0
  while k < plen {
    let c = port_s.code_unit_at(k)
    if c < 0x30 || c > 0x39 {
      return false
    }
    port = port * 10 + (c - 0x30)
    k = k + 1
  }
  port >= 1 && port <= 65535
}

fn tcp_target_port_too_high(s : String) -> Bool {
  // Matches regex ^(\[[0-9a-fA-F:.]+\]|[A-Za-z0-9.-]+):([1-9][0-9]{0,4})$ but port > 65535
  let n = s.length()
  let mut colon = -1
  let mut i = n - 1
  while i >= 0 {
    if s.code_unit_at(i) == 0x3A {
      colon = i
      break
    }
    i = i - 1
  }
  if colon <= 0 || colon >= n - 1 {
    return false
  }
  let host = s.slice(0, colon)
  let port_s = s.slice(colon + 1, n)
  let hlen = host.length()
  if hlen >= 3 && host.code_unit_at(0) == 0x5B && host.code_unit_at(hlen - 1) == 0x5D {
    let mut j = 1
    while j < hlen - 1 {
      let c = host.code_unit_at(j)
      let ok = (c >= 0x30 && c <= 0x39)
      || (c >= 0x61 && c <= 0x66)
      || (c >= 0x41 && c <= 0x46)
      || c == 0x3A
      || c == 0x2E
      if !ok {
        return false
      }
      j = j + 1
    }
  } else {
    let mut j = 0
    while j < hlen {
      let c = host.code_unit_at(j)
      let ok = (c >= 0x30 && c <= 0x39)
      || (c >= 0x41 && c <= 0x5A)
      || (c >= 0x61 && c <= 0x7A)
      || c == 0x2E
      || c == 0x2D
      if !ok {
        return false
      }
      j = j + 1
    }
  }
  let plen = port_s.length()
  if plen < 1 || plen > 5 {
    return false
  }
  if port_s.code_unit_at(0) < 0x31 || port_s.code_unit_at(0) > 0x39 {
    return false
  }
  let mut port = 0
  let mut k = 0
  while k < plen {
    let c = port_s.code_unit_at(k)
    if c < 0x30 || c > 0x39 {
      return false
    }
    port = port * 10 + (c - 0x30)
    k = k + 1
  }
  port > 65535
}

fn is_valid_serial_target(s : String) -> Bool {
  if s.starts_with("/") {
    return true
  }
  if s.starts_with("COM") && s.length() >= 4 {
    let mut i = 3
    while i < s.length() {
      let c = s.code_unit_at(i)
      if c < 0x30 || c > 0x39 {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

fn is_valid_airplay_target(s : String) -> Bool {
  if s.length() == 0 || has_ctrl(s) {
    return false
  }
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    let ok = (c >= 0x30 && c <= 0x39)
    || (c >= 0x41 && c <= 0x5A)
    || (c >= 0x61 && c <= 0x7A)
    || c == 0x2E
    || c == 0x5F
    || c == 0x3A
    || c == 0x2D
    || c == 0x5B
    || c == 0x5D
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

fn is_airplay_proto(s : String) -> Bool {
  s == "airplay" || s == "companion" || s == "raop"
}

fn safe_nonneg_int(v : Option[form::Json]) -> Option[Int64] {
  match v {
    Some(form::Json::Num(n)) => {
      if n >= 0.0 && n <= max_safe_double && n.to_int64().to_double() == n {
        Some(n.to_int64())
      } else {
        None
      }
    }
    _ => None
  }
}

fn text_max(v : Option[form::Json], max : Int) -> Option[String] {
  match v {
    Some(form::Json::Str(s)) => {
      if form::utf16_len(s) <= max {
        Some(s)
      } else {
        None
      }
    }
    _ => None
  }
}

///| Parse and validate a `Device` JSON value (1:1 with `rig-form.ts:deviceRefusal`).
pub fn parse_device(v : form::Json) -> Result[Device, String] {
  let entries = match v {
    form::Json::Obj(m) => m
    _ => return Err("a device has an id of 16 hex digits")
  }
  let id = match form::json_obj_get(entries, "id") {
    Some(form::Json::Str(s)) => {
      if !is_device_id(s) {
        return Err("a device has an id of 16 hex digits")
      }
      s
    }
    _ => return Err("a device has an id of 16 hex digits")
  }
  let name = match text_max(form::json_obj_get(entries, "name"), 80) {
    Some(s) => {
      if trim_js(s) == "" {
        return Err("a device has a name, up to 80 characters")
      }
      s
    }
    None => return Err("a device has a name, up to 80 characters")
  }
  let kind = match form::json_obj_get(entries, "kind") {
    Some(form::Json::Str(s)) => {
      match parse_device_kind(s) {
        Some(k) => k
        None => return Err("kind: adb, tcp, serial or airplay")
      }
    }
    _ => return Err("kind: adb, tcp, serial or airplay")
  }
  let target = match text_max(form::json_obj_get(entries, "target"), 256) {
    Some(s) => {
      if trim_js(s) == "" || has_ws_or_nul(s) {
        return Err("target: what it is reached at, with no spaces")
      }
      s
    }
    None => return Err("target: what it is reached at, with no spaces")
  }
  match kind {
    DeviceKind::Tcp => {
      if tcp_target_port_too_high(target) {
        return Err("a tcp device's port is 1 to 65535")
      }
      if !is_valid_tcp_target(target) {
        return Err("a tcp device's target is host:port")
      }
    }
    DeviceKind::Serial => {
      if !is_valid_serial_target(target) {
        return Err("a serial device's target is its path (/dev/…) or COMn")
      }
    }
    DeviceKind::AirPlay => {
      if !is_valid_airplay_target(target) {
        return Err("an airplay device's target is a device identifier, hostname or IP")
      }
    }
    DeviceKind::Adb => ()
  }
  let baud : Option[Int64] = match form::json_obj_get(entries, "baud") {
    None => None
    Some(form::Json::Num(n)) => {
      if !(n >= 50.0 && n <= 4000000.0 && n.to_int64().to_double() == n) {
        return Err("baud: 50 to 4000000")
      }
      Some(n.to_int64())
    }
    Some(_) => return Err("baud: 50 to 4000000")
  }
  let model : Option[String] = match form::json_obj_get(entries, "model") {
    None => None
    Some(form::Json::Str(s)) => {
      if form::utf16_len(s) > 120 || has_ctrl(s) {
        return Err("model: up to 120 characters")
      }
      Some(s)
    }
    Some(_) => return Err("model: up to 120 characters")
  }
  let protocols : Option[Array[String]] = match form::json_obj_get(entries, "protocols") {
    None => None
    Some(form::Json::Arr(xs)) => {
      if xs.length() > 3 {
        return Err("protocols: up to 3 distinct values from airplay, companion or raop")
      }
      let out : Array[String] = []
      let mut i = 0
      while i < xs.length() {
        let p = match xs[i] {
          form::Json::Str(s) => s
          _ => return Err("protocols: up to 3 distinct values from airplay, companion or raop")
        }
        if !is_airplay_proto(p) {
          return Err("protocols: up to 3 distinct values from airplay, companion or raop")
        }
        let mut j = 0
        while j < out.length() {
          if out[j] == p {
            return Err("protocols: up to 3 distinct values from airplay, companion or raop")
          }
          j = j + 1
        }
        out.push(p)
        i = i + 1
      }
      Some(out)
    }
    Some(_) => return Err("protocols: up to 3 distinct values from airplay, companion or raop")
  }
  let paired : Option[Bool] = match form::json_obj_get(entries, "paired") {
    None => None
    Some(form::Json::Bool(b)) => Some(b)
    Some(_) => return Err("paired: boolean")
  }
  Ok(Device::{
    id: id,
    name: name,
    kind: kind,
    target: target,
    baud: baud,
    model: model,
    protocols: protocols,
    paired: paired,
  })
}

pub fn device_refusal(v : form::Json) -> Option[String] {
  match parse_device(v) {
    Ok(_) => None
    Err(why) => Some(why)
  }
}

///| What is signed for a statement of `kind`: its tag, a NUL byte, then the SHA-256 of its body's canonical JSON.
pub fn signed_bytes(kind : Kind, body : form::Json) -> Result[Bytes, String] {
  let canon = match form::canonical(body) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let tag_bytes = (kind_tag(kind) + "\u{0000}").to_bytes()
  let digest = crypto::sha256(canon.to_bytes())
  let out = Bytes::new(tag_bytes.length() + digest.length())
  let mut i = 0
  while i < tag_bytes.length() {
    out[i] = tag_bytes[i]
    i = i + 1
  }
  let mut j = 0
  while j < digest.length() {
    out[tag_bytes.length() + j] = digest[j]
    j = j + 1
  }
  Ok(out)
}

fn parse_sig_envelope(signed : form::Json) -> Option[(Array[(String, form::Json)], Sig, form::Json)] {
  let root = match signed {
    form::Json::Obj(m) => m
    _ => return None
  }
  let sig_entries = match form::json_obj_get(root, "sig") {
    Some(form::Json::Obj(m)) => m
    _ => return None
  }
  let key = match text_max(form::json_obj_get(sig_entries, "key"), 200) {
    Some(s) => s
    None => return None
  }
  let sig = match text_max(form::json_obj_get(sig_entries, "sig"), 200) {
    Some(s) => s
    None => return None
  }
  let body_val = match form::json_obj_get(root, "body") {
    Some(v) => v
    None => return None
  }
  let body_entries = match body_val {
    form::Json::Obj(m) => m
    _ => return None
  }
  Some((body_entries, Sig::{ key: key, sig: sig }, body_val))
}

fn parse_common(body_entries : Array[(String, form::Json)]) -> Option[(String, String, String, Int64)] {
  let v_ok = match form::json_obj_get(body_entries, "v") {
    Some(form::Json::Num(n)) => n == 1.0
    _ => false
  }
  if !v_ok {
    return None
  }
  let sub = match text_max(form::json_obj_get(body_entries, "sub"), 512) {
    Some(s) => if s != "" { s } else { return None }
    None => return None
  }
  let ws = match text_max(form::json_obj_get(body_entries, "ws"), 64) {
    Some(s) => if s != "" { s } else { return None }
    None => return None
  }
  let rig = match form::json_obj_get(body_entries, "rig") {
    Some(form::Json::Str(s)) => if is_hex32(s) { s } else { return None }
    _ => return None
  }
  let at = match safe_nonneg_int(form::json_obj_get(body_entries, "at")) {
    Some(n) => n
    None => return None
  }
  Some((sub, ws, rig, at))
}

pub fn parse_signed_grant(signed : form::Json) -> Option[Signed[GrantBody]] {
  let (b, sig, _) = match parse_sig_envelope(signed) {
    Some(x) => x
    None => return None
  }
  let (sub, ws, rig, at) = match parse_common(b) {
    Some(x) => x
    None => return None
  }
  let station = match form::json_obj_get(b, "station") {
    Some(form::Json::Str(s)) => if is_hex32(s) { s } else { return None }
    _ => return None
  }
  let session = match text_max(form::json_obj_get(b, "session"), 256) {
    Some(s) => if s != "" { s } else { return None }
    None => return None
  }
  let chat = match text_max(form::json_obj_get(b, "chat"), 256) {
    Some(s) => s
    None => return None
  }
  let request = match text_max(form::json_obj_get(b, "request"), 128) {
    Some(s) => if s != "" { s } else { return None }
    None => return None
  }
  let title = match text_max(form::json_obj_get(b, "title"), 512) {
    Some(s) => s
    None => return None
  }
  let by = match text_max(form::json_obj_get(b, "by"), 512) {
    Some(s) => s
    None => return None
  }
  let timeout = match form::json_obj_get(b, "timeout") {
    Some(tv) => {
      match parse_timeout(tv) {
        Ok(t) => t
        Err(_) => return None
      }
    }
    None => return None
  }
  let exp = match safe_nonneg_int(form::json_obj_get(b, "exp")) {
    Some(n) => n
    None => return None
  }
  if !(exp > at && exp - at <= timeout_max) {
    return None
  }
  let device : Option[String] = match form::json_obj_get(b, "device") {
    None => None
    Some(form::Json::Str(s)) => if is_device_id(s) { Some(s) } else { return None }
    Some(_) => return None
  }
  Some(Signed::{
    body: GrantBody::{
      v: 1,
      sub: sub,
      ws: ws,
      rig: rig,
      station: station,
      session: session,
      chat: chat,
      request: request,
      title: title,
      by: by,
      timeout: timeout,
      at: at,
      exp: exp,
      device: device,
    },
    sig: sig,
  })
}

pub fn parse_signed_revoke(signed : form::Json) -> Option[Signed[RevokeBody]] {
  let (b, sig, _) = match parse_sig_envelope(signed) {
    Some(x) => x
    None => return None
  }
  let (sub, ws, rig, at) = match parse_common(b) {
    Some(x) => x
    None => return None
  }
  let request = match text_max(form::json_obj_get(b, "request"), 128) {
    Some(s) => if s != "" { s } else { return None }
    None => return None
  }
  Some(Signed::{
    body: RevokeBody::{ v: 1, sub: sub, ws: ws, rig: rig, request: request, at: at },
    sig: sig,
  })
}

