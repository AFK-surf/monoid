pub fn parse_signed_device(signed : form::Json) -> Option[Signed[DeviceBody]] {
  let (b, sig, _) = match parse_sig_envelope(signed) {
    Some(x) => x
    None => return None
  }
  let (sub, ws, rig, at) = match parse_common(b) {
    Some(x) => x
    None => return None
  }
  let dev = match form::json_obj_get(b, "device") {
    Some(dv) => {
      match parse_device(dv) {
        Ok(d) => d
        Err(_) => return None
      }
    }
    None => return None
  }
  let removed = match form::json_obj_get(b, "removed") {
    Some(form::Json::Bool(r)) => r
    _ => return None
