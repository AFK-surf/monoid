///| Whether `signed` has the shape of a statement of `kind` (1:1 with `rig-form.ts:wellFormed`).
pub fn well_formed(kind : Kind, signed : form::Json) -> Bool {
  match kind {
    Kind::Grant => {
      match parse_signed_grant(signed) {
        Some(_) => true
        None => false
      }
    }
    Kind::Revoke => {
      match parse_signed_revoke(signed) {
        Some(_) => true
        None => false
      }
    }
    Kind::Settings => {
      match parse_signed_settings(signed) {
        Some(_) => true
        None => false
      }
    }
    Kind::Device => {
      match parse_signed_device(signed) {
        Some(_) => true
        None => false
      }
    }
    Kind::Add => {
      match parse_signed_add(signed) {
        Some(_) => true
        None => false
      }
    }
    Kind::Full => {
      match parse_signed_full(signed) {
        Some(_) => true
        None => false
      }
    }
    Kind::Join => {
      match parse_signed_join(signed) {
        Some(_) => true
        None => false
      }
    }
  }
}

///| Abstract cryptographic operations for rig & lock verification.
pub struct RigCrypto {
  pub lock_crypto : lock::Crypto
  /// Verify raw signature bytes over raw message bytes for key id (`ed25519:<hex>` or `p256:<b64url>`).
  pub verify_raw : (String, Bytes, Bytes) -> Bool
}

fn concat_bytes(a : Bytes, b : Bytes) -> Bytes {
  let out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

pub fn default_valid_key_id(id : String) -> Bool {
  if form::utf16_len(id) > 200 {
    return false
  }
  if id.starts_with("ed25519:") {
    return is_hex32(id.slice(8, id.length()))
  }
  if id.starts_with("p256:") {
    match base64::url_decode_no_pad(id.slice(5, id.length())) {
      Ok(pt) => pt.length() == 65 && pt[0].to_int() == 4 && crypto::p256_validate_pubkey(pt)
      Err(_) => false
    }
  } else {
    false
  }
}

pub fn default_verify_raw(key_id : String, sig : Bytes, msg : Bytes) -> Bool {
  if key_id.starts_with("ed25519:") {
    let hex = key_id.slice(8, key_id.length())
    if !is_hex32(hex) || sig.length() != 64 {
      return false
    }
    match crypto::hex_to_bytes(hex) {
      Some(pk) => crypto::ed25519_verify(pk, msg, sig)
      None => false
    }
  } else if key_id.starts_with("p256:") {
    let pt = match base64::url_decode_no_pad(key_id.slice(5, key_id.length())) {
      Ok(b) => b
      Err(_) => return false
    }
    if pt.length() != 65 || pt[0].to_int() != 4 {
      return false
    }
    match crypto::p256_verify_es256(pt, msg, sig) {
      Ok(_) => true
      Err(_) => false
    }
  } else {
    false
  }
}

fn lock_entry_signed_bytes(hash_hex : String) -> Option[Bytes] {
  let hbytes = match crypto::hex_to_bytes(hash_hex) {
    Some(b) => b
    None => return None
  }
  Some(concat_bytes("stillfail-lock/1 sig\u{0000}".to_bytes(), hbytes))
}

///| Default pure-Pion `RigCrypto` backed by `crypto` (SHA-256, Ed25519, P-256) and `lock`.
///| Note: `sig_valid` supports Ed25519 and ES256 app/device keys (personal locks and non-passkey
///| workspace-lock paths) and returns `false` for WebAuthn passkeys. When verifying workspace locks
///| that include passkeys, Wave 12 assembly should inject a full `lock::Crypto` with WebAuthn support.
pub fn default_rig_crypto() -> RigCrypto {
  let lock_crypto = lock::Crypto::{
    sha256_hex: fn(s : String) -> String { crypto::sha256_hex(s.to_bytes()) },
    sig_valid: fn(sig_json : form::Json, hash : String, _origins : Array[String], _rp_id : String, passkey : Bool) -> Bool {
      if passkey {
        return false
      }
      let entries = match sig_json {
        form::Json::Obj(m) => m
        _ => return false
      }
      let key_id = match form::json_obj_get(entries, "key") {
        Some(form::Json::Str(s)) => s
        _ => return false
      }
      let alg = match form::json_obj_get(entries, "alg") {
        Some(form::Json::Str(s)) => s
        _ => return false
      }
      let sig_str = match form::json_obj_get(entries, "sig") {
        Some(form::Json::Str(s)) => s
        _ => return false
      }
      let msg = match lock_entry_signed_bytes(hash) {
        Some(b) => b
        None => return false
      }
      if alg == "Ed25519" && key_id.starts_with("ed25519:") {
        if !is_even_hex_lower(sig_str) {
          return false
        }
        match crypto::hex_to_bytes(sig_str) {
          Some(sig_bytes) => default_verify_raw(key_id, sig_bytes, msg)
          None => false
        }
      } else if alg == "ES256" && key_id.starts_with("p256:") {
        match base64::url_decode_no_pad(sig_str) {
          Ok(sig_bytes) => default_verify_raw(key_id, sig_bytes, msg)
          Err(_) => false
        }
      } else {
        false
      }
    },
    valid_key_id: default_valid_key_id,
    endpoint_proof: fn(ws : String, base_hex : String, endpoint : String, proof_hex : String) -> Bool {
      if !is_hex32(base_hex) || !is_even_hex_lower(proof_hex) {
        return false
      }
      let msg = ("stillfail-lock-endpoint/1\u{0000}" + ws + "\u{0000}" + endpoint).to_bytes()
      match crypto::hex_to_bytes(proof_hex) {
        Some(sig_bytes) => default_verify_raw("ed25519:" + base_hex, sig_bytes, msg)
        None => false
      }
    },
    // Matches `pion/rules/packages/lock/src/lock.pion:13`, `roster.pion:265`, and `shared/lock.ts:181`:
    // `(key, sig_hex, tag, digest_hex)` — Ed25519 only, signs `tag + "\0" + raw_bytes(digest_hex)` without re-hashing.
    tagged_sig_valid: fn(key_id : String, sig_hex : String, tag : String, digest_hex : String) -> Bool {
      if !is_hex32(digest_hex)
      || !key_id.starts_with("ed25519:")
      || !is_hex32(key_id.slice(8, key_id.length()))
      || !is_even_hex_lower(sig_hex) {
        return false
      }
      let digest_bytes = match crypto::hex_to_bytes(digest_hex) {
        Some(b) => b
        None => return false
      }
      let msg = concat_bytes((tag + "\u{0000}").to_bytes(), digest_bytes)
      match crypto::hex_to_bytes(sig_hex) {
        Some(sig_bytes) => default_verify_raw(key_id, sig_bytes, msg)
        None => false
      }
    },
  }
  RigCrypto::{ lock_crypto: lock_crypto, verify_raw: default_verify_raw }
}

///| Whether `signed_json`'s signature is its key's over its body, as a statement of `kind`.
pub fn signature_holds(kind : Kind, signed_json : form::Json, rc : RigCrypto) -> Bool {
  let (_, sig, body_val) = match parse_sig_envelope(signed_json) {
    Some(x) => x
    None => return false
  }
  if !is_even_hex_lower(sig.sig) {
    return false
  }
  let sig_bytes = match crypto::hex_to_bytes(sig.sig) {
    Some(b) => b
    None => return false
  }
  let msg = match signed_bytes(kind, body_val) {
    Ok(b) => b
    Err(_) => return false
  }
  (rc.verify_raw)(sig.key, sig_bytes, msg)
}
