// Serial session actor queue, turn lifecycle state machine, `goesOn` single re-prompt
// without flashing `stopped`, and `--sessions` abnormal exit (`exit(70)`) contract.

/// Current execution phase of a session's serial actor.
pub enum ActorPhase {
  Idle
  Starting
  Running
  Stopping
  Closed
}

/// How an incoming message is routed given the actor's current phase.
pub enum InputRoute {
  StartPrompt
  Steer
  Queue
}

/// The state an agent declared for its turn (`chat_state` or `chat_post` `kind`).
pub enum TurnDeclared {
  None
  AllDone(String)
  NeedHuman(String)
  Waiting(String, Int, Bool)
}

/// Action to take when a runtime turn finishes (`goesOn` contract).
pub enum TurnEndAction {
  /// Turn ended cleanly with a valid state.
  Finish(TurnDeclared)
  /// Re-prompt the agent once without flashing `stopped` (`keep_running = true`).
  Reprompt(String)
  /// Already re-prompted once and a pending card remains -> end `need_human`.
  ForceNeedHuman
  /// Already re-prompted once and the turn posted -> end `all_done`.
  ForceAllDone
  /// Already re-prompted once and nothing was posted -> end undeclared.
  EndUndeclared
}

/// An item queued on a session's serial actor queue.
pub enum ActorWork {
  Prompt(String)
  InternalPrompt(String)
  Steer(String)
  Deliver(String)
  ToolCall(String)
  LifecycleOp(String)
  Barrier(Int)
}

/// Result of evaluating `--sessions` program exit.
pub struct SessionsExitDecision {
  pub exit_code : Int
  pub skip_hub_shutdown : Bool
  pub keep_runners_for_adopt : Bool
}

/// Process exit code when `--sessions` ends unexpectedly so launcher restarts and
/// the next station adopts live `stillfail-runner` children once.
pub let SESSIONS_CRASH_EXIT_CODE : Int = 70

/// How long a turn steered to check its wait may stay silent before ending as hung (`36bef9f96a`, 15 min).
pub let STEER_SILENT_MS : Int64 = 900000L

/// Result of stopping a session before a turn starts (`#8915`).
pub struct StopBeforeTurnResult {
  pub cleared_queued : Int
  pub mark_delivered : Bool
  pub post_stopped_notice : Bool
}

/// Details when a mid-wait-steered silent turn is ended as hung (`36bef9f96a`).
pub struct SteerHungResult {
  pub failed : Bool
  pub hung : Bool
  pub undelivered_steers : Array[String]
  pub turn_end_notified : Bool
}

/// Result of evaluating the post-wait-steer silence deadline (`36bef9f96a`).
pub enum SteerSilentOutcome {
  NotDue
  StillActive
  EndHung(SteerHungResult)
}

/// Evaluates how the station handles `--sessions` exit:
/// - Unplanned exit (`planned_shutdown == false`): exit with code 70, skip `hub_shutdown`,
///   and leave `stillfail-runner` child processes alive for single-pass adoption on restart.
/// - Planned shutdown (`planned_shutdown == true`): exit 0, run normal `hub_shutdown`.
pub fn evaluate_sessions_exit(planned_shutdown : Bool) -> SessionsExitDecision {
  if planned_shutdown {
    SessionsExitDecision::{
      exit_code: 0,
      skip_hub_shutdown: false,
      keep_runners_for_adopt: false,
    }
  } else {
    SessionsExitDecision::{
      exit_code: SESSIONS_CRASH_EXIT_CODE,
      skip_hub_shutdown: true,
      keep_runners_for_adopt: true,
    }
  }
}

/// Routes incoming user input based on the actor's current phase:
/// - `Idle` -> start a new prompt (`StartPrompt`)
/// - `Running` -> steer the active turn (`Steer`)
/// - `Starting`, `Stopping`, `Closed` -> queue for later (`Queue`)
pub fn route_input(phase : ActorPhase) -> InputRoute {
  match phase {
    ActorPhase::Idle => InputRoute::StartPrompt
    ActorPhase::Running => InputRoute::Steer
    ActorPhase::Starting => InputRoute::Queue
    ActorPhase::Stopping => InputRoute::Queue
    ActorPhase::Closed => InputRoute::Queue
  }
}

/// Evaluates what to do when a runtime turn ends (`actor_run.mbt:2866-2890` `on_turn_ended` 1:1):
/// - Plain text answers are never forwarded; turns must declare `all_done`, `need_human`, or `waiting`.
/// - When a turn ends without a declared state (or posted after a terminal state without declaring anew):
///   1. If the turn posted AND a pending card it posted still waits (`cardAsks`): IMMEDIATELY end
///      `ForceNeedHuman` without re-prompting first!
///   2. Else if the turn posted AND `reprompt_count >= min(max_nudges, 1)`: end `ForceAllDone`.
///   3. Else if `reprompt_count < max_nudges`: re-prompt while keeping the session running (never flash stopped).
///   4. Otherwise: `EndUndeclared`.
pub fn evaluate_turn_end_with_limit(
  declared : TurnDeclared,
  posted : Bool,
  posted_after_terminal : Bool,
  has_pending_card : Bool,
  reprompt_count : Int,
  max_nudges : Int,
) -> TurnEndAction {
  let needs_reprompt = match declared {
    TurnDeclared::None => true
    TurnDeclared::AllDone(_) => posted_after_terminal
    TurnDeclared::NeedHuman(_) => posted_after_terminal
    TurnDeclared::Waiting(_, _, _) => false
  }
  if !needs_reprompt {
    return TurnEndAction::Finish(declared)
  }
  // 1:1 with `actor_run.mbt:2867-2877`: check `cardAsks` BEFORE nudging/re-prompting!
  if posted && has_pending_card {
    return TurnEndAction::ForceNeedHuman
  }
  let post_done_at = if max_nudges < 1 { max_nudges } else { 1 }
  if posted && reprompt_count >= post_done_at {
    return TurnEndAction::ForceAllDone
  }
  if reprompt_count < max_nudges {
    let reason = if posted_after_terminal {
      "posted_after_state"
    } else {
      "missing_state"
    }
    return TurnEndAction::Reprompt(reason)
  }
  TurnEndAction::EndUndeclared
}

/// Default `evaluate_turn_end` with `max_nudges = 1`.
pub fn evaluate_turn_end(
  declared : TurnDeclared,
  posted : Bool,
  posted_after_terminal : Bool,
  has_pending_card : Bool,
  reprompt_count : Int,
) -> TurnEndAction {
  evaluate_turn_end_with_limit(
    declared,
    posted,
    posted_after_terminal,
    has_pending_card,
    reprompt_count,
    1,
  )
}

/// Per-session serial actor state.
pub struct SessionActor {
  pub key : String
  pub mut runtime : String
  pub mut phase : ActorPhase
  pub mut generation : Int
  pub mut in_flight_start : Bool
  pub mut start_failed : Bool
  pub mut wake_pending : Bool
  pub mut has_process : Bool
  pub mut idle_since_ms : Option[Int64]
  pub mut reprompt_count : Int
  pub mut max_nudges : Int
  pub mut posted_in_turn : Bool
  pub mut posted_after_terminal : Bool
  pub mut declared : TurnDeclared
  pub mut queue : Array[ActorWork]
  pub mut next_barrier_id : Int
  pub mut completed_barriers : Array[Int]
  pub mut running_history : Array[Bool]
  pub mut started_prompts : Array[String]
  pub mut started_prompts_internal : Array[Bool]
  /// Tool calls begun and not ended since the turn started (or since a mid-wait steer cleared them, `36bef9f96a`).
  pub mut open_tools : Array[String]
  /// Deadline timestamp when a mid-wait-steered silent turn is ended as hung (`36bef9f96a`).
  pub mut steer_silent_due_at : Option[Int64]
  /// Timestamp of last runtime live event during the current turn (`36bef9f96a`).
  pub mut last_live_event_at : Option[Int64]
  /// Messages steered into the turn while waiting under `steer_silent_due_at` (`36bef9f96a`).
  pub steered_during_silence : Array[String]
  /// Last hung turn end result recorded by `check_steer_silent` (`36bef9f96a`).
  pub mut last_hung_end : Option[SteerHungResult]
  pub mut compacting : Bool
  pub mut archived : Bool
  pub mut active_watch_job : Bool
}

pub fn SessionActor::new(key : String, runtime : String) -> SessionActor {
  SessionActor::{
    key: key,
    runtime: runtime,
    phase: ActorPhase::Idle,
    generation: 0,
    in_flight_start: false,
    start_failed: false,
    wake_pending: false,
    has_process: false,
    idle_since_ms: None,
    reprompt_count: 0,
    max_nudges: 1,
    posted_in_turn: false,
    posted_after_terminal: false,
    declared: TurnDeclared::None,
    queue: [],
    next_barrier_id: 1,
    completed_barriers: [],
    running_history: [],
    started_prompts: [],
    started_prompts_internal: [],
    open_tools: [],
    steer_silent_due_at: None,
    last_live_event_at: None,
    steered_during_silence: [],
    last_hung_end: None,
    compacting: false,
    archived: false,
    active_watch_job: false,
  }
}

/// Returns true if the actor is currently busy (starting, running, stopping, or has queued work).
pub fn SessionActor::is_busy(self : SessionActor) -> Bool {
  match self.phase {
    ActorPhase::Idle => self.queue.length() > 0 || self.in_flight_start
    ActorPhase::Closed => false
    _ => true
  }
}

/// Returns how long the actor's process has been idle in milliseconds, or None if not idle with a process.
pub fn SessionActor::idle_ms(self : SessionActor, now_ms : Int64) -> Option[Int64] {
  if !self.has_process {
    return None
  }
  match self.phase {
    ActorPhase::Idle => match self.idle_since_ms {
      Some(since) => {
        let diff = now_ms - since
        Some(if diff < 0L { 0L } else { diff })
      }
      None => None
    }
    _ => None
  }
}

/// Advances and returns the next generation counter (used during adopt/open).
pub fn SessionActor::next_generation(self : SessionActor) -> Int {
  self.generation = self.generation + 1
  self.generation
}

/// Enqueues a work item on the serial actor queue.
pub fn SessionActor::enqueue(self : SessionActor, item : ActorWork) -> Unit {
  self.queue.push(item)
}

/// Enqueues a flush barrier and returns its barrier id.
pub fn SessionActor::enqueue_barrier(self : SessionActor) -> Int {
  let id = self.next_barrier_id
  self.next_barrier_id = self.next_barrier_id + 1
  self.queue.push(ActorWork::Barrier(id))
  id
}

/// Pops the next queued work item in strict FIFO order.
pub fn SessionActor::pop_next(self : SessionActor) -> Option[ActorWork] {
  if self.queue.length() == 0 {
    return None
  }
  let first = self.queue[0]
  let rest : Array[ActorWork] = []
  for i in 1..<self.queue.length() {
    rest.push(self.queue[i])
  }
  self.queue = rest
  Some(first)
}

fn SessionActor::start_prompt_now(self : SessionActor, text : String, is_internal~ : Bool = false) -> Unit {
  self.phase = ActorPhase::Running
  self.idle_since_ms = None
  self.reprompt_count = 0
  self.posted_in_turn = false
  self.posted_after_terminal = false
  self.declared = TurnDeclared::None
  self.open_tools = []
  self.steer_silent_due_at = None
  self.last_live_event_at = None
  self.steered_during_silence.clear()
  self.running_history.push(true)
  self.started_prompts.push(text)
  self.started_prompts_internal.push(is_internal)
}

/// Submits user input according to `route_input` while preserving strict FIFO queue order:
/// - Idle with empty queue -> transitions to Running, starts prompt immediately (`StartPrompt`)
/// - Idle with queued work -> enqueues behind existing work, pumps FIFO head, returns `Queue`
/// - Running -> steers active turn (`Steer`)
/// - Starting/Stopping/Closed -> enqueues on serial queue (`Queue`)
pub fn SessionActor::submit_input(self : SessionActor, text : String) -> InputRoute {
  let route = route_input(self.phase)
  match route {
    InputRoute::StartPrompt => {
      if self.queue.length() == 0 {
        self.start_prompt_now(text)
        InputRoute::StartPrompt
      } else {
        self.queue.push(ActorWork::Prompt(text))
        self.pump_next_prompt()
        InputRoute::Queue
      }
    }
    InputRoute::Steer => {
      if !(self.steer_silent_due_at is None) {
        self.steered_during_silence.push(text)
      }
      self.queue.push(ActorWork::Steer(text))
      InputRoute::Steer
    }
    InputRoute::Queue => {
      self.queue.push(ActorWork::Prompt(text))
      InputRoute::Queue
    }
  }
}

/// Pops and starts the first queued Prompt/Deliver/Steer in strict FIFO order (draining any
/// leading barriers first). A residual `Steer` left at queue head after a turn ends becomes
/// the next turn's prompt so the actor never deadlocks in Idle.
pub fn SessionActor::pump_next_prompt(self : SessionActor) -> Unit {
  while self.queue.length() > 0 {
    match self.queue[0] {
      ActorWork::Barrier(id) => {
        let _ = self.pop_next()
        self.completed_barriers.push(id)
      }
      ActorWork::Prompt(text) => {
        let _ = self.pop_next()
        self.start_prompt_now(text, is_internal=false)
        return
      }
      ActorWork::InternalPrompt(text) => {
        let _ = self.pop_next()
        self.start_prompt_now(text, is_internal=true)
        return
      }
      ActorWork::Deliver(text) => {
        let _ = self.pop_next()
        self.start_prompt_now(text, is_internal=false)
        return
      }
      ActorWork::Steer(text) => {
        let _ = self.pop_next()
        self.start_prompt_now(text, is_internal=false)
        return
      }
      _ => return
    }
  }
}

/// Records an agent post during the current turn.
pub fn SessionActor::record_post(self : SessionActor, kind : TurnDeclared) -> Unit {
  self.posted_in_turn = true
  match kind {
    TurnDeclared::None => match self.declared {
      TurnDeclared::AllDone(_) => self.posted_after_terminal = true
      TurnDeclared::NeedHuman(_) => self.posted_after_terminal = true
      _ => ()
    }
    _ => {
      self.declared = kind
      self.posted_after_terminal = false
      self.steer_silent_due_at = None
    }
  }
}

/// Records an explicit `chat_state` declaration during the current turn.
pub fn SessionActor::record_state(self : SessionActor, kind : TurnDeclared) -> Unit {
  self.declared = kind
  self.posted_after_terminal = false
  self.steer_silent_due_at = None
}

/// Handles turn completion using the `goesOn` contract.
/// When re-prompting, `self.phase` stays `ActorPhase::Running` (never flashes stopped).
pub fn SessionActor::on_turn_ended(
  self : SessionActor,
  has_pending_card : Bool,
  now_ms : Int64,
) -> TurnEndAction {
  let action = evaluate_turn_end_with_limit(
    self.declared,
    self.posted_in_turn,
    self.posted_after_terminal,
    has_pending_card,
    self.reprompt_count,
    self.max_nudges,
  )
  match action {
    TurnEndAction::Reprompt(_) => {
      self.reprompt_count = self.reprompt_count + 1
      // Keep posted_after_terminal intact until the agent declares a new state.
      // Stay Running — never flash stopped!
      self.phase = ActorPhase::Running
      self.running_history.push(true)
    }
    _ => {
      self.phase = ActorPhase::Idle
      self.steer_silent_due_at = None
      self.open_tools = []
      self.steered_during_silence.clear()
      if self.has_process {
        self.idle_since_ms = Some(now_ms)
      }
      self.running_history.push(false)
      // If prompts were queued while running/starting, immediately pump the FIFO head.
      self.pump_next_prompt()
    }
  }
  action
}

/// Marks an in-flight start as begun.
pub fn SessionActor::begin_start(self : SessionActor) -> Unit {
  self.phase = ActorPhase::Starting
  self.in_flight_start = true
  self.start_failed = false
}

/// Marks an in-flight start as completed (either succeeded or failed).
/// On success, immediately drains any Prompt queued during `Starting` in strict FIFO order
/// so a subsequent `submit_input` cannot jump ahead of earlier queued prompts.
pub fn SessionActor::finish_start(self : SessionActor, ok : Bool, now_ms : Int64) -> Unit {
  self.in_flight_start = false
  if ok {
    self.start_failed = false
    self.has_process = true
    self.phase = ActorPhase::Idle
    self.idle_since_ms = Some(now_ms)
    self.pump_next_prompt()
  } else {
    self.start_failed = true
    self.has_process = false
    self.phase = ActorPhase::Idle
    self.idle_since_ms = None
    let _ = self.drain_barriers()
  }
}

/// Evicts an idle process.
pub fn SessionActor::evict(self : SessionActor) -> Bool {
  if !self.has_process {
    return false
  }
  match self.phase {
    ActorPhase::Idle => {
      self.has_process = false
      self.idle_since_ms = None
      true
    }
    _ => false
  }
}

/// Drains all currently queued barriers and records their ids as completed.
pub fn SessionActor::drain_barriers(self : SessionActor) -> Array[Int] {
  let remaining : Array[ActorWork] = []
  let done : Array[Int] = []
  for i in 0..<self.queue.length() {
    match self.queue[i] {
      ActorWork::Barrier(id) => {
        self.completed_barriers.push(id)
        done.push(id)
      }
      other => remaining.push(other)
    }
  }
  self.queue = remaining
  done
}

/// Stop the actor when called with a snapshot of whether pending deliveries exist (`#8915`).
/// Outside active turns, recovery, and pure failed-start retries, clears queued prompts/steers
/// and instructs the caller to mark snapshotted pending deliveries delivered + post stopped notice.
/// When a turn IS running, preserves `steer_silent_due_at` so a runtime that ignores abort still
/// times out after 15 minutes (`36bef9f96a`).
pub fn SessionActor::stop_with_pending(
  self : SessionActor,
  has_pending : Bool,
  in_recovery : Bool,
) -> StopBeforeTurnResult {
  match self.phase {
    ActorPhase::Running => {
      // Active turn: keep `steer_silent_due_at` armed in case runtime ignores abort (`36bef9f96a`).
      StopBeforeTurnResult::{
        cleared_queued: 0,
        mark_delivered: false,
        post_stopped_notice: false,
      }
    }
    ActorPhase::Closed => StopBeforeTurnResult::{
      cleared_queued: 0,
      mark_delivered: false,
      post_stopped_notice: false,
    }
    _ => {
      if in_recovery || (self.start_failed && !self.in_flight_start && self.queue.length() == 0) {
        return StopBeforeTurnResult::{
          cleared_queued: 0,
          mark_delivered: false,
          post_stopped_notice: false,
        }
      }
      let remaining : Array[ActorWork] = []
      let mut cleared = 0
      for i in 0..<self.queue.length() {
        match self.queue[i] {
          ActorWork::Prompt(_) => cleared = cleared + 1
          ActorWork::Deliver(_) => cleared = cleared + 1
          ActorWork::Steer(_) => cleared = cleared + 1
          other => remaining.push(other)
        }
      }
      self.queue = remaining
      self.in_flight_start = false
      self.start_failed = false
      self.phase = ActorPhase::Idle
      StopBeforeTurnResult::{
        cleared_queued: cleared,
        mark_delivered: has_pending,
        post_stopped_notice: has_pending || cleared > 0,
      }
    }
  }
}

/// Arm the 15-minute `steer_silent` deadline when a waiting turn is steered to check (`36bef9f96a`).
/// Clears `open_tools` so older backgrounded tool calls do not suppress the hung deadline forever.
pub fn SessionActor::on_mid_wait_steered(self : SessionActor, now_ms : Int64) -> Unit {
  self.open_tools = []
  self.steered_during_silence.clear()
  self.last_live_event_at = Some(now_ms)
  self.steer_silent_due_at = Some(now_ms + STEER_SILENT_MS)
}

pub fn SessionActor::on_tool_call_started(self : SessionActor, tool_id : String) -> Unit {
  for i in 0..<self.open_tools.length() {
    if self.open_tools[i] == tool_id {
      return ()
    }
  }
  self.open_tools.push(tool_id)
}

pub fn SessionActor::on_tool_call_ended(self : SessionActor, tool_id : String) -> Unit {
  let next : Array[String] = []
  for i in 0..<self.open_tools.length() {
    if self.open_tools[i] != tool_id {
      next.push(self.open_tools[i])
    }
  }
  self.open_tools = next
}

/// Record a runtime live event: advances `last_live_event_at` and pushes `steer_silent_due_at` forward (`36bef9f96a`).
pub fn SessionActor::on_live_event(self : SessionActor, now_ms : Int64) -> Unit {
  self.last_live_event_at = Some(now_ms)
  if !(self.steer_silent_due_at is None) {
    self.steer_silent_due_at = Some(now_ms + STEER_SILENT_MS)
  }
}

/// Evaluate whether a mid-wait-steered silent turn should end as `EndHung` at `now_ms` (`36bef9f96a`).
/// On hung completion, ends the turn with `failed = true`, `hung = true`, returns any messages
/// steered during the silence so the caller marks them undelivered again, and invokes `on_turn_ended`.
pub fn SessionActor::check_steer_silent(
  self : SessionActor,
  now_ms : Int64,
  is_held : Bool,
  on_turn_ended : Option[(SteerHungResult) -> Unit] = None,
) -> SteerSilentOutcome {
  let due = match self.steer_silent_due_at {
    Some(d) => d
    None => return SteerSilentOutcome::NotDue
  }
  if now_ms < due {
    return SteerSilentOutcome::NotDue
  }
  match self.phase {
    ActorPhase::Running => ()
    _ => {
      self.steer_silent_due_at = None
      self.steered_during_silence.clear()
      return SteerSilentOutcome::StillActive
    }
  }
  if is_held || self.archived || self.compacting || self.active_watch_job || self.open_tools.length() > 0 {
    return SteerSilentOutcome::StillActive
  }
  match self.last_live_event_at {
    Some(last) => {
      if now_ms - last < STEER_SILENT_MS {
        self.steer_silent_due_at = Some(last + STEER_SILENT_MS)
        return SteerSilentOutcome::NotDue
      }
    }
    None => ()
  }
  // End turn as failed+hung: terminate process, collect messages steered during silence
  // so they can be marked undelivered again, notify on_turn_ended, and return to Idle.
  let undelivered : Array[String] = []
  for i in 0..<self.steered_during_silence.length() {
    undelivered.push(self.steered_during_silence[i])
  }
  self.steered_during_silence.clear()
  // Drop only the steers added during silence (walking from the back so any pre-existing
  // `ActorWork::Steer` queued before the silence deadline was armed is preserved).
  let drop_counts : Map[String, Int] = Map::new()
  for i in 0..<undelivered.length() {
    let s = undelivered[i]
    match drop_counts.get(s) {
      Some(c) => drop_counts.set(s, c + 1)
      None => drop_counts.set(s, 1)
    }
  }
  let keep_flags : Array[Bool] = []
  for _ in 0..<self.queue.length() {
    keep_flags.push(true)
  }
  let mut qi = self.queue.length() - 1
  while qi >= 0 {
    match self.queue[qi] {
      ActorWork::Steer(s) => {
        match drop_counts.get(s) {
          Some(c) => {
            if c > 0 {
              keep_flags[qi] = false
              drop_counts.set(s, c - 1)
            }
          }
          None => ()
        }
      }
      _ => ()
    }
    qi = qi - 1
  }
  let kept_q : Array[ActorWork] = []
  for i in 0..<self.queue.length() {
    if keep_flags[i] {
      kept_q.push(self.queue[i])
    }
  }
  self.queue = kept_q
  self.steer_silent_due_at = None
  self.open_tools = []
  self.has_process = false
  self.idle_since_ms = None
  self.phase = ActorPhase::Idle
  self.running_history.push(false)
  let res = SteerHungResult::{
    failed: true,
    hung: true,
    undelivered_steers: undelivered,
    turn_end_notified: true,
  }
  self.last_hung_end = Some(res)
  match on_turn_ended {
    Some(cb) => cb(res)
    None => ()
  }
  SteerSilentOutcome::EndHung(res)
}

/// Remaining `steerSilentMs` for handover snapshot, clamped to `[0, STEER_SILENT_MS]` (`36bef9f96a`).
pub fn SessionActor::snapshot_steer_silent_ms(self : SessionActor, now_ms : Int64) -> Option[Int64] {
  match self.steer_silent_due_at {
    None => None
    Some(due) => {
      let rem = due - now_ms
      if rem < 0L {
        Some(0L)
      } else if rem > STEER_SILENT_MS {
        Some(STEER_SILENT_MS)
      } else {
        Some(rem)
      }
    }
  }
}

/// Restore `steerSilentMs` and `openTools` from a handover snapshot (`36bef9f96a`).
pub fn SessionActor::restore_steer_silent_ms(
  self : SessionActor,
  remaining_ms : Option[Int64],
  open_tools : Array[String],
  now_ms : Int64,
) -> Unit {
  self.open_tools = open_tools
  match remaining_ms {
    None => self.steer_silent_due_at = None
    Some(rem) => {
      let clamped = if rem < 0L { 0L } else if rem > STEER_SILENT_MS { STEER_SILENT_MS } else { rem }
      self.steer_silent_due_at = Some(now_ms + clamped)
      self.last_live_event_at = Some(now_ms - (STEER_SILENT_MS - clamped))
    }
  }
}
