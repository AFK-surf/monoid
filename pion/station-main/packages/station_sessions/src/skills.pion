// Composer `/` slash-invocable skills discovery, frontmatter parsing, and `<skill-invocation>`
// delivery formatting (`station/src/sessions/skills.ts`, `#9028`).

import "base_codec"
import "jscase"
import "nodepath"

pub let MAX_SKILLS : Int = 250
pub let MAX_COMMAND_DEPTH : Int = 4
pub let MAX_DESCRIPTION_CHARS : Int = 200
pub let MAX_INVOCATIONS : Int = 5
pub let PROJECT_MEMORY_PREFIX : String = "项目记忆："

/// Normalize a runtime string to one of the 10 known runtime kinds, else `None` (`#9028`).
pub fn normalize_skill_runtime(raw : Option[String]) -> Option[String] {
  match raw {
    None => None
    Some(r) => {
      if r == "claude" ||
      r == "codex" ||
      r == "dsh" ||
      r == "grok" ||
      r == "cursor" ||
      r == "devin" ||
      r == "hermes" ||
      r == "agy" ||
      r == "pi" ||
      r == "copilot" {
        Some(r)
      } else {
        None
      }
    }
  }
}

fn is_valid_workspace_id(ws : String) -> Bool {
  let b = ws.to_bytes()
  let n = b.length()
  if n == 0 || n > 128 {
    return false
  }
  for i in 0..<n {
    let c = b[i].to_int() & 0xFF
    let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45
    if !ok {
      return false
    }
  }
  true
}

/// Workspace-scoped agent home path matching `station/src/sessions/agent-home.ts` `workspaceAgentHomePath`:
/// home workspace uses `agent_home`; joined workspaces use `<agent_home>/workspaces/<ws>`.
pub fn workspace_agent_home_path(
  agent_home : String,
  ws : Option[String],
  home_ws : Option[String],
) -> Result[String, String] {
  match (ws, home_ws) {
    (None, _) => Ok(agent_home)
    (_, None) => Ok(agent_home)
    (Some(w), Some(h)) => {
      if w == h {
        Ok(agent_home)
      } else if !is_valid_workspace_id(w) {
        Err("not a workspace id: " + w)
      } else {
        Ok(nodepath::join("/", [agent_home, "workspaces", w]))
      }
    }
  }
}

/// Workspace-scoped `skills/` directory (`<workspace_agent_home_path>/skills`).
pub fn workspace_skills_dir(
  agent_home : String,
  ws : Option[String],
  home_ws : Option[String],
) -> Result[String, String] {
  match workspace_agent_home_path(agent_home, ws, home_ws) {
    Ok(dir) => Ok(nodepath::join("/", [dir, "skills"]))
    Err(e) => Err(e)
  }
}

pub enum SkillSource {
  Session
  Agent
  Workspace
  Project
  Builtin
}

pub fn skill_source_name(s : SkillSource) -> String {
  match s {
    SkillSource::Session => "session"
    SkillSource::Agent => "agent"
    SkillSource::Workspace => "workspace"
    SkillSource::Project => "project"
    SkillSource::Builtin => "builtin"
  }
}

pub fn skill_source_rank(s : SkillSource) -> Int {
  match s {
    SkillSource::Session => 0
    SkillSource::Agent => 1
    SkillSource::Workspace => 2
    SkillSource::Project => 3
    SkillSource::Builtin => 4
  }
}

pub struct ListedSkill {
  pub name : String
  pub description : String
  pub source : SkillSource
  pub place : Option[String]
}

pub fn ListedSkill::to_json(self : ListedSkill) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = [
    ("name", base_codec::json_str(self.name)),
    ("description", base_codec::json_str(self.description)),
    ("source", base_codec::json_str(skill_source_name(self.source))),
  ]
  match self.place {
    Some(p) => if p.length() > 0 { fields.push(("place", base_codec::json_str(p))) }
    None => ()
  }
  base_codec::json_obj(fields)
}

pub struct ResolvedSkill {
  pub name : String
  pub description : String
  pub source : SkillSource
  pub path : String
}

pub struct ListedSkills {
  pub runtime : Option[String]
  pub skills : Array[ListedSkill]
}

pub fn ListedSkills::to_json(self : ListedSkills) -> base_codec::Json {
  let arr : Array[base_codec::Json] = []
  for i in 0..<self.skills.length() {
    arr.push(self.skills[i].to_json())
  }
  base_codec::json_obj([
    (
      "runtime",
      match self.runtime {
        Some(rt) => base_codec::json_str(rt)
        None => base_codec::json_null()
      },
    ),
    ("skills", base_codec::json_arr(arr)),
  ])
}

