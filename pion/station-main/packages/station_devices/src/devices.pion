// Core `devices` & `device` subdomains (`station/src/devices/{registry,credentials,connect,tool}.ts`
// and `station/src/device/tools.ts`):
// - Unified `DeviceRegistry` (whole-station open vs rig/phone approval-required permission model,
//   strict `device_refusal` validation matching `client/core-ts/src/rig-form.ts`, max 200 per ws).
// - `DeviceCredentialStore` AES-256-GCM + HKDF-SHA256 encrypted credential envelope codec
//   (`info = "stillfail-device-credentials/v1"`, AAD = `<ws>\0<deviceId>`).
// - `connect`: `host_port`, 4-byte transparent `android_tv` ADB vs HTTP demuxer (`^[0-9a-f]{4}$`).
// - `tool`: `reached_at` & `device_list`/`device_use`/`device_control` tool contracts.
// - `device/tools`: `DeviceToolAccess` (`Off`/`Read`/`Full`), `permitted`, protected-path guard,
//   bounded process registry (`MAX_PROCESSES = 32`, `PROCESS_KEEP = 4 MiB`).

import "base_codec"
import "crypto"

pub let DEVICES_MAX : Int = 200
pub let DEVICE_ADB_PORT : Int = 5037
pub let DEVICE_BAUD_DEFAULT : Int = 115200
pub let TIMEOUT_MIN_SECS : Int = 60
pub let TIMEOUT_MAX_SECS : Int = 2592000 // 30 * 86400

pub enum DeviceKind {
  Adb
  Tcp
  Serial
  AirPlay
  AndroidTv
}

pub fn DeviceKind::as_str(self : DeviceKind) -> String {
  match self {
    DeviceKind::Adb => "adb"
    DeviceKind::Tcp => "tcp"
    DeviceKind::Serial => "serial"
    DeviceKind::AirPlay => "airplay"
    DeviceKind::AndroidTv => "android_tv"
  }
}

pub fn parse_device_kind(s : String) -> Option[DeviceKind] {
  if s == "adb" {
    Some(DeviceKind::Adb)
  } else if s == "tcp" {
    Some(DeviceKind::Tcp)
  } else if s == "serial" {
    Some(DeviceKind::Serial)
  } else if s == "airplay" {
    Some(DeviceKind::AirPlay)
  } else if s == "android_tv" {
    Some(DeviceKind::AndroidTv)
  } else {
    None
  }
}

/// Device access permission model: whole-station devices are open; rig devices and phones need owner approval.
pub enum DeviceAccessPolicy {
  WholeStationOpen
  RigApprovalRequired
  PhoneApprovalRequired
}

pub fn device_requires_approval(policy : DeviceAccessPolicy, rig_open_override : Bool) -> Bool {
  match policy {
    DeviceAccessPolicy::WholeStationOpen => false
    DeviceAccessPolicy::RigApprovalRequired => !rig_open_override
    DeviceAccessPolicy::PhoneApprovalRequired => true
  }
}

pub struct DeviceSpec {
  pub id : String
  pub name : String
  pub kind : DeviceKind
  pub target : String
  pub baud : Option[Int]
  pub model : Option[String]
  pub protocols : Option[Array[String]]
  pub paired : Option[Bool]
}

pub struct KeptDevice {
  pub device : DeviceSpec
  pub ws : String
  pub owner_sub : String
  pub owner_email : String
  pub owner_name : String
  pub at_secs : Int64
}

pub fn is_valid_device_id(id : String) -> Bool {
  let raw = id.to_bytes()
  if raw.length() != 16 {
    return false
  }
  let mut i = 0
  while i < 16 {
    let b = raw[i].to_int() & 0xFF
    if !(is_ascii_digit(b) || (b >= 0x61 && b <= 0x66)) {
      return false
    }
    i = i + 1
  }
  true
}

fn has_ascii_ctrl(s : String) -> Bool {
  let raw = s.to_bytes()
  let mut i = 0
  while i < raw.length() {
    let b = raw[i].to_int() & 0xFF
    if b < 0x20 || b == 0x7F {
      return true
    }
    i = i + 1
  }
  false
}

fn has_space_or_nul(s : String) -> Bool {
  let raw = s.to_bytes()
  let mut i = 0
  while i < raw.length() {
    let b = raw[i].to_int() & 0xFF
    if is_ascii_space(b) || b == 0 {
      return true
    }
    i = i + 1
  }
  false
}

fn is_valid_host_target_chars(s : String) -> Bool {
  let raw = s.to_bytes()
  if raw.length() == 0 {
    return false
  }
  let mut i = 0
  while i < raw.length() {
    let b = raw[i].to_int() & 0xFF
    if !(is_ascii_alnum(b) || b == 0x2E || b == 0x5F || b == 0x3A || b == 0x2D || b == 0x5B || b == 0x5D) {
      return false
    }
    i = i + 1
  }
  true
}

fn is_valid_tcp_target(target : String) -> Option[String] {
  let raw = target.to_bytes()
  let mut last_colon = -1
  let mut i = raw.length() - 1
  while i >= 0 {
    if (raw[i].to_int() & 0xFF) == 0x3A {
      last_colon = i
      break
    }
    i = i - 1
  }
  if last_colon <= 0 || last_colon + 1 >= raw.length() {
    return Some("a tcp device's target is host:port")
  }
  let host = slice_bytes_str(raw, 0, last_colon)
  let port_s = slice_bytes_str(raw, last_colon + 1, raw.length())
  // Validate host: either `[ipv6]` or `[A-Za-z0-9.-]+`
  let hb = host.to_bytes()
  if hb.length() >= 3 && (hb[0].to_int() & 0xFF) == 0x5B && (hb[hb.length() - 1].to_int() & 0xFF) == 0x5D {
    let mut k = 1
    while k < hb.length() - 1 {
      let b = hb[k].to_int() & 0xFF
      if !(is_hex_byte(b) || b == 0x3A || b == 0x2E) {
        return Some("a tcp device's target is host:port")
      }
      k = k + 1
    }
  } else {
    let mut k = 0
    while k < hb.length() {
      let b = hb[k].to_int() & 0xFF
      if !(is_ascii_alnum(b) || b == 0x2E || b == 0x2D) {
        return Some("a tcp device's target is host:port")
      }
      k = k + 1
    }
  }
  if port_s.length() > 5 || (port_s.to_bytes()[0].to_int() & 0xFF) == 0x30 {
    return Some("a tcp device's target is host:port")
  }
  match parse_uint_decimal(port_s) {
    Some(p) => {
      if p < 1 || p > 65535 {
        Some("a tcp device's port is 1 to 65535")
      } else {
        None
      }
    }
    None => Some("a tcp device's target is host:port")
  }
}

fn is_valid_com_port(s : String) -> Bool {
  let raw = s.to_bytes()
  if raw.length() < 4 || slice_bytes_str(raw, 0, 3) != "COM" {
    return false
  }
  let mut i = 3
  while i < raw.length() {
    if !is_ascii_digit(raw[i].to_int() & 0xFF) {
      return false
    }
    i = i + 1
  }
  true
}

/// Validate a device specification (1:1 with `client/core-ts/src/rig-form.ts` `deviceRefusal`).
pub fn device_refusal(d : DeviceSpec) -> Option[String] {
  if !is_valid_device_id(d.id) {
    return Some("a device has an id of 16 hex digits")
  }
  if d.name.length() > 80 || trim_ascii(d.name) == "" {
    return Some("a device has a name, up to 80 characters")
  }
  if d.target.length() > 256 || trim_ascii(d.target) == "" || has_space_or_nul(d.target) {
    return Some("target: what it is reached at, with no spaces")
  }
  match d.kind {
    DeviceKind::Tcp => {
      match is_valid_tcp_target(d.target) {
        Some(err) => return Some(err)
        None => ()
      }
    }
    DeviceKind::Serial => {
      if !str_starts_with_ci(d.target, "/") && !is_valid_com_port(d.target) {
        return Some("a serial device's target is its path (/dev/…) or COMn")
      }
    }
    DeviceKind::AirPlay => {
      if has_ascii_ctrl(d.target) || !is_valid_host_target_chars(d.target) {
        return Some("an airplay device's target is a device identifier, hostname or IP")
      }
    }
    DeviceKind::AndroidTv => {
      if has_ascii_ctrl(d.target) || !is_valid_host_target_chars(d.target) {
        return Some("an android_tv device's target is an IP, hostname or host:port")
      }
    }
    DeviceKind::Adb => ()
  }
  match d.baud {
    Some(b) => {
      if b < 50 || b > 4000000 {
        return Some("baud: 50 to 4000000")
      }
    }
    None => ()
  }
  match d.model {
    Some(m) => {
      if m.length() > 120 || has_ascii_ctrl(m) {
        return Some("model: up to 120 characters")
      }
    }
    None => ()
  }
  match d.protocols {
    Some(protos) => {
      match d.kind {
        DeviceKind::AirPlay => {
          if protos.length() > 3 || has_duplicate_str(protos) {
            return Some("protocols: up to 3 distinct values from airplay, companion or raop")
          }
          let mut i = 0
          while i < protos.length() {
            let p = protos[i]
            if p != "airplay" && p != "companion" && p != "raop" {
              return Some("protocols: up to 3 distinct values from airplay, companion or raop")
            }
            i = i + 1
          }
        }
        DeviceKind::AndroidTv => {
          if protos.length() > 2 || has_duplicate_str(protos) {
            return Some("protocols: up to 2 distinct values from atv_remote or adb")
          }
          let mut i = 0
          while i < protos.length() {
            let p = protos[i]
            if p != "atv_remote" && p != "adb" {
              return Some("protocols: up to 2 distinct values from atv_remote or adb")
            }
            i = i + 1
          }
        }
        _ => {
          if protos.length() > 0 {
            return Some("protocols is only supported for airplay and android_tv devices")
          }
        }
      }
    }
    None => ()
  }
  None
}

fn has_duplicate_str(arr : Array[String]) -> Bool {
  let mut i = 0
  while i < arr.length() {
    let mut j = i + 1
    while j < arr.length() {
      if arr[i] == arr[j] {
        return true
      }
      j = j + 1
    }
    i = i + 1
  }
  false
}

/// Validate grant timeout (`idle` or `fixed`, whole minutes 60..30d).
pub fn timeout_refusal(kind : String, seconds : Int) -> Option[String] {
  if (kind != "idle" && kind != "fixed") ||
  seconds < TIMEOUT_MIN_SECS ||
  seconds > TIMEOUT_MAX_SECS ||
  seconds % 60 != 0 {
    Some("timeout must be idle or fixed, in whole minutes from 1 minute to 30 days")
  } else {
    None
  }
}

// ── DeviceRegistry (`station/src/devices/registry.ts`) ──

pub struct DeviceRegistry {
  mut devices : Array[KeptDevice]
}

pub fn DeviceRegistry::new() -> DeviceRegistry {
  DeviceRegistry::{ devices: [] }
}

pub fn DeviceRegistry::of(self : DeviceRegistry, ws : String) -> Array[KeptDevice] {
  let out : Array[KeptDevice] = []
  let mut i = 0
  while i < self.devices.length() && out.length() < DEVICES_MAX {
    if self.devices[i].ws == ws {
      out.push(self.devices[i])
    }
    i = i + 1
  }
  out
}

pub fn DeviceRegistry::get(self : DeviceRegistry, ws : String, id : String) -> Option[KeptDevice] {
  let mut i = 0
  while i < self.devices.length() {
    if self.devices[i].ws == ws && self.devices[i].device.id == id {
      return Some(self.devices[i])
    }
    i = i + 1
  }
  None
}

pub fn DeviceRegistry::add(
  self : DeviceRegistry,
  ws : String,
  owner_sub : String,
  owner_email : String,
  owner_name : String,
  spec : DeviceSpec,
  at_secs : Int64,
) -> Result[KeptDevice, String] {
  let normalized = DeviceSpec::{
    id: spec.id,
    name: trim_ascii(spec.name),
    kind: spec.kind,
    target: trim_ascii(spec.target),
    baud: spec.baud,
    model: match spec.model {
      Some(m) => {
        let t = trim_ascii(m)
        if t == "" { None } else { Some(t) }
      }
      None => None
    },
    protocols: spec.protocols,
    paired: spec.paired,
  }
  match device_refusal(normalized) {
    Some(err) => return Err(err)
    None => ()
  }
  // Reject duplicate device IDs globally across all workspaces to prevent cross-workspace credential overwrite/deletion.
  let mut g = 0
  while g < self.devices.length() {
    if self.devices[g].device.id == normalized.id {
      return Err("a device with id " + normalized.id + " already exists")
    }
    g = g + 1
  }
  let all = self.of(ws)
  if all.length() >= DEVICES_MAX {
    return Err("a station holds " + DEVICES_MAX.to_string() + " devices at most")
  }
  let name_lo = to_ascii_lower(normalized.name)
  let mut i = 0
  while i < all.length() {
    if to_ascii_lower(all[i].device.name) == name_lo {
      return Err("a device named " + normalized.name + " is attached here already")
    }
    i = i + 1
  }
  let kept = KeptDevice::{
    device: normalized,
    ws,
    owner_sub,
    owner_email: to_ascii_lower(owner_email),
    owner_name,
    at_secs,
  }
  self.devices.push(kept)
  Ok(kept)
}

/// Generate a collision-free 16-hex device ID derived via SHA-256 from caller entropy + timestamp.
pub fn DeviceRegistry::generate_id(self : DeviceRegistry, seed_text : String, at_secs : Int64) -> String {
  let mut attempt = 0
  while attempt < 64 {
    let material = seed_text + ":" + at_secs.to_string() + ":" + self.devices.length().to_string() + ":" + attempt.to_string()
    let digest = crypto::sha256_hex(material.to_bytes())
    let id = slice_bytes_str(digest.to_bytes(), 0, 16)
    let mut exists = false
    let mut i = 0
    while i < self.devices.length() {
      if self.devices[i].device.id == id {
        exists = true
        break
      }
      i = i + 1
    }
    if !exists {
      return id
    }
    attempt = attempt + 1
  }
  "0000000000000000"
}

pub fn DeviceRegistry::update_meta(
  self : DeviceRegistry,
  ws : String,
  id : String,
  model : Option[String],
  protocols : Option[Array[String]],
  paired : Option[Bool],
) -> Result[Option[KeptDevice], String] {
  let mut i = 0
  while i < self.devices.length() {
    if self.devices[i].ws == ws && self.devices[i].device.id == id {
      let cur = self.devices[i]
      let next_spec = DeviceSpec::{
        id: cur.device.id,
        name: cur.device.name,
        kind: cur.device.kind,
        target: cur.device.target,
        baud: cur.device.baud,
        model: match model {
          Some(m) => Some(m)
          None => cur.device.model
        },
        protocols: match protocols {
          Some(p) => Some(p)
          None => cur.device.protocols
        },
        paired: match paired {
          Some(p) => Some(p)
          None => cur.device.paired
        },
      }
      match device_refusal(next_spec) {
        Some(err) => return Err(err)
        None => ()
      }
      let next = KeptDevice::{
        device: next_spec,
        ws: cur.ws,
        owner_sub: cur.owner_sub,
        owner_email: cur.owner_email,
        owner_name: cur.owner_name,
        at_secs: cur.at_secs,
      }
      self.devices[i] = next
      return Ok(Some(next))
    }
    i = i + 1
  }
  Ok(None)
}

pub fn DeviceRegistry::remove(self : DeviceRegistry, ws : String, id : String) -> Bool {
  let kept : Array[KeptDevice] = []
  let mut removed = false
  let mut i = 0
  while i < self.devices.length() {
    if self.devices[i].ws == ws && self.devices[i].device.id == id {
      removed = true
    } else {
      kept.push(self.devices[i])
    }
    i = i + 1
  }
  self.devices = kept
  removed
}

// ── DeviceCredentialStore (`station/src/devices/credentials.ts`) ──
// AES-256-GCM + HKDF-SHA256 (`info = "stillfail-device-credentials/v1"`, AAD = `<ws>\0<deviceId>`).

pub let CREDENTIAL_HKDF_INFO : String = "stillfail-device-credentials/v1"

/// Encrypt a JSON credential payload into a version-1 JSON envelope string.
pub fn seal_device_credentials(
  seed : Bytes,
  ws : String,
  device_id : String,
  salt : Bytes,
  iv : Bytes,
  payload_json : String,
) -> Result[String, String] {
  if !is_valid_device_id(device_id) {
    return Err("invalid device id")
  }
  if salt.length() != 16 || iv.length() != 12 {
    return Err("salt must be 16 bytes and iv must be 12 bytes")
  }
  let key = match crypto::hkdf_sha256(salt, seed, CREDENTIAL_HKDF_INFO.to_bytes(), 32) {
    Ok(k) => k
    Err(_) => return Err("hkdf derivation failed")
  }
  let aad = (ws + "\u{00}" + device_id).to_bytes()
  let sealed = match crypto::aes256_gcm_seal(key, iv, aad, payload_json.to_bytes()) {
    Ok(b) => b
    Err(_) => return Err("aes-256-gcm seal failed")
  }
  if sealed.length() < 16 {
    return Err("aes-256-gcm output too short")
  }
  let ct_len = sealed.length() - 16
  let ct = Bytes::new(ct_len)
  let mut i = 0
  while i < ct_len {
    ct[i] = sealed[i]
    i = i + 1
  }
  let tag = Bytes::new(16)
  let mut j = 0
  while j < 16 {
    tag[j] = sealed[ct_len + j]
    j = j + 1
  }
  let env = base_codec::json_obj([
    ("v", base_codec::json_int(1)),
    ("salt", base_codec::json_str(base_codec::base64_encode(salt))),
    ("iv", base_codec::json_str(base_codec::base64_encode(iv))),
    ("tag", base_codec::json_str(base_codec::base64_encode(tag))),
    ("ciphertext", base_codec::json_str(base_codec::base64_encode(ct))),
  ])
  Ok(base_codec::json_stringify(env))
}

/// Decrypt and authenticate a version-1 JSON credential envelope string.
pub fn open_device_credentials(
  seed : Bytes,
  ws : String,
  device_id : String,
  envelope_json : String,
) -> Result[String, String] {
  if !is_valid_device_id(device_id) {
    return Err("invalid device id")
  }
  let j = match base_codec::json_parse(envelope_json) {
    base_codec::JsonParseResult::Ok(v) => v
    base_codec::JsonParseResult::Err(_) => return Err("corrupt device credentials envelope")
  }
  let v_ok = match json_int_opt(j, "v") {
    Some(1) => true
    _ => false
  }
  if !v_ok {
    return Err("corrupt device credentials envelope")
  }
  let salt_b64 = match json_str_opt(j, "salt") {
    Some(s) => s
    None => return Err("corrupt device credentials envelope")
  }
  let iv_b64 = match json_str_opt(j, "iv") {
    Some(s) => s
    None => return Err("corrupt device credentials envelope")
  }
  let tag_b64 = match json_str_opt(j, "tag") {
    Some(s) => s
    None => return Err("corrupt device credentials envelope")
  }
  let ct_b64 = match json_str_opt(j, "ciphertext") {
    Some(s) => s
    None => return Err("corrupt device credentials envelope")
  }
  let salt = match base_codec::base64_decode(salt_b64) {
    Some(b) => b
    None => return Err("corrupt device credentials envelope")
  }
  let iv = match base_codec::base64_decode(iv_b64) {
    Some(b) => b
    None => return Err("corrupt device credentials envelope")
  }
  let tag = match base_codec::base64_decode(tag_b64) {
    Some(b) => b
    None => return Err("corrupt device credentials envelope")
  }
  let ct = match base_codec::base64_decode(ct_b64) {
    Some(b) => b
    None => return Err("corrupt device credentials envelope")
  }
  if salt.length() != 16 || iv.length() != 12 || tag.length() != 16 {
    return Err("corrupt device credentials envelope")
  }
  let key = match crypto::hkdf_sha256(salt, seed, CREDENTIAL_HKDF_INFO.to_bytes(), 32) {
    Ok(k) => k
    Err(_) => return Err("hkdf derivation failed")
  }
  let combined = Bytes::new(ct.length() + tag.length())
  let mut i = 0
  while i < ct.length() {
    combined[i] = ct[i]
    i = i + 1
  }
  let mut k = 0
  while k < tag.length() {
    combined[ct.length() + k] = tag[k]
    k = k + 1
  }
  let aad = (ws + "\u{00}" + device_id).to_bytes()
  let plain = match crypto::aes256_gcm_open(key, iv, aad, combined) {
    Ok(p) => p
    Err(_) => return Err("device credentials authentication failed")
  }
  let plain_str = bytes_to_str(plain)
  match base_codec::json_parse(plain_str) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Obj(_)) => Ok(plain_str)
    _ => Err("corrupt device credentials payload")
  }
}

// ── Connect & 4-byte Android TV demuxer (`station/src/devices/connect.ts`) ──

pub struct HostPort {
  pub host : String
  pub port : Int
}

pub fn host_port(target : String) -> Option[HostPort] {
  let raw = target.to_bytes()
  let mut at = -1
  let mut i = raw.length() - 1
  while i >= 0 {
    if (raw[i].to_int() & 0xFF) == 0x3A {
      at = i
      break
    }
    i = i - 1
  }
  if at <= 0 || at + 1 >= raw.length() {
    return None
  }
  let mut host = slice_bytes_str(raw, 0, at)
  let hb = host.to_bytes()
  if hb.length() >= 2 && (hb[0].to_int() & 0xFF) == 0x5B && (hb[hb.length() - 1].to_int() & 0xFF) == 0x5D {
    host = slice_bytes_str(hb, 1, hb.length() - 1)
  }
  match parse_uint_decimal(slice_bytes_str(raw, at + 1, raw.length())) {
    Some(p) => Some(HostPort::{ host, port: p })
    None => None
  }
}

/// Whether the first 4 bytes match an ADB client frame header (`^[0-9a-f]{4}$`).
pub fn is_adb_frame_head(bytes : Bytes) -> Bool {
  if bytes.length() < 4 {
    return false
  }
  let mut i = 0
  while i < 4 {
    let b = bytes[i].to_int() & 0xFF
    if !(is_ascii_digit(b) || (b >= 0x61 && b <= 0x66)) {
      return false
    }
    i = i + 1
  }
  true
}

pub enum AndroidTvRoute {
  AdbRaw
  HttpControl
}

pub fn classify_android_tv_stream(first_bytes : Bytes, has_adb_protocol : Bool) -> AndroidTvRoute {
  if has_adb_protocol && is_adb_frame_head(first_bytes) {
    AndroidTvRoute::AdbRaw
  } else {
    AndroidTvRoute::HttpControl
  }
}

// ── Device tool formatting (`station/src/devices/tool.ts`) ──

pub fn reached_at(d : DeviceSpec, port : Int) -> String {
  match d.kind {
    DeviceKind::Adb =>
    d.name + " is reached here through the adb server of the machine it is on: `adb -P " + port.to_string() + " -s " + d.target + " …` (-P on every adb command; never adb kill-server on it). Only this chat's processes connect."
    DeviceKind::Serial => {
      let baud = match d.baud {
        Some(b) => b
        None => DEVICE_BAUD_DEFAULT
      }
      d.name + " (serial " + d.target + ", " + baud.to_string() + " baud, set raw there) is at 127.0.0.1:" + port.to_string() + ": its bytes both ways, e.g. `socat - TCP:127.0.0.1:" + port.to_string() + "` or a socket in a script. Only this chat's processes connect."
    }
    DeviceKind::AirPlay =>
    d.name + " (AirPlay " + d.target + ") is at http://127.0.0.1:" + port.to_string() + ": use `device_control` for standard actions, or POST JSON `{\"action\":\"…\",\"args\":{…}}` to http://127.0.0.1:" + port.to_string() + "/action (GET /status, POST /stream-audio). Only this chat's processes connect."
    DeviceKind::AndroidTv => {
      let has_adb = match d.protocols {
        Some(ps) => array_contains_str(ps, "adb")
        None => false
      }
      let adb_hint = if has_adb {
        let serial = if contains_substr(d.target, ":") { d.target } else { d.target + ":5555" }
        " ADB is also multiplexed on this port: `adb -P " + port.to_string() + " -s " + serial + " …` (-P on every adb command; never adb kill-server)."
      } else {
        ""
      }
      d.name + " (Android TV " + d.target + ") is at http://127.0.0.1:" + port.to_string() + ": use `device_control` for remote/apps/screenshot, or POST JSON `{\"action\":\"…\",\"args\":{…}}` to http://127.0.0.1:" + port.to_string() + "/action (GET /status, POST /screenshot)." + adb_hint + " Only this chat's processes connect."
    }
    DeviceKind::Tcp =>
    d.name + " (" + d.target + ") is at 127.0.0.1:" + port.to_string() + ": connect to it there as you would to " + d.target + " (http://127.0.0.1:" + port.to_string() + "/, ssh -p " + port.to_string() + " …). Only this chat's processes connect."
  }
}

// ── Gateway device tools (`station/src/device/tools.ts`) ──

pub let DEVICE_TOOL_OUTPUT_CAP : Int = 1048576 // 1 MiB
pub let DEVICE_TOOL_READ_CAP : Int = 8388608 // 8 MiB
pub let DEVICE_TOOL_PROCESS_KEEP : Int = 4194304 // 4 MiB
pub let DEVICE_TOOL_MAX_PROCESSES : Int = 32

pub enum DeviceToolAccess {
  Off
  Read
  Full
}

pub fn parse_device_tool_access(s : String) -> DeviceToolAccess {
  if s == "read" {
    DeviceToolAccess::Read
  } else if s == "full" {
    DeviceToolAccess::Full
  } else {
    DeviceToolAccess::Off
  }
}

pub fn is_known_device_tool_op(op : String) -> Bool {
  op == "exec" ||
  op == "fs.read" ||
  op == "fs.write" ||
  op == "fs.list" ||
  op == "fs.stat" ||
  op == "process.start" ||
  op == "process.write" ||
  op == "process.tail" ||
  op == "process.stop" ||
  op == "process.list" ||
  op == "runtime.probe" ||
  op == "session.start" ||
  op == "session.say" ||
  op == "session.status"
}

pub fn is_read_device_tool_op(op : String) -> Bool {
  op == "fs.read" ||
  op == "fs.list" ||
  op == "fs.stat" ||
  op == "runtime.probe" ||
  op == "process.list" ||
  op == "process.tail" ||
  op == "session.status"
}

pub fn device_tool_permitted(access : DeviceToolAccess, op : String) -> Bool {
  match access {
    DeviceToolAccess::Full => is_known_device_tool_op(op)
    DeviceToolAccess::Read => is_read_device_tool_op(op)
    DeviceToolAccess::Off => false
  }
}

fn normalize_path_seps(p : String) -> String {
  let raw = p.to_bytes()
  let out = StringBuilder::new()
  let mut i = 0
  while i < raw.length() {
    let b = raw[i].to_int() & 0xFF
    if b == 0x5C {
      out.write_byte(0x2F.to_byte())
    } else {
      out.write_byte(raw[i])
    }
    i = i + 1
  }
  out.to_string()
}

pub fn is_within_path(path : String, root : String) -> Bool {
  let p_norm = normalize_path_seps(path)
  let r_norm = normalize_path_seps(root)
  if p_norm == r_norm {
    return true
  }
  let prefix = if str_ends_with_byte(r_norm, 0x2F) { r_norm } else { r_norm + "/" }
  str_starts_with_ci(p_norm, to_ascii_lower(prefix)) && p_norm.to_bytes().length() >= prefix.to_bytes().length()
}

pub fn is_protected_path(asked : String, real_asked : String, protected_roots : Array[(String, String)]) -> Bool {
  let mut i = 0
  while i < protected_roots.length() {
    let (root, real_root) = protected_roots[i]
    if is_within_path(asked, root) ||
    is_within_path(real_asked, real_root) ||
    is_within_path(asked, real_root) ||
    is_within_path(real_asked, root) {
      return true
    }
    i = i + 1
  }
  false
}

// ── Capabilities, Admin Error Mapping & Lookup (`station/src/devices/module.ts`) ──

fn push_unique_str(arr : Array[String], v : String) -> Unit {
  if !array_contains_str(arr, v) {
    arr.push(v)
  }
}

/// Desensitized capability summary derived from an AirPlay device's paired/supported protocols.
pub fn airplay_capabilities(protocols : Array[String]) -> Array[String] {
  let caps : Array[String] = []
  if array_contains_str(protocols, "companion") {
    push_unique_str(caps, "remote")
    push_unique_str(caps, "apps")
    push_unique_str(caps, "power")
    push_unique_str(caps, "keyboard")
  }
  if array_contains_str(protocols, "airplay") {
    push_unique_str(caps, "play_url")
    push_unique_str(caps, "playing")
  }
  if array_contains_str(protocols, "raop") {
    push_unique_str(caps, "stream_audio")
    push_unique_str(caps, "volume")
  }
  caps
}

/// Desensitized capability summary derived from an Android TV device's paired/supported protocols.
pub fn android_tv_capabilities(protocols : Array[String]) -> Array[String] {
  let caps : Array[String] = []
  if array_contains_str(protocols, "atv_remote") {
    push_unique_str(caps, "remote")
    push_unique_str(caps, "power")
    push_unique_str(caps, "launch")
    push_unique_str(caps, "volume")
    push_unique_str(caps, "keyboard")
  }
  if array_contains_str(protocols, "adb") {
    push_unique_str(caps, "remote")
    push_unique_str(caps, "power")
    push_unique_str(caps, "apps")
    push_unique_str(caps, "launch")
    push_unique_str(caps, "volume")
    push_unique_str(caps, "keyboard")
    push_unique_str(caps, "play_url")
    push_unique_str(caps, "screenshot")
    push_unique_str(caps, "adb")
  }
  caps
}

/// Map AirPlay/Android TV error codes to Admin API HTTP statuses (`module.ts` `deviceErrorAnswer`).
pub fn device_error_http_status(code : String) -> Int {
  if code == "invalid_params" || code == "invalid_pin" || code == "invalid_pair_id" || code == "invalid_pair_token" {
    422
  } else if code == "adb_unauthorized" || code == "auth_failed" {
    401
  } else if code == "device_not_found" {
    404
  } else if code == "pyatv_missing" || code == "adb_missing" {
    503
  } else {
    502
  }
}

/// Resolve a device by exact ID or case-insensitive name within a workspace (`module.ts` `named`).
pub fn DeviceRegistry::find_by_name_or_id(
  self : DeviceRegistry,
  ws : String,
  given : String,
) -> Result[KeptDevice, String] {
  let list = self.of(ws)
  let trimmed = trim_ascii(given)
  let by_id : Array[KeptDevice] = []
  let mut i = 0
  while i < list.length() {
    if list[i].device.id == trimmed {
      by_id.push(list[i])
    }
    i = i + 1
  }
  let found = if by_id.length() > 0 {
    by_id
  } else {
    let lower = to_ascii_lower(trimmed)
    let by_name : Array[KeptDevice] = []
    let mut j = 0
    while j < list.length() {
      if to_ascii_lower(list[j].device.name) == lower {
        by_name.push(list[j])
      }
      j = j + 1
    }
    by_name
  }
  if found.length() > 1 {
    return Err(found.length().to_string() + " devices are named " + trimmed + ": give the id device_list shows for the one meant")
  }
  if found.length() == 0 {
    if list.length() > 0 {
      let names : Array[String] = []
      let mut k = 0
      while k < list.length() {
        names.push(list[k].device.name)
        k = k + 1
      }
      return Err("no device " + trimmed + " in this workspace; those it has: " + join_strings(names, ", "))
    }
    return Err("no device " + trimmed + " in this workspace")
  }
  Ok(found[0])
}

pub enum DeviceControlDispatch {
  AirPlayAction(String)
  AirPlayStreamAudio
  AndroidTvAction(String)
  AndroidTvScreenshot
}

/// Validate a `device_control` tool invocation against a device spec (`module.ts:321-359`).
pub fn validate_device_control_request(
  spec : DeviceSpec,
  action : String,
  has_audio_path : Bool,
) -> Result[DeviceControlDispatch, String] {
  let act = trim_ascii(action)
  if act == "" {
    return Err("action is required.")
  }
  match spec.kind {
    DeviceKind::AirPlay => {
      if act == "stream_audio" {
        if !has_audio_path {
          return Err("stream_audio requires audio_path (a local audio file path on this station)")
        }
        return Ok(DeviceControlDispatch::AirPlayStreamAudio)
      }
      if !is_airplay_control_action(act) {
        return Err("unsupported action: " + act)
      }
      Ok(DeviceControlDispatch::AirPlayAction(act))
    }
    DeviceKind::AndroidTv => {
      if act == "screenshot" {
        return Ok(DeviceControlDispatch::AndroidTvScreenshot)
      }
      if !is_android_tv_control_action(act) {
        return Err("unsupported action: " + act)
      }
      Ok(DeviceControlDispatch::AndroidTvAction(act))
    }
    _ => Err(spec.name + " is a " + spec.kind.as_str() + " device, not an airplay or android_tv device: use device_use instead.")
  }
}

// ── Streaming 4-byte Android TV Demuxer (`station/src/devices/connect.ts:92-219`) ──

/// Incremental 4-byte transparent stream demuxer for `android_tv` tunnels:
/// buffers up to 4 initial bytes, classifies `AdbRaw` (`^[0-9a-f]{4}$` when `has_adb`) vs
/// `HttpControl`, and flushes all buffered bytes on decision or EOF.
pub struct AndroidTvDemuxer {
  has_adb : Bool
  mut decided : Option[AndroidTvRoute]
  mut head_buf : Bytes
}

pub fn AndroidTvDemuxer::new(has_adb : Bool) -> AndroidTvDemuxer {
  AndroidTvDemuxer::{ has_adb, decided: None, head_buf: Bytes::new(0) }
}

pub fn AndroidTvDemuxer::route(self : AndroidTvDemuxer) -> Option[AndroidTvRoute] {
  self.decided
}

pub fn AndroidTvDemuxer::push(self : AndroidTvDemuxer, chunk : Bytes) -> Option[(AndroidTvRoute, Bytes)] {
  match self.decided {
    Some(r) => Some((r, chunk))
    None => {
      let combined = if self.head_buf.length() == 0 {
        chunk
      } else {
        concat_bytes([self.head_buf, chunk])
      }
      if combined.length() >= 4 {
        let r = classify_android_tv_stream(combined, self.has_adb)
        self.decided = Some(r)
        self.head_buf = Bytes::new(0)
        Some((r, combined))
      } else {
        self.head_buf = combined
        None
      }
    }
  }
}

pub fn AndroidTvDemuxer::finish(self : AndroidTvDemuxer) -> Option[(AndroidTvRoute, Bytes)] {
  match self.decided {
    Some(_) => None
    None => {
      if self.head_buf.length() > 0 {
        let r = classify_android_tv_stream(self.head_buf, self.has_adb)
        let data = self.head_buf
        self.decided = Some(r)
        self.head_buf = Bytes::new(0)
        Some((r, data))
      } else {
        None
      }
    }
  }
}

// ── In-Process HTTP Control Response & Minimal HTTP/1.1 Parser (`memory-socket.ts`) ──

pub struct DeviceHttpResponse {
  pub status : Int
  pub content_type : String
  pub headers : Array[(String, String)]
  pub body : Bytes
}

pub fn device_http_json(status : Int, body : base_codec::Json) -> DeviceHttpResponse {
  let payload = base_codec::json_stringify(body).to_bytes()
  DeviceHttpResponse::{
    status,
    content_type: "application/json; charset=utf-8",
    headers: [("connection", "close")],
    body: payload,
  }
}

pub fn device_http_reason(status : Int) -> String {
  if status == 200 {
    "OK"
  } else if status == 400 {
    "Bad Request"
  } else if status == 401 {
    "Unauthorized"
  } else if status == 403 {
    "Forbidden"
  } else if status == 404 {
    "Not Found"
  } else if status == 413 {
    "Payload Too Large"
  } else if status == 422 {
    "Unprocessable Entity"
  } else if status == 501 {
    "Not Implemented"
  } else if status == 502 {
    "Bad Gateway"
  } else if status == 503 {
    "Service Unavailable"
  } else {
    "Internal Server Error"
  }
}

/// Serialize a `DeviceHttpResponse` into an HTTP/1.1 wire response (`Connection: close`).
pub fn encode_device_http_response(resp : DeviceHttpResponse) -> Bytes {
  let sb = StringBuilder::new()
  sb.write_string("HTTP/1.1 ")
  sb.write_string(resp.status.to_string())
  sb.write_string(" ")
  sb.write_string(device_http_reason(resp.status))
  sb.write_string("\r\ncontent-type: ")
  sb.write_string(resp.content_type)
  sb.write_string("\r\ncontent-length: ")
  sb.write_string(resp.body.length().to_string())
  let mut i = 0
  while i < resp.headers.length() {
    let (k, v) = resp.headers[i]
    sb.write_string("\r\n")
    sb.write_string(k)
    sb.write_string(": ")
    sb.write_string(v)
    i = i + 1
  }
  sb.write_string("\r\n\r\n")
  concat_bytes([sb.to_string().to_bytes(), resp.body])
}

pub struct ParsedDeviceHttpRequest {
  pub method : String
  pub path : String
  pub headers : Array[(String, String)]
  pub body : Bytes
}

/// Parse a complete single HTTP/1.1 request buffer (`METHOD /path HTTP/1.1\r\n...\r\n\r\n<body>`).
pub fn parse_device_http_request(raw : Bytes) -> Result[ParsedDeviceHttpRequest, String] {
  let n = raw.length()
  let mut header_end = -1
  let mut i = 0
  while i + 3 < n {
    if (raw[i].to_int() & 0xFF) == 0x0D &&
    (raw[i + 1].to_int() & 0xFF) == 0x0A &&
    (raw[i + 2].to_int() & 0xFF) == 0x0D &&
    (raw[i + 3].to_int() & 0xFF) == 0x0A {
      header_end = i
      break
    }
    i = i + 1
  }
  if header_end < 0 {
    return Err("incomplete HTTP/1.1 request headers")
  }
  let head_str = slice_bytes_str(raw, 0, header_end)
  let lines = split_by_byte(head_str, 0x0A)
  if lines.length() == 0 {
    return Err("empty HTTP request line")
  }
  let req_line = trim_ascii(lines[0])
  let sp1 = find_substr(req_line, " ", 0)
  if sp1 <= 0 {
    return Err("malformed HTTP request line")
  }
  let sp2 = find_substr(req_line, " ", sp1 + 1)
  let rlb = req_line.to_bytes()
  let method = slice_bytes_str(rlb, 0, sp1)
  let raw_target = if sp2 > sp1 {
    slice_bytes_str(rlb, sp1 + 1, sp2)
  } else {
    slice_bytes_str(rlb, sp1 + 1, rlb.length())
  }
  let q_idx = find_substr(raw_target, "?", 0)
  let path = if q_idx >= 0 {
    slice_bytes_str(raw_target.to_bytes(), 0, q_idx)
  } else {
    raw_target
  }
  let headers : Array[(String, String)] = []
  let mut k = 1
  while k < lines.length() {
    let line = trim_ascii(lines[k])
    if line != "" {
      let colon = find_substr(line, ":", 0)
      if colon > 0 {
        let lb = line.to_bytes()
        let hk = to_ascii_lower(trim_ascii(slice_bytes_str(lb, 0, colon)))
        let hv = trim_ascii(slice_bytes_str(lb, colon + 1, lb.length()))
        headers.push((hk, hv))
      }
    }
    k = k + 1
  }
  let body = sub_bytes(raw, header_end + 4, n)
  Ok(ParsedDeviceHttpRequest::{ method, path, headers, body })
}

pub fn device_http_header_get(headers : Array[(String, String)], name_lower : String) -> Option[String] {
  let mut i = 0
  while i < headers.length() {
    let (k, v) = headers[i]
    if to_ascii_lower(k) == name_lower {
      return Some(v)
    }
    i = i + 1
  }
  None
}

// ── Streaming HTTP/1.1 Request Accumulator for Android TV Tunnels ──

pub enum HttpAccumStep {
  NeedMore
  Ready(ParsedDeviceHttpRequest)
  TooLarge
  BadRequest(String)
  AlreadyResponded
}

/// Incremental single-request HTTP/1.1 accumulator (`Connection: close`):
/// - Buffers chunks until `\r\n\r\n` + full `Content-Length` body bytes arrive
/// - Rejects headers or `Content-Length` / body exceeding `max_body_bytes` immediately with `TooLarge` (413)
/// - Emits `Ready` at most once, then discards all trailing bytes (`AlreadyResponded`)
pub struct AndroidTvHttpBuffer {
  max_body_bytes : Int
  mut buf : Bytes
  mut header_end : Int
  mut content_length : Int
  mut responded : Bool
}

pub fn AndroidTvHttpBuffer::new(max_body_bytes : Int = ATV_MAX_JSON_BYTES) -> AndroidTvHttpBuffer {
  AndroidTvHttpBuffer::{
    max_body_bytes: if max_body_bytes > 0 { max_body_bytes } else { ATV_MAX_JSON_BYTES },
    buf: Bytes::new(0),
    header_end: -1,
    content_length: -1,
    responded: false,
  }
}

pub fn AndroidTvHttpBuffer::is_responded(self : AndroidTvHttpBuffer) -> Bool {
  self.responded
}

fn find_crlf_crlf(raw : Bytes) -> Int {
  let n = raw.length()
  let mut i = 0
  while i + 3 < n {
    if (raw[i].to_int() & 0xFF) == 0x0D &&
    (raw[i + 1].to_int() & 0xFF) == 0x0A &&
    (raw[i + 2].to_int() & 0xFF) == 0x0D &&
    (raw[i + 3].to_int() & 0xFF) == 0x0A {
      return i
    }
    i = i + 1
  }
  -1
}

pub fn AndroidTvHttpBuffer::push(self : AndroidTvHttpBuffer, chunk : Bytes, is_eof : Bool) -> HttpAccumStep {
  if self.responded {
    return HttpAccumStep::AlreadyResponded
  }
  if chunk.length() > 0 {
    self.buf = if self.buf.length() == 0 { chunk } else { concat_bytes([self.buf, chunk]) }
  }
  if self.header_end < 0 {
    let he = find_crlf_crlf(self.buf)
    if he < 0 {
      if self.buf.length() > self.max_body_bytes {
        self.responded = true
        self.buf = Bytes::new(0)
        return HttpAccumStep::TooLarge
      }
      if is_eof {
        self.responded = true
        self.buf = Bytes::new(0)
        return HttpAccumStep::BadRequest("incomplete HTTP/1.1 request headers")
      }
      return HttpAccumStep::NeedMore
    }
    self.header_end = he
    let head_only = sub_bytes(self.buf, 0, he + 4)
    let head_parsed = match parse_device_http_request(head_only) {
      Ok(r) => r
      Err(msg) => {
        self.responded = true
        self.buf = Bytes::new(0)
        return HttpAccumStep::BadRequest(msg)
      }
    }
    match device_http_header_get(head_parsed.headers, "content-length") {
      Some(cl_str) => {
        match parse_uint_decimal(trim_ascii(cl_str)) {
          Some(cl) => {
            if cl < 0 || cl > self.max_body_bytes {
              self.responded = true
              self.buf = Bytes::new(0)
              return HttpAccumStep::TooLarge
            }
            self.content_length = cl
          }
          None => {
            self.responded = true
            self.buf = Bytes::new(0)
            return HttpAccumStep::BadRequest("invalid Content-Length header")
          }
        }
      }
      None => self.content_length = 0
    }
  }
  let body_start = self.header_end + 4
  let body_have = self.buf.length() - body_start
  if body_have > self.max_body_bytes {
    self.responded = true
    self.buf = Bytes::new(0)
    return HttpAccumStep::TooLarge
  }
  if body_have < self.content_length {
    if is_eof {
      self.responded = true
      self.buf = Bytes::new(0)
      return HttpAccumStep::BadRequest("truncated HTTP/1.1 request body")
    }
    return HttpAccumStep::NeedMore
  }
  let exact_end = body_start + self.content_length
  let full_req = sub_bytes(self.buf, 0, exact_end)
  self.responded = true
  self.buf = Bytes::new(0)
  match parse_device_http_request(full_req) {
    Ok(req) => HttpAccumStep::Ready(req)
    Err(msg) => HttpAccumStep::BadRequest(msg)
  }
}

// ── Unified Device Add / Rebind Commit Helpers (`android-tv/pairing.ts:340-459`) ──

pub struct DeviceCredentialPort {
  pub get : (String, String) -> Result[Option[String], String]
  pub set : (String, String, String) -> Result[Unit, String]
  pub delete : (String, String) -> Result[Unit, String]
}

pub enum DeviceCommitResult {
  Ok(KeptDevice)
  Err(Int, String)
}

pub fn normalize_host_target(t : String) -> String {
  let lower = to_ascii_lower(trim_ascii(t))
  let first = find_substr(lower, ":", 0)
  if first > 0 {
    let second = find_substr(lower, ":", first + 1)
    if second < 0 {
      return slice_bytes_str(lower.to_bytes(), 0, first)
    }
  }
  lower
}

/// Unified commit helper for adding any device (AirPlay, Android TV, or tcp/adb/serial).
/// Preserves `pair_id` on registry validation failure; rolls back registry entry on credential write error.
pub fn commit_any_device_add(
  registry : DeviceRegistry,
  airplay : AirPlayPairingManager,
  android_tv : AndroidTvPairingManager,
  credentials : DeviceCredentialPort,
  ws : String,
  owner_sub : String,
  owner_email : String,
  owner_name : String,
  spec : DeviceSpec,
  pair_id : Option[String],
  at_secs : Int64,
) -> DeviceCommitResult {
  let pid = match pair_id {
    Some(s) => {
      let t = trim_ascii(s)
      if t == "" { None } else { Some(t) }
    }
    None => None
  }
  let mut peeked_model : Option[String] = None
  let mut peeked_protocols : Option[Array[String]] = None
  let mut peeked_creds_json : Option[String] = None
  let mut peeked_kind = 0 // 1 = airplay, 2 = android_tv

  match (spec.kind, pid) {
    (DeviceKind::AirPlay, Some(id)) => {
      match airplay.peek_credentials(ws, id) {
        None => return DeviceCommitResult::Err(422, "invalid or incomplete pairing session (pairId)")
        Some(p) => {
          peeked_model = p.model
          peeked_protocols = Some(p.protocols)
          if p.credentials.length() > 0 {
            peeked_creds_json = Some(airplay_credentials_to_json(p.credentials))
          }
          peeked_kind = 1
        }
      }
    }
    (DeviceKind::AndroidTv, Some(id)) => {
      match android_tv.peek_credentials(ws, id) {
        None => return DeviceCommitResult::Err(422, "invalid or incomplete pairing session (pairId)")
        Some(p) => {
          peeked_model = p.model
          peeked_protocols = Some(p.protocols)
          if p.has_credentials {
            peeked_creds_json = Some(p.credentials_json)
          }
          peeked_kind = 2
        }
      }
    }
    _ => ()
  }

  let effective_spec = if peeked_kind == 0 {
    spec
  } else {
    let eff_model = match spec.model {
      Some(m) => if trim_ascii(m) != "" { Some(m) } else { peeked_model }
      None => peeked_model
    }
    let eff_protocols = match peeked_protocols {
      Some(ps) => if ps.length() > 0 { Some(ps) } else { spec.protocols }
      None => spec.protocols
    }
    DeviceSpec::{
      id: spec.id,
      name: spec.name,
      kind: spec.kind,
      target: spec.target,
      baud: spec.baud,
      model: eff_model,
      protocols: eff_protocols,
      paired: Some(peeked_creds_json is Some(_)),
    }
  }

  let made = match registry.add(ws, owner_sub, owner_email, owner_name, effective_spec, at_secs) {
    Ok(k) => k
    Err(msg) => return DeviceCommitResult::Err(422, msg)
  }

  match peeked_creds_json {
    Some(cj) => {
      match (credentials.set)(ws, made.device.id, cj) {
        Ok(_) => ()
        Err(err) => {
          let _ = registry.remove(ws, made.device.id)
          return DeviceCommitResult::Err(500, err)
        }
      }
    }
    None => ()
  }

  match pid {
    Some(id) => {
      if peeked_kind == 1 {
        let _ = airplay.consume_credentials(ws, id)
      } else if peeked_kind == 2 {
        let _ = android_tv.consume_credentials(ws, id)
      }
    }
    None => ()
  }

  DeviceCommitResult::Ok(made)
}

/// Unified re-pair / add-protocol commit helper for AirPlay and Android TV devices.
/// Validates target match and non-empty credentials; merges existing credentials & protocols for Android TV.
pub fn commit_device_rebind(
  registry : DeviceRegistry,
  airplay : AirPlayPairingManager,
  android_tv : AndroidTvPairingManager,
  credentials : DeviceCredentialPort,
  ws : String,
  device_id : String,
  pair_id : String,
) -> DeviceCommitResult {
  let d = match registry.get(ws, device_id) {
    Some(k) => k
    None => return DeviceCommitResult::Err(404, "no such device on this station")
  }
  let is_airplay = match d.device.kind {
    DeviceKind::AirPlay => true
    DeviceKind::AndroidTv => false
    _ => return DeviceCommitResult::Err(422, "only airplay and android_tv devices can be re-paired")
  }
  let target_low = to_ascii_lower(d.device.target)
  let target_host = normalize_host_target(d.device.target)

  if is_airplay {
    let peeked = match airplay.peek_credentials(ws, pair_id) {
      Some(p) => p
      None => return DeviceCommitResult::Err(422, "invalid or incomplete pairing session (pairId)")
    }
    let id_match = to_ascii_lower(peeked.identifier) == target_low
    let addr_match = match peeked.address {
      Some(a) => a != "" && to_ascii_lower(a) == target_low
      None => false
    }
    if !id_match && !addr_match {
      return DeviceCommitResult::Err(
        422,
        "pairing session target (" + peeked.identifier + ") does not match device target (" + d.device.target + ")",
      )
    }
    if peeked.credentials.length() == 0 {
      return DeviceCommitResult::Err(422, "re-pairing produced no credentials; existing device credentials were kept")
    }
    let next_creds_json = airplay_credentials_to_json(peeked.credentials)
    match (credentials.set)(ws, device_id, next_creds_json) {
      Ok(_) => ()
      Err(e) => return DeviceCommitResult::Err(500, e)
    }
    match registry.update_meta(ws, device_id, peeked.model, Some(peeked.protocols), Some(true)) {
      Ok(Some(updated)) => {
        let _ = airplay.consume_credentials(ws, pair_id)
        DeviceCommitResult::Ok(updated)
      }
      Ok(None) => DeviceCommitResult::Err(404, "no such device on this station")
      Err(e) => DeviceCommitResult::Err(422, e)
    }
  } else {
    let peeked = match android_tv.peek_credentials(ws, pair_id) {
      Some(p) => p
      None => return DeviceCommitResult::Err(422, "invalid or incomplete pairing session (pairId)")
    }
    let id_match = to_ascii_lower(peeked.identifier) == target_low ||
    normalize_host_target(peeked.identifier) == target_host
    let addr_match = match peeked.address {
      Some(a) => a != "" && (to_ascii_lower(a) == target_low || normalize_host_target(a) == target_host)
      None => false
    }
    if !id_match && !addr_match {
      return DeviceCommitResult::Err(
        422,
        "pairing session target (" + peeked.identifier + ") does not match device target (" + d.device.target + ")",
      )
    }
    if !peeked.has_credentials {
      return DeviceCommitResult::Err(422, "re-pairing produced no credentials; existing device credentials were kept")
    }
    let existing_json = match (credentials.get)(ws, device_id) {
      Ok(opt) => opt
      Err(_) => None
    }
    let merged_creds = merge_atv_credentials_json(existing_json, peeked.credentials_json)
    let merged_protos : Array[String] = []
    match d.device.protocols {
      Some(ps) => {
        let mut i = 0
        while i < ps.length() {
          push_unique_str(merged_protos, ps[i])
          i = i + 1
        }
      }
      None => ()
    }
    let mut j = 0
    while j < peeked.protocols.length() {
      push_unique_str(merged_protos, peeked.protocols[j])
      j = j + 1
    }
    match (credentials.set)(ws, device_id, merged_creds) {
      Ok(_) => ()
      Err(e) => return DeviceCommitResult::Err(500, e)
    }
    match registry.update_meta(ws, device_id, peeked.model, Some(merged_protos), Some(true)) {
      Ok(Some(updated)) => {
        let _ = android_tv.consume_credentials(ws, pair_id)
        DeviceCommitResult::Ok(updated)
      }
      Ok(None) => DeviceCommitResult::Err(404, "no such device on this station")
      Err(e) => DeviceCommitResult::Err(422, e)
    }
  }
}
