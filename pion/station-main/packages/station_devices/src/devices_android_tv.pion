// Complete Android TV subdomain (`station/src/devices/android-tv/{proto,cert,discovery,adb-client,pairing,adapter,server}.ts`):
// - Zero-dependency wire-format Protobuf codec (`encode_varint`, `decode_varint`, `pb_varint`,
//   `pb_bytes`, `pb_string`, `pb_message`, `decode_fields`, `frame_message`, `AtvFrameReader`).
// - Google Android TV Remote Protocol v2 Pairing (:6467) & Remote (:6466) codecs + `ANDROID_KEY_CODES`.
// - RFC 5280 `der_x509_time`, ASN.1 DER primitives, `strip_leading_zeros`, and
//   `compute_pairing_secret_hash` (SHA-256 over client/server RSA modulus+exponent + pin suffix).
// - LAN mDNS DNS-SD query builder, compressed DNS packet parser, and record merger (`merge_mdns_records`).
// - ADB helpers: `parse_png_dimensions`, `quote_android_shell_arg`, `escape_adb_input_text`.
// - `AndroidTvPairingManager` (retains `pair_token` on retryable `invalid_pin`/`adb_unauthorized`),
//   protocol selection router, and HTTP control route validation.

import "base_codec"
import "crypto"

// ── Wire-format Protobuf primitives (`proto.ts`) ──

pub let PB_WIRE_VARINT : Int = 0
pub let PB_WIRE_LEN : Int = 2
pub let ATV_MAX_FRAME_BYTES : Int = 4194304 // 4 MB

pub fn encode_varint(value : Int64) -> Result[Bytes, String] {
  if value < 0.to_int64() {
    return Err("invalid varint value")
  }
  let out : Array[Byte] = []
  let mut v = value
  while v >= 128.to_int64() {
    out.push(((v & 0x7F.to_int64()) | 0x80.to_int64()).to_int().to_byte())
    v = v >> 7
  }
  out.push(v.to_int().to_byte())
  Ok(bytes_from_array(out))
}

pub struct DecodedVarint {
  pub value : Int64
  pub next : Int
}

pub fn decode_varint(buf : Bytes, offset : Int) -> Result[Option[DecodedVarint], String] {
  let mut value : Int64 = 0.to_int64()
  let mut shift : Int = 0
  let mut i = offset
  while i < buf.length() {
    let b = buf[i].to_int() & 0xFF
    value = value | ((b & 0x7F).to_int64() << shift)
    i = i + 1
    if (b & 0x80) == 0 {
      return Ok(Some(DecodedVarint::{ value, next: i }))
    }
    shift = shift + 7
    if i - offset > 8 {
      return Err("varint too long")
    }
  }
  Ok(None)
}

fn bytes_from_array(arr : Array[Byte]) -> Bytes {
  let out = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    out[i] = arr[i]
    i = i + 1
  }
  out
}

pub fn concat_bytes(parts : Array[Bytes]) -> Bytes {
  let mut total = 0
  let mut i = 0
  while i < parts.length() {
    total = total + parts[i].length()
    i = i + 1
  }
  let out = Bytes::new(total)
  let mut pos = 0
  let mut j = 0
  while j < parts.length() {
    let p = parts[j]
    let mut k = 0
    while k < p.length() {
      out[pos] = p[k]
      pos = pos + 1
      k = k + 1
    }
    j = j + 1
  }
  out
}

fn sub_bytes(buf : Bytes, start : Int, end_excl : Int) -> Bytes {
  let len = if end_excl > start { end_excl - start } else { 0 }
  let out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = buf[start + i]
    i = i + 1
  }
  out
}

fn encode_varint_unchecked(v : Int64) -> Bytes {
  match encode_varint(v) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

pub fn pb_varint(field : Int, value : Int64) -> Bytes {
  let tag = ((field.to_int64()) << 3) | PB_WIRE_VARINT.to_int64()
  concat_bytes([encode_varint_unchecked(tag), encode_varint_unchecked(value)])
}

pub fn pb_bytes(field : Int, data : Bytes) -> Bytes {
  let tag = ((field.to_int64()) << 3) | PB_WIRE_LEN.to_int64()
  concat_bytes([encode_varint_unchecked(tag), encode_varint_unchecked(data.length().to_int64()), data])
}

pub fn pb_string(field : Int, value : String) -> Bytes {
  pb_bytes(field, value.to_bytes())
}

pub fn pb_message(field : Int, parts : Array[Bytes]) -> Bytes {
  pb_bytes(field, concat_bytes(parts))
}

pub enum PbFieldValue {
  Varint(Int64)
  LenBytes(Bytes)
}

pub struct PbField {
  pub field : Int
  pub value : PbFieldValue
}

pub fn decode_fields(buf : Bytes) -> Result[Array[PbField], String] {
  let out : Array[PbField] = []
  let mut offset = 0
  while offset < buf.length() {
    let tag = match decode_varint(buf, offset) {
      Ok(Some(t)) => t
      Ok(None) => return Err("truncated protobuf tag")
      Err(e) => return Err(e)
    }
    offset = tag.next
    let field = (tag.value >> 3).to_int()
    let wire = (tag.value & 7.to_int64()).to_int()
    if wire == PB_WIRE_VARINT {
      let v = match decode_varint(buf, offset) {
        Ok(Some(dv)) => dv
        Ok(None) => return Err("truncated protobuf varint")
        Err(e) => return Err(e)
      }
      offset = v.next
      out.push(PbField::{ field, value: PbFieldValue::Varint(v.value) })
    } else if wire == PB_WIRE_LEN {
      let l = match decode_varint(buf, offset) {
        Ok(Some(dv)) => dv
        Ok(None) => return Err("truncated protobuf length-delimited field")
        Err(e) => return Err(e)
      }
      offset = l.next
      let n = l.value.to_int()
      if n < 0 || offset + n > buf.length() {
        return Err("truncated protobuf length-delimited field")
      }
      out.push(PbField::{ field, value: PbFieldValue::LenBytes(sub_bytes(buf, offset, offset + n)) })
      offset = offset + n
    } else if wire == 1 {
      if offset + 8 > buf.length() {
        return Err("truncated protobuf fixed64")
      }
      offset = offset + 8
    } else if wire == 5 {
      if offset + 4 > buf.length() {
        return Err("truncated protobuf fixed32")
      }
      offset = offset + 4
    } else {
      return Err("unsupported protobuf wire type: " + wire.to_string())
    }
  }
  Ok(out)
}

fn first_varint(fields : Array[PbField], num : Int) -> Option[Int64] {
  let mut i = 0
  while i < fields.length() {
    if fields[i].field == num {
      match fields[i].value {
        PbFieldValue::Varint(v) => return Some(v)
        _ => ()
      }
    }
    i = i + 1
  }
  None
}

fn first_bytes(fields : Array[PbField], num : Int) -> Option[Bytes] {
  let mut i = 0
  while i < fields.length() {
    if fields[i].field == num {
      match fields[i].value {
        PbFieldValue::LenBytes(b) => return Some(b)
        _ => ()
      }
    }
    i = i + 1
  }
  None
}

fn first_string(fields : Array[PbField], num : Int) -> Option[String] {
  match first_bytes(fields, num) {
    Some(b) => Some(bytes_to_str(b))
    None => None
  }
}

// ── Varint-prefixed message framing ──

pub fn atv_frame_message(payload : Bytes) -> Bytes {
  concat_bytes([encode_varint_unchecked(payload.length().to_int64()), payload])
}

pub struct AtvFrameReader {
  mut buf : Bytes
}

pub fn AtvFrameReader::new() -> AtvFrameReader {
  AtvFrameReader::{ buf: Bytes::new(0) }
}

pub fn AtvFrameReader::push(self : AtvFrameReader, chunk : Bytes) -> Result[Array[Bytes], String] {
  self.buf = if self.buf.length() == 0 { chunk } else { concat_bytes([self.buf, chunk]) }
  let frames : Array[Bytes] = []
  while self.buf.length() > 0 {
    let dv = match decode_varint(self.buf, 0) {
      Ok(Some(v)) => v
      Ok(None) => break
      Err(e) => return Err(e)
    }
    let frame_len = dv.value.to_int()
    if frame_len > ATV_MAX_FRAME_BYTES {
      return Err("frame exceeds 4 MB limit")
    }
    if self.buf.length() < dv.next + frame_len {
      break
    }
    frames.push(sub_bytes(self.buf, dv.next, dv.next + frame_len))
    self.buf = sub_bytes(self.buf, dv.next + frame_len, self.buf.length())
  }
  Ok(frames)
}

// ── Pairing Protocol v2 (:6467) ──

pub let PAIRING_PROTOCOL_VERSION : Int64 = 2.to_int64()
pub let PAIRING_STATUS_OK : Int64 = 200.to_int64()
pub let PAIRING_STATUS_ERROR : Int64 = 400.to_int64()
pub let PAIRING_STATUS_BAD_CONFIGURATION : Int64 = 401.to_int64()
pub let PAIRING_STATUS_BAD_SECRET : Int64 = 402.to_int64()
pub let ENCODING_TYPE_HEXADECIMAL : Int64 = 3.to_int64()
pub let ROLE_TYPE_INPUT : Int64 = 1.to_int64()
pub let ROLE_TYPE_OUTPUT : Int64 = 2.to_int64()

pub fn encode_pairing_request(service_name : String, client_name : String) -> Bytes {
  concat_bytes([
    pb_varint(1, PAIRING_PROTOCOL_VERSION),
    pb_varint(2, PAIRING_STATUS_OK),
    pb_message(10, [pb_string(1, service_name), pb_string(2, client_name)]),
  ])
}

pub fn encode_pairing_option(symbol_length : Int) -> Bytes {
  let encoding = concat_bytes([pb_varint(1, ENCODING_TYPE_HEXADECIMAL), pb_varint(2, symbol_length.to_int64())])
  concat_bytes([
    pb_varint(1, PAIRING_PROTOCOL_VERSION),
    pb_varint(2, PAIRING_STATUS_OK),
    pb_message(20, [pb_bytes(1, encoding), pb_varint(3, ROLE_TYPE_INPUT)]),
  ])
}

pub fn encode_pairing_configuration(symbol_length : Int) -> Bytes {
  let encoding = concat_bytes([pb_varint(1, ENCODING_TYPE_HEXADECIMAL), pb_varint(2, symbol_length.to_int64())])
  concat_bytes([
    pb_varint(1, PAIRING_PROTOCOL_VERSION),
    pb_varint(2, PAIRING_STATUS_OK),
    pb_message(30, [pb_bytes(1, encoding), pb_varint(2, ROLE_TYPE_INPUT)]),
  ])
}

pub fn encode_pairing_secret(secret_hash : Bytes) -> Bytes {
  concat_bytes([
    pb_varint(1, PAIRING_PROTOCOL_VERSION),
    pb_varint(2, PAIRING_STATUS_OK),
    pb_message(40, [pb_bytes(1, secret_hash)]),
  ])
}

pub enum PairingMsgKind {
  PairingRequest
  PairingRequestAck
  PairingOption
  PairingConfiguration
  PairingConfigurationAck
  PairingSecret
  PairingSecretAck
  Unknown
}

pub struct DecodedPairingMessage {
  pub protocol_version : Int
  pub status : Int
  pub kind : PairingMsgKind
  pub server_name : Option[String]
  pub service_name : Option[String]
  pub client_name : Option[String]
  pub secret : Option[Bytes]
}

pub fn decode_pairing_message(buf : Bytes) -> Result[DecodedPairingMessage, String] {
  let fields = match decode_fields(buf) {
    Ok(f) => f
    Err(e) => return Err(e)
  }
  let pv = match first_varint(fields, 1) {
    Some(v) => v.to_int()
    None => 0
  }
  let st = match first_varint(fields, 2) {
    Some(v) => v.to_int()
    None => 0
  }
  match first_bytes(fields, 10) {
    Some(req) => {
      let f = match decode_fields(req) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      return Ok(DecodedPairingMessage::{
        protocol_version: pv,
        status: st,
        kind: PairingMsgKind::PairingRequest,
        server_name: None,
        service_name: first_string(f, 1),
        client_name: first_string(f, 2),
        secret: None,
      })
    }
    None => ()
  }
  match first_bytes(fields, 11) {
    Some(ack) => {
      let f = match decode_fields(ack) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      return Ok(DecodedPairingMessage::{
        protocol_version: pv,
        status: st,
        kind: PairingMsgKind::PairingRequestAck,
        server_name: first_string(f, 1),
        service_name: None,
        client_name: None,
        secret: None,
      })
    }
    None => ()
  }
  if first_bytes(fields, 20) is Some(_) {
    return Ok(DecodedPairingMessage::{
      protocol_version: pv,
      status: st,
      kind: PairingMsgKind::PairingOption,
      server_name: None,
      service_name: None,
      client_name: None,
      secret: None,
    })
  }
  if first_bytes(fields, 30) is Some(_) {
    return Ok(DecodedPairingMessage::{
      protocol_version: pv,
      status: st,
      kind: PairingMsgKind::PairingConfiguration,
      server_name: None,
      service_name: None,
      client_name: None,
      secret: None,
    })
  }
  if first_bytes(fields, 31) is Some(_) {
    return Ok(DecodedPairingMessage::{
      protocol_version: pv,
      status: st,
      kind: PairingMsgKind::PairingConfigurationAck,
      server_name: None,
      service_name: None,
      client_name: None,
      secret: None,
    })
  }
  match first_bytes(fields, 40) {
    Some(sec) => {
      let f = match decode_fields(sec) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      return Ok(DecodedPairingMessage::{
        protocol_version: pv,
        status: st,
        kind: PairingMsgKind::PairingSecret,
        server_name: None,
        service_name: None,
        client_name: None,
        secret: first_bytes(f, 1),
      })
    }
    None => ()
  }
  match first_bytes(fields, 41) {
    Some(sec_ack) => {
      let f = match decode_fields(sec_ack) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      return Ok(DecodedPairingMessage::{
        protocol_version: pv,
        status: st,
        kind: PairingMsgKind::PairingSecretAck,
        server_name: None,
        service_name: None,
        client_name: None,
        secret: first_bytes(f, 1),
      })
    }
    None => ()
  }
  Ok(DecodedPairingMessage::{
    protocol_version: pv,
    status: st,
    kind: PairingMsgKind::Unknown,
    server_name: None,
    service_name: None,
    client_name: None,
    secret: None,
  })
}

// ── Remote Protocol v2 (:6466) ──

pub let REMOTE_DIRECTION_START_LONG : Int = 1
pub let REMOTE_DIRECTION_END_LONG : Int = 2
pub let REMOTE_DIRECTION_SHORT : Int = 3

pub fn resolve_android_key_code(key : String) -> Option[Int] {
  let k = to_ascii_lower(trim_ascii(key))
  if k == "up" { Some(19) }
  else if k == "down" { Some(20) }
  else if k == "left" { Some(21) }
  else if k == "right" { Some(22) }
  else if k == "select" || k == "center" { Some(23) }
  else if k == "enter" { Some(66) }
  else if k == "back" { Some(4) }
  else if k == "home" { Some(3) }
  else if k == "menu" { Some(82) }
  else if k == "play" { Some(126) }
  else if k == "pause" { Some(127) }
  else if k == "play_pause" { Some(85) }
  else if k == "stop" { Some(86) }
  else if k == "next" { Some(87) }
  else if k == "previous" { Some(88) }
  else if k == "volume_up" { Some(24) }
  else if k == "volume_down" { Some(25) }
  else if k == "mute" { Some(164) }
  else if k == "power" { Some(26) }
  else if k == "power_on" { Some(224) }
  else if k == "power_off" { Some(223) }
  else if k == "channel_up" { Some(166) }
  else if k == "channel_down" { Some(167) }
  else if k == "search" { Some(84) }
  else if k == "settings" { Some(176) }
  else if k == "0" { Some(7) }
  else if k == "1" { Some(8) }
  else if k == "2" { Some(9) }
  else if k == "3" { Some(10) }
  else if k == "4" { Some(11) }
  else if k == "5" { Some(12) }
  else if k == "6" { Some(13) }
  else if k == "7" { Some(14) }
  else if k == "8" { Some(15) }
  else if k == "9" { Some(16) }
  else {
    match parse_uint_decimal(k) {
      Some(code) => if code >= 0 && code <= 1024 { Some(code) } else { None }
      None => None
    }
  }
}

pub fn encode_remote_configure(code1 : Int, model : String, vendor : String) -> Bytes {
  let device_info = concat_bytes([
    pb_string(1, model),
    pb_string(2, vendor),
    pb_varint(3, 1.to_int64()),
    pb_string(4, "1"),
    pb_string(5, "fail.still.remote"),
    pb_string(6, "1.0.0"),
  ])
  pb_message(1, [pb_varint(1, code1.to_int64()), pb_bytes(2, device_info)])
}

pub fn encode_remote_set_active(active : Int) -> Bytes {
  pb_message(2, [pb_varint(1, active.to_int64())])
}

pub fn encode_remote_ping_response(val1 : Int) -> Bytes {
  pb_message(9, [pb_varint(1, val1.to_int64())])
}

pub fn encode_remote_key_inject(key_code : Int, direction : Int) -> Bytes {
  pb_message(10, [pb_varint(1, key_code.to_int64()), pb_varint(2, direction.to_int64())])
}

pub fn encode_remote_app_link_launch(app_link : String) -> Bytes {
  pb_message(90, [pb_string(1, app_link)])
}

pub fn encode_remote_ime_batch_edit(text : String, ime_counter : Int, field_counter : Int) -> Bytes {
  let text_len = text.length().to_int64()
  let text_field_status = concat_bytes([
    pb_varint(1, field_counter.to_int64()),
    pb_string(2, text),
    pb_varint(3, text_len),
    pb_varint(4, text_len),
  ])
  let edit_info = concat_bytes([pb_varint(1, 2.to_int64()), pb_bytes(2, text_field_status)])
  pb_message(21, [
    pb_varint(1, ime_counter.to_int64()),
    pb_varint(2, field_counter.to_int64()),
    pb_bytes(3, edit_info),
  ])
}

pub enum DecodedRemoteMessage {
  RemoteConfigure(Option[Int], Option[String], Option[String])
  RemoteSetActive(Option[Int])
  RemotePingRequest(Int)
  RemotePingResponse(Int)
  RemoteKeyInject(Int, Int)
  RemoteImeBatchEdit(Int, Int, Option[String])
  RemoteImeShowRequest(Int, Option[String])
  RemoteStart(Bool)
  RemoteSetVolumeLevel(Int, Int, Bool, Option[String])
  RemoteAppLinkLaunchRequest(String)
  RemoteError(Bool)
  Unknown
}

pub fn decode_remote_message(buf : Bytes) -> Result[DecodedRemoteMessage, String] {
  let fields = match decode_fields(buf) {
    Ok(f) => f
    Err(e) => return Err(e)
  }
  match first_bytes(fields, 1) {
    Some(cfg) => {
      let f = match decode_fields(cfg) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let code1 = match first_varint(f, 1) {
        Some(v) => Some(v.to_int())
        None => None
      }
      let (model, vendor) = match first_bytes(f, 2) {
        Some(info) => {
          let inf = match decode_fields(info) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          (first_string(inf, 1), first_string(inf, 2))
        }
        None => (None, None)
      }
      return Ok(DecodedRemoteMessage::RemoteConfigure(code1, model, vendor))
    }
    None => ()
  }
  match first_bytes(fields, 2) {
    Some(act) => {
      let f = match decode_fields(act) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let a = match first_varint(f, 1) {
        Some(v) => Some(v.to_int())
        None => None
      }
      return Ok(DecodedRemoteMessage::RemoteSetActive(a))
    }
    None => ()
  }
  match first_bytes(fields, 3) {
    Some(err) => {
      let f = match decode_fields(err) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let v = match first_varint(f, 1) {
        Some(n) => n != 0.to_int64()
        None => false
      }
      return Ok(DecodedRemoteMessage::RemoteError(v))
    }
    None => ()
  }
  match first_bytes(fields, 8) {
    Some(pr) => {
      let f = match decode_fields(pr) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let v = match first_varint(f, 1) {
        Some(n) => n.to_int()
        None => 0
      }
      return Ok(DecodedRemoteMessage::RemotePingRequest(v))
    }
    None => ()
  }
  match first_bytes(fields, 9) {
    Some(pr) => {
      let f = match decode_fields(pr) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let v = match first_varint(f, 1) {
        Some(n) => n.to_int()
        None => 0
      }
      return Ok(DecodedRemoteMessage::RemotePingResponse(v))
    }
    None => ()
  }
  match first_bytes(fields, 10) {
    Some(key) => {
      let f = match decode_fields(key) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let kc = match first_varint(f, 1) {
        Some(n) => n.to_int()
        None => 0
      }
      let dir = match first_varint(f, 2) {
        Some(n) => n.to_int()
        None => REMOTE_DIRECTION_SHORT
      }
      return Ok(DecodedRemoteMessage::RemoteKeyInject(kc, dir))
    }
    None => ()
  }
  match first_bytes(fields, 21) {
    Some(batch) => {
      let f = match decode_fields(batch) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let ic = match first_varint(f, 1) {
        Some(n) => n.to_int()
        None => 0
      }
      let fc = match first_varint(f, 2) {
        Some(n) => n.to_int()
        None => 0
      }
      let mut text : Option[String] = None
      match first_bytes(f, 3) {
        Some(edit_info) => {
          let ef = match decode_fields(edit_info) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match first_bytes(ef, 2) {
            Some(st) => {
              let sf = match decode_fields(st) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              text = first_string(sf, 2)
            }
            None => ()
          }
        }
        None => ()
      }
      return Ok(DecodedRemoteMessage::RemoteImeBatchEdit(ic, fc, text))
    }
    None => ()
  }
  match first_bytes(fields, 22) {
    Some(ime) => {
      let f = match decode_fields(ime) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let mut fc = 0
      let mut val_ : Option[String] = None
      match first_bytes(f, 2) {
        Some(st) => {
          let sf = match decode_fields(st) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          fc = match first_varint(sf, 1) {
            Some(n) => n.to_int()
            None => 0
          }
          val_ = first_string(sf, 2)
        }
        None => ()
      }
      return Ok(DecodedRemoteMessage::RemoteImeShowRequest(fc, val_))
    }
    None => ()
  }
  match first_bytes(fields, 40) {
    Some(st) => {
      let f = match decode_fields(st) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let started = match first_varint(f, 1) {
        Some(n) => n != 0.to_int64()
        None => false
      }
      return Ok(DecodedRemoteMessage::RemoteStart(started))
    }
    None => ()
  }
  match first_bytes(fields, 50) {
    Some(vol) => {
      let f = match decode_fields(vol) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let pm = first_string(f, 3)
      let vmax = match first_varint(f, 6) {
        Some(n) => n.to_int()
        None => 0
      }
      let vlev = match first_varint(f, 7) {
        Some(n) => n.to_int()
        None => 0
      }
      let muted = match first_varint(f, 8) {
        Some(n) => n != 0.to_int64()
        None => false
      }
      return Ok(DecodedRemoteMessage::RemoteSetVolumeLevel(vlev, vmax, muted, pm))
    }
    None => ()
  }
  match first_bytes(fields, 90) {
    Some(launch) => {
      let f = match decode_fields(launch) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let link = match first_string(f, 1) {
        Some(s) => s
        None => ""
      }
      return Ok(DecodedRemoteMessage::RemoteAppLinkLaunchRequest(link))
    }
    None => ()
  }
  Ok(DecodedRemoteMessage::Unknown)
}

// ── Certificate & Pairing Secret Hash (`cert.ts`) ──

fn pad2(n : Int) -> String {
  if n < 10 { "0" + n.to_string() } else { n.to_string() }
}

fn pad4(n : Int) -> String {
  if n < 10 {
    "000" + n.to_string()
  } else if n < 100 {
    "00" + n.to_string()
  } else if n < 1000 {
    "0" + n.to_string()
  } else {
    n.to_string()
  }
}

pub fn der_length(len : Int) -> Bytes {
  if len < 0x80 {
    let out = Bytes::new(1)
    out[0] = len.to_byte()
    return out
  }
  let rev : Array[Byte] = []
  let mut n = len
  while n > 0 {
    rev.push((n & 0xFF).to_byte())
    n = n >> 8
  }
  let out = Bytes::new(1 + rev.length())
  out[0] = (0x80 | rev.length()).to_byte()
  let mut i = 0
  while i < rev.length() {
    out[1 + i] = rev[rev.length() - 1 - i]
    i = i + 1
  }
  out
}

pub fn der_tag(tag : Int, content : Bytes) -> Bytes {
  let t = Bytes::new(1)
  t[0] = (tag & 0xFF).to_byte()
  concat_bytes([t, der_length(content.length()), content])
}

/// Encode Unix epoch milliseconds as RFC 5280 X.509 Time (UTCTime 1950..2049, else GeneralizedTime).
pub fn der_x509_time(ms : Int64) -> Bytes {
  let total_sec = if ms >= 0.to_int64() { ms / 1000.to_int64() } else { (ms - 999.to_int64()) / 1000.to_int64() }
  let sec_of_day = (((total_sec % 86400.to_int64()) + 86400.to_int64()) % 86400.to_int64()).to_int()
  let days = if total_sec >= 0.to_int64() { total_sec / 86400.to_int64() } else { (total_sec - 86399.to_int64()) / 86400.to_int64() }
  let z = days + 719468.to_int64()
  let era = (if z >= 0.to_int64() { z } else { z - 146096.to_int64() }) / 146097.to_int64()
  let doe = (z - era * 146097.to_int64()).to_int()
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era.to_int() * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let day = doy - (153 * mp + 2) / 5 + 1
  let month = mp + (if mp < 10 { 3 } else { -9 })
  let year = y + (if month <= 2 { 1 } else { 0 })
  let hour = sec_of_day / 3600
  let minute = (sec_of_day % 3600) / 60
  let second = sec_of_day % 60
  let rest = pad2(month) + pad2(day) + pad2(hour) + pad2(minute) + pad2(second) + "Z"
  if year >= 1950 && year <= 2049 {
    der_tag(0x17, (pad2(year % 100) + rest).to_bytes())
  } else {
    der_tag(0x18, (pad4(year) + rest).to_bytes())
  }
}

pub fn strip_leading_zeros(buf : Bytes) -> Bytes {
  if buf.length() == 0 {
    return buf
  }
  let mut i = 0
  while i < buf.length() - 1 && (buf[i].to_int() & 0xFF) == 0 {
    i = i + 1
  }
  sub_bytes(buf, i, buf.length())
}

/// Compute 32-byte Android TV Remote v2 pairing secret hash:
/// SHA-256(clientModulus || clientExponent || serverModulus || serverExponent || pinSuffix).
pub fn compute_pairing_secret_hash(
  client_modulus : Bytes,
  client_exponent : Bytes,
  server_modulus : Bytes,
  server_exponent : Bytes,
  pin_suffix : Bytes,
) -> Bytes {
  let combined = concat_bytes([
    strip_leading_zeros(client_modulus),
    strip_leading_zeros(client_exponent),
    strip_leading_zeros(server_modulus),
    strip_leading_zeros(server_exponent),
    pin_suffix,
  ])
  crypto::sha256(combined)
}

/// Verify a 6-character hex TV pairing PIN against the expected hash (`hash[0] == pin_bytes[0]`).
pub fn verify_atv_pairing_pin(
  pin : String,
  client_modulus : Bytes,
  client_exponent : Bytes,
  server_modulus : Bytes,
  server_exponent : Bytes,
) -> Result[Bytes, String] {
  let clean = trim_ascii(pin)
  let raw = clean.to_bytes()
  if raw.length() != 6 {
    return Err("pairing code must be 6 hexadecimal characters")
  }
  let pin_bytes = match base_codec::hex_decode(clean) {
    Some(b) => b
    None => return Err("pairing code must be 6 hexadecimal characters")
  }
  if pin_bytes.length() != 3 {
    return Err("pairing code must be 6 hexadecimal characters")
  }
  let suffix = sub_bytes(pin_bytes, 1, 3)
  let hash = compute_pairing_secret_hash(client_modulus, client_exponent, server_modulus, server_exponent, suffix)
  if hash.length() == 0 || hash[0] != pin_bytes[0] {
    return Err("pairing code does not match; check the 6-character code on the TV")
  }
  Ok(hash)
}

// ── mDNS Discovery (`discovery.ts`) ──

pub let MDNS_SVC_REMOTE : String = "_androidtvremote2._tcp.local"
pub let MDNS_SVC_ADB_CONNECT : String = "_adb-tls-connect._tcp.local"
pub let MDNS_SVC_ADB_PAIR : String = "_adb-tls-pairing._tcp.local"

fn encode_dns_name(name : String) -> Bytes {
  let parts = split_by_byte(name, 0x2E)
  let chunks : Array[Bytes] = []
  let mut i = 0
  while i < parts.length() {
    if parts[i] != "" {
      let b = parts[i].to_bytes()
      let len_b = Bytes::new(1)
      len_b[0] = (b.length() & 0xFF).to_byte()
      chunks.push(len_b)
      chunks.push(b)
    }
    i = i + 1
  }
  chunks.push(Bytes::new(1)) // terminating 0 byte
  concat_bytes(chunks)
}

/// Build an mDNS PTR query packet with QU bit (`0x8001`).
pub fn build_mdns_query(services : Array[String]) -> Bytes {
  let header = Bytes::new(12)
  header[4] = ((services.length() >> 8) & 0xFF).to_byte()
  header[5] = (services.length() & 0xFF).to_byte()
  let parts : Array[Bytes] = [header]
  let mut i = 0
  while i < services.length() {
    parts.push(encode_dns_name(services[i]))
    let tail = Bytes::new(4)
    tail[0] = 0x00.to_byte()
    tail[1] = 0x0C.to_byte() // TYPE_PTR (12)
    tail[2] = 0x80.to_byte() // Class IN + QU bit
    tail[3] = 0x01.to_byte()
    parts.push(tail)
    i = i + 1
  }
  concat_bytes(parts)
}

fn read_u16_be(buf : Bytes, off : Int) -> Int {
  ((buf[off].to_int() & 0xFF) << 8) | (buf[off + 1].to_int() & 0xFF)
}

fn read_dns_name(buf : Bytes, offset : Int, depth : Int) -> Option[(String, Int)] {
  if depth > 16 || offset < 0 || offset >= buf.length() {
    return None
  }
  let labels : Array[String] = []
  let mut pos = offset
  let mut jumped = false
  let mut end_pos = offset
  while pos < buf.length() {
    let len = buf[pos].to_int() & 0xFF
    if len == 0 {
      if !jumped {
        end_pos = pos + 1
      }
      break
    }
    if (len & 0xC0) == 0xC0 {
      if pos + 1 >= buf.length() {
        return None
      }
      let ptr = ((len & 0x3F) << 8) | (buf[pos + 1].to_int() & 0xFF)
      if !jumped {
        end_pos = pos + 2
        jumped = true
      }
      match read_dns_name(buf, ptr, depth + 1) {
        Some((sub_name, _)) => {
          if sub_name != "" {
            labels.push(sub_name)
          }
          break
        }
        None => return None
      }
    }
    pos = pos + 1
    if pos + len > buf.length() {
      return None
    }
    labels.push(slice_bytes_str(buf, pos, pos + len))
    pos = pos + len
    if !jumped {
      end_pos = pos
    }
  }
  Some((join_strings(labels, "."), end_pos))
}

pub struct ParsedMdnsRecords {
  pub ptrs : Array[(String, String)] // (service, instance)
  pub srvs : Array[(String, String, Int)] // (instance, host, port)
  pub txts : Array[(String, Array[(String, String)])] // (instance, kv)
  pub as_recs : Array[(String, String)] // (host, ipv4)
}

pub fn parse_mdns_packet(buf : Bytes) -> ParsedMdnsRecords {
  let ptrs : Array[(String, String)] = []
  let srvs : Array[(String, String, Int)] = []
  let txts : Array[(String, Array[(String, String)])] = []
  let as_recs : Array[(String, String)] = []
  if buf.length() < 12 {
    return ParsedMdnsRecords::{ ptrs, srvs, txts, as_recs }
  }
  let qd_count = read_u16_be(buf, 4)
  let an_count = read_u16_be(buf, 6)
  let ns_count = read_u16_be(buf, 8)
  let ar_count = read_u16_be(buf, 10)
  let mut pos = 12
  let mut q = 0
  while q < qd_count {
    match read_dns_name(buf, pos, 0) {
      Some((_, next)) => {
        if next + 4 > buf.length() {
          return ParsedMdnsRecords::{ ptrs, srvs, txts, as_recs }
        }
        pos = next + 4
      }
      None => return ParsedMdnsRecords::{ ptrs, srvs, txts, as_recs }
    }
    q = q + 1
  }
  let total_rr = an_count + ns_count + ar_count
  let mut r = 0
  while r < total_rr {
    let (rn_name, next_pos) = match read_dns_name(buf, pos, 0) {
      Some(v) => v
      None => break
    }
    if next_pos + 10 > buf.length() {
      break
    }
    pos = next_pos
    let rtype = read_u16_be(buf, pos)
    let rd_len = read_u16_be(buf, pos + 8)
    pos = pos + 10
    if pos + rd_len > buf.length() {
      break
    }
    let rdata_end = pos + rd_len
    if rtype == 12 {
      // PTR
      match read_dns_name(buf, pos, 0) {
        Some((target, _)) => ptrs.push((to_ascii_lower(rn_name), target))
        None => ()
      }
    } else if rtype == 33 && rd_len >= 6 {
      // SRV
      let port = read_u16_be(buf, pos + 4)
      match read_dns_name(buf, pos + 6, 0) {
        Some((target, _)) => srvs.push((rn_name, to_ascii_lower(target), port))
        None => ()
      }
    } else if rtype == 16 {
      // TXT
      let kv : Array[(String, String)] = []
      let mut p = pos
      while p < rdata_end {
        let l = buf[p].to_int() & 0xFF
        p = p + 1
        if p + l > rdata_end {
          break
        }
        let entry = slice_bytes_str(buf, p, p + l)
        p = p + l
        let eq = find_substr(entry, "=", 0)
        if eq > 0 {
          let eb = entry.to_bytes()
          kv.push((to_ascii_lower(slice_bytes_str(eb, 0, eq)), slice_bytes_str(eb, eq + 1, eb.length())))
        }
      }
      txts.push((rn_name, kv))
    } else if rtype == 1 && rd_len == 4 {
      // A
      let ip = (buf[pos].to_int() & 0xFF).to_string() +
      "." +
      (buf[pos + 1].to_int() & 0xFF).to_string() +
      "." +
      (buf[pos + 2].to_int() & 0xFF).to_string() +
      "." +
      (buf[pos + 3].to_int() & 0xFF).to_string()
      as_recs.push((to_ascii_lower(rn_name), ip))
    }
    pos = rdata_end
    r = r + 1
  }
  ParsedMdnsRecords::{ ptrs, srvs, txts, as_recs }
}

pub struct ParsedHostSpec {
  pub host : String
  pub explicit_port : Option[Int]
}

pub fn parse_host_spec(spec : String) -> ParsedHostSpec {
  let trimmed = trim_ascii(spec)
  let raw = trimmed.to_bytes()
  if raw.length() > 0 && (raw[0].to_int() & 0xFF) == 0x5B {
    let close_br = find_substr(trimmed, "]", 1)
    if close_br > 1 {
      let host = slice_bytes_str(raw, 1, close_br)
      if close_br + 1 < raw.length() && (raw[close_br + 1].to_int() & 0xFF) == 0x3A {
        match parse_uint_decimal(slice_bytes_str(raw, close_br + 2, raw.length())) {
          Some(p) => {
            if p >= 1 && p <= 65535 {
              return ParsedHostSpec::{ host, explicit_port: Some(p) }
            }
          }
          None => ()
        }
      }
      return ParsedHostSpec::{ host, explicit_port: None }
    }
  }
  let first_colon = find_substr(trimmed, ":", 0)
  if first_colon > 0 {
    let second_colon = find_substr(trimmed, ":", first_colon + 1)
    if second_colon < 0 {
      match parse_uint_decimal(slice_bytes_str(raw, first_colon + 1, raw.length())) {
        Some(p) => {
          if p >= 1 && p <= 65535 {
            return ParsedHostSpec::{ host: slice_bytes_str(raw, 0, first_colon), explicit_port: Some(p) }
          }
        }
        None => ()
      }
    }
  }
  ParsedHostSpec::{ host: trimmed, explicit_port: None }
}

// ── ADB Client helpers (`adb-client.ts`) ──

pub struct PngDimensions {
  pub width : Int
  pub height : Int
}

pub fn parse_png_dimensions(png : Bytes) -> Result[PngDimensions, String] {
  if png.length() < 24 {
    return Err("screencap did not return a valid PNG image")
  }
  if (png[0].to_int() & 0xFF) != 0x89 ||
  (png[1].to_int() & 0xFF) != 0x50 ||
  (png[2].to_int() & 0xFF) != 0x4E ||
  (png[3].to_int() & 0xFF) != 0x47 ||
  (png[4].to_int() & 0xFF) != 0x0D ||
  (png[5].to_int() & 0xFF) != 0x0A ||
  (png[6].to_int() & 0xFF) != 0x1A ||
  (png[7].to_int() & 0xFF) != 0x0A {
    return Err("screencap did not return a valid PNG image")
  }
  if slice_bytes_str(png, 12, 16) != "IHDR" {
    return Err("PNG missing IHDR header")
  }
  let w = ((png[16].to_int() & 0xFF) << 24) |
  ((png[17].to_int() & 0xFF) << 16) |
  ((png[18].to_int() & 0xFF) << 8) |
  (png[19].to_int() & 0xFF)
  let h = ((png[20].to_int() & 0xFF) << 24) |
  ((png[21].to_int() & 0xFF) << 16) |
  ((png[22].to_int() & 0xFF) << 8) |
  (png[23].to_int() & 0xFF)
  if w <= 0 || h <= 0 || w > 16384 || h > 16384 {
    return Err("invalid PNG dimensions")
  }
  Ok(PngDimensions::{ width: w, height: h })
}

/// Safely single-quote an argument for Android `/system/bin/sh -c`; rejects ASCII control chars.
pub fn quote_android_shell_arg(s : String) -> Result[String, String] {
  if has_ascii_ctrl(s) {
    return Err("shell argument contains unsupported control characters")
  }
  let raw = s.to_bytes()
  let out = StringBuilder::new()
  out.write_char('\'')
  let mut i = 0
  while i < raw.length() {
    let b = raw[i].to_int() & 0xFF
    if b == 0x27 {
      out.write_string("'\\''")
    } else {
      out.write_byte((b).to_byte())
    }
    i = i + 1
  }
  out.write_char('\'')
  Ok(out.to_string())
}

/// Escape text safely for `adb shell input text <escaped>`.
pub fn escape_adb_input_text(text : String) -> Result[String, String] {
  let raw = text.to_bytes()
  let out = StringBuilder::new()
  let mut i = 0
  while i < raw.length() {
    let b = raw[i].to_int() & 0xFF
    if (b < 0x20 && b != 0x09 && b != 0x0A && b != 0x0D) || b == 0x7F {
      return Err("keyboard text contains unsupported control characters")
    }
    if b == 0x0D {
      if i + 1 < raw.length() && (raw[i + 1].to_int() & 0xFF) == 0x0A {
        i = i + 1
      }
      out.write_string("%s")
    } else if b == 0x0A || b == 0x09 || b == 0x20 {
      out.write_string("%s")
    } else if b == 0x5C {
      out.write_string("\\\\")
    } else if b == 0x22 ||
    b == 0x27 ||
    b == 0x60 ||
    b == 0x24 ||
    b == 0x26 ||
    b == 0x7C ||
    b == 0x3B ||
    b == 0x3C ||
    b == 0x3E ||
    b == 0x28 ||
    b == 0x29 ||
    b == 0x5B ||
    b == 0x5D ||
    b == 0x7B ||
    b == 0x7D ||
    b == 0x2A ||
    b == 0x3F ||
    b == 0x21 ||
    b == 0x23 ||
    b == 0x7E ||
    b == 0x5E {
      out.write_char('\\')
      out.write_byte((b).to_byte())
    } else {
      out.write_byte((b).to_byte())
    }
    i = i + 1
  }
  Ok(out.to_string())
}

// ── AndroidTvPairingManager & Control Routing (`pairing.ts`, `adapter.ts`, `server.ts`) ──

pub struct AndroidTvError {
  pub code : String
  pub message : String
}

pub fn is_android_tv_protocol(p : String) -> Bool {
  p == "atv_remote" || p == "adb"
}

pub fn is_android_tv_control_action(action : String) -> Bool {
  action == "status" ||
  action == "power" ||
  action == "remote" ||
  action == "apps" ||
  action == "launch" ||
  action == "playing" ||
  action == "volume" ||
  action == "keyboard" ||
  action == "play_url" ||
  action == "screenshot"
}

pub fn android_tv_error_http_status(code : String) -> Int {
  if code == "invalid_params" || code == "unknown_action" {
    400
  } else if code == "auth_failed" || code == "adb_unauthorized" {
    401
  } else if code == "device_not_found" {
    404
  } else if code == "payload_too_large" {
    413
  } else if code == "not_supported" {
    422
  } else if code == "adb_missing" {
    503
  } else {
    502
  }
}

pub fn validate_android_tv_action(action : String) -> Result[String, AndroidTvError] {
  let trimmed = trim_ascii(action)
  if trimmed == "screenshot" {
    return Err(AndroidTvError::{
      code: "invalid_params",
      message: "screenshot is not allowed on /action; call POST /screenshot",
    })
  }
  if !is_android_tv_control_action(trimmed) {
    return Err(AndroidTvError::{ code: "unknown_action", message: "unsupported action: " + trimmed })
  }
  Ok(trimmed)
}

pub enum AtvControlBackend {
  UseRemote
  UseAdb
}

/// Select whether an Android TV action routes to Remote v2 or isolated ADB (`adapter.ts`).
pub fn select_android_tv_backend(
  action : String,
  app_arg : Option[String],
  has_remote : Bool,
  has_adb : Bool,
) -> Result[AtvControlBackend, AndroidTvError] {
  if action == "apps" || action == "playing" || action == "screenshot" {
    if !has_adb {
      return Err(AndroidTvError::{
        code: "not_supported",
        message: "action '" + action + "' requires ADB protocol on this Android TV",
      })
    }
    return Ok(AtvControlBackend::UseAdb)
  }
  if action == "launch" {
    match app_arg {
      Some(app) => {
        let is_url = find_substr(app, "://", 0) > 0
        if !is_url && has_adb {
          return Ok(AtvControlBackend::UseAdb)
        }
      }
      None => ()
    }
  }
  if has_remote {
    return Ok(AtvControlBackend::UseRemote)
  }
  if has_adb {
    return Ok(AtvControlBackend::UseAdb)
  }
  Err(AndroidTvError::{
    code: "auth_failed",
    message: "Android TV has no paired protocols (pair atv_remote or adb first)",
  })
}

pub struct AtvPairStep {
  pub pair_id : String
  pub done : Bool
  pub step : Int
  pub total : Int
  pub protocol : Option[String]
  pub paired_protocols : Array[String]
  pub model : Option[String]
}

struct AtvPairSession {
  pair_id : String
  ws : String
  identifier : String
  address : Option[String]
  name : Option[String]
  protocols : Array[String]
  pair_port : Option[Int]
  adb_port : Option[Int]
  adb_mode : Option[String]
  mut index : Int
  mut pair_token : Option[String]
  mut device_provides_pin : Bool
  mut paired_protocols : Array[String]
  mut model : Option[String]
  mut remote_cred_json : Option[String]
  mut adb_cred_json : Option[String]
  mut completed : Bool
  mut expires_at_ms : Int64
}

pub struct CompletedAndroidTvPairing {
  pub identifier : String
  pub address : Option[String]
  pub name : Option[String]
  pub model : Option[String]
  pub protocols : Array[String]
  pub credentials_json : String
  pub has_credentials : Bool
}

pub struct AndroidTvPairingManager {
  ttl_ms : Int64
  mut sessions : Array[AtvPairSession]
  mut next_id : Int
}

pub fn AndroidTvPairingManager::new(ttl_ms : Int64) -> AndroidTvPairingManager {
  AndroidTvPairingManager::{
    ttl_ms: if ttl_ms > 0.to_int64() { ttl_ms } else { 300000.to_int64() },
    sessions: [],
    next_id: 1,
  }
}

pub fn AndroidTvPairingManager::start(
  self : AndroidTvPairingManager,
  ws : String,
  identifier : String,
  raw_protocols : Array[String],
  first_token : Option[String],
  now_ms : Int64,
) -> Result[AtvPairStep, AndroidTvError] {
  self.start_with_meta(
    ws,
    identifier,
    None,
    None,
    None,
    raw_protocols,
    None,
    None,
    None,
    first_token,
    true,
    now_ms,
  )
}

pub fn AndroidTvPairingManager::start_with_meta(
  self : AndroidTvPairingManager,
  ws : String,
  identifier : String,
  address : Option[String],
  name : Option[String],
  model : Option[String],
  raw_protocols : Array[String],
  pair_port : Option[Int],
  adb_port : Option[Int],
  adb_mode : Option[String],
  first_token : Option[String],
  device_provides_pin : Bool,
  now_ms : Int64,
) -> Result[AtvPairStep, AndroidTvError] {
  let id_trim = trim_ascii(identifier)
  if id_trim == "" {
    return Err(AndroidTvError::{ code: "invalid_params", message: "identifier is required" })
  }
  let protocols : Array[String] = []
  let mut i = 0
  while i < raw_protocols.length() {
    let p = raw_protocols[i]
    if is_android_tv_protocol(p) && !array_contains_str(protocols, p) {
      protocols.push(p)
    }
    i = i + 1
  }
  let pair_id = "atv_" + self.next_id.to_string()
  self.next_id = self.next_id + 1
  if protocols.length() == 0 {
    self.sessions.push(AtvPairSession::{
      pair_id,
      ws,
      identifier: id_trim,
      address,
      name,
      protocols: [],
      pair_port,
      adb_port,
      adb_mode,
      index: 0,
      pair_token: None,
      device_provides_pin: false,
      paired_protocols: [],
      model,
      remote_cred_json: None,
      adb_cred_json: None,
      completed: true,
      expires_at_ms: now_ms + self.ttl_ms,
    })
    return Ok(AtvPairStep::{
      pair_id,
      done: true,
      step: 0,
      total: 0,
      protocol: None,
      paired_protocols: [],
      model,
    })
  }
  let first = protocols[0]
  self.sessions.push(AtvPairSession::{
    pair_id,
    ws,
    identifier: id_trim,
    address,
    name,
    protocols,
    pair_port,
    adb_port,
    adb_mode,
    index: 0,
    pair_token: first_token,
    device_provides_pin,
    paired_protocols: [],
    model,
    remote_cred_json: None,
    adb_cred_json: None,
    completed: false,
    expires_at_ms: now_ms + self.ttl_ms,
  })
  Ok(AtvPairStep::{
    pair_id,
    done: false,
    step: 1,
    total: protocols.length(),
    protocol: Some(first),
    paired_protocols: [],
    model,
  })
}

/// Record credentials JSON (`atv_remote` or `adb` sub-object) for the active protocol step.
pub fn AndroidTvPairingManager::record_step_credentials(
  self : AndroidTvPairingManager,
  ws : String,
  pair_id : String,
  protocol : String,
  cred_json : String,
) -> Bool {
  let mut i = 0
  while i < self.sessions.length() {
    let s = self.sessions[i]
    if s.pair_id == pair_id && s.ws == ws {
      if protocol == "atv_remote" {
        s.remote_cred_json = Some(cred_json)
        return true
      } else if protocol == "adb" {
        s.adb_cred_json = Some(cred_json)
        return true
      }
      return false
    }
    i = i + 1
  }
  false
}

fn atv_session_credentials_json(s : AtvPairSession) -> (String, Bool) {
  let fields : Array[(String, base_codec::Json)] = []
  match s.remote_cred_json {
    Some(rj) => {
      match base_codec::json_parse(rj) {
        base_codec::JsonParseResult::Ok(v) => fields.push(("atv_remote", v))
        base_codec::JsonParseResult::Err(_) => fields.push(("atv_remote", base_codec::json_str(rj)))
      }
    }
    None => ()
  }
  match s.adb_cred_json {
    Some(aj) => {
      match base_codec::json_parse(aj) {
        base_codec::JsonParseResult::Ok(v) => fields.push(("adb", v))
        base_codec::JsonParseResult::Err(_) => fields.push(("adb", base_codec::json_str(aj)))
      }
    }
    None => ()
  }
  (base_codec::json_stringify(base_codec::json_obj(fields)), fields.length() > 0)
}

pub fn AndroidTvPairingManager::peek_credentials(
  self : AndroidTvPairingManager,
  ws : String,
  pair_id : String,
) -> Option[CompletedAndroidTvPairing] {
  let mut i = 0
  while i < self.sessions.length() {
    let s = self.sessions[i]
    if s.pair_id == pair_id && s.ws == ws && s.completed {
      let (cj, has_c) = atv_session_credentials_json(s)
      return Some(CompletedAndroidTvPairing::{
        identifier: s.identifier,
        address: s.address,
        name: s.name,
        model: s.model,
        protocols: s.paired_protocols,
        credentials_json: cj,
        has_credentials: has_c,
      })
    }
    i = i + 1
  }
  None
}

pub fn AndroidTvPairingManager::consume_credentials(
  self : AndroidTvPairingManager,
  ws : String,
  pair_id : String,
) -> Bool {
  let kept : Array[AtvPairSession] = []
  let mut removed = false
  let mut i = 0
  while i < self.sessions.length() {
    let s = self.sessions[i]
    if s.pair_id == pair_id && s.ws == ws && s.completed {
      removed = true
    } else {
      kept.push(s)
    }
    i = i + 1
  }
  self.sessions = kept
  removed
}

pub fn AndroidTvPairingManager::cancel(
  self : AndroidTvPairingManager,
  ws : String,
  pair_id : String,
) -> Option[String] {
  let kept : Array[AtvPairSession] = []
  let mut cancelled_token : Option[String] = None
  let mut i = 0
  while i < self.sessions.length() {
    let s = self.sessions[i]
    if s.pair_id == pair_id && s.ws == ws {
      cancelled_token = s.pair_token
    } else {
      kept.push(s)
    }
    i = i + 1
  }
  self.sessions = kept
  cancelled_token
}

pub fn AndroidTvPairingManager::expire_due(self : AndroidTvPairingManager, now_ms : Int64) -> Array[String] {
  let expired_tokens : Array[String] = []
  let kept : Array[AtvPairSession] = []
  let mut i = 0
  while i < self.sessions.length() {
    let s = self.sessions[i]
    if now_ms >= s.expires_at_ms {
      match s.pair_token {
        Some(tok) => expired_tokens.push(tok)
        None => ()
      }
    } else {
      kept.push(s)
    }
    i = i + 1
  }
  self.sessions = kept
  expired_tokens
}

pub fn AndroidTvPairingManager::close_all(self : AndroidTvPairingManager) -> Array[String] {
  let tokens : Array[String] = []
  let mut i = 0
  while i < self.sessions.length() {
    match self.sessions[i].pair_token {
      Some(tok) => tokens.push(tok)
      None => ()
    }
    i = i + 1
  }
  self.sessions = []
  tokens
}

pub fn AndroidTvPairingManager::active_token(
  self : AndroidTvPairingManager,
  ws : String,
  pair_id : String,
) -> Option[String] {
  let mut i = 0
  while i < self.sessions.length() {
    let s = self.sessions[i]
    if s.pair_id == pair_id && s.ws == ws {
      return s.pair_token
    }
    i = i + 1
  }
  None
}

/// Merge newly paired Android TV credentials JSON over existing credentials JSON (preserving other protocol).
pub fn merge_atv_credentials_json(existing_json : Option[String], new_json : String) -> String {
  let merged : Array[(String, base_codec::Json)] = []
  let new_obj = match base_codec::json_parse(new_json) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Obj(m)) => m
    _ => []
  }
  match existing_json {
    Some(ej) => {
      match base_codec::json_parse(ej) {
        base_codec::JsonParseResult::Ok(base_codec::Json::Obj(old_m)) => {
          let mut i = 0
          while i < old_m.length() {
            let (k, v) = old_m[i]
            let mut overridden = false
            let mut j = 0
            while j < new_obj.length() {
              if new_obj[j].0 == k {
                overridden = true
                break
              }
              j = j + 1
            }
            if !overridden {
              merged.push((k, v))
            }
            i = i + 1
          }
        }
        _ => ()
      }
    }
    None => ()
  }
  let mut k = 0
  while k < new_obj.length() {
    merged.push(new_obj[k])
    k = k + 1
  }
  base_codec::json_stringify(base_codec::json_obj(merged))
}

/// Record a failed finish attempt; keeps `pair_token` alive on retryable `invalid_pin` or `adb_unauthorized`.
pub fn AndroidTvPairingManager::on_finish_error(
  self : AndroidTvPairingManager,
  ws : String,
  pair_id : String,
  err_code : String,
) -> Bool {
  let mut i = 0
  while i < self.sessions.length() {
    let s = self.sessions[i]
    if s.pair_id == pair_id && s.ws == ws {
      if err_code != "invalid_pin" && err_code != "adb_unauthorized" {
        s.pair_token = None
      }
      return s.pair_token is Some(_)
    }
    i = i + 1
  }
  false
}

pub fn AndroidTvPairingManager::finish_step(
  self : AndroidTvPairingManager,
  ws : String,
  pair_id : String,
  skip : Bool,
  model : Option[String],
  next_token : Option[String],
  now_ms : Int64,
) -> Result[AtvPairStep, AndroidTvError] {
  let mut idx = -1
  let mut i = 0
  while i < self.sessions.length() {
    if self.sessions[i].pair_id == pair_id && self.sessions[i].ws == ws {
      idx = i
      break
    }
    i = i + 1
  }
  if idx < 0 {
    return Err(AndroidTvError::{ code: "invalid_pair_id", message: "pairing session not found or expired" })
  }
  let s = self.sessions[idx]
  if s.completed {
    return Ok(AtvPairStep::{
      pair_id,
      done: true,
      step: s.protocols.length(),
      total: s.protocols.length(),
      protocol: None,
      paired_protocols: s.paired_protocols,
      model: s.model,
    })
  }
  s.expires_at_ms = now_ms + self.ttl_ms
  let cur_proto = s.protocols[s.index]
  if !skip {
    if !array_contains_str(s.paired_protocols, cur_proto) {
      s.paired_protocols.push(cur_proto)
    }
    if s.model is None {
      s.model = model
    }
  }
  s.index = s.index + 1
  if s.index < s.protocols.length() {
    let next_proto = s.protocols[s.index]
    s.pair_token = next_token
    return Ok(AtvPairStep::{
      pair_id,
      done: false,
      step: s.index + 1,
      total: s.protocols.length(),
      protocol: Some(next_proto),
      paired_protocols: s.paired_protocols,
      model: s.model,
    })
  }
  s.completed = true
  s.pair_token = None
  Ok(AtvPairStep::{
    pair_id,
    done: true,
    step: s.protocols.length(),
    total: s.protocols.length(),
    protocol: None,
    paired_protocols: s.paired_protocols,
    model: s.model,
  })
}

// ── X.509 DER Builders, PEM Codec & RSA Public Key Extractor (`cert.ts`) ──

pub fn der_sequence(items : Array[Bytes]) -> Bytes {
  der_tag(0x30, concat_bytes(items))
}

pub fn der_set(items : Array[Bytes]) -> Bytes {
  der_tag(0x31, concat_bytes(items))
}

pub fn der_integer(buf : Bytes) -> Bytes {
  if buf.length() == 0 {
    let z = Bytes::new(1)
    return der_tag(0x02, z)
  }
  let trimmed = strip_leading_zeros(buf)
  if trimmed.length() > 0 && (trimmed[0].to_int() & 0x80) != 0 {
    let z = Bytes::new(1)
    der_tag(0x02, concat_bytes([z, trimmed]))
  } else {
    der_tag(0x02, trimmed)
  }
}

pub fn der_bit_string(buf : Bytes) -> Bytes {
  let z = Bytes::new(1)
  der_tag(0x03, concat_bytes([z, buf]))
}

pub fn der_oid(oid : Array[Int]) -> Bytes {
  if oid.length() < 2 {
    return der_tag(0x06, Bytes::new(0))
  }
  let out : Array[Byte] = []
  out.push(((oid[0] * 40 + oid[1]) & 0xFF).to_byte())
  let mut i = 2
  while i < oid.length() {
    let mut v = oid[i]
    if v == 0 {
      out.push(0x00.to_byte())
    } else {
      let stack : Array[Int] = []
      while v > 0 {
        stack.push(v & 0x7F)
        v = v >> 7
      }
      let mut j = stack.length() - 1
      while j >= 0 {
        let byte_val = if j == 0 { stack[j] } else { stack[j] | 0x80 }
        out.push((byte_val & 0xFF).to_byte())
        j = j - 1
      }
    }
    i = i + 1
  }
  der_tag(0x06, bytes_from_array(out))
}

pub fn der_utf8(s : String) -> Bytes {
  der_tag(0x0C, s.to_bytes())
}

pub fn der_null() -> Bytes {
  let b = Bytes::new(2)
  b[0] = 0x05.to_byte()
  b[1] = 0x00.to_byte()
  b
}

pub fn der_to_pem(der : Bytes, label : String) -> String {
  let b64 = base_codec::base64_encode(der)
  let raw = b64.to_bytes()
  let sb = StringBuilder::new()
  sb.write_string("-----BEGIN ")
  sb.write_string(label)
  sb.write_string("-----\n")
  let mut i = 0
  while i < raw.length() {
    let end = if i + 64 < raw.length() { i + 64 } else { raw.length() }
    sb.write_string(slice_bytes_str(raw, i, end))
    sb.write_char('\n')
    i = end
  }
  sb.write_string("-----END ")
  sb.write_string(label)
  sb.write_string("-----\n")
  sb.to_string()
}

pub fn pem_to_der(pem : String) -> Option[Bytes] {
  let lines = split_by_byte(pem, 0x0A)
  let sb = StringBuilder::new()
  let mut in_body = false
  let mut i = 0
  while i < lines.length() {
    let line = trim_ascii(lines[i])
    if str_starts_with_ci(line, "-----begin ") {
      in_body = true
    } else if str_starts_with_ci(line, "-----end ") {
      break
    } else if in_body && line != "" {
      sb.write_string(line)
    }
    i = i + 1
  }
  let body = sb.to_string()
  if body == "" {
    None
  } else {
    base_codec::base64_decode(body)
  }
}

/// Build RFC 5280 v3 TBSCertificate DER (`CN=still.fail`, 10-year validity, SHA256withRSA, BasicConstraints CA:FALSE).
pub fn build_atv_tbs_certificate(
  common_name : String,
  spki_der : Bytes,
  serial : Bytes,
  now_ms : Int64,
) -> Bytes {
  let oid_sha256_rsa = [1, 2, 840, 113549, 1, 1, 11]
  let oid_cn = [2, 5, 4, 3]
  let oid_basic_constraints = [2, 5, 29, 19]
  let alg_id = der_sequence([der_oid(oid_sha256_rsa), der_null()])
  let name = der_sequence([der_set([der_sequence([der_oid(oid_cn), der_utf8(common_name)])])])
  let one_day_ms : Int64 = 86400000.to_int64()
  let ten_years_ms : Int64 = 3650.to_int64() * one_day_ms
  let validity = der_sequence([der_x509_time(now_ms - one_day_ms), der_x509_time(now_ms + ten_years_ms)])
  let basic_ext = der_sequence([der_oid(oid_basic_constraints), der_tag(0x04, der_sequence([]))])
  let extensions = der_tag(0xA3, der_sequence([basic_ext]))
  let v3_byte = Bytes::new(1)
  v3_byte[0] = 0x02.to_byte()
  let version = der_tag(0xA0, der_integer(v3_byte))
  der_sequence([version, der_integer(serial), alg_id, name, validity, name, spki_der, extensions])
}

/// Assemble a signed X.509 v3 PEM certificate from `tbs_der` and SHA256withRSA `signature`.
pub fn assemble_signed_x509_cert_pem(tbs_der : Bytes, signature : Bytes) -> String {
  let alg_id = der_sequence([der_oid([1, 2, 840, 113549, 1, 1, 11]), der_null()])
  let cert_der = der_sequence([tbs_der, alg_id, der_bit_string(signature)])
  der_to_pem(cert_der, "CERTIFICATE")
}

/// Lowercase hex SHA-256 fingerprint of a DER X.509 certificate.
pub fn cert_sha256_hex(cert_der : Bytes) -> String {
  crypto::sha256_hex(cert_der)
}

struct DerTlv {
  tag : Int
  content : Bytes
  next : Int
}

fn read_der_tlv(buf : Bytes, offset : Int) -> Result[DerTlv, String] {
  if offset < 0 || offset + 2 > buf.length() {
    return Err("truncated DER TLV")
  }
  let tag = buf[offset].to_int() & 0xFF
  let b1 = buf[offset + 1].to_int() & 0xFF
  let mut pos = offset + 2
  let mut len = 0
  if b1 < 0x80 {
    len = b1
  } else {
    let n_bytes = b1 & 0x7F
    // Cap at 3 length bytes (max 16 MiB) to prevent signed 32-bit Int overflow on 4-byte lengths.
    if n_bytes == 0 || n_bytes > 3 || pos + n_bytes > buf.length() {
      return Err("invalid DER length")
    }
    let mut i = 0
    while i < n_bytes {
      len = (len << 8) | (buf[pos + i].to_int() & 0xFF)
      i = i + 1
    }
    pos = pos + n_bytes
  }
  if len < 0 || pos + len > buf.length() {
    return Err("DER content exceeds buffer")
  }
  Ok(DerTlv::{ tag, content: sub_bytes(buf, pos, pos + len), next: pos + len })
}

/// Extract unsigned big-endian RSA `(modulus, exponent)` bytes directly from a DER X.509 certificate.
pub fn extract_rsa_modulus_exponent_from_cert_der(cert_der : Bytes) -> Result[(Bytes, Bytes), String] {
  let outer = match read_der_tlv(cert_der, 0) {
    Ok(t) => if t.tag == 0x30 { t } else { return Err("certificate is not a DER SEQUENCE") }
    Err(e) => return Err(e)
  }
  let tbs = match read_der_tlv(outer.content, 0) {
    Ok(t) => if t.tag == 0x30 { t } else { return Err("TBSCertificate is not a DER SEQUENCE") }
    Err(e) => return Err(e)
  }
  // Walk TBSCertificate: [0] version (optional), serialNumber, signature, issuer, validity, subject, subjectPublicKeyInfo
  let mut pos = 0
  let first = match read_der_tlv(tbs.content, pos) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if first.tag == 0xA0 {
    pos = first.next
  }
  // Skip serialNumber, signature, issuer, validity, subject (5 elements)
  let mut skip = 0
  while skip < 5 {
    let el = match read_der_tlv(tbs.content, pos) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    pos = el.next
    skip = skip + 1
  }
  let spki = match read_der_tlv(tbs.content, pos) {
    Ok(t) => if t.tag == 0x30 { t } else { return Err("SubjectPublicKeyInfo is not a DER SEQUENCE") }
    Err(e) => return Err(e)
  }
  // SPKI: algorithm SEQUENCE, subjectPublicKey BIT STRING
  let alg = match read_der_tlv(spki.content, 0) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let pub_bits = match read_der_tlv(spki.content, alg.next) {
    Ok(t) => if t.tag == 0x03 && t.content.length() > 1 { t } else { return Err("invalid SubjectPublicKey BIT STRING") }
    Err(e) => return Err(e)
  }
  // Strip unused-bits leading byte (0x00)
  let rsa_der = sub_bytes(pub_bits.content, 1, pub_bits.content.length())
  let rsa_seq = match read_der_tlv(rsa_der, 0) {
    Ok(t) => if t.tag == 0x30 { t } else { return Err("RSAPublicKey is not a DER SEQUENCE") }
    Err(e) => return Err(e)
  }
  let n_tlv = match read_der_tlv(rsa_seq.content, 0) {
    Ok(t) => if t.tag == 0x02 { t } else { return Err("RSA modulus is not a DER INTEGER") }
    Err(e) => return Err(e)
  }
  let e_tlv = match read_der_tlv(rsa_seq.content, n_tlv.next) {
    Ok(t) => if t.tag == 0x02 { t } else { return Err("RSA exponent is not a DER INTEGER") }
    Err(e) => return Err(e)
  }
  Ok((strip_leading_zeros(n_tlv.content), strip_leading_zeros(e_tlv.content)))
}

// ── mDNS Record Merger & Host Probe Candidate Builder (`discovery.ts`) ──

pub struct AndroidTvCandidateProtocol {
  pub protocol : String
  pub pairing : String
  pub port : Option[Int]
  pub pair_port : Option[Int]
  pub adb_mode : Option[String]
}

pub struct AndroidTvCandidate {
  pub identifier : String
  pub name : String
  pub address : String
  pub model : String
  pub remote_port : Option[Int]
  pub adb_port : Option[Int]
  pub adb_pair_port : Option[Int]
  pub protocols : Array[AndroidTvCandidateProtocol]
  pub already_added : Bool
}

pub struct AndroidTvEnvStatus {
  pub ready : Bool
  pub adb_available : Bool
}

pub fn infer_mdns_service(instance : String) -> Option[String] {
  let low = to_ascii_lower(instance)
  let svcs = [MDNS_SVC_REMOTE, MDNS_SVC_ADB_CONNECT, MDNS_SVC_ADB_PAIR]
  let mut i = 0
  while i < svcs.length() {
    let suffix = "." + svcs[i]
    let lb = low.to_bytes()
    let sb = suffix.to_bytes()
    if lb.length() >= sb.length() && slice_bytes_str(lb, lb.length() - sb.length(), lb.length()) == suffix {
      return Some(svcs[i])
    }
    i = i + 1
  }
  None
}

pub fn instance_display_name(instance : String) -> String {
  let dot = find_substr(instance, "._", 0)
  if dot > 0 {
    slice_bytes_str(instance.to_bytes(), 0, dot)
  } else {
    instance
  }
}

fn txt_kv_get(kvs : Array[(String, String)], key : String) -> Option[String] {
  let mut i = 0
  while i < kvs.length() {
    if kvs[i].0 == key {
      return Some(kvs[i].1)
    }
    i = i + 1
  }
  None
}

struct MergedMdnsHost {
  ip : String
  mut name : Option[String]
  mut model : Option[String]
  mut remote_port : Option[Int]
  mut adb_port : Option[Int]
  mut adb_pair_port : Option[Int]
}

/// Merge accumulated mDNS DNS-SD packets across `_androidtvremote2`, `_adb-tls-connect`,
/// and `_adb-tls-pairing` into unified per-IP `AndroidTvCandidate` entries (`discovery.ts:157-238`).
pub fn merge_mdns_records(packets : Array[ParsedMdnsRecords]) -> Array[AndroidTvCandidate] {
  let ptr_map : Map[String, String] = Map::new()
  let srv_map : Map[String, (String, Int)] = Map::new()
  let txt_map : Map[String, Array[(String, String)]] = Map::new()
  let a_map : Map[String, String] = Map::new()
  let srv_order : Array[String] = []

  let mut p_idx = 0
  while p_idx < packets.length() {
    let pkt = packets[p_idx]
    let mut i = 0
    while i < pkt.ptrs.length() {
      let (svc, inst) = pkt.ptrs[i]
      ptr_map.set(inst, svc)
      i = i + 1
    }
    let mut j = 0
    while j < pkt.srvs.length() {
      let (inst, host, port) = pkt.srvs[j]
      if srv_map.get(inst) is None {
        srv_order.push(inst)
      }
      srv_map.set(inst, (host, port))
      j = j + 1
    }
    let mut k = 0
    while k < pkt.txts.length() {
      let (inst, kvs) = pkt.txts[k]
      let merged_kv : Array[(String, String)] = match txt_map.get(inst) {
        Some(prev) => prev
        None => []
      }
      let mut m = 0
      while m < kvs.length() {
        merged_kv.push(kvs[m])
        m = m + 1
      }
      txt_map.set(inst, merged_kv)
      k = k + 1
    }
    let mut a = 0
    while a < pkt.as_recs.length() {
      let (host, ip) = pkt.as_recs[a]
      a_map.set(host, ip)
      a = a + 1
    }
    p_idx = p_idx + 1
  }

  let by_ip : Map[String, MergedMdnsHost] = Map::new()
  let ip_order : Array[String] = []
  let mut s_idx = 0
  while s_idx < srv_order.length() {
    let inst = srv_order[s_idx]
    match srv_map.get(inst) {
      Some((host, port)) => {
        match a_map.get(host) {
          Some(ip) => {
            let svc_opt = match ptr_map.get(inst) {
              Some(svc) => Some(svc)
              None => infer_mdns_service(inst)
            }
            match svc_opt {
              Some(svc) => {
                let entry = match by_ip.get(ip) {
                  Some(e) => e
                  None => {
                    let ne = MergedMdnsHost::{
                      ip,
                      name: None,
                      model: None,
                      remote_port: None,
                      adb_port: None,
                      adb_pair_port: None,
                    }
                    by_ip.set(ip, ne)
                    ip_order.push(ip)
                    ne
                  }
                }
                let txt = match txt_map.get(inst) {
                  Some(kv) => kv
                  None => []
                }
                let label = match txt_kv_get(txt, "name") {
                  Some(v) => if v != "" { v } else { instance_display_name(inst) }
                  None => {
                    match txt_kv_get(txt, "fn") {
                      Some(v) => if v != "" { v } else { instance_display_name(inst) }
                      None => instance_display_name(inst)
                    }
                  }
                }
                if svc == MDNS_SVC_REMOTE {
                  entry.remote_port = Some(port)
                  if label != "" {
                    entry.name = Some(label)
                  }
                  match txt_kv_get(txt, "md") {
                    Some(v) => if v != "" { entry.model = Some(v) }
                    None => {
                      match txt_kv_get(txt, "model") {
                        Some(v) => if v != "" { entry.model = Some(v) }
                        None => ()
                      }
                    }
                  }
                } else if svc == MDNS_SVC_ADB_CONNECT {
                  entry.adb_port = Some(port)
                  if entry.name is None && label != "" {
                    entry.name = Some(label)
                  }
                  match txt_kv_get(txt, "name") {
                    Some(v) => if entry.model is None && v != "" { entry.model = Some(v) }
                    None => ()
                  }
                } else if svc == MDNS_SVC_ADB_PAIR {
                  entry.adb_pair_port = Some(port)
                  if entry.name is None && label != "" {
                    entry.name = Some(label)
                  }
                }
              }
              None => ()
            }
          }
          None => ()
        }
      }
      None => ()
    }
    s_idx = s_idx + 1
  }

  let out : Array[AndroidTvCandidate] = []
  let mut idx = 0
  while idx < ip_order.length() {
    match by_ip.get(ip_order[idx]) {
      Some(m) => {
        let protos : Array[AndroidTvCandidateProtocol] = []
        match m.remote_port {
          Some(rp) => {
            protos.push(AndroidTvCandidateProtocol::{
              protocol: "atv_remote",
              pairing: "mandatory",
              port: Some(rp),
              pair_port: Some(6467),
              adb_mode: None,
            })
          }
          None => ()
        }
        if m.adb_port is Some(_) || m.adb_pair_port is Some(_) {
          protos.push(AndroidTvCandidateProtocol::{
            protocol: "adb",
            pairing: if m.adb_pair_port is Some(_) { "mandatory" } else { "optional" },
            port: m.adb_port,
            pair_port: m.adb_pair_port,
            adb_mode: Some("tls_wireless"),
          })
        }
        if protos.length() > 0 {
          let cname = match m.name {
            Some(n) => n
            None => "Android TV (" + m.ip + ")"
          }
          let cmodel = match m.model {
            Some(md) => md
            None => "Android TV"
          }
          out.push(AndroidTvCandidate::{
            identifier: m.ip,
            name: cname,
            address: m.ip,
            model: cmodel,
            remote_port: m.remote_port,
            adb_port: m.adb_port,
            adb_pair_port: m.adb_pair_port,
            protocols: protos,
            already_added: false,
          })
        }
      }
      None => ()
    }
    idx = idx + 1
  }
  out
}

/// Build an `AndroidTvCandidate` from active manual IP port probe results (`discovery.ts:285-325`).
pub fn build_probed_atv_candidate(
  host_spec : String,
  has_remote : Bool,
  has_adb : Bool,
  remote_port : Int = 6466,
  remote_pair_port : Int = 6467,
  default_adb_port : Int = 5555,
) -> Option[AndroidTvCandidate] {
  let spec = parse_host_spec(host_spec)
  if spec.host == "" {
    return None
  }
  let adb_port = match spec.explicit_port {
    Some(p) => p
    None => default_adb_port
  }
  let protos : Array[AndroidTvCandidateProtocol] = []
  if has_remote {
    protos.push(AndroidTvCandidateProtocol::{
      protocol: "atv_remote",
      pairing: "mandatory",
      port: Some(remote_port),
      pair_port: Some(remote_pair_port),
      adb_mode: None,
    })
  }
  if has_adb {
    protos.push(AndroidTvCandidateProtocol::{
      protocol: "adb",
      pairing: "optional",
      port: Some(adb_port),
      pair_port: None,
      adb_mode: Some(if adb_port == 5555 { "legacy_tcp" } else { "tls_wireless" }),
    })
  }
  if protos.length() == 0 {
    return None
  }
  let identifier = match spec.explicit_port {
    Some(p) => spec.host + ":" + p.to_string()
    None => spec.host
  }
  Some(AndroidTvCandidate::{
    identifier,
    name: "Android TV (" + spec.host + ")",
    address: spec.host,
    model: "Android TV",
    remote_port: if has_remote { Some(remote_port) } else { None },
    adb_port: if has_adb { Some(adb_port) } else { None },
    adb_pair_port: None,
    protocols: protos,
    already_added: false,
  })
}

pub fn mark_atv_candidates_already_added(
  candidates : Array[AndroidTvCandidate],
  existing_targets : Array[String],
) -> Array[AndroidTvCandidate] {
  let low : Array[String] = []
  let mut t = 0
  while t < existing_targets.length() {
    low.push(to_ascii_lower(existing_targets[t]))
    t = t + 1
  }
  let out : Array[AndroidTvCandidate] = []
  let mut i = 0
  while i < candidates.length() {
    let c = candidates[i]
    let added = array_contains_str(low, to_ascii_lower(c.identifier)) ||
    (c.address != "" && array_contains_str(low, to_ascii_lower(c.address)))
    out.push(AndroidTvCandidate::{
      identifier: c.identifier,
      name: c.name,
      address: c.address,
      model: c.model,
      remote_port: c.remote_port,
      adb_port: c.adb_port,
      adb_pair_port: c.adb_pair_port,
      protocols: c.protocols,
      already_added: added,
    })
    i = i + 1
  }
  out
}

// ── Remote v2 State Machine & Control Frame Builder (`remote-client.ts`) ──

pub fn assert_atv_pairing_ok(
  msg : DecodedPairingMessage,
  expected : PairingMsgKind,
) -> Result[Unit, AndroidTvError] {
  if msg.status != 200 {
    let code = if msg.status == 402 { "invalid_pin" } else { "pair_failed" }
    return Err(AndroidTvError::{ code, message: "TV rejected pairing step with status " + msg.status.to_string() })
  }
  if msg.kind != expected {
    return Err(AndroidTvError::{ code: "pair_failed", message: "unexpected pairing message kind" })
  }
  Ok(())
}

pub struct AtvRemoteState {
  pub mut model : Option[String]
  pub mut vendor : Option[String]
  pub mut powered : Option[Bool]
  pub mut volume_level : Option[Int]
  pub mut volume_max : Option[Int]
  pub mut volume_muted : Option[Bool]
  pub mut ime_field_counter : Int
}

pub fn AtvRemoteState::new() -> AtvRemoteState {
  AtvRemoteState::{
    model: None,
    vendor: None,
    powered: None,
    volume_level: None,
    volume_max: None,
    volume_muted: None,
    ime_field_counter: 0,
  }
}

/// Apply an inbound Remote v2 server message to `state`; returns an optional framed reply
/// (e.g., `RemotePingResponse` for `RemotePingRequest`).
pub fn apply_atv_remote_server_msg(state : AtvRemoteState, msg : DecodedRemoteMessage) -> Option[Bytes] {
  match msg {
    DecodedRemoteMessage::RemotePingRequest(val1) => Some(atv_frame_message(encode_remote_ping_response(val1)))
    DecodedRemoteMessage::RemoteConfigure(_, model, vendor) => {
      if model is Some(_) {
        state.model = model
      }
      if vendor is Some(_) {
        state.vendor = vendor
      }
      None
    }
    DecodedRemoteMessage::RemoteStart(started) => {
      state.powered = Some(started)
      None
    }
    DecodedRemoteMessage::RemoteSetVolumeLevel(lvl, vmax, muted, pm) => {
      state.volume_level = Some(lvl)
      state.volume_max = Some(vmax)
      state.volume_muted = Some(muted)
      if state.model is None && pm is Some(_) {
        state.model = pm
      }
      None
    }
    DecodedRemoteMessage::RemoteImeShowRequest(fc, _) => {
      state.ime_field_counter = fc
      None
    }
    _ => None
  }
}

fn json_num_floor_opt(j : base_codec::Json, key : String) -> Option[Int] {
  match base_codec::json_get(j, key) {
    Some(base_codec::Json::Num(d, _)) => Some(d.floor().to_int())
    _ => None
  }
}

fn json_num_round_opt(j : base_codec::Json, key : String) -> Option[Int] {
  match base_codec::json_get(j, key) {
    Some(base_codec::Json::Num(d, _)) => Some(d.round().to_int())
    _ => None
  }
}

/// Build framed Remote v2 outbound protobuf packets and JSON control result (`remote-client.ts:387-501`).
pub fn build_atv_remote_control_frames(
  state : AtvRemoteState,
  action : String,
  args : base_codec::Json,
) -> Result[(Array[Bytes], base_codec::Json), AndroidTvError] {
  let frames : Array[Bytes] = []
  if action == "status" {
    let fields : Array[(String, base_codec::Json)] = [
      ("online", base_codec::json_bool(true)),
      ("protocol", base_codec::json_str("atv_remote")),
    ]
    match state.model {
      Some(m) => fields.push(("model", base_codec::json_str(m)))
      None => ()
    }
    match state.vendor {
      Some(v) => fields.push(("vendor", base_codec::json_str(v)))
      None => ()
    }
    match state.powered {
      Some(p) => fields.push(("power", base_codec::json_str(if p { "on" } else { "off" })))
      None => ()
    }
    match state.volume_level {
      Some(lvl) => {
        fields.push(("volume", base_codec::json_int(lvl)))
        match state.volume_max {
          Some(mx) => fields.push(("volumeMax", base_codec::json_int(mx)))
          None => ()
        }
        let muted = match state.volume_muted {
          Some(b) => b
          None => false
        }
        fields.push(("muted", base_codec::json_bool(muted)))
      }
      None => ()
    }
    return Ok((frames, base_codec::json_obj(fields)))
  }
  if action == "power" {
    let desired = match json_str_opt(args, "state") {
      Some(s) => to_ascii_lower(trim_ascii(s))
      None => "toggle"
    }
    if desired == "get" {
      let ps = match state.powered {
        Some(true) => "on"
        Some(false) => "off"
        None => "unknown"
      }
      return Ok((frames, base_codec::json_obj([("power", base_codec::json_str(ps))])))
    }
    let key_code = if desired == "on" { 224 } else if desired == "off" { 223 } else { 26 }
    frames.push(atv_frame_message(encode_remote_key_inject(key_code, REMOTE_DIRECTION_SHORT)))
    return Ok((
      frames,
      base_codec::json_obj([
        ("ok", base_codec::json_bool(true)),
        ("action", base_codec::json_str("power")),
        ("state", base_codec::json_str(desired)),
      ]),
    ))
  }
  if action == "remote" {
    let key = match json_str_opt(args, "key") {
      Some(s) => trim_ascii(s)
      None => ""
    }
    let code = match resolve_android_key_code(key) {
      Some(c) => c
      None => return Err(AndroidTvError::{ code: "invalid_params", message: "unsupported remote key: " + key })
    }
    let press = match json_str_opt(args, "press") {
      Some(s) => to_ascii_lower(trim_ascii(s))
      None => "single"
    }
    let rep_raw = match json_num_floor_opt(args, "repeat") {
      Some(n) => n
      None => 1
    }
    let repeat = if rep_raw < 1 { 1 } else if rep_raw > 20 { 20 } else { rep_raw }
    let mut i = 0
    while i < repeat {
      if press == "hold" {
        frames.push(atv_frame_message(encode_remote_key_inject(code, REMOTE_DIRECTION_START_LONG)))
        frames.push(atv_frame_message(encode_remote_key_inject(code, REMOTE_DIRECTION_END_LONG)))
      } else if press == "double" {
        frames.push(atv_frame_message(encode_remote_key_inject(code, REMOTE_DIRECTION_SHORT)))
        frames.push(atv_frame_message(encode_remote_key_inject(code, REMOTE_DIRECTION_SHORT)))
      } else {
        frames.push(atv_frame_message(encode_remote_key_inject(code, REMOTE_DIRECTION_SHORT)))
      }
      i = i + 1
    }
    return Ok((
      frames,
      base_codec::json_obj([
        ("ok", base_codec::json_bool(true)),
        ("key", base_codec::json_str(key)),
        ("keyCode", base_codec::json_int(code)),
        ("press", base_codec::json_str(press)),
        ("repeat", base_codec::json_int(repeat)),
      ]),
    ))
  }
  if action == "launch" {
    let app = match json_str_opt(args, "app") {
      Some(s) => trim_ascii(s)
      None => {
        match json_str_opt(args, "url") {
          Some(u) => trim_ascii(u)
          None => ""
        }
      }
    }
    if app == "" {
      return Err(AndroidTvError::{ code: "invalid_params", message: "launch requires args.app (URL or deep link)" })
    }
    frames.push(atv_frame_message(encode_remote_app_link_launch(app)))
    return Ok((
      frames,
      base_codec::json_obj([("ok", base_codec::json_bool(true)), ("launched", base_codec::json_str(app))]),
    ))
  }
  if action == "play_url" {
    let u = match json_str_opt(args, "url") {
      Some(s) => trim_ascii(s)
      None => ""
    }
    if u == "" {
      return Err(AndroidTvError::{ code: "invalid_params", message: "play_url requires args.url" })
    }
    frames.push(atv_frame_message(encode_remote_app_link_launch(u)))
    return Ok((
      frames,
      base_codec::json_obj([("ok", base_codec::json_bool(true)), ("url", base_codec::json_str(u))]),
    ))
  }
  if action == "volume" {
    let is_mute = match json_bool_opt(args, "mute") {
      Some(true) => true
      _ => {
        match json_str_opt(args, "action") {
          Some(a) => a == "mute"
          None => false
        }
      }
    }
    if is_mute {
      frames.push(atv_frame_message(encode_remote_key_inject(164, REMOTE_DIRECTION_SHORT)))
      return Ok((
        frames,
        base_codec::json_obj([("ok", base_codec::json_bool(true)), ("muted", base_codec::json_bool(true))]),
      ))
    }
    match json_str_opt(args, "action") {
      Some("up") => {
        frames.push(atv_frame_message(encode_remote_key_inject(24, REMOTE_DIRECTION_SHORT)))
        return Ok((
          frames,
          base_codec::json_obj([("ok", base_codec::json_bool(true)), ("direction", base_codec::json_str("up"))]),
        ))
      }
      Some("down") => {
        frames.push(atv_frame_message(encode_remote_key_inject(25, REMOTE_DIRECTION_SHORT)))
        return Ok((
          frames,
          base_codec::json_obj([("ok", base_codec::json_bool(true)), ("direction", base_codec::json_str("down"))]),
        ))
      }
      _ => ()
    }
    match json_num_round_opt(args, "level") {
      Some(raw_lvl) => {
        let target = if raw_lvl < 0 { 0 } else if raw_lvl > 100 { 100 } else { raw_lvl }
        match (state.volume_level, state.volume_max) {
          (Some(cur), Some(vmax)) => {
            if vmax > 0 {
              let target_steps = (target * vmax + 50) / 100
              let diff = target_steps - cur
              let code = if diff >= 0 { 24 } else { 25 }
              let abs_d = if diff >= 0 { diff } else { 0 - diff }
              let steps = if abs_d > 30 { 30 } else { abs_d }
              let mut s = 0
              while s < steps {
                frames.push(atv_frame_message(encode_remote_key_inject(code, REMOTE_DIRECTION_SHORT)))
                s = s + 1
              }
              return Ok((
                frames,
                base_codec::json_obj([
                  ("ok", base_codec::json_bool(true)),
                  ("level", base_codec::json_int(target)),
                  ("stepsSent", base_codec::json_int(steps)),
                ]),
              ))
            }
          }
          _ => ()
        }
        return Err(AndroidTvError::{
          code: "not_supported",
          message: "setting exact volume level requires ADB protocol or TV volume state; use args.action='up'|'down'|'mute'",
        })
      }
      None => ()
    }
    match state.volume_level {
      Some(lvl) => {
        let fields : Array[(String, base_codec::Json)] = [("volume", base_codec::json_int(lvl))]
        match state.volume_max {
          Some(mx) => fields.push(("volumeMax", base_codec::json_int(mx)))
          None => ()
        }
        let muted = match state.volume_muted {
          Some(b) => b
          None => false
        }
        fields.push(("muted", base_codec::json_bool(muted)))
        return Ok((frames, base_codec::json_obj(fields)))
      }
      None => return Ok((frames, base_codec::json_obj([("volume", base_codec::json_null())])))
    }
  }
  if action == "keyboard" {
    let text = match json_str_opt(args, "text") {
      Some(s) => s
      None => ""
    }
    frames.push(atv_frame_message(encode_remote_ime_batch_edit(text, 0, state.ime_field_counter)))
    return Ok((
      frames,
      base_codec::json_obj([("ok", base_codec::json_bool(true)), ("text", base_codec::json_str(text))]),
    ))
  }
  Err(AndroidTvError::{
    code: "not_supported",
    message: "action '" + action + "' requires ADB protocol on Android TV",
  })
}

// ── ADB Validation, Output Parsers & Command Builders (`adb-client.ts`) ──

pub fn validate_wireless_adb_pin(pin : String) -> Result[String, AndroidTvError] {
  let clean = trim_ascii(pin)
  let raw = clean.to_bytes()
  if raw.length() != 6 {
    return Err(AndroidTvError::{ code: "invalid_pin", message: "Android wireless debugging pairing code must be 6 digits" })
  }
  let mut i = 0
  while i < 6 {
    if !is_ascii_digit(raw[i].to_int() & 0xFF) {
      return Err(AndroidTvError::{ code: "invalid_pin", message: "Android wireless debugging pairing code must be 6 digits" })
    }
    i = i + 1
  }
  Ok(clean)
}

pub fn check_adb_connect_output(
  serial : String,
  exit_code : Int,
  stdout : String,
  stderr : String,
) -> Result[Unit, AndroidTvError] {
  let combined = trim_ascii(stdout + "\n" + stderr)
  let low = to_ascii_lower(combined)
  if exit_code != 0 ||
  find_substr(low, "unable to connect", 0) >= 0 ||
  find_substr(low, "failed to connect", 0) >= 0 ||
  find_substr(low, "refused", 0) >= 0 ||
  find_substr(low, "cannot connect", 0) >= 0 {
    let detail = if combined != "" { combined } else { "exit " + exit_code.to_string() }
    return Err(AndroidTvError::{ code: "connect_failed", message: "adb connect " + serial + " failed: " + detail })
  }
  Ok(())
}

pub fn check_adb_state_output(
  serial : String,
  exit_code : Int,
  stdout : String,
  stderr : String,
) -> Result[Unit, AndroidTvError] {
  let combined = trim_ascii(stdout + "\n" + stderr)
  if find_substr(combined, "unauthorized", 0) >= 0 {
    return Err(AndroidTvError::{
      code: "adb_unauthorized",
      message: "TV has not authorized USB/network debugging yet; click 'Always allow' on the TV screen and retry",
    })
  }
  if exit_code != 0 || find_substr(combined, "device", 0) < 0 {
    let detail = if combined != "" { combined } else { "exit " + exit_code.to_string() }
    return Err(AndroidTvError::{ code: "connect_failed", message: "adb device " + serial + " not ready (" + detail + ")" })
  }
  Ok(())
}

fn is_valid_android_pkg_name(s : String) -> Bool {
  let raw = s.to_bytes()
  if raw.length() == 0 {
    return false
  }
  let mut i = 0
  while i < raw.length() {
    let b = raw[i].to_int() & 0xFF
    if !(is_ascii_alnum(b) || b == 0x2E || b == 0x5F) {
      return false
    }
    i = i + 1
  }
  true
}

fn is_uri_with_scheme(s : String) -> Bool {
  let idx = find_substr(s, "://", 0)
  if idx <= 0 {
    return false
  }
  let raw = s.to_bytes()
  let b0 = raw[0].to_int() & 0xFF
  if !((b0 >= 0x41 && b0 <= 0x5A) || (b0 >= 0x61 && b0 <= 0x7A)) {
    return false
  }
  let mut i = 1
  while i < idx {
    let b = raw[i].to_int() & 0xFF
    if !(is_ascii_alnum(b) || b == 0x2B || b == 0x2D || b == 0x2E) {
      return false
    }
    i = i + 1
  }
  true
}

fn parse_uint_from(s : String, start : Int) -> Option[(Int, Int)] {
  let raw = s.to_bytes()
  let mut i = start
  let mut acc = 0
  let mut digits = 0
  while i < raw.length() {
    let b = raw[i].to_int() & 0xFF
    if !is_ascii_digit(b) {
      break
    }
    acc = acc * 10 + (b - 0x30)
    digits = digits + 1
    i = i + 1
  }
  if digits == 0 {
    None
  } else {
    Some((acc, i))
  }
}

/// Parse `cmd media_session volume --stream 3 --get` output -> `(volume, min, max)`.
pub fn parse_adb_volume_dump(dump : String) -> Option[(Int, Int, Int)] {
  let vi = find_substr(dump, "volume is ", 0)
  if vi < 0 {
    return None
  }
  let (vol, next1) = match parse_uint_from(dump, vi + 10) {
    Some(p) => p
    None => return None
  }
  let ri = find_substr(dump, "in range [", next1)
  if ri < 0 {
    return None
  }
  let (vmin, next2) = match parse_uint_from(dump, ri + 10) {
    Some(p) => p
    None => return None
  }
  let di = find_substr(dump, "..", next2)
  if di != next2 {
    return None
  }
  let (vmax, _) = match parse_uint_from(dump, di + 2) {
    Some(p) => p
    None => return None
  }
  Some((vol, vmin, vmax))
}

/// Parse `pm list packages -3` output into `{ "apps": [ { "id": ..., "name": ... } ] }`.
pub fn parse_adb_packages_output(raw : String) -> base_codec::Json {
  let lines = split_by_byte(raw, 0x0A)
  let apps : Array[base_codec::Json] = []
  let mut i = 0
  while i < lines.length() {
    let mut line = trim_ascii(lines[i])
    if str_starts_with_ci(line, "package:") {
      let lb = line.to_bytes()
      line = trim_ascii(slice_bytes_str(lb, 8, lb.length()))
    }
    if line != "" {
      apps.push(base_codec::json_obj([("id", base_codec::json_str(line)), ("name", base_codec::json_str(line))]))
    }
    i = i + 1
  }
  base_codec::json_obj([("apps", base_codec::json_arr(apps))])
}

/// Parse `dumpsys media_session` into `{ playbackState?, description? }`.
pub fn parse_adb_playing_dump(dump : String) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = []
  let si = find_substr(dump, "state=PlaybackState {state=", 0)
  if si >= 0 {
    match parse_uint_from(dump, si + 27) {
      Some((st, _)) => fields.push(("playbackState", base_codec::json_int(st)))
      None => ()
    }
  }
  let di = find_substr(dump, "description=", 0)
  if di >= 0 {
    let rest_start = di + 12
    let nl = find_substr(dump, "\n", rest_start)
    let raw = dump.to_bytes()
    let end = if nl >= 0 { nl } else { raw.length() }
    let desc = trim_ascii(slice_bytes_str(raw, rest_start, end))
    if desc != "" {
      fields.push(("description", base_codec::json_str(desc)))
    }
  }
  base_codec::json_obj(fields)
}

/// Parse combined ADB status shell dumps into `{ online, protocol, serial, model?, manufacturer?, androidVersion?, power, foregroundApp?, volume?, volumeMin?, volumeMax? }`.
pub fn parse_adb_status_dumps(
  serial : String,
  model : String,
  manufacturer : String,
  release : String,
  power_dump : String,
  focus_dump : String,
  vol_dump : String,
) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = [
    ("online", base_codec::json_bool(true)),
    ("protocol", base_codec::json_str("adb")),
    ("serial", base_codec::json_str(serial)),
  ]
  if trim_ascii(model) != "" {
    fields.push(("model", base_codec::json_str(trim_ascii(model))))
  }
  if trim_ascii(manufacturer) != "" {
    fields.push(("manufacturer", base_codec::json_str(trim_ascii(manufacturer))))
  }
  if trim_ascii(release) != "" {
    fields.push(("androidVersion", base_codec::json_str(trim_ascii(release))))
  }
  let wake_idx = find_substr(power_dump, "mWakefulness=", 0)
  let screen_on = if wake_idx >= 0 {
    find_substr(power_dump, "mWakefulness=Awake", wake_idx) == wake_idx
  } else {
    find_substr(power_dump, "Display Power: state=ON", 0) >= 0
  }
  fields.push(("power", base_codec::json_str(if screen_on { "on" } else { "off" })))
  let fi = find_substr(focus_dump, "mCurrentFocus=Window{", 0)
  if fi >= 0 {
    let slash = find_substr(focus_dump, "/", fi)
    if slash > fi {
      let fb = focus_dump.to_bytes()
      let mut sp = slash - 1
      while sp > fi && (fb[sp].to_int() & 0xFF) != 0x20 {
        sp = sp - 1
      }
      if sp + 1 < slash {
        let pkg = slice_bytes_str(fb, sp + 1, slash)
        if is_valid_android_pkg_name(pkg) {
          fields.push(("foregroundApp", base_codec::json_str(pkg)))
        }
      }
    }
  }
  match parse_adb_volume_dump(vol_dump) {
    Some((vol, vmin, vmax)) => {
      fields.push(("volume", base_codec::json_int(vol)))
      fields.push(("volumeMin", base_codec::json_int(vmin)))
      fields.push(("volumeMax", base_codec::json_int(vmax)))
    }
    None => ()
  }
  base_codec::json_obj(fields)
}

pub enum AdbVolumePlan {
  /// Single-stage ADB shell command (`mute`, `up`, `down`, or query `--get`).
  Direct(Array[String])
  /// Two-stage volume set (`adb-client.ts:479-487`): run stage-1 `--get` command, then pass its
  /// real stdout together with the clamped `0..100` level into `build_adb_volume_set_command`.
  QueryThenSet(Array[String], Int)
}

/// Plan an ADB `volume` action without ever trusting caller-supplied volume range dumps.
pub fn plan_adb_volume_command(args : base_codec::Json) -> AdbVolumePlan {
  let is_mute = match json_bool_opt(args, "mute") {
    Some(true) => true
    _ => {
      match json_str_opt(args, "action") {
        Some(a) => a == "mute"
        None => false
      }
    }
  }
  if is_mute {
    return AdbVolumePlan::Direct(["input", "keyevent", "164"])
  }
  match json_str_opt(args, "action") {
    Some("up") => return AdbVolumePlan::Direct(["input", "keyevent", "24"])
    Some("down") => return AdbVolumePlan::Direct(["input", "keyevent", "25"])
    _ => ()
  }
  match json_num_round_opt(args, "level") {
    Some(raw_lvl) => {
      let clamped = if raw_lvl < 0 { 0 } else if raw_lvl > 100 { 100 } else { raw_lvl }
      AdbVolumePlan::QueryThenSet(["cmd", "media_session", "volume", "--stream", "3", "--get"], clamped)
    }
    None => AdbVolumePlan::Direct(["cmd", "media_session", "volume", "--stream", "3", "--get"])
  }
}

/// Compute the `cmd media_session volume --stream 3 --set <idx>` command from a 0..100 `level`
/// and the real stdout of `cmd media_session volume --stream 3 --get` (`adb-client.ts:479-488`).
pub fn build_adb_volume_set_command(level : Int, get_stdout : String) -> (Array[String], Int, Int) {
  let clamped = if level < 0 { 0 } else if level > 100 { 100 } else { level }
  let max_vol = match parse_adb_volume_dump(get_stdout) {
    Some((_, _, vmax)) => if vmax > 0 { vmax } else { 15 }
    None => 15
  }
  let idx = (clamped * max_vol + 50) / 100
  (["cmd", "media_session", "volume", "--stream", "3", "--set", idx.to_string()], idx, max_vol)
}

/// Build validated ADB shell command arg lists for an Android TV control action (`adb-client.ts:395-512`).
/// For `launch` with a package name, returns `[primary_leanback, fallback_launcher]` so the executor
/// falls back to `android.intent.category.LAUNCHER` if `LEANBACK_LAUNCHER` fails.
pub fn build_adb_control_commands(
  action : String,
  args : base_codec::Json,
) -> Result[Array[Array[String]], AndroidTvError] {
  if action == "power" {
    let desired = match json_str_opt(args, "state") {
      Some(s) => to_ascii_lower(trim_ascii(s))
      None => "toggle"
    }
    if desired == "get" {
      return Ok([["dumpsys", "power"]])
    }
    let kc = if desired == "on" { "224" } else if desired == "off" { "223" } else { "26" }
    return Ok([["input", "keyevent", kc]])
  }
  if action == "remote" {
    let key = match json_str_opt(args, "key") {
      Some(s) => trim_ascii(s)
      None => ""
    }
    let code = match resolve_android_key_code(key) {
      Some(c) => c
      None => return Err(AndroidTvError::{ code: "invalid_params", message: "unsupported remote key: " + key })
    }
    let press = match json_str_opt(args, "press") {
      Some(s) => to_ascii_lower(trim_ascii(s))
      None => "single"
    }
    let rep_raw = match json_num_floor_opt(args, "repeat") {
      Some(n) => n
      None => 1
    }
    let repeat = if rep_raw < 1 { 1 } else if rep_raw > 20 { 20 } else { rep_raw }
    let cmds : Array[Array[String]] = []
    let mut i = 0
    while i < repeat {
      if press == "hold" {
        cmds.push(["input", "keyevent", "--longpress", code.to_string()])
      } else if press == "double" {
        cmds.push(["input", "keyevent", code.to_string()])
        cmds.push(["input", "keyevent", code.to_string()])
      } else {
        cmds.push(["input", "keyevent", code.to_string()])
      }
      i = i + 1
    }
    return Ok(cmds)
  }
  if action == "apps" {
    return Ok([["pm", "list", "packages", "-3"]])
  }
  if action == "launch" {
    let app = match json_str_opt(args, "app") {
      Some(s) => trim_ascii(s)
      None => {
        match json_str_opt(args, "url") {
          Some(u) => trim_ascii(u)
          None => ""
        }
      }
    }
    if app == "" {
      return Err(AndroidTvError::{ code: "invalid_params", message: "launch requires args.app (package name or URL)" })
    }
    if is_uri_with_scheme(app) {
      let quoted = match quote_android_shell_arg(app) {
        Ok(q) => q
        Err(e) => return Err(AndroidTvError::{ code: "invalid_params", message: e })
      }
      return Ok([["am", "start", "-a", "android.intent.action.VIEW", "-d", quoted]])
    }
    if !is_valid_android_pkg_name(app) {
      return Err(AndroidTvError::{ code: "invalid_params", message: "invalid Android package name: " + app })
    }
    return Ok([
      ["monkey", "-p", app, "-c", "android.intent.category.LEANBACK_LAUNCHER", "1"],
      ["monkey", "-p", app, "-c", "android.intent.category.LAUNCHER", "1"],
    ])
  }
  if action == "playing" {
    return Ok([["dumpsys", "media_session"]])
  }
  if action == "volume" {
    match plan_adb_volume_command(args) {
      AdbVolumePlan::Direct(cmd) => return Ok([cmd])
      // Stage 1 only: executor runs `--get`, then computes stage 2 via `build_adb_volume_set_command(level, get_stdout)`.
      AdbVolumePlan::QueryThenSet(get_cmd, _) => return Ok([get_cmd])
    }
  }
  if action == "keyboard" {
    let text = match json_str_opt(args, "text") {
      Some(s) => s
      None => ""
    }
    if text == "" {
      return Ok([])
    }
    let escaped = match escape_adb_input_text(text) {
      Ok(e) => e
      Err(e) => return Err(AndroidTvError::{ code: "invalid_params", message: e })
    }
    return Ok([["input", "text", escaped]])
  }
  if action == "play_url" {
    let u = match json_str_opt(args, "url") {
      Some(s) => trim_ascii(s)
      None => ""
    }
    if u == "" {
      return Err(AndroidTvError::{ code: "invalid_params", message: "play_url requires args.url" })
    }
    let quoted = match quote_android_shell_arg(u) {
      Ok(q) => q
      Err(e) => return Err(AndroidTvError::{ code: "invalid_params", message: e })
    }
    return Ok([["am", "start", "-a", "android.intent.action.VIEW", "-d", quoted]])
  }
  if action == "screenshot" {
    return Err(AndroidTvError::{ code: "invalid_params", message: "screenshot must be called via POST /screenshot" })
  }
  Err(AndroidTvError::{ code: "unknown_action", message: "unsupported action: " + action })
}

// ── Android TV In-Process HTTP Control Route Dispatcher (`android-tv/server.ts`) ──

pub let ATV_MAX_JSON_BYTES : Int = 1048576
pub let ATV_MAX_SCREENSHOT_BYTES : Int = 33554432 // 32 MB

pub fn parse_android_tv_tunnel_reply(status : Int, raw : String) -> Result[base_codec::Json, AndroidTvError] {
  match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) => {
      if status >= 200 && status < 300 {
        match json_bool_opt(j, "ok") {
          Some(true) => {
            match base_codec::json_get(j, "result") {
              Some(res) => return Ok(res)
              None => return Ok(base_codec::json_null())
            }
          }
          _ => ()
        }
      }
      match base_codec::json_get(j, "error") {
        Some(err_obj) => {
          let code = match json_str_opt(err_obj, "code") {
            Some(c) => c
            None => "http_" + status.to_string()
          }
          let msg = match json_str_opt(err_obj, "message") {
            Some(m) => m
            None => "Android TV request failed (HTTP " + status.to_string() + ")"
          }
          return Err(AndroidTvError::{ code, message: msg })
        }
        None => ()
      }
    }
    base_codec::JsonParseResult::Err(_) => ()
  }
  let trimmed = trim_ascii(raw)
  let msg = if trimmed != "" { trimmed } else { "Android TV request failed (HTTP " + status.to_string() + ")" }
  Err(AndroidTvError::{ code: "http_" + status.to_string(), message: msg })
}

fn atv_http_err(err : AndroidTvError) -> DeviceHttpResponse {
  device_http_json(
    android_tv_error_http_status(err.code),
    base_codec::json_obj([
      ("ok", base_codec::json_bool(false)),
      (
        "error",
        base_codec::json_obj([
          ("code", base_codec::json_str(err.code)),
          ("message", base_codec::json_str(err.message)),
        ]),
      ),
    ]),
  )
}

/// Dispatch an Android TV HTTP control request (`GET /status`, `POST /action`, `POST /screenshot`)
/// (1:1 with `station/src/devices/android-tv/server.ts`).
pub fn dispatch_android_tv_http_route(
  method : String,
  path : String,
  body : Bytes,
  on_action : (String, Option[base_codec::Json]) -> Result[base_codec::Json, AndroidTvError],
  on_screenshot : () -> Result[(Bytes, PngDimensions), AndroidTvError],
) -> DeviceHttpResponse {
  if method == "GET" && path == "/status" {
    match on_action("status", None) {
      Ok(res) => device_http_json(200, base_codec::json_obj([("ok", base_codec::json_bool(true)), ("result", res)]))
      Err(e) => atv_http_err(e)
    }
  } else if method == "POST" && path == "/action" {
    if body.length() > ATV_MAX_JSON_BYTES {
      return atv_http_err(AndroidTvError::{ code: "payload_too_large", message: "request body exceeds 1 MB" })
    }
    let text = trim_ascii(bytes_to_str(body))
    let parsed = if text == "" {
      base_codec::json_obj([])
    } else {
      match base_codec::json_parse(text) {
        base_codec::JsonParseResult::Ok(base_codec::Json::Obj(m)) => base_codec::Json::Obj(m)
        base_codec::JsonParseResult::Ok(_) => {
          return atv_http_err(AndroidTvError::{ code: "invalid_params", message: "JSON body must be an object" })
        }
        base_codec::JsonParseResult::Err(_) => {
          return atv_http_err(AndroidTvError::{ code: "invalid_params", message: "invalid JSON body" })
        }
      }
    }
    let raw_action = match json_str_opt(parsed, "action") {
      Some(s) => s
      None => ""
    }
    let action = match validate_android_tv_action(raw_action) {
      Ok(a) => a
      Err(e) => return atv_http_err(e)
    }
    let args : Option[base_codec::Json] = match base_codec::json_get(parsed, "args") {
      Some(base_codec::Json::Obj(m)) => Some(base_codec::Json::Obj(m))
      _ => None
    }
    match on_action(action, args) {
      Ok(res) => device_http_json(200, base_codec::json_obj([("ok", base_codec::json_bool(true)), ("result", res)]))
      Err(e) => atv_http_err(e)
    }
  } else if method == "POST" && path == "/screenshot" {
    match on_screenshot() {
      Ok((png, dim)) => {
        if png.length() > ATV_MAX_SCREENSHOT_BYTES {
          return atv_http_err(AndroidTvError::{ code: "payload_too_large", message: "screenshot exceeds 32 MB limit" })
        }
        DeviceHttpResponse::{
          status: 200,
          content_type: "image/png",
          headers: [
            ("x-image-width", dim.width.to_string()),
            ("x-image-height", dim.height.to_string()),
            ("connection", "close"),
          ],
          body: png,
        }
      }
      Err(e) => atv_http_err(e)
    }
  } else {
    device_http_json(
      404,
      base_codec::json_obj([
        ("ok", base_codec::json_bool(false)),
        (
          "error",
          base_codec::json_obj([
            ("code", base_codec::json_str("not_found")),
            ("message", base_codec::json_str(method + " " + path + " not found")),
          ]),
        ),
      ]),
    )
  }
}
