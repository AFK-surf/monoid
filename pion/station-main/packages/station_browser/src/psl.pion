fn rule_matches(rule : PslRule, host_labels : Array[String]) -> Bool {
  let rlen = rule.labels.length()
  let hlen = host_labels.length()
  if hlen < rlen {
    return false
  }
  let mut i = 0
  while i < rlen {
    let r = rule.labels[rlen - 1 - i]
    let h = host_labels[hlen - 1 - i]
    if r != "*" && r != h {
      return false
    }
    i = i + 1
  }
  true
}

pub fn PslEngine::parse(self : PslEngine, raw_host : String) -> PslParsed {
  let h = normalize_host(raw_host)
  if h.length() == 0 {
    return PslParsed::{
      host: "",
      is_ip: false,
      is_icann: false,
      is_private: false,
      public_suffix: None,
      domain: None,
    }
  }
  if is_ip_host(h) {
    return PslParsed::{
      host: h,
      is_ip: true,
      is_icann: false,
      is_private: false,
      public_suffix: None,
      domain: None,
    }
  }
  let labels = split_dots(h)
  let mut best_exc : Option[PslRule] = None
  let mut best_norm : Option[PslRule] = None
  let mut i = 0
  while i < self.rules.length() {
    let rule = self.rules[i]
    if rule_matches(rule, labels) {
      if rule.is_exception {
        match best_exc {
          None => best_exc = Some(rule)
          Some(prev) => {
            if rule.labels.length() > prev.labels.length() {
              best_exc = Some(rule)
            }
          }
        }
      } else {
        match best_norm {
          None => best_norm = Some(rule)
          Some(prev) => {
            if rule.labels.length() > prev.labels.length() {
              best_norm = Some(rule)
            }
          }
        }
      }
    }
    i = i + 1
  }
  let chosen : Option[PslRule] = match best_exc {
    Some(r) => Some(r)
    None => best_norm
  }
  match chosen {
    None => PslParsed::{
      host: h,
      is_ip: false,
      is_icann: false,
      is_private: false,
      public_suffix: None,
      domain: None,
    }
    Some(rule) => {
      let suffix_len = if rule.is_exception {
        rule.labels.length() - 1
      } else {
        rule.labels.length()
      }
      let is_icann = match rule.section {
        PslSection::Icann => true
        PslSection::Private => false
      }
      let is_private = !is_icann
      if suffix_len <= 0 || suffix_len > labels.length() {
        return PslParsed::{
          host: h,
          is_ip: false,
          is_icann: is_icann,
          is_private: is_private,
          public_suffix: None,
          domain: None,
        }
      }
      let suffix = join_labels_from(labels, labels.length() - suffix_len)
      let domain = if labels.length() > suffix_len {
        Some(join_labels_from(labels, labels.length() - suffix_len - 1))
      } else {
        None
      }
      PslParsed::{
        host: h,
        is_ip: false,
        is_icann: is_icann,
        is_private: is_private,
        public_suffix: Some(suffix),
        domain: domain,
      }
    }
  }
}

pub fn PslEngine::is_public_suffix(self : PslEngine, host : String) -> Bool {
  let parsed = self.parse(host)
  if parsed.host.length() == 0 {
    return false
  }
  (parsed.is_icann || parsed.is_private) &&
  match (parsed.domain, parsed.public_suffix) {
    (None, Some(_)) => true
    _ => false
  }
}

pub fn PslEngine::registrable_domain(self : PslEngine, host : String) -> Option[String] {
  let parsed = self.parse(host)
  if parsed.host.length() == 0 || parsed.is_ip {
    return None
  }
  parsed.domain
}

pub fn PslEngine::same_site_host(self : PslEngine, host : String, site : String) -> Bool {
  let h = normalize_host(host)
  let s = normalize_host(site)
  if h.length() == 0 || s.length() == 0 || self.is_public_suffix(s) {
    return false
  }
  if h != s && !h.ends_with("." + s) {
    return false
  }
  match self.registrable_domain(s) {
    Some(site_reg) => {
      match self.registrable_domain(h) {
        Some(host_reg) => host_reg == site_reg
        None => false
      }
    }
    None => true
  }
}

/// Whether a page on `host` may ask for a passkey of relying party `rp_id`:
/// the host itself, or a registrable parent domain under the PSL (including private suffixes).
pub fn PslEngine::rp_for(self : PslEngine, rp_id : String, host : String) -> Bool {
  let rp = normalize_host(rp_id)
  let h = normalize_host(host)
  if rp.length() == 0 || h.length() == 0 || self.is_public_suffix(rp) {
    return false
  }
  if rp == h {
    return true
  }
  if !h.ends_with("." + rp) {
    return false
  }
  match self.registrable_domain(h) {
    Some(reg) => rp == reg || rp.ends_with("." + reg)
    None => rp.index_of(".") >= 0
  }
}

/// Whether `host` is a public suffix (ICANN or private PSL entry such as `co.uk` or `github.io`).
pub fn is_public_suffix(host : String) -> Bool {
  PslEngine::standard().is_public_suffix(host)
}

/// The registrable domain (eTLD+1) of `host` under the PSL (private domains included), or `None`.
pub fn registrable_domain(host : String) -> Option[String] {
  PslEngine::standard().registrable_domain(host)
}

/// Whether `host` belongs to `site` (exact host or subdomain) without crossing a nested private PSL boundary.
pub fn same_site_host(host : String, site : String) -> Bool {
  PslEngine::standard().same_site_host(host, site)
}

/// Whether a page on `host` may ask for a passkey of relying party `rp_id`.
pub fn rp_for(rp_id : String, host : String) -> Bool {
  PslEngine::standard().rp_for(rp_id, host)
}

/// Whether `host` is a local loopback host (`localhost`, `127.0.0.1`, or `[::1]` / `::1`).
pub fn is_loopback_host(host : String) -> Bool {
  let h = normalize_host(host)
  h == "localhost" || h == "127.0.0.1" || h == "[::1]"
}

/// Whether `raw_url` is a secure origin eligible for autofill, login prompts, and WebAuthn:
/// `https:` or loopback `http:`.
pub fn is_secure_autofill_url(raw_url : String) -> Bool {
  match url::Url::parse(raw_url) {
    Ok(u) => {
      let scheme = u.scheme()
      if scheme == "https" {
        u.hostname().length() > 0
      } else if scheme == "http" {
        is_loopback_host(u.hostname())
      } else {
        false
      }
    }
    Err(_) => false
  }
}
