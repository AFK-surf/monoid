// Public Suffix List (PSL) and secure-origin checks for browser sign-ins,
// autofill, and WebAuthn relying parties (aligns `station/src/browser/psl.ts`
// and `hostOf`/`rpFor` in `view.ts`).

import "url"

pub enum PslSection {
  Icann
  Private
}

pub struct PslRule {
  pub labels : Array[String]
  pub is_exception : Bool
  pub section : PslSection
}

pub struct PslParsed {
  pub host : String
  pub is_ip : Bool
  pub is_icann : Bool
  pub is_private : Bool
  pub public_suffix : Option[String]
  pub domain : Option[String]
}

pub struct PslEngine {
  rules : Array[PslRule]
}

fn ascii_lower(s : String) -> String {
  let b = s.to_bytes()
  let sb = StringBuilder::with_capacity(b.length())
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(b[i])
    }
    i = i + 1
  }
  sb.to_string()
}

fn is_ascii_space(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12
}

fn trim_ascii(s : String) -> String {
  let b = s.to_bytes()
  let mut start = 0
  let mut end = b.length()
  while start < end && is_ascii_space(b[start].to_int() & 0xFF) {
    start = start + 1
  }
  while end > start && is_ascii_space(b[end - 1].to_int() & 0xFF) {
    end = end - 1
  }
  if start == 0 && end == b.length() {
    return s
  }
  b.slice(start, end).to_string()
}

fn strip_leading_dots(s : String) -> String {
  let b = s.to_bytes()
  let mut i = 0
  while i < b.length() && (b[i].to_int() & 0xFF) == 46 {
    i = i + 1
  }
  if i == 0 {
    return s
  }
  b.slice(i, b.length()).to_string()
}

fn strip_trailing_dots(s : String) -> String {
  let b = s.to_bytes()
  let mut end = b.length()
  while end > 0 && (b[end - 1].to_int() & 0xFF) == 46 {
    end = end - 1
  }
  if end == b.length() {
    return s
  }
  b.slice(0, end).to_string()
}

fn has_forbidden_host_char(s : String) -> Bool {
  let b = s.to_bytes()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c == 47 || c == 63 || c == 35 || c == 64 || c == 92 || is_ascii_space(c) {
      return true
    }
    i = i + 1
  }
  false
}

fn is_ipv6_literal_chars(s : String) -> Bool {
  let b = s.to_bytes()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    let ok = (c >= 48 && c <= 57) ||
    (c >= 97 && c <= 102) ||
    c == 58 ||
    (i == 0 && c == 91) ||
    (i == b.length() - 1 && c == 93)
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

fn split_dots(s : String) -> Array[String] {
  let b = s.to_bytes()
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < b.length() {
    if (b[i].to_int() & 0xFF) == 46 {
      out.push(b.slice(start, i).to_string())
      start = i + 1
    }
    i = i + 1
  }
  out.push(b.slice(start, b.length()).to_string())
  out
}

fn join_labels_from(labels : Array[String], start : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = start
  while i < labels.length() {
    if i > start {
      sb.write_string(".")
    }
    sb.write_string(labels[i])
    i = i + 1
  }
  sb.to_string()
}

fn is_ipv4_host(h : String) -> Bool {
  let parts = split_dots(h)
  if parts.length() != 4 {
    return false
  }
  let mut i = 0
  while i < 4 {
    let p = parts[i]
    let pb = p.to_bytes()
    if pb.length() == 0 || pb.length() > 3 {
      return false
    }
    let mut octet = 0
    let mut j = 0
    while j < pb.length() {
      let c = pb[j].to_int() & 0xFF
      if c < 48 || c > 57 {
        return false
      }
      octet = octet * 10 + (c - 48)
      j = j + 1
    }
    if octet > 255 {
      return false
    }
    i = i + 1
  }
  true
}

fn is_ip_host(h : String) -> Bool {
  if h.starts_with("[") && h.ends_with("]") {
    return true
  }
  is_ipv4_host(h)
}

/// Normalizes a hostname (or cookie domain with leading dot, trailing dot, or IDN labels)
/// into lowercase ASCII form. Rejects strings containing URL delimiters, credentials,
/// whitespace, or non-IPv6 colons. Returns `""` when invalid.
pub fn normalize_host(host : String) -> String {
  let stripped = strip_trailing_dots(strip_leading_dots(ascii_lower(trim_ascii(host))))
  if stripped.length() == 0 || has_forbidden_host_char(stripped) {
    return ""
  }
  if stripped.index_of(":") >= 0 {
    if !is_ipv6_literal_chars(stripped) {
      return ""
    }
    let bare = if stripped.starts_with("[") && stripped.ends_with("]") {
      let b = stripped.to_bytes()
      b.slice(1, b.length() - 1).to_string()
    } else {
      stripped
    }
    match url::Url::parse("http://[" + bare + "]") {
      Ok(u) => return u.hostname()
      Err(_) => return ""
    }
  }
  match url::Url::parse("http://" + stripped) {
    Ok(u) => strip_trailing_dots(u.hostname())
    Err(_) => ""
  }
}

/// The host of a URL (lowercase ASCII, no trailing dot); `""` for URLs without a host (e.g. `about:blank`).
pub fn host_of(raw_url : String) -> String {
  match url::Url::parse(raw_url) {
    Ok(u) => strip_trailing_dots(ascii_lower(u.hostname()))
    Err(_) => ""
  }
}

fn parse_rule_line(line : String, section : PslSection) -> Option[PslRule] {
  let trimmed = trim_ascii(line)
  if trimmed.length() == 0 || trimmed.starts_with("//") {
    return None
  }
  let mut is_exc = false
  let mut body = trimmed
  if body.starts_with("!") {
    is_exc = true
    let b = body.to_bytes()
    body = b.slice(1, b.length()).to_string()
  }
  let raw_labels = split_dots(ascii_lower(body))
  let labels : Array[String] = []
  let mut i = 0
  while i < raw_labels.length() {
    let lbl = raw_labels[i]
    if lbl.length() == 0 {
      return None
    }
    if lbl == "*" {
      labels.push("*")
    } else {
      match url::domain_to_ascii(lbl) {
        Ok(asc) => labels.push(ascii_lower(asc))
        Err(_) => labels.push(lbl)
      }
    }
    i = i + 1
  }
  if labels.length() == 0 {
    return None
  }
  Some(PslRule::{ labels: labels, is_exception: is_exc, section: section })
}

pub fn PslEngine::from_rules(icann : Array[String], private_rules : Array[String]) -> PslEngine {
  let rules : Array[PslRule] = []
  let mut i = 0
  while i < icann.length() {
    match parse_rule_line(icann[i], PslSection::Icann) {
      Some(r) => rules.push(r)
      None => ()
    }
    i = i + 1
  }
  let mut j = 0
  while j < private_rules.length() {
    match parse_rule_line(private_rules[j], PslSection::Private) {
      Some(r) => rules.push(r)
      None => ()
    }
    j = j + 1
  }
  PslEngine::{ rules: rules }
}

