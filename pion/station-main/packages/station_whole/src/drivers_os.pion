// Production OS adapter for `station_drivers`:
// - Wires all 11 coding-agent runtime drivers, `instructions`, `migrations`, `providers`,
//   `accounts`, and `runner` adoption.
// - Injects real OS CSPRNG `next_uuid` via `station_sys::random_bytes(16)` into
//   `station_drivers::OpenOptions::new` (never pseudo-random or sequential IDs).

import "nodepath"
import "station_drivers"
import "station_sys"

/// Generates a real RFC 4122 UUID v4 using OS CSPRNG (`station_sys::random_bytes(16)`).
pub fn os_uuid_v4() -> Result[String, String] {
  match station_sys::random_bytes(16) {
    Ok(raw) => {
      if raw.length() < 16 {
        return Err("OS CSPRNG returned fewer than 16 bytes")
      }
      let id = station_drivers::uuid_v4_from_bytes(raw)
      if !station_drivers::is_valid_uuid_v4(id) {
        return Err("generated UUID v4 failed validation")
      }
      Ok(id)
    }
    Err(e) => Err("OS CSPRNG failed: " + e)
  }
}

/// Callback adapter for `OpenOptions::new`'s `next_uuid : () -> String`.
/// Fails closed (returns empty string, which `build_claude_launch` rejects) if OS CSPRNG fails.
pub fn os_next_uuid() -> String {
  match os_uuid_v4() {
    Ok(id) => id
    Err(_) => ""
  }
}

/// Returns true if `path` exists on the host filesystem (via `station_sys::lstat_raw`).
pub fn os_has_path(path : String) -> Bool {
  match station_sys::lstat_raw(path) {
    Some(_) => true
    None => false
  }
}

fn parse_env_pairs(entries : Array[String]) -> Array[(String, String)] {
  let out : Array[(String, String)] = []
  for i in 0..<entries.length() {
    let entry = entries[i]
    let raw = entry.to_bytes()
    let mut eq = -1
    for j in 0..<raw.length() {
      if (raw[j].to_int() & 0xFF) == 61 {
        eq = j
        break
      }
    }
    if eq > 0 {
      let ks = StringBuilder::new()
      for k in 0..<eq { ks.write_byte(raw[k]) }
      let vs = StringBuilder::new()
      for k in (eq + 1)..<raw.length() { vs.write_byte(raw[k]) }
      out.push((ks.to_string(), vs.to_string()))
    }
  }
  out
}

/// Pure dependency-injected `OpenOptions` builder for deterministic unit tests.
pub fn open_options_with_deps(
  key : String,
  profile : station_drivers::Profile,
  cwd : String,
  mcp_url : String,
  mcp_token : String,
  data_dir : String,
  assets_dir : String,
  runner_bin : String,
  os : String,
  home : String,
  tmpdir : String,
  has_path : (String) -> Bool,
  next_uuid : () -> String,
  station_env : Array[(String, String)],
  instructions : String = "",
  resume : Option[String] = None,
  model : Option[String] = None,
  effort : Option[String] = None,
  sdk_dir : Option[String] = None,
  copilot_token : Option[String] = None,
) -> station_drivers::OpenOptions {
  let sep = if os == "win32" { "\\" } else { "/" }
  let base = station_drivers::OpenOptions::new(
    key,
    profile,
    cwd,
    mcp_url,
    mcp_token,
    home,
    has_path,
    next_uuid,
  )
  let stub_dir = nodepath::join(sep, [tmpdir, "stillfail-no-keychain"])
  station_drivers::OpenOptions::{
    key: base.key,
    profile: base.profile,
    cwd: base.cwd,
    resume: resume,
    model: model,
    effort: effort,
    speed: base.speed,
    context: base.context,
    fast: base.fast,
    tui: base.tui,
    instructions: instructions,
    skills: base.skills,
    mcp_token: base.mcp_token,
    mcp_url: base.mcp_url,
    route: base.route,
    text_only: base.text_only,
    is_root: base.is_root,
    has_keychain: os == "darwin",
    os_name: os,
    sep: sep,
    station_env: station_env,
    agent_env: [],
    node_exec: base.node_exec,
    runner_bin: runner_bin,
    assets_dir: assets_dir,
    data_dir: data_dir,
    stub_dir: stub_dir,
    sdk_dir: sdk_dir,
    external_token: base.external_token,
    copilot_token: copilot_token,
    cursor_key: base.cursor_key,
    home_dir: base.home_dir,
    has_path: base.has_path,
    next_uuid: base.next_uuid,
    hermes_header_line: base.hermes_header_line,
  }
}

/// Builds production `station_drivers::OpenOptions` via `OpenOptions::new` with OS CSPRNG
/// `next_uuid`, real OS `home_dir`, real `has_path`, platform `os_name`/`sep`, and station env.
pub fn os_open_options(
  key : String,
  profile : station_drivers::Profile,
  cwd : String,
  mcp_url : String,
  mcp_token : String,
  data_dir : String,
  assets_dir : String,
  runner_bin : String,
  instructions : String = "",
  resume : Option[String] = None,
  model : Option[String] = None,
  effort : Option[String] = None,
  sdk_dir : Option[String] = None,
  copilot_token : Option[String] = None,
) -> station_drivers::OpenOptions {
  open_options_with_deps(
    key,
    profile,
    cwd,
    mcp_url,
    mcp_token,
    data_dir,
    assets_dir,
    runner_bin,
    station_sys::os_name(),
    station_sys::homedir(),
    station_sys::tmpdir(),
    os_has_path,
    os_next_uuid,
    parse_env_pairs(station_sys::env_all()),
    instructions=instructions,
    resume=resume,
    model=model,
    effort=effort,
    sdk_dir=sdk_dir,
    copilot_token=copilot_token,
  )
}

/// All supported coding-agent CLI runtimes (`station_drivers::runtime_kinds()` plus ACP JSON-RPC framing = 11 drivers).
pub fn all_supported_runtimes() -> Array[station_drivers::RuntimeKind] {
  station_drivers::runtime_kinds()
}

/// Builds a launch spec for any of the 11 supported coding-agent runtimes.
pub fn build_os_driver_launch(
  runtime : station_drivers::RuntimeKind,
  opts : station_drivers::OpenOptions,
) -> Result[station_drivers::DriverLaunchSpec, String] {
  station_drivers::build_driver_launch(runtime, opts)
}

/// Production driver runtime manager holding model catalog, account cooldowns, and runner adoption.
pub struct DriversRuntime {
  pub models : station_drivers::ModelCatalogStore
  pub cooldowns : station_drivers::AccountCooldowns
  pub mut adoption : station_drivers::RunnerAdoptionMachine
}

pub fn DriversRuntime::new(runners : Array[station_drivers::RunnerInfo]) -> DriversRuntime {
  DriversRuntime::{
    models: station_drivers::ModelCatalogStore::new(),
    cooldowns: station_drivers::AccountCooldowns::new(),
    adoption: station_drivers::RunnerAdoptionMachine::new(runners),
  }
}
