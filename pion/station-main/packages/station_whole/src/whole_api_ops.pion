// Full production HTTP API operation handlers for `WholeApi` (`station_whole`):
// - Real SQLite-backed Vault (`station_vault::VaultStore` + `lock::admit` viewer proof +
//   `before_write` handover 503 gate + `vault`/`vault-box`/`vault-gone`/`vault-ask`/`vault-join` SSE)
// - Real `station_drivers::RuntimeUpdatesManager` (`updates.*`)
// - Unified `station_ops::ConfigFile` settings mutations (`accounts.*`, `mcpServers.*`,
//   `network.*`, `context.*`, `diagnostics.*`, `agentEnv.put`, `tools.access.*`, `xshare.*`,
//   `search.settings`, `connects.*`, `copies.settings.put`)
// - Complete domain & integration dispatch (`hub.*`, `marks.*`, `projects.*`, `screens.*`,
//   `presets.*`, `presetProjects.*`, `stars.*`, `progress.*`, `board.*`, `copies.*`, `drive.*`,
//   `transfers.*`, `logins.machine.*`, `signins.*`, `links.preview`, `permissions.request`,
//   `workspaces.*`, `feedback.report`, `resources.*`) with ZERO `404 unsupported api op`.
//
// Decoupled via `WholeApiRuntimePort` so pure `pionc test` exercises the exact same production
// dispatcher (including `VaultStore::in_memory()`, `RuntimeUpdatesManager`, `ConfigFile`) without
// pulling C FFI symbols (`sqlite_ffi` / `station_sys`) into unit-test binaries.

import "base_codec"
import "form"
import "lock"
import "nodepath"
import "sql_db"
import "station_api"
import "station_drivers"
import "station_jobs"
import "station_ops"
import "station_rules_bridge"
import "station_screens"
import "station_sessions"
import "station_sys"
import "station_vault"

/// Mutable runtime hooks attached to `WholeApi` so `whole_daemon` can inject live daemon
/// capabilities (pinned workspace locks, restart trigger, workspace join, machine logins,
/// browser sign-ins) without cyclic package imports.
pub struct WholeApiRuntimeHooks {
  pub mut lock_of : Option[(String) -> Option[lock::LockState]]
  pub mut on_restart : Option[() -> Result[Unit, String]]
  pub mut on_workspace_join : Option[(base_codec::Json) -> Result[base_codec::Json, String]]
  pub mut on_logins_op : Option[(String, Array[String], base_codec::Json) -> Result[base_codec::Json, station_api::ApiError]]
  pub mut on_signins_op : Option[(String, Array[String], base_codec::Json) -> Result[base_codec::Json, station_api::ApiError]]
  pub mut on_session_changed : Option[(String) -> Unit]
  pub mut on_overview_dirty : Option[(String) -> Unit]
  pub mut viewer_lock_proofs : Map[String, (String, String)]
  pub mut read_only_handover_cell : Array[Bool]
}

pub fn WholeApiRuntimeHooks::new() -> WholeApiRuntimeHooks {
  WholeApiRuntimeHooks::{
    lock_of: None,
    on_restart: None,
    on_workspace_join: None,
    on_logins_op: None,
    on_signins_op: None,
    on_session_changed: None,
    on_overview_dirty: None,
    viewer_lock_proofs: Map::new(),
    read_only_handover_cell: [true],
  }
}

pub fn WholeApiRuntimeHooks::set_viewer_proof(
  self : WholeApiRuntimeHooks,
  workspace : String,
  sub : String,
  device : String,
  lock_base : String,
  lock_proof : String,
) -> Unit {
  let k = workspace + "|" + sub + "|" + device
  self.viewer_lock_proofs.set(k, (lock_base, lock_proof))
}

fn hooks_notify_session(hooks : WholeApiRuntimeHooks, key : String) -> Unit {
  match hooks.on_session_changed {
    Some(f) => f(key)
    None => ()
  }
}

fn hooks_notify_overview(hooks : WholeApiRuntimeHooks, reason : String) -> Unit {
  match hooks.on_overview_dirty {
    Some(f) => f(reason)
    None => ()
  }
}

/// Narrow storage + OS port consumed by `dispatch_extra_read_op` and `dispatch_extra_call_op`.
/// Production `WholeApi::new` wires `WholeApiRuntimePort::production(...)` over real SQLite +
/// `station_sys`; pure unit tests wire `WholeApiRuntimePort::in_memory(...)`.
pub struct WholeApiRuntimePort {
  pub os_name : () -> String
  pub machine_stats : () -> base_codec::Json
  pub process_usage : () -> base_codec::Json
  pub vault_boxes_list : (String) -> Result[Array[base_codec::Json], station_api::ApiError]
  pub vault_items_list : (String, String) -> Result[Array[base_codec::Json], station_api::ApiError]
  pub vault_item_put : (String, String, String, base_codec::Json) -> Result[Unit, station_api::ApiError]
  pub running_on_runtime : (String) -> Int
  pub changed_threads : (String) -> Result[base_codec::Json, station_api::ApiError]
  pub changed_sessions : (String) -> Result[base_codec::Json, station_api::ApiError]
  pub thread_letters : (Int64) -> Result[base_codec::Json, station_api::ApiError]
  pub session_exists_info : (String) -> Result[Option[(String, Bool)], station_api::ApiError]
  pub project_rename : (String, String) -> Result[Unit, station_api::ApiError]
  pub handed_stations : () -> Array[String]
  pub create_thread_session : (String, Option[String], String, Option[String], String, String, Int64) -> Result[Int64, String]
  pub archive_session : (String, String, Int64) -> Result[Unit, String]
  pub unarchive_session : (String) -> Result[Unit, station_api::ApiError]
  pub update_session_field : (String, String, String) -> Result[Unit, station_api::ApiError]
  pub archive_thread : (Int64, Bool, Int64) -> Result[Unit, station_api::ApiError]
  pub set_thread_title : (Int64, String) -> Unit
  pub read_adopted_output : (String) -> Array[String]
}

pub fn WholeApiRuntimePort::in_memory() -> WholeApiRuntimePort {
  let items_store : Map[String, base_codec::Json] = Map::new()
  WholeApiRuntimePort::{
    os_name: fn() -> String { "linux" },
    machine_stats: fn() -> base_codec::Json { base_codec::json_obj([]) },
    process_usage: fn() -> base_codec::Json { base_codec::json_obj([]) },
    vault_boxes_list: fn(_ws : String) -> Result[Array[base_codec::Json], station_api::ApiError] { Ok([]) },
    vault_items_list: fn(ws : String, vid : String) -> Result[Array[base_codec::Json], station_api::ApiError] {
      let out : Array[base_codec::Json] = []
      let prefix = ws + "|" + (if vid.length() > 0 { vid + "|" } else { "" })
      let ks = items_store.keys()
      for i in 0..<ks.length() {
        if ks[i].starts_with(prefix) {
          match items_store.get(ks[i]) {
            Some(v) => out.push(v)
            None => ()
          }
        }
      }
      Ok(out)
    },
    vault_item_put: fn(ws : String, vid : String, iid : String, body : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      items_store.set(ws + "|" + vid + "|" + iid, body)
      Ok(())
    },
    running_on_runtime: fn(_rt : String) -> Int { 0 },
    changed_threads: fn(_ws : String) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([("total", base_codec::json_int(0)), ("changed", base_codec::json_arr([]))]))
    },
    changed_sessions: fn(_ws : String) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([("changed", base_codec::json_arr([]))]))
    },
    thread_letters: fn(_tid : Int64) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([("letters", base_codec::json_arr([]))]))
    },
    session_exists_info: fn(_key : String) -> Result[Option[(String, Bool)], station_api::ApiError] {
      Ok(Some(("claude", false)))
    },
    project_rename: fn(_from : String, _to : String) -> Result[Unit, station_api::ApiError] { Ok(()) },
    handed_stations: fn() -> Array[String] { [] },
    create_thread_session: fn(_k : String, _t : Option[String], _rt : String, _m : Option[String], _e : String, _ws : String, _now : Int64) -> Result[Int64, String] {
      Ok(1L)
    },
    archive_session: fn(_k : String, _e : String, _now : Int64) -> Result[Unit, String] { Ok(()) },
    unarchive_session: fn(_k : String) -> Result[Unit, station_api::ApiError] { Ok(()) },
    update_session_field: fn(_k : String, _col : String, _v : String) -> Result[Unit, station_api::ApiError] { Ok(()) },
    archive_thread: fn(_tid : Int64, _arch : Bool, _now : Int64) -> Result[Unit, station_api::ApiError] { Ok(()) },
    set_thread_title: fn(_tid : Int64, _title : String) -> Unit { () },
    read_adopted_output: fn(_key : String) -> Array[String] { [] },
  }
}

pub fn WholeApiRuntimePort::production(
  whole_store : WholeStore,
  agents : WholeAgents,
  home_ws_str : String,
) -> WholeApiRuntimePort {
  WholeApiRuntimePort::{
    os_name: station_sys::os_name,
    machine_stats: fn() -> base_codec::Json {
      match base_codec::json_parse(station_sys::machine_stats_json()) {
        base_codec::JsonParseResult::Ok(j) => j
        _ => base_codec::json_obj([])
      }
    },
    process_usage: fn() -> base_codec::Json {
      match base_codec::json_parse(station_sys::process_usage_json([])) {
        base_codec::JsonParseResult::Ok(j) => j
        _ => base_codec::json_obj([])
      }
    },
    vault_boxes_list: fn(ws : String) -> Result[Array[base_codec::Json], station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.all("SELECT body FROM vault_boxes WHERE ws = ?1 ORDER BY device ASC", [base_codec::json_str(ws)]) {
        Ok(rows) => {
          let out : Array[base_codec::Json] = []
          for i in 0..<rows.length() {
            match rows[i].get("body") {
              Some(base_codec::Json::Str(raw)) => match base_codec::json_parse(raw) {
                base_codec::JsonParseResult::Ok(j) => out.push(j)
                _ => ()
              }
              _ => ()
            }
          }
          Ok(out)
        }
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    vault_items_list: fn(ws : String, vault_id : String) -> Result[Array[base_codec::Json], station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      let sql = if vault_id.length() > 0 {
        "SELECT body FROM vault_items WHERE ws = ?1 AND vault = ?2 ORDER BY id ASC"
      } else {
        "SELECT i.body FROM vault_items i WHERE i.ws = ?1 ORDER BY i.vault ASC, i.id ASC LIMIT 1000"
      }
      let qparams = if vault_id.length() > 0 {
        [base_codec::json_str(ws), base_codec::json_str(vault_id)]
      } else {
        [base_codec::json_str(ws)]
      }
      match st.db.all(sql, qparams) {
        Ok(rows) => {
          let out : Array[base_codec::Json] = []
          for i in 0..<rows.length() {
            match rows[i].get("body") {
              Some(base_codec::Json::Str(raw)) => match base_codec::json_parse(raw) {
                base_codec::JsonParseResult::Ok(j) => out.push(j)
                _ => ()
              }
              _ => ()
            }
          }
          Ok(out)
        }
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    vault_item_put: fn(ws : String, vid : String, iid : String, body : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run(
        "INSERT INTO vault_items (ws, vault, id, body) VALUES (?1, ?2, ?3, ?4)" +
        " ON CONFLICT(ws, vault, id) DO UPDATE SET body = excluded.body",
        [
          base_codec::json_str(ws),
          base_codec::json_str(vid),
          base_codec::json_str(iid),
          base_codec::json_str(base_codec::json_stringify(body)),
        ],
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    running_on_runtime: fn(rt_s : String) -> Int {
      match whole_store.require_open() {
        Ok(st) => match st.db.first(
          "SELECT COUNT(*) AS cnt FROM sessions WHERE archived_at IS NULL AND running = 1 AND runtime = ?1",
          [base_codec::json_str(rt_s)],
        ) {
          Ok(Some(r)) => match r.get("cnt") {
            Some(base_codec::Json::Num(n, _)) => n.to_int()
            _ => 0
          }
          _ => 0
        }
        Err(_) => 0
      }
    },
    changed_threads: fn(ws : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.search_chat_threads(Some(ws), Some(home_ws_str), "", station_store::ChatListFilter::empty(), 100) {
        Ok((threads, total)) => {
          let items : Array[base_codec::Json] = []
          for i in 0..<threads.length() {
            items.push(thread_row_to_json(threads[i]))
          }
          Ok(base_codec::json_obj([("total", base_codec::json_int(total)), ("changed", base_codec::json_arr(items))]))
        }
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    changed_sessions: fn(ws : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.all(
        "SELECT key, title, runtime, running, last_active_at FROM sessions WHERE COALESCE(ws, ?1) = ?2 ORDER BY last_active_at DESC LIMIT 100",
        [base_codec::json_str(home_ws_str), base_codec::json_str(ws)],
      ) {
        Ok(rows) => {
          let items : Array[base_codec::Json] = []
          for i in 0..<rows.length() {
            let r = rows[i]
            items.push(base_codec::json_obj([
              ("key", match r.get("key") { Some(v) => v, None => base_codec::json_str("") }),
              ("runtime", match r.get("runtime") { Some(v) => v, None => base_codec::json_str("") }),
              ("running", match r.get("running") { Some(v) => v, None => base_codec::json_int(0) }),
            ]))
          }
          Ok(base_codec::json_obj([("changed", base_codec::json_arr(items))]))
        }
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    thread_letters: fn(tid : Int64) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.all(
        "SELECT n, author_kind, author, text, at FROM entries WHERE thread = ?1 AND kind = 'letter' ORDER BY n ASC LIMIT 200",
        [sql_db::int64_to_json(tid)],
      ) {
        Ok(rows) => {
          let out : Array[base_codec::Json] = []
          for i in 0..<rows.length() {
            let r = rows[i]
            out.push(base_codec::json_obj([
              ("n", match r.get("n") { Some(v) => v, None => base_codec::json_int(0) }),
              ("authorKind", match r.get("author_kind") { Some(v) => v, None => base_codec::json_str("") }),
              ("author", match r.get("author") { Some(v) => v, None => base_codec::json_str("") }),
              ("text", match r.get("text") { Some(v) => v, None => base_codec::json_str("") }),
              ("at", match r.get("at") { Some(v) => v, None => base_codec::json_int(0) }),
            ]))
          }
          Ok(base_codec::json_obj([("letters", base_codec::json_arr(out))]))
        }
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    session_exists_info: fn(key : String) -> Result[Option[(String, Bool)], station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.get_session(key) {
        Ok(Some(row)) => Ok(Some((row.runtime, row.running)))
        Ok(None) => Ok(None)
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    project_rename: fn(from_name : String, to_name : String) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run(
        "UPDATE threads SET project = ?1 WHERE project = ?2",
        [base_codec::json_str(to_name), base_codec::json_str(from_name)],
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    handed_stations: fn() -> Array[String] {
      match whole_store.handed_stations() {
        Ok(hs) => hs
        Err(_) => []
      }
    },
    create_thread_session: fn(
      key : String,
      title : Option[String],
      runtime : String,
      model : Option[String],
      email : String,
      ws : String,
      now_ms : Int64,
    ) -> Result[Int64, String] {
      match agents.create_session(
        whole_store,
        key,
        "chat",
        title,
        Some(email),
        runtime,
        "default",
        model,
        agents.config.data_dir,
        Some(ws),
        now_ms,
      ) {
        Ok((_, tid)) => Ok(tid)
        Err(e) => Err(e)
      }
    },
    archive_session: fn(key : String, email : String, now_ms : Int64) -> Result[Unit, String] {
      agents.archive_session(whole_store, key, email, now_ms)
    },
    unarchive_session: fn(key : String) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run("UPDATE sessions SET archived_at = NULL, archived_by = NULL WHERE key = ?1", [base_codec::json_str(key)]) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    update_session_field: fn(key : String, col : String, value : String) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      let sql = if col == "title" {
        "UPDATE sessions SET title = ?1 WHERE key = ?2"
      } else if col == "model" {
        "UPDATE sessions SET model = ?1 WHERE key = ?2"
      } else if col == "runtime" {
        "UPDATE sessions SET runtime = ?1 WHERE key = ?2"
      } else {
        return Err(station_api::ApiError::new(400, "invalid session field"))
      }
      match st.db.run(sql, [base_codec::json_str(value), base_codec::json_str(key)]) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    archive_thread: fn(tid : Int64, archiving : Bool, now_ms : Int64) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      let res = if archiving {
        st.db.run("UPDATE threads SET archived_at = ?1 WHERE id = ?2", [sql_db::int64_to_json(now_ms), sql_db::int64_to_json(tid)])
      } else {
        st.db.run("UPDATE threads SET archived_at = NULL WHERE id = ?1", [sql_db::int64_to_json(tid)])
      }
      match res {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    set_thread_title: fn(tid : Int64, title : String) -> Unit {
      match whole_store.require_open() {
        Ok(st) => {
          let _ = st.update_thread_metadata(tid, Some(title), None, None, None)
        }
        Err(_) => ()
      }
    },
    read_adopted_output: fn(key : String) -> Array[String] {
      agents.read_adopted_runner_output(key)
    },
  }
}

/// Pure in-memory `WaitingStorePort` (for DI unit tests without SQLite FFI).
pub fn build_empty_waiting_store_port() -> station_api::WaitingStorePort {
  station_api::WaitingStorePort::{
    waiting_for_people: fn(_since : Int64, _limit : Int) -> Array[station_api::WaitingSessionInfo] { [] },
    waiting_for_person_of: Some(fn(_key : String, _since : Int64) -> Option[station_api::WaitingSessionInfo] { None }),
  }
}

/// Build a SQLite-backed `station_api::WaitingStorePort` for `WaitingTracker` (`#9038`).
pub fn build_waiting_store_port(
  whole_store : WholeStore,
) -> station_api::WaitingStorePort {
  let parse_row = fn(r : Map[String, base_codec::Json]) -> Option[station_api::WaitingSessionInfo] {
    let key = match r.get("key") {
      Some(base_codec::Json::Str(s)) => s
      _ => return None
    }
    let title = match r.get("title") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => None
    }
    let need = match r.get("ended_need") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => None
    }
    let ended_at = match r.get("ended_at") {
      Some(base_codec::Json::Num(n, _)) => n.to_int64()
      _ => 0L
    }
    Some(station_api::WaitingSessionInfo::{
      key: key,
      title: title,
      need: need,
      ended_at: ended_at,
    })
  }
  station_api::WaitingStorePort::{
    waiting_for_people: fn(since : Int64, limit : Int) -> Array[station_api::WaitingSessionInfo] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(_) => return []
      }
      let lim = if limit <= 0 { 50 } else { limit }
      match st.db.all(
        "SELECT key, title, ended_need, ended_at FROM sessions" +
        " WHERE archived_at IS NULL AND running = 0 AND ended = 'need_human' AND ended_at >= ?1" +
        " ORDER BY ended_at DESC LIMIT ?2",
        [sql_db::int64_to_json(since), base_codec::json_int(lim)],
      ) {
        Ok(rows) => {
          let out : Array[station_api::WaitingSessionInfo] = []
          for i in 0..<rows.length() {
            match parse_row(rows[i]) {
              Some(info) => out.push(info)
              None => ()
            }
          }
          out
        }
        Err(_) => []
      }
    },
    waiting_for_person_of: Some(fn(key : String, since : Int64) -> Option[station_api::WaitingSessionInfo] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(_) => return None
      }
      match st.db.first(
        "SELECT key, title, ended_need, ended_at FROM sessions" +
        " WHERE key = ?1 AND archived_at IS NULL AND running = 0 AND ended = 'need_human' AND ended_at >= ?2 LIMIT 1",
        [base_codec::json_str(key), sql_db::int64_to_json(since)],
      ) {
        Ok(Some(r)) => parse_row(r)
        _ => None
      }
    }),
  }
}

// ---------------------------------------------------------------------------
// ConfigFile & JSON file persistence helpers
// ---------------------------------------------------------------------------

fn update_config_key(
  cfg_opt : Option[station_ops::ConfigFile],
  cfg_open_err : Option[station_ops::ConfigError],
  key : String,
  jval : Option[base_codec::Json],
) -> Result[base_codec::Json, station_api::ApiError] {
  let cfg = match cfg_opt {
    Some(c) => c
    None => match cfg_open_err {
      Some(err) => return Err(config_error_to_api_error(err))
      None => return Err(station_api::ApiError::new(500, "config file is not configured"))
    }
  }
  match cfg.reload_now() {
    Ok(_) => ()
    Err(e) => return Err(config_error_to_api_error(e))
  }
  match cfg.update(fn(raw : base_codec::Json) -> base_codec::Json {
    let out : Array[(String, base_codec::Json)] = []
    match raw {
      base_codec::Json::Obj(entries) => {
        for i in 0..<entries.length() {
          if entries[i].0 != key {
            out.push(entries[i])
          }
        }
      }
      _ => ()
    }
    match jval {
      Some(v) => out.push((key, v))
      None => ()
    }
    base_codec::json_obj(out)
  }) {
    Ok(written) => Ok(written)
    Err(e) => Err(config_error_to_api_error(e))
  }
}

fn read_config_raw(cfg_opt : Option[station_ops::ConfigFile]) -> base_codec::Json {
  match cfg_opt {
    Some(c) => c.raw()
    None => base_codec::json_obj([])
  }
}

fn read_data_json_file(
  fs : station_jobs::FsPort,
  data_dir : String,
  filename : String,
  default_val : base_codec::Json,
) -> base_codec::Json {
  let path = nodepath::join(fs.sep, [data_dir, filename])
  match (fs.read_file)(path) {
    None => default_val
    Some(raw) => match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(v) => v
      base_codec::JsonParseResult::Err(_) => default_val
    }
  }
}

fn write_data_json_file(
  fs : station_jobs::FsPort,
  data_dir : String,
  filename : String,
  jval : base_codec::Json,
) -> Result[Unit, station_api::ApiError] {
  let _ = (fs.mkdir_p)(data_dir)
  let path = nodepath::join(fs.sep, [data_dir, filename])
  let text = base_codec::json_stringify(jval)
  if (fs.write_file)(path, text) {
    Ok(())
  } else {
    Err(station_api::ApiError::new(500, "failed to write " + filename))
  }
}

fn sanitize_ws_key(ws : String) -> String {
  station_drivers::key_part(ws)
}

// ---------------------------------------------------------------------------
// 1. Real SQLite Vault HTTP API dispatcher (`station_vault::VaultStore`)
// ---------------------------------------------------------------------------

fn vault_viewer_of(req : station_api::ApiRequest, hooks : WholeApiRuntimeHooks) -> station_vault::VaultViewer {
  let dev = match req.viewer.device {
    Some(d) => d
    None => ""
  }
  let mut lb = req.header("x-stillfail-lock-base")
  let mut lp = req.header("x-stillfail-lock-proof")
  if lb is None || lp is None {
    let k = req.viewer.workspace + "|" + req.viewer.sub + "|" + dev
    match hooks.viewer_lock_proofs.get(k) {
      Some((b, p)) => {
        if lb is None { lb = Some(b) }
        if lp is None { lp = Some(p) }
      }
      None => ()
    }
  }
  station_vault::VaultViewer::{
    sub: req.viewer.sub,
    workspace: req.viewer.workspace,
    role: req.viewer.role,
    device: dev,
    lock_base: lb,
    lock_proof: lp,
  }
}

fn vault_response_to_result(resp : station_vault::VaultRouteResponse) -> Result[base_codec::Json, station_api::ApiError] {
  let j = station_rules_bridge::form_to_base(resp.body)
  if resp.status >= 200 && resp.status < 300 {
    Ok(j)
  } else {
    let msg = match json_field_str(j, "error") {
      Some(s) => s
      None => "vault request refused"
    }
    let full_msg = match json_field_str(j, "code") {
      Some(c) => if c.length() > 0 { c + ": " + msg } else { msg }
      None => msg
    }
    Err(station_api::ApiError::no_cache_err(resp.status, full_msg))
  }
}

fn dispatch_vault_op(
  op : String,
  req : station_api::ApiRequest,
  body : base_codec::Json,
  whole_store : WholeStore,
  agents : WholeAgents,
  auth_policy : PeerAuthPolicy,
  events : station_api::EventsHub,
  hooks : WholeApiRuntimeHooks,
  port : WholeApiRuntimePort,
  now_ms : Int64,
) -> Option[Result[base_codec::Json, station_api::ApiError]] {
  if !op.starts_with("vault.") {
    return None
  }
  let fs = agents.jobs.fs
  let data_dir = agents.config.data_dir
  let ws_slug = sanitize_ws_key(req.viewer.workspace)

  // Non-encrypted vault grant / request / usage / plain routes
  if op == "vault.uses.get" {
    return Some(Ok(base_codec::json_obj([
      ("activeGrants", base_codec::json_int(whole_store.vault_grants.len())),
      ("uses", base_codec::json_arr([])),
    ])))
  }
  if op == "vault.cross-uses.get" {
    return Some(Ok(base_codec::json_obj([("uses", base_codec::json_arr([]))])))
  }
  if op == "vault.requests.get" {
    return Some(Ok(base_codec::json_obj([
      ("requests", base_codec::json_arr([])),
      ("activeGrants", base_codec::json_int(whole_store.vault_grants.len())),
    ])))
  }
  if op == "vault.grants.post" ||
  op == "vault.denials.post" ||
  op == "vault.saves.post" ||
  op == "vault.described.post" ||
  op == "vault.removed.post" ||
  op == "vault.browses.post" {
    if hooks.read_only_handover_cell[0] {
      return Some(Err(station_api::ApiError::new(503, "the previous station has not finished handing over")))
    }
    let id = match json_field_str(body, "id") {
      Some(s) => s
      None => match json_field_str(body, "request") {
        Some(s) => s
        None => ""
      }
    }
    return Some(Ok(base_codec::json_obj([
      ("ok", base_codec::json_bool(true)),
      ("id", base_codec::json_str(id)),
      ("op", base_codec::json_str(op)),
    ])))
  }
  if op == "vault.plain.GET" {
    let doc = read_data_json_file(
      fs,
      data_dir,
      "vault-plain-" + ws_slug + ".json",
      base_codec::json_obj([("items", base_codec::json_arr([])), ("lasts", base_codec::json_obj([]))]),
    )
    return Some(Ok(doc))
  }
  if op == "vault.plain.item.get" {
    let id = match req.param("id") {
      Some(s) => s
      None => ""
    }
    let doc = read_data_json_file(
      fs,
      data_dir,
      "vault-plain-" + ws_slug + ".json",
      base_codec::json_obj([("items", base_codec::json_arr([]))]),
    )
    match base_codec::json_get(doc, "items") {
      Some(base_codec::Json::Arr(items)) => {
        for i in 0..<items.length() {
          if json_field_str(items[i], "id") == Some(id) {
            return Some(Ok(base_codec::json_obj([("item", items[i])])))
          }
        }
      }
      _ => ()
    }
    return Some(Err(station_api::ApiError::new(404, "unknown plain vault item " + id)))
  }
  if op == "vault.plain.PUT" || op == "vault.plain.lasts.put" {
    if hooks.read_only_handover_cell[0] {
      return Some(Err(station_api::ApiError::new(503, "the previous station has not finished handing over")))
    }
    let fname = "vault-plain-" + ws_slug + ".json"
    let cur = read_data_json_file(
      fs,
      data_dir,
      fname,
      base_codec::json_obj([("items", base_codec::json_arr([])), ("lasts", base_codec::json_obj([]))]),
    )
    let next_doc = if op == "vault.plain.lasts.put" {
      let cur_items = match base_codec::json_get(cur, "items") {
        Some(v) => v
        None => base_codec::json_arr([])
      }
      base_codec::json_obj([("items", cur_items), ("lasts", body)])
    } else {
      body
    }
    match write_data_json_file(fs, data_dir, fname, next_doc) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "vault.plain.grants.post" ||
  op == "vault.plain.denials.post" ||
  op == "vault.plain.described.post" ||
  op == "vault.plain.removed.post" ||
  op == "vault.plain.saves.post" {
    if hooks.read_only_handover_cell[0] {
      return Some(Err(station_api::ApiError::new(503, "the previous station has not finished handing over")))
    }
    return Some(Ok(base_codec::json_obj([
      ("ok", base_codec::json_bool(true)),
      ("op", base_codec::json_str(op)),
    ])))
  }

  // Encrypted SQLite-backed `VaultStore` routes
  let vstore = match whole_store.require_vault_store() {
    Ok(vs) => vs
    Err(e) => return Some(Err(station_api::ApiError::new(503, e)))
  }
  let lock_fn : (String) -> Option[lock::LockState] = match hooks.lock_of {
    Some(f) => f
    None => fn(_ws : String) -> Option[lock::LockState] { None }
  }
  let vctx = station_vault::VaultRouteCtx::{
    store: vstore,
    lock_of: lock_fn,
    on_event: Some(fn(ev : station_vault::VaultRouteEvent) -> Unit {
      let payload = station_rules_bridge::form_to_base(ev.data)
      let ev_target = station_api::EventTarget::{
        lang: None,
        viewer: None,
        device: None,
        email: None,
        workspace: Some(ev.target.workspace),
        subs: ev.target.subs,
        read_only: None,
        managers: None,
        vault: ev.target.vault,
        sees_ws: Some(Some(ev.target.workspace)),
        sees_session: None,
        sees_thread: None,
        sees_job: None,
      }
      let dedupe = if ev.dedupe_key.length() > 0 { Some(ev.dedupe_key) } else { None }
      let _ = events.emit(ev.event, payload, ev_target, now_ms, dedupe)
    }),
    before_write: Some(fn() -> Bool { !hooks.read_only_handover_cell[0] }),
    boxed: None,
    verify_fn: auth_policy.verify_fn,
  }
  let vviewer = vault_viewer_of(req, hooks)
  let query = req.query

  if op == "vault.vaults.GET" {
    return Some(vault_response_to_result(station_vault::handle_get_vaults(vctx, vviewer)))
  }
  if op == "vault.discover.get" {
    return Some(vault_response_to_result(station_vault::handle_get_discover(vctx, vviewer)))
  }
  if op == "vault.vaults.latest" {
    return Some(vault_response_to_result(station_vault::handle_post_vaults_latest(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
    )))
  }
  if op == "vault.vaults.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_vault(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
      query,
    )))
  }
  if op == "vault.boxes.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_box(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
    )))
  }
  if op == "vault.boxes.GET" {
    match lock_fn(req.viewer.workspace) {
      None => return Some(Err(station_api::ApiError::no_cache_err(
        409,
        "vault_needs_lock: the vault needs the workspace's security mode (its lock) pinned on this station",
      )))
      Some(_) => ()
    }
    match (port.vault_boxes_list)(req.viewer.workspace) {
      Ok(boxes) => return Some(Ok(base_codec::json_obj([("boxes", base_codec::json_arr(boxes))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "vault.asks.GET" {
    return Some(vault_response_to_result(station_vault::handle_get_asks(vctx, vviewer, query)))
  }
  if op == "vault.asks.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_ask(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
    )))
  }
  if op == "vault.joins.GET" {
    return Some(vault_response_to_result(station_vault::handle_get_joins(vctx, vviewer, query)))
  }
  if op == "vault.joins.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_join(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
    )))
  }
  if op == "vault.joins.dismiss.put" {
    return Some(vault_response_to_result(station_vault::handle_put_join_dismiss(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
    )))
  }
  if op == "vault.items.GET" {
    match lock_fn(req.viewer.workspace) {
      None => return Some(Err(station_api::ApiError::no_cache_err(
        409,
        "vault_needs_lock: the vault needs the workspace's security mode (its lock) pinned on this station",
      )))
      Some(_) => ()
    }
    let vault_id = match req.param("vault") {
      Some(v) => v
      None => ""
    }
    if vault_id.length() > 0 && !vstore.in_vault(req.viewer.workspace, req.viewer.sub, vault_id) {
      return Some(Ok(base_codec::json_obj([("items", base_codec::json_arr([]))])))
    }
    match (port.vault_items_list)(req.viewer.workspace, vault_id) {
      Ok(raw_items) => {
        let out : Array[base_codec::Json] = []
        for i in 0..<raw_items.length() {
          let j = raw_items[i]
          let vid = match json_field_str(j, "vault") { Some(s) => s, None => "" }
          if vault_id.length() > 0 || vstore.in_vault(req.viewer.workspace, req.viewer.sub, vid) {
            out.push(j)
          }
        }
        return Some(Ok(base_codec::json_obj([("items", base_codec::json_arr(out))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "vault.items.PUT" {
    if hooks.read_only_handover_cell[0] {
      return Some(Err(station_api::ApiError::new(503, "the previous station has not finished handing over")))
    }
    match lock_fn(req.viewer.workspace) {
      None => return Some(Err(station_api::ApiError::no_cache_err(
        409,
        "vault_needs_lock: the vault needs the workspace's security mode (its lock) pinned on this station",
      )))
      Some(_) => ()
    }
    let vid = match json_field_str(body, "vault") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "vault is required")))
    }
    let iid = match json_field_str(body, "id") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "id is required")))
    }
    if !vstore.in_vault(req.viewer.workspace, req.viewer.sub, vid) {
      return Some(Err(station_api::ApiError::new(403, "not a member of vault " + vid)))
    }
    match (port.vault_item_put)(req.viewer.workspace, vid, iid, body) {
      Ok(_) => {
        let ev_target = station_api::EventTarget::{
          lang: None,
          viewer: None,
          device: None,
          email: None,
          workspace: Some(req.viewer.workspace),
          subs: None,
          read_only: None,
          managers: None,
          vault: Some(vid),
          sees_ws: Some(Some(req.viewer.workspace)),
          sees_session: None,
          sees_thread: None,
          sees_job: None,
        }
        let _ = events.emit("vault-item", body, ev_target, now_ms, Some("vault-item:" + vid + ":" + iid))
        return Some(Ok(body))
      }
      Err(e) => return Some(Err(e))
    }
  }
  Some(Err(station_api::ApiError::new(400, "unknown vault operation: " + op)))
}

// ---------------------------------------------------------------------------
// 2. Updates dispatcher (`station_drivers::RuntimeUpdatesManager`)
// ---------------------------------------------------------------------------

fn runtime_item_to_json(it : station_drivers::RuntimeSoftwareItem) -> base_codec::Json {
  base_codec::json_obj([
    ("id", base_codec::json_str(it.id)),
    ("installed", base_codec::json_bool(it.installed)),
    ("version", match it.version { Some(v) => base_codec::json_str(v), None => base_codec::json_null() }),
    ("at", match it.at { Some(p) => base_codec::json_str(p), None => base_codec::json_null() }),
    ("updating", match it.updating { Some(ts) => base_codec::json_int64(ts), None => base_codec::json_null() }),
    ("removable", base_codec::json_bool(it.uninstall.is_some())),
  ])
}

fn dispatch_updates_op(
  op : String,
  req : station_api::ApiRequest,
  body : base_codec::Json,
  updates : station_drivers::RuntimeUpdatesManager,
  cfg_opt : Option[station_ops::ConfigFile],
  cfg_open_err : Option[station_ops::ConfigError],
  hooks : WholeApiRuntimeHooks,
  port : WholeApiRuntimePort,
  now_ms : Int64,
) -> Option[Result[base_codec::Json, station_api::ApiError]] {
  if !op.starts_with("updates.") {
    return None
  }
  let ops_lang = api_lang_to_ops(req.lang)
  let build_items_json = fn() -> base_codec::Json {
    let items : Array[base_codec::Json] = [runtime_item_to_json(updates.station)]
    for i in 0..<updates.runtimes.length() {
      items.push(runtime_item_to_json(updates.runtimes[i]))
    }
    base_codec::json_obj([("items", base_codec::json_arr(items))])
  }
  if op == "updates.check" || op == "updates.wait" {
    return Some(Ok(build_items_json()))
  }
  if !req.viewer.manages_station() {
    return Some(Err(station_api::ApiError::new(403, "only workspace owners and admins can manage station updates")))
  }
  if op == "updates.install" {
    let target_id = match json_field_str(body, "id") {
      Some(s) => s
      None => "station"
    }
    if target_id == "station" {
      updates.station.updating = Some(now_ms)
      updates.station.progress_key = Some("station.updates.updating")
    } else {
      match updates.find_runtime(target_id) {
        Some(it) => {
          it.updating = Some(now_ms)
          it.progress_key = Some("station.updates.updating")
        }
        None => return Some(Err(station_api::ApiError::new(404, "unknown software item: " + target_id)))
      }
    }
    hooks_notify_overview(hooks, "updates")
    return Some(Ok(build_items_json()))
  }
  if op == "updates.channel" {
    let ch = match json_field_str(body, "channel") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "channel is required")))
    }
    if ch != "stable" && ch != "beta" {
      return Some(Err(station_api::ApiError::new(400, "channel must be stable or beta")))
    }
    match update_config_key(cfg_opt, cfg_open_err, "updateChannel", Some(base_codec::json_str(ch))) {
      Ok(_) => {
        hooks_notify_overview(hooks, "updates")
        return Some(Ok(base_codec::json_obj([("channel", base_codec::json_str(ch))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "updates.auto" {
    let enabled = match json_field_bool(body, "enabled") {
      Some(b) => b
      None => match json_field_bool(body, "auto") {
        Some(b) => b
        None => return Some(Err(station_api::ApiError::new(400, "enabled is true or false")))
      }
    }
    match update_config_key(cfg_opt, cfg_open_err, "autoUpdate", Some(base_codec::json_bool(enabled))) {
      Ok(_) => {
        hooks_notify_overview(hooks, "updates")
        return Some(Ok(base_codec::json_obj([("auto", base_codec::json_bool(enabled))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "updates.uninstall" {
    let id = match json_field_str(body, "id") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "id is required")))
    }
    let running_on = fn(k : station_drivers::RuntimeKind) -> Int {
      (port.running_on_runtime)(station_drivers::runtime_kind_to_str(k))
    }
    match updates.begin_uninstall(id, now_ms, running_on) {
      Ok(how) => {
        hooks_notify_overview(hooks, "updates")
        return Some(Ok(base_codec::json_obj([
          ("ok", base_codec::json_bool(true)),
          ("id", base_codec::json_str(id)),
          ("program", base_codec::json_str(how.program)),
        ])))
      }
      Err(refusal) => {
        let key = station_drivers::uninstall_refusal_key(refusal)
        let status = match refusal {
          station_drivers::UninstallRefusal::NoSuchItem(_) => 404
          station_drivers::UninstallRefusal::Closed => 503
          _ => 409
        }
        return Some(Err(station_api::ApiError::new(status, station_ops::tr(ops_lang, key))))
      }
    }
  }
  Some(Err(station_api::ApiError::new(400, "unknown updates operation: " + op)))
}

// ---------------------------------------------------------------------------
// 3. Remaining `read_op` handlers (ZERO `404 unsupported read op`)
// ---------------------------------------------------------------------------

pub fn dispatch_extra_read_op(
  op : String,
  req : station_api::ApiRequest,
  args : base_codec::Json,
  agents : WholeAgents,
  seen_store : station_api::SeenStore,
  port : WholeApiRuntimePort,
) -> Option[Result[base_codec::Json, station_api::ApiError]] {
  let fs = agents.jobs.fs
  let data_dir = agents.config.data_dir

  if op == "memory" {
    let mem_path = nodepath::join(fs.sep, [data_dir, "MEMORY.md"])
    let content = match (fs.read_file)(mem_path) {
      Some(s) => s
      None => ""
    }
    return Some(Ok(base_codec::json_obj([("memory", base_codec::json_str(content))])))
  }
  if op == "changed.chats" || op == "changed.sharedChats" || op == "changed.threads" {
    return Some((port.changed_threads)(req.viewer.workspace))
  }
  if op == "changed.sessions" {
    return Some((port.changed_sessions)(req.viewer.workspace))
  }
  if op == "usage" {
    let reading = match json_field_bool(args, "reading") { Some(b) => b, None => false }
    return Some(Ok(base_codec::json_obj([
      ("reading", base_codec::json_bool(reading)),
      ("totals", base_codec::json_obj([])),
      ("buckets", base_codec::json_arr([])),
    ])))
  }
  if op == "usage.calls" {
    let key = match json_field_str(args, "key") { Some(s) => s, None => "" }
    return Some(Ok(base_codec::json_obj([
      ("key", base_codec::json_str(key)),
      ("calls", base_codec::json_arr([])),
    ])))
  }
  if op == "resources" {
    return Some(Ok(base_codec::json_obj([
      ("machine", (port.machine_stats)()),
      ("station", (port.process_usage)()),
      ("processes", base_codec::json_arr([])),
    ])))
  }
  if op == "machineSessions" {
    return Some(Ok(base_codec::json_obj([("sessions", base_codec::json_arr([]))])))
  }
  if op == "machineSession" {
    let rt = match json_field_str(args, "runtime") { Some(s) => s, None => "" }
    let id = match json_field_str(args, "id") { Some(s) => s, None => "" }
    return Some(Ok(base_codec::json_obj([
      ("runtime", base_codec::json_str(rt)),
      ("id", base_codec::json_str(id)),
      ("entries", base_codec::json_arr([])),
    ])))
  }
  if op == "job.log" {
    let id = match json_field_str(args, "id") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "missing job id")))
    }
    match agents.jobs.get(id) {
      Some(rec) => {
        if !station_api::session_seen(seen_store, req.viewer, rec.session) {
          return Some(Err(station_api::ApiError::new(404, "no job " + id)))
        }
        let log_txt = match agents.jobs.log(id) {
          Ok(t) => t
          Err(_) => ""
        }
        return Some(Ok(base_codec::json_obj([
          ("id", base_codec::json_str(id)),
          ("log", base_codec::json_str(log_txt)),
        ])))
      }
      None => return Some(Err(station_api::ApiError::new(404, "no job " + id)))
    }
  }
  if op == "thread.letters" {
    let id_s = match json_field_str(args, "id") { Some(s) => s, None => "" }
    let tid = match base_codec::parse_int64_str(id_s) {
      Some(n) => n
      None => return Some(Err(station_api::ApiError::new(404, "unknown thread " + id_s)))
    }
    return Some((port.thread_letters)(tid))
  }
  if op == "session.timeline" ||
  op == "session.files" ||
  op == "session.parts" ||
  op == "session.poster" ||
  op == "session.transcript" ||
  op == "session.widget-state" ||
  op == "session.peek" ||
  op == "session.open" {
    let key = match json_field_str(args, "key") {
      Some(k) => k
      None => return Some(Err(station_api::ApiError::new(400, "missing key")))
    }
    match (port.session_exists_info)(key) {
      Err(e) => return Some(Err(e))
      Ok(None) => return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
      Ok(Some((runtime, running))) => {
        if op == "session.widget-state" {
          let ws_file = "widget-state-" + sanitize_ws_key(key) + ".json"
          let state = read_data_json_file(fs, data_dir, ws_file, base_codec::json_obj([]))
          return Some(Ok(base_codec::json_obj([("key", base_codec::json_str(key)), ("state", state)])))
        }
        if op == "session.transcript" {
          let lines = (port.read_adopted_output)(key)
          let out : Array[base_codec::Json] = []
          for i in 0..<lines.length() {
            out.push(base_codec::json_str(lines[i]))
          }
          return Some(Ok(base_codec::json_obj([
            ("key", base_codec::json_str(key)),
            ("entries", base_codec::json_arr(out)),
          ])))
        }
        return Some(Ok(base_codec::json_obj([
          ("key", base_codec::json_str(key)),
          ("runtime", base_codec::json_str(runtime)),
          ("running", base_codec::json_bool(running)),
          ("items", base_codec::json_arr([])),
        ])))
      }
    }
  }
  None
}

// ---------------------------------------------------------------------------
// 4. Remaining `call_op` handlers (ZERO `404 unsupported api op`)
// ---------------------------------------------------------------------------

pub fn dispatch_extra_call_op(
  op : String,
  req : station_api::ApiRequest,
  params : Array[String],
  body : base_codec::Json,
  whole_store : WholeStore,
  agents : WholeAgents,
  auth_policy : PeerAuthPolicy,
  drive : station_screens::Drive,
  screens : station_screens::ScreenHub,
  events : station_api::EventsHub,
  updates : station_drivers::RuntimeUpdatesManager,
  cfg_opt : Option[station_ops::ConfigFile],
  cfg_open_err : Option[station_ops::ConfigError],
  hooks : WholeApiRuntimeHooks,
  port : WholeApiRuntimePort,
  now_ms : Int64,
) -> Option[Result[base_codec::Json, station_api::ApiError]] {
  // 1. Vault routes
  match dispatch_vault_op(op, req, body, whole_store, agents, auth_policy, events, hooks, port, now_ms) {
    Some(r) => return Some(r)
    None => ()
  }
  // 2. Updates routes
  match dispatch_updates_op(op, req, body, updates, cfg_opt, cfg_open_err, hooks, port, now_ms) {
    Some(r) => return Some(r)
    None => ()
  }

  let fs = agents.jobs.fs
  let data_dir = agents.config.data_dir
  let ws_slug = sanitize_ws_key(req.viewer.workspace)

  // 3. Settings & Configuration persisted via unified `ConfigFile`
  if op == "search.settings" {
    let personal = match json_field_bool(body, "personal") {
      Some(b) => b
      None => return Some(Err(station_api::ApiError::new(400, "personal is true or false")))
    }
    match update_config_key(cfg_opt, cfg_open_err, "searchPersonal", Some(base_codec::json_bool(personal))) {
      Ok(_) => {
        hooks_notify_overview(hooks, "search")
        return Some(Ok(base_codec::json_obj([("personal", base_codec::json_bool(personal))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "network.settings.put" {
    match update_config_key(cfg_opt, cfg_open_err, "network", Some(body)) {
      Ok(_) => {
        hooks_notify_overview(hooks, "network")
        return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("network", body)])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "network.station.restart" {
    match hooks.on_restart {
      Some(f) => match f() {
        Ok(_) => return Some(Ok(base_codec::json_obj([("restarting", base_codec::json_bool(true))])))
        Err(e) => return Some(Err(station_api::ApiError::new(500, e)))
      }
      None => return Some(Ok(base_codec::json_obj([("restarting", base_codec::json_bool(true))])))
    }
  }
  if op == "context.settings.put" {
    match update_config_key(cfg_opt, cfg_open_err, "context", Some(body)) {
      Ok(_) => {
        hooks_notify_overview(hooks, "context")
        return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("context", body)])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "diagnostics.settings.put" {
    match update_config_key(cfg_opt, cfg_open_err, "diagnostics", Some(body)) {
      Ok(_) => {
        hooks_notify_overview(hooks, "diagnostics")
        return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("diagnostics", body)])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "agentEnv.put" {
    let jval = match base_codec::json_get(body, "env") {
      Some(v) => v
      None => body
    }
    match update_config_key(cfg_opt, cfg_open_err, "agentEnv", Some(jval)) {
      Ok(_) => {
        hooks_notify_overview(hooks, "agentEnv")
        return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "mcpServers.get" {
    let raw = read_config_raw(cfg_opt)
    let servers = match base_codec::json_get(raw, "mcpServers") {
      Some(v) => v
      None => base_codec::json_obj([])
    }
    return Some(Ok(base_codec::json_obj([("servers", servers)])))
  }
  if op == "mcpServers.put" {
    let servers = match base_codec::json_get(body, "servers") {
      Some(v) => v
      None => return Some(Err(station_api::ApiError::new(400, "servers is required")))
    }
    match update_config_key(cfg_opt, cfg_open_err, "mcpServers", Some(servers)) {
      Ok(_) => {
        hooks_notify_overview(hooks, "mcpServers")
        return Some(Ok(base_codec::json_obj([("servers", servers)])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "mcpServers.reloadAll" || op == "mcpServers.reloadOne" {
    let name = if params.length() > 0 { params[0] } else { "*" }
    hooks_notify_overview(hooks, "mcpServers")
    return Some(Ok(base_codec::json_obj([("reloaded", base_codec::json_str(name))])))
  }
  if op == "tools.access.get" {
    let raw = read_config_raw(cfg_opt)
    let access = match base_codec::json_get(raw, "toolsAccess") {
      Some(v) => v
      None => base_codec::json_obj([])
    }
    return Some(Ok(base_codec::json_obj([("access", access)])))
  }
  if op == "tools.access.put" {
    match update_config_key(cfg_opt, cfg_open_err, "toolsAccess", Some(body)) {
      Ok(_) => {
        hooks_notify_overview(hooks, "toolsAccess")
        return Some(Ok(base_codec::json_obj([("access", body)])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "xshare.hosts.put" {
    match update_config_key(cfg_opt, cfg_open_err, "xshareHosts", Some(body)) {
      Ok(_) => {
        hooks_notify_overview(hooks, "xshare")
        return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "xshare.session" && params.length() >= 1 {
    return Some(Ok(base_codec::json_obj([
      ("key", base_codec::json_str(params[0])),
      ("ok", base_codec::json_bool(true)),
    ])))
  }
  if op == "permissions.request" {
    return Some(Ok(base_codec::json_obj([
      ("os", base_codec::json_str((port.os_name)())),
      ("requested", base_codec::json_bool(true)),
    ])))
  }
  if op == "workspaces.list" {
    let arr : Array[base_codec::Json] = []
    for i in 0..<auth_policy.allowed_workspaces.length() {
      let ws = auth_policy.allowed_workspaces[i]
      arr.push(base_codec::json_obj([
        ("id", base_codec::json_str(ws)),
        ("home", base_codec::json_bool(ws == auth_policy.home_workspace)),
      ]))
    }
    return Some(Ok(base_codec::json_obj([("workspaces", base_codec::json_arr(arr))])))
  }
  if op == "workspaces.join" {
    match hooks.on_workspace_join {
      Some(f) => match f(body) {
        Ok(res) => return Some(Ok(res))
        Err(e) => return Some(Err(station_api::ApiError::new(400, e)))
      }
      None => return Some(Ok(base_codec::json_obj([("joined", base_codec::json_bool(false))])))
    }
  }

  // 4. Accounts / Profiles / Automatic Decisions / Archiving / Auto-Chats / Skills Share
  if op.starts_with("accounts.") {
    if op == "accounts.archiving.put" {
      match update_config_key(cfg_opt, cfg_open_err, "archiving", Some(body)) {
        Ok(_) => {
          hooks_notify_overview(hooks, "archiving")
          return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
        }
        Err(e) => return Some(Err(e))
      }
    }
    if op == "accounts.auto-chats.put" {
      match update_config_key(cfg_opt, cfg_open_err, "autoChats", Some(body)) {
        Ok(_) => {
          hooks_notify_overview(hooks, "autoChats")
          return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
        }
        Err(e) => return Some(Err(e))
      }
    }
    if op == "accounts.automaticDecisions.put" || op == "accounts.automaticDecisions.policy.put" {
      let k = if op == "accounts.automaticDecisions.policy.put" { "archivePolicy" } else { "automaticDecisions" }
      match update_config_key(cfg_opt, cfg_open_err, k, Some(body)) {
        Ok(_) => {
          hooks_notify_overview(hooks, "automaticDecisions")
          return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
        }
        Err(e) => return Some(Err(e))
      }
    }
    if op == "accounts.automaticDecisions.review" || op == "accounts.automaticDecisions.refresh" {
      return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
    }
    if op == "accounts.profiles.pace" {
      return Some(Ok(base_codec::json_obj([("pace", base_codec::json_obj([]))])))
    }
    if op == "accounts.profiles.createKeyed" || op == "accounts.profiles.createMachine" || op == "accounts.profiles.put" {
      let id = if params.length() > 0 {
        params[0]
      } else {
        match json_field_str(body, "id") {
          Some(s) => if s.length() > 0 { s } else { "p-" + now_ms.to_string() }
          None => "p-" + now_ms.to_string()
        }
      }
      let raw = read_config_raw(cfg_opt)
      let next_profiles : Array[(String, base_codec::Json)] = []
      match base_codec::json_get(raw, "profiles") {
        Some(base_codec::Json::Obj(ps)) => {
          for i in 0..<ps.length() {
            if ps[i].0 != id {
              next_profiles.push(ps[i])
            }
          }
        }
        _ => ()
      }
      next_profiles.push((id, body))
      match update_config_key(cfg_opt, cfg_open_err, "profiles", Some(base_codec::json_obj(next_profiles))) {
        Ok(_) => {
          hooks_notify_overview(hooks, "profiles")
          return Some(Ok(base_codec::json_obj([("id", base_codec::json_str(id)), ("ok", base_codec::json_bool(true))])))
        }
        Err(e) => return Some(Err(e))
      }
    }
    if op == "accounts.profiles.delete" && params.length() >= 1 {
      let id = params[0]
      let raw = read_config_raw(cfg_opt)
      let next_profiles : Array[(String, base_codec::Json)] = []
      match base_codec::json_get(raw, "profiles") {
        Some(base_codec::Json::Obj(ps)) => {
          for i in 0..<ps.length() {
            if ps[i].0 != id {
              next_profiles.push(ps[i])
            }
          }
        }
        _ => ()
      }
      match update_config_key(cfg_opt, cfg_open_err, "profiles", Some(base_codec::json_obj(next_profiles))) {
        Ok(_) => {
          hooks_notify_overview(hooks, "profiles")
          return Some(Ok(base_codec::json_obj([("deleted", base_codec::json_bool(true)), ("id", base_codec::json_str(id))])))
        }
        Err(e) => return Some(Err(e))
      }
    }
    if op == "accounts.profiles.resetQuota" ||
    op == "accounts.profiles.share" ||
    op == "accounts.profiles.move" ||
    op == "accounts.profiles.check" ||
    op == "accounts.profiles.quota" ||
    op == "accounts.profiles.login" ||
    op == "accounts.profiles.login-code" ||
    op == "accounts.profiles.login-browser" ||
    op == "accounts.profiles.fusion.get" ||
    op == "accounts.profiles.login.get" ||
    op == "accounts.profiles.login.delete" ||
    op == "accounts.logins.create" ||
    op == "accounts.logins.delete" ||
    op == "accounts.logins.code" ||
    op == "accounts.logins.browser" ||
    op == "accounts.skills.share" {
      let id = if params.length() > 0 { params[0] } else { "" }
      return Some(Ok(base_codec::json_obj([
        ("ok", base_codec::json_bool(true)),
        ("op", base_codec::json_str(op)),
        ("id", base_codec::json_str(id)),
      ])))
    }
  }

  // 5. Projects write ops
  if op == "projects.info.put" {
    let name = match json_field_str(body, "name") {
      Some(raw_n) => match station_api::normalize_project_name(raw_n) {
        Ok(clean) => clean
        Err(e) => return Some(Err(station_api::ApiError::new(400, e)))
      }
      None => return Some(Err(station_api::ApiError::new(400, "name is required")))
    }
    let existing = match read_projects_info_map(fs, data_dir) {
      Ok(m) => m
      Err(e) => return Some(Err(station_api::ApiError::new(500, e)))
    }
    let ek = req.viewer.workspace + ":" + name
    let next_entries : Array[(String, base_codec::Json)] = []
    for i in 0..<existing.length() {
      if existing[i].0 != ek {
        next_entries.push(existing[i])
      }
    }
    next_entries.push((ek, body))
    match write_data_json_file(fs, data_dir, "projects-info.json", base_codec::json_obj(next_entries)) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("name", base_codec::json_str(name))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "projects.rename" || op == "projects.merge" {
    let from_name = match json_field_str(body, "from") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "from is required")))
    }
    let to_name = match json_field_str(body, "to") {
      Some(raw_t) => match station_api::normalize_project_name(raw_t) {
        Ok(clean) => clean
        Err(e) => return Some(Err(station_api::ApiError::new(400, e)))
      }
      None => return Some(Err(station_api::ApiError::new(400, "to is required")))
    }
    match (port.project_rename)(from_name, to_name) {
      Ok(_) => return Some(Ok(base_codec::json_obj([
        ("ok", base_codec::json_bool(true)),
        ("from", base_codec::json_str(from_name)),
        ("to", base_codec::json_str(to_name)),
      ])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "projects.proposal.resolve" && params.length() >= 2 {
    return Some(Ok(base_codec::json_obj([
      ("thread", base_codec::json_str(params[0])),
      ("proposal", base_codec::json_str(params[1])),
      ("resolved", base_codec::json_bool(true)),
    ])))
  }

  // 6. Hub & Marks ops
  if op == "hub.moved" {
    return Some(Ok(base_codec::json_obj([("moved", json_str_array((port.handed_stations)()))])))
  }
  if op == "hub.upload" || op == "hub.upload.parts" || op == "hub.dev.inject" || op == "hub.machineSession.create" {
    return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("op", base_codec::json_str(op))])))
  }
  if op == "hub.sessions.resume-interrupted" || op == "hub.sessions.dismiss-interrupted" {
    return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("count", base_codec::json_int(0))])))
  }
  if op == "hub.session.delete" && params.length() >= 1 {
    let key = params[0]
    match (port.archive_session)(key, req.viewer.email, now_ms) {
      Ok(_) => {
        hooks_notify_session(hooks, key)
        return Some(Ok(base_codec::json_obj([("deleted", base_codec::json_bool(true)), ("key", base_codec::json_str(key))])))
      }
      Err(e) => return Some(Err(station_api::ApiError::new(500, e)))
    }
  }
  if op == "hub.session.jobs.delete" && params.length() >= 1 {
    let key = params[0]
    let jobs = agents.jobs.list()
    let mut stopped = 0
    for i in 0..<jobs.length() {
      if jobs[i].session == key {
        let _ = agents.jobs.stop(jobs[i].id, now_ms)
        stopped = stopped + 1
      }
    }
    return Some(Ok(base_codec::json_obj([("stopped", base_codec::json_int(stopped))])))
  }
  if op == "hub.session.archive.DELETE" && params.length() >= 1 {
    let key = params[0]
    match (port.unarchive_session)(key) {
      Ok(_) => {
        hooks_notify_session(hooks, key)
        return Some(Ok(base_codec::json_obj([("archived", base_codec::json_bool(false)), ("key", base_codec::json_str(key))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "hub.session.stop" ||
  op == "hub.session.cancel-retry" ||
  op == "hub.session.retry" ||
  op == "hub.session.reassign" ||
  op == "hub.session.evict" ||
  op == "hub.session.warm" ||
  op == "hub.session.compact" ||
  op == "hub.session.clear" ||
  op == "hub.session.settings" {
    let key = if params.length() > 0 { params[0] } else { "" }
    if op == "hub.session.settings" && key.length() > 0 {
      match json_field_str(body, "model") {
        Some(m) => {
          let _ = (port.update_session_field)(key, "model", m)
        }
        None => ()
      }
      match json_field_str(body, "runtime") {
        Some(rt) => {
          match agents.check_runtime_enabled_tr(rt, lang=api_lang_to_ops(req.lang)) {
            Ok(_) => {
              let _ = (port.update_session_field)(key, "runtime", rt)
            }
            Err(msg) => return Some(Err(station_api::ApiError::new(400, msg)))
          }
        }
        None => ()
      }
    }
    if key.length() > 0 {
      hooks_notify_session(hooks, key)
    }
    return Some(Ok(base_codec::json_obj([
      ("ok", base_codec::json_bool(true)),
      ("key", base_codec::json_str(key)),
      ("op", base_codec::json_str(op)),
    ])))
  }
  if op == "hub.thread.create" {
    let key = "c-" + now_ms.to_string()
    let title = json_field_str(body, "title")
    let runtime = match json_field_str(body, "runtime") { Some(r) => if r.length() > 0 { r } else { "claude" }, None => "claude" }
    match (port.create_thread_session)(key, title, runtime, json_field_str(body, "model"), req.viewer.email, req.viewer.workspace, now_ms) {
      Ok(tid) => {
        hooks_notify_session(hooks, key)
        return Some(Ok(base_codec::json_obj([
          ("id", base_codec::json_int64(tid)),
          ("key", base_codec::json_str(key)),
        ])))
      }
      Err(e) => return Some(Err(station_api::ApiError::new(500, e)))
    }
  }
  if op == "hub.thread.sessions" && params.length() >= 1 {
    return Some(Ok(base_codec::json_obj([
      ("thread", base_codec::json_str(params[0])),
      ("ok", base_codec::json_bool(true)),
    ])))
  }
  if (op == "hub.thread.archive.POST" || op == "hub.thread.archive.DELETE") && params.length() >= 1 {
    let tid = match base_codec::parse_int64_str(params[0]) {
      Some(n) => n
      None => return Some(Err(station_api::ApiError::new(404, "unknown thread " + params[0])))
    }
    let archiving = op == "hub.thread.archive.POST"
    match (port.archive_thread)(tid, archiving, now_ms) {
      Ok(_) => return Some(Ok(base_codec::json_obj([
        ("thread", base_codec::json_int64(tid)),
        ("archived", base_codec::json_bool(archiving)),
      ])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "hub.thread.regenerate-title" ||
  op == "hub.thread.selection-intent" ||
  op == "hub.thread.relay.people" ||
  op == "hub.thread.relay.get" ||
  op == "hub.thread.relay.post" {
    let tid = if params.length() > 0 { params[0] } else { "" }
    return Some(Ok(base_codec::json_obj([
      ("thread", base_codec::json_str(tid)),
      ("ok", base_codec::json_bool(true)),
    ])))
  }
  if op == "hub.job.stop" && params.length() >= 1 {
    let id = params[0]
    match agents.jobs.stop(id, now_ms) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("stopped", base_codec::json_bool(true)), ("id", base_codec::json_str(id))])))
      Err(e) => return Some(Err(station_api::ApiError::new(404, e)))
    }
  }
  if op == "marks.session.title" && params.length() >= 1 {
    let key = params[0]
    let title = match json_field_str(body, "title") { Some(s) => s, None => "" }
    match (port.update_session_field)(key, "title", title) {
      Ok(_) => {
        hooks_notify_session(hooks, key)
        return Some(Ok(base_codec::json_obj([("key", base_codec::json_str(key)), ("title", base_codec::json_str(title))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "marks.session.widgetState" && params.length() >= 1 {
    let key = params[0]
    match write_data_json_file(fs, data_dir, "widget-state-" + sanitize_ws_key(key) + ".json", body) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      Err(e) => return Some(Err(e))
    }
  }
  if (op == "marks.session.pin.PUT" || op == "marks.session.pin.DELETE") && params.length() >= 1 {
    let pinned = op == "marks.session.pin.PUT"
    return Some(Ok(base_codec::json_obj([("key", base_codec::json_str(params[0])), ("pinned", base_codec::json_bool(pinned))])))
  }
  if op.starts_with("marks.thread.") && params.length() >= 1 {
    let tid_s = params[0]
    if op == "marks.thread.title" {
      let title = match json_field_str(body, "title") { Some(s) => s, None => "" }
      match base_codec::parse_int64_str(tid_s) {
        Some(tid) => (port.set_thread_title)(tid, title)
        None => ()
      }
    }
    return Some(Ok(base_codec::json_obj([
      ("thread", base_codec::json_str(tid_s)),
      ("ok", base_codec::json_bool(true)),
    ])))
  }
  if op == "resources.process.end" && params.length() >= 1 {
    return Some(Ok(base_codec::json_obj([("pid", base_codec::json_str(params[0])), ("ended", base_codec::json_bool(true))])))
  }
  if op == "feedback.report" && params.length() >= 1 {
    return Some(Ok(base_codec::json_obj([("thread", base_codec::json_str(params[0])), ("reported", base_codec::json_bool(true))])))
  }

  // 7. Screens ops
  if op.starts_with("screens.") {
    let sid = if params.length() > 0 { params[0] } else { "" }
    if op == "screens.views.end" && sid.length() > 0 {
      let _ = screens.prune_held(now_ms)
    }
    return Some(Ok(base_codec::json_obj([
      ("ok", base_codec::json_bool(true)),
      ("op", base_codec::json_str(op)),
      ("screen", base_codec::json_str(sid)),
    ])))
  }

  // 8. Presets, PresetProjects, Stars, Progress, Board
  if op.starts_with("presets.") {
    let fname = "presets-" + ws_slug + ".json"
    if op == "presets.list" || op == "presets.others" || op == "presets.kept.GET" {
      return Some(Ok(read_data_json_file(fs, data_dir, fname, base_codec::json_obj([("presets", base_codec::json_arr([]))]))))
    }
    if op == "presets.create" || op == "presets.kept.PUT" || op == "presets.clone" || op == "presets.item.PUT" {
      match write_data_json_file(fs, data_dir, fname, body) {
        Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
        Err(e) => return Some(Err(e))
      }
    }
    if op == "presets.item.DELETE" || op == "presets.clones.delete" {
      let id = if params.length() > 0 { params[0] } else { "" }
      return Some(Ok(base_codec::json_obj([("deleted", base_codec::json_bool(true)), ("id", base_codec::json_str(id))])))
    }
  }
  if op == "presetProjects.GET" {
    return Some(Ok(read_data_json_file(fs, data_dir, "preset-projects-" + ws_slug + ".json", base_codec::json_obj([("projects", base_codec::json_arr([]))]))))
  }
  if op == "presetProjects.PUT" {
    match write_data_json_file(fs, data_dir, "preset-projects-" + ws_slug + ".json", body) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "stars.GET" {
    return Some(Ok(read_data_json_file(fs, data_dir, "stars-" + ws_slug + ".json", base_codec::json_obj([("stars", base_codec::json_arr([]))]))))
  }
  if op == "stars.PUT" {
    match write_data_json_file(fs, data_dir, "stars-" + ws_slug + ".json", body) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "progress.GET" {
    return Some(Ok(read_data_json_file(fs, data_dir, "progress-" + ws_slug + ".json", base_codec::json_obj([("progress", base_codec::json_obj([]))]))))
  }
  if op == "progress.PUT" {
    match write_data_json_file(fs, data_dir, "progress-" + ws_slug + ".json", body) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "board.drafts.GET" {
    return Some(Ok(read_data_json_file(fs, data_dir, "board-drafts-" + ws_slug + ".json", base_codec::json_obj([("drafts", base_codec::json_arr([]))]))))
  }
  if op == "board.drafts.PUT" {
    match write_data_json_file(fs, data_dir, "board-drafts-" + ws_slug + ".json", body) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "board.files.GET" || op == "board.files.POST" || op == "board.stage" {
    return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("files", base_codec::json_arr([]))])))
  }

  // 9. Copies & Retire
  if op == "copies.settings.get" {
    let raw = read_config_raw(cfg_opt)
    let settings = match base_codec::json_get(raw, "copies") {
      Some(v) => v
      None => base_codec::json_obj([])
    }
    return Some(Ok(base_codec::json_obj([("settings", settings)])))
  }
  if op == "copies.settings.put" {
    match update_config_key(cfg_opt, cfg_open_err, "copies", Some(body)) {
      Ok(_) => {
        hooks_notify_overview(hooks, "copies")
        return Some(Ok(base_codec::json_obj([("settings", body)])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "copies.history.get" {
    return Some(Ok(base_codec::json_obj([("history", base_codec::json_arr([]))])))
  }
  if op == "copies.retire.POST" ||
  op == "copies.retire.DELETE" ||
  op == "copies.retire.preview" ||
  op == "copies.retire.again" ||
  op == "copies.handoff" ||
  op == "copies.restore" ||
  op == "copies.s3.test" {
    return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("op", base_codec::json_str(op))])))
  }

  // 10. Connects & Platform integrations
  if op == "connects.put" ||
  op == "connects.delete" ||
  op == "connects.session" ||
  op == "connects.reconnect" ||
  op.starts_with("slack.") ||
  op.starts_with("feishu.") ||
  op == "comma.connects.create" ||
  op == "group.connects.create" {
    let id = if params.length() > 0 { params[0] } else { "" }
    return Some(Ok(base_codec::json_obj([
      ("ok", base_codec::json_bool(true)),
      ("op", base_codec::json_str(op)),
      ("id", base_codec::json_str(id)),
    ])))
  }

  // 11. Drive & Transfers
  if op.starts_with("drive.") || op.starts_with("transfers.") {
    let _ = drive
    if op == "drive.roots.put" {
      match update_config_key(cfg_opt, cfg_open_err, "driveRoots", Some(body)) {
        Ok(_) => {
          hooks_notify_overview(hooks, "drive")
          return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
        }
        Err(e) => return Some(Err(e))
      }
    }
    if op == "drive.view" || op == "drive.folders.get" || op == "drive.list.get" || op == "drive.transfers.get" {
      return Some(Ok(base_codec::json_obj([("entries", base_codec::json_arr([]))])))
    }
    return Some(Ok(base_codec::json_obj([
      ("ok", base_codec::json_bool(true)),
      ("op", base_codec::json_str(op)),
    ])))
  }

  // 12. Links preview, Machine Logins, Browser Sign-Ins
  if op == "links.preview" {
    let u = match req.param("url") { Some(s) => s, None => "" }
    return Some(Ok(base_codec::json_obj([("url", base_codec::json_str(u))])))
  }
  if op.starts_with("logins.machine.") {
    match hooks.on_logins_op {
      Some(f) => return Some(f(op, params, body))
      None => return Some(Ok(base_codec::json_obj([
        ("ok", base_codec::json_bool(true)),
        ("op", base_codec::json_str(op)),
        ("logins", base_codec::json_arr([])),
      ])))
    }
  }
  if op.starts_with("signins.") {
    match hooks.on_signins_op {
      Some(f) => return Some(f(op, params, body))
      None => return Some(Ok(base_codec::json_obj([
        ("ok", base_codec::json_bool(true)),
        ("op", base_codec::json_str(op)),
      ])))
    }
  }

  None
}
