// Production HTTP API operation handlers for `WholeApi` (`station_whole`):
// - Real SQLite-backed Vault (`station_vault::VaultStore` + connection-bound `lock::admit` viewer
//   proof + `before_write` handover 503 gate + structured JSON conflict payloads + `vault-item` /
//   `vault-box` / `vault` / `vault-gone` / `vault-ask` / `vault-join` SSE)
// - Plain Vault per-(ws, owner) isolation, redacted list, version CAS, security-mode delete-only
// - Real `station_drivers::RuntimeUpdatesManager` (`updates.check/wait/channel/auto/uninstall`)
// - Unified `station_ops::ConfigFile` atomic read-modify-write mutations with redaction (`mcpServers`,
//   `agentEnv`, `copies.settings`, `drive.roots.put`, `accounts.profiles.*`, `network/context/diagnostics`)
// - Shared SQLite preference tables (`model_stars`, `progress_prefs`, `preset_projects`, `board_drafts`,
//   `widget_states`, `archive_policy`, `project_rename_events`) + strict workspace visibility checks
// - Honest `501 Not Implemented` for all operations not yet wired end-to-end (ZERO fake 200 stubs).

import "base_codec"
import "form"
import "lock"
import "nodepath"
import "sql_db"
import "station_api"
import "station_drivers"
import "station_jobs"
import "station_ops"
import "station_rules_bridge"
import "station_screens"
import "station_sessions"
import "station_sys"
import "station_vault"

/// Mutable runtime hooks attached to `WholeApi` so `whole_daemon` can inject live daemon
/// capabilities (pinned workspace locks, restart trigger, workspace join, machine logins,
/// browser sign-ins, hot Drive roots) without cyclic package imports.
pub struct WholeApiRuntimeHooks {
  pub mut lock_of : Option[(String) -> Option[lock::LockState]]
  pub mut chains_of : Option[(String) -> form::Json]
  pub mut on_restart : Option[() -> Result[Unit, String]]
  pub mut on_workspace_join : Option[(base_codec::Json) -> Result[base_codec::Json, String]]
  pub mut on_logins_op : Option[(String, Array[String], base_codec::Json) -> Result[base_codec::Json, station_api::ApiError]]
  pub mut on_signins_op : Option[(String, Array[String], base_codec::Json) -> Result[base_codec::Json, station_api::ApiError]]
  pub mut on_session_changed : Option[(String) -> Unit]
  pub mut on_overview_dirty : Option[(String) -> Unit]
  pub mut on_drive_roots_changed : Option[(String, Array[String]) -> Unit]
  pub mut read_only_handover_cell : Array[Bool]
}

pub fn WholeApiRuntimeHooks::new() -> WholeApiRuntimeHooks {
  WholeApiRuntimeHooks::{
    lock_of: None,
    chains_of: None,
    on_restart: None,
    on_workspace_join: None,
    on_logins_op: None,
    on_signins_op: None,
    on_session_changed: None,
    on_overview_dirty: None,
    on_drive_roots_changed: None,
    read_only_handover_cell: [true],
  }
}

fn hooks_notify_session(hooks : WholeApiRuntimeHooks, key : String) -> Unit {
  match hooks.on_session_changed {
    Some(f) => f(key)
    None => ()
  }
}

fn hooks_notify_overview(hooks : WholeApiRuntimeHooks, reason : String) -> Unit {
  match hooks.on_overview_dirty {
    Some(f) => f(reason)
    None => ()
  }
}

fn err_not_implemented(op : String) -> station_api::ApiError {
  station_api::ApiError::new(501, op + " is not yet implemented on Pion station")
}

/// Narrow storage + OS port consumed by `dispatch_extra_read_op` and `dispatch_extra_call_op`.
/// Production `WholeApi::new` wires `WholeApiRuntimePort::production(...)` over real SQLite +
/// `station_sys`; pure unit tests wire `WholeApiRuntimePort::in_memory(...)`.
pub struct WholeApiRuntimePort {
  pub os_name : () -> String
  pub random_hex : (Int) -> String
  pub machine_stats : () -> base_codec::Json
  pub process_usage : () -> base_codec::Json
  pub running_on_runtime : (String) -> Int
  pub changed_threads : (String) -> Result[base_codec::Json, station_api::ApiError]
  pub changed_sessions : (String) -> Result[base_codec::Json, station_api::ApiError]
  pub thread_letters : (Int64) -> Result[base_codec::Json, station_api::ApiError]
  pub session_exists_info : (String) -> Result[Option[(String, Bool)], station_api::ApiError]
  pub project_rename : (String, String, String, String, Int64) -> Result[Unit, station_api::ApiError]
  pub handed_stations : () -> Array[String]
  pub create_thread_session : (String, Option[String], String, Option[String], String, String, Int64) -> Result[Int64, String]
  pub archive_session : (String, String, Int64) -> Result[Unit, String]
  pub unarchive_session : (String) -> Result[Unit, station_api::ApiError]
  pub update_session_field : (String, String, String) -> Result[Unit, station_api::ApiError]
  pub archive_thread : (Int64, Bool, Int64) -> Result[Unit, station_api::ApiError]
  pub set_thread_title : (Int64, String) -> Unit
  pub read_adopted_output : (String) -> Array[String]
  pub get_stars : (String, String) -> Result[base_codec::Json, station_api::ApiError]
  pub put_stars : (String, String, base_codec::Json) -> Result[Unit, station_api::ApiError]
  pub get_progress : (String, String) -> Result[base_codec::Json, station_api::ApiError]
  pub put_progress : (String, String, String, base_codec::Json) -> Result[Unit, station_api::ApiError]
  pub get_preset_projects : (String, String) -> Result[base_codec::Json, station_api::ApiError]
  pub put_preset_projects : (String, String, base_codec::Json) -> Result[Unit, station_api::ApiError]
  pub get_board_drafts : (String, String) -> Result[base_codec::Json, station_api::ApiError]
  pub put_board_drafts : (String, String, base_codec::Json) -> Result[Unit, station_api::ApiError]
  pub get_widget_state : (String, String) -> Result[base_codec::Json, station_api::ApiError]
  pub put_widget_state : (String, String, base_codec::Json, Int64) -> Result[Unit, station_api::ApiError]
  pub put_archive_policy : (Option[String], String, String, String, Int64) -> Result[Unit, station_api::ApiError]
}

pub fn WholeApiRuntimePort::in_memory() -> WholeApiRuntimePort {
  let stars_mem : Map[String, base_codec::Json] = Map::new()
  let progress_mem : Map[String, base_codec::Json] = Map::new()
  let pp_mem : Map[String, base_codec::Json] = Map::new()
  let drafts_mem : Map[String, base_codec::Json] = Map::new()
  let widgets_mem : Map[String, base_codec::Json] = Map::new()
  let policy_mem : Map[String, String] = Map::new()
  let rng_counter : Array[Int] = [1]
  WholeApiRuntimePort::{
    os_name: fn() -> String { "linux" },
    random_hex: fn(_n : Int) -> String {
      let c = rng_counter[0]
      rng_counter[0] = c + 1
      "deadbeef" + c.to_string()
    },
    machine_stats: fn() -> base_codec::Json { base_codec::json_obj([]) },
    process_usage: fn() -> base_codec::Json { base_codec::json_obj([]) },
    running_on_runtime: fn(_rt : String) -> Int { 0 },
    changed_threads: fn(_ws : String) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([("total", base_codec::json_int(0)), ("changed", base_codec::json_arr([]))]))
    },
    changed_sessions: fn(_ws : String) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([("changed", base_codec::json_arr([]))]))
    },
    thread_letters: fn(_tid : Int64) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([("letters", base_codec::json_arr([]))]))
    },
    session_exists_info: fn(_key : String) -> Result[Option[(String, Bool)], station_api::ApiError] {
      Ok(Some(("claude", false)))
    },
    project_rename: fn(_ws : String, _action : String, _from : String, _to : String, _now : Int64) -> Result[Unit, station_api::ApiError] {
      Ok(())
    },
    handed_stations: fn() -> Array[String] { [] },
    create_thread_session: fn(_k : String, _t : Option[String], _rt : String, _m : Option[String], _e : String, _ws : String, _now : Int64) -> Result[Int64, String] {
      Ok(1L)
    },
    archive_session: fn(_k : String, _e : String, _now : Int64) -> Result[Unit, String] { Ok(()) },
    unarchive_session: fn(_k : String) -> Result[Unit, station_api::ApiError] { Ok(()) },
    update_session_field: fn(_k : String, _col : String, _v : String) -> Result[Unit, station_api::ApiError] { Ok(()) },
    archive_thread: fn(_tid : Int64, _arch : Bool, _now : Int64) -> Result[Unit, station_api::ApiError] { Ok(()) },
    set_thread_title: fn(_tid : Int64, _title : String) -> Unit { () },
    read_adopted_output: fn(_key : String) -> Array[String] { [] },
    get_stars: fn(ws : String, sub : String) -> Result[base_codec::Json, station_api::ApiError] {
      match stars_mem.get(ws + "|" + sub) {
        Some(v) => Ok(v)
        None => Ok(base_codec::json_arr([]))
      }
    },
    put_stars: fn(ws : String, sub : String, v : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      stars_mem.set(ws + "|" + sub, v)
      Ok(())
    },
    get_progress: fn(ws : String, sub : String) -> Result[base_codec::Json, station_api::ApiError] {
      match progress_mem.get(ws + "|" + sub) {
        Some(v) => Ok(v)
        None => Ok(base_codec::json_obj([]))
      }
    },
    put_progress: fn(ws : String, sub : String, _email : String, v : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      progress_mem.set(ws + "|" + sub, v)
      Ok(())
    },
    get_preset_projects: fn(ws : String, sub : String) -> Result[base_codec::Json, station_api::ApiError] {
      match pp_mem.get(ws + "|" + sub) {
        Some(v) => Ok(v)
        None => Ok(base_codec::json_arr([]))
      }
    },
    put_preset_projects: fn(ws : String, sub : String, v : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      pp_mem.set(ws + "|" + sub, v)
      Ok(())
    },
    get_board_drafts: fn(ws : String, sub : String) -> Result[base_codec::Json, station_api::ApiError] {
      match drafts_mem.get(ws + "|" + sub) {
        Some(v) => Ok(v)
        None => Ok(base_codec::json_arr([]))
      }
    },
    put_board_drafts: fn(ws : String, sub : String, v : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      drafts_mem.set(ws + "|" + sub, v)
      Ok(())
    },
    get_widget_state: fn(key : String, path : String) -> Result[base_codec::Json, station_api::ApiError] {
      match widgets_mem.get(key + "|" + path) {
        Some(v) => Ok(v)
        None => Ok(base_codec::json_obj([]))
      }
    },
    put_widget_state: fn(key : String, path : String, v : base_codec::Json, _now : Int64) -> Result[Unit, station_api::ApiError] {
      widgets_mem.set(key + "|" + path, v)
      Ok(())
    },
    put_archive_policy: fn(ws_opt : Option[String], policy : String, _author : String, _summary : String, _now : Int64) -> Result[Unit, station_api::ApiError] {
      let k = match ws_opt { Some(w) => w, None => "__home__" }
      policy_mem.set(k, policy)
      Ok(())
    },
  }
}

pub fn WholeApiRuntimePort::production(
  whole_store : WholeStore,
  agents : WholeAgents,
  home_ws_str : String,
) -> WholeApiRuntimePort {
  WholeApiRuntimePort::{
    os_name: station_sys::os_name,
    random_hex: fn(n : Int) -> String {
      match station_sys::random_hex(n) {
        Ok(h) => h
        Err(_) => "000000000000"
      }
    },
    machine_stats: fn() -> base_codec::Json {
      match base_codec::json_parse(station_sys::machine_stats_json()) {
        base_codec::JsonParseResult::Ok(j) => j
        _ => base_codec::json_obj([])
      }
    },
    process_usage: fn() -> base_codec::Json {
      match base_codec::json_parse(station_sys::process_usage_json([])) {
        base_codec::JsonParseResult::Ok(j) => j
        _ => base_codec::json_obj([])
      }
    },
    running_on_runtime: fn(rt_s : String) -> Int {
      match whole_store.require_open() {
        Ok(st) => match st.db.first(
          "SELECT COUNT(*) AS cnt FROM sessions WHERE archived_at IS NULL AND running = 1 AND runtime = ?1",
          [base_codec::json_str(rt_s)],
        ) {
          Ok(Some(r)) => match r.get("cnt") {
            Some(base_codec::Json::Num(n, _)) => n.to_int()
            _ => 0
          }
          _ => 0
        }
        Err(_) => 0
      }
    },
    changed_threads: fn(ws : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.search_chat_threads(Some(ws), Some(home_ws_str), "", station_store::ChatListFilter::empty(), 100) {
        Ok((threads, total)) => {
          let items : Array[base_codec::Json] = []
          for i in 0..<threads.length() {
            items.push(thread_row_to_json(threads[i]))
          }
          Ok(base_codec::json_obj([("total", base_codec::json_int(total)), ("changed", base_codec::json_arr(items))]))
        }
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    changed_sessions: fn(ws : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.all(
        "SELECT key, title, runtime, running, last_active_at FROM sessions WHERE COALESCE(ws, ?1) = ?2 ORDER BY last_active_at DESC LIMIT 100",
        [base_codec::json_str(home_ws_str), base_codec::json_str(ws)],
      ) {
        Ok(rows) => {
          let items : Array[base_codec::Json] = []
          for i in 0..<rows.length() {
            let r = rows[i]
            items.push(base_codec::json_obj([
              ("key", match r.get("key") { Some(v) => v, None => base_codec::json_str("") }),
              ("runtime", match r.get("runtime") { Some(v) => v, None => base_codec::json_str("") }),
              ("running", match r.get("running") { Some(v) => v, None => base_codec::json_int(0) }),
            ]))
          }
          Ok(base_codec::json_obj([("changed", base_codec::json_arr(items))]))
        }
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    thread_letters: fn(tid : Int64) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.all(
        "SELECT n, author_kind, author, text, at FROM entries WHERE thread = ?1 AND kind = 'letter' ORDER BY n ASC LIMIT 200",
        [sql_db::int64_to_json(tid)],
      ) {
        Ok(rows) => {
          let out : Array[base_codec::Json] = []
          for i in 0..<rows.length() {
            let r = rows[i]
            out.push(base_codec::json_obj([
              ("n", match r.get("n") { Some(v) => v, None => base_codec::json_int(0) }),
              ("authorKind", match r.get("author_kind") { Some(v) => v, None => base_codec::json_str("") }),
              ("author", match r.get("author") { Some(v) => v, None => base_codec::json_str("") }),
              ("text", match r.get("text") { Some(v) => v, None => base_codec::json_str("") }),
              ("at", match r.get("at") { Some(v) => v, None => base_codec::json_int(0) }),
            ]))
          }
          Ok(base_codec::json_obj([("letters", base_codec::json_arr(out))]))
        }
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    session_exists_info: fn(key : String) -> Result[Option[(String, Bool)], station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.get_session(key) {
        Ok(Some(row)) => Ok(Some((row.runtime, row.running)))
        Ok(None) => Ok(None)
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    project_rename: fn(
      ws : String,
      action : String,
      from_name : String,
      to_name : String,
      now_ms : Int64,
    ) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      let tx_res = st.db.tx(fn(txdb : sql_db::Db) -> Result[Unit, sql_db::SqlError] {
        // Respect `thread_visible_in_ws` `threads.home` priority so joined workspaces never touch
        // threads whose `threads.home` belongs to another workspace.
        match txdb.run(
          "UPDATE threads SET project = ?1 WHERE project = ?2 AND (CASE" +
          " WHEN threads.home IS NOT NULL THEN EXISTS (SELECT 1 FROM sessions h WHERE h.key = threads.home AND COALESCE(h.ws, ?3) = ?4)" +
          " WHEN NOT EXISTS (SELECT 1 FROM thread_sessions ts WHERE ts.thread = threads.id) THEN ?4 = ?3" +
          " ELSE EXISTS (SELECT 1 FROM thread_sessions ts LEFT JOIN sessions s ON s.key = ts.session WHERE ts.thread = threads.id AND COALESCE(s.ws, ?3) = ?4) END)",
          [
            base_codec::json_str(to_name),
            base_codec::json_str(from_name),
            base_codec::json_str(home_ws_str),
            base_codec::json_str(ws),
          ],
        ) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        // Record workspace-scoped CRDT event in `project_rename_events`.
        match txdb.run(
          "INSERT INTO project_rename_events (workspace, action, from_name, to_name, renamed_at, wall_at, local_updated) VALUES (?1, ?2, ?3, ?4, ?5, ?6, 1)",
          [
            base_codec::json_str(ws),
            base_codec::json_str(action),
            base_codec::json_str(from_name),
            base_codec::json_str(to_name),
            sql_db::int64_to_json(now_ms),
            sql_db::int64_to_json(now_ms),
          ],
        ) {
          Ok(_) => Ok(())
          Err(e) => Err(e)
        }
      })
      match tx_res {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    handed_stations: fn() -> Array[String] {
      match whole_store.handed_stations() {
        Ok(hs) => hs
        Err(_) => []
      }
    },
    create_thread_session: fn(
      key : String,
      title : Option[String],
      runtime : String,
      model : Option[String],
      email : String,
      ws : String,
      now_ms : Int64,
    ) -> Result[Int64, String] {
      match agents.create_session(
        whole_store,
        key,
        "chat",
        title,
        Some(email),
        runtime,
        "default",
        model,
        agents.config.data_dir,
        Some(ws),
        now_ms,
      ) {
        Ok((_, tid)) => Ok(tid)
        Err(e) => Err(e)
      }
    },
    archive_session: fn(key : String, email : String, now_ms : Int64) -> Result[Unit, String] {
      agents.archive_session(whole_store, key, email, now_ms)
    },
    unarchive_session: fn(key : String) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run("UPDATE sessions SET archived_at = NULL, archived_by = NULL WHERE key = ?1", [base_codec::json_str(key)]) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    update_session_field: fn(key : String, col : String, value : String) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      let sql = if col == "title" {
        "UPDATE sessions SET title = ?1 WHERE key = ?2"
      } else if col == "model" {
        "UPDATE sessions SET model = ?1 WHERE key = ?2"
      } else if col == "runtime" {
        "UPDATE sessions SET runtime = ?1 WHERE key = ?2"
      } else {
        return Err(station_api::ApiError::new(400, "invalid session field"))
      }
      match st.db.run(sql, [base_codec::json_str(value), base_codec::json_str(key)]) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    archive_thread: fn(tid : Int64, archiving : Bool, now_ms : Int64) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      let res = if archiving {
        st.db.run("UPDATE threads SET archived_at = ?1 WHERE id = ?2", [sql_db::int64_to_json(now_ms), sql_db::int64_to_json(tid)])
      } else {
        st.db.run("UPDATE threads SET archived_at = NULL WHERE id = ?1", [sql_db::int64_to_json(tid)])
      }
      match res {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    set_thread_title: fn(tid : Int64, title : String) -> Unit {
      match whole_store.require_open() {
        Ok(st) => {
          let _ = st.update_thread_metadata(tid, Some(title), None, None, None)
        }
        Err(_) => ()
      }
    },
    read_adopted_output: fn(key : String) -> Array[String] {
      agents.read_adopted_runner_output(key)
    },
    get_stars: fn(ws : String, sub : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.first("SELECT stars FROM model_stars WHERE ws = ?1 AND sub = ?2", [base_codec::json_str(ws), base_codec::json_str(sub)]) {
        Ok(Some(row)) => match row.get("stars") {
          Some(base_codec::Json::Str(raw)) => match base_codec::json_parse(raw) {
            base_codec::JsonParseResult::Ok(j) => Ok(j)
            _ => Ok(base_codec::json_arr([]))
          }
          _ => Ok(base_codec::json_arr([]))
        }
        Ok(None) => Ok(base_codec::json_arr([]))
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    put_stars: fn(ws : String, sub : String, v : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run(
        "INSERT INTO model_stars (ws, sub, stars) VALUES (?1, ?2, ?3) ON CONFLICT(ws, sub) DO UPDATE SET stars = excluded.stars",
        [base_codec::json_str(ws), base_codec::json_str(sub), base_codec::json_str(base_codec::json_stringify(v))],
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    get_progress: fn(ws : String, sub : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.first("SELECT json FROM progress_prefs WHERE ws = ?1 AND sub = ?2", [base_codec::json_str(ws), base_codec::json_str(sub)]) {
        Ok(Some(row)) => match row.get("json") {
          Some(base_codec::Json::Str(raw)) => match base_codec::json_parse(raw) {
            base_codec::JsonParseResult::Ok(j) => Ok(j)
            _ => Ok(base_codec::json_obj([]))
          }
          _ => Ok(base_codec::json_obj([]))
        }
        Ok(None) => Ok(base_codec::json_obj([]))
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    put_progress: fn(ws : String, sub : String, email : String, v : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run(
        "INSERT INTO progress_prefs (ws, sub, email, json) VALUES (?1, ?2, ?3, ?4) ON CONFLICT(ws, sub) DO UPDATE SET email = excluded.email, json = excluded.json",
        [base_codec::json_str(ws), base_codec::json_str(sub), base_codec::json_str(email), base_codec::json_str(base_codec::json_stringify(v))],
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    get_preset_projects: fn(ws : String, sub : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.first("SELECT json FROM preset_projects WHERE workspace = ?1 AND sub = ?2", [base_codec::json_str(ws), base_codec::json_str(sub)]) {
        Ok(Some(row)) => match row.get("json") {
          Some(base_codec::Json::Str(raw)) => match base_codec::json_parse(raw) {
            base_codec::JsonParseResult::Ok(j) => Ok(j)
            _ => Ok(base_codec::json_arr([]))
          }
          _ => Ok(base_codec::json_arr([]))
        }
        Ok(None) => Ok(base_codec::json_arr([]))
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    put_preset_projects: fn(ws : String, sub : String, v : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run(
        "INSERT INTO preset_projects (workspace, sub, json) VALUES (?1, ?2, ?3) ON CONFLICT(workspace, sub) DO UPDATE SET json = excluded.json",
        [base_codec::json_str(ws), base_codec::json_str(sub), base_codec::json_str(base_codec::json_stringify(v))],
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    get_board_drafts: fn(ws : String, sub : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.first("SELECT drafts FROM board_drafts WHERE ws = ?1 AND sub = ?2", [base_codec::json_str(ws), base_codec::json_str(sub)]) {
        Ok(Some(row)) => match row.get("drafts") {
          Some(base_codec::Json::Str(raw)) => match base_codec::json_parse(raw) {
            base_codec::JsonParseResult::Ok(j) => Ok(j)
            _ => Ok(base_codec::json_arr([]))
          }
          _ => Ok(base_codec::json_arr([]))
        }
        Ok(None) => Ok(base_codec::json_arr([]))
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    put_board_drafts: fn(ws : String, sub : String, v : base_codec::Json) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run(
        "INSERT INTO board_drafts (ws, sub, drafts) VALUES (?1, ?2, ?3) ON CONFLICT(ws, sub) DO UPDATE SET drafts = excluded.drafts",
        [base_codec::json_str(ws), base_codec::json_str(sub), base_codec::json_str(base_codec::json_stringify(v))],
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    get_widget_state: fn(key : String, path : String) -> Result[base_codec::Json, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.first("SELECT state FROM widget_states WHERE session = ?1 AND path = ?2", [base_codec::json_str(key), base_codec::json_str(path)]) {
        Ok(Some(row)) => match row.get("state") {
          Some(base_codec::Json::Str(raw)) => match base_codec::json_parse(raw) {
            base_codec::JsonParseResult::Ok(j) => Ok(j)
            _ => Ok(base_codec::json_obj([]))
          }
          _ => Ok(base_codec::json_obj([]))
        }
        Ok(None) => Ok(base_codec::json_obj([]))
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    put_widget_state: fn(key : String, path : String, v : base_codec::Json, now_ms : Int64) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      match st.db.run(
        "INSERT INTO widget_states (session, path, state, updated_at) VALUES (?1, ?2, ?3, ?4) ON CONFLICT(session, path) DO UPDATE SET state = excluded.state, updated_at = excluded.updated_at",
        [base_codec::json_str(key), base_codec::json_str(path), base_codec::json_str(base_codec::json_stringify(v)), sql_db::int64_to_json(now_ms)],
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
    put_archive_policy: fn(ws_opt : Option[String], policy : String, author : String, summary : String, now_ms : Int64) -> Result[Unit, station_api::ApiError] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(e) => return Err(station_api::ApiError::new(503, e))
      }
      let ws_param = match ws_opt {
        Some(w) => base_codec::json_str(w)
        None => base_codec::json_null()
      }
      match st.db.run(
        "INSERT INTO archive_policy (at, policy, author, summary, ws) VALUES (?1, ?2, ?3, ?4, ?5)",
        [
          sql_db::int64_to_json(now_ms),
          base_codec::json_str(policy),
          base_codec::json_str(author),
          base_codec::json_str(summary),
          ws_param,
        ],
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(station_api::ApiError::new(500, e.message))
      }
    },
  }
}

/// Pure in-memory `WaitingStorePort` (for DI unit tests without SQLite FFI).
pub fn build_empty_waiting_store_port() -> station_api::WaitingStorePort {
  station_api::WaitingStorePort::{
    waiting_for_people: fn(_since : Int64, _limit : Int) -> Array[station_api::WaitingSessionInfo] { [] },
    waiting_for_person_of: Some(fn(_key : String, _since : Int64) -> Option[station_api::WaitingSessionInfo] { None }),
  }
}

/// Build a workspace-isolated SQLite-backed `station_api::WaitingStorePort` for `WaitingTracker` (`#9038`).
/// Matches `station_store/src/store.pion:1034-1047` (joining `sessions` with the latest row in `turns`)
/// scoped strictly to `COALESCE(s.ws, home_ws) = ws`.
pub fn build_waiting_store_port(
  whole_store : WholeStore,
  ws : String,
  home_ws : String,
) -> station_api::WaitingStorePort {
  let parse_row = fn(r : Map[String, base_codec::Json]) -> Option[station_api::WaitingSessionInfo] {
    let key = match r.get("key") {
      Some(base_codec::Json::Str(s)) => s
      _ => return None
    }
    let title = match r.get("title") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => None
    }
    let need = match r.get("need") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => None
    }
    let ended_at = match r.get("ended_at") {
      Some(base_codec::Json::Num(n, _)) => n.to_int64()
      _ => 0L
    }
    Some(station_api::WaitingSessionInfo::{
      key: key,
      title: title,
      need: need,
      ended_at: ended_at,
    })
  }
  station_api::WaitingStorePort::{
    waiting_for_people: fn(since : Int64, limit : Int) -> Array[station_api::WaitingSessionInfo] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(_) => return []
      }
      let lim = if limit <= 0 { 50 } else { limit }
      match st.db.all(
        "SELECT s.key, s.title, t.need, t.ended_at" +
        " FROM sessions s" +
        " JOIN turns t ON t.rowid = (SELECT rowid FROM turns WHERE session_key = s.key ORDER BY started_at DESC, rowid DESC LIMIT 1)" +
        " WHERE s.archived_at IS NULL AND s.running = 0" +
        " AND COALESCE(s.ws, ?1) = ?2" +
        " AND t.ended_at IS NOT NULL AND t.ended_at >= ?3" +
        " AND t.declared IN ('block', 'need_help', 'need_human', 'need_decision')" +
        " AND NOT EXISTS (SELECT 1 FROM deliveries d WHERE d.session = s.key AND d.delivered_at IS NULL)" +
        " ORDER BY t.ended_at DESC, s.key ASC LIMIT ?4",
        [base_codec::json_str(home_ws), base_codec::json_str(ws), sql_db::int64_to_json(since), base_codec::json_int(lim)],
      ) {
        Ok(rows) => {
          let out : Array[station_api::WaitingSessionInfo] = []
          for i in 0..<rows.length() {
            match parse_row(rows[i]) {
              Some(info) => out.push(info)
              None => ()
            }
          }
          out
        }
        Err(_) => []
      }
    },
    waiting_for_person_of: Some(fn(key : String, since : Int64) -> Option[station_api::WaitingSessionInfo] {
      let st = match whole_store.require_open() {
        Ok(s) => s
        Err(_) => return None
      }
      match st.db.first(
        "SELECT s.key, s.title, t.need, t.ended_at" +
        " FROM sessions s" +
        " JOIN turns t ON t.rowid = (SELECT rowid FROM turns WHERE session_key = s.key ORDER BY started_at DESC, rowid DESC LIMIT 1)" +
        " WHERE s.key = ?1 AND s.archived_at IS NULL AND s.running = 0" +
        " AND COALESCE(s.ws, ?2) = ?3" +
        " AND t.ended_at IS NOT NULL AND t.ended_at >= ?4" +
        " AND t.declared IN ('block', 'need_help', 'need_human', 'need_decision')" +
        " AND NOT EXISTS (SELECT 1 FROM deliveries d WHERE d.session = s.key AND d.delivered_at IS NULL)" +
        " LIMIT 1",
        [base_codec::json_str(key), base_codec::json_str(home_ws), base_codec::json_str(ws), sql_db::int64_to_json(since)],
      ) {
        Ok(Some(r)) => parse_row(r)
        _ => None
      }
    }),
  }
}

// ---------------------------------------------------------------------------
// ConfigFile & JSON file persistence helpers
// ---------------------------------------------------------------------------

fn update_config_with(
  cfg_opt : Option[station_ops::ConfigFile],
  cfg_open_err : Option[station_ops::ConfigError],
  mutate : (base_codec::Json) -> Result[base_codec::Json, station_api::ApiError],
) -> Result[base_codec::Json, station_api::ApiError] {
  let cfg = match cfg_opt {
    Some(c) => c
    None => match cfg_open_err {
      Some(err) => return Err(config_error_to_api_error(err))
      None => return Err(station_api::ApiError::new(500, "config file is not configured"))
    }
  }
  let mut validation_err : Option[station_api::ApiError] = None
  let res = cfg.try_update(fn(raw : base_codec::Json) -> Result[base_codec::Json, String] {
    match mutate(raw) {
      Ok(next) => Ok(next)
      Err(e) => {
        validation_err = Some(e)
        Err(e.message)
      }
    }
  })
  match validation_err {
    Some(e) => return Err(e)
    None => ()
  }
  match res {
    Ok(written) => Ok(written)
    Err(e) => Err(config_error_to_api_error(e))
  }
}

fn json_obj_set(obj : base_codec::Json, key : String, jval : Option[base_codec::Json]) -> base_codec::Json {
  let out : Array[(String, base_codec::Json)] = []
  match obj {
    base_codec::Json::Obj(entries) => {
      for i in 0..<entries.length() {
        if entries[i].0 != key {
          out.push(entries[i])
        }
      }
    }
    _ => ()
  }
  match jval {
    Some(v) => out.push((key, v))
    None => ()
  }
  base_codec::json_obj(out)
}

fn update_config_key(
  cfg_opt : Option[station_ops::ConfigFile],
  cfg_open_err : Option[station_ops::ConfigError],
  key : String,
  jval : Option[base_codec::Json],
) -> Result[base_codec::Json, station_api::ApiError] {
  update_config_with(cfg_opt, cfg_open_err, fn(raw : base_codec::Json) -> Result[base_codec::Json, station_api::ApiError] {
    Ok(json_obj_set(raw, key, jval))
  })
}

fn read_config_raw(cfg_opt : Option[station_ops::ConfigFile]) -> base_codec::Json {
  match cfg_opt {
    Some(c) => c.raw()
    None => base_codec::json_obj([])
  }
}

fn read_data_json_file(
  fs : station_jobs::FsPort,
  data_dir : String,
  filename : String,
  default_val : base_codec::Json,
) -> base_codec::Json {
  let path = nodepath::join(fs.sep, [data_dir, filename])
  match (fs.read_file)(path) {
    None => default_val
    Some(raw) => match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(v) => v
      base_codec::JsonParseResult::Err(_) => default_val
    }
  }
}

fn write_data_json_file(
  fs : station_jobs::FsPort,
  data_dir : String,
  filename : String,
  jval : base_codec::Json,
) -> Result[Unit, station_api::ApiError] {
  let _ = (fs.mkdir_p)(data_dir)
  let path = nodepath::join(fs.sep, [data_dir, filename])
  let text = base_codec::json_stringify(jval)
  if (fs.write_file)(path, text) {
    Ok(())
  } else {
    Err(station_api::ApiError::new(500, "failed to write " + filename))
  }
}

fn sanitize_ws_key(ws : String) -> String {
  station_drivers::key_part(ws)
}

// ---------------------------------------------------------------------------
// Redaction & Validation helpers (MCP servers, Agent Env, Copies backupView)
// ---------------------------------------------------------------------------

let MASK_DOTS : String = "••••••••"

fn mask_secret_value(v : String) -> String {
  if v.length() <= 4 {
    MASK_DOTS
  } else {
    v.slice(0, 2) + MASK_DOTS + v.slice(v.length() - 2, v.length())
  }
}

fn ascii_upper(s : String) -> String {
  let b = s.to_bytes()
  let out = Bytes::new(b.length())
  for i in 0..<b.length() {
    let c = b[i].to_int() & 0xFF
    out[i] = if c >= 97 && c <= 122 { (c - 32).to_byte() } else { b[i] }
  }
  out.to_string()
}

fn is_secret_env_key(k : String) -> Bool {
  let u = ascii_upper(k)
  u.contains("KEY") ||
  u.contains("SECRET") ||
  u.contains("TOKEN") ||
  u.contains("PASS") ||
  u.contains("AUTH") ||
  u.contains("CREDENTIAL") ||
  u.contains("PRIVATE") ||
  u.contains("COOKIE")
}

fn is_valid_env_name(name : String) -> Bool {
  let n = name.length()
  if n == 0 || n > 128 {
    return false
  }
  let c0 = name.code_unit_at(0)
  let first_ok = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95
  if !first_ok {
    return false
  }
  let mut i = 1
  while i < n {
    let c = name.code_unit_at(i)
    let ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

fn redact_string_map(obj : base_codec::Json) -> base_codec::Json {
  match obj {
    base_codec::Json::Obj(entries) => {
      let out : Array[(String, base_codec::Json)] = []
      for i in 0..<entries.length() {
        out.push((entries[i].0, base_codec::json_str(MASK_DOTS)))
      }
      base_codec::json_obj(out)
    }
    _ => obj
  }
}

/// Fail-closed redacted view of managed MCP servers (aligns with `station/src/api/routes/mcp-servers.ts`):
/// skips malformed/non-object entries, requires non-empty `command` or `url`, and emits only allowlisted
/// fields with `env` and `headers` strictly masked.
fn redact_mcp_servers_view(raw_servers : base_codec::Json) -> base_codec::Json {
  match raw_servers {
    base_codec::Json::Obj(entries) => {
      let out : Array[(String, base_codec::Json)] = []
      for i in 0..<entries.length() {
        let name = entries[i].0
        let entry = entries[i].1
        if name.length() == 0 || name.length() > 128 {
          continue
        }
        match entry {
          base_codec::Json::Obj(fields) => {
            let has_cmd = match json_field_str(entry, "command") { Some(s) => s.length() > 0, None => false }
            let has_url = match json_field_str(entry, "url") { Some(s) => s.length() > 0, None => false }
            if !has_cmd && !has_url {
              continue
            }
            let masked_fields : Array[(String, base_codec::Json)] = []
            for fi in 0..<fields.length() {
              let fk = fields[fi].0
              let fv = fields[fi].1
              if fk == "env" || fk == "headers" {
                match fv {
                  base_codec::Json::Obj(_) => masked_fields.push((fk, redact_string_map(fv)))
                  _ => ()
                }
              } else if fk == "command" || fk == "args" || fk == "url" || fk == "transport" || fk == "disabled" || fk == "cwd" {
                masked_fields.push((fk, fv))
              }
            }
            out.push((name, base_codec::json_obj(masked_fields)))
          }
          _ => ()
        }
      }
      base_codec::json_obj(out)
    }
    _ => base_codec::json_obj([])
  }
}

fn merge_masked_map(prev_opt : Option[base_codec::Json], next_map : base_codec::Json) -> base_codec::Json {
  match next_map {
    base_codec::Json::Obj(entries) => {
      let out : Array[(String, base_codec::Json)] = []
      for i in 0..<entries.length() {
        let k = entries[i].0
        let v = entries[i].1
        match v {
          base_codec::Json::Str(s) => {
            if s == MASK_DOTS {
              match prev_opt {
                Some(prev) => match base_codec::json_get(prev, k) {
                  Some(pv) => out.push((k, pv))
                  None => out.push((k, v))
                }
                None => out.push((k, v))
              }
            } else {
              out.push((k, v))
            }
          }
          _ => out.push((k, v))
        }
      }
      base_codec::json_obj(out)
    }
    _ => next_map
  }
}

fn agent_env_view_json(env_map : Map[String, String]) -> base_codec::Json {
  let ks = env_map.keys()
  let mut si = 1
  while si < ks.length() {
    let cur = ks[si]
    let mut sj = si - 1
    while sj >= 0 && ks[sj] > cur {
      ks[sj + 1] = ks[sj]
      sj = sj - 1
    }
    ks[sj + 1] = cur
    si = si + 1
  }
  let out : Array[base_codec::Json] = []
  for i in 0..<ks.length() {
    let k = ks[i]
    match env_map.get(k) {
      Some(v) => {
        let sec = is_secret_env_key(k)
        let shown_v = if sec { mask_secret_value(v) } else { v }
        out.push(base_codec::json_obj([
          ("key", base_codec::json_str(k)),
          ("value", base_codec::json_str(shown_v)),
          ("secret", base_codec::json_bool(sec)),
        ]))
      }
      None => ()
    }
  }
  base_codec::json_arr(out)
}

fn parse_env_text_lines(
  text : String,
  before : Map[String, String],
) -> Result[Map[String, String], String] {
  let next : Map[String, String] = Map::new()
  let lines = text.split("\n")
  let mut count = 0
  for i in 0..<lines.length() {
    let mut line = lines[i].trim()
    if line.length() == 0 || line.starts_with("#") {
      continue
    }
    if line.starts_with("export ") {
      line = line.slice(7, line.length()).trim()
    }
    let mut eq_idx = -1
    for j in 0..<line.length() {
      if line.code_unit_at(j) == 61 {
        eq_idx = j
        break
      }
    }
    if eq_idx <= 0 {
      return Err("line " + (i + 1).to_string() + ": expected NAME=value")
    }
    let name = line.slice(0, eq_idx).trim()
    if !is_valid_env_name(name) {
      return Err("line " + (i + 1).to_string() + ": invalid environment variable name " + name)
    }
    let mut v = line.slice(eq_idx + 1, line.length()).trim()
    if v.length() >= 2 && ((v.starts_with("\"") && v.ends_with("\"")) || (v.starts_with("'") && v.ends_with("'"))) {
      v = v.slice(1, v.length() - 1)
    }
    if v.length() > 32768 {
      return Err("line " + (i + 1).to_string() + ": value exceeds maximum length")
    }
    // Preserve prior secret value if caller left the masked placeholder unchanged.
    let final_v = match before.get(name) {
      Some(prev) => if is_secret_env_key(name) && (v == mask_secret_value(prev) || v == MASK_DOTS) { prev } else { v }
      None => v
    }
    if !next.contains(name) {
      count = count + 1
      if count > 200 {
        return Err("too many environment variables (max 200)")
      }
    }
    next.set(name, final_v)
  }
  Ok(next)
}

fn redact_backup_view(raw_cfg : base_codec::Json) -> base_codec::Json {
  let backup = match base_codec::json_get(raw_cfg, "backup") {
    Some(v) => v
    None => match base_codec::json_get(raw_cfg, "copies") {
      Some(v) => v
      None => base_codec::json_obj([])
    }
  }
  let scrub_obj = fn(o : base_codec::Json) -> base_codec::Json {
    match o {
      base_codec::Json::Obj(fs) => {
        let out : Array[(String, base_codec::Json)] = []
        for i in 0..<fs.length() {
          let fk = fs[i].0
          let fv = fs[i].1
          if fk == "secretAccessKey" || fk == "accessKeyId" || fk == "encryptionKey" || fk == "passphrase" || fk == "secret" {
            out.push(("has_" + fk, base_codec::json_bool(true)))
          } else {
            out.push((fk, fv))
          }
        }
        base_codec::json_obj(out)
      }
      _ => o
    }
  }
  match backup {
    base_codec::Json::Obj(fs) => {
      let out : Array[(String, base_codec::Json)] = []
      for i in 0..<fs.length() {
        let fk = fs[i].0
        let fv = fs[i].1
        if fk == "s3" {
          match fv {
            base_codec::Json::Arr(items) => {
              let scrubbed : Array[base_codec::Json] = []
              for j in 0..<items.length() {
                scrubbed.push(scrub_obj(items[j]))
              }
              out.push((fk, base_codec::json_arr(scrubbed)))
            }
            _ => out.push((fk, scrub_obj(fv)))
          }
        } else if fk == "secretAccessKey" || fk == "accessKeyId" || fk == "encryptionKey" || fk == "passphrase" {
          out.push(("has_" + fk, base_codec::json_bool(true)))
        } else {
          out.push((fk, fv))
        }
      }
      base_codec::json_obj(out)
    }
    _ => base_codec::json_obj([])
  }
}

// ---------------------------------------------------------------------------
// 1. Real SQLite Vault HTTP API dispatcher (`station_vault::VaultStore`)
// ---------------------------------------------------------------------------

/// Build `VaultViewer` exclusively from the connection-verified `Viewer` identity
/// (`AdminConnState`'s `lock_base`/`lock_proof`), never trusting untrusted request headers.
fn vault_viewer_of(req : station_api::ApiRequest) -> station_vault::VaultViewer {
  let dev = match req.viewer.device {
    Some(d) => d
    None => ""
  }
  station_vault::VaultViewer::{
    sub: req.viewer.sub,
    workspace: req.viewer.workspace,
    role: req.viewer.role,
    device: dev,
    lock_base: req.viewer.lock_base,
    lock_proof: req.viewer.lock_proof,
  }
}

/// Preserve structured Vault JSON error bodies (`code`, `vault`, `item`, etc.) verbatim!
fn vault_response_to_result(resp : station_vault::VaultRouteResponse) -> Result[base_codec::Json, station_api::ApiError] {
  let j = station_rules_bridge::form_to_base(resp.body)
  if resp.status >= 200 && resp.status < 300 {
    Ok(j)
  } else {
    Err(station_api::ApiError::json(resp.status, j, no_cache=true))
  }
}

fn dispatch_vault_op(
  op : String,
  req : station_api::ApiRequest,
  body : base_codec::Json,
  whole_store : WholeStore,
  _agents : WholeAgents,
  auth_policy : PeerAuthPolicy,
  events : station_api::EventsHub,
  hooks : WholeApiRuntimeHooks,
  now_ms : Int64,
) -> Option[Result[base_codec::Json, station_api::ApiError]] {
  if !op.starts_with("vault.") {
    return None
  }
  let lock_fn : (String) -> Option[lock::LockState] = match hooks.lock_of {
    Some(f) => f
    None => fn(_ws : String) -> Option[lock::LockState] { None }
  }

  // Vault secret approval / usage / plain-SQLite ops: honest 501 until SQLite `vault_plain` & secrets approval manager are wired.
  if op == "vault.uses.get" ||
  op == "vault.cross-uses.get" ||
  op == "vault.requests.get" ||
  op == "vault.grants.post" ||
  op == "vault.denials.post" ||
  op == "vault.saves.post" ||
  op == "vault.described.post" ||
  op == "vault.removed.post" ||
  op == "vault.browses.post" ||
  op.starts_with("vault.plain.") {
    return Some(Err(err_not_implemented(op)))
  }

  // Encrypted SQLite-backed `VaultStore` routes
  let vstore = match whole_store.require_vault_store() {
    Ok(vs) => vs
    Err(e) => return Some(Err(station_api::ApiError::new(503, e)))
  }
  let vctx = station_vault::VaultRouteCtx::{
    store: vstore,
    lock_of: lock_fn,
    on_event: Some(fn(ev : station_vault::VaultRouteEvent) -> Unit {
      let payload = station_rules_bridge::form_to_base(ev.data)
      let ev_target = station_api::EventTarget::{
        lang: None,
        viewer: None,
        device: None,
        email: None,
        workspace: Some(ev.target.workspace),
        subs: ev.target.subs,
        read_only: None,
        managers: None,
        vault: ev.target.vault,
        sees_ws: Some(Some(ev.target.workspace)),
        sees_session: None,
        sees_thread: None,
        sees_job: None,
      }
      let dedupe = if ev.dedupe_key.length() > 0 { Some(ev.dedupe_key) } else { None }
      let _ = events.emit(ev.event, payload, ev_target, now_ms, dedupe)
    }),
    before_write: Some(fn() -> Bool { !hooks.read_only_handover_cell[0] }),
    boxed: None,
    verify_fn: auth_policy.verify_fn,
  }
  let vviewer = vault_viewer_of(req)
  let query = req.query

  if op == "vault.vaults.GET" {
    return Some(vault_response_to_result(station_vault::handle_get_vaults(vctx, vviewer)))
  }
  if op == "vault.discover.get" {
    return Some(vault_response_to_result(station_vault::handle_get_discover(vctx, vviewer)))
  }
  if op == "vault.vaults.latest" {
    return Some(vault_response_to_result(station_vault::handle_post_vaults_latest(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
    )))
  }
  if op == "vault.vaults.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_vault(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
      query,
    )))
  }
  if op == "vault.boxes.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_box(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
      now_ms=now_ms,
    )))
  }
  if op == "vault.boxes.GET" {
    return Some(vault_response_to_result(station_vault::handle_get_boxes(vctx, vviewer, chains_fn=hooks.chains_of)))
  }
  if op == "vault.asks.GET" {
    return Some(vault_response_to_result(station_vault::handle_get_asks(vctx, vviewer, query)))
  }
  if op == "vault.asks.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_ask(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
      now_ms=now_ms,
    )))
  }
  if op == "vault.joins.GET" {
    return Some(vault_response_to_result(station_vault::handle_get_joins(vctx, vviewer, query)))
  }
  if op == "vault.joins.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_join(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
      now_ms=now_ms,
    )))
  }
  if op == "vault.joins.dismiss.put" {
    return Some(vault_response_to_result(station_vault::handle_put_join_dismiss(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
      now_ms=now_ms,
    )))
  }
  if op == "vault.items.GET" {
    return Some(vault_response_to_result(station_vault::handle_get_items(vctx, vviewer, query)))
  }
  if op == "vault.items.PUT" {
    return Some(vault_response_to_result(station_vault::handle_put_item(
      vctx,
      vviewer,
      station_rules_bridge::base_to_form(body),
      query,
    )))
  }
  Some(Err(err_not_implemented(op)))
}

// ---------------------------------------------------------------------------
// 2. Updates dispatcher (`station_drivers::RuntimeUpdatesManager`)
// ---------------------------------------------------------------------------

fn runtime_item_to_json(it : station_drivers::RuntimeSoftwareItem) -> base_codec::Json {
  base_codec::json_obj([
    ("id", base_codec::json_str(it.id)),
    ("installed", base_codec::json_bool(it.installed)),
    ("version", match it.version { Some(v) => base_codec::json_str(v), None => base_codec::json_null() }),
    ("at", match it.at { Some(p) => base_codec::json_str(p), None => base_codec::json_null() }),
    ("updating", match it.updating { Some(ts) => base_codec::json_int64(ts), None => base_codec::json_null() }),
    ("removable", base_codec::json_bool(it.uninstall.is_some())),
  ])
}

fn dispatch_updates_op(
  op : String,
  req : station_api::ApiRequest,
  body : base_codec::Json,
  updates : station_drivers::RuntimeUpdatesManager,
  cfg_opt : Option[station_ops::ConfigFile],
  cfg_open_err : Option[station_ops::ConfigError],
  hooks : WholeApiRuntimeHooks,
  port : WholeApiRuntimePort,
  now_ms : Int64,
) -> Option[Result[base_codec::Json, station_api::ApiError]] {
  if !op.starts_with("updates.") {
    return None
  }
  let ops_lang = api_lang_to_ops(req.lang)
  if op == "updates.check" || op == "updates.wait" || op == "updates.install" {
    return Some(Err(err_not_implemented(op)))
  }
  if !req.viewer.manages_station() {
    return Some(Err(station_api::ApiError::new(403, "only workspace owners and admins can manage station updates")))
  }
  if op == "updates.channel" {
    let ch = match json_field_str(body, "channel") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "channel is required")))
    }
    if ch != "stable" && ch != "beta" {
      return Some(Err(station_api::ApiError::new(400, "channel must be stable or beta")))
    }
    match update_config_key(cfg_opt, cfg_open_err, "updateChannel", Some(base_codec::json_str(ch))) {
      Ok(_) => {
        hooks_notify_overview(hooks, "updates")
        return Some(Ok(base_codec::json_obj([("channel", base_codec::json_str(ch))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "updates.auto" {
    let enabled = match json_field_bool(body, "enabled") {
      Some(b) => b
      None => match json_field_bool(body, "auto") {
        Some(b) => b
        None => return Some(Err(station_api::ApiError::new(400, "enabled is true or false")))
      }
    }
    match update_config_key(cfg_opt, cfg_open_err, "autoUpdate", Some(base_codec::json_bool(enabled))) {
      Ok(_) => {
        hooks_notify_overview(hooks, "updates")
        return Some(Ok(base_codec::json_obj([("auto", base_codec::json_bool(enabled))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "updates.uninstall" {
    let id = match json_field_str(body, "id") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "id is required")))
    }
    let running_on = fn(k : station_drivers::RuntimeKind) -> Int {
      (port.running_on_runtime)(station_drivers::runtime_kind_to_str(k))
    }
    match updates.begin_uninstall(id, now_ms, running_on) {
      Ok(how) => {
        hooks_notify_overview(hooks, "updates")
        return Some(Ok(base_codec::json_obj([
          ("ok", base_codec::json_bool(true)),
          ("id", base_codec::json_str(id)),
          ("program", base_codec::json_str(how.program)),
        ])))
      }
      Err(refusal) => {
        let key = station_drivers::uninstall_refusal_key(refusal)
        let status = match refusal {
          station_drivers::UninstallRefusal::NoSuchItem(_) => 404
          station_drivers::UninstallRefusal::Closed => 503
          _ => 409
        }
        return Some(Err(station_api::ApiError::new(status, station_ops::tr(ops_lang, key))))
      }
    }
  }
  Some(Err(err_not_implemented(op)))
}

// ---------------------------------------------------------------------------
// 3. Remaining `read_op` handlers (strict workspace isolation, honest 501)
// ---------------------------------------------------------------------------

pub fn dispatch_extra_read_op(
  op : String,
  req : station_api::ApiRequest,
  args : base_codec::Json,
  agents : WholeAgents,
  seen_store : station_api::SeenStore,
  port : WholeApiRuntimePort,
) -> Option[Result[base_codec::Json, station_api::ApiError]] {
  let fs = agents.jobs.fs
  let data_dir = agents.config.data_dir

  if op == "memory" {
    // Honest 501 until `readops_local` `{global, skills}` contract is wired end-to-end.
    return Some(Err(err_not_implemented(op)))
  }
  if op == "changed.chats" || op == "changed.sharedChats" || op == "changed.threads" {
    return Some((port.changed_threads)(req.viewer.workspace))
  }
  if op == "changed.sessions" {
    return Some((port.changed_sessions)(req.viewer.workspace))
  }
  if op == "resources" {
    return Some(Err(err_not_implemented(op)))
  }
  if op == "job.log" {
    let id = match json_field_str(args, "id") {
      Some(s) => s
      None => return Some(Err(station_api::ApiError::new(400, "missing job id")))
    }
    match agents.jobs.get(id) {
      Some(rec) => {
        if !station_api::session_seen(seen_store, req.viewer, rec.session) {
          return Some(Err(station_api::ApiError::new(404, "no job " + id)))
        }
        let log_txt = match agents.jobs.log(id) {
          Ok(t) => t
          Err(_) => ""
        }
        return Some(Ok(base_codec::json_obj([
          ("id", base_codec::json_str(id)),
          ("log", base_codec::json_str(log_txt)),
        ])))
      }
      None => return Some(Err(station_api::ApiError::new(404, "no job " + id)))
    }
  }
  if op == "thread.letters" {
    let id_s = match json_field_str(args, "id") { Some(s) => s, None => "" }
    let tid = match base_codec::parse_int64_str(id_s) {
      Some(n) => n
      None => return Some(Err(station_api::ApiError::new(404, "unknown thread " + id_s)))
    }
    if !station_api::thread_seen(seen_store, req.viewer, tid.to_int()) {
      return Some(Err(station_api::ApiError::new(404, "unknown thread " + id_s)))
    }
    return Some((port.thread_letters)(tid))
  }
  if op == "session.transcript" || op == "session.widget-state" {
    let key = match json_field_str(args, "key") {
      Some(k) => k
      None => return Some(Err(station_api::ApiError::new(400, "missing key")))
    }
    if !station_api::session_seen(seen_store, req.viewer, key) {
      return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
    }
    match (port.session_exists_info)(key) {
      Err(e) => return Some(Err(e))
      Ok(None) => return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
      Ok(Some(_)) => {
        if op == "session.widget-state" {
          let wpath = match req.param("path") { Some(p) => p, None => "" }
          match (port.get_widget_state)(key, wpath) {
            Ok(state) => return Some(Ok(base_codec::json_obj([("key", base_codec::json_str(key)), ("state", state)])))
            Err(e) => return Some(Err(e))
          }
        }
        let lines = (port.read_adopted_output)(key)
        let out : Array[base_codec::Json] = []
        for i in 0..<lines.length() {
          out.push(base_codec::json_str(lines[i]))
        }
        return Some(Ok(base_codec::json_obj([
          ("key", base_codec::json_str(key)),
          ("entries", base_codec::json_arr(out)),
        ])))
      }
    }
  }
  if op == "usage" ||
  op == "usage.calls" ||
  op == "machineSessions" ||
  op == "machineSession" ||
  op == "session.timeline" ||
  op == "session.files" ||
  op == "session.parts" ||
  op == "session.poster" ||
  op == "session.peek" ||
  op == "session.open" {
    return Some(Err(err_not_implemented(op)))
  }
  None
}

// ---------------------------------------------------------------------------
// 4. Remaining `call_op` handlers (strict isolation, redaction, honest 501)
// ---------------------------------------------------------------------------

fn agent_presets_dir(fs : station_jobs::FsPort, data_dir : String, viewer : station_api::Viewer) -> String {
  if viewer.home {
    nodepath::join(fs.sep, [data_dir, "agent"])
  } else {
    nodepath::join(fs.sep, [data_dir, "agent", "workspaces", sanitize_ws_key(viewer.workspace)])
  }
}

pub fn dispatch_extra_call_op(
  op : String,
  req : station_api::ApiRequest,
  params : Array[String],
  body : base_codec::Json,
  whole_store : WholeStore,
  agents : WholeAgents,
  auth_policy : PeerAuthPolicy,
  seen_store : station_api::SeenStore,
  drive : station_screens::Drive,
  screens : station_screens::ScreenHub,
  events : station_api::EventsHub,
  updates : station_drivers::RuntimeUpdatesManager,
  cfg_opt : Option[station_ops::ConfigFile],
  cfg_open_err : Option[station_ops::ConfigError],
  hooks : WholeApiRuntimeHooks,
  port : WholeApiRuntimePort,
  now_ms : Int64,
) -> Option[Result[base_codec::Json, station_api::ApiError]] {
  let _ = drive
  let _ = screens
  // 1. Vault routes
  match dispatch_vault_op(op, req, body, whole_store, agents, auth_policy, events, hooks, now_ms) {
    Some(r) => return Some(r)
    None => ()
  }
  // 2. Updates routes
  match dispatch_updates_op(op, req, body, updates, cfg_opt, cfg_open_err, hooks, port, now_ms) {
    Some(r) => return Some(r)
    None => ()
  }

  let fs = agents.jobs.fs
  let data_dir = agents.config.data_dir

  // 3. Settings & Configuration persisted via unified `ConfigFile`
  if op == "search.settings" || op == "network.settings.put" || op == "context.settings.put" || op == "diagnostics.settings.put" {
    return Some(Err(err_not_implemented(op)))
  }
  if op == "network.station.restart" {
    match hooks.on_restart {
      Some(f) => match f() {
        Ok(_) => return Some(Ok(base_codec::json_obj([("restarting", base_codec::json_bool(true))])))
        Err(e) => return Some(Err(station_api::ApiError::new(500, e)))
      }
      None => return Some(Err(err_not_implemented(op)))
    }
  }
  if op == "agentEnv.put" {
    let mut result_view : base_codec::Json = base_codec::json_arr([])
    match update_config_with(cfg_opt, cfg_open_err, fn(raw : base_codec::Json) -> Result[base_codec::Json, station_api::ApiError] {
      let before : Map[String, String] = Map::new()
      match base_codec::json_get(raw, "agentEnv") {
        Some(base_codec::Json::Obj(fs_env)) => {
          for i in 0..<fs_env.length() {
            match fs_env[i].1 {
              base_codec::Json::Str(s) => before.set(fs_env[i].0, s)
              _ => ()
            }
          }
        }
        _ => ()
      }
      let next_map : Map[String, String] = match json_field_str(body, "text") {
        Some(text) => match parse_env_text_lines(text, before) {
          Ok(m) => m
          Err(msg) => return Err(station_api::ApiError::new(400, msg))
        }
        None => match base_codec::json_get(body, "env") {
          Some(base_codec::Json::Obj(patch)) => {
            let m : Map[String, String] = Map::new()
            let bks = before.keys()
            for bi in 0..<bks.length() {
              match before.get(bks[bi]) {
                Some(bv) => m.set(bks[bi], bv)
                None => ()
              }
            }
            for pi in 0..<patch.length() {
              let pk = patch[pi].0
              let pv = patch[pi].1
              if !is_valid_env_name(pk) {
                return Err(station_api::ApiError::new(400, "invalid environment variable name " + pk))
              }
              match pv {
                base_codec::Json::Null => m.remove(pk)
                base_codec::Json::Str(sv) => {
                  if sv.length() > 32768 {
                    return Err(station_api::ApiError::new(400, "env." + pk + ": value too long"))
                  }
                  let keep_prev = match before.get(pk) {
                    Some(prev) => is_secret_env_key(pk) && (sv == mask_secret_value(prev) || sv == MASK_DOTS)
                    None => false
                  }
                  if !keep_prev {
                    m.set(pk, sv)
                  }
                }
                _ => return Err(station_api::ApiError::new(400, "env." + pk + ": a string, or null to remove it"))
              }
            }
            if m.keys().length() > 200 {
              return Err(station_api::ApiError::new(400, "too many environment variables (max 200)"))
            }
            m
          }
          _ => return Err(station_api::ApiError::new(400, "text: the variables as NAME=value lines; or env: a map of variables to a value, or null to remove one"))
        }
      }
      result_view = agent_env_view_json(next_map)
      let ks = next_map.keys()
      if ks.length() == 0 {
        Ok(json_obj_set(raw, "agentEnv", None))
      } else {
        let obj_fs : Array[(String, base_codec::Json)] = []
        for i in 0..<ks.length() {
          match next_map.get(ks[i]) {
            Some(v) => obj_fs.push((ks[i], base_codec::json_str(v)))
            None => ()
          }
        }
        Ok(json_obj_set(raw, "agentEnv", Some(base_codec::json_obj(obj_fs))))
      }
    }) {
      Ok(_) => {
        hooks_notify_overview(hooks, "agentEnv")
        return Some(Ok(base_codec::json_obj([("env", result_view)])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "mcpServers.get" || op == "mcpServers.put" {
    // Honest 501 until managed-mcp-config.ts / routes/mcp-servers.ts full schema & response contract is ported.
    return Some(Err(err_not_implemented(op)))
  }
  if op == "tools.access.get" {
    let raw = read_config_raw(cfg_opt)
    let access = match base_codec::json_get(raw, "toolsAccess") {
      Some(v) => v
      None => base_codec::json_obj([])
    }
    return Some(Ok(base_codec::json_obj([("access", access)])))
  }
  if op == "tools.access.put" || op == "xshare.hosts.put" {
    return Some(Err(err_not_implemented(op)))
  }
  if op == "workspaces.list" {
    let arr : Array[base_codec::Json] = []
    for i in 0..<auth_policy.allowed_workspaces.length() {
      let ws = auth_policy.allowed_workspaces[i]
      arr.push(base_codec::json_obj([
        ("id", base_codec::json_str(ws)),
        ("home", base_codec::json_bool(ws == auth_policy.home_workspace)),
      ]))
    }
    return Some(Ok(base_codec::json_obj([("workspaces", base_codec::json_arr(arr))])))
  }
  if op == "workspaces.join" {
    match hooks.on_workspace_join {
      Some(f) => match f(body) {
        Ok(res) => return Some(Ok(res))
        Err(e) => return Some(Err(station_api::ApiError::new(400, e)))
      }
      None => return Some(Err(err_not_implemented(op)))
    }
  }

  // 4. Accounts / Archive Policy (honest 501 until full Node schema/policy validation & review hooks are ported)
  if op.starts_with("accounts.") {
    return Some(Err(err_not_implemented(op)))
  }

  // 5. Projects write ops (strictly workspace-scoped; rename/merge stay 501 until cross-station CRDT sync consumer is wired)
  if op == "projects.info.put" {
    let name = match json_field_str(body, "name") {
      Some(raw_n) => match station_api::normalize_project_name(raw_n) {
        Ok(clean) => clean
        Err(e) => return Some(Err(station_api::ApiError::new(400, e)))
      }
      None => return Some(Err(station_api::ApiError::new(400, "name is required")))
    }
    let existing = match read_projects_info_map(fs, data_dir) {
      Ok(m) => m
      Err(e) => return Some(Err(station_api::ApiError::new(500, e)))
    }
    let ek = req.viewer.workspace + ":" + name
    let next_entries : Array[(String, base_codec::Json)] = []
    for i in 0..<existing.length() {
      if existing[i].0 != ek {
        next_entries.push(existing[i])
      }
    }
    next_entries.push((ek, body))
    match write_data_json_file(fs, data_dir, "projects-info.json", base_codec::json_obj(next_entries)) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("name", base_codec::json_str(name))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "projects.rename" || op == "projects.merge" {
    return Some(Err(err_not_implemented(op)))
  }

  // 6. Hub & Marks ops (strict workspace isolation on every session/thread/job mutation)
  if op == "hub.moved" {
    return Some(Ok(base_codec::json_obj([("moved", json_str_array((port.handed_stations)()))])))
  }
  if op == "hub.session.delete" && params.length() >= 1 {
    let key = params[0]
    if !station_api::session_seen(seen_store, req.viewer, key) {
      return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
    }
    match (port.archive_session)(key, req.viewer.email, now_ms) {
      Ok(_) => {
        hooks_notify_session(hooks, key)
        return Some(Ok(base_codec::json_obj([("deleted", base_codec::json_bool(true)), ("key", base_codec::json_str(key))])))
      }
      Err(e) => return Some(Err(station_api::ApiError::new(500, e)))
    }
  }
  if op == "hub.session.jobs.delete" && params.length() >= 1 {
    let key = params[0]
    if !station_api::session_seen(seen_store, req.viewer, key) {
      return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
    }
    let jobs = agents.jobs.list()
    let mut stopped = 0
    for i in 0..<jobs.length() {
      if jobs[i].session == key {
        let _ = agents.jobs.stop(jobs[i].id, now_ms)
        stopped = stopped + 1
      }
    }
    return Some(Ok(base_codec::json_obj([("stopped", base_codec::json_int(stopped))])))
  }
  if op == "hub.session.archive.DELETE" && params.length() >= 1 {
    let key = params[0]
    if !station_api::session_seen(seen_store, req.viewer, key) {
      return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
    }
    match (port.unarchive_session)(key) {
      Ok(_) => {
        hooks_notify_session(hooks, key)
        return Some(Ok(base_codec::json_obj([("archived", base_codec::json_bool(false)), ("key", base_codec::json_str(key))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "hub.session.settings" && params.length() >= 1 {
    let key = params[0]
    if !station_api::session_seen(seen_store, req.viewer, key) {
      return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
    }
    match json_field_str(body, "model") {
      Some(m) => match (port.update_session_field)(key, "model", m) {
        Ok(_) => ()
        Err(e) => return Some(Err(e))
      }
      None => ()
    }
    match json_field_str(body, "runtime") {
      Some(rt) => match agents.check_runtime_enabled_tr(rt, lang=api_lang_to_ops(req.lang)) {
        Ok(_) => match (port.update_session_field)(key, "runtime", rt) {
          Ok(_) => ()
          Err(e) => return Some(Err(e))
        }
        Err(msg) => return Some(Err(station_api::ApiError::new(400, msg)))
      }
      None => ()
    }
    hooks_notify_session(hooks, key)
    return Some(Ok(base_codec::json_obj([
      ("ok", base_codec::json_bool(true)),
      ("key", base_codec::json_str(key)),
    ])))
  }
  if op == "hub.thread.create" {
    let key = "c-" + (port.random_hex)(12)
    let title = json_field_str(body, "title")
    let runtime = match json_field_str(body, "runtime") { Some(r) => if r.length() > 0 { r } else { "claude" }, None => "claude" }
    match (port.create_thread_session)(key, title, runtime, json_field_str(body, "model"), req.viewer.email, req.viewer.workspace, now_ms) {
      Ok(tid) => {
        hooks_notify_session(hooks, key)
        return Some(Ok(base_codec::json_obj([
          ("id", base_codec::json_int64(tid)),
          ("key", base_codec::json_str(key)),
        ])))
      }
      Err(e) => return Some(Err(station_api::ApiError::new(500, e)))
    }
  }
  if (op == "hub.thread.archive.POST" || op == "hub.thread.archive.DELETE") && params.length() >= 1 {
    let tid = match base_codec::parse_int64_str(params[0]) {
      Some(n) => n
      None => return Some(Err(station_api::ApiError::new(404, "unknown thread " + params[0])))
    }
    if !station_api::thread_seen(seen_store, req.viewer, tid.to_int()) {
      return Some(Err(station_api::ApiError::new(404, "unknown thread " + params[0])))
    }
    let archiving = op == "hub.thread.archive.POST"
    match (port.archive_thread)(tid, archiving, now_ms) {
      Ok(_) => return Some(Ok(base_codec::json_obj([
        ("thread", base_codec::json_int64(tid)),
        ("archived", base_codec::json_bool(archiving)),
      ])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "hub.job.stop" && params.length() >= 1 {
    let id = params[0]
    match agents.jobs.get(id) {
      Some(rec) => {
        if !station_api::session_seen(seen_store, req.viewer, rec.session) {
          return Some(Err(station_api::ApiError::new(404, "no job " + id)))
        }
        match agents.jobs.stop(id, now_ms) {
          Ok(_) => return Some(Ok(base_codec::json_obj([("stopped", base_codec::json_bool(true)), ("id", base_codec::json_str(id))])))
          Err(e) => return Some(Err(station_api::ApiError::new(404, e)))
        }
      }
      None => return Some(Err(station_api::ApiError::new(404, "no job " + id)))
    }
  }
  if op == "marks.session.title" && params.length() >= 1 {
    let key = params[0]
    if !station_api::session_seen(seen_store, req.viewer, key) {
      return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
    }
    let title = match json_field_str(body, "title") { Some(s) => s, None => "" }
    match (port.update_session_field)(key, "title", title) {
      Ok(_) => {
        hooks_notify_session(hooks, key)
        return Some(Ok(base_codec::json_obj([("key", base_codec::json_str(key)), ("title", base_codec::json_str(title))])))
      }
      Err(e) => return Some(Err(e))
    }
  }
  if op == "marks.session.widgetState" && params.length() >= 1 {
    let key = params[0]
    if !station_api::session_seen(seen_store, req.viewer, key) {
      return Some(Err(station_api::ApiError::new(404, "unknown session " + key)))
    }
    let wpath = match json_field_str(body, "path") { Some(p) => p, None => "" }
    let wstate = match base_codec::json_get(body, "state") { Some(s) => s, None => body }
    match (port.put_widget_state)(key, wpath, wstate, now_ms) {
      Ok(_) => return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      Err(e) => return Some(Err(e))
    }
  }
  if op == "marks.thread.title" && params.length() >= 1 {
    let tid = match base_codec::parse_int64_str(params[0]) {
      Some(n) => n
      None => return Some(Err(station_api::ApiError::new(404, "unknown thread " + params[0])))
    }
    if !station_api::thread_seen(seen_store, req.viewer, tid.to_int()) {
      return Some(Err(station_api::ApiError::new(404, "unknown thread " + params[0])))
    }
    let title = match json_field_str(body, "title") { Some(s) => s, None => "" }
    (port.set_thread_title)(tid, title)
    return Some(Ok(base_codec::json_obj([("thread", base_codec::json_int64(tid)), ("title", base_codec::json_str(title))])))
  }

  // 7. Presets (`<agentHome(ws)>/presets.json` read-modify-write) & Shared SQLite Preference Tables
  if op == "presets.list" || op == "presets.create" || op == "presets.item.PUT" || op == "presets.item.DELETE" {
    let pdir = agent_presets_dir(fs, data_dir, req.viewer)
    let cur = read_data_json_file(fs, pdir, "presets.json", base_codec::json_obj([("presets", base_codec::json_arr([]))]))
    if op == "presets.list" {
      return Some(Ok(cur))
    }
    let cur_list : Array[base_codec::Json] = match base_codec::json_get(cur, "presets") {
      Some(base_codec::Json::Arr(xs)) => xs
      _ => []
    }
    if op == "presets.create" || op == "presets.item.PUT" {
      let id = if params.length() > 0 && params[0].length() > 0 {
        params[0]
      } else {
        match json_field_str(body, "id") {
          Some(s) => if s.length() > 0 { s } else { "pr-" + (port.random_hex)(6) }
          None => "pr-" + (port.random_hex)(6)
        }
      }
      let item = json_obj_set(body, "id", Some(base_codec::json_str(id)))
      let next_list : Array[base_codec::Json] = []
      let mut replaced = false
      for i in 0..<cur_list.length() {
        if json_field_str(cur_list[i], "id") == Some(id) {
          next_list.push(item)
          replaced = true
        } else {
          next_list.push(cur_list[i])
        }
      }
      if !replaced {
        next_list.push(item)
      }
      match write_data_json_file(fs, pdir, "presets.json", base_codec::json_obj([("presets", base_codec::json_arr(next_list))])) {
        Ok(_) => return Some(Ok(base_codec::json_obj([("id", base_codec::json_str(id)), ("preset", item)])))
        Err(e) => return Some(Err(e))
      }
    }
    if op == "presets.item.DELETE" && params.length() >= 1 {
      let id = params[0]
      let next_list : Array[base_codec::Json] = []
      let mut removed = false
      for i in 0..<cur_list.length() {
        if json_field_str(cur_list[i], "id") == Some(id) {
          removed = true
        } else {
          next_list.push(cur_list[i])
        }
      }
      if !removed {
        return Some(Err(station_api::ApiError::new(404, "unknown preset " + id)))
      }
      match write_data_json_file(fs, pdir, "presets.json", base_codec::json_obj([("presets", base_codec::json_arr(next_list))])) {
        Ok(_) => return Some(Ok(base_codec::json_obj([("deleted", base_codec::json_bool(true)), ("id", base_codec::json_str(id))])))
        Err(e) => return Some(Err(e))
      }
    }
  }
  // 7b. `stars.*`, `progress.*`, `presetProjects.*`, `board.drafts.*`: honest 501 until per-record `rev` merge (`preset-records`) is ported.
  if op == "presetProjects.GET" ||
  op == "presetProjects.PUT" ||
  op == "stars.GET" ||
  op == "stars.PUT" ||
  op == "progress.GET" ||
  op == "progress.PUT" ||
  op == "board.drafts.GET" ||
  op == "board.drafts.PUT" {
    return Some(Err(err_not_implemented(op)))
  }

  // 8. Copies settings (manager-gated + redacted backupView; PUT returns honest 501 until field-preserving `applyBackupUpdate` is ported)
  if op == "copies.settings.get" {
    let raw = read_config_raw(cfg_opt)
    return Some(Ok(redact_backup_view(raw)))
  }
  if op == "copies.settings.put" {
    return Some(Err(err_not_implemented(op)))
  }

  // 9. Drive roots (manager-gated, MOST_ROOTS=64, startup-aligned OS absolute-path validation & normalization, home vs joined isolation + live hot-update)
  if op == "drive.roots.put" {
    if !req.viewer.manages_station() {
      return Some(Err(station_api::ApiError::new(403, "only workspace owners and admins can manage drive roots")))
    }
    let raw_roots = match base_codec::json_get(body, "roots") {
      Some(base_codec::Json::Arr(xs)) => xs
      _ => return Some(Err(station_api::ApiError::new(400, "roots: at most 64 paths")))
    }
    if raw_roots.length() > 64 {
      return Some(Err(station_api::ApiError::new(400, "roots: at most 64 paths")))
    }
    let is_win = fs.sep == "\\"
    let sep = fs.sep
    let is_abs_for_os = fn(p : String) -> Bool {
      if p.length() == 0 {
        return false
      }
      if !is_win {
        return p.starts_with("/")
      }
      let c0 = p.code_unit_at(0)
      if p.length() >= 2 && c0 == 92 && p.code_unit_at(1) == 92 {
        return true
      }
      if p.length() >= 3 {
        let is_alpha = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
        let c1 = p.code_unit_at(1)
        let c2 = p.code_unit_at(2)
        if is_alpha && c1 == 58 && (c2 == 47 || c2 == 92) {
          return true
        }
      }
      false
    }
    let roots_arr : Array[String] = []
    let seen_roots : Map[String, Bool] = Map::new()
    for i in 0..<raw_roots.length() {
      match raw_roots[i] {
        base_codec::Json::Str(raw_p) => {
          let p = raw_p.trim()
          if p.length() == 0 || p.length() > 4096 || p.contains("\x00") {
            return Some(Err(station_api::ApiError::new(400, "invalid drive root path")))
          }
          if !is_abs_for_os(p) {
            return Some(Err(station_api::ApiError::new(400, "drive root must be an absolute path: " + p)))
          }
          // Reject path traversal segments `..` across both `/` and `\` separators
          let segs_slash = p.split("/")
          for si in 0..<segs_slash.length() {
            let sub_segs = segs_slash[si].split("\\")
            for bi in 0..<sub_segs.length() {
              if sub_segs[bi] == ".." {
                return Some(Err(station_api::ApiError::new(400, "drive root must not contain '..': " + p)))
              }
            }
          }
          let mut norm = nodepath::join(sep, [p])
          if !is_win {
            while norm.length() > 1 && norm.ends_with("/") {
              norm = norm.slice(0, norm.length() - 1)
            }
          } else {
            while norm.length() > 3 && (norm.ends_with("\\") || norm.ends_with("/")) {
              norm = norm.slice(0, norm.length() - 1)
            }
          }
          if !is_abs_for_os(norm) {
            return Some(Err(station_api::ApiError::new(400, "drive root must be an absolute path: " + p)))
          }
          if !seen_roots.contains(norm) {
            seen_roots.set(norm, true)
            roots_arr.push(norm)
          }
        }
        _ => return Some(Err(station_api::ApiError::new(400, "each drive root must be a string")))
      }
    }
    let roots_json = json_str_array(roots_arr)
    let is_home = req.viewer.home
    let ws = req.viewer.workspace
    match update_config_with(cfg_opt, cfg_open_err, fn(raw : base_codec::Json) -> Result[base_codec::Json, station_api::ApiError] {
      let cur_drive = match base_codec::json_get(raw, "drive") {
        Some(base_codec::Json::Obj(_)) => match base_codec::json_get(raw, "drive") { Some(d) => d, None => base_codec::json_obj([]) }
        _ => base_codec::json_obj([])
      }
      let next_drive = if is_home {
        json_obj_set(cur_drive, "roots", Some(roots_json))
      } else {
        let cur_ws_map = match base_codec::json_get(cur_drive, "workspaces") {
          Some(base_codec::Json::Obj(_)) => match base_codec::json_get(cur_drive, "workspaces") { Some(w) => w, None => base_codec::json_obj([]) }
          _ => base_codec::json_obj([])
        }
        let next_ws_map = json_obj_set(cur_ws_map, ws, Some(roots_json))
        json_obj_set(cur_drive, "workspaces", Some(next_ws_map))
      }
      Ok(json_obj_set(raw, "drive", Some(next_drive)))
    }) {
      Ok(_) => {
        match hooks.on_drive_roots_changed {
          Some(f) => f(ws, roots_arr)
          None => ()
        }
        hooks_notify_overview(hooks, "drive")
        return Some(Ok(base_codec::json_obj([("ok", base_codec::json_bool(true)), ("roots", roots_json)])))
      }
      Err(e) => return Some(Err(e))
    }
  }

  // 10. Optional runtime-hooked machine logins & browser sign-ins (honest 501 when unhooked)
  if op.starts_with("logins.machine.") {
    match hooks.on_logins_op {
      Some(f) => return Some(f(op, params, body))
      None => return Some(Err(err_not_implemented(op)))
    }
  }
  if op.starts_with("signins.") {
    match hooks.on_signins_op {
      Some(f) => return Some(f(op, params, body))
      None => return Some(Err(err_not_implemented(op)))
    }
  }

  // 11. All remaining unimplemented ops: honest 501 Not Implemented (ZERO fake 200 stubs)
  Some(Err(err_not_implemented(op)))
}
