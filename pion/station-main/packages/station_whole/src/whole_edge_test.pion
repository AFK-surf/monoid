test "devices_os_terminals_logins_adb_runner_and_aggregated_sources" {
  let mock_now = fn() -> Int64 { 1000L }
  let terms = TerminalsOsRuntime::new("/home/tester", scroll_max_bytes=1024, now_fn=mock_now)
  edge_assert(!station_devices::is_valid_terminal_size(0, 0))
  edge_assert(terms.live_count() == 0)
  edge_assert(terms.pending_kill_count() == 0)

  let logins = LoginsOsRuntime::new(Some(station_devices::LoginPages::new(true)), now_fn=mock_now)
  let starter = station_devices::LoginStarter::{
    by: station_devices::LoginPerson::{ email: "alice@example.com", name: "Alice" },
    workspace: Some("ws-1"),
    chat: Some("c-1"),
    chat_title: Some("Login"),
  }
  let view = match logins.manager.start("gh auth login", starter, None, false, 1000L) {
    Ok(v) => v
    Err(r) => panic(r.message)
  }
  let run = match logins.manager.get_run(view.id) {
    Some(r) => r
    None => panic("missing LoginRun")
  }
  run.output("Open https://github.com/login/device and enter code ABCD-1234\n")
  let _ = run.on_settled(None)
  edge_assert(match run.url { Some(u) => u.contains("github.com") None => false })

  let devs = DevicesOsRuntime::new(now_fn=mock_now)
  let spec = station_devices::DeviceSpec::{
    id: "0123456789abcdef",
    name: "Pixel 9",
    kind: station_devices::DeviceKind::Adb,
    target: "127.0.0.1:5037",
    baud: None,
    model: Some("Pixel 9"),
    protocols: None,
    paired: None,
  }
  edge_assert(devs.registry.add("ws-1", "sub-1", "alice@example.com", "Alice", spec, 100L) is Ok(_))
  let req = match devs.phone_grants.ask("sess-1", "c-1", "ws-1", "alice@example.com", "test", 10000L) {
    Ok(r) => r
    Err(e) => panic(e)
  }
  edge_assert(devs.phone_grants.decide("alice@example.com", req.id, Some(station_devices::PhoneScope::Hour), "ws-1", 10000L) is None)
  edge_assert(devs.aggregate_sources("ws-1", "sess-1", 20000L).length() == 2)
  edge_assert(devs.aggregate_sources("ws-1", "sess-1", 10000L + 7200000L).length() == 1)
  edge_assert(encode_android_tv_key_frame("home", 3) is Ok(_))
  edge_assert(encode_android_tv_key_frame("invalid_key_xyz", 3) is Err(_))
}

test "connects_os_ws_send_async_two_arg_default_awaitable" {
  let mem = station_ops::MemFs::new()
  let h = MockMuxHarness::new(
    1000L,
    fn(id : Int64, op : String, _json : String, _payload : Option[Bytes], q : Array[host_shim::HostEvent]) -> Unit {
      if op == "ws.open" {
        q.push(
          host_shim::HostEvent::ShellDone(
            host_shim::ShellDone::{ id: id, json: "{\"id\":42}", error: "", bytes: None },
          ),
        )
      } else if op == "ws.send" || op == "ws.ping" {
        q.push(
          host_shim::HostEvent::ShellDone(
            host_shim::ShellDone::{ id: id, json: "{\"ok\":true}", error: "", bytes: None },
          ),
        )
      }
    },
  )
  let bridge = ConnectMuxBridge::with_hub(h.hub, mem.ops())
  let ws_h = match bridge.ws_open(
    station_connects::WsOpenRequest::{ url: "wss://example.com/ws", headers: [], timeout_ms: 0L },
  ) {
    Ok(id) => id
    Err(e) => panic("ws_open failed: " + e)
  }
  edge_assert(ws_h == 42L)

  // Two-argument ws_send_async defaults to discard=false so callers can await its returned cid
  // even after the shared event loop has already consumed the Done event into deferred_done.
  let cid = match bridge.ws_send_async(ws_h, station_connects::WsFrame::Text("hello")) {
    Ok(id) => id
    Err(e) => panic("ws_send_async failed: " + e)
  }
  edge_assert(cid > 0L)
  let _ = h.hub.pump_one(0L)
  match h.hub.await_call(cid, 1000L, cancel_on_timeout=false) {
    Ok(done) => {
      edge_assert(done.id == cid)
      edge_assert(done.error == "")
    }
    Err(e) => panic("expected 2-arg ws_send_async cid to resolve, got: " + e)
  }

  // Explicit discard=true fire-and-forget does not accumulate in deferred_done.
  let _ = bridge.ws_send_async(ws_h, station_connects::WsFrame::Ping, discard=true)
  let _ = h.hub.pump_one(0L)
  edge_assert(h.hub.deferred_done_count() == 0)
}

test "devices_os_tick_expiry_uses_monotonic_clock_for_grant_kills" {
  let now_cell : Array[Int64] = [1000L]
  let mock_now = fn() -> Int64 { now_cell[0] }
  let devs = DevicesOsRuntime::new(now_fn=mock_now)
  // Schedule a pending grant kill at mono_ms = 3000ms.
  // Passing a huge wall_ms (e.g. 1_795_000_000_000ms) MUST NOT trigger premature SIGKILL when mono_ms < 3000!
  devs.pending_grant_kills.set(
    999999L,
    PendingProcKill::{
      child: station_sys::ChildProcess::{ handle: 0L, pid: 999999 },
      event_id: 999999L,
      deadline_ms: 3000L,
      pgid_killed: false,
    },
  )
  let wall_huge : Int64 = 1795000000000L
  let killed_pids : Array[Int] = []
  let _ = devs.tick_expiry_with(1500L, wall_huge, fn(pk : PendingProcKill) -> Unit { killed_pids.push(pk.child.pid) })
  edge_assert(devs.pending_kill_count() == 1)
  edge_assert(killed_pids.length() == 0)
  // Once monotonic clock passes 3000ms, the pending kill is drained.
  let _ = devs.tick_expiry_with(3001L, wall_huge, fn(pk : PendingProcKill) -> Unit { killed_pids.push(pk.child.pid) })
  edge_assert(devs.pending_kill_count() == 0)
  edge_assert(killed_pids.length() == 1 && killed_pids[0] == 999999)
}

test "connects_os_fail_closed_ack_on_callback_false" {
  let mem = station_ops::MemFs::new()
  let mut ack_count = 0
  let mut ws_next_served = 0
  let mut stream10_reads = 0
  let h2 = MockMuxHarness::new(
    1000L,
    fn(id : Int64, op : String, json : String, _payload : Option[Bytes], q : Array[host_shim::HostEvent]) -> Unit {
      if op == "stream.open" {
        stream10_reads = 0
        q.push(
          host_shim::HostEvent::ShellDone(
            host_shim::ShellDone::{ id: id, json: "{\"id\":10,\"status\":200,\"headers\":[]}", error: "", bytes: None },
          ),
        )
      } else if op == "stream.read" {
        stream10_reads = stream10_reads + 1
        if stream10_reads == 1 {
          let body = "{\"ok\":true,\"url\":\"wss://mock.slack.test/link\"}".to_bytes()
          q.push(
            host_shim::HostEvent::ShellDone(
              host_shim::ShellDone::{ id: id, json: "{\"end\":false}", error: "", bytes: Some(body) },
            ),
          )
        } else {
          q.push(
            host_shim::HostEvent::ShellDone(
              host_shim::ShellDone::{ id: id, json: "{\"end\":true}", error: "", bytes: None },
            ),
          )
        }
      } else if op == "stream.close" {
        q.push(
          host_shim::HostEvent::ShellDone(
            host_shim::ShellDone::{ id: id, json: "{}", error: "", bytes: None },
          ),
        )
      } else if op == "ws.open" {
        q.push(
          host_shim::HostEvent::ShellDone(
            host_shim::ShellDone::{ id: id, json: "{\"id\":77}", error: "", bytes: None },
          ),
        )
      } else if op == "ws.next" {
        ws_next_served = ws_next_served + 1
        if ws_next_served == 1 {
          let env1 = "{\"envelope_id\":\"env-fail\",\"type\":\"events_api\",\"payload\":{\"event\":{\"type\":\"app_mention\",\"channel\":\"C1\",\"ts\":\"1.1\",\"thread_ts\":\"1.1\",\"user\":\"U1\",\"text\":\"drop me\"}}}"
          q.push(
            host_shim::HostEvent::ShellDone(
              host_shim::ShellDone::{ id: id, json: "{\"kind\":\"text\",\"text\":" + base_codec::json_stringify(base_codec::json_str(env1)) + "}", error: "", bytes: None },
            ),
          )
        } else if ws_next_served == 2 {
          let env2 = "{\"envelope_id\":\"env-ok\",\"type\":\"events_api\",\"payload\":{\"event\":{\"type\":\"app_mention\",\"channel\":\"C1\",\"ts\":\"1.2\",\"thread_ts\":\"1.2\",\"user\":\"U1\",\"text\":\"persist me\"}}}"
          q.push(
            host_shim::HostEvent::ShellDone(
              host_shim::ShellDone::{ id: id, json: "{\"kind\":\"text\",\"text\":" + base_codec::json_stringify(base_codec::json_str(env2)) + "}", error: "", bytes: None },
            ),
          )
        }
      } else if op == "ws.send" {
        if json.contains("envelope_id") {
          ack_count = ack_count + 1
        }
        q.push(
          host_shim::HostEvent::ShellDone(
            host_shim::ShellDone::{ id: id, json: "{\"ok\":true}", error: "", bytes: None },
          ),
        )
      }
    },
  )
  let bridge = ConnectMuxBridge::with_hub(h2.hub, mem.ops())
  let allow_deliver : Array[Bool] = [false]
  let cbs = ConnectsCallbacks::{
    on_event: fn(_cid : String, _p : station_connects::ConnectPlatform, _ev : station_connects::ChatEvent) -> Bool {
      allow_deliver[0]
    },
    on_card_answer: fn(_cid : String, _ans : station_connects::FeishuCardAnswer) -> Bool { false },
    on_interactive: fn(_cid : String, _eid : String, _p : base_codec::Json) -> Bool { false },
    on_disconnect: fn(_cid : String, _r : String) -> Unit {},
  }
  let rt = ConnectsOsRuntime::new(bridge, "st-here", cbs)
  edge_assert(rt.register_slack("sl-1", "xapp-test", "xoxb-test", base_url="http://127.0.0.1:9998") is Ok(_))
  edge_assert(rt.start_connect("sl-1") is Ok(_))
  // First event: callback returns false -> NO ACK sent!
  let _ = h2.hub.pump_one(10L)
  edge_assert(ack_count == 0)
  // Second event: callback returns true -> ACK sent!
  allow_deliver[0] = true
  let _ = h2.hub.pump_one(10L)
  edge_assert(ack_count == 1)
  rt.stop()
}

test "connects_os_group_hex64_endpoint_and_cursor_retry_on_callback_false" {
  let mem = station_ops::MemFs::new()
  let h = MockMuxHarness::new(1000L, fn(_id, _op, _json, _payload, _q) {})
  let bridge = ConnectMuxBridge::with_hub(h.hub, mem.ops())
  let allow : Array[Bool] = [false]
  let calls : Array[Int] = [0]
  let persisted : Array[String] = []
  let disconnects : Array[String] = []
  let cbs = ConnectsCallbacks::{
    on_event: fn(_cid : String, _p : station_connects::ConnectPlatform, ev : station_connects::ChatEvent) -> Bool {
      calls[0] = calls[0] + 1
      if !allow[0] {
        return false
      }
      match ev {
        station_connects::ChatEvent::Message(m) => persisted.push(m.text)
        _ => ()
      }
      true
    },
    on_card_answer: fn(_cid, _ans) -> Bool { false },
    on_interactive: fn(_cid, _eid, _p) -> Bool { false },
    on_disconnect: fn(_cid, r) -> Unit { disconnects.push(r) },
  }
  let rt = ConnectsOsRuntime::new(bridge, "st-here", cbs)

  // 1. Canonical Node 64-hex endpoint ID is accepted as valid config with explicit `unsupported_im2` status.
  let hex64 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  let seed = "1112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30"
  edge_assert(rt.register_group("grp-im2", hex64, seed, "bot-1", "Bot") is Ok(_))
  match rt.start_connect("grp-im2") {
    Err(msg) => edge_assert(msg == "unsupported_im2")
    Ok(_) => panic("expected unsupported_im2 for 64-hex group endpoint")
  }
  edge_assert(!rt.is_connect_running("grp-im2"))

  // 2. Signed Group SSE event: first delivery fails (`on_event` returns false) -> cursor NOT advanced,
  //    SSE stream closed & backoff reconnect triggered; after reconnect, redelivery succeeds once,
  //    and 3rd delivery is ignored as duplicate!
  edge_assert(rt.register_group("grp-sse", "http://127.0.0.1:9999", seed, "bot-1", "Bot") is Ok(_))
  rt.running_connects.set("grp-sse", true)
  let user_seed = "2122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40"
  let (ev_id, signed_ev) = match station_connects::group_sign_event(
    user_seed,
    "d_alice",
    "u_alice",
    1L,
    1000L,
    0L,
    "",
    station_connects::GROUP_LOBBY,
    "msg.post",
    base_codec::json_obj([("text", base_codec::json_str("retry-safe-msg"))]),
  ) {
    Ok(pair) => pair
    Err(e) => panic(e)
  }
  let stamped = base_codec::json_obj([
    (
      "stamped",
      base_codec::json_obj([
        ("id", base_codec::json_str(ev_id)),
        ("aseq", base_codec::json_int(1)),
        ("event", signed_ev),
      ]),
    ),
  ])
  let sse_chunk = "event: event\ndata: " + base_codec::json_stringify(stamped) + "\n\n"

  // Attempt 1: callback returns false -> 0 delivered, cursor stays 0, stream closed & Reconnecting!
  match rt.feed_group_sse("grp-sse", sse_chunk, 1000L) {
    Ok(n) => edge_assert(n == 0)
    Err(e) => panic(e)
  }
  edge_assert(calls[0] == 1 && persisted.length() == 0)
  edge_assert(!rt.is_connect_running("grp-sse"))
  edge_assert(disconnects.length() == 1 && disconnects[0] == "event_rejected")
  match rt.status_of("grp-sse") {
    Some(station_connects::ConnectStatus::Reconnecting(r)) => edge_assert(r == "event_rejected")
    _ => panic("expected Reconnecting(event_rejected) after on_event=false")
  }

  // Attempt 2: after reconnect, callback returns true -> 1 delivered, cursor advances to 1.
  rt.running_connects.set("grp-sse", true)
  allow[0] = true
  match rt.feed_group_sse("grp-sse", sse_chunk, 1001L) {
    Ok(n) => edge_assert(n == 1)
    Err(e) => panic(e)
  }
  edge_assert(calls[0] == 2 && persisted.length() == 1 && persisted[0] == "retry-safe-msg")

  // Attempt 3: exact same event redelivered -> ignored as duplicate (calls stays 2, persisted stays 1).
  match rt.feed_group_sse("grp-sse", sse_chunk, 1002L) {
    Ok(n) => edge_assert(n == 0)
    Err(e) => panic(e)
  }
  edge_assert(calls[0] == 2 && persisted.length() == 1)

  // 3. `GroupStep::NeedSync` (aseq gap `5 > cur(1) + 1`) closes SSE stream & triggers backoff reconnect!
  let gap_stamped = base_codec::json_obj([
    (
      "stamped",
      base_codec::json_obj([
        ("id", base_codec::json_str(ev_id)),
        ("aseq", base_codec::json_int(5)),
        ("event", signed_ev),
      ]),
    ),
  ])
  let gap_chunk = "event: event\ndata: " + base_codec::json_stringify(gap_stamped) + "\n\n"
  match rt.feed_group_sse("grp-sse", gap_chunk, 1003L) {
    Ok(n) => edge_assert(n == 0)
    Err(e) => panic(e)
  }
  edge_assert(!rt.is_connect_running("grp-sse"))
  edge_assert(disconnects.length() == 2 && disconnects[1].starts_with("need_sync:"))
  match rt.status_of("grp-sse") {
    Some(station_connects::ConnectStatus::Reconnecting(r)) => edge_assert(r.starts_with("need_sync:"))
    _ => panic("expected Reconnecting(need_sync:...) on GroupStep::NeedSync")
  }
  rt.stop()
}

test "w17b4_devices_os_airplay_android_tv_serial_tunnel_creds_and_control" {
  let mock_now = fn() -> Int64 { 50000L }
  let devs = DevicesOsRuntime::new(pairing_ttl_ms=30000L, now_fn=mock_now)
  let tmp_root = "/mem/w17b4-data"
  let seed = "0123456789abcdef0123456789abcdef".to_bytes()
  let salt = "saltsaltsaltsalt".to_bytes()
  let iv = "iviviviviviv".to_bytes()
  let enc_files : Map[String, String] = Map::new()
  let cred_port = station_devices::DeviceCredentialPort::{
    get: fn(ws : String, id : String) -> Result[Option[String], String] {
      match enc_files.get(id) {
        None => Ok(None)
        Some(env) => {
          match station_devices::open_device_credentials(seed, ws, id, env) {
            Ok(plain) => Ok(Some(plain))
            Err(e) => Err(e)
          }
        }
      }
    },
    set: fn(ws : String, id : String, payload : String) -> Result[Unit, String] {
      match station_devices::seal_device_credentials(seed, ws, id, salt, iv, payload) {
        Ok(env) => {
          enc_files.set(id, env)
          Ok(())
        }
        Err(e) => Err(e)
      }
    },
    delete: fn(_ws : String, id : String) -> Result[Unit, String] {
      enc_files.remove(id)
      Ok(())
    },
  }
  devs.set_credential_port(tmp_root, cred_port)

  // 1. Encrypted AES-256-GCM + HKDF-SHA256 credential store roundtrip + cross-workspace AAD rejection
  edge_assert((cred_port.set)("ws-a", "0123456789abcdef", "{\"airplay\":\"cred-123\"}") is Ok(_))
  match (cred_port.get)("ws-a", "0123456789abcdef") {
    Ok(Some(plain)) => edge_assert(plain == "{\"airplay\":\"cred-123\"}")
    _ => panic("expected decrypted credentials")
  }
  edge_assert((cred_port.get)("ws-b", "0123456789abcdef") is Err(_))
  edge_assert((cred_port.delete)("ws-a", "0123456789abcdef") is Ok(_))
  match (cred_port.get)("ws-a", "0123456789abcdef") {
    Ok(None) => ()
    _ => panic("expected None after delete")
  }

  // 2. Register all 5 device kinds and verify reach_device_os dispatches every kind (zero 501s) with workspace isolation
  let d_tcp = station_devices::DeviceSpec::{
    id: "1000000000000001",
    name: "Lab SSH",
    kind: station_devices::DeviceKind::Tcp,
    target: "10.0.0.5:22",
    baud: None,
    model: None,
    protocols: None,
    paired: None,
  }
  let d_adb = station_devices::DeviceSpec::{
    id: "1000000000000002",
    name: "USB Pixel",
    kind: station_devices::DeviceKind::Adb,
    target: "emulator-5554",
    baud: None,
    model: None,
    protocols: None,
    paired: None,
  }
  let d_ser = station_devices::DeviceSpec::{
    id: "1000000000000003",
    name: "ESP32",
    kind: station_devices::DeviceKind::Serial,
    target: "/dev/ttyUSB0",
    baud: Some(115200),
    model: None,
    protocols: None,
    paired: None,
  }
  let d_ap = station_devices::DeviceSpec::{
    id: "1000000000000004",
    name: "Apple TV",
    kind: station_devices::DeviceKind::AirPlay,
    target: "AA:BB:CC:DD",
    baud: None,
    model: Some("AppleTV"),
    protocols: Some(["airplay", "companion", "raop"]),
    paired: Some(true),
  }
  let d_atv = station_devices::DeviceSpec::{
    id: "1000000000000005",
    name: "Living Shield",
    kind: station_devices::DeviceKind::AndroidTv,
    target: "192.168.1.52",
    baud: None,
    model: Some("SHIELD"),
    protocols: Some(["atv_remote", "adb"]),
    paired: Some(true),
  }
  edge_assert(devs.registry.add("ws-a", "u1", "a@b.com", "A", d_tcp, 100L) is Ok(_))
  edge_assert(devs.registry.add("ws-a", "u1", "a@b.com", "A", d_adb, 100L) is Ok(_))
  edge_assert(devs.registry.add("ws-a", "u1", "a@b.com", "A", d_ser, 100L) is Ok(_))
  edge_assert(devs.registry.add("ws-a", "u1", "a@b.com", "A", d_ap, 100L) is Ok(_))
  edge_assert(devs.registry.add("ws-a", "u1", "a@b.com", "A", d_atv, 100L) is Ok(_))

  match devs.reach_device_os("ws-a", "1000000000000001") {
    Ok(DeviceTunnelTarget::TcpDial(h, p)) => edge_assert(h == "10.0.0.5" && p == 22)
    _ => panic("expected TcpDial")
  }
  match devs.reach_device_os("ws-a", "1000000000000002") {
    Ok(DeviceTunnelTarget::TcpDial(h, p)) => edge_assert(h == "127.0.0.1" && p == 5037)
    _ => panic("expected Adb TcpDial")
  }
  match devs.reach_device_os("ws-a", "1000000000000003") {
    Ok(DeviceTunnelTarget::SerialPort(path, baud)) => edge_assert(path == "/dev/ttyUSB0" && baud == 115200)
    _ => panic("expected SerialPort")
  }
  match devs.reach_device_os("ws-a", "1000000000000004") {
    Ok(DeviceTunnelTarget::AirPlayHttp(r)) => edge_assert(r.id == "1000000000000004" && r.ws == "ws-a")
    _ => panic("expected AirPlayHttp")
  }
  // Cross-workspace reach_device_os returns 404
  match devs.reach_device_os("ws-b", "1000000000000005") {
    Err((404, _)) => ()
    _ => panic("expected 404 for cross-ws device")
  }

  // 3. Wire deterministic AirPlay & Android TV handlers and exercise 4-byte demux + control_device_with_fs + PNG screenshot
  let png_24 = Bytes::new(24)
  png_24[0] = 0x89.to_byte()
  png_24[1] = 0x50.to_byte()
  png_24[2] = 0x4E.to_byte()
  png_24[3] = 0x47.to_byte()
  png_24[4] = 0x0D.to_byte()
  png_24[5] = 0x0A.to_byte()
  png_24[6] = 0x1A.to_byte()
  png_24[7] = 0x0A.to_byte()
  png_24[12] = 0x49.to_byte()
  png_24[13] = 0x48.to_byte()
  png_24[14] = 0x44.to_byte()
  png_24[15] = 0x52.to_byte()
  png_24[18] = 0x05.to_byte() // 1280 = 0x0500
  png_24[19] = 0x00.to_byte()
  png_24[22] = 0x02.to_byte() // 720 = 0x02D0
  png_24[23] = 0xD0.to_byte()

  devs.set_airplay_handlers(
    fn(r : AirPlayDeviceRefOs, act : String, _args : Option[base_codec::Json], _creds : Option[String]) -> Result[base_codec::Json, station_devices::AirPlayError] {
      Ok(base_codec::json_obj([("device", base_codec::json_str(r.name)), ("action", base_codec::json_str(act))]))
    },
    fn(_r : AirPlayDeviceRefOs, b : Bytes, ext : String, _creds : Option[String]) -> Result[base_codec::Json, station_devices::AirPlayError] {
      Ok(base_codec::json_obj([("bytes", base_codec::json_int(b.length())), ("ext", base_codec::json_str(ext))]))
    },
  )
  devs.set_android_tv_handlers(
    fn(r : AndroidTvDeviceRefOs, act : String, _args : Option[base_codec::Json], _creds : Option[String]) -> Result[base_codec::Json, station_devices::AndroidTvError] {
      Ok(base_codec::json_obj([("device", base_codec::json_str(r.name)), ("action", base_codec::json_str(act))]))
    },
    fn(_r : AndroidTvDeviceRefOs, _creds : Option[String]) -> Result[(Bytes, station_devices::PngDimensions), station_devices::AndroidTvError] {
      Ok((png_24, station_devices::PngDimensions::{ width: 1280, height: 720 }))
    },
  )

  // Android TV 4-byte demux: ADB stream routes to isolated android-tv-adb.sock
  match devs.reach_device_os("ws-a", "1000000000000005") {
    Ok(DeviceTunnelTarget::AndroidTvDemux(ref_atv, demux, http_buf)) => {
      match devs.handle_android_tv_tunnel_bytes(ref_atv, demux, http_buf, "000chost:version".to_bytes()) {
        AndroidTvTunnelStep::AdbForward(sock, payload) => {
          edge_assert(sock.ends_with("/run/android-tv-adb.sock"))
          edge_assert(dev_bytes_to_str(payload) == "000chost:version")
        }
        _ => panic("expected AdbForward")
      }
    }
    _ => panic("expected AndroidTvDemux")
  }
  // Android TV 4-byte demux: split HTTP header + body chunks & single-response discard
  match devs.reach_device_os("ws-a", "1000000000000005") {
    Ok(DeviceTunnelTarget::AndroidTvDemux(ref_atv, demux, http_buf)) => {
      // Split header across chunks before \r\n\r\n
      match devs.handle_android_tv_tunnel_bytes(ref_atv, demux, http_buf, "POST /action HTTP/1.1\r\nContent-Length: ".to_bytes()) {
        AndroidTvTunnelStep::NeedMoreBytes => ()
        _ => panic("expected NeedMoreBytes on partial header")
      }
      match devs.handle_android_tv_tunnel_bytes(ref_atv, demux, http_buf, "19\r\n\r\n{\"action\":".to_bytes()) {
        AndroidTvTunnelStep::NeedMoreBytes => ()
        _ => panic("expected NeedMoreBytes on partial body")
      }
      match devs.handle_android_tv_tunnel_bytes(ref_atv, demux, http_buf, "\"status\"}".to_bytes()) {
        AndroidTvTunnelStep::HttpReply(resp) => {
          edge_assert(resp.status == 200)
          edge_assert(dev_bytes_to_str(resp.body).contains("\"action\":\"status\""))
        }
        _ => panic("expected HttpReply once full body arrived")
      }
      // Trailing bytes after response must return Closed (never respond twice)
      match devs.handle_android_tv_tunnel_bytes(ref_atv, demux, http_buf, "GET /status HTTP/1.1\r\n\r\n".to_bytes()) {
        AndroidTvTunnelStep::Closed => ()
        _ => panic("expected Closed on trailing bytes")
      }
    }
    _ => panic("expected AndroidTvDemux")
  }
  // Oversized Content-Length (> 1 MB) returns 413 immediately
  match devs.reach_device_os("ws-a", "1000000000000005") {
    Ok(DeviceTunnelTarget::AndroidTvDemux(ref_atv, demux, http_buf)) => {
      match devs.handle_android_tv_tunnel_bytes(ref_atv, demux, http_buf, "POST /action HTTP/1.1\r\nContent-Length: 2000000\r\n\r\n".to_bytes()) {
        AndroidTvTunnelStep::HttpReply(resp) => edge_assert(resp.status == 413)
        _ => panic("expected 413 HttpReply")
      }
    }
    _ => panic("expected AndroidTvDemux")
  }

  // device_control_with_fs for AirPlay action, AirPlay stream_audio (with lstat size check), & Android TV screenshot
  let mem_files : Map[String, Bytes] = Map::new()
  mem_files.set("/mem/song.mp3", "ID3audio".to_bytes())
  let read_calls : Array[Int] = [0]
  let mem_fs = DeviceFsPort::{
    stat_size: fn(p : String) -> Result[Int64, String] {
      if p == "/mem/huge.wav" {
        return Ok(station_devices::AIRPLAY_MAX_AUDIO_BYTES.to_int64() + 1L)
      }
      match mem_files.get(p) {
        Some(b) => Ok(b.length().to_int64())
        None => Err("not a regular file: " + p)
      }
    },
    read_file: fn(p : String) -> Result[Bytes, String] {
      read_calls[0] = read_calls[0] + 1
      match mem_files.get(p) {
        Some(b) => Ok(b)
        None => Err("not found: " + p)
      }
    },
    write_file: fn(p : String, b : Bytes) -> Result[Unit, String] {
      mem_files.set(p, b)
      Ok(())
    },
    tmpdir: fn() -> String { "/mem/tmp" },
  }
  // P3-9: oversized audio rejected by stat_size BEFORE read_file is called!
  edge_assert(devs.control_device_with_fs(mem_fs, "ws-a", tmp_root, "Apple TV", "stream_audio", None, Some("/mem/huge.wav")) is Err(_))
  edge_assert(read_calls[0] == 0)

  match devs.control_device_with_fs(mem_fs, "ws-a", tmp_root, "Apple TV", "remote", Some(base_codec::json_obj([("key", base_codec::json_str("home"))])), None) {
    Ok(out) => edge_assert(out.contains("\"action\":\"remote\""))
    Err(e) => panic("airplay control failed: " + e)
  }
  match devs.control_device_with_fs(mem_fs, "ws-a", tmp_root, "Apple TV", "stream_audio", None, Some("/mem/song.mp3")) {
    Ok(out) => edge_assert(out.contains("\"bytes\":8") && out.contains("\"ext\":\".mp3\""))
    Err(e) => panic("airplay stream_audio failed: " + e)
  }
  match devs.control_device_with_fs(mem_fs, "ws-a", tmp_root, "Living Shield", "screenshot", None, None) {
    Ok(out) => {
      edge_assert(out.contains("\"width\":1280") && out.contains("\"height\":720"))
      let shot_path = tmp_root + "/android-tv-1000000000000005-50000.png"
      edge_assert(mem_files.get(shot_path) is Some(_))
    }
    Err(e) => panic("atv screenshot failed: " + e)
  }

  // P3-7: corrupt/AAD-mismatched credentials propagate 401 auth_failed (never silently swallowed as None)
  enc_files.set("1000000000000004", "{\"v\":1,\"salt\":\"bad\",\"iv\":\"bad\",\"tag\":\"bad\",\"ciphertext\":\"bad\"}")
  let bad_cred_resp = devs.handle_airplay_http(
    AirPlayDeviceRefOs::{ id: "1000000000000004", ws: "ws-a", target: "AA:BB:CC:DD", name: "Apple TV" },
    "GET",
    "/status",
    [],
    Bytes::new(0),
  )
  edge_assert(bad_cred_resp.status == 401)
  enc_files.remove("1000000000000004")

  // P1-1: event-driven mDNS scan binds 0.0.0.0, uses disjoint >= 8<<32 monotonic ev_id, clamps 300..10000 / default 2500, expires in tick_expiry_with
  let (ev1, bind1, dl1) = devs.start_android_tv_mdns_scan_virtual(1000L)
  edge_assert(bind1 == "0.0.0.0")
  edge_assert(ev1 == MDNS_EVENT_ID_BASE && ev1 >= 34359738368L)
  edge_assert(dl1 == 3500L) // 1000 + 2500 default
  let (ev2, _, dl2) = devs.start_android_tv_mdns_scan_virtual(1000L, timeout_ms=50L)
  edge_assert(ev2 == ev1 + 1L && dl2 == 1300L) // clamped to 300ms min
  edge_assert(devs.active_mdns_scan_count() == 2)
  // Expire ev2 at 1400ms while ev1 stays active until 3500ms
  let _ = devs.tick_expiry_with(1400L, 1400L, fn(_pk : PendingProcKill) -> Unit {})
  edge_assert(devs.active_mdns_scan_count() == 1)
  edge_assert(devs.take_android_tv_mdns_result(ev2) is Some(_))
  edge_assert(devs.take_android_tv_mdns_result(ev1) is None)
  let _ = devs.tick_expiry_with(3500L, 3500L, fn(_pk : PendingProcKill) -> Unit {})
  edge_assert(devs.active_mdns_scan_count() == 0)
  edge_assert(devs.take_android_tv_mdns_result(ev1) is Some(_))
  // Unclaimed completed_mdns_scans are evicted after MDNS_RESULT_TTL_MS in tick_expiry_with
  let (ev3, _, dl3) = devs.start_android_tv_mdns_scan_virtual(4000L, timeout_ms=300L)
  edge_assert(dl3 == 4300L)
  let _ = devs.tick_expiry_with(4300L, 4300L, fn(_pk : PendingProcKill) -> Unit {})
  let _ = devs.tick_expiry_with(4300L + MDNS_RESULT_TTL_MS, 4300L + MDNS_RESULT_TTL_MS, fn(_pk : PendingProcKill) -> Unit {})
  edge_assert(devs.take_android_tv_mdns_result(ev3) is None)

  // P2-5: unconfigured data_dir fails closed (never falls back to /tmp)
  let uncfg = DevicesOsRuntime::new(now_fn=mock_now)
  edge_assert(uncfg.android_tv_adb_socket_path() is Err(_))
  edge_assert(uncfg.android_tv_adb_key_dir() is Err(_))

  // 4. tick_expiry_with expires BOTH AirPlay and Android TV pairing sessions
  edge_assert(devs.airplay_pairing.start("ws-a", "AA:BB", None, None, None, ["airplay"], Some("ap_t"), true, 1000L) is Ok(_))
  edge_assert(devs.android_tv_pairing.start("ws-a", "192.168.1.52", ["atv_remote"], Some("atv_t"), 1000L) is Ok(_))
  let (expired_pairs, _) = devs.tick_expiry_with(1000L, 40000L, fn(_pk : PendingProcKill) -> Unit {})
  edge_assert(expired_pairs == 2)
}

test "W17B-5 Opus R2 P1-C & P1-D: ConnectsOsRuntime feishu_apply_status_line gating & Feishu create_time cursor" {
  let mem = station_ops::MemFs::new()
  let h = MockMuxHarness::new(
    1700000099000L,
    fn(_id : Int64, _op : String, _json : String, _payload : Option[Bytes], _q : Array[host_shim::HostEvent]) -> Unit {},
  )
  let bridge = ConnectMuxBridge::with_hub(h.hub, mem.ops())
  let crt = ConnectsOsRuntime::new(bridge, "st-p1cd", ConnectsCallbacks::noop())
  edge_assert(crt.register_feishu("feishu-1", "cli_app", "cli_sec") is Ok(_))

  // P1-C (`#9052`): `feishu_apply_status_line` skips opening a status card on turns without
  // a chat message (both idle and non-idle), and clears cleanly on empty status.
  edge_assert(!crt.feishu_apply_status_line("feishu-1", "oc_1/om_1", "idle", true))
  edge_assert(!crt.feishu_apply_status_line("feishu-1", "oc_1/om_1", "running build", false))
  edge_assert(!crt.feishu_apply_status_line("feishu-1", "oc_1/om_1", "", true))

  // P1-D: `FeishuConnector` records message `create_time_ms` from inbound frame so reconnect
  // cursor advances to `create_time_ms` instead of skewed local `now_ms`.
  let f = match station_connects::FeishuConnector::new("cli_app", "cli_sec") {
    Ok(c) => c
    Err(e) => panic(e)
  }
  let create_ms = 1700000001000L
  let hold = f.threads.taking("feishu-1", "oc_chat1", "om_msg1", create_ms)
  edge_assert(f.threads.seen_of("feishu-1", "oc_chat1") == create_ms - 1L)
  f.threads.commit_taking(hold)
  edge_assert(f.threads.seen_of("feishu-1", "oc_chat1") == create_ms)
  edge_assert(f.threads.seen_of("feishu-1", "oc_chat1") != 1700000099000L)
}
