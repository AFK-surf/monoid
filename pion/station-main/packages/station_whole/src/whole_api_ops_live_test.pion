// Wave 17D-2 R2 comprehensive unit tests for the 10 live `call_op`s and honest 501 for the 7 withdrawn ops:
// 1. Updates (3): `updates.wait` (default autoUpdate=false, override preservation, spec parsing), `updates.check`, `updates.install`
// 2. Accounts & Profiles (5): `createKeyed` ({ id, overview }, mandatory key check, mkdir_p fail, key redaction),
//    `createMachine` ({ id, overview }, 403/400/409/501/200), `login` / `login.get` / `login.delete`
//    (read-only 403 & URL/code redaction, withheld 404, unsupported runtime 400, borrowed 409)
// 3. Copies / Workspaces (2): `copies.s3.test` (cross-endpoint/bucket secret non-reuse + secret scrubbing), `workspaces.join`
// 4. Honest 501 for the 7 withdrawn ops (deferred to Wave 17E):
//    `mcpServers.reloadAll`, `mcpServers.reloadOne`, `accounts.profiles.quota`,
//    `accounts.profiles.resetQuota`, `accounts.profiles.pace`, `copies.restore`, `xshare.hosts.put`.

import "base_codec"
import "station_api"
import "station_replica"

fn w17d2_owner(ws : String) -> station_api::Viewer {
  make_test_viewer("owner@example.com", "u-owner", ws, ws == "ws-main", "owner")
}

fn w17d2_member(ws : String) -> station_api::Viewer {
  make_test_viewer("member@example.com", "u-member", ws, ws == "ws-main", "member")
}

fn w17d2_readonly(ws : String) -> station_api::Viewer {
  make_test_viewer("ro@example.com", "u-ro", ws, ws == "ws-main", "viewer")
}

test "wave17d2 r2: updates.wait (default autoUpdate=false, override preserved, spec parsing), updates.check, updates.install" {
  let (_, _, api, updates, mem_fs, hooks) = make_mem_whole_api_fixture()
  let owner = w17d2_owner("ws-main")
  let member = w17d2_member("ws-main")

  // 1. Manager-only 403 across all 3 update ops
  for op in ["updates.wait", "updates.check", "updates.install"] {
    match (api.admin.host.call)(op, make_test_api_req_as("POST", "/updates", member), [], base_codec::json_obj([])) {
      Err(e) => if e.status != 403 { panic("expected 403 for non-manager " + op) }
      Ok(_) => panic("non-manager " + op + " must fail")
    }
  }

  // 2. `updates.wait`: valid specs persist `autoUpdateWhen`; invalid spec -> 400; `null` restores default `autoUpdate=false` (does NOT force true!)
  let wait_body = base_codec::json_obj([
    ("wait", base_codec::json_arr([
      base_codec::json_str("pr:9145"),
      base_codec::json_str("#42"),
      base_codec::json_str("fix:FB-123"),
      base_codec::json_str("commit:deadbeef1234"),
      base_codec::json_str("version:0.1.999"),
      base_codec::json_str("after:0.1.900"),
    ])),
  ])
  match (api.admin.host.call)("updates.wait", make_test_api_req_as("POST", "/updates/wait", owner), [], wait_body) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if !s.contains("#9145") || !s.contains("FB-123") || !s.contains(">= 0.1.999") || !s.contains("> 0.1.900") {
        panic("updates.wait response missing formatted conditions: " + s)
      }
    }
    Err(e) => panic("updates.wait valid failed: " + e.message)
  }
  match (mem_fs.ops().read_bytes)("/tmp/w17c2-api-test/config.json") {
    Ok(b) => {
      let txt = b.to_string()
      if !txt.contains("autoUpdateWhen") {
        panic("updates.wait did not persist autoUpdateWhen: " + txt)
      }
    }
    Err(_) => panic("config.json missing")
  }
  // Invalid wait condition -> 400
  match (api.admin.host.call)("updates.wait", make_test_api_req_as("POST", "/updates/wait", owner), [], base_codec::json_obj([("wait", base_codec::json_arr([base_codec::json_str("https://evil.test/x")]))])) {
    Err(e) => if e.status != 400 { panic("invalid wait condition must return 400") }
    Ok(_) => panic("invalid wait condition must fail")
  }
  // Clear wait with `null` when `autoUpdate` was not explicitly enabled -> MUST NOT write `"autoUpdate": true`!
  match (api.admin.host.call)("updates.wait", make_test_api_req_as("POST", "/updates/wait", owner), [], base_codec::json_obj([("wait", base_codec::json_null())])) {
    Ok(_) => ()
    Err(e) => panic("updates.wait null failed: " + e.message)
  }
  match (mem_fs.ops().read_bytes)("/tmp/w17c2-api-test/config.json") {
    Ok(b) => {
      let txt = b.to_string()
      if txt.contains("autoUpdateWhen") || txt.contains("\"autoUpdate\": true") {
        panic("updates.wait null must NOT force autoUpdate: true when default was false: " + txt)
      }
    }
    Err(_) => panic("config.json missing")
  }

  // When `autoUpdate: true` WAS explicitly configured, setting wait pauses it and clearing wait restores `true`
  let _ = mem_fs.put_text("/tmp/w17c2-api-test/config.json", "{\"autoUpdate\":true}", 384)
  match (api.admin.host.call)("updates.wait", make_test_api_req_as("POST", "/updates/wait", owner), [], base_codec::json_obj([("wait", base_codec::json_arr([base_codec::json_str("pr:9176")]))])) {
    Ok(_) => ()
    Err(e) => panic("updates.wait with autoUpdate=true failed: " + e.message)
  }
  match (api.admin.host.call)("updates.wait", make_test_api_req_as("POST", "/updates/wait", owner), [], base_codec::json_obj([("wait", base_codec::json_null())])) {
    Ok(_) => ()
    Err(e) => panic("updates.wait clear with autoUpdate=true failed: " + e.message)
  }
  match (mem_fs.ops().read_bytes)("/tmp/w17c2-api-test/config.json") {
    Ok(b) => {
      let txt = b.to_string()
      if txt.contains("autoUpdateWhen") || !txt.contains("\"autoUpdate\": true") {
        panic("updates.wait clear did not preserve explicit autoUpdate: true: " + txt)
      }
    }
    Err(_) => panic("config.json missing")
  }

  // 3. `updates.install`: rejects path traversal, arbitrary URLs in `id` or `to`, and non-codex `repair`
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("../evil"))])) {
    Err(e) => if e.status != 400 { panic("bad id must return 400") }
    Ok(_) => panic("bad id must fail")
  }
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("station")), ("to", base_codec::json_str("https://evil.test/bin"))])) {
    Err(e) => if e.status != 400 { panic("URL in to must return 400") }
    Ok(_) => panic("URL in to must fail")
  }
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("claude")), ("repair", base_codec::json_bool(true))])) {
    Err(e) => if e.status != 400 { panic("non-codex repair must return 400") }
    Ok(_) => panic("non-codex repair must fail")
  }

  // 4. Unhooked `updates.check` & `updates.install` return honest 501
  match (api.admin.host.call)("updates.check", make_test_api_req_as("POST", "/updates/check", owner), [], base_codec::json_obj([])) {
    Err(e) => if e.status != 501 { panic("unhooked updates.check must return 501") }
    Ok(_) => panic("unhooked updates.check returned fake 200")
  }
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("station"))])) {
    Err(e) => if e.status != 501 { panic("unhooked updates.install must return 501") }
    Ok(_) => panic("unhooked updates.install returned fake 200")
  }

  // 5. Hooked `updates.check` & `updates.install` succeed
  let mut last_op = ""
  hooks.on_updates_op = Some(fn(op : String, _body : base_codec::Json, _lang : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
    last_op = op
    Ok(updates_view_json(updates, base_codec::json_obj([])))
  })
  match (api.admin.host.call)("updates.check", make_test_api_req_as("POST", "/updates/check", owner), [], base_codec::json_obj([])) {
    Ok(_) => if last_op != "updates.check" { panic("hook not called for updates.check") }
    Err(e) => panic("hooked updates.check failed: " + e.message)
  }
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("station")), ("to", base_codec::json_str("0.1.900"))])) {
    Ok(_) => if last_op != "updates.install" { panic("hook not called for updates.install") }
    Err(e) => panic("hooked updates.install failed: " + e.message)
  }
}

test "wave17d2 r2: accounts.profiles 5 live ops (createKeyed, createMachine, login/get/delete) + 3 withdrawn 501s" {
  let (_, _, api, _, mem_fs, hooks) = make_mem_whole_api_fixture()
  let owner = w17d2_owner("ws-main")
  let member = w17d2_member("ws-main")
  let ro = w17d2_readonly("ws-main")

  // 1. Withdrawn ops MUST return honest 501
  for op in ["accounts.profiles.quota", "accounts.profiles.resetQuota", "accounts.profiles.pace"] {
    match (api.admin.host.call)(op, make_test_api_req_as("POST", "/profiles", owner), ["p1"], base_codec::json_obj([])) {
      Err(e) => if e.status != 501 { panic("withdrawn " + op + " must return 501, got " + e.status.to_string()) }
      Ok(_) => panic("withdrawn " + op + " returned fake 200")
    }
  }

  // 2. `createKeyed`: non-manager 403, subscription 400, unknown provider 400, unhooked key check 501,
  //    bad key check 400 (no config write!), valid key check returns `{ id, overview }` with key redacted!
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", member), [], base_codec::json_obj([])) {
    Err(e) => if e.status != 403 { panic("non-manager createKeyed must return 403") }
    Ok(_) => panic("non-manager createKeyed must fail")
  }
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", owner), [], base_codec::json_obj([("access", base_codec::json_obj([("kind", base_codec::json_str("subscription"))]))])) {
    Err(e) => if e.status != 400 { panic("subscription createKeyed must return 400") }
    Ok(_) => panic("subscription createKeyed must fail")
  }
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", owner), [], base_codec::json_obj([("access", base_codec::json_obj([("kind", base_codec::json_str("api-provider")), ("provider", base_codec::json_str("bogus-lab")), ("key", base_codec::json_str("sk-1"))]))])) {
    Err(e) => if e.status != 400 { panic("unknown provider must return 400") }
    Ok(_) => panic("unknown provider must fail")
  }
  let create_body = base_codec::json_obj([
    ("access", base_codec::json_obj([
      ("kind", base_codec::json_str("api-provider")),
      ("provider", base_codec::json_str("openai")),
      ("key", base_codec::json_str("sk-live-super-secret-key-98765")),
    ])),
  ])
  // Unhooked key verification MUST fail with 501 (never skip verification!)
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", owner), [], create_body) {
    Err(e) => if e.status != 501 { panic("unhooked createKeyed must return 501") }
    Ok(_) => panic("unhooked createKeyed skipped key verification")
  }
  // Failed key verification returns 400 and does NOT write config.json
  hooks.on_profile_live_op = Some(fn(op : String, _ps : Array[String], _b : base_codec::Json, _v : station_api::Viewer, _l : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
    if op == "accounts.profiles.createKeyed.check" {
      return Err(station_api::ApiError::new(400, "invalid API key"))
    }
    Err(station_api::ApiError::new(501, "not wired"))
  })
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", owner), [], create_body) {
    Err(e) => if e.status != 400 { panic("bad key createKeyed must return 400") }
    Ok(_) => panic("bad key createKeyed must fail")
  }
  match (mem_fs.ops().read_bytes)("/tmp/w17c2-api-test/config.json") {
    Ok(b) => if b.to_string().contains("sk-live-super-secret-key-98765") { panic("bad key must NOT be persisted to config.json") }
    Err(_) => ()
  }
  // Passing key verification persists & returns `{ id, overview }` with key redacted
  hooks.overview_for = Some(fn(_v, _l) -> Result[base_codec::Json, station_api::ApiError] {
    Ok(base_codec::json_obj([("profiles", base_codec::json_arr([base_codec::json_obj([("id", base_codec::json_str("openai")), ("hasKey", base_codec::json_bool(true))])]))]))
  })
  hooks.on_profile_live_op = Some(fn(op : String, ps : Array[String], _b : base_codec::Json, _v : station_api::Viewer, _l : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
    if op == "accounts.profiles.createKeyed.check" {
      return Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))]))
    }
    if op == "accounts.profiles.createMachine" {
      return Ok(base_codec::json_obj([("name", base_codec::json_str("alice@claude.ai"))]))
    }
    Ok(base_codec::json_obj([
      ("op", base_codec::json_str(op)),
      ("id", base_codec::json_str(if ps.length() > 0 { ps[0] } else { "" })),
      ("status", base_codec::json_str("pending")),
      ("url", base_codec::json_str("https://auth.example.com/secret-token")),
      ("code", base_codec::json_str("ABCD-1234")),
    ]))
  })
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", owner), [], create_body) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if s.contains("sk-live-super-secret-key-98765") {
        panic("createKeyed leaked plaintext API key: " + s)
      }
      if json_field_str(res, "id") != Some("openai") || base_codec::json_get(res, "overview") is None {
        panic("createKeyed response must be { id, overview }: " + s)
      }
    }
    Err(e) => panic("createKeyed failed: " + e.message)
  }

  // 3. `createMachine`: 403 non-manager, 400 unknown runtime, 200 `{ id, overview }`, 409 duplicate
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", member), [], base_codec::json_obj([("runtime", base_codec::json_str("claude"))])) {
    Err(e) => if e.status != 403 { panic("non-manager createMachine must return 403") }
    Ok(_) => panic("non-manager createMachine must fail")
  }
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", owner), [], base_codec::json_obj([("runtime", base_codec::json_str("bogus"))])) {
    Err(e) => if e.status != 400 { panic("unknown runtime must return 400") }
    Ok(_) => panic("unknown runtime must fail")
  }
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", owner), [], base_codec::json_obj([("runtime", base_codec::json_str("claude"))])) {
    Ok(res) => {
      if json_field_str(res, "id") != Some("machine-claude") || base_codec::json_get(res, "overview") is None {
        panic("createMachine must return { id, overview }: " + base_codec::json_stringify(res))
      }
    }
    Err(e) => panic("hooked createMachine failed: " + e.message)
  }
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", owner), [], base_codec::json_obj([("runtime", base_codec::json_str("claude"))])) {
    Err(e) => if e.status != 409 { panic("duplicate createMachine must return 409") }
    Ok(_) => panic("expected 409")
  }

  // 4. `login` / `login.get` / `login.delete`: withheld 404, read-only 403 on POST/DELETE, URL/code redacted on GET, borrowed 409, keyed 400
  let seed = "{\"profiles\":[{\"id\":\"sub-claude\",\"name\":\"Claude Sub\",\"runtime\":\"claude\",\"access\":{\"kind\":\"subscription\"}},{\"id\":\"withheld-p\",\"name\":\"Hidden\",\"runtime\":\"claude\",\"access\":{\"kind\":\"subscription\"},\"withheld\":[\"ws-main\"]},{\"id\":\"bor-claude\",\"name\":\"Borrowed\",\"runtime\":\"claude\",\"access\":{\"kind\":\"subscription\"},\"sharedFrom\":\"st-other\"},{\"id\":\"keyed-p\",\"name\":\"Keyed\",\"runtime\":\"claude\",\"access\":{\"kind\":\"anthropic-api\",\"key\":\"sk-ant-1\"}}]}"
  let _ = mem_fs.put_text("/tmp/w17c2-api-test/config.json", seed, 384)

  match (api.admin.host.call)("accounts.profiles.login", make_test_api_req_as("POST", "/profiles/withheld-p/login", owner), ["withheld-p"], base_codec::json_obj([])) {
    Err(e) => if e.status != 404 { panic("withheld profile login must return 404") }
    Ok(_) => panic("expected 404 for withheld profile")
  }
  match (api.admin.host.call)("accounts.profiles.login", make_test_api_req_as("POST", "/profiles/sub-claude/login", ro), ["sub-claude"], base_codec::json_obj([])) {
    Err(e) => if e.status != 403 { panic("read-only login POST must return 403") }
    Ok(_) => panic("expected 403")
  }
  match (api.admin.host.call)("accounts.profiles.login.delete", make_test_api_req_as("DELETE", "/profiles/sub-claude/login", ro), ["sub-claude"], base_codec::json_obj([])) {
    Err(e) => if e.status != 403 { panic("read-only login DELETE must return 403") }
    Ok(_) => panic("expected 403")
  }
  match (api.admin.host.call)("accounts.profiles.login.get", make_test_api_req_as("GET", "/profiles/sub-claude/login", ro), ["sub-claude"], base_codec::json_obj([])) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if s.contains("secret-token") || s.contains("ABCD-1234") {
        panic("read-only login.get MUST redact url/code: " + s)
      }
    }
    Err(e) => panic("read-only login.get failed: " + e.message)
  }
  match (api.admin.host.call)("accounts.profiles.login", make_test_api_req_as("POST", "/profiles/keyed-p/login", owner), ["keyed-p"], base_codec::json_obj([])) {
    Err(e) => if e.status != 400 { panic("keyed profile login must return 400") }
    Ok(_) => panic("expected 400")
  }
  match (api.admin.host.call)("accounts.profiles.login", make_test_api_req_as("POST", "/profiles/bor-claude/login", owner), ["bor-claude"], base_codec::json_obj([])) {
    Err(e) => if e.status != 409 { panic("borrowed profile login must return 409") }
    Ok(_) => panic("expected 409")
  }
  for op in ["accounts.profiles.login", "accounts.profiles.login.get", "accounts.profiles.login.delete"] {
    match (api.admin.host.call)(op, make_test_api_req_as("POST", "/profiles/sub-claude/login", owner), ["sub-claude"], base_codec::json_obj([])) {
      Ok(_) => ()
      Err(e) => panic("hooked " + op + " failed: " + e.message)
    }
  }
}

test "wave17d2 r2: copies.s3.test (no cross-endpoint secret reuse + secret scrub) and 4 withdrawn admin 501s" {
  let (_, _, api, _, mem_fs, hooks) = make_mem_whole_api_fixture()
  let owner = w17d2_owner("ws-main")
  let member = w17d2_member("ws-main")

  // 1. Withdrawn admin ops MUST return honest 501
  for op in ["mcpServers.reloadAll", "mcpServers.reloadOne", "copies.restore", "xshare.hosts.put"] {
    match (api.admin.host.call)(op, make_test_api_req_as("POST", "/admin", owner), ["s1"], base_codec::json_obj([])) {
      Err(e) => if e.status != 501 { panic("withdrawn " + op + " must return 501, got " + e.status.to_string()) }
      Ok(_) => panic("withdrawn " + op + " returned fake 200")
    }
  }

  // 2. `copies.s3.test`: 403 non-manager, 400 invalid endpoint, cross-endpoint/bucket MUST NOT reuse saved secret!
  match (api.admin.host.call)("copies.s3.test", make_test_api_req_as("POST", "/copies/s3/test", member), [], base_codec::json_obj([])) {
    Err(e) => if e.status != 403 { panic("non-manager copies.s3.test must return 403") }
    Ok(_) => panic("expected 403")
  }
  let saved_cfg = "{\"backup\":{\"s3\":[{\"id\":\"r2\",\"name\":\"R2\",\"endpoint\":\"https://s3.trusted.example\",\"bucket\":\"trusted-bkt\",\"accessKeyId\":\"SAVED_KEY_ID\",\"secretAccessKey\":\"SAVED_SUPER_SECRET\",\"encryptionKey\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}]}}"
  let _ = mem_fs.put_text("/tmp/w17c2-api-test/config.json", saved_cfg, 384)

  // Attacker supplies saved `id: "r2"` with a DIFFERENT endpoint -> MUST NOT inherit SAVED_KEY_ID/SAVED_SUPER_SECRET!
  let mut observed_secret = ""
  hooks.on_s3_test = Some(fn(t : station_replica::NormalizedS3Target) -> Result[Unit, String] {
    observed_secret = t.secret_access_key
    Err("auth failed for " + t.access_key_id + " / " + t.secret_access_key)
  })
  let cross_ep = base_codec::json_obj([
    ("id", base_codec::json_str("r2")),
    ("endpoint", base_codec::json_str("https://attacker.example")),
    ("bucket", base_codec::json_str("trusted-bkt")),
  ])
  match (api.admin.host.call)("copies.s3.test", make_test_api_req_as("POST", "/copies/s3/test", owner), [], cross_ep) {
    Err(e) => if e.status != 400 { panic("cross-endpoint without explicit creds must fail 400, got " + e.status.to_string()) }
    Ok(_) => panic("cross-endpoint S3 test MUST NOT reuse saved credentials")
  }
  if observed_secret == "SAVED_SUPER_SECRET" {
    panic("saved S3 secret was leaked to attacker endpoint!")
  }

  // Same endpoint+bucket with saved `id: "r2"` MAY reuse saved creds, and error MUST scrub them
  let same_ep = base_codec::json_obj([
    ("id", base_codec::json_str("r2")),
    ("endpoint", base_codec::json_str("https://s3.trusted.example")),
    ("bucket", base_codec::json_str("trusted-bkt")),
  ])
  match (api.admin.host.call)("copies.s3.test", make_test_api_req_as("POST", "/copies/s3/test", owner), [], same_ep) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if s.contains("SAVED_SUPER_SECRET") || s.contains("SAVED_KEY_ID") {
        panic("copies.s3.test leaked S3 credentials in error: " + s)
      }
      if json_field_bool(res, "ok") != Some(false) {
        panic("expected ok: false")
      }
    }
    Err(e) => panic("same-endpoint copies.s3.test failed: " + e.message)
  }
}
