// Wave 17D-2 comprehensive unit tests for the 17 live `call_op`s:
// 1. Updates (3): `updates.check`, `updates.wait`, `updates.install` (manager 403, wait spec parsing, path/URL injection 400, unhooked 501, hooked 200)
// 2. Accounts & Profiles (8): `createKeyed` (validation, atomic persist, key redaction), `createMachine` (403/400/409/501/200),
//    `pace` (v1/v2/unchanged), `resetQuota` (idempotency-key/404/400/501/200), `quota` (404/501/200), `login`/`login.get`/`login.delete` (404/400/409/501/200)
// 3. MCP Servers hot reload (2): `mcpServers.reloadAll`, `mcpServers.reloadOne` (live `on_mcp_view` + `on_mcp_reload`)
// 4. Workspaces / Copies / XShare (4): `workspaces.join`, `copies.s3.test` (merge + secret scrubbing), `copies.restore` (path traversal 400), `xshare.hosts.put`

import "base_codec"
import "http1"
import "station_api"
import "station_http"
import "station_replica"
import "station_tools"

fn w17d2_owner(ws : String) -> station_api::Viewer {
  make_test_viewer("owner@example.com", "u-owner", ws, ws == "ws-main", "owner")
}

fn w17d2_member(ws : String) -> station_api::Viewer {
  make_test_viewer("member@example.com", "u-member", ws, ws == "ws-main", "member")
}

test "wave17d2: updates.wait, updates.check, updates.install (403, wait spec parsing, injection guard, unhooked 501, hooked 200)" {
  let (_, _, api, updates, mem_fs, hooks) = make_mem_whole_api_fixture()
  let owner = w17d2_owner("ws-main")
  let member = w17d2_member("ws-main")

  // 1. Manager-only 403 across all 3 update ops
  for op in ["updates.wait", "updates.check", "updates.install"] {
    match (api.admin.host.call)(op, make_test_api_req_as("POST", "/updates", member), [], base_codec::json_obj([])) {
      Err(e) => if e.status != 403 { panic("expected 403 for non-manager " + op) }
      Ok(_) => panic("non-manager " + op + " must fail")
    }
  }

  // 2. `updates.wait`: valid specs persist `autoUpdateWhen` and pause `autoUpdate`; invalid spec -> 400; `null` restores `autoUpdate`
  let wait_body = base_codec::json_obj([
    ("wait", base_codec::json_arr([
      base_codec::json_str("pr:9145"),
      base_codec::json_str("#42"),
      base_codec::json_str("fix:FB-123"),
      base_codec::json_str("commit:deadbeef1234"),
      base_codec::json_str("version:0.1.999"),
      base_codec::json_str("after:0.1.900"),
    ])),
  ])
  match (api.admin.host.call)("updates.wait", make_test_api_req_as("POST", "/updates/wait", owner), [], wait_body) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if !s.contains("#9145") || !s.contains("FB-123") || !s.contains(">= 0.1.999") || !s.contains("> 0.1.900") {
        panic("updates.wait response missing formatted conditions: " + s)
      }
    }
    Err(e) => panic("updates.wait valid failed: " + e.message)
  }
  match (mem_fs.ops().read_bytes)("/tmp/w17c2-api-test/config.json") {
    Ok(b) => {
      let txt = b.to_string()
      if !txt.contains("autoUpdateWhen") || !txt.contains("\"autoUpdate\": false") {
        panic("updates.wait did not persist autoUpdateWhen: " + txt)
      }
    }
    Err(_) => panic("config.json missing")
  }
  // Invalid wait condition -> 400
  match (api.admin.host.call)("updates.wait", make_test_api_req_as("POST", "/updates/wait", owner), [], base_codec::json_obj([("wait", base_codec::json_arr([base_codec::json_str("https://evil.test/x")]))])) {
    Err(e) => if e.status != 400 { panic("invalid wait condition must return 400") }
    Ok(_) => panic("invalid wait condition must fail")
  }
  // Clear wait with `null` -> removes `autoUpdateWhen` and restores `autoUpdate: true`
  match (api.admin.host.call)("updates.wait", make_test_api_req_as("POST", "/updates/wait", owner), [], base_codec::json_obj([("wait", base_codec::json_null())])) {
    Ok(_) => ()
    Err(e) => panic("updates.wait null failed: " + e.message)
  }
  match (mem_fs.ops().read_bytes)("/tmp/w17c2-api-test/config.json") {
    Ok(b) => {
      let txt = b.to_string()
      if txt.contains("autoUpdateWhen") || !txt.contains("\"autoUpdate\": true") {
        panic("updates.wait null did not restore autoUpdate: " + txt)
      }
    }
    Err(_) => panic("config.json missing")
  }

  // 3. `updates.install`: rejects path traversal, arbitrary URLs in `id` or `to`, and non-codex `repair`
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("../evil"))])) {
    Err(e) => if e.status != 400 { panic("bad id must return 400") }
    Ok(_) => panic("bad id must fail")
  }
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("station")), ("to", base_codec::json_str("https://evil.test/bin"))])) {
    Err(e) => if e.status != 400 { panic("URL in to must return 400") }
    Ok(_) => panic("URL in to must fail")
  }
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("claude")), ("repair", base_codec::json_bool(true))])) {
    Err(e) => if e.status != 400 { panic("non-codex repair must return 400") }
    Ok(_) => panic("non-codex repair must fail")
  }

  // 4. Unhooked `updates.check` & `updates.install` return honest 501
  match (api.admin.host.call)("updates.check", make_test_api_req_as("POST", "/updates/check", owner), [], base_codec::json_obj([])) {
    Err(e) => if e.status != 501 { panic("unhooked updates.check must return 501") }
    Ok(_) => panic("unhooked updates.check returned fake 200")
  }
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("station"))])) {
    Err(e) => if e.status != 501 { panic("unhooked updates.install must return 501") }
    Ok(_) => panic("unhooked updates.install returned fake 200")
  }

  // 5. Hooked `updates.check` & `updates.install` succeed
  let mut last_op = ""
  hooks.on_updates_op = Some(fn(op : String, _body : base_codec::Json, _lang : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
    last_op = op
    Ok(updates_view_json(updates, base_codec::json_obj([])))
  })
  match (api.admin.host.call)("updates.check", make_test_api_req_as("POST", "/updates/check", owner), [], base_codec::json_obj([])) {
    Ok(_) => if last_op != "updates.check" { panic("hook not called for updates.check") }
    Err(e) => panic("hooked updates.check failed: " + e.message)
  }
  match (api.admin.host.call)("updates.install", make_test_api_req_as("POST", "/updates", owner), [], base_codec::json_obj([("id", base_codec::json_str("station")), ("to", base_codec::json_str("0.1.900"))])) {
    Ok(_) => if last_op != "updates.install" { panic("hook not called for updates.install") }
    Err(e) => panic("hooked updates.install failed: " + e.message)
  }
}

test "wave17d2: accounts.profiles 8 live ops (createKeyed, createMachine, pace, resetQuota, quota, login/get/delete)" {
  let (_, _, api, _, mem_fs, hooks) = make_mem_whole_api_fixture()
  let owner = w17d2_owner("ws-main")
  let member = w17d2_member("ws-main")

  // 1. `createKeyed`: non-manager 403, subscription 400, missing key 400, unknown provider 400, valid persists & redacts key!
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", member), [], base_codec::json_obj([])) {
    Err(e) => if e.status != 403 { panic("non-manager createKeyed must return 403") }
    Ok(_) => panic("non-manager createKeyed must fail")
  }
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", owner), [], base_codec::json_obj([("access", base_codec::json_obj([("kind", base_codec::json_str("subscription"))]))])) {
    Err(e) => if e.status != 400 { panic("subscription createKeyed must return 400") }
    Ok(_) => panic("subscription createKeyed must fail")
  }
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", owner), [], base_codec::json_obj([("access", base_codec::json_obj([("kind", base_codec::json_str("api-provider")), ("provider", base_codec::json_str("bogus-lab")), ("key", base_codec::json_str("sk-1"))]))])) {
    Err(e) => if e.status != 400 { panic("unknown provider must return 400") }
    Ok(_) => panic("unknown provider must fail")
  }
  let create_body = base_codec::json_obj([
    ("access", base_codec::json_obj([
      ("kind", base_codec::json_str("api-provider")),
      ("provider", base_codec::json_str("openai")),
      ("key", base_codec::json_str("sk-live-super-secret-key-98765")),
    ])),
  ])
  match (api.admin.host.call)("accounts.profiles.createKeyed", make_test_api_req_as("POST", "/profiles", owner), [], create_body) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if s.contains("sk-live-super-secret-key-98765") {
        panic("createKeyed leaked plaintext API key: " + s)
      }
      if !s.contains("\"id\":\"openai\"") || !s.contains("\"hasKey\":true") {
        panic("createKeyed response missing id/hasKey: " + s)
      }
    }
    Err(e) => panic("createKeyed failed: " + e.message)
  }

  // 2. `pace`: v1 & v2 & unchanged rev
  match (api.admin.host.call)("accounts.profiles.pace", make_test_api_req_as("GET", "/profiles/pace", member), [], base_codec::json_obj([])) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if !s.contains("\"openai\"") || !s.contains("\"fromHour\"") {
        panic("pace v1 missing profile or fromHour: " + s)
      }
    }
    Err(e) => panic("pace v1 failed: " + e.message)
  }
  let rev = match (api.admin.host.call)("accounts.profiles.pace", make_test_api_req_as("GET", "/profiles/pace?v=2", member), [], base_codec::json_obj([])) {
    Ok(res) => match json_field_str(res, "rev") { Some(r) if r.length() > 0 => r, _ => panic("pace v2 missing rev") }
    Err(e) => panic("pace v2 failed: " + e.message)
  }
  match (api.admin.host.call)("accounts.profiles.pace", make_test_api_req_as("GET", "/profiles/pace?v=2&sinceRev=" + rev, member), [], base_codec::json_obj([])) {
    Ok(res) => if json_field_bool(res, "unchanged") != Some(true) { panic("pace v2 unchanged expected") }
    Err(e) => panic("pace v2 unchanged failed: " + e.message)
  }

  // 3. `createMachine`: 403 non-manager, 400 unknown runtime, 501 unhooked, 200 hooked, 409 duplicate
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", member), [], base_codec::json_obj([("runtime", base_codec::json_str("claude"))])) {
    Err(e) => if e.status != 403 { panic("non-manager createMachine must return 403") }
    Ok(_) => panic("non-manager createMachine must fail")
  }
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", owner), [], base_codec::json_obj([("runtime", base_codec::json_str("bogus"))])) {
    Err(e) => if e.status != 400 { panic("unknown runtime must return 400") }
    Ok(_) => panic("unknown runtime must fail")
  }
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", owner), [], base_codec::json_obj([("runtime", base_codec::json_str("claude"))])) {
    Err(e) => if e.status != 501 { panic("unhooked createMachine must return 501") }
    Ok(_) => panic("unhooked createMachine returned fake 200")
  }

  // Seed a subscription profile and a borrowed subscription profile for quota/resetQuota/login tests
  let seed = "{\"profiles\":[{\"id\":\"sub-claude\",\"name\":\"Claude Sub\",\"runtime\":\"claude\",\"access\":{\"kind\":\"subscription\"}},{\"id\":\"bor-claude\",\"name\":\"Borrowed\",\"runtime\":\"claude\",\"access\":{\"kind\":\"subscription\"},\"sharedFrom\":\"st-other\"},{\"id\":\"keyed-p\",\"name\":\"Keyed\",\"runtime\":\"claude\",\"access\":{\"kind\":\"anthropic-api\",\"key\":\"sk-ant-1\"}}]}"
  let _ = mem_fs.put_text("/tmp/w17c2-api-test/config.json", seed, 384)

  // 4. `resetQuota`: missing idempotency key 400, unknown profile 404, non-subscription 400, unhooked 501
  match (api.admin.host.call)("accounts.profiles.resetQuota", make_test_api_req_as("POST", "/profiles/sub-claude/reset-quota", owner), ["sub-claude"], base_codec::json_obj([])) {
    Err(e) => if e.status != 400 { panic("missing idempotency-key must return 400") }
    Ok(_) => panic("missing idempotency-key must fail")
  }
  let (norm_p, norm_qr, norm_q) = station_http::parse_request_target("/profiles/sub-claude/reset-quota")
  let req_idem = station_api::ApiRequest::from_http(
    station_http::HttpRequest::{
      conn_id: 0,
      method: "POST",
      raw_target: "/profiles/sub-claude/reset-quota",
      path: norm_p,
      query_raw: norm_qr,
      query: norm_q,
      version: http1::Version::Http11,
      headers: [http1::Header::{ name: "idempotency-key", value: "idem-1" }],
      body: Bytes::new(0),
      peer: "",
      raw_head: Bytes::new(0),
    },
    owner,
  )
  match (api.admin.host.call)("accounts.profiles.resetQuota", req_idem, ["nope"], base_codec::json_obj([])) {
    Err(e) => if e.status != 404 { panic("unknown profile resetQuota must return 404") }
    Ok(_) => panic("expected 404")
  }
  match (api.admin.host.call)("accounts.profiles.resetQuota", req_idem, ["keyed-p"], base_codec::json_obj([])) {
    Err(e) => if e.status != 400 { panic("non-subscription resetQuota must return 400") }
    Ok(_) => panic("expected 400")
  }
  match (api.admin.host.call)("accounts.profiles.resetQuota", req_idem, ["sub-claude"], base_codec::json_obj([])) {
    Err(e) => if e.status != 501 { panic("unhooked resetQuota must return 501") }
    Ok(_) => panic("expected 501")
  }

  // 5. `quota`, `login`, `login.get`, `login.delete`: 404/400/409/501 unhooked, then 200 hooked
  match (api.admin.host.call)("accounts.profiles.quota", make_test_api_req_as("POST", "/profiles/nope/quota", owner), ["nope"], base_codec::json_obj([])) {
    Err(e) => if e.status != 404 { panic("unknown profile quota must return 404") }
    Ok(_) => panic("expected 404")
  }
  match (api.admin.host.call)("accounts.profiles.login", make_test_api_req_as("POST", "/profiles/keyed-p/login", owner), ["keyed-p"], base_codec::json_obj([])) {
    Err(e) => if e.status != 400 { panic("keyed profile login must return 400") }
    Ok(_) => panic("expected 400")
  }
  match (api.admin.host.call)("accounts.profiles.login", make_test_api_req_as("POST", "/profiles/bor-claude/login", owner), ["bor-claude"], base_codec::json_obj([])) {
    Err(e) => if e.status != 409 { panic("borrowed profile login must return 409") }
    Ok(_) => panic("expected 409")
  }
  match (api.admin.host.call)("accounts.profiles.login", make_test_api_req_as("POST", "/profiles/sub-claude/login", owner), ["sub-claude"], base_codec::json_obj([])) {
    Err(e) => if e.status != 501 { panic("unhooked login must return 501") }
    Ok(_) => panic("expected 501")
  }

  // Wire `on_profile_live_op` and verify all live ops succeed
  hooks.on_profile_live_op = Some(fn(op : String, ps : Array[String], _b : base_codec::Json, _v : station_api::Viewer, _l : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
    if op == "accounts.profiles.createMachine" {
      return Ok(base_codec::json_obj([("name", base_codec::json_str("alice@claude.ai"))]))
    }
    Ok(base_codec::json_obj([("op", base_codec::json_str(op)), ("id", base_codec::json_str(if ps.length() > 0 { ps[0] } else { "" }))]))
  })
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", owner), [], base_codec::json_obj([("runtime", base_codec::json_str("claude"))])) {
    Ok(res) => if json_field_str(res, "id") != Some("machine-claude") { panic("expected machine-claude") }
    Err(e) => panic("hooked createMachine failed: " + e.message)
  }
  // Duplicate machine profile -> 409
  match (api.admin.host.call)("accounts.profiles.createMachine", make_test_api_req_as("POST", "/profiles/machine", owner), [], base_codec::json_obj([("runtime", base_codec::json_str("claude"))])) {
    Err(e) => if e.status != 409 { panic("duplicate createMachine must return 409") }
    Ok(_) => panic("expected 409")
  }
  match (api.admin.host.call)("accounts.profiles.resetQuota", req_idem, ["sub-claude"], base_codec::json_obj([])) {
    Ok(_) => ()
    Err(e) => panic("hooked resetQuota failed: " + e.message)
  }
  match (api.admin.host.call)("accounts.profiles.quota", make_test_api_req_as("POST", "/profiles/sub-claude/quota", owner), ["sub-claude"], base_codec::json_obj([])) {
    Ok(_) => ()
    Err(e) => panic("hooked quota failed: " + e.message)
  }
  for op in ["accounts.profiles.login", "accounts.profiles.login.get", "accounts.profiles.login.delete"] {
    match (api.admin.host.call)(op, make_test_api_req_as("POST", "/profiles/sub-claude/login", owner), ["sub-claude"], base_codec::json_obj([])) {
      Ok(_) => ()
      Err(e) => panic("hooked " + op + " failed: " + e.message)
    }
  }
}

test "wave17d2: copies.s3.test (merge + secret scrub), copies.restore (traversal 400), xshare.hosts.put, and mcpServers live view" {
  let (_, agents, api, _, mem_fs, hooks) = make_mem_whole_api_fixture()
  let owner = w17d2_owner("ws-main")
  let member = w17d2_member("ws-main")

  // 1. `copies.s3.test`: 403 non-manager, 400 invalid endpoint, 501 unhooked, 200 hooked with secret scrubbing on error
  match (api.admin.host.call)("copies.s3.test", make_test_api_req_as("POST", "/copies/s3/test", member), [], base_codec::json_obj([])) {
    Err(e) => if e.status != 403 { panic("non-manager copies.s3.test must return 403") }
    Ok(_) => panic("expected 403")
  }
  match (api.admin.host.call)("copies.s3.test", make_test_api_req_as("POST", "/copies/s3/test", owner), [], base_codec::json_obj([("endpoint", base_codec::json_str("ftp://evil.test")), ("bucket", base_codec::json_str("b"))])) {
    Err(e) => if e.status != 400 { panic("invalid s3 endpoint must return 400") }
    Ok(_) => panic("expected 400")
  }
  let valid_s3 = base_codec::json_obj([
    ("endpoint", base_codec::json_str("https://s3.example.com")),
    ("bucket", base_codec::json_str("my-bucket")),
    ("accessKeyId", base_codec::json_str("AKIA_SECRET_ID_1")),
    ("secretAccessKey", base_codec::json_str("SUPER_SECRET_S3_VALUE_999")),
  ])
  match (api.admin.host.call)("copies.s3.test", make_test_api_req_as("POST", "/copies/s3/test", owner), [], valid_s3) {
    Err(e) => if e.status != 501 { panic("unhooked copies.s3.test must return 501") }
    Ok(_) => panic("expected 501")
  }
  hooks.on_s3_test = Some(fn(t : station_replica::NormalizedS3Target) -> Result[Unit, String] {
    Err("auth failed for " + t.access_key_id + " / " + t.secret_access_key)
  })
  match (api.admin.host.call)("copies.s3.test", make_test_api_req_as("POST", "/copies/s3/test", owner), [], valid_s3) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if s.contains("SUPER_SECRET_S3_VALUE_999") || s.contains("AKIA_SECRET_ID_1") {
        panic("copies.s3.test leaked S3 credentials in error: " + s)
      }
      if json_field_bool(res, "ok") != Some(false) {
        panic("expected ok: false")
      }
    }
    Err(e) => panic("copies.s3.test hooked error failed: " + e.message)
  }

  // 2. `copies.restore`: 403 non-manager, 400 traversal, 501 unhooked, 200 hooked
  match (api.admin.host.call)("copies.restore", make_test_api_req_as("POST", "/copies/restore", member), [], base_codec::json_obj([])) {
    Err(e) => if e.status != 403 { panic("non-manager copies.restore must return 403") }
    Ok(_) => panic("expected 403")
  }
  match (api.admin.host.call)("copies.restore", make_test_api_req_as("POST", "/copies/restore", owner), [], base_codec::json_obj([("station", base_codec::json_str("../etc")), ("gen", base_codec::json_str("g1")), ("from", base_codec::json_obj([("s3", base_codec::json_str("r2"))]))])) {
    Err(e) => if e.status != 400 { panic("path traversal in copies.restore must return 400") }
    Ok(_) => panic("expected 400")
  }
  let valid_restore = base_codec::json_obj([
    ("station", base_codec::json_str("st-lost-1")),
    ("gen", base_codec::json_str("gen-42")),
    ("from", base_codec::json_obj([("s3", base_codec::json_str("r2-main"))])),
  ])
  match (api.admin.host.call)("copies.restore", make_test_api_req_as("POST", "/copies/restore", owner), [], valid_restore) {
    Err(e) => if e.status != 501 { panic("unhooked copies.restore must return 501") }
    Ok(_) => panic("expected 501")
  }
  hooks.on_copies_restore = Some(fn(_ws, _st, _gen, _fk, _fid) -> Result[Unit, String] { Ok(()) })
  match (api.admin.host.call)("copies.restore", make_test_api_req_as("POST", "/copies/restore", owner), [], valid_restore) {
    Ok(res) => if json_field_bool(res, "restoring") != Some(true) { panic("expected restoring: true") }
    Err(e) => panic("hooked copies.restore failed: " + e.message)
  }

  // 3. `xshare.hosts.put`: same-workspace rejected 400, bad id rejected 400, valid member persists to `<data>/xshare/state.json`
  match (api.admin.host.call)("xshare.hosts.put", make_test_api_req_as("PUT", "/xshare/hosts", member), [], base_codec::json_obj([("workspace", base_codec::json_str("ws-main")), ("station", base_codec::json_str("st-remote"))])) {
    Err(e) => if e.status != 400 { panic("same-workspace xshare.hosts.put must return 400") }
    Ok(_) => panic("expected 400")
  }
  match (api.admin.host.call)("xshare.hosts.put", make_test_api_req_as("PUT", "/xshare/hosts", member), [], base_codec::json_obj([("workspace", base_codec::json_str("ws-partner")), ("name", base_codec::json_str("Partner WS")), ("station", base_codec::json_str("st-partner-1")), ("stationName", base_codec::json_str("Partner Box"))])) {
    Ok(res) => if json_field_bool(res, "ok") != Some(true) { panic("expected ok: true") }
    Err(e) => panic("xshare.hosts.put failed: " + e.message)
  }
  match (agents.jobs.fs.read_file)("/tmp/w17c2-api-test/xshare/state.json") {
    Some(txt) => {
      if !txt.contains("ws-main/st-partner-1") || !txt.contains("Partner WS") {
        panic("xshare state.json missing persisted host: " + txt)
      }
    }
    None => panic("xshare state.json not written")
  }

  // 4. `mcpServers.reloadAll` reflects live `on_mcp_view` status ("ready")
  let _ = mem_fs.put_text("/tmp/w17c2-api-test/config.json", "{\"mcpServers\":{\"s1\":{\"command\":\"echo\"}}}", 384)
  hooks.on_mcp_reload = Some(fn(_n : Option[String]) -> Unit { () })
  hooks.on_mcp_view = Some(fn() -> Array[(String, station_tools::ManagedServerRuntime)] {
    [("s1", station_tools::ManagedServerRuntime::{ status: "ready", tools: ["ping"], error: None })]
  })
  match (api.admin.host.call)("mcpServers.reloadAll", make_test_api_req_as("POST", "/mcp-servers/reload", owner), [], base_codec::json_obj([])) {
    Ok(res) => {
      let s = base_codec::json_stringify(res)
      if !s.contains("\"status\":\"ready\"") || !s.contains("ping") {
        panic("mcpServers.reloadAll did not return live runtime status: " + s)
      }
    }
    Err(e) => panic("mcpServers.reloadAll failed: " + e.message)
  }
}
