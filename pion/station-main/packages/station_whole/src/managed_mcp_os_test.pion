// Unit tests for Wave 17E-4A Managed MCP runtime (`managed_mcp_os.pion`):
// - Disjoint `event_id` `[12<<32, 13<<32)` & `MuxToken::Tagged` `5300..5309` boundaries
// - Stdio JSON-RPC 2.0 state machine (chunked framing, pagination, list_changed, backoff, circuit breaker, SIGTERM->SIGKILL)
// - Streamable HTTP (JSON + SSE responses, Mcp-Session-Id, DELETE on close, orphaned stream.open cleanup)
// - Legacy HTTP+SSE (`event: endpoint` resolution, POST + SSE delivery, drop/reconnect)
// - URL userinfo / header / env / error redaction + `truncate_content` + `ManagedMcpAsks` approval card flow

import "base_codec"
import "builders_core"
import "host_shim"
import "station_sys"
import "station_tools"

struct MockMcpHarness {
  spawns : Array[(Int64, station_sys::SpawnOptions)]
  stdin_writes : Array[(Int64, String)]
  stdin_closed : Array[Int64]
  kills : Array[(Int64, Int, Bool)]
  proc_closed : Array[Int64]
  stream_opens : Array[(builders_core::MuxToken, String, Option[Bytes])]
  stream_reads : Array[(builders_core::MuxToken, Int, Int)]
  stream_closes : Array[Int]
  mut status_changes : Int
  deferred_replies : Array[(Int, Int, String)]
  mut next_handle : Int64
}

fn MockMcpHarness::new() -> (MockMcpHarness, ManagedMcpIo) {
  let h = MockMcpHarness::{
    spawns: [],
    stdin_writes: [],
    stdin_closed: [],
    kills: [],
    proc_closed: [],
    stream_opens: [],
    stream_reads: [],
    stream_closes: [],
    status_changes: 0,
    deferred_replies: [],
    next_handle: 100L,
  }
  let io = ManagedMcpIo::{
    spawn_proc: fn(ev_id : Int64, opts : station_sys::SpawnOptions) -> Result[station_sys::ChildProcess, String] {
      h.spawns.push((ev_id, opts))
      let hid = h.next_handle
      h.next_handle = h.next_handle + 1L
      Ok(station_sys::ChildProcess::{ handle: hid, pid: hid.to_int() + 1000 })
    },
    write_stdin: fn(ch : station_sys::ChildProcess, d : Bytes) -> Bool {
      h.stdin_writes.push((ch.handle, d.to_string()))
      true
    },
    close_stdin: fn(ch : station_sys::ChildProcess) -> Bool {
      h.stdin_closed.push(ch.handle)
      true
    },
    kill_proc: fn(ch : station_sys::ChildProcess, sig : Int, group : Bool) -> Int {
      h.kills.push((ch.handle, sig, group))
      0
    },
    close_proc: fn(ch : station_sys::ChildProcess) -> Bool {
      h.proc_closed.push(ch.handle)
      true
    },
    stream_open: fn(tok : builders_core::MuxToken, args : String, body : Option[Bytes]) -> Int64 {
      h.stream_opens.push((tok, args, body))
      h.stream_opens.length().to_int64()
    },
    stream_read: fn(tok : builders_core::MuxToken, sid : Int, stall : Int) -> Int64 {
      h.stream_reads.push((tok, sid, stall))
      h.stream_reads.length().to_int64()
    },
    stream_close: fn(sid : Int) -> Unit {
      h.stream_closes.push(sid)
    },
    base_env: fn() -> Array[(String, String)] { [("PATH", "/usr/bin:/bin")] },
    on_status_changed: fn() -> Unit {
      h.status_changes = h.status_changes + 1
    },
    on_deferred_mcp_reply: fn(cid : Int, st : Int, body : String) -> Unit {
      h.deferred_replies.push((cid, st, body))
    },
  }
  (h, io)
}

fn mock_shell_done_ok(json_str : String, bytes : Option[Bytes]) -> host_shim::ShellDone {
  host_shim::ShellDone::{
    id: 1L,
    json: json_str,
    bytes: bytes,
    error: "",
  }
}

fn mock_shell_done_err(msg : String) -> host_shim::ShellDone {
  host_shim::ShellDone::{
    id: 1L,
    json: "",
    bytes: None,
    error: msg,
  }
}

test "w17e4a: event_id [12<<32, 13<<32) and MuxToken 5300..5309 strict boundaries" {
  if MANAGED_MCP_EVENT_BASE != 51539607552L || MANAGED_MCP_EVENT_END != 55834574848L {
    panic("MANAGED_MCP_EVENT_BASE/END mismatch")
  }
  if is_managed_mcp_event(MANAGED_MCP_EVENT_BASE - 1L) {
    panic("BASE - 1 must be outside range")
  }
  if !is_managed_mcp_event(MANAGED_MCP_EVENT_BASE) {
    panic("BASE must be inside range")
  }
  if !is_managed_mcp_event(MANAGED_MCP_EVENT_END - 1L) {
    panic("END - 1 must be inside range")
  }
  if is_managed_mcp_event(MANAGED_MCP_EVENT_END) {
    panic("END must be outside half-open range")
  }
  if is_managed_mcp_mux_kind(5299) || is_managed_mcp_mux_kind(5310) {
    panic("MuxToken range must be strictly 5300..5309")
  }
  if !is_managed_mcp_mux_kind(5300) || !is_managed_mcp_mux_kind(5309) {
    panic("5300 and 5309 must be inside MuxToken range")
  }
  let (_, io) = MockMcpHarness::new()
  let rt = ManagedMcpRuntime::new(io)
  if rt.handle_sys_event(MANAGED_MCP_EVENT_BASE - 1L, station_sys::SysEvent::ProcStdout(Bytes::new(0)), 1000L) {
    panic("handle_sys_event must reject ev_id below BASE")
  }
  if rt.handle_sys_event(MANAGED_MCP_EVENT_END, station_sys::SysEvent::ProcStdout(Bytes::new(0)), 1000L) {
    panic("handle_sys_event must reject ev_id at END")
  }
  if rt.handle_role_done(builders_core::MuxToken::Tagged(1, 5299, 0L), mock_shell_done_ok("{}", None), 1000L) {
    panic("handle_role_done must reject kind 5299")
  }
  if rt.handle_role_done(builders_core::MuxToken::Tagged(1, 5310, 0L), mock_shell_done_ok("{}", None), 1000L) {
    panic("handle_role_done must reject kind 5310")
  }
}

test "w17e4a: stdio MCP lifecycle, chunked JSON-RPC, pagination, tools/call, list_changed, circuit breaker & shutdown" {
  let (h, io) = MockMcpHarness::new()
  let rt = ManagedMcpRuntime::new(io)
  let raw_cfg = base_codec::json_obj([
    ("mcpServers", base_codec::json_obj([
      ("local", base_codec::json_obj([
        ("command", base_codec::json_str("/usr/bin/node")),
        ("args", base_codec::json_arr([base_codec::json_str("mock-mcp.js")])),
        ("env", base_codec::json_obj([("API_KEY", base_codec::json_str("super_secret_token_12345"))])),
      ])),
    ])),
  ])
  rt.start(raw_cfg, 1000L)
  if h.spawns.length() != 1 {
    panic("expected 1 stdio spawn")
  }
  let (ev_id, spawn_opts) = h.spawns[0]
  if !is_managed_mcp_event(ev_id) || !spawn_opts.new_pgid {
    panic("spawn must use MANAGED_MCP_EVENT_BASE range and new_pgid=true")
  }
  if h.stdin_writes.length() != 1 || !h.stdin_writes[0].1.contains("\"method\":\"initialize\"") {
    panic("expected initialize request on stdin")
  }

  // Feed initialize response split across 2 stdout chunks
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout("{\"jsonrpc\":\"2.0\",\"id\":1,".to_bytes()), 1100L)
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout("\"result\":{\"protocolVersion\":\"2025-06-18\"}}\n".to_bytes()), 1110L)
  // Expect notifications/initialized + tools/list
  if h.stdin_writes.length() != 3 || !h.stdin_writes[1].1.contains("notifications/initialized") || !h.stdin_writes[2].1.contains("\"method\":\"tools/list\"") {
    panic("expected notifications/initialized and tools/list after initialize")
  }

  // Feed paginated tools/list (page 1 with nextCursor, page 2 final)
  let page1 = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[{\"name\":\"echo\",\"description\":\"Echo text\",\"inputSchema\":{\"properties\":{\"msg\":{\"type\":\"string\"}}}}],\"nextCursor\":\"c2\"}}\n"
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout(page1.to_bytes()), 1200L)
  if h.stdin_writes.length() != 4 || !h.stdin_writes[3].1.contains("\"cursor\":\"c2\"") {
    panic("expected second tools/list page with cursor c2")
  }
  let page2 = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"tools\":[{\"name\":\"slow\",\"description\":\"Slow op\"}]}}\n"
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout(page2.to_bytes()), 1250L)

  // Verify exposed tools and masked view
  let decls = rt.exposed_tool_decls()
  if decls.length() != 2 || decls[0].name != "local__echo" || decls[1].name != "local__slow" {
    panic("unexpected exposed tools count/names")
  }
  let views_str = base_codec::json_stringify(base_codec::json_arr(rt.view(raw_cfg)))
  if views_str.contains("super_secret_token_12345") || !views_str.contains("\"status\":\"ready\"") {
    panic("view must mask env secret and report ready: " + views_str)
  }

  // Deferred tools/call on `local__echo`
  let mut got_text = ""
  match rt.start_tool_call(
    "local__echo",
    base_codec::json_obj([("msg", base_codec::json_str("hi"))]),
    42,
    base_codec::json_int(99),
    None,
    1300L,
    Some(fn(rep : station_tools::ToolReply) -> Unit {
      got_text = base_codec::json_stringify(station_tools::content_item_to_json(rep.content[0]))
    }),
  ) {
    Ok(_) => ()
    Err(e) => panic("start_tool_call failed: " + base_codec::json_stringify(station_tools::content_item_to_json(e.content[0])))
  }
  let call_resp = "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"hello back\"}]}}\n"
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout(call_resp.to_bytes()), 1350L)
  if !got_text.contains("hello back") || h.deferred_replies.length() != 1 || h.deferred_replies[0].0 != 42 {
    panic("deferred stdio tools/call reply missing or wrong conn_id")
  }

  // `notifications/tools/list_changed` triggers live refresh
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}\n".to_bytes()), 1400L)
  if !h.stdin_writes[h.stdin_writes.length() - 1].1.contains("\"method\":\"tools/list\"") {
    panic("expected tools/list refresh on list_changed")
  }

  // Unexpected crash with secret URL in stderr -> redacted error + backoff reconnect
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStderr("boom at https://bob:pw999@internal.local/x".to_bytes()), 1500L)
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcExit(station_sys::ExitStatus::{ code: 1, signal: 0, signal_name: "" }), 1510L)
  let crashed_view = base_codec::json_stringify(base_codec::json_arr(rt.view(raw_cfg)))
  if crashed_view.contains("pw999") || !crashed_view.contains("\"status\":\"reconnecting\"") {
    panic("crash view must redact stderr URL password and enter reconnecting: " + crashed_view)
  }

  // Advance clock past 1000ms backoff -> respawns
  let _ = rt.tick(2600L)
  if h.spawns.length() != 2 {
    panic("expected respawn after 1000ms backoff")
  }

  // Shutdown sends SIGTERM to process group, then SIGKILL after grace period
  rt.shutdown(3000L)
  if h.kills.length() == 0 || h.kills[0].1 != station_sys::SIG_TERM || !h.kills[0].2 {
    panic("shutdown must send SIGTERM to process group")
  }
  let _ = rt.tick(3000L + MANAGED_MCP_STDIO_GRACE_MS + 1L)
  if h.kills.length() < 2 || h.kills[1].1 != station_sys::SIG_KILL || !h.kills[1].2 {
    panic("grace expiry must escalate to SIGKILL on process group")
  }
  if rt.active_count() != 0 {
    panic("active_count must be 0 after shutdown + grace drain")
  }
}

test "w17e4a: Streamable HTTP MCP (Mcp-Session-Id, SSE response, async call timeout, orphaned stream close, DELETE)" {
  let (h, io) = MockMcpHarness::new()
  let rt = ManagedMcpRuntime::new(io)
  let raw_cfg = base_codec::json_obj([
    ("mcpServers", base_codec::json_obj([
      ("remote", base_codec::json_obj([
        ("type", base_codec::json_str("http")),
        ("url", base_codec::json_str("https://alice:topsecret@mcp.example.com/v1")),
        ("headers", base_codec::json_obj([("Authorization", base_codec::json_str("Bearer tok_secret_8888"))])),
      ])),
    ])),
  ])
  rt.start(raw_cfg, 1000L)
  if h.stream_opens.length() != 1 {
    panic("expected 1 stream.open for HTTP initialize")
  }
  let init_tok = h.stream_opens[0].0
  // Open succeeds with Mcp-Session-Id and text/event-stream content-type
  let _ = rt.handle_role_done(
    init_tok,
    mock_shell_done_ok("{\"id\":11,\"status\":200,\"headers\":[[\"mcp-session-id\",\"sess-xyz\"],[\"content-type\",\"text/event-stream\"]]}", None),
    1050L,
  )
  let read_tok1 = h.stream_reads[0].0
  let _ = rt.handle_role_done(
    read_tok1,
    mock_shell_done_ok("{\"end\":false}", Some("event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}\n\n".to_bytes())),
    1060L,
  )
  let _ = rt.handle_role_done(read_tok1, mock_shell_done_ok("{\"end\":true}", None), 1070L)

  // Should have issued notifications/initialized (open idx 1) + tools/list (open idx 2)
  if h.stream_opens.length() != 3 {
    panic("expected notify + tools/list opens, got " + h.stream_opens.length().to_string())
  }
  if !h.stream_opens[2].1.contains("sess-xyz") {
    panic("tools/list must include captured mcp-session-id header")
  }
  // Complete notify open -> immediately closed
  let _ = rt.handle_role_done(h.stream_opens[1].0, mock_shell_done_ok("{\"id\":12,\"status\":202,\"headers\":[]}", None), 1080L)

  // Complete tools/list (JSON response)
  let _ = rt.handle_role_done(
    h.stream_opens[2].0,
    mock_shell_done_ok("{\"id\":13,\"status\":200,\"headers\":[[\"content-type\",\"application/json\"]]}", None),
    1090L,
  )
  let list_read_tok = h.stream_reads[h.stream_reads.length() - 1].0
  let _ = rt.handle_role_done(
    list_read_tok,
    mock_shell_done_ok("{\"end\":false}", Some("{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[{\"name\":\"ping\",\"description\":\"Ping\"}]}}".to_bytes())),
    1100L,
  )
  let _ = rt.handle_role_done(list_read_tok, mock_shell_done_ok("{\"end\":true}", None), 1110L)

  if rt.exposed_tool_decls().length() != 1 || rt.exposed_tool_decls()[0].name != "remote__ping" {
    panic("expected remote__ping exposed")
  }

  // Start async HTTP tool call and let it time out -> closes stream & replies error
  let mut timed_out_err = false
  let _ = rt.start_tool_call(
    "remote__ping",
    base_codec::json_obj([]),
    77,
    base_codec::json_int(5),
    None,
    2000L,
    Some(fn(rep : station_tools::ToolReply) -> Unit {
      timed_out_err = rep.is_error
    }),
  )
  let call_open_tok = h.stream_opens[h.stream_opens.length() - 1].0
  let _ = rt.tick(2000L + MANAGED_MCP_CALL_TIMEOUT_MS + 1L)
  if !timed_out_err || h.deferred_replies.length() != 1 {
    panic("timed out HTTP tool call must settle with isError=true")
  }
  // Late stream.open arriving AFTER timeout MUST close orphaned handle 99 immediately!
  let closes_before = h.stream_closes.length()
  let _ = rt.handle_role_done(call_open_tok, mock_shell_done_ok("{\"id\":99,\"status\":200,\"headers\":[]}", None), 999999L)
  if h.stream_closes.length() != closes_before + 1 || h.stream_closes[h.stream_closes.length() - 1] != 99 {
    panic("orphaned late stream.open must be immediately closed")
  }

  // View must redact URL userinfo and header secret
  let vs = base_codec::json_stringify(base_codec::json_arr(rt.view(raw_cfg)))
  if vs.contains("topsecret") || vs.contains("tok_secret_8888") || !vs.contains("https://mcp.example.com/v1") {
    panic("HTTP view leaked secret or mangled URL: " + vs)
  }

  // Shutdown sends DELETE with mcp-session-id
  let opens_before_sd = h.stream_opens.length()
  rt.shutdown(1000000L)
  if h.stream_opens.length() != opens_before_sd + 1 || !h.stream_opens[opens_before_sd].1.contains("\"method\":\"DELETE\"") {
    panic("shutdown must send DELETE for active HTTP mcp-session-id")
  }
}

test "w17e4a: Legacy HTTP+SSE MCP endpoint resolution, handshake, tool call & disconnect cleanup" {
  match resolve_sse_endpoint_url("https://mcp.example.com/api/sse", "/messages?session=1") {
    Ok(u) => if u != "https://mcp.example.com/messages?session=1" { panic("bad root-relative resolve: " + u) }
    Err(e) => panic(e)
  }
  match resolve_sse_endpoint_url("https://mcp.example.com/api/sse", "post?id=2") {
    Ok(u) => if u != "https://mcp.example.com/api/post?id=2" { panic("bad relative resolve: " + u) }
    Err(e) => panic(e)
  }

  let (h, io) = MockMcpHarness::new()
  let rt = ManagedMcpRuntime::new(io)
  let raw_cfg = base_codec::json_obj([
    ("mcpServers", base_codec::json_obj([
      ("legacy", base_codec::json_obj([
        ("type", base_codec::json_str("sse")),
        ("url", base_codec::json_str("http://127.0.0.1:9001/sse")),
      ])),
    ])),
  ])
  rt.start(raw_cfg, 1000L)
  let sse_open_tok = h.stream_opens[0].0
  let _ = rt.handle_role_done(sse_open_tok, mock_shell_done_ok("{\"id\":21,\"status\":200,\"headers\":[]}", None), 1010L)
  let sse_read_tok = h.stream_reads[0].0
  // Receive `event: endpoint` -> triggers POST initialize to resolved endpoint
  let _ = rt.handle_role_done(
    sse_read_tok,
    mock_shell_done_ok("{\"end\":false}", Some("event: endpoint\ndata: /rpc?sid=abc\n\n".to_bytes())),
    1020L,
  )
  if h.stream_opens.length() != 2 || !h.stream_opens[1].1.contains("http://127.0.0.1:9001/rpc?sid=abc") {
    panic("expected initialize POST to resolved SSE endpoint")
  }
  // Deliver initialize + tools/list replies over SSE stream
  let _ = rt.handle_role_done(
    sse_read_tok,
    mock_shell_done_ok("{\"end\":false}", Some("event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}\n\n".to_bytes())),
    1030L,
  )
  let _ = rt.handle_role_done(
    sse_read_tok,
    mock_shell_done_ok("{\"end\":false}", Some("data: {\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[{\"name\":\"greet\"}]}}\n\n".to_bytes())),
    1040L,
  )
  if rt.exposed_tool_decls().length() != 1 || rt.exposed_tool_decls()[0].name != "legacy__greet" {
    panic("expected legacy__greet exposed")
  }
  // Drop SSE stream -> closes handle 21 and enters reconnecting
  let _ = rt.handle_role_done(sse_read_tok, mock_shell_done_err("connection reset"), 1050L)
  let vs = base_codec::json_stringify(base_codec::json_arr(rt.view(raw_cfg)))
  if !vs.contains("\"status\":\"reconnecting\"") {
    panic("SSE drop must transition to reconnecting: " + vs)
  }
}

test "w17e4a: ManagedMcpAsks approval card gate (non-manager rejected, owner approves upsert/reload)" {
  let asks = station_tools::ManagedMcpAsks::new()
  let mut posted_tid = 0
  let mut posted_ts = ""
  let mut posted_card = base_codec::json_null()
  let post_fn = fn(_s : String, _t : String, card : base_codec::Json) -> Option[(Int, String)] {
    posted_tid = 17
    posted_ts = "ts-17"
    posted_card = card
    Some((17, "ts-17"))
  }
  let upsert_args = base_codec::json_obj([
    ("action", base_codec::json_str("upsert")),
    ("name", base_codec::json_str("demo")),
    ("command", base_codec::json_str("node")),
    ("args", base_codec::json_arr([base_codec::json_str("srv.js")])),
  ])
  let ask_id = match asks.tool("s-1", Some("ws-main"), upsert_args, [], [], post_fn) {
    Ok(res) => match base_codec::json_get(res, "ask") {
      Some(base_codec::Json::Str(id)) => id
      _ => panic("missing ask id")
    }
    Err(e) => panic("upsert failed: " + e)
  }
  if posted_tid != 17 || posted_ts != "ts-17" || !base_codec::json_stringify(posted_card).contains(ask_id) {
    panic("confirmation card not posted with ask id")
  }
  // Regular member MUST be rejected
  if asks.may_decide("member", Some("ws-main"), ask_id, 17, "ts-17").is_none() {
    panic("member must not approve MCP server changes")
  }
  // Owner in wrong workspace MUST be rejected
  if asks.may_decide("owner", Some("ws-other"), ask_id, 17, "ts-17").is_none() {
    panic("cross-workspace owner must not approve MCP server changes")
  }
  // Owner in same workspace succeeds and produces ApprovedPatch
  if asks.may_decide("owner", Some("ws-main"), ask_id, 17, "ts-17").is_some() {
    panic("workspace owner must be allowed to approve")
  }
  match asks.choose("owner@example.com", ask_id, station_tools::MCP_CONFIRM_LABEL, 17, "ts-17", []) {
    station_tools::McpChoiceOutcome::ApprovedPatch(sess, next_cfg, _) => {
      if sess != "s-1" || next_cfg.length() != 1 || next_cfg[0].0 != "demo" {
        panic("ApprovedPatch produced wrong config")
      }
    }
    _ => panic("expected ApprovedPatch")
  }
}
