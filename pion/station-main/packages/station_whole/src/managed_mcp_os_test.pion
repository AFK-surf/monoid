// Unit tests for Wave 17E-4A Managed MCP runtime (`managed_mcp_os.pion`):
// - Disjoint `event_id` `[12<<32, 13<<32)` & `MuxToken::Tagged` `5300..5309` boundaries
// - Stdio JSON-RPC 2.0 state machine (`clean_env` + `agentEnv`, chunked framing, pagination, tools/call, crash error, backoff, SIGTERM->SIGKILL)
// - Streamable HTTP (strict `Notifying` serialization before `tools/list`, 15m `tools/call` budget, `RefreshingTools` fail-safe, OLD-cfg DELETE on update, cancel on disconnect)
// - Legacy HTTP+SSE (no 60s idle `stallMs`, `//host` protocol-relative URL, streaming UTF-8 + 4 MiB total event cap, immediate handshake POST error)
// - `ManagedMcpAsks` approval card gate & `marks.thread.closed-card` strict validation + idempotent replay

import "base_codec"
import "builders_core"
import "host_shim"
import "station_api"
import "station_sys"
import "station_tools"

struct MockMcpHarness {
  spawns : Array[(Int64, station_sys::SpawnOptions)]
  stdin_writes : Array[(Int64, String)]
  stdin_closed : Array[Int64]
  kills : Array[(Int64, Int, Bool)]
  proc_closed : Array[Int64]
  stream_opens : Array[(builders_core::MuxToken, String, Option[Bytes])]
  stream_reads : Array[(builders_core::MuxToken, Int, Option[Int])]
  stream_closes : Array[Int]
  cancelled_calls : Array[Int64]
  mut status_changes : Int
  deferred_replies : Array[(Int, Int, String)]
  mut next_handle : Int64
}

fn MockMcpHarness::new() -> (MockMcpHarness, ManagedMcpIo) {
  let h = MockMcpHarness::{
    spawns: [],
    stdin_writes: [],
    stdin_closed: [],
    kills: [],
    proc_closed: [],
    stream_opens: [],
    stream_reads: [],
    stream_closes: [],
    cancelled_calls: [],
    status_changes: 0,
    deferred_replies: [],
    next_handle: 100L,
  }
  let io = ManagedMcpIo::{
    spawn_proc: fn(ev_id : Int64, opts : station_sys::SpawnOptions) -> Result[station_sys::ChildProcess, String] {
      h.spawns.push((ev_id, opts))
      let hid = h.next_handle
      h.next_handle = h.next_handle + 1L
      Ok(station_sys::ChildProcess::{ handle: hid, pid: hid.to_int() + 1000 })
    },
    write_stdin: fn(ch : station_sys::ChildProcess, d : Bytes) -> Bool {
      h.stdin_writes.push((ch.handle, d.to_string()))
      true
    },
    close_stdin: fn(ch : station_sys::ChildProcess) -> Bool {
      h.stdin_closed.push(ch.handle)
      true
    },
    kill_proc: fn(ch : station_sys::ChildProcess, sig : Int, group : Bool) -> Int {
      h.kills.push((ch.handle, sig, group))
      0
    },
    close_proc: fn(ch : station_sys::ChildProcess) -> Bool {
      h.proc_closed.push(ch.handle)
      true
    },
    stream_open: fn(tok : builders_core::MuxToken, args : String, body : Option[Bytes]) -> Int64 {
      h.stream_opens.push((tok, args, body))
      h.stream_opens.length().to_int64()
    },
    stream_read: fn(tok : builders_core::MuxToken, sid : Int, stall : Option[Int]) -> Int64 {
      h.stream_reads.push((tok, sid, stall))
      1000L + h.stream_reads.length().to_int64()
    },
    stream_close: fn(sid : Int) -> Unit {
      h.stream_closes.push(sid)
    },
    cancel_call: fn(cid : Int64) -> Unit {
      h.cancelled_calls.push(cid)
    },
    base_env: fn() -> Array[(String, String)] {
      [
        ("PATH", "/usr/bin:/bin"),
        ("STILLFAIL_MESH_FRONT", "/tmp/front.sock"),
        ("HTTP_PROXY", "http://10.0.0.1:8080"),
      ]
    },
    on_status_changed: fn() -> Unit {
      h.status_changes = h.status_changes + 1
    },
    on_deferred_mcp_reply: fn(cid : Int, st : Int, body : String) -> Unit {
      h.deferred_replies.push((cid, st, body))
    },
  }
  (h, io)
}

fn mock_shell_done_ok(json_str : String, bytes : Option[Bytes]) -> host_shim::ShellDone {
  host_shim::ShellDone::{
    id: 1L,
    json: json_str,
    bytes: bytes,
    error: "",
  }
}

fn mock_shell_done_err(msg : String) -> host_shim::ShellDone {
  host_shim::ShellDone::{
    id: 1L,
    json: "",
    bytes: None,
    error: msg,
  }
}

test "w17e4a: event_id [12<<32, 13<<32) and MuxToken 5300..5309 strict boundaries" {
  if MANAGED_MCP_EVENT_BASE != 51539607552L || MANAGED_MCP_EVENT_END != 55834574848L {
    panic("MANAGED_MCP_EVENT_BASE/END mismatch")
  }
  if is_managed_mcp_event(MANAGED_MCP_EVENT_BASE - 1L) || !is_managed_mcp_event(MANAGED_MCP_EVENT_BASE) {
    panic("BASE boundary check failed")
  }
  if !is_managed_mcp_event(MANAGED_MCP_EVENT_END - 1L) || is_managed_mcp_event(MANAGED_MCP_EVENT_END) {
    panic("END half-open boundary check failed")
  }
  if is_managed_mcp_mux_kind(5299) || is_managed_mcp_mux_kind(5310) || !is_managed_mcp_mux_kind(5300) || !is_managed_mcp_mux_kind(5309) {
    panic("MuxToken range must be strictly 5300..5309")
  }
  let (_, io) = MockMcpHarness::new()
  let rt = ManagedMcpRuntime::new(io)
  if rt.handle_sys_event(MANAGED_MCP_EVENT_BASE - 1L, station_sys::SysEvent::ProcStdout(Bytes::new(0)), 1000L) {
    panic("handle_sys_event must reject ev_id below BASE")
  }
  if rt.handle_sys_event(MANAGED_MCP_EVENT_END, station_sys::SysEvent::ProcStdout(Bytes::new(0)), 1000L) {
    panic("handle_sys_event must reject ev_id at END")
  }
  if rt.handle_role_done(builders_core::MuxToken::Tagged(1, 5299, 0L), mock_shell_done_ok("{}", None), 1000L) {
    panic("handle_role_done must reject kind 5299")
  }
  if rt.handle_role_done(builders_core::MuxToken::Tagged(1, 5310, 0L), mock_shell_done_ok("{}", None), 1000L) {
    panic("handle_role_done must reject kind 5310")
  }
}

test "w17e4a: stdio clean_env (agentEnv + NO_PROXY + strip STILLFAIL_MESH_FRONT), chunked JSON-RPC, crash reason & shutdown" {
  let (h, io) = MockMcpHarness::new()
  let rt = ManagedMcpRuntime::new(io)
  let raw_cfg = base_codec::json_obj([
    ("agentEnv", base_codec::json_obj([("FROM_AGENT_ENV", base_codec::json_str("val-ok"))])),
    ("mcpServers", base_codec::json_obj([
      ("local", base_codec::json_obj([
        ("command", base_codec::json_str("/usr/bin/node")),
        ("args", base_codec::json_arr([base_codec::json_str("mock-mcp.js")])),
        ("env", base_codec::json_obj([("API_KEY", base_codec::json_str("super_secret_token_12345"))])),
      ])),
    ])),
  ])
  // Reload while `!running` must NOT create stuck `connecting` entries (P2-7)
  rt.reload(raw_cfg, None, 500L)
  let stopped_view = base_codec::json_stringify(base_codec::json_arr(rt.view(raw_cfg)))
  if !stopped_view.contains("\"status\":\"stopped\"") {
    panic("reload before start must keep status stopped: " + stopped_view)
  }

  rt.start(raw_cfg, 1000L)
  if h.spawns.length() != 1 {
    panic("expected 1 stdio spawn")
  }
  let (ev_id, spawn_opts) = h.spawns[0]
  if !is_managed_mcp_event(ev_id) || !spawn_opts.new_pgid {
    panic("spawn must use MANAGED_MCP_EVENT_BASE range and new_pgid=true")
  }
  // Verify P1-2 clean_env: stripped STILLFAIL_MESH_FRONT, included FROM_AGENT_ENV, added loopback NO_PROXY
  let env_arr = match spawn_opts.env { Some(e) => e, None => [] }
  let mut has_agent_env = false
  let mut has_no_proxy = false
  let mut leaked_front = false
  for ei in 0..<env_arr.length() {
    if env_arr[ei] == "FROM_AGENT_ENV=val-ok" {
      has_agent_env = true
    }
    if env_arr[ei].starts_with("NO_PROXY=") && env_arr[ei].contains("127.0.0.1") {
      has_no_proxy = true
    }
    if env_arr[ei].starts_with("STILLFAIL_MESH_FRONT=") {
      leaked_front = true
    }
  }
  if !has_agent_env || !has_no_proxy || leaked_front {
    panic("stdio env must use clean_env + agentEnv + NO_PROXY and strip STILLFAIL_MESH_FRONT")
  }

  // Feed initialize response split across 2 stdout chunks
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout("{\"jsonrpc\":\"2.0\",\"id\":1,".to_bytes()), 1100L)
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout("\"result\":{\"protocolVersion\":\"2025-06-18\"}}\n".to_bytes()), 1110L)
  let page1 = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[{\"name\":\"echo\",\"description\":\"Echo text\",\"inputSchema\":{\"properties\":{\"msg\":{\"type\":\"string\"}}}}],\"nextCursor\":\"c2\"}}\n"
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout(page1.to_bytes()), 1200L)
  let page2 = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"tools\":[{\"name\":\"slow\",\"description\":\"Slow op\"}]}}\n"
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStdout(page2.to_bytes()), 1250L)

  // Start an in-flight call, then crash the stdio process -> in-flight call must receive actual exit/stderr error (P2-5)!
  let mut crash_call_err = ""
  let _ = rt.start_tool_call(
    "local__slow",
    base_codec::json_obj([]),
    42,
    base_codec::json_int(99),
    None,
    1300L,
    Some(fn(rep : station_tools::ToolReply) -> Unit {
      crash_call_err = base_codec::json_stringify(station_tools::content_item_to_json(rep.content[0]))
    }),
  )
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcStderr("boom at https://bob:pw999@internal.local/x".to_bytes()), 1500L)
  let _ = rt.handle_sys_event(ev_id, station_sys::SysEvent::ProcExit(station_sys::ExitStatus::{ code: 137, signal: 0, signal_name: "" }), 1510L)
  if !crash_call_err.contains("137") || crash_call_err.contains("pw999") {
    panic("in-flight call must receive redacted exit code + stderr tail, got: " + crash_call_err)
  }

  // Advance clock past 1000ms backoff -> respawns
  let _ = rt.tick(2600L)
  if h.spawns.length() != 2 {
    panic("expected respawn after 1000ms backoff")
  }

  // Shutdown sends SIGTERM to process group, then SIGKILL after grace period
  rt.shutdown(3000L)
  let _ = rt.tick(3000L + MANAGED_MCP_STDIO_GRACE_MS + 1L)
  if rt.active_count() != 0 {
    panic("active_count must be 0 after shutdown + grace drain")
  }
}

test "w17e4a: Streamable HTTP strict Notifying ordering, 15m call budget, RefreshingTools fail-safe, OLD-cfg DELETE, disconnect cancel" {
  let (h, io) = MockMcpHarness::new()
  let rt = ManagedMcpRuntime::new(io)
  let raw_cfg = base_codec::json_obj([
    ("mcpServers", base_codec::json_obj([
      ("remote", base_codec::json_obj([
        ("type", base_codec::json_str("http")),
        ("url", base_codec::json_str("https://alice:topsecret@old.example.com/v1")),
        ("headers", base_codec::json_obj([("Authorization", base_codec::json_str("Bearer tok_secret_8888"))])),
      ])),
    ])),
  ])
  rt.start(raw_cfg, 1000L)
  if h.stream_opens.length() != 1 {
    panic("expected 1 stream.open for HTTP initialize")
  }
  let init_tok = h.stream_opens[0].0
  let _ = rt.handle_role_done(
    init_tok,
    mock_shell_done_ok("{\"id\":11,\"status\":200,\"headers\":[[\"mcp-session-id\",\"sess-old\"],[\"content-type\",\"text/event-stream\"]]}", None),
    1050L,
  )
  let read_tok1 = h.stream_reads[0].0
  let _ = rt.handle_role_done(
    read_tok1,
    mock_shell_done_ok("{\"end\":false}", Some("event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}\n\n".to_bytes())),
    1060L,
  )
  let _ = rt.handle_role_done(read_tok1, mock_shell_done_ok("{\"end\":true}", None), 1070L)

  // P1-1: ONLY `notifications/initialized` must be sent so far (tools/list MUST wait for NOTIFY_OPEN to finish!)
  if h.stream_opens.length() != 2 {
    panic("tools/list MUST wait for notifications/initialized to complete; opens=" + h.stream_opens.length().to_string())
  }
  // Now complete NOTIFY_OPEN -> triggers tools/list!
  let _ = rt.handle_role_done(h.stream_opens[1].0, mock_shell_done_ok("{\"id\":12,\"status\":202,\"headers\":[]}", None), 1080L)
  if h.stream_opens.length() != 3 || !h.stream_opens[2].1.contains("sess-old") {
    panic("expected tools/list AFTER notify completion with captured mcp-session-id")
  }

  // Complete tools/list
  let _ = rt.handle_role_done(
    h.stream_opens[2].0,
    mock_shell_done_ok("{\"id\":13,\"status\":200,\"headers\":[[\"content-type\",\"application/json\"]]}", None),
    1090L,
  )
  let list_read_tok = h.stream_reads[h.stream_reads.length() - 1].0
  let _ = rt.handle_role_done(
    list_read_tok,
    mock_shell_done_ok("{\"end\":false}", Some("{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[{\"name\":\"ping\",\"description\":\"Ping\"}]}}".to_bytes())),
    1100L,
  )
  let _ = rt.handle_role_done(list_read_tok, mock_shell_done_ok("{\"end\":true}", None), 1110L)
  if rt.exposed_tool_decls().length() != 1 {
    panic("expected remote__ping exposed")
  }

  // P1-2 (call timeout): start long HTTP tool call -> stream_read stallMs MUST be ~900000ms (15 min), NOT capped at 60000ms!
  let _ = rt.start_tool_call("remote__ping", base_codec::json_obj([]), 77, base_codec::json_int(5), None, 2000L, None)
  let call_open_tok = h.stream_opens[h.stream_opens.length() - 1].0
  let _ = rt.handle_role_done(
    call_open_tok,
    mock_shell_done_ok("{\"id\":55,\"status\":200,\"headers\":[[\"content-type\",\"text/event-stream\"]]}", None),
    2100L,
  )
  let last_stall = h.stream_reads[h.stream_reads.length() - 1].2
  match last_stall {
    Some(ms) if ms > 600000 => ()
    _ => panic("HTTP tools/call stallMs must use full remaining 15m budget, not 60s")
  }

  // P1-5: caller disconnect cancels in-flight upstream mux call & closes stream 55
  let cancelled_before = h.cancelled_calls.length()
  let closed_before = h.stream_closes.length()
  let n_disc = rt.cancel_disconnected_calls(fn(cid : Int) -> Bool { cid != 77 })
  if n_disc != 1 || h.cancelled_calls.length() != cancelled_before + 1 || h.stream_closes.length() != closed_before + 1 {
    panic("caller disconnect must cancel upstream mux call and close stream handle")
  }

  // P1-2 (config replace): changing URL MUST send DELETE to OLD URL (`old.example.com/v1`), NOT new URL!
  let new_cfg = base_codec::json_obj([
    ("mcpServers", base_codec::json_obj([
      ("remote", base_codec::json_obj([
        ("type", base_codec::json_str("http")),
        ("url", base_codec::json_str("https://new.example.com/v2")),
      ])),
    ])),
  ])
  let opens_before_sync = h.stream_opens.length()
  rt.sync_config(new_cfg, 3000L)
  if h.stream_opens.length() < opens_before_sync + 2 {
    panic("expected DELETE old + POST new initialize on config update")
  }
  let del_args = h.stream_opens[opens_before_sync].1
  if !del_args.contains("\"method\":\"DELETE\"") || !del_args.contains("old.example.com/v1") {
    panic("DELETE must target OLD URL before config swap, got: " + del_args)
  }
}

test "w17e4a: Legacy SSE no idle stallMs, protocol-relative //host URL, streaming UTF-8 & 4 MiB event cap, handshake POST error" {
  match resolve_sse_endpoint_url("https://mcp.example.com/api/sse", "//other.example.com/rpc?s=1") {
    Ok(u) => if u != "https://other.example.com/rpc?s=1" { panic("bad protocol-relative resolve: " + u) }
    Err(e) => panic(e)
  }
  // Streaming UTF-8 split across chunks: `中` = 0xE4 0xB8 0xAD
  let parser = SseFrameParser::new()
  let part1 = Bytes::new(8)
  let hdr = "data: ".to_bytes()
  for i in 0..<6 { part1[i] = hdr[i] }
  part1[6] = 0xE4.to_byte()
  part1[7] = 0xB8.to_byte()
  let part2 = Bytes::new(3)
  part2[0] = 0xAD.to_byte()
  part2[1] = 10.to_byte()
  part2[2] = 10.to_byte()
  match parser.feed(part1) {
    Ok(evs) => if evs.length() != 0 { panic("expected 0 events on partial line") }
    Err(e) => panic(e)
  }
  match parser.feed(part2) {
    Ok(evs) => if evs.length() != 1 || evs[0].1 != "中" { panic("UTF-8 split corrupted") }
    Err(e) => panic(e)
  }

  // Legacy SSE GET read MUST omit stallMs (`None`) so idle servers (>60s) never drop!
  let (h, io) = MockMcpHarness::new()
  let rt = ManagedMcpRuntime::new(io)
  let raw_cfg = base_codec::json_obj([
    ("mcpServers", base_codec::json_obj([
      ("legacy", base_codec::json_obj([
        ("type", base_codec::json_str("sse")),
        ("url", base_codec::json_str("http://127.0.0.1:9001/sse")),
      ])),
    ])),
  ])
  rt.start(raw_cfg, 1000L)
  let sse_open_tok = h.stream_opens[0].0
  let _ = rt.handle_role_done(sse_open_tok, mock_shell_done_ok("{\"id\":21,\"status\":200,\"headers\":[]}", None), 1010L)
  if h.stream_reads[0].2.is_some() {
    panic("Legacy SSE GET stream.read MUST NOT set stallMs")
  }
  let sse_read_tok = h.stream_reads[0].0
  let _ = rt.handle_role_done(
    sse_read_tok,
    mock_shell_done_ok("{\"end\":false}", Some("event: endpoint\ndata: /rpc?sid=abc\n\n".to_bytes())),
    1020L,
  )
  // P2-3: handshake POST returning HTTP 500 MUST immediately fail handshake (not wait 30s!)
  let init_post_tok = h.stream_opens[1].0
  let _ = rt.handle_role_done(init_post_tok, mock_shell_done_ok("{\"id\":22,\"status\":500,\"headers\":[]}", None), 1030L)
  let vs = base_codec::json_stringify(base_codec::json_arr(rt.view(raw_cfg)))
  if !vs.contains("\"status\":\"reconnecting\"") {
    panic("SSE handshake POST 500 must fail immediately into reconnecting: " + vs)
  }
}

test "w17e4a: marks.thread.closed-card strict validation (invalid option 400, non-mcpServer 404, non-manager 403, owner idempotent 200)" {
  let (_, agents, api, _, _, hooks, port) = make_mem_whole_api_fixture_full()
  let owner = make_test_viewer("owner@example.com", "u-owner", "ws-main", true, "owner")
  let member = make_test_viewer("member@example.com", "u-mem", "ws-main", true, "member")
  let mut posted_card = base_codec::json_null()
  let upsert_args = base_codec::json_obj([
    ("action", base_codec::json_str("upsert")),
    ("name", base_codec::json_str("demo")),
    ("command", base_codec::json_str("node")),
    ("args", base_codec::json_arr([base_codec::json_str("srv.js")])),
  ])
  let _ = match agents.mcp_asks.tool("s-1", Some("ws-main"), upsert_args, [], [], fn(_s, _t, c) {
    posted_card = c
    Some((10, "ts-10"))
  }) {
    Ok(r) => r
    Err(e) => panic("upsert failed: " + e)
  }
  let mut closed_once = false
  let mut cur_card : Option[base_codec::Json] = Some(posted_card)
  port.get_entry_card = fn(_tid : Int64, _n : Int64) -> Result[Option[(String, Option[base_codec::Json])], station_api::ApiError] {
    Ok(Some(("ts-10", cur_card)))
  }
  port.close_card_atomic = fn(_tid : Int64, _n : Int64, _v : String, _now : Int64) -> Result[Bool, station_api::ApiError] {
    if closed_once {
      Ok(false)
    } else {
      closed_once = true
      Ok(true)
    }
  }
  let mut sync_calls = 0
  hooks.on_mcp_sync = Some(fn() -> Unit { sync_calls = sync_calls + 1 })
  hooks.read_only_handover_cell[0] = false

  // 1. Invalid option rejected with 400
  match (api.admin.host.call)(
    "marks.thread.closed-card",
    make_test_api_req_as("PUT", "/threads/10/closed-card", owner),
    ["10"],
    base_codec::json_obj([("n", base_codec::json_int(1)), ("option", base_codec::json_str("not-a-real-option"))]),
  ) {
    Err(e) if e.status == 400 => ()
    _ => panic("invalid option must return 400")
  }
  // 2. Regular member rejected with 403
  match (api.admin.host.call)(
    "marks.thread.closed-card",
    make_test_api_req_as("PUT", "/threads/10/closed-card", member),
    ["10"],
    base_codec::json_obj([("n", base_codec::json_int(1)), ("option", base_codec::json_str(station_tools::MCP_CONFIRM_LABEL))]),
  ) {
    Err(e) if e.status == 403 => ()
    _ => panic("regular member must return 403")
  }
  // 3. Owner approves -> 200 & applied once
  match (api.admin.host.call)(
    "marks.thread.closed-card",
    make_test_api_req_as("PUT", "/threads/10/closed-card", owner),
    ["10"],
    base_codec::json_obj([("n", base_codec::json_int(1)), ("option", base_codec::json_str(station_tools::MCP_CONFIRM_LABEL))]),
  ) {
    Ok(_) => if sync_calls != 1 { panic("expected exactly 1 sync call") }
    Err(e) => panic("owner approval must succeed: " + e.message)
  }
  // 4. Owner idempotent replay -> 200 WITHOUT re-applying!
  match (api.admin.host.call)(
    "marks.thread.closed-card",
    make_test_api_req_as("PUT", "/threads/10/closed-card", owner),
    ["10"],
    base_codec::json_obj([("n", base_codec::json_int(1)), ("option", base_codec::json_str(station_tools::MCP_CONFIRM_LABEL))]),
  ) {
    Ok(_) => if sync_calls != 1 { panic("idempotent replay must NOT double-apply config") }
    Err(e) => panic("owner idempotent replay must return 200: " + e.message)
  }
  // 5. Non-mcpServer ordinary agent card falls through to 404 (never corrupted!)
  cur_card = Some(base_codec::json_obj([("type", base_codec::json_str("options")), ("options", base_codec::json_arr([]))]))
  match (api.admin.host.call)(
    "marks.thread.closed-card",
    make_test_api_req_as("PUT", "/threads/10/closed-card", owner),
    ["10"],
    base_codec::json_obj([("n", base_codec::json_int(1)), ("option", base_codec::json_str("anything"))]),
  ) {
    Err(e) if e.status == 404 => ()
    _ => panic("non-mcpServer card must fall through to 404 without half-closing")
  }
}
