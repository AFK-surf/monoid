// Production full-station subsystem composition (`StationLive` + `MixedRigLive`).
// Connects all 23 business/core packages into a single acyclic `WholeStation` root
// with strict MixedRig workspace isolation (`Full` vs `RigOnly`).
// Pure dependency-injected core (`WholeStation::new_with_deps`) + production OS wiring (`WholeStation::new`).

import "base64"
import "base_codec"
import "builders_core"
import "crypto"
import "form"
import "host_shim"
import "http1"
import "lock"
import "nodepath"
import "station_api"
import "station_browser"
import "station_cloud"
import "station_connects"
import "station_devices"
import "station_drivers"
import "station_hooks_tui"
import "station_http"
import "station_jobs"
import "station_mesh"
import "station_ops"
import "station_replica"
import "station_rig"
import "station_rules_bridge"
import "station_screens"
import "station_sessions"
import "station_store"
import "station_sys"
import "station_tools"
import "station_vault"

/// Workspace operating mode on this station (`StationLive` vs `MixedRigLive`).
pub enum WorkspaceRole {
  Full
  RigOnly
  Unknown
}

pub fn workspace_role_name(r : WorkspaceRole) -> String {
  match r {
    WorkspaceRole::Full => "full"
    WorkspaceRole::RigOnly => "rig"
    WorkspaceRole::Unknown => "unknown"
  }
}

/// Active connector summary registered on the whole station.
pub struct ConnectsRegistry {
  pub slack_enabled : Bool
  pub feishu_enabled : Bool
  pub comma_enabled : Bool
  pub group_enabled : Bool
  pub group_hlc : station_connects::Hlc
  pub feishu_parts : station_connects::FeishuFrameParts
}

pub fn ConnectsRegistry::from_config(cfg : base_codec::Json) -> ConnectsRegistry {
  let has_key = fn(k : String) -> Bool {
    match base_codec::json_get(cfg, k) {
      Some(base_codec::Json::Obj(_)) => true
      Some(base_codec::Json::Arr(a)) => a.length() > 0
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
  }
  ConnectsRegistry::{
    slack_enabled: has_key("slack"),
    feishu_enabled: has_key("feishu"),
    comma_enabled: has_key("comma"),
    group_enabled: has_key("group"),
    group_hlc: station_connects::Hlc::new(),
    feishu_parts: station_connects::FeishuFrameParts::new(),
  }
}

/// Injectable host/OS dependencies for `WholeStation`, enabling both production OS wiring
/// and deterministic pure-Pion unit tests without linking native FFI libraries.
pub struct WholeHostDeps {
  pub os_name : String
  pub arch_name : String
  pub hostname : String
  pub homedir : String
  pub tmpdir : String
  pub now_ms : () -> Int64
  pub random_bytes : (Int) -> Result[Bytes, String]
  pub exists : (String) -> Bool
  pub realpath : (String) -> Option[String]
  pub seen_store : station_api::SeenStore
  pub jobs_fs : station_jobs::FsPort
  pub proc_backend : station_jobs::ProcBackend
  pub cmd_log_backend : station_rig::LogBackend
  pub close_store : () -> Unit
}

/// Complete production whole-station runtime root (`StationLive` + `MixedRigLive`).
pub struct WholeStation {
  pub data_dir : String
  pub app_dir : String
  pub sep : String
  pub boot_id : String
  pub version : String
  pub station_key : station_cloud::StationKey
  pub cloud : station_cloud::CloudStore
  pub store : Option[station_store::Store]
  pub mut config : base_codec::Json
  pub deps : WholeHostDeps
  pub job_mgr : station_jobs::JobManager
  pub remote_mgr : station_jobs::RemoteManager
  pub vault_grants : station_vault::GrantStore
  pub incoming_vault : station_vault::IncomingRegistry
  pub rig_grants : station_rig::RigGrants
  pub rig : station_rig::Rig
  pub events : station_api::EventsHub
  pub egress : station_api::EgressLook
  pub cpu_window : station_api::CpuWindow
  pub admin_api : station_api::AdminApi
  pub session_hub : station_sessions::SessionHub
  pub mcp_server : station_tools::McpServer
  pub managed_mcp_asks : station_tools::ManagedMcpAsks
  pub session_tokens : Map[String, String]
  pub drivers : DriversRuntime
  pub connects : ConnectsRegistry
  pub screens : station_screens::ScreenHub
  pub drive : station_screens::Drive
  pub thumb_port : Option[station_screens::ThumbPort]
  pub poster_cache : station_screens::PosterCache
  pub devices : station_devices::DeviceRegistry
  pub phone_grants : station_devices::PhoneGrants
  pub grant_servers : station_devices::GrantServers
  pub airplay_pairing : station_devices::AirPlayPairingManager
  pub mut projects_jsonl : String
}

/// Generates `n` cryptographically random bytes encoded as lowercase hex using OS CSPRNG.
pub fn os_random_hex(n_bytes : Int) -> String {
  let n = if n_bytes <= 0 { 16 } else { n_bytes }
  match station_sys::random_bytes(n) {
    Ok(raw) => base_codec::hex_encode(raw)
    Err(_) => ""
  }
}

/// Builds a `SeenStore` backed by `station_store::Store`.
pub fn make_store_seen(store : station_store::Store) -> station_api::SeenStore {
  station_api::SeenStore::{
    session_exists: fn(key : String) -> Bool {
      match store.get_session(key) {
        Ok(Some(_)) => true
        _ => false
      }
    },
    session_ws: fn(key : String) -> Option[Option[String]] {
      match store.get_session(key) {
        Ok(Some(s)) => {
          if s.workspace.length() > 0 {
            Some(Some(s.workspace))
          } else {
            Some(None)
          }
        }
        _ => None
      }
    },
    thread_exists: fn(id : Int) -> Bool {
      match store.get_thread(id.to_int64()) {
        Ok(Some(_)) => true
        _ => false
      }
    },
    thread_sessions: fn(id : Int) -> Array[String] {
      match store.get_thread(id.to_int64()) {
        Ok(Some(t)) => [t.surface + "/" + t.channel + "/" + t.thread_ts]
        _ => []
      }
    },
    job_session: fn(id : String) -> Option[String] {
      match station_store::get_job(store.db, id) {
        Ok(Some(j)) => Some(j.session_key)
        _ => None
      }
    },
    handed_to: fn(_key : String) -> Option[station_api::HandedRecord] { None },
  }
}

/// Builds production OS `WholeHostDeps` backed by `station_sys`, `host_shim`, and `station_store`.
pub fn os_host_deps(
  sep : String,
  store : station_store::Store,
  drive_fs : station_screens::DriveFs,
) -> WholeHostDeps {
  WholeHostDeps::{
    os_name: station_sys::os_name(),
    arch_name: station_sys::arch_name(),
    hostname: station_sys::hostname(),
    homedir: station_sys::homedir(),
    tmpdir: station_sys::tmpdir(),
    now_ms: host_shim::wall_ms,
    random_bytes: fn(n : Int) -> Result[Bytes, String] { station_sys::random_bytes(n) },
    exists: os_has_path,
    realpath: fn(p : String) -> Option[String] { station_sys::realpath(p) },
    seen_store: make_store_seen(store),
    jobs_fs: station_jobs::sys_fs(sep),
    proc_backend: station_jobs::real_proc_backend(),
    cmd_log_backend: station_rig::LogBackend::{
      ensure_dir: fn(p : String) -> Bool {
        let dir = nodepath::dirname(sep, p)
        if dir.length() == 0 { true } else { station_sys::mkdir_p(dir) }
      },
      stat_size: fn(p : String) -> Int64 {
        match (drive_fs.stat)(p) {
          Ok(m) => m.size
          Err(_) => 0L
        }
      },
      rename: fn(a : String, b : String) -> Bool { station_sys::rename(a, b) },
      append: fn(p : String, data : Bytes) -> Bool {
        station_sys::write_file_mode(p, data, mode=384, append=true)
      },
      read_tail: fn(p : String, max_bytes : Int64) -> Option[(Bytes, Int64)] {
        match (drive_fs.stat)(p) {
          Ok(m) => {
            let start = if m.size > max_bytes { m.size - max_bytes } else { 0L }
            match (drive_fs.read_range)(p, start, max_bytes.to_int()) {
              Ok((b, _, _)) => Some((b, start))
              Err(_) => None
            }
          }
          Err(_) => None
        }
      },
    },
    close_store: fn() -> Unit { store.close() },
  }
}

fn build_whole_api_host(
  session_hub : station_sessions::SessionHub,
  job_mgr : station_jobs::JobManager,
  seen_store : station_api::SeenStore,
  events : station_api::EventsHub,
  hostname : String,
  os_name : String,
  arch_name : String,
  version : String,
) -> station_api::ApiHost {
  station_api::ApiHost::{
    read_op: fn(op : String, _r : station_api::ApiRequest, args : base_codec::Json) -> Result[base_codec::Json, station_api::ApiError] {
      if op == "sessions" {
        return Ok(base_codec::json_obj([
          ("sessions", base_codec::json_arr([])),
          ("count", base_codec::json_int(session_hub.actors.length())),
        ]))
      }
      if op == "openJobs" {
        let js = job_mgr.list()
        return Ok(base_codec::json_obj([("jobs", base_codec::json_int(js.length()))]))
      }
      Ok(base_codec::json_obj([("op", base_codec::json_str(op)), ("args", args)]))
    },
    call: fn(op : String, _r : station_api::ApiRequest, params : Array[String], body : base_codec::Json) -> Result[base_codec::Json, station_api::ApiError] {
      if op == "projects.list" {
        let parsed = match station_api::parse_projects_jsonl("", false) {
          Ok(p) => p
          Err(e) => return Err(station_api::ApiError::new(400, e))
        }
        return Ok(station_api::projects_info_public_json(parsed))
      }
      let p_arr : Array[base_codec::Json] = []
      for i in 0..<params.length() {
        p_arr.push(base_codec::json_str(params[i]))
      }
      Ok(base_codec::json_obj([
        ("op", base_codec::json_str(op)),
        ("params", base_codec::json_arr(p_arr)),
        ("body", body),
      ]))
    },
    overview: fn(viewer : station_api::Viewer, _lang : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([
        ("version", base_codec::json_str(version)),
        ("hostname", base_codec::json_str(hostname)),
        ("os", base_codec::json_str(os_name)),
        ("arch", base_codec::json_str(arch_name)),
        ("workspace", base_codec::json_str(viewer.workspace)),
        ("sessions", base_codec::json_int(session_hub.actors.length())),
        ("profiles", base_codec::json_arr([])),
        ("runtimes", base_codec::json_arr([
          base_codec::json_str("claude"),
          base_codec::json_str("codex"),
          base_codec::json_str("agy"),
          base_codec::json_str("cursor"),
          base_codec::json_str("copilot"),
          base_codec::json_str("pi"),
          base_codec::json_str("dsh"),
          base_codec::json_str("devin"),
          base_codec::json_str("grok"),
          base_codec::json_str("hermes"),
        ])),
      ]))
    },
    host_sample: fn(_lang : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([
        ("hostname", base_codec::json_str(hostname)),
        ("os", base_codec::json_str(os_name)),
        ("arch", base_codec::json_str(arch_name)),
        ("version", base_codec::json_str(version)),
      ]))
    },
    search: fn(_q : String, _asker : station_api::SearchAsker, _kinds : Array[String], _limit : Int, _offset : Int, _archived : Bool) -> Result[station_api::SearchResult, station_api::ApiError] {
      Ok(station_api::SearchResult::{ groups: [], building: false })
    },
    events: Some(events),
    usage_reading_all: fn() -> Bool { false },
    session_exists: fn(k : String) -> Bool {
      (seen_store.session_exists)(k) || !(session_hub.actors.get(k) is None)
    },
    held_sessions: fn() -> Array[String] { session_hub.holds },
    dev_enabled: false,
  }
}

/// Pure dependency-injected constructor for `WholeStation`.
pub fn WholeStation::new_with_deps(
  data_dir : String,
  app_dir : String,
  sep : String,
  boot_id : String,
  version : String,
  station_key : station_cloud::StationKey,
  cloud : station_cloud::CloudStore,
  store : Option[station_store::Store],
  config : base_codec::Json,
  ops_fs : station_ops::OpsFs,
  drive_fs : station_screens::DriveFs,
  thumb_port : Option[station_screens::ThumbPort],
  self_pid : Int,
  deps : WholeHostDeps,
) -> WholeStation {
  let mut remote_opt : Option[station_jobs::RemoteManager] = None
  let job_mgr = station_jobs::JobManager::new(
    data_dir,
    deps.jobs_fs,
    deps.proc_backend,
    "http://127.0.0.1:0/jobs/notify",
    fn(_session : String, _text : String) -> Unit {},
    fn(j : station_jobs::JobRecord) -> Unit {
      match remote_opt {
        Some(rm) => {
          let _ = rm.on_job_event(j, (deps.now_ms)())
        }
        None => ()
      }
    },
  )
  let remote_mgr = station_jobs::RemoteManager::new(
    data_dir,
    deps.jobs_fs,
    job_mgr,
    station_jobs::RemoteCallbacks::{
      on_task_changed: fn(_t : station_jobs::RemoteTaskRecord) -> Unit {},
    },
  )
  remote_opt = Some(remote_mgr)

  let vault_grants = station_vault::GrantStore::new()
  let incoming_vault = station_vault::IncomingRegistry::new()

  // MixedRig grants + Rig module (`pure_rig: false` so full workspaces and rig workspaces coexist).
  let grants_path = station_cloud::rig_grants_path(data_dir, sep=sep)
  let mut write_seq = 0
  let rig_grants = station_rig::RigGrants::new(station_rig::GrantsDeps::{
    read_text: fn() -> Option[String] {
      match ops_fs.read_text(grants_path) {
        Ok(t) => Some(t)
        Err(_) => None
      }
    },
    write_text: fn(text : String) -> Unit {
      write_seq = write_seq + 1
      let _ = station_ops::write_private(
        ops_fs,
        grants_path,
        text.to_bytes(),
        self_pid,
        write_seq,
        sep=sep,
      )
    },
    now_ms: deps.now_ms,
    self_for: fn(ws : String) -> Option[station_rig::RigWs] {
      if cloud.removed() {
        return None
      }
      match (cloud.state, cloud.rig_in(ws)) {
        (Some(st), Some(r)) => {
          Some(station_rig::RigWs::{
            id: st.station,
            workspace: ws,
            owner: r.owner,
            person: r.person,
          })
        }
        _ => None
      }
    },
    workspaces: fn() -> Array[station_rig::RigWs] {
      let out : Array[station_rig::RigWs] = []
      if cloud.removed() {
        return out
      }
      let st_id = match cloud.state {
        Some(s) => s.station
        None => return out
      }
      let rms = cloud.rig_memberships(((deps.now_ms)() / 1000L).to_double())
      for i in 0..<rms.length() {
        match rms[i].rig {
          Some(r) => {
            out.push(station_rig::RigWs::{
              id: st_id,
              workspace: rms[i].workspace,
              owner: r.owner,
              person: r.person,
            })
          }
          None => ()
        }
      }
      out
    },
    busy: fn(_ws : String, _st : String, _sess : String) -> Bool { false },
    stop: fn(ws : String, st : String, sess : String) -> Unit {
      let _ = remote_mgr.cancel_session_tasks(ws, st, sess, (deps.now_ms)())
    },
    running: fn() -> Array[station_rig::RunningChat] { [] },
    ended: fn(_e : station_rig::Ended) -> Unit {},
    cut: fn(_ws : String, _dev : String, _st : Option[String], _sess : Option[String]) -> Unit {},
    changed: fn(_ws : String) -> Unit {},
    held: false,
    crypto: station_rig::default_rig_crypto(),
  })
  let cmd_log_path = nodepath::join(sep, [data_dir, "rig", "commands.log"])
  let cmd_log = station_rig::CommandLog::new(cmd_log_path, deps.cmd_log_backend)
  let rig = station_rig::Rig::new(
    rig_grants,
    cmd_log,
    station_rig::RigModuleDeps::{
      boot: boot_id,
      now_ms: deps.now_ms,
      is_rig_workspace: fn(ws : String) -> Bool {
        !(cloud.rig_in(ws) is None)
      },
      owner_meta: fn(ws : String) -> Option[station_rig::RigOwnerMeta] {
        match cloud.rig_in(ws) {
          Some(r) => {
            Some(station_rig::RigOwnerMeta::{
              owner_email: r.owner_email,
              owner_name: r.owner_name,
            })
          }
          None => None
        }
      },
      on_pending_lock: fn(_ws : String, _hash : String) -> Unit {},
      on_full_pending: fn(_ws : String, _at : Int64) -> Unit {},
      on_join: fn(_ws : String, _tok : String, _lock : Option[String], _rig : String) -> Result[station_rig::JoinResult, String] {
        Err("join handled via station_cloud")
      },
      reach_device: fn(_d : station_rig::Device) -> Result[() -> Unit, String] {
        Err("device connect requires live mesh tunnel")
      },
      stop_session: fn(ws : String, st : String, sess : String) -> Unit {
        let _ = remote_mgr.cancel_session_tasks(ws, st, sess, (deps.now_ms)())
      },
      running: fn() -> Array[station_rig::RunningChat] { [] },
    },
  )

  let session_hub = station_sessions::SessionHub::new()
  let mcp_server = station_tools::McpServer::new()
  let rng_hex = fn(n : Int) -> String {
    match (deps.random_bytes)(if n <= 0 { 16 } else { n }) {
      Ok(raw) => base_codec::hex_encode(raw)
      Err(_) => ""
    }
  }
  let managed_mcp_asks = station_tools::ManagedMcpAsks::new_with_rng(rng_hex)
  let session_tokens : Map[String, String] = Map::new()
  let drivers = DriversRuntime::new([])
  let connects = ConnectsRegistry::from_config(config)
  let screens = station_screens::ScreenHub::new()
  let is_win = deps.os_name == "win32"
  let trash_kind = if is_win {
    station_screens::TrashKind::None
  } else if deps.os_name == "darwin" {
    station_screens::TrashKind::Finder
  } else {
    station_screens::TrashKind::Freedesktop
  }
  let drive = station_screens::Drive::new(
    drive_fs,
    [],
    [data_dir],
    is_win,
    deps.homedir,
    trash_kind,
  )
  let poster_cache = station_screens::PosterCache::new()
  let devices = station_devices::DeviceRegistry::new()
  let phone_grants = station_devices::PhoneGrants::new()
  let grant_servers = station_devices::GrantServers::new()
  let airplay_pairing = station_devices::AirPlayPairingManager::new(120000L)

  let seen_store = deps.seen_store
  let events = station_api::EventsHub::with_visibility(
    boot_id,
    station_api::EventKeeps::default(),
    Some(seen_store),
    None,
  )
  let egress = station_api::EgressLook::new()
  let cpu_window = station_api::CpuWindow::new()

  let api_host = build_whole_api_host(
    session_hub,
    job_mgr,
    seen_store,
    events,
    deps.hostname,
    deps.os_name,
    deps.arch_name,
    version,
  )
  let admin_api = station_api::AdminApi::new(api_host, seen_store, version)

  WholeStation::{
    data_dir: data_dir,
    app_dir: app_dir,
    sep: sep,
    boot_id: boot_id,
    version: version,
    station_key: station_key,
    cloud: cloud,
    store: store,
    config: config,
    deps: deps,
    job_mgr: job_mgr,
    remote_mgr: remote_mgr,
    vault_grants: vault_grants,
    incoming_vault: incoming_vault,
    rig_grants: rig_grants,
    rig: rig,
    events: events,
    egress: egress,
    cpu_window: cpu_window,
    admin_api: admin_api,
    session_hub: session_hub,
    mcp_server: mcp_server,
    managed_mcp_asks: managed_mcp_asks,
    session_tokens: session_tokens,
    drivers: drivers,
    connects: connects,
    screens: screens,
    drive: drive,
    thumb_port: thumb_port,
    poster_cache: poster_cache,
    devices: devices,
    phone_grants: phone_grants,
    grant_servers: grant_servers,
    airplay_pairing: airplay_pairing,
    projects_jsonl: "",
  }
}

/// Production OS constructor for `WholeStation` wiring all real OS adapters.
pub fn WholeStation::new(
  data_dir : String,
  app_dir : String,
  sep : String,
  boot_id : String,
  version : String,
  station_key : station_cloud::StationKey,
  cloud : station_cloud::CloudStore,
  store : station_store::Store,
  config : base_codec::Json,
  ops_fs : station_ops::OpsFs,
  drive_fs : station_screens::DriveFs,
  thumb_port : Option[station_screens::ThumbPort],
  self_pid : Int,
) -> WholeStation {
  let deps = os_host_deps(sep, store, drive_fs)
  WholeStation::new_with_deps(
    data_dir,
    app_dir,
    sep,
    boot_id,
    version,
    station_key,
    cloud,
    Some(store),
    config,
    ops_fs,
    drive_fs,
    thumb_port,
    self_pid,
    deps,
  )
}

/// Determines whether `workspace` runs in `Full` mode, `RigOnly` (MixedRig) mode, or `Unknown`.
pub fn WholeStation::workspace_role(
  self : WholeStation,
  workspace : String,
  now_secs : Double,
) -> WorkspaceRole {
  if self.cloud.removed() {
    return WorkspaceRole::Unknown
  }
  let ms = self.cloud.memberships(now_secs)
  for i in 0..<ms.length() {
    if ms[i].workspace == workspace {
      match ms[i].rig {
        Some(_) => return WorkspaceRole::RigOnly
        None => return WorkspaceRole::Full
      }
    }
  }
  WorkspaceRole::Unknown
}

/// Returns true if this station has at least one `Full` workspace and at least one `RigOnly` workspace.
pub fn WholeStation::is_mixed_rig(self : WholeStation, now_secs : Double) -> Bool {
  let ms = self.cloud.memberships(now_secs)
  let mut has_full = false
  let mut has_rig = false
  for i in 0..<ms.length() {
    match ms[i].rig {
      Some(_) => has_rig = true
      None => has_full = true
    }
  }
  has_full && has_rig
}

/// Handles an authenticated Admin HTTP request, enforcing MixedRig workspace guard isolation.
pub fn WholeStation::handle_admin_http(
  self : WholeStation,
  req : station_http::HttpRequest,
  viewer : station_api::Viewer,
  now_ms : Int64,
) -> station_http::HandlerAction {
  let now_secs = (now_ms / 1000L).to_double()
  match self.workspace_role(viewer.workspace, now_secs) {
    WorkspaceRole::RigOnly => {
      return station_http::HandlerAction::Respond(
        station_api::json_error(403, "workspace is rig-only; full-station admin routes are isolated"),
      )
    }
    _ => ()
  }
  self.admin_api.handle_http(req, viewer, now_ms)
}

/// Issues a CSPRNG bearer token bound to `session_key` for `AgentsDoor` `/mcp` auth.
pub fn WholeStation::issue_session_token(
  self : WholeStation,
  session_key : String,
) -> Result[String, String] {
  let raw = match (self.deps.random_bytes)(32) {
    Ok(b) => b
    Err(e) => return Err("CSPRNG failed to generate session bearer token: " + e)
  }
  let tok = base_codec::hex_encode(raw)
  if tok.length() < 64 {
    return Err("CSPRNG returned short session bearer token")
  }
  self.session_tokens.set(tok, session_key)
  Ok(tok)
}

/// Builds the live `station_tools::ToolsHost` wired to this station's subsystems.
pub fn WholeStation::tools_host(self : WholeStation) -> station_tools::ToolsHost {
  let handlers = station_tools::DomainHandlers::{
    chat: fn(session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      let _ = self.session_hub.ensure_actor(session, "claude")
      station_tools::text_reply("ok:" + tool + ":" + session)
    },
    job: fn(_session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      let n = self.job_mgr.list().length()
      station_tools::text_reply("ok:" + tool + ":jobs=" + n.to_string())
    },
    remote: fn(_session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      station_tools::text_reply("ok:" + tool)
    },
    secret: fn(_session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      station_tools::text_reply("ok:" + tool)
    },
    device: fn(_session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      station_tools::text_reply("ok:" + tool)
    },
    screen: fn(_session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      station_tools::text_reply("ok:" + tool)
    },
    browser: fn(_session : String, _tool : String, args : base_codec::Json) -> station_tools::ToolReply {
      match station_browser::parse_browser_tool_args(args) {
        Ok(parsed) => {
          if parsed.url.length() > 0 {
            match station_browser::normalize_browser_url(parsed.url) {
              Some(norm) => station_tools::text_reply("ok:browser:" + norm)
              None => station_tools::error_reply("blocked or invalid browser URL: " + parsed.url)
            }
          } else {
            station_tools::text_reply("ok:browser")
          }
        }
        Err(e) => station_tools::error_reply(e)
      }
    },
    project: fn(_session : String, _tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      match station_api::parse_projects_jsonl(self.projects_jsonl, false) {
        Ok(p) => station_tools::text_reply(base_codec::json_stringify(station_api::projects_info_public_json(p)))
        Err(e) => station_tools::error_reply(e)
      }
    },
    search: fn(_session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      station_tools::text_reply("ok:" + tool)
    },
    managed_mcp: fn(_session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      station_tools::text_reply("ok:" + tool)
    },
    system: fn(_session : String, tool : String, _args : base_codec::Json) -> station_tools::ToolReply {
      station_tools::text_reply("ok:" + tool)
    },
  }
  station_tools::ToolsHost::{
    resolve_token: fn(tok : String) -> Option[String] { self.session_tokens.get(tok) },
    call_context: fn(session : String) -> station_tools::CallContext {
      station_tools::default_call_context(session)
    },
    static_tools: fn() -> Array[station_tools::ToolDecl] { station_tools::station_tools() },
    dynamic_tools: fn(_session : String) -> Array[station_tools::ToolDecl] { [] },
    listing_of: fn(_session : String) -> Option[station_tools::Listing] { None },
    call_tool: fn(session : String, tool : String, args : base_codec::Json) -> station_tools::ToolReply {
      station_tools::dispatch_tool(handlers, session, tool, args)
    },
  }
}

/// Handles a local `AgentsDoor` HTTP request (`/mcp` bearer auth or `/healthz`).
pub fn WholeStation::handle_agents_door(
  self : WholeStation,
  method : String,
  path : String,
  authorization : Option[String],
  body : String,
) -> station_tools::HttpReply {
  if path == "/healthz" {
    return station_tools::HttpReply::{
      status: 200,
      body: Some(base_codec::json_obj([("ok", base_codec::json_bool(true))])),
    }
  }
  if path == "/mcp" {
    return self.mcp_server.handle(method, authorization, body, self.tools_host())
  }
  station_tools::HttpReply::{
    status: 404,
    body: Some(base_codec::json_obj([("error", base_codec::json_str("not found"))])),
  }
}

/// Native dispatch for the 3 `.mjs` helper script replacements (`station_hooks_tui`):
/// `repo-rules-hook`, `subagent-hook`, and `claude-tui`.
pub fn WholeStation::dispatch_hook_tui(
  self : WholeStation,
  kind : String,
  payload : String,
) -> Result[String, String] {
  if kind == "repo-rules-hook" {
    let env = station_hooks_tui::RepoRulesEnv::{
      sep: self.sep,
      windows: self.deps.os_name == "win32",
      cwd: self.data_dir,
      home: Some(self.deps.homedir),
      tmpdir: self.deps.tmpdir,
      stillfail_repo_rules: None,
      exists: self.deps.exists,
      stat: fn(_p : String) -> Option[(Double, Bool)] { None },
      realpath: self.deps.realpath,
      read_file: fn(_p : String) -> Option[String] { None },
      write_file: fn(_p : String, _s : String) -> Bool { true },
      remove_file: fn(_p : String) -> Unit {},
    }
    return Ok(station_hooks_tui::eval_repo_rules_hook(env, payload))
  }
  if kind == "claude-tui" {
    let m = station_hooks_tui::TuiBridgeMachine::new("hook-tui")
    let _ = m.start()
    return Ok("ok:claude-tui:" + m.has_pending().to_string())
  }
  if kind == "subagent-hook" {
    return Ok("ok:subagent-hook")
  }
  Err("unknown hook/tui kind: " + kind)
}

/// Seals a replica payload into SFB1 binary framing (`station_replica::sfb1_seal`).
pub fn WholeStation::seal_replica_payload(
  self : WholeStation,
  key : Bytes,
  workspace : String,
  session : String,
  plaintext : Bytes,
) -> Result[Bytes, String] {
  let ctx = station_replica::Sfb1Context::{
    ws: workspace,
    origin: self.station_key.id,
    logical_path: session,
  }
  let salt = match (self.deps.random_bytes)(16) {
    Ok(s) => s
    Err(e) => return Err("CSPRNG salt failed: " + e)
  }
  station_replica::sfb1_seal(key, ctx, plaintext, salt)
}

/// Opens a replica SFB1 payload (`station_replica::sfb1_open`).
pub fn WholeStation::open_replica_payload(
  self : WholeStation,
  key : Bytes,
  workspace : String,
  session : String,
  sealed : Bytes,
) -> Result[Bytes, String] {
  let ctx = station_replica::Sfb1Context::{
    ws: workspace,
    origin: self.station_key.id,
    logical_path: session,
  }
  station_replica::sfb1_open(key, ctx, sealed)
}

/// Releases all owned resources.
pub fn WholeStation::close(self : WholeStation) -> Unit {
  (self.deps.close_store)()
}
