// Exhaustive reverse preimage table for `jscase::lower` (derived from
// `pion/station/packages/jscase/src/tables.pion` + U+0130 / U+03A3 special rules)
// and mathematically sound SQL `LIKE ... ESCAPE '\'` prefilter expansion.

import "base_codec"
import "jscase"

// Compressed 4-tuples `(t_start, count, step, f_start)`: for each `k` in `0..<count`,
// `f = f_start + k * step` (>= 0x80) lowers to `t = t_start + k * step` under `jscase::lower`.
