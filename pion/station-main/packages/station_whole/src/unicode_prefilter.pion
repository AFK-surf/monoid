  0x16ebb, 25, 1, 0x16ea0, 0x1e922, 34, 1, 0x1e900, 0xe5, 1, 1, 0x212b, 0x1c6, 1, 1, 0x1c5,
  0x1c9, 1, 1, 0x1c8, 0x1cc, 1, 1, 0x1cb, 0x1f3, 1, 1, 0x1f2, 0x3b8, 1, 1, 0x3f4,
