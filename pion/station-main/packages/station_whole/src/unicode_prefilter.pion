]

/// Return all non-ASCII code points `f >= 0x80` (`f != cp`) whose `jscase::lower` output
/// contains `cp` (exhaustive over Unicode 17.0 / V8 `String.prototype.toLowerCase()`).
pub fn non_ascii_preimages(cp : Int) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < PREIMAGE_RUNS.length() {
    let t0 = PREIMAGE_RUNS[i]
    let cnt = PREIMAGE_RUNS[i + 1]
    let step = PREIMAGE_RUNS[i + 2]
    let f0 = PREIMAGE_RUNS[i + 3]
    if cp >= t0 {
      let diff = cp - t0
      if diff <= (cnt - 1) * step && (diff % step) == 0 {
        let f = f0 + diff
        let mut dup = false
        for j in 0..<out.length() {
          if out[j] == f {
            dup = true
            break
          }
        }
        if !dup {
          out.push(f)
        }
      }
    }
    i = i + 4
  }
  out
}

pub let MAX_UNICODE_SCAN_ROWS : Int = 10000

pub fn encode_utf8_cp(cp : Int) -> String {
  let sb = StringBuilder::new()
  if cp < 0x80 {
    sb.write_byte(cp as Byte)
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)) as Byte)
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  } else {
    sb.write_byte((0xF0 | (cp >> 18)) as Byte)
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)) as Byte)
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  }
  sb.to_string()
}

fn encode_utf8_slice(pts : Array[Int], start : Int, end : Int) -> String {
  let sb = StringBuilder::new()
  for i in start..<end {
    let cp = pts[i]
    if cp < 0x80 {
      sb.write_byte(cp as Byte)
    } else if cp < 0x800 {
      sb.write_byte((0xC0 | (cp >> 6)) as Byte)
      sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
    } else if cp < 0x10000 {
      sb.write_byte((0xE0 | (cp >> 12)) as Byte)
      sb.write_byte((0x80 | ((cp >> 6) & 0x3F)) as Byte)
      sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
    } else {
      sb.write_byte((0xF0 | (cp >> 18)) as Byte)
      sb.write_byte((0x80 | ((cp >> 12) & 0x3F)) as Byte)
      sb.write_byte((0x80 | ((cp >> 6) & 0x3F)) as Byte)
      sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
    }
  }
  sb.to_string()
}

/// Positions in a lowercased pure-ASCII term that can originate from a non-ASCII code point
/// under `jscase::lower`: `'k'` (U+212A Kelvin) anywhere, or `'i'` (U+0130 Turkish İ -> i + U+0307)
/// ONLY at the final code point of the term.
fn ascii_ambig_positions(pts : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  let n = pts.length()
  for i in 0..<n {
    let cp = pts[i]
    if cp == 0x6B || (cp == 0x69 && i == n - 1) {
      out.push(i)
    }
  }
  out
}

fn expand_ascii_variants(pts : Array[Int], ambig : Array[Int]) -> Array[String] {
  let k = ambig.length()
  let total = 1 << k
  let out : Array[String] = []
  for mask in 0..<total {
    let cur : Array[Int] = []
    for i in 0..<pts.length() {
      cur.push(pts[i])
    }
    for b in 0..<k {
      if ((mask >> b) & 1) == 1 {
        let pos = ambig[b]
        cur[pos] = if cur[pos] == 0x6B { 0x212A } else { 0x0130 }
      }
    }
    out.push(encode_utf8_slice(cur, 0, cur.length()))
  }
  out
}

/// Return true iff `term` is 100% exactly representable by SQLite `lower(col) LIKE` (either
/// single `LIKE` or exact `<= 4`-way `OR` expansion for ASCII with `<= 2` `'k'`/trailing-`'i'`
/// positions), requiring NO keyset scan.
pub fn is_sql_like_exact_term(term : String) -> Bool {
  let low = jscase::lower(term)
  let pts = decode_utf8_points(low)
  if pts.length() == 0 {
    return true
  }
  if is_ascii_only(low) {
    return ascii_ambig_positions(pts).length() <= 2
  }
  if jscase::has_cases(low) {
    return false
  }
  for i in 0..<pts.length() {
    if non_ascii_preimages(pts[i]).length() > 0 {
      return false
    }
  }
  true
}

/// Return true iff any non-empty term requires bounded keyset pagination + exact `jscase::lower`
/// verification after SQL prefiltering.
pub fn has_unicode_case_term(terms : Array[String]) -> Bool {
  for i in 0..<terms.length() {
    let t = terms[i]
    if t.length() > 0 && !is_sql_like_exact_term(t) {
      return true
    }
  }
  false
}

fn append_or_like(
  col_expr : String,
  literals : Array[String],
  start_idx : Int,
  params : Array[base_codec::Json],
) -> (String, Int) {
  let uniq : Array[String] = []
  for i in 0..<literals.length() {
    let pat = "%" + escape_sql_like(literals[i]) + "%"
    let mut dup = false
    for j in 0..<uniq.length() {
      if uniq[j] == pat {
        dup = true
        break
      }
    }
    if !dup {
      uniq.push(pat)
    }
  }
  if uniq.length() == 0 {
    return ("", start_idx)
  }
  if uniq.length() == 1 {
    params.push(base_codec::json_str(uniq[0]))
    (" AND lower(" + col_expr + ") LIKE ?" + start_idx.to_string() + " ESCAPE '\\'", start_idx + 1)
  } else {
    let mut sql = " AND ("
    let mut idx = start_idx
    for i in 0..<uniq.length() {
      if i > 0 {
        sql = sql + " OR "
      }
      sql = sql + "lower(" + col_expr + ") LIKE ?" + idx.to_string() + " ESCAPE '\\'"
      params.push(base_codec::json_str(uniq[i]))
      idx = idx + 1
    }
    sql = sql + ")"
    (sql, idx)
  }
}

/// Append mathematically sound (zero false negatives!) SQL `LIKE ... ESCAPE '\'` clauses for
/// `raw_term` targeting `col_expr`:
/// - Case A (pure ASCII): exact 1-way (`ambig == 0`) or 2/4-way `OR` (`1 <= ambig <= 2`), or
///   necessary substring/prefix-window prefilter (`ambig > 2`).
/// - Case B (caseless non-ASCII with zero preimages, e.g. CJK): exact 1-way `LIKE`.
/// - Case C (cased non-ASCII or mixed preimage term): longest unambiguous substring (`len >= 2`)
///   PLUS up to 3 distinct non-ASCII code points (first, middle, last) each expanded via
///   `[cp] + non_ascii_preimages(cp)` so SQLite C-layer filters out unrelated rows in milliseconds.
pub fn append_term_prefilter_clauses(
  col_expr : String,
  raw_term : String,
  start_idx : Int,
  params : Array[base_codec::Json],
) -> (String, Int) {
  let low = jscase::lower(raw_term)
  let pts = decode_utf8_points(low)
  let n = pts.length()
  if n == 0 {
    return ("", start_idx)
  }

  // Case A: pure ASCII
  if is_ascii_only(low) {
    let ambig = ascii_ambig_positions(pts)
    if ambig.length() == 0 {
      return append_or_like(col_expr, [low], start_idx, params)
    }
    if ambig.length() <= 2 {
      return append_or_like(col_expr, expand_ascii_variants(pts, ambig), start_idx, params)
    }
    // ambig > 2: prefer longest unambiguous substring (len >= 2), else prefix with <= 2 ambig positions
    let mut best_s = 0
    let mut best_len = 0
    let mut cur_s = 0
    let mut cur_len = 0
    for i in 0..<n {
      let is_amb = pts[i] == 0x6B || (pts[i] == 0x69 && i == n - 1)
      if !is_amb {
        if cur_len == 0 {
          cur_s = i
        }
        cur_len = cur_len + 1
        if cur_len > best_len {
          best_s = cur_s
          best_len = cur_len
        }
      } else {
        cur_len = 0
      }
    }
    if best_len >= 2 {
      let sub = encode_utf8_slice(pts, best_s, best_s + best_len)
      return append_or_like(col_expr, [sub], start_idx, params)
    }
    let mut win_end = 0
    let mut win_amb : Array[Int] = []
    for i in 0..<n {
      let is_amb = pts[i] == 0x6B || (pts[i] == 0x69 && i == n - 1)
      if is_amb {
        if win_amb.length() >= 2 {
          break
        }
        win_amb.push(i)
      }
      win_end = i + 1
    }
    let sub_pts : Array[Int] = []
    for i in 0..<win_end {
      sub_pts.push(pts[i])
    }
    return append_or_like(col_expr, expand_ascii_variants(sub_pts, win_amb), start_idx, params)
  }

  // Case B: caseless non-ASCII with zero preimages
  if !jscase::has_cases(low) {
    let mut any_pre = false
    for i in 0..<n {
      if non_ascii_preimages(pts[i]).length() > 0 {
        any_pre = true
        break
      }
    }
    if !any_pre {
      return append_or_like(col_expr, [low], start_idx, params)
    }
  }

  // Case C: cased non-ASCII or mixed preimage term
  let mut sql = ""
  let mut idx = start_idx

  // 1. Longest contiguous unambiguous substring (length >= 2)
  let mut best_s = 0
  let mut best_len = 0
  let mut cur_s = 0
  let mut cur_len = 0
  for i in 0..<n {
    let cp = pts[i]
    let unamb = if cp < 0x80 {
      cp != 0x6B && (cp != 0x69 || (i + 1 < n && pts[i + 1] < 0x80))
    } else {
      non_ascii_preimages(cp).length() == 0
    }
    if unamb {
      if cur_len == 0 {
        cur_s = i
      }
      cur_len = cur_len + 1
      if cur_len > best_len {
        best_s = cur_s
        best_len = cur_len
      }
    } else {
      cur_len = 0
    }
  }
  if best_len >= 2 {
    let sub = encode_utf8_slice(pts, best_s, best_s + best_len)
    let (c, next_idx) = append_or_like(col_expr, [sub], idx, params)
    sql = sql + c
    idx = next_idx
  }

  // 2. Up to 3 distinct non-ASCII code points (first, middle, last), each expanded with all preimages
  let distinct_non_ascii : Array[Int] = []
  for i in 0..<n {
    let cp = pts[i]
    if cp >= 0x80 {
      let mut dup = false
      for j in 0..<distinct_non_ascii.length() {
        if distinct_non_ascii[j] == cp {
          dup = true
          break
        }
      }
      if !dup {
        distinct_non_ascii.push(cp)
      }
    }
  }
  let chosen : Array[Int] = []
  let dn = distinct_non_ascii.length()
  if dn <= 3 {
    for i in 0..<dn {
      chosen.push(distinct_non_ascii[i])
    }
  } else {
    chosen.push(distinct_non_ascii[0])
    chosen.push(distinct_non_ascii[dn / 2])
    chosen.push(distinct_non_ascii[dn - 1])
  }
  for ci in 0..<chosen.length() {
    let cp = chosen[ci]
    let pre = non_ascii_preimages(cp)
    let lits : Array[String] = [encode_utf8_cp(cp)]
    for pi in 0..<pre.length() {
      lits.push(encode_utf8_cp(pre[pi]))
    }
    let (c, next_idx) = append_or_like(col_expr, lits, idx, params)
    sql = sql + c
    idx = next_idx
  }

  (sql, idx)
}
