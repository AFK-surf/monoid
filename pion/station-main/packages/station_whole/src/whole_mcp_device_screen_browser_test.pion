// Wave 17E-2B comprehensive pure-DI tests (zero C FFI) for:
// - `DomainHandlers.device` (workspace isolation, rig/phone owner approval, device_control, phone_send)
// - `DomainHandlers.screen` (`screen`, `computer` human-control precedence, `permissions`)
// - `DomainHandlers.browser` + `screens.browser.open` (localhost:3000, empty -> about:blank,
//   dangerous schemes blocked, 503 noBrowser, CDP wake rollback on failure)
// - `signins.{self,deny,fill}` + `sign_in` MCP tool (unknown JSON field preservation, 24h expiry,
//   archived session, `closed_cards` + append-edit, `SessionActor::enqueue_internal_notice`
//   non-blocking Steer, fail-closed refusal before storing plaintext password, origin-bound CDP
//   autofill, 15-min `HELD_MS` TTL, zero plaintext leakage).

import "base_codec"
import "builders_core"
import "host_shim"
import "station_api"
import "station_browser"
import "station_devices"
import "station_jobs"
import "station_screens"
import "station_sessions"
import "station_tools"

fn dsb_reply_text(r : station_tools::ToolReply) -> String {
  if r.content.length() == 0 {
    return ""
  }
  match r.content[0] {
    station_tools::ContentItem::Text(s) => s
    _ => ""
  }
}

fn make_dsb_mem_browser(now_cell : Array[Int64]) -> BrowserOsManager {
  let transport = builders_core::MuxTransport::{
    call_async: fn(_id : Int64, _op : String, _j : String, _p : Option[Bytes]) -> Unit {},
    call_sync: fn(_op : String, _j : String) -> String { "{}" },
    write_stdout_line: fn(_l : String) -> Bool { true },
    write_stdout_frame: fn(_h : Array[(String, base_codec::Json)], _p : Bytes) -> Bool { true },
    now_ms: fn() -> Int64 { now_cell[0] },
    wall_ms: fn() -> Int64 { now_cell[0] },
    wait: fn(_ms : Int64) -> Option[host_shim::HostEvent] { None },
  }
  let hub = EdgeMuxHub::from_transport(transport)
  let hold_hub = station_browser::AgentHoldHubPort::{
    people_views: fn(_sid : String) -> Array[station_browser::ScreenWatcherView] { [] },
    has_taken_view: fn(_sid : String) -> Bool { false },
    yield_to_agent: fn(_sid : String, _agent : String) -> Int { 0 },
    join_agent: fn(_sid : String, _agent : String) -> Int { 0 },
    leave_agent: fn(_sid : String, _tok : Int) -> Unit {},
  }
  BrowserOsManager::new(
    hub,
    hold_hub,
    fn(s : String) -> String { s },
    fn(_cid : String) -> Option[String] { None },
  )
}

fn make_dsb_mem_fixture(
  now_ms : Int64,
) -> (
  Array[Int64],
  WholeStore,
  WholeAgents,
  WholeApi,
  WholeApiRuntimeHooks,
  DevicesOsRuntime,
  BrowserOsManager,
  DsbMemStoreState,
  DsbStorePort,
) {
  let now_cell : Array[Int64] = [now_ms]
  let (store, agents, api, _, _, hooks) = make_mem_whole_api_fixture()
  let devices = DevicesOsRuntime::new(now_fn=fn() -> Int64 { now_cell[0] })
  let browser = make_dsb_mem_browser(now_cell)
  let mem = DsbMemStoreState::new()
  let store_port = DsbStorePort::in_memory(mem, agents)
  (now_cell, store, agents, api, hooks, devices, browser, mem, store_port)
}

test "w17e2b: screens.browser.open URL policy, 503 noBrowser, wake rollback, and success" {
  let (now_cell, _, agents, api, hooks, devices, browser, _, store_port) = make_dsb_mem_fixture(1_700_000_000_000L)
  let avail_cell : Array[Bool] = [false]
  let fail_wake_cell : Array[Bool] = [false]
  let wake_urls : Array[String] = []
  let base_ports = DeviceScreenBrowserPorts::in_memory()
  let ports = DeviceScreenBrowserPorts::{
    ..base_ports,
    random_hex: fn(_n : Int) -> String { "aabbccddeeff" },
    browser_available: fn() -> Bool { avail_cell[0] },
    wake_browser_target: fn(url : String, _key : String) -> Result[String, station_api::ApiError] {
      wake_urls.push(url)
      if fail_wake_cell[0] {
        return Err(station_api::ApiError::new(502, "cdp target creation failed"))
      }
      Ok("tgt-" + wake_urls.length().to_string())
    },
  }
  let rt = DeviceScreenBrowserRuntime::new(devices, browser, api.screens, ports)
  wire_device_screen_browser_with_port(rt, store_port, agents, hooks, "st-1", fn() -> Int64 { now_cell[0] })
  let alice = make_test_viewer("alice@example.com", "u-alice", "ws-main", true, "owner")
  let req = make_test_api_req_as("POST", "/screens/browser", alice)

  // 1. Dangerous schemes strictly blocked with 400
  let bad_urls : Array[String] = [
    "file:///etc/passwd",
    "javascript:alert(1)",
    "data:text/html,<h1>x</h1>",
    "chrome://settings",
    "mailto:alice@example.com",
  ]
  for i in 0..<bad_urls.length() {
    match (api.admin.host.call)(
      "screens.browser.open",
      req,
      [],
      base_codec::json_obj([("url", base_codec::json_str(bad_urls[i]))]),
    ) {
      Err(e) => if e.status != 400 { panic("expected 400 for " + bad_urls[i] + ", got " + e.status.to_string()) }
      Ok(_) => panic("dangerous URL must be rejected: " + bad_urls[i])
    }
  }

  // 2. No browser available -> 503 station.screen.noBrowser (even for valid localhost:3000)
  match (api.admin.host.call)(
    "screens.browser.open",
    req,
    [],
    base_codec::json_obj([("url", base_codec::json_str("localhost:3000"))]),
  ) {
    Err(e) => if e.status != 503 { panic("expected 503 noBrowser, got " + e.status.to_string()) }
    Ok(_) => panic("expected 503 when no browser available")
  }

  // 3. Wake failure -> rolls back ScreenHub + UserTabsState (zero phantom screen!)
  avail_cell[0] = true
  fail_wake_cell[0] = true
  match (api.admin.host.call)(
    "screens.browser.open",
    req,
    [],
    base_codec::json_obj([("url", base_codec::json_str("localhost:3000")), ("id", base_codec::json_str("u_112233445566"))]),
  ) {
    Err(e) => if e.status != 502 { panic("expected 502 on wake failure, got " + e.status.to_string()) }
    Ok(_) => panic("expected error on wake failure")
  }
  if api.screens.get("browser:u_112233445566").is_some() {
    panic("ScreenHub leaked phantom screen after wake failure")
  }
  if !browser.user_tabs.is_sleeping("u_112233445566") {
    panic("UserTabsState leaked live tab after wake failure")
  }

  // 4. localhost:3000 succeeds -> normalized to http://localhost:3000/
  fail_wake_cell[0] = false
  match (api.admin.host.call)(
    "screens.browser.open",
    req,
    [],
    base_codec::json_obj([("url", base_codec::json_str("localhost:3000")), ("id", base_codec::json_str("u_112233445566"))]),
  ) {
    Ok(j) => {
      if json_field_str(j, "screen") != Some("browser:u_112233445566") {
        panic("unexpected screen id for localhost:3000")
      }
    }
    Err(e) => panic("localhost:3000 should succeed: " + e.message)
  }
  if wake_urls[wake_urls.length() - 1] != "http://localhost:3000/" {
    panic("expected http://localhost:3000/, got " + wake_urls[wake_urls.length() - 1])
  }

  // 5. Empty URL -> opens about:blank
  match (api.admin.host.call)(
    "screens.browser.open",
    req,
    [],
    base_codec::json_obj([("url", base_codec::json_str("")), ("id", base_codec::json_str("u_abcdef012345"))]),
  ) {
    Ok(j) => {
      if json_field_str(j, "screen") != Some("browser:u_abcdef012345") {
        panic("unexpected screen id for empty URL")
      }
    }
    Err(e) => panic("empty URL should open about:blank: " + e.message)
  }
  if wake_urls[wake_urls.length() - 1] != "about:blank" {
    panic("expected about:blank, got " + wake_urls[wake_urls.length() - 1])
  }
}

test "w17e2b: DomainHandlers.device workspace isolation, rig/phone approval, and device_control" {
  let (now_cell, store, agents, api, hooks, devices, browser, mem, store_port) = make_dsb_mem_fixture(1_700_000_000_000L)
  mem.sessions.set("s-main", DsbSessionInfo::{
    ws: "ws-main",
    creator: Some("alice@example.com"),
    workspace_dir: "/tmp",
    archived: false,
    runtime: "claude",
    thread_id: Some(10L),
    chat_addr: Some("CHAT/10"),
  })
  mem.sessions.set("s-other", DsbSessionInfo::{
    ws: "ws-other",
    creator: Some("bob@example.com"),
    workspace_dir: "/tmp",
    archived: false,
    runtime: "claude",
    thread_id: Some(11L),
    chat_addr: Some("CHAT/11"),
  })

  let _ = devices.registry.add(
    "ws-main",
    "u-alice",
    "alice@example.com",
    "Alice",
    station_devices::DeviceSpec::{
      id: "1111111111111111",
      name: "Lab Router",
      kind: station_devices::DeviceKind::Tcp,
      target: "10.0.0.5:8080",
      baud: None,
      model: None,
      protocols: None,
      paired: None,
    },
    100L,
  )
  let _ = devices.registry.add(
    "ws-main",
    "u-alice",
    "alice@example.com",
    "Alice",
    station_devices::DeviceSpec::{
      id: "2222222222222222",
      name: "Rig Board",
      kind: station_devices::DeviceKind::Tcp,
      target: "10.0.0.6:22",
      baud: None,
      model: None,
      protocols: None,
      paired: None,
    },
    100L,
  )
  let _ = devices.registry.add(
    "ws-other",
    "u-bob",
    "bob@example.com",
    "Bob",
    station_devices::DeviceSpec::{
      id: "3333333333333333",
      name: "Other WS Secret",
      kind: station_devices::DeviceKind::Tcp,
      target: "10.0.0.9:22",
      baud: None,
      model: None,
      protocols: None,
      paired: None,
    },
    100L,
  )

  let rig_approved_cell : Array[Bool] = [false]
  let base_ports = DeviceScreenBrowserPorts::in_memory()
  let ports = DeviceScreenBrowserPorts::{
    ..base_ports,
    rig_device_approved: fn(_ws : String, _sess : String, dev_id : String) -> Bool {
      dev_id == "2222222222222222" && rig_approved_cell[0]
    },
  }
  let rt = DeviceScreenBrowserRuntime::new(devices, browser, api.screens, ports)
  rt.rig_device_ids.set("ws-main\x002222222222222222", true)
  wire_device_screen_browser_with_port(rt, store_port, agents, hooks, "st-1", fn() -> Int64 { now_cell[0] })
  let base_h = station_tools::default_domain_handlers()
  let handlers = station_tools::DomainHandlers::{
    ..base_h,
    device: match agents.device_tool_override { Some(f) => f, None => base_h.device },
  }
  let _ = store

  // 1. Cross-workspace isolation
  let list_r = (handlers.device)("s-main", "device_list", base_codec::json_obj([]))
  if list_r.is_error { panic("device_list failed: " + dsb_reply_text(list_r)) }
  if dsb_reply_text(list_r).contains("Other WS Secret") || dsb_reply_text(list_r).contains("3333333333333333") {
    panic("cross-workspace device leaked into device_list!")
  }
  let cross_use = (handlers.device)("s-main", "device_use", base_codec::json_obj([("device", base_codec::json_str("3333333333333333"))]))
  if !cross_use.is_error {
    panic("cross-workspace device_use must be rejected")
  }

  // 2. Unapproved rig device MUST be rejected
  let rig_denied = (handlers.device)("s-main", "device_use", base_codec::json_obj([("device", base_codec::json_str("Rig Board"))]))
  if !rig_denied.is_error || !dsb_reply_text(rig_denied).contains("owner approval") {
    panic("unapproved rig device must be rejected, got: " + dsb_reply_text(rig_denied))
  }

  // 3. Approved rig device succeeds
  rig_approved_cell[0] = true
  let rig_ok = (handlers.device)("s-main", "device_use", base_codec::json_obj([("device", base_codec::json_str("Rig Board"))]))
  if rig_ok.is_error {
    panic("approved rig device should succeed, got: " + dsb_reply_text(rig_ok))
  }

  // 4. Phone approval isolation
  let send_unapproved = (handlers.device)("s-main", "phone_send", base_codec::json_obj([("path", base_codec::json_str("/tmp/a.apk"))]))
  if !send_unapproved.is_error || !dsb_reply_text(send_unapproved).contains("no phone grant") {
    panic("phone_send without grant must be refused")
  }
  let ask_phone = (handlers.device)("s-main", "phone_use", base_codec::json_obj([("reason", base_codec::json_str("run android test"))]))
  if ask_phone.is_error || !dsb_reply_text(ask_phone).contains("waits for them to approve") {
    panic("phone_use should create pending approval request, got: " + dsb_reply_text(ask_phone))
  }
}

test "w17e2b: DomainHandlers.screen hides user tabs, enforces human control, and permissions is non-blocking" {
  let (now_cell, store, agents, api, hooks, devices, browser, mem, store_port) = make_dsb_mem_fixture(1_700_000_000_000L)
  mem.sessions.set("s-main", DsbSessionInfo::{
    ws: "ws-main",
    creator: Some("alice@example.com"),
    workspace_dir: "/tmp",
    archived: false,
    runtime: "claude",
    thread_id: Some(20L),
    chat_addr: Some("CHAT/20"),
  })

  api.screens.add(station_screens::RegisteredSource::desktop("desktop", "Mac Desktop", 1920, 1080))
  api.screens.add(station_screens::RegisteredSource::{
    ..station_screens::RegisteredSource::desktop("browser:u_secret", "Private Tab", 1280, 800),
    kind: station_screens::ScreenKind::Browser,
    user_tab: true,
  })
  let _ = api.screens.join("desktop", station_screens::JoinParams::human("Alice", true, "dev-1", true), now_cell[0])

  let rt = DeviceScreenBrowserRuntime::new(devices, browser, api.screens, DeviceScreenBrowserPorts::in_memory())
  wire_device_screen_browser_with_port(rt, store_port, agents, hooks, "st-1", fn() -> Int64 { now_cell[0] })
  let base_h = station_tools::default_domain_handlers()
  let handlers = station_tools::DomainHandlers::{
    ..base_h,
    screen: match agents.screen_tool_override { Some(f) => f, None => base_h.screen },
    browser: match agents.browser_tool_override { Some(f) => f, None => base_h.browser },
  }
  let _ = store

  // 1. `screen` lists desktop and hides private user_tab
  let listed = (handlers.screen)("s-main", "screen", base_codec::json_obj([]))
  if listed.is_error || !dsb_reply_text(listed).contains("desktop") || dsb_reply_text(listed).contains("u_secret") {
    panic("screen list mismatch: " + dsb_reply_text(listed))
  }
  // 2. Requesting user_tab directly returns userOnly error
  let user_only = (handlers.screen)("s-main", "screen", base_codec::json_obj([("id", base_codec::json_str("browser:u_secret"))]))
  if !user_only.is_error {
    panic("screen must refuse user_tab")
  }
  // 3. `computer` click refused while Alice is controlling desktop
  let click_refused = (handlers.screen)(
    "s-main",
    "computer",
    base_codec::json_obj([
      ("screen", base_codec::json_str("desktop")),
      ("action", base_codec::json_str("click")),
      ("x", base_codec::json_int(100)),
      ("y", base_codec::json_int(200)),
    ]),
  )
  if !click_refused.is_error || !dsb_reply_text(click_refused).contains("Alice") || !dsb_reply_text(click_refused).contains("controlling") {
    panic("computer must refuse input while human controls screen, got: " + dsb_reply_text(click_refused))
  }
  // 4. `permissions` on Linux returns non-Mac guidance without blocking
  let perms = (handlers.screen)("s-main", "permissions", base_codec::json_obj([]))
  if perms.is_error || !dsb_reply_text(perms).contains("not a Mac") {
    panic("permissions on linux mismatch: " + dsb_reply_text(perms))
  }
  // 5. `browser` tool status works cleanly
  let bstatus = (handlers.browser)("s-main", "browser", base_codec::json_obj([("action", base_codec::json_str("status"))]))
  if bstatus.is_error || !dsb_reply_text(bstatus).contains("Not running") {
    panic("browser status mismatch: " + dsb_reply_text(bstatus))
  }
}

test "w17e2b: signins.{self,deny,fill} preserves unknown fields, closes cards, enqueues internal notice, enforces 15min TTL & zero plaintext leak" {
  let base_ms : Int64 = 1_700_000_000_000L
  let (now_cell, _, agents, api, hooks, devices, browser, mem, store_port) = make_dsb_mem_fixture(base_ms)
  mem.sessions.set("s-1", DsbSessionInfo::{
    ws: "ws-main",
    creator: Some("alice@example.com"),
    workspace_dir: "/tmp",
    archived: false,
    runtime: "claude",
    thread_id: Some(500L),
    chat_addr: Some("CHAT/ts-500"),
  })

  let seeded_body = base_codec::json_obj([
    ("id", base_codec::json_str("g_ask1")),
    ("session", base_codec::json_str("s-1")),
    ("chat", base_codec::json_str("CHAT/ts-500")),
    ("owner", base_codec::json_str("alice@example.com")),
    ("site", base_codec::json_str("github.com")),
    ("tab", base_codec::json_str("tab-gh")),
    ("reason", base_codec::json_str("check PR")),
    ("at", base_codec::json_int64(base_ms / 1000L)),
    ("status", base_codec::json_str("pending")),
    ("thread", base_codec::json_int64(500L)),
    ("cardTs", base_codec::json_str("card-1")),
    ("said", base_codec::json_str("keep-me-said")),
    ("save", base_codec::json_str("req-save-99")),
    ("kept", base_codec::json_str("pending")),
    ("customExtra", base_codec::json_str("preserve-me-123")),
  ])
  mem.asks.set("g_ask1", ("s-1", "pending", base_codec::json_stringify(seeded_body)))

  let browser_avail : Array[Bool] = [false]
  let tab_live : Array[Bool] = [false]
  let typed_origins : Array[String] = []
  let filled_pw_seen : Array[Bool] = [false]
  let step_moved : Array[Bool] = [false]
  let secret_pw = "S3cr3t!Pass#2026"

  let base_ports = DeviceScreenBrowserPorts::in_memory()
  let ports = DeviceScreenBrowserPorts::{
    ..base_ports,
    browser_available: fn() -> Bool { browser_avail[0] },
    has_live_session_tab: fn(s : String, t : String) -> Bool { s == "s-1" && t == "tab-gh" && tab_live[0] },
    signin_form_for: fn(s : String, t : String) -> Option[station_browser::SignInFormPort] {
      if s != "s-1" || t != "tab-gh" || !tab_live[0] {
        return None
      }
      Some(station_browser::SignInFormPort::{
        get_url: fn() -> String {
          if step_moved[0] { "https://github.com/dashboard" } else { "https://github.com/login" }
        },
        on_site: fn(_site : String) -> Bool { true },
        look: fn() -> station_browser::FormAsks {
          if step_moved[0] {
            station_browser::FormAsks::{ username: false, password: false, code: false, blocked: false }
          } else {
            station_browser::FormAsks::{ username: true, password: true, code: false, blocked: false }
          }
        },
        type_field: fn(kind : station_browser::FormField, fval : String, expected_origin : String) -> Bool {
          typed_origins.push(expected_origin)
          match kind {
            station_browser::FormField::Password => if fval == secret_pw { filled_pw_seen[0] = true }
            _ => ()
          }
          true
        },
        enter: fn() -> Unit { step_moved[0] = true },
        press: fn() -> Bool { true },
        mark: fn() -> Unit { () },
        marked: fn() -> Bool { !step_moved[0] },
      })
    },
  }
  let rt = DeviceScreenBrowserRuntime::new(devices, browser, api.screens, ports)
  wire_device_screen_browser_with_port(rt, store_port, agents, hooks, "st-1", fn() -> Int64 { now_cell[0] })

  let alice = make_test_viewer("alice@example.com", "u-alice", "ws-main", true, "owner")
  let alice_other_ws = make_test_viewer("alice@example.com", "u-alice", "ws-other", true, "owner")
  let req_alice = make_test_api_req_as("POST", "/browser/sign-ins/g_ask1/fill", alice)

  // 1. Cross-workspace request rejected (409)
  match (api.admin.host.call)(
    "signins.fill",
    make_test_api_req_as("POST", "/browser/sign-ins/g_ask1/fill", alice_other_ws),
    ["g_ask1"],
    base_codec::json_obj([("password", base_codec::json_str(secret_pw))]),
  ) {
    Err(e) => if e.status != 409 { panic("expected 409 for cross-ws signin") }
    Ok(_) => panic("cross-ws signin must be rejected")
  }

  // 2. FAIL-CLOSED BEFORE HOLDING PLAINTEXT PASSWORD when browser/tab is unavailable!
  match (api.admin.host.call)(
    "signins.fill",
    req_alice,
    ["g_ask1"],
    base_codec::json_obj([("username", base_codec::json_str("alice")), ("password", base_codec::json_str(secret_pw))]),
  ) {
    Err(e) => if e.status != 409 { panic("expected 409 when browser unavailable, got " + e.status.to_string()) }
    Ok(_) => panic("signins.fill must refuse before storing plaintext password when browser unavailable")
  }
  if rt.held_cred_count() != 0 {
    panic("plaintext password MUST NOT be stored in memory on fail-closed refusal!")
  }

  // 3. With live browser & tab, `signins.fill` accepts, queues async CDP drive, and `tick_with_port` drives it to `left`
  browser_avail[0] = true
  tab_live[0] = true
  let actor = agents.hub.ensure_actor("s-1", "claude")
  let _ = actor.submit_input("human initial")
  match (api.admin.host.call)(
    "signins.fill",
    req_alice,
    ["g_ask1"],
    base_codec::json_obj([
      ("username", base_codec::json_str("alice")),
      ("password", base_codec::json_str(secret_pw)),
      ("keep", base_codec::json_bool(true)),
    ]),
  ) {
    Ok(_) => ()
    Err(e) => panic("signins.fill with live tab should succeed: " + e.message)
  }
  if rt.held_cred_count() != 1 || rt.pending_fill_count() != 1 {
    panic("expected 1 held cred and 1 pending fill")
  }
  let driven = rt.tick_with_port(store_port, now_cell[0] + 100L)
  if driven != 1 || !filled_pw_seen[0] {
    panic("expected async CDP autofill to run and type password")
  }
  if typed_origins.length() == 0 || typed_origins[0] != "https://github.com" {
    panic("expected origin-bound CDP autofill on https://github.com")
  }

  // 4. Verify `signin_asks.body` preserved ALL unknown/existing fields AND zero plaintext password leaked!
  let (st_after, body_after) = match mem.asks.get("g_ask1") {
    Some((_, s, b)) => (s, b)
    None => panic("missing g_ask1 after fill")
  }
  if st_after != "left" {
    panic("expected status='left' after form left login, got " + st_after)
  }
  if body_after.contains(secret_pw) {
    panic("CRITICAL: plaintext password leaked into signin_asks!")
  }
  if !body_after.contains("keep-me-said")
  || !body_after.contains("req-save-99")
  || !body_after.contains("preserve-me-123")
  || !body_after.contains("\"keep\":true") {
    panic("signin_asks.body lost preserved fields: " + body_after)
  }

  // 5. Verify internal notice was queued on `pending_internal_notices` (NOT blocking Running human Steer!)
  if actor.pending_internal_notices.length() == 0 {
    panic("expected internal notice enqueued on SessionActor::pending_internal_notices")
  }
  let steer_res = actor.submit_input("urgent human steer")
  if !(steer_res is station_sessions::InputRoute::Steer) {
    panic("human Steer must not be blocked by internal notice")
  }

  // 6. Verify 15-minute `SIGNIN_HELD_MS` TTL purges in-memory credentials automatically
  let _ = rt.tick_with_port(store_port, now_cell[0] + 100L + SIGNIN_HELD_MS + 1L)
  if rt.held_cred_count() != 0 {
    panic("15-min HELD_MS TTL did not purge in-memory credentials")
  }

  // 7. `signins.deny` closes card (`closed_cards` + card_edits) and emits zero plaintext
  match (api.admin.host.call)(
    "signins.deny",
    make_test_api_req_as("POST", "/browser/sign-ins/g_ask1/deny", alice),
    ["g_ask1"],
    base_codec::json_obj([]),
  ) {
    Ok(_) => ()
    Err(e) => panic("signins.deny failed: " + e.message)
  }
  if mem.closed_cards.length() != 1 || mem.closed_cards[0].0 != 500L || mem.closed_cards[0].1 != "card-1" {
    panic("expected closed_cards entry for (500, card-1)")
  }
  for i in 0..<mem.card_edits.length() {
    if mem.card_edits[i].2.contains(secret_pw) {
      panic("CRITICAL: plaintext password leaked into card_edits!")
    }
  }
  for i in 0..<mem.notices.length() {
    if mem.notices[i].1.contains(secret_pw) {
      panic("CRITICAL: plaintext password leaked into notices!")
    }
  }

  // 8. 24h expiry check on a pending ask
  let expired_at_sec = (base_ms / 1000L) - SIGNIN_PENDING_SECS - 10L
  let exp_body = base_codec::json_obj([
    ("id", base_codec::json_str("g_exp1")),
    ("session", base_codec::json_str("s-1")),
    ("owner", base_codec::json_str("alice@example.com")),
    ("site", base_codec::json_str("github.com")),
    ("tab", base_codec::json_str("tab-gh")),
    ("at", base_codec::json_int64(expired_at_sec)),
    ("status", base_codec::json_str("pending")),
  ])
  mem.asks.set("g_exp1", ("s-1", "pending", base_codec::json_stringify(exp_body)))
  match (api.admin.host.call)(
    "signins.self",
    make_test_api_req_as("POST", "/browser/sign-ins/g_exp1/self", alice),
    ["g_exp1"],
    base_codec::json_obj([("done", base_codec::json_bool(false))]),
  ) {
    Err(e) => if e.status != 409 || !e.message.contains("day undecided") {
      panic("expected 409 expired error, got " + e.message)
    }
    Ok(_) => panic("expired signin ask must be rejected")
  }
}
