// Production OS adapter for `station_devices`:
// - `TerminalsOsRuntime`: real OS child processes (`station_sys::proc_spawn` / `write_stdin` /
//   `kill` / `close`) wired into `TerminalsRegistry` + `VtTerminal` with bounded scrollback,
//   resize, and clean process-group exit reclamation.
// - `LoginsOsRuntime`: real CLI login execution via `station_sys::proc_spawn` (with
//   `keychain_out_of_git` env scrubbing), stdout/stderr feeding `LoginRun::output` for URL/device
//   code extraction, callback validation, deadline timeout kill, and cancellation cleanup.
// - `AdbOsRunner`: real `adb` subprocess execution via `station_sys::proc_spawn` + `host_shim::wait`
//   with hard timeout and process-group kill cleanup.
// - `DevicesOsRuntime`: wires `DeviceRegistry`, `PhoneGrants`, `PhoneDisplays`, `GrantServers`,
//   `AirPlayPairingManager`, `AndroidTvPairingManager` transport bridge, and aggregated
//   `DeviceSources` view across local station, rigs, and lent phones.

import "base_codec"
import "host_shim"
import "station_devices"
import "station_sys"

pub let DEVICES_DEFAULT_SCROLLBACK : Int = 262144
pub let DEVICES_DEFAULT_VT_SCROLLBACK : Int = 1000
pub let DEVICES_DEFAULT_ADB_TIMEOUT_MS : Int64 = 15000L

fn dev_bytes_to_str(b : Bytes) -> String {
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

fn dev_concat_bytes(parts : Array[Bytes]) -> Bytes {
  let mut total = 0
  for i in 0..<parts.length() {
    total = total + parts[i].length()
  }
  let out = Bytes::new(total)
  let mut pos = 0
  for i in 0..<parts.length() {
    let p = parts[i]
    for j in 0..<p.length() {
      out[pos] = p[j]
      pos = pos + 1
    }
  }
  out
}

fn dev_encode_env(pairs : Array[(String, String)]) -> Array[String] {
  let out : Array[String] = []
  for i in 0..<pairs.length() {
    let (k, v) = pairs[i]
    out.push(k + "=" + v)
  }
  out
}

// ---------------------------------------------------------------------------
// 1. Real OS Terminals Runtime (`TerminalsRegistry` + `VtTerminal` + `station_sys`)
// ---------------------------------------------------------------------------

struct LiveTerminalProc {
  term_id : String
  workspace : String
  child : station_sys::ChildProcess
  event_id : Int64
  vt : station_devices::VtTerminal
  mut exited : Bool
  mut stdout_eof : Bool
  mut stderr_eof : Bool
  mut exit_status : Option[station_devices::TerminalEnded]
}

pub struct TerminalsOsRuntime {
  pub registry : station_devices::TerminalsRegistry
  by_id : Map[String, LiveTerminalProc]
  by_event : Map[Int64, String]
  mut next_event_id : Int64
}

pub fn TerminalsOsRuntime::new(
  home : String,
  scroll_max_bytes : Int = DEVICES_DEFAULT_SCROLLBACK,
) -> TerminalsOsRuntime {
  let reg = station_devices::TerminalsRegistry::new(home, scroll_max_bytes)
  reg.set_offered(true)
  TerminalsOsRuntime::{
    registry: reg,
    by_id: Map::new(),
    by_event: Map::new(),
    next_event_id: 800001L,
  }
}

pub fn TerminalsOsRuntime::live_count(self : TerminalsOsRuntime) -> Int {
  self.by_id.length()
}

/// Open a terminal session in `TerminalsRegistry` and spawn a real OS process via
/// `station_sys::proc_spawn` (new process group, piped stdin/stdout/stderr).
pub fn TerminalsOsRuntime::spawn_terminal(
  self : TerminalsOsRuntime,
  asked : station_devices::TerminalAsked,
  by : String,
  by_email : Option[String],
  workspace : String,
  program : String,
  args : Array[String],
  env : Option[Array[String]],
  now_ms : Int64,
) -> Result[station_devices::TerminalSession, String] {
  let sess = match self.registry.open(asked, by, by_email, workspace, false, None, now_ms) {
    Ok(s) => s
    Err(r) => return Err("terminal open refused (" + r.status.to_string() + "): " + r.message)
  }
  let ev_id = self.next_event_id
  self.next_event_id = self.next_event_id + 1L
  let opts = station_sys::SpawnOptions::{
    program: program,
    args: args,
    env: env,
    cwd: sess.cwd,
    new_pgid: true,
    strip_malloc_space_efficient: true,
    pipe_stdin: true,
    pipe_stdout: true,
    pipe_stderr: true,
  }
  let child = match station_sys::proc_spawn(ev_id, opts) {
    Ok(c) => c
    Err(e) => {
      self.registry.mark_ended(sess.id, Some(station_devices::TerminalEnded::{ code: Some(-1), signal: None }))
      return Err("spawn terminal process failed: " + e)
    }
  }
  let vt = station_devices::VtTerminal::new(sess.size.cols, sess.size.rows, DEVICES_DEFAULT_VT_SCROLLBACK)
  self.by_id.set(
    sess.id,
    LiveTerminalProc::{
      term_id: sess.id,
      workspace: workspace,
      child: child,
      event_id: ev_id,
      vt: vt,
      exited: false,
      stdout_eof: false,
      stderr_eof: false,
      exit_status: None,
    },
  )
  self.by_event.set(ev_id, sess.id)
  Ok(sess)
}

pub fn TerminalsOsRuntime::write_stdin(
  self : TerminalsOsRuntime,
  term_id : String,
  data : Bytes,
) -> Result[Unit, String] {
  match self.by_id.get(term_id) {
    None => Err("terminal not running: " + term_id)
    Some(p) => {
      if p.exited {
        return Err("terminal already exited: " + term_id)
      }
      if p.child.write_stdin(data) {
        Ok(())
      } else {
        Err("write_stdin failed for terminal: " + term_id)
      }
    }
  }
}

pub fn TerminalsOsRuntime::close_stdin(self : TerminalsOsRuntime, term_id : String) -> Bool {
  match self.by_id.get(term_id) {
    Some(p) => p.child.close_stdin()
    None => false
  }
}

pub fn TerminalsOsRuntime::resize(
  self : TerminalsOsRuntime,
  term_id : String,
  cols : Int,
  rows : Int,
) -> Result[Unit, String] {
  if !station_devices::is_valid_terminal_size(cols, rows) {
    return Err("invalid terminal size")
  }
  match self.by_id.get(term_id) {
    None => Err("terminal not found: " + term_id)
    Some(p) => {
      p.vt.resize(cols, rows)
      match self.registry.get(term_id, p.workspace) {
        Some(s) => s.size = station_devices::TerminalSize::{ cols: cols, rows: rows }
        None => ()
      }
      Ok(())
    }
  }
}

pub fn TerminalsOsRuntime::screen(
  self : TerminalsOsRuntime,
  term_id : String,
) -> Option[station_devices::VtScreen] {
  match self.by_id.get(term_id) {
    Some(p) => Some(p.vt.screen())
    None => None
  }
}

/// Process a `HostEvent::Sys(event_id, payload)` decoded into `station_sys::SysEvent`.
/// Returns `true` if `event_id` belonged to a managed terminal.
pub fn TerminalsOsRuntime::handle_sys_event(
  self : TerminalsOsRuntime,
  event_id : Int64,
  ev : station_sys::SysEvent,
  now_ms : Int64,
) -> Bool {
  let term_id = match self.by_event.get(event_id) {
    Some(id) => id
    None => return false
  }
  let p = match self.by_id.get(term_id) {
    Some(proc) => proc
    None => return true
  }
  match ev {
    station_sys::SysEvent::ProcStdout(bytes) => {
      p.vt.write_bytes(bytes)
      match self.registry.get(term_id, p.workspace) {
        Some(s) => {
          let _ = s.on_output(bytes, now_ms)
        }
        None => ()
      }
    }
    station_sys::SysEvent::ProcStderr(bytes) => {
      p.vt.write_bytes(bytes)
      match self.registry.get(term_id, p.workspace) {
        Some(s) => {
          let _ = s.on_output(bytes, now_ms)
        }
        None => ()
      }
    }
    station_sys::SysEvent::ProcStdoutEof => {
      p.stdout_eof = true
    }
    station_sys::SysEvent::ProcStderrEof => {
      p.stderr_eof = true
    }
    station_sys::SysEvent::ProcExit(status) => {
      p.exited = true
      let sig_opt : Option[String] = if status.signal != 0 {
        Some(status.signal_name)
      } else {
        None
      }
      let code_opt : Option[Int] = if status.signal == 0 {
        Some(status.code)
      } else {
        None
      }
      p.exit_status = Some(station_devices::TerminalEnded::{ code: code_opt, signal: sig_opt })
    }
    _ => ()
  }
  if p.exited && p.stdout_eof && p.stderr_eof {
    self.registry.mark_ended(term_id, p.exit_status)
    let _ = p.child.close()
    self.by_event.remove(event_id)
  }
  true
}

/// Kill a terminal's process group cleanly and close its handle.
pub fn TerminalsOsRuntime::kill_terminal(self : TerminalsOsRuntime, term_id : String) -> Bool {
  match self.by_id.get(term_id) {
    None => false
    Some(p) => {
      self.by_id.remove(term_id)
      self.by_event.remove(p.event_id)
      if !p.exited {
        let _ = p.child.kill(station_sys::SIG_TERM, true)
        let _ = p.child.kill(station_sys::SIG_KILL, true)
        let _ = p.child.close()
      }
      let _ = self.registry.end_terminal(term_id, p.workspace)
      true
    }
  }
}

pub fn TerminalsOsRuntime::stop_all(self : TerminalsOsRuntime) -> Unit {
  let ids = self.by_id.keys()
  for i in 0..<ids.length() {
    let _ = self.kill_terminal(ids[i])
  }
}

// ---------------------------------------------------------------------------
// 2. Real OS Logins Runtime (`LoginsManager` + `station_sys::proc_spawn`)
// ---------------------------------------------------------------------------

struct LiveLoginProc {
  login_id : String
  child : station_sys::ChildProcess
  event_id : Int64
  mut exited : Bool
  mut stdout_eof : Bool
  mut stderr_eof : Bool
  mut exit_code : Option[Int]
  mut exit_sig : Option[String]
}

pub struct LoginsOsRuntime {
  pub manager : station_devices::LoginsManager
  by_id : Map[String, LiveLoginProc]
  by_event : Map[Int64, String]
  mut next_event_id : Int64
}

pub fn LoginsOsRuntime::new(pages : Option[station_devices::LoginPages]) -> LoginsOsRuntime {
  LoginsOsRuntime::{
    manager: station_devices::LoginsManager::new(pages),
    by_id: Map::new(),
    by_event: Map::new(),
    next_event_id: 850001L,
  }
}

pub fn LoginsOsRuntime::live_count(self : LoginsOsRuntime) -> Int {
  self.by_id.length()
}

/// Start a CLI login through `LoginsManager::start` and spawn its real OS command via
/// `station_sys::proc_spawn` with `keychain_out_of_git` environment scrubbing.
pub fn LoginsOsRuntime::start_login(
  self : LoginsOsRuntime,
  command_line : String,
  starter : station_devices::LoginStarter,
  cwd : String,
  env_pairs : Array[(String, String)],
  now_ms : Int64,
  by_code_line : Option[String] = None,
  paste_on_open : Bool = false,
) -> Result[station_devices::LoginView, String] {
  let view = match self.manager.start(command_line, starter, by_code_line, paste_on_open, now_ms) {
    Ok(v) => v
    Err(r) => return Err("login start refused (" + r.status.to_string() + "): " + r.message)
  }
  if view.command.length() == 0 {
    return Err("empty login command")
  }
  let program = view.command[0]
  let args : Array[String] = []
  for i in 1..<view.command.length() {
    args.push(view.command[i])
  }
  let clean_env = dev_encode_env(station_devices::keychain_out_of_git(env_pairs))
  let ev_id = self.next_event_id
  self.next_event_id = self.next_event_id + 1L
  let opts = station_sys::SpawnOptions::{
    program: program,
    args: args,
    env: if clean_env.length() > 0 { Some(clean_env) } else { None },
    cwd: cwd,
    new_pgid: true,
    strip_malloc_space_efficient: true,
    pipe_stdin: true,
    pipe_stdout: true,
    pipe_stderr: true,
  }
  let child = match station_sys::proc_spawn(ev_id, opts) {
    Ok(c) => c
    Err(e) => {
      match self.manager.get_run(view.id) {
        Some(run) => run.on_exit(Some(-1), None, now_ms)
        None => ()
      }
      return Err("spawn login command failed: " + e)
    }
  }
  self.by_id.set(
    view.id,
    LiveLoginProc::{
      login_id: view.id,
      child: child,
      event_id: ev_id,
      exited: false,
      stdout_eof: false,
      stderr_eof: false,
      exit_code: None,
      exit_sig: None,
    },
  )
  self.by_event.set(ev_id, view.id)
  Ok(view)
}

/// Flush pending stdin writes queued on `LoginRun` into the live child process.
pub fn LoginsOsRuntime::flush_writes(self : LoginsOsRuntime, login_id : String) -> Int {
  let run = match self.manager.get_run(login_id) {
    Some(r) => r
    None => return 0
  }
  let proc = match self.by_id.get(login_id) {
    Some(p) => p
    None => return 0
  }
  if proc.exited {
    return 0
  }
  let writes = run.take_writes()
  let mut sent = 0
  for i in 0..<writes.length() {
    if proc.child.write_stdin(writes[i].to_bytes()) {
      sent = sent + 1
    }
  }
  sent
}

/// Process a `station_sys::SysEvent` for a running login subprocess.
/// Feeds stdout/stderr into `LoginRun::output` (extracting URLs & codes), flushes any stdin
/// responses, and reaps the handle on `ProcExit`.
pub fn LoginsOsRuntime::handle_sys_event(
  self : LoginsOsRuntime,
  event_id : Int64,
  ev : station_sys::SysEvent,
  now_ms : Int64,
) -> Bool {
  let login_id = match self.by_event.get(event_id) {
    Some(id) => id
    None => return false
  }
  let proc = match self.by_id.get(login_id) {
    Some(p) => p
    None => return true
  }
  let run = match self.manager.get_run(login_id) {
    Some(r) => r
    None => return true
  }
  match ev {
    station_sys::SysEvent::ProcStdout(bytes) => {
      run.output(dev_bytes_to_str(bytes))
      let _ = self.flush_writes(login_id)
    }
    station_sys::SysEvent::ProcStderr(bytes) => {
      run.output(dev_bytes_to_str(bytes))
      let _ = self.flush_writes(login_id)
    }
    station_sys::SysEvent::ProcStdoutEof => {
      proc.stdout_eof = true
    }
    station_sys::SysEvent::ProcStderrEof => {
      proc.stderr_eof = true
    }
    station_sys::SysEvent::ProcExit(status) => {
      proc.exited = true
      proc.exit_sig = if status.signal != 0 { Some(status.signal_name) } else { None }
      proc.exit_code = if status.signal == 0 { Some(status.code) } else { None }
    }
    _ => ()
  }
  if proc.exited && proc.stdout_eof && proc.stderr_eof {
    let _ = run.on_settled(None)
    run.on_exit(proc.exit_code, proc.exit_sig, now_ms)
    let _ = proc.child.close()
    self.by_event.remove(event_id)
    self.by_id.remove(login_id)
  }
  true
}

/// Validate and relay an incoming OAuth loopback callback for `login_id`.
pub fn LoginsOsRuntime::handle_callback(
  self : LoginsOsRuntime,
  login_id : String,
  cb : station_devices::LoginCallback,
) -> Result[String, String] {
  let run = match self.manager.get_run(login_id) {
    Some(r) => r
    None => return Err("unknown login: " + login_id)
  }
  match station_devices::check_callback(run, cb) {
    Err(r) => Err("callback refused (" + r.status.to_string() + "): " + r.message)
    Ok(loopback) => {
      run.relayed_now()
      Ok(loopback.host + ":" + loopback.port.to_string() + loopback.path)
    }
  }
}

/// Cancel an active login, killing its process group and closing its handle.
pub fn LoginsOsRuntime::cancel_login(
  self : LoginsOsRuntime,
  login_id : String,
  by : Option[station_devices::LoginPerson],
  now_ms : Int64,
) -> Result[station_devices::LoginView, String] {
  match self.by_id.get(login_id) {
    Some(p) => {
      self.by_id.remove(login_id)
      self.by_event.remove(p.event_id)
      if !p.exited {
        let _ = p.child.kill(station_sys::SIG_TERM, true)
        let _ = p.child.kill(station_sys::SIG_KILL, true)
        let _ = p.child.close()
      }
    }
    None => ()
  }
  match self.manager.cancel(login_id, by, now_ms) {
    Ok(v) => Ok(v)
    Err(r) => Err("cancel login refused: " + r.message)
  }
}

/// Expire timed-out login runs and kill their underlying child processes.
pub fn LoginsOsRuntime::tick(self : LoginsOsRuntime, now_ms : Int64) -> Array[String] {
  let expired : Array[String] = []
  let ids = self.by_id.keys()
  for i in 0..<ids.length() {
    let lid = ids[i]
    match self.manager.get_run(lid) {
      Some(run) => {
        if run.active() && now_ms >= run.expires_at {
          run.on_timeout(now_ms)
          match self.by_id.get(lid) {
            Some(p) => {
              self.by_id.remove(lid)
              self.by_event.remove(p.event_id)
              if !p.exited {
                let _ = p.child.kill(station_sys::SIG_TERM, true)
                let _ = p.child.kill(station_sys::SIG_KILL, true)
                let _ = p.child.close()
              }
            }
            None => ()
          }
          expired.push(lid)
        }
      }
      None => ()
    }
  }
  expired
}

pub fn LoginsOsRuntime::stop_all(self : LoginsOsRuntime, now_ms : Int64) -> Unit {
  let ids = self.by_id.keys()
  for i in 0..<ids.length() {
    let _ = self.cancel_login(ids[i], None, now_ms)
  }
}

// ---------------------------------------------------------------------------
// 3. Real `adb` Subprocess Runner (with timeout & process-group cleanup)
// ---------------------------------------------------------------------------

pub struct AdbExecResult {
  pub exit_code : Int
  pub stdout : Bytes
  pub stderr : Bytes
  pub timed_out : Bool
}

/// Run an `adb` (or custom executable) command via `station_sys::proc_spawn` with hard deadline
/// and guaranteed process-group kill + handle close on completion or timeout.
pub fn run_adb_command_os(
  program : String,
  args : Array[String],
  cwd : String,
  timeout_ms : Int64 = DEVICES_DEFAULT_ADB_TIMEOUT_MS,
  event_id : Int64 = 890001L,
  now_fn : () -> Int64 = host_shim::now_ms,
) -> Result[AdbExecResult, String] {
  let eff_timeout = if timeout_ms > 0L { timeout_ms } else { DEVICES_DEFAULT_ADB_TIMEOUT_MS }
  let opts = station_sys::SpawnOptions::{
    program: program,
    args: args,
    env: None,
    cwd: cwd,
    new_pgid: true,
    strip_malloc_space_efficient: true,
    pipe_stdin: false,
    pipe_stdout: true,
    pipe_stderr: true,
  }
  let child = match station_sys::proc_spawn(event_id, opts) {
    Ok(c) => c
    Err(e) => return Err("adb proc_spawn failed: " + e)
  }
  let out_chunks : Array[Bytes] = []
  let err_chunks : Array[Bytes] = []
  let deadline = now_fn() + eff_timeout
  let mut exit_code : Option[Int] = None
  let mut stdout_eof = false
  let mut stderr_eof = false
  let mut timed_out = false

  while exit_code is None || !stdout_eof || !stderr_eof {
    let rem = deadline - now_fn()
    if rem <= 0L {
      timed_out = true
      let _ = child.kill(station_sys::SIG_TERM, true)
      let _ = child.kill(station_sys::SIG_KILL, true)
      break
    }
    let slice = if rem > 200L { 200L } else { rem }
    match host_shim::wait(slice) {
      Some(host_shim::HostEvent::Sys(ev_id, payload)) => {
        if ev_id == event_id {
          match station_sys::decode_sys_event(payload) {
            Some(station_sys::SysEvent::ProcStdout(b)) => out_chunks.push(b)
            Some(station_sys::SysEvent::ProcStderr(b)) => err_chunks.push(b)
            Some(station_sys::SysEvent::ProcStdoutEof) => stdout_eof = true
            Some(station_sys::SysEvent::ProcStderrEof) => stderr_eof = true
            Some(station_sys::SysEvent::ProcExit(st)) => exit_code = Some(st.code)
            _ => ()
          }
        }
      }
      _ => ()
    }
  }
  let _ = child.close()
  Ok(
    AdbExecResult::{
      exit_code: match exit_code {
        Some(c) => c
        None => -1
      },
      stdout: dev_concat_bytes(out_chunks),
      stderr: dev_concat_bytes(err_chunks),
      timed_out: timed_out,
    },
  )
}

// ---------------------------------------------------------------------------
// 4. Unified `DevicesOsRuntime` + `DeviceSources` Aggregated View
// ---------------------------------------------------------------------------

pub enum DeviceSourceOrigin {
  LocalStation
  Rig(String)
  LentPhone(String)
}

pub struct AggregatedDeviceView {
  pub id : String
  pub name : String
  pub kind : station_devices::DeviceKind
  pub origin : DeviceSourceOrigin
  pub requires_approval : Bool
  pub active_grant_id : Option[String]
}

pub struct DevicesOsRuntime {
  pub registry : station_devices::DeviceRegistry
  pub phone_grants : station_devices::PhoneGrants
  pub phone_displays : station_devices::PhoneDisplays
  pub grant_servers : station_devices::GrantServers
  pub airplay_pairing : station_devices::AirPlayPairingManager
  pub android_tv_pairing : station_devices::AndroidTvPairingManager
  rig_devices : Map[String, Array[station_devices::KeptDevice]]
}

pub fn DevicesOsRuntime::new(
  display_idle_ms : Int64 = 300000L,
  pairing_ttl_ms : Int64 = 180000L,
) -> DevicesOsRuntime {
  DevicesOsRuntime::{
    registry: station_devices::DeviceRegistry::new(),
    phone_grants: station_devices::PhoneGrants::new(),
    phone_displays: station_devices::PhoneDisplays::new(display_idle_ms),
    grant_servers: station_devices::GrantServers::new(),
    airplay_pairing: station_devices::AirPlayPairingManager::new(pairing_ttl_ms),
    android_tv_pairing: station_devices::AndroidTvPairingManager::new(pairing_ttl_ms),
    rig_devices: Map::new(),
  }
}

pub fn DevicesOsRuntime::set_rig_devices(
  self : DevicesOsRuntime,
  rig_station : String,
  devices : Array[station_devices::KeptDevice],
) -> Unit {
  self.rig_devices.set(rig_station, devices)
}

/// Build the aggregated `DeviceSources` view for `workspace` and `session` across:
/// 1) whole-station devices (`WholeStationOpen`),
/// 2) rig-attached devices (`RigApprovalRequired`),
/// 3) lent Android phones (`PhoneApprovalRequired`, showing active grant if held & unexpired).
pub fn DevicesOsRuntime::aggregate_sources(
  self : DevicesOsRuntime,
  workspace : String,
  session : String,
  now_ms : Int64,
  rig_open_override : Bool = false,
) -> Array[AggregatedDeviceView] {
  let out : Array[AggregatedDeviceView] = []
  let local = self.registry.of(workspace)
  for i in 0..<local.length() {
    let d = local[i].device
    out.push(
      AggregatedDeviceView::{
        id: d.id,
        name: d.name,
        kind: d.kind,
        origin: DeviceSourceOrigin::LocalStation,
        requires_approval: station_devices::device_requires_approval(
          station_devices::DeviceAccessPolicy::WholeStationOpen,
          rig_open_override,
        ),
        active_grant_id: None,
      },
    )
  }
  let rigs = self.rig_devices.keys()
  for i in 0..<rigs.length() {
    let rig_name = rigs[i]
    match self.rig_devices.get(rig_name) {
      Some(devs) => {
        for j in 0..<devs.length() {
          if devs[j].ws == workspace {
            let d = devs[j].device
            out.push(
              AggregatedDeviceView::{
                id: d.id,
                name: d.name,
                kind: d.kind,
                origin: DeviceSourceOrigin::Rig(rig_name),
                requires_approval: station_devices::device_requires_approval(
                  station_devices::DeviceAccessPolicy::RigApprovalRequired,
                  rig_open_override,
                ),
                active_grant_id: None,
              },
            )
          }
        }
      }
      None => ()
    }
  }
  let held = self.phone_grants.held(session, now_ms)
  for i in 0..<held.length() {
    let r = held[i]
    if r.workspace == workspace {
      out.push(
        AggregatedDeviceView::{
          id: "phone:" + r.owner,
          name: r.owner + " phone",
          kind: station_devices::DeviceKind::Adb,
          origin: DeviceSourceOrigin::LentPhone(r.owner),
          requires_approval: station_devices::device_requires_approval(
            station_devices::DeviceAccessPolicy::PhoneApprovalRequired,
            false,
          ),
          active_grant_id: Some(r.id),
        },
      )
    }
  }
  out
}

/// Encode an Android TV pairing request frame ready to send over a TLS/TCP transport.
pub fn encode_android_tv_pairing_start_frame(service_name : String, client_name : String) -> Bytes {
  station_devices::atv_frame_message(station_devices::encode_pairing_request(service_name, client_name))
}

/// Encode an Android TV remote key-inject frame ready to send over a TLS/TCP transport.
pub fn encode_android_tv_key_frame(key_name : String, direction : Int) -> Result[Bytes, String] {
  match station_devices::resolve_android_key_code(key_name) {
    Some(code) => Ok(station_devices::atv_frame_message(station_devices::encode_remote_key_inject(code, direction)))
    None => Err("unknown Android TV key: " + key_name)
  }
}

/// Stop and kill any tracked `GrantServers` ADB daemon for `grant_id`.
pub fn DevicesOsRuntime::stop_grant_server_os(self : DevicesOsRuntime, grant_id : String) -> Bool {
  match self.grant_servers.stop(grant_id) {
    None => false
    Some(srv) => {
      if srv.pid > 0 {
        let _ = station_sys::proc_kill(srv.pid, station_sys::SIG_TERM, false)
      }
      true
    }
  }
}

/// Periodic expiry sweep for AirPlay/AndroidTV pairing sessions and idle phone displays.
pub fn DevicesOsRuntime::tick_expiry(self : DevicesOsRuntime, now_ms : Int64) -> (Int, Int) {
  let ap_expired = self.airplay_pairing.expire_due(now_ms)
  let disp_expired = self.phone_displays.sweep_idle(now_ms, [])
  (ap_expired.length(), disp_expired.length())
}
