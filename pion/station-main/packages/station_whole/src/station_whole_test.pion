// Pure-Pion unit & integration test suite for `packages/station_whole` (runnable standalone via
// `pionc test --json --package station_whole`). Full native OS FFI verification (`os_drive_fs()`
// on real disk files, OS CSPRNG `os_uuid_v4`, SQLite `Store::open`) lives in `whole_self_check()`.

import "base_codec"
import "crypto"
import "http1"
