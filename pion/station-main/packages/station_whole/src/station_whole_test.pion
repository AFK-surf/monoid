// Comprehensive unit tests for `packages/station_whole` production OS adapters
// (`drive_fs_os`, `drivers_os`, `thumb_os`), runnable standalone via
// `pionc test --json --package station_whole`.
// Real-disk FFI probes (`run_drive_fs_os_probe_selftest`, `station_sys_test.c` FIFO/EACCES/4GiB)
// are additionally verified natively against `station_sys.o` and `libstillfail_shell.a`.

import "base_codec"
import "builders_core"
import "crypto"
import "host_shim"
import "station_drivers"
import "station_ops"
import "station_screens"

fn assert(cond : Bool) -> Unit {
  if !cond {
    panic("assertion failed")
  }
}

struct DetRng {
  mut counter : Int
}

fn DetRng::new() -> DetRng {
  DetRng::{ counter: 1 }
}

fn DetRng::bytes(self : DetRng, n : Int) -> Result[Bytes, String] {
  let out = Bytes::new(n)
  let mut pos = 0
  while pos < n {
    let seed = ("det-rng-" + self.counter.to_string()).to_bytes()
    self.counter = self.counter + 1
    let blk = crypto::sha256(seed)
    let mut i = 0
    while i < blk.length() && pos < n {
      out[pos] = blk[i]
      pos = pos + 1
      i = i + 1
    }
  }
  Ok(out)
}

test "drive_fs_os_opus_three_probe_gates_and_safe_ino_parsing" {
  let root = "/drive-root"
  let mem = station_screens::MemDriveFs::new()
  mem.put_dir(root)

  let stats = DriveProbeStats::new()
  let probed_fs = instrument_drive_fs(mem.fs(), stats)
  let drive = station_screens::Drive::new(
    probed_fs,
    [root],
    [],
    false,
    root,
    station_screens::TrashKind::Freedesktop,
  )

  // (a) Large file (128 KiB): range read of 64 bytes at offset 40960 must read <= 64 bytes.
  let big_size = 131072
  let big_data = Bytes::new(big_size)
  for i in 0..<big_size {
    big_data[i] = ((i * 31 + 7) & 0xFF) as Byte
  }
  mem.put_file(root + "/big.bin", big_data)

  match drive.read(root, "big.bin", 40960L, 64, false) {
    Ok((chunk, total_sz, _, _)) => {
      assert(chunk.length() == 64)
      assert(total_sz == big_size.to_int64())
      for i in 0..<64 {
        assert(chunk[i] == big_data[40960 + i])
      }
    }
    Err(e) => panic("drive.read failed: " + e.message)
  }
  assert(stats.total_bytes_read <= 64L)
  assert(stats.read_bytes_calls == 0)

  // (b) Chunked upload onto `.part` file: `.part` read count MUST be 0.
  // (c) Atomic finalize: `fsync` MUST occur strictly before `rename`.
  let c1 = "chunk-one-payload-0123456789".to_bytes()
  let c2 = "chunk-two-payload-abcdefghij".to_bytes()
  let total_up = (c1.length() + c2.length()).to_int64()
  let up_id = "upload-probe-0001"
  let now = 1700000000000L

  match drive.upload(root, "uploaded.bin", up_id, 0L, total_up, c1, true, false, now) {
    Ok(r1) => assert(r1.entry is None && r1.have == c1.length().to_int64())
    Err(e) => panic("upload chunk 1 failed: " + e.message)
  }
  match drive.upload(root, "uploaded.bin", up_id, c1.length().to_int64(), total_up, c2, true, false, now + 10L) {
    Ok(r2) => assert(r2.entry is Some(_) && r2.have == total_up)
    Err(e) => panic("upload chunk 2 failed: " + e.message)
  }

  assert(stats.part_read_calls == 0)
  assert(stats.part_bytes_read == 0L)
  assert(stats.sync_calls >= 1)
  assert(stats.rename_calls >= 1)
  assert(probe_sync_preceded_rename(stats, ".part", "uploaded.bin"))

  // Safe unsigned 64-bit inode parsing (exact bit-masking via full UInt64 arithmetic).
  assert(parse_ino_safe("123456789") == 123456789L)
  assert(parse_ino_safe("9223372036854775807") == 9223372036854775807L)
  assert(parse_ino_safe("9223372036854775808") == 0L)
  assert(parse_ino_safe("18446744073709551615") == 9223372036854775807L)

  // Error code mapping distinguishes ENOENT, EACCES, EISDIR, non-regular FIFO, EINVAL.
  assert(match map_sys_err(-2) { station_ops::FsErr::NotFound => true _ => false })
  assert(match map_sys_err(-3) { station_ops::FsErr::PermissionDenied(_) => true _ => false })
  assert(match map_sys_err(-4) { station_ops::FsErr::Other(m) => m == "EISDIR" _ => false })
  assert(match map_sys_err(-5) { station_ops::FsErr::Other(m) => m == "non-regular file" _ => false })
  assert(match map_sys_err(-6) { station_ops::FsErr::Other(m) => m == "EINVAL" _ => false })
}

test "drivers_os_uuid_v4_ts_parity_and_all_11_runtimes" {
  let rng = DetRng::new()
  let next_uuid = fn() -> String {
    match rng.bytes(16) {
      Ok(raw) => station_drivers::uuid_v4_from_bytes(raw)
      Err(_) => ""
    }
  }
  let seen : Map[String, Bool] = Map::new()
  for _ in 0..<32 {
    let id = next_uuid()
    assert(station_drivers::is_valid_uuid_v4(id))
    assert(seen.get(id) is None)
    seen.set(id, true)
  }

  // TS 1:1 parity for `node_exec`, `stub_dir` with uid, and `is_root`.
  assert(resolve_node_exec(None) == "node")
  assert(resolve_node_exec(Some("   ")) == "node")
  assert(resolve_node_exec(Some("/opt/stillfail/bin/node")) == "/opt/stillfail/bin/node")
  assert(resolve_stub_dir("/tmp", "/", "linux", 1000) == "/tmp/stillfail-no-keychain-1000")
  assert(resolve_stub_dir("/tmp", "/", "darwin", 501) == "/tmp/stillfail-no-keychain-501")
  assert(resolve_stub_dir("C:\\Temp", "\\", "win32", -1) == "C:\\Temp\\stillfail-no-keychain")

  let p_root = station_drivers::Profile::default("p-root", Some(station_drivers::RuntimeKind::Claude), "/root")
  let opts_root = open_options_with_deps(
    "s-root",
    p_root,
    "/root",
    "http://127.0.0.1:4761/mcp",
    "tok",
    "/data",
    "/assets",
    "stillfail-runner",
    "linux",
    "/root",
    "/tmp",
    0,
    0,
    Some("/usr/local/bin/node-custom"),
    fn(_p : String) -> Bool { true },
    next_uuid,
    [],
  )
  assert(opts_root.is_root)
  assert(opts_root.node_exec == "/usr/local/bin/node-custom")
  assert(opts_root.stub_dir == "/tmp/stillfail-no-keychain-0")

  let opts_win = open_options_with_deps(
    "s-win",
    p_root,
    "C:\\work",
    "http://127.0.0.1:4761/mcp",
    "tok",
    "C:\\data",
    "C:\\assets",
    "stillfail-runner.exe",
    "win32",
    "C:\\Users\\u",
    "C:\\Temp",
    -1,
    0,
    None,
    fn(_p : String) -> Bool { true },
    next_uuid,
    [],
  )
  assert(!opts_win.is_root)
  assert(opts_win.node_exec == "node")

  // All 10 CLI coding-agent runtimes + 11th ACP runtime.
  let runtimes = all_supported_runtimes()
  assert(runtimes.length() == 10)
  for i in 0..<runtimes.length() {
    let rt = runtimes[i]
    let prof = station_drivers::Profile::default("prof-" + i.to_string(), Some(rt), "/tmp/home")
    let opts = open_options_with_deps(
      "sess-" + i.to_string(),
      prof,
      "/tmp",
      "http://127.0.0.1:4761/mcp",
      "tok-secret-1234",
      "/tmp/data",
      "/tmp/assets",
      "stillfail-runner",
      "linux",
      "/home/tester",
      "/tmp",
      1000,
      1000,
      Some("/usr/local/bin/node"),
      fn(_p : String) -> Bool { true },
      next_uuid,
      [],
      sdk_dir=Some("/tmp/sdk"),
      copilot_token=Some("ghu_test_copilot_token"),
    )
    assert(!opts.is_root)
    match build_os_driver_launch(rt, opts) {
      Ok(spec) => assert(spec.program.length() > 0)
      Err(e) => panic("build_os_driver_launch failed for runtime " + i.to_string() + ": " + e)
    }
  }
  // 11th driver: ACP JSON-RPC framing + MCP server declaration
  let acp_frame = station_drivers::acp_rpc_frame("1", "initialize", base_codec::json_obj([]))
  assert(acp_frame.contains("\"initialize\""))
  let acp_mcp = station_drivers::acp_mcp_servers_json("http://127.0.0.1:4761/mcp", "tok-1")
  assert(acp_mcp.contains("127.0.0.1:4761/mcp"))
}

test "thumb_os_modes_hash_width_height_int64_small_bytes_and_async_mux" {
  // Missing both path and bytes -> error
  let bad_empty = ThumbRequest::{
    mode: ThumbMode::Hash,
    path: None,
    bytes: None,
    dir: None,
    max_width: None,
    max_height: None,
    min_short: None,
    max_long: None,
    quality: None,
    lossless: None,
    ratio: None,
    small_bytes: None,
    thumbhash: None,
  }
  assert(build_image_thumb_args(bad_empty) is Err(_))

  // Both path and bytes -> error
  let bad_both = ThumbRequest::{
    mode: ThumbMode::Thumb,
    path: Some("/tmp/a.png"),
    bytes: Some("png".to_bytes()),
    dir: None,
    max_width: None,
    max_height: None,
    min_short: None,
    max_long: None,
    quality: None,
    lossless: None,
    ratio: None,
    small_bytes: None,
    thumbhash: None,
  }
  assert(build_image_thumb_args(bad_both) is Err(_))

  // 64-bit smallBytes (> 2 GiB) preserved without Int32 narrowing
  let custom = ThumbRequest::{
    mode: ThumbMode::Custom,
    path: Some("/tmp/photo.jpg"),
    bytes: None,
    dir: None,
    max_width: Some(640),
    max_height: Some(480),
    min_short: Some(120),
    max_long: Some(1024),
    quality: Some(85),
    lossless: Some(false),
    ratio: Some(2),
    small_bytes: Some(5368709120L),
    thumbhash: Some(true),
  }
  match build_image_thumb_args(custom) {
    Ok(j) => {
      let s = base_codec::json_stringify(j)
      assert(s.contains("\"mode\":\"custom\""))
      assert(s.contains("\"maxWidth\":640"))
      assert(s.contains("\"quality\":85"))
      assert(s.contains("\"smallBytes\":5368709120"))
      assert(s.contains("\"thumbhash\":true"))
    }
    Err(e) => panic("custom thumb args failed: " + e)
  }

  // `mode: "hash"` response from `client/shell` returns `width` and `height` (no `originalWidth`).
  let hash_json = "{\"thumbhash\":\"1QcSHQRnh493V4dIh4eXh1h4kJUI\",\"width\":768,\"height\":320}"
  match parse_image_thumb_response(hash_json, None) {
    Ok(r) => match extract_thumbhash_info(r) {
      Some(info) => {
        assert(info.hash == "1QcSHQRnh493V4dIh4eXh1h4kJUI")
        assert(info.width == 768)
        assert(info.height == 320)
      }
      None => panic("extract_thumbhash_info returned None for Mode::Hash response")
    }
    Err(e) => panic("parse hash response failed: " + e)
  }

  // `mode: "custom"` + `thumbhash: true` returns BOTH resized `width`/`height` AND
  // `originalWidth`/`originalHeight`: `extract_thumbhash_info` MUST prefer `originalWidth`/`originalHeight`.
  let custom_hash_json = "{\"width\":16,\"height\":16,\"originalWidth\":768,\"originalHeight\":320,\"thumbhash\":\"1QcSHQRnh493V4dIh4eXh1h4kJUI\"}"
  match parse_image_thumb_response(custom_hash_json, None) {
    Ok(r) => match extract_thumbhash_info(r) {
      Some(info) => {
        assert(info.hash == "1QcSHQRnh493V4dIh4eXh1h4kJUI")
        assert(info.width == 768)
        assert(info.height == 320)
      }
      None => panic("extract_thumbhash_info returned None for Mode::Custom+thumbhash response")
    }
    Err(e) => panic("parse custom+hash response failed: " + e)
  }

  // `write_failed` preserves thumbhash + `originalWidth`/`originalHeight` fallback
  let resp_json = "{\"skipped\":true,\"reason\":\"write_failed\",\"writeError\":\"ENOSPC\",\"originalWidth\":800,\"originalHeight\":600,\"thumbhash\":\"abc123\"}"
  match parse_image_thumb_response(resp_json, None) {
    Ok(r) => {
      assert(r.skipped)
      assert(match r.reason { Some(s) => s == "write_failed" _ => false })
      assert(match r.write_error { Some(s) => s == "ENOSPC" _ => false })
      match extract_thumbhash_info(r) {
        Some(info) => assert(info.hash == "abc123" && info.width == 800 && info.height == 600)
        None => panic("expected fallback to originalWidth/originalHeight")
      }
    }
    Err(e) => panic("parse_image_thumb_response failed: " + e)
  }
  assert(parse_image_thumb_response("{\"error\":\"decode bomb\"}", None) is Err(_))

  // Non-blocking `ShellMux` async dispatch + `decode_image_thumb_done`
  let captured_ops : Array[String] = []
  let captured_args : Array[String] = []
  let transport = builders_core::MuxTransport::{
    call_async: fn(_id : Int64, op : String, json : String, _bytes : Option[Bytes]) -> Unit {
      captured_ops.push(op)
      captured_args.push(json)
    },
    call_sync: fn(_op : String, _json : String) -> String { "" },
    write_stdout_line: fn(_line : String) -> Bool { true },
    write_stdout_frame: fn(_hdr : Array[(String, base_codec::Json)], _payload : Bytes) -> Bool { true },
    now_ms: fn() -> Int64 { 1000L },
    wall_ms: fn() -> Int64 { 1700000000000L },
    wait: fn(_ms : Int64) -> Option[host_shim::HostEvent] { None },
  }
  let mux = builders_core::ShellMux::new(transport, start_stdin=false)
  let hash_req = ThumbRequest::for_path(ThumbMode::Hash, "/tmp/sample.png", None)
  match dispatch_image_thumb_mux(mux, 1, 9001, 42L, hash_req) {
    Ok(cid) => assert(cid > 0L)
    Err(e) => panic("dispatch_image_thumb_mux failed: " + e)
  }
  assert(captured_ops.length() == 1 && captured_ops[0] == "image.thumb")
  assert(captured_args[0].contains("\"mode\":\"hash\""))

  let done_ok = host_shim::ShellDone::{
    id: 1L,
    json: hash_json,
    error: "",
    bytes: None,
  }
  match decode_image_thumb_done(done_ok) {
    Ok(r) => match extract_thumbhash_info(r) {
      Some(info) => assert(info.width == 768 && info.height == 320)
      None => panic("decode_image_thumb_done missing thumbhash info")
    }
    Err(e) => panic("decode_image_thumb_done failed: " + e)
  }
  let done_err = host_shim::ShellDone::{
    id: 2L,
    json: "",
    error: "unsupported image format",
    bytes: None,
  }
  assert(decode_image_thumb_done(done_err) is Err(_))
}
