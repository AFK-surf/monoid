test "wave17c3b R3: vault.requests lock/owner boundary & cross-uses projection" {
  let (_, _, api, _, _, _, port) = make_mem_whole_api_fixture_full()
  let alice = w3b_owner("ws-main")
  let bob = w3b_member("ws-main")
  // Pending encrypted vault request without lock -> hidden even if member; save/browse/cross -> owner only
  (port.vault_plain.seed_request_for_test)(
    "ws-main",
    "req-enc",
    "s1",
    "pending",
    base_codec::json_obj([("id", base_codec::json_str("req-enc")), ("vault", base_codec::json_str("v_team")), ("owner", base_codec::json_str("owner@example.com"))]),
  )
  (port.vault_plain.seed_request_for_test)(
    "ws-main",
    "req-save",
    "s1",
    "pending",
    base_codec::json_obj([("id", base_codec::json_str("req-save")), ("vault", base_codec::json_str("v_team")), ("owner", base_codec::json_str("owner@example.com")), ("save", base_codec::json_bool(true))]),
  )
  match (api.admin.host.call)("vault.requests.get", make_test_api_req_as("GET", "/vault/requests", bob), [], base_codec::json_obj([])) {
    Ok(j) => {
      let s = base_codec::json_stringify(j)
      if s.contains("req-enc") || s.contains("req-save") {
        panic("bob must not see unlocked or alice's save request: " + s)
      }
    }
    Err(e) => panic("vault.requests.get failed: " + e.message)
  }
  match (api.admin.host.call)("vault.requests.get", make_test_api_req_as("GET", "/vault/requests", alice), [], base_codec::json_obj([])) {
    Ok(j) => {
      let s = base_codec::json_stringify(j)
      if s.contains("req-enc") {
        panic("unlocked encrypted vault request must be hidden: " + s)
      }
      if !s.contains("req-save") {
        panic("owner alice must see her save request: " + s)
      }
    }
    Err(e) => panic("vault.requests.get alice failed: " + e.message)
  }
  // Cross-uses: cross: null excluded, real cross object projects request/sourceWorkspace/sourceVault
  (port.vault_plain.seed_request_for_test)(
    "ws-main",
    "req-null-cross",
    "s1",
    "granted",
    base_codec::json_obj([
      ("id", base_codec::json_str("req-null-cross")),
      ("owner", base_codec::json_str("owner@example.com")),
      ("cross", base_codec::json_null()),
    ]),
  )
  (port.vault_plain.seed_request_for_test)(
    "ws-main",
    "req-real-cross",
    "s1",
    "granted",
    base_codec::json_obj([
      ("id", base_codec::json_str("req-real-cross")),
      ("vault", base_codec::json_str("v-real")),
      ("owner", base_codec::json_str("owner@example.com")),
      ("item", base_codec::json_str("i_1")),
      ("cross", base_codec::json_obj([
        ("workspace", base_codec::json_str("ws-src")),
        ("workspaceName", base_codec::json_str("Src")),
        ("vaultName", base_codec::json_str("MyVault")),
      ])),
    ]),
  )
  match (api.admin.host.call)("vault.cross-uses.get", make_test_api_req_as("GET", "/vault/cross-uses", alice), [], base_codec::json_obj([])) {
    Ok(j) => {
      let s = base_codec::json_stringify(j)
      if s.contains("req-null-cross") {
        panic("cross: null must be excluded: " + s)
      }
      if !s.contains("\"request\":\"req-real-cross\"") || !s.contains("\"sourceWorkspace\":\"ws-src\"") || !s.contains("\"sourceVault\":\"v-real\"") {
        panic("cross-uses missing projected fields: " + s)
      }
    }
    Err(e) => panic("vault.cross-uses.get failed: " + e.message)
  }
}

test "wave17c3b R3: MCP URL normalization and arbitrary-delimiter redaction" {
  let (_, _, api, _, mem_fs, _, _) = make_mem_whole_api_fixture_full()
  let owner = w3b_owner("ws-main")
  let seed = "{\"mcpServers\":{\"s1\":{\"type\":\"http\",\"url\":\"  https://user:topsecret@api.example.com/v1\\t \"}}}"
  let _ = mem_fs.put_text("/tmp/w17c2-api-test/config.json", seed, 384)
  match (api.admin.host.call)("mcpServers.get", make_test_api_req_as("GET", "/mcp-servers", owner), [], base_codec::json_obj([])) {
    Ok(j) => {
      let s = base_codec::json_stringify(j)
      if s.contains("topsecret") || s.contains("user:") {
        panic("mcpServers.get leaked userinfo from whitespace-padded URL: " + s)
      }
      if !s.contains("https://api.example.com/v1") {
        panic("mcpServers.get did not normalize URL: " + s)
      }
    }
    Err(e) => panic("mcpServers.get failed: " + e.message)
  }
  let redacted = station_tools::redact_error_urls("bad url \"https://u:p,1;2%20+x@host.example/x\" and (http://a:b@other.example)")
  if redacted.contains("u:p") || redacted.contains("a:b@") {
    panic("redact_error_urls leaked userinfo in delimited URLs: " + redacted)
  }
  if !redacted.contains("\"https://host.example/x\"") || !redacted.contains("(http://other.example)") {
    panic("redact_error_urls damaged surrounding delimiters: " + redacted)
  }
}
