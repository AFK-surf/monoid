// Wave 17D-3 pure-Pion unit tests (zero C FFI linkage; real SQLite + real FS tests run via
// `run_w17d3_sqlite_selftest` in `--smoke-w17c3a-sqlite` and `pion-station-whole-e2e.test.ts`):
// - `screens.browser.open`: strict URL policy (file:/javascript:/private/loopback/metadata), ScreenHub registration & focus, 403 read-only, honest 501 unhooked
// - `signins.fill` / `signins.self` / `signins.deny`: honest 501 unhooked, 403 read-only, viewer enrichment & hooked dispatch
// - `hub.session.retry` / `hub.session.compact`: honest 501 unhooked, validation (404 cross-ws, 400 bad thread/seq), hooked dispatch & session change notify
// - `projects.rename` / `projects.merge`: honest 501 unhooked, validation, `migrate_projects_jsonl_rename_merge` & `rewrite_preset_projects_json`
// - `links.preview`: strict SSRF defense (literal/IPv4/IPv6/non-canonical/metadata/userinfo/scheme, DNS IP check, multi-hop redirect re-verification), HTML head parsing, honest 501 unhooked
// - `feedback.report`: honest 501 unhooked, validation, `parse_feedback_cloud_response` (200/duplicate/502) & `$HOME` scrubbing

import "base_codec"
import "station_api"
import "station_browser"
import "station_screens"

fn w17d3_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic("W17D-3 assertion failed: " + msg)
  }
}

test "w17d3: screens.browser.open enforces URL policy and registers Browser screen in ScreenHub" {
  let h = MockMuxHarness::new(
    5000L,
    fn(_id : Int64, _op : String, _json : String, _p : Option[Bytes], _q : Array[host_shim::HostEvent]) -> Unit {},
  )
  let hold_hub = station_browser::AgentHoldHubPort::{
    people_views: fn(_t : String) -> Array[station_browser::ScreenWatcherView] { [] },
    has_taken_view: fn(_t : String) -> Bool { false },
    yield_to_agent: fn(_t : String, _n : String) -> Int { 1 },
    join_agent: fn(_t : String, _n : String) -> Int { 1 },
    leave_agent: fn(_t : String, _tok : Int) -> Unit {},
  }
  let browser = BrowserOsManager::new(h.hub, hold_hub, fn(s) { s }, fn(_c) { None })
  let screens = station_screens::ScreenHub::new()
  let rng = fn(_n : Int) -> String { "abcdef012345" }

  // Reject unsafe / private / SSRF URLs
  let bad_urls : Array[String] = [
    "file:///etc/passwd",
    "javascript:alert(1)",
    "data:text/html,<h1>x</h1>",
    "http://127.0.0.1:8080/admin",
    "http://localhost:3000/",
    "http://169.254.169.254/latest/meta-data/",
    "http://10.0.0.1/",
    "http://[::1]:9222/",
  ]
  for i in 0..<bad_urls.length() {
    match open_browser_screen_interactive(browser, screens, bad_urls[i], None, 1700000000000L, rng) {
      Err(e) => w17d3_assert(e.status == 400, "bad url " + bad_urls[i] + " expected 400, got " + e.status.to_string())
      Ok(sid) => panic("bad url must be rejected: " + bad_urls[i] + " got " + sid)
    }
  }

  // Open valid public URL
  let sid1 = match open_browser_screen_interactive(browser, screens, "https://example.com/docs", None, 1700000000000L, rng) {
    Ok(s) => s
    Err(e) => panic("open_browser_screen_interactive failed: " + e.message)
  }
  w17d3_assert(sid1 == "browser:u_abcdef012345", "expected browser:u_abcdef012345, got " + sid1)
  match screens.get(sid1) {
    Some(src) => {
      w17d3_assert(src.user_tab && src.closable && src.open_url, "browser source flags mismatch")
      w17d3_assert(src.address == Some("https://example.com/docs"), "browser source address mismatch")
    }
    None => panic("expected screen registered in ScreenHub")
  }

  // Focus existing tab idempotently with updated URL
  let sid2 = match open_browser_screen_interactive(browser, screens, "https://example.com/new", Some("u_abcdef012345"), 1700000005000L, rng) {
    Ok(s) => s
    Err(e) => panic("focus existing tab failed: " + e.message)
  }
  w17d3_assert(sid2 == sid1, "expected same screen id on focus")
  match screens.get(sid1) {
    Some(src) => w17d3_assert(src.address == Some("https://example.com/new"), "expected updated address")
    None => panic("missing screen after focus")
  }
}

test "w17d3: links.preview blocks SSRF (literal, DNS, redirect) and extracts HTML head" {
  // 1. Non-http(s) rejected 400
  match fetch_link_preview_with_ports("file:///etc/passwd", fn(_h) { ["93.184.216.34"] }, fn(_u, _ips) { None }) {
    Err(e) => w17d3_assert(e.status == 400, "file:// must return 400")
    Ok(_) => panic("file:// must return 400")
  }
  match fetch_link_preview_with_ports("javascript:alert(1)", fn(_h) { ["93.184.216.34"] }, fn(_u, _ips) { None }) {
    Err(e) => w17d3_assert(e.status == 400, "javascript: must return 400")
    Ok(_) => panic("javascript: must return 400")
  }

  // 2. Private/loopback/metadata literal hosts never invoke fetch_hop
  let mut fetch_called = false
  let ssrf_urls : Array[String] = [
    "http://127.0.0.1/secret",
    "http://0.0.0.0/",
    "http://169.254.169.254/latest/meta-data/",
    "http://10.0.0.5/",
    "http://172.16.0.1/",
    "http://192.168.1.1/",
    "http://[::1]/",
    "http://[::ffff:127.0.0.1]/",
    "http://2130706433/",
    "http://localhost/admin",
    "http://user:pass@example.com/",
  ]
  for i in 0..<ssrf_urls.length() {
    match fetch_link_preview_with_ports(ssrf_urls[i], fn(_h) { ["93.184.216.34"] }, fn(_u, _ips) { fetch_called = true; None }) {
      Ok(j) => w17d3_assert(json_field_str(j, "kind") == Some("none"), "SSRF URL must yield kind:none: " + ssrf_urls[i])
      Err(e) => panic("SSRF URL unexpected error: " + e.message)
    }
  }
  w17d3_assert(!fetch_called, "SSRF literal hosts must NEVER reach fetch_hop")

  // 3. DNS resolving to metadata IP `169.254.169.254` (alone OR mixed with a public IP!) blocked before fetch
  match fetch_link_preview_with_ports("https://rebind.example.com/", fn(_h) { ["169.254.169.254"] }, fn(_u, _ips) { fetch_called = true; None }) {
    Ok(j) => w17d3_assert(json_field_str(j, "kind") == Some("none"), "DNS metadata IP must yield kind:none")
    Err(_) => panic("unexpected error")
  }
  match fetch_link_preview_with_ports("https://dual-a.example.com/", fn(_h) { ["93.184.216.34", "10.0.0.5"] }, fn(_u, _ips) { fetch_called = true; None }) {
    Ok(j) => w17d3_assert(json_field_str(j, "kind") == Some("none"), "multi-A record containing private IP must yield kind:none")
    Err(_) => panic("unexpected error")
  }
  w17d3_assert(!fetch_called, "DNS-blocked host must NEVER reach fetch_hop")

  // 4. Redirect to internal IP blocked on hop 2
  let mut hop_count = 0
  let redir_fetch = fn(u : String, _ips : Array[String]) -> Option[LinkPreviewHopResponse] {
    hop_count = hop_count + 1
    if u == "https://public.example.com/start" {
      Some(LinkPreviewHopResponse::{
        status: 302,
        content_type: "",
        content_encoding: "",
        location: Some("http://169.254.169.254/latest/meta-data/"),
        body: "",
      })
    } else {
      panic("redirect to metadata IP must NEVER be fetched: " + u)
    }
  }
  match fetch_link_preview_with_ports("https://public.example.com/start", fn(_h) { ["93.184.216.34"] }, redir_fetch) {
    Ok(j) => w17d3_assert(json_field_str(j, "kind") == Some("none") && hop_count == 1, "SSRF redirect must stop after hop 1")
    Err(_) => panic("unexpected error")
  }

  // 5. Public HTML page extracts title/description/site, decodes entities, and omits raw third-party image URL
  let ok_html =
  "<html><head>" +
  "<meta property=\"og:title\" content=\"Pion &amp; Monoid &#39;Docs&#39;\">" +
  "<meta name=\"description\" content=\"Fast  system  language\">" +
  "<meta property=\"og:site_name\" content=\"Monoid\">" +
  "<meta property=\"og:image\" content=\"/hero.png\">" +
  "</head><body>ignored</body></html>"
  let ok_fetch = fn(_u : String, _ips : Array[String]) -> Option[LinkPreviewHopResponse] {
    Some(LinkPreviewHopResponse::{
      status: 200,
      content_type: "text/html; charset=utf-8",
      content_encoding: "identity",
      location: None,
      body: ok_html,
    })
  }
  match fetch_link_preview_with_ports("https://public.example.com/page", fn(_h) { ["93.184.216.34"] }, ok_fetch) {
    Ok(j) => {
      w17d3_assert(json_field_str(j, "kind") == Some("page"), "expected kind:page")
      w17d3_assert(json_field_str(j, "title") == Some("Pion & Monoid 'Docs'"), "title decode mismatch")
      w17d3_assert(json_field_str(j, "description") == Some("Fast system language"), "desc mismatch")
      w17d3_assert(json_field_str(j, "site") == Some("Monoid"), "site mismatch")
      w17d3_assert(json_field_str(j, "image") is None, "raw third-party image URL must be omitted")
    }
    Err(e) => panic("valid preview failed: " + e.message)
  }

  // 5b. Empty or non-HTML Content-Type must return kind:none
  let empty_ct_fetch = fn(_u : String, _ips : Array[String]) -> Option[LinkPreviewHopResponse] {
    Some(LinkPreviewHopResponse::{
      status: 200,
      content_type: "",
      content_encoding: "identity",
      location: None,
      body: ok_html,
    })
  }
  match fetch_link_preview_with_ports("https://public.example.com/raw", fn(_h) { ["93.184.216.34"] }, empty_ct_fetch) {
    Ok(j) => w17d3_assert(json_field_str(j, "kind") == Some("none"), "empty Content-Type must yield kind:none")
    Err(_) => panic("unexpected error")
  }
}

test "w17d3: hub.session.retry/compact, projects.rename/merge, signins, links.preview, feedback.report hook dispatch" {
  let (api, _, hooks, _, _) = make_w17c3a_r2_fixture()
  let owner = make_test_viewer("owner@example.com", "u-owner", "ws-main", true, "owner")
  let ro_viewer = make_test_viewer("ro@example.com", "u-ro", "ws-main", true, "readonly")

  // 1. Hooked `hub.session.retry` & `hub.session.compact`
  let mut retried = ""
  let mut compacted = ""
  let mut notified = 0
  hooks.on_session_changed = Some(fn(_k : String) -> Unit { notified = notified + 1 })
  hooks.on_session_retry = Some(fn(k : String, tid : Int64, seq : Int64) -> Result[Unit, station_api::ApiError] {
    retried = k + ":" + tid.to_string() + ":" + seq.to_string()
    Ok(())
  })
  hooks.on_session_compact = Some(fn(k : String) -> Result[Unit, station_api::ApiError] {
    compacted = k
    Ok(())
  })
  match (api.admin.host.call)("hub.session.retry", make_test_api_req_as("POST", "/sessions/s-main/retry", owner), ["s-main"], base_codec::json_obj([("thread", base_codec::json_int(10)), ("seq", base_codec::json_int(2))])) {
    Ok(r) => w17d3_assert(json_field_bool(r, "ok") == Some(true) && retried == "s-main:10:2", "retry hook mismatch")
    Err(e) => panic("retry failed: " + e.message)
  }
  match (api.admin.host.call)("hub.session.retry", make_test_api_req_as("POST", "/sessions/s-other/retry", owner), ["s-other"], base_codec::json_obj([("thread", base_codec::json_int(20)), ("seq", base_codec::json_int(1))])) {
    Err(e) => w17d3_assert(e.status == 404, "cross-ws retry must return 404")
    Ok(_) => panic("cross-ws retry must fail")
  }
  match (api.admin.host.call)("hub.session.compact", make_test_api_req_as("POST", "/sessions/s-main/compact", owner), ["s-main"], base_codec::json_obj([])) {
    Ok(r) => w17d3_assert(json_field_bool(r, "ok") == Some(true) && compacted == "s-main", "compact hook mismatch")
    Err(e) => panic("compact failed: " + e.message)
  }
  w17d3_assert(notified == 2, "expected 2 session change notifications")

  // 2. Hooked `signins.fill` rejects read-only viewer (403) and enriches viewer fields
  let mut signin_seen = ""
  hooks.on_signins_op = Some(fn(op : String, params : Array[String], body : base_codec::Json) -> Result[base_codec::Json, station_api::ApiError] {
    let em = match json_field_str(body, "_viewerEmail") { Some(s) => s, None => "" }
    let ws = match json_field_str(body, "_viewerWorkspace") { Some(s) => s, None => "" }
    signin_seen = op + ":" + params[0] + ":" + em + ":" + ws
    Ok(base_codec::json_obj([("ok", base_codec::json_bool(true))]))
  })
  match (api.admin.host.call)("signins.fill", make_test_api_req_as("POST", "/browser/sign-ins/g1/fill", ro_viewer), ["g1"], base_codec::json_obj([])) {
    Err(e) => w17d3_assert(e.status == 403, "read-only signins.fill must return 403")
    Ok(_) => panic("read-only signins.fill must fail")
  }
  match (api.admin.host.call)("signins.fill", make_test_api_req_as("POST", "/browser/sign-ins/g1/fill", owner), ["g1"], base_codec::json_obj([("code", base_codec::json_str("123456"))])) {
    Ok(_) => w17d3_assert(signin_seen == "signins.fill:g1:owner@example.com:ws-main", "signins enrichment mismatch: " + signin_seen)
    Err(e) => panic("signins.fill failed: " + e.message)
  }

  // 3. Hooked `links.preview` & `feedback.report`
  hooks.on_links_preview = Some(fn(u : String) -> Result[base_codec::Json, station_api::ApiError] {
    Ok(base_codec::json_obj([("kind", base_codec::json_str("page")), ("url", base_codec::json_str(u)), ("title", base_codec::json_str("OK"))]))
  })
  match (api.admin.host.call)("links.preview", make_test_api_req_as("GET", "/link-preview?url=https://example.com", owner), [], base_codec::json_obj([])) {
    Ok(r) => w17d3_assert(json_field_str(r, "title") == Some("OK"), "links.preview hook mismatch")
    Err(e) => panic("links.preview failed: " + e.message)
  }
  match (api.admin.host.call)("links.preview", make_test_api_req_as("GET", "/link-preview?url=ftp://example.com", owner), [], base_codec::json_obj([])) {
    Err(e) => w17d3_assert(e.status == 400, "non-http links.preview must return 400")
    Ok(_) => panic("non-http links.preview must fail")
  }

  hooks.on_feedback_report = Some(fn(_req : station_api::ApiRequest, tid : Int, n : Int) -> Result[base_codec::Json, station_api::ApiError] {
    w17d3_assert(tid == 10 && n == 3, "feedback params mismatch")
    parse_feedback_cloud_response(200, "{\"number\":77,\"duplicate\":true}")
  })
  match (api.admin.host.call)("feedback.report", make_test_api_req_as("POST", "/threads/10/report", owner), ["10"], base_codec::json_obj([("n", base_codec::json_int(3))])) {
    Ok(r) => w17d3_assert(ro_json_int_field(r, "number") == Some(77) && json_field_bool(r, "duplicate") == Some(true), "feedback.report hook mismatch")
    Err(e) => panic("feedback.report failed: " + e.message)
  }
  match parse_feedback_cloud_response(503, "down") {
    Err(e) => w17d3_assert(e.status == 502, "upstream 503 must map to 502")
    Ok(_) => panic("upstream 503 must fail")
  }

  // 4. `migrate_projects_jsonl_rename_merge` & `rewrite_preset_projects_json`
  let parsed = match station_api::parse_projects_jsonl(
    "{\"name\":\"Alpha\",\"note\":\"NoteA\",\"refs\":[\"r/a\"]}\n{\"name\":\"Beta\",\"note\":\"NoteB\",\"refs\":[\"r/b\"]}\n",
    false,
  ) {
    Ok(p) => p
    Err(e) => panic("parse_projects_jsonl failed: " + e)
  }
  let (merged, changed) = migrate_projects_jsonl_rename_merge(parsed, "Alpha", "Beta", 5000L)
  w17d3_assert(changed && merged.entries.length() == 1 && merged.entries[0].name == "Beta", "merge entry count mismatch")
  w17d3_assert(merged.entries[0].refs.length() == 2, "merge must combine refs")
  w17d3_assert(merged.tombstones.length() == 1 && merged.tombstones[0].0 == "Alpha", "merge must tombstone Alpha")
  w17d3_assert(
    rewrite_preset_projects_json("{\"p1\":\"Alpha\",\"p2\":\"Keep\"}", "Alpha", "Beta") == Some("{\"p1\":\"Beta\",\"p2\":\"Keep\"}"),
    "rewrite_preset_projects_json legacy string mismatch",
  )
  match rewrite_preset_projects_json("{\"p1\":{\"project\":\"Alpha\",\"rev\":2,\"at\":1000},\"p2\":{\"project\":\"Keep\",\"rev\":1,\"at\":900}}", "Alpha", "Beta", renamed_at=5000L) {
    Some(s) => w17d3_assert(s.contains("\"project\":\"Beta\"") && s.contains("\"ren\":5000") && s.contains("\"project\":\"Keep\""), "rewrite_preset_projects_json object mismatch: " + s)
    None => panic("rewrite_preset_projects_json object returned None")
  }
}
