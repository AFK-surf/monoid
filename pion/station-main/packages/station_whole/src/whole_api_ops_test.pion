test "wave17c2 vault handover 503 gate, lock 409 gate, updates channel/auto/uninstall, and settings ConfigFile persistence" {
  let (_, _, api, updates, mem_fs) = make_mem_whole_api_fixture()
  let req = make_test_api_req("PUT", "/vault/vaults")

  // 1. Pre-handover read_only_handover=true MUST return 503 vault_handover on PUT /vault/vaults
  api.hooks.read_only_handover_cell[0] = true
  match (api.admin.host.call)("vault.vaults.PUT", req, [], base_codec::json_obj([])) {
    Err(e) => {
      if e.status != 503 {
        panic("expected 503 during handover on vault.vaults.PUT, got " + e.status.to_string())
      }
    }
    Ok(_) => panic("expected 503 error during handover")
  }

  // 2. After handover lifts, missing lock_of returns 409 vault_needs_lock
  api.hooks.read_only_handover_cell[0] = false
  match (api.admin.host.call)("vault.vaults.GET", req, [], base_codec::json_obj([])) {
    Err(e) => {
      if e.status != 409 || !e.message.starts_with("vault_needs_lock") {
        panic("expected 409 vault_needs_lock, got " + e.status.to_string() + " " + e.message)
      }
    }
    Ok(_) => panic("expected 409 vault_needs_lock")
  }

  // 3. Settings persist to unified ConfigFile (mcpServers, network, updates.channel, updates.auto)
  match (api.admin.host.call)(
    "mcpServers.put",
    req,
    [],
    base_codec::json_obj([("servers", base_codec::json_obj([("demo", base_codec::json_obj([("command", base_codec::json_str("echo"))]))]))]),
  ) {
    Ok(_) => ()
    Err(e) => panic("mcpServers.put failed: " + e.message)
  }
  match (api.admin.host.call)("updates.channel", req, [], base_codec::json_obj([("channel", base_codec::json_str("beta"))])) {
    Ok(_) => ()
    Err(e) => panic("updates.channel failed: " + e.message)
  }
  match (api.admin.host.call)("updates.install", req, [], base_codec::json_obj([("id", base_codec::json_str("station"))])) {
    Ok(_) => {
      if updates.station.updating is None {
        panic("updates.install must mark station.updating")
      }
    }
    Err(e) => panic("updates.install failed: " + e.message)
  }
  match mem_fs.ops().read_text("/tmp/w17c2-api-test/config.json") {
    Ok(raw) => {
      if !raw.contains("mcpServers") || !raw.contains("updateChannel") {
        panic("expected config.json to contain mcpServers and updateChannel, got: " + raw)
      }
    }
    Err(_) => panic("expected config.json to be written")
  }
}
