    "session.skills",
    "threads",
    "thread",
    "thread.entries",
    "thread.letters",
    "openJobs",
    "job",
    "job.log",
  ]
  for i in 0..<all_read_ops.length() {
    let op = all_read_ops[i]
    match (api.admin.host.read_op)(op, req, base_codec::json_obj([("key", base_codec::json_str("s1")), ("id", base_codec::json_str("1"))])) {
      Err(e) => {
        if e.status == 404 && e.message.starts_with("unsupported read op") {
