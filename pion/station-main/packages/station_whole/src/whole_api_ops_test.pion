fn make_test_api_req(method : String, path : String) -> station_api::ApiRequest {
  let (norm_path, norm_query_raw, norm_query) = station_http::parse_request_target(path)
  let http_req = station_http::HttpRequest::{
    conn_id: 0,
    method: method,
    raw_target: path,
    path: norm_path,
    query_raw: norm_query_raw,
    query: norm_query,
    version: http1::Version::Http11,
    headers: [],
    body: Bytes::new(0),
    peer: "",
    raw_head: Bytes::new(0),
  }
  let viewer = station_api::Viewer::{
    email: "owner@example.com",
    sub: "u-owner",
    name: "Owner",
    workspace: "ws-main",
    home: true,
    role: "owner",
    device: Some("dev-1"),
  }
  station_api::ApiRequest::from_http(http_req, viewer)
}

fn make_mem_whole_api_fixture() -> (WholeStore, WholeAgents, WholeApi, station_drivers::RuntimeUpdatesManager, station_ops::MemFs) {
  let mem_fs = station_ops::MemFs::new()
  let _ = mem_fs.put_text("/tmp/w17c2-api-test/config.json", "{}", 384)
  let ops_fs = mem_fs.ops()
  let cfg_file = match station_ops::ConfigFile::open(ops_fs, "/tmp/w17c2-api-test", sep="/") {
    Ok(c) => c
    Err(e) => panic("ConfigFile::open failed: " + station_ops::config_err_msg(e))
  }
  let store = WholeStore::new_pre_handover_with_sep("/tmp/w17c2-api-test", "/")
  store.vault_store = Some(station_vault::VaultStore::in_memory())
  let job_fs = mem_job_fs_port(fn() -> Int64 { 1700000000000L })
  let agents_cfg = WholeAgentsConfig::{
    data_dir: "/tmp/w17c2-api-test",
    assets_dir: "/tmp/w17c2-api-test/assets",
    runner_bin: "/usr/bin/true",
    mcp_port: 0,
    home_ws: "ws-main",
  }
  let agents = WholeAgents::new_with_deps(
    agents_cfg,
    job_fs,
    wc_noop_proc_backend(),
    fn(n : Int) -> Result[Bytes, String] {
      let b = Bytes::new(n)
      for i in 0..<n { b[i] = (i % 251 + 1).to_byte() }
      Ok(b)
    },
  )
  let updates = station_drivers::RuntimeUpdatesManager::new()
  let auth_policy = PeerAuthPolicy::{
    station_id: "st-w17c2",
    station_build: "9.9.9",
    home_workspace: "ws-main",
    allowed_workspaces: ["ws-main", "ws-other"],
    verify_fn: None,
  }
  let drive_fs = station_screens::MemDriveFs::new().fs()
  let drive = station_screens::Drive::new(
    drive_fs,
    ["/tmp/w17c2-api-test"],
    ["/tmp/w17c2-api-test/data"],
    false,
    "/tmp/w17c2-api-test/trash",
    station_screens::TrashKind::Freedesktop,
  )
  let screens = station_screens::ScreenHub::new()
  let events = station_api::EventsHub::new("st-w17c2", station_api::EventKeeps::default())
  let seen_store = station_api::SeenStore::empty()
  let hooks = WholeApiRuntimeHooks::new()
  hooks.read_only_handover_cell[0] = false
  let port = WholeApiRuntimePort::in_memory()
  let di_host = station_api::ApiHost::{
    read_op: fn(op : String, req : station_api::ApiRequest, args : base_codec::Json) -> Result[base_codec::Json, station_api::ApiError] {
      if op == "chats" || op == "sessions" || op == "session" || op == "threads" || op == "thread" || op == "thread.entries" || op == "openJobs" || op == "job" || op == "skills" || op == "session.skills" {
        return Ok(base_codec::json_obj([("op", base_codec::json_str(op))]))
      }
      match dispatch_extra_read_op(op, req, args, agents, seen_store, port) {
        Some(res) => res
        None => Err(station_api::ApiError::new(404, "unsupported read op: " + op))
      }
    },
    call: fn(op : String, req : station_api::ApiRequest, params : Array[String], body : base_codec::Json) -> Result[base_codec::Json, station_api::ApiError] {
      if op == "projects.info.get" || op == "hub.thread.messages" || op == "projects.thread.classification" || op == "hub.session.create" || op == "accounts.runtimes.put" || op == "hub.session.archive.POST" || op == "screens.list" {
        return Ok(base_codec::json_obj([("op", base_codec::json_str(op))]))
      }
      match dispatch_extra_call_op(
        op,
        req,
        params,
        body,
        store,
        agents,
        auth_policy,
        drive,
        screens,
        events,
        updates,
        Some(cfg_file),
        None,
        hooks,
        port,
        1700000000000L,
      ) {
        Some(res) => res
        None => Err(station_api::ApiError::new(404, "unsupported api op: " + op))
      }
    },
    overview: fn(_v : station_api::Viewer, _l : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([]))
    },
    host_sample: fn(_l : station_api::Lang) -> Result[base_codec::Json, station_api::ApiError] {
      Ok(base_codec::json_obj([]))
    },
    search: fn(_q : String, _a : station_api::SearchAsker, _k : Array[String], _lim : Int, _off : Int, _arch : Bool) -> Result[station_api::SearchResult, station_api::ApiError] {
      Ok(station_api::SearchResult::{ groups: [], building: false })
    },
    events: Some(events),
    usage_reading_all: fn() -> Bool { false },
    session_exists: fn(_k : String) -> Bool { true },
    held_sessions: fn() -> Array[String] { [] },
    dev_enabled: false,
  }
  let api = WholeApi::new_with_ports(
    auth_policy,
    drive,
    ["/tmp/w17c2-api-test"],
    None,
    screens,
    events,
    seen_store,
    di_host,
  )
  api.read_only_handover = false
  api.hooks.read_only_handover_cell = hooks.read_only_handover_cell
  (store, agents, api, updates, mem_fs)
}

test "wave17c2 completeness gate: every read_op and call_op from routes*.pion dispatches without 404 unsupported" {
  let (_, _, api, _, _) = make_mem_whole_api_fixture()
  let req = make_test_api_req("POST", "/test")

  let all_read_ops : Array[String] = [
    "memory",
    "chats",
    "changed.chats",
    "changed.sharedChats",
    "changed.sessions",
    "changed.threads",
    "usage",
    "usage.calls",
    "resources",
    "machineSessions",
    "machineSession",
    "skills",
    "sessions",
    "session",
    "session.timeline",
