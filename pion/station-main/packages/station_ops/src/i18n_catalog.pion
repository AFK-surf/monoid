    "station.claudeAuth.noCredentials" => Some(CatalogEntry::Plain("No Claude sign-in credentials found; sign in again"))
    "station.claudeAuth.noExpiry" => Some(CatalogEntry::Plain("Claude renewal response lacks expiry"))
    "station.claudeAuth.refreshFailed" => Some(CatalogEntry::Plain("Claude sign-in renewal failed; try again later"))
    "station.claudeAuth.refreshLocked" => Some(CatalogEntry::Plain("Another Claude process is renewing; try again later"))
    "station.claudeAuth.refreshRefused" => Some(CatalogEntry::Plain("Claude sign-in renewal refused ({status}); sign in again"))
    "station.claudeAuth.refreshUnavailable" => Some(CatalogEntry::Plain("Can't renew Claude sign-in now ({status}); try again later"))
    "station.claudeAuth.saveFailed" => Some(CatalogEntry::Plain("Couldn't save renewed Claude sign-in"))
    "station.cli.badChannel" => Some(CatalogEntry::Plain("channel must be stable or beta, not {channel}"))
    "station.cli.held" => Some(CatalogEntry::Plain("Another still.fail station is running on this data directory ({dir}); only one station can run on a data directory on one machine"))
    "station.cli.joined" => Some(CatalogEntry::Plain("Joined workspace “{workspace}” as station “{name}” ({id})"))
    "station.cli.lock.aside" => Some(CatalogEntry::Plural(Some(", and {n} record kept off the chain in use"), ", and {n} records kept off the chain in use"))
    "station.cli.lock.broken" => Some(CatalogEntry::Plain("Security mode: this station's lock.json is invalid, so all connections are refused. Run `stillfail lock reset` to let still.fail's servers manage access again"))
    "station.cli.lock.code" => Some(CatalogEntry::Plain("Security code: {code}"))
    "station.cli.lock.none" => Some(CatalogEntry::Plain("Security mode: off (still.fail's servers manage access)"))
    "station.cli.lock.noneWorkspace" => Some(CatalogEntry::Plain("This station keeps no security mode record for workspace {workspace}"))
    "station.cli.lock.pending" => Some(CatalogEntry::Plain("This station enters security mode once it receives the workspace's trusted list. Verify the station in still.fail with security code {code}"))
    "station.cli.lock.reset" => Some(CatalogEntry::Plain("This station has left security mode; still.fail's servers manage access again. To turn it back on, use a trusted device"))
    "station.cli.lock.resetWorkspace" => Some(CatalogEntry::Plain("This station no longer keeps a security mode record for workspace {workspace}. If that workspace is in security mode, the station takes none of its members until it is protected there again from a trusted device"))
    "station.cli.lock.status" => Some(CatalogEntry::Plain("Security mode: on, record {seq} ({hash}…), {members} members, {devices} devices, {stations} stations"))
    "station.cli.noAnswer" => Some(CatalogEntry::Plain("The running station didn't answer (it may still be starting); try again in a moment"))
    "station.cli.replace.backup" => Some(CatalogEntry::Plain("Revert backup: {path}"))
    "station.cli.replace.none" => Some(CatalogEntry::Plain("No local override active"))
    "station.cli.rig.isRig" => Some(CatalogEntry::Plain("This machine is a tasks-only station of workspace “{workspace}” and cannot join as a full station too. To change that, make it a full station in still.fail, or remove it from the workspace first"))
    "station.cli.rig.isStation" => Some(CatalogEntry::Plain("This machine is a full station of workspace “{workspace}” and cannot join as a tasks-only station too. To change that, make it tasks only in still.fail, or remove it from the workspace first"))
    "station.cli.rig.joined" => Some(CatalogEntry::Plain("Joined workspace “{workspace}” as station “{name}” ({id}), tasks only, owned by {owner}"))
    "station.cli.rig.pending" => Some(CatalogEntry::Plain("This station enters security mode once it receives the workspace's trusted list. Its owner checks the security code {code} in still.fail"))
    "station.cli.rig.status" => Some(CatalogEntry::Plain("Mode: tasks only, owned by {owner} (it takes only their trusted devices' approval, list {person}…). It runs no agents; it only runs tasks the workspace's stations send"))
    "station.cli.rig.working" => Some(CatalogEntry::Plain("Work: normal (waiting for tasks from stations)"))
    "station.cli.signalFailed" => Some(CatalogEntry::Plain("Couldn't notify the running station (pid {pid}): {error}"))
    "station.cli.status.autoHeld" => Some(CatalogEntry::Plain("Auto-update: paused (held by local override)"))
    "station.cli.status.autoWhen" => Some(CatalogEntry::Plain("Auto-update: waiting for {conditions}"))
    "station.cli.status.cloud" => Some(CatalogEntry::Plain("Cloud: {origin}"))
    "station.cli.status.data" => Some(CatalogEntry::Plain("Data directory: {path}"))
    "station.cli.status.frontDown" => Some(CatalogEntry::Plain("Work: failing (the local mesh front is disconnected and reconnecting; devices can't reach this station until it's back. The launcher restarts the front by itself)"))
    "station.cli.status.idleRemoved" => Some(CatalogEntry::Plain("Work: stopped. On removal, the station closed its Slack connections and stopped running agents and jobs (the reason is at the end of each job log). It checks with the cloud every 10 minutes and resumes automatically once readmitted. To rejoin: {join}"))
    "station.cli.status.idleUnjoined" => Some(CatalogEntry::Plain("Work: stopped. A station outside a workspace doesn't connect to Slack or run agents and jobs. To join: {join}"))
    "station.cli.status.join" => Some(CatalogEntry::Plain("stillfail station enroll <cloud> <token> (generate the token under “Add station” in still.fail)"))
    "station.cli.status.keyConflict" => Some(CatalogEntry::Plain("Work: failing (another machine or process is using this station's key, and each keeps replacing the other's connection, so devices connect and drop; stop the station running elsewhere, or enroll one of them again as a new station)"))
    "station.cli.status.limited" => Some(CatalogEntry::Plain("Work: limited (not connected to still.fail cloud yet, retrying; devices may not find this station until then — see the “Online” line above for why)"))
    "station.cli.status.name" => Some(CatalogEntry::Plain("Station name: {name} ({id})"))
    "station.cli.status.noWorkspace" => Some(CatalogEntry::Plain("Workspace: not joined"))
    "station.cli.status.notConnectedYet" => Some(CatalogEntry::Plain("Not connected yet"))
    "station.cli.status.notRunning" => Some(CatalogEntry::Plain("Station: not running"))
    "station.cli.status.offline" => Some(CatalogEntry::Plain("Online: no"))
    "station.cli.status.offlineNotRunning" => Some(CatalogEntry::Plain("Online: no (the station isn't running)"))
    "station.cli.status.offlineWhy" => Some(CatalogEntry::Plain("Online: no ({why})"))
    "station.cli.status.onlineSince" => Some(CatalogEntry::Plain("Online: yes (since {at})"))
    "station.cli.status.override" => Some(CatalogEntry::Plain("Local override: {kind} (base {base})"))
    "station.cli.status.overrideNote" => Some(CatalogEntry::Plain("Override note: {note}"))
    "station.cli.status.removed" => Some(CatalogEntry::Plain("Removed: from workspace “{workspace}”, {at}, {how}"))
    "station.cli.status.removedCode" => Some(CatalogEntry::Plain("code {code}"))
    "station.cli.status.removedOn404" => Some(CatalogEntry::Plain("The cloud reported on connect that this station is no longer in the workspace (404)"))
    "station.cli.status.removedOnClose" => Some(CatalogEntry::Plain("The cloud reported it when closing the connection (4004)"))
    "station.cli.status.running" => Some(CatalogEntry::Plain("Station: running (pid {pid}, version {version})"))
    "station.cli.status.stopped" => Some(CatalogEntry::Plain("Work: stopped (the station isn't running: it doesn't connect to Slack or run agents and jobs). To start it: stillfail start"))
