    "station.updates.moduleWentBack" => Some(CatalogEntry::Plain("{version} 没能启动，已退回 {back}"))
    "station.updates.noApplicableUpdate" => Some(CatalogEntry::Plain("{program} 暂无可在此安装的更新（其源可能还没有最新版本），未做改动：{said}"))
    "station.updates.noBrew" => Some(CatalogEntry::Plain("{name} 通过 Homebrew 安装，但 station 找不到 brew"))
    "station.updates.noBuild" => Some(CatalogEntry::Plain("{version} 没有适用于本机的版本"))
    "station.updates.noInstaller" => Some(CatalogEntry::Plain("当前版本不含安装脚本，请使用安装命令重新安装"))
    "station.updates.noNpm" => Some(CatalogEntry::Plain("{name} 通过 npm 安装，但 station 找不到 npm"))
    "station.updates.noNpmInstall" => Some(CatalogEntry::Plain("安装 {name} 需要 npm：请先在本机安装 Node（含 npm）"))
    "station.updates.noOutput" => Some(CatalogEntry::Plain("更新失败，无输出"))
    "station.updates.noSuchItem" => Some(CatalogEntry::Plain("不存在 {id}"))
    "station.updates.noVp" => Some(CatalogEntry::Plain("{name} 通过 Vite+ 安装，但 station 找不到对应的 vp"))
    "station.updates.nodeUnverified" => Some(CatalogEntry::Plain("下载的 Node 校验失败"))
    "station.updates.notFinished" => Some(CatalogEntry::Plain("{program} 未按时结束"))
    "station.updates.notHere" => Some(CatalogEntry::Plain("无法在此更新 {name}"))
    "station.updates.notInstaller" => Some(CatalogEntry::Plain("并非通过安装脚本安装，无法在此更新"))
    "station.updates.notJoined" => Some(CatalogEntry::Plain("尚未加入 workspace，无法更新"))
    "station.updates.notNewer" => Some(CatalogEntry::Plain("{program} 已完成，但 {command} 仍是 {version}（最新为 {latest}）：可能安装到了其他位置，PATH 中的不是新版本"))
    "station.updates.notOnPath" => Some(CatalogEntry::Plain("{program} 已完成，但 station 的 PATH 中仍找不到 {command}：可能安装到了其他位置"))
    "station.updates.npmRootUnknown" => Some(CatalogEntry::Plain("无法确定 {path} 的 npm 全局安装目录，需在该机器上手动更新"))
    "station.updates.older" => Some(CatalogEntry::Plain("{version} 早于当前的 {current}，不予更新"))
    "station.updates.overrideAutoRefused" => Some(CatalogEntry::Plain("本地替换运行期间无法开启自动更新；请先设置等待条件或恢复官方版本"))
    "station.updates.restarting" => Some(CatalogEntry::Plain("正在重启"))
    "station.updates.runtimeBusy" => Some(CatalogEntry::Plain("{name} 正在安装或更新，完成后再更新 station"))
    "station.updates.standaloneUnknown" => Some(CatalogEntry::Plain("无法确定 {path} 的 standalone 安装入口，需在该机器上手动更新"))
    "station.updates.stationBusyInstall" => Some(CatalogEntry::Plain("station 正在更新，完成后再安装 {name}"))
    "station.updates.stationBusyUninstall" => Some(CatalogEntry::Plain("station 正在更新，完成后再卸载 {name}"))
    "station.updates.stationBusyUpdate" => Some(CatalogEntry::Plain("station 正在更新，完成后再更新 {name}"))
    "station.updates.stillInstalled" => Some(CatalogEntry::Plain("{program} 已结束，但 station 仍能在 {path} 找到 {name}：这台机器上可能还有另一份安装，请在这台机器上按那份的装法卸载"))
    "station.updates.timedOut" => Some(CatalogEntry::Plain("超过 10 分钟仍未完成"))
    "station.updates.uninstallAgy" => Some(CatalogEntry::Plain("Antigravity CLI 没有官方卸载命令，不能在这里卸载；请在这台机器上删掉 {path}（登录和设置在 ~/.gemini/antigravity-cli，可以保留）"))
    "station.updates.uninstallBusy" => Some(CatalogEntry::Plain("{name} 正在安装、更新或卸载，等它结束后再卸载"))
    "station.updates.uninstallCodexStandalone" => Some(CatalogEntry::Plain("Codex 是用它的独立安装脚本装的（{path}），没有官方卸载命令，不能在这里卸载；请在这台机器上删掉 PATH 上的 codex 和 ~/.codex/packages/standalone（登录和设置在 ~/.codex 的其余部分，可以保留）"))
    "station.updates.uninstallElsewhere" => Some(CatalogEntry::Plain("{name} 安装在 {path}，不是 Station 认得的装法，不能在这里卸载；请在这台机器上按当初的安装方式卸载"))
    "station.updates.uninstallHermes" => Some(CatalogEntry::Plain("Hermes 由它自己管理，不能在这里卸载；请在这台机器上按 Hermes 的说明卸载"))
    "station.updates.uninstallNotInstalled" => Some(CatalogEntry::Plain("这台 Station 上没有安装 {name}"))
    "station.updates.uninstallPi" => Some(CatalogEntry::Plain("Pi 是用它的安装脚本装的（{path}），只能在终端里卸载；请在这台机器上运行 curl -fsSL https://pi.dev/install.sh | sh，选「Uninstall Pi」"))
    "station.updates.uninstallTurns" => Some(CatalogEntry::Plain("{name} 上还有对话正在回复，等这些回复结束后再卸载"))
    "station.updates.uninstalling" => Some(CatalogEntry::Plain("正在卸载"))
    "station.updates.unverified" => Some(CatalogEntry::Plain("此版本签名校验失败，不予更新（{why}）"))
    "station.updates.upToDate" => Some(CatalogEntry::Plain("已是最新版本"))
    "station.updates.withDesktop" => Some(CatalogEntry::Plain("随 still.fail 桌面端一起更新"))
    "station.usage.notKept" => Some(CatalogEntry::Plain("此 station 不记录用量"))
    "station.usage.priceNote" => Some(CatalogEntry::Plain("美元 / 100 万 token · 各类 token × 单价后相加；Claude fast ×2。GPT 按标准短上下文价格估算，仅记录输入、缓存读取和输出。"))
    "station.wait.overloaded" => Some(CatalogEntry::Plain("模型恢复可用"))
    _ => None
  }
}

pub fn catalog_en(key : String) -> Option[CatalogEntry] {
  match key {
    "station.adb.allowPrompt" => Some(CatalogEntry::Plain("Tap Allow on the phone's “Allow USB debugging?” prompt"))
    "station.adb.codeDigits" => Some(CatalogEntry::Plain("The pairing code is 6 digits"))
    "station.adb.grantFailed" => Some(CatalogEntry::Plain("Couldn't grant: {said}"))
    "station.adb.grantRefused" => Some(CatalogEntry::Plain("The phone doesn't let adb grant permissions: in Developer options, turn on “Disable permission monitoring” (ColorOS) or “USB debugging (Security settings)” (MIUI), then try again"))
    "station.adb.granted" => Some(CatalogEntry::Plain("The app can now turn on wireless debugging itself"))
    "station.adb.install" => Some(CatalogEntry::Plain("No adb on this station: install Android platform-tools (macOS: brew install android-platform-tools), then share again"))
    "station.adb.noAdb" => Some(CatalogEntry::Plain("No adb on this station"))
    "station.adb.noPackage" => Some(CatalogEntry::Plain("The phone didn't send the app's package name"))
    "station.adb.notSharing" => Some(CatalogEntry::Plain("This device isn't sharing debugging"))
    "station.adb.pairFailed" => Some(CatalogEntry::Plain("Pairing failed: {said}"))
    "station.adb.paired" => Some(CatalogEntry::Plain("Paired"))
    "station.adb.pairingClosed" => Some(CatalogEntry::Plain("Pairing isn't open on the phone: in Wireless debugging, tap “Pair device with pairing code”"))
    "station.adb.serverDown" => Some(CatalogEntry::Plain("adb did not start on the station"))
    "station.adb.unknownAsk" => Some(CatalogEntry::Plain("Unknown adb request"))
    "station.adb.unpaired" => Some(CatalogEntry::Plain("This station isn't paired with the phone yet"))
    "station.adb.wirelessOff" => Some(CatalogEntry::Plain("Wireless debugging is off on the phone"))
    "station.admin.badChannel" => Some(CatalogEntry::Plain("channel must be stable or beta"))
    "station.admin.badFast" => Some(CatalogEntry::Plain("fast must be a boolean or null"))
    "station.admin.badN" => Some(CatalogEntry::Plain("n must be an integer"))
    "station.admin.badOn" => Some(CatalogEntry::Plain("on must be true or false"))
    "station.admin.badOption" => Some(CatalogEntry::Plain("option must be one the agent offered"))
    "station.admin.badRuntime" => Some(CatalogEntry::Plain("runtime must be claude, codex or dsh"))
    "station.admin.emptyMessage" => Some(CatalogEntry::Plain("Message is empty"))
    "station.admin.footprintRemoved" => Some(CatalogEntry::Plain("Storage stats removed"))
    "station.admin.fromAndTo" => Some(CatalogEntry::Plain("Provide from and to together"))
    "station.admin.loginOnMachine" => Some(CatalogEntry::Plain("This Profile uses the machine's sign-in; sign in on that machine"))
    "station.admin.loginSubscriptionOnly" => Some(CatalogEntry::Plain("Only subscription accounts need to sign in"))
    "station.admin.noLocalSession" => Some(CatalogEntry::Plain("No such local session: {id}"))
    "station.admin.notInteger" => Some(CatalogEntry::Plain("{name} must be an integer"))
    "station.admin.nothingWaiting" => Some(CatalogEntry::Plain("Nothing in this message is awaiting your answer"))
    "station.admin.postOnlyStillfail" => Some(CatalogEntry::Plain("You can only post in still.fail chats"))
    "station.admin.renameOnlyStillfail" => Some(CatalogEntry::Plain("You can only rename still.fail chats"))
    "station.admin.updateApp" => Some(CatalogEntry::Plain("This app is too old for this station. Update the app."))
    "station.admin.updateClientForOption" => Some(CatalogEntry::Plain("Update the app to choose this option; it won't be sent to the agent"))
    "station.admin.updateClientForRuntime" => Some(CatalogEntry::Plain("Update the app to view this agent’s execution history"))
    "station.admin.updatesManagersOnly" => Some(CatalogEntry::Plain("Only workspace owners or admins can update the station and runtimes"))
    "station.admin.updatesUnavailable" => Some(CatalogEntry::Plain("This station can't be updated here"))
    "station.admin.waitChanged" => Some(CatalogEntry::Plain("This wait has changed; refresh and try again"))
    "station.agentEnv.badName" => Some(CatalogEntry::Plain("Line {line}: {name} isn't a valid variable name"))
    "station.agentEnv.managersOnly" => Some(CatalogEntry::Plain("Only workspace admins can change agent environment variables"))
    "station.agentEnv.notPair" => Some(CatalogEntry::Plain("Line {line} isn't in the form NAME=value"))
    "station.agentEnv.tooLong" => Some(CatalogEntry::Plain("Line {line}: the value is too long (at most {most} characters)"))
    "station.agentEnv.tooMany" => Some(CatalogEntry::Plain("Too many variables (at most {most})"))
    "station.archiving.badSettings" => Some(CatalogEntry::Plain("Invalid automatic archiving settings: days must be between 0 and 365"))
