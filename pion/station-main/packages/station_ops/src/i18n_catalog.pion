    "station.cli.status.working" => Some(CatalogEntry::Plain("Work: normal (connected to Slack, running agents and jobs)"))
    "station.cli.status.workspace" => Some(CatalogEntry::Plain("Workspace: {name} ({id})"))
    "station.cli.unknownChannel" => Some(CatalogEntry::Plain("Unknown channel {channel}"))
