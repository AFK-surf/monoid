    "station.card.endedClosed" => Some(CatalogEntry::Plain("Closed"))
    "station.card.endedReplaced" => Some(CatalogEntry::Plain("Closed: a newer question replaced it"))
    "station.card.endedWithdrawn" => Some(CatalogEntry::Plain("Withdrawn"))
    "station.card.replied" => Some(CatalogEntry::Plain("{name} replied"))
    "station.card.repliedBare" => Some(CatalogEntry::Plain("Replied"))
    "station.cc.failed" => Some(CatalogEntry::Plain("Could not copy this to {place}: {error}"))
    "station.cc.said" => Some(CatalogEntry::Plain("{who} said on still.fail:"))
