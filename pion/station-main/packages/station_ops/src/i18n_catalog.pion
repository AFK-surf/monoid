    "station.chat.directMessage" => Some(CatalogEntry::Plain("DM"))
    "station.chat.quotedOnly" => Some(CatalogEntry::Plain("Quoted a message"))
    "station.chat.untitled" => Some(CatalogEntry::Plain("New chat"))
    "station.claudeAuth.badResponse" => Some(CatalogEntry::Plain("Claude sign-in renewal returned a bad response"))
    "station.claudeAuth.changedDuringRefresh" => Some(CatalogEntry::Plain("Claude sign-in changed during renewal; try again"))
