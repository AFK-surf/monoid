pub fn stillfail_product() -> Product {
  Product::{
    name: "still.fail",
    test_domain: "youdid.wtf",
    id: "stillfail",
    reverse: "fail.still",
  }
}

pub fn branded_products() -> Array[ProductZones] {
  [
    ProductZones::{
      zones: ["monoid.build", "monoid.zone"],
      product: Product::{
        name: "monoid",
        test_domain: "monoid.zone",
        id: "monoid",
        reverse: "build.monoid",
      },
    },
  ]
}

