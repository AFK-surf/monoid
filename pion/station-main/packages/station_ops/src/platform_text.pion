// 1:1 port of `station/src/platform/text.ts` and `station/src/platform/cpu-share.ts`:
// Parsing OS command outputs (ps, top, vm_stat, sysctl, /proc/stat, /proc/meminfo,
// /proc/pressure/memory, lsof, ioreg, mount), memory pressure classification, and CPU share.

pub enum MemoryPressure {
  Normal
  High
  Critical
}

pub fn memory_pressure_str(p : MemoryPressure) -> String {
  match p {
    MemoryPressure::Normal => "normal"
    MemoryPressure::High => "high"
    MemoryPressure::Critical => "critical"
  }
}

pub fn memory_pressure_rank(p : MemoryPressure) -> Int {
  match p {
    MemoryPressure::Normal => 0
    MemoryPressure::High => 1
    MemoryPressure::Critical => 2
  }
}

pub fn worse_pressure(
  a : Option[MemoryPressure],
  b : Option[MemoryPressure],
) -> Option[MemoryPressure] {
  match a {
    None => b
    Some(pa) => match b {
      None => Some(pa)
      Some(pb) =>
      if memory_pressure_rank(pa) >= memory_pressure_rank(pb) { Some(pa) } else { Some(pb) }
    }
  }
}

fn is_ws_byte(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13
}

pub fn trim_ws(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && is_ws_byte(s.code_unit_at(start) & 0xFF) {
    start = start + 1
  }
  let mut end = n
  while end > start && is_ws_byte(s.code_unit_at(end - 1) & 0xFF) {
    end = end - 1
  }
  ops_slice_str(s, start, end)
}

pub fn split_words(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && is_ws_byte(s.code_unit_at(i) & 0xFF) {
      i = i + 1
    }
    let start = i
    while i < n && !is_ws_byte(s.code_unit_at(i) & 0xFF) {
      i = i + 1
    }
    if i > start {
      out.push(ops_slice_str(s, start, i))
    }
  }
  out
}

pub fn first_word(s : String) -> String {
  let w = split_words(s)
  if w.length() > 0 { w[0] } else { "" }
}

/// Rust `str::parse::<u64>` (optional leading `+`, then ASCII digits).
pub fn parse_u64(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let start = if (s.code_unit_at(0) & 0xFF) == 43 { 1 } else { 0 }
  if start >= n {
    return None
  }
  let mut acc : Int64 = 0.to_int64()
  for i in start..<n {
    let c = s.code_unit_at(i) & 0xFF
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10.to_int64() + (c - 48).to_int64()
  }
  Some(acc)
}

/// Parse finite floating point literal (`[+-]?([0-9]+\.?[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?`).
pub fn parse_f64(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let c0 = s.code_unit_at(0) & 0xFF
  if c0 == 43 || c0 == 45 {
    i = 1
  }
  let mut int_digits = 0
  while i < n {
    let c = s.code_unit_at(i) & 0xFF
    if c >= 48 && c <= 57 {
      int_digits = int_digits + 1
      i = i + 1
    } else {
      break
    }
  }
  let mut frac_digits = 0
  if i < n && (s.code_unit_at(i) & 0xFF) == 46 {
    i = i + 1
    while i < n {
      let c = s.code_unit_at(i) & 0xFF
      if c >= 48 && c <= 57 {
        frac_digits = frac_digits + 1
        i = i + 1
      } else {
        break
      }
    }
  }
  if int_digits == 0 && frac_digits == 0 {
    return None
  }
  if i < n && ((s.code_unit_at(i) & 0xFF) == 101 || (s.code_unit_at(i) & 0xFF) == 69) {
    i = i + 1
    if i < n && ((s.code_unit_at(i) & 0xFF) == 43 || (s.code_unit_at(i) & 0xFF) == 45) {
      i = i + 1
    }
    let mut exp_digits = 0
    while i < n {
      let c = s.code_unit_at(i) & 0xFF
      if c >= 48 && c <= 57 {
        exp_digits = exp_digits + 1
        i = i + 1
      } else {
        break
      }
    }
    if exp_digits == 0 {
      return None
    }
  }
  if i != n {
    return None
  }
  s.to_double()
}

/// Memory pressure from available / total bytes (<4% critical, <10% high, else normal).
pub fn pressure_of_available(
  available : Option[Double],
  total : Option[Double],
) -> Option[MemoryPressure] {
  match (available, total) {
    (Some(a), Some(t)) => {
      if !(t > 0.0) || !(a >= 0.0) || a > t {
        return None
      }
      let share = a / t
      if share < 0.04 {
        Some(MemoryPressure::Critical)
      } else if share < 0.1 {
        Some(MemoryPressure::High)
      } else {
        Some(MemoryPressure::Normal)
      }
    }
    _ => None
  }
}

/// macOS `kern.memorystatus_vm_pressure_level` (1 normal, 2 warn, 4 critical) refined by available/total.
pub fn pressure_of_level(
  level : String,
  available : Option[Double] = None,
  total : Option[Double] = None,
) -> Option[MemoryPressure] {
  let t = trim_ws(level)
  if t == "1" {
    match pressure_of_available(available, total) {
      Some(p) => Some(p)
      None => Some(MemoryPressure::Normal)
    }
  } else if t == "2" {
    match pressure_of_available(available, total) {
      Some(p) => Some(p)
      None => Some(MemoryPressure::High)
    }
  } else if t == "4" {
    Some(MemoryPressure::Critical)
  } else {
    None
  }
}

pub let SWAPPING_PAGES_PER_SECOND : Double = 256.0

pub fn pressure_of_swap(
  swap_used : Option[Double],
  total : Option[Double],
  out_per_second : Option[Double],
) -> Option[MemoryPressure] {
  match (swap_used, total, out_per_second) {
    (Some(su), Some(t), Some(ops)) => {
      if !(t > 0.0) || !(su >= 0.0) {
        return None
      }
      if ops < SWAPPING_PAGES_PER_SECOND {
        return Some(MemoryPressure::Normal)
      }
      if su >= t / 2.0 {
        Some(MemoryPressure::Critical)
      } else if su >= t / 4.0 {
        Some(MemoryPressure::High)
      } else {
        Some(MemoryPressure::Normal)
      }
    }
    _ => None
  }
}

pub let PSI_FULL_HIGH : Double = 10.0
pub let PSI_FULL_CRITICAL : Double = 20.0
pub let PSI_FULL_SEVERE : Double = 50.0
pub let PSI_TIGHT_SHARE : Double = 0.25

/// Extract `avg10=<float>` from `some ` or `full ` line of `/proc/pressure/*`.
pub fn psi_avg10(text : Option[String], which : String) -> Option[Double] {
  let src = match text {
    Some(s) => s
    None => return None
  }
  let prefix = which + " "
  let lines = split_lines_crlf(src)
  for i in 0..<lines.length() {
    if !lines[i].starts_with(prefix) {
      continue
    }
    let words = split_words(lines[i])
    for j in 0..<words.length() {
      if words[j].starts_with("avg10=") {
        let raw = ops_slice_str(words[j], 6, words[j].length())
        match parse_f64(raw) {
          Some(v) => if v >= 0.0 && v == v { return Some(v) }
          None => ()
        }
      }
    }
  }
  None
}

pub fn pressure_of_memory_psi(
  text : Option[String],
  available : Option[Double] = None,
  total : Option[Double] = None,
) -> Option[MemoryPressure] {
  let full = match psi_avg10(text, "full") {
    Some(v) => v
    None => return None
  }
  if full >= PSI_FULL_SEVERE {
    return Some(MemoryPressure::Critical)
  }
  let tight = match (available, total) {
    (Some(a), Some(t)) =>
    if !(t > 0.0) || !(a >= 0.0) || a > t { true } else { a / t < PSI_TIGHT_SHARE }
    _ => true
  }
  if !tight {
    return Some(MemoryPressure::Normal)
  }
  if full >= PSI_FULL_CRITICAL {
    Some(MemoryPressure::Critical)
  } else if full >= PSI_FULL_HIGH {
    Some(MemoryPressure::High)
  } else {
    Some(MemoryPressure::Normal)
  }
}

/// Extract `Swapouts: <n>.` from `vm_stat` output.
pub fn swapouts_of(vm : Option[String]) -> Option[Int64] {
  let src = match vm {
    Some(s) => s
    None => return None
  }
  field_or_null(src, "Swapouts")
}

/// Extract `used = <mb>M` from `sysctl -n vm.swapusage` in bytes.
pub fn swap_used_of(text : Option[String]) -> Option[Int64] {
  let src = match text {
    Some(s) => s
    None => return None
  }
  let needle = "used = "
  let mut idx = -1
  for i in 0..<src.length() {
    if match_at(src, i, needle) {
      idx = i + needle.length()
      break
    }
  }
  if idx < 0 {
    return None
  }
  let mut end = idx
  while end < src.length() {
    let c = src.code_unit_at(end) & 0xFF
    if (c >= 48 && c <= 57) || c == 46 {
      end = end + 1
    } else {
      break
    }
  }
  if end == idx || end >= src.length() || (src.code_unit_at(end) & 0xFF) != 77 { // 'M'
    return None
  }
  match parse_f64(ops_slice_str(src, idx, end)) {
    Some(mb) => Some((mb * 1048576.0 + 0.5).to_int64())
    None => None
  }
}

pub struct ProcessInfo {
  pub pid : Int
  pub ppid : Int
  pub pgid : Int
  pub bytes : Int64
  pub command : String
}

/// Parse `ps -axo pid=,ppid=,pgid=,rss=,comm=` into `ProcessInfo` records.
pub fn parse_ps(text : String) -> Array[ProcessInfo] {
  let out : Array[ProcessInfo] = []
  let lines = split_lines_crlf(text)
  for i in 0..<lines.length() {
    let line = lines[i]
    let n = line.length()
    let mut pos = 0
    let nums : Array[Int64] = []
    let mut ok = true
    for _ in 0..<4 {
      while pos < n && is_ws_byte(line.code_unit_at(pos) & 0xFF) {
        pos = pos + 1
      }
      let start = pos
      while pos < n && !is_ws_byte(line.code_unit_at(pos) & 0xFF) {
        pos = pos + 1
      }
      match parse_u64(ops_slice_str(line, start, pos)) {
        Some(v) => nums.push(v)
        None => {
          ok = false
          break
        }
      }
    }
    if !ok || nums.length() < 4 {
      continue
    }
    let cmd = trim_ws(ops_slice_str(line, pos, n))
    out.push(ProcessInfo::{
      pid: nums[0].to_int(),
      ppid: nums[1].to_int(),
      pgid: nums[2].to_int(),
      bytes: nums[3] * 1024.to_int64(),
      command: cmd,
    })
  }
  out
}

/// Parse `top -l 1 -stats pid,mem` (`<pid> <num><B|K|M|G|T>[+-]?`).
pub fn parse_top_mem(text : String) -> Map[Int, Int64] {
  let out : Map[Int, Int64] = Map::new()
  let lines = split_lines_crlf(text)
  for i in 0..<lines.length() {
    let words = split_words(lines[i])
    if words.length() != 2 {
      continue
    }
    let pid = match parse_u64(words[0]) {
      Some(v) => v.to_int()
      None => continue
    }
    let mut tok = words[1]
    if tok.length() < 2 {
      continue
    }
    let last = tok.code_unit_at(tok.length() - 1) & 0xFF
    if last == 43 || last == 45 { // '+' or '-'
      tok = ops_slice_str(tok, 0, tok.length() - 1)
    }
    if tok.length() < 2 {
      continue
    }
    let unit_ch = tok.code_unit_at(tok.length() - 1) & 0xFF
    let mult = if unit_ch == 66 { // 'B'
      1.0
    } else if unit_ch == 75 { // 'K'
      1024.0
    } else if unit_ch == 77 { // 'M'
      1048576.0
    } else if unit_ch == 71 { // 'G'
      1073741824.0
    } else if unit_ch == 84 { // 'T'
      1099511627776.0
    } else {
      0.0
    }
    if mult == 0.0 {
      continue
    }
    match parse_f64(ops_slice_str(tok, 0, tok.length() - 1)) {
      Some(num) => out.set(pid, (num * mult + 0.5).to_int64())
      None => ()
    }
  }
  out
}

/// Extract integer after `<label>:` in `vm_stat` or `/proc/meminfo`.
pub fn field_or_null(text : String, label : String) -> Option[Int64] {
  let prefix = label + ":"
  let lines = split_lines_crlf(text)
  for i in 0..<lines.length() {
    let line = lines[i]
    if !line.starts_with(prefix) {
      continue
    }
    let mut rest = trim_ws(ops_slice_str(line, prefix.length(), line.length()))
    while rest.length() > 0 && (rest.code_unit_at(rest.length() - 1) & 0xFF) == 46 {
      rest = ops_slice_str(rest, 0, rest.length() - 1)
    }
    return parse_u64(first_word(rest))
  }
  None
}

/// Parse `/proc/stat` first `cpu ` line into `(busy, total)` ticks (iowait counts as idle).
pub fn proc_stat_ticks(stat_text : String) -> Option[(Int64, Int64)] {
  let lines = split_lines_crlf(stat_text)
  for i in 0..<lines.length() {
    if !lines[i].starts_with("cpu ") {
      continue
    }
    let words = split_words(lines[i])
    let vals : Array[Int64] = []
    let limit = if words.length() > 9 { 9 } else { words.length() }
    for j in 1..<limit {
      match parse_u64(words[j]) {
        Some(v) => vals.push(v)
        None => ()
      }
    }
    if vals.length() < 4 {
      return None
    }
    let mut total : Int64 = 0.to_int64()
    for j in 0..<vals.length() {
      total = total + vals[j]
    }
    let idle = vals[3] + (if vals.length() >= 5 { vals[4] } else { 0.to_int64() })
    return Some((total - idle, total))
  }
  None
}

/// Parse `lsof -Fn` output for addresses listening on `port`.
pub fn parse_lsof(text : String, port : Int) -> Array[String] {
  let found : Array[String] = []
  let lines = split_lines_crlf(text)
  for i in 0..<lines.length() {
    let line = lines[i]
    if !line.starts_with("n") {
      continue
    }
    let name = trim_ws(ops_slice_str(line, 1, line.length()))
    let mut colon = -1
    for k in 0..<name.length() {
      if (name.code_unit_at(k) & 0xFF) == 58 {
        colon = k
      }
    }
    if colon < 0 {
      continue
    }
    let port_str = ops_slice_str(name, colon + 1, name.length())
    match parse_int_strict(port_str) {
      Some(p) => {
        if p != port {
          continue
        }
      }
      None => continue
    }
    let mut addr = ops_slice_str(name, 0, colon)
    if addr.starts_with("[") && addr.ends_with("]") && addr.length() >= 2 {
      addr = ops_slice_str(addr, 1, addr.length() - 1)
    }
    if !arr_contains_str(found, addr) {
      found.push(addr)
    }
  }
  found
}

/// Parse `"HIDIdleTime" = <ns>` from macOS `ioreg` output into milliseconds.
pub fn idle_of_ioreg(text : String) -> Option[Double] {
  let needle = "\"HIDIdleTime\""
  let n = text.length()
  for i in 0..<n {
    if match_at(text, i, needle) {
      let mut p = i + needle.length()
      while p < n && is_ws_byte(text.code_unit_at(p) & 0xFF) {
        p = p + 1
      }
      if p < n && (text.code_unit_at(p) & 0xFF) == 61 { // '='
        p = p + 1
        while p < n && is_ws_byte(text.code_unit_at(p) & 0xFF) {
          p = p + 1
        }
        let start = p
        while p < n {
          let c = text.code_unit_at(p) & 0xFF
          if c >= 48 && c <= 57 {
            p = p + 1
          } else {
            break
          }
        }
        if p > start {
          match parse_u64(ops_slice_str(text, start, p)) {
            Some(ns) => return Some(ns.to_double() / 1000000.0)
            None => ()
          }
        }
      }
    }
  }
  None
}

/// Parse macOS `/sbin/mount` output for non-system mount points.
pub fn parse_mounts(out : String) -> Array[String] {
  let found : Array[String] = []
  let lines = split_lines_crlf(out)
  for i in 0..<lines.length() {
    let line = lines[i]
    let n = line.length()
    if n == 0 || (line.code_unit_at(n - 1) & 0xFF) != 41 { // ')'
      continue
    }
    let mut open_paren = -1
    let mut k = n - 2
    while k >= 0 {
      let c = line.code_unit_at(k) & 0xFF
      if c == 40 { // '('
        open_paren = k
        break
      }
      if c == 41 {
        break
      }
      k = k - 1
    }
    if open_paren < 6 || (line.code_unit_at(open_paren - 1) & 0xFF) != 32 {
      continue
    }
    let before = ops_slice_str(line, 0, open_paren - 1)
    let mut on_pos = -1
    for j in 0..<before.length() {
      if match_at(before, j, " on /") {
        on_pos = j + 4
        break
      }
    }
    if on_pos < 0 {
      continue
    }
    let mp = ops_slice_str(before, on_pos, before.length())
    if mp == "/" || mp == "/dev" || mp.starts_with("/System/Volumes/") {
      continue
    }
    found.push(mp)
  }
  found
}

pub fn is_monoid_station_vm(cmdline : String) -> Bool {
  arr_contains_str(split_words(cmdline), "monoid.vm=station")
}

pub struct Dom0MemAnswer {
  pub boot : Int64
  pub plugged : Int64
  pub max : Int64
}

pub struct MemorySample {
  pub total_bytes : Int64
  pub used_bytes : Int64
  pub swap_used_bytes : Option[Int64]
  pub known : Bool
}

/// Add unplugged dom0 elastic headroom (`max - (boot + plugged)`) to `total_bytes`.
pub fn elastic_memory(mem : MemorySample, answer : Option[Dom0MemAnswer]) -> MemorySample {
  if !mem.known {
    return mem
  }
  match answer {
    None => mem
    Some(a) => {
      if a.boot <= 0.to_int64() || a.plugged < 0.to_int64() {
        return mem
      }
      let held = a.boot + a.plugged
      if a.max <= held {
        return mem
      }
      MemorySample::{
        total_bytes: mem.total_bytes + (a.max - held),
        used_bytes: mem.used_bytes,
        swap_used_bytes: mem.swap_used_bytes,
        known: mem.known,
      }
    }
  }
}

/// CPU busy share in `[0.0, 1.0]` between two `(busy, total)` tick samples, or `None` if `t1 <= t0`.
pub fn cpu_share(b0 : Int64, t0 : Int64, b1 : Int64, t1 : Int64) -> Option[Double] {
  if t1 <= t0 {
    return None
  }
  let db = if b1 > b0 { b1 - b0 } else { 0.to_int64() }
  let share = db.to_double() / (t1 - t0).to_double()
  if share < 0.0 {
    Some(0.0)
  } else if share > 1.0 {
    Some(1.0)
  } else {
    Some(share)
  }
}
