// Group IM (`im/2`) connector: canonical JSON (MoonBit key order), SHA-256
// event IDs, direct-space IDs, Hybrid Logical Clock (`Hlc`), incremental
// `SseLines` parser, `@name` mention matching, space/topic thread routing,
// file sync contract, and `chat_leave` semantics.

import "base_codec"
import "crypto"

pub let GROUP_PROTOCOL_VERSION : Int = 2
pub let GROUP_LOBBY : String = "lobby"
pub let GROUP_ALPN : String = "im/2"
pub let GROUP_SECRET_ALPN : String = "im-secret/1"
pub let GROUP_PING_MS : Int64 = 15000.to_int64()
pub let GROUP_STALE_MS : Int64 = 45000.to_int64()
pub let GROUP_TITLE_MAX_CHARS : Int = 60
pub let GROUP_FILES_MAX : Int = 10

// ---------------------------------------------------------------------------
// Thread / Stream Addressing & Mention / Title Helpers
// ---------------------------------------------------------------------------

pub fn group_thread_of(space : String, topic : String) -> ThreadRef {
  let tts = if topic == GROUP_LOBBY || topic == "" { space } else { topic }
  ThreadRef::new(space, tts)
}

pub fn group_stream_of(thread : ThreadRef) -> (String, String) {
  let topic = if thread.thread_ts == thread.channel { GROUP_LOBBY } else { thread.thread_ts }
  (thread.channel, topic)
}

pub fn group_stream_key(space : String, topic : String) -> String {
  if topic == GROUP_LOBBY || topic == "" {
    space
  } else {
    space + "/" + topic
  }
}

pub fn is_group_space_id(id : String) -> Bool {
  (str_starts_with(id, "d_") || str_starts_with(id, "s_"))
  && is_all_lower_hex(str_slice(id, 2, id.to_bytes().length()), 24)
}

pub fn is_group_topic_id(id : String) -> Bool {
  id == GROUP_LOBBY
  || (str_starts_with(id, "t_") && is_all_lower_hex(str_slice(id, 2, id.to_bytes().length()), 16))
}

fn is_ascii_word_byte(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95
}

/// Case-insensitive `@name` mention check with ASCII word-boundary guard,
/// matching `station/src/group/surface.ts` `mentions`.
pub fn group_mentions(text : String, name : String) -> Bool {
  if name == "" {
    return false
  }
  let hay = str_to_lower_ascii(text)
  let needle = "@" + str_to_lower_ascii(name)
  let hbytes = hay.to_bytes()
  let nlen = needle.to_bytes().length()
  let mut pos = 0
  while pos <= hbytes.length() {
    let idx = str_index_of(hay, needle, pos)
    if idx < 0 {
      return false
    }
    let left_ok = idx == 0 || !is_ascii_word_byte(hbytes[idx - 1].to_int() & 0xFF)
    let after = idx + nlen
    let right_ok = after >= hbytes.length() || !is_ascii_word_byte(hbytes[after].to_int() & 0xFF)
    if left_ok && right_ok {
      return true
    }
    pos = idx + 1
  }
  false
}

/// Sanitizes a topic title (replaces ASCII control chars with spaces, trims,
/// caps at 60 code points).
pub fn group_topic_title(title : String) -> String {
  let raw = title.to_bytes()
  let sb = StringBuilder::new()
  for i in 0..<raw.length() {
    let b = raw[i].to_int() & 0xFF
    if b < 0x20 {
      sb.write_byte(32 as Byte)
    } else if b == 0x7F {
      // skip DEL
    } else {
      sb.write_byte(raw[i])
    }
  }
  let trimmed = str_trim(sb.to_string())
  let cps = utf8_code_points(trimmed)
  if cps.length() > GROUP_TITLE_MAX_CHARS {
    str_trim(join_cps(cps, 0, GROUP_TITLE_MAX_CHARS))
  } else {
    trimmed
  }
}

// ---------------------------------------------------------------------------
// Canonical JSON (MoonBit key order), Event ID, Direct Space ID & HLC
// ---------------------------------------------------------------------------

/// MoonBit `String::compare` order: shorter string first, then lexicographical.
pub fn moon_order(a : String, b : String) -> Int {
  let ab = a.to_bytes()
  let bb = b.to_bytes()
  if ab.length() != bb.length() {
    return if ab.length() < bb.length() { -1 } else { 1 }
  }
  for i in 0..<ab.length() {
    let ca = ab[i].to_int() & 0xFF
    let cb = bb[i].to_int() & 0xFF
    if ca != cb {
      return if ca < cb { -1 } else { 1 }
    }
  }
  0
}

fn write_canon_string(sb : StringBuilder, s : String) -> Unit {
  let hex = "0123456789abcdef".to_bytes()
  sb.write_byte(34 as Byte)
  let raw = s.to_bytes()
  for i in 0..<raw.length() {
    let b = raw[i].to_int() & 0xFF
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b < 0x20 {
      sb.write_string("\\u00")
      sb.write_byte(hex[(b >> 4) & 0xF])
      sb.write_byte(hex[b & 0xF])
    } else {
      sb.write_byte(raw[i])
    }
  }
  sb.write_byte(34 as Byte)
}

fn write_canon_json(sb : StringBuilder, j : base_codec::Json) -> Unit {
  match j {
    base_codec::Json::Null => sb.write_string("null")
    base_codec::Json::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    base_codec::Json::Num(n, repr) => {
      if repr != "" {
        sb.write_string(repr)
      } else {
        sb.write_string(n.to_int64().to_string())
      }
    }
    base_codec::Json::Str(s) => write_canon_string(sb, s)
    base_codec::Json::Arr(items) => {
      sb.write_string("[")
      for i in 0..<items.length() {
        if i > 0 {
          sb.write_string(",")
        }
        write_canon_json(sb, items[i])
      }
      sb.write_string("]")
    }
    base_codec::Json::Obj(fields) => {
      // Insertion-sort keys by `moon_order`.
      let sorted : Array[(String, base_codec::Json)] = []
      for i in 0..<fields.length() {
        sorted.push(fields[i])
      }
      for i in 1..<sorted.length() {
        let cur = sorted[i]
        let mut j_idx = i - 1
        while j_idx >= 0 && moon_order(sorted[j_idx].0, cur.0) > 0 {
          sorted[j_idx + 1] = sorted[j_idx]
          j_idx = j_idx - 1
        }
        sorted[j_idx + 1] = cur
      }
      sb.write_string("{")
      for i in 0..<sorted.length() {
        if i > 0 {
          sb.write_string(",")
        }
        write_canon_string(sb, sorted[i].0)
        sb.write_string(":")
        write_canon_json(sb, sorted[i].1)
      }
      sb.write_string("}")
    }
  }
}

pub fn group_canonical_json(j : base_codec::Json) -> String {
  let sb = StringBuilder::new()
  write_canon_json(sb, j)
  sb.to_string()
}

pub fn group_event_id(unsigned_event : base_codec::Json) -> String {
  crypto::sha256_hex(group_canonical_json(unsigned_event).to_bytes())
}

pub fn group_direct_id(a : String, b : String) -> String {
  let pair = if moon_order(a, b) < 0 { a + "|" + b } else { b + "|" + a }
  let digest = crypto::sha256_hex(("im/2 direct " + pair).to_bytes())
  "d_" + str_slice(digest, 0, 24)
}

pub struct Hlc {
  pub mut ms : Int64
  pub mut n : Int64
}

pub fn Hlc::new() -> Hlc {
  Hlc::{ ms: 0.to_int64(), n: 0.to_int64() }
}

pub fn Hlc::next(self : Hlc, wall_ms : Int64) -> (Int64, Int64) {
  if wall_ms > self.ms {
    self.ms = wall_ms
    self.n = 0.to_int64()
  } else {
    self.n = self.n + 1.to_int64()
  }
  (self.ms, self.n)
}

pub fn Hlc::saw(self : Hlc, ms : Int64, n : Int64) -> Unit {
  if ms > self.ms || (ms == self.ms && n > self.n) {
    self.ms = ms
    self.n = n
  }
}

// ---------------------------------------------------------------------------
// Incremental SSE Parser (`SseLines`, aligned with `station/src/group/link.ts`)
// ---------------------------------------------------------------------------

pub struct SseEvent {
  pub event : String
  pub data : String
  pub id : Option[String]
}

pub struct SseLines {
  mut carry : String
}

pub fn SseLines::new() -> SseLines {
  SseLines::{ carry: "" }
}

pub fn SseLines::feed(self : SseLines, chunk : String) -> Array[SseEvent] {
  self.carry = self.carry + chunk
  let out : Array[SseEvent] = []
  while true {
    let end = str_index_of(self.carry, "\n\n", 0)
    if end < 0 {
      break
    }
    let block = str_slice(self.carry, 0, end)
    self.carry = str_slice(self.carry, end + 2, self.carry.to_bytes().length())
    let mut ev = ""
    let data_lines : Array[String] = []
    let mut ev_id : Option[String] = None
    let lines = str_split(block, "\n")
    for i in 0..<lines.length() {
      let line = lines[i]
      if str_starts_with(line, ":") {
        continue
      }
      let colon = str_index_of(line, ":", 0)
      let (field, fval) = if colon < 0 {
        (line, "")
      } else {
        let f = str_slice(line, 0, colon)
        let raw_v = str_slice(line, colon + 1, line.to_bytes().length())
        let v = if str_starts_with(raw_v, " ") {
          str_slice(raw_v, 1, raw_v.to_bytes().length())
        } else {
          raw_v
        }
        (f, v)
      }
      if field == "event" {
        ev = fval
      } else if field == "data" {
        data_lines.push(fval)
      } else if field == "id" {
        ev_id = Some(fval)
      }
    }
    if ev == "" && data_lines.length() > 0 {
      ev = "message"
    }
    let has_id = match ev_id {
      Some(_) => true
      None => false
    }
    if ev != "" || has_id {
      let sb = StringBuilder::new()
      for i in 0..<data_lines.length() {
        if i > 0 {
          sb.write_string("\n")
        }
        sb.write_string(data_lines[i])
      }
      out.push(SseEvent::{ event: ev, data: sb.to_string(), id: ev_id })
    }
  }
  out
}

// ---------------------------------------------------------------------------
// Group IM Connector (space cursors, gap sync, event folding, `chat_leave`)
// ---------------------------------------------------------------------------

pub struct GroupSpace {
  pub id : String
  pub direct : Bool
  pub mut name : String
}

pub struct GroupConnector {
  pub connect_id : String
  pub anchor_url : String
  pub bearer_token : String
  pub mut bot_user_id : String
  pub mut bot_name : String
  pub mut hlc : Hlc
  pub mut sse : SseLines
  pub mut machine : SocketMachine
  pub mut dedupe : InboundDedupe
  mut spaces : Map[String, GroupSpace]
  mut cursors : Map[String, Int64]
  mut left_streams : Map[String, Bool]
}

pub fn GroupConnector::new(
  connect_id : String,
  anchor_url : String,
  bearer_token : String,
  bot_user_id : String,
  bot_name : String,
  ping_ms : Int64 = GROUP_PING_MS,
  stale_ms : Int64 = GROUP_STALE_MS,
) -> GroupConnector {
  GroupConnector::{
    connect_id: connect_id,
    anchor_url: anchor_url,
    bearer_token: bearer_token,
    bot_user_id: bot_user_id,
    bot_name: bot_name,
    hlc: Hlc::new(),
    sse: SseLines::new(),
    machine: SocketMachine::new("group", ReconnectPolicy::new(ping_ms, stale_ms)),
    dedupe: InboundDedupe::new(),
    spaces: Map::new(),
    cursors: Map::new(),
    left_streams: Map::new(),
  }
}

pub fn GroupConnector::register_space(
  self : GroupConnector,
  id : String,
  direct : Bool,
  name : String,
) -> Unit {
  self.spaces.set(id, GroupSpace::{ id: id, direct: direct, name: name })
}

pub fn GroupConnector::cursor(self : GroupConnector, space : String) -> Int64 {
  match self.cursors.get(space) {
    Some(c) => c
    None => 0.to_int64()
  }
}

/// `chat_leave` on a Group stream: stops following the thread until the next
/// explicit `@mention`, while staying a member of the space.
pub fn GroupConnector::leave_thread(self : GroupConnector, thread : ThreadRef) -> Unit {
  let (space, topic) = group_stream_of(thread)
  self.left_streams.set(group_stream_key(space, topic), true)
}

pub fn GroupConnector::is_thread_left(self : GroupConnector, thread : ThreadRef) -> Bool {
  let (space, topic) = group_stream_of(thread)
  match self.left_streams.get(group_stream_key(space, topic)) {
    Some(v) => v
    None => false
  }
}

pub enum GroupStep {
  NoOp
  NeedSync(String, Int64)
  Event(ChatEvent)
  LeftSpace(String)
  DuplicateIgnored(String)
}

/// Processes one decoded SSE event from the Group anchor (`event`, `space`,
/// `left`, `stop`). Enforces per-space monotonic `aseq`, signals `NeedSync`
/// on gaps, folds `msg.post`/`decision.ask`/`msg.edit`/`decision.resolve`,
/// and enforces `chat_leave` until re-mentioned.
pub fn GroupConnector::take_sse(
  self : GroupConnector,
  sse_ev : SseEvent,
  now_ms : Int64,
) -> GroupStep {
  self.machine.on_heard(now_ms)
  let told = match base_codec::json_parse(sse_ev.data) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(_) => return GroupStep::NoOp
  }
  if sse_ev.event == "space" {
    let sid = json_str_field(told, "id")
    if sid != "" {
      let direct = json_str_field(told, "kind") == "direct"
      self.register_space(sid, direct, json_str_field(told, "name"))
    }
    return GroupStep::NoOp
  }
  if sse_ev.event == "left" {
    let sid = json_str_field(told, "space")
    if sid != "" {
      self.spaces.remove(sid)
      self.cursors.remove(sid)
      return GroupStep::LeftSpace(sid)
    }
    return GroupStep::NoOp
  }
  if sse_ev.event == "stop" {
    let space = json_str_field(told, "space")
    let target = json_str_field(told, "target")
    if space == "" || (target != "" && target != self.bot_user_id) {
      return GroupStep::NoOp
    }
    let topic_raw = json_str_field(told, "topic")
    let topic = if topic_raw != "" { topic_raw } else { GROUP_LOBBY }
    let thread = group_thread_of(space, topic)
    let ts_raw = json_str_field(told, "message_ts")
    let ts = if ts_raw != "" { ts_raw } else { now_ms.to_string() }
    return GroupStep::Event(ChatEvent::Stop(thread.channel, thread.thread_ts, ts, None))
  }
  if sse_ev.event != "event" {
    return GroupStep::NoOp
  }

  let stamped = match base_codec::json_get(told, "stamped") {
    Some(s) => s
    None => return GroupStep::NoOp
  }
  let aseq = match json_int64_field(stamped, "aseq") {
    Some(v) => v
    None => return GroupStep::NoOp
  }
  let ev = match base_codec::json_get(stamped, "event") {
    Some(e) => e
    None => return GroupStep::NoOp
  }
  let space = json_str_field(ev, "space")
  if aseq < 1.to_int64() || space == "" {
    return GroupStep::NoOp
  }
  let cur = self.cursor(space)
  if aseq <= cur {
    return GroupStep::DuplicateIgnored("group:" + space + "#" + aseq.to_string())
  }
  if aseq > cur + 1.to_int64() {
    return GroupStep::NeedSync(space, cur)
  }
  self.cursors.set(space, aseq)

  let author = json_str_field(ev, "author")
  if author == self.bot_user_id {
    return GroupStep::NoOp
  }
  let topic_raw = json_str_field(ev, "topic")
  let topic = if topic_raw != "" { topic_raw } else { GROUP_LOBBY }
  let thread = group_thread_of(space, topic)
  let stream = group_stream_key(space, topic)
  let kind = json_str_field(ev, "kind")
  let body = match base_codec::json_get(ev, "body") {
    Some(b) => b
    None => base_codec::json_obj([])
  }

  if kind == "msg.post" || kind == "decision.ask" {
    let words = json_str_field(body, "text")
    let is_direct = match self.spaces.get(space) {
      Some(sp) => sp.direct
      None => str_starts_with(space, "d_")
    }
    let addressed = is_direct || group_mentions(words, self.bot_name)
    match self.left_streams.get(stream) {
      Some(true) => {
        if !addressed {
          return GroupStep::NoOp
        }
        self.left_streams.remove(stream)
      }
      _ => {}
    }
    let files : Array[InboundFile] = []
    match base_codec::json_get(body, "files") {
      Some(base_codec::Json::Arr(farr)) => {
        for i in 0..<farr.length() {
          let f = farr[i]
          let sha = json_str_field(f, "sha256")
          if is_all_lower_hex(sha, 64) {
            let fname = json_str_field(f, "name")
            let fsize = match json_int64_field(f, "size") {
              Some(v) => v
              None => 0.to_int64()
            }
            files.push(
              InboundFile::{
                id: sha,
                name: if fname != "" { fname } else { sha },
                size: fsize,
                url: Some(space + "/" + sha),
              },
            )
          }
        }
      }
      _ => {}
    }
    let dedupe_key = "group:" + space + "#" + aseq.to_string()
    if !self.dedupe.accept(dedupe_key, now_ms) {
      return GroupStep::DuplicateIgnored(dedupe_key)
    }
    return GroupStep::Event(
      ChatEvent::Message(
        InboundMessage::{
          channel: thread.channel,
          thread_ts: thread.thread_ts,
          ts: aseq.to_string(),
          user: author,
          text: words,
          addressed: addressed,
          files: files,
          quoted: None,
        },
      ),
    )
  }

  if kind == "msg.edit" {
    let target = json_str_field(body, "target")
    if target == "" {
      return GroupStep::NoOp
    }
    return GroupStep::Event(
      ChatEvent::Changed(thread.channel, thread.thread_ts, target, json_str_field(body, "text")),
    )
  }

  if kind == "decision.resolve" {
    let choice = json_str_field(body, "choice")
    return GroupStep::Event(
      ChatEvent::Message(
        InboundMessage::{
          channel: thread.channel,
          thread_ts: thread.thread_ts,
          ts: aseq.to_string(),
          user: author,
          text: choice,
          addressed: true,
          files: [],
          quoted: None,
        },
      ),
    )
  }

  GroupStep::NoOp
}

/// Builds an authenticated HTTP request to post a message event to the Group
/// anchor (`POST /spaces/<space>/events`), uploading any files first via
/// `PUT /spaces/<space>/files/<sha256>`.
pub fn GroupConnector::post_message(
  self : GroupConnector,
  transport : ConnectTransport,
  thread : ThreadRef,
  markdown : String,
  files : Array[OutboundFile] = [],
) -> Result[String, String] {
  if files.length() > GROUP_FILES_MAX {
    return Err("group post carries at most " + GROUP_FILES_MAX.to_string() + " files")
  }
  let (space, topic) = group_stream_of(thread)
  let file_refs : Array[base_codec::Json] = []
  for i in 0..<files.length() {
    let f = files[i]
    let sha = crypto::sha256_hex(f.bytes)
    let up_req = HttpRequest::new(
      "PUT",
      self.anchor_url + "/spaces/" + url_encode_component(space) + "/files/" + sha,
      [
        ("authorization", "Bearer " + self.bearer_token),
        ("content-type", "application/octet-stream"),
      ],
      Some(f.bytes),
      60000.to_int64(),
    )
    let up_resp = (transport.fetch)(up_req)
    match up_resp.error {
      Some(e) => return Err("group file upload: " + e)
      None => {}
    }
    if up_resp.status < 200 || up_resp.status >= 300 {
      return Err("group file upload: HTTP " + up_resp.status.to_string())
    }
    file_refs.push(
      base_codec::json_obj([
        ("sha256", base_codec::json_str(sha)),
        ("name", base_codec::json_str(f.name)),
        ("mime", base_codec::json_str(f.mime)),
        ("size", base_codec::json_int(f.bytes.length())),
      ]),
    )
  }

  let adapted = adapt_markdown(ConnectPlatform::Group, markdown)
  let (hlc_ms, hlc_n) = self.hlc.next((transport.now_ms)())
  let body = base_codec::json_stringify(
    base_codec::json_obj([
      ("v", base_codec::json_int(GROUP_PROTOCOL_VERSION)),
      ("space", base_codec::json_str(space)),
      ("topic", base_codec::json_str(topic)),
      ("kind", base_codec::json_str("msg.post")),
      ("hlc", base_codec::json_arr([base_codec::json_int64(hlc_ms), base_codec::json_int64(hlc_n)])),
      (
        "body",
        base_codec::json_obj([
          ("text", base_codec::json_str(adapted)),
          ("files", base_codec::json_arr(file_refs)),
        ]),
      ),
    ]),
  )
  let req = HttpRequest::new(
    "POST",
    self.anchor_url + "/spaces/" + url_encode_component(space) + "/events",
    [
      ("authorization", "Bearer " + self.bearer_token),
      ("content-type", "application/json; charset=utf-8"),
    ],
    Some(body.to_bytes()),
    30000.to_int64(),
  )
  let resp = (transport.fetch)(req)
  match resp.error {
    Some(e) => return Err("group post: " + e)
    None => {}
  }
  if resp.status < 200 || resp.status >= 300 {
    return Err("group post: HTTP " + resp.status.to_string())
  }
  match base_codec::json_parse(bytes_to_string(resp.body)) {
    base_codec::JsonParseResult::Ok(j) => {
      match json_int64_field(j, "aseq") {
        Some(aseq) => Ok(aseq.to_string())
        None => Ok(hlc_ms.to_string())
      }
    }
    base_codec::JsonParseResult::Err(e) => Err("group post: invalid json (" + e + ")")
  }
}
