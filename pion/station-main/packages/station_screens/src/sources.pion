    "ControlLeft" => Some(0x3b)
    "ShiftRight" => Some(0x3c)
    "AltRight" => Some(0x3d)
    "ControlRight" => Some(0x3e)
    "Fn" => Some(0x3f)
    "F17" => Some(0x40)
