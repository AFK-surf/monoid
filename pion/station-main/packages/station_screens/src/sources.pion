pub struct ViewOptions {
  pub max_width : Int
  pub max_height : Int
  pub codecs : Array[Codec]
  pub peek : Bool
  pub agent : Bool
  pub bitrate : Option[Int]
  pub fps : Option[Int]
  pub fit : Option[ViewFit]
  pub audio : Bool
  pub opus : Bool
  pub gamut_p3 : Bool
  pub passkeys : Bool
  pub chroma_444 : Bool
  pub quality : Option[String]
  pub gamepad_mouse : Bool
}

pub fn ViewOptions::default(codecs : Array[Codec]) -> ViewOptions {
  ViewOptions::{
    max_width: 1920,
    max_height: 1080,
    codecs: codecs,
    peek: false,
    agent: false,
    bitrate: None,
    fps: None,
    fit: None,
    audio: false,
    opus: false,
    gamut_p3: false,
    passkeys: false,
    chroma_444: false,
    quality: None,
    gamepad_mouse: false,
  }
}

fn codecs_has(list : Array[Codec], target : Codec) -> Bool {
  for i in 0..<list.length() {
    if codec_eq(list[i], target) {
      return true
    }
  }
  false
}

/// First codec in `own` accepted by `options`; for `peek`, prefers JPEG if both support it.
pub fn codec_for(options : ViewOptions, own : Array[Codec]) -> Option[Codec] {
  if options.peek && codecs_has(own, Codec::Jpeg) && codecs_has(options.codecs, Codec::Jpeg) {
    return Some(Codec::Jpeg)
  }
  for i in 0..<own.length() {
    if codecs_has(options.codecs, own[i]) {
      return Some(own[i])
    }
  }
  None
}

fn clamp_d(v : Double, lo : Double, hi : Double) -> Double {
  if v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

fn round4(n : Double) -> Double {
  let scaled = n * 10000.0
  let r = if scaled >= 0.0 { (scaled + 0.5).to_int64() } else { (scaled - 0.5).to_int64() }
  r.to_double() / 10000.0
}

fn is_finite_d(v : Double) -> Bool {
  v == v && v > -1.0e308 && v < 1.0e308
}

/// Validates and clamps a screen sub-region; returns None for invalid inputs or whole-screen regions.
pub fn region_of(x_in : Double, y_in : Double, w_in : Double, h_in : Double) -> Option[Region] {
  if !is_finite_d(x_in) || !is_finite_d(y_in) || !is_finite_d(w_in) || !is_finite_d(h_in) {
    return None
  }
  let w = clamp_d(w_in, LOOK_LEAST, 1.0)
  let h = clamp_d(h_in, LOOK_LEAST, 1.0)
  if w >= LOOK_WHOLE && h >= LOOK_WHOLE {
    return None
  }
  let x = clamp_d(x_in, 0.0, 1.0 - w)
  let y = clamp_d(y_in, 0.0, 1.0 - h)
  Some(Region::{ x: round4(x), y: round4(y), w: round4(w), h: round4(h) })
}

pub enum ClipType {
  Text
  Png
}

pub fn clip_type_name(t : ClipType) -> String {
  match t {
    ClipType::Text => "text"
    ClipType::Png => "png"
  }
}

pub enum ClipPrivacy {
  Concealed
  Transient
  Auto
}

pub fn privacy_code(p : Option[ClipPrivacy]) -> Int {
  match p {
    None => 0
    Some(ClipPrivacy::Concealed) => 1
    Some(ClipPrivacy::Transient) => 2
    Some(ClipPrivacy::Auto) => 3
  }
}

pub fn privacy_of(code : Int) -> Option[ClipPrivacy] {
  if code == 1 {
    Some(ClipPrivacy::Concealed)
  } else if code == 2 {
    Some(ClipPrivacy::Transient)
  } else if code == 3 {
    Some(ClipPrivacy::Auto)
  } else {
    None
  }
}

pub enum ClipPayload {
  Text(String)
  Png(Bytes)
}

pub struct Clip {
  pub payload : ClipPayload
  pub privacy : Option[ClipPrivacy]
}

pub fn clip_fits(clip : Clip) -> Bool {
  match clip.payload {
    ClipPayload::Text(s) => s.length() > 0 && s.length() <= CLIP_TEXT_MAX
    ClipPayload::Png(b) => b.length() > 0 && b.length() <= CLIP_PNG_MAX
  }
}

/// Wire frame kind for clipboard forwarding (`station/src/screens/AGENTS.md`):
/// - Public clip -> kind 4 (`clipboard`), never changes first byte.
/// - Private clip -> kind 9 (`privateClipboard`) ONLY when client asked `private_clip`.
/// - Private clip when client does NOT support `private_clip` -> None (dropped, never downgraded).
pub struct ClipWireDecision {
  pub kind : Int
  pub privacy_bits : Int
}

pub fn clip_wire_decision(clip : Clip, client_supports_private : Bool) -> Option[ClipWireDecision] {
  let code = privacy_code(clip.privacy)
  if code == 0 {
    return Some(ClipWireDecision::{ kind: 4, privacy_bits: 0 })
  }
  if !client_supports_private {
    return None
  }
  Some(ClipWireDecision::{ kind: 9, privacy_bits: code << 1 })
}

pub struct ScreenCursor {
  pub x : Double
  pub y : Double
  pub shape : String
}

/// Validates CSS cursor name (`[a-z-]{1,24}`) or `custom:<16 lowercase hex>`.
pub fn is_valid_cursor_shape(shape : String) -> Bool {
  let n = shape.length()
  if shape.starts_with("custom:") {
    if n != 23 {
      return false
    }
    for i in 7..<23 {
      let c = shape.code_unit_at(i) & 0xFF
      let hex = (c >= 48 && c <= 57) || (c >= 97 && c <= 102)
      if !hex {
        return false
      }
    }
    return true
  }
  if n < 1 || n > 24 {
    return false
  }
  for i in 0..<n {
    let c = shape.code_unit_at(i) & 0xFF
    let ok = (c >= 97 && c <= 122) || c == 45
    if !ok {
      return false
    }
  }
  true
}

/// Extracts `custom:<id>` from a helper cursor image payload (`w,h,hx,hy` + 16 hex + PNG signature).
pub fn cursor_image_shape(payload : Bytes) -> Option[String] {
  let n = payload.length()
  if n < 28 || n > 20 + CURSOR_PNG_MAX {
    return None
  }
  let w = payload[0].to_int() & 0xFF
  let h = payload[1].to_int() & 0xFF
  let hx = payload[2].to_int() & 0xFF
  let hy = payload[3].to_int() & 0xFF
  if w < 1 || w > 128 || h < 1 || h > 128 || hx > w || hy > h {
    return None
  }
  let sb = StringBuilder::new()
  sb.write_string("custom:")
  for i in 4..<20 {
    let c = payload[i].to_int() & 0xFF
    let hex = (c >= 48 && c <= 57) || (c >= 97 && c <= 102)
    if !hex {
      return None
    }
    sb.write_byte(c as Byte)
  }
  let sig : Array[Int] = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]
  for i in 0..<8 {
    if (payload[20 + i].to_int() & 0xFF) != sig[i] {
      return None
    }
  }
  Some(sb.to_string())
}

/// Validates `^u_[0-9a-f]{12}$`.
pub fn is_user_tab_id(id : String) -> Bool {
  if id.length() != 14 || !id.starts_with("u_") {
    return false
  }
  for i in 2..<14 {
    let c = id.code_unit_at(i) & 0xFF
    let hex = (c >= 48 && c <= 57) || (c >= 97 && c <= 102)
    if !hex {
      return false
    }
  }
  true
}

pub struct ScreenWindow {
  pub id : Int
  pub app : String
  pub title : String
}

pub struct ScreenWindows {
  pub windows : Array[ScreenWindow]
  pub window : Option[Int]
}

fn str_cut(s : String, max_len : Int) -> String {
  station_ops::utf8_truncate(s, max_len)
}

pub fn windows_of_json(v : base_codec::Json) -> Array[ScreenWindow] {
  let out : Array[ScreenWindow] = []
  match v {
    base_codec::Json::Arr(items) => {
      for i in 0..<items.length() {
        if out.length() >= WINDOWS_MOST {
          break
        }
        let item = items[i]
        let id = match base_codec::json_get(item, "id") {
          Some(base_codec::Json::Num(d, _)) => {
            let iv = d.to_int()
            if iv > 0 && iv.to_double() == d { iv } else { -1 }
          }
          _ => -1
        }
        if id <= 0 {
          continue
        }
        let app = match base_codec::json_get(item, "app") {
          Some(base_codec::Json::Str(s)) => str_cut(s, WINDOW_WORDS_MOST)
          _ => ""
        }
        let title = match base_codec::json_get(item, "title") {
          Some(base_codec::Json::Str(s)) => str_cut(s, WINDOW_WORDS_MOST)
          _ => ""
        }
        out.push(ScreenWindow::{ id: id, app: app, title: title })
      }
    }
    _ => ()
  }
  out
}

pub struct ScreenSize {
  pub width : Int
  pub height : Int
}

pub struct ScreenResolution {
  pub width : Int
  pub height : Int
  pub modes : Array[ScreenSize]
}

fn valid_dim(v : Option[base_codec::Json]) -> Option[Int] {
  match v {
    Some(base_codec::Json::Num(d, _)) => {
      let iv = d.to_int()
      if iv > 0 && iv <= 16384 && iv.to_double() == d { Some(iv) } else { None }
    }
    _ => None
  }
}

pub fn resolution_of_json(v : base_codec::Json) -> Option[ScreenResolution] {
  let w = match valid_dim(base_codec::json_get(v, "width")) {
    Some(x) => x
    None => return None
  }
  let h = match valid_dim(base_codec::json_get(v, "height")) {
    Some(x) => x
    None => return None
  }
  let modes : Array[ScreenSize] = []
  match base_codec::json_get(v, "modes") {
    Some(base_codec::Json::Arr(arr)) => {
      for i in 0..<arr.length() {
        let mw = match valid_dim(base_codec::json_get(arr[i], "width")) {
          Some(x) => x
          None => return None
        }
        let mh = match valid_dim(base_codec::json_get(arr[i], "height")) {
          Some(x) => x
          None => return None
        }
        modes.push(ScreenSize::{ width: mw, height: mh })
      }
    }
    _ => return None
  }
  Some(ScreenResolution::{ width: w, height: h, modes: modes })
}

