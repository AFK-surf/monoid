    "NumpadSubtract" => Some(0x4e)
    "F18" => Some(0x4f)
    "F19" => Some(0x50)
    "NumpadEqual" => Some(0x51)
    "Numpad0" => Some(0x52)
    "Numpad1" => Some(0x53)
    "Numpad2" => Some(0x54)
