pub enum PointerKind {
  Down
  Up
  Move
}

pub enum KeyKind {
  Down
  Up
}

pub struct GamepadState {
  pub index : Int
  pub connected : Bool
  pub buttons : Int
  pub lx : Double
  pub ly : Double
  pub rx : Double
  pub ry : Double
  pub lt : Double
  pub rt : Double
}

pub fn gamepad_released(index : Int) -> GamepadState {
  GamepadState::{
    index: index,
    connected: false,
    buttons: 0,
    lx: 0.0,
    ly: 0.0,
    rx: 0.0,
    ry: 0.0,
    lt: 0.0,
    rt: 0.0,
  }
}

pub enum ScreenInput {
  Pointer(PointerKind, Double, Double, Int, Option[Double], Option[Double], Bool)
  Wheel(Double, Double, Double, Double)
  Key(KeyKind, String, String, Int)
  Text(String)
  Pose(String)
  Device(String)
  Button(Int, Int, Bool)
  Gamepad(GamepadState)
  GamepadMode(Bool)
}

fn lowest_bit(bits : Int) -> Int {
  bits & (0 - bits)
}

fn button_of_bit(bit : Int) -> Int {
  if bit == 1 {
    0
  } else if bit == 2 {
    2
  } else if bit == 4 {
    1
  } else {
    0
  }
}

fn is_single_codepoint(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let b0 = s.code_unit_at(0) & 0xFF
  let expected = if b0 < 0x80 {
    1
  } else if (b0 & 0xE0) == 0xC0 {
    2
  } else if (b0 & 0xF0) == 0xE0 {
    3
  } else if (b0 & 0xF8) == 0xF0 {
    4
  } else {
    1
  }
  n == expected
}

// ---------------------------------------------------------------------------
// macOS Input (`station/src/screens/mac-input.ts`)
// ---------------------------------------------------------------------------

pub let MAC_FLAG_ALT : Int = 0x80000
pub let MAC_FLAG_CTRL : Int = 0x40000
pub let MAC_FLAG_COMMAND : Int = 0x100000
pub let MAC_FLAG_SHIFT : Int = 0x20000
pub let MAC_FLAG_NUMERIC_PAD : Int = 0x200000
pub let MAC_FLAG_FN : Int = 0x800000
pub let MAC_CLICK_MS : Int64 = 500.to_int64()
pub let MAC_CLICK_NEAR : Double = 0.01

fn is_key_end(code : String) -> Bool {
  code.length() == 3 && (code.code_unit_at(0) & 0xFF) == 69 && (code.code_unit_at(1) & 0xFF) == 110 && (code.code_unit_at(2) & 0xFF) == 100
}

pub fn mac_flags_of(mods : Int) -> Int {
  let mut f = 0
  if (mods & 1) != 0 { f = f | MAC_FLAG_ALT }
  if (mods & 2) != 0 { f = f | MAC_FLAG_CTRL }
  if (mods & 4) != 0 { f = f | MAC_FLAG_COMMAND }
  if (mods & 8) != 0 { f = f | MAC_FLAG_SHIFT }
  f
}

pub fn mac_keycode_of(code : String) -> Option[Int] {
  match code {
    "KeyA" => Some(0x00)
    "KeyS" => Some(0x01)
    "KeyD" => Some(0x02)
    "KeyF" => Some(0x03)
    "KeyH" => Some(0x04)
    "KeyG" => Some(0x05)
    "KeyZ" => Some(0x06)
    "KeyX" => Some(0x07)
    "KeyC" => Some(0x08)
    "KeyV" => Some(0x09)
    "IntlBackslash" => Some(0x0a)
    "KeyB" => Some(0x0b)
    "KeyQ" => Some(0x0c)
    "KeyW" => Some(0x0d)
    "KeyE" => Some(0x0e)
    "KeyR" => Some(0x0f)
    "KeyY" => Some(0x10)
    "KeyT" => Some(0x11)
    "Digit1" => Some(0x12)
    "Digit2" => Some(0x13)
    "Digit3" => Some(0x14)
    "Digit4" => Some(0x15)
    "Digit6" => Some(0x16)
    "Digit5" => Some(0x17)
    "Equal" => Some(0x18)
    "Digit9" => Some(0x19)
    "Digit7" => Some(0x1a)
    "Minus" => Some(0x1b)
    "Digit8" => Some(0x1c)
    "Digit0" => Some(0x1d)
    "BracketRight" => Some(0x1e)
    "KeyO" => Some(0x1f)
    "KeyU" => Some(0x20)
    "BracketLeft" => Some(0x21)
    "KeyI" => Some(0x22)
    "KeyP" => Some(0x23)
    "Enter" => Some(0x24)
    "KeyL" => Some(0x25)
    "KeyJ" => Some(0x26)
    "Quote" => Some(0x27)
    "KeyK" => Some(0x28)
    "Semicolon" => Some(0x29)
    "Backslash" => Some(0x2a)
    "Comma" => Some(0x2b)
    "Slash" => Some(0x2c)
    "KeyN" => Some(0x2d)
    "KeyM" => Some(0x2e)
    "Period" => Some(0x2f)
    "Tab" => Some(0x30)
    "Space" => Some(0x31)
    "Backquote" => Some(0x32)
    "Backspace" => Some(0x33)
    "Escape" => Some(0x35)
