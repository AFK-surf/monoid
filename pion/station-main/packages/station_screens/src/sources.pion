// Windows Input (`station/src/screens/win-input.ts`)
// ---------------------------------------------------------------------------

pub let WIN_WHEEL_PER_PIXEL : Double = 1.2

pub struct WinKeySpec {
  pub scan : Int
  pub ext : Bool
  pub vk : Int
}

pub fn win_key_of(code : String) -> Option[WinKeySpec] {
  match code {
    "Escape" => Some(WinKeySpec::{ scan: 0x01, ext: false, vk: 0 })
    "Digit1" => Some(WinKeySpec::{ scan: 0x02, ext: false, vk: 0 })
    "Digit2" => Some(WinKeySpec::{ scan: 0x03, ext: false, vk: 0 })
    "Digit3" => Some(WinKeySpec::{ scan: 0x04, ext: false, vk: 0 })
    "Digit4" => Some(WinKeySpec::{ scan: 0x05, ext: false, vk: 0 })
    "Digit5" => Some(WinKeySpec::{ scan: 0x06, ext: false, vk: 0 })
    "Digit6" => Some(WinKeySpec::{ scan: 0x07, ext: false, vk: 0 })
    "Digit7" => Some(WinKeySpec::{ scan: 0x08, ext: false, vk: 0 })
    "Digit8" => Some(WinKeySpec::{ scan: 0x09, ext: false, vk: 0 })
    "Digit9" => Some(WinKeySpec::{ scan: 0x0a, ext: false, vk: 0 })
    "Digit0" => Some(WinKeySpec::{ scan: 0x0b, ext: false, vk: 0 })
    "Minus" => Some(WinKeySpec::{ scan: 0x0c, ext: false, vk: 0 })
    "Equal" => Some(WinKeySpec::{ scan: 0x0d, ext: false, vk: 0 })
    "Backspace" => Some(WinKeySpec::{ scan: 0x0e, ext: false, vk: 0 })
    "Tab" => Some(WinKeySpec::{ scan: 0x0f, ext: false, vk: 0 })
    "KeyQ" => Some(WinKeySpec::{ scan: 0x10, ext: false, vk: 0 })
    "KeyW" => Some(WinKeySpec::{ scan: 0x11, ext: false, vk: 0 })
    "KeyE" => Some(WinKeySpec::{ scan: 0x12, ext: false, vk: 0 })
    "KeyR" => Some(WinKeySpec::{ scan: 0x13, ext: false, vk: 0 })
    "KeyT" => Some(WinKeySpec::{ scan: 0x14, ext: false, vk: 0 })
    "KeyY" => Some(WinKeySpec::{ scan: 0x15, ext: false, vk: 0 })
    "KeyU" => Some(WinKeySpec::{ scan: 0x16, ext: false, vk: 0 })
    "KeyI" => Some(WinKeySpec::{ scan: 0x17, ext: false, vk: 0 })
    "KeyO" => Some(WinKeySpec::{ scan: 0x18, ext: false, vk: 0 })
    "KeyP" => Some(WinKeySpec::{ scan: 0x19, ext: false, vk: 0 })
    "BracketLeft" => Some(WinKeySpec::{ scan: 0x1a, ext: false, vk: 0 })
    "BracketRight" => Some(WinKeySpec::{ scan: 0x1b, ext: false, vk: 0 })
    "Enter" => Some(WinKeySpec::{ scan: 0x1c, ext: false, vk: 0 })
    "ControlLeft" => Some(WinKeySpec::{ scan: 0x1d, ext: false, vk: 0 })
    "KeyA" => Some(WinKeySpec::{ scan: 0x1e, ext: false, vk: 0 })
    "KeyS" => Some(WinKeySpec::{ scan: 0x1f, ext: false, vk: 0 })
    "KeyD" => Some(WinKeySpec::{ scan: 0x20, ext: false, vk: 0 })
    "KeyF" => Some(WinKeySpec::{ scan: 0x21, ext: false, vk: 0 })
    "KeyG" => Some(WinKeySpec::{ scan: 0x22, ext: false, vk: 0 })
    "KeyH" => Some(WinKeySpec::{ scan: 0x23, ext: false, vk: 0 })
    "KeyJ" => Some(WinKeySpec::{ scan: 0x24, ext: false, vk: 0 })
    "KeyK" => Some(WinKeySpec::{ scan: 0x25, ext: false, vk: 0 })
    "KeyL" => Some(WinKeySpec::{ scan: 0x26, ext: false, vk: 0 })
    "Semicolon" => Some(WinKeySpec::{ scan: 0x27, ext: false, vk: 0 })
    "Quote" => Some(WinKeySpec::{ scan: 0x28, ext: false, vk: 0 })
    "Backquote" => Some(WinKeySpec::{ scan: 0x29, ext: false, vk: 0 })
    "ShiftLeft" => Some(WinKeySpec::{ scan: 0x2a, ext: false, vk: 0 })
    "Backslash" => Some(WinKeySpec::{ scan: 0x2b, ext: false, vk: 0 })
    "KeyZ" => Some(WinKeySpec::{ scan: 0x2c, ext: false, vk: 0 })
    "KeyX" => Some(WinKeySpec::{ scan: 0x2d, ext: false, vk: 0 })
    "KeyC" => Some(WinKeySpec::{ scan: 0x2e, ext: false, vk: 0 })
    "KeyV" => Some(WinKeySpec::{ scan: 0x2f, ext: false, vk: 0 })
