// Unified screen source contracts, clipboard/cursor/region/resolution/window codecs,
// platform input state machines (macOS, Windows, Linux/X11, iOS Simulator, Android scrcpy),
// Linux virtual gamepad & virtual microphone state machines, and Windows ScreenService state machine.

import "base_codec"
import "station_ops"

// ---------------------------------------------------------------------------
// Core codecs, regions, clipboard, cursor, windows, resolution, access
// ---------------------------------------------------------------------------

pub enum Codec {
  H265
  H264
  Jpeg
}

pub fn codec_name(c : Codec) -> String {
  match c {
    Codec::H265 => "h265"
    Codec::H264 => "h264"
    Codec::Jpeg => "jpeg"
  }
}

pub fn codec_eq(a : Codec, b : Codec) -> Bool {
  codec_name(a) == codec_name(b)
}

pub enum AudioCodec {
  PcmS16le
  Opus
}

pub let OPUS_MAX : Int = 1275
pub let MIC_PCM_MAX : Int = 3840
pub let GAMEPADS_MOST : Int = 4
pub let GAMEPAD_BUTTONS : Int = 0x1ffff
pub let LOOK_LEAST : Double = 0.02
pub let LOOK_WHOLE : Double = 0.98
pub let CLIP_TEXT_MAX : Int = 1024 * 1024
pub let CLIP_PNG_MAX : Int = 8 * 1024 * 1024
pub let CURSOR_PNG_MAX : Int = 65536
pub let CURSOR_IMAGES_MOST : Int = 64
pub let WINDOWS_MOST : Int = 60
pub let WINDOW_WORDS_MOST : Int = 200

