    "F1" => Some(0x7a)
    "ArrowLeft" => Some(0x7b)
    "ArrowRight" => Some(0x7c)
    "ArrowDown" => Some(0x7d)
    "ArrowUp" => Some(0x7e)
    _ => if is_key_end(code) { Some(0x77) } else { None }
  }
}

fn mac_mod_flag_of(code : String) -> Option[Int] {
  match code {
    "MetaLeft" => Some(MAC_FLAG_COMMAND)
    "MetaRight" => Some(MAC_FLAG_COMMAND)
    "ShiftLeft" => Some(MAC_FLAG_SHIFT)
    "ShiftRight" => Some(MAC_FLAG_SHIFT)
    "AltLeft" => Some(MAC_FLAG_ALT)
    "AltRight" => Some(MAC_FLAG_ALT)
    "ControlLeft" => Some(MAC_FLAG_CTRL)
    "ControlRight" => Some(MAC_FLAG_CTRL)
    _ => None
  }
}

fn mac_is_arrow(kc : Int) -> Bool {
  kc == 0x7b || kc == 0x7c || kc == 0x7d || kc == 0x7e
}

fn mac_is_fn_key(kc : Int) -> Bool {
  kc == 0x72 || kc == 0x73 || kc == 0x74 || kc == 0x75 || kc == 0x77 || kc == 0x79 ||
  kc == 0x7a || kc == 0x78 || kc == 0x63 || kc == 0x76 || kc == 0x60 || kc == 0x61 ||
  kc == 0x62 || kc == 0x64 || kc == 0x65 || kc == 0x6d || kc == 0x67 || kc == 0x6f
}

pub enum MacOp {
  Mouse(String, Double, Double, Int, Int, Int, Int, Option[Double], Option[Double], Bool)
  Gamepad(GamepadState)
  GamepadMode(Bool)
  Scroll(Double, Double, Double, Double, Int)
  Key(Int, Bool, Int)
  Text(String)
}

struct MacPress {
  pub at : Int64
  pub x : Double
  pub y : Double
  pub button : Int
  pub clicks : Int
}

pub struct MacInput {
  pub mut buttons : Int
  pub held : Array[String]
  pub mut at_x : Double
  pub mut at_y : Double
  pub mut press : Option[MacPress]
  pub pads : Array[Int]
}

pub fn MacInput::new() -> MacInput {
  MacInput::{
    buttons: 0,
    held: [],
    at_x: 0.0,
    at_y: 0.0,
    press: None,
    pads: [],
  }
}

fn array_has_str(arr : Array[String], s : String) -> Bool {
  for i in 0..<arr.length() {
    if arr[i] == s {
      return true
    }
  }
  false
}

fn array_add_str(arr : Array[String], s : String) -> Unit {
  if !array_has_str(arr, s) {
    arr.push(s)
  }
}

fn array_remove_str(arr : Array[String], s : String) -> Unit {
  let kept : Array[String] = []
  for i in 0..<arr.length() {
    if arr[i] != s {
      kept.push(arr[i])
    }
  }
  while arr.length() > 0 { let _ = arr.pop() }
  for i in 0..<kept.length() { arr.push(kept[i]) }
}

fn array_has_int(arr : Array[Int], v : Int) -> Bool {
  for i in 0..<arr.length() {
    if arr[i] == v {
      return true
    }
  }
  false
}

fn array_add_int(arr : Array[Int], v : Int) -> Unit {
  if !array_has_int(arr, v) {
    arr.push(v)
  }
}

fn array_remove_int(arr : Array[Int], v : Int) -> Unit {
  let kept : Array[Int] = []
  for i in 0..<arr.length() {
    if arr[i] != v {
      kept.push(arr[i])
    }
  }
  while arr.length() > 0 { let _ = arr.pop() }
  for i in 0..<kept.length() { arr.push(kept[i]) }
}

fn abs_d(v : Double) -> Double {
  if v < 0.0 { 0.0 - v } else { v }
}

fn MacInput::held_flags(self : MacInput) -> Int {
  let mut flags = 0
  for i in 0..<self.held.length() {
    match mac_mod_flag_of(self.held[i]) {
      Some(f) => flags = flags | f
      None => ()
    }
  }
  flags
}

pub fn MacInput::release(self : MacInput) -> Array[MacOp] {
  let ops : Array[MacOp] = []
  let bits : Array[Int] = [1, 2, 4]
  for i in 0..<bits.length() {
    let bit = bits[i]
    if (self.buttons & bit) != 0 {
      self.buttons = self.buttons & (7 ^ bit)
      ops.push(MacOp::Mouse("up", self.at_x, self.at_y, button_of_bit(bit), self.buttons, 1, self.held_flags(), None, None, false))
    }
  }
  let snapshot : Array[String] = []
  for i in 0..<self.held.length() { snapshot.push(self.held[i]) }
  for i in 0..<snapshot.length() {
    let code = snapshot[i]
    array_remove_str(self.held, code)
    match mac_keycode_of(code) {
      Some(kc) => ops.push(MacOp::Key(kc, false, self.held_flags()))
      None => ()
    }
  }
  for i in 0..<self.pads.length() {
    ops.push(MacOp::Gamepad(gamepad_released(self.pads[i])))
  }
  while self.pads.length() > 0 { let _ = self.pads.pop() }
  ops
}

pub fn MacInput::ops(self : MacInput, e : ScreenInput, now : Int64) -> Array[MacOp] {
  match e {
    ScreenInput::Pointer(kind, x, y, buttons_in, dx, dy, relative) => {
      let before = self.buttons
      self.buttons = buttons_in & 7
      self.at_x = x
      self.at_y = y
      let flags = self.held_flags()
      match kind {
        PointerKind::Move => {
          let has_delta = match (dx, dy) {
            (Some(_), Some(_)) => true
            _ => false
          }
          let rel = has_delta && relative
          [MacOp::Mouse("move", x, y, 0, self.buttons, 0, flags, if has_delta { dx } else { None }, if has_delta { dy } else { None }, rel)]
        }
        PointerKind::Down => {
          let added = lowest_bit(self.buttons & (7 ^ before))
          let bit = if added != 0 { added } else { 1 }
          let button = button_of_bit(bit)
          let clicks = match self.press {
            Some(last) => {
              if last.button == button &&
              (now - last.at) <= MAC_CLICK_MS &&
              abs_d(last.x - x) <= MAC_CLICK_NEAR &&
              abs_d(last.y - y) <= MAC_CLICK_NEAR {
                last.clicks + 1
              } else {
                1
              }
            }
            None => 1
          }
          self.press = Some(MacPress::{ at: now, x: x, y: y, button: button, clicks: clicks })
          self.buttons = self.buttons | bit
          [MacOp::Mouse("down", x, y, button, self.buttons, clicks, flags, None, None, relative)]
        }
        PointerKind::Up => {
          let gone = lowest_bit(before & (7 ^ self.buttons))
          let bit = if gone != 0 {
            gone
          } else {
            let lb = lowest_bit(before)
            if lb != 0 { lb } else { 1 }
          }
          let button = button_of_bit(bit)
          self.buttons = self.buttons & (7 ^ bit)
          let clicks = match self.press {
            Some(last) => if last.button == button { last.clicks } else { 1 }
            None => 1
          }
          [MacOp::Mouse("up", x, y, button, self.buttons, clicks, flags, None, None, relative)]
        }
      }
    }
    ScreenInput::Wheel(x, y, dx, dy) => [MacOp::Scroll(x, y, dx, dy, self.held_flags())]
    ScreenInput::Key(kind, key, code, mods) => {
      let down = match kind {
        KeyKind::Down => true
        KeyKind::Up => false
      }
      match mac_keycode_of(code) {
        None => {
          if down && is_single_codepoint(key) && (mods & 6) == 0 {
            [MacOp::Text(key)]
          } else {
            []
          }
        }
        Some(kc) => {
          match mac_mod_flag_of(code) {
            Some(_) => {
              if down {
                array_add_str(self.held, code)
              } else {
                array_remove_str(self.held, code)
              }
              [MacOp::Key(kc, down, self.held_flags())]
            }
            None => {
              let mut flags = mac_flags_of(mods) | self.held_flags()
              if mac_is_arrow(kc) {
                flags = flags | MAC_FLAG_NUMERIC_PAD | MAC_FLAG_FN
              }
              if mac_is_fn_key(kc) {
                flags = flags | MAC_FLAG_FN
              }
              [MacOp::Key(kc, down, flags)]
            }
          }
        }
      }
    }
    ScreenInput::Text(text) => if text == "" { [] } else { [MacOp::Text(text)] }
    ScreenInput::Gamepad(pad) => {
      if pad.connected {
        array_add_int(self.pads, pad.index)
      } else {
        array_remove_int(self.pads, pad.index)
      }
      [MacOp::Gamepad(pad)]
    }
    ScreenInput::GamepadMode(mouse) => [MacOp::GamepadMode(mouse)]
    _ => []
  }
}

