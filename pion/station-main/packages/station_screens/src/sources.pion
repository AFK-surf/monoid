    "NumpadAdd" => Some(0x45)
    "NumLock" => Some(0x47)
    "AudioVolumeUp" => Some(0x48)
    "AudioVolumeDown" => Some(0x49)
    "AudioVolumeMute" => Some(0x4a)
    "NumpadDivide" => Some(0x4b)
