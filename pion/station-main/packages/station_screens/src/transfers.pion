// Drive Transfers (`station/src/drive/transfers.ts`):
// Sequential copy/move queue, random UUID v4 IDs, conflict resolution (`replace`/`keep`/`skip`),
// self-containment & source-overwrite guards, remote-source refusal on local runner,
// 64-bit Int64 chunked transfer with mid-transfer cancellation, `mtime` restart,
// `UploadLost` resume, strict move source release, and JSON persistence hooks.

import "base_codec"
import "station_ops"

pub let TRANSFER_KEPT_MS : Int64 = (24 * 3600).to_int64() * 1000.to_int64()
pub let TRANSFER_MOST_ITEMS : Int = 100_000
pub let TRANSFER_SAVE_EVERY_MS : Int64 = 2_000.to_int64()

pub struct TransferItem {
  pub path : String
  pub dir : Bool
  pub mut size : Int64
}

pub enum ConflictPolicy {
  Replace
  Keep
  Skip
}

pub fn conflict_policy_name(c : ConflictPolicy) -> String {
  match c {
    ConflictPolicy::Replace => "replace"
    ConflictPolicy::Keep => "keep"
    ConflictPolicy::Skip => "skip"
  }
}

pub fn parse_conflict_policy(s : String) -> Option[ConflictPolicy] {
  match s {
    "replace" => Some(ConflictPolicy::Replace)
    "keep" => Some(ConflictPolicy::Keep)
    "skip" => Some(ConflictPolicy::Skip)
    _ => None
  }
}

pub enum TransferState {
  Queued
  Walking
  Copying
  Done
  Failed
  Cancelled
}

pub fn transfer_state_name(s : TransferState) -> String {
  match s {
    TransferState::Queued => "queued"
    TransferState::Walking => "walking"
    TransferState::Copying => "copying"
    TransferState::Done => "done"
    TransferState::Failed => "failed"
    TransferState::Cancelled => "cancelled"
  }
}

pub fn parse_transfer_state(s : String) -> Option[TransferState] {
  match s {
    "queued" => Some(TransferState::Queued)
    "walking" => Some(TransferState::Walking)
    "copying" => Some(TransferState::Copying)
    "done" => Some(TransferState::Done)
    "failed" => Some(TransferState::Failed)
    "cancelled" => Some(TransferState::Cancelled)
    _ => None
  }
}

pub fn transfer_ended(s : TransferState) -> Bool {
  match s {
    TransferState::Done => true
    TransferState::Cancelled => true
    _ => false
  }
}

pub struct TransferFrom {
  pub station : Option[String]
  pub station_name : Option[String]
  pub grant : Option[String]
  pub root : String
  pub path : String
  pub names : Array[String]
}

pub struct TransferTo {
  pub root : String
  pub path : String
}

pub struct Transfer {
  pub id : String
  pub by : String
  pub workspace : String
  pub home : Bool
  pub anywhere : Bool
  pub move_op : Bool
  pub from : TransferFrom
  pub to : TransferTo
  pub conflicts : Map[String, ConflictPolicy]
  pub mut state : TransferState
  pub items : Array[TransferItem]
  pub mut done : Int
  pub mut at : Int64
  pub mut total : Int64
  pub mut copied : Int64
  pub placed : Map[String, String]
  pub mut error : Option[String]
  pub created_at : Int64
  pub mut ended_at : Option[Int64]
}

/// Generates a 32-hex-char RFC 4122 UUID v4 (without dashes, matching `randomUUID().replaceAll("-", "")`).
pub fn random_uuid_hex(rng : (Int) -> Bytes) -> String {
  let raw = rng(16)
  let b = Bytes::new(16)
  let copy_n = if raw.length() < 16 { raw.length() } else { 16 }
  for i in 0..<copy_n { b[i] = raw[i] }
  b[6] = (((b[6].to_int() & 0x0f) | 0x40) & 0xFF) as Byte
  b[8] = (((b[8].to_int() & 0x3f) | 0x80) & 0xFF) as Byte
  base_codec::hex_encode(b)
}

/// Finder-style non-colliding name: `a 2.txt`, `a 3.txt`, or folder `b 2`.
pub fn free_name(name : String, dir : Bool, taken : (String) -> Bool) -> String {
  let mut dot = -1
  if !dir {
    for i in 0..<name.length() {
      if (name.code_unit_at(i) & 0xFF) == 46 { dot = i }
    }
  }
  let (stem, ext) = if dot > 0 {
    (station_ops::ops_slice_str(name, 0, dot), station_ops::ops_slice_str(name, dot, name.length()))
  } else {
    (name, "")
  }
  let mut n = 2
  while true {
    let cand = stem + " " + n.to_string() + ext
    if !taken(cand) { return cand }
    n = n + 1
  }
  name
}

pub fn transfer_shown_json(t : Transfer) -> base_codec::Json {
  let mut files = 0
  for i in 0..<t.items.length() {
    if !t.items[i].dir { files = files + 1 }
  }
  let fields : Array[(String, base_codec::Json)] = [
    ("id", base_codec::json_str(t.id)),
    ("by", base_codec::json_str(t.by)),
    ("workspace", base_codec::json_str(t.workspace)),
    ("home", base_codec::json_bool(t.home)),
    ("anywhere", base_codec::json_bool(t.anywhere)),
    ("move", base_codec::json_bool(t.move_op)),
    ("state", base_codec::json_str(transfer_state_name(t.state))),
    ("done", base_codec::json_int(t.done)),
    ("at", base_codec::json_int64(t.at)),
    ("total", base_codec::json_int64(t.total)),
    ("copied", base_codec::json_int64(t.copied)),
    ("count", base_codec::json_int(t.items.length())),
    ("files", base_codec::json_int(files)),
    ("createdAt", base_codec::json_int64(t.created_at)),
  ]
  match t.state {
    TransferState::Copying => {
      if t.done < t.items.length() {
        fields.push(("current", base_codec::json_str(t.items[t.done].path)))
      }
    }
    _ => ()
  }
  match t.error {
    Some(e) => fields.push(("error", base_codec::json_str(e)))
    None => ()
  }
  match t.ended_at {
    Some(ts) => fields.push(("endedAt", base_codec::json_int64(ts)))
    None => ()
  }
  base_codec::json_obj(fields)
}

/// Serializes full transfer state for `<data>/transfers/<id>.json` persistence.
pub fn transfer_to_json(t : Transfer) -> String {
  let names_j : Array[base_codec::Json] = []
  for i in 0..<t.from.names.length() { names_j.push(base_codec::json_str(t.from.names[i])) }
  let from_fields : Array[(String, base_codec::Json)] = [
    ("station", match t.from.station { Some(s) => base_codec::json_str(s); None => base_codec::json_null() }),
    ("root", base_codec::json_str(t.from.root)),
    ("path", base_codec::json_str(t.from.path)),
    ("names", base_codec::json_arr(names_j)),
  ]
  match t.from.station_name {
    Some(s) => from_fields.push(("stationName", base_codec::json_str(s)))
    None => ()
  }
  match t.from.grant {
    Some(s) => from_fields.push(("grant", base_codec::json_str(s)))
    None => ()
  }
  let items_j : Array[base_codec::Json] = []
  for i in 0..<t.items.length() {
    let it = t.items[i]
    items_j.push(base_codec::json_obj([
      ("path", base_codec::json_str(it.path)),
      ("dir", base_codec::json_bool(it.dir)),
      ("size", base_codec::json_int64(it.size)),
    ]))
  }
  let conflicts_fields : Array[(String, base_codec::Json)] = []
  let placed_fields : Array[(String, base_codec::Json)] = []
  for i in 0..<t.from.names.length() {
    let nm = t.from.names[i]
    match t.conflicts.get(nm) {
      Some(pol) => conflicts_fields.push((nm, base_codec::json_str(conflict_policy_name(pol))))
      None => ()
    }
    match t.placed.get(nm) {
      Some(pl) => placed_fields.push((nm, base_codec::json_str(pl)))
      None => ()
    }
  }
  let fields : Array[(String, base_codec::Json)] = [
    ("id", base_codec::json_str(t.id)),
    ("by", base_codec::json_str(t.by)),
    ("workspace", base_codec::json_str(t.workspace)),
    ("home", base_codec::json_bool(t.home)),
    ("anywhere", base_codec::json_bool(t.anywhere)),
    ("move", base_codec::json_bool(t.move_op)),
    ("from", base_codec::json_obj(from_fields)),
    ("to", base_codec::json_obj([
      ("root", base_codec::json_str(t.to.root)),
      ("path", base_codec::json_str(t.to.path)),
    ])),
    ("conflicts", base_codec::json_obj(conflicts_fields)),
    ("placed", base_codec::json_obj(placed_fields)),
    ("state", base_codec::json_str(transfer_state_name(t.state))),
    ("items", base_codec::json_arr(items_j)),
    ("done", base_codec::json_int(t.done)),
    ("at", base_codec::json_int64(t.at)),
    ("total", base_codec::json_int64(t.total)),
    ("copied", base_codec::json_int64(t.copied)),
    ("createdAt", base_codec::json_int64(t.created_at)),
  ]
  match t.error {
    Some(e) => fields.push(("error", base_codec::json_str(e)))
    None => ()
  }
  match t.ended_at {
    Some(ts) => fields.push(("endedAt", base_codec::json_int64(ts)))
    None => ()
  }
  base_codec::json_stringify(base_codec::json_obj(fields))
}

/// Restores a persisted transfer from JSON (returns None if malformed).
pub fn transfer_from_json(raw : String) -> Option[Transfer] {
  let v = match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(_) => return None
  }
  let id = match opt_json_str(v, "id") { Some(s) => s; None => return None }
  let by = match opt_json_str(v, "by") { Some(s) => s; None => "" }
  let workspace = match opt_json_str(v, "workspace") { Some(s) => s; None => "" }
  let state = match opt_json_str(v, "state") {
    Some(s) => match parse_transfer_state(s) { Some(st) => st; None => return None }
    None => return None
  }
  let from_j = match base_codec::json_get(v, "from") { Some(j) => j; None => return None }
  let to_j = match base_codec::json_get(v, "to") { Some(j) => j; None => return None }
  let names : Array[String] = []
  match base_codec::json_get(from_j, "names") {
    Some(base_codec::Json::Arr(arr)) => {
      for i in 0..<arr.length() {
        match arr[i] { base_codec::Json::Str(s) => names.push(s); _ => () }
      }
    }
    _ => ()
  }
  let items : Array[TransferItem] = []
  match base_codec::json_get(v, "items") {
    Some(base_codec::Json::Arr(arr)) => {
      for i in 0..<arr.length() {
        let it = arr[i]
        let ip = match opt_json_str(it, "path") { Some(s) => s; None => "" }
        let idir = opt_json_bool(it, "dir")
        let isz = match base_codec::json_get(it, "size") {
          Some(base_codec::Json::Num(d, _)) => d.to_int64()
          _ => 0.to_int64()
        }
        items.push(TransferItem::{ path: ip, dir: idir, size: isz })
      }
    }
    _ => ()
  }
  let i64_f = fn(key : String) -> Int64 {
    match base_codec::json_get(v, key) {
      Some(base_codec::Json::Num(d, _)) => d.to_int64()
      _ => 0.to_int64()
    }
  }
  let ended_at = match base_codec::json_get(v, "endedAt") {
    Some(base_codec::Json::Num(d, _)) => Some(d.to_int64())
    _ => None
  }
  let conflicts : Map[String, ConflictPolicy] = Map::new()
  match base_codec::json_get(v, "conflicts") {
    Some(base_codec::Json::Obj(pairs)) => {
      for i in 0..<pairs.length() {
        let (k, jv) = pairs[i]
        match jv {
          base_codec::Json::Str(s) => {
            match parse_conflict_policy(s) {
              Some(pol) => conflicts.set(k, pol)
              None => ()
            }
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  let placed : Map[String, String] = Map::new()
  match base_codec::json_get(v, "placed") {
    Some(base_codec::Json::Obj(pairs)) => {
      for i in 0..<pairs.length() {
        let (k, jv) = pairs[i]
        match jv {
          base_codec::Json::Str(s) => placed.set(k, s)
          _ => ()
        }
      }
    }
    _ => ()
  }
  Some(Transfer::{
    id: id,
    by: by,
    workspace: workspace,
    home: opt_json_bool(v, "home"),
    anywhere: opt_json_bool(v, "anywhere"),
    move_op: opt_json_bool(v, "move"),
    from: TransferFrom::{
      station: opt_json_str(from_j, "station"),
      station_name: opt_json_str(from_j, "stationName"),
      grant: opt_json_str(from_j, "grant"),
      root: match opt_json_str(from_j, "root") { Some(s) => s; None => "" },
      path: match opt_json_str(from_j, "path") { Some(s) => s; None => "" },
      names: names,
    },
    to: TransferTo::{
      root: match opt_json_str(to_j, "root") { Some(s) => s; None => "" },
      path: match opt_json_str(to_j, "path") { Some(s) => s; None => "" },
    },
    conflicts: conflicts,
    state: state,
    items: items,
    done: match opt_json_int(v, "done") { Some(n) => n; None => 0 },
    at: i64_f("at"),
    total: i64_f("total"),
    copied: i64_f("copied"),
    placed: placed,
    error: opt_json_str(v, "error"),
    created_at: i64_f("createdAt"),
    ended_at: ended_at,
  })
}

fn join2_rel(a : String, b : String) -> String {
  if a == "" { b } else if b == "" { a } else { a + "/" + b }
}

fn top_segment(path : String) -> String {
  for i in 0..<path.length() {
    if (path.code_unit_at(i) & 0xFF) == 47 {
      return station_ops::ops_slice_str(path, 0, i)
    }
  }
  path
}

/// Walks selected `names` under `(root, path)` in `drive`, folders before children, capped at `TRANSFER_MOST_ITEMS`.
pub fn walk_drive(
  drive : Drive,
  root : String,
  path : String,
  names : Array[String],
  anywhere : Bool,
) -> Result[Array[TransferItem], DriveError] {
  let items : Array[TransferItem] = []
  let stack : Array[(String, Bool, Int64)] = []
  let mut i = names.length() - 1
  while i >= 0 {
    let name = names[i]
    if name == "" || has_byte(name, 47) || name == "." || name == ".." {
      return Err(DriveError::new(DriveCode::InvalidRequest, "a name, not a path"))
    }
    let st = match drive.stat(root, join2_rel(path, name), anywhere) {
      Ok(e) => e
      Err(err) => return Err(err)
    }
    stack.push((name, st.dir, st.size))
    i = i - 1
  }
  while stack.length() > 0 {
    let (rel, is_dir, sz) = match stack.pop() {
      Some(x) => x
      None => break
    }
    if items.length() >= TRANSFER_MOST_ITEMS {
      return Err(DriveError::new(DriveCode::TooLarge, "more than " + TRANSFER_MOST_ITEMS.to_string() + " files and folders"))
    }
    items.push(TransferItem::{ path: rel, dir: is_dir, size: if is_dir { 0.to_int64() } else { sz } })
    if is_dir {
      let listed = match drive.list(root, join2_rel(path, rel), anywhere) {
        Ok(l) => l
        Err(err) => return Err(err)
      }
      if listed.truncated {
        return Err(DriveError::new(DriveCode::TooLarge, rel + ": too many entries to list; select fewer files or smaller folders"))
      }
      let mut j = listed.entries.length() - 1
      while j >= 0 {
        let e = listed.entries[j]
        stack.push((join2_rel(rel, e.name), e.dir, e.size))
        j = j - 1
      }
    }
  }
  Ok(items)
}

/// Ensures local copy/move neither puts a folder inside itself nor overwrites any selected source.
pub fn check_transfer_separate(t : Transfer, drive : Drive) -> Result[Unit, DriveError] {
  if !(t.from.station is None) {
    return Ok(())
  }
  let into = match drive.place(t.to.root, t.to.path, t.anywhere) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let sources : Array[DrivePlace] = []
  let active_names : Array[String] = []
  for i in 0..<t.from.names.length() {
    let name = t.from.names[i]
    match t.conflicts.get(name) {
      Some(ConflictPolicy::Skip) => continue
      _ => ()
    }
    active_names.push(name)
    match drive.place(t.from.root, join2_rel(t.from.path, name), t.anywhere) {
      Ok(p) => sources.push(p)
      Err(e) => return Err(e)
    }
  }
  for i in 0..<sources.length() {
    if station_ops::platform_path_within(drive.is_win, into.found, sources[i].found) {
      return Err(DriveError::new(DriveCode::InvalidRequest, "choose a different destination folder: a folder cannot go into itself"))
    }
  }
  for i in 0..<active_names.length() {
    let name = active_names[i]
    let skip_keep = match t.conflicts.get(name) {
      Some(ConflictPolicy::Keep) => t.placed.get(name) is None
      _ => false
    }
    if skip_keep { continue }
    let dest_name = match t.placed.get(name) {
      Some(p) => p
      None => name
    }
    let to_place = match drive.place(t.to.root, join2_rel(t.to.path, dest_name), t.anywhere) {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    for j in 0..<sources.length() {
      let src = sources[j]
      if station_ops::platform_path_within(drive.is_win, src.entry, to_place.entry) ||
      station_ops::platform_path_within(drive.is_win, src.found, to_place.entry) {
        return Err(DriveError::new(DriveCode::InvalidRequest, "choose a different destination or keep both: replacing it would remove a source"))
      }
    }
  }
  Ok(())
}

pub struct TransfersManager {
  pub transfers : Array[Transfer]
  pub stop_ids : Array[String]
  pub part_size : Int
  pub rng : (Int) -> Bytes
}

/// Requires a caller-injected CSPRNG `rng` (e.g. OS entropy in production; deterministic stub only in tests).
pub fn TransfersManager::new(rng : (Int) -> Bytes, part_size : Int = MAX_READ) -> TransfersManager {
  TransfersManager::{ transfers: [], stop_ids: [], part_size: part_size, rng: rng }
}

/// Registers a transfer restored from disk JSON persistence.
pub fn TransfersManager::restore(self : TransfersManager, t : Transfer) -> Unit {
  self.transfers.push(t)
}

pub fn TransfersManager::is_cancelled(self : TransfersManager, id : String) -> Bool {
  if array_has_str(self.stop_ids, id) { return true }
  match self.get(id) {
    Some(t) => match t.state {
      TransferState::Cancelled => true
      _ => false
    }
    None => true
  }
}

pub fn TransfersManager::start(
  self : TransfersManager,
  by : String,
  workspace : String,
  home : Bool,
  anywhere : Bool,
  move_op : Bool,
  from : TransferFrom,
  to : TransferTo,
  conflicts : Map[String, ConflictPolicy],
  now : Int64,
) -> Result[Transfer, DriveError] {
  if from.names.length() == 0 {
    return Err(DriveError::new(DriveCode::InvalidRequest, "nothing to copy"))
  }
  let id = random_uuid_hex(self.rng)
  let t = Transfer::{
    id: id,
    by: by,
    workspace: workspace,
    home: home,
    anywhere: anywhere,
    move_op: move_op,
    from: from,
    to: to,
    conflicts: conflicts,
    state: TransferState::Queued,
    items: [],
    done: 0,
    at: 0.to_int64(),
    total: 0.to_int64(),
    copied: 0.to_int64(),
    placed: Map::new(),
    error: None,
    created_at: now,
    ended_at: None,
  }
  self.transfers.push(t)
  Ok(t)
}

pub fn TransfersManager::get(self : TransfersManager, id : String) -> Option[Transfer] {
  for i in 0..<self.transfers.length() {
    if self.transfers[i].id == id { return Some(self.transfers[i]) }
  }
  None
}

pub fn TransfersManager::list(self : TransfersManager, by : String) -> Array[Transfer] {
  let out : Array[Transfer] = []
  let mut i = self.transfers.length() - 1
  while i >= 0 {
    if self.transfers[i].by == by { out.push(self.transfers[i]) }
    i = i - 1
  }
  out
}

pub fn TransfersManager::cancel(self : TransfersManager, by : String, id : String, now : Int64) -> Result[Transfer, DriveError] {
  let t = match self.get(id) {
    Some(x) => if x.by == by { x } else { return Err(DriveError::new(DriveCode::NotFound, "no such transfer")) }
    None => return Err(DriveError::new(DriveCode::NotFound, "no such transfer"))
  }
  if transfer_ended(t.state) {
    return Ok(t)
  }
  array_add_str(self.stop_ids, id)
  t.state = TransferState::Cancelled
  t.ended_at = Some(now)
  Ok(t)
}

pub fn TransfersManager::retry(self : TransfersManager, by : String, id : String) -> Result[Transfer, DriveError] {
  let t = match self.get(id) {
    Some(x) => if x.by == by { x } else { return Err(DriveError::new(DriveCode::NotFound, "no such transfer")) }
    None => return Err(DriveError::new(DriveCode::NotFound, "no such transfer"))
  }
  match t.state {
    TransferState::Failed => {
      array_remove_str(self.stop_ids, id)
      t.state = if t.items.length() > 0 { TransferState::Copying } else { TransferState::Queued }
      t.error = None
      t.ended_at = None
      Ok(t)
    }
    _ => Ok(t)
  }
}

/// Executes a local-only transfer deterministically.
/// - Refuses remote transfers (`from.station != None`) before touching any local file.
/// - Uses 64-bit `Int64` offsets throughout (>2 GiB safe).
/// - Checks cancellation between every chunk (optional `on_chunk` callback).
/// - Propagates permanent delete errors on `NoTrash` fallback (never swallows to `Done`).
pub fn TransfersManager::run_local(
  self : TransfersManager,
  id : String,
  drive : Drive,
  now : Int64,
  on_chunk : Option[(Transfer) -> Unit] = None,
) -> Result[Transfer, DriveError] {
  let t = match self.get(id) {
    Some(x) => x
    None => return Err(DriveError::new(DriveCode::NotFound, "no such transfer"))
  }
  if transfer_ended(t.state) { return Ok(t) }
  // P1-5: NEVER run a remote transfer on the local runner (prevents reading/deleting same-named local files).
  if !(t.from.station is None) {
    let err = DriveError::new(DriveCode::InvalidRequest, "remote transfer cannot run on local runner")
    t.state = TransferState::Failed
    t.error = Some(err.message)
    t.ended_at = Some(now)
    return Err(err)
  }
  match check_transfer_separate(t, drive) {
    Ok(_) => ()
    Err(e) => {
      t.state = TransferState::Failed
      t.error = Some(e.message)
      t.ended_at = Some(now)
      return Err(e)
    }
  }
  if self.is_cancelled(t.id) { return Ok(t) }
  if t.items.length() == 0 {
    t.state = TransferState::Walking
    let names : Array[String] = []
    for i in 0..<t.from.names.length() {
      let nm = t.from.names[i]
      match t.conflicts.get(nm) {
        Some(ConflictPolicy::Skip) => continue
        _ => names.push(nm)
      }
    }
    let walked = match walk_drive(drive, t.from.root, t.from.path, names, t.anywhere) {
      Ok(items) => items
      Err(e) => {
        t.state = TransferState::Failed
        t.error = Some(e.message)
        t.ended_at = Some(now)
        return Err(e)
      }
    }
    if self.is_cancelled(t.id) { return Ok(t) }
    let listed = match drive.list(t.to.root, t.to.path, t.anywhere) {
      Ok(l) => l
      Err(e) => {
        t.state = TransferState::Failed
        t.error = Some(e.message)
        t.ended_at = Some(now)
        return Err(e)
      }
    }
    let there : Array[String] = []
    for i in 0..<listed.entries.length() {
      there.push(station_ops::platform_path_key(drive.is_win, listed.entries[i].name))
    }
    for i in 0..<t.from.names.length() {
      if self.is_cancelled(t.id) { return Ok(t) }
      let name = t.from.names[i]
      let ans = t.conflicts.get(name)
      match ans {
        Some(ConflictPolicy::Skip) => continue
        _ => ()
      }
      let k = station_ops::platform_path_key(drive.is_win, name)
      let exists_there = array_has_str(there, k)
      let mut is_dir = false
      for j in 0..<walked.length() {
        if walked[j].path == name { is_dir = walked[j].dir; break }
      }
      if exists_there {
        match ans {
          Some(ConflictPolicy::Keep) => {
            let fresh = free_name(name, is_dir, fn(cand : String) -> Bool {
              array_has_str(there, station_ops::platform_path_key(drive.is_win, cand))
            })
            t.placed.set(name, fresh)
            there.push(station_ops::platform_path_key(drive.is_win, fresh))
            continue
          }
          Some(ConflictPolicy::Replace) => {
            let target_rel = join2_rel(t.to.path, name)
            match drive.remove(t.to.root, target_rel, t.anywhere, false, now) {
              Ok(_) => ()
              Err(e) => {
                match e.code {
                  DriveCode::NoTrash => {
                    match drive.remove(t.to.root, target_rel, t.anywhere, true, now) {
                      Ok(_) => ()
                      Err(e2) => {
                        t.state = TransferState::Failed
                        t.error = Some(e2.message)
                        t.ended_at = Some(now)
                        return Err(e2)
                      }
                    }
                  }
                  _ => {
                    t.state = TransferState::Failed
                    t.error = Some(e.message)
                    t.ended_at = Some(now)
                    return Err(e)
                  }
                }
              }
            }
          }
          _ => {
            let err = DriveError::new(DriveCode::Exists, name + ": there is already one by that name")
            t.state = TransferState::Failed
            t.error = Some(err.message)
            t.ended_at = Some(now)
            return Err(err)
          }
        }
      }
      t.placed.set(name, name)
    }
    let mut total = 0.to_int64()
    for i in 0..<walked.length() {
      t.items.push(walked[i])
      total = total + walked[i].size
    }
    t.total = total
    t.state = TransferState::Copying
  }

  while t.done < t.items.length() {
    if self.is_cancelled(t.id) { return Ok(t) }
    let item = t.items[t.done]
    let top_name = top_segment(item.path)
    let placed_name = match t.placed.get(top_name) {
      Some(p) => p
      None => top_name
    }
    let suffix = station_ops::ops_slice_str(item.path, top_name.length(), item.path.length())
    let dest_rel = join2_rel(t.to.path, placed_name + suffix)
    if item.dir {
      match drive.mkdir(t.to.root, dest_rel, t.anywhere) {
        Ok(_) => ()
        Err(e) => {
          match e.code {
            DriveCode::Exists => ()
            _ => {
              t.state = TransferState::Failed
              t.error = Some(e.message)
              t.ended_at = Some(now)
              return Err(e)
            }
          }
        }
      }
    } else {
      let up_id = station_ops::ops_slice_str(t.id, 0, if t.id.length() < 32 { t.id.length() } else { 32 }) + "-" + t.done.to_string()
      let mut last_mtime : Option[Int64] = None
      while true {
        if self.is_cancelled(t.id) { return Ok(t) }
        let (chunk, total_sz, mtime, _) = match drive.read(t.from.root, join2_rel(t.from.path, item.path), t.at, self.part_size, t.anywhere) {
          Ok(r) => r
          Err(e) => {
            t.state = TransferState::Failed
            t.error = Some(e.message)
            t.ended_at = Some(now)
            return Err(e)
          }
        }
        match last_mtime {
          Some(prev_m) => {
            if prev_m != mtime {
              t.copied = t.copied - t.at
              t.at = 0.to_int64()
              last_mtime = None
              continue
            }
          }
          None => ()
        }
        last_mtime = Some(mtime)
        if total_sz != item.size {
          t.total = t.total + (total_sz - item.size)
          item.size = total_sz
        }
        match drive.upload(t.to.root, dest_rel, up_id, t.at, total_sz, chunk, false, t.anywhere, now) {
          Ok(res) => {
            t.copied = t.copied + (res.have - t.at)
            t.at = res.have
            match on_chunk {
              Some(cb) => cb(t)
              None => ()
            }
            if !(res.entry is None) || t.at >= total_sz {
              break
            }
            if self.is_cancelled(t.id) { return Ok(t) }
          }
          Err(e) => {
            match (e.code, e.have) {
              (DriveCode::UploadLost, Some(have)) => {
                t.copied = t.copied - (t.at - have)
                t.at = have
                continue
              }
              _ => {
                t.state = TransferState::Failed
                t.error = Some(e.message)
                t.ended_at = Some(now)
                return Err(e)
              }
            }
          }
        }
      }
    }
    t.done = t.done + 1
    t.at = 0.to_int64()
  }

  if self.is_cancelled(t.id) { return Ok(t) }
  if t.move_op {
    for i in 0..<t.from.names.length() {
      let name = t.from.names[i]
      if t.placed.get(name) is None { continue }
      let src_rel = join2_rel(t.from.path, name)
      match drive.remove(t.from.root, src_rel, t.anywhere, false, now) {
        Ok(_) => ()
        Err(e) => {
          match e.code {
            DriveCode::NoTrash => {
              // P2-7: Never swallow permanent delete error on NoTrash fallback!
              match drive.remove(t.from.root, src_rel, t.anywhere, true, now) {
                Ok(_) => ()
                Err(e2) => {
                  t.state = TransferState::Failed
                  t.error = Some(e2.message)
                  t.ended_at = Some(now)
                  return Err(e2)
                }
              }
            }
            _ => {
              t.state = TransferState::Failed
              t.error = Some(e.message)
              t.ended_at = Some(now)
              return Err(e)
            }
          }
        }
      }
    }
  }
  t.state = TransferState::Done
  t.ended_at = Some(now)
  Ok(t)
}
