fn vec_genesis_entry() -> form::Json {
  let owner_id = "ed25519:" + vec_owner_pub
  form::Json::Obj([
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws_test_1")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("owner", form::Json::Str("u1")),
      ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
      ("rp_id", form::Json::Str("app.still.fail")),
      ("cloud_keys", form::Json::Obj([("keys", form::Json::Arr([]))])),
      ("members", form::Json::Arr([
        form::Json::Obj([
          ("sub", form::Json::Str("u1")),
          ("email", form::Json::Str("alice@example.com")),
          ("role", form::Json::Str("owner")),
        ]),
      ])),
      ("devices", form::Json::Arr([
        form::Json::Obj([
          ("id", form::Json::Str(vec_owner_pub)),
          ("sub", form::Json::Str("u1")),
          ("kind", form::Json::Str("app")),
          ("label", form::Json::Str("Mac")),
          ("sign_key", form::Json::Str(owner_id)),
        ]),
      ])),
      ("stations", form::Json::Arr([
        form::Json::Obj([
          ("key", form::Json::Str(vec_station_pub)),
          ("name", form::Json::Str("st1")),
        ]),
      ])),
      ("gateways", form::Json::Arr([])),
    ])),
    ("sig", form::Json::Obj([
      ("key", form::Json::Str(owner_id)),
      ("alg", form::Json::Str("Ed25519")),
      ("sig", form::Json::Str(vec_gen_sig)),
    ])),
  ])
}

