// Unit tests for `station_rules_bridge`, cross-verified byte-for-byte against Node `shared/lock.ts`
// and `client/core-ts/src/rig-form.ts`.

import "base64"
import "base_codec"
import "crypto"
import "form"
import "js_json"
import "lock"

fn assert_true(cond : Bool) -> Unit {
  if !cond {
    panic("assertion failed")
  }
}

fn assert_none_str(v : Option[String]) -> Unit {
  match v {
    None => ()
    Some(s) => panic("expected None, got Some(" + s + ")")
  }
}

