          "{\"workspace\":\"ws_rig\",\"workspace_name\":\"RigTeam\",\"name\":\"gpu-rig\",\"relay_url\":\"\",\"relay_urls\":[],\"grant_keys\":null,\"rig\":{\"owner\":\"u_alice\",\"owner_email\":\"alice@example.test\",\"owner_name\":\"Alice\"}}",
        )
      }
      Err("unexpected url: " + req.url)
    },
    fn() -> Int64 { 1800000000000L },
    pid_alive_fn=fn(p : Int) -> Bool { p == 2002 },
  )
  let person_h = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
  let lock_h = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
  let r = dispatch_cli(["enroll", "https://app.still.fail", "rig-tok", "--rig", person_h, "--lock", lock_h, "--data", "/rigd"], empty_env(), ports)
