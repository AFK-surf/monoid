    "chat_post",
    "chat_state",
    "session_send",
    "chat_create",
    "chat_leave",
    "chat_archive",
    "chat_configure",
    "project_manage",
  ]
}

/// Tool that speaks only when its method writes (refused for subagents on write/stream methods).
pub let SPEAKS_WRITING : String = "slack_api"

/// Tool that exposes undeclared tools when a runtime budget truncates the list.
pub let INDIRECT_TOOL : String = "station_tool"

/// Default tool-list byte budget for Antigravity CLI (`AGY_TOOL_BUDGET`).
pub let AGY_TOOL_BUDGET : Int = 22000

