/// Superseded tools omitted from tools/list and station_tool, yet kept callable for older sessions.
pub fn hidden_tools() -> Array[String] {
  ["adb_devices", "phone_use", "secret_reask", "station_retire"]
}

/// Tools called on every turn (marked always-loaded for runtimes that defer tool loading).
pub fn every_turn_tools() -> Array[String] {
  ["chat_post", "chat_state"]
}

/// Tools by which a session speaks or acts in chats as itself (refused for subagents).
pub fn speaks_tools() -> Array[String] {
