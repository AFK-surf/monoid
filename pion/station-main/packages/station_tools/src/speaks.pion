// SPEAKS guard, visibility classification, and call-context isolation gates.
// 1:1 aligned with `station/src/tools/mcp.ts` and `station/test/speaks.test.ts`.

import "base_codec"

/// Tools that reach outside the station, refused while unbound from a workspace.
pub fn outward_tools() -> Array[String] {
  [
    "chat_post",
    "slack_api",
    "job_start",
    "station_list",
    "station_task",
    "station_file",
    "peer_forward",
    "project_manage",
  ]
}

/// Refusal message returned for outward tool calls while the station is unbound.
pub let UNBOUND_REFUSAL : String = "Refused: this station is not in a still.fail workspace right now (it was removed from it, or has not joined one), so it does not post to chats or Slack, call Slack, or start jobs. Nothing was sent. Stop here and do not retry: when the station is back in its workspace, the interrupted work resumes and you can post then."

/// Tools declared first regardless of runtime tool budget.
pub fn core_tools() -> Array[String] {
  [
    "chat_post",
    "chat_state",
    "chat_history",
    "chat_read",
    "job_start",
    "job_log",
    "job_list",
    "job_stop",
    "station_task",
    "station_file",
    "skill_read",
  ]
}

/// Tools declared next when fitting a runtime budget, before sorting the rest by size.
pub fn priority_tools() -> Array[String] {
  [
    "search",
    "chat_list",
    "chat_create",
    "session_send",
    "chat_configure",
    "chat_archive",
    "session_history",
    "station_list",
    "device_list",
    "device_use",
    "browser",
    "screen",
    "secret_list",
    "secret_use",
    "secret_run",
  ]
}

/// Superseded tools omitted from tools/list and station_tool, yet kept callable for older sessions.
pub fn hidden_tools() -> Array[String] {
  ["adb_devices", "phone_use", "secret_reask", "station_retire"]
}

/// Tools called on every turn (marked always-loaded for runtimes that defer tool loading).
pub fn every_turn_tools() -> Array[String] {
  ["chat_post", "chat_state"]
}

/// Tools by which a session speaks or acts in chats as itself (refused for subagents).
pub fn speaks_tools() -> Array[String] {
  [
    "chat_post",
    "chat_state",
    "session_send",
    "chat_create",
    "chat_leave",
    "chat_archive",
    "chat_configure",
    "project_manage",
  ]
}

/// Tool that speaks only when its method writes (refused for subagents on write/stream methods).
pub let SPEAKS_WRITING : String = "slack_api"

/// Tool that exposes undeclared tools when a runtime budget truncates the list.
pub let INDIRECT_TOOL : String = "station_tool"

/// Default tool-list byte budget for Antigravity CLI (`AGY_TOOL_BUDGET`).
pub let AGY_TOOL_BUDGET : Int = 22000

/// Tools that post/close/renew approval cards or send feedback (not blocked for subagents).
pub fn asks_tools() -> Array[String] {
  [
    "secret_use",
