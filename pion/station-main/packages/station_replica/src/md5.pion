// Pure Pion RFC 1321 MD5 implementation (used for S3 DeleteObjects Content-MD5 header).

import "base64"

fn md5_rotl(x : UInt, s : UInt) -> UInt {
  (x << s) | (x >> (32U - s))
}

fn md5_load_le32(buf : Array[Byte], off : Int) -> UInt {
  let b0 = (buf[off].to_int() & 0xFF).to_uint()
  let b1 = (buf[off + 1].to_int() & 0xFF).to_uint()
  let b2 = (buf[off + 2].to_int() & 0xFF).to_uint()
  let b3 = (buf[off + 3].to_int() & 0xFF).to_uint()
  b0 | (b1 << 8U) | (b2 << 16U) | (b3 << 24U)
}

fn md5_store_le32(out : Bytes, off : Int, v : UInt) -> Unit {
  out[off] = (v & 0xFFU).to_int().to_byte()
  out[off + 1] = ((v >> 8U) & 0xFFU).to_int().to_byte()
  out[off + 2] = ((v >> 16U) & 0xFFU).to_int().to_byte()
  out[off + 3] = ((v >> 24U) & 0xFFU).to_int().to_byte()
}

let md5_k : FixedArray[UInt] = [
  0xd76aa478U, 0xe8c7b756U, 0x242070dbU, 0xc1bdceeeU,
  0xf57c0fafU, 0x4787c62aU, 0xa8304613U, 0xfd469501U,
  0x698098d8U, 0x8b44f7afU, 0xffff5bb1U, 0x895cd7beU,
  0x6b901122U, 0xfd987193U, 0xa679438eU, 0x49b40821U,
  0xf61e2562U, 0xc040b340U, 0x265e5a51U, 0xe9b6c7aaU,
  0xd62f105dU, 0x02441453U, 0xd8a1e681U, 0xe7d3fbc8U,
  0x21e1cde6U, 0xc33707d6U, 0xf4d50d87U, 0x455a14edU,
  0xa9e3e905U, 0xfcefa3f8U, 0x676f02d9U, 0x8d2a4c8aU,
  0xfffa3942U, 0x8771f681U, 0x6d9d6122U, 0xfde5380cU,
  0xa4beea44U, 0x4bdecfa9U, 0xf6bb4b60U, 0xbebfbc70U,
  0x289b7ec6U, 0xeaa127faU, 0xd4ef3085U, 0x04881d05U,
  0xd9d4d039U, 0xe6db99e5U, 0x1fa27cf8U, 0xc4ac5665U,
  0xf4292244U, 0x432aff97U, 0xab9423a7U, 0xfc93a039U,
  0x655b59c3U, 0x8f0ccc92U, 0xffeff47dU, 0x85845dd1U,
  0x6fa87e4fU, 0xfe2ce6e0U, 0xa3014314U, 0x4e0811a1U,
  0xf7537e82U, 0xbd3af235U, 0x2ad7d2bbU, 0xeb86d391U,
]

let md5_s : FixedArray[UInt] = [
  7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U,
  5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U,
  4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U,
  6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U,
]

pub fn md5(data : Bytes) -> Bytes {
  let orig_len = data.length()
  let bit_len = orig_len.to_int64() * 8.to_int64()
  let buf : Array[Byte] = []
  for i in 0..<orig_len {
    buf.push(data[i])
  }
  buf.push(0x80 as Byte)
  while (buf.length() % 64) != 56 {
    buf.push(0 as Byte)
  }
  for i in 0..<8 {
    let shift = i * 8
    buf.push(((bit_len >> shift) & 0xFF.to_int64()).to_int() as Byte)
  }
  let mut a0 : UInt = 0x67452301U
  let mut b0 : UInt = 0xefcdab89U
  let mut c0 : UInt = 0x98badcfeU
  let mut d0 : UInt = 0x10325476U
  let m : FixedArray[UInt] = FixedArray::make(16, 0U)
  let mut off = 0
  while off < buf.length() {
    for j in 0..<16 {
      m[j] = md5_load_le32(buf, off + j * 4)
    }
    let mut a = a0
    let mut b = b0
    let mut c = c0
    let mut d = d0
    for i in 0..<64 {
      let mut f : UInt = 0U
      let mut g = 0
      if i < 16 {
        f = (b & c) | ((b ^ 0xFFFFFFFFU) & d)
        g = i
      } else if i < 32 {
        f = (d & b) | ((d ^ 0xFFFFFFFFU) & c)
        g = (5 * i + 1) % 16
      } else if i < 48 {
        f = b ^ c ^ d
        g = (3 * i + 5) % 16
      } else {
        f = c ^ (b | (d ^ 0xFFFFFFFFU))
        g = (7 * i) % 16
      }
      let tmp = d
      d = c
      c = b
      b = b + md5_rotl(a + f + md5_k[i] + m[g], md5_s[i])
      a = tmp
    }
    a0 = a0 + a
    b0 = b0 + b
    c0 = c0 + c
    d0 = d0 + d
    off = off + 64
  }
  let out = Bytes::new(16)
  md5_store_le32(out, 0, a0)
  md5_store_le32(out, 4, b0)
  md5_store_le32(out, 8, c0)
  md5_store_le32(out, 12, d0)
  out
}

pub fn md5_hex(data : Bytes) -> String {
  base64::hex_encode(md5(data))
}

pub fn md5_base64(data : Bytes) -> String {
  base64::encode(md5(data))
}
