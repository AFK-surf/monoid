// Wave 17E-1: Truly asynchronous, non-blocking `secret_run` runtime for `whole_daemon.pion`.
//
// Invariants:
// - ZERO `host_shim::wait` calls! Every `secret_run` MCP request returns `HandlerAction::Defer`
//   immediately (after passing `McpServer::handle_or_defer`) and completes via
//   `HttpServer::respond_with_callbacks` when the event-driven child process exits (keeping
//   `GET /status` and all other endpoints 100% responsive).
// - Disjoint `event_id` half-open segment `[11 << 32, 12 << 32)` (`47244640256L..51539607552L`),
//   clear of jobs/browser/terminals/logins/adb/replica-restore/dns-resolve/live-runner/mdns/upkeep
//   (`1<<32..9<<32`).
// - Real delivery modes (1:1 Node `station/src/vault/run.ts`):
//   - `proxy`: local `127.0.0.1` `VaultProxy` (CONNECT MITM on allowlisted hosts only) with live
//     `GrantStore` active check & `"use"` audit callback; injects placeholder + `HTTPS_PROXY` + CA
//     bundle into child env (NEVER injects the real secret!).
//   - `ssh`: per-command isolated Unix socket `SshAgentServer` keyed by unique `run_seq` (zero
//     FIFO mixup) with live `GrantStore` check & `"use"` audit; injects `SSH_AUTH_SOCK` only.
//   - `file`: writes `0600` temp file in an exclusively created `0700` private dir, injects path
//     into env, and unconditionally deletes file + dir on exit/error/timeout/shutdown.
//   - `env`: inherits OS base environment filtered by Node `incoming.ts:28-30` sensitive prefixes
//     (`STILLFAIL_`, `ANTHROPIC_`, `CLAUDE_`, `OPENAI_`, `CODEX_`) + injects `STILLFAIL_SECRET` &
//     target var.
// - Bounded output buffer (`HEAD = 4 KiB`, `TAIL = 28 KiB`) + streaming `station_vault::Scrubber`
//   + UTF-8 lossy decoding (`sql_db::decode_utf8_lossy_bytes`).
// - Process-group timeout kill (`SIG_KILL`, `group=true`) driven by `tick` — including when a
//   descendant holds stdout/stderr open after main child exit, or during proxy/SSH startup.

import "base64"
import "base_codec"
import "builders_core"
import "crypto"
import "host_shim"
import "nodepath"
import "sql_db"
import "station_http"
import "station_sys"
import "station_tools"
import "station_vault"
import "station_whole"

/// Disjoint event_id segment `[11 << 32, 12 << 32)` for `secret_run` child processes.
pub let SECRET_RUN_EVENT_BASE : Int64 = 47244640256L
pub let SECRET_RUN_EVENT_END : Int64 = 51539607552L

let SECRET_RUN_HEAD_MAX : Int = 4096
let SECRET_RUN_TAIL_MAX : Int = 28672

// ---------------------------------------------------------------------------
// Bounded Head/Tail Output Buffer (1:1 Node `run.ts::Kept`)
// ---------------------------------------------------------------------------

struct SecretRunKept {
  mut head : Bytes
  mut tail : Bytes
  mut cut : Bool
}

fn SecretRunKept::new() -> SecretRunKept {
  SecretRunKept::{
    head: Bytes::new(0),
    tail: Bytes::new(0),
    cut: false,
  }
}

fn sr_bytes_concat(a : Bytes, b : Bytes) -> Bytes {
  if a.length() == 0 {
    return b
  }
  if b.length() == 0 {
    return a
  }
  let out = Bytes::new(a.length() + b.length())
  for i in 0..<a.length() {
    out[i] = a[i]
  }
  for i in 0..<b.length() {
    out[a.length() + i] = b[i]
  }
  out
}

fn sr_bytes_slice(b : Bytes, start : Int, end : Int) -> Bytes {
  let s = if start < 0 { 0 } else if start > b.length() { b.length() } else { start }
  let e = if end < s { s } else if end > b.length() { b.length() } else { end }
  let out = Bytes::new(e - s)
  for i in 0..<(e - s) {
    out[i] = b[s + i]
  }
  out
}

fn SecretRunKept::add(self : SecretRunKept, chunk : Bytes) -> Unit {
  if chunk.length() == 0 {
    return
  }
  let mut rest = chunk
  if self.head.length() < SECRET_RUN_HEAD_MAX {
    let need = SECRET_RUN_HEAD_MAX - self.head.length()
    let take = if rest.length() < need { rest.length() } else { need }
    self.head = sr_bytes_concat(self.head, sr_bytes_slice(rest, 0, take))
    rest = sr_bytes_slice(rest, take, rest.length())
  }
  if rest.length() == 0 {
    return
  }
  let all = sr_bytes_concat(self.tail, rest)
  if all.length() > SECRET_RUN_TAIL_MAX {
    self.cut = true
    self.tail = sr_bytes_slice(all, all.length() - SECRET_RUN_TAIL_MAX, all.length())
  } else {
    self.tail = all
  }
}

fn sr_bytes_to_utf8_safe(b : Bytes) -> String {
  sql_db::decode_utf8_lossy_bytes(b)
}

fn SecretRunKept::text(self : SecretRunKept) -> String {
  if self.cut {
    sr_bytes_to_utf8_safe(self.head) + "\n…(cut)…\n" + sr_bytes_to_utf8_safe(self.tail)
  } else {
    sr_bytes_to_utf8_safe(sr_bytes_concat(self.head, self.tail))
  }
}

// ---------------------------------------------------------------------------
// JSON-RPC 2.0 MCP Response Builders
// ---------------------------------------------------------------------------

pub fn encode_mcp_tool_rpc_result(
  rpc_id : base_codec::Json,
  text : String,
  is_error : Bool,
  ended_meta : Option[base_codec::Json] = None,
) -> String {
  // Reuse `station_tools::tool_result_json` directly: `secret_run` has `ends_turn = false`,
  // so `ended_meta` (e.g. `claude/endTurn: true`) is NEVER attached to success, refusal, or timeout!
  let reply = if is_error {
    station_tools::error_reply(text)
  } else {
    station_tools::text_reply(text)
  }
  base_codec::json_stringify(
    base_codec::json_obj([
      ("jsonrpc", base_codec::json_str("2.0")),
      ("id", rpc_id),
      ("result", station_tools::tool_result_json(reply, ended_meta)),
    ]),
  )
}

fn respond_mcp_deferred(
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  conn_id : Int,
  rpc_id : base_codec::Json,
  text : String,
  is_error : Bool,
  ended_meta : Option[base_codec::Json] = None,
) -> Unit {
  let body = encode_mcp_tool_rpc_result(rpc_id, text, is_error, ended_meta=ended_meta)
  let _ = mcp_srv.respond_with_callbacks(
    conn_id,
    station_http::HandlerAction::Respond(station_http::HttpResponse::json(200, body)),
    mcp_cb,
  )
}

// ---------------------------------------------------------------------------
// Base Environment & File/Proxy/SSH Helpers
// ---------------------------------------------------------------------------

/// Filter out station/agent sensitive environment variable prefixes (1:1 Node `incoming.ts:28-30`).
/// Applied ONLY to the inherited station environment — NEVER to explicitly approved grant overrides!
pub fn is_sensitive_station_env_key(key : String) -> Bool {
  key.starts_with("STILLFAIL_")
  || key.starts_with("ANTHROPIC_")
  || key.starts_with("CLAUDE_")
  || key.starts_with("OPENAI_")
  || key.starts_with("CODEX_")
}

/// Pure DI child-env builder: filters sensitive prefixes from `base`, then ALWAYS applies `overrides`
/// (so explicitly approved secrets like `OPENAI_API_KEY` or `ANTHROPIC_API_KEY` are delivered!).
pub fn build_child_env_from(base : Array[String], overrides : Array[(String, String)]) -> Array[String] {
  let override_keys : Map[String, Bool] = Map::new()
  for i in 0..<overrides.length() {
    override_keys.set(overrides[i].0, true)
  }
  let out : Array[String] = []
  for i in 0..<base.length() {
    let entry = base[i]
    let mut eq = -1
    let bs = entry.to_bytes()
    for j in 0..<bs.length() {
      if (bs[j].to_int() & 0xFF) == 61 {
        eq = j
        break
      }
    }
    if eq > 0 {
      let k = entry.slice(0, eq)
      if override_keys.contains(k) || is_sensitive_station_env_key(k) {
        continue
      }
    }
    out.push(entry)
  }
  for i in 0..<overrides.length() {
    let (k, v) = overrides[i]
    out.push(k + "=" + v)
  }
  out
}

fn build_child_env(overrides : Array[(String, String)]) -> Array[String] {
  build_child_env_from(station_sys::env_all(), overrides)
}

/// Terminate the managed child's process group (`SIGKILL`) strictly via the managed `ChildProcess`
/// handle (NEVER calling bare `proc_kill(pid)` after `waitpid` to avoid PID-reuse hazards!).
fn kill_run_pgroup(child : station_sys::ChildProcess) -> Unit {
  let _ = child.kill(station_sys::SIG_KILL, true)
}

fn sr_file_hidden_values(raw_bytes : Bytes, b64 : String) -> Array[String] {
  let text = sr_bytes_to_utf8_safe(raw_bytes)
  let mut trimmed = text
  if trimmed.ends_with("\r\n") {
    trimmed = trimmed.slice(0, trimmed.length() - 2)
  } else if trimmed.ends_with("\n") {
    trimmed = trimmed.slice(0, trimmed.length() - 1)
  }
  if trimmed.length() > 0 && trimmed != b64 {
    [trimmed, b64]
  } else {
    [b64]
  }
}

fn sr_posix_shell() -> String {
  if station_sys::os_name() == "win32" {
    "sh"
  } else {
    "/bin/sh"
  }
}

fn sr_create_private_dir(sep : String, prefix : String) -> Result[String, String] {
  let tmp_base = station_sys::tmpdir()
  for _ in 0..<4 {
    let rand = match station_sys::random_bytes(16) {
      Ok(b) if b.length() >= 16 => b
      _ => return Err("CSPRNG failed for private temp directory")
    }
    let dir = nodepath::join(sep, [tmp_base, prefix + crypto::bytes_to_hex(rand)])
    if station_sys::mkdir_exclusive(dir) {
      let _ = station_sys::mkdir_mode(dir, 448)
      return Ok(dir)
    }
  }
  Err("failed to exclusively create private temp directory")
}

// ---------------------------------------------------------------------------
// Active & Pending Run Records
// ---------------------------------------------------------------------------

struct PendingProxyRun {
  conn_id : Int
  rpc_id : base_codec::Json
  ended_meta : Option[base_codec::Json]
  prep : station_whole::PreparedSecretRun
  now_ms : Int64
  deadline_ms : Int64
}

struct StartingSshRun {
  run_seq : Int64
  conn_id : Int
  rpc_id : base_codec::Json
  ended_meta : Option[base_codec::Json]
  prep : station_whole::PreparedSecretRun
  agent : station_vault::SshAgentServer
  dir_path : String
  now_ms : Int64
  deadline_ms : Int64
}

/// Tombstone for a closed `SshAgentServer` retained until in-flight `LISTEN`/`CLOSE`/`UNLINK`
/// completions finish (or deadline cap `expire_ms` passes), then immediately removed.
struct ClosingSshEntry {
  agent : station_vault::SshAgentServer
  dir_path : String
  mut listen_pending : Bool
  mut pending_ops : Int
  expire_ms : Int64
}

struct ActiveSecretRun {
  ev_id : Int64
  conn_id : Int
  rpc_id : base_codec::Json
  ended_meta : Option[base_codec::Json]
  prep : station_whole::PreparedSecretRun
  child : station_sys::ChildProcess
  deadline_ms : Int64
  kept : SecretRunKept
  out_scrubber : station_vault::Scrubber
  err_scrubber : station_vault::Scrubber
  mut timed_out : Bool
  mut stdout_eof : Bool
  mut stderr_eof : Bool
  mut exited : Bool
  mut exit_code : Option[Int]
  mut exit_signal : Option[String]
  mut cleanup_file : Option[String]
  mut cleanup_dir : Option[String]
  mut proxy_token : Option[String]
  mut ssh_agent : Option[station_vault::SshAgentServer]
}

pub struct SecretRunManager {
  data_dir : String
  sep : String
  mut whole_store : Option[station_whole::WholeStore]
  mut next_ev_id : Int64
  mut next_ssh_seq : Int64
  mut proxy : Option[station_vault::VaultProxy]
  mut proxy_bundle_path : String
  mut proxy_starting : Bool
  grant_sessions : Map[String, String]
  waiting_proxy : Array[PendingProxyRun]
  starting_ssh : Map[Int64, StartingSshRun]
  active_ssh : Map[Int64, Int64]
  closing_ssh : Map[Int64, ClosingSshEntry]
  active : Map[Int64, ActiveSecretRun]
}

pub fn SecretRunManager::new(data_dir : String, sep : String) -> SecretRunManager {
  SecretRunManager::{
    data_dir: data_dir,
    sep: sep,
    whole_store: None,
    next_ev_id: SECRET_RUN_EVENT_BASE,
    next_ssh_seq: 1L,
    proxy: None,
    proxy_bundle_path: "",
    proxy_starting: false,
    grant_sessions: Map::new(),
    waiting_proxy: [],
    starting_ssh: Map::new(),
    active_ssh: Map::new(),
    closing_ssh: Map::new(),
    active: Map::new(),
  }
}

pub fn SecretRunManager::attach_store(self : SecretRunManager, store : station_whole::WholeStore) -> Unit {
  self.whole_store = Some(store)
}

pub fn SecretRunManager::closing_ssh_count(self : SecretRunManager) -> Int {
  self.closing_ssh.length()
}

fn sr_getenv(key : String) -> Option[String] {
  let prefix = key + "="
  let all = station_sys::env_all()
  for i in 0..<all.length() {
    if all[i].starts_with(prefix) {
      return Some(all[i].slice(prefix.length(), all[i].length()))
    }
  }
  None
}

fn SecretRunManager::ensure_proxy(
  self : SecretRunManager,
  mux : builders_core::ShellMux,
  wall_ms : Int64,
) -> Result[station_vault::VaultProxy, String] {
  match self.proxy {
    Some(p) => return Ok(p)
    None => ()
  }
  let vault_dir = nodepath::join(self.sep, [self.data_dir, "vault"])
  let _ = station_sys::mkdir_mode(vault_dir, 448)
  let seed = match station_sys::random_bytes(32) {
    Ok(b) if b.length() >= 32 => b
    Ok(_) => return Err("CSPRNG returned fewer than 32 bytes for vault proxy")
    Err(e) => return Err("CSPRNG failed for vault proxy: " + e)
  }
  let serial_seed = match station_sys::random_bytes(16) {
    Ok(b) if b.length() >= 16 => b
    _ => return Err("CSPRNG failed for vault proxy CA serial")
  }
  let ca = match station_vault::make_ca(wall_ms, station_vault::DEFAULT_CA_NAME, seed, serial_seed) {
    Ok(c) => c
    Err(e) => return Err("failed to create vault proxy CA: " + e)
  }
  let p = match station_vault::VaultProxy::new_with_seed(ca, seed) {
    Ok(vp) => vp
    Err(e) => return Err(e)
  }
  // Live `GrantStore` revocation/archive check + `"use"` audit callback on every proxy swap.
  let mgr_ref = self
  p.check_active = Some(
    fn(gid : String) -> Bool {
      match (mgr_ref.whole_store, mgr_ref.grant_sessions.get(gid)) {
        (Some(ws), Some(sess)) => station_whole::vault_is_grant_active_live(ws, sess, gid, host_shim::wall_ms() / 1000L)
        _ => true
      }
    },
  )
  p.on_use = Some(
    fn(gid : String, host : String) -> Unit {
      match (mgr_ref.whole_store, mgr_ref.grant_sessions.get(gid)) {
        (Some(ws), Some(sess)) => station_whole::vault_renew_and_audit_use(ws, sess, gid, host, host_shim::wall_ms() / 1000L)
        _ => ()
      }
    },
  )
  // Optional test/custom upstream CA PEM (via `STILLFAIL_VAULT_PROXY_CA` file path).
  let mut extra_ca = ""
  match sr_getenv("STILLFAIL_VAULT_PROXY_CA") {
    Some(ca_path) if ca_path.trim().length() > 0 => {
      match station_sys::read_file_strict(ca_path.trim()) {
        Ok(b) => {
          let pem_str = sr_bytes_to_utf8_safe(b)
          if pem_str.length() > 0 {
            p.upstream_ca_pem = Some(pem_str)
            extra_ca = pem_str + "\n"
          }
        }
        Err(_) => ()
      }
    }
    _ => ()
  }
  // Include system root CAs if available, plus any test CA (`STILLFAIL_VAULT_PROXY_CA`) and our vault CA.
  let mut sys_ca = ""
  let sys_ca_candidates = [
    "/etc/ssl/certs/ca-certificates.crt",
    "/etc/pki/tls/certs/ca-bundle.crt",
    "/etc/ssl/cert.pem",
  ]
  for ci in 0..<sys_ca_candidates.length() {
    match station_sys::read_file_strict(sys_ca_candidates[ci]) {
      Ok(b) if b.length() > 0 => {
        sys_ca = sr_bytes_to_utf8_safe(b) + "\n"
        break
      }
      _ => ()
    }
  }
  let bundle_path = nodepath::join(self.sep, [vault_dir, "ca-bundle.pem"])
  let bundle_pem = sys_ca + extra_ca + ca.cert_pem()
  let _ = station_sys::write_file_mode(bundle_path, bundle_pem.to_bytes(), mode=420, append=false)
  self.proxy_bundle_path = bundle_path
  self.proxy = Some(p)
  let _ = mux
  Ok(p)
}

fn SecretRunManager::alloc_ev_id(self : SecretRunManager) -> Result[Int64, String] {
  if self.next_ev_id >= SECRET_RUN_EVENT_END {
    return Err("secret_run event_id segment exhausted")
  }
  let id = self.next_ev_id
  self.next_ev_id = self.next_ev_id + 1L
  Ok(id)
}

fn SecretRunManager::spawn_active_run(
  self : SecretRunManager,
  mux : builders_core::ShellMux,
  conn_id : Int,
  rpc_id : base_codec::Json,
  ended_meta : Option[base_codec::Json],
  prep : station_whole::PreparedSecretRun,
  env_overrides : Array[(String, String)],
  hidden_values : Array[String],
  cleanup_file : Option[String],
  cleanup_dir : Option[String],
  proxy_token : Option[String],
  ssh_agent : Option[station_vault::SshAgentServer],
  now_ms : Int64,
) -> Result[Unit, String] {
  let ev_id = match self.alloc_ev_id() {
    Ok(id) => id
    Err(e) => {
      self.cleanup_resources(mux, cleanup_file, cleanup_dir, proxy_token, ssh_agent, false, now_ms)
      self.maybe_gc_grant_session(prep.grant_id)
      return Err(e)
    }
  }
  // Re-verify canonical workspace boundary right before `proc_spawn` (closes TOCTOU symlink swaps).
  let verified_cwd = match station_whole::vault_resolve_cwd_in_workspace(prep.workspace, Some(prep.cwd)) {
    Ok(c) => c
    Err(e) => {
      self.cleanup_resources(mux, cleanup_file, cleanup_dir, proxy_token, ssh_agent, false, now_ms)
      self.maybe_gc_grant_session(prep.grant_id)
      return Err(e)
    }
  }
  let _ = station_sys::mkdir_p(verified_cwd)
  let full_env = build_child_env(env_overrides)
  let opts = station_sys::SpawnOptions::{
    program: sr_posix_shell(),
    args: ["-c", prep.command],
    env: Some(full_env),
    cwd: verified_cwd,
    new_pgid: true,
    strip_malloc_space_efficient: false,
    pipe_stdin: false,
    pipe_stdout: true,
    pipe_stderr: true,
  }
  match station_sys::proc_spawn(ev_id, opts) {
    Ok(child) => {
      self.grant_sessions.set(prep.grant_id, prep.session)
      match ssh_agent {
        Some(ag) => self.active_ssh.set(ag.run_seq, ev_id)
        None => ()
      }
      let run = ActiveSecretRun::{
        ev_id: ev_id,
        conn_id: conn_id,
        rpc_id: rpc_id,
        ended_meta: ended_meta,
        prep: prep,
        child: child,
        deadline_ms: now_ms + prep.timeout_ms,
        kept: SecretRunKept::new(),
        out_scrubber: station_vault::Scrubber::new(hidden_values),
        err_scrubber: station_vault::Scrubber::new(hidden_values),
        timed_out: false,
        stdout_eof: false,
        stderr_eof: false,
        exited: false,
        exit_code: None,
        exit_signal: None,
        cleanup_file: cleanup_file,
        cleanup_dir: cleanup_dir,
        proxy_token: proxy_token,
        ssh_agent: ssh_agent,
      }
      self.active.set(ev_id, run)
      Ok(())
    }
    Err(e) => {
      self.cleanup_resources(mux, cleanup_file, cleanup_dir, proxy_token, ssh_agent, false, now_ms)
      self.maybe_gc_grant_session(prep.grant_id)
      Err("could not start shell: " + e)
    }
  }
}

fn SecretRunManager::maybe_gc_grant_session(self : SecretRunManager, grant_id : String) -> Unit {
  let akeys = self.active.keys()
  for i in 0..<akeys.length() {
    match self.active.get(akeys[i]) {
      Some(r) if r.prep.grant_id == grant_id => return
      _ => ()
    }
  }
  for i in 0..<self.waiting_proxy.length() {
    if self.waiting_proxy[i].prep.grant_id == grant_id {
      return
    }
  }
  let skeys = self.starting_ssh.keys()
  for i in 0..<skeys.length() {
    match self.starting_ssh.get(skeys[i]) {
      Some(sr) if sr.prep.grant_id == grant_id => return
      _ => ()
    }
  }
  self.grant_sessions.remove(grant_id)
}

fn SecretRunManager::cleanup_resources(
  self : SecretRunManager,
  mux : builders_core::ShellMux,
  cleanup_file : Option[String],
  cleanup_dir : Option[String],
  proxy_token : Option[String],
  ssh_agent : Option[station_vault::SshAgentServer],
  ssh_listen_pending : Bool,
  now_ms : Int64,
) -> Unit {
  match proxy_token {
    Some(tok) => match self.proxy {
      Some(p) => { let _ = p.revoke_token(tok) }
      None => ()
    }
    None => ()
  }
  match ssh_agent {
    Some(ag) => {
      self.active_ssh.remove(ag.run_seq)
      let had_listener = ag.is_listening()
      ag.close(mux)
      let dpath = match cleanup_dir { Some(d) => d, None => "" }
      // Retain closed agent tombstone with exact in-flight op count + 30s expiry cap.
      let expected_ops = (if ssh_listen_pending { 1 } else { 0 }) + (if had_listener { 2 } else { 1 })
      self.closing_ssh.set(
        ag.run_seq,
        ClosingSshEntry::{
          agent: ag,
          dir_path: dpath,
          listen_pending: ssh_listen_pending,
          pending_ops: expected_ops,
          expire_ms: now_ms + 30000L,
        },
      )
      let _ = station_vault::unlink_socket_sys(ag.socket_path)
    }
    None => ()
  }
  match cleanup_file {
    Some(fp) => { let _ = station_sys::unlink(fp) }
    None => ()
  }
  match cleanup_dir {
    Some(dp) => { let _ = station_sys::rmdir(dp) }
    None => ()
  }
}

fn SecretRunManager::launch_proxy_run(
  self : SecretRunManager,
  mux : builders_core::ShellMux,
  p : station_vault::VaultProxy,
  pr : PendingProxyRun,
) -> Result[Unit, String] {
  self.grant_sessions.set(pr.prep.grant_id, pr.prep.session)
  let (token, proxy_url) = match p.admit(
    pr.prep.grant_id,
    pr.prep.hosts,
    station_vault::DeliveryMode::Proxy,
    pr.prep.secret_value,
    pr.prep.expires_sec,
  ) {
    Ok(pair) => pair
    Err(e) => {
      self.maybe_gc_grant_session(pr.prep.grant_id)
      return Err("proxy admit failed: " + e)
    }
  }
  let stand = station_vault::placeholder(pr.prep.grant_id)
  let overrides : Array[(String, String)] = [
    ("HTTPS_PROXY", proxy_url),
    ("https_proxy", proxy_url),
    ("NO_PROXY", ""),
    ("no_proxy", ""),
    ("NODE_EXTRA_CA_CERTS", self.proxy_bundle_path),
    ("SSL_CERT_FILE", self.proxy_bundle_path),
    ("REQUESTS_CA_BUNDLE", self.proxy_bundle_path),
    ("CURL_CA_BUNDLE", self.proxy_bundle_path),
    ("GIT_SSL_CAINFO", self.proxy_bundle_path),
    (station_whole::VAULT_SECRET_VAR, stand),
  ]
  // Explicitly approved target env var MUST ALWAYS be injected (including `OPENAI_API_KEY`, `ANTHROPIC_API_KEY`!).
  match pr.prep.target_env {
    Some(ev) if ev.length() > 0 => overrides.push((ev, stand))
    _ => ()
  }
  match pr.prep.account {
    Some(acc) => overrides.push((station_whole::VAULT_ACCOUNT_VAR, acc))
    None => ()
  }
  self.spawn_active_run(
    mux,
    pr.conn_id,
    pr.rpc_id,
    pr.ended_meta,
    pr.prep,
    overrides,
    [pr.prep.secret_value],
    None,
    None,
    Some(token),
    None,
    pr.now_ms,
  )
}

/// Start a validated `PreparedSecretRun` asynchronously (NEVER blocks, NEVER calls `host_shim::wait`).
/// On `Ok(())`, the caller MUST return `HandlerAction::Defer`.
/// On `Err(msg)`, NOTHING was responded yet: caller MUST return `HandlerAction::Respond(err)` synchronously!
pub fn SecretRunManager::start_run(
  self : SecretRunManager,
  mux : builders_core::ShellMux,
  conn_id : Int,
  rpc_id : base_codec::Json,
  ended_meta : Option[base_codec::Json],
  prep : station_whole::PreparedSecretRun,
  now_ms : Int64,
  wall_ms : Int64,
) -> Result[Unit, String] {
  match prep.mode {
    station_vault::DeliveryMode::Proxy => {
      let p = match self.ensure_proxy(mux, wall_ms) {
        Ok(vp) => vp
        Err(e) => return Err(e)
      }
      let pr = PendingProxyRun::{
        conn_id: conn_id,
        rpc_id: rpc_id,
        ended_meta: ended_meta,
        prep: prep,
        now_ms: now_ms,
        deadline_ms: now_ms + prep.timeout_ms,
      }
      if p.is_listening() {
        return self.launch_proxy_run(mux, p, pr)
      }
      self.waiting_proxy.push(pr)
      if !self.proxy_starting {
        self.proxy_starting = true
        let _ = p.start(mux)
      }
      Ok(())
    }
    station_vault::DeliveryMode::Ssh => {
      let ssh_key = match station_vault::parse_openssh_ed25519_key(prep.secret_value) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      let dir = match sr_create_private_dir(self.sep, "sf-ssh-") {
        Ok(d) => d
        Err(e) => return Err(e)
      }
      let sock_path = nodepath::join(self.sep, [dir, "agent.sock"])
      let seq = self.next_ssh_seq
      self.next_ssh_seq = self.next_ssh_seq + 1L
      let agent = station_vault::SshAgentServer::new(sock_path, ssh_key)
      agent.run_seq = seq
      let _ = agent.start(mux)
      self.starting_ssh.set(
        seq,
        StartingSshRun::{
          run_seq: seq,
          conn_id: conn_id,
          rpc_id: rpc_id,
          ended_meta: ended_meta,
          prep: prep,
          agent: agent,
          dir_path: dir,
          now_ms: now_ms,
          deadline_ms: now_ms + prep.timeout_ms,
        },
      )
      Ok(())
    }
    station_vault::DeliveryMode::File => {
      let raw_bytes = match base64::decode(prep.secret_value) {
        Ok(b) => b
        Err(_) => return Err("file secret is not valid base64")
      }
      let dir = match sr_create_private_dir(self.sep, "sf-file-") {
        Ok(d) => d
        Err(e) => return Err(e)
      }
      let fname = station_whole::vault_safe_secret_filename(prep.secret_filename)
      let fpath = nodepath::join(self.sep, [dir, fname])
      if !station_sys::write_file_mode(fpath, raw_bytes, mode=384, append=false) {
        let _ = station_sys::unlink(fpath)
        let _ = station_sys::rmdir(dir)
        return Err("failed to write 0600 secret file")
      }
      let overrides : Array[(String, String)] = [(station_whole::VAULT_SECRET_VAR, fpath)]
      match prep.target_env {
        Some(ev) if ev.length() > 0 => overrides.push((ev, fpath))
        _ => ()
      }
      match prep.account {
        Some(acc) => overrides.push((station_whole::VAULT_ACCOUNT_VAR, acc))
        None => ()
      }
      let hidden = sr_file_hidden_values(raw_bytes, prep.secret_value)
      self.spawn_active_run(
        mux,
        conn_id,
        rpc_id,
        ended_meta,
        prep,
        overrides,
        hidden,
        Some(fpath),
        Some(dir),
        None,
        None,
        now_ms,
      )
    }
    _ => {
      // `env` delivery mode: inherit filtered OS base env + ALWAYS inject approved secret into
      // `STILLFAIL_SECRET` & target var (including `OPENAI_API_KEY`, `ANTHROPIC_API_KEY`!).
      let overrides : Array[(String, String)] = [(station_whole::VAULT_SECRET_VAR, prep.secret_value)]
      match prep.target_env {
        Some(ev) if ev.length() > 0 => overrides.push((ev, prep.secret_value))
        _ => ()
      }
      match prep.account {
        Some(acc) => overrides.push((station_whole::VAULT_ACCOUNT_VAR, acc))
        None => ()
      }
      self.spawn_active_run(
        mux,
        conn_id,
        rpc_id,
        ended_meta,
        prep,
        overrides,
        [prep.secret_value],
        None,
        None,
        None,
        None,
        now_ms,
      )
    }
  }
}

fn SecretRunManager::finish_run(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  ev_id : Int64,
  now_ms : Int64,
  wall_ms : Int64,
) -> Unit {
  let run = match self.active.get(ev_id) {
    Some(r) => r
    None => return
  }
  self.active.remove(ev_id)
  run.kept.add(run.out_scrubber.end())
  run.kept.add(run.err_scrubber.end())
  let _ = run.child.close()
  self.cleanup_resources(mux, run.cleanup_file, run.cleanup_dir, run.proxy_token, run.ssh_agent, false, now_ms)
  self.maybe_gc_grant_session(run.prep.grant_id)
  match self.whole_store {
    Some(ws) => {
      station_whole::vault_record_audit_by_grant(
        ws,
        run.prep.session,
        run.prep.grant_id,
        "run",
        run.prep.command,
        wall_ms / 1000L,
      )
    }
    None => ()
  }
  if mcp_srv.has_live_conn(run.conn_id) {
    let formatted = station_whole::format_secret_run_output(
      run.exit_code,
      run.exit_signal,
      run.timed_out,
      run.kept.cut,
      run.kept.text(),
    )
    respond_mcp_deferred(mcp_srv, mcp_cb, run.conn_id, run.rpc_id, formatted, false, ended_meta=run.ended_meta)
  }
}

fn SecretRunManager::finish_if_ready(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  ev_id : Int64,
  wall_ms : Int64,
) -> Unit {
  let run = match self.active.get(ev_id) {
    Some(r) => r
    None => return
  }
  if !run.exited || !run.stdout_eof || !run.stderr_eof {
    return
  }
  self.finish_run(mcp_srv, mcp_cb, mux, ev_id, host_shim::now_ms(), wall_ms)
}

/// Handle `HostEvent::Sys` events in our disjoint `[11 << 32, 12 << 32)` half-open segment.
pub fn SecretRunManager::handle_sys_event(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  ev_id : Int64,
  sev : station_sys::SysEvent,
  wall_ms : Int64,
) -> Bool {
  if ev_id < SECRET_RUN_EVENT_BASE || ev_id >= SECRET_RUN_EVENT_END {
    return false
  }
  let run = match self.active.get(ev_id) {
    Some(r) => r
    None => return true
  }
  match sev {
    station_sys::SysEvent::ProcStdout(chunk) => {
      run.kept.add(run.out_scrubber.push(chunk))
    }
    station_sys::SysEvent::ProcStderr(chunk) => {
      run.kept.add(run.err_scrubber.push(chunk))
    }
    station_sys::SysEvent::ProcStdoutEof => {
      run.stdout_eof = true
      self.finish_if_ready(mcp_srv, mcp_cb, mux, ev_id, wall_ms)
    }
    station_sys::SysEvent::ProcStderrEof => {
      run.stderr_eof = true
      self.finish_if_ready(mcp_srv, mcp_cb, mux, ev_id, wall_ms)
    }
    station_sys::SysEvent::ProcExit(es) => {
      run.exited = true
      if es.signal > 0 {
        run.exit_code = None
        run.exit_signal = Some(if es.signal_name.length() > 0 { es.signal_name } else { "SIG" + es.signal.to_string() })
      } else {
        run.exit_code = Some(es.code)
        run.exit_signal = None
      }
      self.finish_if_ready(mcp_srv, mcp_cb, mux, ev_id, wall_ms)
    }
    _ => ()
  }
  true
}

/// Route `VaultProxy` (`9201..=9210`) and `SshAgentServer` (`9101..=9108`) `ShellMux` completions.
/// SSH completions are routed strictly by unique `run_seq` (`extra` slot) — ZERO FIFO mixup!
pub fn SecretRunManager::handle_role_done(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  tok : builders_core::MuxToken,
  done : host_shim::ShellDone,
  now_ms : Int64,
  wall_ms : Int64,
) -> Bool {
  match tok {
    builders_core::MuxToken::Tagged(tag, _, extra) => {
      // VaultProxy tags: 9201..=9210
      if tag >= station_vault::PROXY_MUX_TAG_LISTEN && tag <= station_vault::PROXY_MUX_TAG_CLOSE {
        match self.proxy {
          Some(p) => {
            let handled = p.on_shell_done(mux, tok, done, wall_ms, wall_ms / 1000L)
            if tag == station_vault::PROXY_MUX_TAG_LISTEN {
              self.proxy_starting = false
              let queued : Array[PendingProxyRun] = []
              for i in 0..<self.waiting_proxy.length() {
                queued.push(self.waiting_proxy[i])
              }
              self.waiting_proxy.clear()
              if p.is_listening() {
                for i in 0..<queued.length() {
                  let pr = queued[i]
                  if !mcp_srv.has_live_conn(pr.conn_id) {
                    continue
                  }
                  if now_ms >= pr.deadline_ms {
                    respond_mcp_deferred(
                      mcp_srv,
                      mcp_cb,
                      pr.conn_id,
                      pr.rpc_id,
                      "stopped: it ran too long (proxy startup timed out)",
                      true,
                      ended_meta=pr.ended_meta,
                    )
                    continue
                  }
                  match self.launch_proxy_run(mux, p, pr) {
                    Ok(_) => ()
                    Err(e) => respond_mcp_deferred(mcp_srv, mcp_cb, pr.conn_id, pr.rpc_id, e, true, ended_meta=pr.ended_meta)
                  }
                }
              } else {
                for i in 0..<queued.length() {
                  if mcp_srv.has_live_conn(queued[i].conn_id) {
                    respond_mcp_deferred(
                      mcp_srv,
                      mcp_cb,
                      queued[i].conn_id,
                      queued[i].rpc_id,
                      "vault proxy failed to listen: " + done.error,
                      true,
                      ended_meta=queued[i].ended_meta,
                    )
                  }
                }
              }
            }
            return handled
          }
          None => return false
        }
      }
      // SshAgentServer tags: 9101..=9108 — exact `run_seq` routing!
      if tag >= station_vault::SSH_MUX_TAG_LISTEN && tag <= station_vault::SSH_MUX_TAG_CHMOD {
        let run_seq = extra
        // 1. Check starting SSH agent keyed by `run_seq`.
        match self.starting_ssh.get(run_seq) {
          Some(sr) => {
            let _ = sr.agent.on_shell_done(mux, tok, done, true)
            if tag == station_vault::SSH_MUX_TAG_LISTEN {
              self.starting_ssh.remove(run_seq)
              if !mcp_srv.has_live_conn(sr.conn_id) || now_ms >= sr.deadline_ms {
                sr.agent.close(mux)
                self.closing_ssh.set(
                  run_seq,
                  ClosingSshEntry::{
                    agent: sr.agent,
                    dir_path: sr.dir_path,
                    listen_pending: false,
                    pending_ops: 2,
                    expire_ms: now_ms + 30000L,
                  },
                )
                let _ = station_vault::unlink_socket_sys(sr.agent.socket_path)
                let _ = station_sys::rmdir(sr.dir_path)
                if mcp_srv.has_live_conn(sr.conn_id) {
                  respond_mcp_deferred(
                    mcp_srv,
                    mcp_cb,
                    sr.conn_id,
                    sr.rpc_id,
                    "stopped: it ran too long (ssh-agent startup timed out)",
                    true,
                    ended_meta=sr.ended_meta,
                  )
                }
              } else if sr.agent.is_listening() {
                let overrides : Array[(String, String)] = [("SSH_AUTH_SOCK", sr.agent.socket_path)]
                match sr.prep.account {
                  Some(acc) => overrides.push((station_whole::VAULT_ACCOUNT_VAR, acc))
                  None => ()
                }
                match self.spawn_active_run(
                  mux,
                  sr.conn_id,
                  sr.rpc_id,
                  sr.ended_meta,
                  sr.prep,
                  overrides,
                  [sr.prep.secret_value],
                  None,
                  Some(sr.dir_path),
                  None,
                  Some(sr.agent),
                  sr.now_ms,
                ) {
                  Ok(_) => ()
                  Err(e) => respond_mcp_deferred(mcp_srv, mcp_cb, sr.conn_id, sr.rpc_id, e, true, ended_meta=sr.ended_meta)
                }
              } else {
                let err_msg = match sr.agent.start_error() {
                  Some(e) => e
                  None => "ssh-agent failed to start"
                }
                sr.agent.close(mux)
                self.closing_ssh.set(
                  run_seq,
                  ClosingSshEntry::{
                    agent: sr.agent,
                    dir_path: sr.dir_path,
                    listen_pending: false,
                    pending_ops: 1,
                    expire_ms: now_ms + 30000L,
                  },
                )
                let _ = station_vault::unlink_socket_sys(sr.agent.socket_path)
                let _ = station_sys::rmdir(sr.dir_path)
                respond_mcp_deferred(mcp_srv, mcp_cb, sr.conn_id, sr.rpc_id, err_msg, true, ended_meta=sr.ended_meta)
              }
            }
            return true
          }
          None => ()
        }
        // 2. Check active SSH agent keyed by `run_seq`.
        match self.active_ssh.get(run_seq) {
          Some(ev_id) => match self.active.get(ev_id) {
            Some(run) => match run.ssh_agent {
              Some(ag) => {
                let now_sec = wall_ms / 1000L
                let live_ok = match self.whole_store {
                  Some(ws) => station_whole::vault_is_grant_active_live(ws, run.prep.session, run.prep.grant_id, now_sec)
                  None => run.prep.expires_sec > now_sec
                }
                let allowed = !run.timed_out && live_ok
                let prev_signs = ag.sign_count()
                let handled = ag.on_shell_done(mux, tok, done, allowed)
                if ag.sign_count() > prev_signs {
                  match self.whole_store {
                    Some(ws) => station_whole::vault_renew_and_audit_use(ws, run.prep.session, run.prep.grant_id, "ssh sign", now_sec)
                    None => ()
                  }
                }
                return handled
              }
              None => ()
            }
            None => ()
          }
          None => ()
        }
        // 3. Closed SSH agent tombstones: reclaim late LISTEN/ACCEPT handles, decrement `pending_ops`,
        //    and remove immediately once `!listen_pending && pending_ops <= 0`!
        match self.closing_ssh.get(run_seq) {
          Some(entry) => {
            let _ = entry.agent.on_shell_done(mux, tok, done, false)
            if tag == station_vault::SSH_MUX_TAG_LISTEN {
              entry.listen_pending = false
              let _ = station_vault::unlink_socket_sys(entry.agent.socket_path)
              if entry.dir_path.length() > 0 {
                let _ = station_sys::rmdir(entry.dir_path)
              }
            }
            if entry.pending_ops > 0 {
              entry.pending_ops = entry.pending_ops - 1
            }
            if !entry.listen_pending && entry.pending_ops <= 0 {
              self.closing_ssh.remove(run_seq)
            }
            return true
          }
          None => ()
        }
        return true
      }
      false
    }
    _ => false
  }
}

/// Enforce process-group timeouts for starting proxy/SSH runs and active runs (without killing
/// running commands prematurely on HTTP disconnect — matching Node `run.ts`), reap expired
/// `closing_ssh` tombstones, and purge expired proxy tokens.
pub fn SecretRunManager::tick(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  now_ms : Int64,
  wall_ms : Int64,
) -> Unit {
  // 1. Timeout stuck pending proxy runs (commit `keep` BEFORE replying for HTTP pipelining safety!).
  if self.waiting_proxy.length() > 0 {
    let keep : Array[PendingProxyRun] = []
    let expired : Array[PendingProxyRun] = []
    for i in 0..<self.waiting_proxy.length() {
      let pr = self.waiting_proxy[i]
      if now_ms >= pr.deadline_ms {
        expired.push(pr)
      } else {
        keep.push(pr)
      }
    }
    self.waiting_proxy.clear()
    for i in 0..<keep.length() {
      self.waiting_proxy.push(keep[i])
    }
    for i in 0..<expired.length() {
      if mcp_srv.has_live_conn(expired[i].conn_id) {
        respond_mcp_deferred(
          mcp_srv,
          mcp_cb,
          expired[i].conn_id,
          expired[i].rpc_id,
          "stopped: it ran too long (proxy startup timed out)",
          true,
          ended_meta=expired[i].ended_meta,
        )
      }
    }
  }
  // 2. Timeout stuck starting SSH runs (keep tombstone with `listen_pending=true` + expiry cap!).
  let skeys = self.starting_ssh.keys()
  for i in 0..<skeys.length() {
    let seq = skeys[i]
    match self.starting_ssh.get(seq) {
      Some(sr) => {
        if now_ms >= sr.deadline_ms {
          self.starting_ssh.remove(seq)
          sr.agent.close(mux)
          self.closing_ssh.set(
            seq,
            ClosingSshEntry::{
              agent: sr.agent,
              dir_path: sr.dir_path,
              listen_pending: true,
              pending_ops: 2,
              expire_ms: now_ms + 30000L,
            },
          )
          let _ = station_vault::unlink_socket_sys(sr.agent.socket_path)
          let _ = station_sys::rmdir(sr.dir_path)
          if mcp_srv.has_live_conn(sr.conn_id) {
            respond_mcp_deferred(
              mcp_srv,
              mcp_cb,
              sr.conn_id,
              sr.rpc_id,
              "stopped: it ran too long (ssh-agent startup timed out)",
              true,
              ended_meta=sr.ended_meta,
            )
          }
        }
      }
      None => ()
    }
  }
  // 3. Timeout active runs — EVEN IF `run.exited == true` (descendant holding pipe open).
  //    On HTTP disconnect, do NOT prematurely kill the command; `finish_run` checks `has_live_conn`.
  let akeys = self.active.keys()
  for i in 0..<akeys.length() {
    let ev_id = akeys[i]
    match self.active.get(ev_id) {
      Some(run) => {
        if !run.timed_out && now_ms >= run.deadline_ms {
          run.timed_out = true
          kill_run_pgroup(run.child)
          self.finish_run(mcp_srv, mcp_cb, mux, ev_id, now_ms, wall_ms)
        }
      }
      None => ()
    }
  }
  // 4. Reap expired `closing_ssh` tombstones so memory stays bounded.
  let ckeys = self.closing_ssh.keys()
  for i in 0..<ckeys.length() {
    let seq = ckeys[i]
    match self.closing_ssh.get(seq) {
      Some(entry) if now_ms >= entry.expire_ms => {
        let _ = station_vault::unlink_socket_sys(entry.agent.socket_path)
        if entry.dir_path.length() > 0 {
          let _ = station_sys::rmdir(entry.dir_path)
        }
        self.closing_ssh.remove(seq)
      }
      _ => ()
    }
  }
  // 5. Purge expired proxy runs.
  match self.proxy {
    Some(p) => { let _ = p.purge_expired_runs(wall_ms / 1000L) }
    None => ()
  }
}

/// Clean shutdown: kill all active `secret_run` process groups, remove temp files/dirs,
/// close all SSH agents & clear tombstones, break proxy RC cycles, and close proxy.
pub fn SecretRunManager::shutdown(self : SecretRunManager, mux : builders_core::ShellMux) -> Unit {
  let now_m = host_shim::now_ms()
  let keys = self.active.keys()
  for i in 0..<keys.length() {
    match self.active.get(keys[i]) {
      Some(run) => {
        kill_run_pgroup(run.child)
        let _ = run.child.close()
        self.cleanup_resources(mux, run.cleanup_file, run.cleanup_dir, run.proxy_token, run.ssh_agent, false, now_m)
      }
      None => ()
    }
  }
  self.active.clear()
  self.active_ssh.clear()
  let skeys = self.starting_ssh.keys()
  for i in 0..<skeys.length() {
    let seq = skeys[i]
    match self.starting_ssh.get(seq) {
      Some(sr) => {
        sr.agent.close(mux)
        let _ = station_vault::unlink_socket_sys(sr.agent.socket_path)
        let _ = station_sys::rmdir(sr.dir_path)
      }
      None => ()
    }
  }
  self.starting_ssh.clear()
  let ckeys = self.closing_ssh.keys()
  for i in 0..<ckeys.length() {
    match self.closing_ssh.get(ckeys[i]) {
      Some(entry) => {
        let _ = station_vault::unlink_socket_sys(entry.agent.socket_path)
        if entry.dir_path.length() > 0 {
          let _ = station_sys::rmdir(entry.dir_path)
        }
      }
      None => ()
    }
  }
  self.closing_ssh.clear()
  self.waiting_proxy.clear()
  self.grant_sessions.clear()
  match self.proxy {
    Some(p) => {
      // Break RC cycle between `SecretRunManager` and `VaultProxy` closures before closing.
      p.check_active = None
      p.on_use = None
      p.close(mux)
    }
    None => ()
  }
}
