// Wave 17E-1: Truly asynchronous, non-blocking `secret_run` runtime for `whole_daemon.pion`.
//
// Invariants:
// - ZERO `host_shim::wait` calls! Every `secret_run` MCP request returns `HandlerAction::Defer`
//   immediately and completes via `HttpServer::respond_with_callbacks` when the event-driven
//   child process exits (keeping `GET /status` and all other endpoints 100% responsive).
// - Disjoint `event_id` segment `9 << 32` (`38654705664L`), never colliding with jobs/browser/
//   terminals/logins/adb/replica-restore/dns-resolve/live-runner (`1<<32..8<<32`).
// - Real delivery modes (1:1 Node `station/src/vault/run.ts`):
//   - `proxy`: local `127.0.0.1` `VaultProxy` (CONNECT MITM on allowlisted hosts only); injects
//     placeholder + `HTTPS_PROXY` + CA bundle into child env (NEVER injects the real secret!).
//   - `ssh`: per-command isolated Unix socket `SshAgentServer`; injects `SSH_AUTH_SOCK` only
//     (NEVER injects the private key!).
//   - `file`: writes `0600` temp file in a `0700` private dir, injects path into env, and
//     unconditionally deletes file + dir on exit/error/timeout/shutdown.
//   - `env`: inherits OS base environment (`PATH`/`HOME`/etc.) + injects `STILLFAIL_SECRET` & target var.
// - Bounded output buffer (`HEAD = 4 KiB`, `TAIL = 28 KiB`) + streaming `station_vault::Scrubber`.
// - Process-group timeout kill (`SIG_KILL`, `group=true`) driven by `on_tick`.

import "base64"
import "base_codec"
import "builders_core"
import "crypto"
import "host_shim"
import "nodepath"
import "station_http"
import "station_sys"
import "station_vault"
import "station_whole"

/// Disjoint event_id base for `secret_run` child processes (`9 << 32`).
pub let SECRET_RUN_EVENT_BASE : Int64 = 38654705664L

let SECRET_RUN_HEAD_MAX : Int = 4096
let SECRET_RUN_TAIL_MAX : Int = 28672

// ---------------------------------------------------------------------------
// Bounded Head/Tail Output Buffer (1:1 Node `run.ts::Kept`)
// ---------------------------------------------------------------------------

struct SecretRunKept {
  mut head : Bytes
  mut tail : Bytes
  mut cut : Bool
}

fn SecretRunKept::new() -> SecretRunKept {
  SecretRunKept::{
    head: Bytes::new(0),
    tail: Bytes::new(0),
    cut: false,
  }
}

fn sr_bytes_concat(a : Bytes, b : Bytes) -> Bytes {
  if a.length() == 0 {
    return b
  }
  if b.length() == 0 {
    return a
  }
  let out = Bytes::new(a.length() + b.length())
  for i in 0..<a.length() {
    out[i] = a[i]
  }
  for i in 0..<b.length() {
    out[a.length() + i] = b[i]
  }
  out
}

fn sr_bytes_slice(b : Bytes, start : Int, end : Int) -> Bytes {
  let s = if start < 0 { 0 } else if start > b.length() { b.length() } else { start }
  let e = if end < s { s } else if end > b.length() { b.length() } else { end }
  let out = Bytes::new(e - s)
  for i in 0..<(e - s) {
    out[i] = b[s + i]
  }
  out
}

fn SecretRunKept::add(self : SecretRunKept, chunk : Bytes) -> Unit {
  if chunk.length() == 0 {
    return
  }
  let mut rest = chunk
  if self.head.length() < SECRET_RUN_HEAD_MAX {
    let need = SECRET_RUN_HEAD_MAX - self.head.length()
    let take = if rest.length() < need { rest.length() } else { need }
    self.head = sr_bytes_concat(self.head, sr_bytes_slice(rest, 0, take))
    rest = sr_bytes_slice(rest, take, rest.length())
  }
  if rest.length() == 0 {
    return
  }
  let all = sr_bytes_concat(self.tail, rest)
  if all.length() > SECRET_RUN_TAIL_MAX {
    self.cut = true
    self.tail = sr_bytes_slice(all, all.length() - SECRET_RUN_TAIL_MAX, all.length())
  } else {
    self.tail = all
  }
}

fn sr_bytes_to_utf8_safe(b : Bytes) -> String {
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

fn SecretRunKept::text(self : SecretRunKept) -> String {
  if self.cut {
    sr_bytes_to_utf8_safe(self.head) + "\n…(cut)…\n" + sr_bytes_to_utf8_safe(self.tail)
  } else {
    sr_bytes_to_utf8_safe(sr_bytes_concat(self.head, self.tail))
  }
}

// ---------------------------------------------------------------------------
// JSON-RPC 2.0 MCP Response Builders
// ---------------------------------------------------------------------------

pub fn encode_mcp_tool_rpc_result(rpc_id : base_codec::Json, text : String, is_error : Bool) -> String {
  let res_fs : Array[(String, base_codec::Json)] = [
    (
      "content",
      base_codec::json_arr([
        base_codec::json_obj([
          ("type", base_codec::json_str("text")),
          ("text", base_codec::json_str(text)),
        ]),
      ]),
    ),
  ]
  if is_error {
    res_fs.push(("isError", base_codec::json_bool(true)))
  }
  base_codec::json_stringify(
    base_codec::json_obj([
      ("jsonrpc", base_codec::json_str("2.0")),
      ("id", rpc_id),
      ("result", base_codec::json_obj(res_fs)),
    ]),
  )
}

fn respond_mcp_deferred(
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  conn_id : Int,
  rpc_id : base_codec::Json,
  text : String,
  is_error : Bool,
) -> Unit {
  let body = encode_mcp_tool_rpc_result(rpc_id, text, is_error)
  let _ = mcp_srv.respond_with_callbacks(
    conn_id,
    station_http::HandlerAction::Respond(station_http::HttpResponse::json(200, body)),
    mcp_cb,
  )
}

// ---------------------------------------------------------------------------
// Base Environment & File/Proxy/SSH Helpers
// ---------------------------------------------------------------------------

fn build_child_env(overrides : Array[(String, String)]) -> Array[String] {
  let base = station_sys::env_all()
  let override_keys : Map[String, Bool] = Map::new()
  for i in 0..<overrides.length() {
    override_keys.set(overrides[i].0, true)
  }
  let out : Array[String] = []
  for i in 0..<base.length() {
    let entry = base[i]
    let mut eq = -1
    let bs = entry.to_bytes()
    for j in 0..<bs.length() {
      if (bs[j].to_int() & 0xFF) == 61 {
        eq = j
        break
      }
    }
    if eq > 0 {
      let k = entry.slice(0, eq)
      if override_keys.contains(k) {
        continue
      }
    }
    out.push(entry)
  }
  for i in 0..<overrides.length() {
    let (k, v) = overrides[i]
    out.push(k + "=" + v)
  }
  out
}

fn sr_file_hidden_values(raw_bytes : Bytes, b64 : String) -> Array[String] {
  let text = sr_bytes_to_utf8_safe(raw_bytes)
  let mut trimmed = text
  if trimmed.ends_with("\r\n") {
    trimmed = trimmed.slice(0, trimmed.length() - 2)
  } else if trimmed.ends_with("\n") {
    trimmed = trimmed.slice(0, trimmed.length() - 1)
  }
  if trimmed.length() > 0 && trimmed != b64 {
    [trimmed, b64]
  } else {
    [b64]
  }
}

fn sr_posix_shell() -> String {
  if station_sys::os_name() == "win32" {
    "sh"
  } else {
    "/bin/sh"
  }
}

// ---------------------------------------------------------------------------
// Active & Pending Run Records
// ---------------------------------------------------------------------------

struct PendingProxyRun {
  conn_id : Int
  rpc_id : base_codec::Json
  prep : station_whole::PreparedSecretRun
  now_ms : Int64
}

struct StartingSshRun {
  conn_id : Int
  rpc_id : base_codec::Json
  prep : station_whole::PreparedSecretRun
  agent : station_vault::SshAgentServer
  now_ms : Int64
}

struct ActiveSecretRun {
  ev_id : Int64
  conn_id : Int
  rpc_id : base_codec::Json
  prep : station_whole::PreparedSecretRun
  child : station_sys::ChildProcess
  deadline_ms : Int64
  kept : SecretRunKept
  out_scrubber : station_vault::Scrubber
  err_scrubber : station_vault::Scrubber
  mut timed_out : Bool
  mut stdout_eof : Bool
  mut stderr_eof : Bool
  mut exited : Bool
  mut exit_code : Option[Int]
  mut exit_signal : Option[String]
  mut cleanup_file : Option[String]
  mut cleanup_dir : Option[String]
  mut proxy_token : Option[String]
  mut ssh_agent : Option[station_vault::SshAgentServer]
}

pub struct SecretRunManager {
  data_dir : String
  sep : String
  mut next_ev_id : Int64
  mut proxy : Option[station_vault::VaultProxy]
  mut proxy_bundle_path : String
  mut proxy_starting : Bool
  waiting_proxy : Array[PendingProxyRun]
  starting_ssh : Array[StartingSshRun]
  active : Map[Int64, ActiveSecretRun]
}

pub fn SecretRunManager::new(data_dir : String, sep : String) -> SecretRunManager {
  SecretRunManager::{
    data_dir: data_dir,
    sep: sep,
    next_ev_id: SECRET_RUN_EVENT_BASE,
    proxy: None,
    proxy_bundle_path: "",
    proxy_starting: false,
    waiting_proxy: [],
    starting_ssh: [],
    active: Map::new(),
  }
}

fn sr_getenv(key : String) -> Option[String] {
  let prefix = key + "="
  let all = station_sys::env_all()
  for i in 0..<all.length() {
    if all[i].starts_with(prefix) {
      return Some(all[i].slice(prefix.length(), all[i].length()))
    }
  }
  None
}

fn SecretRunManager::ensure_proxy(
  self : SecretRunManager,
  mux : builders_core::ShellMux,
  wall_ms : Int64,
) -> Result[station_vault::VaultProxy, String] {
  match self.proxy {
    Some(p) => return Ok(p)
    None => ()
  }
  let vault_dir = nodepath::join(self.sep, [self.data_dir, "vault"])
  let _ = station_sys::mkdir_mode(vault_dir, 448)
  let seed = match station_sys::random_bytes(32) {
    Ok(b) if b.length() >= 32 => b
    Ok(_) => return Err("CSPRNG returned fewer than 32 bytes for vault proxy")
    Err(e) => return Err("CSPRNG failed for vault proxy: " + e)
  }
  let serial_seed = match station_sys::random_bytes(16) {
    Ok(b) if b.length() >= 16 => b
    _ => return Err("CSPRNG failed for vault proxy CA serial")
  }
  let ca = match station_vault::make_ca(wall_ms, station_vault::DEFAULT_CA_NAME, seed, serial_seed) {
    Ok(c) => c
    Err(e) => return Err("failed to create vault proxy CA: " + e)
  }
  let p = match station_vault::VaultProxy::new_with_seed(ca, seed) {
    Ok(vp) => vp
    Err(e) => return Err(e)
  }
  // Optional test/custom upstream CA PEM (via `STILLFAIL_VAULT_PROXY_CA` file path).
  let mut extra_ca = ""
  match sr_getenv("STILLFAIL_VAULT_PROXY_CA") {
    Some(ca_path) if ca_path.trim().length() > 0 => {
      match station_sys::read_file_strict(ca_path.trim()) {
        Ok(b) => {
          let pem_str = sr_bytes_to_utf8_safe(b)
          if pem_str.length() > 0 {
            p.upstream_ca_pem = Some(pem_str)
            extra_ca = pem_str + "\n"
          }
        }
        Err(_) => ()
      }
    }
    _ => ()
  }
  // Include system root CAs if available, plus any test CA (`STILLFAIL_VAULT_PROXY_CA`) and our vault CA.
  let mut sys_ca = ""
  let sys_ca_candidates = [
    "/etc/ssl/certs/ca-certificates.crt",
    "/etc/pki/tls/certs/ca-bundle.crt",
    "/etc/ssl/cert.pem",
  ]
  for ci in 0..<sys_ca_candidates.length() {
    match station_sys::read_file_strict(sys_ca_candidates[ci]) {
      Ok(b) if b.length() > 0 => {
        sys_ca = sr_bytes_to_utf8_safe(b) + "\n"
        break
      }
      _ => ()
    }
  }
  let bundle_path = nodepath::join(self.sep, [vault_dir, "ca-bundle.pem"])
  let bundle_pem = sys_ca + extra_ca + ca.cert_pem()
  let _ = station_sys::write_file_mode(bundle_path, bundle_pem.to_bytes(), mode=420, append=false)
  self.proxy_bundle_path = bundle_path
  self.proxy = Some(p)
  let _ = mux
  Ok(p)
}

fn SecretRunManager::spawn_active_run(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  conn_id : Int,
  rpc_id : base_codec::Json,
  prep : station_whole::PreparedSecretRun,
  env_overrides : Array[(String, String)],
  hidden_values : Array[String],
  cleanup_file : Option[String],
  cleanup_dir : Option[String],
  proxy_token : Option[String],
  ssh_agent : Option[station_vault::SshAgentServer],
  now_ms : Int64,
) -> Unit {
  let ev_id = self.next_ev_id
  self.next_ev_id = self.next_ev_id + 1L
  let _ = station_sys::mkdir_p(prep.cwd)
  let full_env = build_child_env(env_overrides)
  let opts = station_sys::SpawnOptions::{
    program: sr_posix_shell(),
    args: ["-c", prep.command],
    env: Some(full_env),
    cwd: prep.cwd,
    new_pgid: true,
    strip_malloc_space_efficient: false,
    pipe_stdin: false,
    pipe_stdout: true,
    pipe_stderr: true,
  }
  match station_sys::proc_spawn(ev_id, opts) {
    Ok(child) => {
      let run = ActiveSecretRun::{
        ev_id: ev_id,
        conn_id: conn_id,
        rpc_id: rpc_id,
        prep: prep,
        child: child,
        deadline_ms: now_ms + prep.timeout_ms,
        kept: SecretRunKept::new(),
        out_scrubber: station_vault::Scrubber::new(hidden_values),
        err_scrubber: station_vault::Scrubber::new(hidden_values),
        timed_out: false,
        stdout_eof: false,
        stderr_eof: false,
        exited: false,
        exit_code: None,
        exit_signal: None,
        cleanup_file: cleanup_file,
        cleanup_dir: cleanup_dir,
        proxy_token: proxy_token,
        ssh_agent: ssh_agent,
      }
      self.active.set(ev_id, run)
    }
    Err(e) => {
      self.cleanup_resources(mux, cleanup_file, cleanup_dir, proxy_token, ssh_agent)
      respond_mcp_deferred(mcp_srv, mcp_cb, conn_id, rpc_id, "could not start shell: " + e, true)
    }
  }
}

fn SecretRunManager::cleanup_resources(
  self : SecretRunManager,
  mux : builders_core::ShellMux,
  cleanup_file : Option[String],
  cleanup_dir : Option[String],
  proxy_token : Option[String],
  ssh_agent : Option[station_vault::SshAgentServer],
) -> Unit {
  match proxy_token {
    Some(tok) => match self.proxy {
      Some(p) => { let _ = p.revoke_token(tok) }
      None => ()
    }
    None => ()
  }
  match ssh_agent {
    Some(ag) => {
      ag.close(mux)
      let _ = station_vault::unlink_socket_sys(ag.socket_path)
    }
    None => ()
  }
  match cleanup_file {
    Some(fp) => { let _ = station_sys::unlink(fp) }
    None => ()
  }
  match cleanup_dir {
    Some(dp) => { let _ = station_sys::rmdir(dp) }
    None => ()
  }
}

fn SecretRunManager::launch_proxy_run(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  p : station_vault::VaultProxy,
  pr : PendingProxyRun,
) -> Unit {
  let (token, proxy_url) = match p.admit(
    pr.prep.grant_id,
    pr.prep.hosts,
    station_vault::DeliveryMode::Proxy,
    pr.prep.secret_value,
    pr.prep.expires_sec,
  ) {
    Ok(pair) => pair
    Err(e) => {
      respond_mcp_deferred(mcp_srv, mcp_cb, pr.conn_id, pr.rpc_id, "proxy admit failed: " + e, true)
      return
    }
  }
  let stand = station_vault::placeholder(pr.prep.grant_id)
  let overrides : Array[(String, String)] = [
    ("HTTPS_PROXY", proxy_url),
    ("https_proxy", proxy_url),
    ("NO_PROXY", ""),
    ("no_proxy", ""),
    ("NODE_EXTRA_CA_CERTS", self.proxy_bundle_path),
    ("SSL_CERT_FILE", self.proxy_bundle_path),
    ("REQUESTS_CA_BUNDLE", self.proxy_bundle_path),
    ("CURL_CA_BUNDLE", self.proxy_bundle_path),
    ("GIT_SSL_CAINFO", self.proxy_bundle_path),
    (station_whole::VAULT_SECRET_VAR, stand),
  ]
  match pr.prep.target_env {
    Some(ev) if ev.length() > 0 => overrides.push((ev, stand))
    _ => ()
  }
  match pr.prep.account {
    Some(acc) => overrides.push((station_whole::VAULT_ACCOUNT_VAR, acc))
    None => ()
  }
  self.spawn_active_run(
    mcp_srv,
    mcp_cb,
    mux,
    pr.conn_id,
    pr.rpc_id,
    pr.prep,
    overrides,
    [pr.prep.secret_value],
    None,
    None,
    Some(token),
    None,
    pr.now_ms,
  )
}

/// Start a validated `PreparedSecretRun` asynchronously (NEVER blocks, NEVER calls `host_shim::wait`).
/// Caller must return `HandlerAction::Defer` when this returns `true`, or `Respond(err)` on `Err`.
pub fn SecretRunManager::start_run(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  conn_id : Int,
  rpc_id : base_codec::Json,
  prep : station_whole::PreparedSecretRun,
  now_ms : Int64,
  wall_ms : Int64,
) -> Result[Unit, String] {
  match prep.mode {
    station_vault::DeliveryMode::Proxy => {
      let p = match self.ensure_proxy(mux, wall_ms) {
        Ok(vp) => vp
        Err(e) => return Err(e)
      }
      let pr = PendingProxyRun::{ conn_id: conn_id, rpc_id: rpc_id, prep: prep, now_ms: now_ms }
      if p.is_listening() {
        self.launch_proxy_run(mcp_srv, mcp_cb, mux, p, pr)
      } else {
        self.waiting_proxy.push(pr)
        if !self.proxy_starting {
          self.proxy_starting = true
          let _ = p.start(mux)
        }
      }
      Ok(())
    }
    station_vault::DeliveryMode::Ssh => {
      let ssh_key = match station_vault::parse_openssh_ed25519_key(prep.secret_value) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      let rand = match station_sys::random_bytes(16) {
        Ok(b) if b.length() >= 16 => b
        _ => return Err("CSPRNG failed for ssh-agent directory")
      }
      let tmp_base = station_sys::tmpdir()
      let dir = nodepath::join(self.sep, [tmp_base, "sf-ssh-" + crypto::bytes_to_hex(rand)])
      match station_sys::mkdir_mode(dir, 448) {
        station_sys::MkdirModeResult::Ok | station_sys::MkdirModeResult::AlreadyExists => ()
        _ => return Err("failed to create private ssh-agent directory")
      }
      let sock_path = nodepath::join(self.sep, [dir, "agent.sock"])
      let agent = station_vault::SshAgentServer::new(sock_path, ssh_key)
      let _ = agent.start(mux)
      self.starting_ssh.push(StartingSshRun::{
        conn_id: conn_id,
        rpc_id: rpc_id,
        prep: prep,
        agent: agent,
        now_ms: now_ms,
      })
      Ok(())
    }
    station_vault::DeliveryMode::File => {
      let raw_bytes = match base64::decode(prep.secret_value) {
        Ok(b) => b
        Err(_) => return Err("file secret is not valid base64")
      }
      let rand = match station_sys::random_bytes(16) {
        Ok(b) if b.length() >= 16 => b
        _ => return Err("CSPRNG failed for secret file directory")
      }
      let tmp_base = station_sys::tmpdir()
      let dir = nodepath::join(self.sep, [tmp_base, "sf-file-" + crypto::bytes_to_hex(rand)])
      match station_sys::mkdir_mode(dir, 448) {
        station_sys::MkdirModeResult::Ok | station_sys::MkdirModeResult::AlreadyExists => ()
        _ => return Err("failed to create private secret file directory")
      }
      let fname = station_whole::vault_safe_secret_filename(prep.secret_filename)
      let fpath = nodepath::join(self.sep, [dir, fname])
      if !station_sys::write_file_mode(fpath, raw_bytes, mode=384, append=false) {
        let _ = station_sys::rmdir(dir)
        return Err("failed to write 0600 secret file")
      }
      let overrides : Array[(String, String)] = [(station_whole::VAULT_SECRET_VAR, fpath)]
      match prep.target_env {
        Some(ev) if ev.length() > 0 => overrides.push((ev, fpath))
        _ => ()
      }
      match prep.account {
        Some(acc) => overrides.push((station_whole::VAULT_ACCOUNT_VAR, acc))
        None => ()
      }
      let hidden = sr_file_hidden_values(raw_bytes, prep.secret_value)
      self.spawn_active_run(
        mcp_srv,
        mcp_cb,
        mux,
        conn_id,
        rpc_id,
        prep,
        overrides,
        hidden,
        Some(fpath),
        Some(dir),
        None,
        None,
        now_ms,
      )
      Ok(())
    }
    _ => {
      // `env` delivery mode: inherit OS base env + inject secret into `STILLFAIL_SECRET` & target var.
      let overrides : Array[(String, String)] = [(station_whole::VAULT_SECRET_VAR, prep.secret_value)]
      match prep.target_env {
        Some(ev) if ev.length() > 0 => overrides.push((ev, prep.secret_value))
        _ => ()
      }
      match prep.account {
        Some(acc) => overrides.push((station_whole::VAULT_ACCOUNT_VAR, acc))
        None => ()
      }
      self.spawn_active_run(
        mcp_srv,
        mcp_cb,
        mux,
        conn_id,
        rpc_id,
        prep,
        overrides,
        [prep.secret_value],
        None,
        None,
        None,
        None,
        now_ms,
      )
      Ok(())
    }
  }
}

fn SecretRunManager::finish_if_ready(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  ev_id : Int64,
) -> Unit {
  let run = match self.active.get(ev_id) {
    Some(r) => r
    None => return
  }
  if !run.exited || !run.stdout_eof || !run.stderr_eof {
    return
  }
  self.active.remove(ev_id)
  run.kept.add(run.out_scrubber.end())
  run.kept.add(run.err_scrubber.end())
  let _ = run.child.close()
  self.cleanup_resources(mux, run.cleanup_file, run.cleanup_dir, run.proxy_token, run.ssh_agent)
  let formatted = station_whole::format_secret_run_output(
    run.exit_code,
    run.exit_signal,
    run.timed_out,
    run.kept.cut,
    run.kept.text(),
  )
  respond_mcp_deferred(mcp_srv, mcp_cb, run.conn_id, run.rpc_id, formatted, false)
}

/// Handle `HostEvent::Sys` events in our disjoint `9 << 32` segment.
pub fn SecretRunManager::handle_sys_event(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  ev_id : Int64,
  sev : station_sys::SysEvent,
) -> Bool {
  if ev_id < SECRET_RUN_EVENT_BASE {
    return false
  }
  let run = match self.active.get(ev_id) {
    Some(r) => r
    None => return true
  }
  match sev {
    station_sys::SysEvent::ProcStdout(chunk) => {
      run.kept.add(run.out_scrubber.push(chunk))
    }
    station_sys::SysEvent::ProcStderr(chunk) => {
      run.kept.add(run.err_scrubber.push(chunk))
    }
    station_sys::SysEvent::ProcStdoutEof => {
      run.stdout_eof = true
      self.finish_if_ready(mcp_srv, mcp_cb, mux, ev_id)
    }
    station_sys::SysEvent::ProcStderrEof => {
      run.stderr_eof = true
      self.finish_if_ready(mcp_srv, mcp_cb, mux, ev_id)
    }
    station_sys::SysEvent::ProcExit(es) => {
      run.exited = true
      if es.signal > 0 {
        run.exit_code = None
        run.exit_signal = Some(if es.signal_name.length() > 0 { es.signal_name } else { "SIG" + es.signal.to_string() })
      } else {
        run.exit_code = Some(es.code)
        run.exit_signal = None
      }
      self.finish_if_ready(mcp_srv, mcp_cb, mux, ev_id)
    }
    _ => ()
  }
  true
}

/// Route `VaultProxy` (`9201..=9210`) and `SshAgentServer` (`9101..=9108`) `ShellMux` completions.
pub fn SecretRunManager::handle_role_done(
  self : SecretRunManager,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mux : builders_core::ShellMux,
  tok : builders_core::MuxToken,
  done : host_shim::ShellDone,
  now_ms : Int64,
  wall_ms : Int64,
) -> Bool {
  match tok {
    builders_core::MuxToken::Tagged(tag, _, _) => {
      // VaultProxy tags: 9201..=9210
      if tag >= station_vault::PROXY_MUX_TAG_LISTEN && tag <= station_vault::PROXY_MUX_TAG_CLOSE {
        match self.proxy {
          Some(p) => {
            let handled = p.on_shell_done(mux, tok, done, wall_ms, wall_ms / 1000L)
            if tag == station_vault::PROXY_MUX_TAG_LISTEN {
              self.proxy_starting = false
              let queued : Array[PendingProxyRun] = []
              for i in 0..<self.waiting_proxy.length() {
                queued.push(self.waiting_proxy[i])
              }
              self.waiting_proxy.clear()
              if p.is_listening() {
                for i in 0..<queued.length() {
                  self.launch_proxy_run(mcp_srv, mcp_cb, mux, p, queued[i])
                }
              } else {
                for i in 0..<queued.length() {
                  respond_mcp_deferred(
                    mcp_srv,
                    mcp_cb,
                    queued[i].conn_id,
                    queued[i].rpc_id,
                    "vault proxy failed to listen: " + done.error,
                    true,
                  )
                }
              }
            }
            return handled
          }
          None => return false
        }
      }
      // SshAgentServer tags: 9101..=9108
      if tag >= station_vault::SSH_MUX_TAG_LISTEN && tag <= station_vault::SSH_MUX_TAG_CHMOD {
        // First check starting SSH agents waiting for `LISTEN`.
        if tag == station_vault::SSH_MUX_TAG_LISTEN && self.starting_ssh.length() > 0 {
          let sr = self.starting_ssh[0]
          let rest : Array[StartingSshRun] = []
          for i in 1..<self.starting_ssh.length() {
            rest.push(self.starting_ssh[i])
          }
          self.starting_ssh.clear()
          for i in 0..<rest.length() {
            self.starting_ssh.push(rest[i])
          }
          let _ = sr.agent.on_shell_done(mux, tok, done, true)
          if sr.agent.is_listening() {
            let overrides : Array[(String, String)] = [("SSH_AUTH_SOCK", sr.agent.socket_path)]
            match sr.prep.account {
              Some(acc) => overrides.push((station_whole::VAULT_ACCOUNT_VAR, acc))
              None => ()
            }
            let dir_path = match sr.agent.socket_path.ends_with("/agent.sock") {
              true => Some(sr.agent.socket_path.slice(0, sr.agent.socket_path.length() - 11))
              false => None
            }
            self.spawn_active_run(
              mcp_srv,
              mcp_cb,
              mux,
              sr.conn_id,
              sr.rpc_id,
              sr.prep,
              overrides,
              [sr.prep.secret_value],
              None,
              dir_path,
              None,
              Some(sr.agent),
              sr.now_ms,
            )
          } else {
            let err_msg = match sr.agent.start_error() {
              Some(e) => e
              None => "ssh-agent failed to start"
            }
            sr.agent.close(mux)
            respond_mcp_deferred(mcp_srv, mcp_cb, sr.conn_id, sr.rpc_id, err_msg, true)
          }
          return true
        }
        // Route to active SSH agents.
        let now_sec = wall_ms / 1000L
        let keys = self.active.keys()
        for i in 0..<keys.length() {
          match self.active.get(keys[i]) {
            Some(run) => match run.ssh_agent {
              Some(ag) => {
                let allowed = !run.timed_out && run.prep.expires_sec > now_sec
                if ag.on_shell_done(mux, tok, done, allowed) {
                  return true
                }
              }
              None => ()
            }
            None => ()
          }
        }
        return true
      }
      false
    }
    _ => false
  }
}

/// Enforce process-group timeouts and purge expired proxy tokens on each tick.
pub fn SecretRunManager::tick(self : SecretRunManager, now_ms : Int64, wall_ms : Int64) -> Unit {
  let keys = self.active.keys()
  for i in 0..<keys.length() {
    match self.active.get(keys[i]) {
      Some(run) => {
        if !run.timed_out && !run.exited && now_ms >= run.deadline_ms {
          run.timed_out = true
          let _ = run.child.kill(station_sys::SIG_KILL, true)
        }
      }
      None => ()
    }
  }
  match self.proxy {
    Some(p) => { let _ = p.purge_expired_runs(wall_ms / 1000L) }
    None => ()
  }
}

/// Clean shutdown: kill all active `secret_run` process groups, remove temp files/dirs,
/// close all SSH agents and the shared `VaultProxy`.
pub fn SecretRunManager::shutdown(self : SecretRunManager, mux : builders_core::ShellMux) -> Unit {
  let keys = self.active.keys()
  for i in 0..<keys.length() {
    match self.active.get(keys[i]) {
      Some(run) => {
        let _ = run.child.kill(station_sys::SIG_KILL, true)
        let _ = run.child.close()
        self.cleanup_resources(mux, run.cleanup_file, run.cleanup_dir, run.proxy_token, run.ssh_agent)
      }
      None => ()
    }
  }
  self.active.clear()
  for i in 0..<self.starting_ssh.length() {
    self.starting_ssh[i].agent.close(mux)
  }
  self.starting_ssh.clear()
  self.waiting_proxy.clear()
  match self.proxy {
    Some(p) => p.close(mux)
    None => ()
  }
}
