// Entrypoint for `stillfail-station-pion` (`roles:rig,whole` daemon with automatic `is_rig`
// routing, all 8 CLI subcommands `id,status,lock,channel,enroll,update,heap,admin`, and smoke).

import "base_codec"
import "builders_core"
import "builders_replica"
import "host_shim"
import "js_json"
import "jscase"
import "nodepath"
import "sql_db"
import "sqlite_ffi"
import "sse"
import "station_http"
import "station_ops"
import "station_store"
import "station_sys"
import "station_vault"

pub fn version_line() -> String {
  "stillfail-station-pion 0.1.0 roles:rig,whole commands:id,status,lock,channel,enroll,update,heap,admin,worktree"
}

pub fn usage_line() -> String {
  "usage: stillfail-station-pion --version | run [--app DIR] [--port N] [--data DIR] [--control-fd N] | id | status | lock status|reset | channel [stable|beta] | enroll <cloud> <token> | update [--beta|--stable] --app DIR | heap | [-C <repo>] worktree <args> | admin ..."
}

fn run_smoke_sys() -> Int {
  let os = station_sys::os_name()
  let arch = station_sys::arch_name()
  let host = station_sys::hostname()
  let tmp = station_sys::tmpdir()
  let machine = station_sys::machine_stats_json()
  let ifaces = station_sys::network_interfaces_json()
  let pid = host_shim::pid()
  let usage = station_sys::process_usage_json([pid])
  if os.length() == 0 || arch.length() == 0 || host.length() == 0 || tmp.length() == 0 {
    let _ = host_shim::write_stderr_line("smoke-sys: empty os/arch/host/tmp")
    return 1
  }
  let machine_ok = match base_codec::json_parse(machine) {
    base_codec::JsonParseResult::Ok(v) => match base_codec::json_get(v, "cpus") {
      Some(base_codec::Json::Arr(cpus)) => cpus.length() > 0
      _ => false
    }
    _ => false
  }
  if !machine_ok {
    let _ = host_shim::write_stderr_line("smoke-sys: invalid machine_stats_json")
    return 1
  }
  let ifaces_ok = match base_codec::json_parse(ifaces) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Arr(arr)) => if arr.length() > 0 {
      match base_codec::json_get(arr[0], "name") {
        Some(base_codec::Json::Str(s)) => s.length() > 0
        _ => false
      }
    } else {
      false
    }
    _ => false
  }
  if !ifaces_ok {
    let _ = host_shim::write_stderr_line("smoke-sys: invalid network_interfaces_json")
    return 1
  }
  let usage_ok = match base_codec::json_parse(usage) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Arr(arr)) => if arr.length() == 1 {
      let has_cpu = match base_codec::json_get(arr[0], "cpuNs") {
        Some(base_codec::Json::Num(_, _)) => true
        _ => false
      }
      let has_fp = match base_codec::json_get(arr[0], "footprint") {
        Some(base_codec::Json::Num(_, _)) => true
        _ => false
      }
      has_cpu && has_fp
    } else {
      false
    }
    _ => false
  }
  if !usage_ok {
    let _ = host_shim::write_stderr_line("smoke-sys: invalid process_usage_json")
    return 1
  }
  let lock_path = tmp + "/stillfail-smoke-sys-" + pid.to_string() + "-" + host_shim::wall_ms().to_string() + ".lock"
  match station_sys::flock_try(lock_path) {
    station_sys::FlockResult::Acquired(h) => {
      let busy_ok = match station_sys::flock_try(lock_path) {
        station_sys::FlockResult::Busy => true
        station_sys::FlockResult::Acquired(h2) => {
          let _ = h2.unlock()
          false
        }
        station_sys::FlockResult::Error => false
      }
      let unlocked = h.unlock()
      let unlinked = station_sys::unlink(lock_path)
      if !busy_ok || !unlocked || !unlinked {
        let _ = host_shim::write_stderr_line("smoke-sys: flock contention/unlock/unlink check failed")
        return 1
      }
    }
    _ => {
      let _ = host_shim::write_stderr_line("smoke-sys: flock_try failed")
      return 1
    }
  }
  // R10 P0/P1 real OS FS + real SQLite verifier smoke:
  // (a) `verify_legacy_session_workspace` with real `ELOOP`, `EACCES`, and `ENOENT`
  // (b) Peer Slack `surface_for_described` (`slack:<team>`) + `query_thread_moved_to` (`handed:<ws>`)
  if os != "win32" {
    let vroot = tmp + "/sf-smoke-r10-" + pid.to_string() + "-" + host_shim::wall_ms().to_string()
    let vsess = vroot + "/sessions"
    let vws_a = vsess + "/ws_a"
    let vlocked = vsess + "/locked"
    let vlocked_child = vlocked + "/ws_b"
    let vloop_a = vsess + "/loop_a"
    let vloop_b = vsess + "/loop_b"
    let vdb = vroot + "/stillfail.db"
    let mut r10_ok = station_sys::mkdir_p(vws_a)
    && station_sys::mkdir_p(vlocked_child)
    && station_sys::symlink(vloop_b, vloop_a, false)
    && station_sys::symlink(vloop_a, vloop_b, false)
    if r10_ok {
      match station_store::Store::open(vdb) {
        Ok(vst) => {
          let real_lstat_ops = station_ops::OpsFs::{
            ..station_ops::MemFs::new().ops(),
            lstat: fn(p : String) -> Result[station_ops::FileMeta, station_ops::FsErr] {
              match station_sys::lstat_raw_err(p) {
                Ok(raw) => {
                  let is_dir = raw.starts_with("dir|")
                  let is_link = raw.starts_with("link|")
                  Ok(station_ops::FileMeta::{ is_file: raw.starts_with("file|"), is_dir: is_dir, is_link: is_link, size: 0L, mtime_ms: 0L, mtime_exact: "", ino: 0L, mode: 493 })
                }
                Err(-2) => Err(station_ops::FsErr::NotFound)
                Err(-3) => Err(station_ops::FsErr::PermissionDenied("EACCES"))
                Err(_) => Err(station_ops::FsErr::Other("lstat_err"))
              }
            },
          }
          let mut r10_step = "ok"
          match vst.db.run(
            "INSERT INTO sessions(key, connect, scope, runtime, profile, workspace, token, created_at, last_active_at, ws) VALUES('s-other', 'c1', 'sc1', 'claude', 'default', ?1, 'tok-other', 1000, 1000, 'ws-b')",
            [base_codec::json_str(vloop_a)],
          ) {
            Err(e) => { r10_ok = false; r10_step = "insert s-other: " + e.message }
            Ok(_) => ()
          }
          if r10_ok && !(verify_legacy_session_workspace(Some(vst), real_lstat_ops, vws_a, vroot, "ws-a", "ws-a", "/") is None) {
            r10_ok = false
            r10_step = "eloop not rejected"
          }
          if r10_ok && station_sys::geteuid() > 0 {
            let _ = station_sys::chmod(vlocked, 0)
            let _ = vst.db.run("UPDATE sessions SET workspace = ?1 WHERE key = 's-other'", [base_codec::json_str(vlocked_child)])
            if !(verify_legacy_session_workspace(Some(vst), real_lstat_ops, vws_a, vroot, "ws-a", "ws-a", "/") is None) {
              r10_ok = false
              r10_step = "eacces not rejected"
            }
            let _ = station_sys::chmod(vlocked, 448)
          }
          if r10_ok {
            let _ = vst.db.run("UPDATE sessions SET workspace = ?1 WHERE key = 's-other'", [base_codec::json_str(vsess + "/missing-ws-b/workspace")])
            if !(verify_legacy_session_workspace(Some(vst), real_lstat_ops, vws_a, vroot, "ws-a", "ws-a", "/") is Some(_)) {
              r10_ok = false
              r10_step = "enoent sibling rejected"
            }
          }
          if r10_ok {
            let desc = base_codec::json_obj([
              ("kind", base_codec::json_str("slack")),
              ("team", base_codec::json_str("T_TEAM_R10")),
            ])
            let surf = surface_for_described("slack", desc, "c-slack-r10")
            let _ = vst.db.run("INSERT INTO threads(id, surface, channel, thread_ts, title, created_at) VALUES(101, 'slack:T_TEAM_R10', 'C_R10', '1700.001', '', 1000)", [])
            let _ = vst.db.run("INSERT INTO sessions(key, connect, scope, runtime, profile, workspace, token, created_at, last_active_at, ws) VALUES('s-moved', 'c-slack-r10', 'sc2', 'claude', 'default', '/tmp/m', 'tok-moved', 1000, 1000, 'handed:ws-target')", [])
            let _ = vst.db.run("INSERT INTO thread_sessions(thread, session, connect, joined_at) VALUES(101, 's-moved', 'c-slack-r10', 1000)", [])
            let _ = vst.db.run("INSERT INTO handed_over(session, station, ws, at) VALUES('s-moved', 'st-dest-r10', 'ws-target', 1000)", [])
            match query_thread_moved_to(vst, surf, "c-slack-r10", "C_R10", "1700.001", "ws-target", "ws-home") {
              Some(dest) => if dest != "st-dest-r10" { r10_ok = false; r10_step = "moved_to wrong dest: " + dest }
              None => { r10_ok = false; r10_step = "moved_to returned None" }
            }
          }
          if r10_ok && station_sys::geteuid() > 0 {
            // R19/R20 real OS FS check:
            // (1) `r-locked.json` (`chmod 0000`) + `r-smoke-19.json` (valid) through a `shell_ops_fs`-like
            //     `OpsFs` collapsing read errors to `NotFound`:
            //     - `discover_live_runners_scan` -> `complete == false`, retains `r-smoke-19`;
            //     - `probe_runner_file(..., "r-absent")` -> `ConfirmedAbsent` (not blocked by `r-locked.json`);
            //     - `probe_runner_file(..., "r-locked")` -> `Uncertain(_, None)`.
            // (2) `runners` directory itself `chmod 0000`:
            //     - `probe_runner_file(..., "r-absent")` -> `Uncertain(_, None)`.
            let r19_rdir = vroot + "/run/runners"
            let r19_good = r19_rdir + "/r-smoke-19.json"
            let r19_locked = r19_rdir + "/r-locked.json"
            let my_start = match station_sys::proc_start_time_ms(pid) {
              Some(ms) => ms
              None => host_shim::wall_ms()
            }
            let good_body = "{\"id\":\"r-smoke-19\",\"runner\":" + pid.to_string() + ",\"pid\":" + pid.to_string() + ",\"pgid\":" + pid.to_string() + ",\"startedAt\":" + my_start.to_string() + ",\"socket\":\"/tmp/r-smoke-19.sock\"}"
            let r19_setup = station_sys::mkdir_p(r19_rdir)
            && station_sys::write_file_atomic(r19_good, good_body.to_bytes(), 384)
            && station_sys::write_file_atomic(r19_locked, good_body.to_bytes(), 384)
            if !r19_setup {
              r10_ok = false
              r10_step = "r20 setup failed"
            } else {
              let _ = station_sys::chmod(r19_locked, 0)
              let shell_like_ops = station_ops::OpsFs::{
                ..station_ops::MemFs::new().ops(),
                readdir: fn(p : String) -> Result[Array[String], station_ops::FsErr] {
                  if p == r19_rdir {
                    Ok(["r-smoke-19.json", "r-locked.json"])
                  } else {
                    Err(station_ops::FsErr::NotFound)
                  }
                },
                read_bytes: fn(p : String) -> Result[Bytes, station_ops::FsErr] {
                  match station_sys::read_file_strict(p) {
                    Ok(b) => Ok(b)
                    Err(_) => Err(station_ops::FsErr::NotFound)
                  }
                },
              }
              let scan = discover_live_runners_scan(shell_like_ops, vroot, "/")
              if scan.complete {
                r10_ok = false
                r10_step = "r20 chmod 0000 file must mark scan.complete == false"
              } else if scan.runners.length() != 1 || scan.runners[0].id != "r-smoke-19" {
                r10_ok = false
                r10_step = "r20 valid runner lost alongside chmod 0000 file: len=" + scan.runners.length().to_string()
              } else if !(probe_runner_file(shell_like_ops, vroot, "/", "r-absent") is RunnerFileProbe::ConfirmedAbsent) {
                r10_ok = false
                r10_step = "r20 r-absent must be ConfirmedAbsent despite unrelated r-locked.json"
              } else if !(probe_runner_file(shell_like_ops, vroot, "/", "r-locked") is RunnerFileProbe::Uncertain(_, None)) {
                r10_ok = false
                r10_step = "r20 r-locked (chmod 0000) must be Uncertain(_, None)"
              }
              if r10_ok {
                let _ = station_sys::chmod(r19_rdir, 0)
                if !(probe_runner_file(shell_like_ops, vroot, "/", "r-absent") is RunnerFileProbe::Uncertain(_, None)) {
                  r10_ok = false
                  r10_step = "r20 chmod 0000 runners dir must make r-absent Uncertain(_, None)"
                }
                let _ = station_sys::chmod(r19_rdir, 448)
              }
              let _ = station_sys::chmod(r19_locked, 384)
              let _ = station_sys::unlink(r19_locked)
              let _ = station_sys::unlink(r19_good)
              let _ = station_sys::rmdir(r19_rdir)
              let _ = station_sys::rmdir(vroot + "/run")
            }
          }
          if !r10_ok {
            let _ = host_shim::write_stderr_line("smoke-sys: R10 detail: " + r10_step)
          }
          vst.close()
        }
        Err(_) => r10_ok = false
      }
    }
    let _ = station_sys::chmod(vlocked, 448)
    let _ = station_sys::unlink(vloop_a)
    let _ = station_sys::unlink(vloop_b)
    let _ = station_sys::rmdir(vlocked_child)
    let _ = station_sys::rmdir(vlocked)
    let _ = station_sys::rmdir(vws_a)
    let _ = station_sys::rmdir(vsess)
    let _ = station_sys::unlink(vdb)
    let _ = station_sys::unlink(vdb + "-wal")
    let _ = station_sys::unlink(vdb + "-shm")
    let _ = station_sys::rmdir(vroot)
    if !r10_ok {
      let _ = host_shim::write_stderr_line("smoke-sys: R10 real OS FS + SQLite verifier check failed")
      return 1
    }
  }
  let vs_rc = station_sys::selftest_verified_send_cancel()
  if vs_rc != 0 {
    let _ = host_shim::write_stderr_line("smoke-sys: selftest_verified_send_cancel failed rc=" + vs_rc.to_string())
    return 1
  }
  let _ = host_shim::write_stdout_line(
    "{\"ok\":true,\"os\":\"" + os + "\",\"arch\":\"" + arch + "\",\"pid\":" + pid.to_string() + "}",
  )
  0
}

fn run_smoke_runner(runner_bin : String) -> Int {
  let os = station_sys::os_name()
  let tmp = station_sys::tmpdir()
  let self_pid = host_shim::pid()
  let root = tmp + "/sf-smoke-runner-" + self_pid.to_string() + "-" + host_shim::wall_ms().to_string()
  let rdir = root + "/run/runners"
  let shell_dir = root + "/shell"
  let rid = "r-smoke-posix"
  if !station_sys::mkdir_p(rdir) || !station_sys::mkdir_p(shell_dir) {
    let _ = host_shim::write_stderr_line("smoke-runner: mkdir_p failed")
    return 1
  }
  if !host_shim::start(shell_dir, false) {
    let _ = host_shim::write_stderr_line("smoke-runner: host_shim::start failed")
    return 1
  }
  let mux = builders_core::ShellMux::host(start_stdin=false)
  let spawn_opts = station_sys::SpawnOptions::{
    program: runner_bin,
    args: ["--dir", rdir, "--id", rid, "--", "/bin/sleep", "30"],
    env: None,
    cwd: root,
    new_pgid: os == "win32",
    strip_malloc_space_efficient: true,
    pipe_stdin: false,
    pipe_stdout: true,
    pipe_stderr: true,
  }
  let ev_id : Int64 = 990001L
  let child = match station_sys::proc_spawn(ev_id, spawn_opts) {
    Ok(c) => c
    Err(e) => {
      let _ = host_shim::write_stderr_line("smoke-runner: proc_spawn failed: " + e)
      return 1
    }
  }
  let spawn_pid = child.pid
  let spawn_os_start_ms = match station_sys::proc_start_time_ms(spawn_pid) {
    Some(t) => if t > 0L { t } else { 0L }
    None => 0L
  }
  let spawn_boot_id = station_sys::boot_id()
  let spawn_start_ticks = station_sys::proc_start_ticks(spawn_pid)
  let real_ops = station_ops::OpsFs::{
    ..station_ops::MemFs::new().ops(),
    read_bytes: fn(p : String) -> Result[Bytes, station_ops::FsErr] {
      match station_sys::read_file_strict(p) {
        Ok(b) => Ok(b)
        Err(_) => Err(station_ops::FsErr::NotFound)
      }
    },
  }
  let stop_via_sock = fn(sock_path : String, sig : String) -> Bool {
    if sock_path.length() == 0 {
      return false
    }
    let mut sid : Int64 = -1L
    let mut opened = false
    let _ = mux.call_async_raw(
      builders_core::MuxToken::Tagged(1, 10, 0L),
      "unix.open",
      base_codec::json_stringify(base_codec::json_obj([("path", base_codec::json_str(sock_path))])),
      None,
    )
    let d1 = host_shim::now_ms() + 3000L
    while host_shim::now_ms() < d1 && !opened {
      match host_shim::wait(50L) {
        Some(host_shim::HostEvent::ShellDone(d)) => {
          match builders_core::decode_shell_done(d) {
            Ok((Some(v), _)) => match base_codec::json_get(v, "id") {
              Some(base_codec::Json::Num(n, _)) => sid = n.to_int64()
              _ => ()
            }
            _ => ()
          }
          opened = true
        }
        _ => ()
      }
    }
    if sid < 0L {
      return false
    }
    let payload = station_drivers::encode_runner_attach()
    + station_drivers::encode_runner_signal(sig, true)
    + station_drivers::encode_runner_done()
    let _ = mux.call_async_raw(
      builders_core::MuxToken::Tagged(1, 11, sid),
      "tcp.write",
      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sid))])),
      Some(payload.to_bytes()),
    )
    let d2 = host_shim::now_ms() + 4000L
    let mut gone = false
    while host_shim::now_ms() < d2 && !gone {
      let _ = host_shim::wait(50L)
      if station_sys::proc_kill_is_esrch(station_sys::proc_kill(spawn_pid, station_sys::SIG_PROBE, false)) {
        gone = true
      }
    }
    let _ = mux.call_async_raw(
      builders_core::MuxToken::Tagged(1, 12, sid),
      "tcp.close",
      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sid))])),
      None,
    )
    gone
  }
  let mut out_buf = Bytes::new(0)
  let mut ready_opt : Option[station_drivers::RunnerInfo] = None
  let ready_deadline = host_shim::now_ms() + 10000L
  while host_shim::now_ms() < ready_deadline && ready_opt is None {
    match host_shim::wait(50L) {
      Some(host_shim::HostEvent::Sys(eid, sev)) => {
        if eid == ev_id {
          match station_sys::decode_sys_event(sev) {
            Some(station_sys::SysEvent::ProcStdout(data)) => {
              let merged = Bytes::new(out_buf.length() + data.length())
              for i in 0..<out_buf.length() { merged[i] = out_buf[i] }
              for i in 0..<data.length() { merged[out_buf.length() + i] = data[i] }
              out_buf = merged
              ready_opt = parse_runner_ready_line(out_buf.to_string())
            }
            _ => ()
          }
        }
      }
      _ => ()
    }
  }
  let mut fail_msg = ""
  let mut rinfo_opt : Option[station_drivers::RunnerInfo] = None
  match ready_opt {
    Some(ri) => {
      if ri.runner_pid != spawn_pid {
        fail_msg = "child.pid (" + spawn_pid.to_string() + ") != ready.runner_pid (" + ri.runner_pid.to_string() + ") — POSIX fork occurred!"
        let _ = stop_via_sock(ri.socket, "TERM")
      } else {
        rinfo_opt = Some(ri)
      }
    }
    None => {
      fail_msg = "timed out waiting for stillfail-runner ready line"
      // R23 P2: Before `child.close()`, prefer verified `<rid>.sock` stop, else handle-bound `child.kill(TERM, false)`.
      let stopped = match probe_runner_file(real_ops, root, "/", rid) {
        RunnerFileProbe::Live(pinfo) | RunnerFileProbe::Uncertain(_, Some(pinfo)) =>
        if pinfo.runner_pid == spawn_pid { stop_via_sock(pinfo.socket, "TERM") } else { false }
        _ => false
      }
      if !stopped {
        let _ = child.kill(station_sys::SIG_TERM, false)
      }
    }
  }
  // Close bootstrap handle (handover detach) and verify runner stays alive at the EXACT same PID!
  let _ = child.close()
  if fail_msg.length() == 0 {
    if station_sys::proc_kill(spawn_pid, station_sys::SIG_PROBE, false) != 0 {
      fail_msg = "runner died after child.close()"
    }
  }
  if fail_msg.length() == 0 {
    match probe_runner_file(real_ops, root, "/", rid) {
      RunnerFileProbe::Live(pinfo) => {
        if pinfo.runner_pid != spawn_pid {
          fail_msg = "probed metadata runner_pid mismatch"
        } else {
          let mgr = LiveRunnerManager::new()
          let spawn_key = match encode_spawn_stop_key_pure(rid, spawn_pid, spawn_os_start_ms, spawn_boot_id, spawn_start_ticks) {
            Some(sk) => sk
            None => ""
          }
          mgr.record_draining_stop_marker(spawn_key, "s-smoke-runner")
          let iid = station_whole::WholeAgents::runner_instance_id(pinfo.id, pinfo.runner_pid, pinfo.started_at)
          if !mgr.is_draining_stop_target(iid, pinfo.id, pinfo.runner_pid, pinfo.started_at) {
            fail_msg = "is_draining_stop_target did not match spawn: marker"
          } else {
            // R28: Verify kernel peer PID enforcement (`SO_PEERCRED`):
            // 1. Wrong expected_pid (`runner_pid + 1`) MUST return -2 (0 bytes written, runner stays alive!).
            let stop_bytes = (
              station_drivers::encode_runner_attach()
              + station_drivers::encode_runner_signal("TERM", true)
              + station_drivers::encode_runner_done()
            ).to_bytes()
            let wrong_rc = station_sys::runner_sock_send_verified(pinfo.socket, pinfo.runner_pid + 1, stop_bytes, 1000)
            if wrong_rc != -2 {
              fail_msg = "runner_sock_send_verified(wrong_pid) expected -2, got " + wrong_rc.to_string()
            } else if station_sys::proc_kill(spawn_pid, station_sys::SIG_PROBE, false) != 0 {
              fail_msg = "runner died after rejected wrong-PID send!"
            } else {
              // 2. Exact expected_pid (`runner_pid`) MUST return 0 and cleanly terminate runner + child group!
              let ok_rc = station_sys::runner_sock_send_verified(pinfo.socket, pinfo.runner_pid, stop_bytes, 1000)
              if ok_rc != 0 {
                fail_msg = "runner_sock_send_verified(exact_pid) expected 0, got " + ok_rc.to_string()
              } else {
                let exit_deadline = host_shim::now_ms() + 4000L
                let mut esrch_seen = false
                while host_shim::now_ms() < exit_deadline && !esrch_seen {
                  let _ = host_shim::wait(50L)
                  if station_sys::proc_kill_is_esrch(station_sys::proc_kill(spawn_pid, station_sys::SIG_PROBE, false)) {
                    esrch_seen = true
                  }
                }
                if !esrch_seen {
                  let _ = stop_via_sock(pinfo.socket, "KILL")
                  fail_msg = "runner did not exit after verified attach+TERM+done"
                } else if !mgr.sweep_draining_stop_markers(host_shim::wall_ms())
                || mgr.has_pending_draining_stop_for_session("s-smoke-runner") {
                  fail_msg = "sweep_draining_stop_markers did not clear marker after real OS ESRCH"
                }
              }
            }
          }
        }
      }
      _ => fail_msg = "probe_runner_file did not return Live(rinfo)"
    }
  }
  if fail_msg.length() > 0 {
    match rinfo_opt {
      Some(ri) => { let _ = stop_via_sock(ri.socket, "KILL") }
      None => ()
    }
  }
  match rinfo_opt {
    Some(ri) => { let _ = station_sys::unlink(ri.socket) }
    None => ()
  }
  let _ = station_sys::unlink(rdir + "/" + rid + ".json")
  let _ = station_sys::unlink(rdir + "/" + rid + ".out")
  let _ = station_sys::unlink(rdir + "/" + rid + ".err")
  let _ = station_sys::rmdir(rdir)
  let _ = station_sys::rmdir(root + "/run")
  let _ = station_sys::rmdir(shell_dir)
  let _ = station_sys::rmdir(root)
  if fail_msg.length() > 0 {
    let _ = host_shim::write_stderr_line("smoke-runner: " + fail_msg)
    return 1
  }
  let _ = host_shim::write_stdout_line(
    "{\"ok\":true,\"spawn_pid\":" + spawn_pid.to_string() + ",\"runner_pid\":" + spawn_pid.to_string() + ",\"zero_fork\":true,\"esrch_swept\":true}",
  )
  0
}

fn run_smoke_http() -> Int {
  let shell_dir = station_sys::tmpdir() + "/stillfail-smoke-http-" + host_shim::pid().to_string() + "-" + host_shim::wall_ms().to_string()
  if !host_shim::start(shell_dir, false) {
    let _ = host_shim::write_stderr_line("smoke-http: host_shim::start failed")
    return 1
  }
  let mux = builders_core::ShellMux::host(start_stdin=false)
  let srv = station_http::HttpServer::with_defaults(mux)
  let hc = station_http::HttpClient::new(mux)
  let wc = station_http::WsClient::new(mux)

  let router = station_http::Router::new()
  router.prefix("GET", "/api", fn(req : station_http::HttpRequest) -> station_http::HandlerAction {
    let v = match req.query_get("k") {
      Some(s) => s
      None => ""
    }
    station_http::HandlerAction::Respond(station_http::HttpResponse::text(200, "pong:" + v))
  })
  router.post("/echo", fn(req : station_http::HttpRequest) -> station_http::HandlerAction {
    station_http::HandlerAction::Respond(
      station_http::HttpResponse::bytes(200, "application/octet-stream", req.body),
    )
  })
  router.get("/204", fn(_req : station_http::HttpRequest) -> station_http::HandlerAction {
    station_http::HandlerAction::Respond(station_http::HttpResponse::empty(204))
  })
  router.get("/events", fn(_req : station_http::HttpRequest) -> station_http::HandlerAction {
    station_http::HandlerAction::UpgradeSse([])
  })
  router.get("/ws", fn(_req : station_http::HttpRequest) -> station_http::HandlerAction {
    station_http::HandlerAction::UpgradeWs(Some("chat"))
  })

  let pending_sse : Array[Int] = []
  let mut err_msg = ""
  let mut srv_ws_closed = false
  let cb = station_http::ServerCallbacks::{
    on_accept: fn(_cid : Int, _peer : String) -> Bool { true },
    on_request: fn(req : station_http::HttpRequest) -> station_http::HandlerAction {
      let act = router.handle(req)
      if req.path == "/events" {
        pending_sse.push(req.conn_id)
      }
      act
    },
    on_ws_event: fn(ev : station_http::WsEvent) -> Unit {
      match ev {
        station_http::WsEvent::Text(cid, t) => {
          if t == "bye" {
            let _ = srv.ws_close(cid, 1000, "bye")
          } else {
            let _ = srv.ws_send_text(cid, "echo:" + t)
          }
        }
        station_http::WsEvent::Binary(cid, b) => {
          let _ = srv.ws_send_binary(cid, b)
        }
        station_http::WsEvent::Close(_cid, frame_opt) => {
          match frame_opt {
            Some(c) => {
              if c.code == 1000 && c.reason == "bye" {
                srv_ws_closed = true
              } else {
                err_msg = "server ws close mismatch: " + c.code.to_string()
              }
            }
            None => err_msg = "server ws close missing CloseFrame"
          }
        }
        _ => ()
      }
    },
    on_sse_close: fn(_cid : Int) -> Unit {},
    on_error: fn(msg : String) -> Unit {
      if err_msg.length() == 0 {
        err_msg = msg
      }
    },
  }

  let mut launched = false
  let mut http_get_ok = false
  let mut prefix_ok = false
  let mut http_post_ok = false
  let mut head_ok = false
  let mut no_content_ok = false
  let mut sse_ok = false
  let mut ws_text_ok = false
  let mut ws_bin_ok = false
  let mut ws_pong_ok = false
  let mut ws_closing_sent = false
  let mut ws_closed_ok = false
  let sse_parser = sse::SseParser::new()
  let sse_events : Array[sse::SseEvent] = []
  let bin_payload = Bytes::new(4)
  bin_payload[0] = (0).to_byte()
  bin_payload[1] = (1).to_byte()
  bin_payload[2] = (2).to_byte()
  bin_payload[3] = (255).to_byte()

  srv.listen_loopback(0)
  // timer: bounded smoke-http deadline (10s)
  let deadline = mux.now_ms() + 10000L

  while err_msg.length() == 0 && mux.now_ms() < deadline {
    let wait_ms = match srv.next_wake_ms() {
      Some(w) => if w < 20L { w } else { 20L }
      None => 20L
    }
    let _ = mux.step(
      wait_ms,
      fn(_line : String) -> Unit {},
      fn() -> Unit {},
      fn(tok : builders_core::MuxToken, done : host_shim::ShellDone) -> Unit {
        if srv.handle_done(tok, done, cb) {
          return ()
        }
        match tok {
          builders_core::MuxToken::Tagged(owner_id, kind, _) => {
            if kind == station_http::CLIENT_TOK_FETCH {
              match station_http::decode_fetch_done(done) {
                Err(e) => err_msg = "fetch " + owner_id.to_string() + ": " + e.message
                Ok(r) => {
                  if owner_id == 1 {
                    if r.status == 200 && r.body_text() == "pong:ok" {
                      http_get_ok = true
                    } else {
                      err_msg = "GET /api/ping failed: status=" + r.status.to_string()
                    }
                  } else if owner_id == 2 {
                    if r.status == 404 {
                      prefix_ok = true
                    } else {
                      err_msg = "GET /apiv2 expected 404, got " + r.status.to_string()
                    }
                  } else if owner_id == 3 {
                    if r.status == 200 && r.body_text() == "hello-http" {
                      http_post_ok = true
                    } else {
                      err_msg = "POST /echo failed: status=" + r.status.to_string()
                    }
                  } else if owner_id == 4 {
                    let cl_ok = match r.header("content-length") {
                      Some(v) => v == "7"
                      None => false
                    }
                    if r.status == 200 && r.body.length() == 0 && cl_ok {
                      head_ok = true
                    } else {
                      err_msg = "HEAD /api/ping failed: status=" + r.status.to_string()
                    }
                  } else if owner_id == 5 {
                    if r.status == 204 && r.body.length() == 0 {
                      no_content_ok = true
                    } else {
                      err_msg = "GET /204 failed: status=" + r.status.to_string()
                    }
                  }
                }
              }
            } else if kind == station_http::CLIENT_TOK_STREAM_OPEN {
              match station_http::decode_stream_open_done(done) {
                Err(e) => err_msg = "sse stream.open: " + e.message
                Ok(head) => {
                  if head.status != 200 {
                    err_msg = "sse status=" + head.status.to_string()
                  } else {
                    let _ = hc.stream_read_async(head.id, Some(5000L))
                  }
                }
              }
            } else if kind == station_http::CLIENT_TOK_STREAM_READ {
              match station_http::decode_stream_read_done(done) {
                Err(e) => err_msg = "sse stream.read: " + e.message
                Ok(station_http::StreamChunk::Data(b)) => {
                  match sse_parser.feed_bytes(b) {
                    Ok(evs) => {
                      let mut ei = 0
                      while ei < evs.length() {
                        sse_events.push(evs[ei])
                        ei = ei + 1
                      }
                      let _ = hc.stream_read_async(owner_id, Some(5000L))
                    }
                    Err(e) => err_msg = "sse parse: " + e.message()
                  }
                }
                Ok(station_http::StreamChunk::End) => {
                  let _ = hc.stream_close_async(owner_id)
                  let retry_ok = if sse_events.length() == 1 {
                    match sse_events[0].retry {
                      Some(ms) => ms == 2500L
                      None => false
                    }
                  } else {
                    false
                  }
                  if sse_events.length() == 1 &&
                  sse_events[0].event_type == "hello" &&
                  sse_events[0].id == "1" &&
                  sse_events[0].data == "line1\nline2" &&
                  retry_ok {
                    sse_ok = true
                  } else {
                    err_msg = "sse events mismatch: count=" + sse_events.length().to_string()
                  }
                }
              }
            } else if kind == station_http::CLIENT_TOK_WS_OPEN {
              match station_http::decode_ws_open_done(done) {
                Err(e) => err_msg = "ws.open: " + e.message
                Ok(wid) => {
                  let _ = wc.send_text_async(wid, "hi")
                  let _ = wc.send_binary_async(wid, bin_payload)
                  let _ = wc.ping_async(wid)
                  let _ = wc.recv_async(wid)
                }
              }
            } else if kind == station_http::CLIENT_TOK_WS_NEXT {
              match station_http::decode_ws_next_done(done) {
                Err(e) => err_msg = "ws.next: " + e.message
                Ok(station_http::WsClientEvent::Text(t)) => {
                  if t == "echo:hi" {
                    ws_text_ok = true
                  } else {
                    err_msg = "ws text mismatch: " + t
                  }
                  if err_msg.length() == 0 {
                    if ws_text_ok && ws_bin_ok && ws_pong_ok && !ws_closing_sent {
                      ws_closing_sent = true
                      let _ = wc.send_text_async(owner_id, "bye")
                    }
                    let _ = wc.recv_async(owner_id)
                  }
                }
                Ok(station_http::WsClientEvent::Binary(b)) => {
                  if b.length() == 4 &&
                  (b[0].to_int() & 0xFF) == 0 &&
                  (b[1].to_int() & 0xFF) == 1 &&
                  (b[2].to_int() & 0xFF) == 2 &&
                  (b[3].to_int() & 0xFF) == 255 {
                    ws_bin_ok = true
                  } else {
                    err_msg = "ws binary mismatch"
                  }
                  if err_msg.length() == 0 {
                    if ws_text_ok && ws_bin_ok && ws_pong_ok && !ws_closing_sent {
                      ws_closing_sent = true
                      let _ = wc.send_text_async(owner_id, "bye")
                    }
                    let _ = wc.recv_async(owner_id)
                  }
                }
                Ok(station_http::WsClientEvent::Pong) => {
                  ws_pong_ok = true
                  if ws_text_ok && ws_bin_ok && ws_pong_ok && !ws_closing_sent {
                    ws_closing_sent = true
                    let _ = wc.send_text_async(owner_id, "bye")
                  }
                  let _ = wc.recv_async(owner_id)
                }
                Ok(station_http::WsClientEvent::Ping) => {
                  let _ = wc.recv_async(owner_id)
                }
                Ok(station_http::WsClientEvent::Closed(code_opt, reason)) => {
                  let code_ok = match code_opt {
                    Some(c) => c == 1000
                    None => false
                  }
                  if ws_closing_sent && code_ok && reason == "bye" {
                    ws_closed_ok = true
                    let _ = wc.close_async(owner_id)
                  } else if !ws_closing_sent {
                    err_msg = "ws closed prematurely"
                  } else {
                    err_msg = "ws close mismatch: reason=" + reason
                  }
                }
              }
            } else {
              ()
            }
          }
          _ => ()
        }
      },
    )

    while pending_sse.length() > 0 {
      match pending_sse.pop() {
        Some(cid) => {
          let _ = srv.sse_send(cid, "hello", "line1\nline2", "1", Some(2500L))
          let _ = srv.sse_ping(cid)
          let _ = srv.sse_close(cid)
        }
        None => ()
      }
    }

    if !launched && srv.is_listening() {
      launched = true
      let base = "http://127.0.0.1:" + srv.port().to_string()
      let close_hdr : Array[(String, String)] = [("Connection", "close")]
      let mk_get = fn(u : String) -> station_http::FetchOptions {
        station_http::FetchOptions::{
          method: "GET",
          url: u,
          headers: close_hdr,
          body: None,
          timeout_ms: Some(5000L),
          stall_ms: None,
          redirect: "manual",
          proxy: None,
          ca_pem: None,
          entry: None,
        }
      }
      let post_opts = station_http::FetchOptions::{
        method: "POST",
        url: base + "/echo",
        headers: close_hdr,
        body: Some("hello-http".to_bytes()),
        timeout_ms: Some(5000L),
        stall_ms: None,
        redirect: "manual",
        proxy: None,
        ca_pem: None,
        entry: None,
      }
      let _ = hc.fetch_async(1, mk_get(base + "/api/ping?k=ok"))
      let _ = hc.fetch_async(2, mk_get(base + "/apiv2"))
      let _ = hc.fetch_async(3, post_opts)
      let head_opts = station_http::FetchOptions::{
        method: "HEAD",
        url: base + "/api/ping?k=ok",
        headers: close_hdr,
        body: None,
        timeout_ms: Some(5000L),
        stall_ms: None,
        redirect: "manual",
        proxy: None,
        ca_pem: None,
        entry: None,
      }
      let _ = hc.fetch_async(4, head_opts)
      let _ = hc.fetch_async(5, mk_get(base + "/204"))
      let _ = hc.stream_open_async(6, station_http::FetchOptions::get(base + "/events"))
      let ws_opts = station_http::WsOpenOptions::{
        url: "ws://127.0.0.1:" + srv.port().to_string() + "/ws",
        headers: [],
        protocols: ["chat"],
        timeout_ms: Some(5000L),
        entry: None,
        binary: true,
        control: true,
      }
      let _ = wc.open_async(7, ws_opts)
    }

    let _ = srv.tick(cb)
    if http_get_ok &&
    prefix_ok &&
    http_post_ok &&
    head_ok &&
    no_content_ok &&
    sse_ok &&
    ws_closed_ok &&
    srv_ws_closed &&
    srv.active_connections() == 0 {
      break
    }
  }

  let port = srv.port()
  let active_left = srv.active_connections()
  srv.close_with_callbacks(cb)
  host_shim::stop()

  if err_msg.length() > 0 {
    let _ = host_shim::write_stderr_line("smoke-http: " + err_msg)
    return 1
  }
  if !(http_get_ok &&
    prefix_ok &&
    http_post_ok &&
    head_ok &&
    no_content_ok &&
    sse_ok &&
    ws_closed_ok &&
    srv_ws_closed &&
    active_left == 0) {
    let _ = host_shim::write_stderr_line(
      "smoke-http: timed out before all checks passed (active_connections=" +
      active_left.to_string() +
      ")",
    )
    return 1
  }
  let _ = host_shim::write_stdout_line(
    "{\"ok\":true,\"port\":" + port.to_string() + ",\"http\":true,\"prefix\":true,\"head\":true,\"no_content\":true,\"sse\":true,\"ws\":true}",
  )
  0
}

fn encode_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp as Byte)
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)) as Byte)
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  } else {
    sb.write_byte((0xF0 | (cp >> 18)) as Byte)
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)) as Byte)
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  }
}

fn check_sql_js_lower(db : sql_db::Db, input : String, label : String) -> Result[Unit, String] {
  let expected = jscase::lower(input)
  match db.first("SELECT js_lower(?1) AS v", [base_codec::json_str(input)]) {
    Ok(Some(row)) => match row.get("v") {
      Some(base_codec::Json::Str(got)) => {
        if got == expected {
          Ok(())
        } else {
          Err("js_lower mismatch on " + label + ": got len=" + got.length().to_string() + " expected len=" + expected.length().to_string())
        }
      }
      _ => Err("js_lower returned non-string on " + label)
    }
    Ok(None) => Err("js_lower returned no row on " + label)
    Err(e) => Err("js_lower query error on " + label + ": " + e.message)
  }
}

fn run_smoke_js_lower() -> Int {
  match station_sys::register_sqlite_js_lower() {
    Ok(_) => ()
    Err(e) => {
      let _ = host_shim::write_stderr_line("smoke-js-lower: " + e)
      return 1
    }
  }
  let store = match station_store::Store::open(":memory:") {
    Ok(s) => s
    Err(e) => {
      let _ = host_shim::write_stderr_line("smoke-js-lower: open :memory: failed: " + e.message)
      return 1
    }
  }
  let db = store.db

  // 1. Exhaustive codepoint sweep 0x0001..=0x1E950 (skipping UTF-16 surrogates 0xD800..=0xDFFF).
  //    Each codepoint is separated by ASCII space so isolated lowering is checked cleanly in batches.
  let mut checked = 0
  let mut cp = 1
  while cp <= 0x1E950 {
    let sb = StringBuilder::new()
    let batch_start = cp
    let mut in_batch = 0
    while cp <= 0x1E950 && in_batch < 256 {
      if cp >= 0xD800 && cp <= 0xDFFF {
        cp = 0xE000
        continue
      }
      if in_batch > 0 {
        sb.write_byte(32 as Byte)
      }
      encode_utf8_cp(sb, cp)
      cp = cp + 1
      in_batch = in_batch + 1
      checked = checked + 1
    }
    let batch_str = sb.to_string()
    match check_sql_js_lower(db, batch_str, "batch@" + batch_start.to_string()) {
      Ok(_) => ()
      Err(e) => {
        // Pinpoint exact failing codepoint for immediate diagnosis.
        let mut p = batch_start
        while p < cp {
          if p >= 0xD800 && p <= 0xDFFF {
            p = 0xE000
            continue
          }
          let one = StringBuilder::new()
          encode_utf8_cp(one, p)
          match check_sql_js_lower(db, one.to_string(), "U+" + p.to_string()) {
            Ok(_) => ()
            Err(pe) => {
              let _ = host_shim::write_stderr_line("smoke-js-lower: " + pe)
              db.close()
              return 1
            }
          }
          p = p + 1
        }
        let _ = host_shim::write_stderr_line("smoke-js-lower: " + e)
        db.close()
        return 1
      }
    }
  }

  // 2. Six Final_Sigma (U+03A3) contexts + Greek/Turkish/Kelvin + `mİx`.
  let special_cases : Array[(String, String)] = [
    ("final_sigma_isolated", "\u{03A3}"),
    ("final_sigma_word_end", "\u{0391}\u{039F}\u{03A3}"),
    ("final_sigma_before_space", "\u{0391}\u{039F}\u{03A3} "),
    ("final_sigma_medial", "\u{0391}\u{039F}\u{03A3}\u{0391}"),
    ("final_sigma_initial", "\u{03A3}\u{0391}"),
    ("final_sigma_combining_before", "\u{0391}\u{0301}\u{03A3}"),
    ("final_sigma_combining_after", "\u{0391}\u{039F}\u{03A3}\u{0301}\u{0391}"),
    ("greek_turkish_kelvin", "\u{0386}\u{03BD}\u{03BD}\u{03B1} \u{0130}ZM\u{0130}R 300\u{212A}"),
    ("turkish_dotted_mix", "m\u{0130}x"),
  ]
  for i in 0..<special_cases.length() {
    let (lbl, sample) = special_cases[i]
    match check_sql_js_lower(db, sample, lbl) {
      Ok(_) => ()
      Err(e) => {
        let _ = host_shim::write_stderr_line("smoke-js-lower: " + e)
        db.close()
        return 1
      }
    }
  }
  // Confirm `mİx` does NOT lower to plain `"mix"` (contains combining dot above U+0307).
  if jscase::lower("m\u{0130}x") == "mix" {
    let _ = host_shim::write_stderr_line("smoke-js-lower: mİx unexpectedly lowered to mix")
    db.close()
    return 1
  }

  // 3. NULL handling: `SELECT js_lower(NULL) IS NULL` must return 1.
  let null_ok = match db.first("SELECT js_lower(NULL) IS NULL AS is_null", []) {
    Ok(Some(row)) => match row.get("is_null") {
      Some(base_codec::Json::Num(n, _)) => n.to_int() == 1
      _ => false
    }
    _ => false
  }
  if !null_ok {
    let _ = host_shim::write_stderr_line("smoke-js-lower: NULL check failed")
    db.close()
    return 1
  }

  // 4. Long string > 4096 bytes exercising the heap allocation path in `station_sqlite_ext.c`.
  let long_sb = StringBuilder::new()
  let unit = "ABC-\u{0386}\u{03BD}\u{03BD}\u{03B1}-\u{0130}ZM\u{0130}R-300\u{212A}-\u{0391}\u{039F}\u{03A3}-"
  for _i in 0..<180 {
    long_sb.write_string(unit)
  }
  let long_str = long_sb.to_string()
  if long_str.to_bytes().length() <= 4096 {
    let _ = host_shim::write_stderr_line("smoke-js-lower: long_str unexpectedly <= 4096 bytes")
    db.close()
    return 1
  }
  match check_sql_js_lower(db, long_str, "long_heap_string") {
    Ok(_) => ()
    Err(e) => {
      let _ = host_shim::write_stderr_line("smoke-js-lower: " + e)
      db.close()
      return 1
    }
  }

  db.close()
  let _ = host_shim::write_stdout_line(
    "{\"ok\":true,\"codepoints\":" +
    checked.to_string() +
    ",\"final_sigma\":true,\"null\":true,\"long_bytes\":" +
    long_str.to_bytes().length().to_string() +
    "}",
  )
  0
}

fn run_internal_replica_restore(argv : Array[String]) -> Int {
  let mut db = ""
  let mut data = ""
  let mut sep = if station_sys::os_name() == "win32" { "\\" } else { "/" }
  let mut now_ms = host_shim::wall_ms()
  let mut i = 2
  while i < argv.length() {
    let a = argv[i]
    if a == "--db" && i + 1 < argv.length() {
      db = argv[i + 1]
      i = i + 2
    } else if a == "--data" && i + 1 < argv.length() {
      data = argv[i + 1]
      i = i + 2
    } else if a == "--sep" && i + 1 < argv.length() {
      sep = argv[i + 1]
      i = i + 2
    } else if a == "--now" && i + 1 < argv.length() {
      match base_codec::parse_int64_str(argv[i + 1]) {
        Some(v) => now_ms = v
        None => {
          let _ = host_shim::write_stderr_line("internal-replica-restore: invalid --now value")
          return 2
        }
      }
      i = i + 2
    } else {
      i = i + 1
    }
  }
  if db.length() == 0 || data.length() == 0 {
    let _ = host_shim::write_stderr_line("internal-replica-restore: --db and --data are required")
    return 2
  }
  // 1:1 with Node `--builder replica-restore`:
  // Guard against orphan WAL / zero-byte DB with nonempty WAL, ensure target schema via
  // `ensure_restore_target_schema` (handles empty DB & v12->v13 upgrades with WAL/busy_timeout),
  // then hand sole ownership of `<data>/restore/` and `<data>/replica/restored.json` to
  // `builders_replica::take_back`.
  let db_stat = station_sys::lstat_raw(db)
  let wal_nonempty = file_is_nonempty(db + "-wal")
  match db_stat {
    None =>
    if wal_nonempty {
      let _ = host_shim::write_stderr_line("internal-replica-restore: orphan_wal_without_db, preserving restore/ready.json")
      return 1
    }
    Some(raw) =>
    match parse_stat_file_size(raw) {
      Some(sz) =>
      if sz == 0L && wal_nonempty {
        let _ = host_shim::write_stderr_line("internal-replica-restore: zero_byte_db_with_nonempty_wal, preserving restore/ready.json")
        return 1
      }
      None => ()
    }
  }
  let existed_before = db_stat is Some(_)
  let _ = station_sys::register_sqlite_js_lower()
  match station_store::ensure_restore_target_schema(db, wait_ms=2000, now_ms=now_ms) {
    Ok(()) => ()
    Err(se) => {
      if !existed_before && se.code != 5 && se.code != 6 {
        match station_sys::lstat_raw(db) {
          Some(after_raw) =>
          match parse_stat_file_size(after_raw) {
            Some(sz) =>
            if sz == 0L && !file_is_nonempty(db + "-wal") {
              let _ = station_sys::unlink(db)
              let _ = station_sys::unlink(db + "-journal")
            }
            None => ()
          }
          None => ()
        }
      }
      let _ = host_shim::write_stderr_line("internal-replica-restore: failed to prepare target db: " + se.message)
      return 1
    }
  }

  let shell_dir = station_sys::tmpdir() + "/stillfail-replica-restore-" + host_shim::pid().to_string() + "-" + host_shim::wall_ms().to_string()
  if !host_shim::start(shell_dir, false) {
    let _ = host_shim::write_stderr_line("internal-replica-restore: host_shim::start failed")
    return 1
  }
  let tb_res = builders_replica::take_back(
    builders_core::ShellClient::new(),
    sep,
    data,
    db,
    now_ms.to_double(),
  )
  host_shim::stop()
  let _ = station_sys::rmdir(shell_dir)

  match tb_res {
    Ok(Some(_)) | Ok(None) => 0
    Err(e) => {
      let _ = host_shim::write_stderr_line("internal-replica-restore: " + e)
      1
    }
  }
}

fn parse_stat_file_size(raw : String) -> Option[Int64] {
  let parts = raw.split("|")
  if parts.length() < 2 || parts[0] != "file" {
    return None
  }
  let size_str = parts[1]
  if size_str.length() == 0 {
    return None
  }
  let mut acc = 0L
  for i in 0..<size_str.length() {
    let c = size_str.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10L + (c - 48).to_int64()
  }
  Some(acc)
}

fn file_is_nonempty(path : String) -> Bool {
  match station_sys::lstat_raw(path) {
    None => false
    Some(raw) => match parse_stat_file_size(raw) {
      Some(sz) => sz > 0L
      None => true
    }
  }
}

fn should_run_whole_daemon(argv : Array[String]) -> Bool {
  for i in 1..<argv.length() {
    if argv[i] == "--whole-daemon" {
      return true
    }
  }
  match station_sys::env_get("STILLFAIL_PION_WHOLE_DAEMON") {
    Some("1") => return true
    _ => ()
  }
  // Auto-route 1:1 with `station/native/launcher/src/data.rs::is_rig` & TS `isRig`:
  // only explicitly rig-only stations (`cloud.json`) run `rig_daemon`; everything else
  // (including unenrolled or whole stations) routes directly to `whole_daemon`.
  let sep = if station_sys::os_name() == "win32" { "\\" } else { "/" }
  let home = station_sys::homedir()
  let env_data = station_sys::env_get("STILLFAIL_DATA")
  let data = match parse_daemon_run_args(argv, env_data, home, sep=sep) {
    Ok(parsed) => parsed.data
    Err(_) => station_ops::data_dir([], env_data, home, sep=sep)
  }
  let cloud_path = nodepath::join(sep, [data, "mesh", "cloud.json"])
  match station_sys::read_file_strict(cloud_path) {
    Ok(raw) => !is_rig_raw_cloud_json(raw.to_string())
    Err(_) => true
  }
}

fn main(_world : World) -> Unit {
  let argv = host_shim::args()
  if argv.length() == 2 && argv[1] == "--version" {
    let _ = host_shim::write_stdout_line(version_line())
    return
  }
  if argv.length() == 2 && argv[1] == "--smoke-sys" {
    let rc = run_smoke_sys()
    if rc != 0 {
      host_shim::exit_process(rc)
    }
    return
  }
  if argv.length() == 3 && argv[1] == "--smoke-runner" {
    let rc = run_smoke_runner(argv[2])
    if rc != 0 {
      host_shim::exit_process(rc)
    }
    return
  }
  if argv.length() == 2 && argv[1] == "--smoke-http" {
    let rc = run_smoke_http()
    if rc != 0 {
      host_shim::exit_process(rc)
    }
    return
  }
  if argv.length() == 2 && argv[1] == "--smoke-js-lower" {
    let rc = run_smoke_js_lower()
    if rc != 0 {
      host_shim::exit_process(rc)
    }
    return
  }
  if argv.length() == 2 && argv[1] == "--smoke-vault-sqlite" {
    match station_vault::run_vault_sqlite_selftest() {
      Ok(_) => match station_whole::run_vault_decisions_sqlite_selftest() {
        Ok(_) => match station_whole::run_vault_daemon_e2e_selftest() {
          Ok(_) => match station_whole::run_vault_mcp_sqlite_selftest() {
            Ok(_) => {
              let _ = host_shim::write_stdout_line("{\"ok\":true,\"sqlite_vault\":true,\"sqlite_vault_decisions\":true,\"sqlite_vault_daemon_e2e\":true,\"sqlite_vault_mcp\":true}")
            }
            Err(e) => {
              let _ = host_shim::write_stderr_line("smoke-vault-sqlite mcp: " + e)
              host_shim::exit_process(1)
            }
          }
          Err(e) => {
            let _ = host_shim::write_stderr_line("smoke-vault-sqlite daemon e2e: " + e)
            host_shim::exit_process(1)
          }
        }
        Err(e) => {
          let _ = host_shim::write_stderr_line("smoke-vault-sqlite decisions: " + e)
          host_shim::exit_process(1)
        }
      }
      Err(e) => {
        let _ = host_shim::write_stderr_line("smoke-vault-sqlite: " + e)
        host_shim::exit_process(1)
      }
    }
    return
  }
  if argv.length() == 2 && argv[1] == "--smoke-w17c3a-sqlite" {
    match station_whole::run_w17c3a_sqlite_selftest() {
      Ok(_) => {
        let _ = host_shim::write_stdout_line("{\"ok\":true,\"w17c3a_sqlite\":true}")
      }
      Err(e) => {
        let _ = host_shim::write_stderr_line("smoke-w17c3a-sqlite: " + e)
        host_shim::exit_process(1)
      }
    }
    return
  }
  if argv.length() >= 2 && argv[1] == "--internal-replica-restore" {
    let rc = run_internal_replica_restore(argv)
    if rc != 0 {
      host_shim::exit_process(rc)
    }
    return
  }
  if argv.length() >= 2 {
    match classify_hooks_tui_command(argv[1]) {
      Some(cmd) => {
        let rc = run_hooks_tui_command(cmd, argv)
        if rc != 0 {
          host_shim::exit_process(rc)
        }
        return
      }
      None => ()
    }
    let cli_args : Array[String] = []
    let mut i = 1
    while i < argv.length() {
      cli_args.push(argv[i])
      i = i + 1
    }
    match find_main_subcommand(cli_args) {
      Some("run") => {
        // Wave 17C-1: live `stillfail-runner` spawning & turn execution are wired in Pion
        // `whole_daemon`; external connects & cross-station `connect.event` run natively on Pion.
        let rc = if should_run_whole_daemon(argv) {
          run_whole_daemon(argv)
        } else {
          run_rig_daemon(argv)
        }
        if rc != 0 {
          host_shim::exit_process(rc)
        }
        return
      }
      Some(cmd) => {
        if is_cli_command(cmd) {
          let rc = run_cli_main(argv)
          if rc != 0 {
            host_shim::exit_process(rc)
          }
          return
        }
      }
      None => ()
    }
  }
  let _ = host_shim::write_stderr((usage_line() + "\n").to_bytes())
  host_shim::exit_process(2)
}
