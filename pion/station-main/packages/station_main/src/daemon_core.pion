// Shared pure-Pion daemon transport and lifecycle core (`daemon_core.pion`) for
// `stillfail-station-pion` roles (`rig_daemon` and future `whole_daemon`).
//
// Encapsulates:
// - CLI run-arg parsing (`DaemonRunArgs`), `host_shim::start`, standalone `HeldLock`,
//   `ConfigFile`, `CloudStore`, and OS CSPRNG `load_key`;
// - Launcher control channel (`EV_CTRL`, `EV_SIG`, `EV_RUN_WATCH`), `ready`, `handover`,
//   `serving("admin"|"mcp", port)`, `heartbeat`, `SIGHUP` -> `channel-ask`, and `heap` snapshots;
// - Predecessor identification (`hub.json` with `procStartTicks` + `bootId` + `procStartTimeMs`),
//   handover barrier, and FIFO `pending_handover_rpcs` queue (40s cap);
// - Strictly loopback HTTP listener (`/healthz` 200, `/admin` 302 redirect, `run/ports.json`);
// - Dual mesh transport (`front.sock` + direct `iroh.bind` fallback), centralized fail-closed
//   peer admission (`authenticate_peer_rpc`), optional `PEER_HTTP_ALPN` hook, outbound
//   `OutboundTell` exponential-backoff retry queue, cloud presence WebSocket, and 4-way
//   non-overlapping `ShellMux` tagging (`MUX_TAG_LOOPBACK=0`, `MUX_TAG_DOOR=1`,
//   `MUX_TAG_MESH=2`, `MUX_TAG_ROLE=3`).

import "base_codec"
import "builders_core"
import "host_shim"
import "http1"
import "mesh_door"
import "mesh_wire"
import "nodepath"
import "station_cli"
import "station_cloud"
import "station_http"
import "station_mesh"
import "station_ops"
import "station_sys"

// Non-overlapping ShellMux tag encoding (`id * 4 + tag`) so multiple `ShellMux` instances share
// one `host_shim::wait` loop without ever colliding regardless of connection count.
pub let MUX_TAG_LOOPBACK : Int64 = 0L
pub let MUX_TAG_DOOR : Int64 = 1L
pub let MUX_TAG_MESH : Int64 = 2L
pub let MUX_TAG_ROLE : Int64 = 3L

// Fixed `station_sys` event IDs owned by `daemon_core`.
pub let EV_CTRL : Int64 = 10L
pub let EV_SIG : Int64 = 11L
pub let EV_RUN_WATCH : Int64 = 12L

// Mesh/iroh & front.sock `MuxToken::Tagged` kinds on `mux_mesh`.
let MESH_TOK_BIND : Int = 4001
let MESH_TOK_ACCEPT : Int = 4004
let MESH_TOK_ACCEPT_BI : Int = 4005
let MESH_TOK_READ : Int = 4006
let MESH_TOK_WRITE : Int = 4007
let MESH_TOK_FINISH : Int = 4008
let MESH_TOK_CONN_CLOSE : Int = 4009
let MESH_TOK_EP_CLOSE : Int = 4010
let MESH_TOK_ZSTD_UNPACK : Int = 4011
let MESH_TOK_HTTP_WRITE : Int = 4012
let MESH_TOK_HTTP_FINISH : Int = 4013
let MESH_TOK_HTTP_RESET : Int = 4014
let MESH_TOK_OUT_CONNECT : Int = 4020
let MESH_TOK_OUT_OPEN_BI : Int = 4021
let MESH_TOK_OUT_WRITE : Int = 4022
let MESH_TOK_OUT_FINISH : Int = 4023
let MESH_TOK_OUT_CLOSE : Int = 4024
let MESH_TOK_OUT_READ : Int = 4025
let FRONT_TOK_LISTEN : Int = 4030
let FRONT_TOK_OPEN : Int = 4031
let FRONT_TOK_CTRL_READ : Int = 4032
let FRONT_TOK_CTRL_WRITE : Int = 4033
let FRONT_TOK_STREAM_ACCEPT : Int = 4034
let FRONT_TOK_STREAM_READ : Int = 4035
let FRONT_TOK_STREAM_WRITE : Int = 4036
let FRONT_TOK_STREAM_END : Int = 4037
let FRONT_TOK_OUT_WRITE : Int = 4038
let FRONT_TOK_HTTP_WRITE : Int = 4039
let FRONT_TOK_HTTP_FINISH : Int = 4040

// Hardening caps for inbound mesh connections, streams, and outbound tell retries.
pub let MAX_ACTIVE_CONNS : Int = 64
pub let MAX_ACTIVE_STREAMS : Int = 128
pub let MAX_ACTIVE_PEER_HTTP_STREAMS : Int = 128
pub let STREAM_READ_TIMEOUT_MS : Int64 = 15000L
pub let PEER_HTTP_IDLE_TIMEOUT_MS : Int64 = 60000L
pub let MAX_EARLY_PEER_HTTP_BYTES : Int = 1048576
pub let PEER_HTTP_WRITE_HIGH_WATER : Int = 1048576
pub let PEER_HTTP_WRITE_LOW_WATER : Int = 262144
pub let PEER_HTTP_WRITE_HARD_CAP : Int = 2097152
pub let MAX_OUTBOUND_TELLS : Int = 128
pub let TELL_RETRY_MAX_MS : Int64 = 3600000L
pub let TELL_BACKOFF_CAP_MS : Int64 = 60000L
pub let TELL_SLOT_TIMEOUT_MS : Int64 = 15000L
pub let DEFAULT_MAX_BINARY_BUF : Int = 327680 // 256 KiB + 64 KiB
pub let FILE_STREAM_CHUNK_BYTES : Int64 = 262144L

// Exact `client/shell/src/istream.rs:264,265` & `station/src/mesh/front.ts:21,22` frame markers.
pub let FRONT_FRAME_END : Int64 = 4294967294L // 0xFFFFFFFE
pub let FRONT_FRAME_FAILED : Int64 = 4294967293L // 0xFFFFFFFD
pub let FRONT_FRAME_MOST : Int = 65536

pub fn encode_mux_id(id : Int64, tag : Int64) -> Int64 {
  id * 4L + tag
}

pub fn decode_mux_id(encoded : Int64) -> (Int64, Int64) {
  (encoded / 4L, encoded % 4L)
}

/// Rewrite synchronous `fetch.cancel` JSON `"id"` to `id * 4L + tag` so it matches the
/// encoded call ID submitted by `call_async` in `make_tagged_mux`.
pub fn rewrite_tagged_sync_args(op : String, json_str : String, tag : Int64) -> String {
  if op != "fetch.cancel" {
    return json_str
  }
  match base_codec::json_parse(json_str) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Obj(fields)) => {
      let out : Array[(String, base_codec::Json)] = []
      for i in 0..<fields.length() {
        let (k, v) = fields[i]
        if k == "id" {
          match v {
            base_codec::Json::Num(n, raw) => {
              let id64 = match base_codec::parse_int64_str(raw) {
                Some(i64v) => i64v
                None => n.to_int64()
              }
              out.push((k, base_codec::json_int64(encode_mux_id(id64, tag))))
            }
            _ => out.push((k, v))
          }
        } else {
          out.push((k, v))
        }
      }
      base_codec::json_stringify(base_codec::json_obj(out))
    }
    _ => json_str
  }
}

pub struct MuxSlot {
  pub mut next_ev : Option[host_shim::HostEvent]
}

pub fn make_tagged_mux(tag : Int64, slot : MuxSlot) -> builders_core::ShellMux {
  let transport = builders_core::MuxTransport::{
    call_async: fn(id : Int64, op : String, json : String, bytes : Option[Bytes]) -> Unit {
      host_shim::shell_call(encode_mux_id(id, tag), op, json, bytes)
    },
    call_sync: fn(op : String, json : String) -> String {
      // sync: ShellMux transport sync callback (rewrites fetch.cancel IDs)
      host_shim::shell_sync(op, rewrite_tagged_sync_args(op, json, tag))
    },
    write_stdout_line: host_shim::write_stdout_line,
    write_stdout_frame: host_shim::write_stdout_frame,
    now_ms: host_shim::now_ms,
    wall_ms: host_shim::wall_ms,
    wait: fn(_ms : Int64) -> Option[host_shim::HostEvent] {
      let ev = slot.next_ev
      slot.next_ev = None
      ev
    },
  }
  builders_core::ShellMux::new(transport, start_stdin=false)
}

/// Create a `ShellMux` bound to `MUX_TAG_ROLE` (tag 3) for role-owned async work
/// (e.g. `image.thumb`, connects, browser, or inherited MCP fd in `whole_daemon`).
pub fn make_role_mux(slot : MuxSlot) -> builders_core::ShellMux {
  make_tagged_mux(MUX_TAG_ROLE, slot)
}

pub struct DaemonRunArgs {
  pub app : Option[String]
  pub data : String
  pub port : Option[Int]
  pub launcher : station_ops::LauncherArgs
}

fn daemon_parse_non_neg_int(s : String) -> Option[Int] {
  if s.length() == 0 {
    return None
  }
  let mut acc = 0
  for i in 0..<s.length() {
    let c = s.code_unit_at(i) & 0xFF
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10 + (c - 48)
  }
  Some(acc)
}

/// Parse `stillfail-station-pion run [--app DIR] [--port N] [--data DIR] [--control-fd N] [--launcher-*]`
/// arguments into a normalized `DaemonRunArgs`.
pub fn parse_daemon_run_args(
  argv : Array[String],
  env_data : Option[String],
  home : String,
  sep : String = "/",
) -> Result[DaemonRunArgs, String] {
  let args : Array[String] = []
  let start = if argv.length() > 1 && argv[1] == "run" { 2 } else { 1 }
  for i in start..<argv.length() {
    args.push(argv[i])
  }
  let app = station_ops::flag(args, "--app")
  let data = station_ops::data_dir(args, env_data, home, sep=sep)
  let port : Option[Int] = match station_ops::flag(args, "--port") {
    Some(p) => {
      match daemon_parse_non_neg_int(p) {
        Some(n) => {
          if n > 65535 {
            return Err("invalid --port value: " + p)
          }
          Some(n)
        }
        None => return Err("invalid --port value: " + p)
      }
    }
    None => None
  }
  let base_launcher = station_ops::parse_launcher_args(args)
  let launcher = match (base_launcher.fds, station_ops::flag(args, "--control-fd")) {
    (None, Some(fd_raw)) => {
      match daemon_parse_non_neg_int(fd_raw) {
        Some(fd) => {
          station_ops::LauncherArgs::{
            fds: Some(station_ops::LauncherFds::{ mcp: -1, loopback: -1, control: fd }),
            pipe: base_launcher.pipe,
            ports: base_launcher.ports,
            carries: base_launcher.carries,
            heartbeats: base_launcher.heartbeats,
            installer: base_launcher.installer,
          }
        }
        None => return Err("invalid --control-fd value: " + fd_raw)
      }
    }
    _ => base_launcher
  }
  Ok(DaemonRunArgs::{ app: app, data: data, port: port, launcher: launcher })
}

