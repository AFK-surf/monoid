pub struct RigRunArgs {
  pub app : Option[String]
  pub data : String
  pub port : Option[Int]
  pub launcher : station_ops::LauncherArgs
}

fn parse_non_neg_int(s : String) -> Option[Int] {
  if s.length() == 0 {
    return None
  }
  let mut acc = 0
  for i in 0..<s.length() {
    let c = s.code_unit_at(i) & 0xFF
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10 + (c - 48)
  }
  Some(acc)
}

/// Parse `stillfail-station-pion run [--app DIR] [--port N] [--data DIR] [--control-fd N] [--launcher-*]`
/// arguments into a normalized `RigRunArgs`.
pub fn parse_rig_run_args(
  argv : Array[String],
  env_data : Option[String],
  home : String,
  sep : String = "/",
) -> Result[RigRunArgs, String] {
  let args : Array[String] = []
  let start = if argv.length() > 1 && argv[1] == "run" { 2 } else { 1 }
  for i in start..<argv.length() {
    args.push(argv[i])
  }
  let app = station_ops::flag(args, "--app")
  let data = station_ops::data_dir(args, env_data, home, sep=sep)
  let port : Option[Int] = match station_ops::flag(args, "--port") {
    Some(p) => {
      match parse_non_neg_int(p) {
        Some(n) => {
          if n > 65535 {
            return Err("invalid --port value: " + p)
          }
          Some(n)
        }
        None => return Err("invalid --port value: " + p)
      }
    }
    None => None
  }
  let base_launcher = station_ops::parse_launcher_args(args)
  let launcher = match (base_launcher.fds, station_ops::flag(args, "--control-fd")) {
    (None, Some(fd_raw)) => {
      match parse_non_neg_int(fd_raw) {
        Some(fd) => {
          station_ops::LauncherArgs::{
            fds: Some(station_ops::LauncherFds::{ mcp: -1, loopback: -1, control: fd }),
            pipe: base_launcher.pipe,
            ports: base_launcher.ports,
            carries: base_launcher.carries,
            heartbeats: base_launcher.heartbeats,
            installer: base_launcher.installer,
          }
        }
        None => return Err("invalid --control-fd value: " + fd_raw)
      }
    }
    _ => base_launcher
  }
  Ok(RigRunArgs::{ app: app, data: data, port: port, launcher: launcher })
}

/// Launcher-parity `is_rig` check on raw `cloud.json` text (`station/native/launcher/src/data.rs:202`):
/// returns `true` iff top-level JSON is an object with an object `rig` field AND NO `removed_at` key
/// (even `"removed_at": null` MUST return `false` to match the Rust launcher).
pub fn is_rig_raw_cloud_json(raw : String) -> Bool {
  match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Obj(fields)) => {
      let mut has_rig = false
      for i in 0..<fields.length() {
        let (k, v) = fields[i]
        if k == "removed_at" {
          return false
        }
        if k == "rig" {
          match v {
            base_codec::Json::Obj(_) => has_rig = true
            _ => ()
          }
        }
      }
      has_rig
    }
    _ => false
  }
}

/// `remote:<workspace>:<station>:<session>` job owner key (`station/src/rig/main.ts:44`).
pub fn owner_of(workspace : String, station : String, session : String) -> String {
  "remote:" + workspace + ":" + station + ":" + session
}

/// Parse `remote:<workspace>:<station>:<session>` back into `RunningChat`, preserving colons in `<session>`.
pub fn parse_owner(session_key : String) -> Option[station_rig::RunningChat] {
  if !session_key.starts_with("remote:") {
    return None
  }
  let rest = session_key.slice(7, session_key.length())
  let mut c1 = -1
  for i in 0..<rest.length() {
    if (rest.code_unit_at(i) & 0xFF) == 58 {
      c1 = i
      break
    }
  }
  if c1 < 0 {
    return None
  }
  let mut c2 = -1
  for i in (c1 + 1)..<rest.length() {
    if (rest.code_unit_at(i) & 0xFF) == 58 {
      c2 = i
      break
    }
  }
  if c2 < 0 {
    return None
  }
  let ws = rest.slice(0, c1)
  let st = rest.slice(c1 + 1, c2)
  let sess = rest.slice(c2 + 1, rest.length())
  Some(station_rig::RunningChat::{ workspace: ws, station: st, session: sess })
}

pub fn format_hub_json(pid : Int) -> String {
  "{\"pid\":" + pid.to_string() + "}\n"
}

pub fn format_ports_json(port : Int) -> String {
  "{\"admin\":" + port.to_string() + "}\n"
}

pub fn format_mcp_json(port : Int) -> String {
  "{\"port\":" + port.to_string() + "}\n"
}

pub fn read_hub_pid(text : String) -> Option[Int] {
  match base_codec::json_parse(text) {
    base_codec::JsonParseResult::Ok(v) => {
      match base_codec::json_get(v, "pid") {
        Some(base_codec::Json::Num(d, _)) => {
          let p = d.to_int()
          if p.to_double() == d && p > 0 { Some(p) } else { None }
        }
        _ => None
      }
    }
    _ => None
  }
}

/// Build `LoopbackPlace` from `CloudStore` for `/healthz` and `/admin*` redirects.
pub fn build_loopback_place(cloud : station_cloud::CloudStore) -> Option[station_ops::LoopbackPlace] {
  match cloud.state {
    Some(s) => {
      Some(station_ops::LoopbackPlace::{
        origin: s.origin,
        workspace: s.workspace,
        workspace_name: s.workspace_name,
        station: s.station,
        removed_at: s.removed_at,
      })
    }
    None => None
  }
}

fn json_str_field(v : base_codec::Json, key : String, fallback : String = "") -> String {
  match base_codec::json_get(v, key) {
    Some(base_codec::Json::Str(s)) => s
    _ => fallback
  }
}

fn json_opt_str_field(v : base_codec::Json, key : String) -> Option[String] {
  match base_codec::json_get(v, key) {
    Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
    _ => None
  }
}

fn json_bool_field(v : base_codec::Json, key : String, fallback : Bool = false) -> Bool {
  match base_codec::json_get(v, key) {
    Some(base_codec::Json::Bool(b)) => b
    _ => fallback
  }
}

fn json_int_field(v : base_codec::Json, key : String, fallback : Int = 0) -> Int {
  match base_codec::json_get(v, key) {
    Some(base_codec::Json::Num(d, _)) => d.to_int()
    _ => fallback
  }
}

fn json_int64_field(v : base_codec::Json, key : String, fallback : Int64 = 0L) -> Int64 {
  match base_codec::json_get(v, key) {
    Some(base_codec::Json::Num(d, _)) => d.to_int64()
    _ => fallback
  }
}

fn json_str_array_field(v : base_codec::Json, key : String) -> Array[String] {
  let out : Array[String] = []
  match base_codec::json_get(v, key) {
    Some(base_codec::Json::Arr(arr)) => {
      for i in 0..<arr.length() {
        match arr[i] {
          base_codec::Json::Str(s) => out.push(s)
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

fn require_session(req : base_codec::Json) -> Result[String, String] {
  let s = json_str_field(req, "session")
  if s.length() == 0 || s.length() > 256 {
    return Err("session is required (1..256 chars)")
  }
  Ok(s)
}

fn require_key(req : base_codec::Json) -> Result[String, String] {
  let k = json_str_field(req, "key")
  if k.length() == 0 || k.length() > 128 {
    return Err("key is required (1..128 chars)")
  }
  Ok(k)
}

fn is_valid_env_name(s : String) -> Bool {
  let raw = s.to_bytes()
  if raw.length() == 0 || raw.length() > 128 {
    return false
  }
  for i in 0..<raw.length() {
    let b = raw[i].to_int() & 0xFF
    let is_alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
    let is_digit = b >= 48 && b <= 57
    if i == 0 && !is_alpha {
      return false
    }
    if !(is_alpha || is_digit) {
      return false
    }
  }
  true
}

fn is_safe_under(under : String) -> Bool {
  if under.length() == 0 {
    return true
  }
  if under.starts_with("/") || under.starts_with("\\") {
    return false
  }
  let parts = under.split("/")
  for i in 0..<parts.length() {
    if parts[i] == ".." {
      return false
    }
    let sub = parts[i].split("\\")
    for j in 0..<sub.length() {
      if sub[j] == ".." {
        return false
      }
    }
  }
  true
}

/// Convert `station_cloud::CloudStore` into the decoupled `station_mesh::CloudRoster` view.
pub fn build_cloud_roster(
  cloud : station_cloud::CloudStore,
  now_secs : Double,
  peers_current : Bool,
) -> station_mesh::CloudRoster {
  let st = match cloud.state {
    Some(s) => s
    None => return station_mesh::CloudRoster::empty()
  }
  let ms = cloud.memberships(now_secs)
  let out_ms : Array[station_mesh::WorkspaceMembership] = []
  for i in 0..<ms.length() {
    let m = ms[i]
    let peers : Array[station_mesh::PeerInfo] = []
    for pi in 0..<m.peers.length() {
      let pid = json_str_field(m.peers[pi], "id")
      if pid.length() > 0 {
        peers.push(station_mesh::PeerInfo::{ id: pid, name: json_str_field(m.peers[pi], "name") })
      }
    }
    let rigs : Array[station_mesh::RigInfo] = []
    match m.rigs {
      Some(rs) => {
        for ri in 0..<rs.length() {
          rigs.push(station_mesh::RigInfo::{
            id: rs[ri].id,
            name: rs[ri].name,
            workspace: m.workspace,
          })
        }
      }
      None => ()
    }
    let ws_opt : Option[String] = if m.home { None } else { Some(m.workspace) }
    let waiting = match cloud.locked(now_secs, ws=ws_opt) {
      Some(eff) => eff.waiting
      None => false
    }
    out_ms.push(station_mesh::WorkspaceMembership::{
      workspace: m.workspace,
      name: m.name,
      home: m.home,
      is_rig_here: m.rig is Some(_),
      waiting: waiting,
      peers: peers,
      unprotected: [],
      rigs: rigs,
      rigs_named: rigs,
    })
  }
  let relays = match st.stillfail_relays {
    Some(rs) => rs
    None => st.relay_urls
  }
  station_mesh::CloudRoster::{
    origin: st.origin,
    station_id: st.station,
    peers_current: peers_current,
    stillfail_relays: relays,
    memberships: out_ms,
    moved_offered: Map::new(),
  }
}

/// Convert a `station_jobs::RemoteTaskRecord` + its backing `JobRecord` into the Node/MB wire `job` JSON.
/// Returns `null` when the task has not yet started (`t.job_id is None`), matching `remote_target.mbt:389,392`.
pub fn remote_task_job_json(
  remote : station_jobs::RemoteManager,
  t : station_jobs::RemoteTaskRecord,
) -> base_codec::Json {
  match t.job_id {
    Some(jid) => {
      match remote.jobs.get(jid) {
        Some(j) => return j.to_json()
        None => ()
      }
      let fields : Array[(String, base_codec::Json)] = [
        ("id", base_codec::json_str(jid)),
        ("session", base_codec::json_str(owner_of(t.workspace, t.source_station, t.source_session))),
        ("name", base_codec::json_str(t.name)),
        ("command", base_codec::json_str(t.command)),
        ("state", base_codec::json_str(station_jobs::remote_task_state_str(t.state))),
        ("startedAt", base_codec::json_int64(match t.started_at { Some(s) => s; None => t.created_at })),
        ("screen", base_codec::json_bool(t.screen)),
        ("small", base_codec::json_bool(t.small)),
      ]
      match t.exit_code {
        Some(c) => fields.push(("exitCode", base_codec::json_int(c)))
        None => ()
      }
      match t.ended_at {
        Some(e) => fields.push(("endedAt", base_codec::json_int64(e)))
        None => ()
      }
      base_codec::json_obj(fields)
    }
    None => base_codec::json_null()
  }
}

pub fn remote_task_spec_json(t : station_jobs::RemoteTaskRecord) -> base_codec::Json {
  let back_arr : Array[base_codec::Json] = []
  for i in 0..<t.back_paths.length() {
    back_arr.push(base_codec::json_str(t.back_paths[i]))
  }
  let fields : Array[(String, base_codec::Json)] = [
    ("name", base_codec::json_str(t.name)),
    ("command", base_codec::json_str(t.command)),
    ("back", base_codec::json_arr(back_arr)),
    ("screen", base_codec::json_bool(t.screen)),
    ("small", base_codec::json_bool(t.small)),
  ]
  match t.mirror_name {
    Some(m) => fields.push(("dir", base_codec::json_str(m)))
    None => ()
  }
  base_codec::json_obj(fields)
}

fn task_notices_json(
  remote : station_jobs::RemoteManager,
  t : station_jobs::RemoteTaskRecord,
) -> base_codec::Json {
  let out : Array[base_codec::Json] = []
  match t.job_id {
    Some(jid) => {
      match remote.jobs.get(jid) {
        Some(j) => {
          for i in 0..<j.notices.length() {
            out.push(base_codec::json_obj([
              ("at", base_codec::json_int64(j.notices[i].at)),
              ("text", base_codec::json_str(j.notices[i].text)),
            ]))
          }
        }
        None => ()
      }
    }
    None => ()
  }
  base_codec::json_arr(out)
}

/// Convert a `station_jobs::RemoteTaskRecord` into its wire JSON representation.
pub fn remote_task_to_json(t : station_jobs::RemoteTaskRecord) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = [
    ("key", base_codec::json_str(t.key)),
    ("name", base_codec::json_str(t.name)),
    ("command", base_codec::json_str(t.command)),
    ("state", base_codec::json_str(station_jobs::remote_task_state_str(t.state))),
    ("createdAt", base_codec::json_int64(t.created_at)),
    ("screen", base_codec::json_bool(t.screen)),
    ("small", base_codec::json_bool(t.small)),
    ("pendingResults", base_codec::json_bool(t.pending_results)),
  ]
  match t.job_id {
    Some(jid) => fields.push(("job", base_codec::json_str(jid)))
    None => ()
  }
  match t.exit_code {
    Some(c) => fields.push(("exitCode", base_codec::json_int(c)))
    None => ()
  }
  match t.started_at {
    Some(s) => fields.push(("startedAt", base_codec::json_int64(s)))
    None => ()
  }
  match t.ended_at {
    Some(e) => fields.push(("endedAt", base_codec::json_int64(e)))
    None => ()
  }
  match t.mirror_name {
    Some(m) => fields.push(("mirror", base_codec::json_str(m)))
    None => ()
  }
  base_codec::json_obj(fields)
}

/// Mirror a `station_jobs::JobRecord` into `station_store::Store` (`stillfail.db`).
pub fn sync_job_to_store(store : station_store::Store, job : station_jobs::JobRecord) -> Unit {
  let port_opt : Option[Int64] = match job.port {
    Some(p) => Some(p.to_int64())
    None => None
  }
  let pgid_opt : Option[Int64] = match job.pgid {
    Some(p) => Some(p.to_int64())
    None => None
  }
  let exit_opt : Option[Int64] = match job.exit_code {
    Some(c) => Some(c.to_int64())
    None => None
  }
  let state_s = station_jobs::job_state_to_str(job.state)
  match station_store::get_job(store.db, job.id) {
    Ok(Some(_)) => {
      let _ = station_store::update_job_state(
        store.db,
        job.id,
        state_s,
        pgid_opt,
        exit_opt,
        job.ended_at,
      )
    }
    Ok(None) => {
      let rec = station_store::JobRecord::{
        id: job.id,
        session_key: job.session,
        name: job.name,
        command: job.command,
        cwd: job.cwd,
        port: port_opt,
        token: job.token,
        state: state_s,
        pgid: pgid_opt,
        exit_code: exit_opt,
        started_at: job.started_at,
        ended_at: job.ended_at,
        restarts: job.restarts.to_int64(),
        log: job.log_path,
        watch: job.watch,
        queued: if job.queued { Some(1L) } else { None },
        screen: if job.screen { Some(1L) } else { None },
        size: None,
        small: if job.small { Some(1L) } else { None },
      }
      let _ = station_store::insert_job(store.db, rec)
    }
    Err(_) => ()
  }
}

/// Hydrate a `station_store::JobRecord` (e.g. written by Node `RigLive`) into a `station_jobs::JobRecord`.
pub fn store_job_to_job_record(rec : station_store::JobRecord) -> station_jobs::JobRecord {
  let port_opt : Option[Int] = match rec.port {
    Some(p) => Some(p.to_int())
    None => None
  }
  let pgid_opt : Option[Int] = match rec.pgid {
    Some(p) => Some(p.to_int())
    None => None
  }
  let exit_opt : Option[Int] = match rec.exit_code {
    Some(c) => Some(c.to_int())
    None => None
  }
  station_jobs::JobRecord::{
    id: rec.id,
    session: rec.session_key,
    name: rec.name,
    command: rec.command,
    cwd: rec.cwd,
    port: port_opt,
    token: rec.token,
    state: station_jobs::job_state_from_str(rec.state),
    pgid: pgid_opt,
    start_time_ms: None,
    exit_code: exit_opt,
    started_at: rec.started_at,
    ended_at: rec.ended_at,
    restarts: rec.restarts.to_int(),
    log_path: rec.log,
    watch: rec.watch,
    queued: match rec.queued { Some(v) => v != 0L; None => false },
    screen: match rec.screen { Some(v) => v != 0L; None => false },
    small: match rec.small { Some(v) => v != 0L; None => false },
    notices: [],
    next_restart_at: None,
    stop_deadline_at: None,
  }
}

/// Request handed off to the daemon's real process runner for `vault.run` / `vault.capture`.
pub struct VaultExecRequest {
  pub id : String
  pub workspace : String
  pub peer : String
  pub session : String
  pub command : String
  pub cwd : String
  pub env_pairs : Array[(String, String)]
  pub secret_values : Array[String]
  pub timeout_ms : Int64
  pub idle_timeout_sec : Int64
  pub capture : Bool
}

/// Streaming file response plan for `file.get` (`whole: true`), streamed in chunks to EOF without truncation.
pub struct StreamFilePlan {
  pub root : String
  pub rel : String
  pub offset : Int64
  pub size : Int64
}

/// Wire reply returned by `dispatch_rig_peer_rpc_ext` (JSON header + optional binary tail or streamed file).
pub struct PeerDispatchReply {
  pub json : base_codec::Json
  pub binary : Option[Bytes]
  pub stream_file : Option[StreamFilePlan]
}

fn reply_json(j : base_codec::Json) -> PeerDispatchReply {
  PeerDispatchReply::{ json: j, binary: None, stream_file: None }
}

/// Runtime hooks injected by `rig_daemon.pion` (or mocked in pure unit tests).
pub struct RigDispatchHooks {
  pub on_lock_sync : (String, base_codec::Json) -> Result[base_codec::Json, String]
  pub on_ways_sync : (String, base_codec::Json) -> Result[base_codec::Json, String]
  pub on_vault_exec : (VaultExecRequest) -> Result[Unit, String]
  pub on_vault_revoke : (String, String) -> Unit
  pub take_grants_write_err : () -> Option[String]
  pub read_under_hook : Option[(String, String, Int64, Int) -> Result[(Bytes, Int64), String]]
  pub write_under_hook : Option[(String, String, Bytes, Int64, Int, Bool) -> Result[Unit, String]]
}

pub fn default_rig_dispatch_hooks() -> RigDispatchHooks {
  RigDispatchHooks::{
    on_lock_sync: fn(_ws : String, req : base_codec::Json) -> Result[base_codec::Json, String] {
      station_mesh::answer_lock(
        0,
        None,
        None,
        [],
        req,
        fn(_entries : Array[base_codec::Json]) -> Result[station_mesh::LockWriteResult, String] {
          Err("lock write not configured")
        },
        fn(_entries : Array[base_codec::Json]) -> Result[station_mesh::LockWriteResult, String] {
          Err("lock offer not configured")
        },
      )
    },
    on_ways_sync: fn(_ws : String, _req : base_codec::Json) -> Result[base_codec::Json, String] {
      Err("ways sync not configured")
    },
    on_vault_exec: fn(_req : VaultExecRequest) -> Result[Unit, String] {
      Err("vault execution runner not configured")
    },
    on_vault_revoke: fn(_peer : String, _id : String) -> Unit {},
    take_grants_write_err: fn() -> Option[String] { None },
    read_under_hook: None,
    write_under_hook: None,
  }
}

fn is_hex40(s : String) -> Bool {
  if s.length() != 40 {
    return false
  }
  for i in 0..<40 {
    let b = s.code_unit_at(i) & 0xFF
    if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102)) {
      return false
    }
  }
  true
}

fn slice_bytes_helper(b : Bytes, start : Int, end : Int) -> Bytes {
  let s = if start < 0 { 0 } else if start > b.length() { b.length() } else { start }
  let e = if end < s { s } else if end > b.length() { b.length() } else { end }
  let out = Bytes::new(e - s)
  for i in 0..<(e - s) {
    out[i] = b[s + i]
  }
  out
}

fn bytes_to_str_helper(b : Bytes) -> String {
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

/// Safe read under `root`/`rel`: uses FD-level `O_NOFOLLOW` hook in production, or `remote.fs` in pure tests.
fn safe_read_under(
  fs : station_jobs::FsPort,
  hooks : RigDispatchHooks,
  root : String,
  rel : String,
  offset : Int64,
  max_len : Int,
) -> Result[(Bytes, Int64), String] {
  match hooks.read_under_hook {
    Some(f) => f(root, rel, offset, max_len)
    None => {
      let target = match station_jobs::safe_transfer_path(fs, root, rel, false) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      let st = match (fs.lstat)(target) {
        Some(s) => {
          if s.is_symlink() || !s.is_file() {
            return Err("file path is not a regular file: " + rel)
          }
          s
        }
        None => return Err("file not found: " + rel)
      }
      if max_len <= 0 || offset >= st.size {
        return Ok((Bytes::new(0), st.size))
      }
      match (fs.read_range)(target, offset, max_len.to_int64()) {
        Some(b) => Ok((b, st.size))
        None => Err("failed to read file: " + rel)
      }
    }
  }
}

/// Safe write under `root`/`rel`: uses FD-level `O_NOFOLLOW` hook in production, or `remote.fs` in pure tests.
fn safe_write_under(
  fs : station_jobs::FsPort,
  hooks : RigDispatchHooks,
  root : String,
  rel : String,
  data : Bytes,
  offset : Int64,
  mode : Int,
  truncate : Bool,
) -> Result[Unit, String] {
  match hooks.write_under_hook {
    Some(f) => f(root, rel, data, offset, mode, truncate)
    None => {
      let target = match station_jobs::safe_transfer_path(fs, root, rel, true) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      let append = offset > 0L
      if append {
        match (fs.lstat)(target) {
          Some(st) => {
            if st.is_symlink() || !st.is_file() {
              return Err("file path is not a regular file")
            }
            if st.size != offset {
              return Err("offset mismatch: expected " + st.size.to_string())
            }
          }
          None => return Err("offset mismatch: file does not exist")
        }
      } else {
        match (fs.lstat)(target) {
          Some(st) => {
            if st.is_symlink() {
              return Err("file path contains a symbolic link")
            }
          }
          None => ()
        }
      }
      if !(fs.write_file_mode)(target, data, mode, append) {
        return Err("failed to write file: " + rel)
      }
      Ok(())
    }
  }
}

/// Recursively scan `mirror_dir` for regular files (skipping symlinks), returning sorted `[path, blobId, mode]` tuples.
fn scan_mirror_entries(
  fs : station_jobs::FsPort,
  mirror_dir : String,
  rel_prefix : String,
  out : Array[base_codec::Json],
) -> Unit {
  let cur_dir = if rel_prefix.length() == 0 {
    mirror_dir
  } else {
    nodepath::join(fs.sep, [mirror_dir, rel_prefix])
  }
  let names = match (fs.read_dir)(cur_dir) {
    Some(ns) => ns
    None => return
  }
  for i in 1..<names.length() {
    let cur = names[i]
    let mut j = i - 1
    while j >= 0 && names[j] > cur {
      names[j + 1] = names[j]
      j = j - 1
    }
    names[j + 1] = cur
  }
  for i in 0..<names.length() {
    let name = names[i]
    let child_rel = if rel_prefix.length() == 0 { name } else { rel_prefix + "/" + name }
    let full = nodepath::join(fs.sep, [cur_dir, name])
    match (fs.lstat)(full) {
      Some(st) => {
        if st.is_symlink() {
          continue
        }
        if st.is_dir() {
          scan_mirror_entries(fs, mirror_dir, child_rel, out)
        } else if st.is_file() {
          let bytes = match (fs.read_range)(full, 0L, st.size) {
            Some(b) => b
            None => Bytes::new(0)
          }
          let bid = station_jobs::dirsync_blob_id(bytes)
          out.push(base_codec::json_arr([
            base_codec::json_str(child_rel),
            base_codec::json_str(bid),
            base_codec::json_str(station_jobs::DIRSYNC_FILE_MODE),
          ]))
        }
      }
      None => ()
    }
  }
}

/// Extract the primary secret value and all non-empty string values from `secret.fields`.
fn extract_secret_fields(secret : base_codec::Json) -> (Option[String], Array[String]) {
  let values : Array[String] = []
  let fields = match base_codec::json_get(secret, "fields") {
    Some(base_codec::Json::Obj(fs)) => fs
    _ => return (None, values)
  }
  let mut primary : Option[String] = None
  let mut first_non_empty : Option[String] = None
  for i in 0..<fields.length() {
    let (k, v) = fields[i]
    match v {
      base_codec::Json::Str(s) => {
        if s.length() > 0 {
          values.push(s)
          if first_non_empty is None {
            first_non_empty = Some(s)
          }
          if k == "value" || k == "token" || k == "password" || k == "secret" || k == "key" {
            if primary is None {
              primary = Some(s)
            }
          }
        }
      }
      _ => ()
    }
  }
  match primary {
    Some(p) => (Some(p), values)
    None => (first_non_empty, values)
  }
}

/// Full incoming peer RPC dispatcher with binary tail & runtime hooks.
pub fn dispatch_rig_peer_rpc_ext(
  roster : station_mesh::CloudRoster,
  peer : String,
  env : station_mesh::PeerRequestEnvelope,
  binary_tail : Option[Bytes],
  v2_bytes : Bool,
  rig : station_rig::Rig,
  remote : station_jobs::RemoteManager,
  incoming : station_vault::IncomingRegistry,
  vault_grants : station_vault::GrantStore,
  load_json : () -> base_codec::Json,
  hooks : RigDispatchHooks,
  now_ms : Int64,
) -> Result[PeerDispatchReply, String] {
  let ws = match station_mesh::route_incoming_peer(roster, peer, env, false, false) {
    Ok(station_mesh::PeerRouteTarget::BusLocal(w)) => w
    Ok(station_mesh::PeerRouteTarget::LockSync(w)) => {
      match (hooks.on_lock_sync)(w, env.request) {
        Ok(res) => return Ok(reply_json(res))
        Err(e) => return Err(e)
      }
    }
    Ok(station_mesh::PeerRouteTarget::WaysSync(w)) => {
      match (hooks.on_ways_sync)(w, env.request) {
        Ok(res) => return Ok(reply_json(res))
        Err(e) => return Err(e)
      }
    }
    Ok(_) => return Err("a rig does not answer this route")
    Err(e) => return Err(e)
  }
  let form_req = station_rules_bridge::base_to_form(env.request)
  match rig.guard_request(ws, peer, form_req) {
    Ok(_) => ()
    Err(r) => return Err(r.message)
  }
  let method = json_str_field(env.request, "method")
  if method.starts_with("rig.") {
    // Clear any prior write error before mutating rig grants, then check immediately after.
    let _ = (hooks.take_grants_write_err)()
    match rig.heard(peer, form_req, ws) {
      Ok(res_form) => {
        match (hooks.take_grants_write_err)() {
          Some(werr) => {
            rig.grants.reload()
            return Err("failed to persist rig grants: " + werr)
          }
          None => return Ok(reply_json(station_rules_bridge::form_to_base(res_form)))
        }
      }
      Err(r) => return Err(r.message)
    }
  }
  if method == "describe" {
    let desc_form = rig.described(ws)
    let desc_base = station_rules_bridge::form_to_base(desc_form)
    let fields : Array[(String, base_codec::Json)] = match desc_base {
      base_codec::Json::Obj(fs) => fs
      _ => []
    }
    fields.push(("load", load_json()))
    fields.push(("runtime", base_codec::json_str("pion")))
    fields.push(("role", base_codec::json_str("rig")))
    return Ok(reply_json(base_codec::json_obj(fields)))
  }
  if method == "task.prepare" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    let spec = match base_codec::json_get(env.request, "spec") {
      Some(s) => s
      None => env.request
    }
    let sandbox_req = match json_opt_str_field(env.request, "sandbox") {
      Some(s) => Some(s)
      None => json_opt_str_field(spec, "sandbox")
    }
    match sandbox_req {
      Some(_) => return Err("sandboxes are not supported on this rig")
      None => ()
    }
    let name = json_str_field(spec, "name", fallback=key)
    let command = json_str_field(spec, "command")
    let mirror = match json_opt_str_field(spec, "dir") {
      Some(d) => Some(d)
      None => json_opt_str_field(spec, "mirror")
    }
    let back_paths = json_str_array_field(spec, "back")
    let screen = json_bool_field(spec, "screen")
    let small = json_bool_field(spec, "small")
    if small && screen {
      return Err("a small task cannot use the screen")
    }
    let req = station_jobs::RemotePrepareRequest::{
      key: key,
      workspace: ws,
      source_station: peer,
      source_session: session,
      name: name,
      command: command,
      mirror_name: mirror,
      back_paths: back_paths,
      screen: screen,
      small: small,
    }
    let spec_json = base_codec::json_stringify(spec)
    match remote.prepare_scoped(req, now_ms, spec_json=spec_json) {
      Ok(rec) => {
        let fields : Array[(String, base_codec::Json)] = [
          ("key", base_codec::json_str(rec.key)),
          ("prepared", base_codec::json_bool(true)),
        ]
        match rec.mirror_name {
          Some(m) => fields.push(("dir", base_codec::json_str(m)))
          None => ()
        }
        return Ok(reply_json(base_codec::json_obj(fields)))
      }
      Err(e) => return Err(e)
    }
  }
  if method == "task.start" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    match remote.get_scoped(ws, peer, session, key) {
      Some(rec) => {
        let push_raw = json_str_field(env.request, "push")
        if push_raw.length() > 0 && station_jobs::is_hex64(push_raw) {
          match remote.set_task_push_ref(rec, push_raw) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
      }
      None => return Err("unknown remote task: " + key)
    }
    let needs_sync = json_bool_field(env.request, "syncing", fallback=false)
    match remote.start_scoped(ws, peer, session, key, now_ms, needs_sync=needs_sync) {
      Ok(rec) => {
        let job_j = remote_task_job_json(remote, rec)
        let fields : Array[(String, base_codec::Json)] = [
          ("key", base_codec::json_str(rec.key)),
          ("job", job_j),
        ]
        if rec.push_ref is Some(_) {
          fields.push(("push", base_codec::json_bool(true)))
        }
        match rec.state {
          station_jobs::RemoteTaskState::Syncing => fields.push(("syncing", base_codec::json_bool(true)))
          _ => ()
        }
        return Ok(reply_json(base_codec::json_obj(fields)))
      }
      Err(e) => return Err(e)
    }
  }
  if method.starts_with("sync.") {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    let rec = match remote.get_scoped(ws, peer, session, key) {
      Some(t) => t
      None => return Err("unknown remote task: " + key)
    }
    let mname = match rec.mirror_name {
      Some(m) => m
      None => return Err("this task has no directory to sync")
    }
    let room_dir = nodepath::join(remote.fs.sep, [remote.root, "sessions", rec.room_id])
    let sync_dir = nodepath::join(remote.fs.sep, [room_dir, "sync", mname])
    let blobs_dir = nodepath::join(remote.fs.sep, [sync_dir, "blobs"])
    let state_path = nodepath::join(remote.fs.sep, [sync_dir, "state.json"])
    let actual_path = nodepath::join(remote.fs.sep, [sync_dir, "actual.json"])
    let base_path = nodepath::join(remote.fs.sep, [sync_dir, "base.json"])
    let plan_path = nodepath::join(remote.fs.sep, [sync_dir, "plan.jsonl"])
    let manifests_dir = nodepath::join(remote.fs.sep, [room_dir, "mirrors"])
    let manifest_path = nodepath::join(remote.fs.sep, [manifests_dir, mname + ".json"])
    let mirror_dir = remote.task_base_dir(rec)
    if method == "sync.begin" {
      if rec.job_id is Some(_) {
        return Ok(reply_json(base_codec::json_obj([
          ("key", base_codec::json_str(rec.key)),
          ("started", base_codec::json_bool(true)),
        ])))
      }
      let _ = (remote.fs.mkdir_p)(mirror_dir)
      let _ = (remote.fs.mkdir_p)(manifests_dir)
      let mut prev_version = 0
      let mut base_entries : Array[base_codec::Json] = []
      match (remote.fs.read_file)(manifest_path) {
        Some(mraw) => {
          match base_codec::json_parse(mraw) {
            base_codec::JsonParseResult::Ok(mj) => {
              prev_version = json_int_field(mj, "version", fallback=0)
              match base_codec::json_get(mj, "entries") {
                Some(base_codec::Json::Arr(es)) => base_entries = es
                _ => ()
              }
            }
            _ => ()
          }
        }
        None => ()
      }
      let actual_entries : Array[base_codec::Json] = []
      scan_mirror_entries(remote.fs, mirror_dir, "", actual_entries)
      let sid = station_jobs::remote_task_id(ws, peer, session, rec.key + ":" + now_ms.to_string())
      let _ = (remote.fs.remove_dir_all)(sync_dir)
      if !(remote.fs.mkdir_p)(blobs_dir) {
        return Err("failed to create sync staging directory")
      }
      let st_json = base_codec::json_stringify(base_codec::json_obj([
        ("id", base_codec::json_str(sid)),
        ("key", base_codec::json_str(rec.key)),
        ("version", base_codec::json_int(prev_version)),
      ]))
      if !(remote.fs.write_file_mode)(state_path, st_json.to_bytes(), 384, false) {
        return Err("failed to write sync state.json")
      }
      let _ = (remote.fs.write_file_mode)(actual_path, base_codec::json_stringify(base_codec::json_arr(actual_entries)).to_bytes(), 384, false)
      let _ = (remote.fs.write_file_mode)(base_path, base_codec::json_stringify(base_codec::json_arr(base_entries)).to_bytes(), 384, false)
      let _ = (remote.fs.write_file_mode)(plan_path, Bytes::new(0), 384, false)
      return Ok(reply_json(base_codec::json_obj([
        ("key", base_codec::json_str(rec.key)),
        ("id", base_codec::json_str(sid)),
        ("dir", base_codec::json_str(mname)),
        ("version", base_codec::json_int(prev_version)),
        ("safe", base_codec::json_int(1)),
      ])))
    }
    // Validate active sync session state (`id` and `key`) for manifest/base/put/commit.
    let req_sid = json_str_field(env.request, "id")
    let st_obj = match (remote.fs.read_file)(state_path) {
      Some(sraw) => {
        match base_codec::json_parse(sraw) {
          base_codec::JsonParseResult::Ok(j) => j
          _ => return Err("corrupt sync state")
        }
      }
      None => return Err("no active sync session for this mirror")
    }
    let active_sid = json_str_field(st_obj, "id")
    let active_key = json_str_field(st_obj, "key")
    let prev_ver = json_int_field(st_obj, "version", fallback=0)
    if req_sid.length() == 0 || req_sid != active_sid || active_key != rec.key {
      return Err("sync session mismatch or superseded")
    }
    if method == "sync.manifest" || method == "sync.base" {
      let src_path = if method == "sync.manifest" { actual_path } else { base_path }
      let all_entries : Array[base_codec::Json] = match (remote.fs.read_file)(src_path) {
        Some(raw) => {
          match base_codec::json_parse(raw) {
            base_codec::JsonParseResult::Ok(base_codec::Json::Arr(arr)) => arr
            _ => []
          }
        }
        None => []
      }
      let after = json_int_field(env.request, "after", fallback=json_int_field(env.request, "cursor", fallback=0))
      let start = if after < 0 { 0 } else if after > all_entries.length() { all_entries.length() } else { after }
      let page_lim = 500
      let end = if start + page_lim < all_entries.length() { start + page_lim } else { all_entries.length() }
      let page : Array[base_codec::Json] = []
      for i in start..<end {
        page.push(all_entries[i])
      }
      let next_j = if end < all_entries.length() { base_codec::json_int(end) } else { base_codec::json_null() }
      return Ok(reply_json(base_codec::json_obj([
        ("entries", base_codec::json_arr(page)),
        ("next", next_j),
      ])))
    }
    if method == "sync.put" {
      let pieces_arr = match base_codec::json_get(env.request, "pieces") {
        Some(base_codec::Json::Arr(a)) => a
        _ => match base_codec::json_get(env.request, "blobs") {
          Some(base_codec::Json::Arr(a)) => a
          _ => return Err("pieces array is required")
        }
      }
      let raw_data : Bytes = match binary_tail {
        Some(b) => b
        None => {
          let b64 = json_str_field(env.request, "data")
          match base64::decode(b64) {
            Ok(dec) => dec
            Err(_) => return Err("invalid base64 sync.put data")
          }
        }
      }
      let mut at = 0
      let mut total_expected = 0
      for i in 0..<pieces_arr.length() {
        match pieces_arr[i] {
          base_codec::Json::Arr(tuple) => {
            if tuple.length() < 4 {
              return Err("invalid piece tuple")
            }
            let plen = match tuple[3] {
              base_codec::Json::Num(d, _) => d.to_int()
              _ => return Err("invalid piece length")
            }
            if plen < 0 {
              return Err("invalid negative piece length")
            }
            total_expected = total_expected + plen
          }
          _ => return Err("invalid piece entry")
        }
      }
      if raw_data.length() != total_expected {
        return Err("pieces do not match their data")
      }
      let _ = (remote.fs.mkdir_p)(blobs_dir)
      for i in 0..<pieces_arr.length() {
        match pieces_arr[i] {
          base_codec::Json::Arr(tuple) => {
            let hash = match tuple[0] {
              base_codec::Json::Str(s) => s
              _ => return Err("invalid blob hash")
            }
            if !is_hex40(hash) {
              return Err("invalid blob hash: " + hash)
            }
            let size = match tuple[1] {
              base_codec::Json::Num(d, _) => d.to_int64()
              _ => return Err("invalid blob size")
            }
            let offset = match tuple[2] {
              base_codec::Json::Num(d, _) => d.to_int64()
              _ => return Err("invalid blob offset")
            }
            let plen = match tuple[3] {
              base_codec::Json::Num(d, _) => d.to_int()
              _ => return Err("invalid blob length")
            }
            let piece = slice_bytes_helper(raw_data, at, at + plen)
            at = at + plen
            let done_path = nodepath::join(remote.fs.sep, [blobs_dir, hash])
            if (remote.fs.lstat)(done_path) is Some(_) {
              continue
            }
            let part_rel = hash + ".part"
            let part_path = nodepath::join(remote.fs.sep, [blobs_dir, part_rel])
            let has = match (remote.fs.lstat)(part_path) {
              Some(st) => st.size
              None => 0L
            }
            let end_off = offset + plen.to_int64()
            if end_off <= has && !(offset == 0L && has == 0L) {
              continue
            }
            if offset != has {
              return Err("a content's pieces came out of order")
            }
            match safe_write_under(remote.fs, hooks, blobs_dir, part_rel, piece, offset, 384, false) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if end_off == size {
              let full_bytes = match (remote.fs.read_range)(part_path, 0L, size) {
                Some(fb) => fb
                None => {
                  let _ = (remote.fs.remove_file)(part_path)
                  return Err("cannot verify staged blob on the target")
                }
              }
              if station_jobs::dirsync_blob_id(full_bytes) != hash {
                let _ = (remote.fs.remove_file)(part_path)
                return Err("a content sent does not match its id")
              }
              if !(remote.fs.rename)(part_path, done_path) {
                let _ = (remote.fs.remove_file)(part_path)
                return Err("failed to finalize staged blob")
              }
            }
          }
          _ => return Err("invalid piece entry")
        }
      }
      return Ok(reply_json(base_codec::json_obj([("pieces", base_codec::json_int(pieces_arr.length()))])))
    }
    if method == "sync.commit" {
      let set_arr = match base_codec::json_get(env.request, "set") {
        Some(base_codec::Json::Arr(a)) => a
        _ => []
      }
      let rem_arr = match base_codec::json_get(env.request, "remove") {
        Some(base_codec::Json::Arr(a)) => a
        _ => []
      }
      let part_line = base_codec::json_stringify(base_codec::json_obj([
        ("set", base_codec::json_arr(set_arr)),
        ("remove", base_codec::json_arr(rem_arr)),
      ])) + "\n"
      if !(remote.fs.write_file_mode)(plan_path, part_line.to_bytes(), 384, true) {
        return Err("failed to append sync plan")
      }
      let is_final = json_bool_field(env.request, "final", fallback=true)
      if !is_final {
        return Ok(reply_json(base_codec::json_obj([
          ("key", base_codec::json_str(rec.key)),
          ("planned", base_codec::json_bool(true)),
        ])))
      }
      let plan_raw = match (remote.fs.read_file)(plan_path) {
        Some(s) => s
        None => ""
      }
      let plan_lines = plan_raw.split("\n")
      let mut written = 0
      let mut removed = 0
      for li in 0..<plan_lines.length() {
        let ln = plan_lines[li]
        if ln.length() == 0 {
          continue
        }
        let pj = match base_codec::json_parse(ln) {
          base_codec::JsonParseResult::Ok(j) => j
          _ => return Err("corrupt sync plan")
        }
        match base_codec::json_get(pj, "remove") {
          Some(base_codec::Json::Arr(rems)) => {
            for ri in 0..<rems.length() {
              match rems[ri] {
                base_codec::Json::Str(rel) => {
                  let abs = match station_jobs::safe_transfer_path(remote.fs, mirror_dir, rel, false) {
                    Ok(p) => p
                    Err(e) => return Err(e)
                  }
                  if (remote.fs.lstat)(abs) is Some(_) {
                    if (remote.fs.remove_file)(abs) {
                      removed = removed + 1
                    }
                  }
                }
                _ => ()
              }
            }
          }
          _ => ()
        }
        match base_codec::json_get(pj, "set") {
          Some(base_codec::Json::Arr(sets)) => {
            for si in 0..<sets.length() {
              match sets[si] {
                base_codec::Json::Arr(tuple) => {
                  if tuple.length() < 3 {
                    return Err("invalid set tuple")
                  }
                  let rel = match tuple[0] {
                    base_codec::Json::Str(s) => s
                    _ => return Err("invalid set path")
                  }
                  let hash = match tuple[1] {
                    base_codec::Json::Str(s) => s
                    _ => return Err("invalid set hash")
                  }
                  let mode_s = match tuple[2] {
                    base_codec::Json::Str(s) => s
                    _ => station_jobs::DIRSYNC_FILE_MODE
                  }
                  if !is_hex40(hash) {
                    return Err("invalid blob hash in plan")
                  }
                  let blob_path = nodepath::join(remote.fs.sep, [blobs_dir, hash])
                  let bst = match (remote.fs.lstat)(blob_path) {
                    Some(st) => st
                    None => return Err("the content of " + rel + " was not sent")
                  }
                  let content = match (remote.fs.read_range)(blob_path, 0L, bst.size) {
                    Some(b) => b
                    None => return Err("failed to read staged blob for " + rel)
                  }
                  if station_jobs::dirsync_blob_id(content) != hash {
                    return Err("staged blob hash mismatch for " + rel)
                  }
                  let fmode = if mode_s == station_jobs::DIRSYNC_EXEC_MODE { 493 } else { 420 }
                  match safe_write_under(remote.fs, hooks, mirror_dir, rel, content, 0L, fmode, true) {
                    Ok(_) => written = written + 1
                    Err(e) => return Err(e)
                  }
                }
                _ => return Err("invalid set entry")
              }
            }
          }
          _ => ()
        }
      }
      let new_entries : Array[base_codec::Json] = []
      scan_mirror_entries(remote.fs, mirror_dir, "", new_entries)
      let new_ver = prev_ver + 1
      let m_json = base_codec::json_stringify(base_codec::json_obj([
        ("version", base_codec::json_int(new_ver)),
        ("entries", base_codec::json_arr(new_entries)),
      ]))
      let m_tmp = manifest_path + ".tmp"
      if !(remote.fs.write_file_mode)(m_tmp, m_json.to_bytes(), 384, false) || !(remote.fs.rename)(m_tmp, manifest_path) {
        return Err("failed to persist mirror manifest")
      }
      match remote.mark_task_synced(rec) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let _ = (remote.fs.remove_dir_all)(sync_dir)
      return Ok(reply_json(base_codec::json_obj([
        ("key", base_codec::json_str(rec.key)),
        ("synced", base_codec::json_bool(true)),
        ("written", base_codec::json_int(written)),
        ("removed", base_codec::json_int(removed)),
        ("version", base_codec::json_int(new_ver)),
      ])))
    }
    return Err("unsupported sync method: " + method)
  }
  if method == "task.get" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    match remote.get_scoped(ws, peer, session, key) {
      Some(rec) => {
        let log_json = match remote.log_scoped(ws, peer, session, key, lines=station_jobs::JOB_LOG_LINES_DEFAULT) {
          Ok(txt) => base_codec::json_str(txt)
          Err(_) => base_codec::json_null()
        }
        let fields : Array[(String, base_codec::Json)] = [
          ("key", base_codec::json_str(rec.key)),
          ("job", remote_task_job_json(remote, rec)),
          ("log", log_json),
          ("notices", task_notices_json(remote, rec)),
        ]
        if rec.push_ref is Some(_) {
          fields.push(("push", base_codec::json_bool(true)))
        }
        return Ok(reply_json(base_codec::json_obj(fields)))
      }
      None => return Err("unknown remote task: " + key)
    }
  }
  if method == "task.gets" || method == "task.batch" {
    let items : Array[base_codec::Json] = []
    match base_codec::json_get(env.request, "tasks") {
      Some(base_codec::Json::Arr(arr)) => {
        let lim = if arr.length() > 64 { 64 } else { arr.length() }
        for i in 0..<lim {
          let item = arr[i]
          let sess = json_str_field(item, "session")
          let key = json_str_field(item, "key")
          if sess.length() == 0 || key.length() == 0 {
            items.push(base_codec::json_obj([
              ("session", base_codec::json_str(sess)),
              ("key", base_codec::json_str(key)),
              ("error", base_codec::json_str("session and key are required")),
            ]))
            continue
          }
          match remote.get_scoped(ws, peer, sess, key) {
            Some(rec) => {
              let log_json = match remote.log_scoped(ws, peer, sess, key, lines=station_jobs::JOB_LOG_LINES_DEFAULT) {
                Ok(txt) => base_codec::json_str(txt)
                Err(_) => base_codec::json_null()
              }
              items.push(base_codec::json_obj([
                ("session", base_codec::json_str(sess)),
                ("key", base_codec::json_str(key)),
                (
                  "result",
                  base_codec::json_obj([
                    ("key", base_codec::json_str(rec.key)),
                    ("job", remote_task_job_json(remote, rec)),
                    ("log", log_json),
                    ("notices", task_notices_json(remote, rec)),
                  ]),
                ),
              ]))
            }
            None => {
              items.push(base_codec::json_obj([
                ("session", base_codec::json_str(sess)),
                ("key", base_codec::json_str(key)),
                ("error", base_codec::json_str("unknown remote task: " + key)),
              ]))
            }
          }
        }
        return Ok(reply_json(base_codec::json_obj([("tasks", base_codec::json_arr(items))])))
      }
      _ => {
        // Legacy fallback: require top-level `session` + `keys` array (never unscoped).
        let sess = match require_session(env.request) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        let keys = json_str_array_field(env.request, "keys")
        let lim = if keys.length() > 64 { 64 } else { keys.length() }
        for i in 0..<lim {
          match remote.get_scoped(ws, peer, sess, keys[i]) {
            Some(rec) => {
              items.push(base_codec::json_obj([
                ("session", base_codec::json_str(sess)),
                ("key", base_codec::json_str(rec.key)),
                ("job", remote_task_job_json(remote, rec)),
              ]))
            }
            None => ()
          }
        }
        return Ok(reply_json(base_codec::json_obj([("tasks", base_codec::json_arr(items))])))
      }
    }
  }
  if method == "task.log" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    let lines = json_int_field(env.request, "lines", fallback=station_jobs::JOB_LOG_LINES_DEFAULT)
    match remote.get_scoped(ws, peer, session, key) {
      Some(rec) => {
        match remote.log_scoped(ws, peer, session, key, lines=lines) {
          Ok(txt) => {
            return Ok(reply_json(base_codec::json_obj([
              ("key", base_codec::json_str(rec.key)),
              ("job", remote_task_job_json(remote, rec)),
              ("log", base_codec::json_str(txt)),
              ("notices", task_notices_json(remote, rec)),
            ])))
          }
          Err(e) => return Err(e)
        }
      }
      None => return Err("unknown remote task: " + key)
    }
  }
  if method == "task.list" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let recs = remote.list_scoped(ws, peer, session)
    let items : Array[base_codec::Json] = []
    for i in 0..<recs.length() {
      let r = recs[i]
      items.push(base_codec::json_obj([
        ("key", base_codec::json_str(r.key)),
        ("spec", remote_task_spec_json(r)),
        ("job", remote_task_job_json(remote, r)),
      ]))
    }
    return Ok(reply_json(base_codec::json_obj([("tasks", base_codec::json_arr(items))])))
  }
  if method == "task.stop" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    match remote.stop_scoped(ws, peer, session, key, now_ms) {
      Ok(rec) => {
        return Ok(reply_json(base_codec::json_obj([
          ("key", base_codec::json_str(rec.key)),
          ("job", remote_task_job_json(remote, rec)),
        ])))
      }
      Err(e) => return Err(e)
    }
  }
  if method == "task.release" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    match remote.release_scoped(ws, peer, session, key) {
      Ok(rec) => {
        return Ok(reply_json(base_codec::json_obj([
          ("key", base_codec::json_str(rec.key)),
          ("released", base_codec::json_bool(true)),
          ("job", remote_task_job_json(remote, rec)),
        ])))
      }
      Err(e) => return Err(e)
    }
  }
  if method == "task.files" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    let rec = match remote.get_scoped(ws, peer, session, key) {
      Some(t) => t
      None => return Err("unknown remote task: " + key)
    }
    match rec.state {
      station_jobs::RemoteTaskState::Running => {
        return Err("wait for the task to finish before downloading artifacts")
      }
      station_jobs::RemoteTaskState::Stopping => {
        return Err("wait for the task to finish before downloading artifacts")
      }
      _ => ()
    }
    let req_paths = json_str_array_field(env.request, "paths")
    let paths = if req_paths.length() > 0 { req_paths } else { rec.back_paths }
    if paths.length() > 100 {
      return Err("paths are required (at most 100)")
    }
    let base_dir = remote.task_base_dir(rec)
    let visited : Array[(String, Option[Int64])] = []
    for i in 0..<paths.length() {
      match station_jobs::visit_files_recursive(remote.fs, base_dir, paths[i], visited) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    let files_arr : Array[base_codec::Json] = []
    for i in 0..<visited.length() {
      let (rel, sz_opt) = visited[i]
      let sz = match sz_opt {
        Some(n) => base_codec::json_int64(n)
        None => base_codec::json_null()
      }
      files_arr.push(base_codec::json_arr([base_codec::json_str(rel), sz]))
    }
    let base_j = match rec.mirror_name {
      Some(m) => base_codec::json_str(m)
      None => base_codec::json_str("")
    }
    return Ok(reply_json(base_codec::json_obj([
      ("key", base_codec::json_str(rec.key)),
      ("base", base_j),
      ("files", base_codec::json_arr(files_arr)),
    ])))
  }
  if method == "task.collected" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    let rec = match remote.get_scoped(ws, peer, session, key) {
      Some(t) => t
      None => return Err("unknown remote task: " + key)
    }
    match rec.state {
      station_jobs::RemoteTaskState::Running => return Err("the task has not finished")
      station_jobs::RemoteTaskState::Stopping => return Err("the task has not finished")
      _ => ()
    }
    match remote.mark_task_collected(rec) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let _ = remote.release_scoped(ws, peer, session, key)
    return Ok(reply_json(base_codec::json_obj([
      ("key", base_codec::json_str(rec.key)),
      ("collected", base_codec::json_bool(true)),
    ])))
  }
  if method == "task.mirrors" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let ms = remote.mirrors_scoped(ws, peer, session)
    let items : Array[base_codec::Json] = []
    for i in 0..<ms.length() {
      let m = ms[i]
      items.push(base_codec::json_obj([
        ("name", base_codec::json_str(m.name)),
        ("state", base_codec::json_str(station_jobs::mirror_state_str(m.state))),
        ("bytes", base_codec::json_int64(m.bytes)),
        ("lastUsedAt", base_codec::json_int64(m.last_used_at)),
      ]))
    }
    return Ok(reply_json(base_codec::json_obj([("mirrors", base_codec::json_arr(items))])))
  }
  if method == "task.clean" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let mirror = json_str_field(env.request, "mirror")
    if mirror.length() == 0 {
      return Err("mirror name is required")
    }
    match remote.clean_mirror_scoped(ws, peer, session, mirror) {
      Ok(removed) => return Ok(reply_json(base_codec::json_obj([("removed", base_codec::json_bool(removed))])))
      Err(e) => return Err(e)
    }
  }
  if method == "file.put" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let key = match require_key(env.request) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    let rec = match remote.get_scoped(ws, peer, session, key) {
      Some(t) => {
        if t.job_id is Some(_) {
          return Err("inputs are immutable after a task starts")
        }
        t
      }
      None => return Err("unknown remote task: " + key)
    }
    let rel = json_str_field(env.request, "path")
    let work = remote.session_work_dir(ws, peer, session, now_ms)
    let data_bytes : Bytes = match binary_tail {
      Some(b) => b
      None => {
        let b64 = json_str_field(env.request, "data")
        match base64::decode(b64) {
          Ok(dec) => dec
          Err(_) => return Err("invalid base64 file data")
        }
      }
    }
    let offset = json_int64_field(env.request, "offset", fallback=0L)
    if offset < 0L {
      return Err("invalid negative offset")
    }
    let is_final = json_bool_field(env.request, "final", fallback=false)
    match remote.record_task_upload(rec, rel, false) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match safe_write_under(remote.fs, hooks, work, rel, data_bytes, offset, 384, is_final && offset == 0L) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if is_final {
      match remote.record_task_upload(rec, rel, true) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    return Ok(reply_json(base_codec::json_obj([("bytes", base_codec::json_int(data_bytes.length()))])))
  }
  if method == "file.get" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let rel = json_str_field(env.request, "path")
    let base_dir = match json_opt_str_field(env.request, "key") {
      Some(k) => {
        match remote.get_scoped(ws, peer, session, k) {
          Some(rec) => {
            match rec.state {
              station_jobs::RemoteTaskState::Running => {
                return Err("wait for the task to finish before downloading artifacts")
              }
              station_jobs::RemoteTaskState::Stopping => {
                return Err("wait for the task to finish before downloading artifacts")
              }
              _ => remote.task_base_dir(rec)
            }
          }
          None => return Err("unknown remote task: " + k)
        }
      }
      None => remote.session_work_dir(ws, peer, session, now_ms)
    }
    let offset = json_int64_field(env.request, "offset", fallback=0L)
    if offset < 0L {
      return Err("invalid negative offset")
    }
    let whole = json_bool_field(env.request, "whole", fallback=false)
    if whole && v2_bytes {
      let (_, total_size) = match safe_read_under(remote.fs, hooks, base_dir, rel, offset, 0) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let rem = if offset >= total_size { 0L } else { total_size - offset }
      return Ok(PeerDispatchReply::{
        json: base_codec::json_obj([
          ("bytes", base_codec::json_int64(rem)),
          ("size", base_codec::json_int64(total_size)),
          ("eof", base_codec::json_bool(true)),
        ]),
        binary: None,
        stream_file: Some(StreamFilePlan::{
          root: base_dir,
          rel: rel,
          offset: offset,
          size: total_size,
        }),
      })
    }
    let want_len = json_int_field(env.request, "length", fallback=station_jobs::REMOTE_CHUNK)
    let max_len = if want_len <= 0 || want_len > station_jobs::REMOTE_CHUNK {
      station_jobs::REMOTE_CHUNK
    } else {
      want_len
    }
    let (chunk, total_size) = match safe_read_under(remote.fs, hooks, base_dir, rel, offset, max_len) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let eof = offset + chunk.length().to_int64() >= total_size
    if v2_bytes {
      return Ok(PeerDispatchReply::{
        json: base_codec::json_obj([
          ("bytes", base_codec::json_int(chunk.length())),
          ("size", base_codec::json_int64(total_size)),
          ("eof", base_codec::json_bool(eof)),
        ]),
        binary: Some(chunk),
        stream_file: None,
      })
    } else {
      return Ok(reply_json(base_codec::json_obj([
        ("bytes", base_codec::json_int(chunk.length())),
        ("size", base_codec::json_int64(total_size)),
        ("eof", base_codec::json_bool(eof)),
        ("data", base_codec::json_str(base64::encode(chunk))),
      ])))
    }
  }
  if method == "vault.capabilities" {
    return Ok(reply_json(base_codec::json_obj([
      ("timeouts", base_codec::json_bool(true)),
      ("env", base_codec::json_bool(true)),
      ("proxy", base_codec::json_bool(false)),
      ("ssh", base_codec::json_bool(false)),
      ("scrub", base_codec::json_bool(true)),
    ])))
  }
  if method == "vault.revoke" {
    let id = json_str_field(env.request, "id")
    let _ = vault_grants.revoke(id)
    (hooks.on_vault_revoke)(peer, id)
    match incoming.revoke_from_peer(peer, id) {
      Ok(_) => return Ok(reply_json(base_codec::json_obj([("ok", base_codec::json_bool(true))])))
      Err(e) => return Err(e)
    }
  }
  if method == "vault.run" || method == "vault.capture" {
    let id = json_str_field(env.request, "id")
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let command = json_str_field(env.request, "command")
    let under = json_str_field(env.request, "under")
    if id.length() == 0 || command.length() == 0 {
      return Err("id, session and command are required")
    }
    if !is_safe_under(under) {
      return Err("under is a path inside the session's directory")
    }
    let work = remote.session_work_dir(ws, peer, session, now_ms)
    let cwd = if under.length() == 0 {
      work
    } else {
      match station_jobs::safe_transfer_path(remote.fs, work, under, true) {
        Ok(p) => {
          let _ = (remote.fs.mkdir_p)(p)
          p
        }
        Err(e) => return Err(e)
      }
    }
    let raw_to = json_int64_field(
      env.request,
      "timeoutMs",
      fallback=if method == "vault.capture" { station_vault::CAPTURE_MS } else { station_vault::RUN_MS },
    )
    let max_to = if method == "vault.capture" { station_vault::CAPTURE_MS } else { station_vault::MAX_RUN_MS }
    let timeout_ms = if raw_to < 1L { 1L } else if raw_to > max_to { max_to } else { raw_to }
    if method == "vault.capture" {
      let exec_req = VaultExecRequest::{
        id: id,
        workspace: ws,
        peer: peer,
        session: session,
        command: command,
        cwd: cwd,
        env_pairs: [],
        secret_values: [],
        timeout_ms: timeout_ms,
        idle_timeout_sec: 0L,
        capture: true,
      }
      match (hooks.on_vault_exec)(exec_req) {
        Ok(_) => return Ok(reply_json(base_codec::json_obj([("started", base_codec::json_bool(true))])))
        Err(e) => return Err(e)
      }
    }
    let mode = json_str_field(env.request, "mode")
    if mode != "env" {
      return Err("delivery mode " + mode + " is not supported on this rig")
    }
    let grant_id = json_str_field(env.request, "grant")
    let secret = match base_codec::json_get(env.request, "secret") {
      Some(s) => s
      None => return Err("mode, grant and secret are required")
    }
    if grant_id.length() == 0 {
      return Err("mode, grant and secret are required")
    }
    let (primary_opt, secret_values) = extract_secret_fields(secret)
    let secret_val = match primary_opt {
      Some(v) => v
      None => return Err("the secret holds no value")
    }
    let env_name = match json_opt_str_field(env.request, "env") {
      Some(en) => {
        if !is_valid_env_name(en) {
          return Err("invalid env variable name: " + en)
        }
        en
      }
      None => "STILLFAIL_SECRET"
    }
    let now_sec = now_ms / 1000L
    let req_expires = json_int64_field(env.request, "expires", fallback=0L)
    let max_grant_sec = 30L * 86400L
    let req_grant_timeout = match base_codec::json_get(env.request, "grantTimeout") {
      Some(base_codec::Json::Obj(_)) => {
        let kind = json_str_field(
          match base_codec::json_get(env.request, "grantTimeout") { Some(o) => o; None => base_codec::json_null() },
          "kind",
        )
        let secs = json_int64_field(
          match base_codec::json_get(env.request, "grantTimeout") { Some(o) => o; None => base_codec::json_null() },
          "seconds",
          fallback=0L,
        )
        if kind != "idle" || secs <= 0L || secs > max_grant_sec {
          return Err("invalid grantTimeout: expected { kind: \"idle\", seconds: 1..2592000 }")
        }
        secs
      }
      Some(base_codec::Json::Num(d, _)) => {
        let secs = d.to_int64()
        if secs <= 0L || secs > max_grant_sec {
          return Err("invalid grantTimeout seconds")
        }
        secs
      }
      _ => 0L
    }
    if req_expires > 0L && now_sec >= req_expires {
      return Err("vault grant has expired")
    }
    let exp_sec = if req_expires > 0L {
      req_expires
    } else if req_grant_timeout > 0L {
      now_sec + req_grant_timeout
    } else {
      now_sec + (timeout_ms / 1000L) + 60L
    }
    let max_by_grant_ms = (exp_sec - now_sec) * 1000L
    let eff_timeout_ms = if max_by_grant_ms > 0L && max_by_grant_ms < timeout_ms {
      max_by_grant_ms
    } else {
      timeout_ms
    }
    match incoming.start_run(id, peer, session, command, under, grant_id, exp_sec, req_grant_timeout) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let exec_req = VaultExecRequest::{
      id: id,
      workspace: ws,
      peer: peer,
      session: session,
      command: command,
      cwd: cwd,
      env_pairs: [(env_name, secret_val)],
      secret_values: secret_values,
      timeout_ms: eff_timeout_ms,
      idle_timeout_sec: req_grant_timeout,
      capture: false,
    }
    match (hooks.on_vault_exec)(exec_req) {
      Ok(_) => return Ok(reply_json(base_codec::json_obj([("started", base_codec::json_bool(true))])))
      Err(e) => {
        let _ = incoming.finish_run(id)
        return Err(e)
      }
    }
  }
  if method == "session.close" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let _ = remote.close_session_room(ws, peer, session, now_ms)
    return Ok(reply_json(base_codec::json_obj([("closed", base_codec::json_bool(true))])))
  }
  if method == "session.size" {
    let session = match require_session(env.request) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let (present, bytes) = remote.session_work_size(ws, peer, session)
    if present {
      return Ok(reply_json(base_codec::json_obj([
        ("present", base_codec::json_bool(true)),
        ("bytes", base_codec::json_int64(bytes)),
      ])))
    } else {
      return Ok(reply_json(base_codec::json_obj([("present", base_codec::json_bool(false))])))
    }
  }
  Err("unknown method " + method)
}

/// Convenience wrapper for pure unit tests without binary tail or custom hooks.
pub fn dispatch_rig_peer_rpc(
  roster : station_mesh::CloudRoster,
  peer : String,
  env : station_mesh::PeerRequestEnvelope,
  rig : station_rig::Rig,
  remote : station_jobs::RemoteManager,
  incoming : station_vault::IncomingRegistry,
  vault_grants : station_vault::GrantStore,
  load_json : () -> base_codec::Json,
  now_ms : Int64,
) -> Result[base_codec::Json, String] {
  match dispatch_rig_peer_rpc_ext(
    roster,
    peer,
    env,
    None,
    false,
    rig,
    remote,
    incoming,
    vault_grants,
    load_json,
    default_rig_dispatch_hooks(),
    now_ms,
  ) {
    Ok(rep) => Ok(rep.json)
    Err(e) => Err(e)
  }
}

/// Filter the station's OS environment for `vault.run` / `vault.capture`, stripping
/// `STILLFAIL_*`, `ANTHROPIC_*`, `CLAUDE_*`, `OPENAI_*`, `CODEX_*` (matching `incoming.ts::baseEnv`).
pub fn vault_base_env() -> Array[String] {
  let out : Array[String] = []
  let entries = station_sys::env_all()
  for i in 0..<entries.length() {
    let e = entries[i]
    if e.starts_with("STILLFAIL_")
    || e.starts_with("ANTHROPIC_")
    || e.starts_with("CLAUDE_")
    || e.starts_with("OPENAI_")
    || e.starts_with("CODEX_")
    {
      continue
    }
    out.push(e)
  }
  out
}

/// Generate a cryptographically random hex boot ID using OS CSPRNG (`station_sys::random_hex`).
pub fn generate_boot_id() -> Result[String, String] {
  station_sys::random_hex(8)
}

/// Build a production `station_rig::LogBackend` writing atomically/append with `0600` permissions.
pub fn sys_command_log_backend(fs : station_jobs::FsPort) -> station_rig::LogBackend {
  station_rig::LogBackend::{
    ensure_dir: fn(path : String) -> Bool {
      let dir = nodepath::dirname(fs.sep, path)
      (fs.mkdir_p)(dir)
    },
    stat_size: fn(path : String) -> Int64 {
      match (fs.lstat)(path) {
        Some(st) => st.size
        None => 0L
      }
    },
    rename: fn(from : String, to : String) -> Bool { (fs.rename)(from, to) },
    append: fn(path : String, data : Bytes) -> Bool {
      (fs.write_file_mode)(path, data, 384, true)
    },
    read_tail: fn(path : String, max_bytes : Int64) -> Option[(Bytes, Int64)] {
      match (fs.lstat)(path) {
        None => None
        Some(st) => {
          let start = if st.size > max_bytes { st.size - max_bytes } else { 0L }
          let len = (st.size - start).to_int()
          match (fs.read_range)(path, start, len) {
            Some(b) => Some((b, start))
            None => None
          }
        }
      }
    },
  }
}
