// Wave 17E-2A (R2): Production daemon wiring for `DomainHandlers.remote` + `DomainHandlers.system`
// and non-blocking async deferred `/mcp` HTTP state machine (zero `host_shim::wait`).
//
// All `/mcp` requests pass through `McpServer::handle` FIRST (origin, Bearer auth, JSON-RPC id,
// `station_tool` unwrapping, `bump_heard`, `UNBOUND_REFUSAL`). Cross-station RPC intents are
// captured into `DeferredMcpCapture`, queued as `HandlerAction::Defer`, and launched by
// `flush_deferred_mcp_starts` strictly AFTER `HttpServer` has entered `ConnMode::Deferred`.

import "base64"
import "base_codec"
import "host_shim"
import "station_cloud"
import "station_devices"
import "station_http"
import "station_jobs"
import "station_mesh"
import "station_replica"
import "station_sys"
import "station_tools"
import "station_whole"

fn dm_bytes_to_hex(b : Bytes) -> String {
  let hex = "0123456789abcdef".to_bytes()
  let out = Bytes::new(b.length() * 2)
  for i in 0..<b.length() {
    let v = b[i].to_int() & 0xFF
    out[i * 2] = hex[(v >> 4) & 0xF]
    out[i * 2 + 1] = hex[v & 0xF]
  }
  out.to_string()
}

fn dm_json_str(j : base_codec::Json, key : String) -> String {
  match base_codec::json_get(j, key) {
    Some(base_codec::Json::Str(s)) => s.trim()
    _ => ""
  }
}

fn dm_json_int(j : base_codec::Json, key : String) -> Option[Int] {
  match base_codec::json_get(j, key) {
    Some(base_codec::Json::Num(d, _)) => Some(d.to_int())
    _ => None
  }
}

fn dm_json_i64(j : base_codec::Json, key : String) -> Option[Int64] {
  match base_codec::json_get(j, key) {
    Some(base_codec::Json::Num(d, _)) => Some(d.to_int64())
    _ => None
  }
}

fn dm_json_num(j : base_codec::Json, key : String) -> Option[Double] {
  match base_codec::json_get(j, key) {
    Some(base_codec::Json::Num(d, _)) => Some(d)
    _ => None
  }
}

/// Extract JSON-RPC `"id"` from a raw HTTP `/mcp` body; returns `None` for notifications (no `"id"`).
pub fn extract_mcp_rpc_id(req_body : String) -> Option[base_codec::Json] {
  match base_codec::json_parse(req_body) {
    base_codec::JsonParseResult::Ok(j) => {
      match base_codec::json_get(j, "id") {
        Some(base_codec::Json::Null) | None => None
        Some(id_v) => Some(id_v)
      }
    }
    _ => None
  }
}

/// Build the wire peer RPC payload for a cross-station `station_task` action (1:1 with
/// `remote_source.pion:1446-1560`, `remote_target.mbt:141-153`, `rig_module.pion:504-526`):
/// - `start`: `method: "task.start"` with `spec: { name, command, requestedBy, screen, small }`
/// - `release`: `method: "task.collected"` (NEVER `"task.release"`)
/// - `get`/`log`/`stop`/`list`/`mirrors`/`clean`: `method: "task." + action`
pub fn build_remote_task_rpc_payload(intent : station_whole::DeferredMcpIntent) -> base_codec::Json {
  if intent.action == "release" {
    return base_codec::json_obj([
      ("method", base_codec::json_str("task.collected")),
      ("workspace", base_codec::json_str(intent.caller_ws)),
      ("session", base_codec::json_str(intent.session)),
      ("key", base_codec::json_str(intent.task_key)),
    ])
  }
  if intent.action == "start" {
    let spec_obj = match intent.prepared_spec {
      Some(sp) => {
        let sfields : Array[(String, base_codec::Json)] = [
          ("name", base_codec::json_str(sp.name)),
          ("command", base_codec::json_str(sp.command)),
          ("screen", base_codec::json_bool(sp.screen)),
          ("small", base_codec::json_bool(sp.small)),
        ]
        if intent.starter_email.length() > 0 {
          sfields.push(("requestedBy", base_codec::json_str(intent.starter_email)))
        }
        base_codec::json_obj(sfields)
      }
      None => base_codec::json_obj([])
    }
    return base_codec::json_obj([
      ("method", base_codec::json_str("task.start")),
      ("workspace", base_codec::json_str(intent.caller_ws)),
      ("session", base_codec::json_str(intent.session)),
      ("key", base_codec::json_str(intent.task_key)),
      ("spec", spec_obj),
    ])
  }
  let rpc_fields : Array[(String, base_codec::Json)] = [
    ("method", base_codec::json_str("task." + intent.action)),
    ("workspace", base_codec::json_str(intent.caller_ws)),
    ("session", base_codec::json_str(intent.session)),
  ]
  match intent.args {
    base_codec::Json::Obj(kvs) => {
      for i in 0..<kvs.length() {
        let (k, v) = kvs[i]
        if k != "station" && k != "action" && k != "method" && k != "workspace" && k != "session" {
          rpc_fields.push((k, v))
        }
      }
    }
    _ => ()
  }
  base_codec::json_obj(rpc_fields)
}

/// Build the wire peer RPC payload for a cross-station `login` call (1:1 with Node `logins/module.ts`:
/// `method: "login.call"`, stripping `station` from `args`).
pub fn build_remote_login_rpc_payload(intent : station_whole::DeferredMcpIntent) -> base_codec::Json {
  let rest_kvs : Array[(String, base_codec::Json)] = []
  match intent.args {
    base_codec::Json::Obj(kvs) => {
      for i in 0..<kvs.length() {
        let (k, v) = kvs[i]
        if k != "station" {
          rest_kvs.push((k, v))
        }
      }
    }
    _ => ()
  }
  let fields : Array[(String, base_codec::Json)] = [
    ("method", base_codec::json_str("login.call")),
    ("workspace", base_codec::json_str(intent.caller_ws)),
    ("session", base_codec::json_str(intent.session)),
    (
      "by",
      base_codec::json_obj([
        ("email", base_codec::json_str(intent.starter_email)),
        ("name", base_codec::json_str(intent.starter_name)),
      ]),
    ),
    ("args", base_codec::json_obj(rest_kvs)),
  ]
  match intent.chat_title {
    Some(t) => fields.push(("chatTitle", base_codec::json_str(t)))
    None => ()
  }
  base_codec::json_obj(fields)
}

/// Build the workspace-scoped station list for `caller_ws` from live `CloudStore` + local telemetry,
/// marking any peer outside the workspace lock roster as `unprotected` (`station_mesh::UNPROTECTED`).
pub fn build_daemon_station_peers(
  ctx : DaemonCtx,
  core : station_whole::WholeCore,
  caller_ws : String,
) -> Array[station_whole::McpStationPeer] {
  let out : Array[station_whole::McpStationPeer] = []
  let now_secs = (host_shim::wall_ms() / 1000L).to_double()
  let mut self_cores = 0
  let mut self_load : Option[Double] = None
  let mut self_free_mem : Option[Int64] = None
  let mut self_free_disk : Option[Int64] = None
  match base_codec::json_parse(station_sys::machine_stats_json()) {
    base_codec::JsonParseResult::Ok(mj) => {
      match dm_json_int(mj, "cores") {
        Some(c) => self_cores = c
        None => ()
      }
      self_load = dm_json_num(mj, "load1")
      self_free_mem = dm_json_i64(mj, "freeMem")
    }
    _ => ()
  }
  match station_sys::disk_of_json(ctx.data) {
    Some(dj_str) => {
      match base_codec::json_parse(dj_str) {
        base_codec::JsonParseResult::Ok(dj) => {
          self_free_disk = dm_json_i64(dj, "free")
        }
        _ => ()
      }
    }
    None => ()
  }
  let mut self_name = station_sys::hostname()
  if self_name.length() == 0 {
    self_name = "this station"
  }
  let mem_opt = ctx.cloud.membership(caller_ws, now_secs)
  match mem_opt {
    Some(m) => {
      if m.name.length() > 0 {
        self_name = m.name
      }
    }
    None => ()
  }
  // Compute workspace lock protection for peers (`mesh/peer.ts:75`).
  let lock_roster_opt = ctx.cloud.roster_of(now_secs, ws=Some(caller_ws))
  let peer_unprotected_why = fn(pid : String) -> Option[String] {
    match lock_roster_opt {
      None => None
      Some(eff) => {
        match eff.state {
          None => Some(station_mesh::UNPROTECTED)
          Some(ls) => if ls.stations.contains(pid) { None } else { Some(station_mesh::UNPROTECTED) }
        }
      }
    }
  }
  let running_jobs = core.agents.jobs.list().length()
  let self_ver = if core.config.station_build.length() > 0 { Some(core.config.station_build) } else { None }
  out.push(
    station_whole::McpStationPeer::{
      id: ctx.station_key.id,
      name: self_name,
      workspace: caller_ws,
      is_self: true,
      mode: "whole",
      owner_sub: "",
      owner_email: "",
      owner_name: "",
      rig_open: false,
      unprotected_why: None,
      version: self_ver,
      cores: self_cores,
      arch: station_sys::arch_name(),
      os: station_sys::os_name(),
      cpu_busy: None,
      load_1m: self_load,
      free_mem_bytes: self_free_mem,
      free_disk_bytes: self_free_disk,
      running_jobs: running_jobs,
      relay_ping_ms: None,
    },
  )
  match mem_opt {
    Some(m) => {
      let seen : Map[String, Bool] = Map::new()
      seen.set(ctx.station_key.id, true)
      for i in 0..<m.peers.length() {
        let pj = m.peers[i]
        let pid = dm_json_str(pj, "id")
        if pid.length() == 0 || seen.contains(pid) {
          continue
        }
        seen.set(pid, true)
        let pname = dm_json_str(pj, "name")
        let pver = match base_codec::json_get(pj, "version") {
          Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
          _ => None
        }
        out.push(
          station_whole::McpStationPeer::{
            id: pid,
            name: if pname.length() > 0 { pname } else { pid },
            workspace: caller_ws,
            is_self: false,
            mode: "whole",
            owner_sub: "",
            owner_email: "",
            owner_name: "",
            rig_open: false,
            unprotected_why: peer_unprotected_why(pid),
            version: pver,
            cores: 0,
            arch: "",
            os: "",
            cpu_busy: None,
            load_1m: None,
            free_mem_bytes: None,
            free_disk_bytes: None,
            running_jobs: 0,
            relay_ping_ms: None,
          },
        )
      }
      match m.rigs {
        Some(rigs) => {
          for i in 0..<rigs.length() {
            let r = rigs[i]
            if r.id.length() == 0 || seen.contains(r.id) {
              continue
            }
            seen.set(r.id, true)
            out.push(
              station_whole::McpStationPeer::{
                id: r.id,
                name: if r.name.length() > 0 { r.name } else { r.id },
                workspace: caller_ws,
                is_self: false,
                mode: "tasks",
                owner_sub: r.owner,
                owner_email: r.owner_email,
                owner_name: r.owner_name,
                rig_open: false,
                unprotected_why: peer_unprotected_why(r.id),
                version: r.version,
                cores: 0,
                arch: "",
                os: "",
                cpu_busy: None,
                load_1m: None,
                free_mem_bytes: None,
                free_disk_bytes: None,
                running_jobs: 0,
                relay_ping_ms: None,
              },
            )
          }
        }
        None => ()
      }
    }
    None => ()
  }
  out
}

/// Build a production `station_mesh::WaysStore` seeded from `CloudStore` + real workspace `ways`.
pub fn build_daemon_ways_store(ctx : DaemonCtx) -> station_mesh::WaysStore {
  let still_fail : Array[String] = []
  let mut insecure = false
  match ctx.cloud.state {
    Some(cs) => {
      if cs.relay_url.length() > 0 {
        still_fail.push(cs.relay_url)
      }
      if cs.origin.starts_with("http://") {
        insecure = true
      }
    }
    None => ()
  }
  station_mesh::WaysStore::new(ctx.station_key.id, still_fail, insecure=insecure)
}

/// Build a read-only `MoveScheduler` populated from SQLite chats in `ws` (`plan`/`status` work;
/// `move`/`back` honestly report unavailable until remote move executor is wired).
pub fn build_daemon_move_scheduler(core : station_whole::WholeCore) -> Option[station_replica::MoveScheduler] {
  let chats_mod = station_replica::MoveModule::{
    id: "chats",
    needs: [],
    plan: fn(ws : String, _to : String) -> Result[Array[station_replica::MoveItem], String] {
      let st = match core.store.require_open() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      let items : Array[station_replica::MoveItem] = []
      match st.db.all(
        "SELECT key, archived_at FROM sessions WHERE COALESCE(ws, ?1) = ?2 ORDER BY last_active_at DESC LIMIT 500",
        [base_codec::json_str(core.config.home_workspace), base_codec::json_str(ws)],
      ) {
        Ok(rows) => {
          for i in 0..<rows.length() {
            let k = match rows[i].get("key") {
              Some(base_codec::Json::Str(s)) => s
              _ => ""
            }
            if k.length() == 0 {
              continue
            }
            items.push(
              station_replica::MoveItem::{
                module_id: "chats",
                id: k,
                label: k,
                needs: [],
                cannot: None,
                again: false,
                size: None,
                leaves: None,
              },
            )
          }
        }
        Err(e) => return Err(e.message)
      }
      Ok(items)
    },
    move_item: fn(_item : station_replica::MoveItem, _to : String, _waits : Option[station_replica::MoveWaits]) -> Result[Unit, String] {
      Err("remote move execution is not wired yet on the Pion engine")
    },
    back_item: fn(_item : station_replica::MoveItem, _from : String, _waits : Option[station_replica::MoveWaits]) -> Result[Unit, String] {
      Err("remote move execution is not wired yet on the Pion engine")
    },
    state: fn(_item : station_replica::MoveItem) -> station_replica::MoveItemStateKind {
      station_replica::MoveItemStateKind::Here
    },
    usable_here: fn(_item : station_replica::MoveItem) -> Bool { true },
    usable_there: fn(_item : station_replica::MoveItem) -> Bool { false },
    can_lend: fn(_item : station_replica::MoveItem) -> Bool { false },
    lend: fn(_item : station_replica::MoveItem, _to : String, _for_items : Array[station_replica::MoveNeed]) -> Result[Unit, String] {
      Err("lending is not supported for chats")
    },
    left: fn(_returned : Array[station_replica::MoveNeed]) -> Result[Unit, String] { Ok(()) },
    has_stop: false,
    stop_item: fn(_item : station_replica::MoveItem, _waits : station_replica::MoveWaits) -> Result[Unit, String] { Ok(()) },
    resume_item: fn(_item : station_replica::MoveItem) -> Result[Unit, String] { Ok(()) },
    abandon: fn() -> Unit { () },
  }
  match station_replica::MoveScheduler::new([chats_mod]) {
    Ok(s) => Some(s)
    Err(_) => None
  }
}

fn ways_to_mcp_view(ctx : DaemonCtx, ways : station_mesh::WaysStore, ws : String) -> station_whole::McpRelaysView {
  let v = ways.view(ws)
  let own : Array[station_whole::McpRelayEntry] = []
  let seen : Map[String, Bool] = Map::new()
  for i in 0..<v.relays.length() {
    seen.set(v.relays[i].url, true)
    own.push(station_whole::McpRelayEntry::{ url: v.relays[i].url, by: v.relays[i].by })
  }
  let off : Array[String] = []
  let seen_off : Map[String, Bool] = Map::new()
  for i in 0..<v.off.length() {
    seen_off.set(v.off[i], true)
    off.push(v.off[i])
  }
  // Merge configured workspace relays/off from live `CloudStore` membership.
  let now_secs = (host_shim::wall_ms() / 1000L).to_double()
  match ctx.cloud.membership(ws, now_secs) {
    Some(m) => {
      match m.ways {
        Some(w) => {
          for i in 0..<w.relays.length() {
            if !seen.contains(w.relays[i]) {
              seen.set(w.relays[i], true)
              own.push(station_whole::McpRelayEntry::{ url: w.relays[i], by: None })
            }
          }
          for i in 0..<w.off.length() {
            if !seen_off.contains(w.off[i]) {
              seen_off.set(w.off[i], true)
              off.push(w.off[i])
            }
          }
        }
        None => ()
      }
    }
    None => ()
  }
  station_whole::McpRelaysView::{
    workspace: ws,
    own: own,
    still_fail: ways.stillfail_relays,
    off: off,
    mesh: None,
  }
}

/// Wire `core.agents.remote_system_port` with unified `DeferredMcpCapture` and zero fake successes.
pub fn wire_daemon_mcp_remote_system(
  ctx : DaemonCtx,
  core : station_whole::WholeCore,
  logins : station_whole::LoginsOsRuntime,
  ways : station_mesh::WaysStore,
  move_sched : Option[station_replica::MoveScheduler],
  defer_capture : station_whole::DeferredMcpCapture,
) -> Unit {
  let port = station_whole::McpRemoteSystemPort::{
    station_id: fn() -> String { ctx.station_key.id },
    station_build: fn() -> String { core.config.station_build },
    station_channel: fn() -> Option[String] {
      match base_codec::json_get(ctx.cfg_raw, "updateChannel") {
        Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
        _ => None
      }
    },
    list_stations: fn(ws : String) -> Array[station_whole::McpStationPeer] {
      build_daemon_station_peers(ctx, core, ws)
    },
    list_sandboxes: fn() -> Array[station_whole::McpSandboxInfo] { [] },
    // Zero fake success: `station_use` returns honest not-wired error until signed rig_requests + SSE cards land.
    rig_requests: None,
    prepared_tasks: Map::new(),
    defer_capture: Some(defer_capture),
    dispatch_remote_task: fn(ws : String, session : String, target : String, action : String, args : base_codec::Json) -> Result[base_codec::Json, String] {
      if target == ctx.station_key.id {
        return dispatch_local_remote_task(core.remote, ws, ctx.station_key.id, session, action, args)
      }
      Err("remote station_task requires an active JSON-RPC request id for async dispatch")
    },
    dispatch_remote_file: fn(_ws : String, _session : String, _target : String, _key : String, _dir : String, _rpath : String, _lpath : String) -> Result[base_codec::Json, String] {
      Err("remote station_file requires an active JSON-RPC request id for async dispatch")
    },
    forward_list: fn(_sess : String) -> Array[station_whole::McpPeerForwardEntry] { [] },
    forward_open: fn(_ws : String, _sess : String, target : String, _name : String, _port : Int, _lport : Option[Int], _job : Option[String]) -> Result[station_whole::McpPeerForwardEntry, String] {
      Err("outbound peer_forward listener to " + target + " is not yet wired on the Pion engine (use $STILLFAIL_PEER_HTTP for HTTP APIs)")
    },
    forward_close: fn(_sess : String, port : Int) -> Result[station_whole::McpPeerForwardEntry, String] {
      Err("no forwarded port " + port.to_string() + " for this session")
    },
    // Zero fake success: no orphan workspace-limits files until WorkspaceWatch is ported.
    workspace_limit_enabled: false,
    logins: Some(station_whole::McpLoginsPort::from_os_runtime(logins)),
    login_link: fn(_sess : String, _id : String) -> Option[String] { None },
    remote_login: None,
    relays_list: fn(ws : String) -> Result[station_whole::McpRelaysView, String] {
      Ok(ways_to_mcp_view(ctx, ways, ws))
    },
    relays_add: fn(_ws : String, _url : String, _by : String, _now : Int64) -> Result[(String, Int, station_whole::McpRelaysView), String] {
      Err("relays add is not yet wired on the Pion engine (async relay HTTP probe pending)")
    },
    relays_remove: fn(ws : String, raw_url : String, now_ms : Int64) -> Result[(String, station_whole::McpRelaysView), String] {
      match ways.remove_relay(ws, raw_url, now_ms) {
        Ok(_) => {
          let norm = match station_mesh::validate_relay_url(raw_url, insecure=true) {
            Some(u) => u
            None => raw_url
          }
          Ok((norm, ways_to_mcp_view(ctx, ways, ws)))
        }
        Err(e) => Err("not removed: " + e)
      }
    },
    relays_enroll: None,
    relays_revoke: None,
    move_scheduler: move_sched,
    move_has_executor: false,
    update_trigger: None,
    feedback_send: None,
    feedback_reply: None,
    fs: core.agents.jobs.fs,
  }
  core.agents.remote_system_port = Some(port)
}

fn dispatch_local_remote_task(
  remote : station_jobs::RemoteManager,
  ws : String,
  station_id : String,
  session : String,
  action : String,
  args : base_codec::Json,
) -> Result[base_codec::Json, String] {
  let key = dm_json_str(args, "key")
  let now = host_shim::wall_ms()
  if action == "list" {
    let tasks = remote.list_scoped(ws, station_id, session)
    let arr : Array[base_codec::Json] = []
    for i in 0..<tasks.length() {
      arr.push(
        base_codec::json_obj([
          ("key", base_codec::json_str(tasks[i].key)),
          ("name", base_codec::json_str(tasks[i].name)),
          ("state", base_codec::json_str(station_jobs::remote_task_state_str(tasks[i].state))),
        ]),
      )
    }
    return Ok(base_codec::json_obj([("tasks", base_codec::json_arr(arr))]))
  }
  if action == "mirrors" {
    let ms = remote.mirrors_scoped(ws, station_id, session)
    let arr : Array[base_codec::Json] = []
    for i in 0..<ms.length() {
      arr.push(
        base_codec::json_obj([
          ("name", base_codec::json_str(ms[i].name)),
          ("state", base_codec::json_str(station_jobs::mirror_state_str(ms[i].state))),
        ]),
      )
    }
    return Ok(base_codec::json_obj([("mirrors", base_codec::json_arr(arr))]))
  }
  if action == "clean" {
    let mname = dm_json_str(args, "mirror")
    match remote.clean_mirror_scoped(ws, station_id, session, mname) {
      Ok(_) => return Ok(base_codec::json_obj([("cleaned", base_codec::json_str(mname))]))
      Err(e) => return Err(e)
    }
  }
  if action == "get" {
    match remote.get_scoped(ws, station_id, session, key) {
      Some(t) => return Ok(
        base_codec::json_obj([
          ("key", base_codec::json_str(t.key)),
          ("name", base_codec::json_str(t.name)),
          ("state", base_codec::json_str(station_jobs::remote_task_state_str(t.state))),
        ]),
      )
      None => return Err("unknown task " + key)
    }
  }
  if action == "log" {
    let lines = match dm_json_int(args, "lines") {
      Some(l) => l
      None => 100
    }
    match remote.log_scoped(ws, station_id, session, key, lines) {
      Ok(txt) => return Ok(base_codec::json_obj([("log", base_codec::json_str(txt))]))
      Err(e) => return Err(e)
    }
  }
  if action == "stop" {
    match remote.stop_scoped(ws, station_id, session, key, now) {
      Ok(t) => return Ok(base_codec::json_obj([("state", base_codec::json_str(station_jobs::remote_task_state_str(t.state)))]))
      Err(e) => return Err(e)
    }
  }
  if action == "release" {
    match remote.release_scoped(ws, station_id, session, key) {
      Ok(t) => return Ok(base_codec::json_obj([("state", base_codec::json_str(station_jobs::remote_task_state_str(t.state)))]))
      Err(e) => return Err(e)
    }
  }
  if action == "prepare" {
    let cmd = dm_json_str(args, "command")
    let name = dm_json_str(args, "name")
    let dir_s = dm_json_str(args, "dir")
    let dir_opt = if dir_s.length() > 0 { Some(dir_s) } else { None }
    let screen = match base_codec::json_get(args, "screen") {
      Some(base_codec::Json::Bool(true)) => true
      _ => false
    }
    let small = match base_codec::json_get(args, "small") {
      Some(base_codec::Json::Bool(true)) => true
      _ => false
    }
    let back : Array[String] = []
    match base_codec::json_get(args, "back") {
      Some(base_codec::Json::Arr(xs)) => {
        for i in 0..<xs.length() {
          match xs[i] {
            base_codec::Json::Str(s) => back.push(s)
            _ => ()
          }
        }
      }
      _ => ()
    }
    let prep = station_jobs::RemotePrepareRequest::{
      key: key,
      workspace: ws,
      source_station: station_id,
      source_session: session,
      name: name,
      command: cmd,
      mirror_name: dir_opt,
      back_paths: back,
      screen: screen,
      small: small,
    }
    match remote.prepare_scoped(prep, now) {
      Ok(t) => return Ok(base_codec::json_obj([("key", base_codec::json_str(t.key)), ("state", base_codec::json_str(station_jobs::remote_task_state_str(t.state)))]))
      Err(e) => return Err(e)
    }
  }
  if action == "start" {
    match remote.start_scoped(ws, station_id, session, key, now) {
      Ok(t) => return Ok(base_codec::json_obj([("key", base_codec::json_str(t.key)), ("state", base_codec::json_str(station_jobs::remote_task_state_str(t.state)))]))
      Err(e) => return Err(e)
    }
  }
  Err("unsupported action: " + action)
}

// ---------------------------------------------------------------------------
// Deferred `/mcp` Lifecycle: Launch after `ConnMode::Deferred`, Cleanup on
// Disconnect / Timeout / Shutdown, and Streaming File Chunk Transfer
// ---------------------------------------------------------------------------

fn cleanup_aborted_mcp_req(
  ctx : DaemonCtx,
  fs : station_jobs::FsPort,
  req : station_whole::McpPendingReq,
) -> Unit {
  if req.ask_id > 0L {
    let _ = ctx.cancel_peer_rpc(req.ask_id)
  }
  match req.part_path {
    Some(pp) => {
      let _ = (fs.remove_file)(pp)
    }
    None => ()
  }
}

/// Handle HTTP client disconnect on `/mcp`: cancel mesh RPC and remove any residual `.part` file.
pub fn on_mcp_conn_closed(
  ctx : DaemonCtx,
  fs : station_jobs::FsPort,
  mcp_pending : station_whole::McpPendingTable,
  conn_id : Int,
) -> Unit {
  match mcp_pending.on_conn_closed(conn_id) {
    Some(req) => cleanup_aborted_mcp_req(ctx, fs, req)
    None => ()
  }
}

/// Cancel and clean up all pending deferred `/mcp` requests on daemon shutdown.
pub fn shutdown_mcp_pending(
  ctx : DaemonCtx,
  fs : station_jobs::FsPort,
  mcp_pending : station_whole::McpPendingTable,
) -> Unit {
  let all = mcp_pending.drain_all()
  for i in 0..<all.length() {
    cleanup_aborted_mcp_req(ctx, fs, all[i])
  }
}

fn complete_deferred_mcp(
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mcp_pending : station_whole::McpPendingTable,
  conn_id : Int,
  req_gen : Int64,
  reply : station_tools::ToolReply,
) -> Unit {
  match mcp_pending.take_if_active(conn_id, req_gen) {
    Some(p) => {
      let body_str = station_whole::encode_mcp_tool_jsonrpc(p.rpc_id, reply)
      let resp = station_http::HttpResponse::json(200, body_str)
      let _ = mcp_srv.respond_with_callbacks(conn_id, station_http::HandlerAction::Respond(resp), mcp_cb)
    }
    None => ()
  }
}

/// Complete any timed-out deferred `/mcp` requests using monotonic clock `now_mono_ms`,
/// cancelling their mesh RPCs and removing residual `.part` files.
pub fn sweep_expired_mcp_pending(
  ctx : DaemonCtx,
  fs : station_jobs::FsPort,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mcp_pending : station_whole::McpPendingTable,
  now_mono_ms : Int64,
) -> Unit {
  let expired = mcp_pending.sweep_expired(now_mono_ms)
  for i in 0..<expired.length() {
    let p = expired[i]
    cleanup_aborted_mcp_req(ctx, fs, p)
    let reply = station_tools::error_reply("MCP tool " + p.tool + " timed out waiting for remote response")
    let body_str = station_whole::encode_mcp_tool_jsonrpc(p.rpc_id, reply)
    let resp = station_http::HttpResponse::json(200, body_str)
    let _ = mcp_srv.respond_with_callbacks(p.conn_id, station_http::HandlerAction::Respond(resp), mcp_cb)
  }
}

/// Launch all queued deferred `/mcp` intents strictly AFTER `HttpServer` has transitioned each
/// connection to `ConnMode::Deferred` (guarantees synchronous queue-full callbacks never race).
pub fn flush_deferred_mcp_starts(
  ctx : DaemonCtx,
  fs : station_jobs::FsPort,
  mcp_srv : station_http::HttpServer,
  mcp_cb : station_http::ServerCallbacks,
  mcp_pending : station_whole::McpPendingTable,
) -> Unit {
  let intents = mcp_pending.drain_starts()
  if intents.length() == 0 {
    return
  }
  let now_mono = host_shim::now_ms()
  for i in 0..<intents.length() {
    let intent = intents[i]
    if intent.tool == "station_task" {
      let req_gen = mcp_pending.register(
        intent.conn_id,
        intent.rpc_id,
        intent.session,
        intent.caller_ws,
        "station_task",
        now_mono,
      )
      let rpc_req = build_remote_task_rpc_payload(intent)
      let aid = ctx.ask_peer_rpc_cancellable(
        intent.peer_id,
        intent.caller_ws,
        rpc_req,
        fn(res : Result[base_codec::Json, String]) -> Unit {
          let reply = match res {
            Ok(v) => station_tools::text_reply(base_codec::json_stringify(v))
            Err(e) => station_tools::error_reply(e)
          }
          complete_deferred_mcp(mcp_srv, mcp_cb, mcp_pending, intent.conn_id, req_gen, reply)
        },
      )
      mcp_pending.set_ask_id(intent.conn_id, req_gen, aid)
    } else if intent.tool == "login" {
      let req_gen = mcp_pending.register(
        intent.conn_id,
        intent.rpc_id,
        intent.session,
        intent.caller_ws,
        "login",
        now_mono,
      )
      let rpc_req = build_remote_login_rpc_payload(intent)
      let aid = ctx.ask_peer_rpc_cancellable(
        intent.peer_id,
        intent.caller_ws,
        rpc_req,
        fn(res : Result[base_codec::Json, String]) -> Unit {
          let reply = match res {
            Ok(base_codec::Json::Str(s)) => station_tools::text_reply(s)
            Ok(v) => station_tools::text_reply(base_codec::json_stringify(v))
            Err(e) => station_tools::error_reply(e)
          }
          complete_deferred_mcp(mcp_srv, mcp_cb, mcp_pending, intent.conn_id, req_gen, reply)
        },
      )
      mcp_pending.set_ask_id(intent.conn_id, req_gen, aid)
    } else if intent.tool == "station_file" {
      let req_gen = mcp_pending.register(
        intent.conn_id,
        intent.rpc_id,
        intent.session,
        intent.caller_ws,
        "station_file",
        now_mono,
        timeout_ms=120000L,
      )
      if intent.action == "upload" {
        match station_sys::file_open_ro(intent.local_path) {
          Err(_) => {
            complete_deferred_mcp(
              mcp_srv,
              mcp_cb,
              mcp_pending,
              intent.conn_id,
              req_gen,
              station_tools::error_reply("failed to open regular local file for upload"),
            )
          }
          Ok(ro_file) => {
            if ro_file.size < 0L || ro_file.size > station_jobs::REMOTE_MAX_FILE {
              let _ = ro_file.close()
              complete_deferred_mcp(
                mcp_srv,
                mcp_cb,
                mcp_pending,
                intent.conn_id,
                req_gen,
                station_tools::error_reply("input must be a regular file of at most 1 GiB"),
              )
            } else {
              pump_async_file_upload_ro(
                ctx,
                mcp_srv,
                mcp_cb,
                mcp_pending,
                ro_file,
                intent.conn_id,
                req_gen,
                intent.peer_id,
                intent.caller_ws,
                intent.session,
                intent.task_key,
                intent.remote_path,
                intent.local_path,
                0L,
                ro_file.size,
              )
            }
          }
        }
      } else {
        let rand_suffix = match station_sys::random_bytes(8) {
          Ok(b) => dm_bytes_to_hex(b)
          Err(_) => now_mono.to_string()
        }
        let part_path = intent.local_path + "." + rand_suffix + ".part"
        mcp_pending.set_part_path(intent.conn_id, req_gen, Some(part_path))
        pump_async_file_download_stream(
          ctx,
          mcp_srv,
          mcp_cb,
          mcp_pending,
          fs,
          intent.conn_id,
          req_gen,
          intent.peer_id,
          intent.caller_ws,
          intent.session,
          intent.task_key,
          intent.remote_path,
          intent.local_path,
          part_path,
          0L,
          None,
        )
      }
    }
  }
}

fn pump_async_file_upload_ro(
  ctx : DaemonCtx,
  mcp_srv : station_http::HttpServer,
  cb : station_http::ServerCallbacks,
  mcp_pending : station_whole::McpPendingTable,
  ro_file : station_sys::ReadOnlyFile,
  conn_id : Int,
  req_gen : Int64,
  peer_id : String,
  caller_ws : String,
  caller_session : String,
  task_key : String,
  remote_path : String,
  local_path : String,
  offset : Int64,
  total_size : Int64,
) -> Unit {
  if !mcp_pending.is_active(conn_id, req_gen) {
    let _ = ro_file.close()
    return
  }
  let rem = total_size - offset
  let chunk_len = if rem > station_jobs::REMOTE_CHUNK.to_int64() {
    station_jobs::REMOTE_CHUNK.to_int64()
  } else if rem < 0L {
    0L
  } else {
    rem
  }
  let chunk = if chunk_len == 0L {
    Bytes::new(0)
  } else {
    match ro_file.pread(offset, chunk_len) {
      Ok(b) => {
        if b.length() == 0 {
          let _ = ro_file.close()
          complete_deferred_mcp(
            mcp_srv,
            cb,
            mcp_pending,
            conn_id,
            req_gen,
            station_tools::error_reply("input changed while reading"),
          )
          return
        }
        b
      }
      Err(_) => {
        let _ = ro_file.close()
        complete_deferred_mcp(
          mcp_srv,
          cb,
          mcp_pending,
          conn_id,
          req_gen,
          station_tools::error_reply("failed to read local file chunk"),
        )
        return
      }
    }
  }
  let next_off = offset + chunk.length().to_int64()
  let is_final = next_off >= total_size
  let req = base_codec::json_obj([
    ("method", base_codec::json_str("file.put")),
    ("workspace", base_codec::json_str(caller_ws)),
    ("session", base_codec::json_str(caller_session)),
    ("key", base_codec::json_str(task_key)),
    ("path", base_codec::json_str(remote_path)),
    ("offset", base_codec::json_int64(offset)),
    ("data", base_codec::json_str(base64::encode(chunk))),
    ("final", base_codec::json_bool(is_final)),
  ])
  let aid = ctx.ask_peer_rpc_cancellable(
    peer_id,
    caller_ws,
    req,
    fn(res : Result[base_codec::Json, String]) -> Unit {
      if !mcp_pending.is_active(conn_id, req_gen) {
        let _ = ro_file.close()
        return
      }
      match res {
        Err(e) => {
          let _ = ro_file.close()
          complete_deferred_mcp(mcp_srv, cb, mcp_pending, conn_id, req_gen, station_tools::error_reply(e))
        }
        Ok(_) => {
          if is_final {
            let _ = ro_file.close()
            let ok_json = base_codec::json_stringify(
              base_codec::json_obj([
                ("uploaded", base_codec::json_str(local_path)),
                ("bytes", base_codec::json_int64(total_size)),
              ]),
            )
            complete_deferred_mcp(mcp_srv, cb, mcp_pending, conn_id, req_gen, station_tools::text_reply(ok_json))
          } else {
            pump_async_file_upload_ro(
              ctx,
              mcp_srv,
              cb,
              mcp_pending,
              ro_file,
              conn_id,
              req_gen,
              peer_id,
              caller_ws,
              caller_session,
              task_key,
              remote_path,
              local_path,
              next_off,
              total_size,
            )
          }
        }
      }
    },
  )
  mcp_pending.set_ask_id(conn_id, req_gen, aid)
}

fn pump_async_file_download_stream(
  ctx : DaemonCtx,
  mcp_srv : station_http::HttpServer,
  cb : station_http::ServerCallbacks,
  mcp_pending : station_whole::McpPendingTable,
  fs : station_jobs::FsPort,
  conn_id : Int,
  req_gen : Int64,
  peer_id : String,
  caller_ws : String,
  caller_session : String,
  task_key : String,
  remote_path : String,
  local_path : String,
  part_path : String,
  offset : Int64,
  expected_size : Option[Int64],
) -> Unit {
  if !mcp_pending.is_active(conn_id, req_gen) {
    let _ = (fs.remove_file)(part_path)
    return
  }
  let req = base_codec::json_obj([
    ("method", base_codec::json_str("file.get")),
    ("workspace", base_codec::json_str(caller_ws)),
    ("session", base_codec::json_str(caller_session)),
    ("key", base_codec::json_str(task_key)),
    ("path", base_codec::json_str(remote_path)),
    ("offset", base_codec::json_int64(offset)),
  ])
  let aid = ctx.ask_peer_rpc_cancellable(
    peer_id,
    caller_ws,
    req,
    fn(res : Result[base_codec::Json, String]) -> Unit {
      if !mcp_pending.is_active(conn_id, req_gen) {
        let _ = (fs.remove_file)(part_path)
        return
      }
      match res {
        Err(e) => {
          let _ = (fs.remove_file)(part_path)
          complete_deferred_mcp(mcp_srv, cb, mcp_pending, conn_id, req_gen, station_tools::error_reply(e))
        }
        Ok(v) => {
          let eff_size = match expected_size {
            Some(s) => Some(s)
            None => dm_json_i64(v, "size")
          }
          match eff_size {
            Some(sz) => {
              if sz < 0L || sz > station_jobs::REMOTE_MAX_FILE {
                let _ = (fs.remove_file)(part_path)
                complete_deferred_mcp(
                  mcp_srv,
                  cb,
                  mcp_pending,
                  conn_id,
                  req_gen,
                  station_tools::error_reply("remote file exceeds 1 GiB limit"),
                )
                return
              }
            }
            None => ()
          }
          let b64_opt = match base_codec::json_get(v, "data") {
            Some(base_codec::Json::Str(s)) => Some(s)
            _ => None
          }
          let is_eof_flag = match base_codec::json_get(v, "eof") {
            Some(base_codec::Json::Bool(true)) => true
            _ => false
          }
          let decoded = match b64_opt {
            None => {
              let _ = (fs.remove_file)(part_path)
              complete_deferred_mcp(
                mcp_srv,
                cb,
                mcp_pending,
                conn_id,
                req_gen,
                station_tools::error_reply("remote file.get reply missing data field"),
              )
              return
            }
            Some(b64) => if b64.length() == 0 {
              Bytes::new(0)
            } else {
              match base64::decode(b64) {
                Ok(b) => b
                Err(_) => {
                  let _ = (fs.remove_file)(part_path)
                  complete_deferred_mcp(
                    mcp_srv,
                    cb,
                    mcp_pending,
                    conn_id,
                    req_gen,
                    station_tools::error_reply("invalid base64 chunk from remote station"),
                  )
                  return
                }
              }
            }
          }
          if decoded.length() > station_jobs::REMOTE_CHUNK {
            let _ = (fs.remove_file)(part_path)
            complete_deferred_mcp(
              mcp_srv,
              cb,
              mcp_pending,
              conn_id,
              req_gen,
              station_tools::error_reply("remote chunk exceeds maximum chunk size"),
            )
            return
          }
          let next_off = offset + decoded.length().to_int64()
          if next_off > station_jobs::REMOTE_MAX_FILE {
            let _ = (fs.remove_file)(part_path)
            complete_deferred_mcp(
              mcp_srv,
              cb,
              mcp_pending,
              conn_id,
              req_gen,
              station_tools::error_reply("downloaded file exceeds 1 GiB limit"),
            )
            return
          }
          // Stream chunk directly to `.part` on disk (O_NOFOLLOW in `station_sys::write_at`, zero full-file RAM buffer).
          if decoded.length() > 0 || offset == 0L {
            match station_sys::write_at(part_path, offset, decoded, offset == 0L, None, None, false) {
              Ok(_) => ()
              Err(_) => {
                let _ = (fs.remove_file)(part_path)
                complete_deferred_mcp(
                  mcp_srv,
                  cb,
                  mcp_pending,
                  conn_id,
                  req_gen,
                  station_tools::error_reply("failed to write downloaded chunk to temp file"),
                )
                return
              }
            }
          }
          let reached_size = match eff_size {
            Some(sz) => next_off >= sz
            None => false
          }
          let is_eof = is_eof_flag || reached_size
          if !is_eof && decoded.length() == 0 {
            let _ = (fs.remove_file)(part_path)
            complete_deferred_mcp(
              mcp_srv,
              cb,
              mcp_pending,
              conn_id,
              req_gen,
              station_tools::error_reply("remote station returned empty chunk before EOF"),
            )
            return
          }
          if is_eof {
            match eff_size {
              Some(sz) => {
                if next_off != sz {
                  let _ = (fs.remove_file)(part_path)
                  complete_deferred_mcp(
                    mcp_srv,
                    cb,
                    mcp_pending,
                    conn_id,
                    req_gen,
                    station_tools::error_reply("downloaded byte count does not match remote file size"),
                  )
                  return
                }
              }
              None => ()
            }
            let _ = station_sys::sync_file(part_path)
            // Re-verify generation BEFORE atomic publish so a cancelled/timed-out request never publishes.
            if !mcp_pending.is_active(conn_id, req_gen) {
              let _ = (fs.remove_file)(part_path)
              return
            }
            // Refuse to overwrite an existing local file!
            match (fs.lstat)(local_path) {
              Some(_) => {
                let _ = (fs.remove_file)(part_path)
                complete_deferred_mcp(
                  mcp_srv,
                  cb,
                  mcp_pending,
                  conn_id,
                  req_gen,
                  station_tools::error_reply("local file already exists: downloads never overwrite an existing local file"),
                )
                return
              }
              None => ()
            }
            if !(fs.rename)(part_path, local_path) {
              let _ = (fs.remove_file)(part_path)
              complete_deferred_mcp(
                mcp_srv,
                cb,
                mcp_pending,
                conn_id,
                req_gen,
                station_tools::error_reply("failed to publish downloaded file"),
              )
              return
            }
            mcp_pending.set_part_path(conn_id, req_gen, None)
            let ok_json = base_codec::json_stringify(
              base_codec::json_obj([
                ("downloaded", base_codec::json_str(local_path)),
                ("bytes", base_codec::json_int64(next_off)),
              ]),
            )
            complete_deferred_mcp(mcp_srv, cb, mcp_pending, conn_id, req_gen, station_tools::text_reply(ok_json))
          } else {
            pump_async_file_download_stream(
              ctx,
              mcp_srv,
              cb,
              mcp_pending,
              fs,
              conn_id,
              req_gen,
              peer_id,
              caller_ws,
              caller_session,
              task_key,
              remote_path,
              local_path,
              part_path,
              next_off,
              eff_size,
            )
          }
        }
      }
    },
  )
  mcp_pending.set_ask_id(conn_id, req_gen, aid)
}
