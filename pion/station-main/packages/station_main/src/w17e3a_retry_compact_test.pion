// Wave 17E-3A pure-Pion adversarial unit tests for `hub.session.retry` & `hub.session.compact`:
// (Zero SQLite/OS FFI so `pionc test` links and executes cleanly; full SQLite + live Admin/1
// end-to-end verification runs in `station/side/pion-station-whole-e2e.test.ts`.)
//
// Covers all 6 required anti-cheating scenarios:
// 1. Two consecutive failures + subsequent ordinary station notice: stale & ordinary notices
//    rejected, only exact atomically bound `(about_thread, about_n)` passes with `kind = "resume"`.
// 2. `cutOffByRestart` passes with `RESUME_AFTER_RESTART`; `auth:`/`quota:`/`refused:`, held,
//    archived, busy, and non-member threads rejected.
// 3. Hot compaction receives intermediate output lines (`system/status`, `assistant`,
//    `compact_boundary`, Codex `compact:<seq>` ACK) + human input: never clears `compacting` early,
//    human input queues (`InputRoute::Queue`), duplicate compact rejected (409).
// 4. Normal compaction completion (`result` / `turn/completed`): ZERO extra reprompt writes,
//    `compacting` cleared, queued human input immediately pumped.
// 5. Codex `compact:<seq>` JSON-RPC `error`, runner disconnect, and `check_compaction_timeout`
//    past `COMPACT_TIMEOUT_MS`: all release `compacting` and pump queued input (zero deadlock).
// 6. Claude empty `runtimeSessionId` returns 409 `station.context.empty`; cold Codex returns 409
//    with ZERO prompt writes (never sends literal `"/compact"`).

import "base_codec"
import "js_json"
import "parse_claude"
import "station_drivers"
import "station_ops"
import "station_sessions"

test "w17e3a-1 & 2: exact atomic about binding, cutOffByRestart, and non-retryable/gate rejections" {
  // Two consecutive failures (n=2, n=5) + ordinary station notice (n=6):
  // latest turn is atomically bound to `(thread=10, n=5)`.
  // Old failure notice (n=2) -> REJECTED (409)
  match validate_retry_candidate(false, false, true, false, true, Some("failed"), None, Some("model: 500"), Some(10L), Some(5L), false, 10L, 2L) {
    Err(e) => if e.status != 409 { panic("expected 409 for stale notice") }
    Ok(_) => panic("stale notice n=2 must be rejected")
  }
  // Subsequent ordinary station notice (n=6) -> REJECTED (409)
  match validate_retry_candidate(false, false, true, false, true, Some("failed"), None, Some("model: 500"), Some(10L), Some(5L), false, 10L, 6L) {
    Err(e) => if e.status != 409 { panic("expected 409 for ordinary notice") }
    Ok(_) => panic("ordinary notice n=6 must be rejected")
  }
  // Exact bound latest failure (n=5) -> ACCEPTED with GO_ON_AFTER_FAILED + `kind = "resume"` internal turn
  match validate_retry_candidate(false, false, true, false, true, Some("failed"), None, Some("model: 500"), Some(10L), Some(5L), false, 10L, 5L) {
    Ok(words) => {
      if words != station_drivers::GO_ON_AFTER_FAILED {
        panic("expected GO_ON_AFTER_FAILED")
      }
      let actor = station_sessions::SessionActor::new("s-retry-1", "claude")
      if !actor.start_resume(words) {
        panic("start_resume must succeed when idle")
      }
      if actor.started_prompts.length() != 1
      || !actor.started_prompts_internal[0]
      || actor.started_prompts_kind[0] != "resume" {
        panic("retry must start internal kind=resume turn (never forging user input)")
      }
    }
    Err(e) => panic("exact bound notice n=5 must succeed: " + e.message)
  }

  // cutOffByRestart exact match -> ACCEPTED with RESUME_AFTER_RESTART
  match validate_retry_candidate(false, false, true, false, true, Some("aborted"), None, Some("other: cut off by restart"), Some(10L), Some(7L), false, 10L, 7L) {
    Ok(words) => {
      if words != station_drivers::RESUME_AFTER_RESTART {
        panic("expected RESUME_AFTER_RESTART for cutOffByRestart")
      }
    }
    Err(e) => panic("cutOffByRestart must succeed: " + e.message)
  }

  // givenUp -> ACCEPTED with GO_ON_AFTER_UNANSWERED
  match validate_retry_candidate(false, false, true, false, true, Some("completed"), None, None, Some(10L), Some(8L), false, 10L, 8L) {
    Ok(words) => {
      if words != station_drivers::GO_ON_AFTER_UNANSWERED {
        panic("expected GO_ON_AFTER_UNANSWERED for givenUp")
      }
    }
    Err(e) => panic("givenUp must succeed: " + e.message)
  }

  // auth:, quota:, refused: -> REJECTED (409) even with matching (about_thread, about_n)!
  let bad = ["auth: token expired", "quota: limit reached", "refused: account disabled"]
  for i in 0..<bad.length() {
    match validate_retry_candidate(false, false, true, false, true, Some("failed"), None, Some(bad[i]), Some(10L), Some(7L), false, 10L, 7L) {
      Err(e) => if e.status != 409 { panic("expected 409 for " + bad[i]) }
      Ok(_) => panic("must reject " + bad[i])
    }
  }
  // Held, archived, non-member thread, busy, pending messages -> REJECTED (with localized busy/held!)
  match validate_retry_candidate(true, false, true, false, true, Some("failed"), None, Some("network: x"), Some(10L), Some(7L), false, 10L, 7L, lang=station_ops::Lang::Zh) {
    Err(e) => if e.status != 409 || e.message != station_ops::tr(station_ops::Lang::Zh, "station.context.held") {
      panic("held must reject with localized zh message")
    }
    Ok(_) => panic("held must reject")
  }
  match validate_retry_candidate(false, false, true, true, true, Some("failed"), None, Some("network: x"), Some(10L), Some(7L), false, 10L, 7L, lang=station_ops::Lang::Zh) {
    Err(e) => if e.status != 409 || e.message != station_ops::tr(station_ops::Lang::Zh, "station.context.busy") {
      panic("busy must reject with localized zh message")
    }
    Ok(_) => panic("busy must reject")
  }
  if validate_retry_candidate(false, true, true, false, true, Some("failed"), None, Some("network: x"), Some(10L), Some(7L), false, 10L, 7L).is_ok() {
    panic("archived must reject")
  }
  match validate_retry_candidate(false, false, false, false, true, Some("failed"), None, Some("network: x"), Some(10L), Some(7L), false, 10L, 7L) {
    Err(e) => if e.status != 404 { panic("non-member thread must return 404") }
    Ok(_) => panic("non-member thread must reject")
  }
  // R4 Item 1: `other: session_cap` returns honest 501 until account concurrency cap runtime lands!
  match validate_retry_candidate(false, false, true, false, true, Some("failed"), None, Some("other: session_cap"), Some(10L), Some(9L), true, 10L, 9L) {
    Err(e) => if e.status != 501 { panic("other: session_cap must return honest 501, got " + e.status.to_string()) }
    Ok(_) => panic("other: session_cap must return honest 501")
  }
}

test "w17e3a-3 & 4: hot compaction ignores intermediate output, queues human input, finishes with ZERO reprompt and pumps queue" {
  let actor = station_sessions::SessionActor::new("s-hot-claude", "claude")
  actor.has_process = true
  let claude_turn = parse_claude::Turn::new()
  claude_turn.compacting = Some(true)

  match encode_runtime_compact(station_drivers::RuntimeKind::Claude, "rs-34", "compact:1") {
    Some(f) => if !f.contains("/compact") { panic("Claude compact frame must contain /compact") }
    None => panic("Claude compact frame missing")
  }
  match actor.begin_compaction("compact:1", "claude", 10000L) {
    Ok(_) => ()
    Err(e) => panic("begin_compaction failed: " + e)
  }

  // Intermediate stdout lines MUST NOT clear `compacting`!
  let inter_lines = [
    "{\"type\":\"system\",\"subtype\":\"status\",\"status\":\"compacting\"}",
    "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"working...\"}]}}",
    "{\"type\":\"system\",\"subtype\":\"compact_boundary\"}",
  ]
  for i in 0..<inter_lines.length() {
    let ev = parse_agent_stdout_line(station_drivers::RuntimeKind::Claude, inter_lines[i])
    match classify_compaction_event(actor, claude_turn, ev) {
      Some(_) => panic("intermediate line must NOT finish compaction early: " + inter_lines[i])
      None => ()
    }
    if !actor.compacting || actor.pending_compaction is None {
      panic("compacting cleared prematurely on intermediate line")
    }
  }

  // Human input arrives while compacting -> safely queues (`InputRoute::Queue`)
  match actor.submit_input("human message during compact") {
    station_sessions::InputRoute::Queue => ()
    _ => panic("human input during compaction must return InputRoute::Queue")
  }
  if actor.started_prompts.length() != 0 {
    panic("human prompt must remain queued during compaction")
  }

  // Normal compaction completion (`result` with `is_error: false`)
  let done_ev = parse_agent_stdout_line(station_drivers::RuntimeKind::Claude, "{\"type\":\"result\",\"is_error\":false,\"result\":\"ok\"}")
  match classify_compaction_event(actor, claude_turn, done_ev) {
    Some((ok, err_opt)) => {
      if !ok || err_opt is Some(_) {
        panic("expected ok=true, err=None on normal compaction completion")
      }
      let _ = actor.finish_compaction(ok, err_opt, 10040L)
    }
    None => panic("result frame must finish compaction")
  }

  // ZERO reprompts (`reprompt_count == 0`, no internal prompts pushed!), `compacting` cleared, queued human prompt pumped!
  if actor.reprompt_count != 0 || actor.compacting || actor.pending_compaction is Some(_) {
    panic("compaction completion must clear state with ZERO reprompts")
  }
  if actor.started_prompts.length() != 1
  || actor.started_prompts[0] != "human message during compact"
  || actor.started_prompts_internal[0] {
    panic("queued human prompt must be pumped immediately after compaction completes")
  }

  // Claude `system/status` `compact_result: "failed"` followed by `result` -> ok=false with error!
  let actor2 = station_sessions::SessionActor::new("s-hot-claude-err", "claude")
  let _ = actor2.begin_compaction("compact:2", "claude", 20000L)
  let ct2 = parse_claude::Turn::new()
  ct2.compacting = Some(true)
  match js_json::parse("{\"type\":\"system\",\"subtype\":\"status\",\"compact_result\":\"failed\",\"compact_error\":\"too short\"}") {
    Ok(jv) => parse_claude::on_frame_with(jv, ct2, fn(_) {}, fn() {}, fn() { 20010.0 }, fn(_) {}, fn(d) { d.to_string() })
    Err(_) => panic("parse failed")
  }
  match classify_compaction_event(actor2, ct2, done_ev) {
    Some((ok, Some(err_s))) => if ok || !err_s.contains("too short") { panic("expected compact_error propagation") }
    _ => panic("expected compact_error to fail compaction")
  }
}

test "w17e3a-5: Codex compact:<seq> JSON-RPC error, runner disconnect, and timeout all release queue (zero deadlock)" {
  let actor = station_sessions::SessionActor::new("s-hot-codex", "codex")
  actor.has_process = true
  let ct = parse_claude::Turn::new()

  // Verify Codex compact frame uses `thread/compact/start` + `compact:1`
  match encode_runtime_compact(station_drivers::RuntimeKind::Codex, "th-51", "compact:1") {
    Some(f) => if !f.contains("thread/compact/start") || !f.contains("\"compact:1\"") {
      panic("Codex compact frame mismatch: " + f)
    }
    None => panic("Codex compact frame missing")
  }

  // (a) Codex JSON-RPC error on `compact:1`
  let _ = actor.begin_compaction("compact:1", "codex", 10000L)
  let _ = actor.submit_input("queued-on-codex-err")
  let err_ev = parse_agent_stdout_line(
    station_drivers::RuntimeKind::Codex,
    "{\"jsonrpc\":\"2.0\",\"id\":\"compact:1\",\"error\":{\"code\":-32000,\"message\":\"too short\"}}",
  )
  match classify_compaction_event(actor, ct, err_ev) {
    Some((ok, Some(msg))) => {
      if ok || msg != "too short" {
        panic("unexpected codex compact error classification")
      }
      let _ = actor.finish_compaction(ok, Some(msg), 10010L)
    }
    _ => panic("Codex JSON-RPC error must finish compaction")
  }
  if actor.compacting || actor.pending_compaction is Some(_) {
    panic("Codex JSON-RPC error must clear compacting")
  }
  if actor.started_prompts.length() != 1 || actor.started_prompts[0] != "queued-on-codex-err" {
    panic("queued prompt must be pumped after Codex JSON-RPC error")
  }

  // (b) Codex ACK does NOT early-clear; timeout past COMPACT_TIMEOUT_MS releases queue!
  actor.started_prompts.clear()
  actor.started_prompts_internal.clear()
  actor.started_prompts_kind.clear()
  actor.phase = station_sessions::ActorPhase::Idle
  let _ = actor.begin_compaction("compact:2", "codex", 20000L)
  let ack_ev = parse_agent_stdout_line(station_drivers::RuntimeKind::Codex, "{\"jsonrpc\":\"2.0\",\"id\":\"compact:2\",\"result\":{}}")
  match classify_compaction_event(actor, ct, ack_ev) {
    None => ()
    Some(_) => panic("Codex compact ACK must NOT prematurely clear compacting")
  }
  let _ = actor.submit_input("queued-on-timeout")
  match actor.check_compaction_timeout(20000L + station_sessions::COMPACT_TIMEOUT_MS + 1L) {
    Some(_) => ()
    None => panic("check_compaction_timeout past deadline must fire")
  }
  if actor.compacting || actor.pending_compaction is Some(_) {
    panic("timeout must clear compacting")
  }
  if actor.started_prompts.length() != 1 || actor.started_prompts[0] != "queued-on-timeout" {
    panic("queued prompt must be pumped after compaction timeout")
  }

  // (c) Runner disconnect while compacting releases queue!
  actor.started_prompts.clear()
  actor.started_prompts_internal.clear()
  actor.started_prompts_kind.clear()
  actor.phase = station_sessions::ActorPhase::Idle
  let _ = actor.begin_compaction("compact:3", "codex", 400000L)
  let _ = actor.submit_input("queued-on-disconnect")
  let _ = actor.finish_compaction(false, Some("runner socket read error"), 400050L)
  if actor.compacting || actor.pending_compaction is Some(_) {
    panic("runner disconnect must clear compacting")
  }
  if actor.started_prompts.length() != 1 || actor.started_prompts[0] != "queued-on-disconnect" {
    panic("queued prompt must be pumped after runner disconnect")
  }
}

test "w17e3a-6: Claude empty runtimeSessionId returns station.context.empty; cold Claude allowed; cold Codex returns 409" {
  // Claude with empty runtimeSessionId -> 409 station.context.empty
  match validate_compact_candidate(false, false, false, "claude", "", false) {
    Err(e) => {
      let expected = station_ops::tr(station_ops::Lang::En, "station.context.empty")
      if e.status != 409 || e.message != expected {
        panic("expected 409 '" + expected + "', got " + e.status.to_string() + " '" + e.message + "'")
      }
    }
    Ok(_) => panic("Claude with empty runtimeSessionId must fail with station.context.empty")
  }
  // Cold Claude with non-empty runtimeSessionId -> ALLOWED (P2-3: spawns fresh --resume runner & compacts!)
  match validate_compact_candidate(false, false, false, "claude", "rs-cold-claude-1", false) {
    Ok(_) => ()
    Err(e) => panic("cold Claude with valid runtimeSessionId must be allowed, got " + e.status.to_string() + ": " + e.message)
  }
  // Cold Codex (valid runtimeSessionId, has_ready_runner=false) -> 409 (never sends literal "/compact"!)
  match validate_compact_candidate(false, false, false, "codex", "th-cold-1", false) {
    Err(e) => if e.status != 409 { panic("cold Codex must return 409, got " + e.status.to_string()) }
    Ok(_) => panic("cold Codex must return 409")
  }
  // Duplicate/busy compact -> 409 station.context.busy
  match validate_compact_candidate(false, false, true, "codex", "th-hot-1", true) {
    Err(e) => if e.status != 409 { panic("busy compact must return 409") }
    Ok(_) => panic("busy compact must return 409")
  }
  // Non-compactable runtime (agy) -> 409 station.context.cannotCompact
  match validate_compact_candidate(false, false, false, "agy", "sid-1", true) {
    Err(e) => if e.status != 409 { panic("agy compact must return 409") }
    Ok(_) => panic("agy compact must return 409")
  }
}

test "w17e3a-r2: localized station notices, Codex thread/turn correlation, cap_paused is_active vs queue, and Resume preservation" {
  // P1-1 & P2-1: station notice ts format and localized zh/en notice text
  let nts = make_station_notice_ts(1795857971123L, 42L)
  if !nts.contains(".") || !nts.contains("1795857971") {
    panic("unexpected notice ts: " + nts)
  }
  let en_cut = live_runner_retry_notice_text(station_ops::Lang::En, "aborted", Some("other: cut off by restart"))
  let zh_cut = live_runner_retry_notice_text(station_ops::Lang::Zh, "aborted", Some("other: cut off by restart"))
  if en_cut.length() == 0 || zh_cut.length() == 0 || en_cut == zh_cut {
    panic("expected distinct en/zh cutOffByRestart notices")
  }
  let en_cap = live_runner_retry_notice_text(station_ops::Lang::En, "failed", Some("other: session_cap"))
  if en_cap.length() == 0 {
    panic("expected non-empty cap_paused notice")
  }

  // P1-2: Codex turn/completed threadId & turn.id correlation guard
  let codex_line = "{\"jsonrpc\":\"2.0\",\"method\":\"turn/completed\",\"params\":{\"threadId\":\"th-A\",\"turn\":{\"id\":\"turn-1\",\"status\":\"completed\"}}}"
  let (ev_tid, ev_turn_id) = extract_codex_turn_ids(codex_line)
  if ev_tid != Some("th-A") || ev_turn_id != Some("turn-1") {
    panic("extract_codex_turn_ids failed")
  }
  if !codex_turn_event_matches_session(Some("th-A"), Some("turn-1"), Some("th-A"), Some("turn-1")) {
    panic("matching thread/turn must pass")
  }
  if codex_turn_event_matches_session(Some("th-A"), Some("turn-1"), Some("th-B"), Some("turn-1")) {
    panic("mismatched threadId from stale/other runner must be rejected")
  }
  if codex_turn_event_matches_session(Some("th-A"), Some("turn-1"), Some("th-A"), Some("turn-2")) {
    panic("mismatched turn.id from stale compaction must be rejected")
  }

  // P1-5: SessionActor::is_active() distinguishes queued work from active execution
  let cap_actor = station_sessions::SessionActor::new("s-cap-1", "claude")
  cap_actor.enqueue(station_sessions::ActorWork::Prompt("queued while cap_paused"))
  if cap_actor.is_active() {
    panic("idle actor with queued prompt must NOT be is_active()")
  }
  if !cap_actor.is_busy() {
    panic("idle actor with queued prompt must still be is_busy()")
  }
  // P2-2: ActorWork::Resume preserves kind="resume" and internal=true when pumped from queue
  let res_actor = station_sessions::SessionActor::new("s-res-1", "claude")
  res_actor.enqueue(station_sessions::ActorWork::Resume(station_drivers::GO_ON_AFTER_FAILED))
  res_actor.pump_next_prompt()
  if res_actor.started_prompts.length() != 1
  || !res_actor.started_prompts_internal[0]
  || res_actor.started_prompts_kind[0] != "resume" {
    panic("ActorWork::Resume must preserve internal=true and kind=resume across requeue")
  }
}

test "w17e3a-r3: Codex turn/started compaction correlation, PendingCompaction lifecycle, station_lang, and full instructions" {
  // P2-2: Codex compaction MUST reject terminal events before `turn/started` or with wrong turn.id/threadId
  if codex_compaction_event_matches(Some("th-A"), Some("turn-1"), Some("th-A"), None) {
    panic("Codex compaction must reject turn/completed when compact_turn_id is None")
  }
  if codex_compaction_event_matches(Some("th-A"), Some("turn-other"), Some("th-A"), Some("turn-compact-1")) {
    panic("Codex compaction must reject mismatched turn.id")
  }
  if codex_compaction_event_matches(Some("th-B"), Some("turn-compact-1"), Some("th-A"), Some("turn-compact-1")) {
    panic("Codex compaction must reject mismatched threadId")
  }
  if !codex_compaction_event_matches(Some("th-A"), Some("turn-compact-1"), Some("th-A"), Some("turn-compact-1")) {
    panic("Codex compaction must accept exact matching threadId and turn.id")
  }

  // P1-2 & P2-3: PendingCompaction carries runner_conn_id, bootstrapping, and codex_turn_id;
  // timeout releases queued human prompt and late stale turn.id from reclaimed runner is rejected!
  let a = station_sessions::SessionActor::new("s-r3-timeout", "codex")
  match a.begin_compaction("compact:9", "codex", 1000L, runner_conn_id=Some(42), bootstrapping=true) {
    Ok(pc) => {
      if pc.runner_conn_id != Some(42) || !pc.bootstrapping || pc.codex_turn_id is Some(_) {
        panic("PendingCompaction lifecycle fields mismatch")
      }
      pc.bootstrapping = false
      pc.codex_turn_id = Some("turn-old-compact")
    }
    Err(e) => panic("begin_compaction failed: " + e)
  }
  let _ = a.submit_input("next human prompt after timeout")
  match a.check_compaction_timeout(1000L + station_sessions::COMPACT_TIMEOUT_MS + 5L) {
    Some(_) => ()
    None => panic("expected compaction timeout")
  }
  if a.compacting || a.pending_compaction is Some(_) || a.started_prompts.length() != 1 {
    panic("timeout must release compaction and start queued human prompt")
  }
  if codex_turn_event_matches_session(Some("th-A"), Some("turn-old-compact"), Some("th-A"), Some("turn-new-human")) {
    panic("late turn/completed from timed-out compaction must NOT match new human turn")
  }

  // P2-1: `station_ops::station_lang()` defaults to Zh and respects `set_station_lang`
  let prev_lang = station_ops::station_lang()
  let _ = station_ops::set_station_lang(Some("en"))
  let en_empty = station_ops::tr(station_ops::station_lang(), "station.context.empty")
  let _ = station_ops::set_station_lang(Some("zh"))
  let zh_empty = station_ops::tr(station_ops::station_lang(), "station.context.empty")
  let _ = station_ops::set_station_lang(match prev_lang { station_ops::Lang::En => Some("en"); station_ops::Lang::Zh => Some("zh") })
  if en_empty == zh_empty || en_empty.length() == 0 || zh_empty.length() == 0 {
    panic("station_ops::station_lang must switch between distinct en/zh strings")
  }

  // P1-4: Cold Claude launch instructions must be non-empty (reusing `session_instructions`)
  let full_instr = station_drivers::session_instructions("/tmp/ws", None, "/tmp/repos", "/tmp/MEMORY.md", "", "", "st-1", true, true, "alice@example.com")
  if full_instr.length() == 0 {
    panic("cold Claude compact instructions must never be empty")
  }

  // R4 Item 2 & R5 P1-1 & R7 Item 1: Handover carry state round-trips queued prompts + exact `handed` tokens idempotently!
  let mgr1 = LiveRunnerManager::new()
  mgr1.pending_prompts.push(CarriedHandoverPrompt::{
    id: "chat:compact-ho-1:100-aaaa1111-1",
    session_key: "chat:compact-ho-1",
    runtime: "claude",
    text: "same text",
    is_internal: false,
    kind: "prompt",
    handed: [(701L, 101L, false)],
  })
  mgr1.pending_prompts.push(CarriedHandoverPrompt::{
    id: "chat:compact-ho-1:100-aaaa1111-2",
    session_key: "chat:compact-ho-1",
    runtime: "claude",
    text: "same text",
    is_internal: false,
    kind: "prompt",
    handed: [(701L, 102L, false)],
  })
  if !mgr1.has_handover_carry_state() {
    panic("has_handover_carry_state must be true when pending_prompts is non-empty")
  }
  let exported = mgr1.export_handover_state_json()
  let mgr2 = LiveRunnerManager::new()
  mgr2.import_handover_state_json(exported)
  // Second import of the EXACT same snapshot (dual-path carry + disk) must be strictly idempotent!
  mgr2.import_handover_state_json(exported)
  if mgr2.pending_prompts.length() != 2
  || mgr2.pending_prompts[0].id != "chat:compact-ho-1:100-aaaa1111-1"
  || mgr2.pending_prompts[1].id != "chat:compact-ho-1:100-aaaa1111-2"
  || mgr2.pending_prompts[0].handed.length() != 1
  || mgr2.pending_prompts[0].handed[0] != (701L, 101L, false)
  || mgr2.pending_prompts[1].handed.length() != 1
  || mgr2.pending_prompts[1].handed[0] != (701L, 102L, false) {
    panic("idempotent double-import must preserve both distinct identical-text messages and their exact handed tokens")
  }

  // R6/R7 P1-2: Pre-commit durable snapshot + Phase 0 writeback of `cid`!
  let mgr3 = LiveRunnerManager::new()
  let a1 = station_sessions::SessionActor::new("s-ho-1", "claude")
  let a2 = station_sessions::SessionActor::new("s-ho-2", "claude")
  let _ = a1.begin_compaction("compact:1", "claude", 1000L)
  let _ = a1.submit_input("keep-me-session-1", handed=[(701L, 50L, false)])
  let _ = a2.begin_compaction("compact:1", "claude", 1000L)
  let _ = a2.submit_input("keep-me-session-2", handed=[(701L, 51L, false)])
  let mut persisted_snap : Option[base_codec::Json] = None
  match mgr3.carry_compacting_actors_two_phase(
    [("s-ho-1", a1), ("s-ho-2", a2)],
    fn(k : String, _a : station_sessions::SessionActor) -> Result[Unit, String] {
      if k == "s-ho-2" { Err("simulated SQLite busy") } else { Ok(()) }
    },
    persist_snapshot_fn=fn() -> Result[Unit, String] {
      persisted_snap = Some(mgr3.export_handover_state_json())
      Ok(())
    },
    wall_ms=1700000001000L,
    nonce="abcd1234",
  ) {
    Err(_) => ()
    Ok(_) => panic("expected Err when 2nd session DB commit fails")
  }
  if a1.queue.length() != 1 || a2.queue.length() != 1 {
    panic("two-phase handover failure must NOT clear actor queues")
  }
  // Phase 0 MUST have written `cid` back to `q.meta.carried_id` so retrying handover does not duplicate!
  if a1.queue[0].meta.carried_id is None || a2.queue[0].meta.carried_id is None {
    panic("Phase 0 must write allocated cid back to actor queue meta.carried_id")
  }
  match persisted_snap {
    Some(snap_j) => {
      let mgr_rec = LiveRunnerManager::new()
      mgr_rec.import_handover_state_json(snap_j)
      if mgr_rec.pending_prompts.length() != 2
      || mgr_rec.pending_prompts[0].handed.length() != 1
      || mgr_rec.pending_prompts[0].handed[0] != (701L, 50L, false) {
        panic("persisted pre-commit snapshot must recover both sessions' inputs and exact handed tokens")
      }
    }
    None => panic("persist_snapshot_fn must run BEFORE fallible SQLite commits")
  }

  // R7 Item 4: Phase 0 disk write failure MUST abort IMMEDIATELY before invoking `commit_fn`!
  let mgr_disk_fail = LiveRunnerManager::new()
  let af = station_sessions::SessionActor::new("s-disk-fail", "claude")
  let _ = af.begin_compaction("compact:1", "claude", 1000L)
  let _ = af.submit_input("must-not-run-commit")
  let mut commit_called = 0
  match mgr_disk_fail.carry_compacting_actors_two_phase(
    [("s-disk-fail", af)],
    fn(_k : String, _a : station_sessions::SessionActor) -> Result[Unit, String] {
      commit_called = commit_called + 1
      Ok(())
    },
    persist_snapshot_fn=fn() -> Result[Unit, String] { Err("ENOSPC: disk full") },
    wall_ms=1700000002000L,
    nonce="deadbeef",
  ) {
    Err(e) => if !e.contains("ENOSPC") { panic("expected ENOSPC error, got " + e) }
    Ok(_) => panic("Phase 0 disk failure must abort handover")
  }
  if commit_called != 0 || af.queue.length() != 1 {
    panic("Phase 0 disk failure must abort BEFORE calling commit_fn or clearing queue")
  }

  // R7 Item 3: Consecutive 2-generation handover across two managers MUST keep generation 2's new input!
  let gen1 = LiveRunnerManager::new()
  let ag1 = station_sessions::SessionActor::new("s-gen", "claude")
  let _ = ag1.begin_compaction("compact:1", "claude", 1000L)
  let _ = ag1.submit_input("gen1-msg", handed=[(701L, 1L, false)])
  let _ = gen1.carry_compacting_actors_two_phase([("s-gen", ag1)], fn(_, _) { Ok(()) }, wall_ms=1000L, nonce="11111111")
  let gen1_snap = gen1.export_handover_state_json()
  let gen2 = LiveRunnerManager::new()
  gen2.import_handover_state_json(gen1_snap)
  let _ = gen2.confirm_carried_prompt_ids([gen1.pending_prompts[0].id])
  // Now in generation 2, a new compaction queues a new prompt -> distinct (wall_ms, nonce) -> NEVER collides with gen1!
  let ag2 = station_sessions::SessionActor::new("s-gen", "claude")
  let _ = ag2.begin_compaction("compact:2", "claude", 2000L)
  let _ = ag2.submit_input("gen2-msg", handed=[(701L, 2L, false)])
  let _ = gen2.carry_compacting_actors_two_phase([("s-gen", ag2)], fn(_, _) { Ok(()) }, wall_ms=2000L, nonce="22222222")
  if gen2.pending_prompts.length() != 1 || gen2.pending_prompts[0].text != "gen2-msg" {
    panic("generation 2 handover must keep its new prompt without colliding with generation 1 id")
  }

  // R6/R7 Item 1 & 2: Exact HandedToken binding on Prompt A, queued Prompt B, Steer C,
  // AND zero drift across `drain_barriers`, `stop_with_pending`, and `check_steer_silent`!
  let ab_actor = station_sessions::SessionActor::new("s-ab-1", "claude")
  let _ = ab_actor.begin_compaction("compact:1", "claude", 1000L)
  let _ = ab_actor.enqueue_barrier()
  let _ = ab_actor.submit_input("msg-A", handed=[(701L, 1L, false)])
  let _ = ab_actor.enqueue_barrier()
  let _ = ab_actor.submit_input("msg-B", handed=[(701L, 2L, false)])
  let drained = ab_actor.drain_barriers()
  if drained.length() != 2
  || ab_actor.queue.length() != 2
  || ab_actor.queue[0].meta.handed[0] != (701L, 1L, false)
  || ab_actor.queue[1].meta.handed[0] != (701L, 2L, false) {
    panic("drain_barriers must preserve exact QueuedWork work+meta alignment")
  }
  let _ = ab_actor.finish_compaction(true, None, 1010L)
  if ab_actor.started_entries.length() != 1
  || ab_actor.started_entries[0].meta.handed[0] != (701L, 1L, false)
  || ab_actor.queue.length() != 1
  || ab_actor.queue[0].meta.handed[0] != (701L, 2L, false) {
    panic("started prompt A must carry (701, 1) while queued prompt B retains (701, 2)")
  }
  // `stop_with_pending` clears prompts/steers while keeping non-prompt work with its exact meta!
  let stop_actor = station_sessions::SessionActor::new("s-stop-meta", "claude")
  stop_actor.begin_start()
  let _ = stop_actor.submit_input("drop-p", handed=[(701L, 30L, false)])
  stop_actor.push_queue_with_meta(
    station_sessions::ActorWork::InternalPrompt("keep-int"),
    station_sessions::WorkDeliveryMeta::{ handed: [(701L, 31L, true)], carried_id: Some("cid-int") },
  )
  let sres = stop_actor.stop_with_pending(true, false)
  if sres.cleared_queued != 1
  || stop_actor.queue.length() != 1
  || stop_actor.queue[0].meta.handed[0] != (701L, 31L, true)
  || stop_actor.queue[0].meta.carried_id != Some("cid-int") {
    panic("stop_with_pending must keep remaining work+meta aligned")
  }
  // `check_steer_silent` drops only silence steers while keeping pre-existing steer's exact handed token!
  let silent_actor = station_sessions::SessionActor::new("s-silent-meta", "claude")
  let _ = silent_actor.submit_input("running-turn", handed=[(701L, 40L, false)])
  let _ = silent_actor.submit_input("pre-steer", handed=[(701L, 41L, false)])
  silent_actor.on_mid_wait_steered(1000L)
  let _ = silent_actor.submit_input("during-silence", handed=[(701L, 42L, false)])
  match silent_actor.check_steer_silent(1000L + station_sessions::STEER_SILENT_MS + 1L, false) {
    station_sessions::SteerSilentOutcome::EndHung(_) => ()
    _ => panic("expected EndHung")
  }
  if silent_actor.queue.length() != 1
  || silent_actor.queue[0].meta.handed[0] != (701L, 41L, false) {
    panic("check_steer_silent must preserve pre-existing steer with its exact handed token (701, 41)")
  }
  // Steer C while Running carries exact handed token (701, 11) through `pop_next_with_meta` -> `WriteCommitMeta`!
  let steer_actor = station_sessions::SessionActor::new("s-steer-1", "claude")
  let _ = steer_actor.submit_input("turn-1", handed=[(701L, 10L, false)])
  match steer_actor.submit_input("steer-C", handed=[(701L, 11L, false)]) {
    station_sessions::InputRoute::Steer => ()
    _ => panic("expected InputRoute::Steer while Running")
  }
  match steer_actor.pop_next_with_meta() {
    Some((station_sessions::ActorWork::Steer(stxt), smeta)) => {
      let scommit = WriteCommitMeta::from_delivery_meta(smeta)
      if stxt != "steer-C" || scommit.handed.length() != 1 || scommit.handed[0] != (701L, 11L, false) {
        panic("steer must preserve exact handed token (701, 11) in WriteCommitMeta")
      }
    }
    _ => panic("expected Steer with metadata")
  }

  // R6/R7 P1-3 & Item 5: `restore_carried_pending_prompts_into_hub` preserves `handed` + keeps `pending_prompts`
  // until `UNIX_WRITE` + SQLite `mark_handed_delivered` BOTH succeed; transient SQLite failure queues
  // `pending_db_acks` and clears `pending_prompts` ONLY when retry succeeds!
  let hub_new = station_sessions::SessionHub::new()
  let mgr_new = LiveRunnerManager::new()
  mgr_new.import_handover_state_json(exported)
  let r_cnt1 = mgr_new.restore_carried_pending_prompts_into_hub(hub_new)
  let r_cnt2 = mgr_new.restore_carried_pending_prompts_into_hub(hub_new)
  if r_cnt1 != 2 || r_cnt2 != 0 {
    panic("restore_carried_pending_prompts_into_hub must restore once and be idempotent")
  }
  match hub_new.actors.get("chat:compact-ho-1") {
    Some(ra) => if ra.started_entries.length() != 1 || ra.started_entries[0].meta.handed[0] != (701L, 101L, false) {
      panic("restored prompt must preserve exact handed token (701, 101)")
    }
    None => panic("expected restored actor")
  }
  if mgr_new.pending_prompts.length() != 2 {
    panic("pending_prompts must NOT be cleared before UNIX_WRITE + SQLite confirmation")
  }
  // Simulate UNIX_WRITE Ok + transient SQLite failure -> deferred to `pending_db_acks`, `pending_prompts` STILL intact!
  let mut persist_calls = 0
  let ok_first = mgr_new.commit_written_delivery_with(
    "chat:compact-ho-1",
    WriteCommitMeta::{ handed: [(701L, 101L, false)], carried_ids: ["chat:compact-ho-1:100-aaaa1111-1"] },
    5000L,
    fn(_, _, _) { Err("SQLITE_BUSY") },
    fn() { persist_calls = persist_calls + 1 },
  )
  if ok_first || mgr_new.pending_db_acks.length() != 1 || mgr_new.pending_prompts.length() != 2 || persist_calls != 0 {
    panic("transient SQLite failure must defer to pending_db_acks without clearing pending_prompts")
  }
  // Retry on tick succeeds -> `pending_db_acks` drained, prompt 1 removed from `pending_prompts`, disk synced!
  let settled = mgr_new.retry_pending_db_acks_with(
    fn(_, _, _) { Ok(()) },
    fn() { persist_calls = persist_calls + 1 },
  )
  if settled != 1 || mgr_new.pending_db_acks.length() != 0 || mgr_new.pending_prompts.length() != 1 || persist_calls != 1 {
    panic("retry_pending_db_acks_with must settle ack, remove confirmed prompt, and persist snapshot")
  }
  let rem2 = mgr_new.confirm_carried_prompt_ids(["chat:compact-ho-1:100-aaaa1111-2"])
  if rem2 != 1 || mgr_new.pending_prompts.length() != 0 {
    panic("confirming prompt 2 must empty pending_prompts")
  }
  mgr_new.import_handover_state_json(exported)
  if mgr_new.pending_prompts.length() != 0 {
    panic("re-importing already-confirmed snapshot must remain idempotent (0 duplicates)")
  }

  // R5 P1-3(b): Codex `turn/started` MUST reject missing `threadId` (`None`) and mismatched `threadId`!
  if codex_turn_started_matches_session(None, Some("th-A")) {
    panic("Codex turn/started with missing threadId must be rejected")
  }
  if codex_turn_started_matches_session(Some("th-B"), Some("th-A")) {
    panic("Codex turn/started with mismatched threadId must be rejected")
  }
  if !codex_turn_started_matches_session(Some("th-A"), Some("th-A")) {
    panic("Codex turn/started with matching threadId must be accepted")
  }
}
