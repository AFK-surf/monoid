  remote_id : String
  v2_bytes : Bool
  is_front : Bool
  queued_at_ms : Int64
}

struct PendingFileStream {
  plan : StreamFilePlan
  mut cur_offset : Int64
  v2_bytes : Bool
  is_front : Bool
}

struct FrontStreamState {
  sock_id : Int64
  opened_at : Int64
  mut last_activity_ms : Int64
  mut header_done : Bool
  mut conn_id : Int64
  mut stream_id : Int64
  mut kind : Int
  mut head_buf : Bytes
  mut frame_left : Int
  mut payload_buf : Bytes
  mut rpc_header_line : Option[String]
  mut rpc_expect_binary : Bool
  mut max_binary_buf : Int
  mut rpc_dispatched : Bool
  mut awaiting_accept : Bool
  mut pending_eof : Bool
  mut put_ctx : Option[StreamPutCtx]
}

struct ActiveVaultRun {
  id : String
  ev_id : Int64
  workspace : String
  peer : String
  handle : station_sys::ChildProcess
  secret_values : Array[String]
  deadline_ms : Int64
  mut grant_exp_sec : Int64
  capture : Bool
  used : Bool
  mut stdout_buf : Bytes
  mut stderr_buf : Bytes
  mut cut : Bool
  mut timed_out : Bool
  mut exited : Bool
  mut exit_code : Option[Int]
  mut exit_signal : Option[String]
  mut stdout_eof : Bool
  mut stderr_eof : Bool
}

fn is_zstd_magic(b : Bytes) -> Bool {
  b.length() >= 4
  && (b[0].to_int() & 0xFF) == 0x28
  && (b[1].to_int() & 0xFF) == 0xB5
  && (b[2].to_int() & 0xFF) == 0x2F
  && (b[3].to_int() & 0xFF) == 0xFD
}

fn is_permanent_tell_refusal(err_msg : String) -> Bool {
  err_msg.contains("unknown task")
  || err_msg.contains("ref is required")
  || err_msg.contains("refused")
  || err_msg.contains("not a rig")
  || err_msg.contains("unknown method")
}

fn read_u32_be(b : Bytes, off : Int) -> Int64 {
  let b0 = (b[off].to_int() & 0xFF).to_int64()
  let b1 = (b[off + 1].to_int() & 0xFF).to_int64()
  let b2 = (b[off + 2].to_int() & 0xFF).to_int64()
  let b3 = (b[off + 3].to_int() & 0xFF).to_int64()
  (b0 * 16777216L) + (b1 * 65536L) + (b2 * 256L) + b3
}

fn read_u64_be(b : Bytes, off : Int) -> Int64 {
  let hi = read_u32_be(b, off)
  let lo = read_u32_be(b, off + 4)
  (hi * 4294967296L) + lo
}

fn write_u32_be(buf : Bytes, off : Int, v : Int64) -> Unit {
  buf[off] = ((v / 16777216L) & 0xFFL).to_int() as Byte
  buf[off + 1] = ((v / 65536L) & 0xFFL).to_int() as Byte
  buf[off + 2] = ((v / 256L) & 0xFFL).to_int() as Byte
  buf[off + 3] = (v & 0xFFL).to_int() as Byte
}

fn front_encode_frames(data : Bytes) -> Bytes {
  if data.length() == 0 {
    return Bytes::new(0)
  }
  let mut at = 0
  let mut out = Bytes::new(0)
  while at < data.length() {
    let take = if data.length() - at > FRONT_FRAME_MOST { FRONT_FRAME_MOST } else { data.length() - at }
    let frame = Bytes::new(4 + take)
    write_u32_be(frame, 0, take.to_int64())
    for i in 0..<take {
      frame[4 + i] = data[at + i]
    }
    out = concat_bytes_local(out, frame)
    at = at + take
  }
  out
}

fn front_encode_end_frame() -> Bytes {
  let out = Bytes::new(4)
  write_u32_be(out, 0, FRONT_FRAME_END)
  out
}

fn front_encode_failed_frame(msg : String) -> Bytes {
  let mb = msg.to_bytes()
  let out = Bytes::new(8 + mb.length())
  write_u32_be(out, 0, FRONT_FRAME_FAILED)
  write_u32_be(out, 4, mb.length().to_int64())
  for i in 0..<mb.length() {
    out[8 + i] = mb[i]
  }
  out
}

/// Inspect a completed outbound tell reply JSON: returns `(should_retry, optional_vault_until_sec)`.
fn parse_tell_reply(reply_str : String) -> (Bool, Option[Int64]) {
  let trimmed = reply_str.trim()
  if trimmed.length() == 0 {
    return (true, None)
  }
  match base_codec::json_parse(trimmed) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Obj(_)) => {
      let rj = match base_codec::json_parse(trimmed) {
        base_codec::JsonParseResult::Ok(j) => j
        _ => base_codec::json_null()
      }
      match base_codec::json_get(rj, "error") {
        Some(base_codec::Json::Str(emsg)) => (!is_permanent_tell_refusal(emsg), None)
        Some(_) => (true, None)
        None => {
          let until_opt : Option[Int64] = match base_codec::json_get(rj, "result") {
            Some(res_obj) => match base_codec::json_get(res_obj, "until") {
              Some(base_codec::Json::Num(d, _)) => if d.to_int64() > 0L { Some(d.to_int64()) } else { None }
              _ => None
            }
            None => match base_codec::json_get(rj, "until") {
              Some(base_codec::Json::Num(d, _)) => if d.to_int64() > 0L { Some(d.to_int64()) } else { None }
              _ => None
            }
          }
          (false, until_opt)
        }
      }
    }
    _ => (true, None)
  }
}

fn concat_bytes_local(a : Bytes, b : Bytes) -> Bytes {
  if a.length() == 0 {
    return b
  }
  if b.length() == 0 {
    return a
  }
  let out = Bytes::new(a.length() + b.length())
  for i in 0..<a.length() {
    out[i] = a[i]
  }
  for j in 0..<b.length() {
    out[a.length() + j] = b[j]
  }
  out
}

fn slice_bytes_local(b : Bytes, start : Int, end : Int) -> Bytes {
  let s = if start < 0 { 0 } else if start > b.length() { b.length() } else { start }
  let e = if end < s { s } else if end > b.length() { b.length() } else { end }
  let out = Bytes::new(e - s)
  for i in 0..<(e - s) {
    out[i] = b[s + i]
  }
  out
}

fn find_newline_byte(b : Bytes) -> Int {
  for i in 0..<b.length() {
    if (b[i].to_int() & 0xFF) == 10 {
      return i
    }
  }
  -1
}

fn bytes_to_str_local(b : Bytes, len : Int) -> String {
  let sb = StringBuilder::new()
  let n = if len < b.length() { len } else { b.length() }
  for i in 0..<n {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

fn call_envelope(
  mux : builders_core::ShellMux,
  owner : Int,
  kind : Int,
  tag : Int64,
  env : mesh_door::ShellEnvelope,
) -> Unit {
  let _ = mux.call_async_raw(
    builders_core::MuxToken::Tagged(owner, kind, tag),
    env.op,
    base_codec::json_stringify(env.args),
    env.bytes,
  )
}

fn rig_log(msg : String) -> Unit {
  let _ = host_shim::write_stderr_line("[rig] " + msg)
}

fn append_capped(buf : Bytes, chunk : Bytes, max_len : Int) -> (Bytes, Bool) {
  if buf.length() >= max_len {
    return (buf, true)
  }
  let avail = max_len - buf.length()
  if chunk.length() <= avail {
    (concat_bytes_local(buf, chunk), false)
  } else {
    (concat_bytes_local(buf, slice_bytes_local(chunk, 0, avail)), true)
  }
}

fn tell_backoff_ms(attempts : Int) -> Int64 {
  let mut ms = 1000L
  let mut i = 0
  while i < attempts && ms < TELL_BACKOFF_CAP_MS {
    ms = ms * 2L
    i = i + 1
  }
  if ms > TELL_BACKOFF_CAP_MS { TELL_BACKOFF_CAP_MS } else { ms }
}

fn extract_peer_ips(cloud : station_cloud::CloudStore, now_secs : Double) -> Map[String, Array[String]] {
  let out : Map[String, Array[String]] = Map::new()
  let ms = cloud.memberships(now_secs)
  for i in 0..<ms.length() {
    for pi in 0..<ms[i].peers.length() {
      let p = ms[i].peers[pi]
      let pid = match base_codec::json_get(p, "id") {
        Some(base_codec::Json::Str(s)) => s
        _ => ""
      }
      if pid.length() == 0 {
        continue
      }
      match base_codec::json_get(p, "ips") {
        Some(base_codec::Json::Arr(arr)) => {
          let ips : Array[String] = []
          for ii in 0..<arr.length() {
            match arr[ii] {
              base_codec::Json::Str(ip) => if ip.length() > 0 { ips.push(ip) }
              _ => ()
            }
          }
          if ips.length() > 0 {
            out.set(pid, ips)
          }
        }
        _ => ()
      }
    }
  }
  out
}

/// Entrypoint for `stillfail-station-pion run ...`.
pub fn run_rig_daemon(argv : Array[String]) -> Int {
  let sep = if station_sys::os_name() == "win32" { "\\" } else { "/" }
  let home = station_sys::homedir()
  let env_data = station_sys::env_get("STILLFAIL_DATA")
  let parsed = match parse_rig_run_args(argv, env_data, home, sep=sep) {
    Ok(a) => a
    Err(e) => {
      let _ = host_shim::write_stderr_line("stillfail-station-pion: " + e)
      return 2
    }
  }
  let data = parsed.data
  let run_dir = nodepath::join(sep, [data, "run"])
  let shell_dir = nodepath::join(sep, [run_dir, "shell"])
  if !host_shim::start(shell_dir, false) {
    let _ = host_shim::write_stderr_line("stillfail-station-pion: host_shim::start failed")
    return 1
  }

  let ops_fs = station_ops::shell_ops_fs()
  let _ = (ops_fs.mkdir_p)(run_dir)
  let self_pid = host_shim::pid()

  // Launcher control channel (supports `--launcher-fds`, `--launcher-pipe`, and `--control-fd`).
  let control = station_ops::LauncherChannel::new(parsed.launcher)
  let mut ctrl_connected = false
  if parsed.launcher.linked() {
    ctrl_connected = control.connect(EV_CTRL)
  }
  let _ = control.start_signals(EV_SIG)

  // Standalone exclusive lock when not started by the launcher.
  let mut held_lock : Option[station_ops::HeldLock] = None
  if !parsed.launcher.linked() {
    match station_ops::held_by(ops_fs, data, self_pid, sep=sep) {
      Some(other_pid) => {
        rig_log("another station (pid " + other_pid.to_string() + ") already holds " + data)
        control.close()
        host_shim::stop()
        return station_ops::HELD
      }
      None => ()
    }
    match station_ops::try_acquire_held(data, sep=sep) {
      station_ops::HeldAcquire::Acquired(h) => held_lock = Some(h)
      station_ops::HeldAcquire::Busy => {
        rig_log("data directory lock is held by another process: " + data)
        control.close()
        host_shim::stop()
        return station_ops::HELD
      }
      station_ops::HeldAcquire::Error => ()
    }
  }

  // Open `config.json` and `cloud.json`, then verify launcher-parity `is_rig` & `is_rig_only`.
  let env_cfg = station_sys::env_get("STILLFAIL_CONFIG")
  let cfg_res = station_ops::ConfigFile::open(
    ops_fs,
    data,
    env_config=env_cfg,
    pid=self_pid,
    sep=sep,
  )
  let cfg_raw = match cfg_res {
    Ok(c) => c.value
    Err(e) => {
      let msg = "failed to read config.json: " + station_ops::config_err_msg(e)
      rig_log(msg)
      let _ = control.failed(msg)
      control.close()
      match held_lock {
        Some(h) => {
          let _ = h.release()
        }
        None => ()
      }
      host_shim::stop()
      return 1
    }
  }

  // Launcher-parity raw `cloud.json` check (rejects `"removed_at": null` just like `data.rs:202`).
  let cloud_path = nodepath::join(sep, [data, "mesh", "cloud.json"])
  let raw_cloud_ok = match ops_fs.read_text(cloud_path) {
    Ok(raw) => is_rig_raw_cloud_json(raw)
    Err(_) => false
  }
  let shell_client = builders_core::ShellClient::new()
  let cloud = station_cloud::CloudStore::open_with_shell(data, shell_client, sep=sep)
  let now_secs = (host_shim::wall_ms() / 1000L).to_double()
  if !raw_cloud_ok || !cloud.is_rig_only(now_secs) {
    let msg = "stillfail-station-pion supports roles:rig only, but " + data + " is not a rig-only station"
    rig_log(msg)
    let _ = control.failed(msg)
    control.close()
    match held_lock {
      Some(h) => {
        let _ = h.release()
      }
      None => ()
    }
    host_shim::stop()
    return 1
  }

  // Load or generate Ed25519 station key using OS CSPRNG (`station_sys::random_bytes`).
  let key_fs = station_cloud::KeyFs::{
    read_bytes: fn(path : String) -> Result[Option[Bytes], String] {
      station_cloud::shell_read_bytes_strict(shell_client, path, sep=sep)
    },
    write_private: fn(path : String, bytes : Bytes) -> Result[Unit, String] {
      match shell_client.write_atomic(
        path,
        bytes,
        mode=station_cloud::PRIVATE_FILE_MODE,
        sync=true,
        mkdir=true,
        sep=sep,
      ) {
        Ok(_) => Ok(())
        Err(e) => Err(e.message)
      }
    },
    random_bytes: fn(n : Int) -> Result[Bytes, String] { station_sys::random_bytes(n) },
  }
  let station_key = match station_cloud::load_key(data, key_fs, sep=sep) {
    Ok(k) => k
    Err(e) => {
      let msg = "failed to load station key: " + e
      rig_log(msg)
      let _ = control.failed(msg)
      control.close()
      match held_lock {
        Some(h) => {
          let _ = h.release()
        }
        None => ()
      }
      host_shim::stop()
      return 1
    }
  }

  // Open `stillfail.db` primary writer (WAL + busy timeout + forward-tolerant migrations).
  let db_path = nodepath::join(sep, [data, "stillfail.db"])
  let store = match station_store::Store::open(db_path, wait_ms=5000, now_ms=host_shim::wall_ms()) {
    Ok(s) => s
    Err(e) => {
      let msg = "failed to open stillfail.db: " + e.message
      rig_log(msg)
      let _ = control.failed(msg)
      control.close()
      match held_lock {
        Some(h) => {
          let _ = h.release()
        }
        None => ()
      }
      host_shim::stop()
      return 1
    }
  }

  // Handover barrier: verify previous `hub.json` process identity (`pid > 1`, same UID, matching
  // `procStartTimeMs` or `mtime` within 5s) before waiting; dead/reused/{pid:1} takes over in 0ms.
  // Crucially, `control.ready` is emitted as soon as loopback admin listens (BEFORE waiting for
  // previous PID) so the Rust launcher stops the old process without deadlocking (`lifecycle.rs:653`).
  let prev_identity = station_ops::read_previous_identity(ops_fs, run_dir, self_pid, sep=sep)
  let prev_pid_opt : Option[Int] = match prev_identity {
    Some(id) => if station_ops::is_same_predecessor_alive(id) { Some(id.pid) } else { None }
    None => None
  }
  let prev_proc = station_ops::PreviousProcess::new(prev_pid_opt, host_shim::now_ms())
  let mut handover_done = prev_pid_opt is None
  let mut handover_failed = false

  let boot_id = match generate_boot_id() {
    Ok(b) => b
    Err(e) => {
      let msg = "CSPRNG boot id failed: " + e
      rig_log(msg)
      let _ = control.failed(msg)
      store.close()
      control.close()
      match held_lock {
        Some(h) => {
          let _ = h.release()
        }
        None => ()
      }
      host_shim::stop()
      return 1
    }
  }

  // Outbound peer notification queue with exponential backoff retry up to 1 hour.
  let outbound_queue : Array[OutboundTell] = []
  let active_outbounds : Map[Int64, ActiveOutbound] = Map::new()
  let mut next_outbound_id : Int64 = 1L
  let mut peer_ips = extract_peer_ips(cloud, now_secs)

  let enqueue_tell = fn(peer : String, ws : String, request : base_codec::Json) -> Unit {
    if peer.length() == 0 || peer == station_key.id {
      return
    }
    let method = match base_codec::json_get(request, "method") {
      Some(base_codec::Json::Str(m)) => m
      _ => ""
    }
    if !station_mesh::is_rig_tell(method) {
      return
    }
    if outbound_queue.length() >= MAX_OUTBOUND_TELLS {
      return
    }
    let ref_id = match base_codec::json_get(request, "id") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let env = base_codec::json_obj([
      ("workspace", base_codec::json_str(ws)),
      ("request", request),
    ])
    let payload = (base_codec::json_stringify(env) + "\n").to_bytes()
    let now_t = host_shim::now_ms()
    outbound_queue.push(OutboundTell::{
      peer: peer,
      method: method,
      ref_id: ref_id,
      payload: payload,
      attempts: 0,
      next_at_ms: now_t,
      created_at_ms: now_t,
    })
  }

  let requeue_outbound = fn(ob : ActiveOutbound) -> Unit {
    let now_t = host_shim::now_ms()
    if now_t - ob.created_at_ms >= TELL_RETRY_MAX_MS || outbound_queue.length() >= MAX_OUTBOUND_TELLS {
      return
    }
    let delay = tell_backoff_ms(ob.attempts)
    outbound_queue.push(OutboundTell::{
      peer: ob.peer,
      method: ob.method,
      ref_id: ob.ref_id,
      payload: ob.payload,
      attempts: ob.attempts + 1,
      next_at_ms: now_t + delay,
      created_at_ms: ob.created_at_ms,
    })
  }

  let jobs_fs = station_jobs::sys_fs(sep)
  let mut remote_opt : Option[station_jobs::RemoteManager] = None
  let mut rig_opt : Option[station_rig::Rig] = None

  let job_mgr = station_jobs::JobManager::new(
    data,
    jobs_fs,
    station_jobs::real_proc_backend(),
    "http://127.0.0.1:0/jobs/notify",
    fn(_session : String, _text : String) -> Unit {},
    fn(j : station_jobs::JobRecord) -> Unit {
      sync_job_to_store(store, j)
      match remote_opt {
        Some(rm) => {
          let _ = rm.on_job_event(j, host_shim::wall_ms())
        }
        None => ()
      }
    },
  )
  let remote_mgr = station_jobs::RemoteManager::new(
    data,
    jobs_fs,
    job_mgr,
    station_jobs::RemoteCallbacks::{
      on_task_changed: fn(t : station_jobs::RemoteTaskRecord) -> Unit {
        match t.job_id {
          Some(jid) => {
            match job_mgr.get(jid) {
              Some(j) => sync_job_to_store(store, j)
              None => ()
            }
          }
          None => ()
        }
        // P0-2: emit exact `{ method: "task.changed", ref }` when task holds a 64-hex `push` ref.
        match t.push_ref {
          Some(ref_hex) => {
            if t.source_station.length() > 0 && t.workspace.length() > 0 {
              enqueue_tell(
                t.source_station,
                t.workspace,
                base_codec::json_obj([
                  ("method", base_codec::json_str("task.changed")),
                  ("ref", base_codec::json_str(ref_hex)),
                ]),
              )
            }
          }
          None => ()
        }
      },
    },
  )
  remote_opt = Some(remote_mgr)
  let incoming_vault = station_vault::IncomingRegistry::new()
  let vault_grants = station_vault::GrantStore::new()

  let grants_path = station_cloud::rig_grants_path(data, sep=sep)
  let mut write_seq = 0
  let mut last_grants_write_err : Option[String] = None

  let build_rig_changed_payload = fn(ws : String, ended_opt : Option[station_rig::Ended]) -> base_codec::Json {
    let fields : Array[(String, base_codec::Json)] = [
      ("method", base_codec::json_str("rig.changed")),
      ("workspace", base_codec::json_str(ws)),
    ]
    match rig_opt {
      Some(r) => {
        let desc = station_rules_bridge::form_to_base(r.described(ws))
        match desc {
          base_codec::Json::Obj(dfs) => {
            for i in 0..<dfs.length() {
              fields.push(dfs[i])
            }
          }
          _ => ()
        }
      }
      None => ()
    }
    match ended_opt {
      Some(e) => {
        let ef : Array[(String, base_codec::Json)] = [
          ("workspace", base_codec::json_str(e.workspace)),
          ("request", base_codec::json_str(e.request)),
          ("station", base_codec::json_str(e.station)),
          ("session", base_codec::json_str(e.session)),
          ("why", base_codec::json_str(station_rig::ended_why_str(e.why))),
        ]
        match e.device {
          Some(d) => ef.push(("device", base_codec::json_str(d)))
          None => ()
        }
        fields.push(("ended", base_codec::json_obj(ef)))
      }
      None => ()
    }
    base_codec::json_obj(fields)
  }

  let rig_grants = station_rig::RigGrants::new(station_rig::GrantsDeps::{
    read_text: fn() -> Option[String] {
      match ops_fs.read_text(grants_path) {
        Ok(t) => Some(t)
        Err(_) => None
      }
    },
    write_text: fn(text : String) -> Unit {
      write_seq = write_seq + 1
      match station_ops::write_private(
        ops_fs,
        grants_path,
        text.to_bytes(),
        self_pid,
        write_seq,
        sep=sep,
      ) {
        Ok(_) => last_grants_write_err = None
        Err(_) => {
          last_grants_write_err = Some("failed to write grants.json")
          rig_log("failed to persist grants.json")
        }
      }
    },
    now_ms: host_shim::wall_ms,
    self_for: fn(ws : String) -> Option[station_rig::RigWs] {
      if cloud.removed() {
        return None
      }
      match (cloud.state, cloud.rig_in(ws)) {
        (Some(st), Some(r)) => {
          Some(station_rig::RigWs::{
            id: st.station,
            workspace: ws,
            owner: r.owner,
            person: r.person,
          })
        }
        _ => None
      }
    },
    workspaces: fn() -> Array[station_rig::RigWs] {
      let out : Array[station_rig::RigWs] = []
      if cloud.removed() {
        return out
      }
      let st_id = match cloud.state {
        Some(s) => s.station
        None => return out
      }
      let rms = cloud.rig_memberships((host_shim::wall_ms() / 1000L).to_double())
      for i in 0..<rms.length() {
        match rms[i].rig {
          Some(r) => {
            out.push(station_rig::RigWs::{
              id: st_id,
              workspace: rms[i].workspace,
              owner: r.owner,
              person: r.person,
            })
          }
          None => ()
        }
      }
      out
    },
    busy: fn(ws : String, st : String, sess : String) -> Bool {
      let owner = owner_of(ws, st, sess)
      let js = job_mgr.list(session_opt=Some(owner))
      for i in 0..<js.length() {
        if station_jobs::job_state_is_up(js[i].state) {
          return true
        }
      }
      false
    },
    stop: fn(ws : String, st : String, sess : String) -> Unit {
      let _ = remote_mgr.cancel_session_tasks(ws, st, sess, host_shim::wall_ms())
    },
    running: fn() -> Array[station_rig::RunningChat] {
      let out : Array[station_rig::RunningChat] = []
      let js = job_mgr.list()
      for i in 0..<js.length() {
        if station_jobs::job_state_is_up(js[i].state) {
          match parse_owner(js[i].session) {
            Some(rc) => out.push(rc)
            None => ()
          }
        }
      }
      out
    },
    ended: fn(e : station_rig::Ended) -> Unit {
      let payload = build_rig_changed_payload(e.workspace, Some(e))
      enqueue_tell(e.station, e.workspace, payload)
    },
    cut: fn(_ws : String, _dev : String, _st : Option[String], _sess : Option[String]) -> Unit {},
    changed: fn(ws : String) -> Unit {
      let payload = build_rig_changed_payload(ws, None)
      let w_s = (host_shim::wall_ms() / 1000L).to_double()
      let ms = cloud.memberships(w_s)
      for mi in 0..<ms.length() {
        if ms[mi].workspace == ws {
          for pi in 0..<ms[mi].peers.length() {
            let pid = match base_codec::json_get(ms[mi].peers[pi], "id") {
              Some(base_codec::Json::Str(s)) => s
              _ => ""
            }
            if pid.length() > 0 && pid != station_key.id {
              enqueue_tell(pid, ws, payload)
            }
          }
        }
      }
    },
    held: !handover_done,
    crypto: station_rig::default_rig_crypto(),
  })

  let cmd_log_path = nodepath::join(sep, [data, "rig", "commands.log"])
  let cmd_log = station_rig::CommandLog::new(cmd_log_path, sys_command_log_backend(jobs_fs))
  let rig = station_rig::Rig::new(
    rig_grants,
    cmd_log,
    station_rig::RigModuleDeps::{
      boot: boot_id,
      now_ms: host_shim::wall_ms,
      is_rig_workspace: fn(ws : String) -> Bool { !cloud.removed() && cloud.rig_in(ws) is Some(_) },
      owner_meta: fn(ws : String) -> Option[station_rig::RigOwnerMeta] {
        match cloud.rig_in(ws) {
          Some(r) => {
            Some(station_rig::RigOwnerMeta::{
              owner_email: r.owner_email,
              owner_name: r.owner_name,
            })
          }
          None => None
        }
      },
      on_pending_lock: fn(ws : String, hash : String) -> Unit {
        let is_home = cloud.is_home(Some(ws))
        if is_home {
          if cloud.chain(ws=None) is None && cloud.pending_lock(ws=None) is None {
            let p = station_cloud::pending_lock_path(data, sep=sep)
            write_seq = write_seq + 1
            let body = base_codec::json_stringify(base_codec::json_obj([("hash", base_codec::json_str(hash))]))
            let _ = station_ops::write_private(ops_fs, p, body.to_bytes(), self_pid, write_seq, sep=sep)
          }
        } else if cloud.chain(ws=Some(ws)) is None && cloud.pending_lock(ws=Some(ws)) is None {
          let p = station_cloud::joined_pending_path(data, ws, sep=sep)
          write_seq = write_seq + 1
          let body = base_codec::json_stringify(base_codec::json_obj([("hash", base_codec::json_str(hash))]))
          let _ = station_ops::write_private(ops_fs, p, body.to_bytes(), self_pid, write_seq, sep=sep)
        }
      },
      on_full_pending: fn(ws : String, at_s : Int64) -> Unit {
        match cloud.state {
          Some(st) => {
            st.full_pending.set(ws, at_s)
            let _ = cloud.save_state()
          }
          None => ()
        }
      },
      on_join: fn(_tok : String, _person : String, _lock : Option[String], _ws : String) -> Result[station_rig::JoinResult, String] {
        Err("rig.join requires live control-plane enrollment")
      },
      reach_device: fn(_dev : station_rig::Device) -> Result[() -> Unit, String] {
        Err("device tunneling is not available on this rig")
      },
      stop_session: fn(ws : String, st : String, sess : String) -> Unit {
        let _ = remote_mgr.cancel_session_tasks(ws, st, sess, host_shim::wall_ms())
      },
      running: fn() -> Array[station_rig::RunningChat] {
        let out : Array[station_rig::RunningChat] = []
        let js = job_mgr.list()
        for i in 0..<js.length() {
          if station_jobs::job_state_is_up(js[i].state) {
            match parse_owner(js[i].session) {
              Some(rc) => out.push(rc)
              None => ()
            }
          }
        }
        out
      },
    },
  )
  rig.pure_rig = true
  rig.devices_enabled = false
  rig_opt = Some(rig)

  // Pre-spawn grant recheck for queued remote tasks (P1-2).
  remote_mgr.can_start = Some(fn(ws : String, st : String, sess : String) -> Bool {
    rig.grants.refusal(ws, st, sess) is None
  })

  // Ways store for `ways.*` sync (P1-5).
  let stillfail_relays : Array[String] = match cloud.state {
    Some(s) => match s.stillfail_relays { Some(rs) => rs; None => s.relay_urls }
    None => []
  }
  let ways_store = station_mesh::WaysStore::new(station_key.id, stillfail_relays)

  // Real `vault.run` / `vault.capture` process runner state with bounded active tracking (P0-2, P2-11).
  let active_vault_runs : Map[Int64, ActiveVaultRun] = Map::new()
  let vault_id_to_ev : Map[String, Int64] = Map::new()
  let active_vault_ev_ids : Array[Int64] = []
  let mut next_vault_ev_id : Int64 = VAULT_EV_START

  let remove_active_vault_ev = fn(target_ev : Int64) -> Unit {
    let kept : Array[Int64] = []
    for i in 0..<active_vault_ev_ids.length() {
      if active_vault_ev_ids[i] != target_ev {
        kept.push(active_vault_ev_ids[i])
      }
    }
    active_vault_ev_ids.clear()
    for i in 0..<kept.length() {
      active_vault_ev_ids.push(kept[i])
    }
  }

  let finish_vault_run = fn(run : ActiveVaultRun) -> Unit {
    let _ = run.handle.close()
    let _ = incoming_vault.finish_run(run.id)
    active_vault_runs.remove(run.ev_id)
    vault_id_to_ev.remove(run.id)
    remove_active_vault_ev(run.ev_id)
    let result_json = if run.capture {
      let out_s = bytes_to_str_local(run.stdout_buf, run.stdout_buf.length())
      let err_s = bytes_to_str_local(run.stderr_buf, run.stderr_buf.length())
      base_codec::json_obj([
        ("code", match run.exit_code { Some(c) => base_codec::json_int(c); None => base_codec::json_null() }),
        ("signal", match run.exit_signal { Some(s) => base_codec::json_str(s); None => base_codec::json_null() }),
        ("out", base_codec::json_str(out_s)),
        ("err", base_codec::json_str(err_s)),
        ("timedOut", base_codec::json_bool(run.timed_out)),
        ("tooLong", base_codec::json_bool(run.cut)),
      ])
    } else {
      let combined = concat_bytes_local(run.stdout_buf, run.stderr_buf)
      let raw_out = bytes_to_str_local(combined, combined.length())
      let scrubbed = station_vault::scrub(raw_out, run.secret_values)
      base_codec::json_obj([
        ("code", match run.exit_code { Some(c) => base_codec::json_int(c); None => base_codec::json_null() }),
        ("signal", match run.exit_signal { Some(s) => base_codec::json_str(s); None => base_codec::json_null() }),
        ("output", base_codec::json_str(scrubbed)),
        ("cut", base_codec::json_bool(run.cut)),
        ("timedOut", base_codec::json_bool(run.timed_out)),
        ("used", base_codec::json_bool(run.used)),
      ])
    }
    enqueue_tell(
      run.peer,
      run.workspace,
      base_codec::json_obj([
        ("method", base_codec::json_str("vault.done")),
        ("id", base_codec::json_str(run.id)),
        ("result", result_json),
      ]),
    )
  }

  let lock_crypto = station_rules_bridge::lock_crypto_with(
    Some(station_cloud::shell_verifier_of_client(shell_client)),
  )

  let dispatch_hooks = RigDispatchHooks::{
    on_lock_sync: fn(ws : String, req : base_codec::Json) -> Result[base_codec::Json, String] {
      let is_home = cloud.is_home(Some(ws))
      let ws_opt : Option[String] = if is_home { None } else { Some(ws) }
      let (seq, head, genesis) = match cloud.chain(ws=ws_opt) {
        Some(ch) => {
          match ch.state {
            Some(st) => (st.seq.to_int(), Some(st.head), Some(st.genesis))
            None => (ch.entries.length(), None, None)
          }
        }
        None => (0, None, None)
      }
      let kept_form = cloud.lock_kept(ws=ws_opt)
      let kept_items : Array[station_mesh::LockEntryItem] = []
      for i in 0..<kept_form.length() {
        let h = match lock::entry_hash(kept_form[i], lock_crypto) {
          Ok(hh) => hh
          Err(_) => ""
        }
        let raw_b = station_rules_bridge::form_to_base(kept_form[i])
        let s_n = match base_codec::json_get(raw_b, "seq") {
          Some(base_codec::Json::Num(d, _)) => d.to_int()
          _ => i
        }
        if h.length() > 0 {
          kept_items.push(station_mesh::LockEntryItem::{ hash: h, seq: s_n, raw: raw_b })
        }
      }
      let apply_entries = fn(entries : Array[base_codec::Json], fork : Bool) -> Result[station_mesh::LockWriteResult, String] {
        let form_entries : Array[form::Json] = []
        for i in 0..<entries.length() {
          form_entries.push(station_rules_bridge::base_to_form(entries[i]))
        }
        let now_s = (host_shim::wall_ms() / 1000L).to_double()
        match cloud.keep_lock(form_entries, Some(now_s), ws=ws_opt, fork=fork) {
          Ok(took) => {
            let (n_seq, n_head) = match cloud.chain(ws=ws_opt) {
              Some(ch2) => {
                match ch2.state {
                  Some(st2) => (st2.seq.to_int(), Some(st2.head))
                  None => (ch2.entries.length(), None)
                }
              }
              None => (0, None)
            }
            match took.refusal {
              Some(msg) => if took.taken == 0 { Err(msg) } else { Ok(station_mesh::LockWriteResult::{ taken: took.taken, seq: n_seq, hash: n_head }) }
              None => Ok(station_mesh::LockWriteResult::{ taken: took.taken, seq: n_seq, hash: n_head })
            }
          }
          Err(e) => Err(e)
        }
      }
      station_mesh::answer_lock(
        seq,
        head,
        genesis,
        kept_items,
        req,
        fn(entries : Array[base_codec::Json]) -> Result[station_mesh::LockWriteResult, String] {
          apply_entries(entries, false)
        },
        fn(entries : Array[base_codec::Json]) -> Result[station_mesh::LockWriteResult, String] {
          apply_entries(entries, true)
        },
      )
    },
    on_ways_sync: fn(ws : String, req : base_codec::Json) -> Result[base_codec::Json, String] {
      station_mesh::answer_ways(ways_store, req, ws)
    },
    on_vault_exec: fn(req : VaultExecRequest) -> Result[Unit, String] {
      if active_vault_runs.length() >= MAX_ACTIVE_VAULT_RUNS {
        return Err("too many concurrent vault commands")
      }
      let env_strs = vault_base_env()
      for i in 0..<req.env_pairs.length() {
        let (k, v) = req.env_pairs[i]
        env_strs.push(k + "=" + v)
      }
      next_vault_ev_id = next_vault_ev_id + 2L
      let ev_id = next_vault_ev_id
      let opts = station_sys::SpawnOptions::{
        program: "/bin/sh",
        args: ["-c", req.command],
        cwd: req.cwd,
        env: Some(env_strs),
        new_pgid: true,
        strip_malloc_space_efficient: false,
        pipe_stdin: false,
        pipe_stdout: true,
        pipe_stderr: true,
      }
      match station_sys::proc_spawn(ev_id, opts) {
        Ok(cp) => {
          let was_used = !req.capture && req.env_pairs.length() > 0
          let run = ActiveVaultRun::{
            id: req.id,
            ev_id: ev_id,
            workspace: req.workspace,
            peer: req.peer,
            handle: cp,
            secret_values: req.secret_values,
            deadline_ms: host_shim::now_ms() + req.timeout_ms,
            grant_exp_sec: req.grant_exp_sec,
            capture: req.capture,
            used: was_used,
            stdout_buf: Bytes::new(0),
            stderr_buf: Bytes::new(0),
            cut: false,
            timed_out: false,
            exited: false,
            exit_code: None,
            exit_signal: None,
            stdout_eof: false,
            stderr_eof: false,
          }
          active_vault_runs.set(ev_id, run)
          vault_id_to_ev.set(req.id, ev_id)
          active_vault_ev_ids.push(ev_id)
          if was_used && req.idle_timeout_sec > 0L {
            enqueue_tell(
              req.peer,
              req.workspace,
              base_codec::json_obj([
                ("method", base_codec::json_str("vault.used")),
                ("id", base_codec::json_str(req.id)),
              ]),
            )
          }
          Ok(())
        }
        Err(e) => Err("failed to spawn vault command: " + e)
      }
    },
    on_vault_revoke: fn(peer : String, id : String) -> Unit {
      match vault_id_to_ev.get(id) {
        Some(ev_id) => {
          match active_vault_runs.get(ev_id) {
            Some(run) => {
              if run.peer == peer {
                let _ = run.handle.kill(station_sys::SIG_KILL, true)
              }
            }
            None => ()
          }
        }
        None => ()
      }
    },
    take_grants_write_err: fn() -> Option[String] {
      let e = last_grants_write_err
      last_grants_write_err = None
      e
    },
    read_under_hook: Some(fn(root : String, rel : String, offset : Int64, max_len : Int) -> Result[(Bytes, Int64), String] {
      match station_sys::read_under_nofollow(root, rel, offset, max_len.to_int64()) {
        Some(pair) => Ok(pair)
        None => Err("failed to read file safely: " + rel)
      }
    }),
    write_under_hook: Some(fn(root : String, rel : String, data : Bytes, offset : Int64, mode : Int, truncate : Bool) -> Result[Unit, String] {
      let rc = station_sys::write_under_nofollow(root, rel, data, offset, mode=mode, truncate_end=truncate)
      if rc == 1 {
        Ok(())
      } else if rc == -2 {
        Err("offset mismatch")
      } else {
        Err("failed to write file safely: " + rel)
      }
    }),
  }

  let awake = station_ops::AwakeState::new(fn(_why : String) -> Option[() -> Unit] { None })

  // Track previous roster workspaces & peers for `followRoster` cleanup (P1-8).
  let prev_peers_by_ws : Map[String, Array[String]] = Map::new()
  let prev_workspaces : Array[String] = []
  let init_ms = cloud.memberships(now_secs)
  for i in 0..<init_ms.length() {
    prev_workspaces.push(init_ms[i].workspace)
    let ids : Array[String] = []
    for pi in 0..<init_ms[i].peers.length() {
      match base_codec::json_get(init_ms[i].peers[pi], "id") {
        Some(base_codec::Json::Str(pid)) => if pid.length() > 0 { ids.push(pid) }
        _ => ()
      }
    }
    prev_peers_by_ws.set(init_ms[i].workspace, ids)
  }

  // Control flags & lifecycle state.
  let mut stopping = false
  let mut giving = false
  let mut ready_sent = false
  let mut loopback_announced = false
  let mut door_started = false
  let mut door_announced = false
  let mut jobs_adopted = false
  let mut hub_written = false
  let mut handover_warned = false
  let mut mesh_bound = false
  let mut mesh_binding = false
  let mut mesh_bind_retries = 0
  let mut next_mesh_bind_ms : Int64 = 0L
  let mut next_accept_retry_ms : Int64 = 0L
  let has_origin_init = match cloud.state {
    Some(s) => s.origin.length() > 0 && !cloud.removed()
    None => false
  }
  cloud.peers_current = !has_origin_init
  let mut mesh_ep_id : Option[Int64] = None
  let active_conns : Map[Int64, ActivePeerConn] = Map::new()
  let active_streams : Map[Int64, ActivePeerStream] = Map::new()
  let stream_ids_list : Array[Int64] = []
  let pending_zstd_puts : Map[Int64, PendingZstdPut] = Map::new()
  let pending_file_streams : Map[Int64, PendingFileStream] = Map::new()
  let pending_handover_rpcs : Array[PendingHandoverRpc] = []

  // Optional shared mesh front (`STILLFAIL_MESH_FRONT`) state.
  let front_sock_opt : Option[String] = match station_sys::env_get("STILLFAIL_MESH_FRONT") {
    Some(p) => if p.length() > 0 { Some(p) } else { None }
    None => None
  }
  let mut front_streams_path = ""
  let mut front_stream_srv_id : Option[Int64] = None
  let mut front_ctrl_id : Option[Int64] = None
  let mut front_ctrl_rx = Bytes::new(0)
  let mut front_ctrl = mesh_door::FrontControlClient::new()
  let front_ask_kind : Map[Int64, String] = Map::new()
  let front_ask_oid : Map[Int64, Int64] = Map::new()
  let front_conns : Map[Int64, ActivePeerConn] = Map::new()
  let front_streams : Map[Int64, FrontStreamState] = Map::new()
  let pending_front_by_conn : Map[Int64, Array[Int64]] = Map::new()
  let front_out_by_stream : Map[Int64, Int64] = Map::new()
  let front_out_by_sock : Map[Int64, Int64] = Map::new()
  let front_early_out_socks : Map[Int64, Int64] = Map::new()

  control.on("drain", fn() -> Unit {
    let drained_path = nodepath::join(sep, [run_dir, "drained"])
    let _ = ops_fs.write_text(drained_path, "idle\n", 420)
    let _ = control.drained("idle")
  })
  control.on("stop", fn() -> Unit { stopping = true })
  control.on("handover", fn() -> Unit { stopping = true })
  control.on("hup", fn() -> Unit {
    rig_log("received hup")
  })

  // Three non-overlapping tagged ShellMux instances backed by a single host_shim::wait loop.
  let slot_loopback = MuxSlot::{ next_ev: None }
  let slot_door = MuxSlot::{ next_ev: None }
  let slot_mesh = MuxSlot::{ next_ev: None }
  let mux_loopback = make_tagged_mux(MUX_TAG_LOOPBACK, slot_loopback)
  let mux_door = make_tagged_mux(MUX_TAG_DOOR, slot_door)
  let mux_mesh = make_tagged_mux(MUX_TAG_MESH, slot_mesh)

  // 1. Loopback HTTP server (`/healthz`, `/admin*`) — strictly local (`127.0.0.1` or launcher fd).
  let loopback_srv = station_http::HttpServer::with_defaults(mux_loopback)
  let loopback_cb = station_http::ServerCallbacks::new(fn(req : station_http::HttpRequest) -> station_http::HandlerAction {
    let q_opt : Option[String] = if req.query_raw.length() > 0 { Some(req.query_raw) } else { None }
    let place = build_loopback_place(cloud)
    let hdrs : Array[(String, String)] = []
    for hi in 0..<req.headers.length() {
      hdrs.push((req.headers[hi].name, req.headers[hi].value))
    }
    let lang = station_ops::lang_of_browser(hdrs)
    let reply = station_ops::loopback_answer(req.path, q_opt, ready_sent, place, lang)
    let resp_hdrs : Array[http1::Header] = []
    for ri in 0..<reply.headers.length() {
      let (hk, hv) = reply.headers[ri]
      resp_hdrs.push(http1::Header::new(hk, hv))
    }
    let resp = station_http::HttpResponse::{
      status: reply.status,
      reason: station_http::status_reason(reply.status),
      headers: resp_hdrs,
      body: reply.body.to_bytes(),
      chunked: false,
      close_after: false,
    }
    station_http::HandlerAction::Respond(resp)
  })
  let mut loopback_fd_used = false
  match parsed.launcher.fds {
    Some(fds) => {
      if fds.loopback >= 0 {
        loopback_srv.listen_fd(fds.loopback)
        loopback_fd_used = true
      }
    }
    None => ()
  }
  if !loopback_fd_used {
    let bind_port = match parsed.port {
      Some(p) => p
      None => 0
    }
    loopback_srv.listen_loopback(bind_port)
  }

  // 2. Minimal `AgentsDoor` (`/jobs/notify`, `/jobs/screen`, `/healthz` — zero agent tools).
  let door_srv = station_http::HttpServer::with_defaults(mux_door)
  let door_cb = station_http::ServerCallbacks::new(fn(req : station_http::HttpRequest) -> station_http::HandlerAction {
    if req.method == "GET" && req.path == "/healthz" {
      return station_http::HandlerAction::Respond(station_http::HttpResponse::text(200, "ok"))
    }
    if req.method == "POST" && req.path == "/jobs/notify" {
      let auth = match req.header("authorization") {
        Some(a) => a
        None => ""
      }
      let now_w = host_shim::wall_ms()
      let rep = job_mgr.handle_notify(auth, req.body, now_w)
      if rep.status == 200 {
        let tok = if auth.starts_with("Bearer ") { auth.slice(7, auth.length()) } else { "" }
        match job_mgr.token_to_job.get(tok) {
          Some(jid) => {
            let txt = bytes_to_str_local(req.body, req.body.length())
            let _ = station_store::add_job_notice(store.db, jid, now_w, txt)
          }
          None => ()
        }
      }
      return station_http::HandlerAction::Respond(
        station_http::HttpResponse::json(rep.status, base_codec::json_stringify(rep.body)),
      )
    }
    if req.method == "POST" && req.path == "/jobs/screen" {
      let auth = match req.header("authorization") {
        Some(a) => a
        None => ""
      }
      let body_str = bytes_to_str_local(req.body, req.body.length())
      let rep = job_mgr.handle_screen(auth, body_str, host_shim::wall_ms())
      return station_http::HandlerAction::Respond(
        station_http::HttpResponse::json(rep.status, base_codec::json_stringify(rep.body)),
      )
    }
    station_http::HandlerAction::Respond(station_http::HttpResponse::text(404, "not found"))
  })

  // 3. Direct iroh mesh endpoint (`PEER_HTTP_ALPN`, `PEER_BYTES_ALPN`, `PEER_ALPN`).
  let relay_urls : Array[String] = match cloud.state {
    Some(s) => s.relay_urls
    None => []
  }
  let discovery = match station_sys::env_get("STILLFAIL_NO_DISCOVERY") {
    Some("1") => false
    _ => true
  }
  let dht = match station_sys::env_get("STILLFAIL_NO_DHT") {
    Some("1") => false
    _ => true
  }
  let bind_addr = station_sys::env_get("STILLFAIL_MESH_BIND_ADDR")
  // Only defer direct mesh bind until `previous.gone` when a fixed non-ephemeral bind address is configured.
  let fixed_bind_addr = match bind_addr {
    Some(a) => a.length() > 0 && !a.ends_with(":0")
    None => false
  }
  let cong = station_mesh::congestion_to_str(station_mesh::congestion_of(cfg_raw))
  let start_mesh_bind = fn() -> Unit {
    if mesh_bound || mesh_binding {
      return
    }
    mesh_binding = true
    match front_sock_opt {
      Some(fsock) => {
        let dir = nodepath::dirname(sep, fsock)
        front_streams_path = nodepath::join(sep, [dir, "mesh-" + self_pid.to_string() + "-1.sock"])
        let _ = (ops_fs.remove)(front_streams_path)
        let _ = mux_mesh.call_async_raw(
          builders_core::MuxToken::Tagged(0, FRONT_TOK_LISTEN, 0L),
          "unix.listen",
          base_codec::json_stringify(base_codec::json_obj([("path", base_codec::json_str(front_streams_path))])),
          None,
        )
      }
      None => {
        let bind_env = mesh_door::direct_iroh_bind(
          station_key.seed,
          [station_mesh::PEER_HTTP_ALPN, station_mesh::PEER_BYTES_ALPN, station_mesh::PEER_ALPN],
          relay_urls,
          discovery,
          dht,
          cong,
          bind_addr=bind_addr,
        )
        call_envelope(mux_mesh, 0, MESH_TOK_BIND, 0L, bind_env)
      }
    }
  }
  if front_sock_opt is Some(_) || !fixed_bind_addr {
    start_mesh_bind()
  }

  // 4. Cloud presence WebSocket client (connects when `origin` is configured).
  let presence = station_cloud::PresenceClient::new(cloud, station_key)
  let ws_client = station_http::WsClient::new(mux_mesh)
  let mut ws_handle : Option[Int] = None
  let mut ws_connecting = false
  let mut next_ws_connect_ms = host_shim::now_ms()
  let mut next_ws_ping_ms = host_shim::now_ms() + station_cloud::PING_MS

  // Periodic timer deadlines (every timer explicitly annotated with `// timer:`).
  let now0 = host_shim::now_ms()
  // timer: launcher heartbeat every 10s
  let mut next_heartbeat_ms = now0 + 10000L
  // timer: job stop/followed/grant expiry/stream timeout tick (100ms)
  let mut next_tick_ms = now0 + 100L
  // timer: local machine disk pressure check
  let mut next_disk_ms = now0 + station_ops::DISK_EVERY_MS
  // timer: local machine awake state check
  let mut next_awake_ms = now0 + station_ops::AWAKE_EVERY_MS
  // timer: periodic jobs and remote upkeep (10m)
  let mut next_upkeep_ms = now0 + UPKEEP_EVERY_MS

  let load_probe = station_jobs::live_sys_load_probe(
    fn() -> station_jobs::RunningCounts { job_mgr.running_counts() },
    fn() -> Option[station_jobs::RelayLoad] { None },
  )
  let load_json_fn = fn() -> base_codec::Json {
    let (ld, _) = station_jobs::measure(load_probe, data, None)
    base_codec::json_obj([
      ("os", base_codec::json_str(ld.os)),
      ("arch", base_codec::json_str(ld.arch)),
      ("summary", base_codec::json_str(station_jobs::load_summary(ld))),
    ])
  }

  // Handover takeover once previous process exited (or after 40s fallback): write hub.json, start AgentsDoor, bind deferred mesh.
  let begin_handover_takeover = fn() -> Bool {
    if !hub_written {
      let hub_path = nodepath::join(sep, [run_dir, "hub.json"])
      let hub_body = format_hub_json_with_start(
        self_pid,
        station_sys::proc_start_time_ms(self_pid),
        proc_start_ticks=station_sys::proc_start_ticks(self_pid),
        boot_id=station_sys::boot_id(),
      )
      match ops_fs.write_text(hub_path, hub_body, 420) {
        Ok(_) => hub_written = true
        Err(_) => {
          let msg = "failed to write hub.json"
          rig_log(msg)
          let _ = control.failed(msg)
          return false
        }
      }
    }
    if !door_started {
      door_started = true
      let mut mcp_fd_used = false
      match parsed.launcher.fds {
        Some(fds) => {
          if fds.mcp >= 0 {
            door_srv.listen_fd(fds.mcp)
            mcp_fd_used = true
          }
        }
        None => ()
      }
      if !mcp_fd_used {
        door_srv.listen_loopback(0)
      }
    }
    if !mesh_bound && !mesh_binding && next_mesh_bind_ms == 0L {
      start_mesh_bind()
    }
    true
  }

  // Adopt existing jobs (Pion state JSON + Node `stillfail.db` rows + incoming task.json) once door_srv is listening, then open grants.
  let complete_job_adoption = fn() -> Unit {
    if jobs_adopted {
      return
    }
    jobs_adopted = true
    let w_now = host_shim::wall_ms()
    let _ = job_mgr.relaunch(w_now)
    match station_store::list_running_jobs(store.db) {
      Ok(rows) => {
        for i in 0..<rows.length() {
          let rec = store_job_to_job_record(rows[i])
          let _ = job_mgr.adopt_from_store(rec, w_now)
        }
      }
      Err(_) => ()
    }
    let _ = remote_mgr.adopt_existing(w_now)
    let _ = remote_mgr.adopt_incoming_tasks(w_now)
    rig.grants.reload()
  }

  if handover_done {
    if !begin_handover_takeover() {
      handover_failed = true
      stopping = true
    }
  }

  let front_send_ask = fn(op : String, args : Array[(String, base_codec::Json)], kind : String, oid : Int64) -> Unit {
    match front_ctrl_id {
      Some(cid) => {
        match front_ctrl.build_ask(op, args) {
          Ok((req_id, line_bytes)) => {
            front_ask_kind.set(req_id, kind)
            if oid > 0L {
              front_ask_oid.set(req_id, oid)
            }
            let _ = mux_mesh.call_async_raw(
              builders_core::MuxToken::Tagged(0, FRONT_TOK_CTRL_WRITE, req_id),
              "tcp.write",
              base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(cid))])),
              Some(line_bytes),
            )
          }
          Err(_) => ()
        }
      }
      None => ()
    }
  }

  let write_peer_reply_to_stream = fn(
    sid : Int64,
    reply_bytes : Bytes,
    stream_plan : Option[StreamFilePlan],
    v2_bytes : Bool,
    is_front : Bool,
  ) -> Unit {
    match stream_plan {
      Some(plan) => {
        pending_file_streams.set(
          sid,
          PendingFileStream::{
            plan: plan,
            cur_offset: plan.offset,
            v2_bytes: v2_bytes,
            is_front: is_front,
          },
        )
      }
      None => ()
    }
    if is_front {
      let framed = front_encode_frames(reply_bytes)
      let out = match stream_plan {
        Some(_) => framed
        None => concat_bytes_local(framed, front_encode_end_frame())
      }
      let _ = mux_mesh.call_async_raw(
        builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_WRITE, sid),
        "tcp.write",
        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sid))])),
        Some(out),
      )
    } else {
      call_envelope(mux_mesh, 0, MESH_TOK_WRITE, sid, mesh_door::direct_istream_write(sid, reply_bytes))
    }
  }

  let dispatch_peer_rpc_now = fn(
    sid : Int64,
    line : String,
    bin_opt : Option[Bytes],
    remote_id : String,
    v2_bytes : Bool,
    is_front : Bool,
  ) -> Unit {
    // Check if this is a zstd-compressed `sync.put` (binary tail OR base64 `data`) that needs async Tokio `zstd.unpack`.
    let zstd_payload : Option[Bytes] = match base_codec::json_parse(line) {
      base_codec::JsonParseResult::Ok(j) => {
        match base_codec::json_get(j, "request") {
          Some(req) => {
            let is_sync_put = match base_codec::json_get(req, "method") {
              Some(base_codec::Json::Str("sync.put")) => true
              _ => false
            }
            if is_sync_put {
              match bin_opt {
                Some(b) => if is_zstd_magic(b) { Some(b) } else { None }
                None => {
                  match base_codec::json_get(req, "data") {
                    Some(base_codec::Json::Str(b64)) => {
                      match base64::decode(b64) {
                        Ok(dec) => if is_zstd_magic(dec) { Some(dec) } else { None }
                        Err(_) => None
                      }
                    }
                    _ => None
                  }
                }
              }
            } else {
              None
            }
          }
          None => None
        }
      }
      _ => None
    }
    match zstd_payload {
      Some(zbytes) => {
        pending_zstd_puts.set(
          sid,
          PendingZstdPut::{
            sid: sid,
            line: line,
            remote_id: remote_id,
            v2_bytes: v2_bytes,
            is_front: is_front,
          },
        )
        let _ = mux_mesh.call_async_raw(
          builders_core::MuxToken::Tagged(0, MESH_TOK_ZSTD_UNPACK, sid),
          "zstd.unpack",
          base_codec::json_stringify(base_codec::json_obj([("most", base_codec::json_int(station_jobs::DIRSYNC_RAW_MAX))])),
          Some(zbytes),
        )
      }
      None => {
        let (reply_bytes, stream_plan) = handle_peer_rpc_line(
          line,
          bin_opt,
          remote_id,
          v2_bytes,
          cloud,
          cloud.peers_current,
          rig,
          remote_mgr,
          incoming_vault,
          vault_grants,
          load_json_fn,
          dispatch_hooks,
        )
        write_peer_reply_to_stream(sid, reply_bytes, stream_plan, v2_bytes, is_front)
      }
    }
  }

  let dispatch_peer_rpc_stream = fn(
    sid : Int64,
    line : String,
    bin_opt : Option[Bytes],
    remote_id : String,
    v2_bytes : Bool,
    is_front : Bool,
  ) -> Unit {
    // 1:1 alignment with `station/src/rig/module.ts:111-118`: during startup handover barrier (`!jobs_adopted`),
    // queue incoming requests until previous exits & `grants.reload()` finishes instead of refusing with `this rig is stopping`.
    if !jobs_adopted && !stopping {
      if pending_handover_rpcs.length() >= MAX_ACTIVE_STREAMS {
        let err_b = station_mesh::encode_peer_answer_err("too many queued handover requests", v2_bytes)
        write_peer_reply_to_stream(sid, err_b, None, v2_bytes, is_front)
        return
      }
      pending_handover_rpcs.push(PendingHandoverRpc::{
        sid: sid,
        line: line,
        bin_opt: bin_opt,
        remote_id: remote_id,
        v2_bytes: v2_bytes,
        is_front: is_front,
        queued_at_ms: host_shim::now_ms(),
      })
      return
    }
    dispatch_peer_rpc_now(sid, line, bin_opt, remote_id, v2_bytes, is_front)
  }

  let flush_pending_handover_rpcs = fn() -> Unit {
    if pending_handover_rpcs.length() == 0 {
      return
    }
    let queued : Array[PendingHandoverRpc] = []
    for i in 0..<pending_handover_rpcs.length() {
      queued.push(pending_handover_rpcs[i])
    }
    pending_handover_rpcs.clear()
    for i in 0..<queued.length() {
      let item = queued[i]
      dispatch_peer_rpc_now(item.sid, item.line, item.bin_opt, item.remote_id, item.v2_bytes, item.is_front)
    }
  }

  let try_start_streaming_put = fn(line : String, remote_id : String) -> Option[Result[StreamPutCtx, String]] {
    if !jobs_adopted {
      return None
    }
    let parsed = match base_codec::json_parse(line) {
      base_codec::JsonParseResult::Ok(j) => j
      base_codec::JsonParseResult::Err(_) => return None
    }
    let env = match station_mesh::decode_peer_request(parsed) {
      Ok(e) => e
      Err(_) => return None
    }
    let is_file_put = match base_codec::json_get(env.request, "method") {
      Some(base_codec::Json::Str("file.put")) => true
      _ => false
    }
    if !is_file_put {
      return None
    }
    let now_ms = host_shim::wall_ms()
    let roster = build_cloud_roster(cloud, (now_ms / 1000L).to_double(), cloud.peers_current)
    Some(begin_streaming_file_put(roster, remote_id, env, rig, remote_mgr, now_ms))
  }

  let feed_streaming_put = fn(ctx : StreamPutCtx, chunk : Bytes) -> Result[Unit, String] {
    if chunk.length() == 0 {
      return Ok(())
    }
    if ctx.written + chunk.length().to_int64() > station_jobs::REMOTE_MAX_FILE {
      return Err("file upload exceeds 1 GiB limit")
    }
    let trunc = ctx.cur_offset == 0L
    let rc = station_sys::write_under_nofollow(ctx.work, ctx.rel, chunk, ctx.cur_offset, mode=384, truncate_end=trunc)
    if rc == 1 {
      ctx.cur_offset = ctx.cur_offset + chunk.length().to_int64()
      ctx.written = ctx.written + chunk.length().to_int64()
      Ok(())
    } else if rc == -2 {
      Err("offset mismatch")
    } else {
      Err("failed to write file safely: " + ctx.rel)
    }
  }

  let finalize_streaming_put_to_stream = fn(sid : Int64, ctx : StreamPutCtx, v2_bytes : Bool, is_front : Bool) -> Unit {
    let mut write_err : Option[String] = None
    if ctx.written == 0L {
      let rc = station_sys::write_under_nofollow(
        ctx.work,
        ctx.rel,
        Bytes::new(0),
        ctx.start_offset,
        mode=384,
        truncate_end=ctx.is_final || ctx.start_offset == 0L,
      )
      if rc == -2 {
        write_err = Some("offset mismatch")
      } else if rc != 1 {
        write_err = Some("failed to write file safely: " + ctx.rel)
      }
    } else if ctx.is_final {
      // Truncate at final end offset so shorter overwrites never retain trailing bytes.
      let rc = station_sys::write_under_nofollow(
        ctx.work,
        ctx.rel,
        Bytes::new(0),
        ctx.cur_offset,
        mode=384,
        truncate_end=true,
      )
      if rc != 1 {
        write_err = Some("failed to finalize file safely: " + ctx.rel)
      }
    }
    let reply_b = match write_err {
      Some(e) => station_mesh::encode_peer_answer_err(e, v2_bytes)
      None => match finish_streaming_file_put(remote_mgr, ctx) {
        Ok(res_j) => station_mesh::encode_peer_answer_ok(res_j, false, v2_bytes)
        Err(e) => station_mesh::encode_peer_answer_err(e, v2_bytes)
      }
    }
    write_peer_reply_to_stream(sid, reply_b, None, v2_bytes, is_front)
  }

  let reset_front_connection = fn() -> Unit {
    match front_ctrl_id {
      Some(cid) => {
        front_ctrl_id = None
        let _ = mux_mesh.call_async_raw(
          builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, cid),
          "tcp.close",
          base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(cid))])),
          None,
        )
      }
      None => ()
    }
    let _ = front_ctrl.close("front disconnected")
    front_ctrl = mesh_door::FrontControlClient::new()
    front_ctrl_rx = Bytes::new(0)
    mesh_bound = false
    mesh_binding = false
    let ak = front_ask_kind.keys()
    for i in 0..<ak.length() {
      front_ask_kind.remove(ak[i])
    }
    let ao = front_ask_oid.keys()
    for i in 0..<ao.length() {
      front_ask_oid.remove(ao[i])
    }
    let fc_ks = front_conns.keys()
    for i in 0..<fc_ks.length() {
      front_conns.remove(fc_ks[i])
    }
    let pf_ks = pending_front_by_conn.keys()
    for i in 0..<pf_ks.length() {
      match pending_front_by_conn.get(pf_ks[i]) {
        Some(sids) => {
          for si in 0..<sids.length() {
            front_streams.remove(sids[si])
            let _ = mux_mesh.call_async_raw(
              builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sids[si]),
              "tcp.close",
              base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sids[si]))])),
              None,
            )
          }
        }
        None => ()
      }
      pending_front_by_conn.remove(pf_ks[i])
    }
    let eos = front_early_out_socks.keys()
    for i in 0..<eos.length() {
      front_early_out_socks.remove(eos[i])
    }
    let fos = front_out_by_stream.keys()
    for i in 0..<fos.length() {
      front_out_by_stream.remove(fos[i])
    }
    let fsk = front_out_by_sock.keys()
    for i in 0..<fsk.length() {
      front_out_by_sock.remove(fsk[i])
    }
    if pending_handover_rpcs.length() > 0 {
      let kept_ho : Array[PendingHandoverRpc] = []
      for i in 0..<pending_handover_rpcs.length() {
        if !pending_handover_rpcs[i].is_front {
          kept_ho.push(pending_handover_rpcs[i])
        }
      }
      pending_handover_rpcs.clear()
      for i in 0..<kept_ho.length() {
        pending_handover_rpcs.push(kept_ho[i])
      }
    }
    match front_stream_srv_id {
      Some(srv_id) => {
        front_stream_srv_id = None
        let _ = mux_mesh.call_async_raw(
          builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, srv_id),
          "tcp.close",
          base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(srv_id))])),
          None,
        )
      }
      None => ()
    }
    if mesh_ep_id is None {
      let ob_ks = active_outbounds.keys()
      for i in 0..<ob_ks.length() {
        match active_outbounds.get(ob_ks[i]) {
          Some(ob) => {
            active_outbounds.remove(ob_ks[i])
            requeue_outbound(ob)
          }
          None => ()
        }
      }
    }
    if !stopping {
      // timer: front control disconnect reconnect backoff
      next_mesh_bind_ms = host_shim::now_ms() + 250L
    }
  }

  let _ = ctrl_connected

  // Main single-threaded event loop.
  while !stopping {
    let now = host_shim::now_ms()
    let wall = host_shim::wall_ms()

    // Check handover barrier if still waiting for previous process.
    // On `GoneTimedOut` (40s), log a warning once and KEEP WAITING while `prior_pid` is still alive
    // so we never overwrite `hub.json`, lift `rig.held`, or double-own jobs while the old daemon runs.
    if !handover_done {
      let check_prev = fn(_p : Int) -> Bool {
        match prev_identity {
          Some(id) => station_ops::is_same_predecessor_alive(id)
          None => false
        }
      }
      match prev_proc.rig_barrier(now, check_prev) {
        station_ops::PreviousStatus::Waiting => ()
        station_ops::PreviousStatus::Exited => {
          handover_done = true
          if !begin_handover_takeover() {
            handover_failed = true
            stopping = true
            continue
          }
        }
        station_ops::PreviousStatus::GoneTimedOut => {
          if !handover_warned {
            handover_warned = true
            rig_log("previous process still alive past 40s handover wait; keeping ownership barrier until it exits")
          }
        }
      }
    }

    // Retry mesh bind with backoff if previous process held the fixed UDP port briefly.
    if !mesh_bound && !mesh_binding && next_mesh_bind_ms > 0L && now >= next_mesh_bind_ms {
      next_mesh_bind_ms = 0L
      start_mesh_bind()
    }

    // Retry iroh.accept if a transient accept error backed off.
    if next_accept_retry_ms > 0L && now >= next_accept_retry_ms {
      next_accept_retry_ms = 0L
      match mesh_ep_id {
        Some(ep) => call_envelope(mux_mesh, 0, MESH_TOK_ACCEPT, ep, mesh_door::direct_iroh_accept(ep))
        None => ()
      }
    }

    // Announce loopback port + `control.ready` immediately once loopback listens (never block `ready` on `previous.gone`!).
    if !loopback_announced && loopback_srv.is_listening() {
      loopback_announced = true
      let port = loopback_srv.port()
      let shown = match parsed.launcher.ports {
        Some(lp) => lp.admin
        None => port
      }
      let _ = ops_fs.write_text(nodepath::join(sep, [run_dir, "ports.json"]), format_ports_json(shown), 420)
      let _ = control.serving("admin", port)
      if !ready_sent {
        ready_sent = true
        let _ = control.ready("0.1.0")
      }
      rig_log("loopback listening on 127.0.0.1:" + port.to_string())
    }

    // Announce AgentsDoor port once listening, wire `jobs.notify_url`, THEN adopt jobs, open grants & flush queued handover RPCs.
    if !door_announced && door_srv.is_listening() {
      door_announced = true
      let dport = door_srv.port()
      job_mgr.notify_url = "http://127.0.0.1:" + dport.to_string() + "/jobs/notify"
      let _ = ops_fs.write_text(station_ops::mcp_port_file(data, sep=sep), format_mcp_json(dport), 420)
      let _ = control.serving("mcp", dport)
      rig_log("agents door listening on 127.0.0.1:" + dport.to_string())
      complete_job_adoption()
      flush_pending_handover_rpcs()
    }

    // Dispatch due outbound peer tells (`rig.changed`, `task.changed`, `vault.used`, `vault.done`).
    if (mesh_ep_id is Some(_) || (front_ctrl_id is Some(_) && mesh_bound))
    && outbound_queue.length() > 0
    && active_outbounds.length() < 8
    {
      let rem_q : Array[OutboundTell] = []
      for qi in 0..<outbound_queue.length() {
        let tell = outbound_queue[qi]
        if active_outbounds.length() < 8 && now >= tell.next_at_ms {
          next_outbound_id = next_outbound_id + 1L
          let oid = next_outbound_id
          active_outbounds.set(
            oid,
            ActiveOutbound::{
              id: oid,
              peer: tell.peer,
              method: tell.method,
              ref_id: tell.ref_id,
              payload: tell.payload,
              attempts: tell.attempts,
              created_at_ms: tell.created_at_ms,
              started_at_ms: now,
              conn_id: None,
              stream_id: None,
              sock_id: None,
              reply_buf: Bytes::new(0),
            },
          )
          let ips = match peer_ips.get(tell.peer) {
            Some(list) => list
            None => []
          }
          match mesh_ep_id {
            Some(ep) => {
              call_envelope(
                mux_mesh,
                0,
                MESH_TOK_OUT_CONNECT,
                oid,
                mesh_door::direct_iroh_connect(ep, tell.peer, station_mesh::PEER_ALPN, [], relay_urls, ips=ips),
              )
            }
            None => {
              let relays_j : Array[base_codec::Json] = []
              for ri in 0..<relay_urls.length() {
                relays_j.push(base_codec::json_str(relay_urls[ri]))
              }
              let ips_j : Array[base_codec::Json] = []
              for ii in 0..<ips.length() {
                ips_j.push(base_codec::json_str(ips[ii]))
              }
              front_send_ask(
                "connect",
                [
                  (
                    "addr",
                    base_codec::json_obj([
                      ("id", base_codec::json_str(tell.peer)),
                      ("relays", base_codec::json_arr(relays_j)),
                      ("ips", base_codec::json_arr(ips_j)),
                    ]),
                  ),
                  ("alpn", base_codec::json_str(base_codec::hex_encode(station_mesh::PEER_ALPN.to_bytes()))),
                  ("additional", base_codec::json_arr([])),
                ],
                "out_connect",
                oid,
              )
            }
          }
        } else {
          rem_q.push(tell)
        }
      }
      outbound_queue.clear()
      for qi in 0..<rem_q.length() {
        outbound_queue.push(rem_q[qi])
      }
    }

    // Connect presence WebSocket if origin is set and disconnected.
    let has_origin = match cloud.state {
      Some(s) => s.origin.length() > 0 && !cloud.removed()
      None => false
    }
    if has_origin && ws_handle is None && !ws_connecting && now >= next_ws_connect_ms {
      let now_s = wall / 1000L
      match presence.prepare_connect("0.1.0", now_s, now) {
        Ok((ws_url, ws_headers, _prov)) => {
          ws_connecting = true
          let ws_opts = station_http::WsOpenOptions::{
            url: ws_url,
            headers: ws_headers,
            protocols: [],
            timeout_ms: Some(station_cloud::CONNECT_TIMEOUT_MS.to_int64()),
            entry: None,
            binary: false,
            control: true,
          }
          let _ = ws_client.open_async(1, ws_opts)
        }
        Err(_) => {
          // timer: presence connect retry backoff
          next_ws_connect_ms = now + 5000L
        }
      }
    }

    // Periodic launcher heartbeat (`--launcher-heartbeat`).
    if parsed.launcher.heartbeats && now >= next_heartbeat_ms {
      let _ = control.heartbeat()
      // timer: launcher heartbeat interval (10s)
      next_heartbeat_ms = now + 10000L
    }

    // Periodic 100ms tick: grant expiries, job stops, followed jobs, vault timeouts, stream timeouts, presence ping.
    if now >= next_tick_ms {
      rig.grants.tick()
      let _ = job_mgr.tick_stops(wall)
      let _ = job_mgr.poll_followed(wall)
      let _ = remote_mgr.drain_queue(wall)

      // Enforce `vault.run` / `vault.capture` command + grant deadlines over active runs only (bounded).
      let wall_sec = wall / 1000L
      for vi in 0..<active_vault_ev_ids.length() {
        let vev = active_vault_ev_ids[vi]
        match active_vault_runs.get(vev) {
          Some(run) => {
            let expired_grant = run.grant_exp_sec > 0L && wall_sec >= run.grant_exp_sec
            if !run.exited && !run.timed_out && (now >= run.deadline_ms || expired_grant) {
              run.timed_out = true
              let _ = run.handle.kill(station_sys::SIG_KILL, true)
            }
          }
          None => ()
        }
      }

      // Enforce 15s timeout on in-flight outbound tell slots so silent peers cannot permanently occupy slots.
      let ob_keys = active_outbounds.keys()
      for oi in 0..<ob_keys.length() {
        let oid = ob_keys[oi]
        match active_outbounds.get(oid) {
          Some(ob) => {
            if now - ob.started_at_ms >= TELL_SLOT_TIMEOUT_MS {
              active_outbounds.remove(oid)
              match ob.conn_id {
                Some(cid) => {
                  if mesh_ep_id is Some(_) {
                    call_envelope(mux_mesh, 0, MESH_TOK_OUT_CLOSE, oid, mesh_door::direct_conn_close(cid, 0, ""))
                  } else if front_ctrl_id is Some(_) {
                    front_send_ask(
                      "conn.close",
                      [("conn", base_codec::json_int64(cid)), ("code", base_codec::json_int(0)), ("reason", base_codec::json_str("timeout"))],
                      "out_close",
                      0L,
                    )
                  }
                }
                None => ()
              }
              match ob.stream_id {
                Some(fsid) => {
                  front_out_by_stream.remove(fsid)
                  front_early_out_socks.remove(fsid)
                }
                None => ()
              }
              match ob.sock_id {
                Some(sid) => {
                  front_out_by_sock.remove(sid)
                  front_streams.remove(sid)
                  let _ = mux_mesh.call_async_raw(
                    builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sid),
                    "tcp.close",
                    base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sid))])),
                    None,
                  )
                }
                None => ()
              }
              requeue_outbound(ob)
            }
          }
          None => ()
        }
      }

      // Enforce 40s wait cap on queued startup-handover RPCs so slow/stuck predecessors never leak streams forever.
      if pending_handover_rpcs.length() > 0 {
        let kept_ho : Array[PendingHandoverRpc] = []
        for hi in 0..<pending_handover_rpcs.length() {
          let item = pending_handover_rpcs[hi]
          if now - item.queued_at_ms >= station_ops::PREVIOUS_LIMIT_MS {
            let err_b = station_mesh::encode_peer_answer_err("rig handover timed out", item.v2_bytes)
            write_peer_reply_to_stream(item.sid, err_b, None, item.v2_bytes, item.is_front)
          } else {
            kept_ho.push(item)
          }
        }
        pending_handover_rpcs.clear()
        for hi in 0..<kept_ho.length() {
          pending_handover_rpcs.push(kept_ho[hi])
        }
      }

      // Enforce 15s idle inbound front stream read timeout (including streams queued awaiting `accept`).
      let f_keys = front_streams.keys()
      for fi in 0..<f_keys.length() {
        let fsid = f_keys[fi]
        match front_streams.get(fsid) {
          Some(fs) => {
            if fs.kind != 1 && !fs.rpc_dispatched && now - fs.last_activity_ms >= STREAM_READ_TIMEOUT_MS {
              front_streams.remove(fsid)
              if fs.conn_id >= 0L && front_ctrl_id is Some(_) {
                front_send_ask(
                  "conn.close",
                  [("conn", base_codec::json_int64(fs.conn_id)), ("code", base_codec::json_int(0)), ("reason", base_codec::json_str("stream timeout"))],
                  "out_close",
                  0L,
                )
              }
              let _ = mux_mesh.call_async_raw(
                builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, fsid),
                "tcp.close",
                base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(fsid))])),
                None,
              )
            }
          }
          None => ()
        }
      }

      // Enforce 15s idle inbound peer stream read timeout.
      let kept_streams : Array[Int64] = []
      for si in 0..<stream_ids_list.length() {
        let sid = stream_ids_list[si]
        match active_streams.get(sid) {
          Some(st) => {
            if now - st.last_activity_ms >= STREAM_READ_TIMEOUT_MS {
              active_streams.remove(sid)
              let err_b = station_mesh::encode_peer_answer_err("peer request timed out", st.v2_bytes)
              call_envelope(mux_mesh, 0, MESH_TOK_WRITE, sid, mesh_door::direct_istream_write(sid, err_b))
            } else {
              kept_streams.push(sid)
            }
          }
          None => ()
        }
      }
      stream_ids_list.clear()
      for si in 0..<kept_streams.length() {
        stream_ids_list.push(kept_streams[si])
      }

      match ws_handle {
        Some(wid) => {
          if now >= next_ws_ping_ms {
            let _ = ws_client.send_text_async(wid, "ping")
            // timer: presence WebSocket keepalive ping
            next_ws_ping_ms = now + station_cloud::PING_MS
          }
        }
        None => ()
      }
      // timer: grant/job/vault/stream tick (100ms)
      next_tick_ms = now + 100L
    }

    // Periodic disk pressure check.
    if now >= next_disk_ms {
      let mut tier = station_ops::DiskTier::Ok
      match station_ops::disk_space(data) {
        Some(ds) => {
          tier = station_ops::disk_tier(ds.free, ds.total)
          match tier {
            station_ops::DiskTier::Ok => ()
            station_ops::DiskTier::Soft => {
              let _ = job_mgr.upkeep(wall)
              let _ = remote_mgr.sweep(wall, low_disk=false, disk_total=Some(ds.total))
            }
            station_ops::DiskTier::Low => {
              let _ = job_mgr.upkeep(wall)
              let _ = remote_mgr.sweep(wall, low_disk=true, disk_total=Some(ds.total))
            }
          }
        }
        None => ()
      }
      // timer: local machine disk pressure sampling
      next_disk_ms = now + station_ops::disk_every(tier)
    }

    // Periodic upkeep (10m).
    if now >= next_upkeep_ms {
      let _ = job_mgr.upkeep(wall)
      let _ = remote_mgr.sweep(wall, low_disk=false, disk_total=None)
      // timer: periodic jobs and remote upkeep (10m)
      next_upkeep_ms = now + UPKEEP_EVERY_MS
    }

    // Periodic awake check.
    if now >= next_awake_ms {
      let rc = job_mgr.running_counts()
      let _ = awake.check(now, rc.remote_tasks > 0 || rc.jobs > 0 || active_vault_runs.length() > 0)
      // timer: local machine awake state sampling
      next_awake_ms = now + station_ops::AWAKE_EVERY_MS
    }

    let _ = loopback_srv.tick(loopback_cb)
    let _ = door_srv.tick(door_cb)

    // Wait up to 50ms for next OS / shell event.
    // timer: event loop wait slice (50ms)
    match host_shim::wait(50L) {
      None => ()
      Some(host_shim::HostEvent::Sys(ev_id, payload)) => {
        match station_sys::decode_sys_event(payload) {
          Some(sev) => {
            if ev_id == EV_CTRL || ev_id == EV_SIG {
              control.feed_sys_event(sev)
            } else if active_vault_runs.contains(ev_id) {
              match active_vault_runs.get(ev_id) {
                Some(run) => {
                  match sev {
                    station_sys::SysEvent::ProcStdout(chunk) => {
                      let (next_b, was_cut) = append_capped(run.stdout_buf, chunk, VAULT_OUTPUT_MAX)
                      run.stdout_buf = next_b
                      if was_cut {
                        run.cut = true
                      }
                    }
                    station_sys::SysEvent::ProcStderr(chunk) => {
                      let (next_b, was_cut) = append_capped(run.stderr_buf, chunk, VAULT_OUTPUT_MAX)
                      run.stderr_buf = next_b
                      if was_cut {
                        run.cut = true
                      }
                    }
                    station_sys::SysEvent::ProcStdoutEof => run.stdout_eof = true
                    station_sys::SysEvent::ProcStderrEof => run.stderr_eof = true
                    station_sys::SysEvent::ProcExit(es) => {
                      run.exited = true
                      run.exit_code = if es.signal == 0 { Some(es.code) } else { None }
                      run.exit_signal = if es.signal != 0 { Some(es.signal_name) } else { None }
                    }
                    _ => ()
                  }
                  if run.exited && run.stdout_eof && run.stderr_eof {
                    finish_vault_run(run)
                  }
                }
                None => ()
              }
            } else {
              let _ = job_mgr.handle_sys_event(ev_id, sev, host_shim::wall_ms())
            }
          }
          None => ()
        }
      }
      Some(host_shim::HostEvent::ShellDone(done)) => {
        let mux_tag = done.id % 4L
        let orig_id = done.id / 4L
        if mux_tag == MUX_TAG_LOOPBACK {
          slot_loopback.next_ev = Some(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{
            id: orig_id,
            error: done.error,
            json: done.json,
            bytes: done.bytes,
          }))
          let _ = mux_loopback.step(
            0L,
            fn(_l : String) -> Unit {},
            fn() -> Unit {},
            fn(tok, d) {
              let _ = loopback_srv.handle_done(tok, d, loopback_cb)
            },
          )
        } else if mux_tag == MUX_TAG_DOOR {
          slot_door.next_ev = Some(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{
            id: orig_id,
            error: done.error,
            json: done.json,
            bytes: done.bytes,
          }))
          let _ = mux_door.step(
            0L,
            fn(_l : String) -> Unit {},
            fn() -> Unit {},
            fn(tok, d) {
              let _ = door_srv.handle_done(tok, d, door_cb)
            },
          )
        } else if mux_tag == MUX_TAG_MESH {
          slot_mesh.next_ev = Some(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{
            id: orig_id,
            error: done.error,
            json: done.json,
            bytes: done.bytes,
          }))
          let _ = mux_mesh.step(
            0L,
            fn(_l : String) -> Unit {},
            fn() -> Unit {},
            fn(tok : builders_core::MuxToken, d : host_shim::ShellDone) -> Unit {
              match tok {
                builders_core::MuxToken::Tagged(owner_id, kind, tag) => {
                  if kind == MESH_TOK_BIND {
                    mesh_binding = false
                    let ep_opt : Option[Int64] = match builders_core::decode_shell_done(d) {
                      Ok((Some(base_codec::Json::Num(n, _)), _)) => Some(n.to_int64())
                      Ok((Some(v), _)) => {
                        match base_codec::json_get(v, "id") {
                          Some(base_codec::Json::Num(n, _)) => Some(n.to_int64())
                          _ => {
                            rig_log("mesh bind returned unexpected json: " + d.json)
                            None
                          }
                        }
                      }
                      Err(e) => {
                        rig_log("mesh bind failed: " + e.message)
                        None
                      }
                      _ => None
                    }
                    match ep_opt {
                      Some(ep) => {
                        mesh_ep_id = Some(ep)
                        mesh_bound = true
                        let id_arg = base_codec::json_obj([("id", base_codec::json_int64(ep))])
                        // sync: read bound local iroh sockets once after bind
                        let sockets_str = match shell_client.shell_sync_json("iroh.sockets", id_arg) {
                          Ok(sv) => base_codec::json_stringify(sv)
                          Err(_) => "[]"
                        }
                        rig_log("mesh listening rig=" + station_key.id + " sockets=" + sockets_str)
                        call_envelope(mux_mesh, 0, MESH_TOK_ACCEPT, ep, mesh_door::direct_iroh_accept(ep))
                      }
                      None => {
                        if mesh_bind_retries < 20 && !stopping {
                          mesh_bind_retries = mesh_bind_retries + 1
                          // timer: mesh bind retry backoff after handover
                          next_mesh_bind_ms = host_shim::now_ms() + 250L
                        } else {
                          let msg = "mesh bind failed permanently"
                          rig_log(msg)
                          let _ = control.failed(msg)
                          stopping = true
                        }
                      }
                    }
                  } else if kind == MESH_TOK_ACCEPT {
                    match builders_core::decode_shell_done(d) {
                      Ok((Some(v), _)) => {
                        let is_end = match base_codec::json_get(v, "en" + "d") {
                          Some(base_codec::Json::Bool(true)) => true
                          _ => false
                        }
                        if is_end {
                          return
                        }
                        match mesh_ep_id {
                          Some(ep) => {
                            if !stopping {
                              call_envelope(mux_mesh, 0, MESH_TOK_ACCEPT, ep, mesh_door::direct_iroh_accept(ep))
                            }
                          }
                          None => ()
                        }
                        let cid = match base_codec::json_get(v, "id") {
                          Some(base_codec::Json::Num(n, _)) => n.to_int64()
                          _ => -1L
                        }
                        let alpn_hex = match base_codec::json_get(v, "alpn") {
                          Some(base_codec::Json::Str(s)) => s
                          _ => ""
                        }
                        let alpn = match base_codec::hex_decode(alpn_hex) {
                          Some(b) => bytes_to_str_local(b, b.length())
                          None => alpn_hex
                        }
                        if cid >= 0L {
                          if active_conns.length() >= MAX_ACTIVE_CONNS {
                            call_envelope(mux_mesh, 0, MESH_TOK_CONN_CLOSE, cid, mesh_door::direct_conn_close(cid, 2, "too many connections"))
                            return
                          }
                          // sync: read peer Ed25519 id from in-memory iroh connection handle
                          let remote_id = match shell_client.shell_sync_json(
                            "conn.remoteId",
                            base_codec::json_obj([("id", base_codec::json_int64(cid))]),
                          ) {
                            Ok(base_codec::Json::Str(s)) => s
                            _ => ""
                          }
                          if alpn == station_mesh::PEER_ALPN || alpn == station_mesh::PEER_BYTES_ALPN {
                            active_conns.set(cid, ActivePeerConn::{ id: cid, remote_id: remote_id, alpn: alpn })
                            call_envelope(mux_mesh, 0, MESH_TOK_ACCEPT_BI, cid, mesh_door::direct_conn_accept_bi(cid))
                          } else {
                            call_envelope(mux_mesh, 0, MESH_TOK_CONN_CLOSE, cid, mesh_door::direct_conn_close(cid, 1, "unsupported alpn on rig"))
                          }
                        }
                      }
                      Err(_) => {
                        if !stopping && mesh_ep_id is Some(_) {
                          // timer: iroh.accept error retry backoff
                          next_accept_retry_ms = host_shim::now_ms() + 200L
                        }
                      }
                      _ => ()
                    }
                  } else if kind == MESH_TOK_ACCEPT_BI {
                    let cid = tag
                    match active_conns.get(cid) {
                      Some(conn) => {
                        match builders_core::decode_shell_done(d) {
                          Ok((Some(v), _)) => {
                            let is_end = match base_codec::json_get(v, "en" + "d") {
                              Some(base_codec::Json::Bool(true)) => true
                              _ => false
                            }
                            if is_end {
                              active_conns.remove(cid)
                              return
                            }
                            if !stopping {
                              call_envelope(mux_mesh, 0, MESH_TOK_ACCEPT_BI, cid, mesh_door::direct_conn_accept_bi(cid))
                            }
                            let sid = match v {
                              base_codec::Json::Num(n, _) => n.to_int64()
                              _ => match base_codec::json_get(v, "id") {
                                Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                _ => -1L
                              }
                            }
                            if sid >= 0L {
                              if active_streams.length() >= MAX_ACTIVE_STREAMS {
                                let err_b = station_mesh::encode_peer_answer_err("too many streams", conn.alpn == station_mesh::PEER_BYTES_ALPN)
                                call_envelope(mux_mesh, 0, MESH_TOK_WRITE, sid, mesh_door::direct_istream_write(sid, err_b))
                                return
                              }
                              let now_s = host_shim::now_ms()
                              active_streams.set(sid, ActivePeerStream::{
                                stream_id: sid,
                                conn_id: cid,
                                remote_id: conn.remote_id,
                                v2_bytes: conn.alpn == station_mesh::PEER_BYTES_ALPN,
                                opened_at: now_s,
                                last_activity_ms: now_s,
                                header_line: None,
                                expect_binary: false,
                                max_binary_buf: station_jobs::REMOTE_CHUNK + 65536,
                                rx_buf: Bytes::new(0),
                                put_ctx: None,
                              })
                              stream_ids_list.push(sid)
                              call_envelope(mux_mesh, 0, MESH_TOK_READ, sid, mesh_door::direct_istream_read(sid))
                            }
                          }
                          Err(_) => {
                            active_conns.remove(cid)
                          }
                          _ => ()
                        }
                      }
                      None => ()
                    }
                  } else if kind == MESH_TOK_READ {
                    let sid = tag
                    match active_streams.get(sid) {
                      Some(st) => {
                        match builders_core::decode_shell_done(d) {
                          Ok((_, Some(chunk))) => {
                            if chunk.length() > 0 {
                              st.last_activity_ms = host_shim::now_ms()
                              match st.put_ctx {
                                Some(ctx) => {
                                  match feed_streaming_put(ctx, chunk) {
                                    Ok(_) => call_envelope(mux_mesh, 0, MESH_TOK_READ, sid, mesh_door::direct_istream_read(sid))
                                    Err(e) => {
                                      active_streams.remove(sid)
                                      let err_b = station_mesh::encode_peer_answer_err(e, st.v2_bytes)
                                      call_envelope(mux_mesh, 0, MESH_TOK_WRITE, sid, mesh_door::direct_istream_write(sid, err_b))
                                    }
                                  }
                                  return
                                }
                                None => ()
                              }
                              let max_buf = if st.expect_binary {
                                st.max_binary_buf
                              } else {
                                mesh_wire::MAX_PEER_MESSAGE
                              }
                              if st.rx_buf.length() + chunk.length() > max_buf {
                                active_streams.remove(sid)
                                let err_b = station_mesh::encode_peer_answer_err("peer request too large", st.v2_bytes)
                                call_envelope(mux_mesh, 0, MESH_TOK_WRITE, sid, mesh_door::direct_istream_write(sid, err_b))
                                return
                              }
                              st.rx_buf = concat_bytes_local(st.rx_buf, chunk)
                              if st.v2_bytes && st.header_line is None {
                                let nl = find_newline_byte(st.rx_buf)
                                if nl >= 0 {
                                  let line = bytes_to_str_local(st.rx_buf, nl)
                                  let tail = slice_bytes_local(st.rx_buf, nl + 1, st.rx_buf.length())
                                  let (has_bytes, is_sync_put) = match base_codec::json_parse(line) {
                                    base_codec::JsonParseResult::Ok(j) => {
                                      let hb = match base_codec::json_get(j, "bytes") {
                                        Some(base_codec::Json::Bool(true)) => true
                                        _ => false
                                      }
                                      let sp = match base_codec::json_get(j, "request") {
                                        Some(req_j) => match base_codec::json_get(req_j, "method") {
                                          Some(base_codec::Json::Str(m)) => m == "sync.put"
                                          _ => false
                                        }
                                        None => false
                                      }
                                      (hb, sp)
                                    }
                                    _ => (false, false)
                                  }
                                  if has_bytes {
                                    st.header_line = Some(line)
                                    st.expect_binary = true
                                    if is_sync_put {
                                      st.max_binary_buf = station_jobs::DIRSYNC_PACKED_MAX + 65536
                                    }
                                    match try_start_streaming_put(line, st.remote_id) {
                                      Some(Ok(ctx)) => {
                                        st.put_ctx = Some(ctx)
                                        st.rx_buf = Bytes::new(0)
                                        match feed_streaming_put(ctx, tail) {
                                          Ok(_) => call_envelope(mux_mesh, 0, MESH_TOK_READ, sid, mesh_door::direct_istream_read(sid))
                                          Err(e) => {
                                            active_streams.remove(sid)
                                            let err_b = station_mesh::encode_peer_answer_err(e, st.v2_bytes)
                                            call_envelope(mux_mesh, 0, MESH_TOK_WRITE, sid, mesh_door::direct_istream_write(sid, err_b))
                                          }
                                        }
                                      }
                                      Some(Err(e)) => {
                                        active_streams.remove(sid)
                                        let err_b = station_mesh::encode_peer_answer_err(e, st.v2_bytes)
                                        call_envelope(mux_mesh, 0, MESH_TOK_WRITE, sid, mesh_door::direct_istream_write(sid, err_b))
                                      }
                                      None => {
                                        st.rx_buf = tail
                                        call_envelope(mux_mesh, 0, MESH_TOK_READ, sid, mesh_door::direct_istream_read(sid))
                                      }
                                    }
                                  } else {
                                    active_streams.remove(sid)
                                    dispatch_peer_rpc_stream(sid, line, None, st.remote_id, st.v2_bytes, false)
                                  }
                                } else {
                                  call_envelope(mux_mesh, 0, MESH_TOK_READ, sid, mesh_door::direct_istream_read(sid))
                                }
                              } else {
                                call_envelope(mux_mesh, 0, MESH_TOK_READ, sid, mesh_door::direct_istream_read(sid))
                              }
                            } else {
                              active_streams.remove(sid)
                              match st.put_ctx {
                                Some(ctx) => finalize_streaming_put_to_stream(sid, ctx, st.v2_bytes, false)
                                None => {
                                  let (line, bin_opt) = match st.header_line {
                                    Some(hl) => (hl, Some(st.rx_buf))
                                    None => (bytes_to_str_local(st.rx_buf, st.rx_buf.length()), None)
                                  }
                                  dispatch_peer_rpc_stream(sid, line, bin_opt, st.remote_id, st.v2_bytes, false)
                                }
                              }
                            }
                          }
                          Ok((_, None)) => {
                            active_streams.remove(sid)
                            match st.put_ctx {
                              Some(ctx) => finalize_streaming_put_to_stream(sid, ctx, st.v2_bytes, false)
                              None => {
                                let (line, bin_opt) = match st.header_line {
                                  Some(hl) => (hl, Some(st.rx_buf))
                                  None => (bytes_to_str_local(st.rx_buf, st.rx_buf.length()), None)
                                }
                                dispatch_peer_rpc_stream(sid, line, bin_opt, st.remote_id, st.v2_bytes, false)
                              }
                            }
                          }
                          Err(_) => {
                            active_streams.remove(sid)
                          }
                        }
                      }
                      None => ()
                    }
                  } else if kind == MESH_TOK_ZSTD_UNPACK {
                    let sid = tag
                    match pending_zstd_puts.get(sid) {
                      Some(pz) => {
                        pending_zstd_puts.remove(sid)
                        match builders_core::decode_shell_done(d) {
                          Ok((_, Some(plain))) => {
                            let (reply_bytes, stream_plan) = handle_peer_rpc_line(
                              pz.line,
                              Some(plain),
                              pz.remote_id,
                              pz.v2_bytes,
                              cloud,
                              cloud.peers_current,
                              rig,
                              remote_mgr,
                              incoming_vault,
                              vault_grants,
                              load_json_fn,
                              dispatch_hooks,
                            )
                            write_peer_reply_to_stream(sid, reply_bytes, stream_plan, pz.v2_bytes, pz.is_front)
                          }
                          Err(e) => {
                            let err_b = station_mesh::encode_peer_answer_err("zstd unpack failed: " + e.message, pz.v2_bytes)
                            write_peer_reply_to_stream(sid, err_b, None, pz.v2_bytes, pz.is_front)
                          }
                          _ => {
                            let err_b = station_mesh::encode_peer_answer_err("zstd unpack returned no bytes", pz.v2_bytes)
                            write_peer_reply_to_stream(sid, err_b, None, pz.v2_bytes, pz.is_front)
                          }
                        }
                      }
                      None => ()
                    }
                  } else if kind == MESH_TOK_WRITE {
                    let sid = tag
                    match builders_core::decode_shell_done(d) {
                      Err(_) => {
                        pending_file_streams.remove(sid)
                      }
                      Ok(_) => {
                        match pending_file_streams.get(sid) {
                          Some(pf) => {
                            if pf.cur_offset < pf.plan.size {
                              match station_sys::read_under_nofollow(pf.plan.root, pf.plan.rel, pf.cur_offset, station_jobs::REMOTE_CHUNK.to_int64()) {
                                Some((chunk, _)) => {
                                  if chunk.length() > 0 {
                                    pf.cur_offset = pf.cur_offset + chunk.length().to_int64()
                                    call_envelope(mux_mesh, 0, MESH_TOK_WRITE, sid, mesh_door::direct_istream_write(sid, chunk))
                                  } else {
                                    pending_file_streams.remove(sid)
                                    call_envelope(mux_mesh, 0, MESH_TOK_FINISH, sid, mesh_door::direct_istream_reset(sid, 1))
                                  }
                                }
                                None => {
                                  pending_file_streams.remove(sid)
                                  call_envelope(mux_mesh, 0, MESH_TOK_FINISH, sid, mesh_door::direct_istream_reset(sid, 1))
                                }
                              }
                            } else {
                              pending_file_streams.remove(sid)
                              call_envelope(mux_mesh, 0, MESH_TOK_FINISH, sid, mesh_door::direct_istream_finish(sid))
                            }
                          }
                          None => {
                            call_envelope(mux_mesh, 0, MESH_TOK_FINISH, sid, mesh_door::direct_istream_finish(sid))
                          }
                        }
                      }
                    }
                  } else if kind == MESH_TOK_OUT_CONNECT {
                    let oid = tag
                    match active_outbounds.get(oid) {
                      Some(ob) => {
                        match builders_core::decode_shell_done(d) {
                          Ok((Some(v), _)) => {
                            let cid = match v {
                              base_codec::Json::Num(n, _) => n.to_int64()
                              _ => match base_codec::json_get(v, "id") {
                                Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                _ => -1L
                              }
                            }
                            if cid >= 0L {
                              ob.conn_id = Some(cid)
                              call_envelope(mux_mesh, 0, MESH_TOK_OUT_OPEN_BI, oid, mesh_door::direct_conn_open_bi(cid))
                            } else {
                              active_outbounds.remove(oid)
                              requeue_outbound(ob)
                            }
                          }
                          _ => {
                            active_outbounds.remove(oid)
                            requeue_outbound(ob)
                          }
                        }
                      }
                      None => ()
                    }
                  } else if kind == MESH_TOK_OUT_OPEN_BI {
                    let oid = tag
                    match active_outbounds.get(oid) {
                      Some(ob) => {
                        match builders_core::decode_shell_done(d) {
                          Ok((Some(v), _)) => {
                            let sid = match v {
                              base_codec::Json::Num(n, _) => n.to_int64()
                              _ => match base_codec::json_get(v, "id") {
                                Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                _ => -1L
                              }
                            }
                            if sid >= 0L {
                              ob.stream_id = Some(sid)
                              call_envelope(mux_mesh, 0, MESH_TOK_OUT_WRITE, oid, mesh_door::direct_istream_write(sid, ob.payload))
                            } else {
                              match ob.conn_id {
                                Some(cid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_CLOSE, oid, mesh_door::direct_conn_close(cid, 0, ""))
                                None => ()
                              }
                              active_outbounds.remove(oid)
                              requeue_outbound(ob)
                            }
                          }
                          _ => {
                            match ob.conn_id {
                              Some(cid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_CLOSE, oid, mesh_door::direct_conn_close(cid, 0, ""))
                              None => ()
                            }
                            active_outbounds.remove(oid)
                            requeue_outbound(ob)
                          }
                        }
                      }
                      None => ()
                    }
                  } else if kind == MESH_TOK_OUT_WRITE {
                    let oid = tag
                    match active_outbounds.get(oid) {
                      Some(ob) => {
                        match builders_core::decode_shell_done(d) {
                          Ok(_) => {
                            match ob.stream_id {
                              Some(sid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_FINISH, oid, mesh_door::direct_istream_finish(sid))
                              None => {
                                active_outbounds.remove(oid)
                                requeue_outbound(ob)
                              }
                            }
                          }
                          Err(_) => {
                            match ob.conn_id {
                              Some(cid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_CLOSE, oid, mesh_door::direct_conn_close(cid, 0, ""))
                              None => ()
                            }
                            active_outbounds.remove(oid)
                            requeue_outbound(ob)
                          }
                        }
                      }
                      None => ()
                    }
                  } else if kind == MESH_TOK_OUT_FINISH {
                    let oid = tag
                    match active_outbounds.get(oid) {
                      Some(ob) => {
                        match builders_core::decode_shell_done(d) {
                          Ok(_) => {
                            match ob.stream_id {
                              Some(sid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_READ, oid, mesh_door::direct_istream_read(sid))
                              None => {
                                match ob.conn_id {
                                  Some(cid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_CLOSE, oid, mesh_door::direct_conn_close(cid, 0, ""))
                                  None => ()
                                }
                                active_outbounds.remove(oid)
                              }
                            }
                          }
                          Err(_) => {
                            match ob.conn_id {
                              Some(cid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_CLOSE, oid, mesh_door::direct_conn_close(cid, 0, ""))
                              None => ()
                            }
                            active_outbounds.remove(oid)
                            requeue_outbound(ob)
                          }
                        }
                      }
                      None => ()
                    }
                  } else if kind == MESH_TOK_OUT_READ {
                    let oid = tag
                    match active_outbounds.get(oid) {
                      Some(ob) => {
                        let mut done_read = false
                        let mut read_err = false
                        match builders_core::decode_shell_done(d) {
                          Ok((_, Some(reply_b))) => {
                            if reply_b.length() > 0 {
                              if ob.reply_buf.length() + reply_b.length() <= mesh_wire::MAX_PEER_MESSAGE {
                                ob.reply_buf = concat_bytes_local(ob.reply_buf, reply_b)
                              }
                              match ob.stream_id {
                                Some(sid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_READ, oid, mesh_door::direct_istream_read(sid))
                                None => done_read = true
                              }
                            } else {
                              done_read = true
                            }
                          }
                          Ok((_, None)) => done_read = true
                          Err(_) => {
                            done_read = true
                            read_err = true
                          }
                        }
                        if done_read {
                          let (should_retry, until_opt) = if read_err {
                            (true, None)
                          } else {
                            parse_tell_reply(bytes_to_str_local(ob.reply_buf, ob.reply_buf.length()))
                          }
                          if !should_retry && ob.method == "vault.used" && ob.ref_id.length() > 0 {
                            match until_opt {
                              Some(until_sec) => {
                                match vault_id_to_ev.get(ob.ref_id) {
                                  Some(vev) => match active_vault_runs.get(vev) {
                                    Some(run) => run.grant_exp_sec = until_sec
                                    None => ()
                                  }
                                  None => ()
                                }
                              }
                              None => ()
                            }
                          }
                          match ob.conn_id {
                            Some(cid) => call_envelope(mux_mesh, 0, MESH_TOK_OUT_CLOSE, oid, mesh_door::direct_conn_close(cid, 0, ""))
                            None => ()
                          }
                          active_outbounds.remove(oid)
                          if should_retry {
                            requeue_outbound(ob)
                          }
                        }
                      }
                      None => ()
                    }
                  } else if kind == FRONT_TOK_LISTEN {
                    match builders_core::decode_shell_done(d) {
                      Ok((Some(v), _)) => {
                        let srv_id = match base_codec::json_get(v, "id") {
                          Some(base_codec::Json::Num(n, _)) => n.to_int64()
                          _ => -1L
                        }
                        if srv_id >= 0L {
                          front_stream_srv_id = Some(srv_id)
                          let _ = mux_mesh.call_async_raw(
                            builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_ACCEPT, srv_id),
                            "tcp.accept",
                            base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(srv_id))])),
                            None,
                          )
                          match front_sock_opt {
                            Some(fsock) => {
                              let _ = mux_mesh.call_async_raw(
                                builders_core::MuxToken::Tagged(0, FRONT_TOK_OPEN, 0L),
                                "unix.open",
                                base_codec::json_stringify(base_codec::json_obj([("path", base_codec::json_str(fsock))])),
                                None,
                              )
                            }
                            None => ()
                          }
                        } else {
                          mesh_binding = false
                        }
                      }
                      Err(e) => {
                        mesh_binding = false
                        rig_log("front unix.listen failed: " + e.message)
                        if mesh_bind_retries < 20 && !stopping {
                          mesh_bind_retries = mesh_bind_retries + 1
                          // timer: front bind retry backoff
                          next_mesh_bind_ms = host_shim::now_ms() + 250L
                        }
                      }
                      _ => mesh_binding = false
                    }
                  } else if kind == FRONT_TOK_OPEN {
                    match builders_core::decode_shell_done(d) {
                      Ok((Some(v), _)) => {
                        let cid = match base_codec::json_get(v, "id") {
                          Some(base_codec::Json::Num(n, _)) => n.to_int64()
                          _ => -1L
                        }
                        if cid >= 0L {
                          front_ctrl_id = Some(cid)
                          let _ = mux_mesh.call_async_raw(
                            builders_core::MuxToken::Tagged(0, FRONT_TOK_CTRL_READ, cid),
                            "tcp.read",
                            base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(cid))])),
                            None,
                          )
                          let alpns_j = base_codec::json_arr([
                            base_codec::json_str(base_codec::hex_encode(station_mesh::PEER_HTTP_ALPN.to_bytes())),
                            base_codec::json_str(base_codec::hex_encode(station_mesh::PEER_BYTES_ALPN.to_bytes())),
                            base_codec::json_str(base_codec::hex_encode(station_mesh::PEER_ALPN.to_bytes())),
                          ])
                          let relays_j : Array[base_codec::Json] = []
                          for ri in 0..<relay_urls.length() {
                            relays_j.push(base_codec::json_str(relay_urls[ri]))
                          }
                          // Match `station/src/mesh/front.ts:582-592` 1:1 so `front.mbt:identity_of` reuses the existing endpoint across `Node -> Pion` handovers with 0ms disruption!
                          let opt_fields : Array[(String, base_codec::Json)] = [
                            ("alpns", alpns_j),
                            ("relayUrls", base_codec::json_arr(relays_j)),
                            ("discovery", base_codec::json_bool(discovery)),
                            ("congestion", base_codec::json_str(cong)),
                          ]
                          if !dht {
                            opt_fields.push(("dht", base_codec::json_bool(false)))
                          }
                          match bind_addr {
                            Some(ba) => if ba.length() > 0 { opt_fields.push(("bindAddr", base_codec::json_str(ba))) }
                            None => ()
                          }
                          match station_sys::env_get("STILLFAIL_MESH_DSCP") {
                            Some(ds) => {
                              match base_codec::json_parse(ds) {
                                base_codec::JsonParseResult::Ok(base_codec::Json::Num(dn, _)) => {
                                  let di = dn.to_int()
                                  if di >= 1 && di <= 63 {
                                    opt_fields.push(("dscp", base_codec::json_int(di)))
                                  }
                                }
                                _ => ()
                              }
                            }
                            None => ()
                          }
                          front_send_ask(
                            "bind",
                            [
                              ("streams", base_codec::json_str(front_streams_path)),
                              ("key", base_codec::json_str(base_codec::hex_encode(station_key.seed))),
                              ("options", base_codec::json_obj(opt_fields)),
                            ],
                            "bind",
                            0L,
                          )
                        } else {
                          mesh_binding = false
                        }
                      }
                      Err(e) => {
                        mesh_binding = false
                        rig_log("front unix.open failed: " + e.message)
                        if mesh_bind_retries < 20 && !stopping {
                          mesh_bind_retries = mesh_bind_retries + 1
                          // timer: front open retry backoff
                          next_mesh_bind_ms = host_shim::now_ms() + 250L
                        }
                      }
                      _ => mesh_binding = false
                    }
                  } else if kind == FRONT_TOK_CTRL_READ {
                    let cid = tag
                    match builders_core::decode_shell_done(d) {
                      Ok((_, Some(chunk))) => {
                        if chunk.length() > 0 {
                          front_ctrl_rx = concat_bytes_local(front_ctrl_rx, chunk)
                          while true {
                            let nl = find_newline_byte(front_ctrl_rx)
                            if nl < 0 {
                              break
                            }
                            let line = bytes_to_str_local(front_ctrl_rx, nl)
                            front_ctrl_rx = slice_bytes_local(front_ctrl_rx, nl + 1, front_ctrl_rx.length())
                            match front_ctrl.on_line(line) {
                              mesh_door::FrontReply::Ok(req_id, ok_val) => {
                                let k = match front_ask_kind.get(req_id) {
                                  Some(s) => s
                                  None => ""
                                }
                                front_ask_kind.remove(req_id)
                                let oid = match front_ask_oid.get(req_id) {
                                  Some(n) => n
                                  None => 0L
                                }
                                front_ask_oid.remove(req_id)
                                if k == "bind" {
                                  mesh_binding = false
                                  mesh_bound = true
                                  let sockets_str = match base_codec::json_get(ok_val, "sockets") {
                                    Some(sv) => base_codec::json_stringify(sv)
                                    None => "[]"
                                  }
                                  rig_log("mesh listening rig=" + station_key.id + " sockets=" + sockets_str + " via=front")
                                  front_send_ask("accept", [], "accept", 0L)
                                } else if k == "accept" {
                                  let is_end = match base_codec::json_get(ok_val, "en" + "d") {
                                    Some(base_codec::Json::Bool(true)) => true
                                    _ => false
                                  }
                                  if !is_end {
                                    if !stopping {
                                      front_send_ask("accept", [], "accept", 0L)
                                    }
                                    let fconn = match base_codec::json_get(ok_val, "conn") {
                                      Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                      _ => -1L
                                    }
                                    let remote_id = match base_codec::json_get(ok_val, "remote") {
                                      Some(base_codec::Json::Str(s)) => s
                                      _ => ""
                                    }
                                    let alpn_hex = match base_codec::json_get(ok_val, "alpn") {
                                      Some(base_codec::Json::Str(s)) => s
                                      _ => ""
                                    }
                                    let alpn = match base_codec::hex_decode(alpn_hex) {
                                      Some(b) => bytes_to_str_local(b, b.length())
                                      None => alpn_hex
                                    }
                                    if fconn >= 0L {
                                      if front_conns.length() >= MAX_ACTIVE_CONNS {
                                        front_send_ask(
                                          "conn.close",
                                          [
                                            ("conn", base_codec::json_int64(fconn)),
                                            ("code", base_codec::json_int(2)),
                                            ("reason", base_codec::json_str("too many connections")),
                                          ],
                                          "out_close",
                                          0L,
                                        )
                                        match pending_front_by_conn.get(fconn) {
                                          Some(sids) => {
                                            pending_front_by_conn.remove(fconn)
                                            for si in 0..<sids.length() {
                                              front_streams.remove(sids[si])
                                              let _ = mux_mesh.call_async_raw(
                                                builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sids[si]),
                                                "tcp.close",
                                                base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sids[si]))])),
                                                None,
                                              )
                                            }
                                          }
                                          None => ()
                                        }
                                      } else {
                                        front_conns.set(fconn, ActivePeerConn::{ id: fconn, remote_id: remote_id, alpn: alpn })
                                        front_send_ask("conn.closed", [("conn", base_codec::json_int64(fconn))], "conn_closed", fconn)
                                        // Flush any streams that arrived on `streams.sock` BEFORE this `accept` reply!
                                        match pending_front_by_conn.get(fconn) {
                                          Some(sids) => {
                                            pending_front_by_conn.remove(fconn)
                                            let v2_bytes = alpn == station_mesh::PEER_BYTES_ALPN
                                            for si in 0..<sids.length() {
                                              let psock = sids[si]
                                              match front_streams.get(psock) {
                                                Some(pfs) => {
                                                  pfs.awaiting_accept = false
                                                  pfs.last_activity_ms = host_shim::now_ms()
                                                  if pfs.pending_eof {
                                                    pfs.rpc_dispatched = true
                                                    let (line, bin_opt) = if v2_bytes {
                                                      let nl = find_newline_byte(pfs.payload_buf)
                                                      if nl >= 0 {
                                                        let ln = bytes_to_str_local(pfs.payload_buf, nl)
                                                        let tl = slice_bytes_local(pfs.payload_buf, nl + 1, pfs.payload_buf.length())
                                                        let has_b = match base_codec::json_parse(ln) {
                                                          base_codec::JsonParseResult::Ok(j) => match base_codec::json_get(j, "bytes") {
                                                            Some(base_codec::Json::Bool(true)) => true
                                                            _ => false
                                                          }
                                                          _ => false
                                                        }
                                                        if has_b { (ln, Some(tl)) } else { (ln, None) }
                                                      } else {
                                                        (bytes_to_str_local(pfs.payload_buf, pfs.payload_buf.length()), None)
                                                      }
                                                    } else {
                                                      (bytes_to_str_local(pfs.payload_buf, pfs.payload_buf.length()), None)
                                                    }
                                                    front_streams.remove(psock)
                                                    dispatch_peer_rpc_stream(psock, line, bin_opt, remote_id, v2_bytes, true)
                                                  } else {
                                                    // Check if a complete non-binary header line already arrived while queued.
                                                    let mut dispatched_now = false
                                                    if v2_bytes && pfs.rpc_header_line is None {
                                                      let nl = find_newline_byte(pfs.payload_buf)
                                                      if nl >= 0 {
                                                        let ln = bytes_to_str_local(pfs.payload_buf, nl)
                                                        let tl = slice_bytes_local(pfs.payload_buf, nl + 1, pfs.payload_buf.length())
                                                        let (has_b, is_sp) = match base_codec::json_parse(ln) {
                                                          base_codec::JsonParseResult::Ok(j) => {
                                                            let hb = match base_codec::json_get(j, "bytes") {
                                                              Some(base_codec::Json::Bool(true)) => true
                                                              _ => false
                                                            }
                                                            let sp = match base_codec::json_get(j, "request") {
                                                              Some(req_j) => match base_codec::json_get(req_j, "method") {
                                                                Some(base_codec::Json::Str(m)) => m == "sync.put"
                                                                _ => false
                                                              }
                                                              None => false
                                                            }
                                                            (hb, sp)
                                                          }
                                                          _ => (false, false)
                                                        }
                                                        if has_b {
                                                          pfs.rpc_header_line = Some(ln)
                                                          pfs.rpc_expect_binary = true
                                                          if is_sp {
                                                            pfs.max_binary_buf = station_jobs::DIRSYNC_PACKED_MAX + 65536
                                                          }
                                                          match try_start_streaming_put(ln, remote_id) {
                                                            Some(Ok(ctx)) => {
                                                              pfs.put_ctx = Some(ctx)
                                                              pfs.payload_buf = Bytes::new(0)
                                                              match feed_streaming_put(ctx, tl) {
                                                                Ok(_) => ()
                                                                Err(e) => {
                                                                  pfs.rpc_dispatched = true
                                                                  dispatched_now = true
                                                                  front_streams.remove(psock)
                                                                  let err_b = station_mesh::encode_peer_answer_err(e, v2_bytes)
                                                                  write_peer_reply_to_stream(psock, err_b, None, v2_bytes, true)
                                                                }
                                                              }
                                                            }
                                                            Some(Err(e)) => {
                                                              pfs.rpc_dispatched = true
                                                              dispatched_now = true
                                                              front_streams.remove(psock)
                                                              let err_b = station_mesh::encode_peer_answer_err(e, v2_bytes)
                                                              write_peer_reply_to_stream(psock, err_b, None, v2_bytes, true)
                                                            }
                                                            None => pfs.payload_buf = tl
                                                          }
                                                        } else {
                                                          pfs.rpc_dispatched = true
                                                          dispatched_now = true
                                                          front_streams.remove(psock)
                                                          dispatch_peer_rpc_stream(psock, ln, None, remote_id, v2_bytes, true)
                                                        }
                                                      }
                                                    }
                                                    if !dispatched_now {
                                                      let _ = mux_mesh.call_async_raw(
                                                        builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_READ, psock),
                                                        "tcp.read",
                                                        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(psock))])),
                                                        None,
                                                      )
                                                    }
                                                  }
                                                }
                                                None => ()
                                              }
                                            }
                                          }
                                          None => ()
                                        }
                                      }
                                    }
                                  }
                                } else if k == "conn_closed" && oid > 0L {
                                  front_conns.remove(oid)
                                  match pending_front_by_conn.get(oid) {
                                    Some(sids) => {
                                      pending_front_by_conn.remove(oid)
                                      for si in 0..<sids.length() {
                                        front_streams.remove(sids[si])
                                        let _ = mux_mesh.call_async_raw(
                                          builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sids[si]),
                                          "tcp.close",
                                          base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sids[si]))])),
                                          None,
                                        )
                                      }
                                    }
                                    None => ()
                                  }
                                } else if k == "out_connect" && oid > 0L {
                                  match active_outbounds.get(oid) {
                                    Some(ob) => {
                                      let fconn = match base_codec::json_get(ok_val, "conn") {
                                        Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                        _ => -1L
                                      }
                                      if fconn >= 0L {
                                        ob.conn_id = Some(fconn)
                                        front_send_ask(
                                          "openBi",
                                          [("conn", base_codec::json_int64(fconn))],
                                          "out_open",
                                          oid,
                                        )
                                      } else {
                                        active_outbounds.remove(oid)
                                        requeue_outbound(ob)
                                      }
                                    }
                                    None => ()
                                  }
                                } else if k == "out_open" && oid > 0L {
                                  match active_outbounds.get(oid) {
                                    Some(ob) => {
                                      let fsid = match ok_val {
                                        base_codec::Json::Num(n, _) => n.to_int64()
                                        _ => match base_codec::json_get(ok_val, "stream") {
                                          Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                          _ => match base_codec::json_get(ok_val, "id") {
                                            Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                            _ => -1L
                                          }
                                        }
                                      }
                                      if fsid >= 0L {
                                        ob.stream_id = Some(fsid)
                                        match front_early_out_socks.get(fsid) {
                                          Some(early_sock) => {
                                            front_early_out_socks.remove(fsid)
                                            front_out_by_sock.set(early_sock, oid)
                                            ob.sock_id = Some(early_sock)
                                            let framed = concat_bytes_local(front_encode_frames(ob.payload), front_encode_end_frame())
                                            let _ = mux_mesh.call_async_raw(
                                              builders_core::MuxToken::Tagged(0, FRONT_TOK_OUT_WRITE, oid),
                                              "tcp.write",
                                              base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(early_sock))])),
                                              Some(framed),
                                            )
                                          }
                                          None => front_out_by_stream.set(fsid, oid)
                                        }
                                      } else {
                                        active_outbounds.remove(oid)
                                        requeue_outbound(ob)
                                      }
                                    }
                                    None => ()
                                  }
                                }
                              }
                              mesh_door::FrontReply::Err(req_id, msg) => {
                                let k = match front_ask_kind.get(req_id) {
                                  Some(s) => s
                                  None => ""
                                }
                                front_ask_kind.remove(req_id)
                                let oid = match front_ask_oid.get(req_id) {
                                  Some(n) => n
                                  None => 0L
                                }
                                front_ask_oid.remove(req_id)
                                if k == "bind" {
                                  mesh_binding = false
                                  rig_log("front bind error: " + msg)
                                } else if k == "conn_closed" && oid > 0L {
                                  front_conns.remove(oid)
                                } else if (k == "out_connect" || k == "out_open") && oid > 0L {
                                  match active_outbounds.get(oid) {
                                    Some(ob) => {
                                      active_outbounds.remove(oid)
                                      requeue_outbound(ob)
                                    }
                                    None => ()
                                  }
                                }
                              }
                              _ => ()
                            }
                          }
                          if !stopping {
                            let _ = mux_mesh.call_async_raw(
                              builders_core::MuxToken::Tagged(0, FRONT_TOK_CTRL_READ, cid),
                              "tcp.read",
                              base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(cid))])),
                              None,
                            )
                          }
                        } else {
                          reset_front_connection()
                        }
                      }
                      _ => {
                        reset_front_connection()
                      }
                    }
                  } else if kind == FRONT_TOK_STREAM_ACCEPT {
                    let srv_id = tag
                    match builders_core::decode_shell_done(d) {
                      Ok((Some(v), _)) => {
                        if !stopping {
                          let _ = mux_mesh.call_async_raw(
                            builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_ACCEPT, srv_id),
                            "tcp.accept",
                            base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(srv_id))])),
                            None,
                          )
                        }
                        let sock_id = match base_codec::json_get(v, "id") {
                          Some(base_codec::Json::Num(n, _)) => n.to_int64()
                          _ => -1L
                        }
                        if sock_id >= 0L {
                          if front_streams.length() >= MAX_ACTIVE_STREAMS {
                            let _ = mux_mesh.call_async_raw(
                              builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                              "tcp.close",
                              base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                              None,
                            )
                            return
                          }
                          let now_fs = host_shim::now_ms()
                          front_streams.set(
                            sock_id,
                            FrontStreamState::{
                              sock_id: sock_id,
                              opened_at: now_fs,
                              last_activity_ms: now_fs,
                              header_done: false,
                              conn_id: -1L,
                              stream_id: -1L,
                              kind: 0,
                              head_buf: Bytes::new(0),
                              frame_left: 0,
                              payload_buf: Bytes::new(0),
                              rpc_header_line: None,
                              rpc_expect_binary: false,
                              max_binary_buf: station_jobs::REMOTE_CHUNK + 65536,
                              rpc_dispatched: false,
                              awaiting_accept: false,
                              pending_eof: false,
                              put_ctx: None,
                            },
                          )
                          let _ = mux_mesh.call_async_raw(
                            builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_READ, sock_id),
                            "tcp.read",
                            base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                            None,
                          )
                        }
                      }
                      _ => ()
                    }
                  } else if kind == FRONT_TOK_STREAM_READ {
                    let sock_id = tag
                    match front_streams.get(sock_id) {
                      Some(fs) => {
                        match builders_core::decode_shell_done(d) {
                          Ok((_, Some(chunk))) => {
                            if chunk.length() == 0 {
                              front_streams.remove(sock_id)
                              let _ = mux_mesh.call_async_raw(
                                builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                                "tcp.close",
                                base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                None,
                              )
                              return
                            }
                            fs.last_activity_ms = host_shim::now_ms()
                            let mut data = chunk
                            if !fs.header_done {
                              fs.head_buf = concat_bytes_local(fs.head_buf, data)
                              data = Bytes::new(0)
                              if fs.head_buf.length() < 17 {
                                let _ = mux_mesh.call_async_raw(
                                  builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_READ, sock_id),
                                  "tcp.read",
                                  base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                  None,
                                )
                                return
                              }
                              let kbyte = fs.head_buf[16].to_int() & 0xFF
                              let need_hdr = if kbyte == 2 || kbyte == 3 { 25 } else { 17 }
                              if fs.head_buf.length() < need_hdr {
                                let _ = mux_mesh.call_async_raw(
                                  builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_READ, sock_id),
                                  "tcp.read",
                                  base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                  None,
                                )
                                return
                              }
                              fs.conn_id = read_u64_be(fs.head_buf, 0)
                              fs.stream_id = read_u64_be(fs.head_buf, 8)
                              fs.kind = kbyte
                              fs.header_done = true
                              data = slice_bytes_local(fs.head_buf, need_hdr, fs.head_buf.length())
                              fs.head_buf = Bytes::new(0)
                              if fs.kind == 3 {
                                front_streams.remove(sock_id)
                                let _ = mux_mesh.call_async_raw(
                                  builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                                  "tcp.close",
                                  base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                  None,
                                )
                                return
                              }
                              if fs.kind == 1 {
                                match front_out_by_stream.get(fs.stream_id) {
                                  Some(oid) => {
                                    front_out_by_stream.remove(fs.stream_id)
                                    front_out_by_sock.set(sock_id, oid)
                                    match active_outbounds.get(oid) {
                                      Some(ob) => {
                                        ob.sock_id = Some(sock_id)
                                        let framed = concat_bytes_local(front_encode_frames(ob.payload), front_encode_end_frame())
                                        let _ = mux_mesh.call_async_raw(
                                          builders_core::MuxToken::Tagged(0, FRONT_TOK_OUT_WRITE, oid),
                                          "tcp.write",
                                          base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                          Some(framed),
                                        )
                                      }
                                      None => ()
                                    }
                                  }
                                  None => front_early_out_socks.set(fs.stream_id, sock_id)
                                }
                              }
                            }
                            let mut stream_eof = false
                            let mut stream_failed = false
                            while data.length() > 0 && !stream_eof && !stream_failed {
                              if fs.frame_left > 0 {
                                let take = if fs.frame_left < data.length() { fs.frame_left } else { data.length() }
                                let piece = slice_bytes_local(data, 0, take)
                                fs.frame_left = fs.frame_left - take
                                data = slice_bytes_local(data, take, data.length())
                                match fs.put_ctx {
                                  Some(ctx) => {
                                    match feed_streaming_put(ctx, piece) {
                                      Ok(_) => ()
                                      Err(e) => {
                                        fs.rpc_dispatched = true
                                        front_streams.remove(sock_id)
                                        let v2_b = match front_conns.get(fs.conn_id) {
                                          Some(c) => c.alpn == station_mesh::PEER_BYTES_ALPN
                                          None => true
                                        }
                                        let err_b = station_mesh::encode_peer_answer_err(e, v2_b)
                                        write_peer_reply_to_stream(sock_id, err_b, None, v2_b, true)
                                        return
                                      }
                                    }
                                  }
                                  None => {
                                    // If this is the first frame(s) of a `PEER_BYTES` request and the header line hasn't been parsed yet,
                                    // parse it eagerly before enforcing `max_fbuf` so >256 KiB `sync.put` / `file.put` bursts in one read never reset!
                                    if fs.kind != 1 && !fs.rpc_dispatched && fs.rpc_header_line is None {
                                      match front_conns.get(fs.conn_id) {
                                        Some(c) => {
                                          if c.alpn == station_mesh::PEER_BYTES_ALPN {
                                            let probe = concat_bytes_local(fs.payload_buf, piece)
                                            let nl = find_newline_byte(probe)
                                            if nl >= 0 && nl <= mesh_wire::MAX_PEER_MESSAGE {
                                              let line = bytes_to_str_local(probe, nl)
                                              let tail = slice_bytes_local(probe, nl + 1, probe.length())
                                              let (has_bytes, is_sync_put) = match base_codec::json_parse(line) {
                                                base_codec::JsonParseResult::Ok(j) => {
                                                  let hb = match base_codec::json_get(j, "bytes") {
                                                    Some(base_codec::Json::Bool(true)) => true
                                                    _ => false
                                                  }
                                                  let sp = match base_codec::json_get(j, "request") {
                                                    Some(req_j) => match base_codec::json_get(req_j, "method") {
                                                      Some(base_codec::Json::Str(m)) => m == "sync.put"
                                                      _ => false
                                                    }
                                                    None => false
                                                  }
                                                  (hb, sp)
                                                }
                                                _ => (false, false)
                                              }
                                              if has_bytes {
                                                fs.rpc_header_line = Some(line)
                                                fs.rpc_expect_binary = true
                                                if is_sync_put {
                                                  fs.max_binary_buf = station_jobs::DIRSYNC_PACKED_MAX + 65536
                                                }
                                                match try_start_streaming_put(line, c.remote_id) {
                                                  Some(Ok(ctx)) => {
                                                    fs.put_ctx = Some(ctx)
                                                    fs.payload_buf = Bytes::new(0)
                                                    match feed_streaming_put(ctx, tail) {
                                                      Ok(_) => continue
                                                      Err(e) => {
                                                        fs.rpc_dispatched = true
                                                        front_streams.remove(sock_id)
                                                        let err_b = station_mesh::encode_peer_answer_err(e, true)
                                                        write_peer_reply_to_stream(sock_id, err_b, None, true, true)
                                                        return
                                                      }
                                                    }
                                                  }
                                                  Some(Err(e)) => {
                                                    fs.rpc_dispatched = true
                                                    front_streams.remove(sock_id)
                                                    let err_b = station_mesh::encode_peer_answer_err(e, true)
                                                    write_peer_reply_to_stream(sock_id, err_b, None, true, true)
                                                    return
                                                  }
                                                  None => {
                                                    if tail.length() > fs.max_binary_buf {
                                                      front_streams.remove(sock_id)
                                                      let _ = mux_mesh.call_async_raw(
                                                        builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                                                        "tcp.close",
                                                        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                                        None,
                                                      )
                                                      return
                                                    }
                                                    fs.payload_buf = tail
                                                    continue
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                        None => ()
                                      }
                                    }
                                    let max_fbuf = if fs.rpc_expect_binary {
                                      fs.max_binary_buf
                                    } else {
                                      mesh_wire::MAX_PEER_MESSAGE
                                    }
                                    if fs.payload_buf.length() + piece.length() > max_fbuf {
                                      front_streams.remove(sock_id)
                                      let _ = mux_mesh.call_async_raw(
                                        builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                                        "tcp.close",
                                        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                        None,
                                      )
                                      return
                                    }
                                    fs.payload_buf = concat_bytes_local(fs.payload_buf, piece)
                                  }
                                }
                              } else {
                                let h = if fs.head_buf.length() == 0 { data } else { concat_bytes_local(fs.head_buf, data) }
                                if h.length() < 4 {
                                  fs.head_buf = h
                                  data = Bytes::new(0)
                                  break
                                }
                                let n = read_u32_be(h, 0)
                                if n == FRONT_FRAME_END {
                                  fs.head_buf = Bytes::new(0)
                                  stream_eof = true
                                  break
                                }
                                if n == FRONT_FRAME_FAILED {
                                  fs.head_buf = Bytes::new(0)
                                  stream_failed = true
                                  break
                                }
                                fs.head_buf = Bytes::new(0)
                                fs.frame_left = n.to_int()
                                data = slice_bytes_local(h, 4, h.length())
                              }
                            }
                            if fs.kind == 1 {
                              if stream_failed || stream_eof {
                                front_streams.remove(sock_id)
                                match front_out_by_sock.get(sock_id) {
                                  Some(oid) => {
                                    front_out_by_sock.remove(sock_id)
                                    match active_outbounds.get(oid) {
                                      Some(ob) => {
                                        let (should_retry, until_opt) = if stream_failed {
                                          (true, None)
                                        } else {
                                          parse_tell_reply(bytes_to_str_local(fs.payload_buf, fs.payload_buf.length()))
                                        }
                                        if !should_retry && ob.method == "vault.used" && ob.ref_id.length() > 0 {
                                          match until_opt {
                                            Some(until_sec) => {
                                              match vault_id_to_ev.get(ob.ref_id) {
                                                Some(vev) => match active_vault_runs.get(vev) {
                                                  Some(run) => run.grant_exp_sec = until_sec
                                                  None => ()
                                                }
                                                None => ()
                                              }
                                            }
                                            None => ()
                                          }
                                        }
                                        match ob.conn_id {
                                          Some(fconn) => {
                                            front_send_ask(
                                              "conn.close",
                                              [
                                                ("conn", base_codec::json_int64(fconn)),
                                                ("code", base_codec::json_int(0)),
                                                ("reason", base_codec::json_str("")),
                                              ],
                                              "out_close",
                                              0L,
                                            )
                                          }
                                          None => ()
                                        }
                                        active_outbounds.remove(oid)
                                        if should_retry {
                                          requeue_outbound(ob)
                                        }
                                      }
                                      None => ()
                                    }
                                  }
                                  None => ()
                                }
                                let _ = mux_mesh.call_async_raw(
                                  builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                                  "tcp.close",
                                  base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                  None,
                                )
                              } else {
                                let _ = mux_mesh.call_async_raw(
                                  builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_READ, sock_id),
                                  "tcp.read",
                                  base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                  None,
                                )
                              }
                            } else {
                              if stream_failed {
                                // Transport error from front: discard incomplete inbound request without dispatching!
                                front_streams.remove(sock_id)
                                let _ = mux_mesh.call_async_raw(
                                  builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                                  "tcp.close",
                                  base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                  None,
                                )
                                return
                              }
                              let conn_opt = front_conns.get(fs.conn_id)
                              match conn_opt {
                                None => {
                                  // Stream arrived before `accept` control reply: queue until `accept` resolves!
                                  fs.awaiting_accept = true
                                  if stream_eof {
                                    fs.pending_eof = true
                                  }
                                  let q = match pending_front_by_conn.get(fs.conn_id) {
                                    Some(arr) => arr
                                    None => {
                                      let fresh : Array[Int64] = []
                                      pending_front_by_conn.set(fs.conn_id, fresh)
                                      fresh
                                    }
                                  }
                                  let mut already = false
                                  for qi in 0..<q.length() {
                                    if q[qi] == sock_id {
                                      already = true
                                    }
                                  }
                                  if !already {
                                    q.push(sock_id)
                                  }
                                  return
                                }
                                Some(c) => {
                                  let remote_id = c.remote_id
                                  let v2_bytes = c.alpn == station_mesh::PEER_BYTES_ALPN
                                  if !fs.rpc_dispatched && v2_bytes && fs.rpc_header_line is None {
                                    let nl = find_newline_byte(fs.payload_buf)
                                    if nl >= 0 {
                                      let line = bytes_to_str_local(fs.payload_buf, nl)
                                      let tail = slice_bytes_local(fs.payload_buf, nl + 1, fs.payload_buf.length())
                                      let (has_bytes, is_sync_put) = match base_codec::json_parse(line) {
                                        base_codec::JsonParseResult::Ok(j) => {
                                          let hb = match base_codec::json_get(j, "bytes") {
                                            Some(base_codec::Json::Bool(true)) => true
                                            _ => false
                                          }
                                          let sp = match base_codec::json_get(j, "request") {
                                            Some(req_j) => match base_codec::json_get(req_j, "method") {
                                              Some(base_codec::Json::Str(m)) => m == "sync.put"
                                              _ => false
                                            }
                                            None => false
                                          }
                                          (hb, sp)
                                        }
                                        _ => (false, false)
                                      }
                                      if has_bytes {
                                        fs.rpc_header_line = Some(line)
                                        fs.rpc_expect_binary = true
                                        if is_sync_put {
                                          fs.max_binary_buf = station_jobs::DIRSYNC_PACKED_MAX + 65536
                                        }
                                        match try_start_streaming_put(line, remote_id) {
                                          Some(Ok(ctx)) => {
                                            fs.put_ctx = Some(ctx)
                                            fs.payload_buf = Bytes::new(0)
                                            match feed_streaming_put(ctx, tail) {
                                              Ok(_) => ()
                                              Err(e) => {
                                                fs.rpc_dispatched = true
                                                front_streams.remove(sock_id)
                                                let err_b = station_mesh::encode_peer_answer_err(e, v2_bytes)
                                                write_peer_reply_to_stream(sock_id, err_b, None, v2_bytes, true)
                                                return
                                              }
                                            }
                                          }
                                          Some(Err(e)) => {
                                            fs.rpc_dispatched = true
                                            front_streams.remove(sock_id)
                                            let err_b = station_mesh::encode_peer_answer_err(e, v2_bytes)
                                            write_peer_reply_to_stream(sock_id, err_b, None, v2_bytes, true)
                                            return
                                          }
                                          None => fs.payload_buf = tail
                                        }
                                      } else {
                                        fs.rpc_dispatched = true
                                        front_streams.remove(sock_id)
                                        dispatch_peer_rpc_stream(sock_id, line, None, remote_id, v2_bytes, true)
                                        return
                                      }
                                    }
                                  }
                                  if stream_eof && !fs.rpc_dispatched {
                                    fs.rpc_dispatched = true
                                    front_streams.remove(sock_id)
                                    match fs.put_ctx {
                                      Some(ctx) => finalize_streaming_put_to_stream(sock_id, ctx, v2_bytes, true)
                                      None => {
                                        let (line, bin_opt) = match fs.rpc_header_line {
                                          Some(hl) => (hl, Some(fs.payload_buf))
                                          None => (bytes_to_str_local(fs.payload_buf, fs.payload_buf.length()), None)
                                        }
                                        dispatch_peer_rpc_stream(sock_id, line, bin_opt, remote_id, v2_bytes, true)
                                      }
                                    }
                                  } else if !fs.rpc_dispatched {
                                    let _ = mux_mesh.call_async_raw(
                                      builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_READ, sock_id),
                                      "tcp.read",
                                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                      None,
                                    )
                                  }
                                }
                              }
                            }
                          }
                          _ => {
                            front_streams.remove(sock_id)
                            let _ = mux_mesh.call_async_raw(
                              builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                              "tcp.close",
                              base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                              None,
                            )
                          }
                        }
                      }
                      None => ()
                    }
                  } else if kind == FRONT_TOK_OUT_WRITE {
                    let oid = tag
                    match builders_core::decode_shell_done(d) {
                      Err(_) => {
                        match active_outbounds.get(oid) {
                          Some(ob) => {
                            active_outbounds.remove(oid)
                            match ob.stream_id {
                              Some(fsid) => {
                                front_out_by_stream.remove(fsid)
                                front_early_out_socks.remove(fsid)
                              }
                              None => ()
                            }
                            match ob.sock_id {
                              Some(sid) => {
                                front_out_by_sock.remove(sid)
                                front_streams.remove(sid)
                                let _ = mux_mesh.call_async_raw(
                                  builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sid),
                                  "tcp.close",
                                  base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sid))])),
                                  None,
                                )
                              }
                              None => ()
                            }
                            match ob.conn_id {
                              Some(fconn) => {
                                front_send_ask(
                                  "conn.close",
                                  [("conn", base_codec::json_int64(fconn)), ("code", base_codec::json_int(0)), ("reason", base_codec::json_str("write error"))],
                                  "out_close",
                                  0L,
                                )
                              }
                              None => ()
                            }
                            requeue_outbound(ob)
                          }
                          None => ()
                        }
                      }
                      Ok(_) => ()
                    }
                  } else if kind == FRONT_TOK_STREAM_WRITE {
                    let sock_id = tag
                    match builders_core::decode_shell_done(d) {
                      Err(_) => {
                        pending_file_streams.remove(sock_id)
                        let _ = mux_mesh.call_async_raw(
                          builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                          "tcp.close",
                          base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                          None,
                        )
                      }
                      Ok(_) => {
                        match pending_file_streams.get(sock_id) {
                          Some(pf) => {
                            if pf.cur_offset < pf.plan.size {
                              match station_sys::read_under_nofollow(pf.plan.root, pf.plan.rel, pf.cur_offset, station_jobs::REMOTE_CHUNK.to_int64()) {
                                Some((chunk, _)) => {
                                  if chunk.length() > 0 {
                                    pf.cur_offset = pf.cur_offset + chunk.length().to_int64()
                                    let framed = front_encode_frames(chunk)
                                    let _ = mux_mesh.call_async_raw(
                                      builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_WRITE, sock_id),
                                      "tcp.write",
                                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                      Some(framed),
                                    )
                                  } else {
                                    pending_file_streams.remove(sock_id)
                                    let _ = mux_mesh.call_async_raw(
                                      builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_WRITE, sock_id),
                                      "tcp.write",
                                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                      Some(front_encode_failed_frame("file truncated during read")),
                                    )
                                  }
                                }
                                None => {
                                  pending_file_streams.remove(sock_id)
                                  let _ = mux_mesh.call_async_raw(
                                    builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_WRITE, sock_id),
                                    "tcp.write",
                                    base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                    Some(front_encode_failed_frame("file read failed")),
                                  )
                                }
                              }
                            } else {
                              pending_file_streams.remove(sock_id)
                              let _ = mux_mesh.call_async_raw(
                                builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_WRITE, sock_id),
                                "tcp.write",
                                base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                                Some(front_encode_end_frame()),
                              )
                            }
                          }
                          None => {
                            let _ = mux_mesh.call_async_raw(
                              builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, sock_id),
                              "tcp.end",
                              base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(sock_id))])),
                              None,
                            )
                          }
                        }
                      }
                    }
                  } else if kind == station_http::CLIENT_TOK_WS_OPEN {
                    ws_connecting = false
                    match station_http::decode_ws_open_done(d) {
                      Ok(wid) => {
                        ws_handle = Some(wid)
                        presence.on_open(wid, host_shim::wall_ms() / 1000L)
                        let _ = ws_client.recv_async(wid)
                      }
                      Err(_) => {
                        // timer: presence reconnect backoff
                        next_ws_connect_ms = host_shim::now_ms() + 3000L
                      }
                    }
                  } else if kind == station_http::CLIENT_TOK_WS_NEXT {
                    match station_http::decode_ws_next_done(d) {
                      Ok(station_http::WsClientEvent::Text(txt)) => {
                        let w_s = host_shim::wall_ms() / 1000L
                        let w_ms = host_shim::wall_ms()
                        let res = presence.on_text_frame(txt, w_s)
                        if cloud.peers_current {
                          peer_ips = extract_peer_ips(cloud, w_s.to_double())
                        }
                        for oi in 0..<res.outbound.length() {
                          let _ = ws_client.send_text_async(owner_id, base_codec::json_stringify(res.outbound[oi]))
                        }
                        // `followRoster`: diff workspaces & peers; cancel tasks for disappeared workspaces AND peers.
                        let cur_ms = cloud.memberships(w_s.to_double())
                        let cur_ws_set : Map[String, Bool] = Map::new()
                        for ci in 0..<cur_ms.length() {
                          let ws_id = cur_ms[ci].workspace
                          cur_ws_set.set(ws_id, true)
                          let cur_ids : Array[String] = []
                          let cur_set : Map[String, Bool] = Map::new()
                          for pi in 0..<cur_ms[ci].peers.length() {
                            match base_codec::json_get(cur_ms[ci].peers[pi], "id") {
                              Some(base_codec::Json::Str(pid)) => {
                                if pid.length() > 0 {
                                  cur_ids.push(pid)
                                  cur_set.set(pid, true)
                                }
                              }
                              _ => ()
                            }
                          }
                          match prev_peers_by_ws.get(ws_id) {
                            Some(old_ids) => {
                              for oi in 0..<old_ids.length() {
                                if !cur_set.contains(old_ids[oi]) {
                                  let _ = remote_mgr.cancel_peer_tasks(ws_id, old_ids[oi], w_ms)
                                }
                              }
                            }
                            None => ()
                          }
                          prev_peers_by_ws.set(ws_id, cur_ids)
                        }
                        for wi in 0..<prev_workspaces.length() {
                          let old_ws = prev_workspaces[wi]
                          if !cur_ws_set.contains(old_ws) {
                            let _ = remote_mgr.cancel_workspace_tasks(old_ws, w_ms)
                            prev_peers_by_ws.remove(old_ws)
                          }
                        }
                        prev_workspaces.clear()
                        for ci in 0..<cur_ms.length() {
                          prev_workspaces.push(cur_ms[ci].workspace)
                        }

                        // Check if station gained a full workspace -> hand over to whole process (`becomeOther`), latched by `giving`.
                        if cloud.full_memberships(w_s.to_double()).length() > 0 {
                          if !giving {
                            giving = true
                            rig_log("full workspace detected: handing over to whole station")
                            match station_ops::find_restarter(ops_fs, data, station_ops::is_pid_alive, sep=sep) {
                              Some(target) => {
                                let _ = station_sys::proc_kill(target.pid, station_sys::SIG_USR2, false)
                              }
                              None => stopping = true
                            }
                          }
                        } else if cloud.rig_memberships(w_s.to_double()).length() == 0 {
                          for wi in 0..<prev_workspaces.length() {
                            let _ = remote_mgr.cancel_workspace_tasks(prev_workspaces[wi], w_ms)
                          }
                        }
                        let _ = ws_client.recv_async(owner_id)
                      }
                      Ok(station_http::WsClientEvent::Closed(code_opt, why)) => {
                        ws_handle = None
                        let _ = ws_client.close_async(owner_id)
                        let now_c = host_shim::now_ms()
                        let w_ms = host_shim::wall_ms()
                        let phase = presence.on_close(code_opt, why, w_ms / 1000L, now_c)
                        if has_origin {
                          cloud.peers_current = false
                        }
                        if cloud.removed() {
                          for wi in 0..<prev_workspaces.length() {
                            let _ = remote_mgr.cancel_workspace_tasks(prev_workspaces[wi], w_ms)
                          }
                        }
                        let delay = match phase {
                          station_cloud::PresencePhase::BackingOff(ms) => ms
                          _ => 3000L
                        }
                        // timer: presence reconnect backoff
                        next_ws_connect_ms = now_c + delay
                      }
                      Ok(_) => {
                        let _ = ws_client.recv_async(owner_id)
                      }
                      Err(_) => {
                        ws_handle = None
                        let _ = ws_client.close_async(owner_id)
                        if has_origin {
                          cloud.peers_current = false
                        }
                        // timer: presence reconnect backoff
                        next_ws_connect_ms = host_shim::now_ms() + 3000L
                      }
                    }
                  }
                }
                _ => ()
              }
            },
          )
        }
      }
      _ => ()
    }
  }

  // Graceful shutdown: kill any in-flight vault subprocesses, close listeners, mesh endpoint, grants, DB, and clean up `hub.json`.
  for vi in 0..<active_vault_ev_ids.length() {
    match active_vault_runs.get(active_vault_ev_ids[vi]) {
      Some(run) => {
        let _ = run.handle.kill(station_sys::SIG_KILL, true)
        let _ = run.handle.close()
      }
      None => ()
    }
  }
  remote_opt = None
  loopback_srv.close_with_callbacks(loopback_cb)
  door_srv.close_with_callbacks(door_cb)
  match mesh_ep_id {
    Some(ep) => call_envelope(mux_mesh, 0, MESH_TOK_EP_CLOSE, ep, mesh_door::direct_iroh_close(ep)),
    None => ()
  }
  match front_ctrl_id {
    Some(cid) => {
      front_send_ask("close", [], "close", 0L)
      let _ = mux_mesh.call_async_raw(
        builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, cid),
        "tcp.close",
        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(cid))])),
        None,
      )
    }
    None => ()
  }
  match front_stream_srv_id {
    Some(srv_id) => {
      let _ = mux_mesh.call_async_raw(
        builders_core::MuxToken::Tagged(0, FRONT_TOK_STREAM_END, srv_id),
        "tcp.close",
        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(srv_id))])),
        None,
      )
    }
    None => ()
  }
  if front_streams_path.length() > 0 {
    let _ = (ops_fs.remove)(front_streams_path)
  }
  match ws_handle {
    Some(wid) => {
      let _ = ws_client.close_async(wid)
    }
    None => ()
  }
  // Reconcile any recently-stopped followed jobs into `stillfail.db` before closing the store.
  let w_end = host_shim::wall_ms()
  let _ = job_mgr.poll_followed(w_end)
  let _ = job_mgr.tick_stops(w_end)
  awake.close()
  rig.close()
  control.close()
  store.close()

  // Remove `<data>/run/hub.json` only if it still names our own PID.
  let hub_path = nodepath::join(sep, [run_dir, "hub.json"])
  match ops_fs.read_text(hub_path) {
    Ok(text) => {
      match read_hub_pid(text) {
        Some(p) => {
          if p == self_pid {
            let _ = (ops_fs.remove)(hub_path)
          }
        }
        None => ()
      }
    }
    Err(_) => ()
  }

  match held_lock {
    Some(h) => {
      let _ = h.release()
    }
    None => ()
  }

  // Drain remaining `station_sys` worker events briefly before stopping `host_shim`.
  let mut drain_ticks = 0
  while station_sys::active_workers() > 0 && drain_ticks < 20 {
    let _ = host_shim::wait(10L)
    drain_ticks = drain_ticks + 1
  }
  host_shim::stop()
  if handover_failed { 1 } else { 0 }
}

fn handle_peer_rpc_line(
  line : String,
  binary_tail : Option[Bytes],
  remote_id : String,
  v2_bytes : Bool,
  cloud : station_cloud::CloudStore,
  peers_current : Bool,
  rig : station_rig::Rig,
  remote_mgr : station_jobs::RemoteManager,
  incoming_vault : station_vault::IncomingRegistry,
  vault_grants : station_vault::GrantStore,
  load_json_fn : () -> base_codec::Json,
  hooks : RigDispatchHooks,
) -> (Bytes, Option[StreamFilePlan]) {
  let parsed = match base_codec::json_parse(line) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(e) => {
      return (station_mesh::encode_peer_answer_err("invalid peer json: " + e, v2_bytes), None)
    }
  }
  let env = match station_mesh::decode_peer_request(parsed) {
    Ok(e) => e
    Err(e) => return (station_mesh::encode_peer_answer_err(e, v2_bytes), None)
  }
  let now_ms = host_shim::wall_ms()
  let roster = build_cloud_roster(cloud, (now_ms / 1000L).to_double(), peers_current)
  match dispatch_rig_peer_rpc_ext(
    roster,
    remote_id,
    env,
    binary_tail,
    v2_bytes,
    rig,
    remote_mgr,
    incoming_vault,
    vault_grants,
    load_json_fn,
    hooks,
    now_ms,
  ) {
    Ok(rep) => {
      match rep.stream_file {
        Some(plan) => (station_mesh::encode_peer_answer_ok(rep.json, true, v2_bytes), Some(plan))
        None => {
          match rep.binary {
            Some(bin) => {
              let hdr = station_mesh::encode_peer_answer_ok(rep.json, true, v2_bytes)
              (concat_bytes_local(hdr, bin), None)
            }
            None => (station_mesh::encode_peer_answer_ok(rep.json, false, v2_bytes), None)
          }
        }
      }
    }
    Err(msg) => (station_mesh::encode_peer_answer_err(msg, v2_bytes), None)
  }
}
