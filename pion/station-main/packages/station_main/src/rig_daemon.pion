// Production pure-Pion `roles:rig` daemon (`stillfail-station-pion run ...`),
// assembling `station_sys`, `station_http`, `station_ops`, `station_store`, `station_rules_bridge`,
// `station_cloud`, `mesh_wire`/`mesh_door`/`mesh_accept`, `station_mesh`, `station_jobs`,
// `station_vault`, and `station_rig` aligned with `station/src/rig/main.ts`.

import "base64"
import "base_codec"
import "builders_core"
import "form"
import "host_shim"
import "http1"
import "lock"
import "mesh_door"
import "mesh_wire"
import "nodepath"
import "station_cloud"
import "station_http"
import "station_jobs"
import "station_mesh"
import "station_ops"
import "station_rig"
import "station_rules_bridge"
import "station_store"
import "station_sys"
import "station_vault"

// Non-overlapping ShellMux tag encoding (`id * 4 + tag`) so multiple `ShellMux` instances share
// one `host_shim::wait` loop without ever colliding regardless of connection count.
let MUX_TAG_LOOPBACK : Int64 = 0L
let MUX_TAG_DOOR : Int64 = 1L
let MUX_TAG_MESH : Int64 = 2L

// Fixed `station_sys` event IDs.
let EV_CTRL : Int64 = 10L
let EV_SIG : Int64 = 11L
// Disjoint positive event IDs for Vault subprocesses (matched via `active_vault_runs.contains(ev_id)`).
let VAULT_EV_START : Int64 = 1000000001L

// Mesh/iroh `MuxToken::Tagged` kinds on `mux_mesh`.
let MESH_TOK_BIND : Int = 4001
let MESH_TOK_ACCEPT : Int = 4004
let MESH_TOK_ACCEPT_BI : Int = 4005
let MESH_TOK_READ : Int = 4006
let MESH_TOK_WRITE : Int = 4007
let MESH_TOK_FINISH : Int = 4008
let MESH_TOK_CONN_CLOSE : Int = 4009
let MESH_TOK_EP_CLOSE : Int = 4010
let MESH_TOK_ZSTD_UNPACK : Int = 4011
let MESH_TOK_OUT_CONNECT : Int = 4020
let MESH_TOK_OUT_OPEN_BI : Int = 4021
let MESH_TOK_OUT_WRITE : Int = 4022
let MESH_TOK_OUT_FINISH : Int = 4023
let MESH_TOK_OUT_CLOSE : Int = 4024
let MESH_TOK_OUT_READ : Int = 4025
let FRONT_TOK_LISTEN : Int = 4030
let FRONT_TOK_OPEN : Int = 4031
let FRONT_TOK_CTRL_READ : Int = 4032
let FRONT_TOK_CTRL_WRITE : Int = 4033
let FRONT_TOK_STREAM_ACCEPT : Int = 4034
let FRONT_TOK_STREAM_READ : Int = 4035
let FRONT_TOK_STREAM_WRITE : Int = 4036
let FRONT_TOK_STREAM_END : Int = 4037
let FRONT_TOK_OUT_WRITE : Int = 4038

// Hardening caps for inbound mesh connections, streams, outbound tell retries, and vault output.
let MAX_ACTIVE_CONNS : Int = 64
let MAX_ACTIVE_STREAMS : Int = 128
let STREAM_READ_TIMEOUT_MS : Int64 = 15000L
let MAX_OUTBOUND_TELLS : Int = 128
let TELL_RETRY_MAX_MS : Int64 = 3600000L
let TELL_BACKOFF_CAP_MS : Int64 = 60000L
let TELL_SLOT_TIMEOUT_MS : Int64 = 15000L
let VAULT_OUTPUT_MAX : Int = 65536
let MAX_ACTIVE_VAULT_RUNS : Int = 16
let UPKEEP_EVERY_MS : Int64 = 600000L
// Exact `client/shell/src/istream.rs:264,265` & `station/src/mesh/front.ts:21,22` frame markers!
let FRONT_FRAME_END : Int64 = 4294967294L // 0xFFFFFFFE
let FRONT_FRAME_FAILED : Int64 = 4294967293L // 0xFFFFFFFD
let FRONT_FRAME_MOST : Int = 65536

struct MuxSlot {
  mut next_ev : Option[host_shim::HostEvent]
}

fn make_tagged_mux(tag : Int64, slot : MuxSlot) -> builders_core::ShellMux {
  let transport = builders_core::MuxTransport::{
    call_async: fn(id : Int64, op : String, json : String, bytes : Option[Bytes]) -> Unit {
      host_shim::shell_call(id * 4L + tag, op, json, bytes)
    },
    call_sync: host_shim::shell_sync,
    write_stdout_line: host_shim::write_stdout_line,
    write_stdout_frame: host_shim::write_stdout_frame,
    now_ms: host_shim::now_ms,
    wall_ms: host_shim::wall_ms,
    wait: fn(_ms : Int64) -> Option[host_shim::HostEvent] {
      let ev = slot.next_ev
      slot.next_ev = None
      ev
    },
  }
  builders_core::ShellMux::new(transport, start_stdin=false)
}

struct ActivePeerConn {
  id : Int64
  remote_id : String
  alpn : String
}

struct ActivePeerStream {
  stream_id : Int64
  conn_id : Int64
  remote_id : String
  v2_bytes : Bool
  opened_at : Int64
  mut last_activity_ms : Int64
  mut header_line : Option[String]
  mut expect_binary : Bool
  mut max_binary_buf : Int
  mut rx_buf : Bytes
  mut put_ctx : Option[StreamPutCtx]
}

struct OutboundTell {
  peer : String
  method : String
  ref_id : String
  payload : Bytes
  attempts : Int
  next_at_ms : Int64
  created_at_ms : Int64
}

struct ActiveOutbound {
  id : Int64
  peer : String
  method : String
  ref_id : String
  payload : Bytes
  attempts : Int
  created_at_ms : Int64
  started_at_ms : Int64
  mut conn_id : Option[Int64]
  mut stream_id : Option[Int64]
  mut sock_id : Option[Int64]
  mut reply_buf : Bytes
}

struct PendingZstdPut {
  sid : Int64
  line : String
  remote_id : String
  v2_bytes : Bool
  is_front : Bool
}

struct PendingHandoverRpc {
  sid : Int64
