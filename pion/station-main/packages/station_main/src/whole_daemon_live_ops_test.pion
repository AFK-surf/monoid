// Wave 17D-2 R2 daemon-level unit tests for `whole_daemon_live_ops.pion` & R2 security/lifecycle invariants:
// - `live_current_platform` (dynamic os+arch detection: linux-arm64 vs linux-x64 vs darwin-arm64 vs win32-x64)
// - `LiveUpdateProcManager` `ProcExit` clearing `updating` on BOTH exit 0 and non-zero exit (never permanently stuck at 409)
// - `LoginsManager::start_isolated` unique login IDs across profiles sharing identical command words
// - `PeerAuthPolicy::add_workspace` immediate live workspace admission without restart
// - `controlled_s3_error_message` & `controlled_join_error_message` (never echo raw upstream XML or tokens)

import "station_devices"
import "station_drivers"
import "station_whole"

test "wave17d2 r2: live_current_platform detects real os+arch dynamically" {
  if live_current_platform("linux", "aarch64") != "linux-arm64" {
    panic("expected linux-arm64 for aarch64")
  }
  if live_current_platform("linux", "arm64") != "linux-arm64" {
    panic("expected linux-arm64 for arm64")
  }
  if live_current_platform("linux", "x86_64") != "linux-x64" {
    panic("expected linux-x64 for x86_64")
  }
  if live_current_platform("darwin", "arm64") != "darwin-arm64" {
    panic("expected darwin-arm64")
  }
  if live_current_platform("win32", "x86_64") != "win32-x64" {
    panic("expected win32-x64")
  }
}

test "wave17d2 r2: clear_update_item_state clears updating on both success and failure (no permanent 409)" {
  let updates = station_drivers::RuntimeUpdatesManager::new()
  // 1. Success path clears `updating` and `failed_text`
  updates.station.updating = Some(1000L)
  updates.station.failed_text = Some("old error")
  clear_update_item_state(updates, "station", None)
  if updates.station.updating is Some(_) || updates.station.failed_text is Some(_) {
    panic("success must clear updating and failed_text")
  }

  // 2. Failure path ALSO clears `updating` (so subsequent installs are not permanently stuck at 409!) and records `failed_text`
  updates.station.updating = Some(2000L)
  clear_update_item_state(updates, "station", Some("update exited with code 2"))
  if updates.station.updating is Some(_) || updates.station.failed_text != Some("update exited with code 2") {
    panic("failure must clear updating and record failed_text")
  }
}

test "wave17d2 r2: LoginsManager::start_isolated allocates distinct IDs for identical command words" {
  let lm = station_devices::LoginsManager::new(None)
  let starter_a = station_devices::LoginStarter::{
    workspace: Some("ws-a"),
    by: station_devices::LoginPerson::{ email: "a@example.com", name: "A" },
    chat: Some("profile:ws-a:p1"),
    chat_title: Some("p1"),
  }
  let starter_b = station_devices::LoginStarter::{
    workspace: Some("ws-b"),
    by: station_devices::LoginPerson::{ email: "b@example.com", name: "B" },
    chat: Some("profile:ws-b:p1"),
    chat_title: Some("p1"),
  }
  let r1 = match lm.start_isolated("claude auth login", starter_a, None, false, 1000L) {
    Ok(v) => v
    Err(e) => panic("start_isolated 1 failed: " + e.message)
  }
  let r2 = match lm.start_isolated("claude auth login", starter_b, None, false, 1000L) {
    Ok(v) => v
    Err(e) => panic("start_isolated 2 failed: " + e.message)
  }
  if r1.id == r2.id {
    panic("isolated profile logins MUST NOT collide on shared command words: " + r1.id)
  }
}

test "wave17d2 r2: PeerAuthPolicy::add_workspace admits newly joined workspace immediately" {
  let pol = station_whole::PeerAuthPolicy::{
    station_id: "st-1",
    station_build: "9999",
    home_workspace: "ws-home",
    allowed_workspaces: ["ws-home"],
    verify_fn: None,
  }
  pol.add_workspace("ws-joined")
  pol.add_workspace("ws-joined")
  let mut count = 0
  for i in 0..<pol.allowed_workspaces.length() {
    if pol.allowed_workspaces[i] == "ws-joined" {
      count = count + 1
    }
  }
  if count != 1 {
    panic("ws-joined must be added exactly once, got " + count.to_string())
  }
}

test "wave17d2 r2: controlled S3 and join error messages never echo raw upstream XML or tokens" {
  let s3_msg = controlled_s3_error_message(403)
  if s3_msg.contains("<Error>") || s3_msg.length() == 0 {
    panic("S3 error invalid: " + s3_msg)
  }
  let join_msg = controlled_join_error_message(401)
  if join_msg.length() == 0 {
    panic("join error empty")
  }
}
