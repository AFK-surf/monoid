let WHOLE_UPSTREAM_READ_PAUSE_HIGH : Int = 524288 // 512 KiB pause inbound mesh read
let WHOLE_UPSTREAM_READ_PAUSE_LOW : Int = 131072 // 128 KiB resume inbound mesh read
