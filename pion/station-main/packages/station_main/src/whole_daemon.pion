fn wd_ascii_lower(s : String) -> String {
  let b = s.to_bytes()
  let out = Bytes::new(b.length())
  for i in 0..<b.length() {
    let c = b[i].to_int() & 0xFF
    out[i] = if c >= 65 && c <= 90 { (c + 32).to_byte() } else { b[i] }
  }
  out.to_string()
}

fn wd_encode_header_pairs(hdrs : Array[(String, String)]) -> base_codec::Json {
  let out : Array[base_codec::Json] = []
  for i in 0..<hdrs.length() {
    out.push(base_codec::json_arr([base_codec::json_str(hdrs[i].0), base_codec::json_str(hdrs[i].1)]))
  }
  base_codec::json_arr(out)
}

