struct RemoteConnectRecord {
  station : String
  described : base_codec::Json
}

fn load_remote_connects_file(
  ops_fs : station_ops::OpsFs,
  path : String,
  out_map : Map[String, RemoteConnectRecord],
  connect_meta : Map[String, ConnectMeta],
  home_ws : String,
) -> Unit {
  match ops_fs.read_text(path) {
    Ok(raw) => match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(base_codec::Json::Obj(entries)) => {
        for i in 0..<entries.length() {
          let (rid, entry_val) = entries[i]
          let st_id = match base_codec::json_get(entry_val, "station") {
            Some(base_codec::Json::Str(s)) => s
            _ => ""
          }
          let desc_opt = base_codec::json_get(entry_val, "described")
          match desc_opt {
            Some(desc) => {
              let kind = match base_codec::json_get(desc, "kind") {
                Some(base_codec::Json::Str(k)) => k
                _ => ""
              }
              if st_id.length() > 0 && kind.length() > 0 {
                out_map.set(rid, RemoteConnectRecord::{ station: st_id, described: desc })
                connect_meta.set(rid, connect_meta_from_described(rid, desc, home_ws))
              }
            }
            None => ()
          }
        }
      }
      _ => ()
    }
    Err(_) => ()
  }
}

fn save_remote_connects_file(
  ops_fs : station_ops::OpsFs,
  path : String,
  map : Map[String, RemoteConnectRecord],
  pid : Int,
  sep : String,
) -> Unit {
  let fields : Array[(String, base_codec::Json)] = []
  let keys = map.keys()
  for i in 0..<keys.length() {
    let k = keys[i]
    match map.get(k) {
      Some(rec) => {
        fields.push(
          (
            k,
            base_codec::json_obj([
              ("station", base_codec::json_str(rec.station)),
              ("described", rec.described),
            ]),
          ),
        )
      }
      None => ()
    }
  }
  let body = base_codec::json_stringify(base_codec::json_obj(fields)) + "\n"
  let _ = station_ops::write_private(ops_fs, path, body.to_bytes(), pid, 1, sep=sep)
}

/// Canonical external thread surface key shared by storage and `query_thread_moved_to`:
/// Slack uses `slack:<team>` when `described.team` is present, otherwise `<kind>:<cid>`.
pub fn surface_for_described(kind : String, described : base_codec::Json, cid : String) -> String {
  let eff_kind = if kind.length() > 0 { kind } else { "slack" }
  if eff_kind == "slack" {
    let team = match base_codec::json_get(described, "team") {
      Some(base_codec::Json::Str(s)) => s.trim()
      _ => ""
    }
    if team.length() > 0 { "slack:" + team } else { "slack:" + cid }
  } else {
    eff_kind + ":" + cid
  }
}

fn connect_meta_from_described(
  remote_id : String,
  described : base_codec::Json,
  fallback_ws : String,
) -> ConnectMeta {
  let get_s = fn(obj : base_codec::Json, k : String) -> String {
    match base_codec::json_get(obj, k) {
      Some(base_codec::Json::Str(s)) => s.trim()
      _ => ""
    }
  }
  let kind = {
    let k = get_s(described, "kind")
    if k.length() > 0 { k } else { "slack" }
  }
  let ws = {
    let w = get_s(described, "workspace")
    if w.length() > 0 { w } else { fallback_ws }
  }
  let surface = surface_for_described(kind, described, remote_id)
  let single = get_s(described, "mode") == "single-session"
  let require_mention = if !single {
    true
  } else {
    match base_codec::json_get(described, "requireMention") {
      Some(base_codec::Json::Bool(b)) => b
      _ => true
    }
  }
  let bind_opt = base_codec::json_get(described, "bind")
  let runtime = match bind_opt {
    Some(b) => {
      let r = get_s(b, "runtime")
      if r.length() > 0 { r } else { "claude" }
    }
    None => "claude"
  }
  let profile = match bind_opt {
    Some(b) => {
      let p = get_s(b, "profile")
      if p.length() > 0 { p } else { "default" }
    }
    None => "default"
  }
  // Security (P0-3, 1:1 with TS `station/src/connects/remote.ts::connectOf`):
  // NEVER trust or read `bind.cwd` from a remote station's `described` payload!
  ConnectMeta::{
    ws: ws,
    config_surface: surface,
    single: single,
    require_mention: require_mention,
    runtime: runtime,
    profile: profile,
    cwd: None,
  }
}

pub enum ConnectEventValidation {
  Reject(String)
  DeliverKept(String)
  LearnAndDeliver(String, base_codec::Json)
}

/// Builds a `connect.call` outbound `post` RPC payload 1:1 with TS `station/src/connects/remote.ts`:
/// - `op: "post"` (matching `answerCall` line 369: `request?.op`)
/// - `args: [thread, message, [], card ?? null]` (matching `remote.ts` lines 257 & 397: 4-element tuple)
pub fn build_connect_call_post_request(
  ws : String,
  raw_id : String,
  raw_origin : String,
  ch : String,
  tts : String,
  reply_to : Option[String],
  text : String,
  card : Option[base_codec::Json],
) -> base_codec::Json {
  let thread_j_fields : Array[(String, base_codec::Json)] = [
    ("channel", base_codec::json_str(ch)),
    ("threadTs", base_codec::json_str(tts)),
  ]
  match reply_to {
    Some(rto) => thread_j_fields.push(("replyTo", base_codec::json_str(rto)))
    None => ()
  }
  let call_args : Array[base_codec::Json] = [
    base_codec::json_obj(thread_j_fields),
    base_codec::json_str(text),
    base_codec::json_arr([]),
    match card {
      Some(c) => c
      None => base_codec::json_null()
    },
  ]
  base_codec::json_obj([
    ("method", base_codec::json_str("connect.call")),
    ("workspace", base_codec::json_str(ws)),
    (
      "connect",
      base_codec::json_obj([
        ("id", base_codec::json_str(raw_id)),
        ("origin", base_codec::json_str(raw_origin)),
      ]),
    ),
    ("op", base_codec::json_str("post")),
    ("args", base_codec::json_arr(call_args)),
  ])
}

/// Pure 1:1 validation for cross-station `connect.event` matching TS `station/src/connects/workspace.ts:348-375 taken()`:
/// - Requires non-empty `connect.id` AND `connect.origin` (never falls back to `auth.remote_id`).
/// - For `kept: true`: requires local connect matching `local_id` in the same `ws` (never mutates `remote_connects`).
/// - For non-`kept`: requires `described` with string `kind`, non-empty `ws`, `described.workspace == ws`,
///   and refuses if `local_id` already runs locally (`"that connect runs on this station"`).
pub fn validate_connect_event(
  req : base_codec::Json,
  ws : String,
  here_station : String,
  has_local_connect : (String) -> Bool,
  local_connect_ws : (String) -> Option[String],
) -> ConnectEventValidation {
  let conn_obj = match base_codec::json_get(req, "connect") {
    Some(c) => c
    None => return ConnectEventValidation::Reject("no such connect")
  }
  let cid_raw = match base_codec::json_get(conn_obj, "id") {
    Some(base_codec::Json::Str(s)) => s.trim()
    _ => ""
  }
  let origin_raw = match base_codec::json_get(conn_obj, "origin") {
    Some(base_codec::Json::Str(s)) => s.trim()
    _ => ""
  }
  if cid_raw.length() == 0 || origin_raw.length() == 0 || ws.length() == 0 {
    return ConnectEventValidation::Reject("no such connect")
  }
  let local_id = if origin_raw == here_station {
    cid_raw
  } else {
    cid_raw + "@" + origin_raw
  }
  let is_kept = match base_codec::json_get(req, "kept") {
    Some(base_codec::Json::Bool(true)) => true
    _ => false
  }
  if is_kept {
    if !has_local_connect(local_id) {
      return ConnectEventValidation::Reject("no such connect")
    }
    match local_connect_ws(local_id) {
      Some(lws) => if lws != ws {
        return ConnectEventValidation::Reject("no such connect")
      }
      None => return ConnectEventValidation::Reject("no such connect")
    }
    return ConnectEventValidation::DeliverKept(local_id)
  }
  let desc = match base_codec::json_get(req, "described") {
    Some(d) => d
    None => return ConnectEventValidation::Reject("no such connect")
  }
  let d_kind = match base_codec::json_get(desc, "kind") {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
  let d_ws = match base_codec::json_get(desc, "workspace") {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
  if d_kind.length() == 0 || d_ws != ws {
    return ConnectEventValidation::Reject("no such connect")
  }
  if has_local_connect(local_id) {
    return ConnectEventValidation::Reject("that connect runs on this station")
  }
  ConnectEventValidation::LearnAndDeliver(local_id, desc)
}

/// Parses a Comma `chatRef` (`"<thread>"` or `"<thread>@<station>"`, #9001).
pub fn parse_comma_chat_ref(raw : String) -> Option[(Int64, Option[String])] {
  let tr = raw.trim()
  if tr.length() == 0 {
    return None
  }
  let at = station_connects::str_index_of(tr, "@", 0)
  if at > 0 {
    let left = station_connects::str_slice(tr, 0, at)
    let right = station_connects::str_slice(tr, at + 1, tr.to_bytes().length())
    if right.length() == 0 {
      return None
    }
    match base_codec::parse_int64_str(left) {
      Some(tid) => if tid > 0L { Some((tid, Some(right))) } else { None }
      None => None
    }
  } else {
    match base_codec::parse_int64_str(tr) {
      Some(tid) => if tid > 0L { Some((tid, None)) } else { None }
      None => None
    }
  }
}

/// Parses a Slack interactive payload (button/card action or text submission) into an inbound
/// `ChatEvent::Message` and dispatches it through `handle_connect_inbound_event`.
fn handle_slack_interactive_payload(
  core : station_whole::WholeCore,
  connects : station_whole::ConnectsOsRuntime,
  connect_meta : Map[String, ConnectMeta],
  connect_id : String,
  envelope_id : String,
  payload : base_codec::Json,
  now_ms : Int64,
  on_done : (Bool) -> Unit,
  on_moved_to : Option[(String, String, base_codec::Json, base_codec::Json, (Bool) -> Unit) -> Unit] = None,
) -> Unit {
  let get_s = fn(obj : base_codec::Json, k : String) -> String {
    match base_codec::json_get(obj, k) {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
  }
  let ch = match base_codec::json_get(payload, "channel") {
    Some(c) => get_s(c, "id")
    None => get_s(payload, "channel_id")
  }
  let user = match base_codec::json_get(payload, "user") {
    Some(u) => get_s(u, "id")
    None => get_s(payload, "user_id")
  }
  let msg_obj = base_codec::json_get(payload, "message")
  let container_obj = base_codec::json_get(payload, "container")
  let mut tts = match msg_obj {
    Some(m) => {
      let t = get_s(m, "thread_ts")
      if t.length() > 0 { t } else { get_s(m, "ts") }
    }
    None => ""
  }
  if tts.length() == 0 {
    tts = match container_obj {
      Some(c) => {
        let t = get_s(c, "thread_ts")
        if t.length() > 0 { t } else { get_s(c, "message_ts") }
      }
      None => ""
    }
  }
  let mut choice = get_s(payload, "text")
  let mut action_ts = ""
  match base_codec::json_get(payload, "actions") {
    Some(base_codec::Json::Arr(arr)) => {
      if arr.length() > 0 {
        let a0 = arr[0]
        let v = get_s(a0, "value")
        if v.length() > 0 {
          choice = v
        } else {
          match base_codec::json_get(a0, "text") {
            Some(tobj) => {
              let tt = get_s(tobj, "text")
              if tt.length() > 0 {
                choice = tt
              }
            }
            None => ()
          }
        }
        action_ts = get_s(a0, "action_ts")
      }
    }
    _ => ()
  }
  if ch.length() == 0 || tts.length() == 0 || choice.length() == 0 {
    on_done(false)
    return
  }
  let ts = if action_ts.length() > 0 {
    "card-" + action_ts
  } else if envelope_id.length() > 0 {
    "card-" + envelope_id
  } else {
    "card-" + now_ms.to_string()
  }
  let ev = station_connects::ChatEvent::Message(
    station_connects::InboundMessage::{
      channel: ch,
      thread_ts: tts,
      ts: ts,
      user: if user.length() > 0 { user } else { "slack-user" },
      text: choice,
      addressed: true,
      files: [],
      quoted: match msg_obj {
        Some(m) => {
          let mts = get_s(m, "ts")
          if mts.length() > 0 { Some(mts) } else { None }
        }
        None => None
      },
    },
  )
  let _ = handle_connect_inbound_event(core, connects, connect_meta, connect_id, ev, now_ms, on_done=Some(on_done), on_moved_to=on_moved_to)
}

pub fn parse_wire_chat_event(ev : base_codec::Json) -> Option[station_connects::ChatEvent] {
  let get_s = fn(obj : base_codec::Json, k : String) -> String {
    match base_codec::json_get(obj, k) {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
  }
  let etype = get_s(ev, "type")
  if etype == "changed" {
    let ch = get_s(ev, "channel")
    let tts = get_s(ev, "threadTs")
    let ts = get_s(ev, "ts")
    let text = get_s(ev, "text")
    if ch.length() == 0 || tts.length() == 0 || ts.length() == 0 {
      return None
    }
    return Some(station_connects::ChatEvent::Changed(ch, tts, ts, text))
  }
  if etype == "message" || etype == "ownNotice" {
    let m = match base_codec::json_get(ev, "message") {
      Some(v) => v
      None => return None
    }
    let ch = get_s(m, "channel")
    let tts = get_s(m, "threadTs")
    let ts = get_s(m, "ts")
    let user = get_s(m, "user")
    let text = get_s(m, "text")
    let addressed = match base_codec::json_get(m, "addressed") {
      Some(base_codec::Json::Bool(b)) => b
      _ => false
    }
    let quoted = {
      let q = get_s(m, "quoted")
      if q.length() > 0 { Some(q) } else { None }
    }
    let files : Array[station_connects::InboundFile] = []
    match base_codec::json_get(m, "files") {
      Some(base_codec::Json::Arr(arr)) => {
        for i in 0..<arr.length() {
          let f = arr[i]
          let fid = get_s(f, "id")
          let fname = get_s(f, "name")
          let fsize = match base_codec::json_get(f, "size") {
            Some(base_codec::Json::Num(n, _)) => n.to_int64()
            _ => 0L
          }
          let furl = {
            let u = get_s(f, "url")
            if u.length() > 0 { Some(u) } else { None }
          }
          if fid.length() > 0 || fname.length() > 0 {
            files.push(station_connects::InboundFile::{ id: fid, name: fname, size: fsize, url: furl })
          }
        }
      }
      _ => ()
    }
    if ch.length() == 0 || tts.length() == 0 || ts.length() == 0 {
      return None
    }
    let msg = station_connects::InboundMessage::{
      channel: ch,
      thread_ts: tts,
      ts: ts,
      user: user,
      text: text,
      addressed: addressed,
      files: files,
      quoted: quoted,
    }
    if etype == "ownNotice" {
      return Some(station_connects::ChatEvent::OwnNotice(msg))
    }
    return Some(station_connects::ChatEvent::Message(msg))
  }
  if etype == "stop" {
    let ch = get_s(ev, "channel")
    let tts = get_s(ev, "threadTs")
    let ts = get_s(ev, "ts")
    if ch.length() == 0 || tts.length() == 0 {
      return None
    }
    return Some(station_connects::ChatEvent::Stop(ch, tts, ts, None))
  }
  None
}

/// Encodes a `ChatEvent` into the cross-station `connect.event` wire JSON format (inverse of `parse_wire_chat_event`).
pub fn encode_wire_chat_event(ev : station_connects::ChatEvent) -> base_codec::Json {
  let encode_msg = fn(m : station_connects::InboundMessage) -> base_codec::Json {
    let files_j : Array[base_codec::Json] = []
    for i in 0..<m.files.length() {
      let f = m.files[i]
      let ffields : Array[(String, base_codec::Json)] = [
        ("id", base_codec::json_str(f.id)),
        ("name", base_codec::json_str(f.name)),
        ("size", base_codec::json_int64(f.size)),
      ]
      match f.url {
        Some(u) => if u.length() > 0 { ffields.push(("url", base_codec::json_str(u))) }
        None => ()
      }
      files_j.push(base_codec::json_obj(ffields))
    }
    let mfields : Array[(String, base_codec::Json)] = [
      ("channel", base_codec::json_str(m.channel)),
      ("threadTs", base_codec::json_str(m.thread_ts)),
      ("ts", base_codec::json_str(m.ts)),
      ("user", base_codec::json_str(m.user)),
      ("text", base_codec::json_str(m.text)),
      ("addressed", base_codec::json_bool(m.addressed)),
      ("files", base_codec::json_arr(files_j)),
    ]
    match m.quoted {
      Some(q) => if q.length() > 0 { mfields.push(("quoted", base_codec::json_str(q))) }
      None => ()
    }
    base_codec::json_obj(mfields)
  }
  match ev {
    station_connects::ChatEvent::Message(m) => base_codec::json_obj([
      ("type", base_codec::json_str("message")),
      ("message", encode_msg(m)),
    ])
    station_connects::ChatEvent::OwnNotice(m) => base_codec::json_obj([
      ("type", base_codec::json_str("ownNotice")),
      ("message", encode_msg(m)),
    ])
    station_connects::ChatEvent::Changed(ch, tts, ts, text) => base_codec::json_obj([
      ("type", base_codec::json_str("changed")),
      ("channel", base_codec::json_str(ch)),
      ("threadTs", base_codec::json_str(tts)),
      ("ts", base_codec::json_str(ts)),
      ("text", base_codec::json_str(text)),
    ])
    station_connects::ChatEvent::Stop(ch, tts, ts, _) => base_codec::json_obj([
      ("type", base_codec::json_str("stop")),
      ("channel", base_codec::json_str(ch)),
      ("threadTs", base_codec::json_str(tts)),
      ("ts", base_codec::json_str(ts)),
    ])
    station_connects::ChatEvent::LoginCode(ch, tts, lid, code, _) => base_codec::json_obj([
      ("type", base_codec::json_str("loginCode")),
      ("channel", base_codec::json_str(ch)),
      ("threadTs", base_codec::json_str(tts)),
      ("loginId", base_codec::json_str(lid)),
      ("code", base_codec::json_str(code)),
    ])
  }
}

/// R8 P1-5: Shared `connect.event` peer RPC payload builder (1:1 with TS `knownOf(id, here)` and
/// receiver `validate_connect_event`: `connect` is ALWAYS `{"id": connect_id, "origin": origin_station}`).
pub fn encode_connect_event_rpc(
  connect_id : String,
  origin_station : String,
  ws : String,
  described : base_codec::Json,
  event : base_codec::Json,
) -> base_codec::Json {
  base_codec::json_obj([
    ("method", base_codec::json_str("connect.event")),
    ("workspace", base_codec::json_str(ws)),
    (
      "connect",
      base_codec::json_obj([
        ("id", base_codec::json_str(connect_id)),
        ("origin", base_codec::json_str(origin_station)),
      ]),
    ),
    ("described", described),
    ("event", event),
  ])
}

fn describe_connect_meta(connect_id : String, meta : ConnectMeta) -> base_codec::Json {
  let parts = meta.config_surface.split(":")
  let kind = if parts.length() > 0 && parts[0].length() > 0 { parts[0] } else { "slack" }
  let team = if parts.length() > 1 && parts[1].length() > 0 { parts[1] } else { connect_id }
  base_codec::json_obj([
    ("kind", base_codec::json_str(kind)),
    ("workspace", base_codec::json_str(meta.ws)),
    ("team", base_codec::json_str(team)),
    ("mode", base_codec::json_str(if meta.single { "single-session" } else { "threads" })),
    ("requireMention", base_codec::json_bool(meta.require_mention)),
    (
      "bind",
      base_codec::json_obj([
        ("runtime", base_codec::json_str(meta.runtime)),
        ("profile", base_codec::json_str(meta.profile)),
      ]),
    ),
  ])
}

fn emit_thread_sse_event(
  core : station_whole::WholeCore,
  ws : String,
  tid : Int64,
  n : Int64,
  kind : String,
  author_kind : String,
  author : String,
  text : String,
  now_ms : Int64,
) -> Unit {
  let ev_payload = base_codec::json_obj([
    ("id", base_codec::json_int64(tid)),
    (
      "entries",
      base_codec::json_arr([
        base_codec::json_obj([
          ("n", base_codec::json_int64(n)),
          ("kind", base_codec::json_str(kind)),
          ("authorKind", base_codec::json_str(author_kind)),
          ("author", base_codec::json_str(author)),
          ("text", base_codec::json_str(text)),
          ("at", base_codec::json_int64(now_ms)),
        ]),
      ]),
    ),
  ])
  let ev_target = station_api::EventTarget::{
    lang: None,
    viewer: None,
    device: None,
    email: None,
    workspace: Some(ws),
    subs: None,
    read_only: None,
    managers: None,
    vault: None,
    sees_ws: Some(Some(ws)),
    sees_session: None,
    sees_thread: None,
    sees_job: None,
  }
  let _ = core.api.events.emit("thread", ev_payload, ev_target, now_ms, None)
}

/// Core Wave 17B-5 Hub delivery bridge: persists inbound external connect events
/// (local Slack/Feishu/Comma/Group or cross-station `connect.event`) into SQLite
/// `threads` / `entries` / `deliveries`, respects `left_at` and multi-edit history,
/// and triggers `SessionHub` actor prompt delivery + live `"thread"` SSE push.
fn session_belongs_to_ws(
  sess_ws : Option[String],
  target_ws : String,
  home_ws : String,
) -> Bool {
  let eff = match sess_ws {
    Some(w) => if w.length() > 0 { w } else { home_ws }
    None => home_ws
  }
  eff == target_ws
}

fn handle_connect_inbound_event(
  core : station_whole::WholeCore,
  connects : station_whole::ConnectsOsRuntime,
  connect_meta : Map[String, ConnectMeta],
  connect_id : String,
  ev : station_connects::ChatEvent,
  now_ms : Int64,
  on_stop_session : (String) -> Unit = fn(_s : String) -> Unit { () },
  on_login_code : (String, String) -> Unit = fn(_lid : String, _code : String) -> Unit { () },
  on_done : Option[(Bool) -> Unit] = None,
  on_moved_to : Option[(String, String, base_codec::Json, base_codec::Json, (Bool) -> Unit) -> Unit] = None,
) -> Bool {
  let finish = fn(ok : Bool) -> Bool {
    match on_done {
      Some(cb) => cb(ok)
      None => ()
    }
    ok
  }
  let meta = match connect_meta.get(connect_id) {
    Some(m) => m
    None => return finish(false)
  }
  let st_db = match core.store.require_open() {
    Ok(s) => s
    Err(_) => return finish(false)
  }
  let (ch, tts) = match ev {
    station_connects::ChatEvent::Message(m) => (m.channel, m.thread_ts)
    station_connects::ChatEvent::OwnNotice(m) => (m.channel, m.thread_ts)
    station_connects::ChatEvent::Changed(c, t, _, _) => (c, t)
    station_connects::ChatEvent::Stop(c, t, _, _) => (c, t)
    station_connects::ChatEvent::LoginCode(c, t, _, _, _) => (c, t)
  }
  // R9 P1-5: Query `query_thread_moved_to` FIRST (strictly SQL-filtered by `meta.ws`, matching
  // both in-flight `s.ws = meta.ws` and completed `s.ws = 'handed:' || meta.ws` which
  // `thread_visible_in_ws` intentionally hides from local lists!).
  let moved_station_opt = query_thread_moved_to(
    st_db,
    meta.config_surface,
    connect_id,
    ch,
    tts,
    meta.ws,
    core.config.home_workspace,
  )
  match (moved_station_opt, on_moved_to) {
    (Some(target_station), Some(fwd_fn)) => {
      let done_cb = match on_done {
        Some(cb) => cb
        None => fn(_ok : Bool) -> Unit { () }
      }
      fwd_fn(target_station, meta.ws, describe_connect_meta(connect_id, meta), encode_wire_chat_event(ev), done_cb)
      return true
    }
    _ => ()
  }
  let existing_tid : Option[Int64] = match st_db.db.first(
    "SELECT id FROM threads WHERE surface = ?1 AND channel = ?2 AND thread_ts = ?3 LIMIT 1",
    [
      base_codec::json_str(meta.config_surface),
      base_codec::json_str(ch),
      base_codec::json_str(tts),
    ],
  ) {
    Ok(Some(row)) => match row.get("id") {
      Some(base_codec::Json::Num(n, _)) => Some(n.to_int64())
      _ => None
    }
    _ => None
  }
  // Security (P0-1 / R9 P1-5): For local delivery, enforce workspace visibility BEFORE attachment
  // download or message persistence so workspace A NEVER touches a thread owned by workspace B!
  match existing_tid {
    Some(id) => {
      let vis = match station_whole::thread_visible_in_ws(st_db, id, meta.ws, core.config.home_workspace) {
        Ok(b) => b
        Err(_) => false
      }
      if !vis {
        return finish(false)
      }
    }
    None => ()
  }
  let routed_elsewhere = moved_station_opt is Some(_)
  let ok = handle_connect_inbound_event_local(
    core,
    connects,
    meta,
    st_db,
    connect_id,
    ev,
    now_ms,
    routed_elsewhere,
    existing_tid,
    on_stop_session,
    on_login_code,
  )
  finish(ok)
}

fn handle_connect_inbound_event_local(
  core : station_whole::WholeCore,
  connects : station_whole::ConnectsOsRuntime,
  meta : ConnectMeta,
  st_db : station_store::Store,
  connect_id : String,
  ev : station_connects::ChatEvent,
  now_ms : Int64,
  routed_elsewhere : Bool,
  existing_tid : Option[Int64],
  on_stop_session : (String) -> Unit,
  on_login_code : (String, String) -> Unit,
) -> Bool {
  match decide_connect_inbound(meta.single, meta.require_mention, routed_elsewhere, existing_tid is Some(_), ev) {
    ConnectInboundDecision::IgnoreAndAck => true
    ConnectInboundDecision::RefuseNoAck => false
    ConnectInboundDecision::StopTurn => {
      match existing_tid {
        Some(tid) => {
          match st_db.db.all(
            "SELECT session FROM thread_sessions WHERE thread = ?1 AND left_at IS NULL",
            [sql_db::int64_to_json(tid)],
          ) {
            Ok(rows) => {
              for i in 0..<rows.length() {
                let skey = match rows[i].get("session") {
                  Some(base_codec::Json::Str(s)) => s
                  _ => ""
                }
                if skey.length() > 0 {
                  match st_db.get_session(skey) {
                    Ok(Some(srow)) => {
                      if session_belongs_to_ws(srow.ws, meta.ws, core.config.home_workspace) {
                        on_stop_session(skey)
                      }
                    }
                    _ => ()
                  }
                }
              }
            }
            Err(_) => ()
          }
          true
        }
        None => true
      }
    }
    ConnectInboundDecision::HandleLoginCode => match ev {
      station_connects::ChatEvent::LoginCode(_, _, login_id, code, _) => {
        if login_id.length() > 0 && code.length() > 0 {
          on_login_code(login_id, code)
        }
        true
      }
      _ => true
    }
    ConnectInboundDecision::PersistMessage => match ev {
      station_connects::ChatEvent::Message(m) => {
        if !connects.workspace.should_deliver_thread(connect_id, m.channel, m.thread_ts, m.addressed) {
          return true
        }
        let sess_scope = if meta.single { m.channel } else { m.channel + "/" + m.thread_ts }
        let default_skey = connect_id + ":" + sess_scope
        // Security (P0-1): `threads.home` is a SESSION KEY (not a workspace ID!).
        // Ensure/create the owning session FIRST when creating a new thread so `threads.home = default_skey`
        // atomically resolves `COALESCE(h.ws, home_ws) == meta.ws` in `thread_visible_in_ws`!
        let ensure_default_session = fn() -> Bool {
          let exists_sess = match st_db.get_session(default_skey) {
            Ok(Some(existing_row)) => {
              if !session_belongs_to_ws(existing_row.ws, meta.ws, core.config.home_workspace) {
                return false
              }
              true
            }
            Ok(None) => false
            Err(_) => return false
          }
          if !exists_sess {
            let tok = match station_sys::random_hex(32) {
              Ok(h) => h
              Err(_) => return false
            }
            let sep = if station_sys::os_name() == "win32" { "\\" } else { "/" }
            match meta.cwd {
              Some(c) => if path_has_parent_traversal(c) {
                return false
              }
              None => ()
            }
            // R7 P0-1: Always use shared collision-free `server_session_workspace_dir(data_dir, ws, skey, sep)`.
            let sess_ws_dir = station_whole::server_session_workspace_dir(core.config.data_dir, meta.ws, default_skey, sep)
            let _ = station_sys::mkdir_p(sess_ws_dir)
            let new_sess = station_store::NewSession::{
              key: default_skey,
              connect: connect_id,
              sess_scope: sess_scope,
              title: None,
              created_by: Some(m.user),
              created_by_sub: None,
              runtime: meta.runtime,
              profile: meta.profile,
              model: None,
              effort: None,
              workspace: sess_ws_dir,
              cwd: meta.cwd,
              token: tok,
              created_at: now_ms,
              last_active_at: now_ms,
              ws: Some(meta.ws),
              told_notes: 0L,
            }
            match st_db.insert_session(new_sess) {
              Ok(_) => {
                core.agents.register_adopted_token(default_skey, tok)
                let _ = core.agents.adopt_all_active_tokens_from_store(core.store)
              }
              Err(_) => return false
            }
          }
          true
        }
        let tid = match existing_tid {
          Some(id) => id
          None => {
            if !ensure_default_session() {
              return false
            }
            match st_db.ensure_thread(
              meta.config_surface,
              m.channel,
              m.thread_ts,
              None,
              Some(m.user),
              now_ms,
              home=Some(default_skey),
            ) {
              Ok(id) => id
              Err(_) => return false
            }
          }
        }
        // Verify returned thread row genuinely belongs to `meta.ws` (protects against concurrent race).
        let tid_vis = match station_whole::thread_visible_in_ws(st_db, tid, meta.ws, core.config.home_workspace) {
          Ok(b) => b
          Err(_) => false
        }
        if !tid_vis {
          return false
        }
        let active_sessions : Array[String] = []
        let mut had_left_session = false
        match st_db.db.all(
          "SELECT session, left_at FROM thread_sessions WHERE thread = ?1",
          [sql_db::int64_to_json(tid)],
        ) {
          Ok(rows) => {
            for i in 0..<rows.length() {
              let skey = match rows[i].get("session") {
                Some(base_codec::Json::Str(s)) => s
                _ => ""
              }
              let is_left = match rows[i].get("left_at") {
                Some(base_codec::Json::Null) | None => false
                _ => true
              }
              if skey.length() > 0 {
                match st_db.get_session(skey) {
                  Ok(Some(srow)) => {
                    if !session_belongs_to_ws(srow.ws, meta.ws, core.config.home_workspace) {
                      return false
                    }
                  }
                  _ => ()
                }
                if is_left {
                  had_left_session = true
                } else {
                  active_sessions.push(skey)
                }
              }
            }
          }
          Err(_) => return false
        }
        if active_sessions.length() == 0 && (!had_left_session || m.addressed) {
          if !ensure_default_session() {
            return false
          }
          match st_db.join_thread(tid, default_skey, connect_id, now_ms) {
            Ok(_) => active_sessions.push(default_skey)
            Err(_) => return false
          }
        }
        let msg = station_store::NewMessage::{
          thread: tid,
          ts: Some(m.ts),
          author_kind: "person",
          author: m.user,
          agent_identity: None,
          text: Some(m.text),
          attachments: None,
          quotes: m.quoted,
          declared: None,
          client: None,
          card: None,
          options: None,
          proposal: None,
          at: now_ms,
        }
        match st_db.insert_message(msg, deliver_to=active_sessions) {
          Ok((n, fresh)) => {
            if fresh {
              if m.files.length() > 0 {
                let _ = st_db.tx(fn(t : sql_db::Db) -> Result[Unit, sql_db::SqlError] {
                  let mut ord = 0L
                  for fi in 0..<m.files.length() {
                    let f = m.files[fi]
                    let is_secret = match f.url {
                      Some(u) => u.starts_with("secret:")
                      None => false
                    }
                    if is_secret {
                      continue
                    }
                    let fid = if f.id.length() > 0 { f.id } else { "file-" + n.to_string() + "-" + fi.to_string() }
                    let url_json = match f.url {
                      Some(u) => base_codec::json_str(u)
                      None => base_codec::json_null()
                    }
                    match t.run(
                      "INSERT OR IGNORE INTO deferred_files (thread, n, file_id, name, size, url, ord) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
                      [
                        sql_db::int64_to_json(tid),
                        sql_db::int64_to_json(n),
                        base_codec::json_str(fid),
                        base_codec::json_str(f.name),
                        sql_db::int64_to_json(f.size),
                        url_json,
                        sql_db::int64_to_json(ord),
                      ],
                    ) {
                      Ok(_) => ()
                      Err(e) => return Err(e)
                    }
                    ord = ord + 1L
                  }
                  Ok(())
                })
              }
              for si in 0..<active_sessions.length() {
                let actor = core.agents.hub.ensure_actor(active_sessions[si], meta.runtime)
                let _ = actor.submit_input(m.text)
              }
              emit_thread_sse_event(core, meta.ws, tid, n, "message", "person", m.user, m.text, now_ms)
            }
            true
          }
          Err(_) => false
        }
      }
      _ => false
    }
    ConnectInboundDecision::PersistEdit => match ev {
      station_connects::ChatEvent::Changed(_, _, target_ts, new_text) => {
        let tid = match existing_tid {
          Some(id) => id
          None => return true
        }
        // 1:1 with TS `station/src/store/store.ts:3451-3469` (`#editMessage`): preserve
        // original `author_kind`, `author`, `attachments`, and `quotes`, and skip no-op edits.
        let target_row = match st_db.db.first(
          "SELECT n, author_kind, author, text, attachments, quotes FROM entries WHERE thread = ?1 AND ts = ?2 AND kind = 'message' LIMIT 1",
          [sql_db::int64_to_json(tid), base_codec::json_str(target_ts)],
        ) {
          Ok(Some(row)) => row
          Ok(None) => return true
          Err(_) => return false
        }
        let target_n = match target_row.get("n") {
          Some(base_codec::Json::Num(v, _)) => v.to_int64()
          _ => return true
        }
        let orig_ak = match target_row.get("author_kind") {
          Some(base_codec::Json::Str(s)) => s
          _ => "person"
        }
        let orig_author = match target_row.get("author") {
          Some(base_codec::Json::Str(s)) => s
          _ => ""
        }
        let orig_text = match target_row.get("text") {
          Some(base_codec::Json::Str(s)) => s
          _ => ""
        }
        let orig_att = match target_row.get("attachments") {
          Some(v) => v
          None => base_codec::json_null()
        }
        let orig_quotes = match target_row.get("quotes") {
          Some(v) => v
          None => base_codec::json_null()
        }
        let (latest_text, latest_att) = match st_db.db.first(
          "SELECT text, attachments FROM entries WHERE thread = ?1 AND target = ?2 AND n > ?2 AND kind = 'edit' ORDER BY n DESC LIMIT 1",
          [sql_db::int64_to_json(tid), sql_db::int64_to_json(target_n)],
        ) {
          Ok(Some(r)) => (
            match r.get("text") {
              Some(base_codec::Json::Str(s)) => s
              _ => orig_text
            },
            match r.get("attachments") {
              Some(v) => v
              None => orig_att
            },
          )
          _ => (orig_text, orig_att)
        }
        if latest_text == new_text {
          return true
        }
        let edit_res = st_db.tx(fn(t : sql_db::Db) -> Result[Int64, sql_db::SqlError] {
          let next_n = match t.first(
            "SELECT COALESCE(MAX(n), 0) + 1 AS next_n FROM entries WHERE thread = ?1",
            [sql_db::int64_to_json(tid)],
          ) {
            Ok(Some(r)) => match r.get("next_n") {
              Some(base_codec::Json::Num(v, _)) => v.to_int64()
              _ => 1L
            }
            Ok(None) => 1L
            Err(e) => return Err(e)
          }
          match t.run(
            "INSERT INTO entries (thread, n, kind, ts, author_kind, author, text, attachments, quotes, target, at) VALUES (?1, ?2, 'edit', NULL, ?3, ?4, ?5, ?6, ?7, ?8, ?9)",
            [
              sql_db::int64_to_json(tid),
              sql_db::int64_to_json(next_n),
              base_codec::json_str(orig_ak),
              base_codec::json_str(orig_author),
              base_codec::json_str(new_text),
              latest_att,
              orig_quotes,
              sql_db::int64_to_json(target_n),
              sql_db::int64_to_json(now_ms),
            ],
          ) {
            Ok(_) => Ok(next_n)
            Err(e) => Err(e)
          }
        })
        match edit_res {
          Ok(en) => {
            emit_thread_sse_event(core, meta.ws, tid, en, "edit", orig_ak, orig_author, new_text, now_ms)
            true
          }
          Err(_) => false
        }
      }
      _ => false
    }
  }
}

fn handle_feishu_card_answer(
  core : station_whole::WholeCore,
  connects : station_whole::ConnectsOsRuntime,
  connect_meta : Map[String, ConnectMeta],
  connect_id : String,
  ans : station_connects::FeishuCardAnswer,
  now_ms : Int64,
  on_done : (Bool) -> Unit,
  on_moved_to : Option[(String, String, base_codec::Json, base_codec::Json, (Bool) -> Unit) -> Unit] = None,
) -> Unit {
  let tts = if ans.thread_ts.length() > 0 { ans.thread_ts } else { ans.message_id }
  let ts = if ans.event_id.length() > 0 { "card-" + ans.event_id } else { "card-" + now_ms.to_string() }
  let ev = station_connects::ChatEvent::Message(
    station_connects::InboundMessage::{
      channel: ans.chat_id,
      thread_ts: tts,
      ts: ts,
      user: ans.user,
      text: ans.choice,
      addressed: true,
      files: [],
      quoted: if ans.message_id.length() > 0 { Some(ans.message_id) } else { None },
    },
  )
  let _ = handle_connect_inbound_event(core, connects, connect_meta, connect_id, ev, now_ms, on_done=Some(on_done), on_moved_to=on_moved_to)
}

/// Local attachment chunk reader for Comma `task.read_file` & `comma.read_file`
/// (1:1 with `station/src/comma/chats.ts` `routerReadFile`, `#9001`).
fn router_read_file_local(
  core : station_whole::WholeCore,
  ws : String,
  thread_id : Int64,
  seq : Int64,
  file_name : String,
  offset : Int64,
) -> Result[base_codec::Json, String] {
  if thread_id <= 0L {
    return Err("no such chat")
  }
  if seq <= 0L {
    return Err("seq must be a positive integer")
  }
  if file_name.trim().length() == 0 {
    return Err("file is required")
  }
  if offset < 0L {
    return Err("offset must be a non-negative integer")
  }
  let st_db = match core.store.require_open() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match st_db.get_thread(thread_id) {
    Ok(Some(_)) => ()
    Ok(None) => return Err("no such chat of the workspace")
    Err(e) => return Err(e.message)
  }
  let home_ws = core.config.home_workspace
  let visible = match station_whole::thread_visible_in_ws(st_db, thread_id, ws, home_ws) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !visible {
    return Err("no such chat of the workspace")
  }
  let att_raw = match st_db.db.first(
    "SELECT attachments FROM entries WHERE thread = ?1 AND ((n = ?2 AND kind = 'message') OR (target = ?2 AND kind = 'edit')) ORDER BY n DESC LIMIT 1",
    [sql_db::int64_to_json(thread_id), sql_db::int64_to_json(seq)],
  ) {
    Ok(Some(row)) => match row.get("attachments") {
      Some(base_codec::Json::Str(s)) => s
      _ => return Ok(base_codec::json_obj([("missing", base_codec::json_str("no such file"))]))
    }
    _ => return Ok(base_codec::json_obj([("missing", base_codec::json_str("no such file"))]))
  }
  let parsed = match base_codec::json_parse(att_raw) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Arr(arr)) => arr
    _ => return Ok(base_codec::json_obj([("missing", base_codec::json_str("no such file"))]))
  }
  let mut found_path = ""
  for i in 0..<parsed.length() {
    let item = parsed[i]
    let nm = match base_codec::json_get(item, "name") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let pt = match base_codec::json_get(item, "path") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    if nm == file_name && pt.length() > 0 {
      found_path = pt
      break
    }
  }
  if found_path.length() == 0 {
    return Ok(base_codec::json_obj([("missing", base_codec::json_str("no such file"))]))
  }
  let sep = if station_sys::os_name() == "win32" { "\\" } else { "/" }
  // Fail closed if `realpath` fails (never fall back to un-resolved `found_path`).
  let norm_att = match station_sys::realpath(found_path) {
    Some(rp) => rp
    None => return Ok(base_codec::json_obj([("missing", base_codec::json_str("no longer on its station"))]))
  }
  let mut within_uploads = false
  match st_db.db.all(
    "SELECT s.workspace AS workspace FROM thread_sessions ts JOIN sessions s ON s.key = ts.session WHERE ts.thread = ?1",
    [sql_db::int64_to_json(thread_id)],
  ) {
    Ok(rows) => {
      for i in 0..<rows.length() {
        match rows[i].get("workspace") {
          Some(base_codec::Json::Str(wdir)) => {
            if wdir.length() > 0 {
              let raw_up = nodepath::join(sep, [wdir, "uploads"])
              match station_sys::realpath(raw_up) {
                Some(up_dir) => {
                  if norm_att.starts_with(up_dir + sep) {
                    within_uploads = true
                    break
                  }
                }
                None => ()
              }
            }
          }
          _ => ()
        }
      }
    }
    Err(_) => ()
  }
  if !within_uploads {
    return Ok(base_codec::json_obj([("missing", base_codec::json_str("no such file"))]))
  }
  match station_sys::lstat_raw_err(norm_att) {
    Ok(st_str) => {
      if !st_str.starts_with("file|") {
        return Ok(base_codec::json_obj([("missing", base_codec::json_str("no such file"))]))
      }
    }
    Err(_) => return Ok(base_codec::json_obj([("missing", base_codec::json_str("no longer on its station"))]))
  }
  match station_sys::read_range_meta(norm_att, offset, station_connects::COMMA_FILE_PART_BYTES.to_int64()) {
    Err(_) => Ok(base_codec::json_obj([("missing", base_codec::json_str("no longer on its station"))]))
    Ok((chunk, total_sz, _)) => {
      if total_sz > station_connects::COMMA_READ_FILE_MAX_BYTES {
        return Ok(base_codec::json_obj([("missing", base_codec::json_str("file too large"))]))
      }
      if offset > total_sz {
        return Ok(base_codec::json_obj([("missing", base_codec::json_str("offset past end"))]))
      }
      Ok(
        base_codec::json_obj([
          ("name", base_codec::json_str(file_name)),
          ("size", base_codec::json_int64(total_sz)),
          ("offset", base_codec::json_int64(offset)),
          ("data", base_codec::json_str(base_codec::base64_encode(chunk))),
        ]),
      )
    }
  }
}

/// Identify all enabled external platform connects in raw `config.json` (1:1 with Node
/// `station/src/sessions/config.ts:174`: omitted `enabled` defaults to `true`, and any `kind`
/// other than `"feishu"` / `"comma"` / `"group"` — including omitted, `null`, `"chat"`, `"Slack"`,
/// or non-string — is treated as `"slack"`). Only `enabled: false` entries are ignored.
pub fn enabled_external_connects_in_config(cfg_raw : base_codec::Json) -> Array[String] {
  let out : Array[String] = []
  let items = match base_codec::json_get(cfg_raw, "connects") {
    Some(base_codec::Json::Arr(arr)) => arr
    _ => return out
  }
  for i in 0..<items.length() {
    let it = items[i]
    match it {
      base_codec::Json::Obj(_) => ()
      _ => continue
    }
    let enabled = match base_codec::json_get(it, "enabled") {
      Some(base_codec::Json::Bool(b)) => b
      _ => true
    }
    if !enabled {
      continue
    }
    let kind = match base_codec::json_get(it, "kind") {
      Some(base_codec::Json::Str("feishu")) => "feishu"
      Some(base_codec::Json::Str("comma")) => "comma"
      Some(base_codec::Json::Str("group")) => "group"
      _ => "slack"
    }
    let cid = match base_codec::json_get(it, "id") {
      Some(base_codec::Json::Str(s)) => {
        let t = s.trim()
        if t.length() > 0 { t } else { "(unnamed)" }
      }
      _ => "(unnamed)"
    }
    out.push(kind + ":" + cid)
  }
  out
}

/// Pure classifier for `<data>/remote-connects.json`: returns `Some(reason)` whenever the file
/// has any remote connect entries (`keys.length() > 0`) or is unreadable/corrupt (fail-safe).
pub fn remote_connects_file_needs_node(
  raw_opt : Option[String],
  read_failed : Bool,
) -> Option[String] {
  if read_failed {
    return Some("remote-connects.json(unreadable)")
  }
  match raw_opt {
    None => None
    Some(raw) => match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(base_codec::Json::Obj(entries)) => {
        if entries.length() > 0 {
          Some("remote-connects:" + entries.length().to_string())
        } else {
          None
        }
      }
      _ => Some("remote-connects.json(corrupt)")
    }
  }
}

/// Strict 3-state result for read-only SQLite cross-station session dependency checks:
/// `Unknown` (lock contention, busy timeout, I/O error, corrupt DB) MUST fail-safe and
/// never be treated as `NoneFound`.
pub enum DbDepCheck {
  NoneFound
  Found
  Unknown(String)
}

/// Maps `DbDepCheck` into a fallback/refusal reason (`None` only for `NoneFound`).
pub fn classify_db_dep_check(res : DbDepCheck) -> Option[String] {
  match res {
    DbDepCheck::NoneFound => None
    DbDepCheck::Found => Some("db:remote-connect-sessions")
    DbDepCheck::Unknown(reason) => Some(reason)
  }
}

/// Returns `"restore:pending-ready-json"` when `<data>/restore/ready.json` exists.
pub fn pending_restore_reason(ready_exists : Bool) -> Option[String] {
  if ready_exists {
    Some("restore:pending-ready-json")
  } else {
    None
  }
}

/// ASCII case-insensitive strict-engine parser aligned 1:1 with Rust launcher `main.rs:339`
/// (`STILLFAIL_STATION_ENGINE_STRICT`): returns `true` for trimmed `"1"` or `"true"` (any case).
pub fn is_engine_strict_value(raw : String) -> Bool {
  let t = raw.trim()
  let b = t.to_bytes()
  if b.length() == 1 && b[0] == (49).to_byte() {
    return true
  }
  if b.length() != 4 {
    return false
  }
  let lc = fn(ch : Byte) -> Int {
    let c = ch.to_int() & 0xFF
    if c >= 65 && c <= 90 { c + 32 } else { c }
  }
  lc(b[0]) == 116 && lc(b[1]) == 114 && lc(b[2]) == 117 && lc(b[3]) == 101
}

/// Aligned with `station/native/launcher/src/main.rs:339` (`STILLFAIL_STATION_ENGINE_STRICT`):
/// returns `true` for `"1"` or `"true"` (ASCII case-insensitive).
pub fn is_engine_strict_env(raw_val : Option[String]) -> Bool {
  match raw_val {
    Some(s) => is_engine_strict_value(s)
    None => false
  }
}

/// Extract `--app <dir>` or `--app=<dir>` from daemon `argv[1..]`.
pub fn extract_app_dir_from_argv(argv : Array[String]) -> Option[String] {
  let mut i = 1
  while i < argv.length() {
    let a = argv[i]
    if a == "--app" && i + 1 < argv.length() {
      let v = argv[i + 1].trim()
      if v.length() > 0 {
        return Some(v)
      }
      i = i + 2
    } else if a.starts_with("--app=") {
      let v = a.slice(6, a.length()).trim()
      if v.length() > 0 {
        return Some(v)
      }
      i = i + 1
    } else {
      i = i + 1
    }
  }
  None
}

pub enum ConnectInboundDecision {
  IgnoreAndAck
  RefuseNoAck
  PersistMessage
  PersistEdit
  StopTurn
  HandleLoginCode
}

/// Pure, side-effect-free inbound connect routing decision aligned 1:1 with
/// `station/src/sessions/hub.ts:1179,1252-1274` and `station/src/sessions/config.ts:166,177`.
pub fn decide_connect_inbound(
  single : Bool,
  require_mention : Bool,
  routed_elsewhere : Bool,
  existing_thread_exists : Bool,
  event : station_connects::ChatEvent,
) -> ConnectInboundDecision {
  if routed_elsewhere {
    return ConnectInboundDecision::RefuseNoAck
  }
  match event {
    station_connects::ChatEvent::Message(m) => {
      let wanted = m.addressed
      || (if single { !require_mention || existing_thread_exists } else { existing_thread_exists })
      if wanted {
        ConnectInboundDecision::PersistMessage
      } else {
        ConnectInboundDecision::IgnoreAndAck
      }
    }
    station_connects::ChatEvent::Changed(_, _, _, _) => {
      if existing_thread_exists {
        ConnectInboundDecision::PersistEdit
      } else {
        ConnectInboundDecision::IgnoreAndAck
      }
    }
    // 1:1 with Node `hub.ts:1179` (`acceptOwnNotice`): never insert spurious `author_kind='notice'` rows.
    station_connects::ChatEvent::OwnNotice(_) => ConnectInboundDecision::IgnoreAndAck
    station_connects::ChatEvent::Stop(_, _, _, _) => {
      if existing_thread_exists {
        ConnectInboundDecision::StopTurn
      } else {
        ConnectInboundDecision::IgnoreAndAck
      }
    }
    station_connects::ChatEvent::LoginCode(_, _, _, _, _) => ConnectInboundDecision::HandleLoginCode
  }
}

fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn percent_decode_segment(raw : String) -> String {
  let b = raw.to_bytes()
  let out : Array[Byte] = []
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c == 37 && i + 2 < b.length() {
      let hi = hex_nibble(b[i + 1].to_int() & 0xFF)
      let lo = hex_nibble(b[i + 2].to_int() & 0xFF)
      if hi >= 0 && lo >= 0 {
        out.push(((hi << 4) | lo) as Byte)
        i = i + 3
        continue
      }
    }
    out.push(b[i])
    i = i + 1
  }
  let res = Bytes::new(out.length())
  for j in 0..<out.length() {
    res[j] = out[j]
  }
  res.to_string()
}

/// Extracts `<key>` from `POST /sessions/<key>/stop` (ignoring query string).
pub fn extract_session_stop_key(method : String, raw_path : String) -> Option[String] {
  if method != "POST" {
    return None
  }
  let (path, _, _) = station_http::parse_request_target(raw_path)
  if !path.starts_with("/sessions/") || !path.ends_with("/stop") {
    return None
  }
  let pb = path.to_bytes()
  if pb.length() <= 15 {
    return None
  }
  let key_bytes = slice_bytes_local(pb, 10, pb.length() - 5)
  let raw_key = bytes_to_str_local(key_bytes, key_bytes.length())
  if raw_key.length() == 0 || raw_key.contains("/") {
    return None
  }
  Some(percent_decode_segment(raw_key))
}

/// Route `EV_CONFIG_WATCH` `FsChange` events to `core.config_file.on_fs_event(kind, name)`
/// so external edits to `config.json` hot-reload `agents.disabled_runtimes` in production.
pub fn route_whole_config_fs_event(
  core : station_whole::WholeCore,
  ev_id : Int64,
  sev : station_sys::SysEvent,
) -> Bool {
  if ev_id != EV_CONFIG_WATCH {
    return false
  }
  match (core.config_file, sev) {
    (Some(cfg), station_sys::SysEvent::FsChange(kind, name)) => {
      let _ = cfg.on_fs_event(kind, name)
      true
    }
    _ => true
  }
}

struct WholeRuntimeState {
  core : station_whole::WholeCore
  replica : station_whole::ReplicaOsRuntime
  devices : station_whole::DevicesOsRuntime
  terminals : station_whole::TerminalsOsRuntime
  logins : station_whole::LoginsOsRuntime
  browser : station_whole::BrowserOsManager
  dsb : station_whole::DeviceScreenBrowserRuntime
  connects : station_whole::ConnectsOsRuntime
  upkeep : AsyncUpkeepRunner
  connect_meta : Map[String, ConnectMeta]
  remote_connects : Map[String, RemoteConnectRecord]
  remote_connects_path : String
  comma_notifier : station_connects::PeerChangeNotifier
  dns_streams : Map[Int64, Int64]
  mut next_dns_ev_id : Int64
  mut replica_before_store_ok : Bool
  mcp_srv : station_http::HttpServer
  mcp_cb : station_http::ServerCallbacks
  serve : station_mesh::ServeEndpoint
  admin_conns : Map[Int64, AdminConnState]
  seen_members : Map[String, Map[String, Map[String, SeenMember]]]
  admin_streams : Map[Int64, AdminStreamState]
  proxy_streams : Map[Int64, ProxyStreamState]
  proxy_by_sock : Map[Int64, Int64]
  drive_rpc_puts : Map[Int64, WholeDriveRpcPutState]
  rig_put_streams : Map[Int64, StreamPutCtx]
  adopted_runners : Map[Int, AdoptedRunnerConn]
  adopted_runner_by_sock : Map[Int64, Int]
  live_runners : LiveRunnerManager
  mut next_runner_conn_id : Int
  mut carried_handover_failed : Option[String]
  mut mcp_announced : Bool
  mut handover_exported : Bool
  mut becoming_rig : Bool
  mut next_upkeep_ms : Int64
}

fn devices_table_exists_sql(db : sql_db::Db) -> Bool {
  match db.first("SELECT 1 AS ok FROM sqlite_master WHERE type='table' AND name='devices' LIMIT 1", []) {
    Ok(Some(_)) => true
    _ => false
  }
}

fn count_registered_devices_sql(store : station_whole::WholeStore) -> Int {
  match store.require_open() {
    Err(_) => 0
    Ok(st_db) => {
      if !devices_table_exists_sql(st_db.db) {
        return 0
      }
      match st_db.db.first("SELECT COUNT(*) AS c FROM devices", []) {
        Ok(Some(row)) => match row.get("c") {
          Some(base_codec::Json::Num(n, _)) => n.to_int()
          _ => 0
        }
        _ => 0
      }
    }
  }
}

fn lookup_registered_device_sql(
  store : station_whole::WholeStore,
  ws : String,
  dev_id : String,
) -> Option[station_devices::KeptDevice] {
  match store.require_open() {
    Err(_) => None
    Ok(st_db) => {
      if !devices_table_exists_sql(st_db.db) {
        return None
      }
      match st_db.db.first(
        "SELECT body FROM devices WHERE id = ?1 AND ws = ?2 LIMIT 1",
        [base_codec::json_str(dev_id), base_codec::json_str(ws)],
      ) {
        Ok(Some(row)) => match row.get("body") {
          Some(base_codec::Json::Str(body_str)) => match base_codec::json_parse(body_str) {
            base_codec::JsonParseResult::Ok(j) => {
              let id = match base_codec::json_get(j, "id") {
                Some(base_codec::Json::Str(s)) => s.trim()
                _ => dev_id
              }
              let name = match base_codec::json_get(j, "name") {
                Some(base_codec::Json::Str(s)) => s.trim()
                _ => id
              }
              let kind_str = match base_codec::json_get(j, "kind") {
                Some(base_codec::Json::Str(s)) => s.trim()
                _ => ""
              }
              let target = match base_codec::json_get(j, "target") {
                Some(base_codec::Json::Str(s)) => s.trim()
                _ => ""
              }
              let baud = match base_codec::json_get(j, "baud") {
                Some(base_codec::Json::Num(n, _)) => Some(n.to_int())
                _ => None
              }
              let model = match base_codec::json_get(j, "model") {
                Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
                _ => None
              }
              let protocols = match base_codec::json_get(j, "protocols") {
                Some(base_codec::Json::Arr(xs)) => {
                  let ps : Array[String] = []
                  for pi in 0..<xs.length() {
                    match xs[pi] {
                      base_codec::Json::Str(s) => ps.push(s)
                      _ => ()
                    }
                  }
                  Some(ps)
                }
                _ => None
              }
              let paired = match base_codec::json_get(j, "paired") {
                Some(base_codec::Json::Bool(b)) => Some(b)
                _ => None
              }
              let owner_sub = match base_codec::json_get(j, "ownerSub") {
                Some(base_codec::Json::Str(s)) => s
                _ => match base_codec::json_get(j, "owner") {
                  Some(base_codec::Json::Obj(_)) => match base_codec::json_get(match base_codec::json_get(j, "owner") { Some(o) => o, None => base_codec::json_obj([]) }, "sub") {
                    Some(base_codec::Json::Str(s)) => s
                    _ => ""
                  }
                  _ => ""
                }
              }
              let owner_email = match base_codec::json_get(j, "ownerEmail") {
                Some(base_codec::Json::Str(s)) => s
                _ => match base_codec::json_get(j, "owner") {
                  Some(base_codec::Json::Obj(_)) => match base_codec::json_get(match base_codec::json_get(j, "owner") { Some(o) => o, None => base_codec::json_obj([]) }, "email") {
                    Some(base_codec::Json::Str(s)) => s
                    _ => ""
                  }
                  _ => ""
                }
              }
              let owner_name = match base_codec::json_get(j, "ownerName") {
                Some(base_codec::Json::Str(s)) => s
                _ => match base_codec::json_get(j, "owner") {
                  Some(base_codec::Json::Obj(_)) => match base_codec::json_get(match base_codec::json_get(j, "owner") { Some(o) => o, None => base_codec::json_obj([]) }, "name") {
                    Some(base_codec::Json::Str(s)) => s
                    _ => ""
                  }
                  _ => ""
                }
              }
              let at_secs = match base_codec::json_get(j, "at") {
                Some(base_codec::Json::Num(n, _)) => n.to_int64()
                _ => 0L
              }
              match station_devices::parse_device_kind(kind_str) {
                Some(kind) => Some(station_devices::KeptDevice::{
                  ws: ws,
                  device: station_devices::DeviceSpec::{
                    id: id,
                    name: name,
                    kind: kind,
                    target: target,
                    baud: baud,
                    model: model,
                    protocols: protocols,
                    paired: paired,
                  },
                  owner_sub: owner_sub,
                  owner_email: owner_email,
                  owner_name: owner_name,
                  at_secs: at_secs,
                })
                None => None
              }
            }
            _ => None
          }
          _ => None
        }
        _ => None
      }
    }
  }
}

fn load_connects_from_config(
  cfg_raw : base_codec::Json,
  connects : station_whole::ConnectsOsRuntime,
  connect_meta : Map[String, ConnectMeta],
  home_ws : String,
) -> Unit {
  let items = match base_codec::json_get(cfg_raw, "connects") {
    Some(base_codec::Json::Arr(arr)) => arr
    _ => return
  }
  let get_str = fn(obj : base_codec::Json, k : String) -> String {
    match base_codec::json_get(obj, k) {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
  }
  let get_nested_str = fn(parent : base_codec::Json, sub_opt : Option[base_codec::Json], k : String) -> String {
    match sub_opt {
      Some(sub) => {
        let s = get_str(sub, k)
        if s.length() > 0 { return s }
      }
      None => ()
    }
    get_str(parent, k)
  }
  let env_slack_api = match station_sys::env_get("STILLFAIL_SLACK_API") {
    Some(u) => if u.trim().length() > 0 { u.trim() } else { "" }
    None => ""
  }
  for i in 0..<items.length() {
    let it = items[i]
    let enabled = match base_codec::json_get(it, "enabled") {
      Some(base_codec::Json::Bool(b)) => b
      _ => true
    }
    if !enabled {
      continue
    }
    let cid = get_str(it, "id")
    if cid.length() == 0 {
      continue
    }
    // Missing or null `kind` defaults to `"slack"` (1:1 with `station/src/slack/index.ts:53`).
    let raw_kind = get_str(it, "kind")
    let kind = if raw_kind.length() == 0 { "slack" } else { raw_kind }
    let ws = {
      let w = get_str(it, "workspace").trim()
      if w.length() > 0 { w } else { home_ws }
    }
    // 1:1 with `station/src/sessions/config.ts:166,177`:
    // `mode == "single-session"` honors `requireMention !== false`; `"multi-session"` always requires mention.
    let single = get_str(it, "mode") == "single-session"
    let require_mention = if !single {
      true
    } else {
      match base_codec::json_get(it, "requireMention") {
        Some(base_codec::Json::Bool(b)) => b
        _ => true
      }
    }
    let bind_opt = base_codec::json_get(it, "bind")
    let runtime = {
      let r = match bind_opt {
        Some(b) => get_str(b, "runtime").trim()
        None => ""
      }
      if r.length() > 0 { r } else { "claude" }
    }
    let profile = {
      let p = match bind_opt {
        Some(b) => get_str(b, "profile").trim()
        None => ""
      }
      if p.length() > 0 { p } else { "default" }
    }
    let cwd_opt : Option[String] = match bind_opt {
      Some(b) => {
        let c = get_str(b, "cwd").trim()
        if c.length() > 0 { Some(c) } else { None }
      }
      None => None
    }
    if kind == "slack" {
      let sub = base_codec::json_get(it, "slack")
      let team_id = match sub {
        Some(s) => match base_codec::json_get(s, "team") {
          Some(t) => get_str(t, "id").trim()
          None => ""
        }
        None => ""
      }
      let cfg_surface = if team_id.length() > 0 { "slack:" + team_id } else { "slack:" + cid }
      connect_meta.set(
        cid,
        ConnectMeta::{
          ws: ws,
          config_surface: cfg_surface,
          single: single,
          require_mention: require_mention,
          runtime: runtime,
          profile: profile,
          cwd: cwd_opt,
        },
      )
      let bot_tok = get_nested_str(it, sub, "botToken")
      let app_tok = get_nested_str(it, sub, "appToken")
      let cfg_base = get_nested_str(it, sub, "baseUrl")
      let base_url = if cfg_base.length() > 0 {
        cfg_base
      } else if env_slack_api.length() > 0 {
        env_slack_api
      } else {
        "https://slack.com/api"
      }
      if bot_tok.length() > 0 && app_tok.length() > 0 {
        match connects.register_slack(cid, app_tok, bot_tok, base_url=base_url) {
          Ok(_) => match connects.start_connect(cid) {
            Ok(_) => {
              // 1:1 with `station/src/slack/index.ts:173`: prefer runtime `auth.test` `team_id` over config `team.id` / `cid`.
              match connects.slack_team_id(cid) {
                Some(rt_tid) => {
                  connect_meta.set(
                    cid,
                    ConnectMeta::{
                      ws: ws,
                      config_surface: "slack:" + rt_tid,
                      single: single,
                      require_mention: require_mention,
                      runtime: runtime,
                      profile: profile,
                      cwd: cwd_opt,
                    },
                  )
                }
                None => ()
              }
            }
            Err(se) => {
              let _ = host_shim::write_stderr_line("[whole] slack connect " + cid + " start failed: " + se)
            }
          }
          Err(re) => {
            let _ = host_shim::write_stderr_line("[whole] slack connect " + cid + " register failed: " + re)
          }
        }
      }
    } else if kind == "feishu" {
      connect_meta.set(
        cid,
        ConnectMeta::{
          ws: ws,
          config_surface: "feishu:" + cid,
          single: single,
          require_mention: require_mention,
          runtime: runtime,
          profile: profile,
          cwd: cwd_opt,
        },
      )
      let sub = base_codec::json_get(it, "feishu")
      let app_id = get_nested_str(it, sub, "appId")
      let app_sec = get_nested_str(it, sub, "appSecret")
      let dom_str = get_nested_str(it, sub, "domain")
      let dom = if dom_str == "lark" {
        station_connects::FeishuDomain::Lark
      } else {
        station_connects::FeishuDomain::Feishu
      }
      let cfg_base = get_nested_str(it, sub, "baseUrl")
      let base_opt : Option[String] = if cfg_base.length() > 0 { Some(cfg_base) } else { None }
      if app_id.length() > 0 && app_sec.length() > 0 {
        match connects.register_feishu(cid, app_id, app_sec, domain=dom, base_url=base_opt) {
          Ok(_) => {
            let _ = connects.start_connect(cid)
          }
          Err(_) => ()
        }
      }
    } else if kind == "comma" {
      connect_meta.set(
        cid,
        ConnectMeta::{
          ws: ws,
          config_surface: "comma:" + cid,
          single: single,
          require_mention: require_mention,
          runtime: runtime,
          profile: profile,
          cwd: cwd_opt,
        },
      )
      let sub = base_codec::json_get(it, "comma")
      let srv = get_nested_str(it, sub, "server")
      let url = if srv.length() > 0 { srv } else { get_nested_str(it, sub, "url") }
      let tok = get_nested_str(it, sub, "token")
      let cname = get_nested_str(it, sub, "name")
      let inst_id = get_nested_str(it, sub, "instanceId")
      if url.length() > 0 && tok.length() > 0 {
        connects.register_comma(
          cid,
          url,
          tok,
          if cname.length() > 0 { cname } else { cid },
          if inst_id.length() > 0 { inst_id } else { cid },
          workspace=if ws.length() > 0 { Some(ws) } else { None },
        )
        let _ = connects.start_connect(cid)
      }
    } else if kind == "group" {
      connect_meta.set(
        cid,
        ConnectMeta::{
          ws: ws,
          config_surface: "group:" + cid,
          single: single,
          require_mention: require_mention,
          runtime: runtime,
          profile: profile,
          cwd: cwd_opt,
        },
      )
      let sub = base_codec::json_get(it, "group")
      let srv = get_nested_str(it, sub, "server")
      let origin = if srv.length() > 0 { srv } else { get_nested_str(it, sub, "origin") }
      let key_hex = get_nested_str(it, sub, "key")
      let secret = if key_hex.length() > 0 { key_hex } else { get_nested_str(it, sub, "secretHex") }
      let member_id = get_nested_str(it, sub, "memberId")
      let bot_name = {
        let bn = get_nested_str(it, sub, "botName")
        if bn.length() > 0 { bn } else { get_nested_str(it, sub, "name") }
      }
      if origin.length() > 0 && secret.length() > 0 && member_id.length() > 0 {
        match connects.register_group(
          cid,
          origin,
          secret,
          member_id,
          if bot_name.length() > 0 { bot_name } else { member_id },
        ) {
          Ok(_) => {
            let _ = connects.start_connect(cid)
          }
          Err(_) => ()
        }
      }
    }
  }
}

fn handle_device_tunnel(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  pstream : ProxyStreamState,
  ws : String,
  _session : String,
  dev_id : String,
  is_probe : Bool,
  carry : Bytes,
  own_ports : Map[Int, Bool],
  send_refusal : (DaemonCtx, Int64, Int, String) -> Unit,
) -> Unit {
  pstream.ws = Some(ws)
  if dev_id.length() == 0 {
    send_refusal(ctx, pstream.sid, 404, "no such device on this station")
    pstream.mode = ProxyStreamMode::Done
    return
  }
  // Live SQLite `devices` table query (1:1 with `station/src/devices/registry.ts`).
  // Any miss (missing or cross-workspace) returns unified 404 (zero existence oracle).
  match lookup_registered_device_sql(st.core.store, ws, dev_id) {
    None => {
      send_refusal(ctx, pstream.sid, 404, "no such device on this station")
      pstream.mode = ProxyStreamMode::Done
    }
    Some(kept) => {
      let spec = kept.device
      // Rig workspaces require explicit owner approval (fail-closed 403 here).
      if ctx.cloud.rig_in(ws) is Some(_) {
        send_refusal(ctx, pstream.sid, 403, "that machine refused: rig device requires owner approval")
        pstream.mode = ProxyStreamMode::Done
        return
      }
      let (dial_ip, dial_port) : (String, Int) = match spec.kind {
        station_devices::DeviceKind::Tcp => {
          let hp = match station_devices::host_port(spec.target) {
            Some(parsed) => parsed
            None => {
              send_refusal(ctx, pstream.sid, 502, "the device could not be reached there: invalid target " + spec.target)
              pstream.mode = ProxyStreamMode::Done
              return
            }
          }
          let reject_lo = own_ports.contains(hp.port)
          match station_sys::resolve_host_for_tunnel(hp.host, reject_lo) {
            station_sys::TunnelResolveResult::BlockedLoopback => {
              send_refusal(ctx, pstream.sid, 403, "that machine refused: device target port is the station's own")
              pstream.mode = ProxyStreamMode::Done
              return
            }
            station_sys::TunnelResolveResult::NeedsAsyncDns => {
              if carry.length() > WHOLE_MAX_PRE_CONNECT_BODY {
                send_refusal(ctx, pstream.sid, 413, "pre-connect payload too large")
                pstream.mode = ProxyStreamMode::Done
                return
              }
              let ev_id = st.next_dns_ev_id
              st.next_dns_ev_id = st.next_dns_ev_id + 1L
              pstream.mode = ProxyStreamMode::ResolvingHost(ev_id, hp.host, hp.port, is_probe, carry, pstream.peer_ended)
              st.dns_streams.set(ev_id, pstream.sid)
              if !station_sys::resolve_host_for_tunnel_async(ev_id, hp.host, reject_lo) {
                st.dns_streams.remove(ev_id)
                send_refusal(ctx, pstream.sid, 502, "the device could not be reached there: failed to start dns worker for " + hp.host)
                pstream.mode = ProxyStreamMode::Done
              }
              return
            }
            station_sys::TunnelResolveResult::Failed => {
              send_refusal(ctx, pstream.sid, 502, "the device could not be reached there: failed to resolve " + hp.host)
              pstream.mode = ProxyStreamMode::Done
              return
            }
            station_sys::TunnelResolveResult::Allowed(ip) => (ip, hp.port)
          }
        }
        station_devices::DeviceKind::Adb => {
          let adb_port = 5037
          if own_ports.contains(adb_port) {
            send_refusal(ctx, pstream.sid, 403, "that machine refused: device target port is the station's own")
            pstream.mode = ProxyStreamMode::Done
            return
          }
          ("127.0.0.1", adb_port)
        }
        station_devices::DeviceKind::Serial
        | station_devices::DeviceKind::AirPlay
        | station_devices::DeviceKind::AndroidTv => {
          // Honest 501 until full streaming device tunnel state machines are wired.
          send_refusal(ctx, pstream.sid, 501, "device tunnel for this device kind is not yet implemented on Pion station")
          pstream.mode = ProxyStreamMode::Done
          return
        }
      }
      if is_probe {
        ctx.write_peer_http_chunk(pstream.sid, encode_proxy_head_line(200, []))
        ctx.finish_peer_http(pstream.sid)
        pstream.mode = ProxyStreamMode::Done
        return
      }
      if carry.length() > WHOLE_MAX_PRE_CONNECT_BODY {
        send_refusal(ctx, pstream.sid, 413, "pre-connect payload too large")
        pstream.mode = ProxyStreamMode::Done
        return
      }
      pstream.mode = ProxyStreamMode::OpeningTcp(dial_port, carry, pstream.peer_ended)
      let dial_args = base_codec::json_obj([
        ("host", base_codec::json_str(dial_ip)),
        ("port", base_codec::json_int(dial_port)),
        ("timeoutMs", base_codec::json_int(5000)),
      ])
      let _ = ctx.mux_role.call_async_raw(
        builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_OPEN, pstream.sid),
        "tcp.dial",
        base_codec::json_stringify(dial_args),
        None,
      )
    }
  }
}

fn str_in_arr(arr : Array[String], target : String) -> Bool {
  for i in 0..<arr.length() {
    if arr[i] == target {
      return true
    }
  }
  false
}

fn req_header_ci(headers : Array[http1::Header], name : String) -> Option[String] {
  for i in 0..<headers.length() {
    if station_http::ascii_eq_ci(headers[i].name, name) {
      return Some(headers[i].value)
    }
  }
  None
}

fn parse_str_arr_json(j_opt : Option[base_codec::Json]) -> Array[String] {
  let out : Array[String] = []
  match j_opt {
    Some(base_codec::Json::Arr(arr)) => {
      for i in 0..<arr.length() {
        match arr[i] {
          base_codec::Json::Str(s) => {
            let t = s.trim()
            if t.length() > 0 {
              out.push(t)
            }
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

fn is_abs_drive_root(p : String, is_win : Bool) -> Bool {
  if p.length() == 0 {
    return false
  }
  if !is_win {
    return p.starts_with("/")
  }
  let c0 = p.code_unit_at(0)
  if p.length() >= 2 && c0 == 92 && p.code_unit_at(1) == 92 {
    return true
  }
  if p.length() >= 3 {
    let is_alpha = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
    let c1 = p.code_unit_at(1)
    let c2 = p.code_unit_at(2)
    if is_alpha && c1 == 58 && (c2 == 47 || c2 == 92) {
      return true
    }
  }
  false
}

fn clean_abs_drive_roots_with_sep(raw : Array[String], sep : String) -> Array[String] {
  let is_win = sep == "\\"
  let out : Array[String] = []
  for i in 0..<raw.length() {
    let t = raw[i].trim()
    if is_abs_drive_root(t, is_win) {
      let norm = nodepath::join(sep, [t])
      if is_abs_drive_root(norm, is_win) && !str_in_arr(out, norm) {
        out.push(norm)
      }
    }
  }
  out
}

fn clean_abs_drive_roots(raw : Array[String]) -> Array[String] {
  let sep = if station_sys::os_name() == "win32" { "\\" } else { "/" }
  clean_abs_drive_roots_with_sep(raw, sep)
}

/// Strictly resolve Drive roots for a single workspace (1:1 with `station/src/drive/drive.ts:104-107`):
/// - Home workspace (`is_home == true`): `drive.roots` (or `driveRoots` / `STILLFAIL_DRIVE_ROOTS`).
/// - Joined workspace (`is_home == false`): `drive.workspaces[ws]` ONLY.
/// - Rejects relative paths, normalizes absolute paths, NEVER shares home roots with joined workspaces,
///   and NEVER falls back to `$HOME`!
/// Pure workspace-scoped Drive roots resolver (zero `station_sys` dependency so unit tests can
/// exercise `resolve_session_launch_policy` directly).
fn parse_drive_roots_for_workspace_pure(
  cfg_raw : base_codec::Json,
  ws : String,
  is_home : Bool,
  env_roots_opt : Option[String],
  sep : String,
) -> Array[String] {
  if !is_home {
    match base_codec::json_get(cfg_raw, "drive") {
      Some(drv) => match base_codec::json_get(drv, "workspaces") {
        Some(wss) => return clean_abs_drive_roots_with_sep(parse_str_arr_json(base_codec::json_get(wss, ws)), sep)
        None => return []
      }
      None => return []
    }
  }
  let out : Array[String] = []
  match env_roots_opt {
    Some(env_roots) => {
      if env_roots.length() > 0 {
        let parts = env_roots.split(",")
        for i in 0..<parts.length() {
          let p = parts[i].trim()
          if p.length() > 0 {
            out.push(p)
          }
        }
      }
    }
    None => ()
  }
  if out.length() > 0 {
    return clean_abs_drive_roots_with_sep(out, sep)
  }
  let from_drive_roots = match base_codec::json_get(cfg_raw, "drive") {
    Some(drv) => parse_str_arr_json(base_codec::json_get(drv, "roots"))
    None => []
  }
  if from_drive_roots.length() > 0 {
    return clean_abs_drive_roots_with_sep(from_drive_roots, sep)
  }
  clean_abs_drive_roots_with_sep(parse_str_arr_json(base_codec::json_get(cfg_raw, "driveRoots")), sep)
}

fn parse_drive_roots_for_workspace(
  cfg_raw : base_codec::Json,
  ws : String,
  is_home : Bool,
) -> Array[String] {
  let sep = if station_sys::os_name() == "win32" { "\\" } else { "/" }
  parse_drive_roots_for_workspace_pure(cfg_raw, ws, is_home, station_sys::env_get("STILLFAIL_DRIVE_ROOTS"), sep)
}

fn build_whole_core_config(ctx : DaemonCtx, now_secs : Double) -> station_whole::WholeCoreConfig {
  let home_ws = match ctx.cloud.state {
    Some(s) => if s.workspace.length() > 0 { s.workspace } else { "local" }
    None => "local"
  }
  let allowed : Array[String] = []
  let full_ms = ctx.cloud.full_memberships(now_secs)
  for i in 0..<full_ms.length() {
    let w = full_ms[i].workspace
    if w.length() > 0 {
      allowed.push(w)
    }
  }
  let mut has_home = false
  for i in 0..<allowed.length() {
    if allowed[i] == home_ws {
      has_home = true
    }
  }
  if !has_home && home_ws.length() > 0 && ctx.cloud.rig_in(home_ws) is None {
    allowed.push(home_ws)
  }

  let rig_ws : Array[String] = []
  let mut rig_owner_email = ""
  let mut rig_owner_name = ""
  let mut rig_person = ""
  let rig_ms = ctx.cloud.rig_memberships(now_secs)
  for i in 0..<rig_ms.length() {
    rig_ws.push(rig_ms[i].workspace)
    match rig_ms[i].rig {
      Some(r) => {
        if rig_person.length() == 0 {
          rig_owner_email = r.owner_email
          rig_owner_name = r.owner_name
          rig_person = r.person
        }
      }
      None => ()
    }
  }

  let home_drive_roots = parse_drive_roots_for_workspace(ctx.cfg_raw, home_ws, true)
  let runner_bin = match station_sys::env_get("STILLFAIL_RUNNER") {
    Some(p) => if p.trim().length() > 0 { p.trim() } else {
      match ctx.args.app {
        Some(a) => nodepath::join(ctx.sep, [a, "station", "stillfail-runner"])
        None => ""
      }
    }
    None => match ctx.args.app {
      Some(a) => nodepath::join(ctx.sep, [a, "station", "stillfail-runner"])
      None => ""
    }
  }
  station_whole::WholeCoreConfig::{
    station_id: ctx.station_key.id,
    station_build: "0.1.0",
    data_dir: ctx.data,
    drive_roots: home_drive_roots,
    drive_protected: [ctx.data],
    assets_dir: nodepath::join(ctx.sep, [ctx.data, "assets"]),
    runner_bin: runner_bin,
    mcp_port: 0,
    home_workspace: home_ws,
    allowed_workspaces: allowed,
    rig_workspaces: rig_ws,
    rig_owner_email: rig_owner_email,
    rig_owner_name: rig_owner_name,
    rig_person_lock_id: rig_person,
  }
}

fn drive_entry_json_local(e : station_screens::DriveEntry) -> base_codec::Json {
  base_codec::json_obj([
    ("name", base_codec::json_str(e.name)),
    ("dir", base_codec::json_bool(e.dir)),
    ("size", base_codec::json_int64(e.size)),
    ("mtime", base_codec::json_int64(e.mtime)),
    ("mime", base_codec::json_str(e.mime)),
  ])
}

fn drive_code_name_local(c : station_screens::DriveCode) -> String {
  match c {
    station_screens::DriveCode::InvalidRequest => "invalid_request"
    station_screens::DriveCode::NotARoot => "not_a_root"
    station_screens::DriveCode::NotFound => "not_found"
    station_screens::DriveCode::PathEscape => "path_escape"
    station_screens::DriveCode::Protected => "protected"
    station_screens::DriveCode::Permission => "permission"
    station_screens::DriveCode::IsADirectory => "is_a_directory"
    station_screens::DriveCode::NotADirectory => "not_a_directory"
    station_screens::DriveCode::Exists => "exists"
    station_screens::DriveCode::UploadLost => "upload_lost"
    station_screens::DriveCode::NoTrash => "no_trash"
    station_screens::DriveCode::TooLarge => "too_large"
    station_screens::DriveCode::Io => "io"
  }
}

fn drive_err_http_resp(e : station_screens::DriveError) -> station_http::HttpResponse {
  let status = station_screens::drive_code_status(e.code)
  let fields : Array[(String, base_codec::Json)] = [
    ("error", base_codec::json_str(e.message)),
    ("code", base_codec::json_str(drive_code_name_local(e.code))),
  ]
  match e.have {
    Some(h) => fields.push(("have", base_codec::json_int64(h)))
    None => ()
  }
  station_api::json_status(status, base_codec::json_obj(fields))
}

fn resolve_drive_root_for_ws(
  core : station_whole::WholeCore,
  ws : String,
  requested : Option[String],
) -> Result[String, String] {
  let allowed = match core.api.workspace_drive_roots.get(ws) {
    Some(r) => r
    None => []
  }
  if allowed.length() == 0 {
    return Err("no drive roots authorized for workspace " + ws)
  }
  match requested {
    Some(r) => {
      if r.length() == 0 {
        return Ok(allowed[0])
      }
      for i in 0..<allowed.length() {
        if allowed[i] == r {
          return Ok(r)
        }
      }
      Err("drive root not authorized for workspace " + ws)
    }
    None => Ok(allowed[0])
  }
}

/// Look up the kept personal lock chain for `pin` in `CloudStore::person_chains`.
fn find_kept_person_chain(cloud : station_cloud::CloudStore, pin : String) -> Option[Array[form::Json]] {
  for i in 0..<cloud.person_chains.length() {
    let (genesis, entries) = cloud.person_chains[i]
    if genesis == pin && entries.length() > 0 {
      return Some(entries)
    }
  }
  None
}

/// Transactionally upsert `(pin, entries)` into `CloudStore::person_chains` and persist to disk.
/// Rolls back in-memory state and returns `Err` if `save_person_chains()` fails.
fn upsert_and_save_person_chain(
  cloud : station_cloud::CloudStore,
  pin : String,
  entries : Array[form::Json],
) -> Result[Unit, String] {
  let prev = cloud.person_chains
  let updated : Array[(String, Array[form::Json])] = []
  let mut found = false
  for i in 0..<prev.length() {
    let (g, es) = prev[i]
    if g == pin {
      updated.push((pin, entries))
      found = true
    } else {
      updated.push((g, es))
    }
  }
  if !found {
    updated.push((pin, entries))
  }
  cloud.set_person_chains(updated)
  match cloud.save_person_chains() {
    Ok(_) => Ok(())
    Err(e) => {
      cloud.set_person_chains(prev)
      Err("failed to persist personal lock chain: " + e)
    }
  }
}

/// Evaluate personal lock (`station/src/mesh/serve.ts:705-732` `onPersonalLock`):
/// merges kept + brought chains via `lock::person_chain` fork choice (where `device.remove` beats
/// pre-removal forks regardless of length), validates via `lock::admit_person`, and persists the
/// winning chain back to `CloudStore::person_chains` so subsequent live checks agree.
fn verify_on_personal_lock(
  cloud : station_cloud::CloudStore,
  ls : lock::LockState,
  sub : String,
  endpoint : String,
  lock_base : Option[String],
  lock_proof : Option[String],
  hello_opt : Option[base_codec::Json],
  crypto_adapter : lock::Crypto,
) -> Result[String, String] {
  let pin = match ls.persons.get(sub) {
    Some(p) => p
    None => return Err("person has no bound personal lock")
  }
  let kept_opt = find_kept_person_chain(cloud, pin)
  let mut brought_opt : Option[Array[form::Json]] = None
  match hello_opt {
    Some(hello) => {
      match base_codec::json_get(hello, "lock") {
        Some(lobj) => {
          match base_codec::json_get(lobj, "person") {
            Some(base_codec::Json::Arr(items)) => {
              if items.length() > 0 && items.length() <= 64 {
                let arr : Array[form::Json] = []
                for i in 0..<items.length() {
                  arr.push(station_rules_bridge::base_to_form(items[i]))
                }
                brought_opt = Some(arr)
              }
            }
            _ => ()
          }
        }
        None => ()
      }
    }
    None => ()
  }
  let combined : Array[form::Json] = []
  match kept_opt {
    Some(k) => {
      for i in 0..<k.length() {
        combined.push(k[i])
      }
    }
    None => ()
  }
  match brought_opt {
    Some(b) => {
      for i in 0..<b.length() {
        combined.push(b[i])
      }
    }
    None => ()
  }
  if combined.length() == 0 {
    return Err("this device goes by its person's own lock in this workspace, and it brought none")
  }
  let chosen = match lock::person_chain(combined, pin, crypto_adapter) {
    Ok(ch) => ch.entries
    Err(_) => return Err("person's own lock chain invalid")
  }
  if chosen.length() == 0 {
    return Err("person's own lock chain empty")
  }
  match lock::admit_person(ls, sub, endpoint, lock_base, lock_proof, chosen, crypto_adapter) {
    Ok((_, lock_role, _)) => {
      // Transactionally persist the winning fork-choice chain before admitting `hello`!
      if brought_opt is Some(_) {
        match upsert_and_save_person_chain(cloud, pin, chosen) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      Ok(lock_role)
    }
    Err(_) => Err("device not admitted by person's own lock")
  }
}

/// Locate every `ws` entry in `person_chains` (active chain + kept `aside` forks) committing to
/// statement body hash `h` and return the exact chain prefix from genesis to that entry
/// (1:1 with `PersonChains.commitsTo` in `station/src/mesh/person-chains.ts:187`, capped at `CHAIN_MOST = 1024`),
/// because `lock::body_refusal` checks the LAST entry.
fn commits_to_body(
  person_chains : Array[(String, Array[form::Json])],
  aside_opt : Option[form::Json],
  h : String,
) -> Array[lock::Commit] {
  let chain_most = 1024
  let out : Array[lock::Commit] = []
  for ci in 0..<person_chains.length() {
    let (g, active) = person_chains[ci]
    let all : Array[form::Json] = []
    for i in 0..<active.length() {
      all.push(active[i])
    }
    match form::json_field(aside_opt, g) {
      Some(form::Json::Arr(xs)) => {
        for i in 0..<xs.length() {
          all.push(xs[i])
        }
      }
      _ => ()
    }
    let by : Map[String, form::Json] = Map::new()
    for i in 0..<all.length() {
      match station_rules_bridge::entry_hash(all[i]) {
        Ok(eh) => by.set(eh, all[i])
        Err(_) => ()
      }
    }
    for j in 0..<all.length() {
      let e = all[j]
      let kind = match form::json_field(Some(e), "kind") {
        Some(form::Json::Str(s)) => s
        _ => ""
      }
      if kind != "ws" {
        continue
      }
      let body_h = match form::json_field(form::json_field(Some(e), "body"), "h") {
        Some(form::Json::Str(s)) => s
        _ => ""
      }
      if body_h != h {
        continue
      }
      let rev : Array[form::Json] = []
      let mut cur_opt : Option[form::Json] = Some(e)
      while rev.length() <= chain_most {
        match cur_opt {
          None => break
          Some(cur) => {
            rev.push(cur)
            match form::json_field(Some(cur), "prev") {
              Some(form::Json::Str(prev_h)) => cur_opt = by.get(prev_h)
              _ => break
            }
          }
        }
      }
      if rev.length() > 0 {
        let first = rev[rev.length() - 1]
        let is_genesis = match form::json_field(Some(first), "prev") {
          Some(form::Json::Null) | None => true
          _ => false
        }
        if is_genesis {
          let prefix : Array[form::Json] = []
          let mut k = rev.length() - 1
          while k >= 0 {
            prefix.push(rev[k])
            k = k - 1
          }
          out.push(lock::Commit::{ genesis: g, chain: prefix })
        }
      }
    }
  }
  out
}

/// Bring missing moved-lock root chain (`lock.person`) and statement bodies (`lock.bodies`) from
/// an authenticated hello while a workspace is in `waiting` state (`station/src/mesh/serve.ts` `broughtForState`).
/// Fail-closed persistence order: validates `lock.person` in memory first, persists `lock.bodies`
/// BEFORE saving the root chain so a body write failure NEVER leaves the root chain persisted
/// without its rotated settings body (which would exit `waiting` using carried old `cloud_keys`).
fn bring_waiting_lock(
  cloud : station_cloud::CloudStore,
  hello : base_codec::Json,
  ws : String,
  now_secs : Double,
) -> Bool {
  let home_ws = match cloud.home() {
    Some(h) => h
    None => ""
  }
  let joined_ws : Option[String] = if ws == home_ws { None } else { Some(ws) }
  let root = match cloud.chain(ws=joined_ws) {
    Some(kl) => match kl.state {
      Some(st) => match st.moved {
        Some(r) => r
        None => return false
      }
      None => return false
    }
    None => return false
  }
  match cloud.locked(now_secs, ws=joined_ws) {
    Some(eff) => if !eff.waiting { return false }
    None => return false
  }
  let lobj = match base_codec::json_get(hello, "lock") {
    Some(o) => o
    None => return false
  }
  let mut cand_chain : Option[Array[form::Json]] = None
  match base_codec::json_get(lobj, "person") {
    Some(base_codec::Json::Arr(items)) => {
      if items.length() > 0 && items.length() <= 64 {
        let arr : Array[form::Json] = []
        for i in 0..<items.length() {
          arr.push(station_rules_bridge::base_to_form(items[i]))
        }
        match lock::person_chain(arr, root, station_rules_bridge::lock_crypto()) {
          Ok(ch) => if ch.entries.length() > 0 { cand_chain = Some(ch.entries) }
          Err(_) => ()
        }
      }
    }
    _ => ()
  }
  let mut any = false
  match base_codec::json_get(lobj, "bodies") {
    Some(base_codec::Json::Arr(items)) => {
      if items.length() > 0 && items.length() <= 64 {
        let arr : Array[form::Json] = []
        for i in 0..<items.length() {
          arr.push(station_rules_bridge::base_to_form(items[i]))
        }
        let cand_chains : Array[(String, Array[form::Json])] = []
        let mut replaced = false
        for ci in 0..<cloud.person_chains.length() {
          let (g, ch) = cloud.person_chains[ci]
          if g == root {
            match cand_chain {
              Some(new_ch) => {
                cand_chains.push((root, new_ch))
                replaced = true
              }
              None => cand_chains.push((g, ch))
            }
          } else {
            cand_chains.push((g, ch))
          }
        }
        if !replaced {
          match cand_chain {
            Some(new_ch) => cand_chains.push((root, new_ch))
            None => ()
          }
        }
        let commits_fn = fn(h : String) -> Array[lock::Commit] {
          commits_to_body(cand_chains, cloud.person_chains_aside, h)
        }
        match cloud.take_bodies(joined_ws, arr, commits_fn) {
          Ok(r) => if r.taken > 0 { any = true }
          Err(_) => return false
        }
      }
    }
    _ => ()
  }
  match cand_chain {
    Some(entries) => {
      match upsert_and_save_person_chain(cloud, root, entries) {
        Ok(_) => any = true
        Err(_) => return false
      }
    }
    None => ()
  }
  any
}

/// Evaluate workspace lock + personal lock for a member (`station/src/mesh/serve.ts:641-672` `inLock`/`stillIn`).
fn verify_member_lock(
  cloud : station_cloud::CloudStore,
  ws : String,
  sub : String,
  endpoint : String,
  lock_base : Option[String],
  lock_proof : Option[String],
  hello_opt : Option[base_codec::Json],
  now_secs : Double,
) -> Result[Option[String], String] {
  let home_ws = match cloud.home() {
    Some(h) => h
    None => ""
  }
  let joined_ws : Option[String] = if ws == home_ws { None } else { Some(ws) }
  match cloud.locked(now_secs, ws=joined_ws) {
    None => Ok(None)
    Some(eff) => {
      if eff.waiting {
        return Err(station_mesh::NOT_GIVEN_WAITING)
      }
      match eff.state {
        None => Err("this station's workspace lock is broken")
        Some(ls) => {
          let crypto_adapter = station_rules_bridge::lock_crypto()
          match lock::admit(ls, sub, endpoint, lock_base, lock_proof, now_secs, crypto_adapter) {
            Ok((dev, lock_role)) => {
              // Align with `station/src/mesh/serve.ts:653-657`:
              // An app device whose person is bound in `state.persons` and not `by == "chain"`
              // MUST ALSO pass `onPersonalLock` (if removed from personal lock, reject!).
              let is_by_chain = match dev.by {
                Some(b) => b == "chain"
                None => false
              }
              if dev.kind == "app" && ls.persons.contains(sub) && !is_by_chain {
                match verify_on_personal_lock(cloud, ls, sub, endpoint, lock_base, lock_proof, hello_opt, crypto_adapter) {
                  Ok(person_role) => Ok(Some(person_role))
                  Err(e) => Err(e)
                }
              } else {
                Ok(Some(lock_role))
              }
            }
            Err(_) => {
              // Fallback to personal lock when device is only listed on the person's own lock.
              if ls.persons.contains(sub) {
                match verify_on_personal_lock(cloud, ls, sub, endpoint, lock_base, lock_proof, hello_opt, crypto_adapter) {
                  Ok(person_role) => Ok(Some(person_role))
                  Err(e) => Err(e)
                }
              } else {
                Err("device not admitted by workspace lock")
              }
            }
          }
        }
      }
    }
  }
}

fn member_role_rank(r : String) -> Int {
  if r == "owner" { 3 } else if r == "admin" { 2 } else if r == "member" { 1 } else { 0 }
}

struct VerifiedMember {
  session : station_mesh::MemberSession
  name : String
  iat : Int64
  sid_claim : String
  cred_role : String
  lock_base : Option[String]
  lock_proof : Option[String]
}

/// Cryptographically verify a cloud-signed EdDSA (Ed25519) member JWT against `CloudStore`
/// (`grant_keys`, full memberships, `device == remote_id`, expiry, revocations, workspace lock, and personal lock).
fn verify_member_credential(
  cloud : station_cloud::CloudStore,
  hello : base_codec::Json,
  remote_id : String,
  now_secs : Double,
  prior_lock : Option[(String, String)] = None,
) -> Result[VerifiedMember, mesh_door::Refusal] {
  let refuse = fn(msg : String, code : Int, reason : String) -> Result[VerifiedMember, mesh_door::Refusal] {
    Err(mesh_door::Refusal::{
      line: base_codec::json_obj([("error", base_codec::json_str(msg))]),
      code: code,
      reason: reason,
      error: msg,
    })
  }
  let verify_cred_step = fn(h : base_codec::Json) -> Result[VerifiedMember, mesh_door::Refusal] {
    if remote_id.length() == 0 {
      return refuse("missing peer device id", 3, "unauthorized")
    }
    let cred = match base_codec::json_get(h, "credential") {
      Some(base_codec::Json::Str(s)) => s
      _ => return refuse("missing credential", 3, "unauthorized")
    }
    let parts = cred.split(".")
    if parts.length() != 3 {
      return refuse("malformed credential", 3, "unauthorized")
    }
    let head_b64 = parts[0]
    let body_b64 = parts[1]
    let sig_b64 = parts[2]

    let head_bytes = match station_rules_bridge::decode_base64url_flex(head_b64) {
      Ok(b) => b
      Err(_) => return refuse("malformed credential header", 3, "unauthorized")
    }
    let head_j = match base_codec::json_parse(bytes_to_str_local(head_bytes, head_bytes.length())) {
      base_codec::JsonParseResult::Ok(j) => j
      base_codec::JsonParseResult::Err(_) => return refuse("invalid credential header json", 3, "unauthorized")
    }
    let alg = match base_codec::json_get(head_j, "alg") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let typ = match base_codec::json_get(head_j, "typ") {
      Some(base_codec::Json::Str(s)) => s
      _ => ""
    }
    let spec = station_cloud::spec_of(cloud.provider())
    if alg != "EdDSA" || !str_in_arr(spec.credential.types, typ) {
      return refuse("not a member's credential", 3, "unauthorized")
    }
    let kid_opt : Option[String] = match base_codec::json_get(head_j, "kid") {
      Some(base_codec::Json::Str(s)) => if s.length() > 0 { Some(s) } else { None }
      _ => None
    }

    let body_bytes = match station_rules_bridge::decode_base64url_flex(body_b64) {
      Ok(b) => b
      Err(_) => return refuse("malformed credential payload", 3, "unauthorized")
    }
    let claims = match base_codec::json_parse(bytes_to_str_local(body_bytes, body_bytes.length())) {
      base_codec::JsonParseResult::Ok(j) => j
      base_codec::JsonParseResult::Err(_) => return refuse("invalid credential payload json", 3, "unauthorized")
    }
    let claim_str = fn(k : String) -> String {
      match base_codec::json_get(claims, k) {
        Some(base_codec::Json::Str(s)) => s
        _ => ""
      }
    }
    let claim_i64 = fn(k : String) -> Int64 {
      match base_codec::json_get(claims, k) {
        Some(base_codec::Json::Num(n, raw)) => match base_codec::parse_int64_str(raw) {
          Some(v) => v
          None => n.to_int64()
        }
        _ => 0L
      }
    }

    let iss = claim_str("iss")
    if !str_in_arr(spec.credential.issuers, iss) {
      return refuse("credential not issued by control plane", 3, "unauthorized")
    }
    let ws = claim_str("ws")
    if ws.length() == 0 {
      return refuse("credential missing workspace", 3, "unauthorized")
    }
    let full_ms = cloud.full_memberships(now_secs)
    let mut matched_m : Option[station_cloud::Membership] = None
    for i in 0..<full_ms.length() {
      if full_ms[i].workspace == ws {
        matched_m = Some(full_ms[i])
        break
      }
    }
    let membership = match matched_m {
      Some(m) => m
      None => return refuse("credential is for another workspace", 3, "unauthorized")
    }

    let home_ws = match cloud.home() {
      Some(hp) => hp
      None => ""
    }
    let joined_ws : Option[String] = if ws == home_ws { None } else { Some(ws) }
    let gkeys = cloud.grant_keys(now_secs, ws=joined_ws)
    let jwk_arr : Array[base_codec::Json] = match base_codec::json_get(gkeys, "keys") {
      Some(base_codec::Json::Arr(a)) => a
      _ => []
    }
    let mut matched_x : Option[String] = None
    for ki in 0..<jwk_arr.length() {
      let jwk = jwk_arr[ki]
      let jkid = match base_codec::json_get(jwk, "kid") {
        Some(base_codec::Json::Str(s)) => s
        _ => ""
      }
      let kid_ok = match kid_opt {
        None => true
        Some(want) => jkid == want
      }
      if kid_ok {
        match base_codec::json_get(jwk, "x") {
          Some(base_codec::Json::Str(xs)) => {
            matched_x = Some(xs)
            break
          }
          _ => ()
        }
      }
    }
    let x_b64 = match matched_x {
      Some(xs) => xs
      None => return refuse("unknown credential key", 3, "unauthorized")
    }
    let pub_bytes = match station_rules_bridge::decode_base64url_flex(x_b64) {
      Ok(b) => if b.length() == 32 { b } else { return refuse("invalid credential public key", 3, "unauthorized") }
      Err(_) => return refuse("invalid credential public key", 3, "unauthorized")
    }
    let sig_bytes = match station_rules_bridge::decode_base64url_flex(sig_b64) {
      Ok(b) => if b.length() == 64 { b } else { return refuse("invalid credential signature length", 3, "unauthorized") }
      Err(_) => return refuse("malformed credential signature", 3, "unauthorized")
    }
    let key_id = "ed25519:" + base_codec::hex_encode(pub_bytes)
    let signing_input = (head_b64 + "." + body_b64).to_bytes()
    if !station_rules_bridge::signature_ok(key_id, sig_bytes, signing_input) {
      return refuse("credential signature invalid", 3, "unauthorized")
    }

    let device = claim_str("device")
    if device != remote_id {
      return refuse("credential is for another device", 3, "unauthorized")
    }
    let exp = claim_i64("exp")
    if exp <= now_secs.to_int64() {
      return refuse("credential expired", 3, "credential_expired")
    }
    let sub = claim_str("sub")
    let email = claim_str("email")
    let name = claim_str("name")
    let role = claim_str("role")
    if role != "owner" && role != "admin" && role != "member" && role != "viewer" {
      return refuse("invalid member role in credential", 3, "unauthorized")
    }
    let iat = claim_i64("iat")
    let sid_claim = claim_str("sid")

    // Enforce workspace revocations (`sub` or `sid` issued up to `rev.at`).
    for ri in 0..<membership.revocations.length() {
      let r = membership.revocations[ri]
      if iat <= r.at && ((r.kind == "sub" && r.id == sub) || (r.kind == "sid" && r.id == sid_claim)) {
        return refuse("credential revoked", 3, "credential_revoked")
      }
    }

    let mut lock_base : Option[String] = match prior_lock {
      Some((b, _)) => Some(b)
      None => None
    }
    let mut lock_proof_str : Option[String] = match prior_lock {
      Some((_, p)) => Some(p)
      None => None
    }
    match base_codec::json_get(h, "lock") {
      Some(lobj) => {
        match (base_codec::json_get(lobj, "device"), base_codec::json_get(lobj, "proof")) {
          (Some(base_codec::Json::Str(db)), Some(base_codec::Json::Str(dp))) => {
            if db.length() == 64 && dp.length() == 128 {
              lock_base = Some(db)
              lock_proof_str = Some(dp)
            }
          }
          _ => ()
        }
      }
      None => ()
    }

    let eff_email = if email.length() > 0 { email } else { sub }
    let eff_name = if name.length() > 0 { name } else { eff_email }
    Ok(VerifiedMember::{
      session: station_mesh::MemberSession::{
        workspace: ws,
        user_sub: sub,
        email: eff_email,
        role: role,
        device_id: remote_id,
        expires_unix: exp,
      },
      name: eff_name,
      iat: iat,
      sid_claim: sid_claim,
      cred_role: role,
      lock_base: lock_base,
      lock_proof: lock_proof_str,
    })
  }

  let mut last_vm : Option[VerifiedMember] = None
  let mut cred_refusal : Option[mesh_door::Refusal] = None
  let is_waiting_ws = fn(w : String) -> Bool {
    let home_ws = match cloud.home() {
      Some(hp) => hp
      None => ""
    }
    let jw : Option[String] = if w == home_ws { None } else { Some(w) }
    match cloud.locked(now_secs, ws=jw) {
      Some(eff) => eff.waiting
      None => false
    }
  }
  let res = station_mesh::admit_member_with_waiting_recovery(
    hello,
    fn(h : base_codec::Json) -> Result[station_mesh::MemberSession, (station_mesh::RefusalKind, Array[(String, base_codec::Json)])] {
      match verify_cred_step(h) {
        Ok(vm) => {
          last_vm = Some(vm)
          Ok(vm.session)
        }
        Err(refusal) => {
          cred_refusal = Some(refusal)
          Err((station_mesh::RefusalKind::CredentialError(refusal.error), []))
        }
      }
    },
    is_waiting_ws,
    fn(h : base_codec::Json, w : String) -> Bool { bring_waiting_lock(cloud, h, w, now_secs) },
    fn(_sub : String) -> Unit { () },
    fn(_sess : station_mesh::MemberSession) -> Unit { () },
    fn(sess : station_mesh::MemberSession, h : base_codec::Json) -> Result[(station_mesh::MemberSession, base_codec::Json), (station_mesh::RefusalKind, Array[(String, base_codec::Json)])] {
      let vm = match last_vm {
        Some(v) => v
        None => return Err((station_mesh::RefusalKind::CredentialError("missing verified member"), []))
      }
      match verify_member_lock(cloud, sess.workspace, sess.user_sub, remote_id, vm.lock_base, vm.lock_proof, Some(h), now_secs) {
        Err(why) => Err((station_mesh::RefusalKind::LockRefusal(why), []))
        Ok(Some(lock_role)) => {
          let eff_role = if member_role_rank(lock_role) < member_role_rank(sess.role) { lock_role } else { sess.role }
          Ok((
            station_mesh::MemberSession::{
              workspace: sess.workspace,
              user_sub: sess.user_sub,
              email: sess.email,
              role: eff_role,
              device_id: sess.device_id,
              expires_unix: sess.expires_unix,
            },
            base_codec::Json::Null,
          ))
        }
        Ok(None) => Ok((sess, base_codec::Json::Null))
      }
    },
  )
  match res {
    Ok((final_sess, _)) => {
      let vm = match last_vm {
        Some(v) => v
        None => return refuse("missing verified member", 3, "unauthorized")
      }
      Ok(VerifiedMember::{
        session: final_sess,
        name: vm.name,
        iat: vm.iat,
        sid_claim: vm.sid_claim,
        cred_role: vm.cred_role,
        lock_base: vm.lock_base,
        lock_proof: vm.lock_proof,
      })
    }
    Err(refusal) => match cred_refusal {
      Some(cr) => Err(cr)
      None => Err(refusal)
    }
  }
}

fn parse_admin_headers(j_opt : Option[base_codec::Json]) -> Array[http1::Header] {
  let out : Array[http1::Header] = []
  match j_opt {
    Some(base_codec::Json::Obj(fields)) => {
      for i in 0..<fields.length() {
        let (k, v) = fields[i]
        match v {
          base_codec::Json::Str(s) => out.push(http1::Header::new(k, s))
          _ => ()
        }
      }
    }
    Some(base_codec::Json::Arr(items)) => {
      for i in 0..<items.length() {
        match items[i] {
          base_codec::Json::Arr(pair) => {
            if pair.length() >= 2 {
              match (pair[0], pair[1]) {
                (base_codec::Json::Str(k), base_codec::Json::Str(v)) => out.push(http1::Header::new(k, v))
                _ => ()
              }
            }
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

fn encode_admin_head_line(status : Int, headers : Array[http1::Header], body_len : Option[Int64]) -> Bytes {
  let hfields : Array[(String, base_codec::Json)] = []
  let mut has_cl = false
  let mut has_ce = false
  for i in 0..<headers.length() {
    let k = mesh_wire::ascii_lower(headers[i].name)
    if k == "content-length" {
      has_cl = true
    } else if k == "content-encoding" {
      has_ce = true
    }
    hfields.push((k, base_codec::json_str(headers[i].value)))
  }
  match body_len {
    Some(n) => {
      if !has_cl && !has_ce {
        hfields.push(("content-length", base_codec::json_str(n.to_string())))
      }
    }
    None => ()
  }
  let head_j = base_codec::json_obj([
    ("status", base_codec::json_int(status)),
    ("headers", base_codec::json_obj(hfields)),
  ])
  (base_codec::json_stringify(head_j) + "\n").to_bytes()
}

fn encode_proxy_head_line(status : Int, headers : Array[(String, String)]) -> Bytes {
  let h_arr : Array[base_codec::Json] = []
  for i in 0..<headers.length() {
    let (k, v) = headers[i]
    h_arr.push(base_codec::json_arr([base_codec::json_str(k), base_codec::json_str(v)]))
  }
  let head_j = base_codec::json_obj([
    ("status", base_codec::json_int(status)),
    ("headers", base_codec::json_arr(h_arr)),
  ])
  (base_codec::json_stringify(head_j) + "\n").to_bytes()
}

/// Encode a `preview.ts` WebSocket frame: `[kind: u8][length: u32be][payload]`.
fn encode_ws_proxy_frame(kind : Int, payload : Bytes) -> Bytes {
  let out = Bytes::new(5 + payload.length())
  out[0] = (kind & 0xFF) as Byte
  write_u32_be(out, 1, payload.length().to_int64())
  for i in 0..<payload.length() {
    out[5 + i] = payload[i]
  }
  out
}

/// Scan `<data>/run/runners/*.json` for live runner metadata to pass into
/// `WholeCore::open_after_predecessor_gone` (`whole_agents.pion:807`).
/// Prioritizes native `stillfail-runner` field `"runner"` (`station/native/runner/src/main.rs:376`),
/// falling back to `"runnerPid"` / `"runner_pid"` for compatibility.
pub enum RunnerPidStatus {
  Alive
  ConfirmedDead
  Unknown
}

/// R20/R21: Unified tri-state runner PID liveness probe:
/// - `rpid <= 1` or `station_sys::proc_kill_is_esrch(kill_rc)` (`-3`) -> `ConfirmedDead`
/// - `kill_rc != 0` (POSIX `EPERM` `-1`, Win32 `WAIT_FAILED`/unknown `-1`) or `started_at <= 0L` -> `Unknown` (NEVER dead!)
/// - `kill_rc == 0 && started_at > 0L`: PID reused (`actual > started_at + STARTED_SLACK_MS`) -> `ConfirmedDead`, else `Alive`
pub fn probe_runner_pid_status(
  rpid : Int,
  started_at : Int64,
  kill_rc : Int,
  os_start_time_ms : Option[Int64],
) -> RunnerPidStatus {
  if rpid <= 1 || station_sys::proc_kill_is_esrch(kill_rc) {
    return RunnerPidStatus::ConfirmedDead
  }
  if kill_rc != 0 || started_at <= 0L {
    return RunnerPidStatus::Unknown
  }
  match os_start_time_ms {
    Some(actual) => if actual > started_at + station_drivers::STARTED_SLACK_MS {
      RunnerPidStatus::ConfirmedDead
    } else {
      RunnerPidStatus::Alive
    }
    None => RunnerPidStatus::Alive
  }
}

pub enum RunnerFileProbe {
  Live(station_drivers::RunnerInfo)
  ConfirmedAbsent
  ConfirmedDead
  Uncertain(String, Option[station_drivers::RunnerInfo])
}

pub struct RunnerScanResult {
  pub runners : Array[station_drivers::RunnerInfo]
  pub complete : Bool
  pub error : Option[String]
}

fn is_safe_runner_id(runner_id : String) -> Bool {
  if runner_id.length() == 0 {
    return false
  }
  if runner_id.contains("/") || runner_id.contains("\\") || runner_id.contains("..") {
    return false
  }
  true
}

/// R20: Single-file runner metadata + tri-state PID probe:
/// - `read_text` failure is `ConfirmedAbsent` ONLY when `realpath_fn(fpath)` confirms true `FsErr::NotFound`;
///   existing unreadable file (`Ok(_)`) or un-traversable parent (`PermissionDenied`/etc.) returns `Uncertain(_, None)`.
/// - Corrupt JSON, missing `id`, `expected_id` mismatch, or `rpid <= 1` returns `Uncertain(_, None)`.
/// - Uses tri-state `probe_runner_pid_status` so `Unknown` (`kill_rc == -1`) returns `Uncertain(..., Some(info))`
///   instead of silently dropping a live runner as dead!
pub fn probe_runner_metadata_file_with(
  ops_fs : station_ops::OpsFs,
  fpath : String,
  expected_id : Option[String],
  realpath_fn : (String) -> Result[String, station_ops::FsErr],
  readlink_fn : (String) -> Option[String],
  kill_probe_fn : (Int) -> Int,
  start_time_fn : (Int) -> Option[Int64],
) -> RunnerFileProbe {
  let raw = match ops_fs.read_text(fpath) {
    Ok(s) => s
    Err(e) => match realpath_fn(fpath) {
      Err(station_ops::FsErr::NotFound) => return RunnerFileProbe::ConfirmedAbsent
      Ok(_) => return RunnerFileProbe::Uncertain("read " + fpath + " failed while file exists: " + station_ops::fs_err_msg(e), None)
      Err(re) => return RunnerFileProbe::Uncertain("read/realpath " + fpath + ": " + station_ops::fs_err_msg(re), None)
    }
  }
  let j = match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(v) => v
    base_codec::JsonParseResult::Err(e) => return RunnerFileProbe::Uncertain("parse " + fpath + ": " + e, None)
  }
  let id = match base_codec::json_get(j, "id") {
    Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else { return RunnerFileProbe::Uncertain("empty id in " + fpath, None) }
    _ => return RunnerFileProbe::Uncertain("missing id in " + fpath, None)
  }
  match expected_id {
    Some(eid) => if id != eid {
      return RunnerFileProbe::Uncertain("id mismatch in " + fpath + ": expected " + eid + ", got " + id, None)
    }
    None => ()
  }
  let rpid = match base_codec::json_get(j, "runner") {
    Some(base_codec::Json::Num(n, _)) => n.to_int()
    _ => match base_codec::json_get(j, "runnerPid") {
      Some(base_codec::Json::Num(n, _)) => n.to_int()
      _ => match base_codec::json_get(j, "runner_pid") {
        Some(base_codec::Json::Num(n, _)) => n.to_int()
        _ => 0
      }
    }
  }
  if rpid <= 1 {
    return RunnerFileProbe::Uncertain("invalid runner pid in " + fpath, None)
  }
  let pid = match base_codec::json_get(j, "pid") {
    Some(base_codec::Json::Num(n, _)) => n.to_int()
    _ => rpid
  }
  let pgid = match base_codec::json_get(j, "pgid") {
    Some(base_codec::Json::Num(n, _)) => n.to_int()
    _ => pid
  }
  let started_at = match base_codec::json_get(j, "startedAt") {
    Some(base_codec::Json::Num(n, _)) => {
      let v = n.to_int64()
      if n > 0.0 && v > 0L { v } else { return RunnerFileProbe::Uncertain("missing or invalid startedAt in " + fpath, None) }
    }
    Some(_) => return RunnerFileProbe::Uncertain("missing or invalid startedAt in " + fpath, None)
    None => match base_codec::json_get(j, "started_at") {
      Some(base_codec::Json::Num(n, _)) => {
        let v = n.to_int64()
        if n > 0.0 && v > 0L { v } else { return RunnerFileProbe::Uncertain("missing or invalid startedAt in " + fpath, None) }
      }
      _ => return RunnerFileProbe::Uncertain("missing or invalid startedAt in " + fpath, None)
    }
  }
  let program = match base_codec::json_get(j, "program") {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
  let args : Array[String] = []
  match base_codec::json_get(j, "args") {
    Some(base_codec::Json::Arr(arr)) => {
      for ai in 0..<arr.length() {
        match arr[ai] {
          base_codec::Json::Str(s) => args.push(s)
          _ => ()
        }
      }
    }
    _ => ()
  }
  let socket = match base_codec::json_get(j, "socket") {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
  let keeps = match base_codec::json_get(j, "keeps") {
    Some(base_codec::Json::Bool(b)) => b
    _ => false
  }
  let pty = match base_codec::json_get(j, "pty") {
    Some(base_codec::Json::Bool(b)) => b
    _ => false
  }
  let cwd_opt = match base_codec::json_get(j, "cwd") {
    Some(base_codec::Json::Str(s)) => if s.trim().length() > 0 { Some(s.trim()) } else { None }
    _ => if pid > 1 && pid != rpid {
      match readlink_fn("/proc/" + pid.to_string() + "/cwd") {
        Some(p) => if p.trim().length() > 0 { Some(p.trim()) } else { None }
        None => None
      }
    } else {
      None
    }
  }
  let info = station_drivers::RunnerInfo::{
    id: id,
    runner_pid: rpid,
    pid: pid,
    pgid: pgid,
    started_at: started_at,
    program: program,
    args: args,
    socket: socket,
    keeps: keeps,
    pty: pty,
    cwd: cwd_opt,
  }
  let kill_rc = kill_probe_fn(rpid)
  let os_start = if kill_rc == 0 { start_time_fn(rpid) } else { None }
  match probe_runner_pid_status(rpid, started_at, kill_rc, os_start) {
    RunnerPidStatus::ConfirmedDead => RunnerFileProbe::ConfirmedDead
    RunnerPidStatus::Alive => RunnerFileProbe::Live(info)
    RunnerPidStatus::Unknown => RunnerFileProbe::Uncertain("pid probe uncertain rc=" + kill_rc.to_string(), Some(info))
  }
}

pub fn probe_runner_file_with(
  ops_fs : station_ops::OpsFs,
  data : String,
  sep : String,
  runner_id : String,
  realpath_fn : (String) -> Result[String, station_ops::FsErr],
  readlink_fn : (String) -> Option[String],
  kill_probe_fn : (Int) -> Int,
  start_time_fn : (Int) -> Option[Int64],
) -> RunnerFileProbe {
  if !is_safe_runner_id(runner_id) {
    return RunnerFileProbe::Uncertain("invalid runner id", None)
  }
  let fpath = nodepath::join(sep, [station_drivers::runners_dir(data, sep), runner_id + ".json"])
  probe_runner_metadata_file_with(ops_fs, fpath, Some(runner_id), realpath_fn, readlink_fn, kill_probe_fn, start_time_fn)
}

pub fn probe_runner_file(
  ops_fs : station_ops::OpsFs,
  data : String,
  sep : String,
  runner_id : String,
) -> RunnerFileProbe {
  probe_runner_file_with(
    ops_fs,
    data,
    sep,
    runner_id,
    sys_realpath_checked,
    station_sys::readlink,
    fn(p : Int) -> Int { station_sys::proc_kill(p, station_sys::SIG_PROBE, false) },
    station_sys::proc_start_time_ms,
  )
}

/// R18/R19/R20: Startup directory scan reusing `probe_runner_metadata_file_with` + tri-state `kill_probe_fn`.
/// Retains both `Live(info)` and `Uncertain(msg, Some(info))` (never drops a runner on Win32/POSIX `-1`!).
pub fn discover_live_runners_scan_with(
  ops_fs : station_ops::OpsFs,
  data : String,
  sep : String,
  realpath_fn : (String) -> Result[String, station_ops::FsErr],
  readlink_fn : (String) -> Option[String],
  kill_probe_fn : (Int) -> Int,
  start_time_fn : (Int) -> Option[Int64],
) -> RunnerScanResult {
  let out : Array[station_drivers::RunnerInfo] = []
  let mut complete = true
  let mut first_err : Option[String] = None
  let mark_incomplete = fn(msg : String) -> Unit {
    complete = false
    if first_err is None {
      first_err = Some(msg)
    }
  }
  let rdir = station_drivers::runners_dir(data, sep)
  let entries = match (ops_fs.readdir)(rdir) {
    Ok(list) => list
    Err(e) => match realpath_fn(rdir) {
      Err(station_ops::FsErr::NotFound) => return RunnerScanResult::{ runners: out, complete: true, error: None }
      Ok(_) => return RunnerScanResult::{ runners: out, complete: false, error: Some("readdir " + rdir + " failed while dir exists: " + station_ops::fs_err_msg(e)) }
      Err(re) => return RunnerScanResult::{ runners: out, complete: false, error: Some("readdir/realpath " + rdir + ": " + station_ops::fs_err_msg(re)) }
    }
  }
  for i in 0..<entries.length() {
    let name = entries[i]
    if !name.ends_with(".json") {
      continue
    }
    let fpath = nodepath::join(sep, [rdir, name])
    match probe_runner_metadata_file_with(ops_fs, fpath, None, realpath_fn, readlink_fn, kill_probe_fn, start_time_fn) {
      RunnerFileProbe::Live(info) => out.push(info)
      RunnerFileProbe::Uncertain(msg, Some(info)) => {
        out.push(info)
        mark_incomplete(msg)
      }
      RunnerFileProbe::Uncertain(msg, None) => mark_incomplete(msg)
      RunnerFileProbe::ConfirmedAbsent | RunnerFileProbe::ConfirmedDead => ()
    }
  }
  RunnerScanResult::{ runners: out, complete: complete, error: first_err }
}

pub fn discover_live_runners_scan(
  ops_fs : station_ops::OpsFs,
  data : String,
  sep : String,
) -> RunnerScanResult {
  discover_live_runners_scan_with(
    ops_fs,
    data,
    sep,
    sys_realpath_checked,
    station_sys::readlink,
    fn(p : Int) -> Int { station_sys::proc_kill(p, station_sys::SIG_PROBE, false) },
    station_sys::proc_start_time_ms,
  )
}

fn discover_live_runners(ops_fs : station_ops::OpsFs, data : String, sep : String) -> Array[station_drivers::RunnerInfo] {
  discover_live_runners_scan(ops_fs, data, sep).runners
}

fn find_crlf_crlf(b : Bytes) -> Int {
  let n = b.length()
  if n < 4 {
    return -1
  }
  for i in 0..<(n - 3) {
    if (b[i].to_int() & 0xFF) == 13
    && (b[i + 1].to_int() & 0xFF) == 10
    && (b[i + 2].to_int() & 0xFF) == 13
    && (b[i + 3].to_int() & 0xFF) == 10
    {
      return i
    }
  }
  -1
}

/// Parse an upstream HTTP/1.1 response head (`status`, `headers`, `is_chunked`, `content_length`).
fn parse_upstream_http_head(raw_head : String) -> Result[(Int, Array[(String, String)], Bool, Option[Int64]), String] {
  let lines = raw_head.split("\r\n")
  if lines.length() == 0 {
    return Err("empty upstream http response")
  }
  let status_parts = lines[0].split(" ")
  if status_parts.length() < 2 {
    return Err("malformed upstream status line")
  }
  let status = match base_codec::parse_int64_str(status_parts[1]) {
    Some(n) => n.to_int()
    None => return Err("invalid upstream status code")
  }
  let raw_headers : Array[(String, String)] = []
  let mut is_chunked = false
  let mut content_len : Option[Int64] = None
  for i in 1..<lines.length() {
    let line = lines[i]
    if line.length() == 0 {
      continue
    }
    let colon = line.index_of(":")
    if colon <= 0 {
      continue
    }
    let k = mesh_wire::ascii_lower(line.slice(0, colon).trim())
    let v = line.slice(colon + 1, line.length()).trim()
    if k == "transfer-encoding" && mesh_wire::ascii_lower(v).contains("chunked") {
      is_chunked = true
    } else if k == "content-length" {
      match base_codec::parse_int64_str(v) {
        Some(n) => if n >= 0L { content_len = Some(n) }
        None => ()
      }
    }
    raw_headers.push((k, v))
  }
  let extra_hop = [
    "expect",
    "sec-websocket-key",
    "sec-websocket-version",
    "sec-websocket-extensions",
    "sec-websocket-accept",
  ]
  let filtered = mesh_wire::filter_hop_headers(raw_headers, extra_hop)
  Ok((status, filtered, is_chunked, content_len))
}

fn parse_upstream_ws_head(raw_head : String) -> Result[(Int, Array[(String, String)]), String] {
  let lines = raw_head.split("\r\n")
  if lines.length() == 0 {
    return Err("empty upstream websocket response")
  }
  let status_parts = lines[0].split(" ")
  if status_parts.length() < 2 {
    return Err("malformed upstream websocket status line")
  }
  let status = match base_codec::parse_int64_str(status_parts[1]) {
    Some(n) => n.to_int()
    None => return Err("invalid upstream websocket status code")
  }
  let raw_headers : Array[(String, String)] = []
  for i in 1..<lines.length() {
    let line = lines[i]
    if line.length() == 0 {
      continue
    }
    let colon = line.index_of(":")
    if colon <= 0 {
      continue
    }
    let k = mesh_wire::ascii_lower(line.slice(0, colon).trim())
    let v = line.slice(colon + 1, line.length()).trim()
    raw_headers.push((k, v))
  }
  Ok((status, raw_headers))
}

fn build_upstream_http_request(
  port : Int,
  method : String,
  path : String,
  headers : Array[(String, String)],
  has_body : Bool,
) -> (Bytes, Bool) {
  let sb = StringBuilder::new()
  sb.write_string(method)
  sb.write_string(" ")
  sb.write_string(path)
  sb.write_string(" HTTP/1.1\r\nHost: 127.0.0.1:")
  sb.write_string(port.to_string())
  sb.write_string("\r\nConnection: close\r\n")
  let mut has_cl = false
  for i in 0..<headers.length() {
    let (k, v) = headers[i]
    let kl = mesh_wire::ascii_lower(k)
    if kl == "host" || kl == "connection" || kl == "transfer-encoding" || kl == "keep-alive" || kl == "proxy-connection" || kl == "upgrade" || kl == "te" || kl == "trailer" {
      continue
    }
    if kl == "content-length" {
      has_cl = true
    }
    sb.write_string(k)
    sb.write_string(": ")
    sb.write_string(v)
    sb.write_string("\r\n")
  }
  let use_chunked = has_body && !has_cl
  if use_chunked {
    sb.write_string("Transfer-Encoding: chunked\r\n")
  }
  sb.write_string("\r\n")
  (sb.to_string().to_bytes(), use_chunked)
}

/// Entrypoint for `stillfail-station-pion run --whole-daemon ...` (or `STILLFAIL_PION_WHOLE_DAEMON=1`).
pub fn run_whole_daemon(argv : Array[String]) -> Int {
  let mut state_opt : Option[WholeRuntimeState] = None
  let mut shutdown_exit_code = 0

  let pump_admin_body_chunk = fn(
    ctx : DaemonCtx,
    astream : AdminStreamState,
    bs : AdminBodySendingState,
  ) -> Unit {
    while bs.offset < bs.body.length() {
      if ctx.is_peer_http_write_paused(astream.sid)
      || ctx.peer_http_write_queued_bytes(astream.sid) > PEER_HTTP_WRITE_LOW_WATER
      {
        return
      }
      let rem = bs.body.length() - bs.offset
      let take = if rem > WHOLE_DRIVE_READ_CHUNK { WHOLE_DRIVE_READ_CHUNK } else { rem }
      let chunk = slice_bytes_local(bs.body, bs.offset, bs.offset + take)
      bs.offset = bs.offset + take
      ctx.write_peer_http_chunk(astream.sid, chunk)
    }
    ctx.finish_peer_http(astream.sid)
    astream.mode = AdminStreamMode::Done
  }

  let send_admin_resp_and_finish = fn(ctx : DaemonCtx, sid : Int64, resp : station_http::HttpResponse) -> Unit {
    let head_b = encode_admin_head_line(resp.status, resp.headers, Some(resp.body.length().to_int64()))
    ctx.write_peer_http_chunk(sid, head_b)
    if resp.body.length() <= WHOLE_DRIVE_READ_CHUNK {
      if resp.body.length() > 0 {
        ctx.write_peer_http_chunk(sid, resp.body)
      }
      ctx.finish_peer_http(sid)
      return
    }
    match state_opt {
      Some(st) => {
        match st.admin_streams.get(sid) {
          Some(astream) => {
            let bs = AdminBodySendingState::{ body: resp.body, offset: 0 }
            astream.mode = AdminStreamMode::SendingBody(bs)
            pump_admin_body_chunk(ctx, astream, bs)
            return
          }
          None => ()
        }
      }
      None => ()
    }
    // Fallback if stream entry is absent: still chunk by 64 KiB.
    let mut off = 0
    while off < resp.body.length() {
      let rem = resp.body.length() - off
      let take = if rem > WHOLE_DRIVE_READ_CHUNK { WHOLE_DRIVE_READ_CHUNK } else { rem }
      ctx.write_peer_http_chunk(sid, slice_bytes_local(resp.body, off, off + take))
      off = off + take
    }
    ctx.finish_peer_http(sid)
  }

  let send_proxy_refusal_and_finish = fn(ctx : DaemonCtx, sid : Int64, status : Int, text : String) -> Unit {
    let head_b = encode_proxy_head_line(status, [("content-type", "text/plain; charset=utf-8")])
    ctx.write_peer_http_chunk(sid, head_b)
    if text.length() > 0 {
      ctx.write_peer_http_chunk(sid, text.to_bytes())
    }
    ctx.finish_peer_http(sid)
  }

  let build_member_check_hooks = fn(
    ctx : DaemonCtx,
    aconn : AdminConnState,
    now_s : Double,
  ) -> station_mesh::MemberCheckHooks {
    station_mesh::MemberCheckHooks::{
      is_station_removed: fn(_ws : String) -> Bool { ctx.cloud.removed() },
      is_credential_revoked: fn(sess : station_mesh::MemberSession) -> Bool {
        let full_ms = ctx.cloud.full_memberships(now_s)
        for i in 0..<full_ms.length() {
          if full_ms[i].workspace == sess.workspace {
            let revs = full_ms[i].revocations
            for ri in 0..<revs.length() {
              let r = revs[ri]
              if aconn.iat <= r.at
              && ((r.kind == "sub" && r.id == sess.user_sub) || (r.kind == "sid" && r.id == aconn.sid_claim))
              {
                return true
              }
            }
            return false
          }
        }
        false
      },
      is_lock_confirmed: fn(sess : station_mesh::MemberSession, remote : String) -> Bool {
        match verify_member_lock(
          ctx.cloud,
          sess.workspace,
          sess.user_sub,
          remote,
          aconn.lock_base,
          aconn.lock_proof,
          None,
          now_s,
        ) {
          Ok(Some(lock_role)) => {
            let base_role = if aconn.cred_role.length() > 0 { aconn.cred_role } else { sess.role }
            aconn.effective_role = if member_role_rank(lock_role) < member_role_rank(base_role) {
              lock_role
            } else {
              base_role
            }
            match state_opt {
              Some(st) => record_seen_member(st.seen_members, sess.workspace, sess.user_sub, seen_member_session_key(aconn.sid_claim, aconn.conn_id), sess.email, aconn.effective_role, aconn.iat, aconn.sid_claim, sess.expires_unix)
              None => ()
            }
            true
          }
          Ok(None) => {
            if aconn.cred_role.length() > 0 {
              aconn.effective_role = aconn.cred_role
            }
            let r = if aconn.effective_role.length() > 0 { aconn.effective_role } else { sess.role }
            match state_opt {
              Some(st) => record_seen_member(st.seen_members, sess.workspace, sess.user_sub, seen_member_session_key(aconn.sid_claim, aconn.conn_id), sess.email, r, aconn.iat, aconn.sid_claim, sess.expires_unix)
              None => ()
            }
            true
          }
          Err(_) => false
        }
      },
    }
  }

  let apply_door_actions = fn(
    ctx : DaemonCtx,
    conn : AdminConnState,
    acts : Array[mesh_door::DoorAction],
  ) -> Unit {
    for i in 0..<acts.length() {
      match acts[i] {
        mesh_door::DoorAction::WriteControl(b) => {
          match conn.control_sid {
            Some(csid) => ctx.write_peer_http_chunk(csid, b)
            None => ()
          }
        }
        mesh_door::DoorAction::FinishControl => {
          match conn.control_sid {
            Some(csid) => ctx.finish_peer_http(csid)
            None => ()
          }
        }
        mesh_door::DoorAction::ResetControl(_) => {
          match conn.control_sid {
            Some(csid) => ctx.close_peer_http(csid)
            None => ()
          }
        }
        mesh_door::DoorAction::ResetStream(rsid, _) => ctx.close_peer_http(rsid)
        mesh_door::DoorAction::FinishStream(fsid) => ctx.finish_peer_http(fsid)
        mesh_door::DoorAction::CloseConn(code, reason) => {
          ctx.close_mesh_conn(conn.conn_id, conn.is_front, code, reason)
        }
        _ => ()
      }
    }
  }

  let member_identity_for_conn = fn(
    st : WholeRuntimeState,
    conn_id : Int64,
    remote_id : String,
  ) -> station_whole::PeerIdentity {
    match st.serve.member_of(conn_id) {
      Some(sess) => {
        let (eff_role, lock_base, lock_proof) = match st.admin_conns.get(conn_id) {
          Some(ac) => {
            let r = if ac.effective_role.length() > 0 { ac.effective_role } else { sess.role }
            (r, ac.lock_base, ac.lock_proof)
          }
          None => (sess.role, None, None)
        }
        let is_home = sess.workspace == st.core.config.home_workspace
        let viewer = station_api::Viewer::{
          email: sess.email,
          sub: sess.user_sub,
          name: sess.email,
          workspace: sess.workspace,
          home: is_home,
          role: eff_role,
          device: Some(sess.device_id),
          lock_base: lock_base,
          lock_proof: lock_proof,
        }
        station_whole::PeerIdentity::AuthenticatedMember(viewer, "ed25519:" + remote_id)
      }
      None => station_whole::PeerIdentity::Unknown
    }
  }

  let check_oldest_core_fast = fn(
    st : WholeRuntimeState,
    method : String,
    raw_path : String,
    headers : Array[http1::Header],
  ) -> Option[station_http::HttpResponse] {
    let norm_raw = station_whole::normalize_api_path(raw_path)
    let (norm_path, norm_qraw, norm_q) = station_http::parse_request_target(norm_raw)
    let probe_req = station_http::HttpRequest::{
      conn_id: 0,
      method: method,
      raw_target: norm_raw,
      path: norm_path,
      query_raw: norm_qraw,
      query: norm_q,
      version: http1::Version::Http11,
      headers: headers,
      body: Bytes::new(0),
      peer: "",
      raw_head: Bytes::new(0),
    }
    let lang = station_api::lang_of_core(probe_req)
    station_api::check_core_version(
      probe_req,
      st.core.api.admin.oldest_core,
      st.core.config.station_build,
      lang,
    )
  }

  // Pump AT MOST 1 x 64 KiB chunk per call (write-completion-driven backpressure).
  let pump_drive_download_chunk = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    astream : AdminStreamState,
    dl : DriveDownloadStreamState,
  ) -> Unit {
    if dl.remaining <= 0L {
      ctx.finish_peer_http(astream.sid)
      astream.mode = AdminStreamMode::Done
      return
    }
    if ctx.peer_http_write_queued_bytes(astream.sid) > PEER_HTTP_WRITE_LOW_WATER {
      return
    }
    let take = if dl.remaining > WHOLE_DRIVE_READ_CHUNK.to_int64() {
      WHOLE_DRIVE_READ_CHUNK
    } else {
      dl.remaining.to_int()
    }
    let ws_drive = st.core.api.drive_for_workspace(dl.workspace)
    match ws_drive.read(dl.root, dl.rel, dl.cur_offset, take, false) {
      Ok((cb, _, _, _)) => {
        if cb.length() == 0 {
          ctx.finish_peer_http(astream.sid)
          astream.mode = AdminStreamMode::Done
          return
        }
        dl.cur_offset = dl.cur_offset + cb.length().to_int64()
        dl.remaining = dl.remaining - cb.length().to_int64()
        ctx.write_peer_http_chunk(astream.sid, cb)
        if dl.remaining <= 0L {
          ctx.finish_peer_http(astream.sid)
          astream.mode = AdminStreamMode::Done
        }
      }
      Err(_) => {
        ctx.close_peer_http(astream.sid)
        astream.mode = AdminStreamMode::Done
      }
    }
  }

  // Pump AT MOST 1 x 64 KiB chunk per call for `GET /sessions/:key/(files|parts|open?raw=1)`
  // (200 OK full Content-Length streaming with constant ~64 KiB memory, zero OOM, never 206).
  let pump_session_file_download_chunk = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    astream : AdminStreamState,
    dl : SessionFileDownloadState,
  ) -> Unit {
    if dl.remaining <= 0L {
      if dl.unlink_on_done {
        let _ = (st.core.agents.jobs.fs.remove_file)(dl.path)
      }
      ctx.finish_peer_http(astream.sid)
      astream.mode = AdminStreamMode::Done
      return
    }
    if ctx.peer_http_write_queued_bytes(astream.sid) > PEER_HTTP_WRITE_LOW_WATER {
      return
    }
    let take = if dl.remaining > WHOLE_DRIVE_READ_CHUNK.to_int64() {
      WHOLE_DRIVE_READ_CHUNK
    } else {
      dl.remaining.to_int()
    }
    match (st.core.agents.jobs.fs.read_range)(dl.path, dl.cur_offset, take.to_int64()) {
      Some(cb) => {
        if cb.length() == 0 {
          if dl.unlink_on_done {
            let _ = (st.core.agents.jobs.fs.remove_file)(dl.path)
          }
          ctx.finish_peer_http(astream.sid)
          astream.mode = AdminStreamMode::Done
          return
        }
        dl.cur_offset = dl.cur_offset + cb.length().to_int64()
        dl.remaining = dl.remaining - cb.length().to_int64()
        ctx.write_peer_http_chunk(astream.sid, cb)
        if dl.remaining <= 0L {
          if dl.unlink_on_done {
            let _ = (st.core.agents.jobs.fs.remove_file)(dl.path)
          }
          ctx.finish_peer_http(astream.sid)
          astream.mode = AdminStreamMode::Done
        }
      }
      None => {
        if dl.unlink_on_done {
          let _ = (st.core.agents.jobs.fs.remove_file)(dl.path)
        }
        ctx.close_peer_http(astream.sid)
        astream.mode = AdminStreamMode::Done
      }
    }
  }

  let start_session_file_stream = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    astream : AdminStreamState,
    spec : station_whole::SessionFileStreamSpec,
  ) -> Unit {
    let ct = if spec.content_type.length() > 0 { spec.content_type } else { "application/octet-stream" }
    let hdrs : Array[http1::Header] = [
      http1::Header::new("content-type", ct),
      http1::Header::new("cache-control", "private, max-age=3600"),
      http1::Header::new("content-length", spec.send_length.to_string()),
      http1::Header::new(station_api::BUILD_HEADER, st.core.config.station_build),
    ]
    for i in 0..<spec.extra_headers.length() {
      hdrs.push(spec.extra_headers[i])
    }
    ctx.write_peer_http_chunk(astream.sid, encode_admin_head_line(200, hdrs, Some(spec.send_length)))
    if spec.send_length <= 0L {
      if spec.unlink_on_done {
        let _ = (st.core.agents.jobs.fs.remove_file)(spec.path)
      }
      ctx.finish_peer_http(astream.sid)
      astream.mode = AdminStreamMode::Done
      return
    }
    let dl = SessionFileDownloadState::{
      path: spec.path,
      cur_offset: spec.start_offset,
      remaining: spec.send_length,
      unlink_on_done: spec.unlink_on_done,
    }
    astream.mode = AdminStreamMode::SessionFileDownloading(dl)
    pump_session_file_download_chunk(ctx, st, astream, dl)
  }

  let dispatch_admin_request = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    astream : AdminStreamState,
    head : AdminReqHead,
    body : Bytes,
  ) -> Unit {
    let now_w = host_shim::wall_ms()
    let peer_id = member_identity_for_conn(st, astream.conn_id, astream.remote_id)
    let norm_raw = station_whole::normalize_api_path(head.path)
    let (norm_path, _, norm_query) = station_http::parse_request_target(norm_raw)

    // Backpressured streaming `GET /drive/read` (gated by `OLDEST_CORE`).
    if head.method == "GET" && norm_path == "/drive/read" {
      match check_oldest_core_fast(st, head.method, head.path, head.headers) {
        Some(old_resp) => {
          send_admin_resp_and_finish(ctx, astream.sid, old_resp)
          astream.mode = AdminStreamMode::Done
          return
        }
        None => ()
      }
      match peer_id {
        station_whole::PeerIdentity::AuthenticatedMember(v, _) => {
          let req_len = match norm_query.get("length") {
            Some(s) => match base_codec::parse_int64_str(s) {
              Some(n) => n
              None => 65536L
            }
            None => match norm_query.get("len") {
              Some(s) => match base_codec::parse_int64_str(s) {
                Some(n) => n
                None => 65536L
              }
              None => 65536L
            }
          }
          if req_len > WHOLE_DRIVE_READ_CHUNK.to_int64() {
            let root = match resolve_drive_root_for_ws(st.core, v.workspace, norm_query.get("root")) {
              Ok(r) => r
              Err(msg) => {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(403, msg))
                astream.mode = AdminStreamMode::Done
                return
              }
            }
            let rel = match norm_query.get("path") {
              Some(p) => if p.length() > 0 { p } else {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "path is required"))
                astream.mode = AdminStreamMode::Done
                return
              }
              None => {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "path is required"))
                astream.mode = AdminStreamMode::Done
                return
              }
            }
            let start_off = match norm_query.get("offset") {
              Some(s) => match base_codec::parse_int64_str(s) {
                Some(n) => n
                None => 0L
              }
              None => 0L
            }
            let ws_drive = st.core.api.drive_for_workspace(v.workspace)
            match ws_drive.read(root, rel, start_off, WHOLE_DRIVE_READ_CHUNK, false) {
              Err(de) => {
                send_admin_resp_and_finish(ctx, astream.sid, drive_err_http_resp(de))
                astream.mode = AdminStreamMode::Done
                return
              }
              Ok((first_bytes, total_sz, mtime, mime)) => {
                let avail_total = if total_sz - start_off < req_len {
                  if total_sz > start_off { total_sz - start_off } else { 0L }
                } else {
                  req_len
                }
                let ct = if mime.length() > 0 { mime } else { "application/octet-stream" }
                let hdrs : Array[http1::Header] = [
                  http1::Header::new("content-type", ct),
                  http1::Header::new("content-length", avail_total.to_string()),
                  http1::Header::new("stillfail-total", total_sz.to_string()),
                  http1::Header::new("stillfail-mtime", mtime.to_string()),
                  http1::Header::new(station_api::BUILD_HEADER, st.core.config.station_build),
                ]
                ctx.write_peer_http_chunk(astream.sid, encode_admin_head_line(200, hdrs, Some(avail_total)))
                let first_len = if first_bytes.length().to_int64() > avail_total {
                  avail_total.to_int()
                } else {
                  first_bytes.length()
                }
                if first_len > 0 {
                  let piece = if first_len == first_bytes.length() {
                    first_bytes
                  } else {
                    slice_bytes_local(first_bytes, 0, first_len)
                  }
                  ctx.write_peer_http_chunk(astream.sid, piece)
                }
                let rem = avail_total - first_len.to_int64()
                if rem <= 0L {
                  ctx.finish_peer_http(astream.sid)
                  astream.mode = AdminStreamMode::Done
                } else {
                  astream.mode = AdminStreamMode::DriveDownloading(DriveDownloadStreamState::{
                    workspace: v.workspace,
                    root: root,
                    rel: rel,
                    cur_offset: start_off + first_len.to_int64(),
                    remaining: rem,
                  })
                }
                return
              }
            }
          }
        }
        _ => {
          send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(403, "unauthenticated peer rejected"))
          astream.mode = AdminStreamMode::Done
          return
        }
      }
    }

    // Backpressured 64 KiB `200 OK` streaming for > 8 MiB `GET /sessions/:key/(files|open?raw=1)`
    // and async `EdgeMuxHub` `tar.file` extraction for archived `workspace.tar.zst` uploads.
    if head.method == "GET" && norm_path.starts_with("/sessions/") {
      match st.core.api.session_plan_fn {
        Some(plan_fn) => {
          match check_oldest_core_fast(st, head.method, head.path, head.headers) {
            Some(old_resp) => {
              send_admin_resp_and_finish(ctx, astream.sid, old_resp)
              astream.mode = AdminStreamMode::Done
              return
            }
            None => ()
          }
          match peer_id {
            station_whole::PeerIdentity::AuthenticatedMember(v, _) => {
              let (s_path, s_qraw, s_q) = station_http::parse_request_target(norm_raw)
              let probe_req = station_http::HttpRequest::{
                conn_id: 0,
                method: head.method,
                raw_target: norm_raw,
                path: s_path,
                query_raw: s_qraw,
                query: s_q,
                version: http1::Version::Http11,
                headers: head.headers,
                body: Bytes::new(0),
                peer: "",
                raw_head: Bytes::new(0),
              }
              match plan_fn(probe_req, v, astream.sid) {
                station_whole::SessionFilePlan::NotMatched => ()
                station_whole::SessionFilePlan::ImmediateError(resp) => {
                  send_admin_resp_and_finish(ctx, astream.sid, resp)
                  astream.mode = AdminStreamMode::Done
                  return
                }
                station_whole::SessionFilePlan::StreamFile(spec) => {
                  start_session_file_stream(ctx, st, astream, spec)
                  return
                }
                station_whole::SessionFilePlan::ExtractArchive(spec) => {
                  astream.mode = AdminStreamMode::WaitingArchiveExtract(spec)
                  let wanted_j : Array[base_codec::Json] = []
                  for wi in 0..<spec.wanted.length() {
                    wanted_j.push(base_codec::json_str(spec.wanted[wi]))
                  }
                  let tar_args = base_codec::json_obj([
                    ("path", base_codec::json_str(spec.archive_path)),
                    ("wanted", base_codec::json_arr(wanted_j)),
                    ("out", base_codec::json_str(spec.out_path)),
                  ])
                  let _ = ctx.mux_role.call_async_raw(
                    builders_core::MuxToken::Tagged(0, SESSION_TOK_TAR_FILE, astream.sid),
                    "tar.file",
                    base_codec::json_stringify(tar_args),
                    None,
                  )
                  return
                }
              }
            }
            _ => ()
          }
        }
        None => ()
      }
    }

    // P1-4: Direct authenticated `POST /sessions/<key>/stop` interception (avoids whole_api.pion 501).
    match extract_session_stop_key(head.method, norm_path) {
      Some(stop_skey) => {
        match check_oldest_core_fast(st, head.method, head.path, head.headers) {
          Some(old_resp) => {
            send_admin_resp_and_finish(ctx, astream.sid, old_resp)
            astream.mode = AdminStreamMode::Done
            return
          }
          None => ()
        }
        match peer_id {
          station_whole::PeerIdentity::AuthenticatedMember(v, _) => {
            let can_write = v.role == "owner" || v.role == "admin" || v.role == "member"
            if !can_write {
              send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(403, "read-only member cannot stop session"))
              astream.mode = AdminStreamMode::Done
              return
            }
            let st_db = match st.core.store.require_open() {
              Ok(s) => s
              Err(_) => {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(503, "store not ready"))
                astream.mode = AdminStreamMode::Done
                return
              }
            }
            match st_db.get_session(stop_skey) {
              Ok(Some(srow)) => {
                if !session_belongs_to_ws(srow.ws, v.workspace, st.core.config.home_workspace) {
                  send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(404, "no such session"))
                  astream.mode = AdminStreamMode::Done
                  return
                }
                let stopped = st.live_runners.stop_session(ctx, stop_skey, host_shim::now_ms())
                let body_s = base_codec::json_stringify(
                  base_codec::json_obj([("ok", base_codec::json_bool(true)), ("stopped", base_codec::json_bool(stopped))]),
                )
                send_admin_resp_and_finish(ctx, astream.sid, station_http::HttpResponse::json(200, body_s))
                astream.mode = AdminStreamMode::Done
                return
              }
              _ => {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(404, "no such session"))
                astream.mode = AdminStreamMode::Done
                return
              }
            }
          }
          _ => {
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(403, "unauthenticated peer rejected"))
            astream.mode = AdminStreamMode::Done
            return
          }
        }
      }
      None => ()
    }

    // Wave 17D-2 R6: Non-blocking async interception for network-bound live ops
    // (`updates.check`, `copies.s3.test`, `accounts.profiles.createKeyed`).
    // Enforces unified `OLDEST_CORE`, `read_only_handover` write barrier, manager role, and `AdminApi` idempotency BEFORE async I/O.
    match peer_id {
      station_whole::PeerIdentity::AuthenticatedMember(v, _) => {
        let mut req_lang = station_api::Lang::En
        for hi in 0..<head.headers.length() {
          if station_http::ascii_eq_ci(head.headers[hi].name, "accept-language") {
            let lv = head.headers[hi].value.trim()
            if lv.starts_with("zh") || lv.starts_with("ZH") || lv.starts_with("Zh") {
              req_lang = station_api::Lang::Zh
            }
          }
        }
        let is_live_async_route = head.method == "POST"
        && (norm_path == "/updates/check"
          || norm_path == "/copies/s3/test"
          || norm_path == "/profiles")
        if is_live_async_route {
          match check_oldest_core_fast(st, head.method, head.path, head.headers) {
            Some(old_resp) => {
              send_admin_resp_and_finish(ctx, astream.sid, old_resp)
              astream.mode = AdminStreamMode::Done
              return
            }
            None => ()
          }
          if st.core.api.read_only_handover {
            astream.mode = AdminStreamMode::Done
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(403, "station is in read-only handover mode"))
            return
          }
          // Authorization MUST run BEFORE idempotency claim/replay so a downgraded member
          // can never replay a cached 200 admin response with a prior Idempotency-Key!
          if !v.manages_station() {
            astream.mode = AdminStreamMode::Done
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(403, "only workspace owners and admins can perform this action"))
            return
          }
          let idem_claim : Option[(String, String)] = match st.core.api.admin.claim_async_idempotency(
            v,
            head.method,
            norm_path,
            head.headers,
            now_w,
          ) {
            station_api::AsyncIdemClaim::NotKeyed => None
            station_api::AsyncIdemClaim::Claimed(sk, ik) => Some((sk, ik))
            station_api::AsyncIdemClaim::Replay(cached_resp) => {
              // Set Done BEFORE send_admin_resp_and_finish so >64 KiB backpressured SendingBody is preserved!
              astream.mode = AdminStreamMode::Done
              send_admin_resp_and_finish(ctx, astream.sid, cached_resp)
              return
            }
            station_api::AsyncIdemClaim::Conflict(conf_resp) => {
              astream.mode = AdminStreamMode::Done
              send_admin_resp_and_finish(ctx, astream.sid, conf_resp)
              return
            }
          }
          match try_intercept_async_admin_op(ctx, st, astream.sid, astream.conn_id, head.method, norm_path, body, v, req_lang, idem_claim) {
            Some(Ok(async_st)) => {
              astream.mode = AdminStreamMode::WaitingAsyncOp(async_st)
              return
            }
            Some(Err(resp)) => {
              match idem_claim {
                Some((sk, ik)) => st.core.api.admin.complete_async_idempotency(sk, ik, v, head.method, norm_path, resp, now_w)
                None => ()
              }
              astream.mode = AdminStreamMode::Done
              send_admin_resp_and_finish(ctx, astream.sid, resp)
              return
            }
            None => {
              match idem_claim {
                Some((sk, _)) => st.core.api.admin.abort_async_idempotency(sk)
                None => ()
              }
            }
          }
        }
      }
      _ => ()
    }

    // Wave 17D-3: Non-blocking async `GET /link-preview?url=` (all-IP DNS + `entry` pinning + multi-hop redirect check + hard monotonic deadline, zero `host_shim::wait`).
    if head.method == "GET" && norm_path == "/link-preview" {
      match check_oldest_core_fast(st, head.method, head.path, head.headers) {
        Some(old_resp) => {
          send_admin_resp_and_finish(ctx, astream.sid, old_resp)
          astream.mode = AdminStreamMode::Done
          return
        }
        None => ()
      }
      match peer_id {
        station_whole::PeerIdentity::AuthenticatedMember(_, _) => {
          let (_, _, lp_q) = station_http::parse_request_target(norm_raw)
          let raw_url = match lp_q.get("url") {
            Some(u) => u.trim()
            None => ""
          }
          let low_u = wd_ascii_lower(raw_url)
          if (!low_u.starts_with("http://") && !low_u.starts_with("https://")) || raw_url.to_bytes().length() > station_whole::LINK_PREVIEW_MAX_URL_LEN {
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "an http(s) url is required"))
            astream.mode = AdminStreamMode::Done
            return
          }
          // Bound concurrent link-preview DNS/HTTP tasks to protect daemon resources.
          let mut active_lp = 0
          let asids = st.admin_streams.keys()
          for ai in 0..<asids.length() {
            match st.admin_streams.get(asids[ai]) {
              Some(s) => match s.mode {
                AdminStreamMode::WaitingLinkPreview(_) => active_lp = active_lp + 1
                _ => ()
              }
              None => ()
            }
          }
          if active_lp >= 16 {
            send_admin_resp_and_finish(ctx, astream.sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
            astream.mode = AdminStreamMode::Done
            return
          }
          // Fail-closed if an outbound HTTP/HTTPS/ALL proxy is configured in the environment:
          // `client/shell` reqwest client inherits env proxies which would bypass `EntryResolver` IP pinning!
          if station_whole::link_preview_proxy_blocked(fn(k : String) -> Option[String] { station_sys::env_get(k) }) {
            send_admin_resp_and_finish(
              ctx,
              astream.sid,
              station_api::json_error(503, "link preview is disabled when an outbound HTTP/HTTPS/ALL proxy is configured"),
            )
            astream.mode = AdminStreamMode::Done
            return
          }
          match station_whole::validate_link_preview_url(raw_url) {
            Err(_) => {
              send_admin_resp_and_finish(ctx, astream.sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
              astream.mode = AdminStreamMode::Done
              return
            }
            Ok(parsed) => {
              let port = match parsed.port {
                Some(p) => p
                None => if parsed.scheme == "https" { 443 } else { 80 }
              }
              let ev_id = st.next_dns_ev_id
              st.next_dns_ev_id = ev_id + 1L
              let lp_state = LinkPreviewAsyncState::{
                hop: 0,
                url: raw_url,
                target_port: port,
                dns_ev_id: ev_id,
                call_id: 0L,
                stream_id: 0,
                content_type: "",
                body_buf: Bytes::new(0),
                head_tail: "",
                // timer: single monotonic deadline across DNS + redirects + body read (6s)
                deadline_ms: host_shim::now_ms() + station_whole::LINK_PREVIEW_TIMEOUT_MS,
              }
              astream.mode = AdminStreamMode::WaitingLinkPreview(lp_state)
              st.dns_streams.set(ev_id, astream.sid)
              if !station_sys::resolve_host_all_async(ev_id, parsed.host) {
                st.dns_streams.remove(ev_id)
                send_admin_resp_and_finish(ctx, astream.sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                astream.mode = AdminStreamMode::Done
              }
              return
            }
          }
        }
        _ => {
          send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(403, "unauthenticated peer rejected"))
          astream.mode = AdminStreamMode::Done
          return
        }
      }
    }

    // Wave 17D-3: Non-blocking async `POST /threads/:id/report` (workspace gate BEFORE any DB/log read, `"fetch"` op + `[[k,v]]` headers, zero `host_shim::wait`).
    if head.method == "POST" && norm_path.starts_with("/threads/") && norm_path.ends_with("/report") {
      let trimmed_r = norm_path.slice(9, norm_path.length() - 7)
      if trimmed_r.length() > 0 && !trimmed_r.contains("/") {
        match check_oldest_core_fast(st, head.method, head.path, head.headers) {
          Some(old_resp) => {
            send_admin_resp_and_finish(ctx, astream.sid, old_resp)
            astream.mode = AdminStreamMode::Done
            return
          }
          None => ()
        }
        match peer_id {
          station_whole::PeerIdentity::AuthenticatedMember(v, _) => {
            // Single bounded uint parse (prevents 64-bit wraparound like "18446744073709551617" -> 1 bypassing `elsewhere`),
            // followed immediately by fail-closed `thread_seen` workspace visibility check BEFORE touching DB.
            let tid = match station_api::parse_uint_str(trimmed_r) {
              Some(n) if n >= 1 => n
              _ => {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "invalid thread id"))
                astream.mode = AdminStreamMode::Done
                return
              }
            }
            if !station_api::thread_seen(st.core.api.admin.seen_store, v, tid) {
              send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(404, "unknown thread " + trimmed_r))
              astream.mode = AdminStreamMode::Done
              return
            }
            let body_j = match base_codec::json_parse(body.to_string()) {
              base_codec::JsonParseResult::Ok(j) => j
              _ => {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "invalid JSON"))
                astream.mode = AdminStreamMode::Done
                return
              }
            }
            let entry_n = match base_codec::json_get(body_j, "n") {
              Some(base_codec::Json::Num(d, _)) if d >= 1.0 && d <= 2147483647.0 && d.to_int().to_double() == d => d.to_int()
              _ => {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "n must be a positive integer"))
                astream.mode = AdminStreamMode::Done
                return
              }
            }
            // Enforce provider feedback spec + real installed CHANNEL gate BEFORE any DB read
            // (1:1 with `station/src/updates/versions.ts:48-64`: config `updateChannel` ?? `<app>/CHANNEL` ?? `"stable"`).
            let provider_fb = match ctx.cloud.provider() {
              station_cloud::Provider::Stillfail => station_cloud::stillfail_spec().feedback
              station_cloud::Provider::Comma => station_cloud::comma_spec().feedback
            }
            let installed_ch : Option[String] = match ctx.args.app {
              Some(app_dir) if app_dir.length() > 0 => station_ops::station_channel(ctx.ops_fs, app_dir, ctx.sep)
              _ => None
            }
            let upd_ch = station_whole::resolve_feedback_channel(live_config_raw(st.core, ctx.cfg_raw), installed_ch)
            if !provider_fb || upd_ch != "stable" {
              send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(404, "feedback reporting is only enabled on stable still.fail stations"))
              astream.mode = AdminStreamMode::Done
              return
            }
            // Submit strictly whitelisted scrubbed structured diagnostic metadata (no synchronous main-loop `stillfail.log` read or unverified free-text logs).
            match station_whole::prepare_feedback_notice_report(
              st.core.store,
              tid,
              entry_n,
              v,
              station_sys::os_name(),
              station_sys::arch_name(),
              station_sys::homedir(),
              None,
            ) {
              Err(e) => {
                send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(e.status, e.message))
                astream.mode = AdminStreamMode::Done
                return
              }
              Ok((report_j, _)) => {
                if ctx.cloud.removed() {
                  send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(502, "this station was removed from its workspace"))
                  astream.mode = AdminStreamMode::Done
                  return
                }
                let (origin, st_id) = match ctx.cloud.state {
                  Some(cs) if cs.origin.length() > 0 && cs.station.length() > 0 => (cs.origin, cs.station)
                  _ => {
                    send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(502, "station is not enrolled with cloud"))
                    astream.mode = AdminStreamMode::Done
                    return
                  }
                }
                let payload_str = base_codec::json_stringify(report_j)
                // Cloud `cloud/src/tracing.ts:190-196` verifies Unix SECONDS (matching Node `nowSecs()`).
                let hdrs = match station_cloud::signed_post_headers(
                  origin,
                  st_id,
                  "stillfail-station-feedback-v1",
                  payload_str,
                  host_shim::wall_ms() / 1000L,
                  ctx.station_key,
                ) {
                  Ok(h) => h
                  Err(e) => {
                    send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(502, "feedback signing failed: " + e))
                    astream.mode = AdminStreamMode::Done
                    return
                  }
                }
                let fetch_args = base_codec::json_obj([
                  ("url", base_codec::json_str(origin + "/v1/feedback")),
                  ("method", base_codec::json_str("POST")),
                  ("headers", wd_encode_header_pairs(hdrs)),
                  ("timeoutMs", base_codec::json_int(15000)),
                ])
                let fb_cid = ctx.mux_role.call_async_raw(
                  builders_core::MuxToken::Tagged(0, FEEDBACK_TOK_POST, astream.sid),
                  "fetch",
                  base_codec::json_stringify(fetch_args),
                  Some(payload_str.to_bytes()),
                )
                astream.mode = AdminStreamMode::WaitingFeedbackReport(fb_cid)
                return
              }
            }
          }
          _ => {
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(403, "unauthenticated peer rejected"))
            astream.mode = AdminStreamMode::Done
            return
          }
        }
      }
    }

    let action = st.core.handle_peer_http(peer_id, head.method, head.path, head.headers, body, now_w)
    match action {
      station_http::HandlerAction::Respond(resp) => {
        if resp.status >= 200 && resp.status < 300 {
          match extract_session_stop_key(head.method, head.path) {
            Some(stop_skey) => {
              let _ = st.live_runners.stop_session(ctx, stop_skey, host_shim::now_ms())
            }
            None => ()
          }
        }
        astream.mode = AdminStreamMode::Done
        send_admin_resp_and_finish(ctx, astream.sid, resp)
      }
      station_http::HandlerAction::UpgradeSse(extra_headers) => {
        match st.core.api.events.take_last_opened() {
          Some(opened) => {
            let hdrs : Array[http1::Header] = []
            for hi in 0..<opened.headers.length() {
              hdrs.push(opened.headers[hi])
            }
            let mut has_build = false
            for hi in 0..<extra_headers.length() {
              if station_http::ascii_eq_ci(extra_headers[hi].name, station_api::BUILD_HEADER) {
                has_build = true
              }
            }
            if !has_build {
              hdrs.push(http1::Header::new(station_api::BUILD_HEADER, st.core.config.station_build))
            }
            ctx.write_peer_http_chunk(astream.sid, encode_admin_head_line(200, hdrs, None))
            for fi in 0..<opened.initial_frames.length() {
              ctx.write_peer_http_chunk(astream.sid, opened.initial_frames[fi].to_bytes())
            }
            astream.last_sse_ping_ms = host_shim::now_ms()
            astream.mode = AdminStreamMode::SseStreaming(opened.client_id)
          }
          None => {
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(500, "events subscription missing"))
            astream.mode = AdminStreamMode::Done
          }
        }
      }
      _ => {
        send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(501, "unsupported handler action"))
        astream.mode = AdminStreamMode::Done
      }
    }
  }

  let begin_admin_drive_upload = fn(
    st : WholeRuntimeState,
    astream : AdminStreamState,
    head : AdminReqHead,
  ) -> Result[DriveUploadStreamState, station_http::HttpResponse] {
    match check_oldest_core_fast(st, head.method, head.path, head.headers) {
      Some(old_resp) => return Err(old_resp)
      None => ()
    }
    let peer_id = member_identity_for_conn(st, astream.conn_id, astream.remote_id)
    let viewer = match peer_id {
      station_whole::PeerIdentity::AuthenticatedMember(v, _) => v
      _ => return Err(station_api::json_error(403, "unauthenticated peer rejected"))
    }
    if viewer.is_read_only() {
      return Err(station_api::json_error(403, "read-only members cannot change this station"))
    }
    if st.core.api.read_only_handover {
      return Err(station_api::json_error(403, "station is in read-only handover mode"))
    }
    let norm_raw = station_whole::normalize_api_path(head.path)
    let (_, _, q) = station_http::parse_request_target(norm_raw)
    let root = match resolve_drive_root_for_ws(st.core, viewer.workspace, q.get("root")) {
      Ok(r) => r
      Err(msg) => return Err(station_api::json_error(403, msg))
    }
    let rel = match q.get("path") {
      Some(p) => if p.length() > 0 { p } else { return Err(station_api::json_error(400, "path is required")) }
      None => return Err(station_api::json_error(400, "path is required"))
    }
    let up_id = match q.get("id") {
      Some(u) => if u.length() > 0 { u } else { return Err(station_api::json_error(400, "id is required")) }
      None => return Err(station_api::json_error(400, "id is required"))
    }
    let offset = match q.get("offset") {
      Some(s) => match base_codec::parse_int64_str(s) {
        Some(n) => if n >= 0L { n } else { return Err(station_api::json_error(400, "invalid offset")) }
        None => return Err(station_api::json_error(400, "invalid offset"))
      }
      None => 0L
    }
    let total = match q.get("total") {
      Some(s) => match base_codec::parse_int64_str(s) {
        Some(n) => if n >= 0L { n } else { return Err(station_api::json_error(400, "invalid total")) }
        None => return Err(station_api::json_error(400, "invalid total"))
      }
      None => return Err(station_api::json_error(400, "total is required"))
    }
    match head.expected_cl {
      Some(exp) => {
        if offset + exp > total {
          return Err(station_api::json_error(400, "content-length exceeds upload total"))
        }
      }
      None => ()
    }
    let replace = match q.get("replace") {
      Some(v) => v == "1"
      None => false
    }
    Ok(DriveUploadStreamState::{
      workspace: viewer.workspace,
      root: root,
      rel: rel,
      upload_id: up_id,
      total: total,
      replace: replace,
      expected_cl: head.expected_cl,
      received_bytes: 0L,
      cur_offset: offset,
      pending_commit_chunk: None,
      last_entry: None,
      failed: None,
    })
  }

  // Feed a streaming Drive upload chunk while NEVER triggering atomic rename commit until
  // `on_peer_http_end` confirms no trailing overflow bytes and exact `Content-Length` parity
  // (applies uniformly to BOTH fixed Content-Length and chunked/streamed uploads!).
  let feed_drive_upload_chunk = fn(
    st : WholeRuntimeState,
    up : DriveUploadStreamState,
    chunk : Bytes,
  ) -> Unit {
    if up.failed is Some(_) || chunk.length() == 0 {
      return
    }
    let next_received = up.received_bytes + chunk.length().to_int64()
    match up.expected_cl {
      Some(exp) => {
        if next_received > exp {
          up.received_bytes = next_received
          up.pending_commit_chunk = None
          up.failed = Some(station_screens::DriveError::new(
            station_screens::DriveCode::InvalidRequest,
            "request body exceeds content-length",
          ))
          return
        }
      }
      None => ()
    }
    let pending_len = match up.pending_commit_chunk {
      Some(p) => p.length().to_int64()
      None => 0L
    }
    if up.cur_offset + pending_len + chunk.length().to_int64() > up.total {
      up.received_bytes = next_received
      up.pending_commit_chunk = None
      up.failed = Some(station_screens::DriveError::new(
        station_screens::DriveCode::InvalidRequest,
        "upload body exceeds declared total",
      ))
      return
    }
    up.received_bytes = next_received
    let ws_drive = st.core.api.drive_for_workspace(up.workspace)

    // Whenever this chunk reaches `up.total` (for BOTH fixed Content-Length and streamed uploads),
    // hold ONLY the final committing byte(s) in `pending_commit_chunk` until stream EOF confirms
    // zero overflow bytes and exact `Content-Length`!
    let reaches_total = up.cur_offset + pending_len + chunk.length().to_int64() == up.total
    if reaches_total {
      let combined = match up.pending_commit_chunk {
        Some(p) => concat_bytes_local(p, chunk)
        None => chunk
      }
      if combined.length() > 1 {
        let prefix = slice_bytes_local(combined, 0, combined.length() - 1)
        let last_b = slice_bytes_local(combined, combined.length() - 1, combined.length())
        match ws_drive.upload(
          up.root,
          up.rel,
          up.upload_id,
          up.cur_offset,
          up.total,
          prefix,
          up.replace,
          false,
          host_shim::wall_ms(),
        ) {
          Ok(res) => {
            up.cur_offset = res.have
            up.last_entry = res.entry
            up.pending_commit_chunk = Some(last_b)
          }
          Err(de) => {
            up.pending_commit_chunk = None
            up.failed = Some(de)
          }
        }
      } else {
        up.pending_commit_chunk = Some(combined)
      }
      return
    }

    match ws_drive.upload(
      up.root,
      up.rel,
      up.upload_id,
      up.cur_offset,
      up.total,
      chunk,
      up.replace,
      false,
      host_shim::wall_ms(),
    ) {
      Ok(res) => {
        up.cur_offset = res.have
        up.last_entry = res.entry
      }
      Err(de) => up.failed = Some(de)
    }
  }

  let finish_admin_drive_upload = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    astream : AdminStreamState,
    up : DriveUploadStreamState,
  ) -> Unit {
    match up.failed {
      Some(de) => {
        up.pending_commit_chunk = None
        send_admin_resp_and_finish(ctx, astream.sid, drive_err_http_resp(de))
        astream.mode = AdminStreamMode::Done
        return
      }
      None => ()
    }
    match up.expected_cl {
      Some(exp) => {
        if up.received_bytes != exp {
          up.pending_commit_chunk = None
          send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "content-length mismatch"))
          astream.mode = AdminStreamMode::Done
          return
        }
      }
      None => ()
    }
    let ws_drive = st.core.api.drive_for_workspace(up.workspace)
    // Now that EOF confirmed zero overflow & exact `Content-Length`, flush any held final committing chunk!
    match up.pending_commit_chunk {
      Some(last_chunk) => {
        up.pending_commit_chunk = None
        match ws_drive.upload(
          up.root,
          up.rel,
          up.upload_id,
          up.cur_offset,
          up.total,
          last_chunk,
          up.replace,
          false,
          host_shim::wall_ms(),
        ) {
          Ok(res) => {
            up.cur_offset = res.have
            up.last_entry = res.entry
          }
          Err(de) => up.failed = Some(de)
        }
      }
      None => ()
    }
    if up.received_bytes == 0L && up.total == 0L && up.failed is None {
      match ws_drive.upload(
        up.root,
        up.rel,
        up.upload_id,
        up.cur_offset,
        up.total,
        Bytes::new(0),
        up.replace,
        false,
        host_shim::wall_ms(),
      ) {
        Ok(res) => {
          up.cur_offset = res.have
          up.last_entry = res.entry
        }
        Err(de) => up.failed = Some(de)
      }
    }
    match up.failed {
      Some(de) => send_admin_resp_and_finish(ctx, astream.sid, drive_err_http_resp(de))
      None => {
        let entry_j = match up.last_entry {
          Some(e) => drive_entry_json_local(e)
          None => base_codec::json_null()
        }
        let resp = station_api::json_ok(
          base_codec::json_obj([
            ("have", base_codec::json_int64(up.cur_offset)),
            ("entry", entry_j),
          ]),
        )
        .with_header(station_api::BUILD_HEADER, st.core.config.station_build)
        send_admin_resp_and_finish(ctx, astream.sid, resp)
      }
    }
    astream.mode = AdminStreamMode::Done
  }

  let process_admin_stream_rx = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    astream : AdminStreamState,
  ) -> Result[Unit, String] {
    match astream.mode {
      AdminStreamMode::Done
      | AdminStreamMode::SseStreaming(_)
      | AdminStreamMode::DriveDownloading(_)
      | AdminStreamMode::SessionFileDownloading(_)
      | AdminStreamMode::WaitingArchiveExtract(_)
      | AdminStreamMode::WaitingAsyncOp(_)
      | AdminStreamMode::WaitingLinkPreview(_)
      | AdminStreamMode::WaitingFeedbackReport(_)
      | AdminStreamMode::SendingBody(_) => {
        astream.rx_buf = Bytes::new(0)
        return Ok(())
      }
      AdminStreamMode::ControlStream => {
        let chunk = astream.rx_buf
        astream.rx_buf = Bytes::new(0)
        if chunk.length() == 0 {
          return Ok(())
        }
        match st.admin_conns.get(astream.conn_id) {
          Some(aconn) => {
            let now_w = host_shim::wall_ms()
            let now_s = (now_w / 1000L).to_double()
            let acts = st.serve.feed_member_control(
              aconn.conn_id,
              aconn.remote_id,
              chunk,
              now_w,
              fn(hello : base_codec::Json, rid : String) -> Result[(station_mesh::MemberSession, base_codec::Json), mesh_door::Refusal] {
                match verify_member_credential(ctx.cloud, hello, rid, now_s) {
                  Ok(vm) => {
                    aconn.iat = vm.iat
                    aconn.sid_claim = vm.sid_claim
                    aconn.cred_role = vm.cred_role
                    aconn.effective_role = vm.session.role
                    aconn.lock_base = vm.lock_base
                    aconn.lock_proof = vm.lock_proof
                    record_seen_member(st.seen_members, vm.session.workspace, vm.session.user_sub, seen_member_session_key(vm.sid_claim, aconn.conn_id), vm.session.email, vm.session.role, vm.iat, vm.sid_claim, vm.session.expires_unix)
                    let reply = base_codec::json_obj([
                      ("ok", base_codec::json_bool(true)),
                      ("station", base_codec::json_str(st.core.config.station_id)),
                      ("workspace", base_codec::json_str(vm.session.workspace)),
                      ("role", base_codec::json_str(vm.session.role)),
                    ])
                    Ok((vm.session, reply))
                  }
                  Err(refusal) => Err(refusal)
                }
              },
              fn(_cur : station_mesh::MemberSession, line : base_codec::Json) -> station_mesh::MemberRenewResult {
                let prior_lock : Option[(String, String)] = match (aconn.lock_base, aconn.lock_proof) {
                  (Some(b), Some(p)) => Some((b, p))
                  _ => None
                }
                match verify_member_credential(ctx.cloud, line, aconn.remote_id, now_s, prior_lock=prior_lock) {
                  Ok(vm) => {
                    aconn.iat = vm.iat
                    aconn.sid_claim = vm.sid_claim
                    aconn.cred_role = vm.cred_role
                    aconn.effective_role = vm.session.role
                    aconn.lock_base = vm.lock_base
                    aconn.lock_proof = vm.lock_proof
                    record_seen_member(st.seen_members, vm.session.workspace, vm.session.user_sub, seen_member_session_key(vm.sid_claim, aconn.conn_id), vm.session.email, vm.session.role, vm.iat, vm.sid_claim, vm.session.expires_unix)
                    let reply = base_codec::json_obj([
                      ("ok", base_codec::json_bool(true)),
                      ("station", base_codec::json_str(st.core.config.station_id)),
                      ("workspace", base_codec::json_str(vm.session.workspace)),
                      ("role", base_codec::json_str(vm.session.role)),
                    ])
                    station_mesh::MemberRenewResult::Updated(vm.session, reply)
                  }
                  Err(refusal) => station_mesh::MemberRenewResult::SoftError(refusal.error)
                }
              },
            )
            // Exempt control stream 1 from generic 60s idle sweep ONLY AFTER authentication succeeds!
            match st.serve.member_of(aconn.conn_id) {
              Some(_) => ctx.set_stream_idle_exempt(astream.sid, true)
              None => ()
            }
            apply_door_actions(ctx, aconn, acts)
          }
          None => ()
        }
        return Ok(())
      }
      AdminStreamMode::ReadingHeadLine => {
        let nl = find_newline_byte(astream.rx_buf)
        if nl < 0 {
          if astream.rx_buf.length() > WHOLE_MAX_ADMIN_HEAD {
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(431, "request header too large"))
            astream.mode = AdminStreamMode::Done
            astream.rx_buf = Bytes::new(0)
          }
          return Ok(())
        }
        if nl > WHOLE_MAX_ADMIN_HEAD {
          send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(431, "request header too large"))
          astream.mode = AdminStreamMode::Done
          astream.rx_buf = Bytes::new(0)
          return Ok(())
        }
        let line = bytes_to_str_local(astream.rx_buf, nl)
        let tail = slice_bytes_local(astream.rx_buf, nl + 1, astream.rx_buf.length())
        astream.rx_buf = Bytes::new(0)
        let head_j = match base_codec::json_parse(line) {
          base_codec::JsonParseResult::Ok(j) => j
          base_codec::JsonParseResult::Err(e) => {
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "invalid request head json: " + e))
            astream.mode = AdminStreamMode::Done
            return Ok(())
          }
        }
        let method = match base_codec::json_get(head_j, "method") {
          Some(base_codec::Json::Str(m)) => if m.length() > 0 { m } else { "GET" }
          _ => "GET"
        }
        let path = match base_codec::json_get(head_j, "path") {
          Some(base_codec::Json::Str(p)) => p
          _ => {
            send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "path is required"))
            astream.mode = AdminStreamMode::Done
            return Ok(())
          }
        }
        if !path.starts_with("/") {
          send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "path must start with /"))
          astream.mode = AdminStreamMode::Done
          return Ok(())
        }
        let headers = parse_admin_headers(base_codec::json_get(head_j, "headers"))
        let expected_cl : Option[Int64] = match req_header_ci(headers, "content-length") {
          Some(cls) => match base_codec::parse_int64_str(cls.trim()) {
            Some(n) => if n >= 0L { Some(n) } else {
              send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "invalid content-length"))
              astream.mode = AdminStreamMode::Done
              return Ok(())
            }
            None => {
              send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(400, "invalid content-length"))
              astream.mode = AdminStreamMode::Done
              return Ok(())
            }
          }
          None => None
        }
        let req_head = AdminReqHead::{ method: method, path: path, headers: headers, expected_cl: expected_cl }
        let norm_raw = station_whole::normalize_api_path(path)
        let (norm_path, _, _) = station_http::parse_request_target(norm_raw)

        if method == "GET" || method == "HEAD" {
          dispatch_admin_request(ctx, st, astream, req_head, Bytes::new(0))
          return Ok(())
        }

        if method == "PUT" && norm_path == "/drive/upload" {
          match begin_admin_drive_upload(st, astream, req_head) {
            Err(resp) => {
              send_admin_resp_and_finish(ctx, astream.sid, resp)
              astream.mode = AdminStreamMode::Done
              return Ok(())
            }
            Ok(up) => {
              if tail.length() > 0 {
                feed_drive_upload_chunk(st, up, tail)
              }
              astream.mode = AdminStreamMode::StreamingDriveUpload(up)
              match up.failed {
                Some(_) => finish_admin_drive_upload(ctx, st, astream, up)
                None => ()
              }
              return Ok(())
            }
          }
        }

        match expected_cl {
          Some(cl) => {
            if cl > WHOLE_MAX_HTTP_BODY {
              send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(413, "payload too large"))
              astream.mode = AdminStreamMode::Done
              return Ok(())
            }
          }
          None => ()
        }
        if tail.length().to_int64() > WHOLE_MAX_HTTP_BODY {
          send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(413, "payload too large"))
          astream.mode = AdminStreamMode::Done
          return Ok(())
        }
        astream.mode = AdminStreamMode::ReadingBody(req_head, tail)
        return Ok(())
      }
      AdminStreamMode::ReadingBody(req_head, acc) => {
        if astream.rx_buf.length() == 0 {
          return Ok(())
        }
        let next_len = acc.length().to_int64() + astream.rx_buf.length().to_int64()
        if next_len > WHOLE_MAX_HTTP_BODY {
          send_admin_resp_and_finish(ctx, astream.sid, station_api::json_error(413, "payload too large"))
          astream.mode = AdminStreamMode::Done
          astream.rx_buf = Bytes::new(0)
          return Ok(())
        }
        let next_acc = concat_bytes_local(acc, astream.rx_buf)
        astream.rx_buf = Bytes::new(0)
        astream.mode = AdminStreamMode::ReadingBody(req_head, next_acc)
        return Ok(())
      }
      AdminStreamMode::StreamingDriveUpload(up) => {
        if astream.rx_buf.length() == 0 {
          return Ok(())
        }
        let chunk = astream.rx_buf
        astream.rx_buf = Bytes::new(0)
        feed_drive_upload_chunk(st, up, chunk)
        match up.failed {
          Some(_) => finish_admin_drive_upload(ctx, st, astream, up)
          None => ()
        }
        return Ok(())
      }
    }
  }

  let close_proxy_local_resources = fn(ctx : DaemonCtx, st : WholeRuntimeState, pstream : ProxyStreamState) -> Unit {
    match pstream.mode {
      ProxyStreamMode::ResolvingHost(ev_id, _, _, _, _, _) => st.dns_streams.remove(ev_id)
      _ => ()
    }
    pstream.tcp_write_queue.clear()
    pstream.tcp_write_queue_bytes = 0
    pstream.tcp_write_in_flight = false
    pstream.tcp_end_pending = false
    pstream.tcp_read_paused = false
    pstream.downstream_pending = []
    pstream.downstream_pending_idx = 0
    pstream.downstream_finish_after = false
    if pstream.mesh_read_paused {
      pstream.mesh_read_paused = false
      ctx.set_peer_http_read_paused(pstream.sid, false)
    }
    if pstream.local_sock >= 0L {
      let lsid = pstream.local_sock
      pstream.local_sock = -1L
      st.proxy_by_sock.remove(lsid)
      let _ = ctx.mux_role.call_async_raw(
        builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_CLOSE, pstream.sid),
        "tcp.close",
        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(lsid))])),
        None,
      )
    }
  }

  // Serialized upstream TCP writer (max 1 in-flight `tcp.write` per local socket + true inbound mesh read-pause backpressure).
  let enqueue_proxy_tcp_write = fn(ctx : DaemonCtx, st : WholeRuntimeState, pstream : ProxyStreamState, data : Bytes) -> Unit {
    if data.length() == 0 || pstream.local_sock < 0L {
      return
    }
    if pstream.tcp_write_in_flight {
      if pstream.tcp_write_queue_bytes + data.length() > WHOLE_MAX_UPSTREAM_WRITE_Q {
        close_proxy_local_resources(ctx, st, pstream)
        ctx.close_peer_http(pstream.sid)
        pstream.mode = ProxyStreamMode::Done
        return
      }
      pstream.tcp_write_queue.push(data)
      pstream.tcp_write_queue_bytes = pstream.tcp_write_queue_bytes + data.length()
      if !pstream.mesh_read_paused && pstream.tcp_write_queue_bytes >= WHOLE_UPSTREAM_READ_PAUSE_HIGH {
        pstream.mesh_read_paused = true
        ctx.set_peer_http_read_paused(pstream.sid, true)
      }
    } else {
      pstream.tcp_write_in_flight = true
      let _ = ctx.mux_role.call_async_raw(
        builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_WRITE, pstream.sid),
        "tcp.write",
        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(pstream.local_sock))])),
        Some(data),
      )
    }
  }

  let enqueue_proxy_tcp_end = fn(ctx : DaemonCtx, pstream : ProxyStreamState) -> Unit {
    if pstream.local_sock < 0L {
      return
    }
    if pstream.tcp_write_in_flight {
      pstream.tcp_end_pending = true
    } else {
      let _ = ctx.mux_role.call_async_raw(
        builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_END, pstream.sid),
        "tcp.end",
        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(pstream.local_sock))])),
        None,
      )
    }
  }

  let issue_proxy_tcp_read_or_pause = fn(ctx : DaemonCtx, pstream : ProxyStreamState) -> Unit {
    if pstream.local_sock < 0L {
      return
    }
    if pstream.downstream_pending_idx < pstream.downstream_pending.length()
    || ctx.is_peer_http_write_paused(pstream.sid)
    {
      pstream.tcp_read_paused = true
      return
    }
    pstream.tcp_read_paused = false
    let _ = ctx.mux_role.call_async_raw(
      builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_READ, pstream.sid),
      "tcp.read",
      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(pstream.local_sock))])),
      None,
    )
  }

  let pump_proxy_downstream = fn(ctx : DaemonCtx, st : WholeRuntimeState, pstream : ProxyStreamState) -> Unit {
    while pstream.downstream_pending_idx < pstream.downstream_pending.length() {
      if ctx.is_peer_http_write_paused(pstream.sid) {
        pstream.tcp_read_paused = true
        return
      }
      let piece = pstream.downstream_pending[pstream.downstream_pending_idx]
      pstream.downstream_pending_idx = pstream.downstream_pending_idx + 1
      ctx.write_peer_http_chunk(pstream.sid, piece)
    }
    if pstream.downstream_pending.length() > 0 {
      pstream.downstream_pending = []
      pstream.downstream_pending_idx = 0
    }
    if pstream.downstream_finish_after {
      pstream.downstream_finish_after = false
      ctx.finish_peer_http(pstream.sid)
      close_proxy_local_resources(ctx, st, pstream)
      pstream.mode = ProxyStreamMode::Done
      return
    }
    if pstream.tcp_read_paused && pstream.local_sock >= 0L
    && ctx.peer_http_write_queued_bytes(pstream.sid) <= PEER_HTTP_WRITE_LOW_WATER
    {
      issue_proxy_tcp_read_or_pause(ctx, pstream)
    }
  }

  // Enqueue a potentially large downstream WS frame (up to 16 MiB) in 64 KiB slices so it NEVER
  // trips `PEER_HTTP_WRITE_HARD_CAP` (2 MiB) and naturally pauses upstream `tcp.read` on backpressure.
  let enqueue_proxy_downstream_chunked = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    pstream : ProxyStreamState,
    data : Bytes,
    finish_after : Bool,
  ) -> Unit {
    let n = data.length()
    let mut off = 0
    while off < n {
      let end = if off + WHOLE_WS_DOWNSTREAM_CHUNK < n { off + WHOLE_WS_DOWNSTREAM_CHUNK } else { n }
      let piece = if off == 0 && end == n { data } else { slice_bytes_local(data, off, end) }
      pstream.downstream_pending.push(piece)
      off = end
    }
    if finish_after {
      pstream.downstream_finish_after = true
    }
    pump_proxy_downstream(ctx, st, pstream)
  }

  let ws_random_mask = fn() -> UInt {
    match station_sys::random_bytes(4) {
      Ok(b) => {
        if b.length() == 4 {
          let b0 = (b[0].to_int() & 0xFF).to_uint()
          let b1 = (b[1].to_int() & 0xFF).to_uint()
          let b2 = (b[2].to_int() & 0xFF).to_uint()
          let b3 = (b[3].to_int() & 0xFF).to_uint()
          (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        } else {
          0x5A3C9E17U
        }
      }
      Err(_) => 0x5A3C9E17U
    }
  }

  let build_ws_upgrade_request = fn(
    port : Int,
    path : String,
    headers : Array[(String, String)],
  ) -> (Bytes, String) {
    let key_raw = match station_sys::random_bytes(16) {
      Ok(b) => if b.length() == 16 { b } else { "0123456789abcdef".to_bytes() }
      Err(_) => "0123456789abcdef".to_bytes()
    }
    let ws_key = base64::encode(key_raw)
    let accept_hex = crypto::sha1_hex((ws_key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").to_bytes())
    let expected_accept = match base_codec::hex_decode(accept_hex) {
      Some(ab) => base64::encode(ab)
      None => ""
    }
    let eff_path = if path.length() > 0 && path.starts_with("/") { path } else { "/" + path }
    let sb = StringBuilder::new()
    sb.write_string("GET ")
    sb.write_string(eff_path)
    sb.write_string(" HTTP/1.1\r\nHost: 127.0.0.1:")
    sb.write_string(port.to_string())
    sb.write_string("\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ")
    sb.write_string(ws_key)
    sb.write_string("\r\nSec-WebSocket-Version: 13\r\nOrigin: http://localhost:")
    sb.write_string(port.to_string())
    sb.write_string("\r\n")
    for hi in 0..<headers.length() {
      let (hk, hv) = headers[hi]
      let kl = mesh_wire::ascii_lower(hk)
      if kl == "sec-websocket-protocol" || kl == "cookie" || kl == "user-agent" || kl == "authorization" {
        sb.write_string(hk)
        sb.write_string(": ")
        sb.write_string(hv)
        sb.write_string("\r\n")
      }
    }
    sb.write_string("\r\n")
    (sb.to_string().to_bytes(), expected_accept)
  }

  // Decode `[kind: u8][len: u32be][payload]` WebSocket proxy frames from mesh stream -> masked RFC 6455
  // frames queued over the bounded, serialized upstream TCP writer (`enqueue_proxy_tcp_write`).
  let drain_ws_proxy_rx = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    pstream : ProxyStreamState,
    lsock : Int64,
    dec : websocket::Decoder,
    buf_in : Bytes,
  ) -> Unit {
    let mut buf = buf_in
    while buf.length() >= 5 {
      let kind = buf[0].to_int() & 0xFF
      let flen64 = read_u32_be(buf, 1)
      if flen64 < 0L || flen64 > WS_MAX_FRAME.to_int64() {
        close_proxy_local_resources(ctx, st, pstream)
        ctx.close_peer_http(pstream.sid)
        pstream.mode = ProxyStreamMode::Done
        return
      }
      let flen = flen64.to_int()
      if buf.length() < 5 + flen {
        break
      }
      let payload = slice_bytes_local(buf, 5, 5 + flen)
      buf = slice_bytes_local(buf, 5 + flen, buf.length())
      let mask = ws_random_mask()
      if kind == WS_FRAME_TEXT {
        let frame_b = websocket::encode_message(
          websocket::Message::Text(bytes_to_str_local(payload, payload.length())),
          Some(mask),
        )
        enqueue_proxy_tcp_write(ctx, st, pstream, frame_b)
      } else if kind == WS_FRAME_BINARY {
        let frame_b = websocket::encode_message(websocket::Message::Binary(payload), Some(mask))
        enqueue_proxy_tcp_write(ctx, st, pstream, frame_b)
      } else if kind == WS_FRAME_CLOSE {
        let cf_opt : Option[websocket::CloseFrame] = if payload.length() >= 2 {
          let code = ((payload[0].to_int() & 0xFF) * 256) + (payload[1].to_int() & 0xFF)
          let reason = if payload.length() > 2 {
            let rb = slice_bytes_local(payload, 2, payload.length())
            bytes_to_str_local(rb, rb.length())
          } else {
            ""
          }
          Some(websocket::CloseFrame::new(code, reason))
        } else {
          None
        }
        let frame_b = websocket::encode_message(websocket::Message::Close(cf_opt), Some(mask))
        enqueue_proxy_tcp_write(ctx, st, pstream, frame_b)
        enqueue_proxy_tcp_end(ctx, pstream)
        pstream.mode = ProxyStreamMode::WsForwarding(lsock, dec, Bytes::new(0))
        return
      }
      if pstream.local_sock < 0L {
        return
      }
    }
    pstream.mode = ProxyStreamMode::WsForwarding(lsock, dec, buf)
  }

  // Feed upstream RFC 6455 bytes into `websocket::Decoder` -> emit `[kind: u8][len: u32be][payload]`
  // frames onto mesh stream, replying Pong automatically and pausing upstream `tcp.read` on backpressure.
  let feed_ws_upstream_bytes = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    pstream : ProxyStreamState,
    lsock : Int64,
    dec : websocket::Decoder,
    chunk : Bytes,
  ) -> Unit {
    if chunk.length() > 0 {
      dec.feed(chunk)
    }
    while true {
      match dec.next_message() {
        Ok(None) => break
        Ok(Some(websocket::Message::Text(txt))) => {
          enqueue_proxy_downstream_chunked(ctx, st, pstream, encode_ws_proxy_frame(WS_FRAME_TEXT, txt.to_bytes()), false)
        }
        Ok(Some(websocket::Message::Binary(bin))) => {
          enqueue_proxy_downstream_chunked(ctx, st, pstream, encode_ws_proxy_frame(WS_FRAME_BINARY, bin), false)
        }
        Ok(Some(websocket::Message::Ping(payload))) => {
          let pong_b = websocket::encode_message(websocket::Message::Pong(payload), Some(ws_random_mask()))
          enqueue_proxy_tcp_write(ctx, st, pstream, pong_b)
        }
        Ok(Some(websocket::Message::Pong(_))) => ()
        Ok(Some(websocket::Message::Close(cf_opt))) => {
          let (code, reason) = match cf_opt {
            Some(cf) => (cf.code, cf.reason)
            None => (1000, "")
          }
          let rb = reason.to_bytes()
          let payload = Bytes::new(2 + rb.length())
          payload[0] = ((code / 256) & 0xFF) as Byte
          payload[1] = (code & 0xFF) as Byte
          for ri in 0..<rb.length() {
            payload[2 + ri] = rb[ri]
          }
          enqueue_proxy_downstream_chunked(ctx, st, pstream, encode_ws_proxy_frame(WS_FRAME_CLOSE, payload), true)
          return
        }
        Err(_) => {
          ctx.finish_peer_http(pstream.sid)
          close_proxy_local_resources(ctx, st, pstream)
          pstream.mode = ProxyStreamMode::Done
          return
        }
      }
    }
    if pstream.local_sock == lsock {
      issue_proxy_tcp_read_or_pause(ctx, pstream)
    }
  }

  let process_proxy_stream_rx = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    pstream : ProxyStreamState,
  ) -> Result[Unit, String] {
    match pstream.mode {
      ProxyStreamMode::Done => {
        pstream.rx_buf = Bytes::new(0)
        return Ok(())
      }
      ProxyStreamMode::ReadingHeadLine => {
        let nl = find_newline_byte(pstream.rx_buf)
        if nl < 0 {
          if pstream.rx_buf.length() > WHOLE_MAX_PROXY_HEAD {
            send_proxy_refusal_and_finish(ctx, pstream.sid, 431, "request head too large")
            pstream.mode = ProxyStreamMode::Done
            pstream.rx_buf = Bytes::new(0)
          }
          return Ok(())
        }
        if nl > WHOLE_MAX_PROXY_HEAD {
          send_proxy_refusal_and_finish(ctx, pstream.sid, 431, "request head too large")
          pstream.mode = ProxyStreamMode::Done
          pstream.rx_buf = Bytes::new(0)
          return Ok(())
        }
        let line = bytes_to_str_local(pstream.rx_buf, nl)
        let carry = slice_bytes_local(pstream.rx_buf, nl + 1, pstream.rx_buf.length())
        pstream.rx_buf = Bytes::new(0)
        let head_j = match base_codec::json_parse(line) {
          base_codec::JsonParseResult::Ok(j) => j
          base_codec::JsonParseResult::Err(e) => {
            send_proxy_refusal_and_finish(ctx, pstream.sid, 400, "invalid head json: " + e)
            pstream.mode = ProxyStreamMode::Done
            return Ok(())
          }
        }
        let now_s = (host_shim::wall_ms() / 1000L).to_double()
        let roster = build_cloud_roster(ctx.cloud, now_s, ctx.cloud.peers_current)
        let own_ports : Map[Int, Bool] = Map::new()
        let lb_port = ctx.loopback_port()
        if lb_port > 0 {
          own_ports.set(lb_port, true)
        }
        let shown_lb = ctx.shown_loopback_port()
        if shown_lb > 0 {
          own_ports.set(shown_lb, true)
        }
        let mcp_port = st.mcp_srv.port()
        if mcp_port > 0 {
          own_ports.set(mcp_port, true)
        }
        match ctx.args.launcher.ports {
          Some(lp) => {
            if lp.admin > 0 { own_ports.set(lp.admin, true) }
            if lp.mcp > 0 { own_ports.set(lp.mcp, true) }
          }
          None => ()
        }
        let policy = station_mesh::HttpLocalPolicy::new(
          own_ports,
          fn(_p : Int) -> Bool { false },
          fn(_peer : String, _ws : String) -> Option[String] { None },
          true,
        )
        match station_mesh::authorize_peer_http(roster, pstream.remote_id, head_j, policy) {
          Err(mesh_wire::WireError::HttpRefusal(status, msg, _)) => {
            send_proxy_refusal_and_finish(ctx, pstream.sid, status, msg)
            pstream.mode = ProxyStreamMode::Done
            return Ok(())
          }
          Err(_) => {
            send_proxy_refusal_and_finish(ctx, pstream.sid, 403, "refused")
            pstream.mode = ProxyStreamMode::Done
            return Ok(())
          }
          Ok(station_mesh::PeerHttpAction::TcpProbe(_)) => {
            ctx.write_peer_http_chunk(pstream.sid, encode_proxy_head_line(200, []))
            ctx.finish_peer_http(pstream.sid)
            pstream.mode = ProxyStreamMode::Done
            return Ok(())
          }
          Ok(station_mesh::PeerHttpAction::TcpForward(port)) => {
            if carry.length() > WHOLE_MAX_PRE_CONNECT_BODY {
              send_proxy_refusal_and_finish(ctx, pstream.sid, 413, "pre-connect payload too large")
              pstream.mode = ProxyStreamMode::Done
              return Ok(())
            }
            pstream.mode = ProxyStreamMode::OpeningTcp(port, carry, pstream.peer_ended)
            let _ = ctx.mux_role.call_async_raw(
              builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_OPEN, pstream.sid),
              "tcp.open",
              base_codec::json_stringify(base_codec::json_obj([("port", base_codec::json_int(port))])),
              None,
            )
            return Ok(())
          }
          Ok(station_mesh::PeerHttpAction::HttpProxy(port, method, path, headers, has_body)) => {
            if carry.length() > WHOLE_MAX_PRE_CONNECT_BODY {
              send_proxy_refusal_and_finish(ctx, pstream.sid, 413, "pre-connect payload too large")
              pstream.mode = ProxyStreamMode::Done
              return Ok(())
            }
            pstream.mode = ProxyStreamMode::OpeningHttp(port, method, path, headers, has_body, carry, pstream.peer_ended)
            let _ = ctx.mux_role.call_async_raw(
              builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_OPEN, pstream.sid),
              "tcp.open",
              base_codec::json_stringify(base_codec::json_obj([("port", base_codec::json_int(port))])),
              None,
            )
            return Ok(())
          }
          Ok(station_mesh::PeerHttpAction::WebSocketProxy(port, path, headers)) => {
            if carry.length() > WHOLE_MAX_PRE_CONNECT_BODY {
              send_proxy_refusal_and_finish(ctx, pstream.sid, 413, "pre-connect payload too large")
              pstream.mode = ProxyStreamMode::Done
              return Ok(())
            }
            pstream.mode = ProxyStreamMode::OpeningWsTcp(port, path, headers, carry)
            let _ = ctx.mux_role.call_async_raw(
              builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_OPEN, pstream.sid),
              "tcp.open",
              base_codec::json_stringify(base_codec::json_obj([("port", base_codec::json_int(port))])),
              None,
            )
            return Ok(())
          }
          Ok(station_mesh::PeerHttpAction::DeviceTunnel(ws, session, dev_id, is_probe)) => {
            handle_device_tunnel(ctx, st, pstream, ws, session, dev_id, is_probe, carry, own_ports, send_proxy_refusal_and_finish)
            return Ok(())
          }
        }
      }
      ProxyStreamMode::ResolvingHost(ev_id, host, port, is_probe, carry, ended) => {
        if pstream.rx_buf.length() > 0 {
          if carry.length() + pstream.rx_buf.length() > WHOLE_MAX_PRE_CONNECT_BODY {
            st.dns_streams.remove(ev_id)
            send_proxy_refusal_and_finish(ctx, pstream.sid, 413, "pre-connect payload too large")
            pstream.mode = ProxyStreamMode::Done
            pstream.rx_buf = Bytes::new(0)
            return Ok(())
          }
          let next_carry = concat_bytes_local(carry, pstream.rx_buf)
          pstream.rx_buf = Bytes::new(0)
          pstream.mode = ProxyStreamMode::ResolvingHost(ev_id, host, port, is_probe, next_carry, ended)
        }
        return Ok(())
      }
      ProxyStreamMode::OpeningTcp(port, carry, ended) => {
        if pstream.rx_buf.length() > 0 {
          if carry.length() + pstream.rx_buf.length() > WHOLE_MAX_PRE_CONNECT_BODY {
            send_proxy_refusal_and_finish(ctx, pstream.sid, 413, "pre-connect payload too large")
            pstream.mode = ProxyStreamMode::Done
            pstream.rx_buf = Bytes::new(0)
            return Ok(())
          }
          let next_carry = concat_bytes_local(carry, pstream.rx_buf)
          pstream.rx_buf = Bytes::new(0)
          pstream.mode = ProxyStreamMode::OpeningTcp(port, next_carry, ended)
        }
        return Ok(())
      }
      ProxyStreamMode::OpeningHttp(port, method, path, headers, has_body, carry, ended) => {
        if pstream.rx_buf.length() > 0 {
          if carry.length() + pstream.rx_buf.length() > WHOLE_MAX_PRE_CONNECT_BODY {
            send_proxy_refusal_and_finish(ctx, pstream.sid, 413, "pre-connect payload too large")
            pstream.mode = ProxyStreamMode::Done
            pstream.rx_buf = Bytes::new(0)
            return Ok(())
          }
          let next_carry = concat_bytes_local(carry, pstream.rx_buf)
          pstream.rx_buf = Bytes::new(0)
          pstream.mode = ProxyStreamMode::OpeningHttp(port, method, path, headers, has_body, next_carry, ended)
        }
        return Ok(())
      }
      ProxyStreamMode::OpeningWsTcp(port, path, headers, carry) => {
        if pstream.rx_buf.length() > 0 {
          if carry.length() + pstream.rx_buf.length() > WHOLE_MAX_PRE_CONNECT_BODY {
            send_proxy_refusal_and_finish(ctx, pstream.sid, 413, "pre-connect payload too large")
            pstream.mode = ProxyStreamMode::Done
            pstream.rx_buf = Bytes::new(0)
            return Ok(())
          }
          let next_carry = concat_bytes_local(carry, pstream.rx_buf)
          pstream.rx_buf = Bytes::new(0)
          pstream.mode = ProxyStreamMode::OpeningWsTcp(port, path, headers, next_carry)
        }
        return Ok(())
      }
      ProxyStreamMode::WsHandshaking(lsock, expected_acc, http_buf, carry) => {
        if pstream.rx_buf.length() > 0 {
          if carry.length() + pstream.rx_buf.length() > WHOLE_MAX_PRE_CONNECT_BODY {
            close_proxy_local_resources(ctx, st, pstream)
            send_proxy_refusal_and_finish(ctx, pstream.sid, 413, "pre-connect payload too large")
            pstream.mode = ProxyStreamMode::Done
            pstream.rx_buf = Bytes::new(0)
            return Ok(())
          }
          let next_carry = concat_bytes_local(carry, pstream.rx_buf)
          pstream.rx_buf = Bytes::new(0)
          pstream.mode = ProxyStreamMode::WsHandshaking(lsock, expected_acc, http_buf, next_carry)
        }
        return Ok(())
      }
      ProxyStreamMode::WsForwarding(lsock, dec, buf) => {
        if pstream.rx_buf.length() > 0 {
          let next_buf = concat_bytes_local(buf, pstream.rx_buf)
          pstream.rx_buf = Bytes::new(0)
          drain_ws_proxy_rx(ctx, st, pstream, lsock, dec, next_buf)
        }
        return Ok(())
      }
      ProxyStreamMode::Tunneling(_) => {
        if pstream.rx_buf.length() > 0 {
          let data = pstream.rx_buf
          pstream.rx_buf = Bytes::new(0)
          enqueue_proxy_tcp_write(ctx, st, pstream, data)
        }
        return Ok(())
      }
      ProxyStreamMode::ProxyHttpReadingHead(_, _, _)
      | ProxyStreamMode::ProxyHttpRawBody(_, _, _, _)
      | ProxyStreamMode::ProxyHttpChunkedBody(_, _, _) => {
        if pstream.rx_buf.length() > 0 {
          let data = pstream.rx_buf
          pstream.rx_buf = Bytes::new(0)
          let wire = if pstream.req_chunked { http1::encode_chunk(data) } else { data }
          enqueue_proxy_tcp_write(ctx, st, pstream, wire)
        }
        return Ok(())
      }
    }
  }

  let handle_proxy_role_done = fn(
    ctx : DaemonCtx,
    st : WholeRuntimeState,
    tok : builders_core::MuxToken,
    d : host_shim::ShellDone,
  ) -> Unit {
    if st.live_runners.handle_role_done(ctx, st.core, tok, d, host_shim::now_ms(), host_shim::wall_ms()) {
      return
    }
    match tok {
      builders_core::MuxToken::Tagged(owner_id, kind, sid) => {
        // Wave 17D-2 R6: non-blocking async HTTP live admin op completion (`stream.open` / `stream.read`).
        // - Sets `Done` BEFORE `send_admin_resp_and_finish` so >64 KiB backpressured `SendingBody` is preserved!
        // - If `stream.open` arrives with no active op, decodes and immediately `stream.close`s.
        if kind == LIVE_OP_TOK_HTTP_OPEN || kind == LIVE_OP_TOK_HTTP_READ {
          let mut handled = false
          match st.admin_streams.get(sid) {
            None => ()
            Some(astream) => match astream.mode {
              AdminStreamMode::WaitingAsyncOp(async_st) => {
                handled = true
                match step_async_admin_http_done(ctx, st, kind, async_st, d) {
                  Some(resp) => {
                    astream.mode = AdminStreamMode::Done
                    send_admin_resp_and_finish(ctx, sid, resp)
                  }
                  None => ()
                }
              }
              _ => ()
            }
          }
          if !handled && kind == LIVE_OP_TOK_HTTP_OPEN {
            close_orphaned_async_stream_open(ctx, d)
          }
          return
        }
        // Async `GET /link-preview` stream.open completion (Wave 17D-3).
        if kind == LINK_PREVIEW_TOK_OPEN {
          match st.admin_streams.get(sid) {
            None => {
              // Late completion after client disconnected: close opened stream handle immediately.
              match station_http::decode_stream_open_done(d) {
                Ok(h) if h.id > 0 => {
                  let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + h.id.to_string() + "}", None)
                }
                _ => ()
              }
            }
            Some(astream) => match astream.mode {
              AdminStreamMode::WaitingLinkPreview(lp) => {
                lp.call_id = 0L
                match station_http::decode_stream_open_done(d) {
                  Err(_) => {
                    send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                    astream.mode = AdminStreamMode::Done
                  }
                  Ok(head_info) => {
                    lp.stream_id = head_info.id
                    let close_lp = fn() -> Unit {
                      if lp.stream_id > 0 {
                        let _ = ctx.edge_hub.call_async_discard(
                          "stream.close",
                          "{\"id\":" + lp.stream_id.to_string() + "}",
                          None,
                        )
                        lp.stream_id = 0
                      }
                    }
                    let rem_open = lp.deadline_ms - host_shim::now_ms()
                    if rem_open <= 0L {
                      close_lp()
                      send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                      astream.mode = AdminStreamMode::Done
                      return
                    }
                    let mut ct = ""
                    let mut enc = ""
                    let mut loc : Option[String] = None
                    for hi in 0..<head_info.headers.length() {
                      let hk = wd_ascii_lower(head_info.headers[hi].0)
                      let hv = head_info.headers[hi].1
                      if hk == "content-type" { ct = hv }
                      else if hk == "content-encoding" { enc = wd_ascii_lower(hv.trim()) }
                      else if hk == "location" { loc = Some(hv) }
                    }
                    if enc.length() > 0 && enc != "identity" {
                      close_lp()
                      send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                      astream.mode = AdminStreamMode::Done
                      return
                    }
                    if head_info.status >= 300 && head_info.status < 400 {
                      close_lp()
                      let next_hop = lp.hop + 1
                      if next_hop >= station_whole::LINK_PREVIEW_MAX_HOPS {
                        send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                        astream.mode = AdminStreamMode::Done
                        return
                      }
                      match loc {
                        Some(l) => match station_whole::resolve_redirect_url(lp.url, l) {
                          Some(next_url) => match station_whole::validate_link_preview_url(next_url) {
                            Ok(parsed) => {
                              let next_port = match parsed.port {
                                Some(p) => p
                                None => if parsed.scheme == "https" { 443 } else { 80 }
                              }
                              let ev_id = st.next_dns_ev_id
                              st.next_dns_ev_id = ev_id + 1L
                              lp.hop = next_hop
                              lp.url = next_url
                              lp.target_port = next_port
                              lp.dns_ev_id = ev_id
                              st.dns_streams.set(ev_id, sid)
                              if !station_sys::resolve_host_all_async(ev_id, parsed.host) {
                                st.dns_streams.remove(ev_id)
                                send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                                astream.mode = AdminStreamMode::Done
                              }
                            }
                            Err(_) => {
                              send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                              astream.mode = AdminStreamMode::Done
                            }
                          }
                          None => {
                            send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                            astream.mode = AdminStreamMode::Done
                          }
                        }
                        None => {
                          send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                          astream.mode = AdminStreamMode::Done
                        }
                      }
                      return
                    }
                    let ct_low = wd_ascii_lower(ct)
                    // Require explicit HTML Content-Type (never accept empty Content-Type).
                    if head_info.status < 200 || head_info.status >= 300 || (!ct_low.contains("text/html") && !ct_low.contains("application/xhtml")) {
                      close_lp()
                      send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                      astream.mode = AdminStreamMode::Done
                      return
                    }
                    lp.content_type = ct
                    let stall = if rem_open < 6000L { rem_open.to_int() } else { 6000 }
                    lp.call_id = ctx.mux_role.call_async_raw(
                      builders_core::MuxToken::Tagged(0, LINK_PREVIEW_TOK_READ, sid),
                      "stream.read",
                      base_codec::json_stringify(base_codec::json_obj([
                        ("id", base_codec::json_int(lp.stream_id)),
                        ("stallMs", base_codec::json_int(stall)),
                      ])),
                      None,
                    )
                  }
                }
              }
              _ => {
                // Late `stream.open` completion after stream transitioned out of `WaitingLinkPreview` (e.g. tick timeout -> `Done`):
                // must still close the opened Rust stream handle immediately to prevent leaks.
                match station_http::decode_stream_open_done(d) {
                  Ok(h) if h.id > 0 => {
                    let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + h.id.to_string() + "}", None)
                  }
                  _ => ()
                }
              }
            }
          }
          return
        }
        // Async `GET /link-preview` stream.read completion (Wave 17D-3).
        if kind == LINK_PREVIEW_TOK_READ {
          match st.admin_streams.get(sid) {
            None => ()
            Some(astream) => match astream.mode {
              AdminStreamMode::WaitingLinkPreview(lp) => {
                lp.call_id = 0L
                let finish_lp = fn() -> Unit {
                  if lp.stream_id > 0 {
                    let _ = ctx.edge_hub.call_async_discard(
                      "stream.close",
                      "{\"id\":" + lp.stream_id.to_string() + "}",
                      None,
                    )
                    lp.stream_id = 0
                  }
                  let res_j = station_whole::parse_link_preview_html(lp.body_buf.to_string(), lp.url)
                  send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, base_codec::json_stringify(res_j)))
                  astream.mode = AdminStreamMode::Done
                }
                match station_http::decode_stream_read_done(d) {
                  Err(_) | Ok(station_http::StreamChunk::End) => finish_lp()
                  Ok(station_http::StreamChunk::Data(chunk)) => {
                    let cap_rem = station_whole::LINK_PREVIEW_MAX_BYTES - lp.body_buf.length()
                    let take_len = if chunk.length() > cap_rem { cap_rem } else { chunk.length() }
                    let piece = if take_len == chunk.length() {
                      chunk
                    } else if take_len > 0 {
                      let b = Bytes::new(take_len)
                      for bi in 0..<take_len { b[bi] = chunk[bi] }
                      b
                    } else {
                      Bytes::new(0)
                    }
                    lp.body_buf = concat_bytes_local(lp.body_buf, piece)
                    // O(chunk) `</head>` detection using 16-byte sliding tail (zero O(n^2) re-scan).
                    let probe = lp.head_tail + wd_ascii_lower(piece.to_string())
                    let saw_head_end = probe.contains("</head>")
                    lp.head_tail = if probe.length() > 16 { probe.slice(probe.length() - 16, probe.length()) } else { probe }
                    let rem_read = lp.deadline_ms - host_shim::now_ms()
                    if lp.body_buf.length() >= station_whole::LINK_PREVIEW_MAX_BYTES || saw_head_end || rem_read <= 0L {
                      finish_lp()
                    } else {
                      let stall = if rem_read < 6000L { rem_read.to_int() } else { 6000 }
                      lp.call_id = ctx.mux_role.call_async_raw(
                        builders_core::MuxToken::Tagged(0, LINK_PREVIEW_TOK_READ, sid),
                        "stream.read",
                        base_codec::json_stringify(base_codec::json_obj([
                          ("id", base_codec::json_int(lp.stream_id)),
                          ("stallMs", base_codec::json_int(stall)),
                        ])),
                        None,
                      )
                    }
                  }
                }
              }
              _ => ()
            }
          }
          return
        }
        // Async `POST /threads/:id/report` cloud feedback completion (Wave 17D-3).
        if kind == FEEDBACK_TOK_POST {
          match st.admin_streams.get(sid) {
            None => ()
            Some(astream) => match astream.mode {
              AdminStreamMode::WaitingFeedbackReport(_) => {
                match station_http::decode_fetch_done(d) {
                  Err(e) => {
                    send_admin_resp_and_finish(ctx, sid, station_api::json_error(502, "feedback transport error: " + e.message))
                  }
                  Ok(resp) => {
                    match station_whole::parse_feedback_cloud_response(resp.status, resp.body_text()) {
                      Ok(j) => send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, base_codec::json_stringify(j)))
                      Err(e) => {
                        let body_s = match e.raw_body {
                          Some(rb) => base_codec::json_stringify(rb)
                          None => base_codec::json_stringify(base_codec::json_obj([("error", base_codec::json_str(e.message))]))
                        }
                        send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(e.status, body_s))
                      }
                    }
                  }
                }
                astream.mode = AdminStreamMode::Done
              }
              _ => ()
            }
          }
          return
        }
        // Async `tar.file` archived session upload completion (Wave 17C-3A R4 N1).
        if kind == SESSION_TOK_TAR_FILE {
          match st.admin_streams.get(sid) {
            None => ()
            Some(astream) => match astream.mode {
              AdminStreamMode::WaitingArchiveExtract(spec) => {
                let mut found_ok = false
                match builders_core::decode_shell_done(d) {
                  Ok((Some(v), _)) => {
                    match base_codec::json_get(v, "found") {
                      Some(base_codec::Json::Bool(true)) => found_ok = true
                      _ => ()
                    }
                  }
                  _ => ()
                }
                if !found_ok {
                  let _ = (st.core.agents.jobs.fs.remove_file)(spec.out_path)
                  send_admin_resp_and_finish(ctx, sid, station_api::json_error(404, "station.files.notFound"))
                  astream.mode = AdminStreamMode::Done
                  return
                }
                match (st.core.agents.jobs.fs.stat)(spec.out_path) {
                  Some(fst) => {
                    let total_sz = fst.size
                    let start_off = if spec.is_parts {
                      if spec.offset > total_sz { total_sz } else { spec.offset }
                    } else {
                      0L
                    }
                    let avail = if total_sz > start_off { total_sz - start_off } else { 0L }
                    let send_len = if spec.is_parts {
                      if spec.length < avail { spec.length } else { avail }
                    } else {
                      total_sz
                    }
                    start_session_file_stream(
                      ctx,
                      st,
                      astream,
                      station_whole::SessionFileStreamSpec::{
                        path: spec.out_path,
                        total_size: total_sz,
                        content_type: spec.content_type,
                        extra_headers: [http1::Header::new("stillfail-total", total_sz.to_string())],
                        start_offset: start_off,
                        send_length: send_len,
                        unlink_on_done: true,
                      },
                    )
                  }
                  None => {
                    send_admin_resp_and_finish(ctx, sid, station_api::json_error(404, "station.files.notFound"))
                    astream.mode = AdminStreamMode::Done
                  }
                }
              }
              _ => ()
            }
          }
          return
        }
        // Adopted `stillfail-runner` Unix socket completions (`unix.open` / `unix.read` / `unix.write` / `unix.close`).
        if kind == RUNNER_TOK_UNIX_OPEN {
          match st.adopted_runners.get(owner_id) {
            None => ()
            Some(rconn) => {
              match builders_core::decode_shell_done(d) {
                Ok((Some(v), _)) => {
                  let usid = match base_codec::json_get(v, "id") {
                    Some(base_codec::Json::Num(n, _)) => n.to_int64()
                    _ => -1L
                  }
                  if usid >= 0L {
                    rconn.sock_id = usid
                    st.adopted_runner_by_sock.set(usid, owner_id)
                    st.core.agents.set_adopted_instance_active(rconn.instance_id, true)
                    let attach_b = "{\"op\":\"attach\"}\n".to_bytes()
                    let _ = ctx.mux_role.call_async_raw(
                      builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_WRITE, usid),
                      "tcp.write",
                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(usid))])),
                      Some(attach_b),
                    )
                    let _ = ctx.mux_role.call_async_raw(
                      builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_READ, usid),
                      "tcp.read",
                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(usid))])),
                      None,
                    )
                    ctx.log("adopted runner attached: " + rconn.runner_id)
                  } else {
                    st.core.agents.set_adopted_instance_active(rconn.instance_id, false)
                    st.adopted_runners.remove(owner_id)
                  }
                }
                Err(e) => {
                  ctx.log("adopted runner unix.open failed (" + rconn.runner_id + "): " + e.message)
                  st.core.agents.set_adopted_instance_active(rconn.instance_id, false)
                  st.adopted_runners.remove(owner_id)
                }
                _ => {
                  st.core.agents.set_adopted_instance_active(rconn.instance_id, false)
                  st.adopted_runners.remove(owner_id)
                }
              }
            }
          }
          return
        }
        if kind == RUNNER_TOK_UNIX_READ {
          match st.adopted_runners.get(owner_id) {
            None => ()
            Some(rconn) => {
              if rconn.exited {
                return
              }
              match builders_core::decode_shell_done(d) {
                Ok((_, Some(chunk))) => {
                  if chunk.length() == 0 {
                    rconn.exited = true
                    st.core.agents.set_adopted_instance_active(rconn.instance_id, false)
                    if rconn.sock_id >= 0L {
                      let usid = rconn.sock_id
                      rconn.sock_id = -1L
                      st.adopted_runner_by_sock.remove(usid)
                      let _ = ctx.mux_role.call_async_raw(
                        builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_CLOSE, usid),
                        "tcp.close",
                        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(usid))])),
                        None,
                      )
                    }
                    return
                  }
                  // O(n) raw-byte NDJSON line assembly (no UTF-8 split corruption, bounded to 8 MiB/line).
                  // Batch contiguous `Out` frames from a single `tcp.read` into one ACID WAL tx
                  // before sending ACK so bursty runners avoid per-line `synchronous=FULL` stalls.
                  let mut scan_from = 0
                  let mut cur_chunk = chunk
                  let mut pending_batch : Array[(String, Int64, Int64, Bytes)] = []
                  let mut batch_out = rconn.acked_out
                  let mut batch_err = rconn.acked_err
                  let mut need_reack = false
                  let flush_batch = fn() -> Bool {
                    if pending_batch.length() == 0 {
                      if need_reack && rconn.sock_id >= 0L {
                        need_reack = false
                        let ack_line = station_drivers::encode_runner_ack(
                          rconn.acked_out,
                          rconn.acked_err,
                          Some(rconn.keep_from),
                        ) + "\n"
                        let _ = ctx.mux_role.call_async_raw(
                          builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_WRITE, rconn.sock_id),
                          "tcp.write",
                          base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(rconn.sock_id))])),
                          Some(ack_line.to_bytes()),
                        )
                      }
                      return true
                    }
                    let now_w = host_shim::wall_ms()
                    match st.core.agents.commit_adopted_runner_chunks(
                      rconn.instance_id,
                      rconn.session_key,
                      rconn.runner_id,
                      rconn.runner_pid,
                      rconn.started_at,
                      pending_batch,
                      now_w,
                    ) {
                      Ok(_) => {
                        let count = pending_batch.length()
                        pending_batch = []
                        need_reack = false
                        rconn.acked_out = batch_out
                        rconn.acked_err = batch_err
                        rconn.lines_received = rconn.lines_received + count
                        if rconn.sock_id >= 0L {
                          let ack_line = station_drivers::encode_runner_ack(
                            rconn.acked_out,
                            rconn.acked_err,
                            Some(rconn.keep_from),
                          ) + "\n"
                          let _ = ctx.mux_role.call_async_raw(
                            builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_WRITE, rconn.sock_id),
                            "tcp.write",
                            base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(rconn.sock_id))])),
                            Some(ack_line.to_bytes()),
                          )
                        }
                        true
                      }
                      Err(pe) => {
                        pending_batch = []
                        ctx.log("failed to commit adopted runner chunk (" + rconn.instance_id + "): " + pe + "; closing runner socket fail-stop")
                        rconn.exited = true
                        false
                      }
                    }
                  }
                  while scan_from < cur_chunk.length() {
                    let mut nl = -1
                    for bi in scan_from..<cur_chunk.length() {
                      if (cur_chunk[bi].to_int() & 0xFF) == 10 {
                        nl = bi
                        break
                      }
                    }
                    if nl < 0 {
                      let rem = if scan_from == 0 {
                        cur_chunk
                      } else {
                        slice_bytes_local(cur_chunk, scan_from, cur_chunk.length())
                      }
                      if rconn.rx_total_bytes + rem.length() > WHOLE_RUNNER_MAX_LINE_BYTES {
                        ctx.log("adopted runner line exceeded 8 MiB cap (" + rconn.runner_id + "): closing")
                        rconn.exited = true
                        break
                      }
                      rconn.rx_chunks.push(rem)
                      rconn.rx_total_bytes = rconn.rx_total_bytes + rem.length()
                      break
                    }
                    let tail_part = slice_bytes_local(cur_chunk, scan_from, nl)
                    scan_from = nl + 1
                    let total_line_len = rconn.rx_total_bytes + tail_part.length()
                    if total_line_len > WHOLE_RUNNER_MAX_LINE_BYTES {
                      ctx.log("adopted runner line exceeded 8 MiB cap (" + rconn.runner_id + "): closing")
                      rconn.rx_chunks = []
                      rconn.rx_total_bytes = 0
                      rconn.exited = true
                      break
                    }
                    let line_bytes = if rconn.rx_chunks.length() == 0 {
                      tail_part
                    } else {
                      let merged = Bytes::new(total_line_len)
                      let mut pos = 0
                      for ci in 0..<rconn.rx_chunks.length() {
                        let c = rconn.rx_chunks[ci]
                        for bi in 0..<c.length() {
                          merged[pos + bi] = c[bi]
                        }
                        pos = pos + c.length()
                      }
                      for bi in 0..<tail_part.length() {
                        merged[pos + bi] = tail_part[bi]
                      }
                      rconn.rx_chunks = []
                      rconn.rx_total_bytes = 0
                      merged
                    }
                    let line = bytes_to_str_local(line_bytes, line_bytes.length())
                    if line.trim().length() == 0 {
                      continue
                    }
                    match station_drivers::decode_runner_frame(line) {
                      Some(station_drivers::RunnerFrame::Attached(att_out, att_err, _keep)) => {
                        if !flush_batch() {
                          break
                        }
                        rconn.attached_seen = true
                        let now_w = host_shim::wall_ms()
                        match st.core.agents.get_or_init_runner_instance(
                          rconn.instance_id,
                          rconn.session_key,
                          rconn.runner_id,
                          rconn.runner_pid,
                          rconn.started_at,
                          att_out,
                          att_err,
                          now_w,
                        ) {
                          Ok((eff_out, eff_err, _existed)) => {
                            rconn.acked_out = eff_out
                            rconn.acked_err = eff_err
                            batch_out = eff_out
                            batch_err = eff_err
                            rconn.db_initialized = true
                          }
                          Err(pe) => {
                            ctx.log("failed to init adopted runner instance (" + rconn.instance_id + "): " + pe + "; closing runner socket fail-stop")
                            rconn.exited = true
                            break
                          }
                        }
                      }
                      Some(station_drivers::RunnerFrame::Out(stream, at, payload)) => {
                        let now_w = host_shim::wall_ms()
                        if !rconn.db_initialized {
                          match st.core.agents.get_or_init_runner_instance(
                            rconn.instance_id,
                            rconn.session_key,
                            rconn.runner_id,
                            rconn.runner_pid,
                            rconn.started_at,
                            0L,
                            0L,
                            now_w,
                          ) {
                            Ok((db_out, db_err, _)) => {
                              rconn.acked_out = db_out
                              rconn.acked_err = db_err
                              batch_out = db_out
                              batch_err = db_err
                              rconn.db_initialized = true
                            }
                            Err(pe) => {
                              ctx.log("failed to init adopted runner instance (" + rconn.instance_id + "): " + pe + "; closing runner socket fail-stop")
                              rconn.exited = true
                              break
                            }
                          }
                        }
                        let current_acked = if stream == "err" { batch_err } else { batch_out }
                        let end_pos = at + payload.length().to_int64()
                        if end_pos <= current_acked {
                          // Already committed on disk (duplicate replay): skip duplicate insert and re-ACK.
                          need_reack = true
                        } else if at > current_acked {
                          // Offset gap: commit any valid contiguous prefix before the gap, then fail-stop!
                          let _ = flush_batch()
                          ctx.log(
                            "adopted runner offset gap (" + rconn.instance_id + "): at=" + at.to_string() +
                            " > acked=" + current_acked.to_string() + "; closing runner socket fail-stop",
                          )
                          rconn.exited = true
                          break
                        } else {
                          let (write_at, write_payload) = if at < current_acked {
                            let skip = (current_acked - at).to_int()
                            (current_acked, slice_bytes_local(payload, skip, payload.length()))
                          } else {
                            (at, payload)
                          }
                          pending_batch.push((stream, write_at, end_pos, write_payload))
                          if stream == "err" {
                            batch_err = end_pos
                          } else {
                            batch_out = end_pos
                          }
                        }
                      }
                      Some(station_drivers::RunnerFrame::Exit(code_opt, sig_opt)) => {
                        let _ = flush_batch()
                        st.core.agents.record_adopted_runner_exit(
                          rconn.session_key,
                          code_opt,
                          sig_opt,
                          instance_id=rconn.instance_id,
                        )
                        rconn.exited = true
                        if rconn.sock_id >= 0L {
                          let usid = rconn.sock_id
                          rconn.sock_id = -1L
                          st.adopted_runner_by_sock.remove(usid)
                          let _ = ctx.mux_role.call_async_raw(
                            builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_CLOSE, usid),
                            "tcp.close",
                            base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(usid))])),
                            None,
                          )
                        }
                        return
                      }
                      _ => ()
                    }
                  }
                  if !rconn.exited {
                    let _ = flush_batch()
                  }
                  if rconn.exited {
                    st.core.agents.set_adopted_instance_active(rconn.instance_id, false)
                  }
                  if rconn.exited && rconn.sock_id >= 0L {
                    let usid = rconn.sock_id
                    rconn.sock_id = -1L
                    st.adopted_runner_by_sock.remove(usid)
                    let _ = ctx.mux_role.call_async_raw(
                      builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_CLOSE, usid),
                      "tcp.close",
                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(usid))])),
                      None,
                    )
                    return
                  }
                  if !rconn.exited && rconn.sock_id >= 0L {
                    let _ = ctx.mux_role.call_async_raw(
                      builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_READ, rconn.sock_id),
                      "tcp.read",
                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(rconn.sock_id))])),
                      None,
                    )
                  }
                }
                _ => {
                  rconn.exited = true
                  st.core.agents.set_adopted_instance_active(rconn.instance_id, false)
                  if rconn.sock_id >= 0L {
                    let usid = rconn.sock_id
                    rconn.sock_id = -1L
                    st.adopted_runner_by_sock.remove(usid)
                    let _ = ctx.mux_role.call_async_raw(
                      builders_core::MuxToken::Tagged(owner_id, RUNNER_TOK_UNIX_CLOSE, usid),
                      "tcp.close",
                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(usid))])),
                      None,
                    )
                  }
                }
              }
            }
          }
          return
        }
        if kind == RUNNER_TOK_UNIX_WRITE || kind == RUNNER_TOK_UNIX_CLOSE {
          return
        }

        // TCP port-forward completions (`tcp.open` / `tcp.write` / `tcp.read`).
        if kind == PROXY_TOK_TCP_OPEN {
          match builders_core::decode_shell_done(d) {
            Ok((Some(v), _)) => {
              let lsid = match base_codec::json_get(v, "id") {
                Some(base_codec::Json::Num(n, _)) => n.to_int64()
                _ => -1L
              }
              match st.proxy_streams.get(sid) {
                None => {
                  // Stream closed before `tcp.open` returned: close the orphaned local socket immediately!
                  if lsid >= 0L {
                    let _ = ctx.mux_role.call_async_raw(
                      builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_CLOSE, sid),
                      "tcp.close",
                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(lsid))])),
                      None,
                    )
                  }
                  return
                }
                Some(pstream) => {
                  if lsid < 0L {
                    send_proxy_refusal_and_finish(ctx, sid, 502, "local port connect returned invalid handle")
                    pstream.mode = ProxyStreamMode::Done
                    return
                  }
                  match pstream.mode {
                    ProxyStreamMode::OpeningTcp(_, carry, ended) => {
                      pstream.local_sock = lsid
                      st.proxy_by_sock.set(lsid, sid)
                      pstream.mode = ProxyStreamMode::Tunneling(lsid)
                      ctx.write_peer_http_chunk(sid, encode_proxy_head_line(200, []))
                      if carry.length() > 0 {
                        enqueue_proxy_tcp_write(ctx, st, pstream, carry)
                      }
                      if ended {
                        enqueue_proxy_tcp_end(ctx, pstream)
                      }
                      issue_proxy_tcp_read_or_pause(ctx, pstream)
                    }
                    ProxyStreamMode::OpeningHttp(port, method, path, headers, has_body, carry, ended) => {
                      pstream.local_sock = lsid
                      st.proxy_by_sock.set(lsid, sid)
                      let (req_head_b, use_chunked) = build_upstream_http_request(port, method, path, headers, has_body)
                      pstream.req_chunked = use_chunked
                      let mut first_out = req_head_b
                      if has_body && carry.length() > 0 {
                        let cwire = if use_chunked { http1::encode_chunk(carry) } else { carry }
                        first_out = concat_bytes_local(first_out, cwire)
                      }
                      if has_body && ended && use_chunked {
                        first_out = concat_bytes_local(first_out, "0\r\n\r\n".to_bytes())
                      }
                      pstream.mode = ProxyStreamMode::ProxyHttpReadingHead(lsid, Bytes::new(0), method == "HEAD")
                      enqueue_proxy_tcp_write(ctx, st, pstream, first_out)
                      issue_proxy_tcp_read_or_pause(ctx, pstream)
                    }
                    ProxyStreamMode::OpeningWsTcp(port, path, headers, carry) => {
                      pstream.local_sock = lsid
                      st.proxy_by_sock.set(lsid, sid)
                      let (upgrade_b, expected_acc) = build_ws_upgrade_request(port, path, headers)
                      pstream.mode = ProxyStreamMode::WsHandshaking(lsid, expected_acc, Bytes::new(0), carry)
                      enqueue_proxy_tcp_write(ctx, st, pstream, upgrade_b)
                      issue_proxy_tcp_read_or_pause(ctx, pstream)
                    }
                    _ => {
                      // Stream transitioned to `Done` before `tcp.open` resolved: close immediately!
                      let _ = ctx.mux_role.call_async_raw(
                        builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_CLOSE, sid),
                        "tcp.close",
                        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(lsid))])),
                        None,
                      )
                    }
                  }
                }
              }
            }
            Err(e) => {
              match st.proxy_streams.get(sid) {
                Some(pstream) => {
                  send_proxy_refusal_and_finish(ctx, sid, 502, "nothing takes connections on local port: " + e.message)
                  pstream.mode = ProxyStreamMode::Done
                }
                None => ()
              }
            }
            _ => {
              match st.proxy_streams.get(sid) {
                Some(pstream) => {
                  send_proxy_refusal_and_finish(ctx, sid, 502, "local port connect failed")
                  pstream.mode = ProxyStreamMode::Done
                }
                None => ()
              }
            }
          }
          return
        }

        if kind == PROXY_TOK_TCP_WRITE {
          match st.proxy_streams.get(sid) {
            None => ()
            Some(pstream) => {
              match builders_core::decode_shell_done(d) {
                Err(_) => {
                  close_proxy_local_resources(ctx, st, pstream)
                  ctx.close_peer_http(sid)
                  pstream.mode = ProxyStreamMode::Done
                }
                Ok(_) => {
                  if pstream.local_sock < 0L {
                    pstream.tcp_write_in_flight = false
                    return
                  }
                  if pstream.tcp_write_queue.length() > 0 {
                    let next_c = pstream.tcp_write_queue[0]
                    let rem : Array[Bytes] = []
                    for qi in 1..<pstream.tcp_write_queue.length() {
                      rem.push(pstream.tcp_write_queue[qi])
                    }
                    pstream.tcp_write_queue = rem
                    pstream.tcp_write_queue_bytes = pstream.tcp_write_queue_bytes - next_c.length()
                    if pstream.tcp_write_queue_bytes < 0 {
                      pstream.tcp_write_queue_bytes = 0
                    }
                    if pstream.mesh_read_paused && pstream.tcp_write_queue_bytes <= WHOLE_UPSTREAM_READ_PAUSE_LOW {
                      pstream.mesh_read_paused = false
                      ctx.set_peer_http_read_paused(sid, false)
                    }
                    let _ = ctx.mux_role.call_async_raw(
                      builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_WRITE, sid),
                      "tcp.write",
                      base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(pstream.local_sock))])),
                      Some(next_c),
                    )
                  } else {
                    pstream.tcp_write_in_flight = false
                    pstream.tcp_write_queue_bytes = 0
                    if pstream.mesh_read_paused {
                      pstream.mesh_read_paused = false
                      ctx.set_peer_http_read_paused(sid, false)
                    }
                    if pstream.tcp_end_pending {
                      pstream.tcp_end_pending = false
                      let _ = ctx.mux_role.call_async_raw(
                        builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_END, sid),
                        "tcp.end",
                        base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(pstream.local_sock))])),
                        None,
                      )
                    }
                  }
                }
              }
            }
          }
          return
        }

        if kind == PROXY_TOK_TCP_READ {
          match st.proxy_streams.get(sid) {
            None => ()
            Some(pstream) => {
              match builders_core::decode_shell_done(d) {
                Ok((_, Some(chunk))) => {
                  if chunk.length() == 0 {
                    close_proxy_local_resources(ctx, st, pstream)
                    ctx.finish_peer_http(sid)
                    pstream.mode = ProxyStreamMode::Done
                    return
                  }
                  match pstream.mode {
                    ProxyStreamMode::Tunneling(_) => {
                      ctx.write_peer_http_chunk(sid, chunk)
                      issue_proxy_tcp_read_or_pause(ctx, pstream)
                    }
                    ProxyStreamMode::WsHandshaking(lsock, expected_acc, http_acc, carry) => {
                      let buf = concat_bytes_local(http_acc, chunk)
                      let sep_idx = find_crlf_crlf(buf)
                      if sep_idx < 0 {
                        if buf.length() > WHOLE_MAX_PROXY_HEAD {
                          close_proxy_local_resources(ctx, st, pstream)
                          send_proxy_refusal_and_finish(ctx, sid, 502, "upstream websocket header too large")
                          pstream.mode = ProxyStreamMode::Done
                          return
                        }
                        pstream.mode = ProxyStreamMode::WsHandshaking(lsock, expected_acc, buf, carry)
                        issue_proxy_tcp_read_or_pause(ctx, pstream)
                        return
                      }
                      let head_str = bytes_to_str_local(buf, sep_idx)
                      let ws_tail = slice_bytes_local(buf, sep_idx + 4, buf.length())
                      match parse_upstream_ws_head(head_str) {
                        Err(e) => {
                          close_proxy_local_resources(ctx, st, pstream)
                          send_proxy_refusal_and_finish(ctx, sid, 502, e)
                          pstream.mode = ProxyStreamMode::Done
                          return
                        }
                        Ok((status, resp_hdrs)) => {
                          if status != 101 {
                            ctx.write_peer_http_chunk(sid, encode_proxy_head_line(status, resp_hdrs))
                            if ws_tail.length() > 0 {
                              ctx.write_peer_http_chunk(sid, ws_tail)
                            }
                            close_proxy_local_resources(ctx, st, pstream)
                            ctx.finish_peer_http(sid)
                            pstream.mode = ProxyStreamMode::Done
                            return
                          }
                          let mut got_accept = ""
                          let out_hdrs : Array[(String, String)] = []
                          for hi in 0..<resp_hdrs.length() {
                            let (hk, hv) = resp_hdrs[hi]
                            let kl = mesh_wire::ascii_lower(hk)
                            if kl == "sec-websocket-accept" {
                              got_accept = hv.trim()
                            } else if kl == "sec-websocket-protocol" {
                              out_hdrs.push(("sec-websocket-protocol", hv.trim()))
                            }
                          }
                          if expected_acc.length() > 0 && got_accept != expected_acc {
                            close_proxy_local_resources(ctx, st, pstream)
                            send_proxy_refusal_and_finish(ctx, sid, 502, "invalid sec-websocket-accept from upstream")
                            pstream.mode = ProxyStreamMode::Done
                            return
                          }
                          let dec = websocket::Decoder::new(websocket::Role::Client, WS_MAX_FRAME)
                          ctx.write_peer_http_chunk(sid, encode_proxy_head_line(101, out_hdrs))
                          pstream.mode = ProxyStreamMode::WsForwarding(lsock, dec, Bytes::new(0))
                          if carry.length() > 0 {
                            drain_ws_proxy_rx(ctx, st, pstream, lsock, dec, carry)
                          }
                          if pstream.local_sock == lsock {
                            feed_ws_upstream_bytes(ctx, st, pstream, lsock, dec, ws_tail)
                          }
                        }
                      }
                    }
                    ProxyStreamMode::WsForwarding(lsock, dec, _) => {
                      feed_ws_upstream_bytes(ctx, st, pstream, lsock, dec, chunk)
                    }
                    ProxyStreamMode::ProxyHttpReadingHead(lsock, acc, is_head_req) => {
                      let buf = concat_bytes_local(acc, chunk)
                      let sep_idx = find_crlf_crlf(buf)
                      if sep_idx < 0 {
                        if buf.length() > WHOLE_MAX_PROXY_HEAD {
                          close_proxy_local_resources(ctx, st, pstream)
                          send_proxy_refusal_and_finish(ctx, sid, 502, "upstream response header too large")
                          pstream.mode = ProxyStreamMode::Done
                          return
                        }
                        pstream.mode = ProxyStreamMode::ProxyHttpReadingHead(lsock, buf, is_head_req)
                        issue_proxy_tcp_read_or_pause(ctx, pstream)
                        return
                      }
                      let head_str = bytes_to_str_local(buf, sep_idx)
                      let body_tail = slice_bytes_local(buf, sep_idx + 4, buf.length())
                      match parse_upstream_http_head(head_str) {
                        Err(e) => {
                          close_proxy_local_resources(ctx, st, pstream)
                          send_proxy_refusal_and_finish(ctx, sid, 502, e)
                          pstream.mode = ProxyStreamMode::Done
                          return
                        }
                        Ok((status, resp_hdrs, is_chunked, cl_opt)) => {
                          ctx.write_peer_http_chunk(sid, encode_proxy_head_line(status, resp_hdrs))
                          let bodyless = is_head_req || status < 200 || status == 204 || status == 304
                          if bodyless {
                            close_proxy_local_resources(ctx, st, pstream)
                            ctx.finish_peer_http(sid)
                            pstream.mode = ProxyStreamMode::Done
                            return
                          }
                          if is_chunked {
                            let dec = http1::ChunkedDecoder::with_limits(http1::Limits::default())
                            if body_tail.length() > 0 {
                              dec.feed(body_tail)
                            }
                            let mut finished = false
                            while true {
                              match dec.next() {
                                Ok(http1::ChunkStep::Data(c)) => {
                                  if c.length() > 0 {
                                    ctx.write_peer_http_chunk(sid, c)
                                  }
                                }
                                Ok(http1::ChunkStep::NeedMore) => break
                                Ok(http1::ChunkStep::Done(_)) => {
                                  finished = true
                                  break
                                }
                                Err(_) => {
                                  finished = true
                                  break
                                }
                              }
                            }
                            if finished {
                              close_proxy_local_resources(ctx, st, pstream)
                              ctx.finish_peer_http(sid)
                              pstream.mode = ProxyStreamMode::Done
                            } else {
                              pstream.mode = ProxyStreamMode::ProxyHttpChunkedBody(lsock, dec, is_head_req)
                              issue_proxy_tcp_read_or_pause(ctx, pstream)
                            }
                          } else {
                            let mut sent = 0L
                            if body_tail.length() > 0 {
                              ctx.write_peer_http_chunk(sid, body_tail)
                              sent = body_tail.length().to_int64()
                            }
                            let done_now = match cl_opt {
                              Some(cl) => sent >= cl
                              None => false
                            }
                            if done_now {
                              close_proxy_local_resources(ctx, st, pstream)
                              ctx.finish_peer_http(sid)
                              pstream.mode = ProxyStreamMode::Done
                            } else {
                              pstream.mode = ProxyStreamMode::ProxyHttpRawBody(lsock, cl_opt, sent, is_head_req)
                              issue_proxy_tcp_read_or_pause(ctx, pstream)
                            }
                          }
                        }
                      }
                    }
                    ProxyStreamMode::ProxyHttpRawBody(lsock, cl_opt, sent, is_head_req) => {
                      ctx.write_peer_http_chunk(sid, chunk)
                      let next_sent = sent + chunk.length().to_int64()
                      let done_now = match cl_opt {
                        Some(cl) => next_sent >= cl
                        None => false
                      }
                      if done_now {
                        close_proxy_local_resources(ctx, st, pstream)
                        ctx.finish_peer_http(sid)
                        pstream.mode = ProxyStreamMode::Done
                      } else {
                        pstream.mode = ProxyStreamMode::ProxyHttpRawBody(lsock, cl_opt, next_sent, is_head_req)
                        issue_proxy_tcp_read_or_pause(ctx, pstream)
                      }
                    }
                    ProxyStreamMode::ProxyHttpChunkedBody(lsock, dec, is_head_req) => {
                      dec.feed(chunk)
                      let mut finished = false
                      while true {
                        match dec.next() {
                          Ok(http1::ChunkStep::Data(c)) => {
                            if c.length() > 0 {
                              ctx.write_peer_http_chunk(sid, c)
                            }
                          }
                          Ok(http1::ChunkStep::NeedMore) => break
                          Ok(http1::ChunkStep::Done(_)) => {
                            finished = true
                            break
                          }
                          Err(_) => {
                            finished = true
                            break
                          }
                        }
                      }
                      if finished {
                        close_proxy_local_resources(ctx, st, pstream)
                        ctx.finish_peer_http(sid)
                        pstream.mode = ProxyStreamMode::Done
                      } else {
                        pstream.mode = ProxyStreamMode::ProxyHttpChunkedBody(lsock, dec, is_head_req)
                        issue_proxy_tcp_read_or_pause(ctx, pstream)
                      }
                    }
                    _ => close_proxy_local_resources(ctx, st, pstream)
                  }
                }
                _ => {
                  close_proxy_local_resources(ctx, st, pstream)
                  ctx.finish_peer_http(sid)
                  pstream.mode = ProxyStreamMode::Done
                }
              }
            }
          }
        }
      }
      _ => ()
    }
  }

  let hooks = DaemonRoleHooks::{
    role_name: "whole",
    hears_outside: false,
    has_mesh_directory: true,
    accept_peer_http: true,
    accept_admin_alpn: true,
    validate_mode: fn(
      data : String,
      ops_fs : station_ops::OpsFs,
      cloud : station_cloud::CloudStore,
      now_secs : Double,
      sep : String,
    ) -> Result[Unit, String] {
      // Launcher-parity raw `cloud.json` check (`data.rs:202`: `"removed_at": null` is NOT rig-only).
      let cloud_path = nodepath::join(sep, [data, "mesh", "cloud.json"])
      let raw_cloud_is_rig = match ops_fs.read_text(cloud_path) {
        Ok(raw) => is_rig_raw_cloud_json(raw)
        Err(_) => false
      }
      if raw_cloud_is_rig && cloud.is_rig_only(now_secs) {
        return Err("stillfail-station-pion --whole-daemon refuses rig-only station: " + data)
      }
      Ok(())
    },
    on_init: fn(ctx : DaemonCtx) -> Result[Unit, String] {
      let now_secs = (host_shim::wall_ms() / 1000L).to_double()
      let cfg = build_whole_core_config(ctx, now_secs)
      let verify_fn = Some(station_cloud::shell_verifier_of_client(ctx.shell_client))
      let thumb_port = Some(station_whole::os_thumb_port(ctx.shell_client))

      // Pre-handover init ONLY: SQLite MUST NOT be opened until `on_predecessor_gone`!
      let core = station_whole::WholeCore::init_pre_handover(
        cfg,
        thumb_port=thumb_port,
        verify_fn=verify_fn,
        config_file_override=Some(ctx.config_file),
      )
      // Watch `config.json` directory so external edits hot-reload `disabledRuntimes` via `ConfigFile::listen`.
      match core.config_file {
        Some(cfg_file) => {
          let _ = cfg_file.watch(EV_CONFIG_WATCH)
        }
        None => ()
      }
      // Strict per-workspace Drive root isolation (`drive.roots` for home, `drive.workspaces[ws]` for joined; NEVER `$HOME`).
      for wi in 0..<cfg.allowed_workspaces.length() {
        let ws = cfg.allowed_workspaces[wi]
        let ws_roots = parse_drive_roots_for_workspace(ctx.cfg_raw, ws, ws == cfg.home_workspace)
        core.api.set_workspace_drive_roots(ws, ws_roots)
      }

      // Mount all 4 Wave 16C edge OS adapters onto the single `ctx.edge_hub` event pump.
      let replica_dir = nodepath::join(ctx.sep, [ctx.data, "replica"])
      let replica = match station_whole::ReplicaOsRuntime::open(ctx.ops_fs, replica_dir) {
        Ok(r) => r
        Err(e) => return Err("failed to open ReplicaOsRuntime: " + e)
      }
      let devices = station_whole::DevicesOsRuntime::new()
      let terminals = station_whole::TerminalsOsRuntime::new(ctx.data)
      let logins = station_whole::LoginsOsRuntime::new(None)
      let hold_hub = station_browser::AgentHoldHubPort::{
        people_views: fn(_sid : String) -> Array[station_browser::ScreenWatcherView] { [] },
        has_taken_view: fn(_sid : String) -> Bool { false },
        yield_to_agent: fn(_sid : String, _agent : String) -> Int { 0 },
        join_agent: fn(_sid : String, _agent : String) -> Int { 0 },
        leave_agent: fn(_sid : String, _tok : Int) -> Unit {},
      }
      let browser = station_whole::BrowserOsManager::new(
        ctx.edge_hub,
        hold_hub,
        fn(s : String) -> String { s },
        fn(_cid : String) -> Option[String] { None },
      )
      let connect_meta : Map[String, ConnectMeta] = Map::new()
      let remote_connects : Map[String, RemoteConnectRecord] = Map::new()
      let remote_connects_path = nodepath::join(ctx.sep, [ctx.data, "remote-connects.json"])
      let connect_bridge = station_whole::ConnectMuxBridge::with_hub(ctx.edge_hub, ctx.ops_fs)
      let connects_cell : Array[Option[station_whole::ConnectsOsRuntime]] = [None]
      let live_runners_cell : Array[Option[LiveRunnerManager]] = [None]
      let make_local_moved_fwd = fn(connect_id : String) -> (String, String, base_codec::Json, base_codec::Json, (Bool) -> Unit) -> Unit {
        fn(target_station : String, ws : String, desc : base_codec::Json, ev_j : base_codec::Json, on_done : (Bool) -> Unit) -> Unit {
          if target_station.length() == 0 || target_station == ctx.station_key.id {
            on_done(false)
            return
          }
          let fwd_req = encode_connect_event_rpc(connect_id, ctx.station_key.id, ws, desc, ev_j)
          ctx.ask_peer_rpc(target_station, ws, fwd_req, fn(res : Result[base_codec::Json, String]) -> Unit {
            match res {
              Ok(_) => on_done(true)
              Err(e) => {
                ctx.log("[connects] local movedTo forward to " + target_station + " failed: " + e)
                on_done(false)
              }
            }
          })
        }
      }
      let connect_cbs = station_whole::ConnectsCallbacks::{
        on_event: fn(
          connect_id : String,
          _platform : station_connects::ConnectPlatform,
          ev : station_connects::ChatEvent,
          on_done : (Bool) -> Unit,
        ) -> Unit {
          match connects_cell[0] {
            Some(crt) => {
              let _ = handle_connect_inbound_event(
                core,
                crt,
                connect_meta,
                connect_id,
                ev,
                host_shim::wall_ms(),
                on_stop_session=fn(skey : String) -> Unit {
                  match live_runners_cell[0] {
                    Some(lr) => {
                      let _ = lr.stop_session(ctx, skey, host_shim::now_ms())
                    }
                    None => ()
                  }
                },
                on_login_code=fn(lid : String, code : String) -> Unit {
                  let _ = logins.send_input(lid, Some(code), None)
                },
                on_done=Some(on_done),
                on_moved_to=Some(make_local_moved_fwd(connect_id)),
              )
            }
            None => on_done(false)
          }
        },
        on_card_answer: fn(cid : String, ans : station_connects::FeishuCardAnswer, on_done : (Bool) -> Unit) -> Unit {
          match connects_cell[0] {
            Some(crt) => handle_feishu_card_answer(
              core,
              crt,
              connect_meta,
              cid,
              ans,
              host_shim::wall_ms(),
              on_done,
              on_moved_to=Some(make_local_moved_fwd(cid)),
            )
            None => on_done(false)
          }
        },
        on_interactive: fn(cid : String, eid : String, payload : base_codec::Json, on_done : (Bool) -> Unit) -> Unit {
          match connects_cell[0] {
            Some(crt) => handle_slack_interactive_payload(
              core,
              crt,
              connect_meta,
              cid,
              eid,
              payload,
              host_shim::wall_ms(),
              on_done,
              on_moved_to=Some(make_local_moved_fwd(cid)),
            )
            None => on_done(false)
          }
        },
        on_disconnect: fn(_cid : String, _reason : String) -> Unit {},
      }
      let connects = station_whole::ConnectsOsRuntime::new(
        connect_bridge,
        ctx.station_key.id,
        connect_cbs,
      )
      connects.set_feishu_threads_dir(ctx.data)
      connects_cell[0] = Some(connects)
      let comma_notifier = station_connects::PeerChangeNotifier::new()
      connects.set_on_comma_connected(fn(cid : String) -> Unit {
        let now_w = host_shim::wall_ms()
        connects.comma_on_fresh_event(cid)
        let _ = connects.comma_on_build_result(cid, 0, false, now_w)
      })
      connects.set_on_comma_read_file(fn(cid : String, req : station_connects::CommaReadFileReq) -> Result[base_codec::Json, String] {
        let ws = match connect_meta.get(cid) {
          Some(m) => m.ws
          None => core.config.home_workspace
        }
        match parse_comma_chat_ref(req.task) {
          Some((tid, Some(remote_station))) => {
            if remote_station != ctx.station_key.id {
              let fwd = base_codec::json_obj([
                ("method", base_codec::json_str(station_connects::COMMA_PEER_READ_FILE)),
                ("workspace", base_codec::json_str(ws)),
                (
                  "readFile",
                  base_codec::json_obj([
                    ("thread", base_codec::json_int64(tid)),
                    ("seq", base_codec::json_int64(req.seq)),
                    ("file", base_codec::json_str(req.file)),
                    ("offset", base_codec::json_int64(req.offset)),
                  ]),
                ),
              ])
              ctx.enqueue_tell(remote_station, ws, fwd)
              Err("remote station " + remote_station + " read_file dispatched")
            } else {
              router_read_file_local(core, ws, tid, req.seq, req.file, req.offset)
            }
          }
          Some((tid, None)) => router_read_file_local(core, ws, tid, req.seq, req.file, req.offset)
          None => Err("no such chat")
        }
      })
      ctx.edge_hub.set_router(fn(tok : builders_core::MuxToken, done : host_shim::ShellDone) -> Bool {
        connects.handle_mux_reply(tok, done)
      })
      let enabled_in_cfg = enabled_external_connects_in_config(ctx.cfg_raw).length()
      let replica_bs_cell : Array[Bool] = [false]
      core.api.edge_status_fn = Some(fn() -> base_codec::Json {
        base_codec::json_obj([
          (
            "replica",
            base_codec::json_obj([
              ("ready", base_codec::json_bool(true)),
              ("beforeStoreCalled", base_codec::json_bool(replica_bs_cell[0])),
              ("inFlightMoves", base_codec::json_int(replica.in_flight_moves.length())),
            ]),
          ),
          (
            "devices",
            base_codec::json_obj([
              ("registered", base_codec::json_int(count_registered_devices_sql(core.store))),
              ("terminals", base_codec::json_int(terminals.live_count())),
              ("logins", base_codec::json_int(logins.live_count())),
              ("pendingKills", base_codec::json_int(devices.pending_kill_count() + terminals.pending_kill_count() + logins.pending_kill_count())),
            ]),
          ),
          (
            "browser",
            base_codec::json_obj([
              ("running", base_codec::json_int(browser.running_count())),
              ("pendingKills", base_codec::json_int(browser.pending_kill_count())),
            ]),
          ),
          (
            "connects",
            base_codec::json_obj([
              ("enabledInConfig", base_codec::json_int(enabled_in_cfg)),
              ("total", base_codec::json_int(connects.connector_count())),
              ("running", base_codec::json_int(connects.running_count())),
              ("remote", base_codec::json_int(remote_connects.length())),
              ("stopped", base_codec::json_bool(connects.is_stopped())),
            ]),
          ),
          (
            "mux",
            base_codec::json_obj([
              ("deferredSys", base_codec::json_int(ctx.edge_hub.deferred_sys_count())),
              ("deferredDone", base_codec::json_int(ctx.edge_hub.deferred_done_count())),
              ("deferredSysDropped", base_codec::json_int64(ctx.edge_hub.deferred_sys_dropped_count())),
              ("deferredDoneDropped", base_codec::json_int64(ctx.edge_hub.deferred_done_dropped_count())),
            ]),
          ),
        ])
      })

      // Bind inherited `mcp_fd` (or `127.0.0.1:0` when `< 0`) BEFORE handover completes so `/mcp`
      // immediately answers `503` (zero internal info leaked) until `open_after_predecessor_gone` succeeds.
      let mcp_srv = station_http::HttpServer::with_defaults(ctx.mux_door)
      let mcp_cb = station_http::ServerCallbacks::new(fn(req : station_http::HttpRequest) -> station_http::HandlerAction {
        if req.method == "GET" && req.path == "/healthz" {
          return station_http::HandlerAction::Respond(station_http::HttpResponse::text(200, "ok"))
        }
        if req.path == "/mcp" || req.path.starts_with("/mcp/") {
          let req_body = req.body_text()
          let host_hdr = req.header("host")
          let origin_hdr = req.header("origin")
          let auth_hdr = req.header("authorization")
          // Inspect `tools/call` for `chat_post` / `chat_state` so we can validate Feishu `reply_to`
          // strictly AFTER ready + local-origin + Bearer auth (no unauthenticated probing oracle),
          // and forward outbound posts/cards/status-lines to local or remote external connects.
          let mut post_text_opt : Option[String] = None
          let mut post_reply_to_opt : Option[String] = None
          let mut post_card_opt : Option[base_codec::Json] = None
          let mut post_kind_opt : Option[String] = None
          let mut post_for_opt : Option[String] = None
          let mut rpc_id_opt : Option[base_codec::Json] = None
          let mut is_chat_post = false
          let mut is_chat_state = false
          let mut post_to_raw = ""
          match base_codec::json_parse(req_body) {
            base_codec::JsonParseResult::Ok(j) => {
              let mname = match base_codec::json_get(j, "method") {
                Some(base_codec::Json::Str(s)) => s
                _ => ""
              }
              if mname == "tools/call" {
                rpc_id_opt = base_codec::json_get(j, "id")
                match base_codec::json_get(j, "params") {
                  Some(p) => {
                    let tname = match base_codec::json_get(p, "name") {
                      Some(base_codec::Json::Str(s)) => s
                      _ => ""
                    }
                    if tname == "chat_post" || tname == "chat_state" {
                      is_chat_post = tname == "chat_post"
                      is_chat_state = tname == "chat_state"
                      match base_codec::json_get(p, "arguments") {
                        Some(a) => {
                          match base_codec::json_get(a, "to") {
                            Some(base_codec::Json::Str(s)) => post_to_raw = s.trim()
                            _ => ()
                          }
                          match base_codec::json_get(a, "text") {
                            Some(base_codec::Json::Str(s)) => post_text_opt = Some(s)
                            _ => ()
                          }
                          match base_codec::json_get(a, "kind") {
                            Some(base_codec::Json::Str(s)) => post_kind_opt = Some(s)
                            _ => ()
                          }
                          match base_codec::json_get(a, "for") {
                            Some(base_codec::Json::Str(s)) => post_for_opt = Some(s)
                            _ => ()
                          }
                          match base_codec::json_get(a, "reply_to") {
                            Some(base_codec::Json::Str(s)) => {
                              let tr = s.trim()
                              if tr.length() > 0 {
                                post_reply_to_opt = Some(tr)
                              }
                            }
                            _ => ()
                          }
                          post_card_opt = base_codec::json_get(a, "card")
                        }
                        None => ()
                      }
                    }
                  }
                  None => ()
                }
              }
            }
            _ => ()
          }
          // Validate Feishu `reply_to` (#9045) ONLY AFTER `core.ready`, local-origin check, and
          // Bearer token authentication so unauthenticated callers cannot probe thread/message ts.
          if is_chat_post && core.ready {
            match post_reply_to_opt {
              Some(rt_ts) => {
                let origin_ok = match origin_hdr {
                  Some(o) => o.trim().length() == 0
                  None => match host_hdr {
                    Some(h) => {
                      let hl = jscase::lower(h.trim())
                      hl == "127.0.0.1"
                      || hl.starts_with("127.0.0.1:")
                      || hl == "localhost"
                      || hl.starts_with("localhost:")
                      || hl == "[::1]"
                      || hl.starts_with("[::1]:")
                    }
                    None => true
                  }
                }
                let caller_sess_opt : Option[String] = if origin_ok {
                  match auth_hdr {
                    Some(ah) => {
                      let tr = ah.trim()
                      if tr.starts_with("Bearer ") || tr.starts_with("bearer ") {
                        let tok = station_connects::str_slice(tr, 7, tr.to_bytes().length()).trim()
                        core.agents.resolve_token_ct(tok)
                      } else {
                        None
                      }
                    }
                    None => None
                  }
                } else {
                  None
                }
                match caller_sess_opt {
                  Some(caller_sess) => match core.store.require_open() {
                    Ok(st_db) => {
                      let mut surf = ""
                      let mut exists_msg = false
                      let slash = station_connects::str_index_of(post_to_raw, "/", 0)
                      if slash > 0 {
                        let ch = station_connects::str_slice(post_to_raw, 0, slash)
                        let tts = station_connects::str_slice(post_to_raw, slash + 1, post_to_raw.to_bytes().length())
                        // Align with TS `conversations.ts:105-110`: allow pointing to any existing Feishu
                        // thread visible in the authenticated session's workspace (not only threads already joined).
                        let caller_ws = match st_db.get_session(caller_sess) {
                          Ok(Some(srow)) => match srow.ws {
                            Some(w) => if w.length() > 0 { w } else { core.config.home_workspace }
                            None => core.config.home_workspace
                          }
                          _ => core.config.home_workspace
                        }
                        match st_db.db.all(
                          "SELECT id, surface FROM threads WHERE channel = ?1 AND thread_ts = ?2 ORDER BY CASE WHEN surface LIKE 'feishu:%' THEN 0 ELSE 1 END, id ASC LIMIT 10",
                          [base_codec::json_str(ch), base_codec::json_str(tts)],
                        ) {
                          Ok(rows) => {
                            for ri in 0..<rows.length() {
                              let row = rows[ri]
                              let tid = match row.get("id") {
                                Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                _ => 0L
                              }
                              if tid <= 0L {
                                continue
                              }
                              let vis = match station_whole::thread_visible_in_ws(
                                st_db,
                                tid,
                                caller_ws,
                                core.config.home_workspace,
                              ) {
                                Ok(v) => v
                                Err(_) => false
                              }
                              if !vis {
                                continue
                              }
                              surf = match row.get("surface") {
                                Some(base_codec::Json::Str(s)) => s
                                _ => ""
                              }
                              match st_db.db.first(
                                "SELECT 1 AS ok FROM entries WHERE thread = ?1 AND ts = ?2 LIMIT 1",
                                [sql_db::int64_to_json(tid), base_codec::json_str(rt_ts)],
                              ) {
                                Ok(Some(_)) => exists_msg = true
                                _ => ()
                              }
                              break
                            }
                          }
                          _ => ()
                        }
                      }
                      match station_connects::feishu_validate_reply_to(surf, post_to_raw, rt_ts, exists_msg) {
                        Ok(_) => ()
                        Err(verr) => {
                          let err_rpc = base_codec::json_obj([
                            ("jsonrpc", base_codec::json_str("2.0")),
                            (
                              "id",
                              match rpc_id_opt {
                                Some(id_v) => id_v
                                None => base_codec::json_null()
                              },
                            ),
                            (
                              "result",
                              base_codec::json_obj([
                                ("isError", base_codec::json_bool(true)),
                                (
                                  "content",
                                  base_codec::json_arr([
                                    base_codec::json_obj([
                                      ("type", base_codec::json_str("text")),
                                      ("text", base_codec::json_str(verr)),
                                    ]),
                                  ]),
                                ),
                              ]),
                            ),
                          ])
                          return station_http::HandlerAction::Respond(
                            station_http::HttpResponse::json(200, base_codec::json_stringify(err_rpc)),
                          )
                        }
                      }
                    }
                    Err(_) => ()
                  }
                  None => ()
                }
              }
              None => ()
            }
          }
          let mresp = core.handle_mcp_http(
            req.method,
            req.path,
            host_hdr,
            origin_hdr,
            auth_hdr,
            req_body,
            host_shim::wall_ms(),
          )
          // Forward successful `chat_post` (including card-only posts with empty/omitted text!)
          // to local external connects or via `connect.call` peer RPC to the origin station,
          // and apply `#9052` Feishu status-card gating on `chat_post` / `chat_state`.
          if (is_chat_post || is_chat_state) && mresp.status == 200 {
            let txt = match post_text_opt {
              Some(s) => s
              None => ""
            }
            let has_outbound = is_chat_post && (txt.length() > 0 || post_card_opt is Some(_))
            match base_codec::json_parse(mresp.body) {
              base_codec::JsonParseResult::Ok(rj) => {
                let is_err = match base_codec::json_get(rj, "result") {
                  Some(res_obj) => match base_codec::json_get(res_obj, "isError") {
                    Some(base_codec::Json::Bool(true)) => true
                    _ => false
                  }
                  None => true
                }
                if !is_err {
                  match base_codec::json_get(rj, "result") {
                    Some(res_obj) => match base_codec::json_get(res_obj, "content") {
                      Some(base_codec::Json::Arr(carr)) => {
                        if carr.length() > 0 {
                          let ctxt = match base_codec::json_get(carr[0], "text") {
                            Some(base_codec::Json::Str(s)) => s
                            _ => ""
                          }
                          match base_codec::json_parse(ctxt) {
                            base_codec::JsonParseResult::Ok(pj) => {
                              let tid = match base_codec::json_get(pj, "thread") {
                                Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                _ => 0L
                              }
                              let n_seq = match base_codec::json_get(pj, "n") {
                                Some(base_codec::Json::Num(n, _)) => n.to_int64()
                                _ => 0L
                              }
                              if tid > 0L {
                                match core.store.require_open() {
                                  Ok(st_db) => {
                                    match st_db.db.first(
                                      "SELECT t.surface AS surf, t.channel AS ch, t.thread_ts AS tts, ts.connect AS cid FROM threads t JOIN thread_sessions ts ON ts.thread = t.id WHERE t.id = ?1 AND ts.left_at IS NULL LIMIT 1",
                                      [sql_db::int64_to_json(tid)],
                                    ) {
                                      Ok(Some(row)) => {
                                        let surf = match row.get("surf") { Some(base_codec::Json::Str(s)) => s, _ => "" }
                                        let ch = match row.get("ch") { Some(base_codec::Json::Str(s)) => s, _ => "" }
                                        let tts = match row.get("tts") { Some(base_codec::Json::Str(s)) => s, _ => "" }
                                        let cid = match row.get("cid") { Some(base_codec::Json::Str(s)) => s, _ => "" }
                                        if cid.length() > 0 {
                                          if has_outbound {
                                            if connects.has_connect(cid) {
                                              let tref = station_connects::ThreadRef::new(ch, tts, reply_to=post_reply_to_opt)
                                              let pkey = tid.to_string() + ":" + n_seq.to_string()
                                              let _ = connects.send_message(cid, tref, txt, post_key=pkey, card=post_card_opt)
                                            } else {
                                              // Remote connect: forward outbound post/card via `connect.call` peer RPC to origin station.
                                              match remote_connects.get(cid) {
                                                Some(rec) => {
                                                  let at_idx = station_connects::str_index_of(cid, "@", 0)
                                                  let raw_id = if at_idx > 0 { station_connects::str_slice(cid, 0, at_idx) } else { cid }
                                                  let raw_origin = if at_idx > 0 { station_connects::str_slice(cid, at_idx + 1, cid.to_bytes().length()) } else { rec.station }
                                                  let ws_for = match connect_meta.get(cid) {
                                                    Some(m) => m.ws
                                                    None => core.config.home_workspace
                                                  }
                                                  let call_req = build_connect_call_post_request(
                                                    ws_for,
                                                    raw_id,
                                                    raw_origin,
                                                    ch,
                                                    tts,
                                                    post_reply_to_opt,
                                                    txt,
                                                    post_card_opt,
                                                  )
                                                  ctx.ask_peer_rpc(
                                                    rec.station,
                                                    ws_for,
                                                    call_req,
                                                    fn(res : Result[base_codec::Json, String]) -> Unit {
                                                      match res {
                                                        Ok(_) => ()
                                                        Err(err_msg) => ctx.log(
                                                          "[connect.call] remote post to "
                                                          + rec.station
                                                          + " for "
                                                          + cid
                                                          + " failed: "
                                                          + err_msg,
                                                        )
                                                      }
                                                    },
                                                  )
                                                }
                                                None => ()
                                              }
                                            }
                                          }
                                          // `#9052`: apply Feishu status-card gating on turn state transitions.
                                          if surf.starts_with("feishu:") && connects.has_connect(cid) {
                                            match post_kind_opt {
                                              Some("waiting") => {
                                                let st_txt = match post_for_opt {
                                                  Some(f) => f
                                                  None => ""
                                                }
                                                let _ = connects.feishu_apply_status_line(cid, ch + "/" + tts, st_txt, false)
                                              }
                                              Some("all_done") | Some("need_human") => {
                                                let _ = connects.feishu_apply_status_line(cid, ch + "/" + tts, "", true)
                                              }
                                              _ => ()
                                            }
                                          }
                                        }
                                      }
                                      _ => ()
                                    }
                                  }
                                  Err(_) => ()
                                }
                              }
                            }
                            _ => ()
                          }
                        }
                      }
                      _ => ()
                    }
                    None => ()
                  }
                }
              }
              _ => ()
            }
          }
          let resp = station_http::HttpResponse::{
            status: mresp.status,
            reason: station_http::status_reason(mresp.status),
            headers: [http1::Header::new("Content-Type", mresp.content_type)],
            body: mresp.body.to_bytes(),
            chunked: false,
            close_after: false,
          }
          return station_http::HandlerAction::Respond(resp)
        }
        if req.method == "POST" && (req.path == "/job-notify" || req.path == "/jobs/notify") {
          if !core.ready {
            return station_http::HandlerAction::Respond(
              station_api::json_error(503, "station is not ready"),
            )
          }
          let auth = match req.header("authorization") {
            Some(a) => a
            None => ""
          }
          let rep = core.agents.jobs.handle_notify(auth, req.body, host_shim::wall_ms())
          return station_http::HandlerAction::Respond(
            station_http::HttpResponse::json(rep.status, base_codec::json_stringify(rep.body)),
          )
        }
        if req.method == "POST" && req.path == "/jobs/screen" {
          if !core.ready {
            return station_http::HandlerAction::Respond(
              station_api::json_error(503, "station is not ready"),
            )
          }
          let auth = match req.header("authorization") {
            Some(a) => a
            None => ""
          }
          let rep = core.agents.jobs.handle_screen(auth, req.body_text(), host_shim::wall_ms())
          return station_http::HandlerAction::Respond(
            station_http::HttpResponse::json(rep.status, base_codec::json_stringify(rep.body)),
          )
        }
        station_http::HandlerAction::Respond(station_http::HttpResponse::text(404, "not found"))
      })

      let mut mcp_fd_used = false
      match ctx.args.launcher.fds {
        Some(fds) => {
          if fds.mcp >= 0 {
            mcp_srv.listen_fd(fds.mcp)
            mcp_fd_used = true
          }
        }
        None => ()
      }
      if !mcp_fd_used {
        mcp_srv.listen_loopback(0)
      }

      let live_runners = LiveRunnerManager::new()
      live_runners_cell[0] = Some(live_runners)
      let now0 = host_shim::now_ms()
      let seen_members : Map[String, Map[String, Map[String, SeenMember]]] = Map::new()
      let dsb = wire_whole_core_runtime_hooks(ctx, core, devices, logins, browser, seen_members)
      let upkeep = AsyncUpkeepRunner::new(ctx.data, ctx.sep, core.agents.jobs.fs, host_shim::now_ms())
      state_opt = Some(WholeRuntimeState::{
        core: core,
        replica: replica,
        devices: devices,
        terminals: terminals,
        logins: logins,
        browser: browser,
        dsb: dsb,
        connects: connects,
        upkeep: upkeep,
        connect_meta: connect_meta,
        remote_connects: remote_connects,
        remote_connects_path: remote_connects_path,
        comma_notifier: comma_notifier,
        dns_streams: Map::new(),
        next_dns_ev_id: 30064771072L, // 7 << 32 (disjoint from jobs/browser/terminals/logins/adb/restore)
        replica_before_store_ok: false,
        mcp_srv: mcp_srv,
        mcp_cb: mcp_cb,
        serve: station_mesh::ServeEndpoint::new(),
        admin_conns: Map::new(),
        seen_members: seen_members,
        admin_streams: Map::new(),
        proxy_streams: Map::new(),
        proxy_by_sock: Map::new(),
        drive_rpc_puts: Map::new(),
        rig_put_streams: Map::new(),
        adopted_runners: Map::new(),
        adopted_runner_by_sock: Map::new(),
        live_runners: live_runners,
        next_runner_conn_id: 1,
        carried_handover_failed: None,
        mcp_announced: false,
        handover_exported: false,
        becoming_rig: false,
        // timer: periodic jobs and remote upkeep (10m)
        next_upkeep_ms: now0 + WHOLE_UPKEEP_EVERY_MS,
      })
      Ok(())
    },
    on_predecessor_gone: fn(ctx : DaemonCtx) -> Bool {
      match state_opt {
        Some(st) => {
          // If the predecessor reported handover snapshot failure via launcher `carried`,
          // abort takeover immediately so `Slot::Current` emits `{"failed": ...}` and the
          // launcher writes `handoff-failed` (never falsely claiming `has taken over`!).
          match st.carried_handover_failed {
            Some(err_msg) => {
              let msg = "handover snapshot failed on predecessor: " + err_msg
              ctx.log(msg)
              ctx.fail_and_stop(msg)
              return false
            }
            None => ()
          }
          let ho_path = nodepath::join(ctx.sep, [ctx.run_dir, WHOLE_HANDOVER_FILE])
          let mut snap_valid_to_remove = false
          let mut snap_opt : Option[station_whole::WholeHandoverSnapshot] = None
          match ctx.ops_fs.read_text(ho_path) {
            Ok(raw) => {
              match station_whole::WholeHandoverSnapshot::from_json(raw) {
                Ok(s) => {
                  snap_opt = Some(s)
                  snap_valid_to_remove = true
                }
                Err(e) => {
                  // Snapshot exists on disk but is corrupt/unparseable: KEEP the file AND fail takeover!
                  let msg = "handover snapshot parse failed (preserving " + ho_path + "): " + e
                  ctx.log(msg)
                  ctx.fail_and_stop(msg)
                  return false
                }
              }
            }
            Err(station_ops::FsErr::NotFound) => ()
            Err(fe) => {
              // Snapshot exists on disk but could not be read: KEEP the file AND fail takeover!
              let msg = "handover snapshot read failed (preserving " + ho_path + "): " + station_ops::fs_err_msg(fe)
              ctx.log(msg)
              ctx.fail_and_stop(msg)
              return false
            }
          }
          let lr_ho_path = nodepath::join(ctx.sep, [ctx.run_dir, WHOLE_LIVE_RUNNERS_HANDOVER_FILE])
          st.live_runners.set_handover_state_path(lr_ho_path)
          // PR #9161 P2: Clean stale `<data>/tmp/tar-extract-*.bin` ONLY AFTER predecessor is gone
          // via dirfd-relative `O_DIRECTORY|O_NOFOLLOW` + `unlinkat` (zero parent-symlink escape).
          let _ = station_sys::cleanup_stale_tar_extracts_dir(
            nodepath::join(ctx.sep, [ctx.data, "tmp"]),
            host_shim::wall_ms(),
            0L,
          )
          match ctx.ops_fs.read_text(lr_ho_path) {
            Ok(lr_raw) => {
              match base_codec::json_parse(lr_raw) {
                base_codec::JsonParseResult::Ok(lr_j) => {
                  st.live_runners.import_handover_state_json(lr_j)
                  // R12 P1-1: Keep `whole-live-runners.json` on disk until ALL pending_end_turns
                  // and draining_stopping_ids are truly drained (unlink only when empty).
                  let _ = st.live_runners.sync_handover_state_file(ctx.ops_fs, ctx.self_pid, ctx.sep, log_fn=fn(m) { ctx.log(m) })
                }
                base_codec::JsonParseResult::Err(e) => ctx.log("[live-runner] failed to parse " + lr_ho_path + ": " + e)
              }
            }
            Err(_) => ()
          }
          let live_runners = discover_live_runners(ctx.ops_fs, ctx.data, ctx.sep)
          let w_now = host_shim::wall_ms()
          let home_ws = st.core.config.home_workspace
          let before_store_fn = fn(dir : String) -> Result[Unit, String] {
            let ready_path = nodepath::join(ctx.sep, [dir, "restore", "ready.json"])
            if station_sys::lstat_raw(ready_path) is Some(_) {
              let self_argv = host_shim::args()
              let argv0 = if self_argv.length() > 0 { self_argv[0] } else { "" }
              let self_exe = match resolve_self_executable_with(
                argv0,
                match station_sys::getcwd() { Some(c) => c; None => "" },
                station_sys::env_get("PATH"),
                ctx.sep,
                station_sys::os_name(),
                station_sys::realpath,
                station_sys::is_executable,
              ) {
                Some(p) => p
                None => argv0
              }
              if self_exe.length() == 0 {
                let _ = host_shim::write_stderr_line("[whole] replica restore skipped: cannot determine self executable")
              } else {
                let db_path = nodepath::join(ctx.sep, [dir, "stillfail.db"])
                // Disjoint high event_id (6 << 32) for one-shot `--internal-replica-restore` helper.
                let restore_ev_id : Int64 = 25769803776L
                let spawn_opts = station_sys::SpawnOptions::{
                  program: self_exe,
                  args: [
                    "--internal-replica-restore",
                    "--db",
                    db_path,
                    "--data",
                    dir,
                    "--now",
                    w_now.to_string(),
                    "--sep",
                    ctx.sep,
                  ],
                  env: None,
                  cwd: dir,
                  new_pgid: false,
                  strip_malloc_space_efficient: false,
                  pipe_stdin: false,
                  pipe_stdout: false,
                  pipe_stderr: true,
                }
                match station_sys::proc_spawn(restore_ev_id, spawn_opts) {
                  Err(se) => {
                    // 1:1 with Node `station/src/main.ts:240`: log spawn failure and fail-open into startup.
                    let _ = host_shim::write_stderr_line("[whole] failed to spawn --internal-replica-restore: " + se + "; continuing startup")
                  }
                  Ok(child) => {
                    let mut exit_code : Option[Int] = None
                    let err_sb = StringBuilder::new()
                    let mut err_bytes = 0
                    let err_cap = 16384
                    let prev_router = ctx.edge_hub.get_sys_router()
                    ctx.edge_hub.set_sys_router(fn(eid : Int64, payload : Bytes) -> Bool {
                      if eid != restore_ev_id {
                        return false
                      }
                      match station_sys::decode_sys_event(payload) {
                        Some(station_sys::SysEvent::ProcStderr(b)) => {
                          if err_bytes < err_cap {
                            let s = b.to_string()
                            let rem = err_cap - err_bytes
                            if s.to_bytes().length() <= rem {
                              err_sb.write_string(s)
                              err_bytes = err_bytes + s.to_bytes().length()
                            } else {
                              err_sb.write_string(station_connects::str_slice(s, 0, rem))
                              err_bytes = err_cap
                            }
                          }
                        }
                        Some(station_sys::SysEvent::ProcExit(es)) => exit_code = Some(es.code)
                        _ => ()
                      }
                      true
                    })
                    // timer: bounded replica restore helper deadline (120s)
                    let deadline = host_shim::now_ms() + 120000L
                    while exit_code is None && host_shim::now_ms() < deadline {
                      let _ = ctx.edge_hub.pump_one(50L)
                    }
                    ctx.edge_hub.restore_sys_router(prev_router)
                    match exit_code {
                      Some(0) => {
                        let _ = child.close()
                      }
                      Some(rc) => {
                        let _ = child.close()
                        let detail = err_sb.to_string().trim()
                        // 1:1 with Node `station/src/main.ts:238-240`: log restore error and fail-open into
                        // normal startup so a corrupt/failed restore never bricks the station in a boot loop.
                        let _ = host_shim::write_stderr_line(
                          "[whole] replica restore helper exited " + rc.to_string()
                          + (if detail.length() > 0 { ": " + detail } else { "" }),
                        )
                      }
                      None => {
                        let _ = child.kill(station_sys::SIG_KILL, false)
                        let _ = child.close()
                        let _ = host_shim::write_stderr_line("[whole] replica restore helper timed out after 120s; continuing startup")
                      }
                    }
                  }
                }
              }
            }
            match st.replica.before_store(home_ws, ctx.station_key.id, "station_store", "primary", w_now) {
              Ok(_) => {
                st.replica_before_store_ok = true
                Ok(())
              }
              Err(e) => Err(e)
            }
          }
          match st.core.open_after_predecessor_gone(
            true,
            before_store_fn,
            handover=snap_opt,
            runners=live_runners,
            wait_ms=5000,
            now_ms=w_now,
          ) {
            Ok(_) => {
              st.replica.after_store(home_ws, ctx.station_key.id, host_shim::wall_ms())
              // Load persisted cross-station `remote-connects.json` and start all enabled local external
              // connects (Slack / Feishu / Comma / Group) directly onto `WholeCore` `Hub`!
              load_remote_connects_file(
                ctx.ops_fs,
                st.remote_connects_path,
                st.remote_connects,
                st.connect_meta,
                home_ws,
              )
              load_connects_from_config(ctx.cfg_raw, st.connects, st.connect_meta, home_ws)
              let enabled_in_cfg = enabled_external_connects_in_config(ctx.cfg_raw).length()
              // Refresh edge status closure flag after `ReplicaOsRuntime::before_store` succeeds.
              let bs_ok = st.replica_before_store_ok
              st.core.api.edge_status_fn = Some(fn() -> base_codec::Json {
                base_codec::json_obj([
                  (
                    "replica",
                    base_codec::json_obj([
                      ("ready", base_codec::json_bool(true)),
                      ("beforeStoreCalled", base_codec::json_bool(bs_ok)),
                      ("inFlightMoves", base_codec::json_int(st.replica.in_flight_moves.length())),
                    ]),
                  ),
                  (
                    "devices",
                    base_codec::json_obj([
                      ("registered", base_codec::json_int(count_registered_devices_sql(st.core.store))),
                      ("terminals", base_codec::json_int(st.terminals.live_count())),
                      ("logins", base_codec::json_int(st.logins.live_count())),
                      ("pendingKills", base_codec::json_int(st.devices.pending_kill_count() + st.terminals.pending_kill_count() + st.logins.pending_kill_count())),
                    ]),
                  ),
                  (
                    "browser",
                    base_codec::json_obj([
                      ("running", base_codec::json_int(st.browser.running_count())),
                      ("pendingKills", base_codec::json_int(st.browser.pending_kill_count())),
                    ]),
                  ),
                  (
                    "connects",
                    base_codec::json_obj([
                      ("enabledInConfig", base_codec::json_int(enabled_in_cfg)),
                      ("total", base_codec::json_int(st.connects.connector_count())),
                      ("running", base_codec::json_int(st.connects.running_count())),
                      ("remote", base_codec::json_int(st.remote_connects.length())),
                      ("stopped", base_codec::json_bool(st.connects.is_stopped())),
                    ]),
                  ),
                  (
                    "mux",
                    base_codec::json_obj([
                      ("deferredSys", base_codec::json_int(ctx.edge_hub.deferred_sys_count())),
                      ("deferredDone", base_codec::json_int(ctx.edge_hub.deferred_done_count())),
                      ("deferredSysDropped", base_codec::json_int64(ctx.edge_hub.deferred_sys_dropped_count())),
                      ("deferredDoneDropped", base_codec::json_int64(ctx.edge_hub.deferred_done_dropped_count())),
                    ]),
                  ),
                ])
              })
              // Remove handover snapshot ONLY AFTER valid snapshot restore succeeded!
              if snap_valid_to_remove {
                let _ = (ctx.ops_fs.remove)(ho_path)
              }
              // P0-3: Actively reconnect claimed live runners directly into `st.live_runners` so
              // in-flight turns continue parsing stdout and finish cleanly, and subsequent prompts
              // reuse the SAME live runner without socket collisions (while still persisting
              // `adopted-runners.db` chunks with `keep: 0` for `adoptedOutput`).
              let adopt_wall_ms = host_shim::wall_ms()
              let adopt_now_ms = host_shim::now_ms()
              let adopt_cfg = live_config_raw(st.core, ctx.cfg_raw)
              for ri in 0..<live_runners.length() {
                let rinfo = live_runners[ri]
                if rinfo.socket.length() > 0 {
                  match st.core.agents.adopted_session_by_runner_id.get(rinfo.id) {
                    Some(skey) => {
                      let _ = st.live_runners.adopt_live_runner(ctx, st.core, adopt_cfg, rinfo, skey, adopt_now_ms, adopt_wall_ms)
                    }
                    None => ()
                  }
                }
              }
              // R14 Invariant 2: Do NOT single-scan prune `draining_stopping_ids` at startup;
              // `LiveRunnerManager::tick()` safely sweeps dead exact `instance_id`s via OS liveness
              // checks and expires `Spawning` `"rid:<id>@<before_ms>"` markers after 30s while
              // catching late-ready runners during that window.
              ctx.mark_role_ready()
              true
            }
            Err(e) => {
              let msg = "whole_daemon failed to open primary store after predecessor exit: " + e
              ctx.fail_and_stop(msg)
              false
            }
          }
        }
        None => false
      }
    },
    on_peer_rpc: fn(
      ctx : DaemonCtx,
      sid : Int64,
      _line : String,
      bin_opt : Option[Bytes],
      auth : PeerAuthInfo,
      v2_bytes : Bool,
      is_front : Bool,
    ) -> Unit {
      match state_opt {
        Some(st) => {
          match auth.route {
            station_mesh::PeerRouteTarget::BusOutside(_) => {
              let err_b = station_mesh::encode_peer_answer_err("peer is not another station in this workspace", v2_bytes)
              ctx.reply_peer_rpc(sid, err_b, None, v2_bytes, is_front)
              return
            }
            _ => ()
          }
          let now_w = host_shim::wall_ms()
          let req = auth.env.request
          let method = match base_codec::json_get(req, "method") {
            Some(base_codec::Json::Str(m)) => m
            _ => ""
          }
          let ws = auth.env.workspace

          // Roster station HTTP-over-RPC: strictly read-only `AuthenticatedStation` (`role: "viewer"`).
          // NEVER trusts self-asserted email/role headers; write routes (e.g. `POST /sessions`) MUST return `403`.
          if method == "http" {
            let http_method = match base_codec::json_get(req, "httpMethod") {
              Some(base_codec::Json::Str(m)) => m
              _ => "GET"
            }
            let path = match base_codec::json_get(req, "path") {
              Some(base_codec::Json::Str(p)) => p
              _ => "/status"
            }
            let hdrs = parse_admin_headers(base_codec::json_get(req, "headers"))
            let body_bytes = match bin_opt {
              Some(b) => b
              None => match base_codec::json_get(req, "body") {
                Some(base_codec::Json::Str(s)) => s.to_bytes()
                _ => Bytes::new(0)
              }
            }
            let station_peer_id = station_whole::PeerIdentity::AuthenticatedStation(auth.remote_id, ws, false)
            match st.core.handle_peer_http(station_peer_id, http_method, path, hdrs, body_bytes, now_w) {
              station_http::HandlerAction::Respond(resp) => {
                if resp.status >= 200 && resp.status < 300 {
                  match extract_session_stop_key(http_method, path) {
                    Some(stop_skey) => {
                      let _ = st.live_runners.stop_session(ctx, stop_skey, host_shim::now_ms())
                    }
                    None => ()
                  }
                }
                let rh_arr : Array[base_codec::Json] = []
                for hi in 0..<resp.headers.length() {
                  rh_arr.push(
                    base_codec::json_arr([
                      base_codec::json_str(resp.headers[hi].name),
                      base_codec::json_str(resp.headers[hi].value),
                    ]),
                  )
                }
                let res_j = base_codec::json_obj([
                  ("status", base_codec::json_int(resp.status)),
                  ("headers", base_codec::json_arr(rh_arr)),
                  ("body", base_codec::json_str(resp.body.to_string())),
                ])
                let reply_b = station_mesh::encode_peer_answer_ok(res_j, false, v2_bytes)
                ctx.reply_peer_rpc(sid, reply_b, None, v2_bytes, is_front)
              }
              _ => {
                let err_b = station_mesh::encode_peer_answer_err("streaming route requires stillfail/admin/1", v2_bytes)
                ctx.reply_peer_rpc(sid, err_b, None, v2_bytes, is_front)
              }
            }
            return
          }

          // Streaming Drive read over `PEER_BYTES_ALPN` (`method: "drive.read"`).
          if method == "drive.read" {
            let root = match resolve_drive_root_for_ws(
              st.core,
              ws,
              match base_codec::json_get(req, "root") { Some(base_codec::Json::Str(s)) => Some(s), _ => None },
            ) {
              Ok(r) => r
              Err(msg) => {
                ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err(msg, v2_bytes), None, v2_bytes, is_front)
                return
              }
            }
            let rel = match base_codec::json_get(req, "path") {
              Some(base_codec::Json::Str(p)) => p
              _ => {
                ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("path is required", v2_bytes), None, v2_bytes, is_front)
                return
              }
            }
            let offset = match base_codec::json_get(req, "offset") {
              Some(base_codec::Json::Num(n, _)) => n.to_int64()
              _ => 0L
            }
            let length = match base_codec::json_get(req, "length") {
              Some(base_codec::Json::Num(n, _)) => n.to_int()
              _ => WHOLE_DRIVE_READ_CHUNK
            }
            let ws_drive = st.core.api.drive_for_workspace(ws)
            match ws_drive.read(root, rel, offset, length, false) {
              Ok((bytes, total, mtime, mime)) => {
                let meta = base_codec::json_obj([
                  ("total", base_codec::json_int64(total)),
                  ("mtime", base_codec::json_int64(mtime)),
                  ("mime", base_codec::json_str(mime)),
                  ("size", base_codec::json_int(bytes.length())),
                ])
                if v2_bytes {
                  let hdr = station_mesh::encode_peer_answer_ok(meta, true, true)
                  ctx.reply_peer_rpc(sid, concat_bytes_local(hdr, bytes), None, true, is_front)
                } else {
                  ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_ok(meta, false, false), None, false, is_front)
                }
              }
              Err(de) => {
                ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err(de.message, v2_bytes), None, v2_bytes, is_front)
              }
            }
            return
          }

          // Cross-station external connect event delivery (`connect.event`, 1:1 with TS `workspace.ts:348-375 taken()`).
          if method == "connect.event" {
            let validation = validate_connect_event(
              req,
              ws,
              ctx.station_key.id,
              fn(id : String) -> Bool { st.connects.has_connect(id) },
              fn(id : String) -> Option[String] {
                match st.connect_meta.get(id) {
                  Some(m) => Some(m.ws)
                  None => None
                }
              },
            )
            let ev_json = match base_codec::json_get(req, "event") {
              Some(e) => e
              None => {
                ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("event is required", v2_bytes), None, v2_bytes, is_front)
                return
              }
            }
            match validation {
              ConnectEventValidation::Reject(err_msg) => {
                ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err(err_msg, v2_bytes), None, v2_bytes, is_front)
                return
              }
              ConnectEventValidation::DeliverKept(local_cid) => {
                match parse_wire_chat_event(ev_json) {
                  Some(chat_ev) => {
                    let ok = handle_connect_inbound_event(
                      st.core,
                      st.connects,
                      st.connect_meta,
                      local_cid,
                      chat_ev,
                      now_w,
                      on_stop_session=fn(skey : String) -> Unit {
                        let _ = st.live_runners.stop_session(ctx, skey, host_shim::now_ms())
                      },
                      on_login_code=fn(lid : String, code : String) -> Unit {
                        let _ = st.logins.send_input(lid, Some(code), None)
                      },
                    )
                    if ok {
                      let res_j = base_codec::json_obj([("ok", base_codec::json_bool(true))])
                      ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_ok(res_j, false, v2_bytes), None, v2_bytes, is_front)
                    } else {
                      ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("connect.event delivery refused", v2_bytes), None, v2_bytes, is_front)
                    }
                  }
                  None => {
                    ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("invalid connect.event payload", v2_bytes), None, v2_bytes, is_front)
                  }
                }
                return
              }
              ConnectEventValidation::LearnAndDeliver(remote_cid, desc) => {
                // Security (P0-1): Validate event payload, workspace ownership, AND prevent another peer
                // from silently hijacking an existing `RemoteConnectRecord.station` before downstream passes!
                match st.connect_meta.get(remote_cid) {
                  Some(existing_meta) => {
                    if existing_meta.ws != ws {
                      ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("connect workspace mismatch", v2_bytes), None, v2_bytes, is_front)
                      return
                    }
                  }
                  None => ()
                }
                match st.remote_connects.get(remote_cid) {
                  Some(existing_rec) => {
                    if existing_rec.station != auth.remote_id {
                      ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("connect origin station mismatch", v2_bytes), None, v2_bytes, is_front)
                      return
                    }
                  }
                  None => ()
                }
                match parse_wire_chat_event(ev_json) {
                  Some(chat_ev) => {
                    let (ev_ch, ev_tts) = match chat_ev {
                      station_connects::ChatEvent::Message(m) => (m.channel, m.thread_ts)
                      station_connects::ChatEvent::OwnNotice(m) => (m.channel, m.thread_ts)
                      station_connects::ChatEvent::Changed(c, t, _, _) => (c, t)
                      station_connects::ChatEvent::Stop(c, t, _, _) => (c, t)
                      station_connects::ChatEvent::LoginCode(c, t, _, _, _) => (c, t)
                    }
                    // R6 Invariant 4: Query local SQLite `handed_over` directly (1:1 with Node
                    // `hub.ts:801` `movedTo`, zero stale in-memory cache).
                    let moved_opt : Option[String] = match st.core.store.require_open() {
                      Ok(st_db) => {
                        let desc_kind = match base_codec::json_get(desc, "kind") {
                          Some(base_codec::Json::Str(s)) => if s.length() > 0 { s } else { "slack" }
                          _ => "slack"
                        }
                        let desc_surf = surface_for_described(desc_kind, desc, remote_cid)
                        query_thread_moved_to(st_db, desc_surf, remote_cid, ev_ch, ev_tts, ws, st.core.config.home_workspace)
                      }
                      Err(_) => None
                    }
                    match moved_opt {
                      Some(moved) => {
                        if moved != ctx.station_key.id {
                          let fwd_req = base_codec::json_obj([
                            ("method", base_codec::json_str("connect.event")),
                            ("workspace", base_codec::json_str(ws)),
                            (
                              "connect",
                              match base_codec::json_get(req, "connect") {
                                Some(c) => c
                                None => base_codec::json_null()
                              },
                            ),
                            ("described", desc),
                            ("event", ev_json),
                          ])
                          ctx.ask_peer_rpc(moved, ws, fwd_req, fn(res : Result[base_codec::Json, String]) -> Unit {
                            match res {
                              Ok(ans) => {
                                ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_ok(ans, false, v2_bytes), None, v2_bytes, is_front)
                              }
                              Err(e) => {
                                ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("movedTo forward failed: " + e, v2_bytes), None, v2_bytes, is_front)
                              }
                            }
                          })
                          return
                        }
                      }
                      None => ()
                    }
                    let prev_meta_opt = st.connect_meta.get(remote_cid)
                    st.connect_meta.set(remote_cid, connect_meta_from_described(remote_cid, desc, ws))
                    let ok = handle_connect_inbound_event(
                      st.core,
                      st.connects,
                      st.connect_meta,
                      remote_cid,
                      chat_ev,
                      now_w,
                      on_stop_session=fn(skey : String) -> Unit {
                        let _ = st.live_runners.stop_session(ctx, skey, host_shim::now_ms())
                      },
                      on_login_code=fn(lid : String, code : String) -> Unit {
                        let _ = st.logins.send_input(lid, Some(code), None)
                      },
                    )
                    if ok {
                      let rec = RemoteConnectRecord::{ station: auth.remote_id, described: desc }
                      st.remote_connects.set(remote_cid, rec)
                      save_remote_connects_file(
                        ctx.ops_fs,
                        st.remote_connects_path,
                        st.remote_connects,
                        ctx.self_pid,
                        ctx.sep,
                      )
                      let res_j = base_codec::json_obj([("ok", base_codec::json_bool(true))])
                      ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_ok(res_j, false, v2_bytes), None, v2_bytes, is_front)
                    } else {
                      match prev_meta_opt {
                        Some(pm) => st.connect_meta.set(remote_cid, pm)
                        None => st.connect_meta.remove(remote_cid)
                      }
                      ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("connect.event delivery refused", v2_bytes), None, v2_bytes, is_front)
                    }
                  }
                  None => {
                    ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("invalid connect.event payload", v2_bytes), None, v2_bytes, is_front)
                  }
                }
                return
              }
            }
          }

          // Cross-station Comma attachment read (`comma.read_file`, #9001).
          if method == station_connects::COMMA_PEER_READ_FILE {
            let rf = match base_codec::json_get(req, "readFile") {
              Some(r) => r
              None => {
                ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err("no such file request", v2_bytes), None, v2_bytes, is_front)
                return
              }
            }
            let tid = match base_codec::json_get(rf, "thread") {
              Some(base_codec::Json::Num(n, _)) => n.to_int64()
              _ => 0L
            }
            let seq = match base_codec::json_get(rf, "seq") {
              Some(base_codec::Json::Num(n, _)) => n.to_int64()
              _ => 0L
            }
            let fname = match base_codec::json_get(rf, "file") {
              Some(base_codec::Json::Str(s)) => s
              _ => ""
            }
            let offset = match base_codec::json_get(rf, "offset") {
              Some(base_codec::Json::Num(n, _)) => n.to_int64()
              _ => 0L
            }
            match router_read_file_local(st.core, ws, tid, seq, fname, offset) {
              Ok(res_j) => ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_ok(res_j, false, v2_bytes), None, v2_bytes, is_front)
              Err(msg) => ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_err(msg, v2_bytes), None, v2_bytes, is_front)
            }
            return
          }

          // Cross-station Comma change notice (`comma.changed`, #8886): trigger `PeerChangeNotifier`
          // and `CommaUnreadRetry` rebuild cycle for local Comma connectors in this workspace.
          if method == station_connects::COMMA_PEER_CHANGED {
            st.comma_notifier.nudge(now_w)
            let cids = st.connects.comma_ids()
            for ci in 0..<cids.length() {
              let cid = cids[ci]
              st.connects.comma_on_fresh_event(cid)
              let _ = st.connects.comma_on_build_result(cid, 0, false, now_w)
            }
            let res_j = base_codec::json_obj([("ok", base_codec::json_bool(true))])
            ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_ok(res_j, false, v2_bytes), None, v2_bytes, is_front)
            return
          }

          // Standard `WholeCore::handle_peer_rpc` (full-station `describe` + isolated `MixedRig` RPCs).
          let params_form = station_rules_bridge::base_to_form(req)
          match st.core.handle_peer_rpc(auth.remote_id, ws, method, params_form, now_w) {
            Ok(res_form) => {
              let res_base = station_rules_bridge::form_to_base(res_form)
              let reply_b = station_mesh::encode_peer_answer_ok(res_base, false, v2_bytes)
              ctx.reply_peer_rpc(sid, reply_b, None, v2_bytes, is_front)
            }
            Err(msg) => {
              let err_b = station_mesh::encode_peer_answer_err(msg, v2_bytes)
              ctx.reply_peer_rpc(sid, err_b, None, v2_bytes, is_front)
            }
          }
        }
        None => ()
      }
    },
    on_stream_start: fn(
      ctx : DaemonCtx,
      sid : Int64,
      _line : String,
      auth : PeerAuthInfo,
      _v2_bytes : Bool,
    ) -> StreamStartAction {
      match state_opt {
        Some(st) => {
          if !ctx.is_role_ready() {
            return StreamStartAction::Reject("station handover in progress")
          }
          let req = auth.env.request
          let method = match base_codec::json_get(req, "method") {
            Some(base_codec::Json::Str(m)) => m
            _ => ""
          }
          if method == "drive.upload" {
            let root = match resolve_drive_root_for_ws(
              st.core,
              auth.env.workspace,
              match base_codec::json_get(req, "root") { Some(base_codec::Json::Str(s)) => Some(s), _ => None },
            ) {
              Ok(r) => r
              Err(msg) => return StreamStartAction::Reject(msg)
            }
            let rel = match base_codec::json_get(req, "path") {
              Some(base_codec::Json::Str(p)) => if p.length() > 0 { p } else { return StreamStartAction::Reject("path is required") }
              _ => return StreamStartAction::Reject("path is required")
            }
            let up_id = match base_codec::json_get(req, "id") {
              Some(base_codec::Json::Str(u)) => if u.length() > 0 { u } else { return StreamStartAction::Reject("id is required") }
              _ => return StreamStartAction::Reject("id is required")
            }
            let offset = match base_codec::json_get(req, "offset") {
              Some(base_codec::Json::Num(n, _)) => n.to_int64()
              _ => 0L
            }
            let total = match base_codec::json_get(req, "total") {
              Some(base_codec::Json::Num(n, _)) => n.to_int64()
              _ => return StreamStartAction::Reject("total is required")
            }
            let replace = match base_codec::json_get(req, "replace") {
              Some(base_codec::Json::Bool(b)) => b
              _ => false
            }
            st.drive_rpc_puts.set(
              sid,
              WholeDriveRpcPutState::{
                workspace: auth.env.workspace,
                root: root,
                rel: rel,
                upload_id: up_id,
                total: total,
                replace: replace,
                cur_offset: offset,
                last_entry: None,
              },
            )
            return StreamStartAction::Streaming
          }
          if method == "file.put" {
            let now_ms = host_shim::wall_ms()
            let roster = build_cloud_roster(ctx.cloud, (now_ms / 1000L).to_double(), ctx.cloud.peers_current)
            match begin_streaming_file_put(roster, auth.remote_id, auth.env, st.core.rig, st.core.remote, now_ms) {
              Ok(put_ctx) => {
                st.rig_put_streams.set(sid, put_ctx)
                return StreamStartAction::Streaming
              }
              Err(e) => return StreamStartAction::Reject(e)
            }
          }
          StreamStartAction::BufferBinary(station_jobs::REMOTE_CHUNK + 65536)
        }
        None => StreamStartAction::Reject("whole runtime not initialized")
      }
    },
    on_stream_chunk: fn(_ctx : DaemonCtx, sid : Int64, chunk : Bytes) -> Result[Unit, String] {
      match state_opt {
        Some(st) => {
          match st.drive_rpc_puts.get(sid) {
            Some(up) => {
              if chunk.length() == 0 {
                return Ok(())
              }
              let ws_drive = st.core.api.drive_for_workspace(up.workspace)
              match ws_drive.upload(
                up.root,
                up.rel,
                up.upload_id,
                up.cur_offset,
                up.total,
                chunk,
                up.replace,
                false,
                host_shim::wall_ms(),
              ) {
                Ok(res) => {
                  up.cur_offset = res.have
                  up.last_entry = res.entry
                  Ok(())
                }
                Err(de) => Err(de.message)
              }
            }
            None => match st.rig_put_streams.get(sid) {
              Some(put_ctx) => feed_streaming_put(put_ctx, chunk)
              None => Err("streaming upload state missing")
            }
          }
        }
        None => Err("whole runtime not initialized")
      }
    },
    on_stream_end: fn(
      ctx : DaemonCtx,
      sid : Int64,
      _remote_id : String,
      v2_bytes : Bool,
      is_front : Bool,
    ) -> Unit {
      match state_opt {
        Some(st) => {
          match st.drive_rpc_puts.get(sid) {
            Some(up) => {
              st.drive_rpc_puts.remove(sid)
              let entry_j = match up.last_entry {
                Some(e) => drive_entry_json_local(e)
                None => base_codec::json_null()
              }
              let res_j = base_codec::json_obj([
                ("have", base_codec::json_int64(up.cur_offset)),
                ("entry", entry_j),
              ])
              ctx.reply_peer_rpc(sid, station_mesh::encode_peer_answer_ok(res_j, false, v2_bytes), None, v2_bytes, is_front)
              return
            }
            None => ()
          }
          match st.rig_put_streams.get(sid) {
            Some(put_ctx) => {
              st.rig_put_streams.remove(sid)
              finalize_streaming_put_to_stream(ctx, st.core.remote, sid, put_ctx, v2_bytes, is_front)
            }
            None => ()
          }
        }
        None => ()
      }
    },
    on_stream_abort: fn(_ctx : DaemonCtx, sid : Int64) -> Unit {
      match state_opt {
        Some(st) => {
          st.drive_rpc_puts.remove(sid)
          st.rig_put_streams.remove(sid)
        }
        None => ()
      }
    },
    on_admin_conn_open: fn(_ctx : DaemonCtx, conn_id : Int64, remote_id : String, is_front : Bool) -> Unit {
      match state_opt {
        Some(st) => {
          let _ = st.serve.on_connection(mesh_accept::ConnMeta::{
            conn_id: conn_id,
            remote_id: remote_id,
            alpn: station_mesh::ALPN,
            via: if is_front { "front" } else { "direct" },
            accepted_ms: host_shim::wall_ms(),
          })
          st.admin_conns.set(
            conn_id,
            AdminConnState::{
              conn_id: conn_id,
              remote_id: remote_id,
              is_front: is_front,
              control_sid: None,
              iat: 0L,
              sid_claim: "",
              cred_role: "",
              effective_role: "",
              lock_base: None,
              lock_proof: None,
            },
          )
        }
        None => ()
      }
    },
    on_admin_conn_close: fn(_ctx : DaemonCtx, conn_id : Int64) -> Unit {
      match state_opt {
        Some(st) => {
          match st.admin_conns.get(conn_id) {
            Some(aconn) => {
              let _ = st.serve.close_connection(conn_id, aconn.remote_id)
              st.admin_conns.remove(conn_id)
            }
            None => ()
          }
        }
        None => ()
      }
    },
    on_peer_http_open: fn(
      ctx : DaemonCtx,
      sid : Int64,
      remote_id : String,
      alpn : String,
      is_front : Bool,
    ) -> Result[Unit, String] {
      match state_opt {
        Some(st) => {
          if alpn == station_mesh::ALPN {
            let conn_id = ctx.stream_conn_id(sid)
            let aconn = match st.admin_conns.get(conn_id) {
              Some(c) => c
              None => {
                let _ = st.serve.on_connection(mesh_accept::ConnMeta::{
                  conn_id: conn_id,
                  remote_id: remote_id,
                  alpn: station_mesh::ALPN,
                  via: if is_front { "front" } else { "direct" },
                  accepted_ms: host_shim::wall_ms(),
                })
                let fresh = AdminConnState::{
                  conn_id: conn_id,
                  remote_id: remote_id,
                  is_front: is_front,
                  control_sid: None,
                  iat: 0L,
                  sid_claim: "",
                  cred_role: "",
                  effective_role: "",
                  lock_base: None,
                  lock_proof: None,
                }
                st.admin_conns.set(conn_id, fresh)
                fresh
              }
            }
            match aconn.control_sid {
              None => {
                // Stream 1: member credential control stream.
                // Remains subject to generic idle sweep until authentication succeeds (`DoorPhase::Open`)!
                aconn.control_sid = Some(sid)
                st.admin_streams.set(
                  sid,
                  AdminStreamState::{
                    sid: sid,
                    conn_id: conn_id,
                    remote_id: remote_id,
                    is_front: is_front,
                    mode: AdminStreamMode::ControlStream,
                    rx_buf: Bytes::new(0),
                    last_sse_ping_ms: host_shim::now_ms(),
                  },
                )
                return Ok(())
              }
              Some(_) => {
                // Streams 2..N: member AdminApi request streams (guarded by real `MemberCheckHooks`).
                let now_w = host_shim::wall_ms()
                let now_s = (now_w / 1000L).to_double()
                let roster = build_cloud_roster(ctx.cloud, now_s, ctx.cloud.peers_current)
                let check_hooks = build_member_check_hooks(ctx, aconn, now_s)
                let acts = st.serve.accept_member_stream(conn_id, sid, roster, now_w, check_hooks)
                let mut rejected = false
                for ai in 0..<acts.length() {
                  match acts[ai] {
                    mesh_door::DoorAction::ResetStream(_, _) | mesh_door::DoorAction::CloseConn(_, _) => rejected = true
                    _ => ()
                  }
                }
                apply_door_actions(ctx, aconn, acts)
                if rejected {
                  return Err("member stream refused")
                }
                st.admin_streams.set(
                  sid,
                  AdminStreamState::{
                    sid: sid,
                    conn_id: conn_id,
                    remote_id: remote_id,
                    is_front: is_front,
                    mode: AdminStreamMode::ReadingHeadLine,
                    rx_buf: Bytes::new(0),
                    last_sse_ping_ms: host_shim::now_ms(),
                  },
                )
                return Ok(())
              }
            }
          }
          // `stillfail/http/1` (`PEER_HTTP_ALPN`): station-to-station local port forward.
          st.proxy_streams.set(
            sid,
            ProxyStreamState::{
              sid: sid,
              conn_id: ctx.stream_conn_id(sid),
              remote_id: remote_id,
              is_front: is_front,
              ws: None,
              mode: ProxyStreamMode::ReadingHeadLine,
              rx_buf: Bytes::new(0),
              local_sock: -1L,
              req_chunked: false,
              peer_ended: false,
              tcp_write_queue: [],
              tcp_write_queue_bytes: 0,
              tcp_write_in_flight: false,
              tcp_end_pending: false,
              tcp_read_paused: false,
              downstream_pending: [],
              downstream_pending_idx: 0,
              downstream_finish_after: false,
              mesh_read_paused: false,
            },
          )
          Ok(())
        }
        None => Err("whole runtime not initialized")
      }
    },
    on_peer_http_data: fn(ctx : DaemonCtx, sid : Int64, chunk : Bytes) -> Result[Unit, String] {
      match state_opt {
        Some(st) => {
          match st.admin_streams.get(sid) {
            Some(astream) => {
              match astream.mode {
                AdminStreamMode::Done
                | AdminStreamMode::SseStreaming(_)
                | AdminStreamMode::DriveDownloading(_)
                | AdminStreamMode::SessionFileDownloading(_)
                | AdminStreamMode::WaitingArchiveExtract(_)
                | AdminStreamMode::WaitingAsyncOp(_)
                | AdminStreamMode::WaitingLinkPreview(_)
                | AdminStreamMode::WaitingFeedbackReport(_)
                | AdminStreamMode::SendingBody(_) => {
                  return Ok(())
                }
                _ => {
                  astream.rx_buf = concat_bytes_local(astream.rx_buf, chunk)
                  return process_admin_stream_rx(ctx, st, astream)
                }
              }
            }
            None => ()
          }
          match st.proxy_streams.get(sid) {
            Some(pstream) => {
              match pstream.mode {
                ProxyStreamMode::Done => return Ok(())
                _ => {
                  pstream.rx_buf = concat_bytes_local(pstream.rx_buf, chunk)
                  return process_proxy_stream_rx(ctx, st, pstream)
                }
              }
            }
            None => Err("unknown full-duplex stream")
          }
        }
        None => Err("whole runtime not initialized")
      }
    },
    on_peer_http_end: fn(ctx : DaemonCtx, sid : Int64) -> Unit {
      match state_opt {
        Some(st) => {
          match st.admin_streams.get(sid) {
            Some(astream) => {
              match astream.mode {
                AdminStreamMode::ReadingHeadLine => {
                  if astream.rx_buf.length() > 0 {
                    send_admin_resp_and_finish(ctx, sid, station_api::json_error(400, "incomplete request head"))
                  } else {
                    ctx.finish_peer_http(sid)
                  }
                  astream.rx_buf = Bytes::new(0)
                  astream.mode = AdminStreamMode::Done
                }
                AdminStreamMode::ReadingBody(req_head, acc) => {
                  let body = concat_bytes_local(acc, astream.rx_buf)
                  astream.rx_buf = Bytes::new(0)
                  match req_head.expected_cl {
                    Some(exp) => {
                      if body.length().to_int64() != exp {
                        send_admin_resp_and_finish(ctx, sid, station_api::json_error(400, "content-length mismatch"))
                        astream.mode = AdminStreamMode::Done
                        return
                      }
                    }
                    None => ()
                  }
                  dispatch_admin_request(ctx, st, astream, req_head, body)
                }
                AdminStreamMode::StreamingDriveUpload(up) => {
                  if astream.rx_buf.length() > 0 {
                    let rem = astream.rx_buf
                    astream.rx_buf = Bytes::new(0)
                    feed_drive_upload_chunk(st, up, rem)
                  }
                  finish_admin_drive_upload(ctx, st, astream, up)
                }
                _ => ()
              }
              return
            }
            None => ()
          }
          match st.proxy_streams.get(sid) {
            Some(pstream) => {
              pstream.peer_ended = true
              match pstream.mode {
                ProxyStreamMode::ReadingHeadLine => {
                  if pstream.rx_buf.length() > 0 {
                    send_proxy_refusal_and_finish(ctx, sid, 400, "incomplete head line")
                  } else {
                    ctx.finish_peer_http(sid)
                  }
                  pstream.rx_buf = Bytes::new(0)
                  pstream.mode = ProxyStreamMode::Done
                }
                ProxyStreamMode::ResolvingHost(ev_id, host, port, is_probe, carry, _) => {
                  pstream.mode = ProxyStreamMode::ResolvingHost(ev_id, host, port, is_probe, carry, true)
                }
                ProxyStreamMode::OpeningTcp(port, carry, _) => {
                  pstream.mode = ProxyStreamMode::OpeningTcp(port, carry, true)
                }
                ProxyStreamMode::OpeningHttp(port, method, path, headers, has_body, carry, _) => {
                  pstream.mode = ProxyStreamMode::OpeningHttp(port, method, path, headers, has_body, carry, true)
                }
                ProxyStreamMode::Tunneling(_) => {
                  enqueue_proxy_tcp_end(ctx, pstream)
                }
                ProxyStreamMode::ProxyHttpReadingHead(_, _, _)
                | ProxyStreamMode::ProxyHttpRawBody(_, _, _, _)
                | ProxyStreamMode::ProxyHttpChunkedBody(_, _, _) => {
                  if pstream.req_chunked {
                    enqueue_proxy_tcp_write(ctx, st, pstream, "0\r\n\r\n".to_bytes())
                  }
                }
                ProxyStreamMode::WsForwarding(_, _, _) => {
                  let close_b = websocket::encode_message(websocket::Message::Close(None), Some(ws_random_mask()))
                  enqueue_proxy_tcp_write(ctx, st, pstream, close_b)
                  enqueue_proxy_tcp_end(ctx, pstream)
                }
                ProxyStreamMode::OpeningWsTcp(_, _, _, _)
                | ProxyStreamMode::WsHandshaking(_, _, _, _)
                | ProxyStreamMode::Done => ()
              }
            }
            None => ()
          }
        }
        None => ()
      }
    },
    on_peer_http_close: fn(ctx : DaemonCtx, sid : Int64) -> Unit {
      match state_opt {
        Some(st) => {
          match st.admin_streams.get(sid) {
            Some(astream) => {
              let is_ctrl = match astream.mode {
                AdminStreamMode::ControlStream => true
                AdminStreamMode::SseStreaming(cid) => {
                  let _ = st.core.api.events.disconnect(cid)
                  false
                }
                AdminStreamMode::SessionFileDownloading(dl) => {
                  if dl.unlink_on_done {
                    let _ = (st.core.agents.jobs.fs.remove_file)(dl.path)
                  }
                  false
                }
                AdminStreamMode::WaitingArchiveExtract(spec) => {
                  let _ = (st.core.agents.jobs.fs.remove_file)(spec.out_path)
                  false
                }
                AdminStreamMode::WaitingAsyncOp(async_st) => {
                  cancel_async_admin_op(ctx, st, async_st)
                  false
                }
                AdminStreamMode::WaitingLinkPreview(lp) => {
                  if lp.dns_ev_id > 0L {
                    st.dns_streams.remove(lp.dns_ev_id)
                  }
                  if lp.call_id > 0L {
                    ctx.mux_role.cancel(lp.call_id)
                  }
                  if lp.stream_id > 0 {
                    let _ = ctx.edge_hub.call_async_discard(
                      "stream.close",
                      "{\"id\":" + lp.stream_id.to_string() + "}",
                      None,
                    )
                  }
                  false
                }
                AdminStreamMode::WaitingFeedbackReport(fb_cid) => {
                  if fb_cid > 0L {
                    ctx.mux_role.cancel(fb_cid)
                  }
                  false
                }
                _ => false
              }
              if !is_ctrl {
                match st.serve.door_of(astream.conn_id) {
                  Some(door) => door.finish_request_stream(sid)
                  None => ()
                }
              }
              st.admin_streams.remove(sid)
            }
            None => ()
          }
          match st.proxy_streams.get(sid) {
            Some(pstream) => {
              close_proxy_local_resources(ctx, st, pstream)
              st.proxy_streams.remove(sid)
            }
            None => ()
          }
        }
        None => ()
      }
    },
    on_peer_http_writable: fn(ctx : DaemonCtx, sid : Int64) -> Unit {
      match state_opt {
        Some(st) => {
          match st.admin_streams.get(sid) {
            Some(astream) => {
              match astream.mode {
                AdminStreamMode::DriveDownloading(dl) => {
                  pump_drive_download_chunk(ctx, st, astream, dl)
                }
                AdminStreamMode::SessionFileDownloading(dl) => {
                  pump_session_file_download_chunk(ctx, st, astream, dl)
                }
                AdminStreamMode::SendingBody(bs) => {
                  pump_admin_body_chunk(ctx, astream, bs)
                }
                _ => ()
              }
            }
            None => ()
          }
          match st.proxy_streams.get(sid) {
            Some(pstream) => {
              pump_proxy_downstream(ctx, st, pstream)
            }
            None => ()
          }
        }
        None => ()
      }
    },
    on_outbound_reply: fn(_ctx : DaemonCtx, _method : String, _ref_id : String, _until_opt : Option[Int64]) -> Unit {},
    on_sys_event: fn(ctx : DaemonCtx, ev_id : Int64, sev : station_sys::SysEvent) -> Unit {
      match state_opt {
        Some(st) => {
          if route_whole_config_fs_event(st.core, ev_id, sev) {
            return
          }
          match sev {
            station_sys::SysEvent::DnsResolved(rc, ip) => {
              match st.dns_streams.get(ev_id) {
                Some(sid) => {
                  st.dns_streams.remove(ev_id)
                  match st.admin_streams.get(sid) {
                    Some(astream) => match astream.mode {
                      AdminStreamMode::WaitingLinkPreview(lp) => {
                        if lp.dns_ev_id == ev_id {
                          lp.dns_ev_id = 0L
                          let rem = lp.deadline_ms - host_shim::now_ms()
                          // Verify ALL resolved A/AAAA IPs are strictly public (blocks multi-A private IP & DNS rebinding).
                          let mut verified_ip = ""
                          let mut all_public = rc == 1 && rem > 0L && ip.length() > 0
                          if all_public {
                            let parts = ip.split("\n")
                            if parts.length() == 0 {
                              all_public = false
                            } else {
                              for pi in 0..<parts.length() {
                                let cand = parts[pi].trim()
                                if cand.length() == 0 || !station_whole::is_public_link_preview_ip(cand) {
                                  all_public = false
                                  break
                                }
                                if verified_ip.length() == 0 {
                                  verified_ip = cand
                                }
                              }
                            }
                          }
                          if !all_public || verified_ip.length() == 0 {
                            send_admin_resp_and_finish(ctx, sid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                            astream.mode = AdminStreamMode::Done
                          } else {
                            let tmo = if rem < 6000L { rem.to_int() } else { 6000 }
                            let lp_hdrs : Array[(String, String)] = [
                              ("user-agent", "stillfail-station (link preview)"),
                              ("accept", "text/html,application/xhtml+xml"),
                              ("accept-encoding", "identity"),
                            ]
                            let open_args = base_codec::json_obj([
                              ("url", base_codec::json_str(lp.url)),
                              ("method", base_codec::json_str("GET")),
                              ("redirect", base_codec::json_str("manual")),
                              ("headers", wd_encode_header_pairs(lp_hdrs)),
                              (
                                "entry",
                                base_codec::json_obj([
                                  ("host", base_codec::json_str(verified_ip)),
                                  ("port", base_codec::json_int(lp.target_port)),
                                ]),
                              ),
                              ("timeoutMs", base_codec::json_int(tmo)),
                            ])
                            lp.call_id = ctx.mux_role.call_async_raw(
                              builders_core::MuxToken::Tagged(0, LINK_PREVIEW_TOK_OPEN, sid),
                              "stream.open",
                              base_codec::json_stringify(open_args),
                              None,
                            )
                          }
                          return
                        }
                      }
                      _ => ()
                    }
                    None => ()
                  }
                  match st.proxy_streams.get(sid) {
                    Some(pstream) => match pstream.mode {
                      ProxyStreamMode::ResolvingHost(cur_ev, host, port, is_probe, carry, peer_ended) => {
                        if cur_ev == ev_id {
                          if rc == -2 {
                            send_proxy_refusal_and_finish(ctx, sid, 403, "that machine refused: device target port is the station's own")
                            pstream.mode = ProxyStreamMode::Done
                          } else if rc != 1 || ip.length() == 0 {
                            send_proxy_refusal_and_finish(ctx, sid, 502, "the device could not be reached there: failed to resolve " + host)
                            pstream.mode = ProxyStreamMode::Done
                          } else if is_probe {
                            ctx.write_peer_http_chunk(sid, encode_proxy_head_line(200, []))
                            ctx.finish_peer_http(sid)
                            pstream.mode = ProxyStreamMode::Done
                          } else {
                            pstream.mode = ProxyStreamMode::OpeningTcp(port, carry, peer_ended)
                            let dial_args = base_codec::json_obj([
                              ("host", base_codec::json_str(ip)),
                              ("port", base_codec::json_int(port)),
                              ("timeoutMs", base_codec::json_int(5000)),
                            ])
                            let _ = ctx.mux_role.call_async_raw(
                              builders_core::MuxToken::Tagged(0, PROXY_TOK_TCP_OPEN, sid),
                              "tcp.dial",
                              base_codec::json_stringify(dial_args),
                              None,
                            )
                          }
                        }
                      }
                      _ => ()
                    }
                    None => ()
                  }
                  return
                }
                None => ()
              }
            }
            _ => ()
          }
          let now_sys = host_shim::now_ms()
          if st.devices.handle_sys_event(ev_id, sev, now_sys) {
            return
          }
          if st.upkeep.handle_sys_event(ev_id, sev) {
            return
          }
          if st.terminals.handle_sys_event(ev_id, sev, now_sys) {
            return
          }
          if st.logins.handle_sys_event(ev_id, sev, now_sys) {
            return
          }
          if st.browser.handle_sys_event(ev_id, sev) {
            return
          }
          if st.live_runners.handle_sys_event(ctx, st.core, ev_id, sev, now_sys, host_shim::wall_ms()) {
            return
          }
          let _ = st.core.agents.jobs.handle_sys_event(ev_id, sev, host_shim::wall_ms())
        }
        None => ()
      }
    },
    on_extra_host_event: fn(ctx : DaemonCtx, ev : DaemonExtraEvent) -> Unit {
      match state_opt {
        Some(st) => {
          match ev {
            DaemonExtraEvent::SysEvent(_, _) => ()
            DaemonExtraEvent::DoorDone(tok, d) => {
              let _ = st.mcp_srv.handle_done(tok, d, st.mcp_cb)
            }
            DaemonExtraEvent::RoleDone(tok, d) => {
              handle_proxy_role_done(ctx, st, tok, d)
            }
          }
        }
        None => ()
      }
    },
    on_loop_step: fn(ctx : DaemonCtx, _now : Int64, _wall : Int64) -> Unit {
      match state_opt {
        Some(st) => {
          if !st.mcp_announced && st.mcp_srv.is_listening() {
            st.mcp_announced = true
            let mport = st.mcp_srv.port()
            st.core.agents.config.mcp_port = mport
            st.core.agents.jobs.notify_url = "http://127.0.0.1:" + mport.to_string() + "/job-notify"
            ctx.announce_mcp_port(mport)
            ctx.log("mcp server listening on 127.0.0.1:" + mport.to_string())
          }
          let _ = st.mcp_srv.tick(st.mcp_cb)
          st.live_runners.pump(ctx, st.core, live_config_raw(st.core, ctx.cfg_raw), _now, _wall)
        }
        None => ()
      }
    },
    on_tick: fn(ctx : DaemonCtx, now : Int64, wall : Int64) -> Unit {
      match state_opt {
        Some(st) => {
          st.core.on_tick(wall)
          if st.core.store.is_primary_open() {
            let _ = station_whole::drain_card_outbox_once(st.core.store, Some(st.core.api.events), wall)
          }
          let mut clones_active = false
          let active_jobs = st.core.agents.jobs.list()
          for ji in 0..<active_jobs.length() {
            if active_jobs[ji].state == station_jobs::JobState::Running {
              clones_active = true
              break
            }
          }
          st.upkeep.tick(now, clones_active)
          // Enforce hard monotonic deadlines on all in-flight `WaitingAsyncOp` and `WaitingLinkPreview` streams.
          let async_sids = st.admin_streams.keys()
          for asi in 0..<async_sids.length() {
            let asid = async_sids[asi]
            match st.admin_streams.get(asid) {
              Some(astream) => match astream.mode {
                AdminStreamMode::WaitingAsyncOp(async_st) => {
                  if now >= async_st.deadline_ms {
                    cancel_async_admin_op(ctx, st, async_st)
                    astream.mode = AdminStreamMode::Done
                    send_admin_resp_and_finish(ctx, asid, station_api::json_error(504, "request timed out"))
                  }
                }
                AdminStreamMode::WaitingLinkPreview(lp) if now >= lp.deadline_ms => {
                  if lp.dns_ev_id > 0L {
                    st.dns_streams.remove(lp.dns_ev_id)
                    lp.dns_ev_id = 0L
                  }
                  if lp.call_id > 0L {
                    let _ = ctx.mux_role.cancel(lp.call_id)
                    lp.call_id = 0L
                  }
                  if lp.stream_id > 0 {
                    let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + lp.stream_id.to_string() + "}", None)
                    lp.stream_id = 0
                  }
                  send_admin_resp_and_finish(ctx, asid, station_http::HttpResponse::json(200, "{\"kind\":\"none\"}"))
                  astream.mode = AdminStreamMode::Done
                }
                _ => ()
              }
              None => ()
            }
          }
          st.live_runners.tick(ctx, st.core, now, wall)
          st.live_runners.pump(ctx, st.core, live_config_raw(st.core, ctx.cfg_raw), now, wall)
          let _ = st.core.agents.jobs.poll_followed(wall)
          let _ = st.core.remote.drain_queue(wall)
          let _ = st.devices.tick_expiry(now, wall)
          let _ = st.devices.adb_runner.tick(now)
          let _ = st.terminals.tick(now)
          let _ = st.logins.tick(now)
          let _ = st.browser.tick(now)
          let _ = st.dsb.tick(st.core.store, st.core.agents, st.core.api.events, st.core.api.hooks, wall)
          let _ = st.connects.tick(now)
          // `#8886`: poll `PeerChangeNotifier` and `CommaUnreadRetry` due retries.
          let comma_due = st.connects.comma_poll_unread_due(wall)
          for ci in 0..<comma_due.length() {
            let _ = st.connects.comma_on_build_result(comma_due[ci], 0, false, wall)
          }
          let peer_targets : Array[String] = []
          let rc_keys = st.remote_connects.keys()
          for rki in 0..<rc_keys.length() {
            match st.remote_connects.get(rc_keys[rki]) {
              Some(rec) => {
                if rec.station != ctx.station_key.id {
                  peer_targets.push(rec.station)
                }
              }
              None => ()
            }
          }
          let notify_dispatches = st.comma_notifier.poll_due(wall, peer_targets)
          for npi in 0..<notify_dispatches.length() {
            let disp = notify_dispatches[npi]
            let targets = match disp.targets {
              Some(ts) => ts
              None => peer_targets
            }
            for ti in 0..<targets.length() {
              let p_id = targets[ti]
              let ch_req = base_codec::json_obj([
                ("method", base_codec::json_str(station_connects::COMMA_PEER_CHANGED)),
                ("workspace", base_codec::json_str(disp.workspace)),
              ])
              ctx.enqueue_tell(p_id, disp.workspace, ch_req)
            }
          }
          // Sync runtime `auth.test` `team_id` into `connect_meta` if populated after reconnect.
          let cm_keys = st.connect_meta.keys()
          for cmi in 0..<cm_keys.length() {
            let cid = cm_keys[cmi]
            match st.connects.slack_team_id(cid) {
              Some(rt_tid) => {
                let want = "slack:" + rt_tid
                match st.connect_meta.get(cid) {
                  Some(m) => {
                    if m.config_surface != want {
                      st.connect_meta.set(
                        cid,
                        ConnectMeta::{
                          ws: m.ws,
                          config_surface: want,
                          single: m.single,
                          require_mention: m.require_mention,
                          runtime: m.runtime,
                          profile: m.profile,
                          cwd: m.cwd,
                        },
                      )
                    }
                  }
                  None => ()
                }
              }
              None => ()
            }
          }
          let _ = ctx.edge_hub.drain_deferred_done(fn(tok : builders_core::MuxToken, d : host_shim::ShellDone) -> Bool {
            st.connects.handle_mux_reply(tok, d)
          })

          // Poll member connection deadlines (`REFUSED_CLOSE_MS`, expiry, revocation, lock check).
          let now_s = (wall / 1000L).to_double()
          let roster = build_cloud_roster(ctx.cloud, now_s, ctx.cloud.peers_current)
          let ac_keys = st.admin_conns.keys()
          for aci in 0..<ac_keys.length() {
            let cid = ac_keys[aci]
            match st.admin_conns.get(cid) {
              Some(aconn) => {
                let check_hooks = build_member_check_hooks(ctx, aconn, now_s)
                let acts = st.serve.poll_member_deadlines(cid, roster, wall, check_hooks)
                if acts.length() > 0 {
                  apply_door_actions(ctx, aconn, acts)
                }
              }
              None => ()
            }
          }

          // Push live `EventsHub` broadcasts and periodic SSE keepalives to open `stillfail/admin/1` SSE streams.
          let as_keys = st.admin_streams.keys()
          for asi in 0..<as_keys.length() {
            let sid = as_keys[asi]
            match st.admin_streams.get(sid) {
              Some(astream) => {
                match astream.mode {
                  AdminStreamMode::SseStreaming(cid) => {
                    match st.core.api.events.get_client(cid) {
                      Some(client) => {
                        let frames = client.drain_outbox()
                        if frames.length() > 0 {
                          for fi in 0..<frames.length() {
                            ctx.write_peer_http_chunk(sid, frames[fi].to_bytes())
                          }
                          astream.last_sse_ping_ms = now
                        } else if now - astream.last_sse_ping_ms >= 15000L {
                          astream.last_sse_ping_ms = now
                          ctx.write_peer_http_chunk(sid, ": ping\n\n".to_bytes())
                        }
                      }
                      None => ()
                    }
                  }
                  _ => ()
                }
              }
              None => ()
            }
          }

          if now >= st.next_upkeep_ms {
            let _ = st.core.agents.jobs.upkeep(wall)
            let _ = st.core.remote.sweep(wall, low_disk=false, disk_total=None)
            // timer: periodic jobs and remote upkeep (10m)
            st.next_upkeep_ms = now + WHOLE_UPKEEP_EVERY_MS
          }
        }
        None => ()
      }
    },
    on_cloud_changed: fn(ctx : DaemonCtx, w_s : Int64, w_ms : Int64, connected : Bool) -> Unit {
      match state_opt {
        Some(st) => {
          // Immediately re-check every live `stillfail/admin/1` connection on cloud state/revocation/lock update!
          let now_s = w_s.to_double()
          let roster = build_cloud_roster(ctx.cloud, now_s, ctx.cloud.peers_current)
          let ac_keys = st.admin_conns.keys()
          for aci in 0..<ac_keys.length() {
            let cid = ac_keys[aci]
            match st.admin_conns.get(cid) {
              Some(aconn) => {
                match st.serve.member_of(cid) {
                  Some(sess) => {
                    let check_hooks = build_member_check_hooks(ctx, aconn, now_s)
                    match station_mesh::check_member_gone(roster, sess, aconn.remote_id, w_ms, check_hooks) {
                      mesh_door::StreamGuardVerdict::Allow => ()
                      mesh_door::StreamGuardVerdict::Close(code, reason) => {
                        ctx.log("kicking live admin connection " + cid.to_string() + ": " + reason)
                        revoke_seen_member_session(st.seen_members, sess.workspace, sess.user_sub, seen_member_session_key(aconn.sid_claim, cid))
                        ctx.close_mesh_conn(cid, aconn.is_front, code, reason)
                        let _ = st.serve.close_connection(cid, aconn.remote_id)
                        st.admin_conns.remove(cid)
                      }
                    }
                  }
                  None => ()
                }
              }
              None => ()
            }
          }
          // Immediately re-check every live `stillfail/http/1` peer-http / `device:` tunnel on fresh cloud roster
          // OR explicit station removal (`CLOSE_REMOVED`), while preserving active tunnels during pure cloud outages!
          let station_removed = ctx.cloud.removed()
          if ctx.cloud.peers_current || station_removed {
            let ps_keys = st.proxy_streams.keys()
            for psi in 0..<ps_keys.length() {
              let sid = ps_keys[psi]
              match st.proxy_streams.get(sid) {
                Some(pstream) => {
                  let mut kick : Option[(Int, String)] = if station_removed {
                    Some((3, "removed from workspace"))
                  } else {
                    station_mesh::check_peer_http_roster_change(roster, pstream.remote_id)
                  }
                  if kick is None {
                    match pstream.ws {
                      Some(ws) => {
                        if station_mesh::member(roster, pstream.remote_id, Some(ws)) is Err(_) {
                          kick = Some((3, "not in the workspace"))
                        } else if ctx.cloud.rig_in(ws) is Some(_) {
                          kick = Some((3, "rig device requires owner approval"))
                        }
                      }
                      None => ()
                    }
                  }
                  match kick {
                    Some((code, reason)) => {
                      ctx.log(
                        "kicking live peer-http stream " + sid.to_string()
                        + " (conn=" + pstream.conn_id.to_string() + "): " + reason,
                      )
                      close_proxy_local_resources(ctx, st, pstream)
                      pstream.mode = ProxyStreamMode::Done
                      ctx.close_peer_http(sid)
                      st.proxy_streams.remove(sid)
                      ctx.close_mesh_conn(pstream.conn_id, pstream.is_front, code, reason)
                    }
                    None => ()
                  }
                }
                None => ()
              }
            }
          }
          if !connected {
            return
          }
          if ctx.cloud.is_rig_only(now_s) && !st.becoming_rig {
            st.becoming_rig = true
            ctx.log("station became rig-only: triggering handover to rig process")
            match station_ops::find_restarter(ctx.ops_fs, ctx.data, station_ops::is_pid_alive, sep=ctx.sep) {
              Some(target) => {
                let _ = station_sys::proc_kill(target.pid, station_sys::SIG_USR2, false)
              }
              None => ctx.request_stop()
            }
          }
        }
        None => ()
      }
    },
    on_carried: fn(ctx : DaemonCtx, carried : base_codec::Json) -> Unit {
      match state_opt {
        Some(st) => {
          match base_codec::json_get(carried, "vault") {
            Some(vj) => st.core.store.import_vault_carried_json(vj, host_shim::wall_ms() / 1000L)
            None => ()
          }
          match base_codec::json_get(carried, "liveRunnerHandover") {
            Some(lr_j) => {
              let lr_ho_path = nodepath::join(ctx.sep, [ctx.run_dir, WHOLE_LIVE_RUNNERS_HANDOVER_FILE])
              st.live_runners.set_handover_state_path(lr_ho_path)
              st.live_runners.import_handover_state_json(lr_j)
              let _ = st.live_runners.sync_handover_state_file(ctx.ops_fs, ctx.self_pid, ctx.sep, log_fn=fn(m) { ctx.log(m) })
            }
            None => ()
          }
          match base_codec::json_get(carried, "handoverFailed") {
            Some(base_codec::Json::Str(msg)) => {
              if msg.length() > 0 {
                let full_msg = "handover snapshot failed on predecessor: " + msg
                ctx.log(full_msg)
                st.carried_handover_failed = Some(msg)
                // Fail immediately on `Slot::Current` BEFORE predecessor exits & `taken` is set
                // so Rust launcher `lifecycle.rs:684` triggers `take_failed` and writes `handoff-failed`!
                ctx.fail_and_stop(full_msg)
              }
            }
            _ => ()
          }
        }
        None => ()
      }
    },
    on_handover_start: fn(ctx : DaemonCtx) -> Result[Unit, String] {
      match state_opt {
        Some(st) => {
          if st.handover_exported || !st.core.store.is_primary_open() {
            return Ok(())
          }
          let ho_wall_ms = host_shim::wall_ms()
          // R11 P1-1: Freeze `pre_delivery` prompts immediately, best-effort commit all pending
          // end-turns/draining entries, and hand over any uncommitted entries + in-flight
          // `draining_stopping_ids` to the successor via `carry` + private handover file.
          st.live_runners.prepare_handover(ctx, st.core, ho_wall_ms)
          match st.core.export_handover(ho_wall_ms) {
            Ok(snap) => {
              let ho_path = nodepath::join(ctx.sep, [ctx.run_dir, WHOLE_HANDOVER_FILE])
              let body = base_codec::json_stringify(snap.to_json())
              match station_ops::write_private(ctx.ops_fs, ho_path, body.to_bytes(), ctx.self_pid, 1, sep=ctx.sep) {
                Ok(_) => {
                  if st.core.store.vault_boxes.keys().length() > 0 ||
                  st.core.store.vault_grants.len() > 0 ||
                  st.core.store.vault_unsaved.keys().length() > 0 {
                    let vj = st.core.store.export_vault_carried_json()
                    ctx.carry(base_codec::json_obj([("vault", vj)]))
                  }
                  if st.live_runners.has_handover_carry_state() {
                    let lr_j = st.live_runners.export_handover_state_json()
                    ctx.carry(base_codec::json_obj([("liveRunnerHandover", lr_j)]))
                    let lr_ho_path = nodepath::join(ctx.sep, [ctx.run_dir, WHOLE_LIVE_RUNNERS_HANDOVER_FILE])
                    st.live_runners.set_handover_state_path(lr_ho_path)
                    match st.live_runners.sync_handover_state_file(ctx.ops_fs, ctx.self_pid, ctx.sep, log_fn=fn(m) { ctx.log(m) }) {
                      Ok(_) => ()
                      Err(e) => return Err(e)
                    }
                  }
                  st.connects.stop()
                  if st.replica.kept_log.entries.length() > 0 {
                    let _ = st.replica.persist_kept_log()
                  }
                  st.handover_exported = true
                  st.core.agents.close_adopted_db()
                  Ok(())
                }
                Err(_) => {
                  let msg = "failed to write whole handover snapshot to " + ho_path
                  ctx.log(msg)
                  Err(msg)
                }
              }
            }
            Err(e) => {
              let msg = "failed to export whole handover snapshot: " + e
              ctx.log(msg)
              Err(msg)
            }
          }
        }
        None => Ok(())
      }
    },
    on_shutdown: fn(ctx : DaemonCtx) -> Unit {
      match state_opt {
        Some(st) => {
          let as_keys = st.admin_streams.keys()
          for ai in 0..<as_keys.length() {
            let sid = as_keys[ai]
            match st.admin_streams.get(sid) {
              Some(astream) => {
                match astream.mode {
                  AdminStreamMode::SseStreaming(cid) => {
                    let _ = st.core.api.events.disconnect(cid)
                  }
                  AdminStreamMode::WaitingAsyncOp(async_st) => {
                    // Cancel/close any open async stream BEFORE removing from `admin_streams`!
                    cancel_async_admin_op(ctx, st, async_st)
                  }
                  _ => ()
                }
              }
              None => ()
            }
            ctx.close_peer_http(sid)
            st.admin_streams.remove(sid)
          }
          let ps_keys = st.proxy_streams.keys()
          for pi in 0..<ps_keys.length() {
            let sid = ps_keys[pi]
            match st.proxy_streams.get(sid) {
              Some(pstream) => close_proxy_local_resources(ctx, st, pstream)
              None => ()
            }
            ctx.close_peer_http(sid)
            st.proxy_streams.remove(sid)
          }
          let ar_keys = st.adopted_runners.keys()
          for ari in 0..<ar_keys.length() {
            let rcid = ar_keys[ari]
            match st.adopted_runners.get(rcid) {
              Some(rconn) => {
                if rconn.sock_id >= 0L {
                  let usid = rconn.sock_id
                  rconn.sock_id = -1L
                  st.adopted_runner_by_sock.remove(usid)
                  let _ = ctx.mux_role.call_async_raw(
                    builders_core::MuxToken::Tagged(rcid, RUNNER_TOK_UNIX_WRITE, usid),
                    "tcp.write",
                    base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(usid))])),
                    Some("{\"op\":\"leave\"}\n".to_bytes()),
                  )
                  let _ = ctx.mux_role.call_async_raw(
                    builders_core::MuxToken::Tagged(rcid, RUNNER_TOK_UNIX_CLOSE, usid),
                    "tcp.close",
                    base_codec::json_stringify(base_codec::json_obj([("id", base_codec::json_int64(usid))])),
                    None,
                  )
                }
              }
              None => ()
            }
          }
          st.adopted_runners.clear()
          st.adopted_runner_by_sock.clear()
          st.admin_conns.clear()
          st.drive_rpc_puts.clear()
          st.rig_put_streams.clear()
          st.mcp_srv.close_with_callbacks(st.mcp_cb)

          // Cleanly stop all 4 Wave 16C edge OS adapters with zero orphan processes / leaked FDs.
          st.connects.stop()
          st.upkeep.shutdown()
          st.dsb.shutdown()
          st.browser.stop_all()
          let _ = st.browser.drain_kills_with_hub(max_ms=500L)
          st.terminals.stop_all()
          let _ = st.terminals.drain_kills_with_hub(ctx.edge_hub, max_ms=500L)
          st.logins.stop_all(host_shim::now_ms())
          let _ = st.logins.drain_kills_with_hub(ctx.edge_hub, max_ms=500L)
          let _ = st.devices.drain_kills_with_hub(ctx.edge_hub, max_ms=500L)
          if st.replica.kept_log.entries.length() > 0 {
            let _ = st.replica.persist_kept_log()
          }

          // On `SIGUSR2` hot handover: detach job & live runner handles WITHOUT killing running
          // processes so the new daemon adopts them seamlessly. On full shutdown: stop them cleanly.
          if ctx.is_handover_shutdown() {
            st.live_runners.detach_all_for_handover(ctx, st.core, host_shim::wall_ms())
            st.core.agents.jobs.detach_all_for_handover()
          } else {
            let runner_stop_ok = st.live_runners.stop_all_on_shutdown(ctx, st.core, host_shim::wall_ms())
            if !runner_stop_ok {
              ctx.log("[whole-daemon] ERROR: full shutdown failed to confirm stop/persistence of all spawning runners")
              shutdown_exit_code = 1
            }
            let jobs_list = st.core.agents.jobs.list()
            let w_end = host_shim::wall_ms()
            for ji in 0..<jobs_list.length() {
              if station_jobs::job_state_is_up(jobs_list[ji].state) {
                let _ = st.core.agents.jobs.stop(jobs_list[ji].id, w_end)
              }
            }
            let _ = st.core.agents.jobs.poll_followed(w_end)
            let _ = st.core.agents.jobs.tick_stops(w_end)
          }
          match st.core.config_file {
            Some(cfg_file) => cfg_file.unwatch()
            None => ()
          }
          st.core.shutdown()
        }
        None => ()
      }
    },
    heap_objects_count: fn() -> Int64 {
      match state_opt {
        Some(st) => (st.core.active_object_count() + st.admin_streams.length() + st.proxy_streams.length()).to_int64()
        None => 0L
      }
    },
  }

  let rc = run_daemon(argv, hooks)
  if rc != 0 { rc } else { shutdown_exit_code }
}

fn test_wd_assert(cond : Bool, msg : String = "assertion failed") -> Unit {
  if !cond {
    panic(msg)
  }
}

fn test_wd_b64url(b : Bytes) -> String {
  let std = base64::encode(b)
  let sb = StringBuilder::new()
  for i in 0..<std.length() {
    let ch = std.code_unit_at(i)
    if ch == 43 {
      sb.write_byte(45 as Byte)
    } else if ch == 47 {
      sb.write_byte(95 as Byte)
    } else if ch != 61 {
      sb.write_byte(ch as Byte)
    }
  }
  sb.to_string()
}

fn test_wd_sign_entry(seed : Bytes, pub_hex : String, fields : Array[(String, form::Json)]) -> form::Json {
  let key_id = "ed25519:" + pub_hex
  let with_empty_sig : Array[(String, form::Json)] = []
  for i in 0..<fields.length() {
    with_empty_sig.push(fields[i])
  }
  with_empty_sig.push(("sig", form::Json::Obj([
    ("key", form::Json::Str(key_id)),
    ("alg", form::Json::Str("Ed25519")),
    ("sig", form::Json::Str("")),
  ])))
  let h = match station_rules_bridge::entry_hash(form::Json::Obj(with_empty_sig)) {
    Ok(v) => v
    Err(_) => panic("entry_hash failed")
  }
  let msg = match station_rules_bridge::signed_bytes(h) {
    Some(b) => b
    None => panic("signed_bytes failed")
  }
  let sig = match crypto::ed25519_sign(seed, msg) {
    Ok(b) => base_codec::hex_encode(b)
    Err(_) => panic("ed25519_sign failed")
  }
  let out : Array[(String, form::Json)] = []
  for i in 0..<fields.length() {
    out.push(fields[i])
  }
  out.push(("sig", form::Json::Obj([
    ("key", form::Json::Str(key_id)),
    ("alg", form::Json::Str("Ed25519")),
    ("sig", form::Json::Str(sig)),
  ])))
  form::Json::Obj(out)
}

fn test_wd_entry_hash(entry : form::Json) -> String {
  match station_rules_bridge::entry_hash(entry) {
    Ok(h) => h
    Err(_) => panic("entry_hash failed")
  }
}

fn test_wd_make_jwt(seed : Bytes, kid : String, claims : Array[(String, base_codec::Json)]) -> String {
  let head = base_codec::json_stringify(base_codec::json_obj([
    ("alg", base_codec::json_str("EdDSA")),
    ("typ", base_codec::json_str("stillfail-member+jwt")),
    ("kid", base_codec::json_str(kid)),
  ]))
  let body = base_codec::json_stringify(base_codec::json_obj(claims))
  let h_b64 = test_wd_b64url(head.to_bytes())
  let b_b64 = test_wd_b64url(body.to_bytes())
  let input = (h_b64 + "." + b_b64).to_bytes()
  let sig = match crypto::ed25519_sign(seed, input) {
    Ok(b) => test_wd_b64url(b)
    Err(_) => panic("jwt sign failed")
  }
  h_b64 + "." + b_b64 + "." + sig
}

fn test_wd_endpoint_proof(seed : Bytes, ws : String, _base_hex : String, endpoint : String) -> String {
  let msg = station_rules_bridge::endpoint_bytes(ws, endpoint)
  match crypto::ed25519_sign(seed, msg) {
    Ok(b) => base_codec::hex_encode(b)
    Err(_) => panic("endpoint proof sign failed")
  }
}

fn test_wd_seed(b : Int) -> (Bytes, String, String) {
  let seed = Bytes::new(32)
  for i in 0..<32 {
    seed[i] = ((b + i) & 0xFF) as Byte
  }
  let pk = match crypto::ed25519_public_key(seed) {
    Ok(p) => p
    Err(_) => panic("pk")
  }
  let hex = base_codec::hex_encode(pk)
  let b64 = test_wd_b64url(pk)
  (seed, hex, b64)
}

test "P1-A & P2-A: non-head ws commit recovery rejects rotated key and renewal preserves endpoint proof" {
  let ws = "ws_wd_r3"
  let now_s = 1700000100.0
  let (owner_seed, owner_pub, _) = test_wd_seed(11)
  let (old_k_seed, _, old_k_b64) = test_wd_seed(22)
  let (new_k_seed, _, new_k_b64) = test_wd_seed(33)
  let (_, extra_dev_pub, _) = test_wd_seed(44)
  let (_, endpoint_id, _) = test_wd_seed(55)
  let owner_kid = "ed25519:" + owner_pub

  let old_jwks_form = form::Json::Obj([
    ("keys", form::Json::Arr([form::Json::Obj([
      ("kty", form::Json::Str("OKP")), ("crv", form::Json::Str("Ed25519")),
      ("kid", form::Json::Str("k-old")), ("x", form::Json::Str(old_k_b64)),
    ])])),
  ])
  let new_jwks_form = form::Json::Obj([
    ("keys", form::Json::Arr([form::Json::Obj([
      ("kty", form::Json::Str("OKP")), ("crv", form::Json::Str("Ed25519")),
      ("kid", form::Json::Str("k-new")), ("x", form::Json::Str(new_k_b64)),
    ])])),
  ])
  let old_jwks_base = station_rules_bridge::form_to_base(old_jwks_form)

  let mfs = station_cloud::MemCloudFs::new()
  let fs = mfs.as_fs()
  let cs = station_cloud::CloudState::{
    provider: None,
    origin: "https://app.still.fail",
    station: extra_dev_pub,
    workspace: ws,
    workspace_name: "WS",
    workspace_emoji: None,
    workspace_icon: None,
    name: "st1",
    relay_url: "https://r.example",
    relay_urls: ["https://r.example"],
    stillfail_relays: None,
    mesh_relays: None,
    grant_keys: old_jwks_base,
    peers: [],
    revocations: [],
    gateway_keys: None,
    removed_at: None,
    removed_code: None,
    joined: [],
    rigs: [],
    ways: None,
    rig: None,
    rig_pending: Map::new(),
    full_pending: Map::new(),
    rig_due: [],
  }
  test_wd_assert(station_cloud::write_state("/d", cs, fs) is Ok(_), "write_state failed")
  let cloud = station_cloud::CloudStore::open("/d", fs)

  // Build root person chain with 3 entries: [pgen, p_ws (commits rotated cloud_keys open body), p_tail (newer device.add)]
  let pgen = test_wd_sign_entry(owner_seed, owner_pub, [
    ("v", form::Json::Num(1.0)), ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(0.0)), ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)), ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("sub", form::Json::Str("u1")),
      ("device", form::Json::Obj([
        ("key", form::Json::Str(owner_kid)), ("id", form::Json::Str(owner_pub)),
        ("label", form::Json::Str("Owner Mac")), ("sign_key", form::Json::Str(owner_kid)),
      ])),
    ])),
  ])
  let root_hash = test_wd_entry_hash(pgen)
  let ws_gen = test_wd_sign_entry(owner_seed, owner_pub, [
    ("v", form::Json::Num(1.0)), ("ws", form::Json::Str(ws)),
    ("seq", form::Json::Num(0.0)), ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)), ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("owner", form::Json::Str("u1")),
      ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
      ("rp_id", form::Json::Str("app.still.fail")),
      ("cloud_keys", old_jwks_form),
      ("members", form::Json::Arr([
        form::Json::Obj([("sub", form::Json::Str("u1")), ("email", form::Json::Str("u1@x.test")), ("role", form::Json::Str("owner"))]),
      ])),
      ("devices", form::Json::Arr([
        form::Json::Obj([
          ("id", form::Json::Str(owner_pub)), ("sub", form::Json::Str("u1")),
          ("kind", form::Json::Str("app")), ("label", form::Json::Str("Owner Mac")),
          ("sign_key", form::Json::Str(owner_kid)),
        ]),
      ])),
      ("stations", form::Json::Arr([
        form::Json::Obj([("key", form::Json::Str(extra_dev_pub)), ("name", form::Json::Str("st1"))]),
      ])),
    ])),
  ])
  let ws_gen_h = test_wd_entry_hash(ws_gen)
  let ws_mv = test_wd_sign_entry(owner_seed, owner_pub, [
    ("v", form::Json::Num(1.0)), ("ws", form::Json::Str(ws)),
    ("seq", form::Json::Num(1.0)), ("prev", form::Json::Str(ws_gen_h)),
    ("at", form::Json::Num(1700000010.0)), ("kind", form::Json::Str("moved")),
    ("body", form::Json::Obj([("root", form::Json::Str(root_hash))])),
  ])
  match cloud.take_lock([ws_gen, ws_mv], Some(now_s)) {
    Ok(n) => test_wd_assert(n == 2, "expected 2 lock entries taken")
    Err(e) => panic("take_lock failed: " + e)
  }
  // Confirm station is in `waiting` state
  match cloud.locked(now_s) {
    Some(eff) => test_wd_assert(eff.waiting, "expected waiting lock")
    None => panic("expected waiting lock")
  }

  let open_body = form::Json::Obj([
    ("ws", form::Json::Str(ws)),
    ("prev", form::Json::Null),
    ("kind", form::Json::Str("open")),
    ("email", form::Json::Str("u1@x.test")),
    ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
    ("rp_id", form::Json::Str("app.still.fail")),
    ("cloud_keys", new_jwks_form),
    ("salt", form::Json::Str("0123456789abcdef0123456789abcdef")),
  ])
  let open_h = match station_rules_bridge::body_hash(open_body) {
    Some(h) => h
    None => panic("body_hash")
  }
  let tag = station_rules_bridge::ws_tag(ws, root_hash)
  let p_ws = test_wd_sign_entry(owner_seed, owner_pub, [
    ("v", form::Json::Num(1.0)), ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(1.0)), ("prev", form::Json::Str(root_hash)),
    ("at", form::Json::Num(1700000020.0)), ("kind", form::Json::Str("ws")),
    ("body", form::Json::Obj([("t", form::Json::Str(tag)), ("h", form::Json::Str(open_h))])),
  ])
  let p_ws_h = test_wd_entry_hash(p_ws)
  // Add a newer entry AFTER p_ws so p_ws is NOT at the head of the person chain!
  let p_tail = test_wd_sign_entry(owner_seed, owner_pub, [
    ("v", form::Json::Num(1.0)), ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(2.0)), ("prev", form::Json::Str(p_ws_h)),
    ("at", form::Json::Num(1700000030.0)), ("kind", form::Json::Str("device")),
    ("body", form::Json::Obj([
      ("id", form::Json::Str(extra_dev_pub)),
      ("label", form::Json::Str("Phone")),
      ("sign_key", form::Json::Str("ed25519:" + extra_dev_pub)),
    ])),
  ])

  // Verify commits_to_body returns exact prefix [pgen, p_ws] (length 2, NOT 3) both on active chain and in `aside`!
  let commits = commits_to_body([(root_hash, [pgen, p_ws, p_tail])], None, open_h)
  test_wd_assert(commits.length() == 1 && commits[0].chain.length() == 2, "expected exact prefix len 2")
  let aside_doc = form::Json::Obj([(root_hash, form::Json::Arr([p_ws]))])
  let aside_commits = commits_to_body([(root_hash, [pgen])], Some(aside_doc), open_h)
  test_wd_assert(aside_commits.length() == 1 && aside_commits[0].chain.length() == 2, "expected aside prefix len 2")
  match station_rules_bridge::body_refusal(ws, open_body, commits) {
    None => ()
    Some(why) => panic("open_body refused: " + why)
  }

  let jwt_claims = [
    ("iss", base_codec::json_str("stillfail-cloud")),
    ("ws", base_codec::json_str(ws)),
    ("sub", base_codec::json_str("u1")),
    ("email", base_codec::json_str("u1@x.test")),
    ("name", base_codec::json_str("U1")),
    ("role", base_codec::json_str("owner")),
    ("device", base_codec::json_str(endpoint_id)),
    ("iat", base_codec::json_int64(1700000050L)),
    ("exp", base_codec::json_int64(1700009999L)),
    ("sid", base_codec::json_str("sid_1")),
  ]
  let old_jwt = test_wd_make_jwt(old_k_seed, "k-old", jwt_claims)
  let new_jwt = test_wd_make_jwt(new_k_seed, "k-new", jwt_claims)
  let ep_proof = test_wd_endpoint_proof(owner_seed, ws, owner_pub, endpoint_id)

  let hello_old_bring = base_codec::json_obj([
    ("credential", base_codec::json_str(old_jwt)),
    ("lock", base_codec::json_obj([
      ("device", base_codec::json_str(owner_pub)),
      ("proof", base_codec::json_str(ep_proof)),
      ("person", base_codec::json_arr([
        station_rules_bridge::form_to_base(pgen),
        station_rules_bridge::form_to_base(p_ws),
        station_rules_bridge::form_to_base(p_tail),
      ])),
      ("bodies", base_codec::json_arr([station_rules_bridge::form_to_base(open_body)])),
    ])),
  ])

  // R4 P1: Inject disk write failure on `bodies`: MUST fail closed — stay `waiting`, do NOT persist
  // `lock.person`, and MUST NOT admit `old_jwt` using carried old keys!
  let fail_fs = station_cloud::CloudFs::{
    read_text: fs.read_text,
    write_private_text: fn(p : String, data : String) -> Result[Unit, String] {
      if p.contains("bodies") {
        Err("ENOSPC")
      } else {
        (fs.write_private_text)(p, data)
      }
    },
    remove_file: fs.remove_file,
    rename_file: fs.rename_file,
    mkdir_p: fs.mkdir_p,
    exists: fs.exists,
  }
  let cloud_fail = station_cloud::CloudStore::open("/d", fail_fs)
  match verify_member_credential(cloud_fail, hello_old_bring, endpoint_id, now_s) {
    Err(refusal) => test_wd_assert(refusal.reason == "lock_station", "R4 P1: expected lock_station waiting refusal on body write failure, got " + refusal.reason)
    Ok(_) => panic("R4 P1: must not admit old_jwt when take_bodies fails")
  }
  match cloud_fail.locked(now_s) {
    Some(eff) => test_wd_assert(eff.waiting, "R4 P1: must remain waiting after body write failure")
    None => panic("R4 P1: expected waiting lock")
  }
  test_wd_assert(cloud_fail.person_chains.length() == 0, "R4 P1: root person chain must not be persisted on body write failure")

  // P1-A: Old-key hello carries root chain (with p_ws NOT at head) + rotated cloud_keys open_body.
  // Station exits waiting, re-verifies against rotated cloud_keys -> MUST REJECT old_jwt!
  match verify_member_credential(cloud, hello_old_bring, endpoint_id, now_s) {
    Err(refusal) => test_wd_assert(refusal.error == "unknown credential key", "unexpected refusal: " + refusal.error)
    Ok(_) => panic("P1-A: rotated-out old credential must be rejected; bodies=" + cloud.bodies().values().length().to_string() + " chains=" + cloud.person_chains.length().to_string() + " gkeys=" + base_codec::json_stringify(cloud.grant_keys(now_s)))
  }
  match cloud.locked(now_s) {
    Some(eff) => test_wd_assert(!eff.waiting, "expected active non-waiting lock after recovery")
    None => panic("expected active non-waiting lock after recovery")
  }

  // P2-A: Initial hello with new_jwt + endpoint proof succeeds; renewal WITHOUT `lock` field
  // succeeds when passing `prior_lock`, fails without `prior_lock`, and rejects `old_jwt`!
  let hello_new = base_codec::json_obj([
    ("credential", base_codec::json_str(new_jwt)),
    ("lock", base_codec::json_obj([
      ("device", base_codec::json_str(owner_pub)),
      ("proof", base_codec::json_str(ep_proof)),
    ])),
  ])
  let vm1 = match verify_member_credential(cloud, hello_new, endpoint_id, now_s) {
    Ok(v) => v
    Err(r) => panic("P2-A: initial hello with endpoint proof failed: " + r.error)
  }
  let saved_lock = match (vm1.lock_base, vm1.lock_proof) {
    (Some(b), Some(p)) => Some((b, p))
    _ => panic("P2-A: expected saved lock_base/lock_proof")
  }
  let renew_no_lock = base_codec::json_obj([("credential", base_codec::json_str(new_jwt))])
  test_wd_assert(verify_member_credential(cloud, renew_no_lock, endpoint_id, now_s, prior_lock=saved_lock) is Ok(_), "P2-A: renewal with saved_lock failed")
  test_wd_assert(verify_member_credential(cloud, renew_no_lock, endpoint_id, now_s, prior_lock=None) is Err(_), "P2-A: renewal without proof must fail")
  let renew_old_key = base_codec::json_obj([("credential", base_codec::json_str(old_jwt))])
  match verify_member_credential(cloud, renew_old_key, endpoint_id, now_s, prior_lock=saved_lock) {
    Err(r) => test_wd_assert(r.error == "unknown credential key", "P2-A: unexpected refusal: " + r.error)
    Ok(_) => panic("P2-A: rotated-out key must be rejected on renewal")
  }
}

test "R5: commits_to_body enforces CHAIN_MOST = 1024 boundary (1025-entry chain succeeds, 1026-entry chain stops before genesis)" {
  let mk_entry = fn(seq : Int, prev : form::Json, kind : String, body : form::Json) -> form::Json {
    form::Json::Obj([
      ("v", form::Json::Num(1.0)),
      ("ws", form::Json::Str("person:u_bound")),
      ("seq", form::Json::Num(seq.to_double())),
      ("prev", prev),
      ("at", form::Json::Num((1700000000 + seq).to_double())),
      ("kind", form::Json::Str(kind)),
      ("body", body),
      ("sig", form::Json::Obj([("key", form::Json::Str("ed25519:00")), ("alg", form::Json::Str("Ed25519")), ("sig", form::Json::Str("00"))])),
    ])
  }
  let target_h_1025 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let target_h_1026 = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let entries : Array[form::Json] = []
  let gen = mk_entry(0, form::Json::Null, "genesis", form::Json::Obj([("sub", form::Json::Str("u_bound"))]))
  let root_h = test_wd_entry_hash(gen)
  entries.push(gen)
  let mut prev_h = root_h
  // Build entries 1..=1025 (total 1026 entries):
  // - index 1024 (1025th entry, chain length 1025) commits to target_h_1025 -> MUST succeed (len 1025)
  // - index 1025 (1026th entry, chain length 1026) commits to target_h_1026 -> MUST stop before genesis (empty)
  for seq in 1..<1026 {
    let e = if seq == 1024 {
      mk_entry(seq, form::Json::Str(prev_h), "ws", form::Json::Obj([("t", form::Json::Str("tag")), ("h", form::Json::Str(target_h_1025))]))
    } else if seq == 1025 {
      mk_entry(seq, form::Json::Str(prev_h), "ws", form::Json::Obj([("t", form::Json::Str("tag")), ("h", form::Json::Str(target_h_1026))]))
    } else {
      mk_entry(seq, form::Json::Str(prev_h), "device", form::Json::Obj([("id", form::Json::Str("d" + seq.to_string()))]))
    }
    prev_h = test_wd_entry_hash(e)
    entries.push(e)
  }
  let ok_1025 = commits_to_body([(root_h, entries)], None, target_h_1025)
  test_wd_assert(ok_1025.length() == 1 && ok_1025[0].chain.length() == 1025, "expected 1025-entry chain to succeed")
  let rej_1026 = commits_to_body([(root_h, entries)], None, target_h_1026)
  test_wd_assert(rej_1026.length() == 0, "expected 1026-entry chain to stop before genesis and return empty")
}
