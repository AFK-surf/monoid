    (158, "station_move has action stop."),
    (159, "station_move has no module agent-home any more."),
    (160, "station_move takes arriveStopped."),
    (161, "secret_save takes oauth: \"slack\"."),
    (162, "chat_create needs for: me for a chat you lead, person for one opened for your person."),
    (163, "station_move plan and status answer a summary and enforce disk headroom."),
    (164, "browser takes engine (chrome or farview)."),
    (165, "Pi is available where Pi 1.0 or newer is installed: chat_create takes runtime \"pi\"."),
    (166, "Messages can come from group (IM) chats, via=\"group\"."),
    (167, "Antigravity CLI (agy) sessions now load workspace/preset skills, repo rules, and default multi-level models to medium."),
    (168, "chat_create takes speed: standard, fast or ultrafast."),
