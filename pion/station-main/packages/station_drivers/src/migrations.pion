// Numbered migration notes delivered once to older sessions when agent
// instructions or tool rules change — 1:1 aligned with `station/src/agents/migrations.ts`.

/// The last note that replaces every one before it.
pub let REWRITTEN : Int = 121
pub let WATERMARK_MASK : Int = 0xFFFFF
pub let GATED_PROJECTS_BIT : Int = 1 << 20

pub fn is_projects_gated(n : Int) -> Bool {
  n == 186 || n == 188
}

/// Active numbered migration notes from `REWRITTEN` (121) onward (verbatim 1:1 with TS).
pub fn migration_notes() -> Array[(Int, String)] {
  [
    (121, "The instructions were rewritten whole and much shorter; every earlier note is void. Follow only the current instructions (the file named below): one state per turn, cards only for real choices, details of other chats, agents, Slack and Feishu in the new skill stillfail-chats."),
    (122, "phone_send {path} puts a file on the phone granted to your chat (it fetches it as it downloads a chat's file), much faster and surer than adb push over its link, and answers its path there (pm cannot read that folder: install an APK from a copy in /data/local/tmp). Use it instead of adb push for anything but small files."),
    (123, "Skill stillfail-chats corrected: Slack shows login cards (a login on this station that takes a pasted code or a device code, with its link); only Feishu has none, where the login's link goes alone."),
    (124, "A repository's AGENTS.md files (its root's and each directory's down to where you change code) are its rules: read them before changing code there and keep them true in what you change."),
    (125, "chat_post no longer posts over messages you have not read: when some came in its thread first, it holds the post back and answers its id, and they come to you next. If it still stands, send it unchanged with chat_post {to, send: <id>} plus the state the turn ends with, without writing it again; otherwise post what fits now."),
    (126, "all_done only when nothing people asked for in the chat is left, not when a step of a longer goal is done; a post that says what you do next means you go on doing it in this turn; need_human is not for what people already decided."),
    (127, "A choice on a card's action=close option still sends no message and does not wake you, but you are now told it: a <card-choice> block before what you are next handed (a message, a notice), with when it was chosen (at, ago). It is an earlier, settled choice, not what the new messages are about; chat_history shows it on the card as well."),
    (128, "A station's queue no longer holds station_task tasks back for busy CPUs: a task waits only for memory pressure, the screen, or the small-task slot (queue.why memory, screen, person or small; no cause, and decision has only memoryPressure)."),
    (129, "A station_task started beside others is no longer given STILLFAIL_CPUS, MAKEFLAGS, CARGO_BUILD_JOBS or CMAKE_BUILD_PARALLEL_LEVEL by the station (the count came out as one on a busy machine): builds take the cores the system gives them. Only a small task is still told one CPU."),
    (130, "station_list now also lists the workspace's stations safe mode does not protect (offline or too old when it was turned on), each with unprotected saying why it cannot be called from here; naming one in station_task, station_file or station_list is refused saying the same. It is not a bug: tell the person an owner or admin protects it in Settings → Security (设置 → 安全) with Protect (保护), updating it first if it is too old."),
    (131, "A station can be set to only run tasks (station_list says mode: \"tasks\"): it runs no agents and holds no chats, and it is its owner's. station_list lists it among the stations with its owner, whether this chat may use it (thisChat) and who has access. Ask to use one with the new tool station_use {station, reason, timeout?} (a card in your chat goes to its owner, who approves it for this chat for a time; you are told when it is decided), unless station_list says it is open to every chat. Once this chat may use it, name it as station in station_task, station_file, peer_forward and secret_use as any other; station_use {station, done: true} hands it back. chat_create and session_send do not reach it: it holds no chats."),
    (132, "The still.fail team can now reply to a bug report (FB-<n>); people read their replies in the app, beside the chat, and may hand one to you quoted in a message. When the person asks you to answer the team, use the new tool feedback_reply {number, text}, with only what they agreed to send."),
    (133, "New tools device_list and device_use: the workspace's devices (phones, boards, cameras, routers, serial ports attached to a station, and members' Android phones lent by their app), each with whose it is and whether this chat may use it. device_use {device, reason, timeout?} puts one this chat may use on a port of 127.0.0.1 here at once (only this chat's processes connect), or asks its owner with a card (a device on a tasks-only station, someone's phone); call it again once granted, done: true hands it back. phone_use still asks for the phone of the person you work for; device_use with no device, or with a person's email, does too. A phone may now be granted until it has gone unused for an hour, or for eight hours, besides an hour or until the chat is archived."),
    (134, "New tool chat_archive {chat}: archive another still.fail chat of this workspace by its link, here or on another station, as a person does in the app. Its messages remain; workspace files may later be cleaned up."),
    (135, "New tool relays {action: list|add|remove, url?}: the relays of your chat's workspace of its own (one in an office in mainland China, say), beside still.fail's. add reaches the URL from this station first and adds it only if it answers as a relay over https; nobody approves it, it is the workspace's at once and its members' devices measure and use it. Use it rather than asking a person to add a relay in the app."),
    (136, "secret_list, secret_use and secret_save take person: the email of someone who wrote in this chat from the still.fail app, whose vault it is and who approves the card; left out, whoever started the chat as before. Name them when someone other than the chat's starter asks for a secret, or when a chat started in Slack is now written in from still.fail (a card for a Slack starter cannot be approved in the app)."),
    (137, "In Antigravity CLI the station's tools that do not fit what it declares to you are no longer missing: they are reached through the tool station_tool {name, arguments?} (only name: that tool's description and parameters; with arguments: it runs). chat_post and chat_state are always declared."),
    (138, "A vault item has an about now (what it is for and how it is used), which secret_list returns beside its name. secret_save requires about, and its name should tell a person at a glance what it is (UniFi 后台登录态（经 Studio 转发到 127.0.0.1:8443）, not 127.0.0.1 登录态); sign_in {done: true} takes name and about for the sign-in it keeps. One whose name or about does not say what it is: ask to change them with the new tool secret_describe {item, name?, about?, reason} (a card its owner approves)."),
    (139, "feishu_api now saves non-JSON answers in this session's uploads and returns their local path, content_type and size. To get an image or file in a message, call GET /open-apis/im/v1/messages/:message_id/resources/:file_key with params type: image or file."),
    (140, "Sessions no longer run in sandboxes, and job_start has no size any more. Heavy work goes to a sandbox instead: station_list lists this station's sandboxes (config.json's sandboxes; kind sandbox, by their name) beside the stations, and station_task runs a task there as on another station (dir to sync, back to bring results here; no screen)."),
    (141, "New vault tools: secret_delete {item, reason, person?} asks the item's owner (a card approved in the app) to delete a secret that is wrong or no longer needed, rather than renaming it; secret_cancel {request} withdraws a request of this chat's own (secret_use, secret_save, secret_describe, secret_delete) nobody decided yet, closing its card and taking it off the person's waiting requests. Saying in the chat that a card is not needed leaves it waiting: withdraw it with secret_cancel."),
    (142, "New tool station_retire {action: preview|status|start|hand_over|again|cancel, station?, to?} and skill stillfail-retire: you can assist retiring a station of the workspace (its chats, jobs, memory and skills, accounts and connects go to another station). start and hand_over each post a card an owner or admin confirms in the still.fail app; you are told each step after. A chat moved from a retired station now has its running jobs started again there, and is told so at once."),
    (143, "The station's tool descriptions are shorter: each says what the tool does and when, the rules and what a tool takes are as before, and the details moved to the skills they name: stillfail-chats (cards, held posts, other chats and agents, archive policy), stillfail-jobs (jobs and watches, tasks on another station, tasks-only stations, forwards, devices and phones), stillfail-vault (secrets), stillfail-browser (sign-ins, the computer and screen tools) and stillfail-login. When you do not have a skill that your instructions or a tool's description names, read it with skill_read by its name. chat_post's options beside text, from before cards, is still taken but no longer declared: write card."),
    (144, "A subagent you start must not post to the chat, end the turn, write to another chat's agent, open, leave or archive a chat, or write to Slack (reading Slack is fine): it hands its result back to you as its final answer, and you say what people need. Do not ask one to do any of these. On Claude Code its calls of chat_post, chat_state, session_send, chat_create, chat_leave, chat_archive and of slack_api's writing methods are refused, in a process started since this change."),
    (145, "Retiring a station is switched off for now, while it is fixed after its first use lost files: station_retire start and hand_over are refused and post no card; preview, status, cancel and again answer as before."),
    (146, "chat_create takes preset (one of this station's presets, by name or id), fast and context: with a preset it opens as a person opening it with that preset in the app would, and where the preset names its model nothing of runtime, model, effort, fast or context is given beside it; without one the chat has no preset (skill stillfail-chats)."),
    (147, "The memory (MEMORY.md) and skills are now the same on every station of the workspace, kept level by the stations within seconds of an edit. What is true of one machine alone says which station it is of (「Studio：…」); a line or skill marked [<station>] came from that station before; a *.conflict-<station>.* file beside a skill is a version made at the same time elsewhere: merge it in and delete it."),
    (148, "Messages and chat history now say sent_at in UTC where the message ID carries its time, or recorded_at for when the station recorded an opaque ID. ts remains the original message ID. Every turn and steer also says when it was delivered in UTC."),
    (149, "station_list no longer calls a station that did not answer within 2 s offline: it is listed unanswered (ask it alone with station_list {station}, which waits 10 s); offline is said only where no link to it would open. version is what each station says itself; version_seen is still.fail cloud's older copy, not its version now: never tell a person a station is offline or out of date from those."),
    (150, "Memory holds lasting rules and facts only, never progress, status or handover notes (those go in your chat's workspace); remove what a new rule contradicts or repeats, and keep one where a merge kept two versions. Where MEMORY.md or a skill has grown too large, the memory you are told ends with what to condense: do it before adding to it."),
    (151, "card.assignee is the email in the from of the deciding person's message, never the email your runtime gives as its user's (the account you run on): chat_post refuses an account of this station's as assignee unless that person wrote in the chat."),
    (152, "When a request or change will take more than a couple of minutes, reply briefly first with the cause and plan rather than staying silent until the end; in stillfail-browser, never register a new passkey on a person's account unless they explicitly ask you to."),
    (153, "A chat_post with no kind after all_done or need_human in the same turn means you go on: that state no longer stands, so end the turn with a state again when you are done."),
    (154, "stillfail-cron: set a schedule up in one turn without asking how, saying what you picked. stillfail-vault: as soon as you see a credential will be needed again, offer to keep it (secret_save). stillfail-show: compare before and after at the same size and data, and send fresh evidence after each revision."),
    (155, "The chat's title says what the whole chat is for, never the step you are on. Where people gave a principle decide by it yourself, and ask plainly anything that makes someone wait. Told off with nothing new found, keep your answer. Asked to do as another chat did, read that chat from its start first; another chat's agent asking this chat to take up a large piece of other work, ask this chat's people first. Before fixing a bug, look for a fix someone already opened or merged. A lent phone or device (phone_use, device_use) is handed back once the whole task is done, not between steps, and not asked for again for each use."),
    (156, "New tool station_move {action: plan|move|back|status, to?, module?, item?, withNeeds?, all?} and skill stillfail-move: chats move to another station one at a time while both stations work (a chat pauses for seconds; its jobs follow), and back the same way; accounts and connects are items of their own; a whole station is every item moved in order, confirmed once on a card by an owner or admin. A chat moved here is told so once with what it is next handed."),
    (157, "station_move takes station (another station does it with its own items) and wait (false: a chat in a turn is refused, not waited for); repos, vault, agent-home and settings move as items of their own now, a chat of a Comma or single-session connect moves after its connect, and an item may arrive stopped where what it needs is not there yet (arriveStopped)."),
    (158, "station_move has action stop (the move under way stops: a chat not yet gone stays here, one gone completes), and moving is refused where a station has it switched off (config.json move), saying so."),
