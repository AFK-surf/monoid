    (174, "Codex reports which models offer Ultrafast for each subscription."),
    (175, "Farview now has an authenticator of its own for stored passkeys."),
    (176, "relays action enroll issues a one-use 24h mesh relay enrollment token."),
    (177, "station_version: list, update, back."),
    (178, "New tool chat_configure; chat_list filters; superseded tools hidden."),
    (179, "Moving to another station is on for every station now, stable ones too."),
    (180, "chat_post now takes a Feishu chat_id as to (to=\"oc_…\")."),
    (181, "Google Colab GPU sandboxes (colab-g4, colab-l4, colab-t4) are now automatically exposed from Google Colab profiles and discoverable across stations via station_list and station_task."),
    (182, "chat_configure now takes for: \"me\" or \"person\" and reports led and leader."),
    (183, "station_version now supports action: \"wait\"."),
    (184, "Post brief progress updates with chat_post during long multi-step waits."),
    (185, "chat_post now takes kind waiting with for and seconds."),
    (186, "chat_configure now takes project (\"\" for cross-project) and tags/tags_add/tags_remove (max 3) to silently classify chats; new tool project_manage (read skill stillfail-projects first) lists, proposes new projects (never end need_human for a proposal), updates shared project info, renames, merges, or bulk reclassifies."),
    (187, "In Antigravity CLI, search is now declared directly alongside skill_read; when a workspace has more skills than fit .agent/skills, the omitted ones stay searchable with search (kinds=[\"skill\"]) and readable with skill_read."),
    (188, "Projects are conceptual workstreams (e.g. office CI, ops, clients, products, research — not limited to GitHub repos or folders); unclassified and empty project are unified (no separate cross-project bucket). Tags (0–3) are optional: prefer existing tags and leave tags empty when unsure instead of inventing ad-hoc tags. Accepting project_manage(action=\"propose\") only creates the project without auto-assigning the current chat. project_manage(action=\"reclassify\") now batches per station up to 500 items and accepts optional station (name or id) on each item; chat_list also accepts project (\"\" for unclassified)."),
    (189, "chat_list now supports offset (pagination) and compact: true (one-line `- <address> \"<title>\" [...]` summary with limit up to 500) for scanning large chat lists."),
    (190, "Memory now routes into four layers: MEMORY.md (<= 8 KB target, hard-capped at 16 KB on injection) for cross-project/person/machine rules only, skills/<project>/SKILL.md for projects, skills/machines/<station-tag>.md for machine/environment notes (current station auto-injected as <station-memory>, 4 KB cap), and skills/people/<name>.md for team roles and preferences (read via skill_read). Update existing same-topic entries in place instead of appending duplicates."),
    (191, "skills/people/<person-tag>.md (the tag is the person's email in lower case) of the person a session is for is now auto-injected at session start as <person-memory> (4 KB cap): keep personal preferences, approval habits and personal machine details there, not in MEMORY.md."),
    (192, "device_list now includes AirPlay devices (kind: \"airplay\", Apple TV / HomePod / AirPlay speakers) and new tool device_control runs standard AirPlay actions (status, power, remote, apps, launch, playing, seek, volume, keyboard, play_url, stream_audio) over the device tunnel (see skill stillfail-jobs)."),
  ]
}

fn note_visible(n : Int, projects_on : Bool) -> Bool {
  if is_projects_gated(n) {
    projects_on
  } else {
    true
  }
}

/// Next `told_notes` value after delivering all currently visible notes to a session at `told`.
/// Low 20 bits hold the highest note number reached; upper bits record gated features skipped.
pub fn next_told(told : Int, projects_on : Bool) -> Int {
  let prev_mark = told & WATERMARK_MASK
  let mut withheld = told & (0 - 1 - WATERMARK_MASK)
  let mut max_mark = prev_mark
  let notes = migration_notes()
  for i in 0..<notes.length() {
    let (n, _) = notes[i]
    if n < REWRITTEN {
      continue
    }
    let gated = is_projects_gated(n)
    if note_visible(n, projects_on) {
      if n > max_mark {
        max_mark = n
      }
      if gated {
        withheld = withheld & (0 - 1 - GATED_PROJECTS_BIT)
      }
    } else if gated && n > prev_mark {
      withheld = withheld | GATED_PROJECTS_BIT
    }
  }
  max_mark | withheld
}

pub fn latest_told(projects_on : Bool) -> Int {
  next_told(0, projects_on)
}

pub fn untold_entries(told : Int, projects_on : Bool) -> Array[(Int, String)] {
  let prev_mark = told & WATERMARK_MASK
  let withheld = told & (0 - 1 - WATERMARK_MASK)
  let notes = migration_notes()
  let out : Array[(Int, String)] = []
  for i in 0..<notes.length() {
    let (n, text) = notes[i]
    if n < REWRITTEN || !note_visible(n, projects_on) {
      continue
    }
    if n > prev_mark {
      out.push((n, text))
    } else if is_projects_gated(n) && (withheld & GATED_PROJECTS_BIT) != 0 {
      out.push((n, text))
    }
  }
  out
}

pub fn has_untold(told : Int, projects_on : Bool) -> Bool {
  untold_entries(told, projects_on).length() > 0
}

pub fn untold_notes(told : Int, full_path : String, projects_on : Bool) -> String {
  let entries = untold_entries(told, projects_on)
  if entries.length() == 0 {
    return ""
  }
  let lines : Array[String] = []
  for i in 0..<entries.length() {
    let (_, note) = entries[i]
    lines.push("- " + note)
  }
  "[still.fail changed how you work since this session began]\n" +
  join_strings(lines, "\n") +
  "\nToday's whole instructions, tool parameters included, are in " +
  full_path +
  ": read them when you need the details (your tool list may not show the new parameters; pass them anyway)."
}
