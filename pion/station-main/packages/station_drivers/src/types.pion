/// Format 16 bytes as an RFC 4122 UUID v4 (`xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx`).
pub fn uuid_v4_from_bytes(raw : Bytes) -> String {
  let b = Bytes::new(16)
  for i in 0..<16 {
    b[i] = if i < raw.length() { raw[i] } else { 0 as Byte }
  }
  b[6] = ((b[6].to_int() & 0x0F) | 0x40) as Byte
  b[8] = ((b[8].to_int() & 0x3F) | 0x80) as Byte
  let hex = "0123456789abcdef".to_bytes()
  let sb = StringBuilder::new()
  for i in 0..<16 {
    if i == 4 || i == 6 || i == 8 || i == 10 {
      sb.write_byte(45 as Byte)
    }
    let v = b[i].to_int() & 0xFF
    sb.write_byte(hex[(v >> 4) & 0x0F])
    sb.write_byte(hex[v & 0x0F])
  }
  sb.to_string()
}

/// Validate RFC 4122 UUID v4 format (`8-4-4-4-12` hex, version `4`, variant `8|9|a|b`).
pub fn is_valid_uuid_v4(s : String) -> Bool {
  let raw = s.to_bytes()
  if raw.length() != 36 {
    return false
  }
  for i in 0..<36 {
    let b = raw[i].to_int() & 0xFF
    if i == 8 || i == 13 || i == 18 || i == 23 {
      if b != 45 {
        return false
      }
    } else if i == 14 {
      if b != 52 { // '4'
        return false
      }
    } else if i == 19 {
      let ok_var = b == 56 || b == 57 || b == 97 || b == 98 || b == 65 || b == 66
      if !ok_var {
        return false
      }
    } else {
      let ok_hex = (b >= 48 && b <= 57) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70)
      if !ok_hex {
        return false
      }
    }
  }
  true
}

