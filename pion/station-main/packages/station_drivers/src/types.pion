// Core domain types, failure classification, speaking-tool guards, and
// environment sanitization for `station_drivers`.

import "base_codec"
import "crypto"

/// The runtimes a station runs, in the order they are offered.
pub enum RuntimeKind {
  Claude
  Codex
  Dsh
  Grok
  Cursor
  Devin
  Hermes
  Agy
  Pi
  Copilot
}

pub fn runtime_kinds() -> Array[RuntimeKind] {
  [
    RuntimeKind::Claude,
    RuntimeKind::Codex,
    RuntimeKind::Dsh,
    RuntimeKind::Grok,
    RuntimeKind::Cursor,
    RuntimeKind::Devin,
    RuntimeKind::Hermes,
    RuntimeKind::Agy,
    RuntimeKind::Pi,
    RuntimeKind::Copilot,
  ]
}

pub fn runtime_kind_to_str(r : RuntimeKind) -> String {
  match r {
    RuntimeKind::Claude => "claude"
    RuntimeKind::Codex => "codex"
    RuntimeKind::Dsh => "dsh"
    RuntimeKind::Grok => "grok"
    RuntimeKind::Cursor => "cursor"
    RuntimeKind::Devin => "devin"
    RuntimeKind::Hermes => "hermes"
    RuntimeKind::Agy => "agy"
    RuntimeKind::Pi => "pi"
    RuntimeKind::Copilot => "copilot"
  }
}

pub fn runtime_kind_from_str(s : String) -> Option[RuntimeKind] {
  if s == "claude" {
    Some(RuntimeKind::Claude)
  } else if s == "codex" {
    Some(RuntimeKind::Codex)
  } else if s == "dsh" {
    Some(RuntimeKind::Dsh)
  } else if s == "grok" {
    Some(RuntimeKind::Grok)
  } else if s == "cursor" {
    Some(RuntimeKind::Cursor)
  } else if s == "devin" {
    Some(RuntimeKind::Devin)
  } else if s == "hermes" {
    Some(RuntimeKind::Hermes)
  } else if s == "agy" {
    Some(RuntimeKind::Agy)
  } else if s == "pi" {
    Some(RuntimeKind::Pi)
  } else if s == "copilot" {
    Some(RuntimeKind::Copilot)
  } else {
    None
  }
}

pub fn runtime_kind_eq(a : RuntimeKind, b : RuntimeKind) -> Bool {
  runtime_kind_to_str(a) == runtime_kind_to_str(b)
}

pub fn runtime_label(r : RuntimeKind) -> String {
  match r {
    RuntimeKind::Claude => "Claude Code"
    RuntimeKind::Codex => "Codex"
    RuntimeKind::Dsh => "DeepSeek Harness"
    RuntimeKind::Grok => "Grok Build"
    RuntimeKind::Cursor => "Cursor"
    RuntimeKind::Devin => "Devin"
    RuntimeKind::Hermes => "Hermes Agent"
    RuntimeKind::Agy => "Antigravity CLI"
    RuntimeKind::Pi => "Pi"
    RuntimeKind::Copilot => "GitHub Copilot"
  }
}

pub enum AccessKind {
  Subscription
  OpencodeGo
  AnthropicApi
  Env
  ApiProvider
  Service
}

pub fn access_kind_to_str(k : AccessKind) -> String {
  match k {
    AccessKind::Subscription => "subscription"
    AccessKind::OpencodeGo => "opencode-go"
    AccessKind::AnthropicApi => "anthropic-api"
    AccessKind::Env => "env"
    AccessKind::ApiProvider => "api-provider"
    AccessKind::Service => "service"
  }
}

pub fn access_kind_from_str(s : String) -> AccessKind {
  if s == "subscription" {
    AccessKind::Subscription
  } else if s == "opencode-go" {
    AccessKind::OpencodeGo
  } else if s == "anthropic-api" {
    AccessKind::AnthropicApi
  } else if s == "api-provider" {
    AccessKind::ApiProvider
  } else if s == "service" {
    AccessKind::Service
  } else {
    AccessKind::Env
  }
}

pub fn access_kind_eq(a : AccessKind, b : AccessKind) -> Bool {
  access_kind_to_str(a) == access_kind_to_str(b)
}

pub enum Protocol {
  ChatCompletions
  Responses
  Anthropic
}

pub fn protocol_to_str(p : Protocol) -> String {
  match p {
    Protocol::ChatCompletions => "chat_completions"
    Protocol::Responses => "responses"
    Protocol::Anthropic => "anthropic"
  }
}

pub fn protocol_from_str(s : String) -> Option[Protocol] {
  if s == "chat_completions" {
    Some(Protocol::ChatCompletions)
  } else if s == "responses" {
    Some(Protocol::Responses)
  } else if s == "anthropic" {
    Some(Protocol::Anthropic)
  } else {
    None
  }
}

