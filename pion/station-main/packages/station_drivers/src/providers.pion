// API providers, endpoint resolution, profile environment construction,
// Codex TOML overrides, DSH/Pi routes, and runtime capability mapping —
// 1:1 aligned with `station/src/agents/providers.ts` and `station/src/agents/profiles.ts`.

import "base_codec"
import "nodepath"

pub let KIMI_CODE : String = "kimi-code"
pub let KIMI_TOKEN_FILE : String = "kimi-code.token"
pub let OPENCODE : String = "https://opencode.ai/zen/go"
pub let OPENCODE_SMALL : String = "claude-haiku-5-5"
pub let CODEX_KEY : String = "STILLFAIL_API_KEY"
pub let DSH_KEY : String = "STILLFAIL_DSH_KEY"
pub let PI_KEY : String = "STILLFAIL_PI_KEY"
let NO_KEY : String = "none"

pub struct Source {
  pub id : String
  pub name : String
  pub chat : Option[String]
  pub responses : Option[String]
  pub anthropic : Option[String]
  pub decision : Option[String]
  pub endpoint_required : Bool
  pub protocols : Array[Protocol]
  pub key_optional : Bool
  pub auth : ClaudeAuth
  pub session_header : Bool
}

fn make_source(
  id : String,
  name : String,
  chat : Option[String],
  responses : Option[String],
  anthropic : Option[String],
  decision : Option[String],
  endpoint_required : Bool,
  protocols : Array[Protocol],
  key_optional : Bool,
  auth : ClaudeAuth,
  session_header : Bool,
) -> Source {
  Source::{
    id: id,
    name: name,
    chat: chat,
    responses: responses,
    anthropic: anthropic,
    decision: decision,
    endpoint_required: endpoint_required,
    protocols: protocols,
    key_optional: key_optional,
    auth: auth,
    session_header: session_header,
  }
}

fn all_protocols() -> Array[Protocol] {
  [Protocol::ChatCompletions, Protocol::Responses, Protocol::Anthropic]
}

