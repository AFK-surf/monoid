test "review P1: workspace isolation (borrowed empty share_workspaces, homeWorkspace, sorted colab, profiles_for)" {
  // Borrowed profile with empty share_workspaces must be allowed NOWHERE!
  let base_b = Profile::default("borrowed-empty", Some(RuntimeKind::Claude), "/h/b")
  let borrowed_empty = Profile::{ ..base_b, access_kind: AccessKind::Subscription, borrowed: true, share_workspaces: [] }
  expect(!allowed_in(borrowed_empty, Some("ws-a"), Some("ws-home")), "borrowed empty share_workspaces denied in ws-a")
  expect(!allowed_in(borrowed_empty, None, Some("ws-home")), "borrowed empty share_workspaces denied in home")
  expect(!profile_serves_workspace(borrowed_empty, Some("ws-a"), None), "profile_serves_workspace denies borrowed empty")

  // Home workspace ignores withheld; joined workspace honors withheld
  let base_w = Profile::default("local-withheld", Some(RuntimeKind::Claude), "/h/w")
  let local_w = Profile::{ ..base_w, access_kind: AccessKind::Subscription, withheld: ["ws-home", "ws-joined"] }
  expect(allowed_in(local_w, Some("ws-home"), Some("ws-home")), "home workspace bypasses withheld")
  expect(allowed_in(local_w, None, Some("ws-home")), "null ws means home workspace")
  expect(!allowed_in(local_w, Some("ws-joined"), Some("ws-home")), "joined workspace blocked by withheld")

  // colab_accounts_for sorted by id
  let c_b = make_profile("colab-b", None, "/h/cb", true, false, None, AccessKind::Service, "", None, Some(COLAB_SERVICE_ID), [], None)
  let c_a = make_profile("colab-a", None, "/h/ca", true, false, None, AccessKind::Service, "", None, Some(COLAB_SERVICE_ID), [], None)
  let sorted = colab_accounts_for([c_b, c_a], Some("ws-home"), Some("ws-home"), fn(_p : String) -> Bool { true }, "/")
  expect(sorted.length() == 2 && sorted[0].id == "colab-a" && sorted[1].id == "colab-b", "colab_accounts_for sorted by id")

  // pick_profile_for_workspace blocks withheld & borrowed profiles
  let signals = PoolSignals::{
    now_ms: 1000L,
    health_fn: fn(_id : String) -> ProfileHealth { ProfileHealth::ok([]) },
    load_fn: fn(_id : String) -> Int { 0 },
    local_active_fn: fn(_id : String) -> Int { 0 },
    remote_active_fn: fn(_id : String) -> Int { 0 },
    last_picked_fn: fn(_id : String) -> Int64 { 0L },
    max_sessions_fn: fn(_id : String) -> Option[Int] { None },
  }
  match pick_profile_for_workspace([borrowed_empty, local_w], RuntimeKind::Claude, Some("ws-joined"), Some("ws-home"), None, signals, false) {
    Ok(_) => panic("cross-workspace withheld/borrowed profiles must be rejected")
    Err(_) => ()
  }
}

test "review P2: Codex textOnly/turn/start, Vertex api_env, key_part UTF-16, Hermes home, strict loopback URL" {
  // Codex textOnly + ultrafast non-subscription rejection + profile.fast fallback
  let p_api = make_profile("p-cx-api", Some(RuntimeKind::Codex), "/h/cx", true, true, None, AccessKind::OpencodeGo, "k", None, None, [], None)
  let o_text = OpenOptions::{ ..test_opts("chat:t1", p_api, "/ws/1", "", ""), text_only: true }
  let text_cfg = codex_thread_start_params_json(o_text, [], ["github", "linear"])
  expect(str_contains(text_cfg, "\"sandbox\":\"read-only\""), "codex textOnly read-only")
  expect(str_contains(text_cfg, "\"ephemeral\":true"), "codex textOnly ephemeral")
  expect(str_contains(text_cfg, "\"github\":{\"enabled\":false}"), "codex textOnly disables existing MCPs")
  match codex_turn_start_params_json("t1", "hi", p_api, Some("ultrafast"), None) {
    Ok(_) => panic("ultrafast must be rejected on non-subscription codex profile")
    Err(_) => ()
  }
  let p_sub_fast = make_profile("p-cx-sub", Some(RuntimeKind::Codex), "/h/cx", true, true, None, AccessKind::Subscription, "", None, None, [], None)
  let fast_turn = match codex_turn_start_params_json("t1", "hi", p_sub_fast, None, None) {
    Ok(s) => s
    Err(e) => panic(e)
  }
  expect(str_contains(fast_turn, "\"serviceTier\":\"fast\""), "codex turn/start honors profile.fast")

  // api_env returns empty for google-vertex on dsh / pi
  let v_via = Via::{ provider: Some("google-vertex"), endpoint: None, protocol: None }
  expect(access_env(RuntimeKind::Dsh, AccessKind::ApiProvider, "{\"type\":\"service_account\"}", None, v_via).length() == 0, "dsh vertex api_env empty")
  expect(access_env(RuntimeKind::Pi, AccessKind::ApiProvider, "{\"type\":\"service_account\"}", None, v_via).length() == 0, "pi vertex api_env empty")

  // key_part UTF-16 code units: emoji is 2 UTF-16 units -> "__"
  let kp = key_part("a🚀b")
  expect(str_starts_with(kp, "a__b-"), "key_part replaces emoji surrogate pair as 2 UTF-16 units: " + kp)

  // Hermes configured_hermes_home & session_hermes_home
  match configured_hermes_home(Some("relative/path"), "/fb", "/home/u", "/") {
    Ok(_) => panic("relative HERMES_HOME must be rejected")
    Err(_) => ()
  }
  match configured_hermes_home(Some("~/custom-hermes"), "/fb", "/home/u", "/") {
    Ok(p) => expect(p == "/home/u/custom-hermes", "tilde expanded: " + p)
    Err(e) => panic(e)
  }
  match session_hermes_home(Some("bad/id"), "/cfg", "/priv", None, "/home/u", "/") {
    Ok(_) => panic("invalid hermes session id must be rejected")
    Err(_) => ()
  }
  match session_hermes_home(Some("sess_1"), "/cfg", "/priv", Some("{\"type\":\"session\",\"hermesHome\":\"/orig/hermes\"}"), "/home/u", "/") {
    Ok(p) => expect(p == "/orig/hermes", "resumed session keeps original hermesHome: " + p)
    Err(e) => panic(e)
  }

  // Strict is_local_mcp_url adversarial cases
  expect(is_local_mcp_url("http://127.0.0.1:9000/mcp"), "valid 127.0.0.1")
  expect(is_local_mcp_url("http://localhost:8080/mcp"), "valid localhost")
  expect(is_local_mcp_url("http://[::1]:4321/mcp"), "valid [::1]")
  expect(!is_local_mcp_url("http://127.0.0.1:1@evil.com/mcp"), "userinfo @ bypass rejected")
  expect(!is_local_mcp_url("http://localhost@evil.com/mcp"), "localhost@ bypass rejected")
  expect(!is_local_mcp_url("http://[::1]@evil.com/mcp"), "[::1]@ bypass rejected")
  expect(!is_local_mcp_url("http://127.0.0.1.evil.com/mcp"), "subdomain prefix bypass rejected")
  expect(!is_local_mcp_url("http://127.0.0.1:99999/mcp"), "out-of-range port rejected")
  expect(!is_local_mcp_url("https://127.0.0.1:9000/mcp"), "non-http scheme rejected")
}

test "review R2: invalid UUID rejection, byte-for-byte session_instructions parity, and Hermes resume session_hermes_home" {
  // P1-1: build_claude_launch and build_pi_launch reject non-UUID-v4 from injected next_uuid
  let p_cl = make_profile("p-cl", Some(RuntimeKind::Claude), "/homes/cl", true, false, None, AccessKind::Subscription, "", None, None, [], None)
  let bad_cl = OpenOptions::{ ..test_opts("chat:bad", p_cl, "/ws/1", "http://127.0.0.1:9000/mcp", "tok-1"), next_uuid: fn() -> String { "sess-not-a-uuid" } }
  match build_claude_launch(bad_cl) {
    Ok(_) => panic("claude must reject invalid UUID from next_uuid")
    Err(_) => ()
  }
  let p_pi = make_profile("p-pi", Some(RuntimeKind::Pi), "/homes/pi", true, false, Some("deepseek-r2"), AccessKind::OpencodeGo, "ocg-key", None, None, [], None)
  let bad_pi = OpenOptions::{ ..test_opts("chat:bad", p_pi, "/ws/1", "http://127.0.0.1:9000/mcp", "tok-1"), next_uuid: fn() -> String { "not-a-uuid" } }
  match build_pi_launch(bad_pi) {
    Ok(_) => panic("pi must reject invalid UUID from next_uuid")
    Err(_) => ()
  }

  // P1-2: byte-for-byte parity with TS station/src/agents/instructions.ts (project, site, station, projects, person, move=false)
  let out1 = session_instructions(
    "/ws/1",
    Some("/repo/app"),
    "/repos",
    "/mem/MEMORY.md",
    "<memory>hi</memory>",
    "Site note here.",
    "gt1",
    false,
    true,
    "alice@example.com",
  )
  let len1 = out1.to_bytes().length()
  let sha1 = crypto::sha256_hex(out1.to_bytes())
  expect(len1 == 9631, "out1 byte length must match TS 9631, got " + len1.to_string())
  expect(
    sha1 == "b87810f8a42d18e0c6d6df86e55b0a70e712f6a62a07f5f8cd6411c362874e90",
    "out1 sha256 must match TS instructions.ts exactly, got " + sha1,
  )
  let out2 = session_instructions("/ws/2", None, "/repos", "/mem/MEMORY.md", "", "", "", true, false, "")
  let len2 = out2.to_bytes().length()
  let sha2 = crypto::sha256_hex(out2.to_bytes())
  expect(len2 == 8505, "out2 byte length must match TS 8505, got " + len2.to_string())
  expect(
    sha2 == "8bbe2f44f87c8b2b1902bf9717eb1d75528418d0c37e282a925bd9a3af4e4e94",
    "out2 sha256 must match TS instructions.ts exactly, got " + sha2,
  )

  // P2-2: build_hermes_launch wires session_hermes_home on resume
  let p_hm = make_profile(
    "p-hm",
    Some(RuntimeKind::Hermes),
    "/homes/hm",
    true,
    false,
    None,
    AccessKind::Subscription,
    "",
    None,
    None,
    [("HERMES_HOME", "/new/configured/hermes")],
    None,
  )
  let hm_resume = OpenOptions::{
    ..test_opts("chat:hm-r", p_hm, "/ws/1", "http://127.0.0.1:9000/mcp", "tok-1"),
    resume: Some("sess_42"),
    hermes_header_line: Some("{\"type\":\"session\",\"hermesHome\":\"~/orig-hermes\"}"),
  }
  let s_hm = match build_hermes_launch(hm_resume) {
    Ok(s) => s
    Err(e) => panic(e)
  }
  expect(opt_str_eq(env_get(s_hm.env, "HERMES_HOME"), Some("/home/tester/orig-hermes")), "resumed hermes uses transcript hermesHome expanded via home_dir")
  expect(opt_str_eq(env_get(s_hm.env, "CLAUDE_CONFIG_DIR"), Some("/home/tester/orig-hermes/claude")), "resumed hermes derives CLAUDE_CONFIG_DIR from resumed HERMES_HOME")
  expect(opt_str_eq(env_get(s_hm.env, "CODEX_HOME"), Some("/home/tester/orig-hermes/codex")), "resumed hermes derives CODEX_HOME from resumed HERMES_HOME")

  // Legacy transcript without hermesHome falls back to profile's private home, not new profile HERMES_HOME
  let hm_legacy = OpenOptions::{
    ..test_opts("chat:hm-l", p_hm, "/ws/1", "http://127.0.0.1:9000/mcp", "tok-1"),
    resume: Some("sess_41"),
    hermes_header_line: Some("{\"type\":\"session\"}"),
  }
  let s_hm_legacy = match build_hermes_launch(hm_legacy) {
    Ok(s) => s
    Err(e) => panic(e)
  }
  expect(opt_str_eq(env_get(s_hm_legacy.env, "HERMES_HOME"), Some("/homes/hm/hermes")), "legacy resumed hermes falls back to private home")

  // Resume without transcript header fails
  let hm_missing = OpenOptions::{
    ..test_opts("chat:hm-m", p_hm, "/ws/1", "http://127.0.0.1:9000/mcp", "tok-1"),
    resume: Some("sess_40"),
    hermes_header_line: None,
  }
  match build_hermes_launch(hm_missing) {
    Ok(_) => panic("resumed hermes without transcript header must fail")
    Err(_) => ()
  }
}
