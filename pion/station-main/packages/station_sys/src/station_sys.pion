/// Idempotently register deterministic SQLite scalar function `js_lower(x)` (1:1 with `jscase::lower`)
/// via `sqlite3_auto_extension` before opening SQLite connections.
pub fn register_sqlite_js_lower() -> Result[Unit, String] {
  let rc = sts_register_sqlite_js_lower()
  if rc == 0 {
    Ok(())
  } else {
    Err("sqlite3_auto_extension(js_lower) failed with rc=" + rc.to_string())
  }
}

pub enum TunnelResolveResult {
  Allowed(String)
  BlockedLoopback
  NeedsAsyncDns
  Failed
}

/// Pure user-space literal IP / `localhost` resolution for `device:` tunnel dialing
/// (0 syscalls, 0 FDs, never blocks). Returns `NeedsAsyncDns` for non-literal hostnames.
pub fn resolve_host_for_tunnel(
  host : String,
  reject_loopback_or_unspec : Bool,
) -> TunnelResolveResult {
  let cap = 128
  let buf = ptr_alloc(cap.to_int64())
  ptr_write_i64(buf, 0L, 0L)
  let rc = sts_resolve_host_for_tunnel(
    host.as_cstr(),
    if reject_loopback_or_unspec { 1 } else { 0 },
    buf,
    cap.to_int64(),
  )
  let _ = host.length()
  if rc == 1 {
    let ip = read_cstr_from_buf(buf, cap)
    sts_free(buf)
    TunnelResolveResult::Allowed(ip)
  } else {
    sts_free(buf)
    if rc == -2 {
      TunnelResolveResult::BlockedLoopback
    } else if rc == 0 {
      TunnelResolveResult::NeedsAsyncDns
    } else {
      TunnelResolveResult::Failed
    }
  }
}

/// Spawn a detached worker thread to resolve a non-literal hostname via OS `getaddrinfo`.
/// Emits `SysEvent::DnsResolved(rc, ip)` (`rc == 1` allowed, `-2` blocked loopback/unspec, `-1` error).
pub fn resolve_host_for_tunnel_async(
  event_id : Int64,
  host : String,
  reject_loopback_or_unspec : Bool,
) -> Bool {
  let ok = sts_resolve_host_for_tunnel_async(
    event_id,
    host.as_cstr(),
    if reject_loopback_or_unspec { 1 } else { 0 },
  )
  let _ = host.length()
  ok != 0
}

/// Replace the current process in-place:
/// - Unix: `execv(program, argv)` preserving PID, PGID, signal mask, and inherited launcher FDs (3/4/5).
/// - Windows: `CreateProcessW` with `bInheritHandles=TRUE` inside a `KILL_ON_JOB_CLOSE | SILENT_BREAKAWAY_OK`
///   Job Object, waiting for exit and returning the child's exit code.
/// Returns 127 on failure.
pub fn exec_replace(program : String, argv : Array[String]) -> Int {
  let raw = encode_nul_list(argv)
  let rc = sts_exec_replace(
    program.as_cstr(),
    bytes_data_ptr(raw),
    raw.length().to_int64(),
  )
  let _ = program.length()
  let _ = raw.length()
  rc
}
