pub fn env_all() -> Array[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_env_all(out_len)
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  if ptr_is_null(p) || n <= 0.to_int64() {
    if !ptr_is_null(p) {
      sts_free(p)
    }
    return []
  }
  let raw = bytes_from_ptr(p, n.to_int())
  sts_free(p)
  decode_nul_list(raw)
}

pub fn env_get(name : String) -> Option[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_env_get(name.as_cstr(), out_len)
  let _ = name.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  take_owned_string(p, n)
}

pub fn env_set(name : String, value : String) -> Bool {
  let ok = sts_env_set(name.as_cstr(), value.as_cstr())
  let _ = name.length()
  let _ = value.length()
  ok != 0
}

pub fn env_unset(name : String) -> Bool {
  let ok = sts_env_unset(name.as_cstr())
  let _ = name.length()
  ok != 0
}

pub fn is_executable(path : String) -> Bool {
  let ok = sts_is_executable(path.as_cstr())
  let _ = path.length()
  ok != 0
}

