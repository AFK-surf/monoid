// ---------------------------------------------------------------------------
// Portable constants
// ---------------------------------------------------------------------------

pub let SIG_PROBE : Int = 0
pub let SIG_HUP : Int = 1
pub let SIG_INT : Int = 2
pub let SIG_KILL : Int = 9
pub let SIG_TERM : Int = 15
pub let SIG_USR1 : Int = 101
pub let SIG_USR2 : Int = 102
pub let SIG_STOP : Int = 103
pub let SIG_CONT : Int = 104

pub let ERR_NETUNREACH : Int = -101
pub let ERR_HOSTUNREACH : Int = -113

pub let PROC_NEW_PGID : Int = 1
pub let PROC_STRIP_MALLOC_SE : Int = 2
pub let PROC_PIPE_STDIN : Int = 4
pub let PROC_PIPE_STDOUT : Int = 8
pub let PROC_PIPE_STDERR : Int = 16
pub let PROC_EXPLICIT_ENV : Int = 32

// ---------------------------------------------------------------------------
// Decoded system events (from `HostEvent::Sys(id, payload)`)
// ---------------------------------------------------------------------------

pub enum FsChangeKind {
  Rename
  Change
  Overflow
  Error
}

pub struct ExitStatus {
  pub code : Int
  pub signal : Int
  pub signal_name : String
}

pub struct UdpPacket {
  pub addr : String
  pub port : Int
  pub data : Bytes
}

pub enum SysEvent {
  FsChange(FsChangeKind, String)
  FsClosed
  ProcStdout(Bytes)
  ProcStderr(Bytes)
  ProcStdoutEof
  ProcStderrEof
  ProcExit(ExitStatus)
  CtrlLine(String)
  CtrlEof
  Signal(Int, String)
  PtyData(Bytes)
  PtyEof
  PtyExit(ExitStatus)
  UdpRecv(UdpPacket)
  UdpClosed
  DnsResolved(Int, String)
}

// ---------------------------------------------------------------------------
// Pure binary / NUL encoding & decoding helpers (unit-tested in Pion)
// ---------------------------------------------------------------------------

fn bytes_to_str(b : Bytes) -> String {
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

fn slice_bytes(b : Bytes, start : Int, len : Int) -> Bytes {
  if len <= 0 || start < 0 || start >= b.length() {
    return Bytes::new(0)
  }
  let end = if start + len > b.length() { b.length() } else { start + len }
  let actual = end - start
  let out = Bytes::new(actual)
  for i in 0..<actual {
    out[i] = b[start + i]
  }
  out
}

fn read_u16_le(b : Bytes, off : Int) -> Int {
  let b0 = b[off].to_int() & 0xFF
  let b1 = b[off + 1].to_int() & 0xFF
  b0 | (b1 << 8)
}

fn read_i32_le(b : Bytes, off : Int) -> Int {
  let b0 = b[off].to_int() & 0xFF
  let b1 = b[off + 1].to_int() & 0xFF
  let b2 = b[off + 2].to_int() & 0xFF
  let b3 = b[off + 3].to_int() & 0xFF
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

pub fn encode_nul_list(items : Array[String]) -> Bytes {
  let mut total = 0
  let parts : Array[Bytes] = []
  for i in 0..<items.length() {
    let raw = items[i].to_bytes()
    parts.push(raw)
    total = total + raw.length() + 1
  }
  let out = Bytes::new(total)
  let mut pos = 0
  for i in 0..<parts.length() {
    let raw = parts[i]
    for j in 0..<raw.length() {
      out[pos] = raw[j]
      pos = pos + 1
    }
    out[pos] = 0 as Byte
    pos = pos + 1
  }
  out
}

pub fn decode_nul_list(raw : Bytes) -> Array[String] {
  host_shim::split_nul_args(raw)
}

pub fn pack_i32_le_array(values : Array[Int]) -> Bytes {
  let out = Bytes::new(values.length() * 4)
  for i in 0..<values.length() {
    let v = values[i]
    let off = i * 4
    out[off] = (v & 0xFF) as Byte
    out[off + 1] = ((v >> 8) & 0xFF) as Byte
    out[off + 2] = ((v >> 16) & 0xFF) as Byte
    out[off + 3] = ((v >> 24) & 0xFF) as Byte
  }
  out
}

pub fn decode_sys_event(payload : Bytes) -> Option[SysEvent] {
  let n = payload.length()
  if n < 1 {
    return None
  }
  let tag = payload[0].to_int() & 0xFF
  if tag == 1 {
    if n < 2 {
      return None
    }
    let k = payload[1].to_int() & 0xFF
    let kind = if k == 0 {
      FsChangeKind::Error
    } else if k == 1 {
      FsChangeKind::Rename
    } else if k == 2 {
      FsChangeKind::Change
    } else if k == 3 {
      FsChangeKind::Overflow
    } else {
      return None
    }
    let name = bytes_to_str(slice_bytes(payload, 2, n - 2))
    Some(SysEvent::FsChange(kind, name))
  } else if tag == 2 {
    if n != 1 {
      return None
    }
    Some(SysEvent::FsClosed)
  } else if tag == 10 {
    Some(SysEvent::ProcStdout(slice_bytes(payload, 1, n - 1)))
  } else if tag == 11 {
    Some(SysEvent::ProcStderr(slice_bytes(payload, 1, n - 1)))
  } else if tag == 12 {
    if n != 1 {
      return None
    }
    Some(SysEvent::ProcStdoutEof)
  } else if tag == 13 {
    if n != 1 {
      return None
    }
    Some(SysEvent::ProcStderrEof)
  } else if tag == 14 {
    if n < 9 {
      return None
    }
    let code = read_i32_le(payload, 1)
    let sig = read_i32_le(payload, 5)
    let sname = bytes_to_str(slice_bytes(payload, 9, n - 9))
    Some(SysEvent::ProcExit(ExitStatus::{ code: code, signal: sig, signal_name: sname }))
  } else if tag == 20 {
    Some(SysEvent::CtrlLine(bytes_to_str(slice_bytes(payload, 1, n - 1))))
  } else if tag == 21 {
    if n != 1 {
      return None
    }
    Some(SysEvent::CtrlEof)
  } else if tag == 30 {
    if n < 5 {
      return None
    }
    let sig = read_i32_le(payload, 1)
    let sname = bytes_to_str(slice_bytes(payload, 5, n - 5))
    Some(SysEvent::Signal(sig, sname))
  } else if tag == 40 {
    Some(SysEvent::PtyData(slice_bytes(payload, 1, n - 1)))
  } else if tag == 41 {
    if n != 1 {
      return None
    }
    Some(SysEvent::PtyEof)
  } else if tag == 42 {
    if n < 9 {
      return None
    }
    let code = read_i32_le(payload, 1)
    let sig = read_i32_le(payload, 5)
    let sname = bytes_to_str(slice_bytes(payload, 9, n - 9))
    Some(SysEvent::PtyExit(ExitStatus::{ code: code, signal: sig, signal_name: sname }))
  } else if tag == 50 {
    if n < 5 {
      return None
    }
    let port = read_u16_le(payload, 1)
    let alen = read_u16_le(payload, 3)
    if 5 + alen > n {
      return None
    }
    let addr = bytes_to_str(slice_bytes(payload, 5, alen))
    let data = slice_bytes(payload, 5 + alen, n - (5 + alen))
    Some(SysEvent::UdpRecv(UdpPacket::{ addr: addr, port: port, data: data }))
  } else if tag == 51 {
    if n != 1 {
      return None
    }
    Some(SysEvent::UdpClosed)
  } else if tag == 60 {
    if n < 5 {
      return None
    }
    let rc = read_i32_le(payload, 1)
    let ip = bytes_to_str(slice_bytes(payload, 5, n - 5))
    Some(SysEvent::DnsResolved(rc, ip))
  } else {
    None
  }
}

// ---------------------------------------------------------------------------
// Internal FFI buffer reader helper
// ---------------------------------------------------------------------------

fn take_owned_string(p : Ptr, n : Int64) -> Option[String] {
  if ptr_is_null(p) {
    return None
  }
  if n <= 0.to_int64() {
    sts_free(p)
    return Some("")
  }
  let raw = bytes_from_ptr(p, n.to_int())
  sts_free(p)
  Some(bytes_to_str(raw))
}

fn read_cstr_from_buf(p : Ptr, cap : Int) -> String {
  let raw = bytes_from_ptr(p, cap)
  let sb = StringBuilder::new()
  for i in 0..<raw.length() {
    if raw[i].to_int() == 0 {
      break
    }
    sb.write_byte(raw[i])
  }
  sb.to_string()
}

// ---------------------------------------------------------------------------
// 1. Non-recursive directory fs.watch
// ---------------------------------------------------------------------------

pub struct FsWatchHandle {
  pub id : Int64
}

pub fn fs_watch_open(event_id : Int64, dir_path : String) -> Option[FsWatchHandle] {
  let h = sts_fs_watch_open(event_id, dir_path.as_cstr())
  let _ = dir_path.length()
  if h > 0.to_int64() {
    Some(FsWatchHandle::{ id: h })
  } else {
    None
  }
}

pub fn FsWatchHandle::close(self : FsWatchHandle) -> Bool {
  sts_fs_watch_close(self.id) != 0
}

// ---------------------------------------------------------------------------
// 2. Async child process manager
// ---------------------------------------------------------------------------

pub struct SpawnOptions {
  pub program : String
  pub args : Array[String]
  pub env : Option[Array[String]]
  pub cwd : String
  pub new_pgid : Bool
  pub strip_malloc_space_efficient : Bool
  pub pipe_stdin : Bool
  pub pipe_stdout : Bool
  pub pipe_stderr : Bool
}

pub struct ChildProcess {
  pub handle : Int64
  pub pid : Int
}

pub fn spawn_flags(opts : SpawnOptions) -> Int {
  let mut f = 0
  if opts.new_pgid {
    f = f | PROC_NEW_PGID
  }
  if opts.strip_malloc_space_efficient {
    f = f | PROC_STRIP_MALLOC_SE
  }
  if opts.pipe_stdin {
    f = f | PROC_PIPE_STDIN
  }
  if opts.pipe_stdout {
    f = f | PROC_PIPE_STDOUT
  }
  if opts.pipe_stderr {
    f = f | PROC_PIPE_STDERR
  }
  match opts.env {
    Some(_) => {
      f = f | PROC_EXPLICIT_ENV
    }
    None => ()
  }
  f
}

pub fn proc_spawn(event_id : Int64, opts : SpawnOptions) -> Result[ChildProcess, String] {
  let args_buf = encode_nul_list(opts.args)
  let env_buf = match opts.env {
    Some(pairs) => encode_nul_list(pairs)
    None => Bytes::new(0)
  }
  let out_pid = ptr_alloc(8.to_int64())
  ptr_write_i64(out_pid, 0.to_int64(), 0.to_int64())
  let err_cap = 256
  let err_buf = ptr_alloc(err_cap.to_int64())
  let flags = spawn_flags(opts)

  let h = sts_proc_spawn(
    event_id,
    opts.program.as_cstr(),
    bytes_data_ptr(args_buf),
    args_buf.length().to_int64(),
    bytes_data_ptr(env_buf),
    env_buf.length().to_int64(),
    opts.cwd.as_cstr(),
    flags,
    out_pid,
    err_buf,
    err_cap.to_int64(),
  )
  let _ = opts.program.length()
  let _ = opts.cwd.length()
  let _ = args_buf.length()
  let _ = env_buf.length()

  let pid = ptr_read_i64(out_pid, 0.to_int64()).to_int()
  sts_free(out_pid)
  if h <= 0.to_int64() {
    let msg = read_cstr_from_buf(err_buf, err_cap)
    sts_free(err_buf)
    return Err(if msg.length() > 0 { msg } else { "spawn failed" })
  }
  sts_free(err_buf)
  Ok(ChildProcess::{ handle: h, pid: pid })
}

pub fn ChildProcess::write_stdin(self : ChildProcess, data : Bytes) -> Bool {
  if data.length() == 0 {
    return true
  }
  let ok = sts_proc_write_stdin(self.handle, bytes_data_ptr(data), data.length().to_int64())
  let _ = data.length()
  ok != 0
}

pub fn ChildProcess::close_stdin(self : ChildProcess) -> Bool {
  sts_proc_close_stdin(self.handle) != 0
}

pub fn ChildProcess::kill(self : ChildProcess, sig : Int, group : Bool) -> Int {
  sts_proc_kill_handle(self.handle, sig, if group { 1 } else { 0 })
}

pub fn ChildProcess::close(self : ChildProcess) -> Bool {
  sts_proc_close(self.handle) != 0
}

pub fn proc_kill(pid : Int, sig : Int, group : Bool) -> Int {
  sts_proc_kill(pid, sig, if group { 1 } else { 0 })
}

pub fn proc_start_time_ms(pid : Int) -> Option[Int64] {
  let ms = sts_proc_start_time_ms(pid)
  if ms < 0.to_int64() { None } else { Some(ms) }
}

pub fn proc_start_ticks(pid : Int) -> Option[Int64] {
  let t = sts_proc_start_ticks(pid)
  if t < 0.to_int64() { None } else { Some(t) }
}

pub fn boot_id() -> Option[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_boot_id(out_len)
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  take_owned_string(p, n)
}

// ---------------------------------------------------------------------------
// 3. Launcher control channel
// ---------------------------------------------------------------------------

pub struct CtrlChannel {
  pub handle : Int64
}

pub fn ctrl_open_fd(event_id : Int64, fd : Int) -> Option[CtrlChannel] {
  let h = sts_ctrl_open_fd(event_id, fd)
  if h > 0.to_int64() { Some(CtrlChannel::{ handle: h }) } else { None }
}

pub fn ctrl_open_pipe(event_id : Int64, pipe_name : String) -> Option[CtrlChannel] {
  let h = sts_ctrl_open_pipe(event_id, pipe_name.as_cstr())
  let _ = pipe_name.length()
  if h > 0.to_int64() { Some(CtrlChannel::{ handle: h }) } else { None }
}

pub fn CtrlChannel::write(self : CtrlChannel, data : Bytes) -> Bool {
  if data.length() == 0 {
    return true
  }
  let ok = sts_ctrl_write(self.handle, bytes_data_ptr(data), data.length().to_int64())
  let _ = data.length()
  ok != 0
}

pub fn CtrlChannel::write_line(self : CtrlChannel, line : String) -> Bool {
  self.write((line + "\n").to_bytes())
}

pub fn CtrlChannel::close(self : CtrlChannel) -> Bool {
  sts_ctrl_close(self.handle) != 0
}

// ---------------------------------------------------------------------------
// 4. Process signals
// ---------------------------------------------------------------------------

pub fn signal_watch(event_id : Int64) -> Bool {
  sts_signal_watch(event_id) != 0
}

pub fn signal_unwatch() -> Bool {
  sts_signal_unwatch() != 0
}

// ---------------------------------------------------------------------------
// 5. Advisory file lock
// ---------------------------------------------------------------------------

pub struct FlockHandle {
  pub handle : Int64
}

pub enum FlockResult {
  Acquired(FlockHandle)
  Busy
  Error
}

pub fn flock_try(path : String) -> FlockResult {
  let h = sts_flock_try(path.as_cstr())
  let _ = path.length()
  if h > 0.to_int64() {
    FlockResult::Acquired(FlockHandle::{ handle: h })
  } else if h == 0.to_int64() {
    FlockResult::Busy
  } else {
    FlockResult::Error
  }
}

pub fn FlockHandle::unlock(self : FlockHandle) -> Bool {
  sts_flock_unlock(self.handle) != 0
}

pub fn unlink(path : String) -> Bool {
  let ok = sts_unlink(path.as_cstr())
  let _ = path.length()
  ok != 0
}

pub fn rmdir(path : String) -> Bool {
  let ok = sts_rmdir(path.as_cstr())
  let _ = path.length()
  ok != 0
}

pub fn readlink(path : String) -> Option[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_readlink(path.as_cstr(), out_len)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  take_owned_string(p, n)
}

pub fn realpath(path : String) -> Option[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_realpath(path.as_cstr(), out_len)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  take_owned_string(p, n)
}

pub fn lstat_raw(path : String) -> Option[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_lstat(path.as_cstr(), out_len)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  take_owned_string(p, n)
}

pub fn chmod(path : String, mode : Int) -> Bool {
  let ok = sts_chmod(path.as_cstr(), mode)
  let _ = path.length()
  ok != 0
}

pub fn truncate_in_place(path : String, size : Int64 = 0.to_int64()) -> Bool {
  let ok = sts_truncate_in_place(path.as_cstr(), size)
  let _ = path.length()
  ok != 0
}

pub fn read_range(path : String, offset : Int64, len : Int64) -> Option[Bytes] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_read_range(path.as_cstr(), offset, len, out_len)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  if ptr_is_null(p) {
    return None
  }
  if n <= 0.to_int64() {
    sts_free(p)
    return Some(Bytes::new(0))
  }
  let raw = bytes_from_ptr(p, n.to_int())
  sts_free(p)
  Some(raw)
}

pub fn write_file_mode(
  path : String,
  data : Bytes,
  mode : Int = 384,
  append : Bool = false,
) -> Bool {
  let ok = sts_write_file_mode(
    path.as_cstr(),
    bytes_data_ptr(data),
    data.length().to_int64(),
    mode,
    if append { 1 } else { 0 },
  )
  let _ = path.length()
  let _ = data.length()
  ok != 0
}

/// FD-level TOCTOU-safe read under `root` (`openat(..., O_NOFOLLOW | O_DIRECTORY)` + `fstat` regular check).
/// Returns `Some((chunk, total_file_size))` or `None` on symlink/traversal/non-regular/error.
pub fn read_under_nofollow(
  root : String,
  rel : String,
  offset : Int64,
  len : Int64,
) -> Option[(Bytes, Int64)] {
  let out_len = ptr_alloc(8.to_int64())
  let out_size = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_size, 0.to_int64(), 0.to_int64())
  let p = sts_read_under_nofollow(root.as_cstr(), rel.as_cstr(), offset, len, out_len, out_size)
  let _ = root.length()
  let _ = rel.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  let sz = ptr_read_i64(out_size, 0.to_int64())
  sts_free(out_len)
  sts_free(out_size)
  if ptr_is_null(p) {
    return None
  }
  if n <= 0.to_int64() {
    sts_free(p)
    return Some((Bytes::new(0), sz))
  }
  let raw = bytes_from_ptr(p, n.to_int())
  sts_free(p)
  Some((raw, sz))
}

/// FD-level TOCTOU-safe write under `root` (`openat(..., O_NOFOLLOW | O_DIRECTORY)` + `fstat` regular check).
/// Returns `1` on success, `-2` on offset mismatch (`offset > 0 && offset != size`), `0` on error.
pub fn write_under_nofollow(
  root : String,
  rel : String,
  data : Bytes,
  offset : Int64,
  mode : Int = 384,
  truncate_end : Bool = true,
) -> Int {
  let rc = sts_write_under_nofollow(
    root.as_cstr(),
    rel.as_cstr(),
    bytes_data_ptr(data),
    data.length().to_int64(),
    offset,
    mode,
    if truncate_end { 1 } else { 0 },
  )
  let _ = root.length()
  let _ = rel.length()
  let _ = data.length()
  rc
}

pub fn read_dir(path : String) -> Option[Array[String]] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_read_dir(path.as_cstr(), out_len)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  if ptr_is_null(p) {
    return None
  }
  if n <= 0.to_int64() {
    sts_free(p)
    return Some([])
  }
  let raw = bytes_from_ptr(p, n.to_int())
  sts_free(p)
  Some(decode_nul_list(raw))
}

pub fn mkdir_p(path : String) -> Bool {
  let ok = sts_mkdir_p(path.as_cstr())
  let _ = path.length()
  ok != 0
}

pub fn mkdir_exclusive(path : String) -> Bool {
  let ok = sts_mkdir_exclusive(path.as_cstr())
  let _ = path.length()
  ok != 0
}

pub enum MkdirModeResult {
  Ok
  AlreadyExists
  PermissionDenied
  NotFound
  Error
}

pub fn mkdir_mode(path : String, mode : Int = 448) -> MkdirModeResult {
  let rc = sts_mkdir_mode(path.as_cstr(), mode)
  let _ = path.length()
  if rc == 1 {
    MkdirModeResult::Ok
  } else if rc == -2 {
    MkdirModeResult::AlreadyExists
  } else if rc == -3 {
    MkdirModeResult::PermissionDenied
  } else if rc == -4 {
    MkdirModeResult::NotFound
  } else {
    MkdirModeResult::Error
  }
}

pub fn symlink(target : String, link_path : String, is_dir : Bool = false) -> Bool {
  let ok = sts_symlink(target.as_cstr(), link_path.as_cstr(), if is_dir { 1 } else { 0 })
  let _ = target.length()
  let _ = link_path.length()
  ok != 0
}

pub fn is_dir_symlink(path : String) -> Bool {
  let ok = sts_is_dir_symlink(path.as_cstr())
  let _ = path.length()
  ok != 0
}

pub fn getcwd() -> Option[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_getcwd(out_len)
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  take_owned_string(p, n)
}

pub enum StrictReadErr {
  NotFound
  PermissionDenied
  Other
}

pub fn read_file_strict(path : String) -> Result[Bytes, StrictReadErr] {
  let out_len = ptr_alloc(8.to_int64())
  let out_err = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_err, 0.to_int64(), 0.to_int64())
  let p = sts_read_file_strict(path.as_cstr(), out_len, out_err)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  let err_code = (ptr_read_i64(out_err, 0.to_int64()) & 0xFFFFFFFFL).to_int()
  sts_free(out_len)
  sts_free(out_err)
  if ptr_is_null(p) {
    if err_code == 1 {
      return Err(StrictReadErr::NotFound)
    } else if err_code == 2 {
      return Err(StrictReadErr::PermissionDenied)
    }
    return Err(StrictReadErr::Other)
  }
  if n <= 0.to_int64() {
    sts_free(p)
    return Ok(Bytes::new(0))
  }
  let raw = bytes_from_ptr(p, n.to_int())
  sts_free(p)
  Ok(raw)
}

pub fn write_file_atomic(path : String, data : Bytes, mode : Int = 384) -> Bool {
  let ok = sts_write_file_atomic(
    path.as_cstr(),
    bytes_data_ptr(data),
    data.length().to_int64(),
    mode,
  )
  let _ = path.length()
  let _ = data.length()
  ok != 0
}
pub fn rename(old_path : String, new_path : String) -> Bool {
  let ok = sts_rename(old_path.as_cstr(), new_path.as_cstr())
  let _ = old_path.length()
  let _ = new_path.length()
  ok != 0
}

pub fn stat_raw(path : String) -> Option[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_stat(path.as_cstr(), out_len)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  take_owned_string(p, n)
}

pub fn stat_raw_err(path : String) -> Result[String, Int] {
  let out_len = ptr_alloc(8.to_int64())
  let out_err = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_err, 0.to_int64(), 0.to_int64())
  let p = sts_stat_err(path.as_cstr(), out_len, out_err)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  let err_i = ptr_read_i32(out_err, 0.to_int64())
  sts_free(out_len)
  sts_free(out_err)
  match take_owned_string(p, n) {
    Some(s) => Ok(s)
    None => Err(if err_i != 0 { err_i } else { -1 })
  }
}

pub fn lstat_raw_err(path : String) -> Result[String, Int] {
  let out_len = ptr_alloc(8.to_int64())
  let out_err = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_err, 0.to_int64(), 0.to_int64())
  let p = sts_lstat_err(path.as_cstr(), out_len, out_err)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  let err_i = ptr_read_i32(out_err, 0.to_int64())
  sts_free(out_len)
  sts_free(out_err)
  match take_owned_string(p, n) {
    Some(s) => Ok(s)
    None => Err(if err_i != 0 { err_i } else { -1 })
  }
}

pub fn realpath_err(path : String) -> Result[String, Int] {
  let out_len = ptr_alloc(8.to_int64())
  let out_err = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_err, 0.to_int64(), 0.to_int64())
  let p = sts_realpath_err(path.as_cstr(), out_len, out_err)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  let err_i = ptr_read_i32(out_err, 0.to_int64())
  sts_free(out_len)
  sts_free(out_err)
  match take_owned_string(p, n) {
    Some(s) => Ok(s)
    None => Err(if err_i != 0 { err_i } else { -1 })
  }
}

/// Real POSIX `getuid()`, or `-1` on Windows.
pub fn getuid() -> Int {
  sts_getuid()
}

/// Real POSIX `geteuid()`, or `-1` on Windows.
pub fn geteuid() -> Int {
  sts_geteuid()
}

/// Positioned range read (`pread` / `ReadFile`+`OVERLAPPED`) returning `(bytes, total_size, mtime_ms)`
/// or error code (`-2` ENOENT, `-3` EACCES, `-4` EISDIR, `-1` IO).
pub fn read_range_meta(path : String, offset : Int64, len : Int64) -> Result[(Bytes, Int64, Int64), Int] {
  let out_len = ptr_alloc(8.to_int64())
  let out_total = ptr_alloc(8.to_int64())
  let out_mtime = ptr_alloc(8.to_int64())
  let out_err = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_total, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_mtime, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_err, 0.to_int64(), 0.to_int64())
  let p = sts_read_range_meta(path.as_cstr(), offset, len, out_len, out_total, out_mtime, out_err)
  let _ = path.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  let total = ptr_read_i64(out_total, 0.to_int64())
  let mtime = ptr_read_i64(out_mtime, 0.to_int64())
  let err_i = ptr_read_i32(out_err, 0.to_int64())
  sts_free(out_len)
  sts_free(out_total)
  sts_free(out_mtime)
  sts_free(out_err)
  if ptr_is_null(p) {
    return Err(if err_i != 0 { err_i } else { -1 })
  }
  if n <= 0.to_int64() {
    sts_free(p)
    return Ok((Bytes::new(0), total, mtime))
  }
  let raw = bytes_from_ptr(p, n.to_int())
  sts_free(p)
  Ok((raw, total, mtime))
}

/// Positioned write (`pwrite`+`ftruncate`+`fsync` / `WriteFile`+`OVERLAPPED`+`SetEndOfFile`+`FlushFileBuffers`).
/// Returns `Ok((size_after, short))` or `Err(code)` (`-2` ENOENT, `-3` EACCES, `-4` EISDIR, `-1` IO).
pub fn write_at(
  path : String,
  offset : Int64,
  data : Bytes,
  create : Bool,
  at_least : Option[Int64],
  truncate_to : Option[Int64],
  sync : Bool,
) -> Result[(Int64, Bool), Int] {
  let out_size = ptr_alloc(8.to_int64())
  let out_short = ptr_alloc(8.to_int64())
  ptr_write_i64(out_size, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_short, 0.to_int64(), 0.to_int64())
  let (has_al, al_val) = match at_least {
    Some(v) => (1, v)
    None => (0, 0.to_int64())
  }
  let (has_tr, tr_val) = match truncate_to {
    Some(v) => (1, v)
    None => (0, 0.to_int64())
  }
  let rc = sts_write_at(
    path.as_cstr(),
    offset,
    bytes_data_ptr(data),
    data.length().to_int64(),
    if create { 1 } else { 0 },
    has_al,
    al_val,
    has_tr,
    tr_val,
    if sync { 1 } else { 0 },
    out_size,
    out_short,
  )
  let _ = path.length()
  let _ = data.length()
  let sz = ptr_read_i64(out_size, 0.to_int64())
  let is_short = ptr_read_i32(out_short, 0.to_int64()) != 0
  sts_free(out_size)
  sts_free(out_short)
  if rc != 0 {
    return Err(rc)
  }
  Ok((sz, is_short))
}

/// Real `fsync` / `FlushFileBuffers` on a file path.
pub fn sync_file(path : String) -> Result[Unit, Int] {
  let rc = sts_sync_file(path.as_cstr())
  let _ = path.length()
  if rc != 0 {
    return Err(rc)
  }
  Ok(())
}

/// Single-open read-only file handle (POSIX `O_RDONLY|O_NOFOLLOW|O_NONBLOCK` + `S_ISREG`,
/// Windows `FILE_FLAG_OPEN_REPARSE_POINT` + `FILE_TYPE_DISK` + non-surrogate check) for
/// tear-free chunked streaming reads across concurrent atomic renames.
pub struct ReadOnlyFile {
  pub handle : Int64
  pub size : Int64
}

pub fn file_open_ro(path : String) -> Result[ReadOnlyFile, Int] {
  let out_size = ptr_alloc(8.to_int64())
  let out_err = ptr_alloc(8.to_int64())
  ptr_write_i64(out_size, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_err, 0.to_int64(), 0.to_int64())
  let h = sts_file_open_ro(path.as_cstr(), out_size, out_err)
  let _ = path.length()
  let sz = ptr_read_i64(out_size, 0.to_int64())
  let err = ptr_read_i32(out_err, 0.to_int64())
  sts_free(out_size)
  sts_free(out_err)
  if h <= 0.to_int64() || err != 0 {
    return Err(if err != 0 { err } else { -1 })
  }
  Ok(ReadOnlyFile::{ handle: h, size: sz })
}

pub fn ReadOnlyFile::pread(self : ReadOnlyFile, offset : Int64, len : Int64) -> Result[Bytes, Int] {
  let out_len = ptr_alloc(8.to_int64())
  let out_err = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  ptr_write_i64(out_err, 0.to_int64(), 0.to_int64())
  let p = sts_file_pread(self.handle, offset, len, out_len, out_err)
  let n = ptr_read_i64(out_len, 0.to_int64())
  let err = ptr_read_i32(out_err, 0.to_int64())
  sts_free(out_len)
  sts_free(out_err)
  if ptr_is_null(p) {
    return Err(if err != 0 { err } else { -1 })
  }
  if err != 0 {
    sts_free(p)
    return Err(err)
  }
  if n <= 0.to_int64() {
    sts_free(p)
    return Ok(Bytes::new(0))
  }
  let out = bytes_from_ptr(p, n.to_int())
  sts_free(p)
  Ok(out)
}

pub fn ReadOnlyFile::close(self : ReadOnlyFile) -> Bool {
  sts_file_close(self.handle) != 0
}

pub fn random_bytes(len : Int) -> Result[Bytes, String] {
  if len < 0 {
    return Err("negative length")
  }
  if len == 0 {
    return Ok(Bytes::new(0))
  }
  let out = Bytes::new(len)
  let ok = sts_random_bytes(bytes_data_ptr(out), len.to_int64())
  let _ = out.length()
  if ok != 0 {
    Ok(out)
  } else {
    Err("random_bytes failed")
  }
}

pub fn hex_encode(b : Bytes) -> String {
  let hex = "0123456789abcdef".to_bytes()
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    let v = b[i].to_int() & 0xFF
    sb.write_byte(hex[(v >> 4) & 0xF])
    sb.write_byte(hex[v & 0xF])
  }
  sb.to_string()
}

pub fn random_hex(num_bytes : Int) -> Result[String, String] {
  match random_bytes(num_bytes) {
    Ok(b) => Ok(hex_encode(b))
    Err(e) => Err(e)
  }
}

// ---------------------------------------------------------------------------
// 6. Unix peer identity & 7. Process resource usage
// ---------------------------------------------------------------------------

pub fn peer_process_json(fd : Int) -> Option[String] {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_peer_process(fd, out_len)
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  take_owned_string(p, n)
}

pub fn process_usage_json(pids : Array[Int]) -> String {
  let packed = pack_i32_le_array(pids)
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_process_usage(bytes_data_ptr(packed), pids.length(), out_len)
  let _ = packed.length()
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  match take_owned_string(p, n) {
    Some(s) => s
    None => "[]"
  }
}

// ---------------------------------------------------------------------------
// 8. PTY / ConPTY
// ---------------------------------------------------------------------------

pub struct PtyHandle {
  pub handle : Int64
  pub pid : Int
}

pub fn pty_spawn(
  event_id : Int64,
  program : String,
  args : Array[String],
  env : Option[Array[String]],
  cwd : String,
  cols : Int,
  rows : Int,
  strip_malloc_space_efficient : Bool = true,
) -> Result[PtyHandle, String] {
  let args_buf = encode_nul_list(args)
  let env_buf = match env {
    Some(pairs) => encode_nul_list(pairs)
    None => Bytes::new(0)
  }
  let out_pid = ptr_alloc(8.to_int64())
  ptr_write_i64(out_pid, 0.to_int64(), 0.to_int64())
  let err_cap = 256
  let err_buf = ptr_alloc(err_cap.to_int64())
  let base_flags = if strip_malloc_space_efficient { PROC_STRIP_MALLOC_SE } else { 0 }
  let flags = match env {
    Some(_) => base_flags | PROC_EXPLICIT_ENV
    None => base_flags
  }

  let h = sts_pty_spawn(
    event_id,
    program.as_cstr(),
    bytes_data_ptr(args_buf),
    args_buf.length().to_int64(),
    bytes_data_ptr(env_buf),
    env_buf.length().to_int64(),
    cwd.as_cstr(),
    cols,
    rows,
    flags,
    out_pid,
    err_buf,
    err_cap.to_int64(),
  )
  let _ = program.length()
  let _ = cwd.length()
  let _ = args_buf.length()
  let _ = env_buf.length()

  let pid = ptr_read_i64(out_pid, 0.to_int64()).to_int()
  sts_free(out_pid)
  if h <= 0.to_int64() {
    let msg = read_cstr_from_buf(err_buf, err_cap)
    sts_free(err_buf)
    return Err(if msg.length() > 0 { msg } else { "pty spawn failed" })
  }
  sts_free(err_buf)
  Ok(PtyHandle::{ handle: h, pid: pid })
}

pub fn PtyHandle::write(self : PtyHandle, data : Bytes) -> Bool {
  if data.length() == 0 {
    return true
  }
  let ok = sts_pty_write(self.handle, bytes_data_ptr(data), data.length().to_int64())
  let _ = data.length()
  ok != 0
}

pub fn PtyHandle::resize(self : PtyHandle, cols : Int, rows : Int) -> Bool {
  sts_pty_resize(self.handle, cols, rows) != 0
}

pub fn PtyHandle::kill(self : PtyHandle, sig : Int) -> Bool {
  sts_pty_kill(self.handle, sig) > 0
}

pub fn PtyHandle::close(self : PtyHandle) -> Bool {
  sts_pty_close(self.handle) != 0
}

// ---------------------------------------------------------------------------
// 9. Minimal UDP dgram
// ---------------------------------------------------------------------------

pub struct UdpSocket {
  pub handle : Int64
  pub port : Int
}

pub fn udp_bind(
  event_id : Int64,
  addr : String = "127.0.0.1",
  port : Int = 0,
) -> Option[UdpSocket] {
  let out_port = ptr_alloc(8.to_int64())
  ptr_write_i64(out_port, 0.to_int64(), 0.to_int64())
  let h = sts_udp_bind(event_id, addr.as_cstr(), port, out_port)
  let _ = addr.length()
  let bound_port = ptr_read_i64(out_port, 0.to_int64()).to_int()
  sts_free(out_port)
  if h > 0.to_int64() {
    Some(UdpSocket::{ handle: h, port: bound_port })
  } else {
    None
  }
}

pub fn UdpSocket::send_to(self : UdpSocket, addr : String, port : Int, data : Bytes) -> Int {
  let rc = sts_udp_send_to(
    self.handle,
    addr.as_cstr(),
    port,
    bytes_data_ptr(data),
    data.length().to_int64(),
  )
  let _ = addr.length()
  let _ = data.length()
  rc
}

pub fn UdpSocket::close(self : UdpSocket) -> Bool {
  sts_udp_close(self.handle) != 0
}

pub fn udp_send_once(addr : String, port : Int, data : Bytes) -> Int {
  let rc = sts_udp_send_once(
    addr.as_cstr(),
    port,
    bytes_data_ptr(data),
    data.length().to_int64(),
  )
  let _ = addr.length()
  let _ = data.length()
  rc
}

pub fn active_workers() -> Int {
  sts_active_workers()
}

// ---------------------------------------------------------------------------
// 10. Machine / OS info
// ---------------------------------------------------------------------------

pub fn os_name() -> String {
  let k = sts_os_kind()
  if k == 0 {
    "darwin"
  } else if k == 1 {
    "linux"
  } else if k == 2 {
    "win32"
  } else {
    "other"
  }
}

pub fn arch_name() -> String {
  let k = sts_arch_kind()
  if k == 0 {
    "arm64"
  } else if k == 1 {
    "x64"
  } else {
    "other"
  }
}

pub fn hostname() -> String {
  let out_len = ptr_alloc(8.to_int64())
  ptr_write_i64(out_len, 0.to_int64(), 0.to_int64())
  let p = sts_hostname(out_len)
  let n = ptr_read_i64(out_len, 0.to_int64())
  sts_free(out_len)
  match take_owned_string(p, n) {
    Some(s) => s
    None => ""
  }
}

