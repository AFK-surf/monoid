fn expect(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic(msg)
  }
}

test "encode_nul_list and decode_nul_list roundtrip" {
  let items = ["hello", "world", "KEY=VAL"]
  let raw = encode_nul_list(items)
  let got = decode_nul_list(raw)
  expect(got.length() == 3, "expected 3 items")
  expect(got[0] == "hello", "item 0")
  expect(got[1] == "world", "item 1")
  expect(got[2] == "KEY=VAL", "item 2")

  let empty = encode_nul_list([])
  expect(empty.length() == 0, "empty nul list")
  expect(decode_nul_list(empty).length() == 0, "decode empty")
}

test "pack_i32_le_array encodes little-endian int32s" {
  let packed = pack_i32_le_array([1, 258, -1])
  expect(packed.length() == 12, "3 * 4 bytes")
  expect((packed[0].to_int() & 0xFF) == 1, "v0 b0")
  expect((packed[1].to_int() & 0xFF) == 0, "v0 b1")
  expect((packed[4].to_int() & 0xFF) == 2, "v1 b0")
  expect((packed[5].to_int() & 0xFF) == 1, "v1 b1")
  expect((packed[8].to_int() & 0xFF) == 255, "v2 b0")
  expect((packed[11].to_int() & 0xFF) == 255, "v2 b3")
}

test "spawn_flags encodes all bitmask combinations" {
  let opts = SpawnOptions::{
    program: "/bin/sh",
    args: [],
    env: None,
    cwd: "",
    new_pgid: true,
    strip_malloc_space_efficient: true,
    pipe_stdin: true,
    pipe_stdout: false,
    pipe_stderr: true,
  }
  expect(spawn_flags(opts) == (1 | 2 | 4 | 16), "bitmask mismatch")
  let explicit_empty = SpawnOptions::{
    program: "/bin/sh",
    args: [],
    env: Some([]),
    cwd: "",
    new_pgid: false,
    strip_malloc_space_efficient: false,
    pipe_stdin: false,
    pipe_stdout: true,
    pipe_stderr: false,
  }
  expect(spawn_flags(explicit_empty) == (8 | 32), "explicit empty env sets PROC_EXPLICIT_ENV")
  expect(ERR_NETUNREACH == -101, "portable ERR_NETUNREACH constant")
  expect(ERR_HOSTUNREACH == -113, "portable ERR_HOSTUNREACH constant")
  expect(SIG_STOP == 103 && SIG_CONT == 104, "cross-platform logical SIG_STOP/SIG_CONT constants")
  expect(hex_encode("AB".to_bytes()) == "4142", "hex_encode")
}

test "decode_sys_event parses fs, proc, ctrl, signal, pty, and udp frames" {
  // FsChange(Rename, "cfg.json")
  let fs_raw = Bytes::new(10)
  fs_raw[0] = 1 as Byte
  fs_raw[1] = 1 as Byte
  let fname = "cfg.json".to_bytes()
  for i in 0..<8 {
    fs_raw[2 + i] = fname[i]
  }
  match decode_sys_event(fs_raw) {
    Some(SysEvent::FsChange(FsChangeKind::Rename, name)) => expect(name == "cfg.json", "fs name")
    _ => panic("expected FsChange Rename")
  }

  // ProcExit(code=-1, sig=9, "SIGKILL")
  let pexit = Bytes::new(16)
  pexit[0] = 14 as Byte
  pexit[1] = 255 as Byte
  pexit[2] = 255 as Byte
  pexit[3] = 255 as Byte
  pexit[4] = 255 as Byte
  pexit[5] = 9 as Byte
  let sk = "SIGKILL".to_bytes()
  for i in 0..<7 {
    pexit[9 + i] = sk[i]
  }
  match decode_sys_event(pexit) {
    Some(SysEvent::ProcExit(st)) => {
      expect(st.code == -1, "exit code -1")
      expect(st.signal == 9, "sig 9")
      expect(st.signal_name == "SIGKILL", "SIGKILL")
    }
    _ => panic("expected ProcExit")
  }

  // CtrlLine("{\"ok\":1}")
  let line = "{\"ok\":1}".to_bytes()
  let ctrl = Bytes::new(1 + line.length())
  ctrl[0] = 20 as Byte
  for i in 0..<line.length() {
    ctrl[1 + i] = line[i]
  }
  match decode_sys_event(ctrl) {
    Some(SysEvent::CtrlLine(s)) => expect(s == "{\"ok\":1}", "ctrl line")
    _ => panic("expected CtrlLine")
  }

  // Signal(12, "SIGUSR2")
  let sig = Bytes::new(5 + 7)
  sig[0] = 30 as Byte
  sig[1] = 12 as Byte
  let su = "SIGUSR2".to_bytes()
  for i in 0..<7 {
    sig[5 + i] = su[i]
  }
  match decode_sys_event(sig) {
    Some(SysEvent::Signal(num, name)) => {
      expect(num == 12, "sig num")
      expect(name == "SIGUSR2", "sig name")
    }
    _ => panic("expected Signal")
  }

  // UdpRecv(port=5353, addr="127.0.0.1", data="hi")
  let addr = "127.0.0.1".to_bytes()
  let udp = Bytes::new(5 + addr.length() + 2)
  udp[0] = 50 as Byte
  udp[1] = (5353 & 0xFF) as Byte
  udp[2] = ((5353 >> 8) & 0xFF) as Byte
  udp[3] = addr.length() as Byte
  udp[4] = 0 as Byte
  for i in 0..<addr.length() {
    udp[5 + i] = addr[i]
  }
  udp[5 + addr.length()] = 104 as Byte
  udp[5 + addr.length() + 1] = 105 as Byte
  match decode_sys_event(udp) {
    Some(SysEvent::UdpRecv(pkt)) => {
      expect(pkt.port == 5353, "udp port")
      expect(pkt.addr == "127.0.0.1", "udp addr")
      expect(pkt.data.length() == 2, "udp data len")
      expect((pkt.data[0].to_int() & 0xFF) == 104, "udp b0")
      expect((pkt.data[1].to_int() & 0xFF) == 105, "udp b1")
    }
    _ => panic("expected UdpRecv")
  }

  // Malformed / truncated frames must return None.
  expect(
    match decode_sys_event(Bytes::new(0)) {
      None => true
      Some(_) => false
    },
    "empty payload",
  )
  let fs_ovf = Bytes::new(2)
  fs_ovf[0] = 1 as Byte
  fs_ovf[1] = 3 as Byte
  match decode_sys_event(fs_ovf) {
    Some(SysEvent::FsChange(FsChangeKind::Overflow, name)) => expect(name == "", "fs overflow")
    _ => panic("expected FsChange Overflow")
  }
  let fs_err = Bytes::new(2)
  fs_err[0] = 1 as Byte
  fs_err[1] = 0 as Byte
  match decode_sys_event(fs_err) {
    Some(SysEvent::FsChange(FsChangeKind::Error, name)) => expect(name == "", "fs error")
    _ => panic("expected FsChange Error")
  }
  let fs_bad = Bytes::new(2)
  fs_bad[0] = 1 as Byte
  fs_bad[1] = 4 as Byte
  expect(
    match decode_sys_event(fs_bad) {
      None => true
      Some(_) => false
    },
    "unknown FsChangeKind must return None",
  )
  let trailing_eof = Bytes::new(2)
  trailing_eof[0] = 12 as Byte
  trailing_eof[1] = 0 as Byte
  expect(
    match decode_sys_event(trailing_eof) {
      None => true
      Some(_) => false
    },
    "fixed-size tag with trailing bytes must return None",
  )
  let bad_udp = Bytes::new(6)
  bad_udp[0] = 50 as Byte
  bad_udp[3] = 20 as Byte // addr_len exceeds frame length
  expect(
    match decode_sys_event(bad_udp) {
      None => true
      Some(_) => false
    },
    "truncated udp frame",
  )
}
