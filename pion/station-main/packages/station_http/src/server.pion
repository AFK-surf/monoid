// Asynchronous HTTP/1.1 + SSE + WebSocket server over `builders_core::ShellMux` and `SerialOutbox`.
// Zero RC cycles: `ShellMux.pending` holds only integer `MuxToken::Tagged` values,
// `HttpConn` holds only data (no server/mux references or closures), and callbacks are passed per step.

import "base_codec"
import "builders_core"
import "host_shim"
import "http1"
import "websocket"

let HTTP_TOK_LISTEN : Int = 2001
let HTTP_TOK_ACCEPT : Int = 2002
let HTTP_TOK_READ : Int = 2003
let HTTP_TOK_WRITE : Int = 2004
let HTTP_TOK_CLOSE : Int = 2006
let HTTP_TOK_LISTEN_CLOSE : Int = 2007

/// Callbacks supplied to `HttpServer::step` / `HttpServer::handle_done`.
/// Passed per tick rather than stored on connections so Pion RC can never form cycles.
pub struct ServerCallbacks {
  pub on_accept : (Int, String) -> Bool
  pub on_request : (HttpRequest) -> HandlerAction
  pub on_ws_event : (WsEvent) -> Unit
  pub on_sse_close : (Int) -> Unit
  pub on_error : (String) -> Unit
}

pub fn ServerCallbacks::new(on_request : (HttpRequest) -> HandlerAction) -> ServerCallbacks {
  ServerCallbacks::{
    on_accept: fn(_conn_id : Int, _peer : String) -> Bool { true },
    on_request: on_request,
    on_ws_event: fn(_ev : WsEvent) -> Unit {},
    on_sse_close: fn(_conn_id : Int) -> Unit {},
    on_error: fn(_msg : String) -> Unit {},
  }
}

pub fn ServerCallbacks::from_router(router : Router) -> ServerCallbacks {
  ServerCallbacks::new(fn(req : HttpRequest) -> HandlerAction { router.handle(req) })
}

enum ConnMode {
  ReadingHead
  ReadingFixedBody(http1::Request, Bytes, Int64, Array[Bytes], Int)
  ReadingChunkedBody(http1::Request, Bytes, http1::ChunkedDecoder, Array[Bytes], Int)
  WritingChunked(Bool, Bool)
  Sse
  WebSocket(WsConnState)
  Closing
}

struct HttpConn {
  id : Int
  gen : Int64
  peer : String
  mut mode : ConnMode
  mut rx_buf : Bytes
  mut last_activity_ms : Int64
  mut queued_write_bytes : Int
  mut write_sizes : Array[Int]
  mut write_sizes_head : Int
  mut close_after_flush : Bool
  mut closed : Bool
}

fn HttpConn::new(id : Int, gen : Int64, peer : String, now_ms : Int64) -> HttpConn {
  HttpConn::{
    id: id,
    gen: gen,
    peer: peer,
    mode: ConnMode::ReadingHead,
    rx_buf: Bytes::new(0),
    last_activity_ms: now_ms,
    queued_write_bytes: 0,
    write_sizes: [],
    write_sizes_head: 0,
    close_after_flush: false,
    closed: false,
  }
}

fn HttpConn::push_write_size(self : HttpConn, sz : Int) -> Unit {
  self.write_sizes.push(sz)
  self.queued_write_bytes = self.queued_write_bytes + sz
}

fn HttpConn::pop_write_size(self : HttpConn) -> Int {
  if self.write_sizes_head >= self.write_sizes.length() {
    return 0
  }
  let sz = self.write_sizes[self.write_sizes_head]
  self.write_sizes_head = self.write_sizes_head + 1
  if self.write_sizes_head == self.write_sizes.length() {
    self.write_sizes = []
    self.write_sizes_head = 0
  } else if self.write_sizes_head >= 32 && self.write_sizes_head * 2 >= self.write_sizes.length() {
    let next : Array[Int] = []
    let mut i = self.write_sizes_head
    while i < self.write_sizes.length() {
      next.push(self.write_sizes[i])
      i = i + 1
    }
    self.write_sizes = next
    self.write_sizes_head = 0
  }
  self.queued_write_bytes = self.queued_write_bytes - sz
  if self.queued_write_bytes < 0 {
    self.queued_write_bytes = 0
  }
  sz
}

fn concat_two_bytes(a : Bytes, b : Bytes) -> Bytes {
  let al = a.length()
  let bl = b.length()
  if al == 0 {
    return b
  }
  if bl == 0 {
    return a
  }
  let mut out = Bytes::new(al + bl)
  let mut i = 0
  while i < al {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < bl {
    out[al + j] = b[j]
    j = j + 1
  }
  out
}

fn concat_chunks(chunks : Array[Bytes], total_len : Int) -> Bytes {
  if total_len <= 0 || chunks.length() == 0 {
    return Bytes::new(0)
  }
  if chunks.length() == 1 && chunks[0].length() == total_len {
    return chunks[0]
  }
  let mut out = Bytes::new(total_len)
  let mut off = 0
  let mut ci = 0
  while ci < chunks.length() {
    let c = chunks[ci]
    let cl = c.length()
    let mut j = 0
    while j < cl && off < total_len {
      out[off] = c[j]
      off = off + 1
      j = j + 1
    }
    ci = ci + 1
  }
  out
}

fn json_int_field(o : base_codec::Json, k : String, fallback : Int) -> Int {
  match builders_core::json_get_last(o, k) {
    Some(base_codec::Json::Num(n, _)) => n.to_int()
    _ => fallback
  }
}

fn json_str_field(o : base_codec::Json, k : String, fallback : String) -> String {
  match builders_core::json_get_last(o, k) {
    Some(base_codec::Json::Str(s)) => s
    _ => fallback
  }
}

fn json_bool_field(o : base_codec::Json, k : String, fallback : Bool) -> Bool {
  match builders_core::json_get_last(o, k) {
    Some(base_codec::Json::Bool(b)) => b
    _ => fallback
  }
}

/// Asynchronous HTTP/1.1 + SSE + WebSocket server.
pub struct HttpServer {
  pub mux : builders_core::ShellMux
  pub limits : ServerLimits
  outbox : builders_core::SerialOutbox
  conns : Map[Int, HttpConn]
  mut listen_id : Option[Int]
  mut listen_port : Int
  mut listening : Bool
  mut closing : Bool
  mut listen_error : Option[String]
  mut consecutive_accept_errors : Int
  mut next_gen : Int64
  mut total_accepted : Int64
  mut total_requests : Int64
}

pub fn HttpServer::new(mux : builders_core::ShellMux, limits : ServerLimits) -> HttpServer {
  HttpServer::{
    mux: mux,
    limits: limits,
    outbox: builders_core::SerialOutbox::new(),
    conns: Map::new(),
    listen_id: None,
    listen_port: 0,
    listening: false,
    closing: false,
    listen_error: None,
    consecutive_accept_errors: 0,
    next_gen: 0L,
    total_accepted: 0L,
    total_requests: 0L,
  }
}

pub fn HttpServer::with_defaults(mux : builders_core::ShellMux) -> HttpServer {
  HttpServer::new(mux, ServerLimits::default())
}

pub fn HttpServer::is_listening(self : HttpServer) -> Bool {
  self.listening
}

pub fn HttpServer::is_closing(self : HttpServer) -> Bool {
  self.closing
}

pub fn HttpServer::port(self : HttpServer) -> Int {
  self.listen_port
}

pub fn HttpServer::listen_error(self : HttpServer) -> Option[String] {
  self.listen_error
}

pub fn HttpServer::active_connections(self : HttpServer) -> Int {
  self.conns.length()
}

pub fn HttpServer::total_accepted(self : HttpServer) -> Int64 {
  self.total_accepted
}

pub fn HttpServer::total_requests(self : HttpServer) -> Int64 {
  self.total_requests
}

/// Start listening on a local `ListenSource` (loopback 127.0.0.1, inherited fd, or Unix socket).
pub fn HttpServer::listen(self : HttpServer, source : ListenSource) -> Unit {
  if self.listening || self.closing {
    return ()
  }
  match source {
    ListenSource::Loopback(port) => {
      let args = "{\"port\":" + port.to_string() + "}"
      let _ = self.mux.call_async_raw(
        builders_core::MuxToken::Tagged(0, HTTP_TOK_LISTEN, 0L),
        "tcp.listen",
        args,
        None,
      )
    }
    ListenSource::InheritedFd(fd) => {
      // Launcher fd ownership is transferred directly to `client/shell`; never close raw fd here.
      let args = "{\"fd\":" + fd.to_string() + "}"
      let _ = self.mux.call_async_raw(
        builders_core::MuxToken::Tagged(0, HTTP_TOK_LISTEN, 0L),
        "tcp.listen",
        args,
        None,
      )
    }
    ListenSource::UnixPath(path) => {
      let args = base_codec::json_stringify(
        base_codec::json_obj([("path", base_codec::json_str(path))]),
      )
      let _ = self.mux.call_async_raw(
        builders_core::MuxToken::Tagged(0, HTTP_TOK_LISTEN, 0L),
        "unix.listen",
        args,
        None,
      )
    }
  }
}

pub fn HttpServer::listen_loopback(self : HttpServer, port : Int) -> Unit {
  self.listen(ListenSource::Loopback(port))
}

pub fn HttpServer::listen_fd(self : HttpServer, fd : Int) -> Unit {
  self.listen(ListenSource::InheritedFd(fd))
}

pub fn HttpServer::listen_unix(self : HttpServer, path : String) -> Unit {
  self.listen(ListenSource::UnixPath(path))
}

fn HttpServer::start_accept(self : HttpServer, lid : Int) -> Unit {
  if self.closing {
    return ()
  }
  let _ = self.mux.call_async_raw(
    builders_core::MuxToken::Tagged(lid, HTTP_TOK_ACCEPT, 0L),
    "tcp.accept",
    "{\"id\":" + lid.to_string() + "}",
    None,
  )
}

fn HttpServer::start_read(self : HttpServer, conn_id : Int, gen : Int64) -> Unit {
  let _ = self.mux.call_async_raw(
    builders_core::MuxToken::Tagged(conn_id, HTTP_TOK_READ, gen),
    "tcp.read",
    "{\"id\":" + conn_id.to_string() + "}",
    None,
  )
}

fn HttpServer::send_tcp_close(self : HttpServer, conn_id : Int, gen : Int64) -> Unit {
  let _ = self.mux.call_async_raw(
    builders_core::MuxToken::Tagged(conn_id, HTTP_TOK_CLOSE, gen),
    "tcp.close",
    "{\"id\":" + conn_id.to_string() + "}",
    None,
  )
}

/// Enqueue bytes on a connection's `SerialOutbox`, enforcing per-connection backpressure cap.
fn HttpServer::enqueue_write(self : HttpServer, conn : HttpConn, data : Bytes) -> Bool {
  if conn.closed || data.length() == 0 {
    return !conn.closed
  }
  if conn.queued_write_bytes + data.length() > self.limits.max_write_queue_bytes {
    return false
  }
  conn.push_write_size(data.length())
  conn.last_activity_ms = self.mux.now_ms()
  let _ = self.outbox.send_raw(
    self.mux,
    conn.id,
    builders_core::MuxToken::Tagged(conn.id, HTTP_TOK_WRITE, conn.gen),
    "tcp.write",
    "{\"id\":" + conn.id.to_string() + "}",
    Some(data),
  )
  true
}

/// Immediately close a connection, clear its outbox, fire disconnect callbacks, and call `tcp.close`.
fn HttpServer::close_conn_with_callbacks(
  self : HttpServer,
  conn_id : Int,
  callbacks : ServerCallbacks,
  notify_ws_close : Bool,
) -> Unit {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return ()
  }
  if conn.closed {
    return ()
  }
  conn.closed = true
  let prev_mode = conn.mode
  conn.mode = ConnMode::Closing
  conn.rx_buf = Bytes::new(0)
  self.conns.remove(conn_id)
  self.outbox.close_handle(conn_id)
  self.send_tcp_close(conn_id, conn.gen)
  match prev_mode {
    ConnMode::Sse => (callbacks.on_sse_close)(conn_id)
    ConnMode::WebSocket(ws) => {
      if notify_ws_close && !ws.close_received {
        ws.close_received = true
        (callbacks.on_ws_event)(WsEvent::Close(conn_id, None))
      }
    }
    _ => ()
  }
}

fn HttpServer::close_conn_silent(self : HttpServer, conn_id : Int) -> Unit {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return ()
  }
  if conn.closed {
    return ()
  }
  conn.closed = true
  conn.mode = ConnMode::Closing
  conn.rx_buf = Bytes::new(0)
  self.conns.remove(conn_id)
  self.outbox.close_handle(conn_id)
  self.send_tcp_close(conn_id, conn.gen)
}

/// Gracefully stop accepting new connections and immediately close all active connections.
pub fn HttpServer::close(self : HttpServer) -> Unit {
  self.closing = true
  self.listening = false
  match self.listen_id {
    Some(lid) => {
      self.listen_id = None
      let _ = self.mux.call_async_raw(
        builders_core::MuxToken::Tagged(lid, HTTP_TOK_LISTEN_CLOSE, 0L),
        "listen.close",
        "{\"id\":" + lid.to_string() + "}",
        None,
      )
    }
    None => ()
  }
  let ids = self.conns.keys()
  let mut i = 0
  while i < ids.length() {
    self.close_conn_silent(ids[i])
    i = i + 1
  }
}

/// Close with callbacks so active SSE/WS subscribers receive disconnect notifications.
pub fn HttpServer::close_with_callbacks(self : HttpServer, callbacks : ServerCallbacks) -> Unit {
  self.closing = true
  self.listening = false
  match self.listen_id {
    Some(lid) => {
      self.listen_id = None
      let _ = self.mux.call_async_raw(
        builders_core::MuxToken::Tagged(lid, HTTP_TOK_LISTEN_CLOSE, 0L),
        "listen.close",
        "{\"id\":" + lid.to_string() + "}",
        None,
      )
    }
    None => ()
  }
  let ids = self.conns.keys()
  let mut i = 0
  while i < ids.length() {
    self.close_conn_with_callbacks(ids[i], callbacks, true)
    i = i + 1
  }
}

/// Sweep idle HTTP keep-alive connections past `limits.idle_timeout_ms`.
// timer: idle keep-alive connection timeout cleanup
pub fn HttpServer::sweep_idle(
  self : HttpServer,
  now_ms : Int64,
  callbacks : ServerCallbacks,
) -> Int {
  if self.limits.idle_timeout_ms <= 0L {
    return 0
  }
  let expired : Array[Int] = []
  let ids = self.conns.keys()
  let mut ki = 0
  while ki < ids.length() {
    let id = ids[ki]
    match self.conns.get(id) {
      Some(conn) => {
        let is_http_idle = match conn.mode {
          ConnMode::ReadingHead => true
          ConnMode::ReadingFixedBody(_, _, _, _, _) => true
          ConnMode::ReadingChunkedBody(_, _, _, _, _) => true
          _ => false
        }
        if is_http_idle && now_ms - conn.last_activity_ms >= self.limits.idle_timeout_ms {
          expired.push(id)
        }
      }
      None => ()
    }
    ki = ki + 1
  }
  let mut i = 0
  while i < expired.length() {
    self.close_conn_with_callbacks(expired[i], callbacks, false)
    i = i + 1
  }
  expired.length()
}

fn has_header_named(headers : Array[http1::Header], name : String) -> Bool {
  let mut i = 0
  while i < headers.length() {
    if ascii_eq_ci(headers[i].name, name) {
      return true
    }
    i = i + 1
  }
  false
}

fn HttpServer::send_error_and_close(
  self : HttpServer,
  conn : HttpConn,
  status : Int,
  msg : String,
  callbacks : ServerCallbacks,
) -> Unit {
  let resp = HttpResponse::error(status, msg).with_close(true)
  self.write_http_response(conn, "GET", false, resp, callbacks)
}

fn HttpServer::write_http_response(
  self : HttpServer,
  conn : HttpConn,
  req_method : String,
  req_keep_alive : Bool,
  resp : HttpResponse,
  callbacks : ServerCallbacks,
) -> Unit {
  let bodyless = resp.status < 200 || resp.status == 204 || resp.status == 304
  let is_head = req_method == "HEAD"
  let keep_alive = req_keep_alive && !resp.close_after && !self.closing
  let headers : Array[http1::Header] = []
  let mut i = 0
  while i < resp.headers.length() {
    let h = resp.headers[i]
    if bodyless &&
    (ascii_eq_ci(h.name, "transfer-encoding") ||
      ((resp.status < 200 || resp.status == 204) && ascii_eq_ci(h.name, "content-length"))) {
      i = i + 1
      continue
    }
    headers.push(h)
    i = i + 1
  }
  if !bodyless {
    if resp.chunked {
      if !has_header_named(headers, "transfer-encoding") {
        headers.push(http1::Header::new("Transfer-Encoding", "chunked"))
      }
    } else if !has_header_named(headers, "content-length") {
      headers.push(http1::Header::new("Content-Length", resp.body.length().to_string()))
    }
  }
  if !has_header_named(headers, "connection") {
    headers.push(
      http1::Header::new("Connection", if keep_alive { "keep-alive" } else { "close" }),
    )
  }
  let head_bytes = match http1::encode_response(
    http1::Version::Http11,
    resp.status,
    resp.reason,
    headers,
  ) {
    Ok(b) => b
    Err(e) => {
      (callbacks.on_error)("encode_response failed: " + http1::http_error_string(e))
      self.close_conn_with_callbacks(conn.id, callbacks, false)
      return ()
    }
  }
  let wire = if bodyless || is_head {
    head_bytes
  } else if resp.chunked {
    let mut chunk_body = Bytes::new(0)
    if resp.body.length() > 0 {
      chunk_body = http1::encode_chunk(resp.body)
    }
    let fin = match http1::encode_final_chunk([]) {
      Ok(b) => b
      Err(_) => "0\r\n\r\n".to_bytes()
    }
    concat_two_bytes(head_bytes, concat_two_bytes(chunk_body, fin))
  } else {
    concat_two_bytes(head_bytes, resp.body)
  }
  if !self.enqueue_write(conn, wire) {
    self.close_conn_with_callbacks(conn.id, callbacks, false)
    return ()
  }
  if !keep_alive {
    conn.close_after_flush = true
    conn.mode = ConnMode::Closing
  } else {
    conn.mode = ConnMode::ReadingHead
  }
}

fn HttpServer::dispatch_request(
  self : HttpServer,
  conn : HttpConn,
  raw_req : http1::Request,
  raw_head : Bytes,
  body : Bytes,
  callbacks : ServerCallbacks,
) -> Unit {
  self.total_requests = self.total_requests + 1L
  let (path, query_raw, query) = parse_request_target(raw_req.path)
  let req = HttpRequest::{
    conn_id: conn.id,
    method: raw_req.method,
    raw_target: raw_req.path,
    path: path,
    query_raw: query_raw,
    query: query,
    version: raw_req.version,
    headers: raw_req.headers,
    body: body,
    peer: conn.peer,
    raw_head: raw_head,
  }
  let req_ka = req.keep_alive()
  let action = (callbacks.on_request)(req)
  if conn.closed {
    return ()
  }
  match action {
    HandlerAction::Respond(resp) => {
      self.write_http_response(conn, raw_req.method, req_ka, resp, callbacks)
    }
    HandlerAction::StartChunked(status, extra_headers) => {
      let bodyless = status < 200 || status == 204 || status == 304
      let is_head = raw_req.method == "HEAD"
      let suppress_body = bodyless || is_head
      let keep_alive = req_ka && !self.closing
      let headers : Array[http1::Header] = []
      let mut i = 0
      while i < extra_headers.length() {
        let h = extra_headers[i]
        if bodyless &&
        (ascii_eq_ci(h.name, "transfer-encoding") ||
          ((status < 200 || status == 204) && ascii_eq_ci(h.name, "content-length"))) {
          i = i + 1
          continue
        }
        headers.push(h)
        i = i + 1
      }
      if !bodyless && !has_header_named(headers, "transfer-encoding") {
        headers.push(http1::Header::new("Transfer-Encoding", "chunked"))
      }
      if !has_header_named(headers, "connection") {
        headers.push(
          http1::Header::new("Connection", if keep_alive { "keep-alive" } else { "close" }),
        )
      }
      match http1::encode_response(
        http1::Version::Http11,
        status,
        status_reason(status),
        headers,
      ) {
        Ok(head_bytes) => {
          if !self.enqueue_write(conn, head_bytes) {
            self.close_conn_with_callbacks(conn.id, callbacks, false)
            return ()
          }
          conn.mode = ConnMode::WritingChunked(keep_alive, suppress_body)
        }
        Err(e) => {
          (callbacks.on_error)("StartChunked encode failed: " + http1::http_error_string(e))
          self.close_conn_with_callbacks(conn.id, callbacks, false)
        }
      }
    }
    HandlerAction::UpgradeSse(extra_headers) => {
      if raw_req.method == "HEAD" {
        let r1 = HttpResponse::empty(200).with_header(
          "Content-Type",
          "text/event-stream; charset=utf-8",
        )
        let r2 = r1.with_header("Cache-Control", "no-cache").with_close(true)
        self.write_http_response(conn, "HEAD", false, r2, callbacks)
        return ()
      }
      let headers = sse_response_headers(extra_headers)
      match http1::encode_response(http1::Version::Http11, 200, "OK", headers) {
        Ok(head_bytes) => {
          if !self.enqueue_write(conn, head_bytes) {
            self.close_conn_with_callbacks(conn.id, callbacks, false)
            return ()
          }
          conn.mode = ConnMode::Sse
        }
        Err(e) => {
          (callbacks.on_error)("UpgradeSse encode failed: " + http1::http_error_string(e))
          self.close_conn_with_callbacks(conn.id, callbacks, false)
        }
      }
    }
    HandlerAction::UpgradeWs(selected_protocol) => {
      match validate_ws_upgrade(raw_head, selected_protocol) {
        Err(msg) => {
          self.send_error_and_close(conn, 400, msg, callbacks)
        }
        Ok((_hs, resp_bytes)) => {
          if !self.enqueue_write(conn, resp_bytes) {
            self.close_conn_with_callbacks(conn.id, callbacks, false)
            return ()
          }
          let ws_state = WsConnState::new(
            conn.id,
            selected_protocol,
            self.limits.max_ws_message_bytes,
          )
          conn.mode = ConnMode::WebSocket(ws_state)
          (callbacks.on_ws_event)(WsEvent::Open(conn.id, selected_protocol))
          if !conn.closed && conn.rx_buf.length() > 0 {
            let extra = conn.rx_buf
            conn.rx_buf = Bytes::new(0)
            self.feed_ws_bytes(conn, ws_state, extra, callbacks)
          }
        }
      }
    }
  }
}

fn HttpServer::feed_ws_bytes(
  self : HttpServer,
  conn : HttpConn,
  ws : WsConnState,
  chunk : Bytes,
  callbacks : ServerCallbacks,
) -> Unit {
  if conn.closed {
    return ()
  }
  ws.decoder.feed(chunk)
  while !conn.closed {
    match ws.decoder.next_message() {
      Ok(None) => break
      Ok(Some(websocket::Message::Text(text))) => {
        (callbacks.on_ws_event)(WsEvent::Text(conn.id, text))
      }
      Ok(Some(websocket::Message::Binary(data))) => {
        (callbacks.on_ws_event)(WsEvent::Binary(conn.id, data))
      }
      Ok(Some(websocket::Message::Ping(payload))) => {
        // RFC 6455 §5.5.3: automatically respond to Ping with Pong carrying identical payload.
        let pong = encode_ws_pong(payload)
        if !self.enqueue_write(conn, pong) {
          self.close_conn_with_callbacks(conn.id, callbacks, true)
          return ()
        }
        (callbacks.on_ws_event)(WsEvent::Ping(conn.id, payload))
      }
      Ok(Some(websocket::Message::Pong(payload))) => {
        (callbacks.on_ws_event)(WsEvent::Pong(conn.id, payload))
      }
      Ok(Some(websocket::Message::Close(cf))) => {
        ws.close_received = true
        if !ws.close_sent {
          ws.close_sent = true
          let reply = match cf {
            Some(c) => encode_ws_close(c.code, c.reason)
            None => encode_ws_close(1000, "")
          }
          let _ = self.enqueue_write(conn, reply)
        }
        conn.close_after_flush = true
        (callbacks.on_ws_event)(WsEvent::Close(conn.id, cf))
        if !conn.closed && !self.outbox.is_busy(conn.id) {
          self.close_conn_with_callbacks(conn.id, callbacks, false)
        }
        break
      }
      Err(err) => {
        let code = ws_close_code_for_error(err)
        let msg = websocket::ws_error_string(err)
        if !ws.close_sent {
          ws.close_sent = true
          let _ = self.enqueue_write(conn, encode_ws_close(code, msg))
        }
        conn.close_after_flush = true
        (callbacks.on_ws_event)(WsEvent::Error(conn.id, msg))
        if !conn.closed && !self.outbox.is_busy(conn.id) {
          self.close_conn_with_callbacks(conn.id, callbacks, false)
        }
        break
      }
    }
  }
}

fn HttpServer::process_rx(
  self : HttpServer,
  conn : HttpConn,
  incoming : Bytes,
  callbacks : ServerCallbacks,
) -> Unit {
  if conn.closed {
    return ()
  }
  match conn.mode {
    ConnMode::WebSocket(ws) => {
      self.feed_ws_bytes(conn, ws, incoming, callbacks)
      return ()
    }
    ConnMode::Sse => {
      // SSE is server-to-client; ignore any stray client bytes while keeping read armed for EOF.
      return ()
    }
    ConnMode::WritingChunked(_, _) => {
      let max_pipelined = self.limits.max_header_bytes + self.limits.max_body_bytes
      if conn.rx_buf.length().to_int64() + incoming.length().to_int64() > max_pipelined {
        self.close_conn_with_callbacks(conn.id, callbacks, false)
        return ()
      }
      if incoming.length() > 0 {
        conn.rx_buf = concat_two_bytes(conn.rx_buf, incoming)
      }
      return ()
    }
    ConnMode::Closing => return ()
    _ => ()
  }
  if incoming.length() > 0 {
    conn.rx_buf = concat_two_bytes(conn.rx_buf, incoming)
  }
  let mut steps = 0
  while !conn.closed && steps < 16 {
    steps = steps + 1
    match conn.mode {
      ConnMode::ReadingHead => {
        if conn.rx_buf.length() == 0 {
          break
        }
        let hlimits = self.limits.to_http1_limits()
        match http1::parse_request_with_limits(conn.rx_buf, hlimits) {
          Ok(http1::ParseStatus::Partial) => {
            if conn.rx_buf.length().to_int64() > self.limits.max_header_bytes {
              self.send_error_and_close(conn, 431, "request header fields too large", callbacks)
            }
            break
          }
          Err(http1::HttpError::HeaderTooLarge) | Err(http1::HttpError::TooManyHeaders) => {
            self.send_error_and_close(conn, 431, "request header fields too large", callbacks)
            break
          }
          Err(http1::HttpError::UriTooLarge) => {
            self.send_error_and_close(conn, 414, "request URI too long", callbacks)
            break
          }
          Err(e) => {
            self.send_error_and_close(conn, 400, http1::http_error_string(e), callbacks)
            break
          }
          Ok(http1::ParseStatus::Complete(raw_req, consumed)) => {
            let raw_head = conn.rx_buf.slice(0, consumed)
            conn.rx_buf = if consumed < conn.rx_buf.length() {
              conn.rx_buf.slice(consumed, conn.rx_buf.length())
            } else {
              Bytes::new(0)
            }
            let wants_100 = match raw_req.header("expect") {
              Some(v) => ascii_eq_ci(v.trim(), "100-continue")
              None => false
            }
            match raw_req.framing {
              http1::Framing::None => {
                self.dispatch_request(conn, raw_req, raw_head, Bytes::new(0), callbacks)
              }
              http1::Framing::ContentLength(cl) => {
                if cl < 0L || cl > self.limits.max_body_bytes || cl > 2147483647L {
                  self.send_error_and_close(conn, 413, "payload too large", callbacks)
                  break
                }
                if cl == 0L {
                  self.dispatch_request(conn, raw_req, raw_head, Bytes::new(0), callbacks)
                } else {
                  if wants_100 {
                    if !self.enqueue_write(conn, "HTTP/1.1 100 Continue\r\n\r\n".to_bytes()) {
                      self.close_conn_with_callbacks(conn.id, callbacks, false)
                      break
                    }
                  }
                  conn.mode = ConnMode::ReadingFixedBody(raw_req, raw_head, cl, [], 0)
                }
              }
              http1::Framing::Chunked => {
                if wants_100 {
                  if !self.enqueue_write(conn, "HTTP/1.1 100 Continue\r\n\r\n".to_bytes()) {
                    self.close_conn_with_callbacks(conn.id, callbacks, false)
                    break
                  }
                }
                let dec = http1::ChunkedDecoder::with_limits(hlimits)
                conn.mode = ConnMode::ReadingChunkedBody(raw_req, raw_head, dec, [], 0)
              }
            }
          }
        }
      }
      ConnMode::ReadingFixedBody(raw_req, raw_head, expected, chunks, got) => {
        let need = expected.to_int() - got
        if need <= 0 {
          let body = concat_chunks(chunks, got)
          conn.mode = ConnMode::ReadingHead
          self.dispatch_request(conn, raw_req, raw_head, body, callbacks)
          continue
        }
        if conn.rx_buf.length() == 0 {
          break
        }
        let avail = conn.rx_buf.length()
        if avail <= need {
          chunks.push(conn.rx_buf)
          let new_got = got + avail
          conn.rx_buf = Bytes::new(0)
          if new_got >= expected.to_int() {
            let body = concat_chunks(chunks, new_got)
            conn.mode = ConnMode::ReadingHead
            self.dispatch_request(conn, raw_req, raw_head, body, callbacks)
          } else {
            conn.mode = ConnMode::ReadingFixedBody(raw_req, raw_head, expected, chunks, new_got)
            break
          }
        } else {
          let take = conn.rx_buf.slice(0, need)
          let rest = conn.rx_buf.slice(need, avail)
          chunks.push(take)
          conn.rx_buf = rest
          let body = concat_chunks(chunks, expected.to_int())
          conn.mode = ConnMode::ReadingHead
          self.dispatch_request(conn, raw_req, raw_head, body, callbacks)
        }
      }
      ConnMode::ReadingChunkedBody(raw_req, raw_head, dec, chunks, got) => {
        if conn.rx_buf.length() > 0 {
          dec.feed(conn.rx_buf)
          conn.rx_buf = Bytes::new(0)
        }
        let mut cur_got = got
        let mut finished = false
        let mut failed = false
        while true {
          match dec.next() {
            Ok(http1::ChunkStep::Data(c)) => {
              let next_got = cur_got + c.length()
              if next_got.to_int64() > self.limits.max_body_bytes {
                self.send_error_and_close(conn, 413, "payload too large", callbacks)
                failed = true
                break
              }
              chunks.push(c)
              cur_got = next_got
            }
            Ok(http1::ChunkStep::NeedMore) => break
            Ok(http1::ChunkStep::Done(_trailers)) => {
              conn.rx_buf = dec.take_remaining()
              let body = concat_chunks(chunks, cur_got)
              conn.mode = ConnMode::ReadingHead
              self.dispatch_request(conn, raw_req, raw_head, body, callbacks)
              finished = true
              break
            }
            Err(http1::HttpError::ChunkTooLarge) => {
              self.send_error_and_close(conn, 413, "payload too large", callbacks)
              failed = true
              break
            }
            Err(e) => {
              self.send_error_and_close(conn, 400, http1::http_error_string(e), callbacks)
              failed = true
              break
            }
          }
        }
        if failed {
          break
        }
        if !finished {
          conn.mode = ConnMode::ReadingChunkedBody(raw_req, raw_head, dec, chunks, cur_got)
          break
        }
      }
      _ => break
    }
  }
  if steps == 16 && !conn.closed && conn.rx_buf.length() > 0 {
    match conn.mode {
      ConnMode::ReadingHead => {
        self.send_error_and_close(conn, 400, "too many pipelined requests", callbacks)
      }
      _ => ()
    }
  }
}

/// Send a streaming HTTP/1.1 chunk on a connection in `WritingChunked` mode.
pub fn HttpServer::send_chunk(self : HttpServer, conn_id : Int, data : Bytes) -> Bool {
  if data.length() == 0 {
    return true
  }
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return false
  }
  match conn.mode {
    ConnMode::WritingChunked(_, suppress_body) => {
      if suppress_body {
        return true
      }
      let encoded = http1::encode_chunk(data)
      if !self.enqueue_write(conn, encoded) {
        self.close_conn_silent(conn_id)
        return false
      }
      true
    }
    _ => false
  }
}

/// Finish a streaming chunked response (`0\r\n\r\n`) and return to keep-alive or close.
pub fn HttpServer::finish_chunked(
  self : HttpServer,
  conn_id : Int,
  trailers : Array[http1::Header],
) -> Bool {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return false
  }
  match conn.mode {
    ConnMode::WritingChunked(keep_alive, suppress_body) => {
      if !suppress_body {
        let fin = match http1::encode_final_chunk(trailers) {
          Ok(b) => b
          Err(_) => "0\r\n\r\n".to_bytes()
        }
        if !self.enqueue_write(conn, fin) {
          self.close_conn_silent(conn_id)
          return false
        }
      }
      if keep_alive && !self.closing {
        conn.mode = ConnMode::ReadingHead
      } else {
        conn.close_after_flush = true
        conn.mode = ConnMode::Closing
        if !self.outbox.is_busy(conn_id) {
          self.close_conn_silent(conn_id)
        }
      }
      true
    }
    _ => false
  }
}

/// Finish a streaming chunked response and immediately resume any pipelined HTTP requests in `rx_buf`.
pub fn HttpServer::finish_chunked_with_callbacks(
  self : HttpServer,
  conn_id : Int,
  trailers : Array[http1::Header],
  callbacks : ServerCallbacks,
) -> Bool {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return false
  }
  match conn.mode {
    ConnMode::WritingChunked(keep_alive, suppress_body) => {
      if !suppress_body {
        let fin = match http1::encode_final_chunk(trailers) {
          Ok(b) => b
          Err(_) => "0\r\n\r\n".to_bytes()
        }
        if !self.enqueue_write(conn, fin) {
          self.close_conn_with_callbacks(conn_id, callbacks, false)
          return false
        }
      }
      if keep_alive && !self.closing {
        conn.mode = ConnMode::ReadingHead
        if conn.rx_buf.length() > 0 {
          self.process_rx(conn, Bytes::new(0), callbacks)
        }
      } else {
        conn.close_after_flush = true
        conn.mode = ConnMode::Closing
        if !self.outbox.is_busy(conn_id) {
          self.close_conn_with_callbacks(conn_id, callbacks, false)
        }
      }
      true
    }
    _ => false
  }
}

/// Send an SSE event on an active SSE connection (framed as an HTTP/1.1 chunk).
pub fn HttpServer::sse_send(
  self : HttpServer,
  conn_id : Int,
  event_type : String,
  data : String,
  id : String,
  retry : Option[Int64],
) -> Result[Bool, String] {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return Ok(false)
  }
  match conn.mode {
    ConnMode::Sse => {
      let wire = match encode_sse_event(event_type, data, id, retry) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      let chunked = http1::encode_chunk(wire)
      if !self.enqueue_write(conn, chunked) {
        self.close_conn_silent(conn_id)
        return Ok(false)
      }
      Ok(true)
    }
    _ => Ok(false)
  }
}

/// Send an SSE heartbeat comment (`: ping\n\n`) on an active SSE connection (framed as an HTTP/1.1 chunk).
pub fn HttpServer::sse_ping(self : HttpServer, conn_id : Int) -> Bool {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return false
  }
  match conn.mode {
    ConnMode::Sse => {
      let chunked = http1::encode_chunk(encode_sse_ping())
      if !self.enqueue_write(conn, chunked) {
        self.close_conn_silent(conn_id)
        return false
      }
      true
    }
    _ => false
  }
}

/// Close an active SSE connection cleanly by writing the terminating `0\r\n\r\n` chunk before closing.
pub fn HttpServer::sse_close(self : HttpServer, conn_id : Int) -> Unit {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return ()
  }
  match conn.mode {
    ConnMode::Sse => {
      let fin = match http1::encode_final_chunk([]) {
        Ok(b) => b
        Err(_) => "0\r\n\r\n".to_bytes()
      }
      let _ = self.enqueue_write(conn, fin)
      conn.mode = ConnMode::Closing
      conn.close_after_flush = true
      if !self.outbox.is_busy(conn_id) {
        self.close_conn_silent(conn_id)
      }
    }
    _ => ()
  }
}

/// Send a WebSocket text frame on an upgraded connection.
pub fn HttpServer::ws_send_text(self : HttpServer, conn_id : Int, text : String) -> Bool {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return false
  }
  match conn.mode {
    ConnMode::WebSocket(_) => {
      if !self.enqueue_write(conn, encode_ws_text(text)) {
        self.close_conn_silent(conn_id)
        return false
      }
      true
    }
    _ => false
  }
}

/// Send a WebSocket binary frame on an upgraded connection.
pub fn HttpServer::ws_send_binary(self : HttpServer, conn_id : Int, data : Bytes) -> Bool {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return false
  }
  match conn.mode {
    ConnMode::WebSocket(_) => {
      if !self.enqueue_write(conn, encode_ws_binary(data)) {
        self.close_conn_silent(conn_id)
        return false
      }
      true
    }
    _ => false
  }
}

/// Send a WebSocket ping frame on an upgraded connection.
pub fn HttpServer::ws_send_ping(self : HttpServer, conn_id : Int, payload : Bytes) -> Bool {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return false
  }
  match conn.mode {
    ConnMode::WebSocket(_) => {
      if !self.enqueue_write(conn, encode_ws_ping(payload)) {
        self.close_conn_silent(conn_id)
        return false
      }
      true
    }
    _ => false
  }
}

/// Send a WebSocket close frame and close the connection after flush.
pub fn HttpServer::ws_close(self : HttpServer, conn_id : Int, code : Int, reason : String) -> Bool {
  let conn = match self.conns.get(conn_id) {
    Some(c) => c
    None => return false
  }
  match conn.mode {
    ConnMode::WebSocket(ws) => {
      if !ws.close_sent {
        ws.close_sent = true
        let _ = self.enqueue_write(conn, encode_ws_close(code, reason))
      }
      conn.close_after_flush = true
      if !self.outbox.is_busy(conn_id) {
        self.close_conn_silent(conn_id)
      }
      true
    }
    _ => false
  }
}

fn is_fatal_accept_error(msg : String) -> Bool {
  msg.index_of("not a listening socket") >= 0 ||
  msg.index_of("no handle") >= 0 ||
  msg.index_of("bad file descriptor") >= 0 ||
  msg.index_of("closed") >= 0
}

/// Handle a `ShellMux` completion token. Returns `true` if the token belonged to `HttpServer`.
pub fn HttpServer::handle_done(
  self : HttpServer,
  tok : builders_core::MuxToken,
  done : host_shim::ShellDone,
  callbacks : ServerCallbacks,
) -> Bool {
  match tok {
    builders_core::MuxToken::Tagged(owner_id, kind, gen) => {
      if kind == HTTP_TOK_LISTEN {
        match builders_core::decode_shell_done(done) {
          Err(e) => {
            self.listen_error = Some(e.message)
            (callbacks.on_error)("http listen failed: " + e.message)
          }
          Ok((j_opt, _)) => {
            let said = match j_opt {
              Some(j) => j
              None => base_codec::json_null()
            }
            let lid = json_int_field(said, "id", -1)
            if lid < 0 {
              self.listen_error = Some("shell returned no listener id")
              (callbacks.on_error)("http listen failed: no listener id")
              return true
            }
            let port = json_int_field(said, "port", 0)
            self.listen_id = Some(lid)
            self.listen_port = port
            self.listening = !self.closing
            self.consecutive_accept_errors = 0
            if self.closing {
              self.close()
            } else {
              self.start_accept(lid)
            }
          }
        }
        true
      } else if kind == HTTP_TOK_ACCEPT {
        match builders_core::decode_shell_done(done) {
          Err(e) => {
            if !self.closing {
              (callbacks.on_error)("http accept failed: " + e.message)
              self.consecutive_accept_errors = self.consecutive_accept_errors + 1
              if is_fatal_accept_error(e.message) || self.consecutive_accept_errors > 8 {
                self.listening = false
                self.listen_id = None
              } else {
                match self.listen_id {
                  Some(lid) => self.start_accept(lid)
                  None => self.listening = false
                }
              }
            }
          }
          Ok((j_opt, _)) => {
            self.consecutive_accept_errors = 0
            let said = match j_opt {
              Some(j) => j
              None => base_codec::json_null()
            }
            let conn_id = json_int_field(said, "id", -1)
            let peer = json_str_field(said, "peer", "")
            // Re-arm accept immediately if still listening.
            match self.listen_id {
              Some(lid) => {
                if !self.closing {
                  self.start_accept(lid)
                }
              }
              None => ()
            }
            if conn_id < 0 {
              return true
            }
            if self.closing || self.conns.length() >= self.limits.max_connections {
              self.send_tcp_close(conn_id, 0L)
              return true
            }
            if !(callbacks.on_accept)(conn_id, peer) {
              self.send_tcp_close(conn_id, 0L)
              return true
            }
            self.next_gen = self.next_gen + 1L
            let cgen = self.next_gen
            self.total_accepted = self.total_accepted + 1L
            let conn = HttpConn::new(conn_id, cgen, peer, self.mux.now_ms())
            self.conns.set(conn_id, conn)
            self.start_read(conn_id, cgen)
          }
        }
        true
      } else if kind == HTTP_TOK_READ {
        let conn = match self.conns.get(owner_id) {
          Some(c) => {
            if c.gen != gen || c.closed {
              return true
            }
            c
          }
          None => return true
        }
        match builders_core::decode_shell_done(done) {
          Err(_) => {
            self.close_conn_with_callbacks(owner_id, callbacks, true)
          }
          Ok((j_opt, bytes_opt)) => {
            let said = match j_opt {
              Some(j) => j
              None => base_codec::json_null()
            }
            let is_end = json_bool_field(said, "e" + "nd", false)
            if is_end {
              self.close_conn_with_callbacks(owner_id, callbacks, true)
              return true
            }
            conn.last_activity_ms = self.mux.now_ms()
            match bytes_opt {
              Some(chunk) => {
                if chunk.length() > 0 {
                  self.process_rx(conn, chunk, callbacks)
                }
              }
              None => ()
            }
            if !conn.closed && !conn.close_after_flush {
              self.start_read(conn.id, conn.gen)
            }
          }
        }
        true
      } else if kind == HTTP_TOK_WRITE {
        let _ = self.outbox.on_complete(self.mux, owner_id, done.id)
        let conn = match self.conns.get(owner_id) {
          Some(c) => {
            if c.gen != gen || c.closed {
              return true
            }
            c
          }
          None => return true
        }
        let _ = conn.pop_write_size()
        if done.error.length() > 0 {
          self.close_conn_with_callbacks(owner_id, callbacks, true)
          return true
        }
        conn.last_activity_ms = self.mux.now_ms()
        if conn.close_after_flush && !self.outbox.is_busy(owner_id) {
          self.close_conn_with_callbacks(owner_id, callbacks, false)
        }
        true
      } else if kind == HTTP_TOK_CLOSE || kind == HTTP_TOK_LISTEN_CLOSE {
        true
      } else {
        false
      }
    }
    _ => false
  }
}

/// Run one event-loop tick on the underlying `ShellMux`, dispatching HTTP/SSE/WS events
/// and sweeping idle keep-alive connections.
pub fn HttpServer::step(
  self : HttpServer,
  wait_ms : Int64,
  callbacks : ServerCallbacks,
) -> Bool {
  let progressed = self.mux.step(
    wait_ms,
    fn(_line : String) -> Unit {},
    fn() -> Unit {},
    fn(tok : builders_core::MuxToken, done : host_shim::ShellDone) -> Unit {
      let _ = self.handle_done(tok, done, callbacks)
    },
  )
  let swept = self.sweep_idle(self.mux.now_ms(), callbacks)
  progressed || swept > 0
}
