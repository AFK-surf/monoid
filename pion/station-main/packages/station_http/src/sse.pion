// Server-Sent Events (SSE) formatting and stream helpers over `pion-packages/sse`.

import "http1"
import "sse"

/// Lightweight value-type handle for an active SSE connection (zero RC cycles).
pub val struct SseStream {
  pub conn_id : Int
}

pub fn SseStream::new(conn_id : Int) -> SseStream {
  SseStream::{ conn_id: conn_id }
}

/// Build HTTP headers for an SSE `text/event-stream` response.
/// - `use_chunked`: true for HTTP/1.1 streaming (`Transfer-Encoding: chunked`), false for HTTP/1.0 or `HEAD`.
/// - `is_head`: true for `HEAD` requests (no `Transfer-Encoding: chunked`, no synthetic `Content-Length: 0`, `Connection: close`).
/// - `keep_alive`: negotiated keep-alive flag (`Connection: close` when request or server requires close).
pub fn sse_response_headers_for(
  extra : Array[http1::Header],
  use_chunked : Bool,
  is_head : Bool,
  keep_alive : Bool,
) -> Array[http1::Header] {
  let out : Array[http1::Header] = [
    http1::Header::new("Content-Type", "text/event-stream; charset=utf-8"),
    http1::Header::new("Cache-Control", "no-cache"),
    http1::Header::new(
      "Connection",
      if !is_head && use_chunked && keep_alive { "keep-alive" } else { "close" },
    ),
    http1::Header::new("X-Accel-Buffering", "no"),
  ]
  if !is_head && use_chunked {
    out.push(http1::Header::new("Transfer-Encoding", "chunked"))
  }
  let mut i = 0
  while i < extra.length() {
    let h = extra[i]
    if !ascii_eq_ci(h.name, "content-type") &&
    !ascii_eq_ci(h.name, "cache-control") &&
    !ascii_eq_ci(h.name, "connection") &&
    !ascii_eq_ci(h.name, "content-length") &&
    !ascii_eq_ci(h.name, "transfer-encoding") {
      out.push(h)
    }
    i = i + 1
  }
  out
}

/// Build canonical HTTP/1.1 chunked headers for an SSE `text/event-stream` response.
pub fn sse_response_headers(extra : Array[http1::Header]) -> Array[http1::Header] {
  sse_response_headers_for(extra, true, false, true)
}

/// Format a full SSE event (`event`, `id`, `retry`, multi-line `data`) via `pion-packages/sse`.
pub fn encode_sse_event(
  event_type : String,
  data : String,
  id : String,
  retry : Option[Int64],
) -> Result[Bytes, String] {
  let ev = sse::SseEvent::{
    event_type: if event_type.length() == 0 { "message" } else { event_type },
    data: data,
    id: id,
    retry: retry,
  }
  match sse::format_event_bytes(ev) {
    Ok(b) => Ok(b)
    Err(e) => Err(e.message())
  }
}

/// Format a simple `data:` SSE event via `pion-packages/sse`.
pub fn encode_sse_data(data : String) -> Result[Bytes, String] {
  match sse::format_event_bytes(sse::SseEvent::new(data)) {
    Ok(b) => Ok(b)
    Err(e) => Err(e.message())
  }
}

/// Format an SSE comment line(s) followed by a blank line.
pub fn encode_sse_comment(comment : String) -> Result[Bytes, String] {
  match sse::format_comment(comment) {
    Ok(s) => Ok((s + "\n").to_bytes())
    Err(e) => Err(e.message())
  }
}

/// Format a standard SSE heartbeat comment (`: ping\n\n`).
pub fn encode_sse_ping() -> Bytes {
  match encode_sse_comment("ping") {
    Ok(b) => b
    Err(_) => ": ping\n\n".to_bytes()
  }
}
