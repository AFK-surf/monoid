// Core `Store` write engine for the pure-Pion station (`station_store`):
// - Opens and migrates `stillfail.db` with WAL, busy_timeout, foreign_keys, forward tolerance
// - All write transactions go through `sql_db::Db::tx` / `Db::tx_err` (zero raw tx SQL)
// - Built-in `SQLITE_BUSY` retry wrapper + slow-SQL timing tracker
// - Core session, thread, entry, delivery, turn, metadata, and `chat_list` operations.

import "base_codec"
import "host_shim"
import "jscase"
import "sql_db"
import "station_conv"

pub struct Store {
  pub db : sql_db::Db
  pub path : String
  pub schema_version : Int
  pub tracker : TimedTracker
}

pub struct NewSession {
  pub key : String
  pub connect : String
  pub sess_scope : String
  pub title : Option[String]
  pub created_by : Option[String]
  pub created_by_sub : Option[String]
  pub runtime : String
  pub profile : String
  pub model : Option[String]
  pub effort : Option[String]
  pub workspace : String
  pub cwd : Option[String]
  pub token : String
  pub created_at : Int64
  pub last_active_at : Int64
  pub ws : Option[String]
  pub told_notes : Int64
}

pub struct SessionRow {
  pub key : String
  pub connect : String
  pub sess_scope : String
  pub title : Option[String]
  pub created_by : Option[String]
  pub runtime : String
  pub profile : String
  pub model : Option[String]
  pub effort : Option[String]
  pub workspace : String
  pub cwd : Option[String]
  pub token : String
  pub running : Bool
  pub created_at : Int64
  pub last_active_at : Int64
  pub archived_at : Option[Int64]
  pub archived_by : Option[String]
  pub shown_at : Option[Int64]
  pub ws : Option[String]
  pub conv : Option[String]
}

pub struct ThreadRow {
  pub id : Int64
  pub surface : String
  pub channel : String
  pub thread_ts : String
  pub title : Option[String]
  pub auto_title : Option[String]
  pub created_by : Option[String]
  pub created_at : Int64
  pub home : Option[String]
  pub hidden_at : Option[Int64]
  pub hidden_by : Option[String]
  pub shown_at : Option[Int64]
  pub project : Option[String]
  pub project_locked : Bool
  pub tags : Array[String]
}

pub struct NewMessage {
  pub thread : Int64
  pub ts : Option[String]
  pub author_kind : String
  pub author : String
  pub agent_identity : Option[String]
  pub text : Option[String]
  pub attachments : Option[String]
  pub quotes : Option[String]
  pub declared : Option[String]
  pub client : Option[String]
