// Chat handover / snapshot read & write contract compatible with
// `station/src/store/handover.ts` (`handover_in`, `handed_over`, bounded paging
// with composite cursors, forward-tolerant column-intersecting inserts/updates,
// lossless non-fresh entry/letter remapping, and rollback-safe staging state).

import "base_codec"
import "sql_db"

pub let HANDOVER_PAGE : Int = 500

pub fn chat_tables() -> Array[String] {
  [
    "threads",
    "sessions",
    "thread_sessions",
    "entries",
    "letters",
    "turns",
    "runtime_sessions",
    "closed_cards",
    "entry_proposals",
    "proposal_outcomes",
    "deferred_files",
    "reads",
    "hidden_chats",
    "muted_chats",
    "kept_chats",
    "dismissed",
    "pins",
    "opened_chats",
    "deliveries",
    "usage",
    "usage_files",
    "session_usage",
  ]
}

pub fn usage_columns() -> Array[String] {
  [
    "id",
    "at",
    "session",
    "turn",
    "thread",
    "person",
    "profile",
    "runtime",
    "model",
    "subagent",
    "fast",
    "input",
    "cache_read",
    "cache_write",
    "cache_write_long",
    "output",
    "calls",
    "context",
    "context_window",
  ]
}

/// Map a connect id from a source station to this station (`handover.ts` `connectHere`).
pub fn connect_here(connect : String, connects : Map[String, String]) -> String {
  if connect == "ember" || connect == "stillfail" {
    return STILLFAIL_CONNECT
  }
  match connects.get(connect) {
    Some(mapped) => mapped
    None => connect
  }
}

/// Map a surface (`feishu:<id>`, `comma:<id>`, etc.) from a source station (`handover.ts` `surfaceHere`).
pub fn surface_here(surface : String, connects : Map[String, String]) -> String {
  if surface == "ember" || surface == "stillfail" {
    return STILLFAIL_SURFACE
  }
  let at = str_index_of_byte(surface, 58)
  if at < 0 {
    return surface
  }
  let b = surface.to_bytes()
  let prefix = slice_bytes(b, 0, at + 1)
  let id = slice_bytes(b, at + 1, b.length())
  match connects.get(id) {
    Some(mapped) => prefix + mapped
    None => surface
  }
}

/// Increment trailing ASCII decimal digits of a thread timestamp string (`handover.ts` `bump`).
pub fn bump_ts(ts : String) -> String {
  let b = ts.to_bytes()
  let n = b.length()
  let mut i = n
  while i > 0 {
    let c = b[i - 1].to_int() & 0xFF
    if c >= 48 && c <= 57 {
      i = i - 1
    } else {
      break
    }
  }
  if i == n {
    return ts + "1"
  }
  let prefix = slice_bytes(b, 0, i)
  let digits = slice_bytes(b, i, n)
  let db = digits.to_bytes()
  let out = Bytes::new(db.length())
  let mut carry = 1
  let mut k = db.length() - 1
  while k >= 0 {
    let d = (db[k].to_int() & 0xFF) - 48 + carry
    if d >= 10 {
      out[k] = (48 + (d - 10)) as Byte
      carry = 1
    } else {
      out[k] = (48 + d) as Byte
      carry = 0
    }
    k = k - 1
  }
  if carry > 0 {
    prefix + "1" + slice_bytes(out, 0, out.length())
  } else {
    prefix + slice_bytes(out, 0, out.length())
  }
}

/// Rewrite a path prefix from `from_data` to `to_data` (`handover.ts` `moved`).
pub fn moved_path(path : String, from_data : String, to_data : String) -> String {
  if from_data.length() == 0 || from_data == to_data {
    return path
  }
  let f = if str_has_suffix(from_data, "/") {
    str_slice_bytes(from_data, 0, from_data.to_bytes().length() - 1)
  } else {
    from_data
  }
  if path == f {
    return to_data
  }
  let f_slash = f + "/"
  if str_has_prefix(path, f_slash) {
    let rest = str_slice_bytes(path, f_slash.to_bytes().length(), path.to_bytes().length())
    let base = if str_has_suffix(to_data, "/") { to_data } else { to_data + "/" }
    return base + rest
  }
  path
}

pub struct HandedRecord {
  pub session : String
  pub station : String
  pub ws : Option[String]
  pub thread : Option[Int64]
  pub there : Option[Int64]
  pub at : Int64
}

pub fn record_handed_over(db : sql_db::Db, rec : HandedRecord) -> Result[Unit, sql_db::SqlError] {
  with_write_tx(db, "st_record_handed_over", fn(t : sql_db::Db) -> Result[Unit, sql_db::SqlError] {
    match t.run(
      "INSERT INTO handed_over (session, station, ws, thread, there, at) VALUES (?1, ?2, ?3, ?4, ?5, ?6)" +
      " ON CONFLICT (session) DO UPDATE SET station = excluded.station, ws = excluded.ws, thread = excluded.thread, there = excluded.there, at = excluded.at",
      [
        base_codec::json_str(rec.session),
        base_codec::json_str(rec.station),
        opt_str_to_json(rec.ws),
        opt_i64_to_json(rec.thread),
        opt_i64_to_json(rec.there),
        sql_db::int64_to_json(rec.at),
      ],
    ) {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
  })
}

pub fn get_handed_over(db : sql_db::Db, session : String) -> Result[Option[HandedRecord], sql_db::SqlError] {
  match db.first("SELECT * FROM handed_over WHERE session = ?1", [base_codec::json_str(session)]) {
    Ok(Some(r)) => Ok(
      Some(
        HandedRecord::{
          session: row_str(r, "session", ""),
          station: row_str(r, "station", ""),
          ws: row_str_opt(r, "ws"),
          thread: row_i64_opt(r, "thread"),
          there: row_i64_opt(r, "there"),
          at: row_i64(r, "at", 0.to_int64()),
        },
      ),
    )
    Ok(None) => Ok(None)
    Err(e) => Err(e)
  }
}

pub fn delete_handed_over(db : sql_db::Db, session : String) -> Result[Bool, sql_db::SqlError] {
  with_write_tx(db, "st_delete_handed_over", fn(t : sql_db::Db) -> Result[Bool, sql_db::SqlError] {
    match t.run("DELETE FROM handed_over WHERE session = ?1", [base_codec::json_str(session)]) {
      Ok(n) => Ok(n > 0)
      Err(e) => Err(e)
    }
  })
}

pub fn handed_stations(db : sql_db::Db) -> Result[Array[String], sql_db::SqlError] {
  let rows = match db.all("SELECT DISTINCT station FROM handed_over ORDER BY station", []) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let out : Array[String] = []
  for i in 0..<rows.length() {
    let s = row_str(rows[i], "station", "")
    if s.length() > 0 {
      out.push(s)
    }
  }
  Ok(out)
}

/// Save handover-in context using `ON CONFLICT DO UPDATE` so extra/future columns on `handover_in` are preserved.
pub fn save_handover_in(db : sql_db::Db, id : String, ctx_json : String) -> Result[Unit, sql_db::SqlError] {
  with_write_tx(db, "st_save_handover_in", fn(t : sql_db::Db) -> Result[Unit, sql_db::SqlError] {
    match t.run(
      "INSERT INTO handover_in (id, ctx) VALUES (?1, ?2) ON CONFLICT (id) DO UPDATE SET ctx = excluded.ctx",
      [base_codec::json_str(id), base_codec::json_str(ctx_json)],
    ) {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
  })
}

pub fn load_handover_in(db : sql_db::Db, id : String) -> Result[Option[String], sql_db::SqlError] {
  match db.first("SELECT ctx FROM handover_in WHERE id = ?1", [base_codec::json_str(id)]) {
    Ok(Some(r)) => Ok(row_str_opt(r, "ctx"))
    Ok(None) => Ok(None)
    Err(e) => Err(e)
  }
}

pub fn delete_handover_in(db : sql_db::Db, id : String) -> Result[Bool, sql_db::SqlError] {
  with_write_tx(db, "st_delete_handover_in", fn(t : sql_db::Db) -> Result[Bool, sql_db::SqlError] {
    match t.run("DELETE FROM handover_in WHERE id = ?1", [base_codec::json_str(id)]) {
      Ok(n) => Ok(n > 0)
      Err(e) => Err(e)
    }
  })
}

/// Threads participated in by `keys`, after `after_thread`, ascending, capped at `limit`.
pub fn chat_threads(
  db : sql_db::Db,
  keys : Array[String],
  after_thread : Int64,
  limit : Int = HANDOVER_PAGE,
) -> Result[Array[Int64], sql_db::SqlError] {
  let out : Array[Int64] = []
  for i in 0..<keys.length() {
    let rows = match db.all(
      "SELECT thread FROM thread_sessions WHERE session = ?1 AND thread > ?2 ORDER BY thread LIMIT ?3",
      [base_codec::json_str(keys[i]), sql_db::int64_to_json(after_thread), base_codec::json_int(limit)],
    ) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    for j in 0..<rows.length() {
      push_unique_i64(out, row_i64(rows[j], "thread", 0.to_int64()))
    }
  }
  for i in 1..<out.length() {
    let cur = out[i]
    let mut j = i - 1
    while j >= 0 && out[j] > cur {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
  }
  if out.length() > limit {
    let trimmed : Array[Int64] = []
    for i in 0..<limit {
      trimmed.push(out[i])
    }
    Ok(trimmed)
  } else {
    Ok(out)
  }
}

fn json_to_i64(v : base_codec::Json, default_val : Int64) -> Int64 {
  match v {
    base_codec::Json::Num(d, repr) => {
      if repr.length() > 0 {
        match sql_db::parse_int64_strict(repr) {
          Some(n) => n
          None => d.to_int64()
        }
      } else {
        d.to_int64()
      }
    }
    _ => default_val
  }
}

fn json_to_str(v : base_codec::Json, default_val : String) -> String {
  match v {
    base_codec::Json::Str(s) => s
    _ => default_val
  }
}

fn cursor_i64_str(after_cursor : Option[base_codec::Json], default_i : Int64) -> (Int64, String) {
  match after_cursor {
    Some(base_codec::Json::Arr(arr)) => {
      let a = if arr.length() > 0 { json_to_i64(arr[0], default_i) } else { default_i }
      let b = if arr.length() > 1 { json_to_str(arr[1], "") } else { "" }
      (a, b)
    }
    _ => (default_i, "")
  }
}

fn cursor_str_i64(after_cursor : Option[base_codec::Json], default_n : Int64) -> (String, Int64) {
  match after_cursor {
    Some(base_codec::Json::Arr(arr)) => {
      let a = if arr.length() > 0 { json_to_str(arr[0], "") } else { "" }
      let b = if arr.length() > 1 { json_to_i64(arr[1], default_n) } else { default_n }
      (a, b)
    }
    _ => ("", default_n)
  }
}

fn cursor_i64_i64(after_cursor : Option[base_codec::Json], default_a : Int64, default_b : Int64) -> (Int64, Int64) {
  match after_cursor {
    Some(base_codec::Json::Arr(arr)) => {
      let a = if arr.length() > 0 { json_to_i64(arr[0], default_a) } else { default_a }
      let b = if arr.length() > 1 { json_to_i64(arr[1], default_b) } else { default_b }
      (a, b)
    }
    _ => (default_a, default_b)
  }
}

fn cursor_str(after_cursor : Option[base_codec::Json]) -> String {
  match after_cursor {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
}

/// Bounded page read for any table in `chat_tables()` with exact composite cursors matching `handover.ts:45-97`.
pub fn chat_page(
  db : sql_db::Db,
  table : String,
  target_id : base_codec::Json,
  after_n : Int64 = -1.to_int64(),
  limit : Int = HANDOVER_PAGE,
  keys : Array[String] = [],
  after_cursor : Option[base_codec::Json] = None,
) -> Result[Array[Map[String, base_codec::Json]], sql_db::SqlError] {
  if table == "threads" {
    return db.all("SELECT * FROM threads WHERE id = ?1", [target_id])
  }
  if table == "sessions" {
    return db.all("SELECT * FROM sessions WHERE key = ?1", [target_id])
  }
  if table == "thread_sessions" {
    return db.all(
      "SELECT * FROM thread_sessions WHERE thread = ?1 AND session IN (SELECT value FROM json_each(?2))",
      [target_id, base_codec::json_str(json_str_arr(keys))],
    )
  }
  if table == "entries" || table == "letters" || table == "closed_cards" || table == "entry_proposals" || table == "proposal_outcomes" {
    let cur_n = match after_cursor {
      Some(c) => json_to_i64(c, after_n)
      None => after_n
    }
    return db.all(
      "SELECT * FROM " + table + " WHERE thread = ?1 AND n > ?2 ORDER BY n LIMIT ?3",
      [target_id, sql_db::int64_to_json(cur_n), base_codec::json_int(limit)],
    )
  }
  if table == "deferred_files" {
    let is_num = match after_cursor {
      Some(base_codec::Json::Num(_, _)) => true
      _ => false
    }
    if is_num {
      let cur_n = match after_cursor {
        Some(c) => json_to_i64(c, after_n)
        None => after_n
      }
      return db.all(
        "SELECT * FROM deferred_files WHERE thread = ?1 AND n > ?2 ORDER BY n, file_id LIMIT ?3",
        [target_id, sql_db::int64_to_json(cur_n), base_codec::json_int(limit)],
      )
    }
    let (n_val, fid) = cursor_i64_str(after_cursor, after_n)
    return db.all(
      "SELECT * FROM deferred_files WHERE thread = ?1 AND (n > ?2 OR (n = ?2 AND file_id > ?3)) ORDER BY n, file_id LIMIT ?4",
      [target_id, sql_db::int64_to_json(n_val), base_codec::json_str(fid), base_codec::json_int(limit)],
    )
  }
  if table == "reads" || table == "hidden_chats" || table == "muted_chats" || table == "kept_chats" {
    let after_v = cursor_str(after_cursor)
    return db.all(
      "SELECT * FROM " + table + " WHERE thread = ?1 AND viewer > ?2 ORDER BY viewer LIMIT ?3",
      [target_id, base_codec::json_str(after_v), base_codec::json_int(limit)],
    )
  }
  if table == "dismissed" {
    let (v, n) = cursor_str_i64(after_cursor, -1.to_int64())
    return db.all(
      "SELECT * FROM dismissed WHERE thread = ?1 AND (viewer > ?2 OR (viewer = ?2 AND n > ?3)) ORDER BY viewer, n LIMIT ?4",
      [target_id, base_codec::json_str(v), sql_db::int64_to_json(n), base_codec::json_int(limit)],
    )
  }
  if table == "turns" {
    let (at, id) = cursor_i64_str(after_cursor, -1.to_int64())
    return db.all(
      "SELECT * FROM turns WHERE session_key = ?1 AND (started_at > ?2 OR (started_at = ?2 AND id > ?3)) ORDER BY started_at, id LIMIT ?4",
      [target_id, sql_db::int64_to_json(at), base_codec::json_str(id), base_codec::json_int(limit)],
    )
  }
  if table == "runtime_sessions" {
    let after_id = cursor_str(after_cursor)
    return db.all(
      "SELECT * FROM runtime_sessions WHERE session_key = ?1 AND id > ?2 ORDER BY id LIMIT ?3",
      [target_id, base_codec::json_str(after_id), base_codec::json_int(limit)],
    )
  }
  if table == "pins" {
    let after_v = cursor_str(after_cursor)
    return db.all(
      "SELECT * FROM pins WHERE session = ?1 AND viewer > ?2 ORDER BY viewer LIMIT ?3",
      [target_id, base_codec::json_str(after_v), base_codec::json_int(limit)],
    )
  }
  if table == "deliveries" {
    let (t, n) = cursor_i64_i64(after_cursor, -1.to_int64(), -1.to_int64())
    return db.all(
      "SELECT * FROM deliveries WHERE session = ?1 AND delivered_at IS NULL AND (thread > ?2 OR (thread = ?2 AND n > ?3)) ORDER BY thread, n LIMIT ?4",
      [target_id, sql_db::int64_to_json(t), sql_db::int64_to_json(n), base_codec::json_int(limit)],
    )
  }
  if table == "opened_chats" {
    return db.all("SELECT * FROM opened_chats WHERE child_station = '' AND child = ?1", [target_id])
  }
  if table == "usage" {
    let (at, id) = cursor_i64_str(after_cursor, -9007199254740991.to_int64())
    let have = match table_columns(db, "usage") { Ok(c) => c, Err(e) => return Err(e) }
    let want = usage_columns()
    let sb = StringBuilder::new()
    let mut first = true
    for i in 0..<want.length() {
      if arr_contains_str(have, want[i]) {
        if !first { sb.write_string(", ") }
        sb.write_string(want[i])
        first = false
      }
    }
    return db.all(
      "SELECT " + sb.to_string() + " FROM usage INDEXED BY usage_session WHERE session = ?1 AND (at > ?2 OR (at = ?2 AND id > ?3)) ORDER BY at, id LIMIT ?4",
      [target_id, sql_db::int64_to_json(at), base_codec::json_str(id), base_codec::json_int(limit)],
    )
  }
  if table == "usage_files" {
    let after_path = cursor_str(after_cursor)
    return db.all(
      "SELECT * FROM usage_files WHERE session = ?1 AND path > ?2 ORDER BY path LIMIT ?3",
      [target_id, base_codec::json_str(after_path), base_codec::json_int(limit)],
    )
  }
  if table == "session_usage" {
    return db.all("SELECT * FROM session_usage WHERE session = ?1", [target_id])
  }
  Err(sql_db::sql_error(1, "unsupported handover table: " + table))
}

/// Forward-tolerant insert intersecting incoming columns with `pragma_table_info(table)`.
/// Unknown columns from a newer station are safely ignored; missing columns keep SQLite defaults.
pub fn insert_row_tolerant(
  db : sql_db::Db,
  table : String,
  row : Map[String, base_codec::Json],
  or_ignore : Bool = false,
) -> Result[Int, sql_db::SqlError] {
  let have = match table_columns(db, table) {
    Ok(cols) => cols
    Err(e) => return Err(e)
  }
  let cols : Array[String] = []
  let args : Array[base_codec::Json] = []
  for i in 0..<have.length() {
    let col = have[i]
    match row.get(col) {
      Some(v) => {
        cols.push(col)
        args.push(v)
      }
      None => ()
    }
  }
  if cols.length() == 0 {
    return Err(sql_db::sql_error(1, "no matching columns for table " + table))
  }
  let col_sb = StringBuilder::new()
  let q_sb = StringBuilder::new()
  for i in 0..<cols.length() {
    if i > 0 {
      col_sb.write_string(", ")
      q_sb.write_string(", ")
    }
    col_sb.write_string(cols[i])
    q_sb.write_string("?")
  }
  let verb = if or_ignore { "INSERT OR IGNORE INTO " } else { "INSERT INTO " }
  db.run(verb + table + " (" + col_sb.to_string() + ") VALUES (" + q_sb.to_string() + ")", args)
}

fn update_row_tolerant(
  db : sql_db::Db,
  table : String,
  pk_col : String,
  pk_val : base_codec::Json,
  row : Map[String, base_codec::Json],
) -> Result[Int, sql_db::SqlError] {
  let have = match table_columns(db, table) {
    Ok(cols) => cols
    Err(e) => return Err(e)
  }
  let sets = StringBuilder::new()
  let args : Array[base_codec::Json] = []
  let mut count = 0
  for i in 0..<have.length() {
    let col = have[i]
    if col == pk_col {
      continue
    }
    match row.get(col) {
      Some(v) => {
        if count > 0 {
          sets.write_string(", ")
        }
        sets.write_string(col)
        sets.write_string(" = ?")
        args.push(v)
        count = count + 1
      }
      None => ()
    }
  }
  if count == 0 {
    return Ok(0)
  }
  args.push(pk_val)
  db.run("UPDATE " + table + " SET " + sets.to_string() + " WHERE " + pk_col + " = ?", args)
}

pub struct HandoverThreadMap {
  pub remote_id : Int64
  pub local_id : Int64
  pub fresh : Bool
  pub linear : Bool
  pub letters_linear : Bool
  pub ns : Array[(Int64, Int64)]
  pub ls : Array[(Int64, Int64)]
}

fn clone_pairs_i64(src : Array[(Int64, Int64)]) -> Array[(Int64, Int64)] {
  let out : Array[(Int64, Int64)] = []
  for i in 0..<src.length() {
    out.push(src[i])
  }
  out
}

fn set_pair_i64(arr : Array[(Int64, Int64)], k : Int64, v : Int64) -> Unit {
  for i in 0..<arr.length() {
    let (ek, _) = arr[i]
    if ek == k {
      arr[i] = (k, v)
      return
    }
  }
  arr.push((k, v))
}

fn get_pair_i64(arr : Array[(Int64, Int64)], k : Int64) -> Option[Int64] {
  for i in 0..<arr.length() {
    let (ek, ev) = arr[i]
    if ek == k {
      return Some(ev)
    }
  }
  None
}

fn clone_thread_map(tm : HandoverThreadMap) -> HandoverThreadMap {
  HandoverThreadMap::{
    remote_id: tm.remote_id,
    local_id: tm.local_id,
    fresh: tm.fresh,
    linear: tm.linear,
    letters_linear: tm.letters_linear,
    ns: clone_pairs_i64(tm.ns),
    ls: clone_pairs_i64(tm.ls),
  }
}

pub struct HandoverImportState {
  pub from_station : String
  pub here_station : Option[String]
  pub from_data : String
  pub to_data : String
  pub ws : String
  pub connects : Map[String, String]
  pub profiles : Map[String, String]
  pub threads : Array[HandoverThreadMap]
  pub added_sessions : Array[String]
  pub session_befores : Array[(String, Option[Map[String, base_codec::Json]])]
  pub added_members : Array[(Int64, String)]
  pub added_entries : Array[(Int64, Int64)]
  pub added_letters : Array[(Int64, Int64)]
  pub added_rows : Array[(String, Array[(String, base_codec::Json)])]
  pub before_rows : Array[(String, Map[String, base_codec::Json])]
  pub thread_written_class : Array[(Int64, Option[String], Int64, Option[String])]
}

pub fn HandoverImportState::new(
  from_station : String,
  from_data : String,
  to_data : String,
  ws : String,
  here_station : Option[String] = None,
) -> HandoverImportState {
  HandoverImportState::{
    from_station: from_station,
    here_station: here_station,
    from_data: from_data,
    to_data: to_data,
    ws: ws,
    connects: Map::new(),
    profiles: Map::new(),
    threads: [],
    added_sessions: [],
    session_befores: [],
    added_members: [],
    added_entries: [],
    added_letters: [],
    added_rows: [],
    before_rows: [],
    thread_written_class: [],
  }
}

pub fn HandoverImportState::clone(self : HandoverImportState) -> HandoverImportState {
  let threads : Array[HandoverThreadMap] = []
  for i in 0..<self.threads.length() {
    threads.push(clone_thread_map(self.threads[i]))
  }
  let added_sessions : Array[String] = []
  for i in 0..<self.added_sessions.length() {
    added_sessions.push(self.added_sessions[i])
  }
  let session_befores : Array[(String, Option[Map[String, base_codec::Json]])] = []
  for i in 0..<self.session_befores.length() {
    session_befores.push(self.session_befores[i])
  }
  let added_members : Array[(Int64, String)] = []
  for i in 0..<self.added_members.length() {
    added_members.push(self.added_members[i])
  }
  let added_entries : Array[(Int64, Int64)] = []
  for i in 0..<self.added_entries.length() {
    added_entries.push(self.added_entries[i])
  }
  let added_letters : Array[(Int64, Int64)] = []
  for i in 0..<self.added_letters.length() {
    added_letters.push(self.added_letters[i])
  }
  let added_rows : Array[(String, Array[(String, base_codec::Json)])] = []
  for i in 0..<self.added_rows.length() {
    added_rows.push(self.added_rows[i])
  }
  let before_rows : Array[(String, Map[String, base_codec::Json])] = []
  for i in 0..<self.before_rows.length() {
    before_rows.push(self.before_rows[i])
  }
  let thread_written_class : Array[(Int64, Option[String], Int64, Option[String])] = []
  for i in 0..<self.thread_written_class.length() {
    thread_written_class.push(self.thread_written_class[i])
  }
  HandoverImportState::{
    from_station: self.from_station,
    here_station: self.here_station,
    from_data: self.from_data,
    to_data: self.to_data,
    ws: self.ws,
    connects: self.connects,
    profiles: self.profiles,
    threads: threads,
    added_sessions: added_sessions,
    session_befores: session_befores,
    added_members: added_members,
    added_entries: added_entries,
    added_letters: added_letters,
    added_rows: added_rows,
    before_rows: before_rows,
    thread_written_class: thread_written_class,
  }
}

fn record_session_before(
  state : HandoverImportState,
  key : String,
  before : Option[Map[String, base_codec::Json]],
) -> Unit {
  for i in 0..<state.session_befores.length() {
    let (ek, _) = state.session_befores[i]
    if ek == key {
      return
    }
  }
  state.session_befores.push((key, before))
}

fn record_before_row(
  state : HandoverImportState,
  table : String,
  pk_col : String,
  pk_val : String,
  was : Map[String, base_codec::Json],
) -> Unit {
  for i in 0..<state.added_rows.length() {
    let (t, kvs) = state.added_rows[i]
    if t == table && kvs.length() == 1 {
      let (kc, kv) = kvs[0]
      if kc == pk_col && base_codec::json_stringify(kv) == pk_val {
        return
      }
    }
  }
  for i in 0..<state.before_rows.length() {
    let (t, old) = state.before_rows[i]
    if t == table {
      match old.get(pk_col) {
        Some(v) => if base_codec::json_stringify(v) == pk_val { return }
        None => ()
      }
    }
  }
  state.before_rows.push((table, was))
}

fn rewrite_attachments_json(raw : String, from_data : String, to_data : String) -> String {
  if raw.length() == 0 || from_data.length() == 0 || from_data == to_data {
    return raw
  }
  match base_codec::json_parse(raw) {
    Ok(base_codec::Json::Arr(items)) => {
      let out : Array[base_codec::Json] = []
      for i in 0..<items.length() {
        match items[i] {
          base_codec::Json::Obj(fields) => {
            let new_fields : Array[(String, base_codec::Json)] = []
            for j in 0..<fields.length() {
              let (k, v) = fields[j]
              if k == "path" {
                match v {
                  base_codec::Json::Str(p) => new_fields.push((k, base_codec::json_str(moved_path(p, from_data, to_data))))
                  _ => new_fields.push((k, v))
                }
              } else {
                new_fields.push((k, v))
              }
            }
            out.push(base_codec::Json::Obj(new_fields))
          }
          other => out.push(other)
        }
      }
      base_codec::json_stringify(base_codec::Json::Arr(out))
    }
    _ => raw
  }
}

fn remap_profiles_json(raw : String, profiles : Map[String, String]) -> String {
  match base_codec::json_parse(raw) {
    Ok(base_codec::Json::Arr(items)) => {
      let out : Array[base_codec::Json] = []
      for i in 0..<items.length() {
        match items[i] {
          base_codec::Json::Str(p) => {
            match profiles.get(p) {
              Some(mapped) => out.push(base_codec::json_str(mapped))
              None => out.push(base_codec::json_str(p))
            }
          }
          other => out.push(other)
        }
      }
      base_codec::json_stringify(base_codec::Json::Arr(out))
    }
    _ => raw
  }
}

fn merge_existing_thread_classification(
  db : sql_db::Db,
  next : HandoverImportState,
  local_id : Int64,
  r : Map[String, base_codec::Json],
) -> Result[Unit, sql_db::SqlError] {
  let have = match table_columns(db, "threads") { Ok(c) => c, Err(e) => return Err(e) }
  if !arr_contains_str(have, "project") || !arr_contains_str(have, "project_locked") || !arr_contains_str(have, "tags") {
    return Ok(())
  }
  let cur = match db.first("SELECT * FROM threads WHERE id = ?1", [sql_db::int64_to_json(local_id)]) {
    Ok(Some(row)) => row
    Ok(None) => return Ok(())
    Err(e) => return Err(e)
  }
  let cur_locked = row_i64(cur, "project_locked", 0.to_int64()) == 1.to_int64()
  let in_locked = row_i64(r, "project_locked", 0.to_int64()) == 1.to_int64()
  let cur_proj = row_str_opt(cur, "project")
  let in_proj = row_str_opt(r, "project")
  let cur_tags = match row_str_opt(cur, "tags") { Some(s) => if s.length() > 0 { Some(s) } else { None }, None => None }
  let in_tags = match row_str_opt(r, "tags") { Some(s) => if s.length() > 0 { Some(s) } else { None }, None => None }
  let next_proj = if cur_locked { cur_proj } else if in_locked { in_proj } else { match cur_proj { Some(_) => cur_proj, None => in_proj } }
  let next_locked = cur_locked || in_locked
  let next_tags = if cur_locked { cur_tags } else if in_locked { in_tags } else { match cur_tags { Some(_) => cur_tags, None => in_tags } }
  let next_locked_i64 = if next_locked { 1.to_int64() } else { 0.to_int64() }
  if !opt_str_eq(next_proj, cur_proj) || next_locked != cur_locked || !opt_str_eq(next_tags, cur_tags) {
    record_before_row(next, "threads", "id", local_id.to_string(), cur)
    match db.run(
      "UPDATE threads SET project = ?1, project_locked = ?2, tags = ?3 WHERE id = ?4",
      [opt_str_to_json(next_proj), sql_db::int64_to_json(next_locked_i64), opt_str_to_json(next_tags), sql_db::int64_to_json(local_id)],
    ) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  next.thread_written_class.push((local_id, next_proj, next_locked_i64, next_tags))
  Ok(())
}

fn find_mapped_thread_idx(state : HandoverImportState, remote_id : Int64) -> Int {
  for i in 0..<state.threads.length() {
    if state.threads[i].remote_id == remote_id {
      return i
    }
  }
  -1
}

fn map_entry_n(tm : HandoverThreadMap, remote_n : Int64) -> Int64 {
  match get_pair_i64(tm.ns, remote_n) {
    Some(local_n) => local_n
    None => remote_n
  }
}

fn copy_known_columns(
  cols : Array[String],
  r : Map[String, base_codec::Json],
  skip_col : String = "",
) -> Map[String, base_codec::Json] {
  let copy : Map[String, base_codec::Json] = Map::new()
  for ci in 0..<cols.length() {
    let col = cols[ci]
    if col == skip_col {
      continue
    }
    match r.get(col) {
      Some(v) => copy.set(col, v)
      None => ()
    }
  }
  copy
}

fn import_thread_row(
  db : sql_db::Db,
  next : HandoverImportState,
  r : Map[String, base_codec::Json],
) -> Result[Int, sql_db::SqlError] {
  let remote_id = row_i64(r, "id", 0.to_int64())
  if find_mapped_thread_idx(next, remote_id) >= 0 {
    return Ok(0)
  }
  let surf = surface_here(row_str(r, "surface", STILLFAIL_SURFACE), next.connects)
  let ch = row_str(r, "channel", "")
  let mut ts = row_str(r, "thread_ts", "")
  let home_opt = row_str_opt(r, "home")
  let existing = match db.first(
    "SELECT id, home FROM threads WHERE surface = ?1 AND channel = ?2 AND thread_ts = ?3",
    [base_codec::json_str(surf), base_codec::json_str(ch), base_codec::json_str(ts)],
  ) {
    Ok(res) => res
    Err(e) => return Err(e)
  }
  let mut use_existing : Option[Int64] = None
  match existing {
    Some(ex) => {
      let ex_home = row_str_opt(ex, "home")
      if surf == STILLFAIL_SURFACE && !opt_str_eq(ex_home, home_opt) {
        let mut next_ts = bump_ts(ts)
        while true {
          match db.first(
            "SELECT 1 FROM threads WHERE surface = ?1 AND channel = ?2 AND thread_ts = ?3",
            [base_codec::json_str(surf), base_codec::json_str(ch), base_codec::json_str(next_ts)],
          ) {
            Ok(Some(_)) => next_ts = bump_ts(next_ts)
            Ok(None) => break
            Err(e) => return Err(e)
          }
        }
        ts = next_ts
      } else {
        use_existing = Some(row_i64(ex, "id", 0.to_int64()))
      }
    }
    None => ()
  }
  match use_existing {
    Some(local_id) => {
      match merge_existing_thread_classification(db, next, local_id, r) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      next.threads.push(
        HandoverThreadMap::{
          remote_id: remote_id,
          local_id: local_id,
          fresh: false,
          linear: true,
          letters_linear: true,
          ns: [],
          ls: [],
        },
      )
    }
    None => {
      let cols = match table_columns(db, "threads") { Ok(c) => c, Err(e) => return Err(e) }
      let copy = copy_known_columns(cols, r, skip_col="id")
      copy.set("surface", base_codec::json_str(surf))
      copy.set("thread_ts", base_codec::json_str(ts))
      match insert_row_tolerant(db, "threads", copy) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let inserted = match db.first(
        "SELECT id FROM threads WHERE surface = ?1 AND channel = ?2 AND thread_ts = ?3",
        [base_codec::json_str(surf), base_codec::json_str(ch), base_codec::json_str(ts)],
      ) {
        Ok(Some(row)) => row_i64(row, "id", 0.to_int64())
        Ok(None) => return Err(sql_db::sql_error(1, "inserted thread not found"))
        Err(e) => return Err(e)
      }
      next.threads.push(
        HandoverThreadMap::{
          remote_id: remote_id,
          local_id: inserted,
          fresh: true,
          linear: true,
          letters_linear: true,
          ns: [],
          ls: [],
        },
      )
    }
  }
  Ok(1)
}

fn import_session_row(
  db : sql_db::Db,
  next : HandoverImportState,
  r : Map[String, base_codec::Json],
) -> Result[Int, sql_db::SqlError] {
  let key = row_str(r, "key", "")
  if key.length() == 0 {
    return Ok(0)
  }
  let cols = match table_columns(db, "sessions") { Ok(c) => c, Err(e) => return Err(e) }
  let copy = copy_known_columns(cols, r)
  copy.set("connect", base_codec::json_str(connect_here(row_str(r, "connect", STILLFAIL_CONNECT), next.connects)))
  copy.set("workspace", base_codec::json_str(moved_path(row_str(r, "workspace", ""), next.from_data, next.to_data)))
  match row_str_opt(r, "cwd") {
    Some(c) => copy.set("cwd", base_codec::json_str(moved_path(c, next.from_data, next.to_data)))
    None => ()
  }
  copy.set("running", base_codec::json_int(0))
  copy.set("ws", base_codec::json_str(next.ws))
  let began = match row_str_opt(r, "began_on") {
    Some(b) => if b.length() > 0 { b } else { next.from_station }
    None => next.from_station
  }
  if opt_str_eq(next.here_station, Some(began)) {
    copy.set("began_on", base_codec::json_null())
    copy.set("came_from", base_codec::json_null())
  } else {
    copy.set("began_on", base_codec::json_str(began))
    copy.set("came_from", base_codec::json_str(next.from_station))
  }
  match row_str_opt(r, "profile") {
    Some(p) => match next.profiles.get(p) { Some(mp) => copy.set("profile", base_codec::json_str(mp)), None => () }
    None => ()
  }
  match row_str_opt(r, "profiles") {
    Some(ps) => copy.set("profiles", base_codec::json_str(remap_profiles_json(ps, next.profiles)))
    None => ()
  }
  let before = match db.first("SELECT * FROM sessions WHERE key = ?1", [base_codec::json_str(key)]) {
    Ok(res) => res
    Err(e) => return Err(e)
  }
  record_session_before(next, key, before)
  match before {
    None => {
      match insert_row_tolerant(db, "sessions", copy) {
        Ok(_) => {
          push_unique_str(next.added_sessions, key)
          Ok(1)
        }
        Err(e) => Err(e)
      }
    }
    Some(_) => {
      match update_row_tolerant(db, "sessions", "key", base_codec::json_str(key), copy) {
        Ok(_) => Ok(1)
        Err(e) => Err(e)
      }
    }
  }
}

fn import_entry_or_letter_row(
  db : sql_db::Db,
  next : HandoverImportState,
  table : String,
  r : Map[String, base_codec::Json],
) -> Result[Int, sql_db::SqlError] {
  let remote_tid = row_i64(r, "thread", 0.to_int64())
  let tidx = find_mapped_thread_idx(next, remote_tid)
  if tidx < 0 {
    return Ok(0)
  }
  let tm = next.threads[tidx]
  let was = row_i64(r, "n", 0.to_int64())
  let is_entries = table == "entries"
  let last = match db.first(
    "SELECT COALESCE(MAX(n), 0) AS n FROM " + table + " WHERE thread = ?1",
    [sql_db::int64_to_json(tm.local_id)],
  ) {
    Ok(Some(row)) => row_i64(row, "n", 0.to_int64())
    Ok(None) => 0.to_int64()
    Err(e) => return Err(e)
  }
  let same = match db.first(
    "SELECT ts, author FROM " + table + " WHERE thread = ?1 AND n = ?2",
    [sql_db::int64_to_json(tm.local_id), sql_db::int64_to_json(was)],
  ) {
    Ok(res) => res
    Err(e) => return Err(e)
  }
  let cur_linear = if is_entries { tm.linear } else { tm.letters_linear }
  let r_ts = row_str_opt(r, "ts")
  let r_author = row_str(r, "author", "")
  let mut same_matches = false
  let mut has_same = false
  match same {
    Some(srow) => {
      has_same = true
      if opt_str_eq(row_str_opt(srow, "ts"), r_ts) && row_str(srow, "author", "") == r_author {
        same_matches = true
      }
    }
    None => ()
  }
  if cur_linear && same_matches {
    return Ok(0)
  }
  let onward = cur_linear && !has_same && was == last + 1.to_int64()
  if onward && is_entries && !tm.fresh {
    match r_ts {
      Some(ts_s) => {
        match db.first(
          "SELECT n FROM entries WHERE thread = ?1 AND ts = ?2",
          [sql_db::int64_to_json(tm.local_id), base_codec::json_str(ts_s)],
        ) {
          Ok(Some(er)) => {
            set_pair_i64(tm.ns, was, row_i64(er, "n", 0.to_int64()))
            next.threads[tidx] = HandoverThreadMap::{
              remote_id: tm.remote_id,
              local_id: tm.local_id,
              fresh: tm.fresh,
              linear: false,
              letters_linear: tm.letters_linear,
              ns: tm.ns,
              ls: tm.ls,
            }
            return Ok(0)
          }
          Ok(None) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
  }
  let mut to_n = was
  if !onward {
    let next_linear = if is_entries { false } else { tm.linear }
    let next_letters_linear = if is_entries { tm.letters_linear } else { false }
    let target_mapped = if is_entries {
      match row_i64_opt(r, "target") {
        Some(rt) => Some(map_entry_n(tm, rt))
        None => None
      }
    } else {
      None
    }
    let dup_n = match r_ts {
      Some(ts_s) => {
        match db.first(
          "SELECT n FROM " + table + " WHERE thread = ?1 AND ts = ?2 LIMIT 1",
          [sql_db::int64_to_json(tm.local_id), base_codec::json_str(ts_s)],
        ) {
          Ok(Some(er)) => Some(row_i64(er, "n", 0.to_int64()))
          Ok(None) => None
          Err(e) => return Err(e)
        }
      }
      None => {
        if is_entries {
          match target_mapped {
            Some(tgt) => {
              match db.first(
                "SELECT n FROM entries WHERE thread = ?1 AND target = ?2 AND ts IS NULL AND kind IS ?3 AND author = ?4 AND at IS ?5 AND text IS ?6 LIMIT 1",
                [
                  sql_db::int64_to_json(tm.local_id),
                  sql_db::int64_to_json(tgt),
                  sql_db::row_val(r, "kind"),
                  base_codec::json_str(r_author),
                  sql_db::row_val(r, "at"),
                  sql_db::row_val(r, "text"),
                ],
              ) {
                Ok(Some(er)) => Some(row_i64(er, "n", 0.to_int64()))
                Ok(None) => None
                Err(e) => return Err(e)
              }
            }
            None => None
          }
        } else {
          None
        }
      }
    }
    match dup_n {
      Some(existing_n) => {
        if is_entries {
          set_pair_i64(tm.ns, was, existing_n)
        } else {
          set_pair_i64(tm.ls, was, existing_n)
        }
        next.threads[tidx] = HandoverThreadMap::{
          remote_id: tm.remote_id,
          local_id: tm.local_id,
          fresh: tm.fresh,
          linear: next_linear,
          letters_linear: next_letters_linear,
          ns: tm.ns,
          ls: tm.ls,
        }
        return Ok(0)
      }
      None => {
        to_n = last + 1.to_int64()
        if is_entries {
          set_pair_i64(tm.ns, was, to_n)
        } else {
          set_pair_i64(tm.ls, was, to_n)
        }
        next.threads[tidx] = HandoverThreadMap::{
          remote_id: tm.remote_id,
          local_id: tm.local_id,
          fresh: tm.fresh,
          linear: next_linear,
          letters_linear: next_letters_linear,
          ns: tm.ns,
          ls: tm.ls,
        }
      }
    }
  }
  let cols = match table_columns(db, table) { Ok(c) => c, Err(e) => return Err(e) }
  let copy = copy_known_columns(cols, r)
  copy.set("thread", sql_db::int64_to_json(tm.local_id))
  copy.set("n", sql_db::int64_to_json(to_n))
  if is_entries {
    match row_i64_opt(r, "target") {
      Some(rt) => copy.set("target", sql_db::int64_to_json(map_entry_n(tm, rt)))
      None => ()
    }
  }
  match row_str_opt(r, "attachments") {
    Some(att) => if att.length() > 0 { copy.set("attachments", base_codec::json_str(rewrite_attachments_json(att, next.from_data, next.to_data))) }
    None => ()
  }
  match insert_row_tolerant(db, table, copy, or_ignore=false) {
    Ok(_) => {
      if is_entries {
        next.added_entries.push((tm.local_id, to_n))
      } else {
        next.added_letters.push((tm.local_id, to_n))
      }
      Ok(1)
    }
    Err(e) => Err(e)
  }
}

fn import_usage_file_row(
  db : sql_db::Db,
  next : HandoverImportState,
  r : Map[String, base_codec::Json],
) -> Result[Int, sql_db::SqlError] {
  let raw_path = row_str(r, "path", "")
  let in_offset = match row_i64_opt(r, "offset") {
    Some(v) => v
    None => return Ok(0)
  }
  if raw_path.length() == 0 {
    return Ok(0)
  }
  let mapped_path = moved_path(raw_path, next.from_data, next.to_data)
  let path_j = base_codec::json_str(mapped_path)
  let was = match db.first("SELECT * FROM usage_files WHERE path = ?1", [path_j]) {
    Ok(res) => res
    Err(e) => return Err(e)
  }
  match was {
    Some(old) => {
      if row_i64(old, "offset", 0.to_int64()) >= in_offset {
        return Ok(0)
      }
      let cols = match table_columns(db, "usage_files") { Ok(c) => c, Err(e) => return Err(e) }
      let copy = copy_known_columns(cols, r)
      copy.set("path", path_j)
      match update_row_tolerant(db, "usage_files", "path", path_j, copy) {
        Ok(_) => {
          record_before_row(next, "usage_files", "path", base_codec::json_stringify(path_j), old)
          Ok(1)
        }
        Err(e) => Err(e)
      }
    }
    None => {
      let cols = match table_columns(db, "usage_files") { Ok(c) => c, Err(e) => return Err(e) }
      let copy = copy_known_columns(cols, r)
      copy.set("path", path_j)
      match insert_row_tolerant(db, "usage_files", copy, or_ignore=false) {
        Ok(_) => {
          next.added_rows.push(("usage_files", [("path", path_j)]))
          Ok(1)
        }
        Err(e) => Err(e)
      }
    }
  }
}

fn import_other_row(
  db : sql_db::Db,
  next : HandoverImportState,
  table : String,
  r : Map[String, base_codec::Json],
) -> Result[Int, sql_db::SqlError] {
  if table == "thread_sessions" {
    let remote_tid = row_i64(r, "thread", 0.to_int64())
    let tidx = find_mapped_thread_idx(next, remote_tid)
    if tidx < 0 { return Ok(0) }
    let mapped = next.threads[tidx]
    let session = row_str(r, "session", "")
    let copy : Map[String, base_codec::Json] = Map::new()
    copy.set("thread", sql_db::int64_to_json(mapped.local_id))
    copy.set("session", base_codec::json_str(session))
    copy.set("connect", base_codec::json_str(connect_here(row_str(r, "connect", STILLFAIL_CONNECT), next.connects)))
    copy.set("joined_at", sql_db::row_val(r, "joined_at"))
    match r.get("left_at") { Some(v) => copy.set("left_at", v), None => () }
    let chg = match insert_row_tolerant(db, "thread_sessions", copy, or_ignore=true) { Ok(c) => c, Err(e) => return Err(e) }
    if chg > 0 { next.added_members.push((mapped.local_id, session)); return Ok(1) }
    return Ok(0)
  }
  if table == "turns" {
    let cols = match table_columns(db, "turns") { Ok(c) => c, Err(e) => return Err(e) }
    let copy = copy_known_columns(cols, r)
    match row_i64_opt(r, "about_thread") {
      Some(rt) => {
        let tidx = find_mapped_thread_idx(next, rt)
        if tidx < 0 {
          copy.set("about_thread", base_codec::json_null())
          copy.set("about_n", base_codec::json_null())
        } else {
          let tm = next.threads[tidx]
          copy.set("about_thread", sql_db::int64_to_json(tm.local_id))
          match row_i64_opt(r, "about_n") {
            Some(rn) => copy.set("about_n", sql_db::int64_to_json(map_entry_n(tm, rn)))
            None => copy.set("about_n", base_codec::json_null())
          }
        }
      }
      None => ()
    }
    let chg = match insert_row_tolerant(db, "turns", copy, or_ignore=true) { Ok(c) => c, Err(e) => return Err(e) }
    if chg > 0 {
      next.added_rows.push(("turns", [("id", sql_db::row_val(copy, "id"))]))
      return Ok(1)
    }
    return Ok(0)
  }
  if table == "closed_cards" || table == "entry_proposals" || table == "proposal_outcomes" || table == "deferred_files" || table == "dismissed" || table == "deliveries" {
    let tidx = find_mapped_thread_idx(next, row_i64(r, "thread", 0.to_int64()))
    if tidx < 0 { return Ok(0) }
    let tm = next.threads[tidx]
    let cols = match table_columns(db, table) { Ok(c) => c, Err(e) => return Err(e) }
    let copy = copy_known_columns(cols, r)
    let tid_j = sql_db::int64_to_json(tm.local_id)
    copy.set("thread", tid_j)
    let n_j = match row_i64_opt(r, "n") {
      Some(rn) => { let v = sql_db::int64_to_json(map_entry_n(tm, rn)); copy.set("n", v); v }
      None => sql_db::row_val(copy, "n")
    }
    if table == "deliveries" {
      copy.set("delivered_at", base_codec::json_null())
    }
    let chg = match insert_row_tolerant(db, table, copy, or_ignore=true) { Ok(c) => c, Err(e) => return Err(e) }
    if chg > 0 {
      if table == "dismissed" {
        next.added_rows.push((table, [("viewer", sql_db::row_val(copy, "viewer")), ("thread", tid_j), ("n", n_j)]))
      } else if table == "deliveries" {
        next.added_rows.push((table, [("thread", tid_j), ("n", n_j), ("session", sql_db::row_val(copy, "session"))]))
      } else if table == "deferred_files" {
        next.added_rows.push((table, [("thread", tid_j), ("n", n_j), ("file_id", sql_db::row_val(copy, "file_id"))]))
      } else {
        next.added_rows.push((table, [("thread", tid_j), ("n", n_j)]))
      }
      return Ok(1)
    }
    return Ok(0)
  }
  if table == "reads" || table == "hidden_chats" || table == "muted_chats" || table == "kept_chats" {
    let tidx = find_mapped_thread_idx(next, row_i64(r, "thread", 0.to_int64()))
    if tidx < 0 { return Ok(0) }
    let tm = next.threads[tidx]
    let cols = match table_columns(db, table) { Ok(c) => c, Err(e) => return Err(e) }
    let copy = copy_known_columns(cols, r)
    let tid_j = sql_db::int64_to_json(tm.local_id)
    copy.set("thread", tid_j)
    if table == "reads" {
      match row_i64_opt(r, "n") { Some(rn) => copy.set("n", sql_db::int64_to_json(map_entry_n(tm, rn))), None => () }
    }
    let chg = match insert_row_tolerant(db, table, copy, or_ignore=true) { Ok(c) => c, Err(e) => return Err(e) }
    if chg > 0 {
      next.added_rows.push((table, [("viewer", sql_db::row_val(copy, "viewer")), ("thread", tid_j)]))
      return Ok(1)
    }
    return Ok(0)
  }
  if table == "usage_files" {
    return import_usage_file_row(db, next, r)
  }
  if table == "session_usage" {
    let sess = row_str(r, "session", "")
    let usg = row_str(r, "usage", "")
    if sess.length() == 0 { return Ok(0) }
    let sess_j = base_codec::json_str(sess)
    let was = match db.first("SELECT * FROM session_usage WHERE session = ?1", [sess_j]) { Ok(res) => res, Err(e) => return Err(e) }
    match db.run(
      "INSERT INTO session_usage (session, usage) VALUES (?1, ?2) ON CONFLICT (session) DO UPDATE SET usage = excluded.usage",
      [sess_j, base_codec::json_str(usg)],
    ) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match was {
      None => next.added_rows.push(("session_usage", [("session", sess_j)]))
      Some(old) => record_before_row(next, "session_usage", "session", base_codec::json_stringify(sess_j), old)
    }
    return Ok(1)
  }
  if table == "runtime_sessions" || table == "pins" || table == "opened_chats" || table == "usage" {
    let cols = match table_columns(db, table) { Ok(c) => c, Err(e) => return Err(e) }
    let copy = copy_known_columns(cols, r)
    if table == "usage" {
      match row_i64_opt(r, "thread") {
        Some(rt) => {
          let tidx = find_mapped_thread_idx(next, rt)
          if tidx >= 0 { copy.set("thread", sql_db::int64_to_json(next.threads[tidx].local_id)) } else { copy.set("thread", base_codec::json_null()) }
        }
        None => ()
      }
      match row_str_opt(r, "profile") {
        Some(p) => match next.profiles.get(p) { Some(mp) => copy.set("profile", base_codec::json_str(mp)), None => () }
        None => ()
      }
    }
    let chg = match insert_row_tolerant(db, table, copy, or_ignore=true) { Ok(c) => c, Err(e) => return Err(e) }
    if chg > 0 {
      if table == "runtime_sessions" {
        next.added_rows.push((table, [("session_key", sql_db::row_val(copy, "session_key")), ("id", sql_db::row_val(copy, "id"))]))
      } else if table == "pins" {
        next.added_rows.push((table, [("viewer", sql_db::row_val(copy, "viewer")), ("session", sql_db::row_val(copy, "session"))]))
      } else if table == "opened_chats" {
        next.added_rows.push((table, [("child_station", sql_db::row_val(copy, "child_station")), ("child", sql_db::row_val(copy, "child"))]))
      } else {
        next.added_rows.push((table, [("id", sql_db::row_val(copy, "id"))]))
      }
      return Ok(1)
    }
    return Ok(0)
  }
  Err(sql_db::sql_error(1, "unsupported handover table: " + table))
}

/// Import a page of handover rows inside an ALREADY-OPEN transaction.
/// Asserts `!db.autocommit()` and NEVER mutates `state` in place; returns `(imported, next_state)`
/// so a rolled-back transaction cannot pollute caller state.
pub fn import_rows_in_tx(
  db : sql_db::Db,
  state : HandoverImportState,
  table : String,
  rows : Array[Map[String, base_codec::Json]],
) -> Result[(Int, HandoverImportState), sql_db::SqlError] {
  if db.autocommit() {
    return Err(sql_db::sql_error(1, "import_rows_in_tx requires an active transaction"))
  }
  let next = state.clone()
  let mut imported = 0
  for i in 0..<rows.length() {
    let r = rows[i]
    let added = if table == "threads" {
      match import_thread_row(db, next, r) { Ok(n) => n, Err(e) => return Err(e) }
    } else if table == "sessions" {
      match import_session_row(db, next, r) { Ok(n) => n, Err(e) => return Err(e) }
    } else if table == "entries" || table == "letters" {
      match import_entry_or_letter_row(db, next, table, r) { Ok(n) => n, Err(e) => return Err(e) }
    } else {
      match import_other_row(db, next, table, r) { Ok(n) => n, Err(e) => return Err(e) }
    }
    imported = imported + added
  }
  Ok((imported, next))
}

/// Transactional wrapper around `import_rows_in_tx`: runs inside a write transaction and returns
/// `(imported, next_state)` ONLY if the transaction commits, preventing state pollution on rollback.
pub fn import_rows_tx(
  db : sql_db::Db,
  state : HandoverImportState,
  table : String,
  rows : Array[Map[String, base_codec::Json]],
) -> Result[(Int, HandoverImportState), sql_db::SqlError] {
  with_write_tx(db, "st_import_rows", fn(t : sql_db::Db) -> Result[(Int, HandoverImportState), sql_db::SqlError] {
    import_rows_in_tx(t, state, table, rows)
  })
}

fn delete_row_by_pk(
  db : sql_db::Db,
  table : String,
  kvs : Array[(String, base_codec::Json)],
) -> Result[Unit, sql_db::SqlError] {
  if kvs.length() == 0 {
    return Ok(())
  }
  let where_sb = StringBuilder::new()
  let args : Array[base_codec::Json] = []
  for i in 0..<kvs.length() {
    let (col, v) = kvs[i]
    if i > 0 { where_sb.write_string(" AND ") }
    where_sb.write_string(col)
    where_sb.write_string(" = ?")
    args.push(v)
  }
  match db.run("DELETE FROM " + table + " WHERE " + where_sb.to_string(), args) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

fn replace_row_tolerant(
  db : sql_db::Db,
  table : String,
  row : Map[String, base_codec::Json],
) -> Result[Unit, sql_db::SqlError] {
  let have = match table_columns(db, table) { Ok(c) => c, Err(e) => return Err(e) }
  let cols : Array[String] = []
  let args : Array[base_codec::Json] = []
  for i in 0..<have.length() {
    let col = have[i]
    match row.get(col) {
      Some(v) => { cols.push(col); args.push(v) }
      None => ()
    }
  }
  if cols.length() == 0 {
    return Ok(())
  }
  let col_sb = StringBuilder::new()
  let q_sb = StringBuilder::new()
  for i in 0..<cols.length() {
    if i > 0 { col_sb.write_string(", "); q_sb.write_string(", ") }
    col_sb.write_string(cols[i])
    q_sb.write_string("?")
  }
  match db.run("INSERT OR REPLACE INTO " + table + " (" + col_sb.to_string() + ") VALUES (" + q_sb.to_string() + ")", args) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

fn restore_thread_if_untouched(
  db : sql_db::Db,
  state : HandoverImportState,
  old_row : Map[String, base_codec::Json],
) -> Result[Unit, sql_db::SqlError] {
  let tid = row_i64(old_row, "id", 0.to_int64())
  let mut written : Option[(Option[String], Int64, Option[String])] = None
  for i in 0..<state.thread_written_class.length() {
    let (id, p, l, t) = state.thread_written_class[i]
    if id == tid {
      written = Some((p, l, t))
    }
  }
  let mut untouched = true
  match written {
    Some((last_proj, last_locked, last_tags)) => {
      match db.first("SELECT project, project_locked, tags FROM threads WHERE id = ?1", [sql_db::int64_to_json(tid)]) {
        Ok(Some(cur)) => {
          let cur_proj = row_str_opt(cur, "project")
          let cur_locked = if row_i64(cur, "project_locked", 0.to_int64()) == 1.to_int64() { 1.to_int64() } else { 0.to_int64() }
          let cur_tags = match row_str_opt(cur, "tags") { Some(s) => if s.length() > 0 { Some(s) } else { None }, None => None }
          untouched = opt_str_eq(cur_proj, last_proj) && cur_locked == last_locked && opt_str_eq(cur_tags, last_tags)
        }
        Ok(None) => untouched = false
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  if !untouched {
    return Ok(())
  }
  match db.run(
    "UPDATE threads SET project = ?1, project_locked = ?2, tags = ?3 WHERE id = ?4",
    [
      opt_str_to_json(row_str_opt(old_row, "project")),
      sql_db::int64_to_json(row_i64(old_row, "project_locked", 0.to_int64())),
      opt_str_to_json(row_str_opt(old_row, "tags")),
      sql_db::int64_to_json(tid),
    ],
  ) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

/// Cleanly roll back all rows inserted or overwritten across pages during an aborted handover inside an open tx.
pub fn drop_import_in_tx(
  db : sql_db::Db,
  state : HandoverImportState,
) -> Result[Unit, sql_db::SqlError] {
  if db.autocommit() {
    return Err(sql_db::sql_error(1, "drop_import_in_tx requires an active transaction"))
  }
  for i in 0..<state.added_entries.length() {
    let (tid, n_val) = state.added_entries[i]
    match db.run("DELETE FROM entries WHERE thread = ?1 AND n = ?2", [sql_db::int64_to_json(tid), sql_db::int64_to_json(n_val)]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  for i in 0..<state.added_letters.length() {
    let (tid, n_val) = state.added_letters[i]
    match db.run("DELETE FROM letters WHERE thread = ?1 AND n = ?2", [sql_db::int64_to_json(tid), sql_db::int64_to_json(n_val)]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  for i in 0..<state.added_rows.length() {
    let (tbl, kvs) = state.added_rows[i]
    match delete_row_by_pk(db, tbl, kvs) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  for i in 0..<state.added_members.length() {
    let (tid, sess) = state.added_members[i]
    match db.run("DELETE FROM thread_sessions WHERE thread = ?1 AND session = ?2", [sql_db::int64_to_json(tid), base_codec::json_str(sess)]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  for i in 0..<state.before_rows.length() {
    let (tbl, old_row) = state.before_rows[i]
    if tbl == "threads" {
      match restore_thread_if_untouched(db, state, old_row) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      match replace_row_tolerant(db, tbl, old_row) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
  }
  if state.session_befores.length() > 0 {
    for i in 0..<state.session_befores.length() {
      let (sess, before_opt) = state.session_befores[i]
      match before_opt {
        Some(old_sess) => {
          match update_row_tolerant(db, "sessions", "key", base_codec::json_str(sess), old_sess) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => {
          match delete_session_in_tx(db, sess) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
      }
    }
  } else {
    for i in 0..<state.added_sessions.length() {
      let sess = state.added_sessions[i]
      match delete_session_in_tx(db, sess) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
  }
  for i in 0..<state.threads.length() {
    let tm = state.threads[i]
    if !tm.fresh {
      continue
    }
    let has_mem = match db.first("SELECT 1 FROM thread_sessions WHERE thread = ?1 LIMIT 1", [sql_db::int64_to_json(tm.local_id)]) {
      Ok(Some(_)) => true
      Ok(None) => false
      Err(e) => return Err(e)
    }
    if !has_mem {
      match db.run("DELETE FROM threads WHERE id = ?1", [sql_db::int64_to_json(tm.local_id)]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
  }
  Ok(())
}
