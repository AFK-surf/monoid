// 1:1 SQLite Schema & forward-tolerant idempotent migrations matching
// `station/src/store/schema.ts` and `station/src/store/mesh-schema.ts`.
//
// Covered schema scope:
// - All core station tables, indexes, triggers, and views (`sessions`, `threads`, `thread_sessions`,
//   `entries`, `letters`, `merged`, `deliveries`, `letter_deliveries`, `turns`, `runtime_sessions`,
//   `bindings`, `jobs`, `job_notices`, `remote_runs`, `active_watch_jobs`, `active_other_jobs`,
//   `thread_state`, `pending_cards`, `pending_system_cards`, `session_turns` incl. `session_turns_move`,
//   `session_work`, `usage`, `usage_totals`, `usage_compactions`, `usage_files`, `session_usage`,
//   `handover_in`, `handed_over`, `card_outbox*`, `mesh_*`, etc.).
// - Background/derived builder tables & indexes (`usage_15m`, `usage_counter`, `profile_hours`,
//   `search_scope`, `recent_chat`, `vault_uses`, `process_job_meta`, etc.) are installed lazily
//   by their dedicated builder workers or the Node station on demand (not during `init_schema`).
//
// Invariants:
// - All write transactions go through `sql_db::Db::tx` / `Db::savepoint_err` (zero raw tx SQL).
// - Forward-tolerant: databases with `user_version > SCHEMA_VERSION` open read/write without
//   downgrading `user_version`, dropping views, or running destructive migrations.
// - Safe version guard: non-empty v12 databases are rejected (requiring Node station to restore
//   `archive/threads/<id>.jsonl.zst` files during v12->v13 upgrade first), and non-empty v0 or
//   < v13 databases are rejected without modifying `user_version`.

import "base_codec"
import "sql_db"

pub let SCHEMA_VERSION : Int = 13
pub let MIN_SUPPORTED_VERSION : Int = 13
pub let CACHE_KIB : Int = 32768
pub let WAL_PAGES : Int = 10000
pub let WAL_KEEP_BYTES : Int = 67108864

pub fn mesh_schema_ddl() -> String {
  "CREATE TABLE IF NOT EXISTS mesh_relay_tokens (" +
  "  hash TEXT PRIMARY KEY, scope TEXT NOT NULL, name TEXT NOT NULL," +
  "  made_by TEXT NOT NULL, expires INTEGER NOT NULL" +
  ");" +
  "CREATE INDEX IF NOT EXISTS mesh_relay_tokens_scope ON mesh_relay_tokens(scope, expires);" +
  "CREATE TABLE IF NOT EXISTS mesh_relay_registrations (" +
  "  scope TEXT NOT NULL, node TEXT NOT NULL, issuer TEXT NOT NULL," +
  "  generation INTEGER NOT NULL, name TEXT NOT NULL, made_by TEXT NOT NULL," +
  "  revoked INTEGER NOT NULL DEFAULT 0," +
  "  PRIMARY KEY(scope, node)" +
  ");" +
  "CREATE TABLE IF NOT EXISTS mesh_announcements (" +
  "  scope TEXT NOT NULL, node TEXT NOT NULL, revision INTEGER NOT NULL, body TEXT NOT NULL, signature TEXT NOT NULL," +
  "  PRIMARY KEY(scope, node)" +
  ");" +
  "CREATE TABLE IF NOT EXISTS mesh_relay_records (" +
  "  scope TEXT NOT NULL, node TEXT NOT NULL, issuer TEXT NOT NULL, generation INTEGER NOT NULL," +
  "  body TEXT NOT NULL, signature TEXT NOT NULL, PRIMARY KEY(scope, node)" +
  ");"
}

pub fn system_card_sql(col : String) -> String {
  "(CASE WHEN " +
  col +
  " IS NULL OR NOT json_valid(" +
  col +
  ") THEN 0 ELSE COALESCE(json_extract(" +
  col +
  ", '$.type') = 'login' OR json_type(" +
  col +
  ", '$.vault') = 'object' OR json_type(" +
  col +
  ", '$.adb') = 'object' OR json_type(" +
  col +
  ", '$.rig') = 'object' OR json_type(" +
  col +
  ", '$.signin') = 'object', 0) END)"
}

