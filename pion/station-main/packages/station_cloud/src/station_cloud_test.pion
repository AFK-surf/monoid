// Comprehensive unit tests for `station_cloud`:
// - Ed25519 key generation, persistence (0600), reload, signing & verification
// - Provider specs (`stillfail`, `comma`), signed headers, telemetry/connect/enroll signatures
// - CloudState parsing/serialization, legacy migration, former-host migration, path helpers
// - Lock chain pinning, fork choice, broken lock refusal, disable -> .off, joined locks
// - `join_workspace` (full, rig, locked-station gate, home promotion, KeptLock refusal)
// - `LockBodies` & `personal_vault_lock`
// - `CloudTransport` (`race: true`, regional entry eligibility, `ShellMux` fetch/ws args & response parsers)
// - `PresenceClient` (connect headers, ping/pong, `Replaced` conflict detector, backoff, `state`/`revoke`/`lock` frames, `CLOSE_REMOVED`)
// - `NotifyBatcher`, `BilledCooldown`, `ProfileLoginCooldown`

import "base_codec"
import "builders_core"
import "crypto"
import "form"
import "host_shim"
import "lock"
import "station_rules_bridge"

fn assert_true(cond : Bool) -> Unit {
  if !cond {
    panic("assertion failed")
  }
}

fn assert_opt_str(v : Option[String], expected : Option[String]) -> Unit {
  match (v, expected) {
    (None, None) => ()
    (Some(a), Some(b)) => assert_true(a == b)
    _ => panic("assert_opt_str failed")
  }
}

fn assert_opt_bool(v : Option[Bool], expected : Option[Bool]) -> Unit {
  match (v, expected) {
    (None, None) => ()
    (Some(a), Some(b)) => assert_true(a == b)
    _ => panic("assert_opt_bool failed")
  }
}

let test_owner_seed : String = "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"
let test_owner_pub : String = "79b5562e8fe654f94078b112e8a98ba7901f853ae695bed7e0e3910bad049664"
let test_station_seed : String = "2122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40"
let test_station_pub : String = "e7f162a10bec559afea195e4dce84b69568d5d2cb0963eb446c0685e2b17f2f0"
let test_station2_pub : String = "adc14011f82d1c56d956aa4f9d73d8858361a606048525e0d08c638dc75dd8c7"
let test_station3_pub : String = "882d0ea3b2864e7a587f3e698cea4459998312e655e05fa5e8b5119d8baac8cd"

fn must_hex(h : String) -> Bytes {
  match crypto::hex_to_bytes(h) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

fn make_signed_entry(seed_hex : String, pub_hex : String, unsigned_fields : Array[(String, form::Json)]) -> form::Json {
  let key_id = "ed25519:" + pub_hex
  let with_empty_sig : Array[(String, form::Json)] = []
  let mut i = 0
  while i < unsigned_fields.length() {
    with_empty_sig.push(unsigned_fields[i])
    i = i + 1
  }
  with_empty_sig.push(("sig", form::Json::Obj([
    ("key", form::Json::Str(key_id)),
    ("alg", form::Json::Str("Ed25519")),
    ("sig", form::Json::Str("")),
  ])))
  let h = match station_rules_bridge::entry_hash(form::Json::Obj(with_empty_sig)) {
    Ok(v) => v
    Err(_) => ""
  }
  let msg = match station_rules_bridge::signed_bytes(h) {
    Some(b) => b
    None => Bytes::new(0)
  }
  let sig_hex = match crypto::ed25519_sign(must_hex(seed_hex), msg) {
    Ok(s) => crypto::bytes_to_hex(s)
    Err(_) => ""
  }
  let out : Array[(String, form::Json)] = []
  i = 0
  while i < unsigned_fields.length() {
    out.push(unsigned_fields[i])
    i = i + 1
  }
  out.push(("sig", form::Json::Obj([
    ("key", form::Json::Str(key_id)),
    ("alg", form::Json::Str("Ed25519")),
    ("sig", form::Json::Str(sig_hex)),
  ])))
  form::Json::Obj(out)
}

fn make_genesis_entry(ws : String) -> form::Json {
  let owner_id = "ed25519:" + test_owner_pub
  make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str(ws)),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("owner", form::Json::Str("u1")),
      ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
      ("rp_id", form::Json::Str("app.still.fail")),
      ("cloud_keys", form::Json::Obj([("keys", form::Json::Arr([]))])),
      ("members", form::Json::Arr([
        form::Json::Obj([
          ("sub", form::Json::Str("u1")),
          ("email", form::Json::Str("alice@example.com")),
          ("role", form::Json::Str("owner")),
        ]),
      ])),
      ("devices", form::Json::Arr([
        form::Json::Obj([
          ("id", form::Json::Str(test_owner_pub)),
          ("sub", form::Json::Str("u1")),
          ("kind", form::Json::Str("app")),
          ("label", form::Json::Str("Mac")),
          ("sign_key", form::Json::Str(owner_id)),
        ]),
      ])),
      ("stations", form::Json::Arr([
        form::Json::Obj([
          ("key", form::Json::Str(test_station_pub)),
          ("name", form::Json::Str("st1")),
        ]),
      ])),
      ("gateways", form::Json::Arr([])),
    ])),
  ])
}

fn make_station_entry(ws : String, seq : Double, prev : String, at : Double, st_pub : String, name : String) -> form::Json {
  make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str(ws)),
    ("seq", form::Json::Num(seq)),
    ("prev", form::Json::Str(prev)),
    ("at", form::Json::Num(at)),
    ("kind", form::Json::Str("station")),
    ("body", form::Json::Obj([
      ("key", form::Json::Str(st_pub)),
      ("name", form::Json::Str(name)),
    ])),
  ])
}

fn make_disable_entry(ws : String, seq : Double, prev : String, at : Double) -> form::Json {
  make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str(ws)),
    ("seq", form::Json::Num(seq)),
    ("prev", form::Json::Str(prev)),
    ("at", form::Json::Num(at)),
    ("kind", form::Json::Str("disable")),
    ("body", form::Json::Obj([])),
  ])
}

fn sample_cloud_state(ws : String) -> CloudState {
  CloudState::{
    provider: None,
    origin: "https://app.still.fail",
    station: test_station_pub,
    workspace: ws,
    workspace_name: "Alpha",
    workspace_emoji: Some("🚀"),
    workspace_icon: None,
    name: "st1",
    relay_url: "https://relay.still.fail",
    relay_urls: ["https://relay.still.fail"],
    stillfail_relays: None,
    mesh_relays: None,
    grant_keys: base_codec::json_obj([("keys", base_codec::json_arr([]))]),
    peers: [],
    revocations: [],
    gateway_keys: None,
    removed_at: None,
    removed_code: None,
    joined: [],
    rigs: [],
    ways: None,
    rig: None,
    rig_pending: Map::new(),
    rig_due: [],
    full_pending: Map::new(),
  }
}

test "station key generate, persist, reload and sign" {
  let mem : Map[String, Bytes] = Map::new()
  let mut wrote_count = 0
  let fs = KeyFs::{
    read_bytes: fn(p : String) -> Result[Option[Bytes], String] { Ok(mem.get(p)) },
    write_private: fn(p : String, b : Bytes) -> Result[Unit, String] {
      wrote_count = wrote_count + 1
      mem.set(p, b)
      Ok(())
    },
    random_bytes: fn(n : Int) -> Result[Bytes, String] {
      assert_true(n == 32)
      Ok(must_hex(test_station_seed))
    },
  }
  let k1 = match load_key("/data", fs) {
    Ok(k) => k
    Err(e) => {
      assert_true(false)
      StationKey::{ seed: Bytes::new(0), id: e }
    }
  }
  assert_true(k1.id == test_station_pub)
  assert_true(wrote_count == 1)
  assert_true(mem.contains("/data/mesh/secret.key"))

  // Second call loads existing key without regenerating
  let k2 = match load_key("/data", fs) {
    Ok(k) => k
    Err(_) => {
      assert_true(false)
      StationKey::{ seed: Bytes::new(0), id: "" }
    }
  }
  assert_true(k2.id == test_station_pub)
  assert_true(wrote_count == 1)

  // Signature verifies via station_rules_bridge
  let sig = match k1.sign("hello-cloud") {
    Ok(s) => s
    Err(_) => {
      assert_true(false)
      ""
    }
  }
  let sig_bytes = must_hex(sig)
  assert_true(station_rules_bridge::signature_ok("ed25519:" + k1.id, sig_bytes, "hello-cloud".to_bytes()))
}

test "provider specs and signed headers (stillfail vs comma)" {
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => {
      assert_true(false)
      StationKey::{ seed: Bytes::new(0), id: "" }
    }
  }
  let sf = spec_of(Provider::Stillfail)
  let cm = spec_of(Provider::Comma)
  assert_true(sf.connect_path == "/v1/stations/connect")
  assert_true(cm.connect_path == "/v1/comma/stations/connect")
  assert_true(release_base_for(sf, "https://app.still.fail") == "https://app.still.fail")
  assert_true(release_base_for(cm, "https://comma.example") == "https://comma.example/stations")

  // Comma uses x-stillfail-* header names while signing under comma-station-connect-v1
  let cm_hdrs = match connect_ws_headers(cm, "https://comma.example", key.id, "0.1.0", 1700000000.to_int64(), key) {
    Ok(h) => h
    Err(_) => {
      assert_true(false)
      []
    }
  }
  assert_true(cm_hdrs.length() == 4)
  assert_true(cm_hdrs[0].0 == "x-stillfail-station")
  assert_true(cm_hdrs[1].0 == "x-stillfail-ts")
  assert_true(cm_hdrs[2].0 == "x-stillfail-signature")
  assert_true(cm_hdrs[3].0 == "x-stillfail-version")
  let expected_msg = "comma-station-connect-v1:https://comma.example:" + key.id + ":1700000000"
  assert_true(station_rules_bridge::signature_ok("ed25519:" + key.id, must_hex(cm_hdrs[2].1), expected_msg.to_bytes()))

  // signed_post_headers matches signed.ts contract
  let body = "{\"notices\":[]}"
  let post_hdrs = match signed_post_headers("https://app.still.fail", key.id, sf.notify_tag, body, 1700000005.to_int64(), key) {
    Ok(h) => h
    Err(_) => {
      assert_true(false)
      []
    }
  }
  assert_true(post_hdrs[0].0 == "content-type")
  assert_true(post_hdrs[3].0 == "x-stillfail-signature")
  let expected_post_msg = sf.notify_tag + ":https://app.still.fail:" + key.id + ":1700000005:" + sha256_hex(body)
  assert_true(station_rules_bridge::signature_ok("ed25519:" + key.id, must_hex(post_hdrs[3].1), expected_post_msg.to_bytes()))
}

test "cloud state read/write, path helpers, former host migration, rig self" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  assert_true(lock_path("/d") == "/d/mesh/lock.json")
  assert_true(pending_lock_path("/d") == "/d/mesh/lock-pending.json")
  assert_true(joined_lock_path("/d", "ws_123") == "/d/mesh/locks/ws_123.json")
  assert_true(joined_pending_path("/d", "ws_123") == "/d/mesh/locks/ws_123.pending.json")
  assert_true(bodies_path("/d", "ws_123") == "/d/mesh/locks/ws_123.bodies.json")

  let st = sample_cloud_state("ws_home")
  st.rig = Some(RigSelf::{
    owner: "u1",
    owner_email: "alice@example.com",
    owner_name: "Alice",
    person: test_owner_pub,
  })
  match write_state("/d", st, fs) {
    Ok(_) => ()
    Err(_) => assert_true(false)
  }
  let loaded = match read_state("/d", fs) {
    Ok(Some(s)) => s
    _ => {
      assert_true(false)
      st
    }
  }
  assert_true(loaded.workspace == "ws_home")
  assert_true(loaded.station == test_station_pub)
  match loaded.rig {
    Some(r) => {
      assert_true(r.owner == "u1")
      assert_true(r.person == test_owner_pub)
    }
    None => assert_true(false)
  }

  // Former host migration
  let old_json = "{\"origin\":\"https://ember.3720.org\",\"relay_url\":\"https://ember.3720.org/relay\",\"relay_urls\":[\"https://ember.3720.org/r1\"]}"
  match move_former_host_text(old_json) {
    Some(migrated) => {
      assert_true(!migrated.contains("ember.3720.org"))
      assert_true(migrated.contains("https://app.still.fail/relay"))
      assert_true(migrated.contains("https://app.still.fail/r1"))
    }
    None => assert_true(false)
  }
}

test "lock pinning, fork choice, broken lock refusal and disable" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_test_1"), fs)
  let store = CloudStore::open("/d", fs)

  let gen = make_genesis_entry("ws_test_1")
  let gen_h = hash_of_entry(gen)
  let e1 = make_station_entry("ws_test_1", 1.0, gen_h, 1700000010.0, test_station2_pub, "st2")
  let e1_fork = make_station_entry("ws_test_1", 1.0, gen_h, 1700000020.0, test_station3_pub, "st3")

  // Pin genesis + e1
  match store.take_lock([gen, e1], Some(1700000050.0)) {
    Ok(n) => assert_true(n == 2)
    Err(_) => assert_true(false)
  }
  match store.locked(1700000050.0) {
    Some(eff) => {
      match eff.state {
        Some(ls) => {
          assert_true(ls.seq.to_int() == 1)
          assert_true(ls.stations.contains(test_station2_pub))
        }
        None => assert_true(false)
      }
    }
    None => assert_true(false)
  }

  // Non-fork call rejects entry not on head
  match store.take_lock([e1_fork], Some(1700000050.0), fork=false) {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg == FORK_MSG)
  }

  // Fork call takes competing entry and switches to fork winner (e1_fork wins by hash tie-break)
  match store.keep_lock([e1_fork], Some(1700000050.0), fork=true) {
    Ok(t) => {
      assert_true(t.taken == 1)
      match store.chain() {
        Some(kl) => {
          assert_true(kl.aside.length() == 1)
          match kl.state {
            Some(ls) => assert_true(ls.head == hash_of_entry(e1_fork))
            None => assert_true(false)
          }
        }
        None => assert_true(false)
      }
    }
    Err(_) => assert_true(false)
  }

  // Disable turns off lock and writes .off record; re-pinning same genesis is refused
  let dis = make_disable_entry("ws_test_1", 2.0, hash_of_entry(e1_fork), 1700000030.0)
  match store.take_lock([dis], Some(1700000050.0)) {
    Ok(n) => assert_true(n == 1)
    Err(_) => assert_true(false)
  }
  match store.locked(1700000050.0) {
    None => ()
    Some(_) => assert_true(false)
  }
  match store.take_lock([gen], Some(1700000050.0)) {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("turned off"))
  }

  // Corrupted lock.json is detected as broken lock (`state: None`, admits nobody)
  let _ = (fs.write_private_text)(lock_path("/d"), "{broken-json")
  match read_lock("/d", fs) {
    Some(kl) => {
      match kl.state {
        None => ()
        Some(_) => assert_true(false)
      }
    }
    None => assert_true(false)
  }
}

test "join_workspace full, rig, locked gate, and home promotion" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => {
      assert_true(false)
      StationKey::{ seed: Bytes::new(0), id: "" }
    }
  }
  let _ = write_state("/d", sample_cloud_state("ws_home"), fs)

  // Join a second workspace as a rig
  let res = join_workspace(
    "/d",
    fs,
    key,
    "tok_abc",
    "0.1.0",
    1700000100.to_int64(),
    fn(url : String, body : String) -> Result[(Int, String), String] {
      assert_true(url == "https://app.still.fail/v1/stations/join")
      assert_true(body.contains("\"rig\":true"))
      assert_true(body.contains("\"locks\":true"))
      Ok((200, "{\"workspace\":\"ws_rig_2\",\"workspace_name\":\"Beta\",\"name\":\"rig-1\",\"rig\":{\"owner\":\"u2\",\"owner_email\":\"bob@example.com\",\"owner_name\":\"Bob\"}}"))
    },
    lock_hash=Some(test_owner_pub),
    rig_person_hash=Some(test_owner_pub),
    expected_workspace=Some("ws_rig_2"),
  )
  match res {
    Ok(r) => {
      assert_true(r.workspace == "ws_rig_2")
      assert_true(r.became_home == false)
      assert_opt_str(r.owner, Some("bob@example.com"))
    }
    Err(_) => assert_true(false)
  }
  // Pending lock file written for ws_rig_2 and cloud.json updated with joined rig
  assert_opt_str(read_pending_lock("/d", fs, ws=Some("ws_rig_2")), Some(test_owner_pub))
  let st_after = match read_state("/d", fs) {
    Ok(Some(s)) => s
    _ => {
      assert_true(false)
      sample_cloud_state("ws_home")
    }
  }
  assert_true(st_after.joined.length() == 1)
  assert_true(st_after.joined[0].workspace == "ws_rig_2")
  match st_after.joined[0].rig {
    Some(rg) => assert_true(rg.person == test_owner_pub)
    None => assert_true(false)
  }

  // Locked home workspace rejects join without lock_hash
  let store = CloudStore::open("/d", fs)
  let _ = store.take_lock([make_genesis_entry("ws_home")], Some(1700000105.0))
  let rejected = join_workspace(
    "/d",
    fs,
    key,
    "tok_nolock",
    "0.1.0",
    1700000110.to_int64(),
    fn(_u : String, _b : String) -> Result[(Int, String), String] { Ok((200, "{}")) },
  )
  match rejected {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("locked"))
  }

  // Home promotion when cloud returns `"home": "ws_new_home"`
  let promo = join_workspace(
    "/d",
    fs,
    key,
    "tok_home",
    "0.1.0",
    1700000120.to_int64(),
    fn(_u : String, _b : String) -> Result[(Int, String), String] {
      Ok((200, "{\"workspace\":\"ws_new_home\",\"workspace_name\":\"Gamma\",\"name\":\"st-gamma\",\"home\":\"ws_new_home\"}"))
    },
    lock_hash=Some(test_station2_pub),
  )
  match promo {
    Ok(r) => {
      assert_true(r.became_home == true)
      assert_true(r.workspace == "ws_new_home")
    }
    Err(_) => assert_true(false)
  }
  let st_promo = match read_state("/d", fs) {
    Ok(Some(s)) => s
    _ => {
      assert_true(false)
      sample_cloud_state("")
    }
  }
  assert_true(st_promo.workspace == "ws_new_home")
  assert_opt_str(read_pending_lock("/d", fs, ws=None), Some(test_station2_pub))
  // Old home lock was demoted to joined_lock_path(ws_home)
  assert_true((fs.exists)(joined_lock_path("/d", "ws_home")))
}

test "transport regional entry eligibility and race: true over ShellMux" {
  let cfg = match base_codec::json_parse("{\"cloudEntry\":{\"origin\":\"https://app.still.fail\",\"host\":\"edge.example\",\"port\":24443}}") {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(_) => base_codec::json_null()
  }
  let entry = match parse_cloud_entry(cfg) {
    Ok(Some(e)) => e
    _ => {
      assert_true(false)
      CloudEntry::{ origin: "", host: "", port: 0 }
    }
  }
  let transport = CloudTransport::new(entry=Some(entry), race=true)
  assert_true(transport.eligible("https://app.still.fail/v1/stations/notify", Provider::Stillfail))
  assert_true(transport.eligible("wss://app.still.fail/v1/stations/connect", Provider::Stillfail))
  assert_true(!transport.eligible("https://app.still.fail/v1/stations/notify", Provider::Comma))
  assert_true(!transport.eligible("https://other.example/foo", Provider::Stillfail))

  let recorded_ops : Array[(String, String)] = []
  let mux = builders_core::ShellMux::new(
    builders_core::MuxTransport::{
      call_async: fn(_id : Int64, op : String, args : String, _payload : Option[Bytes]) -> Unit {
        recorded_ops.push((op, args))
      },
      call_sync: fn(_op : String, _args : String) -> String { "{}" },
      write_stdout_line: fn(_s : String) -> Bool { true },
      write_stdout_frame: fn(_h : Array[(String, base_codec::Json)], _b : Bytes) -> Bool { true },
      now_ms: fn() -> Int64 { 0.to_int64() },
      wall_ms: fn() -> Int64 { 0.to_int64() },
      wait: fn(_ms : Int64) -> Option[host_shim::HostEvent] { None },
    },
    start_stdin=false,
  )
  let _ = transport.start_fetch(
    mux,
    builders_core::MuxToken::Tagged(1, 0, 0.to_int64()),
    "https://app.still.fail/v1/stations/notify",
    "POST",
    [("content-type", "application/json")],
    Some("{}".to_bytes()),
  )
  let _ = transport.start_ws_open(
    mux,
    builders_core::MuxToken::Tagged(2, 0, 0.to_int64()),
    "wss://app.still.fail/v1/stations/connect",
    [("x-stillfail-station", test_station_pub)],
  )
  assert_true(recorded_ops.length() == 2)
  assert_true(recorded_ops[0].0 == "fetch")
  assert_true(recorded_ops[0].1.contains("\"race\":true"))
  assert_true(recorded_ops[0].1.contains("\"edge.example\""))
  assert_true(recorded_ops[1].0 == "ws.open")
  assert_true(recorded_ops[1].1.contains("\"race\":true"))
}

test "presence state machine: heartbeat, Replaced conflict, backoff, state/revoke/lock frames" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => {
      assert_true(false)
      StationKey::{ seed: Bytes::new(0), id: "" }
    }
  }
  let _ = write_state("/d", sample_cloud_state("ws_test_1"), fs)
  let store = CloudStore::open("/d", fs)
  let pc = PresenceClient::new(store, key)

  // Connect headers
  match pc.prepare_connect("0.1.0", 1700000000.to_int64(), 1000.to_int64()) {
    Ok((url, hdrs, _)) => {
      assert_true(url == "wss://app.still.fail/v1/stations/connect")
      assert_true(hdrs.length() == 4)
    }
    Err(_) => assert_true(false)
  }

  // Open -> ping -> pong -> steady
  pc.on_open(42, 1700000001.to_int64())
  assert_true(pc.last_presence_json.contains("\"online\":true"))
  match pc.on_ping_tick(1700000001.to_int64()) {
    Ok(frames) => {
      assert_true(frames.length() == 1)
      assert_true(frames[0] == "ping")
    }
    Err(_) => assert_true(false)
  }
  // Second ping before pong -> timeout error
  match pc.on_ping_tick(1700000001.to_int64()) {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("stopped answering"))
  }
  // Pong clears unanswered and marks held
  let _ = pc.on_text_frame("pong", 1700000002.to_int64())
  assert_true(pc.answered)
  assert_true(pc.held)

  // CloudSaid release & models
  let r_rel = pc.on_text_frame("{\"type\":\"release\"}", 1700000003.to_int64())
  match r_rel.cloud_said {
    Some(CloudSaid::Release) => ()
    _ => assert_true(false)
  }
  let r_mod = pc.on_text_frame("{\"type\":\"models\",\"etag\":\"v42\"}", 1700000004.to_int64())
  match r_mod.cloud_said {
    Some(CloudSaid::Models(Some(tag))) => assert_true(tag == "v42")
    _ => assert_true(false)
  }

  // Revoke frame persists into state
  let _ = pc.on_text_frame("{\"type\":\"revoke\",\"kind\":\"member\",\"id\":\"u9\",\"at\":1700000010}", 1700000010.to_int64())
  match store.state {
    Some(st) => {
      assert_true(st.revocations.length() == 1)
      assert_true(st.revocations[0].id == "u9")
    }
    None => assert_true(false)
  }

  // Replaced conflict after 3 consecutive 4000 closes without heartbeat
  let rep = ReplacedTracker::new()
  let _ = rep.ended(Some(CLOSE_REPLACED), false)
  let _ = rep.ended(Some(CLOSE_REPLACED), false)
  assert_true(!rep.conflict)
  assert_opt_bool(rep.ended(Some(CLOSE_REPLACED), false), Some(true))
  assert_true(rep.conflict)
  assert_opt_bool(rep.steady(), Some(false))
  assert_true(!rep.conflict)

  // Exponential backoff & conflict jump
  let bo = BackoffState::new()
  bo.on_connect_start(1000.to_int64())
  assert_true(bo.on_disconnect(2000.to_int64(), false) == 1000.to_int64())
  assert_true(bo.on_disconnect(3000.to_int64(), false) == 2000.to_int64())
  assert_true(bo.on_disconnect(4000.to_int64(), true) == 60000.to_int64())

  // CLOSE_REMOVED transitions to Removed and persists removed_at/removed_code
  match pc.on_close(Some(CLOSE_REMOVED), "removed", 1700000050.to_int64(), 50000.to_int64()) {
    PresencePhase::Removed => ()
    _ => assert_true(false)
  }
  assert_true(store.removed())
}

test "notify batcher and cooldown gates" {
  let bc = BilledCooldown::new()
  assert_true(bc.take("ws1", "claude", 1000.to_int64()))
  assert_true(!bc.take("ws1", "claude", 2000.to_int64()))
  assert_true(bc.take("ws1", "claude", 1000.to_int64() + BILLED_NOTIFY_COOLDOWN_MS))

  let pc = ProfileLoginCooldown::new()
  assert_true(pc.take(Some("ws1"), "prof1", 1000.to_int64()))
  assert_true(!pc.take(Some("ws1"), "prof1", 2000.to_int64()))
  pc.clear("prof1")
  assert_true(pc.take(Some("ws1"), "prof1", 2000.to_int64()))

  let batcher = NotifyBatcher::new()
  batcher.enqueue(
    [
      Notice::{ to: ["u1"], audience: None, kind: "done", session: "s1", thread: 1.to_int64(), seq: Some(2.to_int64()), title: "T", by: "A", text: "ok", at: 100.to_int64(), ws: None },
      Notice::{ to: ["u2"], audience: None, kind: "done", session: "s2", thread: 2.to_int64(), seq: None, title: "T2", by: "B", text: "hi", at: 101.to_int64(), ws: Some("ws_j") },
      Notice::{ to: ["u3"], audience: None, kind: "done", session: "s3", thread: 3.to_int64(), seq: None, title: "T3", by: "C", text: "drop", at: 102.to_int64(), ws: Some("ws_gone") },
    ],
    5000.to_int64(),
  )
  assert_true(!batcher.is_due(5500.to_int64()))
  assert_true(batcher.is_due(6000.to_int64()))
  let posts = batcher.flush(Some("ws_home"), fn(w : String) -> Bool { w == "ws_home" || w == "ws_j" }, 6000.to_int64())
  assert_true(posts.length() == 2)
  assert_opt_str(posts[0].workspace, None)
  assert_true(posts[0].count == 1)
  assert_opt_str(posts[1].workspace, Some("ws_j"))
  assert_true(posts[1].count == 1)
  assert_true(posts[1].body.contains("\"workspace\":\"ws_j\""))
}

// ── R2 Regression Tests (P0 / P1 / P2) ──

test "R2 #1: fail-closed read_lock and load_key on I/O error" {
  // read_lock returns Some({ state: None }) on Err (never None/unlocked!)
  let err_fs = CloudFs::{
    read_text: fn(_p : String) -> Result[Option[String], String] { Err("EACCES: permission denied") },
    write_private_text: fn(_p : String, _t : String) -> Result[Unit, String] { Ok(()) },
    remove_file: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    rename_file: fn(_a : String, _b : String) -> Result[Unit, String] { Ok(()) },
    mkdir_p: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    exists: fn(_p : String) -> Bool { true },
  }
  match read_lock("/d", err_fs) {
    Some(kl) => {
      match kl.state {
        None => ()
        Some(_) => assert_true(false)
      }
    }
    None => assert_true(false)
  }

  // load_key returns Err on read error and never overwrites secret.key
  let mut wrote = false
  let err_key_fs = KeyFs::{
    read_bytes: fn(_p : String) -> Result[Option[Bytes], String] { Err("EIO: disk error") },
    write_private: fn(_p : String, _b : Bytes) -> Result[Unit, String] {
      wrote = true
      Ok(())
    },
    random_bytes: fn(_n : Int) -> Result[Bytes, String] { Ok(must_hex(test_station_seed)) },
  }
  match load_key("/d", err_key_fs) {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("EIO"))
  }
  assert_true(!wrote)
}

test "R2 #2: moved workspace effective state (waiting / on / off), roster_of, and join_workspace" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_mv"), fs)
  let store = CloudStore::open("/d", fs)

  // Build personal genesis log for root person u1
  let owner_id = "ed25519:" + test_owner_pub
  let pgen = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("sub", form::Json::Str("u1")),
      ("device", form::Json::Obj([
        ("key", form::Json::Str(owner_id)),
        ("id", form::Json::Str(test_owner_pub)),
        ("label", form::Json::Str("Mac")),
        ("sign_key", form::Json::Str(owner_id)),
      ])),
    ])),
  ])
  let root_hash = hash_of_entry(pgen)

  // Pin workspace genesis + moved {root}
  let gen = make_genesis_entry("ws_mv")
  let gen_h = hash_of_entry(gen)
  let mv_entry = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws_mv")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(gen_h)),
    ("at", form::Json::Num(1700000010.0)),
    ("kind", form::Json::Str("moved")),
    ("body", form::Json::Obj([("root", form::Json::Str(root_hash))])),
  ])
  match store.take_lock([gen, mv_entry], Some(1700000020.0)) {
    Ok(n) => assert_true(n == 2)
    Err(_) => assert_true(false)
  }

  // Without person_chains, moved workspace is waiting: locked().waiting == true, roster_of() falls back to chain
  match store.locked(1700000020.0, ws=None) {
    Some(eff) => assert_true(eff.waiting)
    None => assert_true(false)
  }
  match store.roster_of(1700000020.0, ws=None) {
    Some(r) => {
      assert_true(!r.waiting)
      match r.state {
        Some(ls) => assert_true(ls.stations.contains(test_station_pub))
        None => assert_true(false)
      }
    }
    None => assert_true(false)
  }

  // Provide person log with `ws` commit to an `off` statement body -> effective state becomes None (off!)
  let off_body = form::Json::Obj([
    ("ws", form::Json::Str("ws_mv")),
    ("prev", form::Json::Null),
    ("kind", form::Json::Str("off")),
    ("salt", form::Json::Str("0123456789abcdef0123456789abcdef")),
  ])
  let off_h = match station_rules_bridge::body_hash(off_body) {
    Some(h) => h
    None => ""
  }
  let tag = station_rules_bridge::ws_tag("ws_mv", root_hash)
  let p_ws = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(root_hash)),
    ("at", form::Json::Num(1700000015.0)),
    ("kind", form::Json::Str("ws")),
    ("body", form::Json::Obj([
      ("t", form::Json::Str(tag)),
      ("h", form::Json::Str(off_h)),
    ])),
  ])
  store.set_person_chains([(root_hash, [pgen, p_ws])])
  let commits_fn = fn(h : String) -> Array[lock::Commit] {
    if h == off_h {
      [lock::Commit::{ genesis: root_hash, chain: [pgen, p_ws] }]
    } else {
      []
    }
  }
  match store.bodies(ws=None).take("ws_mv", [off_body], commits_fn, fs=Some(fs)) {
    Ok(res) => assert_true(res.taken == 1)
    Err(_) => assert_true(false)
  }
  // Effective state is now None ("off")!
  match store.locked(1700000020.0, ws=None) {
    None => ()
    Some(_) => assert_true(false)
  }
  // join_workspace with store=Some(store) allows joining WITHOUT lock_hash because moved workspace is off
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => StationKey::{ seed: Bytes::new(0), id: "" }
  }
  let jres = join_workspace(
    "/d",
    fs,
    key,
    "tok_unlocked_ok",
    "0.1.0",
    1700000020.to_int64(),
    fn(_u : String, _b : String) -> Result[(Int, String), String] {
      Ok((200, "{\"workspace\":\"ws_other\",\"workspace_name\":\"Other\",\"name\":\"st-other\"}"))
    },
    store=Some(store),
  )
  match jres {
    Ok(r) => assert_true(r.workspace == "ws_other")
    Err(_) => assert_true(false)
  }
}

test "R2 #3: presence rig two-signal gate + replay and tool lock/provider gate" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let st = sample_cloud_state("ws_home")
  let _ = write_state("/d", st, fs)
  let store = CloudStore::open("/d", fs)

  // Plane lists joined workspace `ws_rig_x` as rig-mode BEFORE local RigSelf is written -> must be skipped!
  let frame_str = "{\"type\":\"state\",\"workspace\":\"ws_home\",\"peers\":[],\"workspaces\":[{\"workspace\":\"ws_rig_x\",\"workspace_name\":\"RigX\",\"name\":\"r1\",\"peers\":[],\"revocations\":[],\"rig\":{\"owner\":\"u2\"}}]}"
  let _ = apply_text_frame(store, frame_str, 1700000010.to_int64())
  assert_true(store.skipped_rig_ws.length() == 1)
  assert_true(store.skipped_rig_ws[0] == "ws_rig_x")
  match store.state {
    Some(s) => assert_true(s.joined.length() == 0)
    None => assert_true(false)
  }

  // Once local RigSelf is recorded in cloud.json, replay_skipped_rig_frame admits it as a rig
  match store.state {
    Some(s) => {
      s.joined.push(Joined::{
        workspace: "ws_rig_x",
        workspace_name: "RigX",
        workspace_emoji: None,
        workspace_icon: None,
        name: "r1",
        peers: [],
        revocations: [],
        locked: false,
        rigs: None,
        ways: None,
        rig: Some(RigSelf::{ owner: "u2", owner_email: "b@e", owner_name: "B", person: test_owner_pub }),
      })
    }
    None => assert_true(false)
  }
  match replay_skipped_rig_frame(store, 1700000012.to_int64()) {
    Some(_) => ()
    None => assert_true(false)
  }
  assert_true(store.skipped_rig_ws.length() == 0)
  match store.rig_in("ws_rig_x") {
    Some(r) => assert_true(r.owner == "u2")
    None => assert_true(false)
  }

  // Tool gate: Stillfail provider refuses tool frames with `unavailable`
  let tool_frame = "{\"type\":\"tool\",\"id\":\"t1\",\"request\":{\"op\":\"ping\"}}"
  let r_sf = apply_text_frame(store, tool_frame, 1700000015.to_int64())
  match r_sf.tool_call {
    None => ()
    Some(_) => assert_true(false)
  }
  assert_true(r_sf.outbound.length() == 1)
  assert_true(base_codec::json_stringify(r_sf.outbound[0]).contains("\"unavailable\""))

  // Comma provider allows tool frames while unlocked, then refuses once home lock is pinned
  match store.state {
    Some(s) => s.provider = Some(Provider::Comma)
    None => assert_true(false)
  }
  let r_cm_open = apply_text_frame(store, tool_frame, 1700000016.to_int64())
  match r_cm_open.tool_call {
    Some((tid, _)) => assert_true(tid == "t1")
    None => assert_true(false)
  }
  let _ = store.take_lock([make_genesis_entry("ws_home")], Some(1700000017.0))
  let r_cm_locked = apply_text_frame(store, tool_frame, 1700000018.to_int64())
  match r_cm_locked.tool_call {
    None => ()
    Some(_) => assert_true(false)
  }
  assert_true(r_cm_locked.outbound.length() == 1)
  assert_true(base_codec::json_stringify(r_cm_locked.outbound[0]).contains("\"unavailable\""))
}

test "R2 #4 & #7: fork now_fn rejects invalid fork entry, and on_again re-enables disabled lock" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_fk"), fs)
  let store = CloudStore::open("/d", fs)

  // Genesis with owner u1 (test_owner_pub) and admin u2 (test_station_pub) so a 2-signer branch outweighs a 1-signer disable
  let owner_id = "ed25519:" + test_owner_pub
  let admin_id = "ed25519:" + test_station_pub
  let gen = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws_fk")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("owner", form::Json::Str("u1")),
      ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
      ("rp_id", form::Json::Str("app.still.fail")),
      ("cloud_keys", form::Json::Obj([("keys", form::Json::Arr([]))])),
      ("members", form::Json::Arr([
        form::Json::Obj([
          ("sub", form::Json::Str("u1")),
          ("email", form::Json::Str("alice@example.com")),
          ("role", form::Json::Str("owner")),
        ]),
        form::Json::Obj([
          ("sub", form::Json::Str("u2")),
          ("email", form::Json::Str("bob@example.com")),
          ("role", form::Json::Str("admin")),
        ]),
      ])),
      ("devices", form::Json::Arr([
        form::Json::Obj([
          ("id", form::Json::Str(test_owner_pub)),
          ("sub", form::Json::Str("u1")),
          ("kind", form::Json::Str("app")),
          ("label", form::Json::Str("Mac")),
          ("sign_key", form::Json::Str(owner_id)),
        ]),
        form::Json::Obj([
          ("id", form::Json::Str(test_station_pub)),
          ("sub", form::Json::Str("u2")),
          ("kind", form::Json::Str("app")),
          ("label", form::Json::Str("BobMac")),
          ("sign_key", form::Json::Str(admin_id)),
        ]),
      ])),
      ("stations", form::Json::Arr([
        form::Json::Obj([
          ("key", form::Json::Str(test_station_pub)),
          ("name", form::Json::Str("st1")),
        ]),
      ])),
      ("gateways", form::Json::Arr([])),
    ])),
  ])
  let gen_h = hash_of_entry(gen)
  let st_on_head = make_station_entry("ws_fk", 1.0, gen_h, 1700000020.0, test_station2_pub, "st2")
  match store.take_lock([gen, st_on_head], Some(1700000025.0)) {
    Ok(n) => assert_true(n == 2)
    Err(_) => assert_true(false)
  }

  // Competing fork entry at seq 1 signed by an unauthorized key -> rejected by fork now_fn (`state_at` + `apply`)
  let bad_fork = make_signed_entry(test_station_seed, test_station2_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws_fk")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(gen_h)),
    ("at", form::Json::Num(1700000030.0)),
    ("kind", form::Json::Str("station")),
    ("body", form::Json::Obj([
      ("key", form::Json::Str(test_station3_pub)),
      ("name", form::Json::Str("st3")),
    ])),
  ])
  match store.keep_lock([bad_fork], Some(1700000200.0), fork=true) {
    Ok(t) => {
      assert_true(t.taken == 0)
      assert_true(t.off.length() == 1)
      assert_true(t.off[0].why == "refused")
    }
    Err(_) => assert_true(false)
  }

  // on_again: disable the lock at seq 2 (1 signer: u1), then bring a competing 2-signer branch (u1 + u2) with fork=true
  let dis = make_disable_entry("ws_fk", 2.0, hash_of_entry(st_on_head), 1700000040.0)
  match store.take_lock([dis], Some(1700000045.0)) {
    Ok(n) => assert_true(n == 1)
    Err(_) => assert_true(false)
  }
  match store.locked(1700000045.0) {
    None => ()
    Some(_) => assert_true(false)
  }
  let alt2 = make_station_entry("ws_fk", 2.0, hash_of_entry(st_on_head), 1700000041.0, test_station3_pub, "st3")
  let alt3 = make_signed_entry(test_station_seed, test_station_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws_fk")),
    ("seq", form::Json::Num(3.0)),
    ("prev", form::Json::Str(hash_of_entry(alt2))),
    ("at", form::Json::Num(1700000042.0)),
    ("kind", form::Json::Str("station")),
    ("body", form::Json::Obj([
      ("key", form::Json::Str(test_owner_pub)),
      ("name", form::Json::Str("st4")),
    ])),
  ])
  match store.keep_lock([gen, st_on_head, alt2, alt3], Some(1700000045.0), fork=true) {
    Ok(t) => {
      assert_true(t.taken > 0)
      match store.locked(1700000045.0) {
        Some(eff) => match eff.state {
          Some(ls) => assert_true(ls.seq.to_int() == 3)
          None => assert_true(false)
        }
        None => assert_true(false)
      }
    }
    Err(_) => assert_true(false)
  }
}

test "R2 #5: join_workspace propagates write_state ENOSPC error" {
  let mem = MemCloudFs::new()
  let base_fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_home"), base_fs)
  let fail_write_fs = CloudFs::{
    read_text: base_fs.read_text,
    write_private_text: fn(_p : String, _t : String) -> Result[Unit, String] { Err("ENOSPC: no space left on device") },
    remove_file: base_fs.remove_file,
    rename_file: base_fs.rename_file,
    mkdir_p: base_fs.mkdir_p,
    exists: base_fs.exists,
  }
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => StationKey::{ seed: Bytes::new(0), id: "" }
  }
  let res = join_workspace(
    "/d",
    fail_write_fs,
    key,
    "tok_enospc",
    "0.1.0",
    1700000100.to_int64(),
    fn(_u : String, _b : String) -> Result[(Int, String), String] {
      Ok((200, "{\"workspace\":\"ws_new\",\"workspace_name\":\"New\",\"name\":\"st-new\"}"))
    },
  )
  match res {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("ENOSPC"))
  }
}

test "R2 #6: presence lock frame preserves lone surrogate (\\ud800) losslessly" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_sur"), fs)
  let store = CloudStore::open("/d", fs)

  let gen = make_genesis_entry("ws_sur")
  let gen_h = hash_of_entry(gen)
  let _ = store.take_lock([gen], Some(1700000010.0))

  // Create a station entry whose name contains a lone high surrogate (\ud800)
  let sur_name = match form::parse_json("\"st-\\ud800-x\"") {
    Ok(form::Json::Str(s)) => s
    _ => ""
  }
  let sur_entry = make_station_entry("ws_sur", 1.0, gen_h, 1700000020.0, test_station2_pub, sur_name)
  let expected_h = hash_of_entry(sur_entry)
  let lock_frame = form::json_stringify(form::Json::Obj([
    ("type", form::Json::Str("lock")),
    ("entries", form::Json::Arr([sur_entry])),
  ]))
  let _ = apply_text_frame(store, lock_frame, 1700000025.to_int64())
  match store.chain() {
    Some(kl) => {
      assert_true(kl.entries.length() == 2)
      assert_true(hash_of_entry(kl.entries[1]) == expected_h)
    }
    None => assert_true(false)
  }
}

test "R2 #9, #10, #11: lock_bodies UTF-16 & persistence, notify session_ws, CLOSE_REMOVED & transport cancel" {
  // #9: CJK string with 6000 UTF-16 units (18000 UTF-8 bytes > 16384, but UTF-16 len <= 16384) is accepted & persisted
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let sb = StringBuilder::new()
  let mut ci = 0
  while ci < 6000 {
    sb.write_string("中")
    ci = ci + 1
  }
  let big_cjk = sb.to_string()
  let owner_id = "ed25519:" + test_owner_pub
  let pgen_b = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("sub", form::Json::Str("u1")),
      ("device", form::Json::Obj([
        ("key", form::Json::Str(owner_id)),
        ("id", form::Json::Str(test_owner_pub)),
        ("label", form::Json::Str("Mac")),
        ("sign_key", form::Json::Str(owner_id)),
      ])),
    ])),
  ])
  let pgen_b_h = hash_of_entry(pgen_b)
  let body = form::Json::Obj([
    ("ws", form::Json::Str("ws_b")),
    ("prev", form::Json::Null),
    ("kind", form::Json::Str("member")),
    ("sub", form::Json::Str("u2")),
    ("email", form::Json::Str(big_cjk)),
    ("lock", form::Json::Str(pgen_b_h)),
    ("role", form::Json::Str("member")),
    ("salt", form::Json::Str("0123456789abcdef0123456789abcdef")),
  ])
  let bh = match station_rules_bridge::body_hash(body) {
    Some(h) => h
    None => ""
  }
  let tag = station_rules_bridge::ws_tag("ws_b", pgen_b_h)
  let p_ws_b = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(pgen_b_h)),
    ("at", form::Json::Num(1700000005.0)),
    ("kind", form::Json::Str("ws")),
    ("body", form::Json::Obj([
      ("t", form::Json::Str(tag)),
      ("h", form::Json::Str(bh)),
    ])),
  ])
  let lb = LockBodies::new(Some("/d/mesh/locks/ws_b.bodies.json"))
  let res = lb.take(
    "ws_b",
    [body],
    fn(h : String) -> Array[lock::Commit] {
      if h == bh { [lock::Commit::{ genesis: pgen_b_h, chain: [pgen_b, p_ws_b] }] } else { [] }
    },
    fs=Some(fs),
  )
  match res {
    Ok(r) => assert_true(r.taken == 1)
    Err(_) => assert_true(false)
  }
  assert_true((fs.exists)("/d/mesh/locks/ws_b.bodies.json"))

  // #10: NotifyBatcher::flush resolves session_ws before falling back to home_ws
  let nb = NotifyBatcher::new()
  nb.enqueue(
    [Notice::{ to: ["u1"], audience: None, kind: "done", session: "sess_in_j", thread: 1.to_int64(), seq: None, title: "T", by: "A", text: "ok", at: 100.to_int64(), ws: None }],
    1000.to_int64(),
  )
  let posts = nb.flush(
    Some("ws_home"),
    fn(w : String) -> Bool { w == "ws_home" || w == "ws_joined" },
    2000.to_int64(),
    session_ws=fn(sid : String) -> Option[String] { if sid == "sess_in_j" { Some("ws_joined") } else { None } },
  )
  assert_true(posts.length() == 1)
  assert_opt_str(posts[0].workspace, Some("ws_joined"))

  // #11: CLOSE_REMOVED / 404 clears reached & peers_current; transport close_with_mux cancels in-flight calls
  let _ = write_state("/d", sample_cloud_state("ws_rm"), fs)
  let store = CloudStore::open("/d", fs)
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => StationKey::{ seed: Bytes::new(0), id: "" }
  }
  let pc = PresenceClient::new(store, key)
  store.reached = true
  store.peers_current = true
  match pc.on_http_error(404, 1700000099.to_int64(), 99000.to_int64()) {
    PresencePhase::Removed => ()
    _ => assert_true(false)
  }
  assert_true(!store.reached)
  assert_true(!store.peers_current)

  let cancelled : Array[String] = []
  let mux = builders_core::ShellMux::new(
    builders_core::MuxTransport::{
      call_async: fn(_id : Int64, _op : String, _args : String, _payload : Option[Bytes]) -> Unit { () },
      call_sync: fn(op : String, args : String) -> String {
        cancelled.push(op + ":" + args)
        "{\"value\":true}"
      },
      write_stdout_line: fn(_s : String) -> Bool { true },
      write_stdout_frame: fn(_h : Array[(String, base_codec::Json)], _b : Bytes) -> Bool { true },
      now_ms: fn() -> Int64 { 0.to_int64() },
      wall_ms: fn() -> Int64 { 0.to_int64() },
      wait: fn(_ms : Int64) -> Option[host_shim::HostEvent] { None },
    },
    start_stdin=false,
  )
  let tr = CloudTransport::new()
  let _ = tr.start_fetch(mux, builders_core::MuxToken::Tagged(1, 0, 0.to_int64()), "https://app.still.fail/x", "GET", [], None)
  assert_true(tr.in_flight.length() == 1)
  tr.close_with_mux(mux)
  assert_true(tr.closed)
  assert_true(tr.in_flight.length() == 0)
  assert_true(cancelled.length() == 1)
}

// ── R3 Regression Tests (6 P1 items) ──

test "R3 #2: CloudStore threads injected verifier through take_lock/fold" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_vf"), fs)
  let mut calls = 0
  let mut allow = true
  let vf = fn(alg : String, key : Bytes, sig : Bytes, msg : Bytes) -> Bool {
    calls = calls + 1
    if !allow {
      return false
    }
    if alg == "Ed25519" {
      crypto::ed25519_verify(key, msg, sig)
    } else {
      false
    }
  }
  let store = CloudStore::open("/d", fs, verify_fn=Some(vf))
  let gen = make_genesis_entry("ws_vf")
  match store.take_lock([gen], Some(1700000010.0)) {
    Ok(n) => assert_true(n == 1)
    Err(_) => assert_true(false)
  }
  assert_true(calls >= 1)

  // When verifier rejects, next entry is refused even with valid Ed25519 signature
  allow = false
  let e1 = make_station_entry("ws_vf", 1.0, hash_of_entry(gen), 1700000020.0, test_station2_pub, "st2")
  match store.take_lock([e1], Some(1700000025.0)) {
    Ok(_) => assert_true(false)
    Err(_) => ()
  }
}

test "R3 #3 & #4: restart recovers person-chains.json for moved-off workspace, and default join_workspace uses effective state" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_mv_r3"), fs)
  let store = CloudStore::open("/d", fs)

  let owner_id = "ed25519:" + test_owner_pub
  let pgen = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("sub", form::Json::Str("u1")),
      ("device", form::Json::Obj([
        ("key", form::Json::Str(owner_id)),
        ("id", form::Json::Str(test_owner_pub)),
        ("label", form::Json::Str("Mac")),
        ("sign_key", form::Json::Str(owner_id)),
      ])),
    ])),
  ])
  let root_hash = hash_of_entry(pgen)
  let gen = make_genesis_entry("ws_mv_r3")
  let gen_h = hash_of_entry(gen)
  let mv_entry = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws_mv_r3")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(gen_h)),
    ("at", form::Json::Num(1700000010.0)),
    ("kind", form::Json::Str("moved")),
    ("body", form::Json::Obj([("root", form::Json::Str(root_hash))])),
  ])
  match store.take_lock([gen, mv_entry], Some(1700000020.0)) {
    Ok(n) => assert_true(n == 2)
    Err(_) => assert_true(false)
  }

  let off_body = form::Json::Obj([
    ("ws", form::Json::Str("ws_mv_r3")),
    ("prev", form::Json::Null),
    ("kind", form::Json::Str("off")),
    ("salt", form::Json::Str("0123456789abcdef0123456789abcdef")),
  ])
  let off_h = match station_rules_bridge::body_hash(off_body) {
    Some(h) => h
    None => ""
  }
  let tag = station_rules_bridge::ws_tag("ws_mv_r3", root_hash)
  let p_ws = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(root_hash)),
    ("at", form::Json::Num(1700000015.0)),
    ("kind", form::Json::Str("ws")),
    ("body", form::Json::Obj([
      ("t", form::Json::Str(tag)),
      ("h", form::Json::Str(off_h)),
    ])),
  ])
  store.set_person_chains([(root_hash, [pgen, p_ws])])
  match store.save_person_chains() {
    Ok(_) => ()
    Err(_) => assert_true(false)
  }
  match store.take_bodies(None, [off_body], fn(h : String) -> Array[lock::Commit] {
    if h == off_h { [lock::Commit::{ genesis: root_hash, chain: [pgen, p_ws] }] } else { [] }
  }) {
    Ok(r) => assert_true(r.taken == 1)
    Err(_) => assert_true(false)
  }

  // Simulate process restart: fresh CloudStore::open loads person-chains.json + bodies -> STILL off (not waiting!)
  let restarted = CloudStore::open("/d", fs)
  match restarted.locked(1700000020.0, ws=None) {
    None => ()
    Some(_) => assert_true(false)
  }

  // Default join_workspace (store=None) uses effective state -> allows joining WITHOUT lock_hash!
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => StationKey::{ seed: Bytes::new(0), id: "" }
  }
  let jres = join_workspace(
    "/d",
    fs,
    key,
    "tok_default_eff",
    "0.1.0",
    1700000020.to_int64(),
    fn(_u : String, _b : String) -> Result[(Int, String), String] {
      Ok((200, "{\"workspace\":\"ws_new2\",\"workspace_name\":\"New2\",\"name\":\"st2\"}"))
    },
  )
  match jres {
    Ok(r) => assert_true(r.workspace == "ws_new2")
    Err(_) => assert_true(false)
  }
}

test "R3 #5: home promotion ENOSPC on cloud.json rolls back pending hash and old home lock" {
  let mem = MemCloudFs::new()
  let base_fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_home_old"), base_fs)
  let store = CloudStore::open("/d", base_fs)
  let _ = store.take_lock([make_genesis_entry("ws_home_old")], Some(1700000010.0))

  // Fail ONLY writes to cloud.json (simulating ENOSPC at the final write_state step)
  let enospc_cloud_fs = CloudFs::{
    read_text: base_fs.read_text,
    write_private_text: fn(p : String, t : String) -> Result[Unit, String] {
      if p == state_path("/d") {
        Err("ENOSPC: no space left for cloud.json")
      } else {
        (base_fs.write_private_text)(p, t)
      }
    },
    remove_file: base_fs.remove_file,
    rename_file: base_fs.rename_file,
    mkdir_p: base_fs.mkdir_p,
    exists: base_fs.exists,
  }
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => StationKey::{ seed: Bytes::new(0), id: "" }
  }
  let res = join_workspace(
    "/d",
    enospc_cloud_fs,
    key,
    "tok_promo_fail",
    "0.1.0",
    1700000100.to_int64(),
    fn(_u : String, _b : String) -> Result[(Int, String), String] {
      Ok((200, "{\"workspace\":\"ws_home_new\",\"workspace_name\":\"NewHome\",\"name\":\"st-new\",\"home\":\"ws_home_new\"}"))
    },
    lock_hash=Some(test_station2_pub),
  )
  match res {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("ENOSPC"))
  }

  // On restart: cloud.json is STILL ws_home_old, old home lock is STILL at lock_path, and NO split pending hash!
  let after = CloudStore::open("/d", base_fs)
  match after.state {
    Some(s) => assert_true(s.workspace == "ws_home_old")
    None => assert_true(false)
  }
  assert_true((base_fs.exists)(lock_path("/d")))
  assert_opt_str(read_pending_lock("/d", base_fs, ws=None), None)
}

test "R3 #6: LockBodies::take / take_bodies writes disk before mutating memory (retry succeeds after ENOSPC)" {
  let mem = MemCloudFs::new()
  let base_fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_bod"), base_fs)

  let mut disk_full = false
  let flaky_fs = CloudFs::{
    read_text: base_fs.read_text,
    write_private_text: fn(p : String, t : String) -> Result[Unit, String] {
      if disk_full && p.ends_with(".bodies.json") {
        Err("ENOSPC: bodies write failed")
      } else {
        (base_fs.write_private_text)(p, t)
      }
    },
    remove_file: base_fs.remove_file,
    rename_file: base_fs.rename_file,
    mkdir_p: base_fs.mkdir_p,
    exists: base_fs.exists,
  }
  let store = CloudStore::open("/d", flaky_fs)
  let _ = store.take_lock([make_genesis_entry("ws_bod")], Some(1700000010.0))

  let owner_id = "ed25519:" + test_owner_pub
  let pgen = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("sub", form::Json::Str("u1")),
      ("device", form::Json::Obj([
        ("key", form::Json::Str(owner_id)),
        ("id", form::Json::Str(test_owner_pub)),
        ("label", form::Json::Str("Mac")),
        ("sign_key", form::Json::Str(owner_id)),
      ])),
    ])),
  ])
  let root_h = hash_of_entry(pgen)
  let body = form::Json::Obj([
    ("ws", form::Json::Str("ws_bod")),
    ("prev", form::Json::Null),
    ("kind", form::Json::Str("off")),
    ("salt", form::Json::Str("0123456789abcdef0123456789abcdef")),
  ])
  let bh = match station_rules_bridge::body_hash(body) {
    Some(h) => h
    None => ""
  }
  let tag = station_rules_bridge::ws_tag("ws_bod", root_h)
  let p_ws = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(root_h)),
    ("at", form::Json::Num(1700000015.0)),
    ("kind", form::Json::Str("ws")),
    ("body", form::Json::Obj([
      ("t", form::Json::Str(tag)),
      ("h", form::Json::Str(bh)),
    ])),
  ])
  let commits_fn = fn(h : String) -> Array[lock::Commit] {
    if h == bh { [lock::Commit::{ genesis: root_h, chain: [pgen, p_ws] }] } else { [] }
  }

  // 1. Disk full -> take_bodies returns Err and does NOT pollute in-memory LockBodies
  disk_full = true
  match store.take_bodies(None, [body], commits_fn) {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("ENOSPC"))
  }
  assert_true(!store.bodies(ws=None).has(bh))
  assert_true(store.bodies(ws=None).len() == 0)
  assert_true(!(base_fs.exists)(bodies_path("/d", "ws_bod")))

  // 2. Disk recovers -> retry succeeds with taken == 1 and persists to disk
  disk_full = false
  match store.take_bodies(None, [body], commits_fn) {
    Ok(res) => assert_true(res.taken == 1)
    Err(_) => assert_true(false)
  }
  assert_true(store.bodies(ws=None).has(bh))
  assert_true((base_fs.exists)(bodies_path("/d", "ws_bod")))
}

// ── R4 Final 3-Item Regression Tests ──

test "R4 #1: person-chains.json round-trip preserves TS heard and aside fields losslessly" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let owner_id = "ed25519:" + test_owner_pub
  let pgen = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("sub", form::Json::Str("u1")),
      ("device", form::Json::Obj([
        ("key", form::Json::Str(owner_id)),
        ("id", form::Json::Str(test_owner_pub)),
        ("label", form::Json::Str("Mac")),
        ("sign_key", form::Json::Str(owner_id)),
      ])),
    ])),
  ])
  let g = hash_of_entry(pgen)
  let aside_entry = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(g)),
    ("at", form::Json::Num(1700000010.0)),
    ("kind", form::Json::Str("ws")),
    ("body", form::Json::Obj([
      ("t", form::Json::Str(station_rules_bridge::ws_tag("ws_1", g))),
      ("h", form::Json::Str(test_station_pub)),
    ])),
  ])
  let ts_doc = form::Json::Obj([
    ("chains", form::Json::Obj([(g, form::Json::Arr([pgen]))])),
    ("heard", form::Json::Obj([(g, form::Json::Arr([form::Json::Str("ws_1"), form::Json::Str("ws_2")]))])),
    ("aside", form::Json::Obj([(g, form::Json::Arr([aside_entry]))])),
  ])
  let _ = (fs.write_private_text)(person_chains_path("/d"), form::json_stringify(ts_doc))

  // open -> save_person_chains -> reload preserves chains, heard, AND aside!
  let store = CloudStore::open("/d", fs)
  assert_true(store.person_chains.length() == 1)
  match store.save_person_chains() {
    Ok(_) => ()
    Err(_) => assert_true(false)
  }
  let reloaded = read_person_chains_doc("/d", fs)
  assert_true(reloaded.chains.length() == 1)
  assert_true(reloaded.chains[0].0 == g)
  match reloaded.heard {
    Some(h) => {
      let s = form::json_stringify(h)
      assert_true(s.contains("\"ws_1\""))
      assert_true(s.contains("\"ws_2\""))
    }
    None => assert_true(false)
  }
  match reloaded.aside {
    Some(a) => {
      let s = form::json_stringify(a)
      assert_true(s.contains(test_station_pub))
    }
    None => assert_true(false)
  }
}

test "R4 #2: verify_fn threaded through join_workspace/name_joined_lock and personal_vault_lock/chains" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  let _ = write_state("/d", sample_cloud_state("ws_home"), fs)
  // Pre-seed a joined lock on disk so join_workspace -> name_joined_lock -> read_lock verifies it!
  let j_gen = make_genesis_entry("ws_j_vf")
  let j_gen_h = hash_of_entry(j_gen)
  let _ = (fs.write_private_text)(
    joined_lock_path("/d", "ws_j_vf"),
    form::json_stringify(form::Json::Obj([("entries", form::Json::Arr([j_gen]))])),
  )
  let mut join_vf_calls = 0
  let join_vf = fn(alg : String, key : Bytes, sig : Bytes, msg : Bytes) -> Bool {
    join_vf_calls = join_vf_calls + 1
    if alg == "Ed25519" { crypto::ed25519_verify(key, msg, sig) } else { false }
  }
  let key = match StationKey::from_seed(must_hex(test_station_seed)) {
    Ok(k) => k
    Err(_) => StationKey::{ seed: Bytes::new(0), id: "" }
  }
  match join_workspace(
    "/d",
    fs,
    key,
    "tok_jvf",
    "0.1.0",
    1700000100.to_int64(),
    fn(_u : String, _b : String) -> Result[(Int, String), String] {
      Ok((200, "{\"workspace\":\"ws_j_vf\",\"workspace_name\":\"JVF\",\"name\":\"st-jvf\"}"))
    },
    lock_hash=Some(j_gen_h),
    verify_fn=Some(join_vf),
  ) {
    Ok(r) => assert_true(r.workspace == "ws_j_vf")
    Err(_) => assert_true(false)
  }
  assert_true(join_vf_calls >= 1)

  // personal_vault_lock & personal_vault_chains thread verify_fn into person_fold!
  let owner_id = "ed25519:" + test_owner_pub
  let pgen = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("sub", form::Json::Str("u1")),
      ("device", form::Json::Obj([
        ("key", form::Json::Str(owner_id)),
        ("id", form::Json::Str(test_owner_pub)),
        ("label", form::Json::Str("Mac")),
        ("sign_key", form::Json::Str(owner_id)),
      ])),
    ])),
  ])
  let pg_h = hash_of_entry(pgen)
  let sources = PersonalLockSources::{
    chains: [(pg_h, [pgen])],
    member_emails: Map::new(),
    member_roles: Map::new(),
    vaults: [],
    boxes: [],
    cert_ok: fn(_s : lock::LockState, _c : BoxCertSummary) -> Bool { false },
  }
  let mut vault_vf_calls = 0
  let vault_vf = fn(alg : String, key : Bytes, sig : Bytes, msg : Bytes) -> Bool {
    vault_vf_calls = vault_vf_calls + 1
    if alg == "Ed25519" { crypto::ed25519_verify(key, msg, sig) } else { false }
  }
  let vlock = personal_vault_lock("ws_home", sources, verify_fn=Some(vault_vf))
  assert_true(vlock.persons.contains("u1"))
  assert_true(vault_vf_calls >= 1)
  let before_chains = vault_vf_calls
  let vchains = personal_vault_chains("ws_home", sources, verify_fn=Some(vault_vf))
  assert_true(vchains.contains("u1"))
  assert_true(vault_vf_calls > before_chains)
}

test "R4 #3: fs.bytes null + fs.lstat non-null fails closed on read_lock and load_key" {
  // classify_read_none: Null lstat -> Ok(None) (ENOENT); non-null lstat -> Err("cannot read existing file")
  match classify_read_none("/d/mesh/lock.json", Ok(base_codec::json_null())) {
    Ok(None) => ()
    _ => assert_true(false)
  }
  let stat_obj = base_codec::json_obj([("kind", base_codec::json_str("file")), ("size", base_codec::json_int(128))])
  match classify_read_none("/d/mesh/lock.json", Ok(stat_obj)) {
    Err(msg) => assert_true(msg.contains("cannot read existing file"))
    _ => assert_true(false)
  }

  // Simulated shell fs where fs.bytes returns null on EACCES but fs.lstat returns non-null
  let eacces_cloud_fs = CloudFs::{
    read_text: fn(p : String) -> Result[Option[String], String] {
      match classify_read_none(p, Ok(stat_obj)) {
        Ok(None) => Ok(None)
        Ok(Some(_)) => Ok(Some(""))
        Err(e) => Err(e)
      }
    },
    write_private_text: fn(_p : String, _t : String) -> Result[Unit, String] { Ok(()) },
    remove_file: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    rename_file: fn(_a : String, _b : String) -> Result[Unit, String] { Ok(()) },
    mkdir_p: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    exists: fn(_p : String) -> Bool { true },
  }
  match read_lock("/d", eacces_cloud_fs) {
    Some(kl) => match kl.state {
      None => ()
      Some(_) => assert_true(false)
    }
    None => assert_true(false)
  }

  let mut overwrote_key = false
  let eacces_key_fs = KeyFs::{
    read_bytes: fn(p : String) -> Result[Option[Bytes], String] {
      classify_read_none(p, Ok(stat_obj))
    },
    write_private: fn(_p : String, _b : Bytes) -> Result[Unit, String] {
      overwrote_key = true
      Ok(())
    },
    random_bytes: fn(_n : Int) -> Result[Bytes, String] { Ok(must_hex(test_station_seed)) },
  }
  match load_key("/d", eacces_key_fs) {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("cannot read existing file"))
  }
  assert_true(!overwrote_key)
}

// ── R5 Final 2-Item Regression Tests ──

test "R5 #1: state_at / make_now_cb fails closed on missing parent and cycle (never returns None)" {
  let empty_states : Map[String, lock::LockState] = Map::new()
  let now_cb = match make_now_cb(Some(1700000050.0), empty_states, None) {
    Some(f) => f
    None => {
      assert_true(false)
      fn(_p : String, _e : form::Json, _find : (String) -> Option[form::Json]) -> Option[String] { None }
    }
  }
  let dummy_entry = make_genesis_entry("ws_cycle")

  // 1. Broken/missing parent returns explicit refusal reason (Some), never None
  match now_cb("deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef", dummy_entry, fn(_h : String) -> Option[form::Json] { None }) {
    Some(msg) => assert_true(msg.contains("parent entry missing"))
    None => assert_true(false)
  }

  // 2. Cycle in parent chain (a -> b -> a) returns explicit refusal reason (Some), never None
  let ha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let hb = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let ea = form::Json::Obj([("prev", form::Json::Str(hb))])
  let eb = form::Json::Obj([("prev", form::Json::Str(ha))])
  let cyclic_find = fn(h : String) -> Option[form::Json] {
    if h == ha { Some(ea) } else if h == hb { Some(eb) } else { None }
  }
  match now_cb(ha, dummy_entry, cyclic_find) {
    Some(msg) => assert_true(msg.contains("cycle"))
    None => assert_true(false)
  }
}

test "R5 #2: untraversable parent dir (chmod 0000: bytes=null, lstat(path)=null, lstat(dir)!=null, readdir(dir)=null) fails closed" {
  let dir_stat = base_codec::json_obj([("kind", base_codec::json_str("dir"))])
  // Simulate chmod 0000 on /d/mesh:
  // - fs.lstat("/d/mesh/lock.json") -> null (EACCES)
  // - fs.lstat("/d/mesh") -> dir_stat (exists!)
  // - fs.readdir("/d/mesh") -> null (EACCES!)
  let lstat_chmod0 = fn(p : String) -> Result[base_codec::Json, String] {
    if p == "/d/mesh" || p == "/d" {
      Ok(dir_stat)
    } else {
      Ok(base_codec::json_null())
    }
  }
  let readdir_chmod0 = fn(_d : String) -> Result[base_codec::Json, String] {
    Ok(base_codec::json_null())
  }

  // CloudFs::read_text & read_lock fail closed
  let cloud_fs_chmod0 = CloudFs::{
    read_text: fn(p : String) -> Result[Option[String], String] {
      match classify_read_none_with_ancestors(p, "/", lstat_chmod0, readdir_chmod0) {
        Ok(None) => Ok(None)
        Ok(Some(_)) => Ok(Some(""))
        Err(e) => Err(e)
      }
    },
    write_private_text: fn(_p : String, _t : String) -> Result[Unit, String] { Ok(()) },
    remove_file: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    rename_file: fn(_a : String, _b : String) -> Result[Unit, String] { Ok(()) },
    mkdir_p: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    exists: fn(_p : String) -> Bool { false },
  }
  match (cloud_fs_chmod0.read_text)("/d/mesh/lock.json") {
    Err(msg) => assert_true(msg.contains("cannot read existing file or directory"))
    _ => assert_true(false)
  }
  match read_lock("/d", cloud_fs_chmod0) {
    Some(kl) => match kl.state {
      None => ()
      Some(_) => assert_true(false)
    }
    None => assert_true(false)
  }

  // KeyFs::read_bytes & load_key fail closed (never regenerate identity!)
  let mut wrote_key = false
  let key_fs_chmod0 = KeyFs::{
    read_bytes: fn(p : String) -> Result[Option[Bytes], String] {
      classify_read_none_with_ancestors(p, "/", lstat_chmod0, readdir_chmod0)
    },
    write_private: fn(_p : String, _b : Bytes) -> Result[Unit, String] {
      wrote_key = true
      Ok(())
    },
    random_bytes: fn(_n : Int) -> Result[Bytes, String] { Ok(must_hex(test_station_seed)) },
  }
  match load_key("/d", key_fs_chmod0) {
    Ok(_) => assert_true(false)
    Err(msg) => assert_true(msg.contains("cannot read existing file or directory"))
  }
  assert_true(!wrote_key)

  // Genuine ENOENT: ancestor /d/mesh exists & readdir succeeds without "lock.json" -> Ok(None)
  let readdir_ok_missing = fn(_d : String) -> Result[base_codec::Json, String] {
    Ok(base_codec::json_arr([base_codec::json_str("cloud.json")]))
  }
  match classify_read_none_with_ancestors("/d/mesh/lock.json", "/", lstat_chmod0, readdir_ok_missing) {
    Ok(None) => ()
    _ => assert_true(false)
  }

  // Parent readdir lists "lock.json" even though lstat returned null -> fail closed!
  let readdir_has_lock = fn(_d : String) -> Result[base_codec::Json, String] {
    Ok(base_codec::json_arr([base_codec::json_str("lock.json")]))
  }
  match classify_read_none_with_ancestors("/d/mesh/lock.json", "/", lstat_chmod0, readdir_has_lock) {
    Err(msg) => assert_true(msg.contains("cannot read existing file or directory"))
    _ => assert_true(false)
  }
}

test "#9067: waiting moved station grant_keys uses pinned chain cloud_keys and broken lock.json returns null" {
  let mem = MemCloudFs::new()
  let fs = mem.as_fs()
  // Put a distinct fake key in control-plane state to prove waiting never trusts control-plane grant_keys.
  let st = sample_cloud_state("ws_wait_gk")
  st.grant_keys = base_codec::json_obj([
    ("keys", base_codec::json_arr([base_codec::json_obj([("kid", base_codec::json_str("k-plane-fake"))])])),
  ])
  let _ = write_state("/d", st, fs)
  let store = CloudStore::open("/d", fs)

  let owner_id = "ed25519:" + test_owner_pub
  let pgen = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("person:u1")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("sub", form::Json::Str("u1")),
      ("device", form::Json::Obj([
        ("key", form::Json::Str(owner_id)),
        ("id", form::Json::Str(test_owner_pub)),
        ("label", form::Json::Str("Mac")),
        ("sign_key", form::Json::Str(owner_id)),
      ])),
    ])),
  ])
  let root_hash = hash_of_entry(pgen)

  // Genesis with pinned cloud_keys = [{kid: "k-chain"}]
  let gen = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws_wait_gk")),
    ("seq", form::Json::Num(0.0)),
    ("prev", form::Json::Null),
    ("at", form::Json::Num(1700000000.0)),
    ("kind", form::Json::Str("genesis")),
    ("body", form::Json::Obj([
      ("owner", form::Json::Str("u1")),
      ("origins", form::Json::Arr([form::Json::Str("https://app.still.fail")])),
      ("rp_id", form::Json::Str("app.still.fail")),
      ("cloud_keys", form::Json::Obj([
        ("keys", form::Json::Arr([form::Json::Obj([("kid", form::Json::Str("k-chain"))])])),
      ])),
      ("members", form::Json::Arr([
        form::Json::Obj([
          ("sub", form::Json::Str("u1")),
          ("email", form::Json::Str("u1@x")),
          ("role", form::Json::Str("owner")),
        ]),
      ])),
      ("devices", form::Json::Arr([
        form::Json::Obj([
          ("id", form::Json::Str(test_owner_pub)),
          ("sub", form::Json::Str("u1")),
          ("kind", form::Json::Str("app")),
          ("label", form::Json::Str("Mac")),
          ("sign_key", form::Json::Str(owner_id)),
        ]),
      ])),
      ("stations", form::Json::Arr([
        form::Json::Obj([
          ("key", form::Json::Str(test_station_pub)),
          ("name", form::Json::Str("st1")),
        ]),
      ])),
      ("gateways", form::Json::Arr([])),
    ])),
  ])
  let gen_h = hash_of_entry(gen)
  let mv_entry = make_signed_entry(test_owner_seed, test_owner_pub, [
    ("v", form::Json::Num(1.0)),
    ("ws", form::Json::Str("ws_wait_gk")),
    ("seq", form::Json::Num(1.0)),
    ("prev", form::Json::Str(gen_h)),
    ("at", form::Json::Num(1700000010.0)),
    ("kind", form::Json::Str("moved")),
    ("body", form::Json::Obj([("root", form::Json::Str(root_hash))])),
  ])
  match store.take_lock([gen, mv_entry], Some(1700000020.0)) {
    Ok(n) => assert_true(n == 2)
    Err(_) => assert_true(false)
  }

  // Waiting state: grant_keys must return pinned chain cloud_keys ("k-chain"), NOT null and NOT "k-plane-fake".
  match store.locked(1700000020.0, ws=None) {
    Some(eff) => assert_true(eff.waiting)
    None => assert_true(false)
  }
  let gk = store.grant_keys(1700000020.0, ws=None)
  let gk_str = base_codec::json_stringify(gk)
  assert_true(gk_str.contains("k-chain"))
  assert_true(!gk_str.contains("k-plane-fake"))

  // Broken lock.json must fail closed with null grant_keys.
  let _ = (fs.write_private_text)("/d/mesh/lock.json", "{broken json")
  let broken = CloudStore::open("/d", fs)
  match broken.grant_keys(1700000020.0, ws=None) {
    base_codec::Json::Null => ()
    _ => assert_true(false)
  }
}
