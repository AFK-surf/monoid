// Cloud state persistence (`cloud.json`), lock/pending/joined lock files, fork choice,
// membership/rig/lock queries, and `join_workspace` (for Wave 12 `station_rig`).
// 1:1 with `station/src/cloud/state.ts` and `station/src/cli.ts` (`joinWorkspace`, `nameJoinedLock`).

import "base_codec"
import "builders_core"
import "crypto"
import "form"
import "js_json"
import "lock"
import "nodepath"
import "station_rules_bridge"

pub let MODE_PENDING_S : Int64 = 3600.to_int64()
pub let FORK_MSG : String = "the entry disagrees with this station's lock (a fork)"
pub let FORMER_HOST : String = "https://ember.3720.org"
pub let CURRENT_HOST : String = "https://app.still.fail"
pub let UNPROTECTED_MSG : String = "that station is in this workspace but not protected by its safe mode (安全模式): it was offline or too old when safe mode was turned on. It is not a bug: stations safe mode protects run no remote tasks for an unprotected one, nor share with it, and it cannot be called from here. An owner or admin of the workspace protects it in the app's Settings → Security (设置 → 安全) with Protect (保护), updating it first if it is too old."
pub let NOT_GIVEN_MSG : String = "this station has not yet been given this workspace's settings by a trusted device: connect from a device of the workspace's owner, or wait for another of its stations to bring them"

let OFF_LOGS_MAX : Int = 4

// ── Types ──

