    ("INSERT INTO remote_run_progress(id, done) VALUES (1, 1)", []),
    ("INSERT INTO remote_run_total(id, n) VALUES (1, 4)", []),
    ("INSERT INTO remote_run_counts(ws, n) VALUES ('ws1', 2)", []),
    ("INSERT INTO remote_run_lookup(ws, at, session) VALUES ('ws1', 1704067201000, 'chat:s1/a')", []),
    ("INSERT INTO remote_run_lookup(ws, at, session) VALUES ('ws1', 1704067205000, 'chat:s1/a')", []),
  ]
  for i in 0..<seeds.length() {
    match db_exec_ok(db, seeds[i].0, seeds[i].1) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }

  // 1-6: outflow_messages (all entries, P1-2 U+FFFD Feishu vs \ud800 Group, card enrichment, messagesOnly, foreign ws)
  let om_all = match outflow_messages(
    db,
    client,
    root,
    "/",
    base_codec::json_obj([
      ("thread", base_codec::json_num(10.0)),
      ("after", base_codec::json_num(0.0)),
      ("limit", base_codec::json_num(10.0)),
      ("ws", base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(false))])),
    ]),
  ) {
    Ok(v) => v
    Err(e) => return Err("outflow_messages all failed: " + readops_core::read_error_message(e))
  }
  let om_msgs = match readops_core::json_val(om_all, "messages") {
    Some(base_codec::Json::Arr(xs)) => xs
    _ => []
  }
  match check(om_msgs.length() == 5, "outflow_messages all count == 5", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let p0_email = match readops_core::json_val(om_msgs[0], "person") {
    Some(p) => readops_core::json_val(p, "email")
    None => None
  }
  match check(
    match p0_email { Some(base_codec::Json::Str("alice@acme.com")) => true; _ => false },
    "outflow_messages resolved slack person email",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  // P1-2 regression: author "slack:\u{FFFD}:U9" MUST match Feishu U+FFFD connect (via: "feishu", email: "fu@acme.com"),
  // NOT the later Group \ud800 connect!
  let p3_ok = match readops_core::json_val(om_msgs[3], "person") {
    Some(p) => {
      readops_chats::mb_json_eq(readops_core::json_val_or_null(p, "via"), base_codec::json_str("feishu")) &&
      readops_chats::mb_json_eq(readops_core::json_val_or_null(p, "name"), base_codec::json_str("FeishuUser")) &&
      readops_chats::mb_json_eq(readops_core::json_val_or_null(p, "email"), base_codec::json_str("fu@acme.com"))
    }
    None => false
  }
  match check(p3_ok, "P1-2: Feishu U+FFFD connect not clobbered by Group \\ud800 connect", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  // R2 P2-1 regression: author "slack:c-slack:\u{FFFD}" with name "\ud800" MUST NOT be falsely nulled by suffix check!
  let p4_ok = match readops_core::json_val(om_msgs[4], "person") {
    Some(p) => {
      match readops_core::json_val(p, "name") {
        Some(base_codec::Json::Str(n)) => n != ""
        _ => false
      }
    }
    None => false
  }
  match check(p4_ok, "R2 P2-1: lone-surrogate name not falsely nulled by suffix comparison", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let card_closed = match readops_core::json_val(om_msgs[1], "card") {
    Some(c) => {
      match (readops_core::json_val(c, "closed"), readops_core::json_val(c, "choice")) {
        (Some(base_codec::Json::Bool(true)), Some(base_codec::Json::Str("Yes"))) => true
        _ => false
      }
    }
    None => false
  }
  match check(card_closed, "outflow_messages enriched closed card + choice", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let om_only = match outflow_messages(
    db,
    client,
    root,
    "/",
    base_codec::json_obj([
      ("thread", base_codec::json_num(10.0)),
      ("after", base_codec::json_num(0.0)),
      ("limit", base_codec::json_num(10.0)),
      ("messagesOnly", base_codec::json_bool(true)),
      ("ws", base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(false))])),
    ]),
  ) {
    Ok(v) => v
    Err(e) => return Err("outflow_messages messagesOnly failed: " + readops_core::read_error_message(e))
  }
  let om_only_msgs = match readops_core::json_val(om_only, "messages") {
    Some(base_codec::Json::Arr(xs)) => xs
    _ => []
  }
  match check(om_only_msgs.length() == 4, "outflow_messages messagesOnly excludes edit via savepoint", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let om_other_ws = match outflow_messages(
    db,
    client,
    root,
    "/",
    base_codec::json_obj([
      ("thread", base_codec::json_num(20.0)),
      ("after", base_codec::json_num(0.0)),
      ("limit", base_codec::json_num(10.0)),
      ("ws", base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(false))])),
    ]),
  ) {
    Ok(v) => v
    Err(e) => return Err("outflow_messages other ws failed: " + readops_core::read_error_message(e))
  }
  match check(
    match om_other_ws { base_codec::Json::Null => true; _ => false },
    "outflow_messages foreign workspace returns null",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  // 7-13: outflow_chats (URL encoding, before/more/next pagination, need_human card, all_done unread, failed first-line)
  let oc_page1 = match outflow_chats(
    db,
    client,
    root,
    "/",
    base_codec::json_obj([
      (
        "args",
        base_codec::json_obj([
          ("since", base_codec::json_num(0.0)),
          ("limit", base_codec::json_num(2.0)),
          ("ws", base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(false))])),
          (
            "pages",
            base_codec::json_obj([
              ("origin", base_codec::json_str("https://app.test")),
              ("workspace", base_codec::json_str("ws1")),
              ("station", base_codec::json_str("st1")),
            ]),
          ),
        ]),
      ),
    ]),
  ) {
    Ok(v) => v
    Err(e) => return Err("outflow_chats page1 failed: " + readops_core::read_error_message(e))
  }
  let oc_list1 = match readops_core::json_val(oc_page1, "chats") {
    Some(base_codec::Json::Arr(xs)) => xs
    _ => []
  }
  let oc_next1 = readops_core::json_val_or_null(oc_page1, "next")
  match check(
    oc_list1.length() == 2 &&
    readops_chats::mb_json_eq(readops_core::json_val_or_null(oc_page1, "more"), base_codec::json_bool(true)) &&
    readops_chats::mb_json_eq(oc_next1, base_codec::json_str("910.30")),
    "outflow_chats page1 returns 2 chats with more=true and next=910.30",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let c0 = oc_list1[0]
  match check(
    readops_chats::mb_json_eq(readops_core::json_val_or_null(c0, "state"), base_codec::json_str("need_human")),
    "outflow_chats maps need_decision -> need_human via last_turn_of",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match check(
    readops_chats::mb_json_eq(
      readops_core::json_val_or_null(c0, "url"),
      base_codec::json_str("https://app.test/o/ws1/st1/chat%3As1%2Fa"),
    ),
    "outflow_chats encodes session key in url with encode_uri_component",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let att0_ok = match readops_core::json_val(c0, "attention") {
    Some(att) => {
      readops_chats::mb_json_eq(readops_core::json_val_or_null(att, "kind"), base_codec::json_str("need")) &&
      readops_chats::mb_json_eq(readops_core::json_val_or_null(att, "card"), base_codec::json_str("options")) &&
      readops_chats::mb_json_eq(readops_core::json_val_or_null(att, "note"), base_codec::json_str("approve deploy"))
    }
    None => false
  }
  match check(att0_ok, "outflow_chats attention card & trimmed note", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match check(
    readops_chats::mb_json_eq(readops_core::json_val_or_null(c0, "router"), base_codec::json_bool(true)) &&
    readops_chats::mb_json_eq(readops_core::json_val_or_null(c0, "surface"), base_codec::json_str("stillfail")),
    "outflow_chats router flag & chat->stillfail surface",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let c1 = oc_list1[1]
  let att1_ok = match readops_core::json_val(c1, "attention") {
    Some(att) => {
      readops_chats::mb_json_eq(readops_core::json_val_or_null(att, "kind"), base_codec::json_str("done")) &&
      readops_chats::mb_json_eq(readops_core::json_val_or_null(att, "note"), base_codec::json_str("shipped"))
    }
    None => false
  }
  match check(att1_ok, "outflow_chats attention all_done unread branch", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  // Page 2 using `before: "910.30"` -> returns thread 40 (failed turn, first line of detail) with more=false, next=null
  let oc_page2 = match outflow_chats(
    db,
    client,
    root,
    "/",
    base_codec::json_obj([
      (
        "args",
        base_codec::json_obj([
          ("since", base_codec::json_num(0.0)),
          ("limit", base_codec::json_num(2.0)),
          ("before", oc_next1),
          ("ws", base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(false))])),
        ]),
      ),
    ]),
  ) {
    Ok(v) => v
    Err(e) => return Err("outflow_chats page2 failed: " + readops_core::read_error_message(e))
  }
  let oc_list2 = match readops_core::json_val(oc_page2, "chats") {
    Some(base_codec::Json::Arr(xs)) => xs
    _ => []
  }
  let page2_ok = oc_list2.length() == 1 &&
  readops_chats::mb_json_eq(readops_core::json_val_or_null(oc_page2, "more"), base_codec::json_bool(false)) &&
  readops_chats::mb_json_eq(readops_core::json_val_or_null(oc_page2, "next"), base_codec::json_null()) &&
  match readops_core::json_val(oc_list2[0], "attention") {
    Some(att) => {
      readops_chats::mb_json_eq(readops_core::json_val_or_null(att, "kind"), base_codec::json_str("failed")) &&
      readops_chats::mb_json_eq(readops_core::json_val_or_null(att, "note"), base_codec::json_str("boom first line"))
    }
    None => false
  }
  match check(page2_ok, "outflow_chats page2 cursor pagination & failed attention first-line note", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  // 14-21: usage_page_json_str (P1-1 exact i64_json repr + history.places order + lossless profiles)
  let usage_ask = base_codec::json_obj([
    (
      "args",
      base_codec::json_obj([
        ("from", base_codec::json_num(1704067200000.0)),
        ("to", base_codec::json_num(1704153600000.0)),
        ("tz", base_codec::json_num(0.0)),
        ("history", base_codec::json_bool(true)),
        (
          "historyRange",
          base_codec::json_obj([
            ("from", base_codec::json_num(1704067200000.0)),
            ("to", base_codec::json_num(1704153600000.0)),
          ]),
        ),
        ("viewer", base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(false))])),
      ]),
    ),
  ])
  let usage_wire = match usage_page_json_str(db, state, root, usage_ask) {
    Ok(s) => s
    Err(e) => return Err("usage_page_json_str failed: " + readops_core::read_error_message(e))
  }
  match check(
    readops_core::str_contains_sub(usage_wire, "\"\\ud800\":{\"name\":\"Lone\\ud800\",\"runtime\":\"agy\"}"),
    "usage_page_json_str preserves lone surrogate key and trimmed value losslessly",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  // P1-1: history.places MUST preserve insertion order ["chat","10","2"] (NOT reordered to ["2","10","chat"])!
  match check(
    readops_core::str_contains_sub(usage_wire, "\"places\":{\"chat\":3,\"10\":4,\"2\":5}"),
    "P1-1: history.places preserves MB insertion order [chat, 10, 2]",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  // P1-1: from=to="9007199254740993" MUST emit exact decimal digits without Double precision loss!
  let big_ask = base_codec::json_obj([
    (
      "args",
      base_codec::json_obj([
        ("from", base_codec::json_str("9007199254740993")),
        ("to", base_codec::json_str("9007199254740993")),
        ("tz", base_codec::json_num(0.0)),
      ]),
    ),
  ])
  let big_wire = match usage_page_json_str(db, state, root, big_ask) {
    Ok(s) => s
    Err(e) => return Err("usage_page_json_str big i64 failed: " + readops_core::read_error_message(e))
  }
  match check(
    readops_core::str_contains_sub(big_wire, "\"from\":9007199254740993,\"to\":9007199254740993"),
    "P1-1: exact i64 decimal repr 9007199254740993 preserved in raw wire JSON",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  // P2-3: 1e400 parsed via sql_db::parse_json returns exact MB error "Cannot convert 1e400 to a BigInt"
  let inf_ask = match sql_db::parse_json("{\"args\":{\"from\":1e400,\"to\":0,\"tz\":0}}") {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(e) => return Err("parse 1e400 ask failed: " + e)
  }
  let inf_ok = match usage_page_json_str(db, state, root, inf_ask) {
    Err(readops_core::ReadError::App(m)) => m == "Cannot convert 1e400 to a BigInt"
    _ => false
  }
  match check(inf_ok, "P2-3: 1e400 returns exact 'Cannot convert 1e400 to a BigInt'", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let idx_0 = readops_core::str_find_sub(usage_wire, "\"0\":{\"name\":\"ZeroMoved\"")
  let idx_2 = readops_core::str_find_sub(usage_wire, "\"2\":{\"name\":\"Two\"")
  let idx_10 = readops_core::str_find_sub(usage_wire, "\"10\":{\"name\":\"Ten\"")
  let idx_dup = readops_core::str_find_sub(usage_wire, "\"dup\":{\"name\":\"Second\",\"runtime\":\"codex\"}")
  let idx_gw = readops_core::str_find_sub(usage_wire, "\"gw\":{\"name\":\"GW\",\"runtime\":\"codex\"}")
  let idx_moved = readops_core::str_find_sub(usage_wire, "\"moved-1\":{\"name\":\"Moved One\",\"runtime\":\"grok\"}")
  let order_ok = match (idx_0, idx_2, idx_10, idx_dup, idx_gw, idx_moved) {
    (Some(a), Some(b), Some(c), Some(d), Some(e), Some(f)) => a < b && b < c && c < d && d < e && e < f
    _ => false
  }
  match check(order_ok, "usage_page_json_str integer-index key reorder & dup last-wins at first pos", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let parsed_wire = match js_json::parse(usage_wire) {
    Ok(v) => v
    Err(e) => return Err("js_json::parse(usage_wire) failed: " + e)
  }
  let prof_obj = readops_core::jget(Some(parsed_wire), "profiles")
  let prof_count = match prof_obj {
    Some(js_json::JValue::Obj(es)) => es.length()
    _ => 0
  }
  match check(prof_count == 8, "profiles has 8 distinct keys (0, 2, 10, dup, \\ud800, U+FFFD, gw, moved-1)", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match check(
    readops_core::str_contains_sub(usage_wire, "\"beforeDay\":\"2024-01-02\"") &&
    readops_core::str_contains_sub(usage_wire, "\"remoteRuns\":[{\"at\":1704067205000,\"session\":\"chat:s1/a\",\"count\":2}]") &&
    readops_core::str_contains_sub(usage_wire, "\"cards\":2,\"picked\":1"),
    "usage_page history beforeDay, remoteRuns count=2, and cards/picked",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  // 22-24: outflow_usage (renames profile -> account, resolves people, clamps tz/span)
  let ou = match outflow_usage(
    db,
    state,
    root,
    base_codec::json_obj([
      (
        "args",
        base_codec::json_obj([
          ("from", base_codec::json_num(1704067200000.0)),
          ("to", base_codec::json_num(1704153600000.0)),
          ("tz", base_codec::json_num(2000.0)),
          ("ws", base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(false))])),
        ]),
      ),
    ]),
  ) {
    Ok(v) => v
    Err(e) => return Err("outflow_usage failed: " + readops_core::read_error_message(e))
  }
  match check(
    readops_chats::mb_json_eq(readops_core::json_val_or_null(ou, "tz"), base_codec::json_num(1440.0)),
    "outflow_usage clamps tz to 1440",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let ou_rows = match readops_core::json_val(ou, "rows") {
    Some(base_codec::Json::Arr(xs)) => xs
    _ => []
  }
  match check(
    ou_rows.length() == 1 &&
    readops_chats::mb_json_eq(readops_core::json_val_or_null(ou_rows[0], "account"), base_codec::json_str("dup")),
    "outflow_usage maps profile -> account",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let ou_person_ok = match readops_core::json_val(ou, "people") {
    Some(ps) => {
      match readops_core::json_val(ps, "slack:c-slack:U1") {
        Some(p) => readops_chats::mb_json_eq(readops_core::json_val_or_null(p, "email"), base_codec::json_str("alice@acme.com"))
        None => false
      }
    }
    None => false
  }
  match check(ou_person_ok, "outflow_usage resolves people map", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  // 25-27: cardsIncomplete, chatsIncomplete, and SAVEPOINT 503 swallow-error recovery
  match db_exec_ok(db, "CREATE TABLE card_outcomes_incomplete(id INTEGER)", []) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let cards_inc_wire = match usage_page_json_str(db, state, root, usage_ask) {
    Ok(s) => s
    Err(e) => return Err("cardsIncomplete usage_page failed: " + readops_core::read_error_message(e))
  }
  match check(
    readops_core::str_contains_sub(cards_inc_wire, "\"cardsIncomplete\":true"),
