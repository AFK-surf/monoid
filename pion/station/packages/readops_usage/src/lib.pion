    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match db_exec_ok(db, "UPDATE usage_chat_progress SET done = 0 WHERE id = 1", []) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let chats_inc_wire = match usage_page_json_str(db, state, root, usage_ask) {
    Ok(s) => s
    Err(e) => return Err("chatsIncomplete usage_page failed: " + readops_core::read_error_message(e))
  }
  match check(
    readops_core::str_contains_sub(chats_inc_wire, "\"chatsIncomplete\":true") &&
    readops_core::str_contains_sub(chats_inc_wire, "\"places\":{}"),
    "usage_history sets chatsIncomplete and empty places when chat stats pending",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  // R2 P1 regression: usage_page_json_str with remote-connects.json (U+FFFD Feishu + \ud800 Slack)
  // resolves usage.people["slack:\u{FFFD}:U9"] -> name="FeishuUser", email="fu@acme.com", via="feishu"!
  let remote_usage_ask = base_codec::json_obj([
    (
      "args",
      base_codec::json_obj([
        ("from", base_codec::json_num(1704067200000.0)),
        ("to", base_codec::json_num(1704153600000.0)),
        ("tz", base_codec::json_num(0.0)),
        ("viewer", base_codec::json_obj([("workspace", base_codec::json_str("ws3")), ("home", base_codec::json_bool(false))])),
      ]),
    ),
  ])
  let remote_usage_wire = match usage_page_json_str(db, state, remote_root, remote_usage_ask) {
    Ok(s) => s
    Err(e) => return Err("R2 P1 usage_page_json_str failed: " + readops_core::read_error_message(e))
  }
  let r2_p1_ok = readops_core::str_contains_sub(remote_usage_wire, "\"name\":\"FeishuUser\"") &&
  readops_core::str_contains_sub(remote_usage_wire, "\"email\":\"fu@acme.com\"") &&
  readops_core::str_contains_sub(remote_usage_wire, "\"via\":\"feishu\"")
  match check(r2_p1_ok, "R2 P1: usage.people remote-connects U+FFFD Feishu not clobbered by \\ud800 Slack", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  // Drop entries_letters index and seed 70 edit rows on thread 10 to trigger 503 PAGE_LETTER_PENDING
  // inside `savepoint_swallow_err("message_entries_after_read", ...)`, verifying db.autocommit() == true before & after!
  match db_exec_ok(db, "DROP INDEX entries_letters", []) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  for k in 0..<70 {
    match db_exec_ok(
      db,
      "INSERT INTO entries(thread, n, kind, target, author_kind, author, text, at) VALUES (?, ?, 'edit', 1, 'agent', 'chat:s1/a', 'e', ?)",
      [base_codec::json_num(10.0), base_codec::json_num((100 + k).to_double()), base_codec::json_num((2000 + k).to_double())],
    ) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let ac_before = db.autocommit()
  let sp_503 = match outflow_messages(
    db,
    client,
    root,
    "/",
    base_codec::json_obj([
      ("thread", base_codec::json_num(10.0)),
      ("after", base_codec::json_num(50.0)),
      ("limit", base_codec::json_num(2.0)),
      ("messagesOnly", base_codec::json_bool(true)),
      ("ws", base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(false))])),
    ]),
  ) {
    Err(readops_core::ReadError::Refused(503, m)) => readops_core::str_has_prefix(m, readops_core::PAGE_LETTER_PENDING)
    _ => false
  }
  let ac_after = db.autocommit()
  let still_usable = match readops_core::one(db, "SELECT 1 AS x FROM threads WHERE id = 10", []) {
    Ok(Some(_)) => true
    _ => false
  }
  match check(
    ac_before && sp_503 && ac_after && still_usable,
    "R2 P2-2: page_keys_after 503 + savepoint_swallow_err keeps db.autocommit() == true",
    passed,
  ) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  // 28: historyUnavailable on a DB without usage_15m_meta
  let db2 = match sql_db::Db::create(root + "/no_history.db") {
    Ok(d) => d
    Err(e) => return Err("open no_history db failed: " + e.message)
  }
  let min_stmts : Array[String] = [
    "CREATE TABLE usage_span(id INTEGER PRIMARY KEY, first_at INTEGER)",
    "CREATE TABLE usage_15m_meta_unused(id INTEGER)",
    "CREATE TABLE usage_15m(scope TEXT, quarter INTEGER, session TEXT, thread INTEGER, person TEXT, profile TEXT, runtime TEXT, model TEXT, fast INTEGER, calls INTEGER, input INTEGER, cache_read INTEGER, cache_write INTEGER, cache_write_long INTEGER, output INTEGER)",
    "CREATE TABLE remote_run_progress(id INTEGER PRIMARY KEY, done INTEGER)",
  ]
  for i in 0..<min_stmts.length() {
    match db_exec_ok(db2, min_stmts[i], []) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  // Note: usage_page_json_str calls detail_since which queries usage_15m_meta unless metadata=false;
  // check usage_history directly returns Null when usage_15m_meta is absent!
  let hist_unavail = match usage_history(db2, 0.to_int64(), None, None) {
    Ok(base_codec::Json::Null) => true
    _ => false
  }
  match check(hist_unavail, "usage_history returns Null (historyUnavailable) when usage_15m_meta absent", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let _ = db2.close()

  // 29-30: Non-finite float -> null & shortlex ordering sanity on linked binary
  let nf_str = js_json::stringify(
    normalize_jval(
      js_json::JValue::Obj([
        (js_json::utf16_units("nan"), js_json::JValue::Num(0.0 / 0.0)),
        (js_json::utf16_units("inf"), js_json::JValue::Num(1.0 / 0.0)),
        (js_json::utf16_units("ok"), js_json::JValue::Num(42.0)),
      ]),
    ),
  )
  match check(nf_str == "{\"nan\":null,\"inf\":null,\"ok\":42}", "non-finite floats serialize as null", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match check(shortlex_compare("z", "aa") < 0 && shortlex_compare("2024-01-02", "2024-01-10") < 0, "shortlex_compare parity", passed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let _ = db.close()
  Ok(passed[0])
}
