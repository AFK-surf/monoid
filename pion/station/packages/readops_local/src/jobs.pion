// 1:1 port of `station/mb/src/readops/jobs.mbt`.
// Reads of a background job (`job`, `job_log`) and shared helpers (`shown`, `parse_usize`, `rust_lines`).

import "base_codec"
import "builders_core"
import "js_json"
import "readops_core"
import "sql_db"

let NOTICES_SHOWN : Int = 20

let LOG_BYTES : Int = 65536

/// jobs.ts `outputAt`: when a log last grew (ms), null when it is empty or does not stat.
fn output_at(client : builders_core::ShellClient, path : base_codec::Json) -> base_codec::Json {
  let p = match path {
    base_codec::Json::Str(s) => s
    _ => return base_codec::json_null()
  }
  match client.shell_sync_json("fs.meta", base_codec::json_obj([("path", base_codec::json_str(p))])) {
    Ok(v) => {
      let size = match builders_core::json_get_last(v, "size") {
        Some(base_codec::Json::Num(sz, _)) => sz
        _ => return base_codec::json_null()
      }
      if size <= 0.0 {
        return base_codec::json_null()
      }
      match builders_core::json_get_last(v, "mtimeMs") {
        Some(base_codec::Json::Num(at, r)) => base_codec::Json::Num(at, r)
        _ => base_codec::json_null()
      }
    }
    Err(_) => base_codec::json_null()
  }
}

pub fn job_row(
  db : sql_db::Db,
  id : base_codec::Json,
) -> Result[Map[String, base_codec::Json], readops_core::ReadError] {
  let rows = match db.all("SELECT * FROM jobs WHERE id = ?", [id]) {
    Ok(rs) => rs
    Err(e) => return Err(readops_core::ReadError::Sql(e))
  }
  if rows.length() == 0 {
    let id_text = match id {
      base_codec::Json::Str(s) => s
      other => sql_db::stringify_json(other)
    }
    return Err(readops_core::refused(404, "no job " + id_text))
  }
  Ok(rows[0])
}

/// jobs.ts `shown`: the record as serde writes it (token skipped, `sessionKey` as `session`),
/// its notices (up to 20), and when its output last grew (`outputAt` via `fs.meta`).
pub fn shown(
  db : sql_db::Db,
  client : builders_core::ShellClient,
  j : Map[String, base_codec::Json],
) -> Result[base_codec::Json, readops_core::ReadError] {
  let notice_rows = match db.all(
    "SELECT at, text FROM job_notices WHERE job_id = ? ORDER BY at DESC, rowid DESC LIMIT ?",
    [readops_core::field(j, "id"), base_codec::json_num(NOTICES_SHOWN.to_double())],
  ) {
    Ok(rs) => rs
    Err(e) => return Err(readops_core::ReadError::Sql(e))
  }
  let notices : Array[base_codec::Json] = []
  for i in 0..<notice_rows.length() {
    let r = notice_rows[i]
    notices.push(
      base_codec::json_obj([
        ("at", readops_core::field(r, "at")),
        ("text", readops_core::field(r, "text")),
      ]),
    )
  }
  let is_watch = match readops_core::field(j, "watch") {
    base_codec::Json::Num(v, _) => v != 0.0
    _ => true
  }
  let is_queued = match readops_core::field(j, "queued") {
    base_codec::Json::Num(v, _) => v == 1.0
    _ => false
  }
  let out : Array[(String, base_codec::Json)] = [
    ("id", readops_core::field(j, "id")),
    ("session", readops_core::field(j, "session_key")),
    ("name", readops_core::field(j, "name")),
    ("command", readops_core::field(j, "command")),
    ("cwd", readops_core::field(j, "cwd")),
    ("port", readops_core::field(j, "port")),
    ("state", readops_core::field(j, "state")),
    ("pgid", readops_core::field(j, "pgid")),
    ("exitCode", readops_core::field(j, "exit_code")),
    ("startedAt", readops_core::field(j, "started_at")),
    ("endedAt", readops_core::field(j, "ended_at")),
    ("restarts", readops_core::field(j, "restarts")),
    ("log", readops_core::field(j, "log")),
    ("watch", base_codec::json_bool(is_watch)),
  ]
  if is_queued {
    out.push(("queued", base_codec::json_bool(true)))
  }
  out.push(("notices", base_codec::json_arr(notices)))
  out.push(("outputAt", output_at(client, readops_core::field(j, "log"))))
  Ok(base_codec::json_obj(out))
}

/// GET /jobs/:id.
pub fn job(
  db : sql_db::Db,
  client : builders_core::ShellClient,
  args : base_codec::Json,
) -> Result[base_codec::Json, readops_core::ReadError] {
  let row = match job_row(db, readops_core::json_val_or_null(args, "id")) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  shown(db, client, row)
}

/// jobs.ts `rustLines`: split at `\n`, drop a `\r` before it, no trailing empty line.
pub fn rust_lines(text : String) -> Array[String] {
  if text == "" {
    return []
  }
  let parts = readops_core::str_split_byte(text, 10)
  let ended = parts.length() > 0 && parts[parts.length() - 1] == ""
  if ended {
    let _ = parts.pop()
  }
  let out : Array[String] = []
  for i in 0..<parts.length() {
    let l = parts[i]
    if (i < parts.length() - 1 || ended) && readops_core::str_has_suffix(l, "\r") {
      out.push(readops_core::str_slice_bytes(l, 0, l.to_bytes().length() - 1))
    } else {
      out.push(l)
    }
  }
  out
}

/// jobs.ts `parseUsize`: ASCII digits with an optional leading `+`, within u64 range.
/// Non-negative integer JSON numbers fail with Refused(500, "text.replace is not a function")
/// matching MB `jobs.mbt:111-114`.
pub fn parse_usize(v : Option[base_codec::Json]) -> Result[Option[Double], readops_core::ReadError] {
  let text = match v {
    Some(base_codec::Json::Str(s)) => s
    Some(base_codec::Json::Num(n, _)) => {
      if js_json::is_integer(n) && n >= 0.0 && n < 1.0e21 {
        return Err(readops_core::refused(500, "text.replace is not a function"))
      } else {
        return Ok(None)
      }
    }
    _ => return Ok(None)
  }
  let body = if readops_core::str_has_prefix(text, "+") {
    readops_core::str_slice_bytes(text, 1, text.to_bytes().length())
  } else {
    text
  }
  let bb = body.to_bytes()
  if bb.length() == 0 {
    return Ok(None)
  }
  for i in 0..<bb.length() {
    let c = bb[i].to_int() & 0xFF
    if c < 48 || c > 57 {
      return Ok(None)
    }
  }
  let mut start = 0
  while start < bb.length() - 1 && (bb[start].to_int() & 0xFF) == 48 {
    start = start + 1
  }
  let digits = readops_core::str_slice_bytes(body, start, bb.length())
  let db = digits.to_bytes()
  if db.length() > 20 || (db.length() == 20 && readops_core::by_bytes(digits, "18446744073709551615") > 0) {
    return Ok(None)
  }
  let mut n = 0.0
  for i in 0..<db.length() {
    n = n * 10.0 + ((db[i].to_int() & 0xFF) - 48).to_double()
  }
  Ok(Some(n))
}

/// GET /jobs/:id/log.
pub fn job_log(
  db : sql_db::Db,
  client : builders_core::ShellClient,
  args : base_codec::Json,
) -> Result[base_codec::Json, readops_core::ReadError] {
  let j = match job_row(db, readops_core::json_val_or_null(args, "id")) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let wanted = match parse_usize(readops_core::json_val(args, "lines")) {
    Ok(Some(w)) => w
    Ok(None) => 200.0
    Err(e) => return Err(e)
  }
  let n = if wanted < 1.0 { 1 } else if wanted > 1000.0 { 1000 } else { wanted.to_int() }
  let log = readops_core::field(j, "log")
  let text = match log {
    base_codec::Json::Str(p) => {
      match client.shell_sync_json(
        "fs.tail",
        base_codec::json_obj([
          ("path", base_codec::json_str(p)),
          ("bytes", base_codec::json_num(LOG_BYTES.to_double())),
        ]),
      ) {
        Ok(base_codec::Json::Str(t)) => {
          let all = rust_lines(t)
          let from = if all.length() > n { all.length() - n } else { 0 }
          let slice : Array[String] = []
          for i in from..<all.length() {
            slice.push(all[i])
          }
          readops_core::join_strings(slice, "\n")
        }
        _ => ""
      }
    }
    _ => ""
  }
  Ok(
    base_codec::json_obj([
      ("text", base_codec::json_str(text)),
      ("outputAt", output_at(client, log)),
      ("follows", base_codec::json_bool(true)),
      ("state", readops_core::field(j, "state")),
    ]),
  )
}
