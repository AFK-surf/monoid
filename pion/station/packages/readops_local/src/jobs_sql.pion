// 1:1 port of `station/mb/src/readops/jobs_sql.mbt`.
// SQL statements used by open jobs reads (consumed by L2 `readops_views`).

/// read/store.ts HAS_NAMING_ORIGIN.
pub let HAS_NAMING_ORIGIN_SQL : String = "SELECT 1 FROM thread_sessions origin\n" +
"  CROSS JOIN threads t ON t.id = origin.thread\n" +
"  WHERE origin.session = ?1 AND t.surface IS NOT ?2 AND EXISTS (\n" +
"    SELECT 1 FROM thread_sessions member\n" +
"    CROSS JOIN sessions live ON live.key = member.session\n" +
"    WHERE member.thread = t.id\n" +
"  ) LIMIT 1"

/// read/store.ts HAS_NAMING_ORIGIN_PREPARED.
pub let HAS_NAMING_ORIGIN_PREPARED_SQL : String = "SELECT 1 FROM cc_session_rows INDEXED BY cc_session_order\n" +
"  WHERE session = ?1 AND surface != 'chat' LIMIT 1"

/// read/store.ts HAS_NAMING_ORIGIN_POSSIBLE.
pub let HAS_NAMING_ORIGIN_POSSIBLE_SQL : String = "SELECT 1 FROM cc_sessions c CROSS JOIN sessions live ON live.key = c.session\n" +
"      WHERE c.session = ?1 AND c.complete = 1 AND EXISTS (\n" +
"        SELECT 1 FROM thread_sessions INDEXED BY thread_sessions_session WHERE session = c.session LIMIT 1 OFFSET 8\n" +
"      )"

/// read/store.ts LATEST_NAMING_ORIGIN.
pub let LATEST_NAMING_ORIGIN_SQL : String = "SELECT (SELECT t.id FROM thread_sessions m\n" +
"  CROSS JOIN threads t ON t.id = m.thread\n" +
"  LEFT JOIN thread_state st ON st.thread = t.id\n" +
"  LEFT JOIN entries e ON e.thread = t.id AND e.n = st.said_n AND e.kind = 'message'\n" +
"  WHERE m.session = requested.value AND t.surface IS NOT ?2 AND EXISTS (\n" +
"    SELECT 1 FROM thread_sessions member CROSS JOIN sessions live ON live.key = member.session\n" +
"    WHERE member.thread = t.id\n" +
"  ) ORDER BY COALESCE(e.at, 0) DESC, t.created_at DESC, t.id DESC LIMIT 1) AS id\n" +
"  FROM json_each(?1) requested"

/// read/store.ts LATEST_NAMING_ORIGIN_POSSIBLE.
pub let LATEST_NAMING_ORIGIN_POSSIBLE_SQL : String = "SELECT requested.key AS ordinal FROM json_each(?1) requested\n" +
"  CROSS JOIN cc_sessions c ON c.session=requested.value CROSS JOIN sessions live ON live.key=c.session\n" +
"  WHERE c.complete=1 AND EXISTS (SELECT 1 FROM thread_sessions INDEXED BY thread_sessions_session\n" +
"    WHERE session=c.session LIMIT 1 OFFSET 8)"

/// read/store.ts LATEST_NAMING_ORIGIN_PREPARED.
pub let LATEST_NAMING_ORIGIN_PREPARED_SQL : String = "WITH candidates AS MATERIALIZED (\n" +
"    SELECT thread FROM cc_session_rows INDEXED BY cc_session_order\n" +
"    WHERE session=?1 AND surface != 'chat' LIMIT 9\n" +
"  ) SELECT (SELECT COUNT(*) FROM candidates) AS count,\n" +
"    CASE WHEN (SELECT COUNT(*) FROM candidates)<9 THEN (SELECT t.id FROM candidates r\n" +
"      CROSS JOIN threads t ON t.id=r.thread LEFT JOIN thread_state st ON st.thread=t.id\n" +
"      LEFT JOIN entries e ON e.thread=t.id AND e.n=st.said_n AND e.kind='message'\n" +
"      ORDER BY COALESCE(e.at,0) DESC,t.created_at DESC,t.id DESC LIMIT 1) END AS id"

/// station/test/reference/backfill/job-name-first.ts JOB_NAME_FIRST_LARGE.
pub let JOB_NAME_FIRST_LARGE_SQL : String = "SELECT 1 FROM thread_sessions WHERE thread=? LIMIT 1 OFFSET 64"

/// station/test/reference/backfill/job-name-first.ts JOB_NAME_FIRST_ROW.
pub let JOB_NAME_FIRST_ROW_SQL : String = "SELECT m.* FROM thread_sessions m WHERE m.rowid=(SELECT best FROM job_name_first\n" +
"  WHERE owner=?1 AND thread=?2 AND ready=1 AND restart=0)"

/// station/test/reference/backfill/workspace-up-jobs.ts WORKSPACE_UP_JOBS.
pub let WORKSPACE_UP_JOBS_SQL : String = "WITH wanted AS (\n" +
"  SELECT session FROM workspace_up_sessions INDEXED BY workspace_up_sessions_scope WHERE scope=0 AND ws=?1\n" +
"  UNION ALL SELECT session FROM workspace_up_sessions INDEXED BY workspace_up_sessions_scope WHERE scope=1 AND ws='' AND ?2\n" +
"    AND session<'remote:'\n" +
"  UNION ALL SELECT session FROM workspace_up_sessions INDEXED BY workspace_up_sessions_scope WHERE scope=1 AND ws='' AND ?2\n" +
"    AND session>='remote;'\n" +
"  UNION ALL SELECT session FROM workspace_up_sessions INDEXED BY workspace_up_sessions_scope WHERE scope=1 AND ws='' AND ?2\n" +
"    AND session>='remote:' AND session<'remote;' AND NOT (instr(substr(session,8),':')>1 AND instr(substr(substr(session,8),1,instr(substr(session,8),':')-1),'/')=0\n" +
"    AND (instr(substr(substr(session,8),instr(substr(session,8),':')+1),':')>1 AND instr(substr(substr(substr(session,8),instr(substr(session,8),':')+1),1,instr(substr(substr(session,8),instr(substr(session,8),':')+1),':')-1),'/')=0\n" +
"    AND length(substr(substr(session,8),instr(substr(session,8),':')+1))>instr(substr(substr(session,8),instr(substr(session,8),':')+1),':')))\n" +
"  UNION ALL SELECT session FROM workspace_up_sessions INDEXED BY workspace_up_sessions_scope WHERE scope=1 AND ws=''\n" +
"    AND session>='remote:'||?1||':' AND session<'remote:'||?1||';' AND ?1<>'' AND instr(?1,':')=0 AND instr(?1,'/')=0\n" +
"    AND (instr(substr(session,length(?1)+9),':')>1 AND instr(substr(substr(session,length(?1)+9),1,instr(substr(session,length(?1)+9),':')-1),'/')=0\n" +
"    AND length(substr(session,length(?1)+9))>instr(substr(session,length(?1)+9),':'))\n" +
"  UNION ALL SELECT session FROM workspace_up_sessions INDEXED BY workspace_up_sessions_scope WHERE scope=2 AND ws=''\n" +
") SELECT j.* FROM wanted w CROSS JOIN session_up_job_rows u ON u.session=w.session\n" +
"  CROSS JOIN jobs j ON j.rowid=u.job_rowid\n" +
"  ORDER BY j.started_at DESC, (j.state <> 'running'), j.port, j.rowid"

/// read/store.ts JOBS_UP_IN_WORKSPACE.
pub let JOBS_UP_IN_WORKSPACE_SQL : String = "SELECT j.* FROM jobs j LEFT JOIN sessions s ON s.key = j.session_key\n" +
"  WHERE j.state = 'running' AND (s.ws = ?1 OR (s.ws IS NULL AND CASE WHEN s.key IS NULL AND substr(j.session_key,1,7) = 'remote:'\n" +
"    AND (instr(substr(j.session_key,8),':')>1 AND instr(substr(substr(j.session_key,8),1,instr(substr(j.session_key,8),':')-1),'/')=0\n" +
"    AND (instr(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1),':')>1 AND instr(substr(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1),1,instr(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1),':')-1),'/')=0\n" +
"    AND length(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1))>instr(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1),':'))) THEN substr(j.session_key,8,instr(substr(j.session_key,8),':')-1) = ?1 ELSE ?2 END)\n" +
"  OR typeof(j.session_key) <> 'text' OR instr(CAST(j.session_key AS BLOB), x'00') > 0\n" +
"  OR j.session_key GLOB '*[^ -~]*'\n" +
"  OR (s.ws IS NOT NULL AND (typeof(s.ws) <> 'text' OR instr(CAST(s.ws AS BLOB), x'00') > 0\n" +
"    OR s.ws GLOB '*[^ -~]*')))\n" +
"  UNION ALL\n" +
"  SELECT j.* FROM jobs j LEFT JOIN sessions s ON s.key = j.session_key\n" +
"  WHERE j.state = 'exited' AND j.port IS NOT NULL AND (s.ws = ?1 OR (s.ws IS NULL AND CASE WHEN s.key IS NULL AND substr(j.session_key,1,7) = 'remote:'\n" +
"    AND (instr(substr(j.session_key,8),':')>1 AND instr(substr(substr(j.session_key,8),1,instr(substr(j.session_key,8),':')-1),'/')=0\n" +
"    AND (instr(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1),':')>1 AND instr(substr(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1),1,instr(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1),':')-1),'/')=0\n" +
"    AND length(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1))>instr(substr(substr(j.session_key,8),instr(substr(j.session_key,8),':')+1),':'))) THEN substr(j.session_key,8,instr(substr(j.session_key,8),':')-1) = ?1 ELSE ?2 END)\n" +
"  OR typeof(j.session_key) <> 'text' OR instr(CAST(j.session_key AS BLOB), x'00') > 0\n" +
"  OR j.session_key GLOB '*[^ -~]*'\n" +
"  OR (s.ws IS NOT NULL AND (typeof(s.ws) <> 'text' OR instr(CAST(s.ws AS BLOB), x'00') > 0\n" +
"    OR s.ws GLOB '*[^ -~]*')))\n" +
"  ORDER BY started_at DESC"

/// store/rows.ts JOBS_UP.
pub let JOBS_UP_SQL : String = "SELECT * FROM (SELECT * FROM jobs WHERE state = 'running' UNION ALL SELECT * FROM jobs WHERE state = 'exited' AND port IS NOT NULL) ORDER BY started_at DESC"

/// store/cc-thread-index.ts CC_INDEX_VERSION.
pub let CC_INDEX_VERSION : Double = 1.0

pub let JOB_NAME_FIRST_PENDING : String = "job name first member pending: "
