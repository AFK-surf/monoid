// Linked-binary real-SQLite + real-shell self-test for `readops_local` (all 8 modules).
// Invoked by `stillfail-pion --smoke-readops <temp-dir>` in `build-linux` CI.

import "base_codec"
import "builders_core"
import "host_shim"
import "locate"
import "readops_core"
import "sql_db"

fn opt_json_str_eq(v : Option[base_codec::Json], expected : String) -> Bool {
  match v {
    Some(base_codec::Json::Str(s)) => s == expected
    _ => false
  }
}

fn opt_json_num_eq(v : Option[base_codec::Json], expected : Double) -> Bool {
  match v {
    Some(base_codec::Json::Num(n, _)) => n == expected
    _ => false
  }
}

fn opt_json_null(v : Option[base_codec::Json]) -> Bool {
  match v {
    Some(base_codec::Json::Null) => true
    _ => false
  }
}

fn timeline_entries_match(res : base_codec::Json, expected : Array[String]) -> Bool {
  match builders_core::json_get_last(res, "entries") {
    Some(base_codec::Json::Arr(es)) => {
      if es.length() != expected.length() {
        return false
      }
      for i in 0..<expected.length() {
        if !opt_json_str_eq(builders_core::json_get_last(es[i], "text"), expected[i]) {
          return false
        }
      }
      true
    }
    _ => false
  }
}

fn mkdir_sync(client : builders_core::ShellClient, path : String) -> Result[Unit, String] {
  match client.shell_sync_json("fs.mkdir", base_codec::json_obj([("path", base_codec::json_str(path))])) {
    Ok(_) => Ok(())
    Err(e) => Err("fs.mkdir " + path + " failed: " + e.message)
  }
}

fn write_sync(client : builders_core::ShellClient, path : String, text : String) -> Result[Unit, String] {
  match client.shell_sync_json(
    "fs.write",
    base_codec::json_obj([("path", base_codec::json_str(path)), ("text", base_codec::json_str(text))]),
  ) {
    Ok(_) => Ok(())
    Err(e) => Err("fs.write " + path + " failed: " + e.message)
  }
}

fn write_zst_sync(client : builders_core::ShellClient, path : String, text : String) -> Result[Unit, String] {
  match client.shell_sync_json(
    "fs.write",
    base_codec::json_obj([
      ("path", base_codec::json_str(path)),
      ("text", base_codec::json_str(text)),
      ("zstd", base_codec::json_bool(true)),
    ]),
  ) {
    Ok(_) => Ok(())
    Err(e) => Err("fs.write(zstd) " + path + " failed: " + e.message)
  }
}

pub fn run_selftest(temp_dir : String) -> Result[Int, String] {
  let started_shell = if !host_shim::shell_active() {
    if !host_shim::start(temp_dir, false) {
      return Err("host_shim::start failed")
    }
    true
  } else {
    false
  }
  let res = run_selftest_inner(temp_dir)
  if started_shell {
    host_shim::stop()
  }
  res
}

fn run_selftest_inner(temp_dir : String) -> Result[Int, String] {
  let root = temp_dir + "/w7c_readops_local"
  let client = builders_core::ShellClient::new()
  let state = readops_core::ReaderState::new(client, "/")
  match mkdir_sync(client, root) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let db_path = root + "/readops_local_selftest.db"
  let db = match sql_db::Db::create(db_path) {
    Ok(d) => d
    Err(e) => return Err("open selftest db failed: " + e.message)
  }
  let mut passed = 0

  let schema_sql = "CREATE TABLE sessions(key TEXT PRIMARY KEY, conv TEXT, ws TEXT, title TEXT, runtime TEXT, model TEXT, effort TEXT, running INTEGER DEFAULT 0, created_by TEXT, archived_at INTEGER, last_active_at INTEGER, workspace TEXT, cwd TEXT, connect TEXT, runtime_session_id TEXT, original_runtime TEXT, profile TEXT);" +
  "CREATE TABLE runtime_sessions(session_key TEXT, id TEXT, runtime TEXT, profile TEXT, at INTEGER);" +
  "CREATE TABLE threads(id INTEGER PRIMARY KEY, surface TEXT, channel TEXT, thread_ts TEXT, title TEXT, auto_title TEXT, created_by TEXT, created_at INTEGER, home TEXT, hidden_at INTEGER, hidden_by TEXT, shown_at INTEGER, links TEXT);" +
  "CREATE TABLE thread_sessions(thread INTEGER, session TEXT, connect TEXT, joined_at INTEGER, left_at INTEGER);" +
  "CREATE INDEX thread_sessions_session ON thread_sessions(session);" +
  "CREATE TABLE thread_state(thread INTEGER PRIMARY KEY, said_n INTEGER, person_n INTEGER, last_n INTEGER);" +
  "CREATE TABLE entries(thread INTEGER, n INTEGER, kind TEXT, author_kind TEXT, author TEXT, ts TEXT, at INTEGER, text TEXT);" +
  "CREATE TABLE deliveries(thread INTEGER, n INTEGER, session TEXT, delivered_at INTEGER);" +
  "CREATE TABLE jobs(id TEXT PRIMARY KEY, session_key TEXT, name TEXT, command TEXT, cwd TEXT, port INTEGER, state TEXT, pgid INTEGER, exit_code INTEGER, started_at INTEGER, ended_at INTEGER, restarts INTEGER, log TEXT, watch INTEGER, queued INTEGER);" +
  "CREATE TABLE job_notices(job_id TEXT, at INTEGER, text TEXT);" +
  "CREATE TABLE cc_sessions(session TEXT PRIMARY KEY, complete INTEGER);" +
  "CREATE TABLE cc_session_rows(session TEXT, surface TEXT, thread INTEGER);" +
  "CREATE INDEX cc_session_order ON cc_session_rows(session, surface);" +
  "CREATE TABLE job_name_first(owner TEXT, thread INTEGER, best INTEGER, ready INTEGER, restart INTEGER);" +
  "CREATE TABLE workspace_up_sessions(scope INTEGER, ws TEXT, session TEXT);" +
  "CREATE INDEX workspace_up_sessions_scope ON workspace_up_sessions(scope, ws, session);" +
  "CREATE TABLE session_up_job_rows(session TEXT, job_rowid INTEGER);" +
  "CREATE TABLE turns(id TEXT, session_key TEXT, kind TEXT, started_at INTEGER, profile TEXT, person TEXT, thread INTEGER);" +
  "CREATE TABLE usage(id TEXT, at INTEGER, session TEXT, turn TEXT, thread INTEGER, person TEXT, profile TEXT, runtime TEXT, model TEXT, subagent INTEGER, fast INTEGER, input INTEGER, cache_read INTEGER, cache_write INTEGER, cache_write_long INTEGER, output INTEGER, calls INTEGER, context INTEGER, context_window INTEGER, rollup_counted INTEGER DEFAULT 1);" +
  "CREATE INDEX usage_session ON usage(session, at);" +
  "CREATE TABLE usage_15m(scope TEXT, quarter INTEGER, session TEXT, thread INTEGER, person TEXT, profile TEXT, runtime TEXT, model TEXT, fast INTEGER, calls INTEGER, input INTEGER, cache_read INTEGER, cache_write INTEGER, cache_write_long INTEGER, output INTEGER);" +
  "CREATE INDEX usage_15m_quarter ON usage_15m(quarter, scope);"

  match db.exec(schema_sql) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("schema setup failed: " + e.message)
    }
  }

  // ── 1. jobs (`job`, `shown`, `job_log`, `fs.meta`, `NOTICES_SHOWN=20` DESC + rowid DESC, `parse_usize`) ──
  let log_path = root + "/job1.log"
  match write_sync(client, log_path, "line1\r\nline2\r\nline3\n") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match db.run(
    "INSERT INTO sessions(key, ws, runtime, created_by, profile, last_active_at, workspace, cwd, runtime_session_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
    [
      base_codec::json_str("s1"),
      base_codec::json_str("ws1"),
      base_codec::json_str("claude"),
      base_codec::json_str("alice@example.com"),
      base_codec::json_str("p1"),
      base_codec::json_int(5000),
      base_codec::json_str("/tmp/w"),
      base_codec::json_str("/tmp/w"),
      base_codec::json_str("claude-rt-1"),
    ],
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("seed session s1 failed: " + e.message)
    }
  }
  match db.run(
    "INSERT INTO jobs(id, session_key, name, command, cwd, port, state, pgid, exit_code, started_at, ended_at, restarts, log, watch, queued) VALUES (?, ?, ?, ?, ?, ?, ?, ?, NULL, ?, NULL, ?, ?, ?, ?)",
    [
      base_codec::json_str("j1"),
      base_codec::json_str("s1"),
      base_codec::json_str("build"),
      base_codec::json_str("echo hi"),
      base_codec::json_str("/tmp/w"),
      base_codec::json_int(8080),
      base_codec::json_str("running"),
      base_codec::json_int(123),
      base_codec::json_int(1000),
      base_codec::json_int(0),
      base_codec::json_str(log_path),
      base_codec::json_int(1),
      base_codec::json_int(1),
    ],
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("seed job j1 failed: " + e.message)
    }
  }
  // Insert 24 notices with ascending timestamps + 1 tie at 1023 to verify `ORDER BY at DESC, rowid DESC LIMIT 20`
  for i in 0..<24 {
    let at = 1000 + i
    match db.run(
      "INSERT INTO job_notices(job_id, at, text) VALUES (?, ?, ?)",
      [base_codec::json_str("j1"), base_codec::json_int(at), base_codec::json_str("n" + i.to_string())],
    ) {
      Ok(_) => ()
      Err(e) => {
        db.close()
        return Err("seed job_notices failed: " + e.message)
      }
    }
  }
  match db.run(
    "INSERT INTO job_notices(job_id, at, text) VALUES (?, ?, ?)",
    [base_codec::json_str("j1"), base_codec::json_int(1023), base_codec::json_str("n24-tie")],
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("seed job_notices tie failed: " + e.message)
    }
  }
  match job(db, client, base_codec::json_obj([("id", base_codec::json_str("j1"))])) {
    Ok(res) => {
      match builders_core::json_get_last(res, "notices") {
        Some(base_codec::Json::Arr(ns)) => {
          if ns.length() != 20 {
            db.close()
            return Err("job notices expected 20, got " + ns.length().to_string())
          }
          if !opt_json_str_eq(builders_core::json_get_last(ns[0], "text"), "n24-tie") ||
          !opt_json_str_eq(builders_core::json_get_last(ns[1], "text"), "n23") ||
          !opt_json_str_eq(builders_core::json_get_last(ns[19], "text"), "n5") {
            db.close()
            return Err("job notices ordering mismatch: " + sql_db::stringify_json(base_codec::json_arr(ns)))
          }
        }
        _ => {
          db.close()
          return Err("job missing notices array")
        }
      }
      match builders_core::json_get_last(res, "queued") {
        Some(base_codec::Json::Bool(true)) => ()
        _ => {
          db.close()
          return Err("job expected queued=true")
        }
      }
      match builders_core::json_get_last(res, "outputAt") {
        Some(base_codec::Json::Num(ms, _)) => {
          if ms <= 0.0 {
            db.close()
            return Err("job outputAt expected > 0")
          }
        }
        _ => {
          db.close()
          return Err("job expected numeric outputAt from fs.meta")
        }
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("job(j1) failed: " + readops_core::read_error_message(e))
    }
  }
  match job(db, client, base_codec::json_obj([("id", base_codec::json_str("missing"))])) {
    Err(readops_core::ReadError::Refused(404, _)) => passed = passed + 1
    _ => {
      db.close()
      return Err("job(missing) expected 404")
    }
  }
  match job_log(
    db,
    client,
    base_codec::json_obj([("id", base_codec::json_str("j1")), ("lines", base_codec::json_str("2"))]),
  ) {
    Ok(res) => {
      match builders_core::json_get_last(res, "text") {
        Some(base_codec::Json::Str("line2\nline3")) => passed = passed + 1
        other => {
          db.close()
          return Err("job_log text mismatch: " + sql_db::stringify_json(readops_core::or_null(other)))
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("job_log failed: " + readops_core::read_error_message(e))
    }
  }
  match job_log(
    db,
    client,
    base_codec::json_obj([("id", base_codec::json_str("j1")), ("lines", base_codec::json_num(5.0))]),
  ) {
    Err(readops_core::ReadError::Refused(500, msg)) => {
      if msg != "text.replace is not a function" {
        db.close()
        return Err("job_log numeric lines wrong error: " + msg)
      }
      passed = passed + 1
    }
    _ => {
      db.close()
      return Err("job_log numeric lines expected Refused(500)")
    }
  }

  // ── 2. jobs_sql (real SQLite execution of SQL constants) ──
  match db.exec(
    "INSERT INTO threads(id, surface, created_at) VALUES (10, 'slack', 100);" +
    "INSERT INTO thread_sessions(thread, session, joined_at) VALUES (10, 's1', 100);" +
    "INSERT INTO workspace_up_sessions(scope, ws, session) VALUES (0, 'ws1', 's1');" +
    "INSERT INTO session_up_job_rows(session, job_rowid) SELECT 's1', rowid FROM jobs WHERE id='j1';",
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("seed jobs_sql failed: " + e.message)
    }
  }
  match db.all(JOBS_UP_SQL, []) {
    Ok(rs) => {
      if rs.length() != 1 {
        db.close()
        return Err("JOBS_UP_SQL expected 1 row")
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("JOBS_UP_SQL failed: " + e.message)
    }
  }
  match db.all(WORKSPACE_UP_JOBS_SQL, [base_codec::json_str("ws1"), base_codec::json_int(1)]) {
    Ok(rs) => {
      if rs.length() != 1 {
        db.close()
        return Err("WORKSPACE_UP_JOBS_SQL expected 1 row")
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("WORKSPACE_UP_JOBS_SQL failed: " + e.message)
    }
  }
  match db.all(HAS_NAMING_ORIGIN_SQL, [base_codec::json_str("s1"), base_codec::json_str("chat")]) {
    Ok(rs) => {
      if rs.length() != 1 {
        db.close()
        return Err("HAS_NAMING_ORIGIN_SQL expected 1 row")
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("HAS_NAMING_ORIGIN_SQL failed: " + e.message)
    }
  }

  // ── 3. machine (`machine_sessions`, `machine_session`, dedupe, \n\n merge, 404s, lone-surrogate non-collision) ──
  let mroot = root + "/machine"
  let claude_root = mroot + "/claude"
  let claude_proj = claude_root + "/proj1"
  let codex_root = mroot + "/codex/sessions"
  match mkdir_sync(client, claude_proj) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match mkdir_sync(client, codex_root) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  let claude_file = claude_proj + "/claude-rt-1.jsonl"
  let claude_jsonl = "{\"type\":\"user\",\"cwd\":\"/tmp/w\",\"timestamp\":\"2026-11-25T01:00:00.000Z\",\"message\":{\"content\":\"Hello Claude\"}}\n" +
  "{\"type\":\"assistant\",\"timestamp\":\"2026-11-25T01:00:05.000Z\",\"message\":{\"model\":\"claude-opus-5-5\",\"content\":[{\"type\":\"text\",\"text\":\"Part one\"}]}}\n" +
  "{\"type\":\"assistant\",\"timestamp\":\"2026-11-25T01:00:06.000Z\",\"message\":{\"model\":\"claude-opus-5-5\",\"content\":[{\"type\":\"text\",\"text\":\"Part two\"}]}}\n" +
  "{\"type\":\"custom-title\",\"customTitle\":\"My Claude Chat\"}\n"
  match write_sync(client, claude_file, claude_jsonl) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  let codex_file = codex_root + "/rollout-2026-11-25-codex-rt-1.jsonl"
  let codex_jsonl = "{\"type\":\"session_meta\",\"payload\":{\"id\":\"codex-rt-1\",\"cwd\":\"/tmp/codex\"}}\n" +
  "{\"type\":\"event_msg\",\"timestamp\":\"2026-11-25T02:00:00.000Z\",\"payload\":{\"type\":\"user_message\",\"message\":\"Fix bug\"}}\n" +
  "{\"type\":\"event_msg\",\"timestamp\":\"2026-11-25T02:00:01.000Z\",\"payload\":{\"type\":\"agent_message\",\"message\":\"Step 1\"}}\n" +
  "{\"type\":\"event_msg\",\"timestamp\":\"2026-11-25T02:00:02.000Z\",\"payload\":{\"type\":\"agent_message\",\"message\":\"Step 2\"}}\n" +
  "{\"type\":\"turn_context\",\"payload\":{\"model\":\"gpt-6.1-sol\"}}\n"
  match write_sync(client, codex_file, codex_jsonl) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  // Duplicate rollout file with the same codex-rt-1 id (must be deduplicated)
  let codex_dup = codex_root + "/rollout-2026-11-24-codex-rt-1_dup.jsonl"
  match write_sync(client, codex_dup, codex_jsonl) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  // Lone-surrogate regression: transcript id is U+FFFD, session_index.jsonl only names \ud800 -> title must stay null
  let codex_fffd = codex_root + "/rollout-2026-11-25-fffd.jsonl"
  let codex_fffd_jsonl = "{\"type\":\"session_meta\",\"payload\":{\"id\":\"\\ufffd\",\"cwd\":\"/tmp/fffd\"}}\n" +
  "{\"type\":\"event_msg\",\"timestamp\":\"2026-11-25T02:10:00.000Z\",\"payload\":{\"type\":\"user_message\",\"message\":\"Check surrogate\"}}\n"
  match write_sync(client, codex_fffd, codex_fffd_jsonl) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(
    client,
    mroot + "/codex/session_index.jsonl",
    "{\"id\":\"codex-rt-1\",\"thread_name\":\"Codex Named\"}\n{\"id\":\"\\ud800\",\"thread_name\":\"Wrong Surrogate Name\"}\n",
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  let roots_json = base_codec::json_obj([
    ("claude", base_codec::json_str(claude_root)),
    ("codex", base_codec::json_str(codex_root)),
  ])
  match machine_sessions(db, client, "/", base_codec::json_obj([("roots", roots_json)])) {
    Ok(res) => {
      match builders_core::json_get_last(res, "sessions") {
        Some(base_codec::Json::Arr(ss)) => {
          // claude-rt-1, codex-rt-1 (deduped from 2 files), and U+FFFD session => 3 sessions
          if ss.length() != 3 {
            db.close()
            return Err("machine_sessions expected 3 deduped sessions, got " + ss.length().to_string())
          }
          // Verify newest-first descending updatedAt order
          let mut prev_u = 1.0e30
          let mut saw_claude = false
          let mut saw_codex = false
          let mut saw_fffd_null_title = false
          for i in 0..<ss.length() {
            let s = ss[i]
            match builders_core::json_get_last(s, "updatedAt") {
              Some(base_codec::Json::Num(u, _)) => {
                if u > prev_u {
                  db.close()
                  return Err("machine_sessions not sorted newest-first")
                }
                prev_u = u
              }
              _ => ()
            }
            match builders_core::json_get_last(s, "id") {
              Some(base_codec::Json::Str("claude-rt-1")) => {
                if opt_json_str_eq(builders_core::json_get_last(s, "session"), "s1") &&
                opt_json_str_eq(builders_core::json_get_last(s, "title"), "My Claude Chat") {
                  saw_claude = true
                }
              }
              Some(base_codec::Json::Str("codex-rt-1")) => {
                if opt_json_str_eq(builders_core::json_get_last(s, "title"), "Codex Named") {
                  saw_codex = true
                }
              }
              Some(base_codec::Json::Str("\u{FFFD}")) => {
                if opt_json_null(builders_core::json_get_last(s, "title")) {
                  saw_fffd_null_title = true
                }
              }
              _ => ()
            }
          }
          if !saw_claude || !saw_codex || !saw_fffd_null_title {
            db.close()
            return Err("machine_sessions metadata/surrogate mismatch: " + sql_db::stringify_json(res))
          }
          passed = passed + 1
        }
        _ => {
          db.close()
          return Err("machine_sessions missing sessions array")
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("machine_sessions failed: " + readops_core::read_error_message(e))
    }
  }
  // Claude machine_session: 2 consecutive assistant messages merged with \n\n => total=2
  match machine_session(
    db,
    client,
    "/",
    base_codec::json_obj([
      ("roots", roots_json),
      ("runtime", base_codec::json_str("claude")),
      ("id", base_codec::json_str("claude-rt-1")),
    ]),
  ) {
    Ok(res) => {
      if !opt_json_num_eq(builders_core::json_get_last(res, "total"), 2.0) {
        db.close()
        return Err("machine_session claude expected total=2, got " + sql_db::stringify_json(res))
      }
      match builders_core::json_get_last(res, "said") {
        Some(base_codec::Json::Arr(said)) => {
          if said.length() != 2 || !opt_json_str_eq(builders_core::json_get_last(said[1], "text"), "Part one\n\nPart two") {
            db.close()
            return Err("machine_session claude assistant merge mismatch")
          }
        }
        _ => {
          db.close()
          return Err("machine_session claude missing said")
        }
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("machine_session claude failed: " + readops_core::read_error_message(e))
    }
  }
  // Codex machine_session: consecutive agent_message merged with \n\n => total=2 + title "Codex Named"
  match machine_session(
    db,
    client,
    "/",
    base_codec::json_obj([
      ("roots", roots_json),
      ("runtime", base_codec::json_str("codex")),
      ("id", base_codec::json_str("codex-rt-1")),
    ]),
  ) {
    Ok(res) => {
      if !opt_json_num_eq(builders_core::json_get_last(res, "total"), 2.0) {
        db.close()
        return Err("machine_session codex expected total=2")
      }
      match builders_core::json_get_last(res, "said") {
        Some(base_codec::Json::Arr(said)) => {
          if said.length() != 2 || !opt_json_str_eq(builders_core::json_get_last(said[1], "text"), "Step 1\n\nStep 2") {
            db.close()
            return Err("machine_session codex assistant merge mismatch")
          }
        }
        _ => {
          db.close()
          return Err("machine_session codex missing said")
        }
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("machine_session codex failed: " + readops_core::read_error_message(e))
    }
  }
  // machine_session(found=true) returns path
  match machine_session(
    db,
    client,
    "/",
    base_codec::json_obj([
      ("roots", roots_json),
      ("runtime", base_codec::json_str("claude")),
      ("id", base_codec::json_str("claude-rt-1")),
      ("found", base_codec::json_bool(true)),
    ]),
  ) {
    Ok(res) => {
      match builders_core::json_get_last(res, "session") {
        Some(sess) => {
          if !opt_json_str_eq(builders_core::json_get_last(sess, "path"), claude_file) {
            db.close()
            return Err("machine_session(found=true) path mismatch")
          }
          passed = passed + 1
        }
        None => {
          db.close()
          return Err("machine_session(found=true) missing session")
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("machine_session(found=true) failed: " + readops_core::read_error_message(e))
    }
  }
  // machine_session 404s: invalid runtime + missing session (zh & en)
  match machine_session(
    db,
    client,
    "/",
    base_codec::json_obj([
      ("roots", roots_json),
      ("runtime", base_codec::json_str("grok")),
      ("id", base_codec::json_str("x")),
    ]),
  ) {
    Err(readops_core::ReadError::Refused(404, msg)) => {
      if msg != "no runtime grok" {
        db.close()
        return Err("machine_session invalid runtime wrong msg: " + msg)
      }
      passed = passed + 1
    }
    _ => {
      db.close()
      return Err("machine_session invalid runtime expected 404")
    }
  }
  match machine_session(
    db,
    client,
    "/",
    base_codec::json_obj([
      ("roots", roots_json),
      ("runtime", base_codec::json_str("claude")),
      ("id", base_codec::json_str("nope")),
    ]),
  ) {
    Err(readops_core::ReadError::Refused(404, msg)) => {
      if msg != "本机没有这个会话：nope" {
        db.close()
        return Err("machine_session missing zh wrong msg: " + msg)
      }
      passed = passed + 1
    }
    _ => {
      db.close()
      return Err("machine_session missing zh expected 404")
    }
  }

  // ── 4. memory (`memory`, frontmatter, sorting, prev blob, invalid ws 400, lone-surrogate non-collision) ──
  let data_dir = root + "/data"
  match mkdir_sync(client, data_dir + "/mesh") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match mkdir_sync(client, data_dir + "/share/memory/blobs") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match mkdir_sync(client, data_dir + "/agent/skills/demo-proj") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match mkdir_sync(client, data_dir + "/agent/skills/stillfail-jobs") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  let blob_hash = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  match write_sync(client, data_dir + "/config.json", "{\"agentHome\":\"agent\",\"sharedSkills\":{\"demo-proj\":\"sh-surr1\"}}") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(
    client,
    data_dir + "/share/state.json",
    "{\"hosted\":{\"sh-surr1\":{\"missing\":{\"\\ud800\":7},\"told\":{\"\\ufffd\":1}}}}",
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(
    client,
    data_dir + "/mesh/cloud.json",
    "{\"workspace\":\"ws1\",\"station\":\"st-self\",\"name\":\"OfficeHost\",\"peers\":[{\"id\":\"\\ud800\",\"name\":\"Wrong\"},{\"id\":\"\\ufffd\",\"name\":\"Right\"}]}",
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(
    client,
    data_dir + "/share/memory/ws-peer.json",
    "{\"files\":{\"MEMORY.md\":{\"hash\":\"" + blob_hash + "\",\"at\":1700000000001,\"by\":\"\\ufffd\",\"prev\":[]}}}",
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(client, data_dir + "/share/memory/blobs/" + blob_hash, "old memory") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(
    client,
    data_dir + "/share/memory/ws1.json",
    "{\"files\":{\"MEMORY.md\":{\"hash\":\"" +
    blob_hash +
    "\",\"at\":1700000000000,\"by\":\"st-self\",\"prev\":[\"" +
    blob_hash +
    "\"]},\"skills/demo-proj/SKILL.md\":{\"hash\":\"" +
    blob_hash +
    "\",\"at\":1700000000000,\"by\":\"\\ud800\",\"prev\":[]},\"skills/demo-proj/extra.md\":{\"hash\":\"" +
    blob_hash +
    "\",\"at\":1700000000000,\"by\":\"\\ufffd\",\"prev\":[]}}}",
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(client, data_dir + "/agent/MEMORY.md", "# Global Memory\n") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(client, data_dir + "/agent/skills/demo-proj/SKILL.md", "---\nname: demo-proj\ndescription: 项目记忆：演示\n---\nbody\n") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(client, data_dir + "/agent/skills/demo-proj/extra.md", "# Extra\n") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(client, data_dir + "/agent/skills/stillfail-jobs/SKILL.md", "---\nname: stillfail-jobs\ndescription: builtin\n---\n") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match memory(client, data_dir, "/", base_codec::json_obj([])) {
    Ok(res) => {
      match builders_core::json_get_last(res, "global") {
        Some(g) => {
          if !opt_json_str_eq(builders_core::json_get_last(g, "by"), "OfficeHost") ||
          !opt_json_str_eq(builders_core::json_get_last(g, "prev"), "old memory") {
            db.close()
            return Err("memory global mismatch: " + sql_db::stringify_json(g))
          }
        }
        None => {
          db.close()
          return Err("memory missing global")
        }
      }
      match builders_core::json_get_last(res, "skills") {
        Some(base_codec::Json::Arr(ss)) => {
          if ss.length() != 2 ||
          !opt_json_str_eq(builders_core::json_get_last(ss[0], "name"), "demo-proj") ||
          !opt_json_str_eq(builders_core::json_get_last(ss[0], "by"), "Right") {
            db.close()
            return Err("memory skills ordering or newer_rec surrogate tie-break mismatch: " + sql_db::stringify_json(ss[0]))
          }
          // Lone-surrogate non-collision: missing has \ud800:7, told has \ufffd:1 => users:["\uFFFD"], missing:[]
          match builders_core::json_get_last(ss[0], "share") {
            Some(sh) => {
              match (builders_core::json_get_last(sh, "users"), builders_core::json_get_last(sh, "missing")) {
                (Some(base_codec::Json::Arr(users)), Some(base_codec::Json::Arr(miss))) => {
                  if users.length() != 1 || !opt_json_str_eq(Some(users[0]), "\u{FFFD}") || miss.length() != 0 {
                    db.close()
                    return Err("memory lone-surrogate sharing mismatch: " + sql_db::stringify_json(sh))
                  }
                }
                _ => {
                  db.close()
                  return Err("memory share missing users/missing arrays")
                }
              }
            }
            None => {
              db.close()
              return Err("memory demo-proj missing share")
            }
          }
        }
        _ => {
          db.close()
          return Err("memory missing skills")
        }
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("memory() failed: " + readops_core::read_error_message(e))
    }
  }
  match memory(client, data_dir, "/", base_codec::json_obj([("workspace", base_codec::json_str("ws-peer"))])) {
    Ok(res) => {
      match builders_core::json_get_last(res, "global") {
        Some(g) => {
          if !opt_json_str_eq(builders_core::json_get_last(g, "by"), "Right") {
            db.close()
            return Err("memory peer lone-surrogate by mismatch: " + sql_db::stringify_json(g))
          }
          passed = passed + 1
        }
        None => {
          db.close()
          return Err("memory(ws-peer) missing global")
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("memory(ws-peer) failed: " + readops_core::read_error_message(e))
    }
  }
  match memory(client, data_dir, "/", base_codec::json_obj([("workspace", base_codec::json_str("../bad"))])) {
    Err(readops_core::ReadError::Refused(400, _)) => passed = passed + 1
    _ => {
      db.close()
      return Err("memory(bad ws) expected 400")
    }
  }

  // ── 5. models (`ReaderState.model_catalog` update + persistence) ──
  learn_catalog(
    state,
    base_codec::json_obj([
      (
        "neon-test",
        base_codec::json_obj([
          (
            "cost",
            base_codec::json_obj([
              ("input", base_codec::json_num(2.0)),
              ("output", base_codec::json_num(8.0)),
              ("cacheRead", base_codec::json_num(0.5)),
            ]),
          ),
        ]),
      ),
    ]),
  )
  match price(state, "neon-test-medium") {
    Some(p) => {
      if p.input != 2.0 || p.output != 8.0 || p.cache_read != 0.5 {
        db.close()
        return Err("models catalog price mismatch")
      }
      passed = passed + 1
    }
    None => {
      db.close()
      return Err("models catalog lookup failed")
    }
  }

  // ── 6. usage (`big_of` JS double format, `usage_turns`, `usage_calls` SAME+EARLIER 2-page cursor + viewer isolation) ──
  match big_of(Some(base_codec::json_num(0.00001))) {
    Err(readops_core::ReadError::App(msg)) => {
      if msg != "Cannot convert 0.00001 to a BigInt" {
        db.close()
        return Err("big_of(0.00001) wrong message: " + msg)
      }
      passed = passed + 1
    }
    _ => {
      db.close()
      return Err("big_of(0.00001) expected App error")
    }
  }
  match db.exec(
    "INSERT INTO turns(id, session_key, kind, started_at, profile, person, thread) VALUES ('t1', 's1', 'input', 1000, 'p1', 'alice@example.com', 10);" +
    "INSERT INTO usage(id, at, session, turn, thread, person, profile, runtime, model, subagent, fast, input, cache_read, cache_write, cache_write_long, output, calls, context, context_window, rollup_counted) VALUES " +
    "('u1', 1500, 's1', 't1', 10, 'alice@example.com', 'p1', 'claude', 'neon-test', 0, 0, 1000000, 0, 0, 0, 500000, 1, 1000, 200000, 1)," +
    "('u2', 2000, 's1', 't1', 10, 'alice@example.com', 'p1', 'claude', 'neon-test', 0, 1, 500000, 0, 0, 0, 250000, 1, 1500, 200000, 1);",
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("seed usage failed: " + e.message)
    }
  }
  match usage_turns(
    db,
    base_codec::json_obj([
      ("session", base_codec::json_str("s1")),
      ("from", base_codec::json_num(900.0)),
      ("until", base_codec::json_num(3000.0)),
    ]),
  ) {
    Ok(base_codec::Json::Arr(ts)) => {
      if ts.length() != 1 {
        db.close()
        return Err("usage_turns expected 1 turn, got " + ts.length().to_string())
      }
      passed = passed + 1
    }
    _ => {
      db.close()
      return Err("usage_turns failed")
    }
  }
  // Page 1: beforeAt=2000 < to=5000 exercises USAGE_CALLS_SAME_SQL and returns u2 + next cursor
  let page1_next = match usage_calls(
    db,
    base_codec::json_obj([
      ("session", base_codec::json_str("s1")),
      ("from", base_codec::json_str("0")),
      ("to", base_codec::json_str("5000")),
      ("beforeAt", base_codec::json_str("2000")),
      ("beforeSeq", base_codec::json_str("999999")),
      ("limit", base_codec::json_num(1.0)),
    ]),
  ) {
    Ok(res) => {
      match (builders_core::json_get_last(res, "rows"), builders_core::json_get_last(res, "next")) {
        (Some(base_codec::Json::Arr(rows)), Some(base_codec::Json::Obj(nf))) => {
          if rows.length() != 1 || !opt_json_str_eq(builders_core::json_get_last(rows[0], "id"), "u2") {
            db.close()
            return Err("usage_calls page 1 expected u2, got " + sql_db::stringify_json(res))
          }
          passed = passed + 1
          base_codec::Json::Obj(nf)
        }
        _ => {
          db.close()
          return Err("usage_calls page 1 expected rows + next cursor: " + sql_db::stringify_json(res))
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("usage_calls page 1 failed: " + readops_core::read_error_message(e))
    }
  }
  // Page 2: follow next.at/next.seq cursor -> returns u1
  match usage_calls(
    db,
    base_codec::json_obj([
      ("session", base_codec::json_str("s1")),
      ("from", base_codec::json_str("0")),
      ("to", base_codec::json_str("5000")),
      ("beforeAt", readops_core::json_val_or_null(page1_next, "at")),
      ("beforeSeq", readops_core::json_val_or_null(page1_next, "seq")),
      ("limit", base_codec::json_num(10.0)),
    ]),
  ) {
    Ok(res) => {
      match builders_core::json_get_last(res, "rows") {
        Some(base_codec::Json::Arr(rows)) => {
          if rows.length() != 1 ||
          !opt_json_str_eq(builders_core::json_get_last(rows[0], "id"), "u1") ||
          !opt_json_null(builders_core::json_get_last(res, "next")) {
            db.close()
            return Err("usage_calls page 2 expected u1 + null next: " + sql_db::stringify_json(res))
          }
          passed = passed + 1
        }
        _ => {
          db.close()
          return Err("usage_calls page 2 missing rows")
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("usage_calls page 2 failed: " + readops_core::read_error_message(e))
    }
  }
  match usage_calls(
    db,
    base_codec::json_obj([
      ("session", base_codec::json_str("s1")),
      ("from", base_codec::json_str("0")),
      ("to", base_codec::json_str("5000")),
      ("beforeAt", base_codec::json_str("5000")),
      ("beforeSeq", base_codec::json_str("999999")),
      ("limit", base_codec::json_num(10.0)),
      ("viewer", base_codec::json_obj([("workspace", base_codec::json_str("other-ws")), ("home", base_codec::json_bool(false))])),
    ]),
  ) {
    Ok(res) => {
      match builders_core::json_get_last(res, "rows") {
        Some(base_codec::Json::Arr(rows)) => {
          if rows.length() != 0 {
            db.close()
            return Err("usage_calls viewer isolation failed")
          }
          passed = passed + 1
        }
        _ => {
          db.close()
          return Err("usage_calls viewer isolation missing rows")
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("usage_calls viewer failed: " + readops_core::read_error_message(e))
    }
  }

  // ── 7. usagegroups (`table_installed`, `usage_groups` full quarter + unaligned edge + offset=10 straddle, `cost`) ──
  match db.exec(
    "INSERT INTO usage_15m(scope, quarter, session, thread, person, profile, runtime, model, fast, calls, input, cache_read, cache_write, cache_write_long, output) VALUES " +
    "('ws1', 0, 's1', 10, 'alice@example.com', 'p1', 'claude', 'neon-test', 0, 1, 1000000, 0, 0, 0, 500000)," +
    "('ws1', 1, 's1', 10, 'alice@example.com', 'p1', 'claude', 'neon-test', 0, 2, 1000000, 0, 0, 0, 500000);",
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("seed usage_15m failed: " + e.message)
    }
  }
  match table_installed(db, "usage_15m") {
    Ok(true) => passed = passed + 1
    _ => {
      db.close()
      return Err("table_installed(usage_15m) expected true")
    }
  }
  let v_ws1 = viewer_of(
    Some(base_codec::json_obj([("workspace", base_codec::json_str("ws1")), ("home", base_codec::json_bool(true))])),
  )
  match usage_groups(db, 900000.to_int64(), 1800000.to_int64(), 0.to_int64(), v_ws1) {
    Ok(gs) => {
      if gs.length() != 1 || gs[0].calls != 2.0 {
        db.close()
        return Err("usage_groups expected 1 group with calls=2")
      }
      // 1M * $2 + 0.5M * $8 = $6
      match cost(state, gs[0]) {
        base_codec::Json::Num(c, _) => {
          if c != 6.0 {
            db.close()
            return Err("cost(group) expected 6.0, got " + c.to_string())
          }
          passed = passed + 1
        }
        _ => {
          db.close()
          return Err("cost(group) expected numeric dollar value")
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("usage_groups failed: " + readops_core::read_error_message(e))
    }
  }
  // Unaligned `from=1000` (inside quarter 0, reads raw `usage` rows u1 & u2) + quarter 1 + non-15m `offset=10` (straddle SQL active)
  match usage_groups(db, 1000.to_int64(), 1800000.to_int64(), 10.to_int64(), v_ws1) {
    Ok(gs) => {
      // fast=0: raw u1 (calls=1, input=1M) + quarter 1 (calls=2, input=1M) => calls=3, input=2M
      // fast=1: raw u2 (calls=1, input=500k)
      if gs.length() != 2 {
        db.close()
        return Err("usage_groups unaligned+straddle expected 2 groups, got " + gs.length().to_string())
      }
      let mut fast0_calls = 0.0
      let mut fast1_calls = 0.0
      for i in 0..<gs.length() {
        if gs[i].fast {
          fast1_calls = gs[i].calls
        } else {
          fast0_calls = gs[i].calls
        }
      }
      if fast0_calls != 3.0 || fast1_calls != 1.0 {
        db.close()
        return Err("usage_groups unaligned+straddle calls mismatch")
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("usage_groups unaligned+straddle failed: " + readops_core::read_error_message(e))
    }
  }

  // ── 8. timeline (`ReaderState` Finder + TranscriptCache append/truncate + after/before/limit + .zst packedStamp + tail_read) ──
  let tl_ws = root + "/tl_ws"
  let prof_home = data_dir + "/homes/p1"
  let proj_slug = match locate::claude_project(tl_ws) {
    Some(sl) => sl
    None => "-tmp-tl"
  }
  let tl_proj_dir = prof_home + "/projects/" + proj_slug
  match mkdir_sync(client, tl_proj_dir) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match write_sync(client, data_dir + "/config.json", "{\"agentHome\":\"agent\",\"profiles\":[{\"id\":\"p1\",\"home\":\"homes/p1\"}]}") {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  let tl_file = tl_proj_dir + "/tl-rt-1.jsonl"
  let tl_line1 = "{\"type\":\"user\",\"timestamp\":\"2026-11-25T03:00:00.000Z\",\"message\":{\"role\":\"user\",\"content\":\"First prompt\"}}\n"
  let tl_line2 = "{\"type\":\"assistant\",\"timestamp\":\"2026-11-25T03:00:01.000Z\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"First reply\"}]}}\n"
  let tl_line3 = "{\"type\":\"user\",\"timestamp\":\"2026-11-25T03:00:02.000Z\",\"message\":{\"role\":\"user\",\"content\":\"Second prompt\"}}\n"
  match write_sync(client, tl_file, tl_line1 + tl_line2) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match db.run(
    "INSERT INTO sessions(key, ws, runtime, created_by, profile, last_active_at, workspace, cwd, runtime_session_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
    [
      base_codec::json_str("s-tl"),
      base_codec::json_str("ws1"),
      base_codec::json_str("claude"),
      base_codec::json_str("alice@example.com"),
      base_codec::json_str("p1"),
      base_codec::json_int(6000),
      base_codec::json_str(tl_ws),
      base_codec::json_str(tl_ws),
      base_codec::json_str("tl-rt-1"),
    ],
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("seed timeline session failed: " + e.message)
    }
  }
  // 8a. Initial timeline read (2 entries) — verify literal wire key `"end":2` and body text independently
  let tl_ask = base_codec::json_obj([
    (
      "args",
      base_codec::json_obj([
        ("key", base_codec::json_str("s-tl")),
        ("from", base_codec::json_str("0")),
        ("to", base_codec::json_str("10")),
      ]),
    ),
  ])
  match timeline(db, state, data_dir, tl_ask) {
    Ok(res) => {
      let wire = sql_db::stringify_json(res)
      if !opt_json_num_eq(builders_core::json_get_last(res, "start"), 0.0) ||
      !readops_core::str_contains_sub(wire, ",\"end\":2}") ||
      !timeline_entries_match(res, ["First prompt", "First reply"]) {
        db.close()
        return Err("timeline initial mismatch: " + wire)
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("timeline initial failed: " + readops_core::read_error_message(e))
    }
  }
  // 8b. Append 3rd line -> same ReaderState tx_cache picks up end=3 + test `after`, `before`, `limit`
  match write_sync(client, tl_file, tl_line1 + tl_line2 + tl_line3) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match timeline(
    db,
    state,
    data_dir,
    base_codec::json_obj([
      (
        "args",
        base_codec::json_obj([
          ("key", base_codec::json_str("s-tl")),
          ("after", base_codec::json_str("0")),
          ("limit", base_codec::json_str("1")),
        ]),
      ),
    ]),
  ) {
    Ok(res) => {
      let wire = sql_db::stringify_json(res)
      if !opt_json_num_eq(builders_core::json_get_last(res, "start"), 1.0) ||
      !readops_core::str_contains_sub(wire, ",\"end\":3}") ||
      !timeline_entries_match(res, ["First reply"]) {
        db.close()
        return Err("timeline after+limit mismatch: " + wire)
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("timeline after+limit failed: " + readops_core::read_error_message(e))
    }
  }
  match timeline(
    db,
    state,
    data_dir,
    base_codec::json_obj([
      (
        "args",
        base_codec::json_obj([
          ("key", base_codec::json_str("s-tl")),
          ("before", base_codec::json_str("3")),
          ("limit", base_codec::json_str("1")),
        ]),
      ),
    ]),
  ) {
    Ok(res) => {
      let wire = sql_db::stringify_json(res)
      if !opt_json_num_eq(builders_core::json_get_last(res, "start"), 2.0) ||
      !readops_core::str_contains_sub(wire, ",\"end\":3}") ||
      !timeline_entries_match(res, ["Second prompt"]) {
        db.close()
        return Err("timeline before+limit mismatch: " + wire)
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("timeline before+limit failed: " + readops_core::read_error_message(e))
    }
  }
  // 8c. Truncate back to 1 line -> same ReaderState tx_cache handles truncation (end=1)
  match write_sync(client, tl_file, tl_line1) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match timeline(db, state, data_dir, tl_ask) {
    Ok(res) => {
      let wire = sql_db::stringify_json(res)
      if !readops_core::str_contains_sub(wire, ",\"end\":1}") || !timeline_entries_match(res, ["First prompt"]) {
        db.close()
        return Err("timeline after truncate expected end=1 + First prompt, got " + wire)
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("timeline after truncate failed: " + readops_core::read_error_message(e))
    }
  }
  // 8d. transcript_state + tail_read (plain file)
  match transcript_state(db, state, data_dir, base_codec::json_obj([("key", base_codec::json_str("s-tl"))])) {
    Ok(res) => {
      match builders_core::json_get_last(res, "states") {
        Some(base_codec::Json::Arr(sts)) => {
          if sts.length() != 1 {
            db.close()
            return Err("transcript_state expected 1 state")
          }
          match write_sync(client, tl_file, tl_line1 + tl_line2) {
            Ok(_) => ()
            Err(e) => {
              db.close()
              return Err(e)
            }
          }
          match tail_read(
            state,
            base_codec::json_obj([
              ("runtime", base_codec::json_str("claude")),
              ("state", sts[0]),
            ]),
          ) {
            Ok(tres) => {
              if !timeline_entries_match(tres, ["First reply"]) {
                db.close()
                return Err("tail_read expected 1 new entry [First reply], got " + sql_db::stringify_json(tres))
              }
              passed = passed + 1
            }
            Err(e) => {
              db.close()
              return Err("tail_read failed: " + readops_core::read_error_message(e))
            }
          }
        }
        _ => {
          db.close()
          return Err("transcript_state missing states array")
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("transcript_state failed: " + readops_core::read_error_message(e))
    }
  }
  // 8e. .zst-only transcript + packedStamp change on the SAME ReaderState (body + tail_read offset)
  let zst_file = tl_proj_dir + "/tl-zst-1.jsonl.zst"
  match write_zst_sync(client, zst_file, tl_line1) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match db.run(
    "INSERT INTO sessions(key, ws, runtime, created_by, profile, last_active_at, workspace, cwd, runtime_session_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
    [
      base_codec::json_str("s-tl-zst"),
      base_codec::json_str("ws1"),
      base_codec::json_str("claude"),
      base_codec::json_str("alice@example.com"),
      base_codec::json_str("p1"),
      base_codec::json_int(7000),
      base_codec::json_str(tl_ws),
      base_codec::json_str(tl_ws),
      base_codec::json_str("tl-zst-1"),
    ],
  ) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err("seed zst session failed: " + e.message)
    }
  }
  let zst_ask = base_codec::json_obj([
    (
      "args",
      base_codec::json_obj([
        ("key", base_codec::json_str("s-tl-zst")),
        ("from", base_codec::json_str("0")),
        ("to", base_codec::json_str("10")),
      ]),
    ),
  ])
  match timeline(db, state, data_dir, zst_ask) {
    Ok(res) => {
      let wire = sql_db::stringify_json(res)
      if !readops_core::str_contains_sub(wire, ",\"end\":1}") || !timeline_entries_match(res, ["First prompt"]) {
        db.close()
        return Err("timeline zst initial mismatch: " + wire)
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("timeline zst initial failed: " + readops_core::read_error_message(e))
    }
  }
  let zst_st0 = match transcript_state(db, state, data_dir, base_codec::json_obj([("key", base_codec::json_str("s-tl-zst"))])) {
    Ok(res) => {
      match builders_core::json_get_last(res, "states") {
        Some(base_codec::Json::Arr(sts)) => {
          if sts.length() != 1 {
            db.close()
            return Err("transcript_state zst expected 1 state")
          }
          sts[0]
        }
        _ => {
          db.close()
          return Err("transcript_state zst missing states")
        }
      }
    }
    Err(e) => {
      db.close()
      return Err("transcript_state zst failed: " + readops_core::read_error_message(e))
    }
  }
  let off0 = match builders_core::json_get_last(zst_st0, "offset") {
    Some(base_codec::Json::Num(o, _)) => o
    _ => 0.0
  }
  // Overwrite .zst with 2 lines -> packedStamp changes, same ReaderState sees end=2 + tail_read advances offset
  match write_zst_sync(client, zst_file, tl_line1 + tl_line2) {
    Ok(_) => ()
    Err(e) => {
      db.close()
      return Err(e)
    }
  }
  match timeline(db, state, data_dir, zst_ask) {
    Ok(res) => {
      let wire = sql_db::stringify_json(res)
      if !readops_core::str_contains_sub(wire, ",\"end\":2}") ||
      !timeline_entries_match(res, ["First prompt", "First reply"]) {
        db.close()
        return Err("timeline zst after packedStamp change mismatch: " + wire)
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("timeline zst after packedStamp change failed: " + readops_core::read_error_message(e))
    }
  }
  match tail_read(
    state,
    base_codec::json_obj([
      ("runtime", base_codec::json_str("claude")),
      ("state", zst_st0),
    ]),
  ) {
    Ok(tres) => {
      let off1 = match builders_core::json_get_last(tres, "state") {
        Some(st1) => {
          match builders_core::json_get_last(st1, "offset") {
            Some(base_codec::Json::Num(o, _)) => o
            _ => 0.0
          }
        }
        None => 0.0
      }
      if off1 <= off0 || !timeline_entries_match(tres, ["First reply"]) {
        db.close()
        return Err("tail_read zst offset/body mismatch: " + sql_db::stringify_json(tres))
      }
      passed = passed + 1
    }
    Err(e) => {
      db.close()
      return Err("tail_read zst failed: " + readops_core::read_error_message(e))
    }
  }

  db.close()
  Ok(passed)
}
