// Linked-binary real-SQLite + real-shell self-test for `readops_views` (all 7 modules).
// Invoked by `stillfail-pion --smoke-readops <temp-dir>` in `build-linux` CI.
// All SQL fixture paths use `Db::run` parameter binding (safe with quotes like `O'Brien`).

import "base_codec"
import "builders_core"
import "host_shim"
import "readops_core"
import "sql_db"

fn check_autocommit(db : sql_db::Db, label : String) -> Result[Unit, String] {
  if !db.autocommit() {
    return Err(label + ": left transaction open (autocommit=false)")
  }
  Ok(())
}

fn mkdir_sync(client : builders_core::ShellClient, path : String) -> Result[Unit, String] {
  match client.shell_sync_json("fs.mkdir", base_codec::json_obj([("path", base_codec::json_str(path))])) {
    Ok(_) => Ok(())
    Err(e) => Err("fs.mkdir " + path + " failed: " + e.message)
  }
}

fn write_sync(client : builders_core::ShellClient, path : String, text : String) -> Result[Unit, String] {
  match client.shell_sync_json(
    "fs.write",
    base_codec::json_obj([("path", base_codec::json_str(path)), ("text", base_codec::json_str(text))]),
  ) {
    Ok(_) => Ok(())
    Err(e) => Err("fs.write " + path + " failed: " + e.message)
  }
}

fn run_sql(db : sql_db::Db, sql : String, params : Array[base_codec::Json]) -> Result[Unit, String] {
  match db.run(sql, params) {
    Ok(_) => Ok(())
    Err(e) => Err("db.run failed: " + e.message + " | sql=" + sql)
  }
}

fn assert_eq_str(actual : String, expected : String, label : String) -> Result[Unit, String] {
  if actual != expected {
    return Err(label + ": expected `" + expected + "`, got `" + actual + "`")
  }
  Ok(())
}

fn assert_true(cond : Bool, label : String) -> Result[Unit, String] {
  if !cond {
    return Err("assertion failed: " + label)
  }
  Ok(())
}

pub fn run_views_selftest(temp_dir : String) -> Result[Int, String] {
  let started_shell = if !host_shim::shell_active() {
    if !host_shim::start(temp_dir, false) {
      return Err("host_shim::start failed")
    }
    true
  } else {
    false
  }
  let res = run_views_selftest_inner(temp_dir)
  if started_shell {
    host_shim::stop()
  }
  res
}

fn run_views_selftest_inner(temp_dir : String) -> Result[Int, String] {
  let data_dir = temp_dir + "/w7d_O'Brien_data"
  let client = builders_core::ShellClient::new()
  match mkdir_sync(client, data_dir) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let config_json = "{\"automaticDecisions\":{\"completion\":{\"enabled\":true}},\"connects\":[{\"id\":\"slack-1\",\"kind\":\"slack\",\"slack\":{\"botName\":\"BotOne\",\"team\":{\"id\":\"T1\",\"name\":\"Acme Team\"}}}]}"
  match write_sync(client, data_dir + "/config.json", config_json) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let slack_names_json = "{\"c:T1:C1\":{\"channel\":\"general\"},\"c:T1:C2\":{\"channel\":\"alerts\"}}"
  match write_sync(client, data_dir + "/slack-names.json", slack_names_json) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let job_log_path = data_dir + "/job1.log"
  match write_sync(client, job_log_path, "job output line\n") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let db_path = data_dir + "/readops_views_selftest.db"
  let db = match sql_db::Db::create(db_path) {
    Ok(d) => d
    Err(e) => return Err("open selftest db failed: " + e.message)
  }

  let res = run_all_checks(db, client, data_dir, job_log_path)
  db.close()
  res
}

fn run_all_checks(
  db : sql_db::Db,
  client : builders_core::ShellClient,
  data_dir : String,
  job_log_path : String,
) -> Result[Int, String] {
  let mut passed = 0

  let schema_sql = "CREATE TABLE sessions(key TEXT PRIMARY KEY, conv TEXT, ws TEXT, title TEXT, connect TEXT, scope TEXT, created_by TEXT, runtime TEXT, original_runtime TEXT, profile TEXT, profile_pinned INTEGER, profiles TEXT, model TEXT, effort TEXT, fast INTEGER, tui INTEGER, speed TEXT, afresh INTEGER, context INTEGER, context_before INTEGER, compactions INTEGER, runtime_session_id TEXT, workspace TEXT, cwd TEXT, token TEXT, running INTEGER DEFAULT 0, created_at INTEGER, last_active_at INTEGER, archived_at INTEGER, archived_by TEXT, shown_at INTEGER, came_from TEXT);" +
  "CREATE INDEX sessions_live ON sessions(last_active_at DESC) WHERE archived_at IS NULL;" +
  "CREATE INDEX sessions_put_away ON sessions(archived_at DESC, key DESC) WHERE archived_at IS NOT NULL;" +
  "CREATE INDEX sessions_ws ON sessions(ws, key);" +
  "CREATE INDEX sessions_conv_grouped ON sessions(conv, key) WHERE conv IS NOT NULL AND conv != key;" +
  "CREATE TABLE threads(id INTEGER PRIMARY KEY, surface TEXT NOT NULL, channel TEXT, thread_ts TEXT, title TEXT, auto_title TEXT, created_by TEXT, created_at INTEGER, home TEXT, hidden_at INTEGER, hidden_by TEXT, shown_at INTEGER, links TEXT, project TEXT, project_locked INTEGER, tags TEXT);" +
  "CREATE INDEX threads_home ON threads(home);" +
  "CREATE TABLE thread_sessions(thread INTEGER, session TEXT, connect TEXT, joined_at INTEGER);" +
  "CREATE INDEX thread_sessions_session ON thread_sessions(session);" +
  "CREATE TABLE thread_people(thread INTEGER, author TEXT, first_n INTEGER);" +
  "CREATE TABLE entries(thread INTEGER, n INTEGER, kind TEXT, author_kind TEXT, author TEXT, ts TEXT, at INTEGER, text TEXT, attachments TEXT, quotes TEXT, declared TEXT, client TEXT, profile TEXT, runtime TEXT, agent_identity TEXT, letter TEXT, card TEXT, options TEXT, change TEXT, proposal TEXT, target INTEGER, PRIMARY KEY(thread, n));" +
  "CREATE INDEX entries_said ON entries(thread, n) WHERE kind='message' AND letter IS NULL;" +
  "CREATE INDEX entries_cards ON entries(thread, n) WHERE card IS NOT NULL;" +
  "CREATE INDEX entries_options ON entries(thread, n) WHERE options IS NOT NULL;" +
  "CREATE INDEX entries_letters ON entries(thread, n) WHERE letter IS NOT NULL;" +
  "CREATE INDEX entries_people_by_n ON entries(thread, n) WHERE author_kind='person' AND kind='message';" +
  "CREATE INDEX entries_people_since ON entries(thread, at, n) WHERE author_kind='person' AND kind='message';" +
  "CREATE TABLE entry_proposals(thread INTEGER, n INTEGER, proposal TEXT, PRIMARY KEY(thread, n));" +
  "CREATE TABLE proposal_outcomes(thread INTEGER, n INTEGER, status TEXT, project TEXT, resolved_by TEXT, resolved_at INTEGER, PRIMARY KEY(thread, n));" +
  "CREATE TABLE thread_state(thread INTEGER PRIMARY KEY, said_n INTEGER, person_n INTEGER, last_n INTEGER, said_other_n INTEGER, said_other_known INTEGER, letters INTEGER DEFAULT 0);" +
  "CREATE TABLE turns(id INTEGER PRIMARY KEY, session_key TEXT, kind TEXT, outcome TEXT, declared TEXT, need TEXT, about_thread INTEGER, about_n INTEGER, about_ts TEXT, wait_seconds INTEGER, wait_for TEXT, wait_watch INTEGER, detail TEXT, started_at INTEGER, ended_at INTEGER);" +
  "CREATE INDEX turns_by_session ON turns(session_key);" +
  "CREATE INDEX turns_by_end ON turns(session_key, ended_at);" +
  "CREATE TABLE session_turns(session TEXT PRIMARY KEY, n INTEGER);" +
  "CREATE TABLE session_work_from(id INTEGER PRIMARY KEY, at INTEGER);" +
  "CREATE TABLE session_work(session TEXT PRIMARY KEY, ms INTEGER);" +
  "CREATE TABLE session_first(session TEXT PRIMARY KEY, thread INTEGER, n INTEGER);" +
  "CREATE TABLE deliveries(thread INTEGER, n INTEGER, session TEXT, delivered_at INTEGER);" +
  "CREATE INDEX deliveries_pending ON deliveries(session) WHERE delivered_at IS NULL;" +
  "CREATE TABLE letter_deliveries(thread INTEGER, n INTEGER, session TEXT, delivered_at INTEGER);" +
  "CREATE INDEX letter_deliveries_pending ON letter_deliveries(session) WHERE delivered_at IS NULL;" +
  "CREATE TABLE letters(thread INTEGER, n INTEGER, ts TEXT, author_kind TEXT, author TEXT, text TEXT, attachments TEXT, at INTEGER, letter TEXT);" +
  "CREATE TABLE reads(viewer TEXT, thread INTEGER, n INTEGER, PRIMARY KEY(viewer, thread));" +
  "CREATE TABLE dismissed(viewer TEXT, thread INTEGER, n INTEGER);" +
  "CREATE TABLE kept_chats(viewer TEXT, thread INTEGER);" +
  "CREATE TABLE hidden_chats(viewer TEXT, thread INTEGER);" +
  "CREATE TABLE muted_chats(viewer TEXT, thread INTEGER);" +
  "CREATE TABLE pins(viewer TEXT, session TEXT, at INTEGER);" +
  "CREATE TABLE identities(viewer TEXT, slack_user TEXT, at INTEGER);" +
  "CREATE TABLE jobs(id TEXT PRIMARY KEY, session_key TEXT, name TEXT, command TEXT, cwd TEXT, port INTEGER, state TEXT, pgid INTEGER, exit_code INTEGER, started_at INTEGER, ended_at INTEGER, restarts INTEGER DEFAULT 0, log TEXT, watch INTEGER DEFAULT 0, queued INTEGER DEFAULT 0);" +
  "CREATE INDEX jobs_state ON jobs(state, watch);" +
  "CREATE INDEX jobs_by_session ON jobs(session_key);" +
  "CREATE INDEX jobs_up ON jobs(state, session_key);" +
  "CREATE TABLE job_notices(job_id TEXT, at INTEGER, text TEXT);" +
  "CREATE TABLE active_watch_jobs(job TEXT PRIMARY KEY, session TEXT);" +
  "CREATE INDEX active_watch_jobs_session ON active_watch_jobs(session);" +
  "CREATE TABLE workspace_up_meta(id INTEGER PRIMARY KEY, version INTEGER, ready INTEGER);" +
  "CREATE TABLE workspace_up_sessions(scope INTEGER, ws TEXT, session TEXT);" +
  "CREATE INDEX workspace_up_sessions_scope ON workspace_up_sessions(scope, ws, session);" +
  "CREATE TABLE session_up_job_meta(id INTEGER PRIMARY KEY, version INTEGER, fresh INTEGER);" +
  "CREATE TABLE session_up_job_scopes(session TEXT PRIMARY KEY, complete INTEGER);" +
  "CREATE TABLE session_up_job_rows(session TEXT, job_rowid INTEGER);" +
  "CREATE TABLE pending_cards_from(id INTEGER PRIMARY KEY, entry INTEGER);" +
  "CREATE TABLE pending_cards(thread INTEGER PRIMARY KEY, n INTEGER);" +
  "CREATE TABLE card_post_meta(id INTEGER PRIMARY KEY, version INTEGER);" +
  "CREATE TABLE card_post_scopes(thread INTEGER PRIMARY KEY, last_n INTEGER, end_n INTEGER, phase INTEGER);" +
  "CREATE TABLE card_posts(thread INTEGER, n INTEGER, PRIMARY KEY(thread, n));" +
  "CREATE TABLE pending_system_cards(thread INTEGER, n INTEGER, PRIMARY KEY(thread, n));" +
  "CREATE TABLE closed_cards(thread INTEGER, n INTEGER, viewer TEXT, at INTEGER, PRIMARY KEY(thread, n));" +
  "CREATE INDEX closed_cards_thread_at ON closed_cards(thread, at);" +
  "CREATE TABLE session_binding_meta(id INTEGER PRIMARY KEY, version INTEGER, complete INTEGER);" +
  "CREATE TABLE session_binding_rows(session TEXT, connect TEXT, binding_rowid INTEGER);" +
  "CREATE TABLE session_list_meta(id INTEGER PRIMARY KEY, version INTEGER, complete INTEGER);" +
  "CREATE TABLE session_list_rows(kind INTEGER, ws TEXT, archived INTEGER, connect TEXT, session TEXT);" +
  "CREATE INDEX session_list_connect ON session_list_rows(archived, connect);" +
  "CREATE TABLE archive_suggestions(thread INTEGER PRIMARY KEY, version INTEGER);" +
  "CREATE TABLE archive_verdicts(thread INTEGER PRIMARY KEY, version INTEGER, at INTEGER, verdict TEXT);" +
  "CREATE TABLE opened_chats(parent_station TEXT, parent TEXT, child_station TEXT, child TEXT, opener_title TEXT, title TEXT, led INTEGER, state TEXT, created_at INTEGER);" +
