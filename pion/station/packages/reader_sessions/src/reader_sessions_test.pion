// Deterministic tests for the production zero-stub `reader_sessions` assembly.

import "base_codec"
import "effect"
import "sessions_actors"
import "sessions_agents"
import "sessions_core"
import "sessions_jobs_live"
import "sessions_remote"

fn assert(cond : Bool) -> Unit {
  if !cond {
    panic("assertion failed")
  }
}

fn test_store_provider(_gen : sessions_core::HubGen) -> Option[sessions_actors::StoreDb] {
  None
}

fn test_fmt_num(n : Double) -> String {
  let i = n.to_int64()
  if i.to_double() == n {
    i.to_string()
  } else {
    n.to_string()
  }
}

fn new_test_app(host : sessions_core::SessionHost) -> SessionsApp {
  SessionsApp::new_with(host, "/", test_store_provider, test_fmt_num)
}

fn assert_holding_zero(host : sessions_core::SessionHost) -> Unit {
  let (h0, h1, h2, h3, h4, h5) = host.rt.holding()
  assert(h0 == 0 && h1 == 0 && h2 == 0 && h3 == 0 && h4 == 0 && h5 == 0)
}

test "reader_sessions: production assembly has ZERO stubs (has_stubs == false)" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let app = new_test_app(host)
  assert(!app.has_stubs())
  assert(!app.actors.has_stubs())
  assert(!app.dispatch.is_stub)
  app.close()
}

test "reader_sessions: emits ready without active/seen, handles db:null, quiet, and clean EOF 0" {
  let mem = sessions_core::MemHostTransport::new()
  mem.push_stdin("{\"db\":null}\n")
  mem.push_eof()

  let host = sessions_core::SessionHost::for_test(mem)
  let app = new_test_app(host)
  assert(!app.has_stubs())

  let code = sessions_core::run_host_loop(host, fn(_h : sessions_core::SessionHost, k) -> Unit {
    serve_sessions_k(app, k)
  })
  assert(code == 0)
  assert(mem.stderr_lines.length() == 0)
  assert(mem.exit_codes.length() == 1)
  assert(mem.exit_codes[0] == 0)
  assert(mem.stdout_lines.length() == 2)
  assert(mem.stdout_lines[0] == "{\"ready\":true}")
  assert(mem.stdout_lines[1] == "{\"quiet\":true,\"active\":0,\"seen\":1}")
  assert_holding_zero(host)
  assert(app.agents.delta_timer_count() == 0)
}

test "reader_sessions: same-chunk freeze (numeric) + routed (numeric) through real Agents and Actors" {
  let mem = sessions_core::MemHostTransport::new()
  // Real Node payloads: `{"freeze":1}` (mb-agents.ts:297) + `{"routed":2}` (mb-actor.ts:655) in one chunk.
  mem.push_stdin("{\"freeze\":1}\n{\"routed\":2}\n")
  mem.push_round_barrier()
  mem.push_eof()

  let host = sessions_core::SessionHost::for_test(mem)
  let code = run_sessions_with_host_and(host, "/", test_store_provider, test_fmt_num)
  assert(code == 0)
  assert(mem.stderr_lines.length() == 0)
  assert(mem.stdout_lines.length() == 3)
  assert(mem.stdout_lines[0] == "{\"ready\":true}")
  assert(mem.stdout_lines[1] == "{\"frozen\":1,\"states\":{}}")
  assert(mem.stdout_lines[2] == "{\"quiet\":true,\"active\":0,\"seen\":1}")
  assert_holding_zero(host)
}

test "reader_sessions: db rotation rebuilds Jobs/Live/Remote on new HubGen while keeping Agents alive" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let app = new_test_app(host)

  // Seed process-scoped Agents with a Codex replay before `{"db":null}` rotation.
  app.agents.told("{\"codexReplay\":42,\"notices\":[]}")
  assert(app.agents.replay_count() == 1)

  let epoch0 = app.gen().counters.epoch
  assert(app.jobs.gen.counters.epoch == epoch0)
  assert(app.live.gen.counters.epoch == epoch0)
  assert(app.remote.gen.counters.epoch == epoch0)

  // Rotate generation via `{"db":null}`.
  app.heard("{\"db\":null}")
  let epoch1 = app.gen().counters.epoch
  assert(epoch1 == epoch0 + 1)
  assert(app.jobs.gen.counters.epoch == epoch1)
  assert(app.live.gen.counters.epoch == epoch1)
  assert(app.remote.gen.counters.epoch == epoch1)
  assert(!app.jobs.gen.counters.sealed)
  assert(!app.live.gen.counters.sealed)
  assert(!app.remote.gen.counters.sealed)

  // Agents survived rotation with its pending replay intact!
  assert(app.agents.replay_count() == 1)
  app.agents.told("{\"codexReplayed\":42}")
  assert(app.agents.replay_count() == 0)

  app.close()
  host.tick()
  assert_holding_zero(host)
  assert(app.agents.delta_timer_count() == 0)
}

test "reader_sessions: due routes across Actors, Jobs, Live, Remote, and HubGen timer tables" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let app = new_test_app(host)
  let epoch = app.gen().counters.epoch

  // 1. HubGen timer
  let mut hub_fired = false
  let hub_tid = host.alloc_id()
  app.gen().register_timer(host, hub_tid, fn() -> Unit {
    hub_fired = true
  })

  // 2. Jobs timer (`JobsState.timer_actions`)
  let jobs_tid = host.alloc_id()
  app.jobs.state.timer_actions.set(jobs_tid, (epoch, sessions_jobs_live::JobsTimerAction::LookLater))

  // 3. Live timer (`LiveState.timer_actions`)
  let live_tid = host.alloc_id()
  app.live.state.timer_actions.set(live_tid, (epoch, sessions_jobs_live::LiveTimerAction::ReleaseHold("s1")))

  // 4. Remote timer (`RemoteState.timers`)
  let remote_tid = host.alloc_id()
  app.remote.state.timers.set(
    remote_tid,
    sessions_remote::RemoteTimerEntry::{ epoch: epoch, action: sessions_remote::RemoteTimerAction::SweepHourly },
  )

  // 5. Actor timer (`ActorsGen.actor_timers`)
  let a = app.actors.actor("s1", "claude")
  let actor_tid = host.alloc_id()
  a.timers.set("wait", sessions_actors::ActorTimerRef::{ timer_id: actor_tid, gen: 1 })
  app.actors.current.actor_timers.set(
    actor_tid,
    sessions_actors::PendingActorTimer::{
      actor_key: "s1",
      name: "wait",
      gen: 1,
      action: sessions_actors::ActorTimerAction::FireWait(1, 100.0),
    },
  )

  // Fire each via `heard({"due": id})` and assert each table entry is consumed cleanly.
  app.heard("{\"due\":" + hub_tid.to_string() + "}")
  assert(hub_fired)

  app.heard("{\"due\":" + jobs_tid.to_string() + "}")
  assert(!app.jobs.state.timer_actions.contains(jobs_tid))

  app.heard("{\"due\":" + live_tid.to_string() + "}")
  assert(!app.live.state.timer_actions.contains(live_tid))

  app.heard("{\"due\":" + remote_tid.to_string() + "}")
  assert(!app.remote.state.timers.contains(remote_tid))

  app.heard("{\"due\":" + actor_tid.to_string() + "}")
  assert(!app.actors.current.actor_timers.contains(actor_tid))

  app.close()
  host.tick()
  assert_holding_zero(host)
  assert(app.agents.delta_timer_count() == 0)
}
