// Deterministic tests for the `reader_sessions` walking skeleton.

import "base_codec"
import "effect"
import "sessions_core"

fn assert(cond : Bool) -> Unit {
  if !cond {
    panic("assertion failed")
  }
}

test "reader_sessions: emits ready without active/seen, handles db:null, quiet, and clean EOF 0" {
  let mem = sessions_core::MemHostTransport::new()
  mem.push_stdin("{\"db\":null}\n")
  mem.push_eof()

  let host = sessions_core::SessionHost::for_test(mem)
  let app = SessionsApp::new(host, "/", sessions_core::SessionDispatch::stub())
  assert(app.has_stubs())

  let code = sessions_core::run_host_loop(host, fn(_h : sessions_core::SessionHost, k) -> Unit {
    serve_sessions_k(app, k)
  })
  assert(code == 0)
  assert(mem.stderr_lines.length() == 0)
  assert(mem.exit_codes.length() == 1)
  assert(mem.exit_codes[0] == 0)
  assert(mem.stdout_lines.length() == 2)
  assert(mem.stdout_lines[0] == "{\"ready\":true}")
  assert(mem.stdout_lines[1] == "{\"quiet\":true,\"active\":0,\"seen\":1}")
}

test "reader_sessions: non-actor lines route to agents_told without emitting quiet" {
  let mem = sessions_core::MemHostTransport::new()
  mem.push_stdin("{\"wall\":12345}\n")
  mem.push_eof()

  let seen_agents : Array[String] = []
  let stub = sessions_core::SessionDispatch::stub()
  let dispatch = sessions_core::SessionDispatch::{
    mirror_actor: stub.mirror_actor,
    live_event: stub.live_event,
    live_end: stub.live_end,
    live_called: stub.live_called,
    jobs_called_k: stub.jobs_called_k,
    jstore_get_job_k: stub.jstore_get_job_k,
    remote_called_k: stub.remote_called_k,
    remote_changed_k: stub.remote_changed_k,
    queue_of_locked_k: stub.queue_of_locked_k,
    agents_told: fn(line : String) -> Unit { seen_agents.push(line) },
    agents_take: stub.agents_take,
    is_stub: true,
  }

  let host = sessions_core::SessionHost::for_test(mem)
  let code = run_sessions_with_host(host, "/", dispatch)
  assert(code == 0)
  assert(seen_agents.length() == 1)
  assert(seen_agents[0] == "{\"wall\":12345}")
  assert(mem.stdout_lines.length() == 1)
  assert(mem.stdout_lines[0] == "{\"ready\":true}")
}

test "reader_sessions: same-chunk freeze (numeric) + routed (numeric) matches 1:1 MB 3-frame sequence" {
  let mem = sessions_core::MemHostTransport::new()
  // Real Node payloads: `{"freeze":1}` (mb-agents.ts:297) + `{"routed":2}` (mb-actor.ts:655) in one chunk.
  mem.push_stdin("{\"freeze\":1}\n{\"routed\":2}\n")
  mem.push_round_barrier()
  mem.push_eof()

  let host = sessions_core::SessionHost::for_test(mem)
  let seen_agents : Array[String] = []
  let stub = sessions_core::SessionDispatch::stub()
  let dispatch = sessions_core::SessionDispatch::{
    mirror_actor: stub.mirror_actor,
    live_event: stub.live_event,
    live_end: stub.live_end,
    live_called: stub.live_called,
    jobs_called_k: stub.jobs_called_k,
    jstore_get_job_k: stub.jstore_get_job_k,
    remote_called_k: stub.remote_called_k,
    remote_changed_k: stub.remote_changed_k,
    queue_of_locked_k: stub.queue_of_locked_k,
    agents_told: fn(line : String) -> Unit {
      seen_agents.push(line)
      // Emit agents.mbt:183 frozen reply directly to stdout.
      host.say("{\"frozen\":1,\"states\":{}}")
    },
    agents_take: stub.agents_take,
    is_stub: true,
  }

  let code = run_sessions_with_host(host, "/", dispatch)
  assert(code == 0)
  assert(mem.stderr_lines.length() == 0)
  assert(seen_agents.length() == 1)
  assert(seen_agents[0] == "{\"freeze\":1}")
  assert(mem.stdout_lines.length() == 3)
  assert(mem.stdout_lines[0] == "{\"ready\":true}")
  assert(mem.stdout_lines[1] == "{\"frozen\":1,\"states\":{}}")
  assert(mem.stdout_lines[2] == "{\"quiet\":true,\"active\":0,\"seen\":1}")
}

test "reader_sessions: same-chunk answer + due through real serve_sessions_k emits quiet before EOF" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let app = SessionsApp::new(host, "/", sessions_core::SessionDispatch::stub())
  let order : Array[String] = []

  // Pre-register timer (id=1) and RPC (id=2) on real `app.gen`.
  let timer_id = host.alloc_id()
  app.gen.register_timer(host, timer_id, fn() -> Unit {
    order.push("due")
  })
  app.gen.spawn_work(fn(wk : (effect::Exit[Unit]) -> Unit) -> Unit {
    app.gen.rpc_k(host, "s1", "node.ping", [], fn(_k : String) -> Unit { () }, fn(res : effect::Exit[base_codec::Json]) -> Unit {
      match res {
        effect::Exit::Succeeded(_) => order.push("answer")
        _ => ()
      }
      wk(effect::Exit::Succeeded(()))
    })
  })
  host.tick()
  assert(app.gen.counters.active == 0)
  assert(mem.stdout_lines.length() == 1)
  assert(mem.stdout_lines[0].contains("\"rpc\":2"))

  // Round 1: same-chunk `answer` + `due` through real `serve_sessions_k` / `SessionsApp::heard`;
  // Round 2: EOF after round barrier.
  mem.push_stdin("{\"answer\":2,\"value\":true}\n{\"due\":1}\n")
  mem.push_round_barrier()
  mem.push_eof()

  let code = sessions_core::run_host_loop(host, fn(_h : sessions_core::SessionHost, k) -> Unit {
    serve_sessions_k(app, k)
  })
  assert(code == 0)
  assert(mem.stderr_lines.length() == 0)
  assert(order.length() == 2)
  assert(order[0] == "due")
  assert(order[1] == "answer")
  assert(app.gen.counters.active == 0)
  assert(app.gen.counters.seen == 2)
  // stdout: [0]=rpc, [1]=ready, [2]=quiet after work finishes on answer+due (before EOF).
  assert(mem.stdout_lines.length() == 3)
  assert(mem.stdout_lines[1] == "{\"ready\":true}")
  assert(mem.stdout_lines[2] == "{\"quiet\":true,\"active\":0,\"seen\":2}")
}
