// Post-blocks backfill builder (`--builder post-blocks`), 1:1 aligned with
// `station/mb/src/posts/posts.mbt` and `station/mb/src/reader/main.mbt:984-989`.
// All write transactions go exclusively through `db.tx_err(...)` (never raw transaction SQL).

import "base_codec"
import "sql_db"

let POST_BLOCKS_SIZE : Int = 64

fn post_block_expr(n : String) -> String {
  "(" +
  n +
  " / " +
  POST_BLOCKS_SIZE.to_string() +
  " - CASE WHEN " +
  n +
  " < 0 AND " +
  n +
  " % " +
  POST_BLOCKS_SIZE.to_string() +
  " != 0 THEN 1 ELSE 0 END)"
}

fn post_blocks_fresh(db : sql_db::Db) -> Result[Bool, StepError] {
  match db.first("SELECT fresh FROM post_blocks_meta WHERE id = 1", []) {
    Ok(Some(r)) => {
      match sql_db::row_val(r, "fresh") {
        base_codec::Json::Num(n, _) => Ok(n == 1.0)
        _ => Ok(false)
      }
    }
    Ok(None) => Err(StepError::App("post block metadata is missing"))
    Err(e) => Err(StepError::Sql(e))
  }
}

fn post_blocks_coverage(
  db : sql_db::Db,
  thread : base_codec::Json,
  after : base_codec::Json,
) -> Result[(Option[Map[String, base_codec::Json]], Bool), StepError] {
  match db.first(
    "SELECT CAST(cursor AS TEXT) AS cursor, complete, (complete = 1 OR (cursor IS NOT NULL AND cursor <= ?2 + 1)) AS covers FROM post_blocks_coverage WHERE thread = ?1",
    [thread, after],
  ) {
    Ok(Some(r)) => {
      let covered = match sql_db::row_val(r, "covers") {
        base_codec::Json::Num(n, _) => n == 1.0
        _ => false
      }
      Ok((Some(r), covered))
    }
    Ok(None) => Ok((None, false))
    Err(e) => Err(StepError::Sql(e))
  }
}

/// One step of marking `thread`'s messages from `after` on, at most `limit` (64 at most) entries,
/// newest first; whether that suffix is covered then.
pub fn post_blocks_step(
  db : sql_db::Db,
  thread : Int64,
  after : Int64,
  limit : Int = 64,
) -> Result[Bool, StepError] {
  if limit < 1 || limit > POST_BLOCKS_SIZE {
    return Err(StepError::App("post block batch must be between 1 and 64"))
  }
  match post_blocks_fresh(db) {
    Ok(true) => return Ok(true)
    Ok(false) => ()
    Err(e) => return Err(e)
  }
  let t = base_codec::json_num(thread.to_double())
  let a = base_codec::json_num(after.to_double())
  let lim = base_codec::json_int(limit)
  let (before, covered) = match post_blocks_coverage(db, t, a) {
    Ok(pair) => pair
    Err(e) => return Err(e)
  }
  if covered {
    return Ok(true)
  }
  let before_cursor = match before {
    Some(r) => sql_db::row_val(r, "cursor")
    None => base_codec::json_null()
  }
  let before_complete = match before {
    Some(r) => sql_db::row_val(r, "complete")
    None => base_codec::json_int(0)
  }
  let rows = match before_cursor {
    base_codec::Json::Null => {
      match db.all(
        "SELECT CAST(n AS TEXT) AS n, kind, author_kind, author FROM entries WHERE thread = ? AND n >= ? ORDER BY entries.n DESC LIMIT ?",
        [t, a, lim],
      ) {
        Ok(r) => r
        Err(e) => return Err(StepError::Sql(e))
      }
    }
    _ => {
      match db.all(
        "SELECT CAST(n AS TEXT) AS n, kind, author_kind, author FROM entries WHERE thread = ? AND n < CAST(? AS INTEGER) AND n >= ? ORDER BY entries.n DESC LIMIT ?",
        [t, before_cursor, a, lim],
      ) {
        Ok(r) => r
        Err(e) => return Err(StepError::Sql(e))
      }
    }
  }
  let older = if rows.length() < limit {
    match db.first("SELECT 1 FROM entries WHERE thread = ? AND n < ? LIMIT 1", [t, a]) {
      Ok(Some(_)) => true
      Ok(None) => false
      Err(e) => return Err(StepError::Sql(e))
    }
  } else {
    false
  }
  let b_expr = post_block_expr("e.n")
  let put_sql = "INSERT INTO post_blocks (thread, author, bucket) SELECT e.thread, e.author, " +
  b_expr +
  " FROM entries e WHERE e.thread = ? AND e.n = CAST(? AS INTEGER) AND e.author = ? AND e.kind = 'message' AND e.author_kind = 'agent' AND NOT EXISTS (SELECT 1 FROM post_blocks b WHERE b.thread = e.thread AND b.author = e.author AND b.bucket = " +
  b_expr +
  ")"
  db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Bool, StepError] {
      let (current, now_covered) = match post_blocks_coverage(tx_db, t, a) {
        Ok(pair) => pair
        Err(e) => return Err(e)
      }
      let current_cursor = match current {
        Some(r) => sql_db::row_val(r, "cursor")
        None => base_codec::json_null()
      }
      let current_complete = match current {
        Some(r) => sql_db::row_val(r, "complete")
        None => base_codec::json_int(0)
      }
      if !base_codec::json_eq(current_cursor, before_cursor) ||
      !base_codec::json_eq(current_complete, before_complete) {
        return Ok(now_covered)
      }
      for i in 0..<rows.length() {
        let row = rows[i]
        let is_agent_msg = match (sql_db::row_val(row, "kind"), sql_db::row_val(row, "author_kind")) {
          (base_codec::Json::Str("message"), base_codec::Json::Str("agent")) => true
          _ => false
        }
        if is_agent_msg {
          let _ = match tx_db.run(
            put_sql,
            [t, sql_db::row_val(row, "n"), sql_db::row_val(row, "author")],
          ) {
            Ok(n) => n
            Err(e) => return Err(StepError::Sql(e))
          }
        }
      }
      let cursor = if rows.length() < limit {
        a
      } else {
        sql_db::row_val(rows[rows.length() - 1], "n")
      }
      let complete = rows.length() < limit && !older
      let _ = match tx_db.run(
        "INSERT INTO post_blocks_coverage(thread, cursor, complete) VALUES (?, CAST(? AS INTEGER), ?) ON CONFLICT(thread) DO UPDATE SET cursor = excluded.cursor, complete = excluded.complete",
        [t, cursor, base_codec::json_int(if complete { 1 } else { 0 })],
      ) {
        Ok(n) => n
        Err(e) => return Err(StepError::Sql(e))
      }
      let done = if complete {
        true
      } else {
        match tx_db.first("SELECT CAST(? AS INTEGER) <= ? + 1 AS ok", [cursor, a]) {
          Ok(Some(r)) => {
            match sql_db::row_val(r, "ok") {
              base_codec::Json::Num(n, _) => n == 1.0
              _ => false
            }
          }
          Ok(None) => false
          Err(e) => return Err(StepError::Sql(e))
        }
      }
      Ok(done)
    },
    fn(e : sql_db::SqlError) -> StepError { StepError::Sql(e) },
  )
}

/// Request dispatcher for `--builder post-blocks`
/// (matches MB `{ "thread": Number(thread, ..), "after": Number(after, ..), .. }`).
pub fn post_blocks_dispatch(
  db : sql_db::Db,
  ask : base_codec::Json,
) -> Result[Option[Bool], StepError] {
  match (json_get_last(ask, "thread"), json_get_last(ask, "after")) {
    (Some(base_codec::Json::Num(thread, _)), Some(base_codec::Json::Num(after, _))) => {
      match post_blocks_step(
        db,
        double_to_i64_saturating(thread),
        double_to_i64_saturating(after),
        limit=64,
      ) {
        Ok(done) => Ok(Some(done))
        Err(e) => Err(e)
      }
    }
    _ => Ok(None)
  }
}

pub fn run_post_blocks(db_path : String) -> Int {
  builder_loop(db_path, "post block", post_blocks_dispatch)
}
