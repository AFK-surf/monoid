// Per-chat legacy lookups backfill builders (`--builder closed-cards` and `--builder people-since`),
// 1:1 aligned with `station/mb/src/lookups/lookups.mbt` and `station/mb/src/reader/main.mbt:907-916`.
// All write transactions go exclusively through `db.tx_err(...)` (never raw transaction SQL).
// Every `CREATE TRIGGER ... BEGIN ... END;` stays inside a single string literal so the static
// SQL transaction-control guard can lex each trigger body cleanly with zero false positives.

import "base_codec"
import "sql_db"

let LOOKUPS_VERSION : Int = 1
let LOOKUPS_BATCH : Int = 64

struct LookupSpec {
  name : String
  native_index : String
  native_ddl : String
  meta : String
  scopes : String
  source : String
  schema : String
  put : String
  cleanup : Option[(String, String)]
}

fn closed_lookup_spec() -> LookupSpec {
  let schema = "CREATE TABLE legacy_closed_meta (id INTEGER PRIMARY KEY CHECK(id=1),version INTEGER NOT NULL) WITHOUT ROWID;\n" +
  "INSERT INTO legacy_closed_meta VALUES(1,1);\n" +
  "CREATE TABLE legacy_closed_scopes (thread INTEGER PRIMARY KEY,last_n INTEGER,end_n INTEGER,complete INTEGER NOT NULL) WITHOUT ROWID;\n" +
  "CREATE TABLE legacy_closed_cards (source_rowid INTEGER PRIMARY KEY,thread INTEGER NOT NULL,n INTEGER NOT NULL,at INTEGER NOT NULL);\n" +
  "CREATE UNIQUE INDEX legacy_closed_by_entry ON legacy_closed_cards(thread,n);\n" +
  "CREATE INDEX legacy_closed_by_time ON legacy_closed_cards(thread,at);\n" +
  "CREATE TRIGGER legacy_closed_insert AFTER INSERT ON closed_cards BEGIN DELETE FROM legacy_closed_cards WHERE thread=NEW.thread AND n=NEW.n; DELETE FROM legacy_closed_cards WHERE source_rowid=NEW.rowid; INSERT INTO legacy_closed_cards(thread,at,source_rowid,n) SELECT c.thread,c.at,c.rowid,c.n FROM (SELECT rowid AS id FROM closed_cards WHERE thread=NEW.thread AND n=NEW.n UNION SELECT rowid FROM closed_cards WHERE rowid=NEW.rowid) p CROSS JOIN closed_cards c ON c.rowid=p.id WHERE EXISTS (SELECT 1 FROM legacy_closed_scopes s WHERE s.thread=c.thread) AND NOT EXISTS (SELECT 1 FROM legacy_closed_cards k WHERE k.thread=c.thread AND k.n=c.n); END;\n" +
  "CREATE TRIGGER legacy_closed_update AFTER UPDATE ON closed_cards WHEN OLD.thread IS NOT NEW.thread OR OLD.n IS NOT NEW.n OR OLD.at IS NOT NEW.at OR OLD.rowid IS NOT NEW.rowid BEGIN DELETE FROM legacy_closed_cards WHERE thread=OLD.thread AND n=OLD.n; DELETE FROM legacy_closed_cards WHERE source_rowid=OLD.rowid; DELETE FROM legacy_closed_cards WHERE thread=NEW.thread AND n=NEW.n; DELETE FROM legacy_closed_cards WHERE source_rowid=NEW.rowid; INSERT INTO legacy_closed_cards(thread,at,source_rowid,n) SELECT c.thread,c.at,c.rowid,c.n FROM (SELECT rowid AS id FROM closed_cards WHERE thread=OLD.thread AND n=OLD.n UNION SELECT rowid FROM closed_cards WHERE rowid=OLD.rowid UNION SELECT rowid AS id FROM closed_cards WHERE thread=NEW.thread AND n=NEW.n UNION SELECT rowid FROM closed_cards WHERE rowid=NEW.rowid) p CROSS JOIN closed_cards c ON c.rowid=p.id WHERE EXISTS (SELECT 1 FROM legacy_closed_scopes s WHERE s.thread=c.thread) AND NOT EXISTS (SELECT 1 FROM legacy_closed_cards k WHERE k.thread=c.thread AND k.n=c.n); END;\n" +
  "CREATE TRIGGER legacy_closed_delete AFTER DELETE ON closed_cards BEGIN DELETE FROM legacy_closed_cards WHERE thread=OLD.thread AND n=OLD.n; DELETE FROM legacy_closed_cards WHERE source_rowid=OLD.rowid; INSERT INTO legacy_closed_cards(thread,at,source_rowid,n) SELECT c.thread,c.at,c.rowid,c.n FROM (SELECT rowid AS id FROM closed_cards WHERE thread=OLD.thread AND n=OLD.n UNION SELECT rowid FROM closed_cards WHERE rowid=OLD.rowid) p CROSS JOIN closed_cards c ON c.rowid=p.id WHERE EXISTS (SELECT 1 FROM legacy_closed_scopes s WHERE s.thread=c.thread) AND NOT EXISTS (SELECT 1 FROM legacy_closed_cards k WHERE k.thread=c.thread AND k.n=c.n); END;"
  LookupSpec::{
    name: "closed-card",
    native_index: "closed_cards_thread_at",
    native_ddl: "CREATE INDEX IF NOT EXISTS closed_cards_thread_at ON closed_cards (thread, at)",
    meta: "legacy_closed_meta",
    scopes: "legacy_closed_scopes",
    source: "closed_cards",
    schema: schema,
    put: "INSERT INTO legacy_closed_cards(thread,at,source_rowid,n) SELECT c.thread,c.at,c.rowid,c.n FROM closed_cards c WHERE c.thread=?1 AND c.n=CAST(?2 AS INTEGER) AND NOT EXISTS (SELECT 1 FROM legacy_closed_cards k WHERE k.thread=c.thread AND k.n=c.n)",
    cleanup: Some(
      (
        "legacy_closed_drop_thread",
        "CREATE TRIGGER legacy_closed_drop_thread AFTER DELETE ON threads WHEN NOT EXISTS (SELECT 1 FROM closed_cards WHERE thread=OLD.id LIMIT 1) BEGIN DELETE FROM legacy_closed_scopes WHERE thread=OLD.id; END;",
      ),
    ),
  }
}

fn people_lookup_spec() -> LookupSpec {
  let schema = "CREATE TABLE legacy_people_time_meta(id INTEGER PRIMARY KEY CHECK(id=1),version INTEGER NOT NULL) WITHOUT ROWID;\n" +
  "INSERT INTO legacy_people_time_meta VALUES(1,1);\n" +
  "CREATE TABLE legacy_people_time_scopes(thread INTEGER PRIMARY KEY,last_n INTEGER,end_n INTEGER,complete INTEGER NOT NULL) WITHOUT ROWID;\n" +
  "CREATE TABLE legacy_people_time_rows(source_rowid INTEGER PRIMARY KEY,thread INTEGER NOT NULL,n INTEGER NOT NULL,at INTEGER NOT NULL,ts TEXT);\n" +
  "CREATE UNIQUE INDEX legacy_people_time_by_entry ON legacy_people_time_rows(thread,n);\n" +
  "CREATE INDEX legacy_people_time_by_at ON legacy_people_time_rows(thread,at);\n" +
  "CREATE INDEX legacy_people_time_by_ts ON legacy_people_time_rows(thread,ts) WHERE ts IS NOT NULL;\n" +
  "CREATE TRIGGER legacy_people_time_insert AFTER INSERT ON entries WHEN EXISTS (SELECT 1 FROM legacy_people_time_scopes WHERE thread=NEW.thread) OR EXISTS (SELECT 1 FROM legacy_people_time_rows WHERE source_rowid=NEW.rowid) BEGIN DELETE FROM legacy_people_time_rows WHERE thread=NEW.thread AND n=NEW.n; DELETE FROM legacy_people_time_rows WHERE source_rowid=NEW.rowid; DELETE FROM legacy_people_time_rows WHERE NEW.ts IS NOT NULL AND thread=NEW.thread AND ts=NEW.ts; INSERT INTO legacy_people_time_rows(source_rowid,thread,n,at,ts) SELECT e.rowid,e.thread,e.n,e.at,e.ts FROM (SELECT rowid AS id FROM entries WHERE thread=NEW.thread AND n=NEW.n UNION SELECT rowid FROM entries INDEXED BY entries_ts WHERE NEW.ts IS NOT NULL AND thread=NEW.thread AND ts=NEW.ts UNION SELECT rowid FROM entries WHERE rowid=NEW.rowid) p CROSS JOIN entries e ON e.rowid=p.id WHERE e.kind='message' AND e.author_kind='person' AND EXISTS (SELECT 1 FROM legacy_people_time_scopes s WHERE s.thread=e.thread) AND NOT EXISTS (SELECT 1 FROM legacy_people_time_rows k WHERE k.source_rowid=e.rowid) AND NOT EXISTS (SELECT 1 FROM legacy_people_time_rows k WHERE k.thread=e.thread AND k.n=e.n); END;\n" +
  "CREATE TRIGGER legacy_people_time_update AFTER UPDATE ON entries WHEN (OLD.thread IS NOT NEW.thread OR OLD.n IS NOT NEW.n OR OLD.rowid IS NOT NEW.rowid OR OLD.ts IS NOT NEW.ts OR OLD.at IS NOT NEW.at OR OLD.kind IS NOT NEW.kind OR OLD.author_kind IS NOT NEW.author_kind) AND (EXISTS (SELECT 1 FROM legacy_people_time_scopes WHERE thread IN (OLD.thread,NEW.thread)) OR EXISTS (SELECT 1 FROM legacy_people_time_rows WHERE source_rowid=NEW.rowid)) BEGIN DELETE FROM legacy_people_time_rows WHERE thread=OLD.thread AND n=OLD.n; DELETE FROM legacy_people_time_rows WHERE source_rowid=OLD.rowid; DELETE FROM legacy_people_time_rows WHERE OLD.ts IS NOT NULL AND thread=OLD.thread AND ts=OLD.ts; DELETE FROM legacy_people_time_rows WHERE thread=NEW.thread AND n=NEW.n; DELETE FROM legacy_people_time_rows WHERE source_rowid=NEW.rowid; DELETE FROM legacy_people_time_rows WHERE NEW.ts IS NOT NULL AND thread=NEW.thread AND ts=NEW.ts; INSERT INTO legacy_people_time_rows(source_rowid,thread,n,at,ts) SELECT e.rowid,e.thread,e.n,e.at,e.ts FROM (SELECT rowid AS id FROM entries WHERE thread=OLD.thread AND n=OLD.n UNION SELECT rowid FROM entries INDEXED BY entries_ts WHERE OLD.ts IS NOT NULL AND thread=OLD.thread AND ts=OLD.ts UNION SELECT rowid FROM entries WHERE rowid=OLD.rowid UNION SELECT rowid AS id FROM entries WHERE thread=NEW.thread AND n=NEW.n UNION SELECT rowid FROM entries INDEXED BY entries_ts WHERE NEW.ts IS NOT NULL AND thread=NEW.thread AND ts=NEW.ts UNION SELECT rowid FROM entries WHERE rowid=NEW.rowid) p CROSS JOIN entries e ON e.rowid=p.id WHERE e.kind='message' AND e.author_kind='person' AND EXISTS (SELECT 1 FROM legacy_people_time_scopes s WHERE s.thread=e.thread) AND NOT EXISTS (SELECT 1 FROM legacy_people_time_rows k WHERE k.source_rowid=e.rowid) AND NOT EXISTS (SELECT 1 FROM legacy_people_time_rows k WHERE k.thread=e.thread AND k.n=e.n); END;\n" +
  "CREATE TRIGGER legacy_people_time_delete AFTER DELETE ON entries WHEN EXISTS (SELECT 1 FROM legacy_people_time_scopes WHERE thread=OLD.thread) OR EXISTS (SELECT 1 FROM legacy_people_time_rows WHERE source_rowid=OLD.rowid) BEGIN DELETE FROM legacy_people_time_rows WHERE thread=OLD.thread AND n=OLD.n; DELETE FROM legacy_people_time_rows WHERE source_rowid=OLD.rowid; DELETE FROM legacy_people_time_rows WHERE OLD.ts IS NOT NULL AND thread=OLD.thread AND ts=OLD.ts; INSERT INTO legacy_people_time_rows(source_rowid,thread,n,at,ts) SELECT e.rowid,e.thread,e.n,e.at,e.ts FROM (SELECT rowid AS id FROM entries WHERE thread=OLD.thread AND n=OLD.n UNION SELECT rowid FROM entries INDEXED BY entries_ts WHERE OLD.ts IS NOT NULL AND thread=OLD.thread AND ts=OLD.ts UNION SELECT rowid FROM entries WHERE rowid=OLD.rowid) p CROSS JOIN entries e ON e.rowid=p.id WHERE e.kind='message' AND e.author_kind='person' AND EXISTS (SELECT 1 FROM legacy_people_time_scopes s WHERE s.thread=e.thread) AND NOT EXISTS (SELECT 1 FROM legacy_people_time_rows k WHERE k.source_rowid=e.rowid) AND NOT EXISTS (SELECT 1 FROM legacy_people_time_rows k WHERE k.thread=e.thread AND k.n=e.n); END;\n" +
  "CREATE TRIGGER legacy_people_time_drop_thread AFTER DELETE ON threads WHEN NOT EXISTS (SELECT 1 FROM entries WHERE thread=OLD.id LIMIT 1) BEGIN DELETE FROM legacy_people_time_scopes WHERE thread=OLD.id; END;"
  LookupSpec::{
    name: "people-time",
    native_index: "entries_people_since",
    native_ddl: "CREATE INDEX IF NOT EXISTS entries_people_since ON entries (thread, at) WHERE author_kind = 'person' AND kind = 'message'",
    meta: "legacy_people_time_meta",
    scopes: "legacy_people_time_scopes",
    source: "entries",
    schema: schema,
    put: "INSERT INTO legacy_people_time_rows(source_rowid,thread,n,at,ts) SELECT e.rowid,e.thread,e.n,e.at,e.ts FROM entries e WHERE e.thread=?1 AND e.n=CAST(?2 AS INTEGER) AND e.kind='message' AND e.author_kind='person' AND NOT EXISTS (SELECT 1 FROM legacy_people_time_rows k WHERE k.source_rowid=e.rowid) AND NOT EXISTS (SELECT 1 FROM legacy_people_time_rows k WHERE k.thread=e.thread AND k.n=e.n)",
    cleanup: None,
  }
}

fn lookup_meta_version(db : sql_db::Db, l : LookupSpec) -> Result[Option[Int], StepError] {
  match db.first("SELECT version FROM " + l.meta + " WHERE id=1", []) {
    Ok(Some(r)) => {
      match r.get("version") {
        Some(base_codec::Json::Num(v, _)) => Ok(Some(v.to_int()))
        _ => Ok(Some(-1))
      }
    }
    Ok(None) => Ok(None)
    Err(e) => Err(StepError::Sql(e))
  }
}

fn lookup_has_native(db : sql_db::Db, l : LookupSpec) -> Result[Bool, StepError] {
  match db.has_schema("index", l.native_index) {
    Ok(b) => Ok(b)
    Err(e) => Err(StepError::Sql(e))
  }
}

fn lookup_has_legacy(db : sql_db::Db, l : LookupSpec) -> Result[Bool, StepError] {
  let has_meta = match db.has_schema("table", l.meta) {
    Ok(b) => b
    Err(e) => return Err(StepError::Sql(e))
  }
  if !has_meta {
    return Ok(false)
  }
  match lookup_meta_version(db, l) {
    Ok(Some(v)) => {
      if v == LOOKUPS_VERSION {
        Ok(true)
      } else {
        Err(StepError::App("legacy " + l.name + " lookup has an unsupported version"))
      }
    }
    Ok(None) => Err(StepError::App("legacy " + l.name + " lookup has an unsupported version"))
    Err(e) => Err(e)
  }
}

fn lookup_needs_cleanup(db : sql_db::Db, l : LookupSpec) -> Result[Bool, StepError] {
  let trigger = match l.cleanup {
    Some((t, _)) => t
    None => return Ok(false)
  }
  let has_meta = match db.has_schema("table", l.meta) {
    Ok(b) => b
    Err(e) => return Err(StepError::Sql(e))
  }
  if !has_meta {
    return Ok(false)
  }
  let has_trig = match db.has_schema("trigger", trigger) {
    Ok(b) => b
    Err(e) => return Err(StepError::Sql(e))
  }
  if has_trig {
    return Ok(false)
  }
  let has_threads = match db.has_schema("table", "threads") {
    Ok(b) => b
    Err(e) => return Err(StepError::Sql(e))
  }
  if !has_threads {
    return Ok(false)
  }
  let has_scopes = match db.has_schema("table", l.scopes) {
    Ok(b) => b
    Err(e) => return Err(StepError::Sql(e))
  }
  if !has_scopes {
    return Ok(false)
  }
  match lookup_meta_version(db, l) {
    Ok(Some(v)) => Ok(v == LOOKUPS_VERSION)
    Ok(None) => Ok(false)
    Err(e) => Err(e)
  }
}

fn lookup_install(db : sql_db::Db, l : LookupSpec) -> Result[Unit, StepError] {
  let has_nat = match lookup_has_native(db, l) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let has_leg = if has_nat {
    false
  } else {
    match lookup_has_legacy(db, l) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
  }
  if has_nat || has_leg {
    let need_cl = match lookup_needs_cleanup(db, l) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    if !need_cl {
      return Ok(())
    }
  }
  db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Unit, StepError] {
      let nat_now = match lookup_has_native(tx_db, l) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      let leg_now = if nat_now {
        false
      } else {
        match lookup_has_legacy(tx_db, l) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
      }
      if !nat_now && !leg_now {
        let large = match tx_db.first("SELECT 1 FROM " + l.source + " LIMIT 1 OFFSET 63", []) {
          Ok(Some(_)) => true
          Ok(None) => false
          Err(e) => return Err(StepError::Sql(e))
        }
        let ddl = if !large { l.native_ddl } else { l.schema }
        match tx_db.exec(ddl) {
          Ok(_) => ()
          Err(e) => return Err(StepError::Sql(e))
        }
      }
      let need_cl = match lookup_needs_cleanup(tx_db, l) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      if need_cl {
        match l.cleanup {
          Some((_, ddl)) => {
            match tx_db.exec(ddl) {
              Ok(_) => ()
              Err(e) => return Err(StepError::Sql(e))
            }
          }
          None => ()
        }
      }
      Ok(())
    },
    fn(e : sql_db::SqlError) -> StepError { StepError::Sql(e) },
  )
}

fn lookup_scope_of(
  db : sql_db::Db,
  l : LookupSpec,
  thread : base_codec::Json,
) -> Result[Option[Map[String, base_codec::Json]], StepError] {
  match db.first(
    "SELECT CAST(last_n AS TEXT) AS last_n,CAST(end_n AS TEXT) AS end_n,complete FROM " +
    l.scopes +
    " WHERE thread=?",
    [thread],
  ) {
    Ok(r) => Ok(r)
    Err(e) => Err(StepError::Sql(e))
  }
}

fn lookup_step(
  db : sql_db::Db,
  l : LookupSpec,
  thread : Int64,
  limit : Int,
) -> Result[Bool, StepError] {
  if limit < 1 || limit > LOOKUPS_BATCH {
    return Err(StepError::App(l.name + " batch must be 1\u{2013}64"))
  }
  match lookup_install(db, l) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match lookup_has_native(db, l) {
    Ok(true) => return Ok(true)
    Ok(false) => ()
    Err(e) => return Err(e)
  }
  let t = base_codec::json_num(thread.to_double())
  db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Bool, StepError] {
      match lookup_has_native(tx_db, l) {
        Ok(true) => return Ok(true)
        Ok(false) => ()
        Err(e) => return Err(e)
      }
      match lookup_has_legacy(tx_db, l) {
        Ok(false) => return Ok(false)
        Ok(true) => ()
        Err(e) => return Err(e)
      }
      let existing = match lookup_scope_of(tx_db, l, t) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match existing {
        None => {
          let chats = match l.cleanup {
            None => true
            Some(_) => {
              match tx_db.has_schema("table", "threads") {
                Ok(b) => b
                Err(e) => return Err(StepError::Sql(e))
              }
            }
          }
          if chats {
            let has_thread = match tx_db.first("SELECT 1 FROM threads WHERE id=?", [t]) {
              Ok(Some(_)) => true
              Ok(None) => false
              Err(e) => return Err(StepError::Sql(e))
            }
            if !has_thread {
              let has_src = match tx_db.first(
                "SELECT 1 FROM " + l.source + " WHERE thread=? LIMIT 1",
                [t],
              ) {
                Ok(Some(_)) => true
                Ok(None) => false
                Err(e) => return Err(StepError::Sql(e))
              }
              if !has_src {
                return Ok(true)
              }
            }
          }
          let _ = match tx_db.run(
            "INSERT INTO " +
            l.scopes +
            "(thread,last_n,end_n,complete) VALUES(?1,NULL,(SELECT n FROM " +
            l.source +
            " WHERE thread=?1 ORDER BY n DESC LIMIT 1),0)",
            [t],
          ) {
            Ok(n) => n
            Err(e) => return Err(StepError::Sql(e))
          }
        }
        Some(_) => ()
      }
      let s = match lookup_scope_of(tx_db, l, t) {
        Ok(Some(r)) => r
        Ok(None) => return Err(StepError::App(l.name + " scope is missing"))
        Err(e) => return Err(e)
      }
      match sql_db::row_val(s, "complete") {
        base_codec::Json::Num(n, _) => {
          if n == 1.0 {
            return Ok(true)
          }
        }
        _ => ()
      }
      let last = sql_db::row_val(s, "last_n")
      let end = sql_db::row_val(s, "end_n")
      let lim = base_codec::json_int(limit)
      let rows : Array[Map[String, base_codec::Json]] = match end {
        base_codec::Json::Null => []
        _ => {
          match last {
            base_codec::Json::Null => {
              match tx_db.all(
                "SELECT CAST(n AS TEXT) AS n FROM (SELECT n FROM " +
                l.source +
                " WHERE thread=?1 AND n<=CAST(?2 AS INTEGER) ORDER BY n LIMIT ?3)",
                [t, end, lim],
              ) {
                Ok(r) => r
                Err(e) => return Err(StepError::Sql(e))
              }
            }
            _ => {
              match tx_db.all(
                "SELECT CAST(n AS TEXT) AS n FROM (SELECT n FROM " +
                l.source +
                " WHERE thread=?1 AND n>CAST(?2 AS INTEGER) AND n<=CAST(?3 AS INTEGER) ORDER BY n LIMIT ?4)",
                [t, last, end, lim],
              ) {
                Ok(r) => r
                Err(e) => return Err(StepError::Sql(e))
              }
            }
          }
        }
      }
      for i in 0..<rows.length() {
        let _ = match tx_db.run(l.put, [t, sql_db::row_val(rows[i], "n")]) {
          Ok(k) => k
          Err(e) => return Err(StepError::Sql(e))
        }
      }
      let done = rows.length() < limit
      let reached = if rows.length() > 0 {
        sql_db::row_val(rows[rows.length() - 1], "n")
      } else {
        last
      }
      let _ = match tx_db.run(
        "UPDATE " + l.scopes + " SET last_n=CAST(? AS INTEGER),complete=? WHERE thread=?",
        [reached, base_codec::json_int(if done { 1 } else { 0 }), t],
      ) {
        Ok(k) => k
        Err(e) => return Err(StepError::Sql(e))
      }
      Ok(done)
    },
    fn(e : sql_db::SqlError) -> StepError { StepError::Sql(e) },
  )
}

/// One batch of the closed cards of `thread` (`closedCardsStep`).
pub fn closed_cards_step(
  db : sql_db::Db,
  thread : Int64,
  limit : Int = 64,
) -> Result[Bool, StepError] {
  lookup_step(db, closed_lookup_spec(), thread, limit)
}

/// One batch of the people's messages of `thread` (`peopleSinceStep`).
pub fn people_since_step(
  db : sql_db::Db,
  thread : Int64,
  limit : Int = 64,
) -> Result[Bool, StepError] {
  lookup_step(db, people_lookup_spec(), thread, limit)
}

/// Request dispatcher for `--builder closed-cards`.
pub fn closed_cards_dispatch(
  db : sql_db::Db,
  ask : base_codec::Json,
) -> Result[Option[Bool], StepError] {
  match json_get_last(ask, "thread") {
    Some(base_codec::Json::Num(thread, _)) => {
      match closed_cards_step(db, double_to_i64_saturating(thread), limit=64) {
        Ok(done) => Ok(Some(done))
        Err(e) => Err(e)
      }
    }
    _ => Ok(None)
  }
}

/// Request dispatcher for `--builder people-since`.
pub fn people_since_dispatch(
  db : sql_db::Db,
  ask : base_codec::Json,
) -> Result[Option[Bool], StepError] {
  match json_get_last(ask, "thread") {
    Some(base_codec::Json::Num(thread, _)) => {
      match people_since_step(db, double_to_i64_saturating(thread), limit=64) {
        Ok(done) => Ok(Some(done))
        Err(e) => Err(e)
      }
    }
    _ => Ok(None)
  }
}

pub fn run_closed_cards(db_path : String) -> Int {
  builder_loop(db_path, "closed card", closed_cards_dispatch)
}

pub fn run_people_since(db_path : String) -> Int {
  builder_loop(db_path, "people-time", people_since_dispatch)
}
