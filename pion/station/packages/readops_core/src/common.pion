// L0 core primitives, error types, process-lifetime `ReaderState`, and per-outer-request
// `ReadSignals` for the acyclic 5-package `readops` DAG (`readops_core`).

import "base_codec"
import "builders_core"
import "builders_search"
import "builders_usage"
import "js_json"
import "jscase"
import "locate"
import "sql_db"

/// Unified error type for all `readops_*` operations.
/// `Refused(status, message)` maps 1:1 to MB `suberror Refused(Int, String)`.
pub enum ReadError {
  Refused(Int, String)
  Sql(sql_db::SqlError)
  App(String)
}

pub fn refused(status : Int, message : String) -> ReadError {
  ReadError::Refused(status, message)
}

pub fn map_sql_err(e : sql_db::SqlError) -> ReadError {
  ReadError::Sql(e)
}

pub fn map_step_err(e : builders_core::StepError) -> ReadError {
  match e {
    builders_core::StepError::Sql(se) => ReadError::Sql(se)
    builders_core::StepError::App(msg) => ReadError::App(msg)
    builders_core::StepError::Fallback => ReadError::App("fallback")
  }
}

pub fn read_error_message(e : ReadError) -> String {
  match e {
    ReadError::Refused(_, m) => m
    ReadError::Sql(se) => se.message
    ReadError::App(m) => m
  }
}

// ── Process-lifetime state (`ReaderState`) vs per-outer-request signals (`ReadSignals`) ──

pub struct PlaceCache {
  pub listed : Map[String, (Double, Array[String])]
  pub mut mounted : Option[(Double, Array[String])]
}

pub fn PlaceCache::new() -> PlaceCache {
  PlaceCache::{ listed: Map::new(), mounted: None }
}

/// Process-lifetime state created once per `Reader` and passed explicitly to `readops_*` ops.
pub struct ReaderState {
  pub client : builders_core::ShellClient
  pub sep : String
  pub finder : locate::Finder
  pub tx_cache : builders_search::TranscriptCache
  pub place_cache : PlaceCache
  pub mut model_catalog : Map[String, base_codec::Json]
}

pub fn ReaderState::new(client : builders_core::ShellClient, sep : String) -> ReaderState {
  ReaderState::{
    client: client,
    sep: sep,
    finder: locate::Finder::new(client, sep),
    tx_cache: builders_search::TranscriptCache::new(),
    place_cache: PlaceCache::new(),
    model_catalog: Map::new(),
  }
}

/// Update `model_catalog` from an incoming `ask.catalog` object (retained even if the read errors).
pub fn ReaderState::learn_catalog(self : ReaderState, models : base_codec::Json) -> Unit {
  let next : Map[String, base_codec::Json] = Map::new()
  match models {
    base_codec::Json::Obj(fields) => {
      for i in 0..<fields.length() {
        let (k, v) = fields[i]
        next.set(k, v)
      }
    }
    _ => ()
  }
  self.model_catalog = next
}

/// Per-outer-request signals created fresh at top-level `Reader::answer` (shared into `changed`'s
/// recursive `answer_in`, never emitted on error, not used by `--serve`).
pub struct ReadSignals {
  pub mut prepare_up_jobs : Option[String]
  pub mut prepare_workspace_up_jobs : Bool
}

pub fn ReadSignals::new() -> ReadSignals {
  ReadSignals::{ prepare_up_jobs: None, prepare_workspace_up_jobs: false }
}

// ── 20 Pure Hoisted Helpers (exact L0 closure) ──

pub fn field(row : Map[String, base_codec::Json], name : String) -> base_codec::Json {
  match row.get(name) {
    Some(v) => v
    None => base_codec::json_null()
  }
}

pub fn jget(v : Option[js_json::JValue], k : String) -> Option[js_json::JValue] {
  match v {
    Some(js_json::JValue::Obj(_)) => {
      match v {
        Some(obj) => obj.get(k)
        None => None
      }
    }
    _ => None
  }
}

pub fn str_of(v : Option[js_json::JValue]) -> Option[String] {
  match v {
    Some(js_json::JValue::Str(u)) => Some(js_json::sanitize_str(u))
    _ => None
  }
}

fn abs_double(d : Double) -> Double {
  if d < 0.0 { -d } else { d }
}

pub fn js_text(v : base_codec::Json) -> String {
  match v {
    base_codec::Json::Str(s) => s
    base_codec::Json::Null => ""
    base_codec::Json::Num(n, _) => {
      if js_json::is_integer(n) && abs_double(n) < 1.0e21 {
        builders_core::double_to_i64_saturating(n).to_string()
      } else {
        sql_db::stringify_json(v)
      }
    }
    other => sql_db::stringify_json(other)
  }
}

pub fn num(v : base_codec::Json) -> Double {
  match v {
    base_codec::Json::Num(n, _) => n
    _ => 0.0
  }
}

/// Returns a JSON `Str` containing the JSON-serialized array of `ids` (for `json_each(?)`).
pub fn ids_json(ids : Array[base_codec::Json]) -> base_codec::Json {
  base_codec::json_str(sql_db::stringify_json(base_codec::json_arr(ids)))
}

pub fn col(r : Map[String, base_codec::Json], name : String) -> Option[base_codec::Json] {
  r.get(name)
}

pub fn or_null(v : Option[base_codec::Json]) -> base_codec::Json {
  match v {
    Some(x) => x
    None => base_codec::json_null()
  }
}

/// Put a column into an ordered object field list only if present (`Some(v)`).
pub fn put_col(
  out : Array[(String, base_codec::Json)],
  name : String,
  v : Option[base_codec::Json],
) -> Unit {
  match v {
    Some(x) => out.push((name, x))
    None => ()
  }
}

pub fn nan() -> Double {
  0.0 / 0.0
}

pub fn parsed_number(s : String) -> base_codec::Json {
  builders_usage::parsed_number(s)
}

pub fn arg_number(v : Option[base_codec::Json]) -> base_codec::Json {
  builders_usage::arg_number(v)
}

pub fn or_else(a : base_codec::Json, b : base_codec::Json) -> base_codec::Json {
  match a {
    base_codec::Json::Null => b
    _ => a
  }
}

pub fn parse_iso(at : String) -> Option[Double] {
  builders_usage::parse_iso(at)
}

/// `chatmarks.mbt:85-101` (`views.ts` `isMine`): whether person `p` is the viewer.
pub fn is_mine(viewer_email : String, slack : Array[String], p : base_codec::Json) -> Bool {
  match p {
    base_codec::Json::Obj(_) => ()
    _ => return false
  }
  let pid = match builders_core::json_get_last(p, "id") {
    Some(base_codec::Json::Str(s)) => s
    _ => ""
  }
  if pid == viewer_email {
    return true
  }
  match builders_core::json_get_last(p, "email") {
    Some(base_codec::Json::Str(e)) => {
      if jscase::lower(e) == jscase::lower(viewer_email) {
        return true
      }
    }
    _ => ()
  }
  match builders_core::json_get_last(p, "via") {
    Some(base_codec::Json::Str("slack")) => {
      let tail = match str_rev_find_byte(pid, 58) {
        Some(idx) => str_slice_bytes(pid, idx + 1, pid.to_bytes().length())
        None => pid
      }
      for i in 0..<slack.length() {
        if slack[i] == tail {
          return true
        }
      }
      false
    }
    _ => false
  }
}

pub fn said_before(d : String) -> String {
  if d == "all_done" {
    "final"
  } else if d == "need_decision" || d == "need_help" {
    "block"
  } else {
    d
  }
}

pub fn ending_of(d : String) -> String {
  if d == "final" {
    "all_done"
  } else if d == "block" || d == "need_decision" {
    "need_help"
  } else {
    d
  }
}

pub fn parsed_thread_links(v : base_codec::Json) -> Option[base_codec::Json] {
  match v {
    base_codec::Json::Str(s) => {
      if s == "" || builders_core::has_lone_surrogate(s) {
        return None
      }
      match sql_db::parse_json(s) {
        base_codec::JsonParseResult::Ok(base_codec::Json::Obj(_)) => {
          let obj = match sql_db::parse_json(s) {
            base_codec::JsonParseResult::Ok(j) => j
            _ => return None
          }
          let out : Array[(String, base_codec::Json)] = []
          match builders_core::json_get_last(obj, "web") {
            Some(base_codec::Json::Str(w)) => {
              if w != "" {
                out.push(("web", base_codec::json_str(w)))
              }
            }
            _ => ()
          }
          match builders_core::json_get_last(obj, "app") {
            Some(base_codec::Json::Str(a)) => {
              if a != "" {
                out.push(("app", base_codec::json_str(a)))
              }
            }
            _ => ()
          }
          if out.length() == 0 {
            None
          } else {
            Some(base_codec::json_obj(out))
          }
        }
        _ => None
      }
    }
    _ => None
  }
}

fn is_nan_or_inf(d : Double) -> Bool {
  d != d || d == (1.0 / 0.0) || d == (-1.0 / 0.0)
}

/// rows.ts `parseThreadTags`: JSON string array, trimmed, deduplicated, at most 3 tags.
pub fn parsed_thread_tags(v : base_codec::Json) -> Option[base_codec::Json] {
  let raw = match v {
    base_codec::Json::Str(s) => {
      if s == "" || builders_core::has_lone_surrogate(s) {
        return None
      }
      match sql_db::parse_json(s) {
        base_codec::JsonParseResult::Ok(base_codec::Json::Arr(xs)) => xs
        _ => return None
      }
    }
    base_codec::Json::Arr(xs) => xs
    _ => return None
  }
  let out : Array[base_codec::Json] = []
  let seen : Map[String, Bool] = Map::new()
  for i in 0..<raw.length() {
    match raw[i] {
      base_codec::Json::Str(s) => {
        let t = jscase::trim_white(s)
        if t == "" || js_json::utf16_len(t) > 48 || seen.contains(t) {
          continue
        }
        seen.set(t, true)
        out.push(base_codec::json_str(t))
        if out.length() >= 3 {
          break
        }
      }
      _ => ()
    }
  }
  if out.length() == 0 {
    None
  } else {
    Some(base_codec::json_arr(out))
  }
}

/// rows.ts `proposalOf`: inline project-creation proposal JSON on an entry.
pub fn parsed_proposal(v : base_codec::Json) -> Option[base_codec::Json] {
  let obj = match v {
    base_codec::Json::Str(s) => {
      if s == "" || builders_core::has_lone_surrogate(s) {
        return None
      }
      match sql_db::parse_json(s) {
        base_codec::JsonParseResult::Ok(parsed_j) => {
          match parsed_j {
            base_codec::Json::Obj(_) => parsed_j
            _ => return None
          }
        }
        _ => return None
      }
    }
    base_codec::Json::Obj(_) => v
    _ => return None
  }
  let id = match json_val(obj, "id") {
    Some(base_codec::Json::Str(s)) => if s != "" { s } else { return None }
    _ => return None
  }
  let name = match json_val(obj, "name") {
    Some(base_codec::Json::Str(s)) => if s != "" { s } else { return None }
    _ => return None
  }
  let status = match json_val(obj, "status") {
    Some(base_codec::Json::Str(s)) => {
      if s == "pending" || s == "accepted" || s == "reassigned" || s == "dismissed" {
        s
      } else {
        return None
      }
    }
    _ => return None
  }
  let out : Array[(String, base_codec::Json)] = [
    ("id", base_codec::json_str(id)),
    ("name", base_codec::json_str(name)),
    ("status", base_codec::json_str(status)),
  ]
  match json_val(obj, "note") {
    Some(base_codec::Json::Str(n)) => if n != "" { out.push(("note", base_codec::json_str(n))) }
    _ => ()
  }
  match json_val(obj, "refs") {
    Some(base_codec::Json::Arr(rs)) => {
      let refs : Array[base_codec::Json] = []
      for i in 0..<rs.length() {
        match rs[i] {
          base_codec::Json::Str(s) => {
            let t = jscase::trim_white(s)
            if t != "" {
              refs.push(base_codec::json_str(t))
            }
          }
          _ => ()
        }
      }
      if refs.length() > 0 {
        out.push(("refs", base_codec::json_arr(refs)))
      }
    }
    _ => ()
  }
  match json_val(obj, "proposer") {
    Some(base_codec::Json::Str(pr)) => if pr != "" { out.push(("proposer", base_codec::json_str(pr))) }
    _ => ()
  }
  match json_val(obj, "resolvedProject") {
    Some(base_codec::Json::Str(rp)) => out.push(("resolvedProject", base_codec::json_str(rp)))
    _ => ()
  }
  match json_val(obj, "resolvedBy") {
    Some(base_codec::Json::Str(rb)) => if rb != "" { out.push(("resolvedBy", base_codec::json_str(rb))) }
    _ => ()
  }
  match json_val(obj, "resolvedAt") {
    Some(base_codec::Json::Num(ra, _)) => {
      if !is_nan_or_inf(ra) {
        out.push(("resolvedAt", base_codec::json_num(ra)))
      }
    }
    _ => ()
  }
  Some(base_codec::json_obj(out))
}

pub fn thread_json(r : Map[String, base_codec::Json]) -> base_codec::Json {
  let out : Array[(String, base_codec::Json)] = []
  let pairs : Array[(String, String)] = [
    ("id", "id"),
    ("surface", "surface"),
    ("channel", "channel"),
    ("threadTs", "thread_ts"),
    ("title", "title"),
    ("autoTitle", "auto_title"),
    ("createdBy", "created_by"),
    ("createdAt", "created_at"),
    ("home", "home"),
    ("hiddenAt", "hidden_at"),
    ("hiddenBy", "hidden_by"),
    ("shownAt", "shown_at"),
  ]
  for i in 0..<pairs.length() {
    let (k, c) = pairs[i]
    put_col(out, k, col(r, c))
  }
  match col(r, "links") {
    Some(v) => {
      match parsed_thread_links(v) {
        Some(l) => out.push(("links", l))
        None => ()
      }
    }
    None => ()
  }
  match col(r, "project") {
    Some(base_codec::Json::Str(p)) => out.push(("project", base_codec::json_str(p)))
    _ => ()
  }
  match col(r, "project_locked") {
    Some(base_codec::Json::Num(n, _)) => {
      if n == 1.0 {
        out.push(("projectLocked", base_codec::json_bool(true)))
      }
    }
    _ => ()
  }
  match col(r, "tags") {
    Some(v) => {
      match parsed_thread_tags(v) {
        Some(ts) => out.push(("tags", ts))
        None => ()
      }
    }
    None => ()
  }
  base_codec::json_obj(out)
}

// ── Shared internal helpers for L0/L1/L2 ──

pub fn one(
  db : sql_db::Db,
  sql : String,
  params : Array[base_codec::Json],
) -> Result[Option[Map[String, base_codec::Json]], ReadError] {
  match db.all(sql, params) {
    Ok(rows) => if rows.length() > 0 { Ok(Some(rows[0])) } else { Ok(None) }
    Err(e) => Err(ReadError::Sql(e))
  }
}

pub fn json_val(j : base_codec::Json, key : String) -> Option[base_codec::Json] {
  builders_core::json_get_last(j, key)
}

pub fn json_val_or_null(j : base_codec::Json, key : String) -> base_codec::Json {
  match builders_core::json_get_last(j, key) {
    Some(v) => v
    None => base_codec::json_null()
  }
}

pub fn str_find_byte(s : String, target : Int) -> Option[Int] {
  let b = s.to_bytes()
  for i in 0..<b.length() {
    if (b[i].to_int() & 0xFF) == target {
      return Some(i)
    }
  }
  None
}

pub fn str_rev_find_byte(s : String, target : Int) -> Option[Int] {
  let b = s.to_bytes()
  let mut i = b.length() - 1
  while i >= 0 {
    if (b[i].to_int() & 0xFF) == target {
      return Some(i)
    }
    i = i - 1
  }
  None
}

pub fn str_slice_bytes(s : String, start : Int, end : Int) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let s0 = if start < 0 { 0 } else if start > n { n } else { start }
  let e0 = if end < 0 { 0 } else if end > n { n } else { end }
  if s0 >= e0 {
    return ""
  }
  let sb = StringBuilder::new()
  for i in s0..<e0 {
    sb.write_byte(b[i])
  }
  sb.to_string()
}

pub fn str_has_prefix(s : String, prefix : String) -> Bool {
  let sb = s.to_bytes()
  let pb = prefix.to_bytes()
  if pb.length() > sb.length() {
    return false
  }
  for i in 0..<pb.length() {
    if sb[i] != pb[i] {
      return false
    }
  }
  true
}

pub fn str_has_suffix(s : String, suffix : String) -> Bool {
  let sb = s.to_bytes()
  let xb = suffix.to_bytes()
  if xb.length() > sb.length() {
    return false
  }
  let off = sb.length() - xb.length()
  for i in 0..<xb.length() {
    if sb[off + i] != xb[i] {
      return false
    }
  }
  true
}

pub fn str_find_sub(haystack : String, needle : String) -> Option[Int] {
  let h = haystack.to_bytes()
  let n = needle.to_bytes()
  if n.length() == 0 {
    return Some(0)
  }
  if n.length() > h.length() {
    return None
  }
  let last = h.length() - n.length()
  for i in 0..<(last + 1) {
    let mut ok = true
    for j in 0..<n.length() {
      if h[i + j] != n[j] {
        ok = false
        break
      }
    }
    if ok {
      return Some(i)
    }
  }
  None
}

pub fn str_contains_sub(haystack : String, needle : String) -> Bool {
  match str_find_sub(haystack, needle) {
    Some(_) => true
    None => false
  }
}

pub fn str_split_byte(s : String, sep : Int) -> Array[String] {
  let b = s.to_bytes()
  let out : Array[String] = []
  let mut start = 0
  for i in 0..<b.length() {
    if (b[i].to_int() & 0xFF) == sep {
      out.push(str_slice_bytes(s, start, i))
      start = i + 1
    }
  }
  out.push(str_slice_bytes(s, start, b.length()))
  out
}

pub fn join_strings(parts : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  for i in 0..<parts.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(parts[i])
  }
  sb.to_string()
}

pub fn stable_sort[T](xs : Array[T], cmp : (T, T) -> Int) -> Array[T] {
  let n = xs.length()
  let buf : Array[T] = []
  for i in 0..<n {
    buf.push(xs[i])
  }
  if n <= 1 {
    return buf
  }
  let tmp : Array[T] = []
  for i in 0..<n {
    tmp.push(xs[i])
  }
  let mut width = 1
  while width < n {
    let mut i = 0
    while i < n {
      let mid = if i + width < n { i + width } else { n }
      let right = if i + 2 * width < n { i + 2 * width } else { n }
      let mut l = i
      let mut r = mid
      let mut k = i
      while l < mid && r < right {
        if cmp(buf[l], buf[r]) <= 0 {
          tmp[k] = buf[l]
          l = l + 1
        } else {
          tmp[k] = buf[r]
          r = r + 1
        }
        k = k + 1
      }
      while l < mid {
        tmp[k] = buf[l]
        l = l + 1
        k = k + 1
      }
      while r < right {
        tmp[k] = buf[r]
        r = r + 1
        k = k + 1
      }
      i = i + 2 * width
    }
    for j in 0..<n {
      buf[j] = tmp[j]
    }
    width = width * 2
  }
  buf
}

pub fn array_rev[T](xs : Array[T]) -> Array[T] {
  let out : Array[T] = []
  let mut i = xs.length() - 1
  while i >= 0 {
    out.push(xs[i])
    i = i - 1
  }
  out
}

pub fn row_to_json(r : Map[String, base_codec::Json]) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = []
  let keys = stable_sort(r.keys(), by_bytes)
  for i in 0..<keys.length() {
    let k = keys[i]
    match r.get(k) {
      Some(v) => fields.push((k, v))
      None => ()
    }
  }
  base_codec::json_obj(fields)
}

pub fn row_to_json_cols(
  r : Map[String, base_codec::Json],
  cols : Array[String],
) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = []
  for i in 0..<cols.length() {
    let k = cols[i]
    match r.get(k) {
      Some(v) => fields.push((k, v))
      None => ()
    }
  }
  base_codec::json_obj(fields)
}
