// Pure-Pion unit tests for `readops_core` (`place_wbtest.mbt`, `cyrb53`/`base36`/`canonical`, `url_util`, `common`).

import "base_codec"
import "js_json"
import "jscase"

fn assert(cond : Bool) -> Unit {
  if !cond {
    panic("assertion failed")
  }
}

fn test_fmt_num(d : Double) -> String {
  if d == 0.0 {
    "0"
  } else if js_json::is_safe_integer(d) {
    d.to_int64().to_string()
  } else {
    d.to_string()
  }
}

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => x == y
    (None, None) => true
    _ => false
  }
}

test "readops_core: place_wbtest protected folders (home and mounts)" {
  let prot = Protected::new("/", "/Users/me", ["/Volumes/Data/x", "/mnt/Share", "/mnt/Share/Deep"])
  let known = fn(p : String) -> Option[String] { protected_known(prot, jscase::lower(p)) }
  assert(opt_str_eq(known("/Users/me/Documents"), Some("/Users/me/Documents")))
  assert(opt_str_eq(known("/users/ME/documents/a/b"), Some("/Users/me/Documents")))
  assert(opt_str_eq(known("/Users/me/Library/CloudStorage/Box/f"), Some("/Users/me/Library/CloudStorage")))
  assert(opt_str_eq(known("/Users/me/Library/Mobile Documents"), Some("/Users/me/Library/Mobile Documents")))
  assert(opt_str_eq(known("/Users/me/DocumentsX"), None))
  assert(opt_str_eq(known("/Users/me/code"), None))
  assert(opt_str_eq(known("/mnt/share/deep/f"), Some("/mnt/Share/Deep")))
  assert(opt_str_eq(known("/mnt/Share/f"), Some("/mnt/Share")))
  assert(opt_str_eq(known("/Volumes/Data/x/f"), None))
  assert(opt_str_eq(known("/mnt/Shared"), None))
}

test "readops_core: cyrb53 32-bit imul wraparound and base36 vectors" {
  // Exact JS/MB cyrb53 vectors verified against Node / `client/core-ts/src/digest.ts`:
  assert(cyrb53("").to_string() == "3338908027751811")
  assert(base36(cyrb53("")) == "wvjl67o803")
  assert(cyrb53("hello").to_string() == "4625896200565286")
  assert(base36(cyrb53("hello")) == "19jqrdkps12")
  // Non-BMP emoji (UTF-16 surrogate pair 0xD83D 0xDE00)
  assert(cyrb53("a😀b").to_string() == "4276530243625572")
  assert(base36(cyrb53("a😀b")) == "163wivebdd0")
  assert(base36(0.to_int64()) == "0")
  assert(base36(35.to_int64()) == "z")
  assert(base36(36.to_int64()) == "10")
}

test "readops_core: canonical sorts object keys in UTF-16 order" {
  let obj = base_codec::json_obj([
    ("z", base_codec::json_int(1)),
    ("a", base_codec::json_obj([("b", base_codec::json_bool(true)), ("a", base_codec::json_null())])),
  ])
  let sb = StringBuilder::new()
  canonical_with(sb, obj, test_fmt_num)
  assert(sb.to_string() == "{\"a\":{\"a\":null,\"b\":true},\"z\":1}")
  let d = digest_with(obj, test_fmt_num)
  assert(d == base36(cyrb53("{\"a\":{\"a\":null,\"b\":true},\"z\":1}")))
}

test "readops_core: url_util encode_uri_component and percent_decode_lossy" {
  assert(encode_uri_component("a b/é!") == "a%20b%2F%C3%A9!")
  assert(encode_uri_component("a/b?c=1") == "a%2Fb%3Fc%3D1")
  assert(percent_decode_lossy("a%20b+c%zz", plus_space=true) == "a b c%zz")
  assert(percent_decode_lossy("a%20b+c%e4%b8%ad%zz", plus_space=true) == "a b c中%zz")
  assert(percent_decode_lossy("a%20b+c", plus_space=false) == "a b+c")
}

test "readops_core: common helpers is_mine, said_before, ending_of, parsed_thread_links" {
  assert(said_before("all_done") == "final")
  assert(said_before("need_decision") == "block")
  assert(said_before("need_help") == "block")
  assert(said_before("waiting") == "waiting")
  assert(ending_of("final") == "all_done")
  assert(ending_of("block") == "need_help")
  assert(ending_of("need_decision") == "need_help")
  assert(ending_of("waiting") == "waiting")

  let p_email = base_codec::json_obj([
    ("id", base_codec::json_str("u1")),
    ("email", base_codec::json_str("Alice@Example.com")),
  ])
  assert(is_mine("alice@example.com", [], p_email))
  let p_slack = base_codec::json_obj([
    ("id", base_codec::json_str("slack:c1:U999")),
    ("via", base_codec::json_str("slack")),
  ])
  assert(is_mine("bob@example.com", ["U999"], p_slack))
  assert(!is_mine("bob@example.com", ["U888"], p_slack))

  match parsed_thread_links(base_codec::json_str("{\"web\":\"https://a\",\"extra\":1}")) {
    Some(l) => assert(base_codec::json_stringify(l) == "{\"web\":\"https://a\"}")
    None => panic("expected parsed links")
  }
  assert(parsed_thread_links(base_codec::json_str("{}")) is None)
}

test "readops_core: background tally preserves distinct raw UTF-16 keys through lossless JSON roundtrip" {
  let d_lone = js_json::jval_try_parse("{\"result\":{\"selected\":\"\\uD800\"},\"accepted\":true}")
  let d_fffd = js_json::jval_try_parse("{\"result\":{\"selected\":\"\\uFFFD\"},\"accepted\":false}")
  let d_lone2 = js_json::jval_try_parse("{\"result\":{\"selected\":\"\\uD800\"},\"accepted\":false}")
  let (failed, opts_jv) = tally_background_selected_jval([
    ("s1", base_codec::json_int(1), d_lone),
    ("s2", base_codec::json_int(2), d_fffd),
    ("s3", base_codec::json_int(3), d_lone2),
  ])
  assert(failed == 0)
  // Serialize losslessly via js_json::stringify_with_num and parse back to assert distinct keys, counts, and sessions.
  let wire = js_json::stringify_with_num(opts_jv, test_fmt_num)
  let reparsed = match js_json::parse(wire) {
    Ok(v) => v
    Err(e) => panic("roundtrip parse failed: " + e)
  }
  match reparsed {
    js_json::JValue::Obj(entries) => {
      assert(entries.length() == 2)
      let (k0, v0) = entries[0]
      let (k1, v1) = entries[1]
      // Key 0 is raw lone high surrogate 0xD800 (count=2, sessions s1 & s3)
      assert(k0.length() == 1 && k0[0] == 0xD800)
      match js_json::jval_num_of(js_json::jval_at(Some(v0), "count")) {
        Some(c) => assert(c == 2.0)
        None => panic("expected count 2")
      }
      let chats0 = js_json::jval_arr(js_json::jval_at(Some(v0), "chats"))
      assert(chats0.length() == 2)
      assert(opt_str_eq(str_of(js_json::jval_at(Some(chats0[0]), "session")), Some("s1")))
      assert(opt_str_eq(str_of(js_json::jval_at(Some(chats0[1]), "session")), Some("s3")))
      // Key 1 is literal U+FFFD (count=1, session s2)
      assert(k1.length() == 1 && k1[0] == 0xFFFD)
      match js_json::jval_num_of(js_json::jval_at(Some(v1), "count")) {
        Some(c) => assert(c == 1.0)
        None => panic("expected count 1")
      }
      let chats1 = js_json::jval_arr(js_json::jval_at(Some(v1), "chats"))
      assert(chats1.length() == 1)
      assert(opt_str_eq(str_of(js_json::jval_at(Some(chats1[0]), "session")), Some("s2")))
    }
    _ => panic("expected JValue::Obj")
  }
}

test "readops_core: places_from_jvals keeps remote lone-surrogate keys distinct from U+FFFD while preserving local config sanitization" {
  let remote_both = match js_json::parse(
    "{\"\\ufffd\":{\"described\":{\"kind\":\"feishu\"}},\"\\ud800\":{\"described\":{\"kind\":\"slack\",\"team\":\"T2\"}}}",
  ) {
    Ok(v) => v
    Err(_) => js_json::JValue::Null
  }
  let m_remote = places_from_jvals(remote_both, js_json::JValue::Obj([]))
  match m_remote.get("\u{FFFD}") {
    Some(p) => assert(p.book == "feishu" && p.id == "\u{FFFD}")
    None => assert(false)
  }

  let remote_lone_only = match js_json::parse("{\"\\ud800\":{\"described\":{\"kind\":\"slack\",\"team\":\"T2\"}}}") {
    Ok(v) => v
    Err(_) => js_json::JValue::Null
  }
  let m_lone = places_from_jvals(remote_lone_only, js_json::JValue::Obj([]))
  match m_lone.get("\u{FFFD}") {
    None => ()
    Some(_) => assert(false)
  }

  // Control group: local config.json retains MB `str_of` sanitization behavior unchanged.
  let own_both = match js_json::parse(
    "{\"connects\":[{\"id\":\"\\ufffd\",\"kind\":\"feishu\"},{\"id\":\"\\ud800\",\"kind\":\"group\"}]}",
  ) {
    Ok(v) => v
    Err(_) => js_json::JValue::Null
  }
  let m_local = places_from_jvals(js_json::JValue::Obj([]), own_both)
  match m_local.get("\u{FFFD}") {
    Some(p) => assert(p.book == "group" && p.id == "\u{FFFD}")
    None => assert(false)
  }
}

test "readops_core: join_path Windows drive check uses UTF-16 code unit positions" {
  assert(join_path("\\", "C:\\base", "D:\\sub") == "D:\\sub")
  assert(join_path("\\", "C:\\base", "D:/sub") == "D:/sub")
  assert(join_path("\\", "C:\\base", "é:/x") == "é:/x")
  assert(join_path("\\", "C:\\base", "é:\\x") == "é:\\x")
  assert(join_path("\\", "C:\\base", "rel\\path") == "C:\\base\\rel\\path")
  // Surrogate pair occupies 2 UTF-16 units, so ':' is at unit index 2, not 1 -> relative.
  assert(join_path("\\", "C:\\base", "😀:/x") == "C:\\base\\😀:/x")
}

test "readops_core: row_to_json and row_to_json_cols have deterministic column order" {
  let row : Map[String, base_codec::Json] = Map::new()
  row.set("signature", base_codec::json_str("sig"))
  row.set("body", base_codec::json_str("b"))
  assert(base_codec::json_stringify(row_to_json(row)) == "{\"body\":\"b\",\"signature\":\"sig\"}")
  assert(
    base_codec::json_stringify(row_to_json_cols(row, ["signature", "body"])) ==
    "{\"signature\":\"sig\",\"body\":\"b\"}",
  )
}

test "readops_core: thread_json includes project, projectLocked, and tags" {
  let row : Map[String, base_codec::Json] = Map::new()
  row.set("id", base_codec::json_int(1))
  row.set("surface", base_codec::json_str("chat"))
  row.set("project", base_codec::json_str("monoid"))
  row.set("project_locked", base_codec::json_int(1))
  row.set("tags", base_codec::json_str("[\" ui \", \"ui\", \"ops\"]"))
  let got = base_codec::json_stringify(thread_json(row))
  assert(
    got == "{\"id\":1,\"surface\":\"chat\",\"project\":\"monoid\",\"projectLocked\":true,\"tags\":[\"ui\",\"ops\"]}",
  )
}

test "readops_core: tally_background_selected_json_str preserves numeric key order, lone surrogate keys, and >2^53 at repr" {
  let d10 = js_json::jval_try_parse("{\"result\":{\"selected\":\"10\"},\"accepted\":true}")
  let d2 = js_json::jval_try_parse("{\"result\":{\"selected\":\"2\"},\"accepted\":false}")
  let d1 = js_json::jval_try_parse("{\"result\":{\"selected\":\"1\"},\"accepted\":true}")
  let dlone = js_json::jval_try_parse("{\"result\":{\"selected\":\"\\ud800\"},\"accepted\":false}")
  let dfffd = js_json::jval_try_parse("{\"result\":{\"selected\":\"\\ufffd\"},\"accepted\":true}")
  let big_at = base_codec::Json::Num(9007199254740993.0, "9007199254740993")
  let wire = tally_background_selected_json_str_with(
    5,
    [
      ("s10", big_at, d10),
      ("s2", base_codec::json_int(2), d2),
      ("s1", base_codec::json_int(1), d1),
      ("sl", base_codec::json_int(3), dlone),
      ("sf", base_codec::json_int(4), dfffd),
    ],
    base_codec::json_stringify,
  )
  assert(
    wire ==
    "{\"checked\":5,\"failed\":0,\"options\":{\"10\":{\"count\":1,\"chats\":[{\"session\":\"s10\",\"at\":9007199254740993,\"recommended\":true}]},\"2\":{\"count\":1,\"chats\":[{\"session\":\"s2\",\"at\":2,\"recommended\":false}]},\"1\":{\"count\":1,\"chats\":[{\"session\":\"s1\",\"at\":1,\"recommended\":true}]},\"\\ud800\":{\"count\":1,\"chats\":[{\"session\":\"sl\",\"at\":3,\"recommended\":false}]},\"\u{FFFD}\":{\"count\":1,\"chats\":[{\"session\":\"sf\",\"at\":4,\"recommended\":true}]}}}",
  )
}
