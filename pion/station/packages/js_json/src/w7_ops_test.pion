// Pure-Pion parity unit tests for Wave 7 `js_json` additions.

import "base_codec"

fn assert(cond : Bool) -> Unit {
  if !cond {
    panic("assertion failed")
  }
}

fn test_fmt_num(d : Double) -> String {
  if d == 0.0 {
    "0"
  } else if is_safe_integer(d) {
    d.to_int64().to_string()
  } else {
    d.to_string()
  }
}

test "js_json: jval_truthy parity" {
  assert(!jval_truthy(None))
  assert(!jval_truthy(Some(JValue::Null)))
  assert(!jval_truthy(Some(JValue::Bool(false))))
  assert(jval_truthy(Some(JValue::Bool(true))))
  assert(!jval_truthy(Some(JValue::Num(0.0))))
  assert(!jval_truthy(Some(JValue::Num(-0.0))))
  assert(!jval_truthy(Some(JValue::Num(0.0 / 0.0))))
  assert(jval_truthy(Some(JValue::Num(1.0))))
  assert(jval_truthy(Some(JValue::Num(-0.5))))
  assert(!jval_truthy(Some(JValue::Str([]))))
  assert(jval_truthy(Some(JValue::Str([97]))))
  assert(jval_truthy(Some(JValue::Arr([]))))
  assert(jval_truthy(Some(JValue::Obj([]))))
}

test "js_json: is_integer vs is_safe_integer above 2^53" {
  assert(is_integer(0.0))
  assert(is_integer(-0.0))
  assert(is_integer(42.0))
  assert(is_integer(-42.0))
  assert(!is_integer(1.5))
  assert(!is_integer(-0.1))
  assert(!is_integer(0.0 / 0.0))
  assert(!is_integer(1.0 / 0.0))
  assert(!is_integer(-1.0 / 0.0))

  // At 2^53 - 1: both true
  assert(is_integer(9007199254740991.0))
  assert(is_safe_integer(9007199254740991.0))
  // At 2^53 and beyond: is_integer is true, is_safe_integer is false!
  assert(is_integer(9007199254740992.0))
  assert(!is_safe_integer(9007199254740992.0))
  assert(is_integer(-9007199254740992.0))
  assert(!is_safe_integer(-9007199254740992.0))
  assert(is_integer(1e20))
  assert(!is_safe_integer(1e20))
  assert(!is_integer(4503599627370495.5))
}

test "js_json: js_number_parse parity" {
  assert(js_number_parse("") == 0.0)
  assert(js_number_parse("   \t\n\u{00A0}  ") == 0.0)
  assert(js_number_parse("007") == 7.0)
  assert(js_number_parse("+42") == 42.0)
  assert(js_number_parse("-3.5") == -3.5)
  assert(js_number_parse(".5") == 0.5)
  assert(js_number_parse("5.") == 5.0)
  assert(js_number_parse("5.e2") == 500.0)
  assert(js_number_parse("0x10") == 16.0)
  assert(js_number_parse("0Xff") == 255.0)
  assert(js_number_parse("0o10") == 8.0)
  assert(js_number_parse("0b101") == 5.0)
  let pos_inf = js_number_parse("Infinity")
  assert(pos_inf > 0.0 && pos_inf == 1.0 / 0.0)
  let plus_inf = js_number_parse("+Infinity")
  assert(plus_inf > 0.0 && plus_inf == 1.0 / 0.0)
  let neg_inf = js_number_parse("-Infinity")
  assert(neg_inf < 0.0 && neg_inf == -1.0 / 0.0)
  let nan1 = js_number_parse("abc")
  assert(nan1 != nan1)
  let nan2 = js_number_parse("12px")
  assert(nan2 != nan2)
  let nan3 = js_number_parse("0x1g")
  assert(nan3 != nan3)
}

test "js_json: json_js_str_with parity" {
  assert(json_js_str_with(None, test_fmt_num) == "undefined")
  assert(json_js_str_with(Some(base_codec::json_null()), test_fmt_num) == "null")
  assert(json_js_str_with(Some(base_codec::json_bool(true)), test_fmt_num) == "true")
  assert(json_js_str_with(Some(base_codec::json_bool(false)), test_fmt_num) == "false")
  assert(json_js_str_with(Some(base_codec::json_str("hi")), test_fmt_num) == "hi")
  assert(json_js_str_with(Some(base_codec::json_int(42)), test_fmt_num) == "42")
  assert(json_js_str_with(Some(base_codec::json_obj([])), test_fmt_num) == "[object Object]")
  let arr = base_codec::json_arr([
    base_codec::json_int(1),
    base_codec::json_null(),
    base_codec::json_str("a"),
    base_codec::json_obj([]),
  ])
  assert(json_js_str_with(Some(arr), test_fmt_num) == "1,,a,[object Object]")
}

test "js_json: chars counts surrogate pairs and lone surrogates as 1" {
  // [ 'A', 0xD83D, 0xDE00 (emoji), 0xD800 (lone high), 'B' ]
  let units = [65, 0xD83D, 0xDE00, 0xD800, 66]
  let c0 = chars(units, 0)
  assert(c0.length() == 0)
  let c1 = chars(units, 1)
  assert(units_eq(c1, [65]))
  let c2 = chars(units, 2)
  assert(units_eq(c2, [65, 0xD83D, 0xDE00]))
  let c3 = chars(units, 3)
  assert(units_eq(c3, [65, 0xD83D, 0xDE00, 0xD800]))
  let c4 = chars(units, 4)
  assert(units_eq(c4, units))
  let c9 = chars(units, 9)
  assert(units_eq(c9, units))
}

test "js_json: JValue::to_json_lossy preserves insertion order and deduplicates sanitized keys" {
  let jv = match parse("{\"b\":1,\"2\":2,\"0\":3,\"b\":4}") {
    Ok(v) => v
    Err(e) => panic(e)
  }
  assert(base_codec::json_stringify(jv.to_json_lossy()) == "{\"b\":4,\"2\":2,\"0\":3}")
  // Escaped lone high surrogate and literal U+FFFD sanitize to the same key -> last-wins, no duplicate JSON field
  let colliding = match parse("{\"\\uD800\":1,\"\\uFFFD\":2,\"a\":3}") {
    Ok(v) => v
    Err(e) => panic(e)
  }
  assert(base_codec::json_stringify(colliding.to_json_lossy()) == "{\"\u{FFFD}\":2,\"a\":3}")
  assert(base_codec::json_stringify(colliding.to_json()) == "{\"\u{FFFD}\":2,\"a\":3}")
}

test "js_json: JValue::to_json orders integer keys and maps non-finite to null" {
  let jv = match parse("{\"b\":1,\"2\":2,\"0\":3,\"b\":4}") {
    Ok(v) => v
    Err(e) => panic(e)
  }
  let j = jv.to_json()
  assert(base_codec::json_stringify(j) == "{\"0\":3,\"2\":2,\"b\":4}")
  assert(base_codec::json_eq(JValue::Num(0.0 / 0.0).to_json(), base_codec::json_null()))
  assert(base_codec::json_eq(JValue::Num(1.0 / 0.0).to_json(), base_codec::json_null()))
}
