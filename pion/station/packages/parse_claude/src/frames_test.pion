// 1:1 port of `station/mb/src/claude/frames_test.mbt` + lone-surrogate UTF-16 round-trip tests.

import "js_json"
import "live_wire"

fn assert_eq_str(got : String, want : String, ctx : String) -> Unit {
  if got != want {
    panic(ctx + ": got=" + got + " want=" + want)
  }
}

fn assert_eq_bool(got : Bool, want : Bool, ctx : String) -> Unit {
  if got != want {
    panic(ctx + ": bool mismatch")
  }
}

fn assert_eq_int(got : Int, want : Int, ctx : String) -> Unit {
  if got != want {
    panic(ctx + ": got=" + got.to_string() + " want=" + want.to_string())
  }
}

fn assert_eq_arr(got : Array[String], want : Array[String], ctx : String) -> Unit {
  if got.length() != want.length() {
    panic(ctx + ": len got=" + got.length().to_string() + " want=" + want.length().to_string())
  }
  for i in 0..<got.length() {
    if got[i] != want[i] {
      panic(ctx + "[" + i.to_string() + "]: got=" + got[i] + " want=" + want[i])
    }
  }
}

fn claude_fmt_num(d : Double) -> String {
  if d == 0.0 {
    "0"
  } else if js_json::is_safe_integer(d) {
    d.to_int64().to_string()
  } else {
    d.to_string()
  }
}

fn jparse(s : String) -> js_json::JValue {
  match js_json::parse(s) {
    Ok(v) => v
    Err(e) => panic("bad json: " + e)
  }
}

fn jstr_out(v : js_json::JValue) -> String {
  js_json::stringify_with_num(v, claude_fmt_num)
}

fn rep(s : String, n : Int) -> String {
  let out = StringBuilder::new()
  for _ in 0..<n {
    out.write_string(s)
  }
  out.to_string()
}

fn outcomes(frames : Array[String], turn : Turn) -> Array[String] {
  let out : Array[String] = []
  for i in 0..<frames.length() {
    on_frame_with(
      jparse(frames[i]),
      turn,
      fn(e : js_json::JValue) -> Unit {
        if live_wire::is_str(e.get("type"), "turnEnded") {
          match e.get("outcome") {
            Some(o) => out.push(jstr_out(o))
            None => panic("missing outcome")
          }
        }
      },
      fn() -> Unit { () },
      fn() -> Double { 0.0 },
      fn(_ : String) -> Unit { () },
      claude_fmt_num,
    )
  }
  out
}

