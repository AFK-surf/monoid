  for i in 0..<cases.length() {
    let (text, reason, is_refused, utf16_len) = cases[i]
    assert_eq_str(classify_result(text), reason, "classify:" + text)
    assert_eq_bool(refused(text), is_refused, "refused:" + text)
    assert_eq_int(chars_u16(js_json::utf16_units(text), 1000).length(), utf16_len, "chars:" + text)
  }
}

test "parse_claude: a failed result is told apart by what claude said; is_error decides, not subtype" {
  let texts : Array[String] = [
    "You've hit your 5-hour limit · resets 7:50am (UTC)",
    "You've hit your 5 hour limit",
    "You've hit your 3-hour limit",
  ]
  for i in 0..<texts.length() {
    let said = jstr_out(live_wire::jstr(texts[i]))
    assert_eq_arr(
      outcomes(["{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":true,\"result\":" + said + "}"], Turn::new()),
      ["{\"kind\":\"failed\",\"reason\":\"rate_limit\",\"message\":" + said + "}"],
      "is_error true",
    )
    assert_eq_arr(
      outcomes(["{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":" + said + "}"], Turn::new()),
      ["{\"kind\":\"completed\"}"],
      "is_error false",
    )
  }
  assert_eq_arr(
    outcomes(
      ["{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":true,\"result\":\"API Error: 401 invalid x-api-key\"}"],
      Turn::new(),
    ),
    ["{\"kind\":\"failed\",\"reason\":\"auth\",\"message\":\"API Error: 401 invalid x-api-key\"}"],
    "401 auth",
  )
  let long_s = jstr_out(live_wire::jstr(rep("😀", 1001)))
  let want_s = jstr_out(live_wire::jstr(rep("😀", 1000)))
  assert_eq_arr(
    outcomes(["{\"type\":\"result\",\"is_error\":true,\"result\":" + long_s + "}"], Turn::new()),
    ["{\"kind\":\"failed\",\"reason\":\"model\",\"message\":" + want_s + "}"],
    "1000 chars surrogate pair",
  )
}

test "parse_claude: a turn that failed with no result says claude's errors, not just error_during_execution" {
  assert_eq_arr(
    outcomes(
      [
        "{\"type\":\"result\",\"subtype\":\"error_during_execution\",\"is_error\":true,\"num_turns\":0,\"errors\":[\"No conversation found with session ID: 1\"]}",
      ],
      Turn::new(),
    ),
    ["{\"kind\":\"failed\",\"reason\":\"model\",\"message\":\"No conversation found with session ID: 1\"}"],
    "errors fallback",
  )
  assert_eq_arr(
    outcomes(
      ["{\"type\":\"result\",\"subtype\":\"error_during_execution\",\"is_error\":true,\"errors\":[]}"],
      Turn::new(),
    ),
    ["{\"kind\":\"failed\",\"reason\":\"model\",\"message\":\"error_during_execution\"}"],
    "subtype fallback",
  )
}

test "parse_claude: a 401 or 403 as it retries fails the turn as the account's, or as refused where it says so" {
  let end = "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"\"}"
  assert_eq_arr(
    outcomes(
      [
        "{\"type\":\"system\",\"subtype\":\"api_retry\",\"error_status\":401,\"attempt\":1,\"error\":\"authentication_failed\"}",
        end,
      ],
      Turn::new(),
    ),
    ["{\"kind\":\"failed\",\"reason\":\"auth\",\"message\":\"401 authentication_failed\"}"],
    "401 retry",
  )
  assert_eq_arr(
    outcomes(
      [
        "{\"type\":\"system\",\"subtype\":\"api_retry\",\"error_status\":403,\"attempt\":1,\"error\":\"Request not allowed\"}",
        end,
      ],
      Turn::new(),
    ),
    ["{\"kind\":\"failed\",\"reason\":\"refused\",\"message\":\"403 Request not allowed\"}"],
    "403 refused retry",
  )
}

test "parse_claude: a /compact that compacted nothing ends failed, saying why; one that did, completed" {
  let turn = Turn::new()
  turn.busy = true
  turn.compacting = Some(true)
  assert_eq_arr(
    outcomes(
      [
        "{\"type\":\"system\",\"subtype\":\"status\",\"status\":\"compacting\"}",
        "{\"type\":\"system\",\"subtype\":\"status\",\"status\":null,\"compact_result\":\"failed\",\"compact_error\":\"Not enough messages to compact.\"}",
        "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false}",
      ],
      turn,
    ),
    ["{\"kind\":\"failed\",\"reason\":\"other\",\"message\":\"Not enough messages to compact.\"}"],
    "compact failed",
  )
  match turn.compacting {
    Some(false) => ()
    _ => panic("expected turn.compacting == Some(false)")
  }
  turn.busy = true
  assert_eq_arr(
    outcomes(
      [
        "{\"type\":\"system\",\"subtype\":\"status\",\"status\":null,\"compact_result\":\"failed\",\"compact_error\":\"x\"}",
        "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false}",
      ],
      turn,
    ),
    ["{\"kind\":\"completed\"}"],
    "auto compact failed ignored",
  )
}

test "parse_claude: Claude Code's compact_boundary, automatic or by hand, says it compacted" {
  let told : Array[String] = []
  let turn = Turn::new()
  turn.busy = true
  let triggers : Array[String] = ["auto", "manual"]
  for i in 0..<triggers.length() {
    on_frame_with(
      jparse(
        "{\"type\":\"system\",\"subtype\":\"compact_boundary\",\"compact_metadata\":{\"trigger\":\"" +
        triggers[i] +
        "\",\"pre_tokens\":180000}}",
      ),
      turn,
      fn(e : js_json::JValue) -> Unit { told.push(jstr_out(e)) },
      fn() -> Unit { () },
      fn() -> Double { 0.0 },
      fn(_ : String) -> Unit { () },
      claude_fmt_num,
    )
  }
  assert_eq_arr(told, ["{\"type\":\"compacted\"}", "{\"type\":\"compacted\"}"], "compact_boundary")
}

test "parse_claude: an API key's credits run out: a limit, so another account takes the session on" {
  let texts : Array[String] = [
    "Credit balance is too low",
    "API Error: 400 {\"type\":\"error\",\"error\":{\"type\":\"invalid_request_error\",\"message\":\"Your credit balance is too low to access the Anthropic API. Please go to Plans & Billing to upgrade or purchase credits.\"}}",
  ]
  for i in 0..<texts.length() {
    assert_eq_str(classify_result(texts[i]), "rate_limit", "classify_result credit")
    assert_eq_str(failure_of(texts[i]), "rate_limit", "failure_of credit")
  }
}

test "parse_claude: lone surrogate round-trip in Live, Turn, and tools_lost_in" {
  // Distinct lone surrogates \ud800 and \ud801 in tool ids, deltas, state snapshot
  let live = Live::new()
  let _ = live.feed_with(
    jparse("{\"type\":\"stream_event\",\"event\":{\"type\":\"message_start\",\"message\":{\"id\":\"m\\ud800\"}}}"),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  let ev1 = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"tool_use\",\"id\":\"t\\ud800\",\"name\":\"bash\"}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  let ev2 = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":1,\"content_block\":{\"type\":\"tool_use\",\"id\":\"t\\ud801\",\"name\":\"bash\"}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  assert_eq_str(
    jstr_out(ev1[0]),
    "{\"kind\":\"start\",\"id\":\"t\\ud800\",\"step\":\"tool\",\"tool\":\"bash\"}",
    "start ud800",
  )
  assert_eq_str(
    jstr_out(ev2[0]),
    "{\"kind\":\"start\",\"id\":\"t\\ud801\",\"step\":\"tool\",\"tool\":\"bash\"}",
    "start ud801",
  )
  let snap = live.state()
  let sb = StringBuilder::new()
  js_json::write_utf8_with_num(sb, snap, claude_fmt_num)
  let again = Live::of_state(jparse(sb.to_string()))
  let sb2 = StringBuilder::new()
  js_json::write_utf8_with_num(sb2, again.state(), claude_fmt_num)
  assert_eq_str(sb2.to_string(), sb.to_string(), "live state roundtrip")

  // Closing t\ud800 must NOT close t\ud801
  let end_ev = again.feed_with(
    jparse(
      "{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"t\\ud800\",\"content\":\"out\\udc00\"}]}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  assert_eq_int(end_ev.length(), 2, "tool_result ud800 events")
  assert_eq_str(
    jstr_out(end_ev[0]),
    "{\"kind\":\"delta\",\"id\":\"t\\ud800\",\"field\":\"output\",\"text\":\"out\\udc00\"}",
    "tool_result delta",
  )
  assert_eq_int(again.tools.length(), 1, "t\\ud801 still open")

  // Result error message with lone surrogate preserved verbatim
  let res = outcomes(
    ["{\"type\":\"result\",\"is_error\":true,\"result\":\"err \\ud800 and \\ud801\"}"],
    Turn::new(),
  )
  assert_eq_arr(
    res,
    ["{\"kind\":\"failed\",\"reason\":\"model\",\"message\":\"err \\ud800 and \\ud801\"}"],
    "result lone surrogate",
  )

  // tools_lost_in: register two pending MCP tool calls differing only by lone surrogate
  let calls : Array[Array[Int]] = []
  let reg = tools_lost_in(
    jparse(
      "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"mcp\\ud800\",\"name\":\"mcp__stillfail__post\"},{\"type\":\"tool_use\",\"id\":\"mcp\\ud801\",\"name\":\"mcp__stillfail__post\"}]}}",
    ),
    calls,
  )
  match reg {
    None => ()
    Some(_) => panic("expected None on tool_use registration")
  }
  assert_eq_int(calls.length(), 2, "two distinct lone-surrogate MCP calls")
  let lost = tools_lost_in(
    jparse(
      "{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"mcp\\ud800\",\"is_error\":true,\"content\":\"ECONNREFUSED \\udc00\"}]}}",
    ),
    calls,
  )
  match lost {
    Some(why) => {
      assert_eq_str(
        jstr_out(live_wire::jstr_u16(why)),
        "\"ECONNREFUSED \\udc00\"",
        "tools_lost_in preserves lone surrogate",
      )
    }
    None => panic("expected Some why from tools_lost_in")
  }
  assert_eq_int(calls.length(), 1, "second MCP call mcp\\ud801 still pending")
  assert_eq_str(
    jstr_out(live_wire::jstr_u16(calls[0])),
    "\"mcp\\ud801\"",
    "remaining pending call is mcp\\ud801",
  )

  // Turn.tasks, background_of, and auth_failure preserve lone surrogates
  let turn = Turn::new()
  let task_evs : Array[String] = []
  on_frame_with(
    jparse(
      "{\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"tk\\ud800\",\"task_type\":\"local_agent\",\"description\":\"desc\\ud801\",\"is_backgrounded\":true}",
    ),
    turn,
    fn(e : js_json::JValue) -> Unit { task_evs.push(jstr_out(e)) },
    fn() -> Unit { () },
    fn() -> Double { 123.0 },
    fn(_ : String) -> Unit { () },
    claude_fmt_num,
  )
  assert_eq_str(
    jstr_out(background_of(turn)),
    "[{\"id\":\"tk\\ud800\",\"kind\":\"agent\",\"description\":\"desc\\ud801\",\"startedAt\":123}]",
    "background_of lone surrogate",
  )
  assert_eq_int(task_evs.length(), 1, "background tasks live event emitted")

  let auth_turn = Turn::new()
  let auth_out = outcomes(
    [
      "{\"type\":\"system\",\"subtype\":\"api_retry\",\"error_status\":401,\"attempt\":1,\"error\":\"tok\\ud800\"}",
      "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"\"}",
    ],
    auth_turn,
  )
  assert_eq_arr(
    auth_out,
    ["{\"kind\":\"failed\",\"reason\":\"auth\",\"message\":\"401 tok\\ud800\"}"],
    "auth_failure lone surrogate",
  )
}

test "parse_claude: Live streaming input_json_delta, INPUT_MOST cap, content_block_stop, estimated_tokens, and parent_tool_use_id" {
  let live = Live::new()
  let _ = live.feed_with(
    jparse("{\"type\":\"stream_event\",\"event\":{\"type\":\"message_start\",\"message\":{\"id\":\"m1\"}}}"),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  // Thinking block with parent_tool_use_id and estimated_tokens
  let s_think = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"parent_tool_use_id\":\"p\\ud800\",\"event\":{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"thinking\"}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  assert_eq_str(
    jstr_out(s_think[0]),
    "{\"kind\":\"start\",\"id\":\"m1:0\",\"step\":\"thinking\",\"subagent\":true,\"parent\":\"p\\ud800\"}",
    "subagent start",
  )
  let d_tok = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"parent_tool_use_id\":\"p\\ud800\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"thinking_delta\",\"thinking\":\"\",\"estimated_tokens\":42}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  assert_eq_str(
    jstr_out(d_tok[0]),
    "{\"kind\":\"delta\",\"id\":\"m1:0\",\"field\":\"text\",\"text\":\"\",\"tokens\":42}",
    "estimated_tokens delta",
  )

  // Tool block with input_json_delta accumulation + content_block_stop re-emit start
  let _ = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"parent_tool_use_id\":\"p\\ud800\",\"event\":{\"type\":\"content_block_start\",\"index\":1,\"content_block\":{\"type\":\"tool_use\",\"id\":\"tu1\",\"name\":\"bash\"}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  let d1 = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"a\\\":\"}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  assert_eq_str(
    jstr_out(d1[0]),
    "{\"kind\":\"delta\",\"id\":\"tu1\",\"field\":\"input\",\"text\":\"{\\\"a\\\":\"}",
    "input_json_delta 1",
  )
  let _ = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"1}\"}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  let stopped = live.feed_with(
    jparse("{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_stop\",\"index\":1}}"),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  assert_eq_str(
    jstr_out(stopped[0]),
    "{\"kind\":\"start\",\"id\":\"tu1\",\"step\":\"tool\",\"tool\":\"bash\",\"input\":\"{\\\"a\\\":1}\",\"subagent\":true,\"parent\":\"p\\ud800\"}",
    "content_block_stop re-emits start with accumulated input",
  )

  // INPUT_MOST cap: once input >= INPUT_MOST, further input_json_delta is still emitted as delta but stops accumulating
  let _ = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":2,\"content_block\":{\"type\":\"tool_use\",\"id\":\"tu2\",\"name\":\"bash\"}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  let big = rep("x", live_wire::INPUT_MOST)
  let _ = live.feed_with(
    live_wire::obj([
      ("type", live_wire::jstr("stream_event")),
      (
        "event",
        live_wire::obj([
          ("type", live_wire::jstr("content_block_delta")),
          ("index", js_json::JValue::Num(2.0)),
          (
            "delta",
            live_wire::obj([
              ("type", live_wire::jstr("input_json_delta")),
              ("partial_json", live_wire::jstr(big)),
            ]),
          ),
        ]),
      ),
    ]),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  let extra = live.feed_with(
    jparse(
      "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"tail\"}}}",
    ),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  assert_eq_int(extra.length(), 1, "delta still emitted after INPUT_MOST")
  let stopped2 = live.feed_with(
    jparse("{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_stop\",\"index\":2}}"),
    fn() -> Double { 0.0 },
    claude_fmt_num,
  )
  match live_wire::str_u16(stopped2[0].get("input")) {
    Some(u) => assert_eq_int(u.length(), live_wire::INPUT_MOST, "accumulated input capped at INPUT_MOST")
    None => panic("expected input on content_block_stop")
  }
}
