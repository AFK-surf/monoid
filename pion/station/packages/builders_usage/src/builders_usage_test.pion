// Pure-Pion unit tests for `builders_usage` (`parse_iso`, `usage_turns` arg coercion,
// `calls_of`, `speed`, `files` raw-byte line buffering & `sections_of`, and wire formatting).

import "base_codec"
import "js_json"
import "sql_db"

fn expect_u(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic(msg)
  }
}

fn expect_opt_d(got : Option[Double], want : Option[Double], msg : String) -> Unit {
  match (got, want) {
    (Some(a), Some(b)) => expect_u(a == b, msg + ": got=" + a.to_string() + " want=" + b.to_string())
    (None, None) => ()
    _ => panic(msg + ": Option mismatch")
  }
}

test "parse_iso reads UTF-8 byte positions independently of js_parse_iso" {
  expect_opt_d(parse_iso("2026-11-24T12:34:56.789Z"), Some(1795523696789.0), "3-digit ms")
  expect_opt_d(parse_iso("2026-11-24T12:34:56.5Z"), Some(1795523696500.0), "1-digit ms")
  expect_opt_d(parse_iso("2026-11-24T12:34:56.05Z"), Some(1795523696050.0), "2-digit ms")
  expect_opt_d(parse_iso("2026-11-24T12:34:56.789999Z"), Some(1795523696789.0), "6-digit ms truncated")
  expect_opt_d(parse_iso("1970-01-01T00:00:00Z"), Some(0.0), "epoch")
  expect_opt_d(parse_iso("2024-02-29T00:00:00Z"), Some(1709164800000.0), "leap day")
  // Position-based: accepts non-standard separators (unlike js_parse_iso)
  expect_opt_d(parse_iso("1970/01/01 00:00:01"), Some(1000.0), "non-standard sep")
  expect_opt_d(js_json::js_parse_iso("1970/01/01 00:00:01"), None, "js_parse_iso rejects slash")
  expect_opt_d(parse_iso("2026-11-24"), None, "too short")
  expect_opt_d(parse_iso("xxxx-11-24T00:00:00Z"), None, "non-digits")
}

test "readops arg_number and text_arg coercion preserves NaN without JSON round-trip" {
  let nan_v = arg_number(None)
  match nan_v {
    base_codec::Json::Num(d, _) => expect_u(d != d, "None -> NaN")
    _ => panic("expected Num(NaN)")
  }
  match arg_number(Some(base_codec::json_str("not-a-num"))) {
    base_codec::Json::Num(d, _) => expect_u(d != d, "bad str -> NaN")
    _ => panic("expected Num(NaN)")
  }
  match arg_number(Some(base_codec::json_str("42"))) {
    base_codec::Json::Num(d, _) => expect_u(d == 42.0, "42")
    _ => panic("expected 42")
  }
  match arg_number(Some(base_codec::json_null())) {
    base_codec::Json::Num(d, _) => expect_u(d == 0.0, "null -> 0")
    _ => panic("expected 0")
  }
  match arg_number(Some(base_codec::json_bool(true))) {
    base_codec::Json::Num(d, _) => expect_u(d == 1.0, "true -> 1")
    _ => panic("expected 1")
  }
  expect_u(text_arg_with(Some(base_codec::json_str("abc")), base_codec::json_stringify) == "abc", "text str")
  expect_u(text_arg_with(Some(base_codec::json_num(123.0)), base_codec::json_stringify) == "123", "text num")
  expect_u(text_arg_with(Some(base_codec::json_null()), base_codec::json_stringify) == "null", "text null")
  expect_u(text_arg_with(Some(base_codec::json_bool(true)), base_codec::json_stringify) == "true", "text true")
  expect_u(text_arg_with(None, base_codec::json_stringify) == "undefined", "text none")
}

test "Lines buffers incomplete trailing line and split UTF-8 bytes across chunks" {
  let c1 = Bytes::new(4)
  c1[0] = 0x61 as Byte // 'a'
  c1[1] = 0xE4 as Byte
  c1[2] = 0xB8 as Byte
  c1[3] = 0xAD as Byte
  let c2 = Bytes::new(5)
  c2[0] = 0x0A as Byte // '\n'
  c2[1] = 0x74 as Byte // 't'
  c2[2] = 0x61 as Byte // 'a'
  c2[3] = 0x69 as Byte // 'i'
  c2[4] = 0x6C as Byte // 'l' (no trailing '\n')

  let lines = Lines::new(10.to_int64())
  let got : Array[(String, Int64, Int64)] = []
  let r1 = lines.add(c1, fn(p : Part) -> Result[Bool, String] {
    got.push((sql_db::decode_utf8_lossy_bytes(p.bytes), p.from, p.offset))
    Ok(true)
  })
  match r1 {
    Ok(true) => ()
    _ => panic("r1 failed")
  }
  expect_u(got.length() == 0, "no complete line yet")

  let r2 = lines.add(c2, fn(p : Part) -> Result[Bool, String] {
    got.push((sql_db::decode_utf8_lossy_bytes(p.bytes), p.from, p.offset))
    Ok(true)
  })
  match r2 {
    Ok(true) => ()
    _ => panic("r2 failed")
  }
  expect_u(got.length() == 1, "one complete line")
  let (text, from, off) = got[0]
  expect_u(text == "a中\n", "decoded utf8")
  expect_u(from == 10.to_int64(), "from offset")
  expect_u(off == 15.to_int64(), "end offset")
}

test "sections_of splits at cutoff keeping line begun at cutoff in old section" {
  let raw = "aaa\nbbb\nccc\n".to_bytes()
  let part = Part::{ bytes: raw, from: 0.to_int64(), offset: 12.to_int64() }
  let secs = sections_of(part, 5.0)
  expect_u(secs.length() == 2, "two sections")
  let (b0, f0, o0, fol0) = secs[0]
  let (b1, f1, o1, fol1) = secs[1]
  expect_u(sql_db::decode_utf8_lossy_bytes(b0) == "aaa\nbbb\n", "old bytes")
  expect_u(f0 == 0.to_int64(), "old from")
  expect_u(o0 == 8.to_int64(), "old end")
  expect_u(!fol0, "old not followed")
  expect_u(sql_db::decode_utf8_lossy_bytes(b1) == "ccc\n", "new bytes")
  expect_u(f1 == 8.to_int64(), "new from")
  expect_u(o1 == 12.to_int64(), "new end")
  expect_u(fol1, "new followed")
}

test "claude_project replaces non-ASCII-alnum code points with single dashes" {
  expect_u(claude_project("/Users/a/中文/ws_1") == "-Users-a----ws-1", "claude_project unicode")
}

test "calls_of parses Claude and Agy with speed settlement" {
  let claude_text = "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"hi\"},\"timestamp\":\"2026-11-24T00:00:00.000Z\"}\n{\"type\":\"assistant\",\"timestamp\":\"2026-11-24T00:00:02.500Z\",\"message\":{\"id\":\"m1\",\"model\":\"claude-opus-5-5\",\"usage\":{\"input_tokens\":10,\"cache_read_input_tokens\":20,\"cache_creation_input_tokens\":5,\"output_tokens\":30}}}\n"
  let st = CallState::{ model: None, codex_id: None, window: None, speed: no_speed() }
  let cs = calls_of("claude", claude_text.to_bytes(), false, st)
  expect_u(cs.length() == 1, "claude len")
  expect_u(cs[0].id == "m1", "claude id")
  expect_u(cs[0].input == 10.0, "claude input")
  expect_u(cs[0].cache_read == 20.0, "claude cache_read")
  expect_u(cs[0].cache_write == 5.0, "claude cache_write")
  expect_u(cs[0].output == 30.0, "claude output")
  expect_u(cs[0].gen_ms == 2500.0, "claude gen_ms")

  let agy_text = "{\"type\":\"user\",\"time\":1000}\n{\"type\":\"tool\",\"startedAt\":1200,\"time\":1700}\n{\"type\":\"usage\",\"run\":\"r1\",\"time\":2500,\"model\":\"gemini-4-neon\",\"usage\":{\"inputTokens\":50,\"outputTokens\":100}}\n{\"type\":\"end\",\"time\":2600}\n"
  let st_agy = CallState::{ model: None, codex_id: None, window: None, speed: no_speed() }
  let cs_agy = calls_of("agy", agy_text.to_bytes(), false, st_agy)
  expect_u(cs_agy.length() == 1, "agy len")
  expect_u(cs_agy[0].id == "agy:r1", "agy id")
  expect_u(cs_agy[0].gen_ms == 1000.0, "agy gen_ms")
  expect_u(kept_speed_for("agy", st_agy.speed) == "v1:", "agy speed cleared")
}

test "format_wire_answer matches main.mbt:616-624 for object, non-object, and error" {
  let id_arr = base_codec::json_arr([base_codec::json_int(1), base_codec::json_str("a")])
  let ans1 = format_wire_answer(id_arr, Ok(base_codec::json_obj([("added", base_codec::json_int(3))])))
  expect_u(base_codec::json_stringify(ans1) == "{\"added\":3,\"id\":[1,\"a\"]}", "append array id")

  let ans2 = format_wire_answer(
    base_codec::json_str("req-9"),
    Ok(base_codec::json_obj([("id", base_codec::json_int(0)), ("ok", base_codec::json_bool(true))])),
  )
  expect_u(base_codec::json_stringify(ans2) == "{\"id\":\"req-9\",\"ok\":true}", "overwrite id")

  let ans3 = format_wire_answer(base_codec::json_int(7), Ok(base_codec::json_arr([base_codec::json_int(42)])))
  expect_u(base_codec::json_stringify(ans3) == "[42]", "non-object passthrough")

  let ans4 = format_wire_answer(base_codec::json_null(), Err("no data directory"))
  expect_u(base_codec::json_stringify(ans4) == "{\"id\":null,\"error\":\"no data directory\"}", "error envelope")
}
