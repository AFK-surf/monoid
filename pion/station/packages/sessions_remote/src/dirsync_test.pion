    None => panic("missing partial manifest")
  }
  let manifest = match sessions_core::parse_json_strict(txt) {
    Ok(j) => j
    Err(_) => panic("parse")
  }
  assert(sessions_core::int_of(sessions_core::jget(manifest, "version")) == 1)
  assert(!files_of(Some(manifest)).contains("a.txt"))
  assert_holding_zero(host)
}

test "dirsync_r3_recursive_flush_cancel_halts_siblings_before_pack_close" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let mut stream_pack_id = 0
  let stream_need = [
    DirsyncLocal::{
      path: "huge.bin",
      hash: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      mode: FILE_MODE,
      size: 2 * 1024 * 1024,
      indexed: false,
    },
  ]
  let mut cancelled = false
  let mut did_interrupt = false
  let mut closed = false
  let mut used_closed = false
  let fiber = host.rt.fork_named("recursive_flush_cancel", fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    dirsync_send_blobs_k(ctx.remote_host(), "peer", [], "sid", "/src", stream_need, fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          cancelled = true
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })
  let mut st_steps = 0
  while st_steps < 200 {
    st_steps = st_steps + 1
    host.tick()
    let mut prog = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "zstd.pack" {
        let j = match sessions_core::parse_json_strict(sc.json) { Ok(v) => v; Err(_) => base_codec::json_null() }
        let n_pieces = match sessions_core::field_of(j, "pieces") { base_codec::Json::Arr(a) => a.length(); _ => 0 }
        if closed {
          used_closed = true
        }
        let amount = n_pieces * 524288
        let answer = base_codec::json_stringify(
          base_codec::json_obj([
            ("raw", sessions_core::jnum(amount.to_double())),
            ("packed", sessions_core::jnum(amount.to_double())),
          ]),
        )
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: "", json: answer, bytes: None }))
      } else {
        if sc.op == "pack.close" {
          closed = true
        }
        let (res, err, bopt) = vfs.handle_shell(sc)
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
      }
      prog = true
    }
    while cur.stdout_cursor < mem.stdout_lines.length() {
      let line = mem.stdout_lines[cur.stdout_cursor]
      cur.stdout_cursor = cur.stdout_cursor + 1
      match sessions_core::parse_json_strict(line) {
        Ok(msg) => {
          match sessions_core::jget(msg, "rpc") {
            Some(base_codec::Json::Num(id_d, _)) => {
              let f = sessions_core::text_of(msg, "fn")
              if f == "node.syncPacking" {
                stream_pack_id = stream_pack_id + 1
                gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", sessions_core::jstr("/tmp/stream-pack-" + stream_pack_id.to_string()))]))
              } else if f == "node.syncPut" {
                let args = match sessions_core::field_of(msg, "args") { base_codec::Json::Arr(a) => a; _ => [] }
                if sessions_core::truthy(args[3]) {
                  gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("error", base_codec::json_obj([("kind", sessions_core::jstr("NoBytes"))]))]))
                } else {
                  if !did_interrupt {
                    did_interrupt = true
                    fiber.interrupt()
                    host.tick()
                  }
                  gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", base_codec::json_obj([("pieces", sessions_core::jnum(1.0))]))]))
                }
              }
              prog = true
            }
            _ => ()
          }
        }
        Err(_) => ()
      }
    }
    if !prog && host.rt.idle() {
      break
    }
  }
  assert(cancelled && closed && !used_closed)
  assert_holding_zero(host)
}

// ── R4 Regression Tests: Process-scope rotation boundaries (positive assertions) ──

test "dirsync_r4_rotate_after_mirror_mutations_publishes_manifest_and_blocks_next_gen" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let rhost = ctx.remote_host()

  let work = "/data/remote/sessions/s1/work"
  let mirror = "m1"
  let mirror_root = work + "/" + mirror
  let syncing = "/data/remote/sessions/s1/syncing"
  let manifest_path = "/data/remote/sessions/s1/mirrors/m1.json"
  vfs.add_dir(work, 1.0)
  vfs.add_dir(syncing + "/blobs", 1.0)
  vfs.add_dir("/data/remote/sessions/s1/mirrors", 1.0)

  let ha = text_blob_id("aaa")
  let hb = text_blob_id("bbb")
  vfs.add_file(syncing + "/blobs/" + ha, "aaa", 420.0)
  vfs.add_file(syncing + "/blobs/" + hb, "bbb", 420.0)
  vfs.add_file(syncing + "/base.json", "{}", 420.0)
  let plan_line = sessions_core::js_text_with(
    base_codec::json_obj([
      (
        "set",
        base_codec::json_arr([
          base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)]),
          base_codec::json_arr([sessions_core::jstr("b.txt"), sessions_core::jstr(hb), sessions_core::jstr(FILE_MODE)]),
        ]),
      ),
      ("remove", base_codec::json_arr([])),
    ]),
    test_fmt_num,
  )
  vfs.add_file(syncing + "/plan.jsonl", plan_line + "\n", 420.0)

  let mut paused_put : Option[sessions_core::MemShellCall] = None
  let mut got_interrupted = false
  gen.spawn_work(fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(0.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          got_interrupted = true
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })

  let mut steps = 0
  while steps < 200 {
    steps = steps + 1
    host.tick()
    let mut found = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "fs.put" && str_contains(sc.json, "/mirrors/") {
        paused_put = Some(sc)
        found = true
        break
      }
      let (res, err, bopt) = vfs.handle_shell(sc)
      host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
    }
    if found {
      break
    }
  }
  let held = match paused_put {
    Some(c) => c
    None => panic("expected paused manifest fs.put")
  }

  let stdout_before_rotate = mem.stdout_lines.length()
  let next = sessions_core::rotate_hub_gen(host, gen, base_codec::json_null())
  host.tick()
  assert(got_interrupted)
  // Old generation emitted zero business frames after rotation, and manifest barrier is active.
  assert(mem.stdout_lines.length() == stdout_before_rotate)
  assert(host.manifest_barriers.contains(manifest_path))

  // Start next-gen sync_begin_k BEFORE delivering held fs.put to prove it waits on manifest_barriers!
  let new_state = RemoteState::new_with_fmt(test_fmt_num)
  new_state.root = "/data/remote"
  let next_ctx = RemoteCtx::new_default(host, next, "/", new_state, sessions_core::SessionDispatch::stub())
  let next_hash = text_blob_id("changed-at-source")
  vfs.add_file(syncing + "/blobs/" + next_hash, "changed-at-source", 420.0)
  let replacement = base_codec::json_obj([
    (
      "set",
      base_codec::json_arr([
        base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(next_hash), sessions_core::jstr(FILE_MODE)]),
      ]),
    ),
    ("remove", base_codec::json_arr([])),
  ])
  let mut saw_begin_version = -1.0
  let mut commit_version = -1
  let mut commit_written = -1
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (next_ctx.dirsync.sync_begin_k)(next_ctx.remote_host(), manifest_path, mirror_root, syncing, fn(bex : effect::Exit[Double]) -> Unit {
      match bex {
        effect::Exit::Succeeded(version) => {
          saw_begin_version = version
          vfs.add_file(syncing + "/plan.jsonl", sessions_core::js_text_with(replacement, test_fmt_num) + "\n", 420.0)
          (next_ctx.dirsync.sync_commit_k)(next_ctx.remote_host(), work, mirror, syncing, manifest_path, sessions_core::jnum(version), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
            match ex {
              effect::Exit::Succeeded(v) => {
                commit_version = sessions_core::int_of(sessions_core::jget(v, "version"))
                commit_written = sessions_core::int_of(sessions_core::jget(v, "written"))
                done(effect::Exit::Succeeded(()))
              }
              _ => assert(false)
            }
          })
        }
        _ => assert(false)
      }
    })
  })
  // Tick once while held fs.put is still in flight: next-gen sync_begin_k must still be blocked on barrier.
  host.tick()
  assert(saw_begin_version == -1.0)

  // Now deliver the paused manifest fs.put -> process-scope publish finishes fs.rename -> unblocks next-gen!
  let (res, err, bopt) = vfs.handle_shell(held)
  host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: held.id, error: err, json: res, bytes: bopt }))
  let tells : Array[(String, Array[base_codec::Json])] = []
  drain_dirsync_vfs(host, next, mem, vfs, cur, fn(_f, _a) { base_codec::json_obj([("value", base_codec::json_null())]) }, tells)

  assert(saw_begin_version == 1.0)
  assert(commit_version == 2)
  assert(commit_written == 1)
  assert(opt_str_eq(vfs.files.get(mirror_root + "/a.txt"), "changed-at-source"))
  assert(opt_str_eq(vfs.files.get(mirror_root + "/b.txt"), "bbb"))
  assert(vfs.files.contains(manifest_path))
  assert(!host.manifest_barriers.contains(manifest_path))
  assert_holding_zero(host)
}

test "dirsync_r4_rotate_after_pack_transferred_closes_pack_and_removes_temp" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()

  let dir = "/work/src"
  vfs.add_dir(dir, 1.0)
  vfs.add_file(dir + "/f.txt", "hello-interrupt", 420.0)

  let mut open_packs = 0
  let mut opened_pack_id = -1
  let mut pack_close_count = 0
  let mut closed_pack_id = -1
  let mut pending_put_id = -1
  let mut got_interrupted = false

  gen.spawn_work(fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_dir_k)(ctx.remote_host(), "peer-1", "ws-1", "sess-1", "k-int", dir, fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          got_interrupted = true
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })

  // Pump until node.syncPut is parked in flight
  let mut steps = 0
  while steps < 200 && pending_put_id < 0 {
    steps = steps + 1
    host.tick()
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      let (res, err, bopt) = vfs.handle_shell(sc)
      if sc.op == "pack.open" {
        open_packs = open_packs + 1
        match sessions_core::parse_json_strict(res) {
          Ok(j) => opened_pack_id = sessions_core::int_of(sessions_core::jget(j, "id"))
          Err(_) => ()
        }
      } else if sc.op == "pack.close" {
        open_packs = open_packs - 1
        pack_close_count = pack_close_count + 1
        match sessions_core::parse_json_strict(sc.json) {
          Ok(j) => closed_pack_id = sessions_core::int_of(sessions_core::jget(j, "id"))
          Err(_) => ()
        }
      }
      host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
    }
    while cur.stdout_cursor < mem.stdout_lines.length() {
      let line = mem.stdout_lines[cur.stdout_cursor]
      cur.stdout_cursor = cur.stdout_cursor + 1
      match sessions_core::parse_json_strict(line) {
        Ok(msg) => {
          match sessions_core::jget(msg, "rpc") {
            Some(base_codec::Json::Num(id_d, _)) => {
              let f = sessions_core::text_of(msg, "fn")
              let args = match sessions_core::field_of(msg, "args") { base_codec::Json::Arr(a) => a; _ => [] }
              if f == "store.now" {
                gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", sessions_core::jnum(1000.0))]))
              } else if f == "node.ask" {
                let m = sessions_core::text_of(args[1], "method")
                if m == "sync.begin" {
                  gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", base_codec::json_obj([("id", sessions_core::jstr("s1")), ("safe", sessions_core::jnum(1.0))]))]))
                } else {
                  gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", base_codec::json_obj([("entries", base_codec::json_arr([])), ("next", base_codec::json_null())]))]))
                }
              } else if f == "node.syncPacking" {
                gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", sessions_core::jstr("/tmp/sync-pack-int-1"))]))
              } else if f == "node.syncPut" {
                pending_put_id = id_d.to_int()
              }
            }
            _ => ()
          }
        }
        Err(_) => ()
      }
    }
  }
  assert(pending_put_id > 0)
  assert(open_packs == 1 && opened_pack_id > 0)
  assert(vfs.files.contains("/tmp/sync-pack-int-1"))

  // Rotate hub generation while syncPut is in flight!
  let stdout_before_rotate = mem.stdout_lines.length()
  let _ = sessions_core::rotate_hub_gen(host, gen, base_codec::json_null())
  host.tick()
  assert(got_interrupted)

  // Deliver the in-flight syncPut reply and pump process-scope silent cleanup shell calls
  gen.handle_answer(host, pending_put_id, base_codec::json_obj([("value", base_codec::json_obj([("pieces", sessions_core::jnum(1.0))]))]))
  let mut csteps = 0
  while csteps < 200 {
    csteps = csteps + 1
    host.tick()
    let mut prog = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "pack.open" {
        open_packs = open_packs + 1
      } else if sc.op == "pack.close" {
        open_packs = open_packs - 1
        pack_close_count = pack_close_count + 1
        match sessions_core::parse_json_strict(sc.json) {
          Ok(j) => closed_pack_id = sessions_core::int_of(sessions_core::jget(j, "id"))
          Err(_) => ()
        }
      }
      let (res, err, bopt) = vfs.handle_shell(sc)
      host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
      prog = true
    }
    if !prog && host.rt.idle() {
      break
    }
  }
  // Old generation stayed completely silent on stdout, pack closed exactly once with exact ID, temp out removed!
  assert(mem.stdout_lines.length() == stdout_before_rotate)
  assert(open_packs == 0)
  assert(pack_close_count == 1 && closed_pack_id == opened_pack_id)
  assert(!vfs.files.contains("/tmp/sync-pack-int-1"))
  assert_holding_zero(host)
}

// ── R5 Regression Tests: In-flight native I/O (mirror rename & zstd.pack) across rotation ──

test "dirsync_r5_rotate_while_mirror_rename_pending_records_file_and_next_gen_updates" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let rhost = ctx.remote_host()

  let work = "/data/remote/sessions/s1/work"
  let mirror = "m1"
  let mirror_root = work + "/" + mirror
  let syncing = "/data/remote/sessions/s1/syncing"
  let manifest_path = "/data/remote/sessions/s1/mirrors/m1.json"
  vfs.add_dir(work, 1.0)
  vfs.add_dir(syncing + "/blobs", 1.0)
  vfs.add_dir("/data/remote/sessions/s1/mirrors", 1.0)

  let ha = text_blob_id("aaa")
  let hb = text_blob_id("bbb")
  vfs.add_file(syncing + "/blobs/" + ha, "aaa", 420.0)
  vfs.add_file(syncing + "/blobs/" + hb, "bbb", 420.0)
  vfs.add_file(syncing + "/base.json", "{}", 420.0)
  let plan_line = sessions_core::js_text_with(
    base_codec::json_obj([
      (
        "set",
        base_codec::json_arr([
          base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)]),
          base_codec::json_arr([sessions_core::jstr("b.txt"), sessions_core::jstr(hb), sessions_core::jstr(FILE_MODE)]),
        ]),
      ),
      ("remove", base_codec::json_arr([])),
    ]),
    test_fmt_num,
  )
  vfs.add_file(syncing + "/plan.jsonl", plan_line + "\n", 420.0)

  let mut paused_rename : Option[sessions_core::MemShellCall] = None
  let mut got_interrupted = false
  gen.spawn_work(fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(0.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          got_interrupted = true
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })

  let mut steps = 0
  while steps < 200 {
    steps = steps + 1
    host.tick()
    let mut found = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "fs.rename" && str_contains(sc.json, mirror_root + "/a.txt") {
        paused_rename = Some(sc)
        found = true
        break
      }
      let (res, err, bopt) = vfs.handle_shell(sc)
      host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
    }
    if found {
      break
    }
  }
  let held = match paused_rename {
    Some(c) => c
    None => panic("expected pending mirror rename")
  }

  let stdout_before_rotate = mem.stdout_lines.length()
  let next = sessions_core::rotate_hub_gen(host, gen, base_codec::json_null())
  host.tick()
  assert(got_interrupted)
  // Old generation stayed silent and manifest barrier is active while rename is still pending.
  assert(mem.stdout_lines.length() == stdout_before_rotate)
  assert(host.manifest_barriers.contains(manifest_path))

  // Deliver the in-flight mirror rename; process-scope daemon runs lstat, updates files, and publishes v1 manifest.
  let (res, err, bopt) = vfs.handle_shell(held)
  host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: held.id, error: err, json: res, bytes: bopt }))
  let tells : Array[(String, Array[base_codec::Json])] = []
  let noop = fn(_f : String, _a : Array[base_codec::Json]) -> base_codec::Json {
    base_codec::json_obj([("value", base_codec::json_null())])
  }
  drain_dirsync_vfs(host, next, mem, vfs, cur, noop, tells)
  assert(mem.stdout_lines.length() == stdout_before_rotate)
  assert(opt_str_eq(vfs.files.get(mirror_root + "/a.txt"), "aaa"))
  let manifest_text = match vfs.files.get(manifest_path) { Some(t) => t; None => panic("missing manifest") }
  let manifest = match sessions_core::parse_json_strict(manifest_text) { Ok(j) => j; Err(_) => panic("bad JSON") }
  assert(sessions_core::int_of(sessions_core::jget(manifest, "version")) == 1)
  assert(files_of(Some(manifest)).contains("a.txt"))
  assert(!host.manifest_barriers.contains(manifest_path))

  // Next generation reads v1 baseline and updates a.txt cleanly to v2 with zero false conflict!
  let new_state = RemoteState::new_with_fmt(test_fmt_num)
  new_state.root = "/data/remote"
  let next_ctx = RemoteCtx::new_default(host, next, "/", new_state, sessions_core::SessionDispatch::stub())
  let next_hash = text_blob_id("changed-at-source")
  vfs.add_file(syncing + "/blobs/" + next_hash, "changed-at-source", 420.0)
  let replacement = base_codec::json_obj([
    (
      "set",
      base_codec::json_arr([
        base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(next_hash), sessions_core::jstr(FILE_MODE)]),
      ]),
    ),
    ("remove", base_codec::json_arr([])),
  ])
  let mut saw_begin_version = -1.0
  let mut commit_version = -1
  let mut commit_written = -1
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (next_ctx.dirsync.sync_begin_k)(next_ctx.remote_host(), manifest_path, mirror_root, syncing, fn(bex : effect::Exit[Double]) -> Unit {
      match bex {
        effect::Exit::Succeeded(version) => {
          saw_begin_version = version
          vfs.add_file(syncing + "/plan.jsonl", sessions_core::js_text_with(replacement, test_fmt_num) + "\n", 420.0)
          (next_ctx.dirsync.sync_commit_k)(next_ctx.remote_host(), work, mirror, syncing, manifest_path, sessions_core::jnum(version), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
            match ex {
              effect::Exit::Succeeded(v) => {
                commit_version = sessions_core::int_of(sessions_core::jget(v, "version"))
                commit_written = sessions_core::int_of(sessions_core::jget(v, "written"))
                done(effect::Exit::Succeeded(()))
              }
              _ => assert(false)
            }
          })
        }
        _ => assert(false)
      }
    })
  })
  drain_dirsync_vfs(host, next, mem, vfs, cur, noop, tells)
  assert(saw_begin_version == 1.0)
  assert(commit_version == 2)
  assert(commit_written == 1)
  assert(opt_str_eq(vfs.files.get(mirror_root + "/a.txt"), "changed-at-source"))
  assert_holding_zero(host)
}

test "dirsync_r5_rotate_while_zstd_pack_pending_cleans_temp_after_pack_and_closes_once" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()

  let dir = "/work/src"
  vfs.add_dir(dir, 1.0)
  vfs.add_file(dir + "/f.txt", "hello-interrupt", 420.0)

  let mut open_packs = 0
  let mut opened_pack_id = -1
  let mut pack_close_count = 0
  let mut closed_pack_id = -1
  let mut remove_out_count = 0
  let mut pending_put_id = -1
  let mut pending_pack : Option[sessions_core::MemShellCall] = None
  let mut got_interrupted = false

  gen.spawn_work(fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_dir_k)(ctx.remote_host(), "peer-1", "ws-1", "sess-1", "k-int", dir, fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          got_interrupted = true
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })

  // Hold zstd.pack before its native worker finishes writing /tmp/sync-pack-int-1.
  let mut steps = 0
  while steps < 200 && (match pending_pack { None => true; Some(_) => false }) {
    steps = steps + 1
    host.tick()
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "zstd.pack" {
        pending_pack = Some(sc)
        break
      }
      let (res, err, bopt) = vfs.handle_shell(sc)
      if sc.op == "pack.open" {
        open_packs = open_packs + 1
        match sessions_core::parse_json_strict(res) {
          Ok(j) => opened_pack_id = sessions_core::int_of(sessions_core::jget(j, "id"))
          Err(_) => ()
        }
      } else if sc.op == "pack.close" {
        open_packs = open_packs - 1
        pack_close_count = pack_close_count + 1
        match sessions_core::parse_json_strict(sc.json) {
          Ok(j) => closed_pack_id = sessions_core::int_of(sessions_core::jget(j, "id"))
          Err(_) => ()
        }
      }
      host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
    }
    while cur.stdout_cursor < mem.stdout_lines.length() {
      let line = mem.stdout_lines[cur.stdout_cursor]
      cur.stdout_cursor = cur.stdout_cursor + 1
      match sessions_core::parse_json_strict(line) {
        Ok(msg) => {
          match sessions_core::jget(msg, "rpc") {
            Some(base_codec::Json::Num(id_d, _)) => {
              let f = sessions_core::text_of(msg, "fn")
              let args = match sessions_core::field_of(msg, "args") { base_codec::Json::Arr(a) => a; _ => [] }
              if f == "store.now" {
                gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", sessions_core::jnum(1000.0))]))
              } else if f == "node.ask" {
                let m = sessions_core::text_of(args[1], "method")
                if m == "sync.begin" {
                  gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", base_codec::json_obj([("id", sessions_core::jstr("s1")), ("safe", sessions_core::jnum(1.0))]))]))
                } else {
                  gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", base_codec::json_obj([("entries", base_codec::json_arr([])), ("next", base_codec::json_null())]))]))
                }
              } else if f == "node.syncPacking" {
                gen.handle_answer(host, id_d.to_int(), base_codec::json_obj([("value", sessions_core::jstr("/tmp/sync-pack-int-1"))]))
              } else if f == "node.syncPut" {
                pending_put_id = id_d.to_int()
              }
            }
            _ => ()
          }
        }
        Err(_) => ()
      }
    }
  }
  assert(pending_put_id < 0)
  let held = match pending_pack { Some(sc) => sc; None => panic("pack did not start") }
  assert(open_packs == 1 && opened_pack_id > 0)
  assert(!vfs.files.contains("/tmp/sync-pack-int-1"))

  // Rotate while zstd.pack is still pending on the native worker!
  let stdout_before_rotate = mem.stdout_lines.length()
  let _ = sessions_core::rotate_hub_gen(host, gen, base_codec::json_null())
  host.tick()
  assert(got_interrupted)

  // Before zstd.pack completes, NEITHER fs.remove(out) NOR pack.close may have been emitted!
  while cur.shell_cursor < mem.shell_calls.length() {
    let sc = mem.shell_calls[cur.shell_cursor]
    cur.shell_cursor = cur.shell_cursor + 1
    if sc.op == "pack.close" {
      pack_close_count = pack_close_count + 1
    } else if sc.op == "fs.remove" && str_contains(sc.json, "/tmp/sync-pack-int-1") {
      remove_out_count = remove_out_count + 1
    }
  }
  assert(mem.stdout_lines.length() == stdout_before_rotate)
  assert(remove_out_count == 0)
  assert(pack_close_count == 0 && open_packs == 1)

  // Now the native compressor completes and writes /tmp/sync-pack-int-1.
  let (res, err, bopt) = vfs.handle_shell(held)
  assert(vfs.files.contains("/tmp/sync-pack-int-1"))
  host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: held.id, error: err, json: res, bytes: bopt }))

  let mut csteps = 0
  while csteps < 200 {
    csteps = csteps + 1
    host.tick()
    let mut prog = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "pack.open" {
        open_packs = open_packs + 1
      } else if sc.op == "pack.close" {
        open_packs = open_packs - 1
        pack_close_count = pack_close_count + 1
        match sessions_core::parse_json_strict(sc.json) {
          Ok(j) => closed_pack_id = sessions_core::int_of(sessions_core::jget(j, "id"))
          Err(_) => ()
        }
      } else if sc.op == "fs.remove" && str_contains(sc.json, "/tmp/sync-pack-int-1") {
        remove_out_count = remove_out_count + 1
      }
      let (r2, e2, b2) = vfs.handle_shell(sc)
      host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: e2, json: r2, bytes: b2 }))
      prog = true
    }
    if !prog && host.rt.idle() {
      break
    }
  }
  // After zstd.pack finished: out removed, pack.close sent exactly once with exact ID, zero stdout, holding == 0!
  assert(mem.stdout_lines.length() == stdout_before_rotate)
  assert(remove_out_count == 1)
  assert(!vfs.files.contains("/tmp/sync-pack-int-1"))
  assert(open_packs == 0)
  assert(pack_close_count == 1 && closed_pack_id == opened_pack_id)
  assert_holding_zero(host)
}

// ── R6 Regression Tests: Link/dir replacement preflight lstat, unlink->rename, and rename-fail partial manifest ──

test "dirsync_r6_rotate_during_link_preflight_lstat_skips_unlink_and_next_gen_succeeds" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let rhost = ctx.remote_host()

  let work = "/data/remote/sessions/s1/work"
  let mirror = "m1"
  let mirror_root = work + "/" + mirror
  let syncing = "/data/remote/sessions/s1/syncing"
  let manifest_path = "/data/remote/sessions/s1/mirrors/m1.json"
  vfs.add_dir(work, 1.0)
  vfs.add_dir(syncing + "/blobs", 1.0)
  vfs.add_dir("/data/remote/sessions/s1/mirrors", 1.0)

  let ha = text_blob_id("aaa")
  let old_target = "old.txt"
  let old_hash = text_blob_id(old_target)
  vfs.add_link(mirror_root + "/a.txt", old_target)
  let base = base_codec::json_obj([("a.txt", base_codec::json_arr([sessions_core::jstr(old_hash), sessions_core::jstr(LINK_MODE)]))])
  vfs.add_file(manifest_path, sessions_core::js_text_with(base_codec::json_obj([("files", base), ("version", sessions_core::jnum(0.0))]), test_fmt_num), 420.0)
  let hb = text_blob_id("bbb")
  vfs.add_file(syncing + "/blobs/" + ha, "aaa", 420.0)
  vfs.add_file(syncing + "/blobs/" + hb, "bbb", 420.0)
  vfs.add_file(syncing + "/base.json", sessions_core::js_text_with(base, test_fmt_num), 420.0)
  let plan_line = sessions_core::js_text_with(
    base_codec::json_obj([
      (
        "set",
        base_codec::json_arr([
          base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)]),
          base_codec::json_arr([sessions_core::jstr("b.txt"), sessions_core::jstr(hb), sessions_core::jstr(FILE_MODE)]),
        ]),
      ),
      ("remove", base_codec::json_arr([])),
    ]),
    test_fmt_num,
  )
  vfs.add_file(syncing + "/plan.jsonl", plan_line + "\n", 420.0)

  let mut paused_call : Option[sessions_core::MemShellCall] = None
  let mut got_interrupted = false
  gen.spawn_work(fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(0.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          got_interrupted = true
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })

  let mut steps = 0
  while steps < 200 {
    steps = steps + 1
    host.tick()
    let mut found = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      let process_owned = match host.shell_waiters.get(sc.id) {
        Some(w) => match w.owner { sessions_core::ShellOwner::Process => true; _ => false }
        None => false
      }
      if process_owned && sc.op == "fs.lstat" && str_contains(sc.json, mirror_root + "/a.txt") {
        paused_call = Some(sc)
        found = true
        break
      }
      let (res, err, bopt) = vfs.handle_shell(sc)
      host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
    }
    if found {
      break
    }
  }
  let held = match paused_call {
    Some(c) => c
    None => panic("expected pending mirror preflight lstat")
  }

  assert(opt_str_eq(vfs.links.get(mirror_root + "/a.txt"), old_target))
  let before = mem.shell_calls.length()
  let stdout_before_rotate = mem.stdout_lines.length()
  let next = sessions_core::rotate_hub_gen(host, gen, base_codec::json_null())
  host.tick()
  assert(got_interrupted)

  let (res, err, bopt) = vfs.handle_shell(held)
  host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: held.id, error: err, json: res, bytes: bopt }))
  let tells : Array[(String, Array[base_codec::Json])] = []
  let noop = fn(_f : String, _a : Array[base_codec::Json]) -> base_codec::Json {
    base_codec::json_obj([("value", base_codec::json_null())])
  }
  drain_dirsync_vfs(host, next, mem, vfs, cur, noop, tells)
  assert(mem.stdout_lines.length() == stdout_before_rotate)

  // Must NOT issue fs.remove after rotation during preflight lstat; old symlink remains intact on disk & in v1 manifest.
  let mut late_unlink = false
  for i in before..<mem.shell_calls.length() {
    let call = mem.shell_calls[i]
    if call.op == "fs.remove" && str_contains(call.json, mirror_root + "/a.txt") {
      late_unlink = true
    }
  }
  assert(!late_unlink)
  assert(opt_str_eq(vfs.links.get(mirror_root + "/a.txt"), old_target))
  let manifest_text = match vfs.files.get(manifest_path) { Some(t) => t; None => panic("missing manifest") }
  let manifest = match sessions_core::parse_json_strict(manifest_text) { Ok(j) => j; Err(_) => panic("bad JSON") }
  assert(sessions_core::int_of(sessions_core::jget(manifest, "version")) == 1)
  let kept = match files_of(Some(manifest)).get("a.txt") { Some(v) => v; None => panic("expected original link baseline") }
  assert(json_equal(entry_at(kept, 0), sessions_core::jstr(old_hash)))
  assert(!host.manifest_barriers.contains(manifest_path))

  // Next generation retries the same replacement plan cleanly to v2!
  let new_state = RemoteState::new_with_fmt(test_fmt_num)
  new_state.root = "/data/remote"
  let next_ctx = RemoteCtx::new_default(host, next, "/", new_state, sessions_core::SessionDispatch::stub())
  vfs.add_file(syncing + "/blobs/" + ha, "aaa", 420.0)
  let replacement = base_codec::json_obj([
    (
      "set",
      base_codec::json_arr([
        base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)]),
      ]),
    ),
    ("remove", base_codec::json_arr([])),
  ])
  let mut saw_begin_version = -1.0
  let mut commit_version = -1
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (next_ctx.dirsync.sync_begin_k)(next_ctx.remote_host(), manifest_path, mirror_root, syncing, fn(bex : effect::Exit[Double]) -> Unit {
      match bex {
        effect::Exit::Succeeded(version) => {
          saw_begin_version = version
          vfs.add_file(syncing + "/plan.jsonl", sessions_core::js_text_with(replacement, test_fmt_num) + "\n", 420.0)
          (next_ctx.dirsync.sync_commit_k)(next_ctx.remote_host(), work, mirror, syncing, manifest_path, sessions_core::jnum(version), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
            match ex {
              effect::Exit::Succeeded(v) => {
                commit_version = sessions_core::int_of(sessions_core::jget(v, "version"))
                done(effect::Exit::Succeeded(()))
              }
              _ => assert(false)
            }
          })
        }
        _ => assert(false)
      }
    })
  })
  drain_dirsync_vfs(host, next, mem, vfs, cur, noop, tells)
  assert(saw_begin_version == 1.0)
  assert(commit_version == 2)
  assert(opt_str_eq(vfs.files.get(mirror_root + "/a.txt"), "aaa"))
  assert(!vfs.links.contains(mirror_root + "/a.txt"))
  assert_holding_zero(host)
}

test "dirsync_r6_rotate_during_link_unlink_completes_rename_and_next_gen_succeeds" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let rhost = ctx.remote_host()

  let work = "/data/remote/sessions/s1/work"
  let mirror = "m1"
  let mirror_root = work + "/" + mirror
  let syncing = "/data/remote/sessions/s1/syncing"
  let manifest_path = "/data/remote/sessions/s1/mirrors/m1.json"
  vfs.add_dir(work, 1.0)
  vfs.add_dir(syncing + "/blobs", 1.0)
  vfs.add_dir("/data/remote/sessions/s1/mirrors", 1.0)

  let ha = text_blob_id("aaa")
  let old_target = "old.txt"
  let old_hash = text_blob_id(old_target)
  vfs.add_link(mirror_root + "/a.txt", old_target)
  let base = base_codec::json_obj([("a.txt", base_codec::json_arr([sessions_core::jstr(old_hash), sessions_core::jstr(LINK_MODE)]))])
  vfs.add_file(manifest_path, sessions_core::js_text_with(base_codec::json_obj([("files", base), ("version", sessions_core::jnum(0.0))]), test_fmt_num), 420.0)
  let hb = text_blob_id("bbb")
  vfs.add_file(syncing + "/blobs/" + ha, "aaa", 420.0)
  vfs.add_file(syncing + "/blobs/" + hb, "bbb", 420.0)
  vfs.add_file(syncing + "/base.json", sessions_core::js_text_with(base, test_fmt_num), 420.0)
  let plan_line = sessions_core::js_text_with(
    base_codec::json_obj([
      (
        "set",
        base_codec::json_arr([
          base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)]),
          base_codec::json_arr([sessions_core::jstr("b.txt"), sessions_core::jstr(hb), sessions_core::jstr(FILE_MODE)]),
        ]),
      ),
      ("remove", base_codec::json_arr([])),
    ]),
    test_fmt_num,
  )
  vfs.add_file(syncing + "/plan.jsonl", plan_line + "\n", 420.0)

  let mut paused_call : Option[sessions_core::MemShellCall] = None
  let mut got_interrupted = false
  gen.spawn_work(fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(0.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          got_interrupted = true
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })

  let mut steps = 0
  while steps < 200 {
    steps = steps + 1
    host.tick()
    let mut found = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      let process_owned = match host.shell_waiters.get(sc.id) {
        Some(w) => match w.owner { sessions_core::ShellOwner::Process => true; _ => false }
        None => false
      }
      if process_owned && sc.op == "fs.remove" && str_contains(sc.json, mirror_root + "/a.txt") {
        paused_call = Some(sc)
        found = true
        break
      }
      let (res, err, bopt) = vfs.handle_shell(sc)
      host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
    }
    if found {
      break
    }
  }
  let held = match paused_call {
    Some(c) => c
    None => panic("expected pending mirror unlink")
  }

  assert(opt_str_eq(vfs.links.get(mirror_root + "/a.txt"), old_target))
  let stdout_before_rotate = mem.stdout_lines.length()
  let next = sessions_core::rotate_hub_gen(host, gen, base_codec::json_null())
  host.tick()
  assert(got_interrupted)

  let (res, err, bopt) = vfs.handle_shell(held)
  host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: held.id, error: err, json: res, bytes: bopt }))
  let tells : Array[(String, Array[base_codec::Json])] = []
  let noop = fn(_f : String, _a : Array[base_codec::Json]) -> base_codec::Json {
    base_codec::json_obj([("value", base_codec::json_null())])
  }
  drain_dirsync_vfs(host, next, mem, vfs, cur, noop, tells)
  assert(mem.stdout_lines.length() == stdout_before_rotate)

  // Unlink already ran -> process-scope daemon completes rename + lstat + v1 manifest with a.txt = aaa!
  assert(opt_str_eq(vfs.files.get(mirror_root + "/a.txt"), "aaa"))
  assert(!vfs.links.contains(mirror_root + "/a.txt"))
  let manifest_text = match vfs.files.get(manifest_path) { Some(t) => t; None => panic("missing manifest") }
  let manifest = match sessions_core::parse_json_strict(manifest_text) { Ok(j) => j; Err(_) => panic("bad JSON") }
  assert(sessions_core::int_of(sessions_core::jget(manifest, "version")) == 1)
  let kept = match files_of(Some(manifest)).get("a.txt") { Some(v) => v; None => panic("expected updated a.txt") }
  assert(json_equal(entry_at(kept, 0), sessions_core::jstr(ha)))
  assert(json_equal(entry_at(kept, 1), sessions_core::jstr(FILE_MODE)))
  assert(!host.manifest_barriers.contains(manifest_path))

  // Next generation retries cleanly to v2 with zero false conflict!
  let new_state = RemoteState::new_with_fmt(test_fmt_num)
  new_state.root = "/data/remote"
  let next_ctx = RemoteCtx::new_default(host, next, "/", new_state, sessions_core::SessionDispatch::stub())
  vfs.add_file(syncing + "/blobs/" + ha, "aaa", 420.0)
  let replacement = base_codec::json_obj([
    (
      "set",
      base_codec::json_arr([
        base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)]),
      ]),
    ),
    ("remove", base_codec::json_arr([])),
  ])
  let mut saw_begin_version = -1.0
  let mut commit_version = -1
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (next_ctx.dirsync.sync_begin_k)(next_ctx.remote_host(), manifest_path, mirror_root, syncing, fn(bex : effect::Exit[Double]) -> Unit {
      match bex {
        effect::Exit::Succeeded(version) => {
          saw_begin_version = version
          vfs.add_file(syncing + "/plan.jsonl", sessions_core::js_text_with(replacement, test_fmt_num) + "\n", 420.0)
          (next_ctx.dirsync.sync_commit_k)(next_ctx.remote_host(), work, mirror, syncing, manifest_path, sessions_core::jnum(version), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
            match ex {
              effect::Exit::Succeeded(v) => {
                commit_version = sessions_core::int_of(sessions_core::jget(v, "version"))
                done(effect::Exit::Succeeded(()))
              }
              _ => assert(false)
            }
          })
        }
        _ => assert(false)
      }
    })
  })
  drain_dirsync_vfs(host, next, mem, vfs, cur, noop, tells)
  assert(saw_begin_version == 1.0)
  assert(commit_version == 2)
  assert(opt_str_eq(vfs.files.get(mirror_root + "/a.txt"), "aaa"))
  assert_holding_zero(host)
}

test "dirsync_r6_link_unlink_then_rename_fail_drops_stale_link_from_partial_manifest" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let rhost = ctx.remote_host()

  let work = "/data/remote/sessions/s1/work"
  let mirror = "m1"
  let mirror_root = work + "/" + mirror
  let syncing = "/data/remote/sessions/s1/syncing"
  let manifest_path = "/data/remote/sessions/s1/mirrors/m1.json"
  vfs.add_dir(work, 1.0)
  vfs.add_dir(syncing + "/blobs", 1.0)
  vfs.add_dir("/data/remote/sessions/s1/mirrors", 1.0)

  let ha = text_blob_id("aaa")
  let old_target = "old.txt"
  let old_hash = text_blob_id(old_target)
  vfs.add_link(mirror_root + "/a.txt", old_target)
  let base = base_codec::json_obj([("a.txt", base_codec::json_arr([sessions_core::jstr(old_hash), sessions_core::jstr(LINK_MODE)]))])
  vfs.add_file(manifest_path, sessions_core::js_text_with(base_codec::json_obj([("files", base), ("version", sessions_core::jnum(0.0))]), test_fmt_num), 420.0)
  vfs.add_file(syncing + "/blobs/" + ha, "aaa", 420.0)
  vfs.add_file(syncing + "/base.json", sessions_core::js_text_with(base, test_fmt_num), 420.0)
  let plan_line = sessions_core::js_text_with(
    base_codec::json_obj([
      ("set", base_codec::json_arr([base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)])])),
      ("remove", base_codec::json_arr([])),
    ]),
    test_fmt_num,
  )
  vfs.add_file(syncing + "/plan.jsonl", plan_line + "\n", 420.0)

  let mut saw_rename_err = false
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(0.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Failed(e) => {
          saw_rename_err = str_contains(sessions_core::error_message(e), "EIO: simulated rename failure")
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })

  // Inject an I/O error on the mirror fs.rename right after the old link was unlinked.
  let mut steps = 0
  while steps < 200 {
    steps = steps + 1
    host.tick()
    let mut prog = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "fs.rename" && str_contains(sc.json, mirror_root + "/a.txt") {
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: "EIO: simulated rename failure", json: "", bytes: None }))
      } else {
        let (res, err, bopt) = vfs.handle_shell(sc)
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
      }
      prog = true
    }
    if !prog && host.rt.idle() {
      break
    }
  }
  assert(saw_rename_err)
  assert(!vfs.links.contains(mirror_root + "/a.txt"))
  assert(!vfs.files.contains(mirror_root + "/a.txt"))
  let manifest_text = match vfs.files.get(manifest_path) { Some(t) => t; None => panic("missing partial manifest") }
  let manifest = match sessions_core::parse_json_strict(manifest_text) { Ok(j) => j; Err(_) => panic("bad JSON") }
  assert(sessions_core::int_of(sessions_core::jget(manifest, "version")) == 1)
  // Stale link entry MUST NOT remain in partial manifest after unlink succeeded and rename failed!
  assert(!files_of(Some(manifest)).contains("a.txt"))
  assert_holding_zero(host)
}

test "dirsync_w9_a2_reuse_key_and_commit_paging_utf8_budget" {
  let h = "1111111111111111111111111111111111111111"
  assert(reuse_key(h, FILE_MODE) == "file:" + h)
  assert(reuse_key(h, EXEC_MODE) == "file:" + h)
  assert(reuse_key(h, LINK_MODE) == "link:" + h)
  assert(reuse_key(h, FILE_MODE) != reuse_key(h, LINK_MODE))

  let js_text = fn(v : base_codec::Json) -> String {
    sessions_core::js_text_with(v, test_fmt_num)
  }
  let id = "0123456789abcdef"
  let budget = 300
  let set : Array[base_codec::Json] = [
    base_codec::json_arr([sessions_core::jstr("目录/文件一😀.txt"), sessions_core::jstr(h), sessions_core::jstr(FILE_MODE)]),
    base_codec::json_arr([sessions_core::jstr("目录/\"引号\"\\转义😀.txt"), sessions_core::jstr(h), sessions_core::jstr(EXEC_MODE)]),
    base_codec::json_arr([sessions_core::jstr("目录/文件三😀.txt"), sessions_core::jstr(h), sessions_core::jstr(LINK_MODE)]),
  ]
  let remove : Array[String] = [
    "旧目录/删除一😀.txt",
    "旧目录/删除二😀.txt",
    "旧目录/删除三😀.txt",
    "旧目录/删除四😀.txt",
  ]
  let subs : Array[(String, String, String)] = [
    ("vendor/sub-a", h, "https://example.invalid/org/sub-a.git"),
    ("vendor/sub-b", h, "https://example.invalid/org/sub-b.git"),
  ]
  let pages = sync_commit_pages(js_text, id, set, remove, subs, budget)
  assert(pages.length() >= 3)
  for i in 0..<pages.length() {
    let obj = base_codec::json_obj(pages[i])
    let encoded = js_text(obj)
    assert(bytes_len(encoded) <= budget)
    assert(json_equal(sessions_core::field_of(obj, "final"), sessions_core::jbool(i == pages.length() - 1)))
    if i < pages.length() - 1 {
      assert(json_equal(sessions_core::field_of(obj, "submodules"), base_codec::json_null()))
    } else {
      match sessions_core::field_of(obj, "submodules") {
        base_codec::Json::Arr(a) => assert(a.length() == 2)
        _ => assert(false)
      }
    }
  }

  // Submodules overflow forces an extra empty final page carrying submodules
  let small_set : Array[base_codec::Json] = [
    base_codec::json_arr([sessions_core::jstr("a.txt"), sessions_core::jstr(h), sessions_core::jstr(FILE_MODE)]),
  ]
  let sub_pages = sync_commit_pages(js_text, id, small_set, [], subs, 300)
  assert(sub_pages.length() == 2)
  let sp0 = base_codec::json_obj(sub_pages[0])
  let sp1 = base_codec::json_obj(sub_pages[1])
  assert(bytes_len(js_text(sp0)) <= 300)
  assert(bytes_len(js_text(sp1)) <= 300)
  assert(json_equal(sessions_core::field_of(sp0, "final"), sessions_core::jbool(false)))
  assert(json_equal(sessions_core::field_of(sp0, "submodules"), base_codec::json_null()))
  assert(json_equal(sessions_core::field_of(sp1, "final"), sessions_core::jbool(true)))
  assert(json_equal(sessions_core::field_of(sp1, "set"), base_codec::json_arr([])))
  assert(json_equal(sessions_core::field_of(sp1, "remove"), base_codec::json_arr([])))

  // Single item exceeding budget is placed alone without looping
  let sb = StringBuilder::new()
  sb.write_string("超长路径_")
  for _k in 0..<80 {
    sb.write_string("汉")
  }
  sb.write_string(".txt")
  let giant : Array[base_codec::Json] = [
    base_codec::json_arr([sessions_core::jstr(sb.to_string()), sessions_core::jstr(h), sessions_core::jstr(FILE_MODE)]),
    base_codec::json_arr([sessions_core::jstr("small.txt"), sessions_core::jstr(h), sessions_core::jstr(FILE_MODE)]),
  ]
  let giant_pages = sync_commit_pages(js_text, id, giant, [], [], 160)
  assert(giant_pages.length() == 2)
  assert(bytes_len(js_text(base_codec::json_obj(giant_pages[1]))) <= 160)

  // dirsync_page_of_budget respects UTF-8 byte budget including frame overhead
  let entries : Array[base_codec::Json] = [
    base_codec::json_arr([sessions_core::jstr("中文路径一😀.txt"), sessions_core::jstr(h), sessions_core::jstr(FILE_MODE)]),
    base_codec::json_arr([sessions_core::jstr("中文路径二😀.txt"), sessions_core::jstr(h), sessions_core::jstr(FILE_MODE)]),
    base_codec::json_arr([sessions_core::jstr("中文路径三😀.txt"), sessions_core::jstr(h), sessions_core::jstr(FILE_MODE)]),
  ]
  let mut after = 0
  let mut pcount = 0
  while after < entries.length() {
    let page = dirsync_page_of_budget(entries, after, 140)
    assert(bytes_len(js_text(page)) <= 140)
    pcount = pcount + 1
    match sessions_core::field_of(page, "next") {
      base_codec::Json::Num(n, _) => after = n.to_int()
      _ => break
    }
  }
  assert(pcount == 3)
}

test "dirsync_w9_a2_put_blobs_complete_part_bad_hash_oversize_empty_and_retry" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let tells : Array[(String, Array[base_codec::Json])] = []
  let noop_rpc = fn(_f : String, _args : Array[base_codec::Json]) -> base_codec::Json {
    base_codec::json_obj([("value", base_codec::json_null())])
  }
  let blobs = "/data/remote/sessions/s1/syncing/blobs"
  vfs.add_dir(blobs, 1.0)
  let rhost = ctx.remote_host()
  let port = ctx.dirsync

  let body = "abcdefghij"
  let h = text_blob_id(body)
  let put_piece = fn(hash : String, size : Double, offset : Double, chunk : String) -> Result[Int, String] {
    let mut res : Result[Int, String] = Err("unset")
    let b64 = base_codec::base64_encode(chunk.to_bytes())
    let idx = base_codec::json_arr([
      base_codec::json_arr([sessions_core::jstr(hash), sessions_core::jnum(size), sessions_core::jnum(offset), sessions_core::jnum(bytes_len(chunk).to_double())]),
    ])
    fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
      (port.put_blobs_k)(rhost, blobs, idx, None, sessions_core::jstr(b64), fn(ex : effect::Exit[Int]) -> Unit {
        match ex {
          effect::Exit::Succeeded(n) => { res = Ok(n); done(effect::Exit::Succeeded(())) }
          effect::Exit::Failed(e) => { res = Err(sessions_core::error_message(e)); done(effect::Exit::Succeeded(())) }
          effect::Exit::Interrupted => { res = Err("interrupted"); done(effect::Exit::Succeeded(())) }
        }
      })
    })
    drain_dirsync_vfs(host, gen, mem, vfs, cur, noop_rpc, tells)
    res
  }

  // 1. Valid complete .part left on disk before rename -> last-piece retry verifies & commits
  vfs.add_file(blobs + "/" + h + ".part", body, 420.0)
  match put_piece(h, 10.0, 6.0, "ghij") {
    Ok(n) => assert(n == 1)
    Err(_) => assert(false)
  }
  assert(!vfs.files.contains(blobs + "/" + h + ".part"))
  assert(opt_str_eq(vfs.files.get(blobs + "/" + h), body))

  // 2. Bad-hash complete .part -> refused, .part removed, done not created, retry succeeds
  let body2 = "0123456789"
  let h2 = text_blob_id(body2)
  vfs.add_file(blobs + "/" + h2 + ".part", "xxxxxxxxxx", 420.0)
  match put_piece(h2, 10.0, 6.0, "6789") {
    Ok(_) => assert(false)
    Err(msg) => assert(msg == "a content sent does not match its id")
  }
  assert(!vfs.files.contains(blobs + "/" + h2 + ".part"))
  assert(!vfs.files.contains(blobs + "/" + h2))
  match put_piece(h2, 10.0, 0.0, body2) {
    Ok(n) => assert(n == 1)
    Err(_) => assert(false)
  }
  assert(opt_str_eq(vfs.files.get(blobs + "/" + h2), body2))

  // 3. Oversize .part -> refused, .part removed, retry succeeds
  let body3 = "hello"
  let h3 = text_blob_id(body3)
  vfs.add_file(blobs + "/" + h3 + ".part", "hello-extra-bytes", 420.0)
  match put_piece(h3, 5.0, 0.0, body3) {
    Ok(_) => assert(false)
    Err(msg) => assert(msg == "a content sent does not match its id")
  }
  assert(!vfs.files.contains(blobs + "/" + h3 + ".part"))
  assert(!vfs.files.contains(blobs + "/" + h3))
  match put_piece(h3, 5.0, 0.0, body3) {
    Ok(n) => assert(n == 1)
    Err(_) => assert(false)
  }
  assert(opt_str_eq(vfs.files.get(blobs + "/" + h3), body3))

  // 4. Empty file: oversize .part -> refused & cleaned; bad-hash empty .part -> refused; valid empty .part -> commits
  let h_empty = text_blob_id("")
  vfs.add_file(blobs + "/" + h_empty + ".part", "junk", 420.0)
  match put_piece(h_empty, 0.0, 0.0, "") {
    Ok(_) => assert(false)
    Err(msg) => assert(msg == "a content sent does not match its id")
  }
  assert(!vfs.files.contains(blobs + "/" + h_empty + ".part"))
  vfs.add_file(blobs + "/" + h_empty + ".part", "", 420.0)
  match put_piece(h_empty, 0.0, 0.0, "") {
    Ok(n) => assert(n == 1)
    Err(_) => assert(false)
  }
  assert(opt_str_eq(vfs.files.get(blobs + "/" + h_empty), ""))
  assert_holding_zero(host)
}

test "dirsync_w9_a2_remove_enoent_eacces_and_parent_escape" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let work = "/data/remote/sessions/s1/work"
  let mirror = "m1"
  let mirror_root = work + "/" + mirror
  let syncing = "/data/remote/sessions/s1/syncing"
  let manifest_path = "/data/remote/sessions/s1/mirrors/m1.json"
  vfs.add_dir(mirror_root, 1.0)
  vfs.add_dir(syncing, 1.0)
  vfs.add_dir("/data/remote/sessions/s1/mirrors", 1.0)
  let rhost = ctx.remote_host()

  let ha = text_blob_id("aaa")
  vfs.add_file(mirror_root + "/locked.txt", "aaa", 420.0)
  let base = base_codec::json_obj([
    ("locked.txt", base_codec::json_arr([sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)])),
  ])
  vfs.add_file(manifest_path, sessions_core::js_text_with(base_codec::json_obj([("files", base), ("version", sessions_core::jnum(0.0))]), test_fmt_num), 420.0)
  vfs.add_file(syncing + "/base.json", sessions_core::js_text_with(base, test_fmt_num), 420.0)
  let plan_line = sessions_core::js_text_with(
    base_codec::json_obj([("set", base_codec::json_arr([])), ("remove", base_codec::json_arr([sessions_core::jstr("locked.txt")]))]),
    test_fmt_num,
  )
  vfs.add_file(syncing + "/plan.jsonl", plan_line + "\n", 420.0)

  // 1. EACCES on fs.remove -> refuses & preserves manifest entry for retry
  let mut err_msg = ""
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(0.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Failed(e) => { err_msg = sessions_core::error_message(e); done(effect::Exit::Succeeded(())) }
        _ => assert(false)
      }
    })
  })
  let mut steps = 0
  while steps < 200 {
    steps = steps + 1
    host.tick()
    let mut prog = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "fs.remove" && str_contains(sc.json, mirror_root + "/locked.txt") {
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: "EACCES: permission denied", json: "", bytes: None }))
      } else {
        let (res, err, bopt) = vfs.handle_shell(sc)
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
      }
      prog = true
    }
    if !prog && host.rt.idle() {
      break
    }
  }
  assert(str_contains(err_msg, "cannot remove locked.txt on the target") && str_contains(err_msg, "EACCES"))
  let m1 = match sessions_core::parse_json_strict(match vfs.files.get(manifest_path) { Some(t) => t; None => "" }) { Ok(j) => j; Err(_) => panic("bad json") }
  assert(files_of(Some(m1)).contains("locked.txt"))

  // 2. Retry after permissions fixed -> succeeds and removes from manifest
  let mut ok_removed = -1
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(1.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Succeeded(v) => { ok_removed = sessions_core::int_of(sessions_core::jget(v, "removed")); done(effect::Exit::Succeeded(())) }
        _ => assert(false)
      }
    })
  })
  let tells : Array[(String, Array[base_codec::Json])] = []
  let noop_rpc = fn(_f : String, _args : Array[base_codec::Json]) -> base_codec::Json {
    base_codec::json_obj([("value", base_codec::json_null())])
  }
  drain_dirsync_vfs(host, gen, mem, vfs, cur, noop_rpc, tells)
  assert(ok_removed == 1)
  let m2 = match sessions_core::parse_json_strict(match vfs.files.get(manifest_path) { Some(t) => t; None => "" }) { Ok(j) => j; Err(_) => panic("bad json") }
  assert(!files_of(Some(m2)).contains("locked.txt"))

  // 3. Untracked remote-only file (not in base manifest) in remove -> skipped completely (file & parent dir preserved, removed == 0)
  vfs.add_dir(mirror_root + "/remote-only", 1.0)
  vfs.add_file(mirror_root + "/remote-only/keep.txt", "untouched", 420.0)
  vfs.add_file(syncing + "/base.json", sessions_core::js_text_with(base_codec::json_obj([]), test_fmt_num), 420.0)
  vfs.add_file(
    syncing + "/plan.jsonl",
    sessions_core::js_text_with(
      base_codec::json_obj([("set", base_codec::json_arr([])), ("remove", base_codec::json_arr([sessions_core::jstr("remote-only/keep.txt")]))]),
      test_fmt_num,
    ) + "\n",
    420.0,
  )
  let mut untracked_removed = -1
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(2.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Succeeded(v) => {
          untracked_removed = sessions_core::int_of(sessions_core::jget(v, "removed"))
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })
  drain_dirsync_vfs(host, gen, mem, vfs, cur, noop_rpc, tells)
  assert(untracked_removed == 0)
  assert(opt_str_eq(vfs.files.get(mirror_root + "/remote-only/keep.txt"), "untouched"))
  assert(vfs.dirs.contains(mirror_root + "/remote-only"))

  // 4. Traversal path in remove (present in base) -> explicitly refused by file_path
  let trav_base = base_codec::json_obj([
    ("../escape.txt", base_codec::json_arr([sessions_core::jstr(ha), sessions_core::jstr(FILE_MODE)])),
  ])
  vfs.add_file(syncing + "/base.json", sessions_core::js_text_with(trav_base, test_fmt_num), 420.0)
  vfs.add_file(
    syncing + "/plan.jsonl",
    sessions_core::js_text_with(
      base_codec::json_obj([("set", base_codec::json_arr([])), ("remove", base_codec::json_arr([sessions_core::jstr("../escape.txt")]))]),
      test_fmt_num,
    ) + "\n",
    420.0,
  )
  let mut trav_err = ""
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.sync_commit_k)(rhost, work, mirror, syncing, manifest_path, sessions_core::jnum(3.0), "/src", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Failed(e) => { trav_err = sessions_core::error_message(e); done(effect::Exit::Succeeded(())) }
        _ => assert(false)
      }
    })
  })
  drain_dirsync_vfs(host, gen, mem, vfs, cur, noop_rpc, tells)
  assert(str_contains(trav_err, "cannot remove ../escape.txt on the target"))
  assert_holding_zero(host)
}

test "dirsync_w9_a2_put_blobs_preserves_part_on_transient_io_error" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 1)
  let state = RemoteState::new_with_fmt(test_fmt_num)
  state.root = "/data/remote"
  let ctx = RemoteCtx::new_default(host, gen, "/", state, sessions_core::SessionDispatch::stub())
  let vfs = DirsyncVfs::new()
  let cur = PumpCursor::new()
  let rhost = ctx.remote_host()
  let blobs = "/data/remote/blobs"
  vfs.add_dir(blobs, 1.0)

  let body = "transient-io-check"
  let h = text_blob_id(body)
  let done_path = blobs + "/" + h
  let part_path = done_path + ".part"
  vfs.add_file(part_path, body, 420.0)
  let idx = base_codec::json_arr([
    base_codec::json_arr([
      sessions_core::jstr(h),
      sessions_core::jnum(body.to_bytes().length().to_double()),
      sessions_core::jnum(0.0),
      sessions_core::jnum(body.to_bytes().length().to_double()),
    ]),
  ])
  let b64 = base_codec::base64_encode(body.to_bytes())
  let mut err_msg = ""
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.put_blobs_k)(rhost, blobs, idx, None, sessions_core::jstr(b64), fn(ex : effect::Exit[Int]) -> Unit {
      match ex {
        effect::Exit::Failed(e) => {
          err_msg = sessions_core::error_message(e)
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })
  let mut steps = 0
  while steps < 200 {
    steps = steps + 1
    host.tick()
    let mut prog = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "fs.gitblob" && str_contains(sc.json, part_path) {
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: "EIO: transient read error", json: "", bytes: None }))
      } else {
        let (res, err, bopt) = vfs.handle_shell(sc)
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
      }
      prog = true
    }
    if !prog && host.rt.idle() {
      break
    }
  }
  assert(str_contains(err_msg, "EIO: transient read error"))
  // .part must still exist (not deleted on transient I/O error) and done must not exist yet
  assert(vfs.files.contains(part_path))
  assert(!vfs.files.contains(done_path))

  // 2. When verify lstat returns None -> do NOT delete .part; fail with actionable verification refusal
  let mut lstat_count = 0
  let mut none_err = ""
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.put_blobs_k)(rhost, blobs, idx, None, sessions_core::jstr(b64), fn(ex : effect::Exit[Int]) -> Unit {
      match ex {
        effect::Exit::Failed(e) => {
          none_err = sessions_core::error_message(e)
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })
  let mut steps2 = 0
  while steps2 < 200 {
    steps2 = steps2 + 1
    host.tick()
    let mut prog = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "fs.lstat" && str_contains(sc.json, part_path) {
        lstat_count = lstat_count + 1
        if lstat_count == 2 {
          // Second lstat is inside verify_and_commit_k: simulate shell mapping EACCES/I/O to null
          host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: "", json: "null", bytes: None }))
        } else {
          let (res, err, bopt) = vfs.handle_shell(sc)
          host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
        }
      } else {
        let (res, err, bopt) = vfs.handle_shell(sc)
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
      }
      prog = true
    }
    if !prog && host.rt.idle() {
      break
    }
  }
  assert(str_contains(none_err, "cannot verify staged blob on the target"))
  assert(vfs.files.contains(part_path))

  // 3. When mismatch cleanup remove(part) fails -> propagate the cleanup error instead of swallowing it
  let bad_body = "wrong-content-len!"
  vfs.add_file(part_path, bad_body, 420.0)
  let mut rm_err = ""
  fork_test(host, fn(done : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ctx.dirsync.put_blobs_k)(rhost, blobs, idx, None, sessions_core::jstr(b64), fn(ex : effect::Exit[Int]) -> Unit {
      match ex {
        effect::Exit::Failed(e) => {
          rm_err = sessions_core::error_message(e)
          done(effect::Exit::Succeeded(()))
        }
        _ => assert(false)
      }
    })
  })
  let mut steps3 = 0
  while steps3 < 200 {
    steps3 = steps3 + 1
    host.tick()
    let mut prog = false
    while cur.shell_cursor < mem.shell_calls.length() {
      let sc = mem.shell_calls[cur.shell_cursor]
      cur.shell_cursor = cur.shell_cursor + 1
      if sc.op == "fs.remove" && str_contains(sc.json, part_path) {
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: "EACCES: cannot unlink part", json: "", bytes: None }))
      } else {
        let (res, err, bopt) = vfs.handle_shell(sc)
        host.dispatch_event(host_shim::HostEvent::ShellDone(host_shim::ShellDone::{ id: sc.id, error: err, json: res, bytes: bopt }))
      }
      prog = true
    }
    if !prog && host.rt.idle() {
      break
    }
  }
  assert(str_contains(rm_err, "EACCES: cannot unlink part"))
  assert(vfs.files.contains(part_path))
  assert_holding_zero(host)
}
