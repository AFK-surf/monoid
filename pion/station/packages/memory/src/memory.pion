// Production `--builder memory` JSON-RPC dispatcher and streaming loop (pure Pion).
// Mirrors station/mb/src/memory/answer.mbt and station/mb/src/reader/main.mbt `memory`.

import "base_codec"
import "host_shim"

fn need_str(j : base_codec::Json, key : String) -> Result[String, String] {
  match str_field(j, key) {
    Some(s) => Ok(s)
    None => Err("no " + key)
  }
}

fn hex_field(j : base_codec::Json, key : String) -> Result[Bytes, String] {
  let h = match str_field(j, key) {
    Some(s) => s
    None => return Err("no " + key)
  }
  match base_codec::hex_decode(h) {
    Some(b) => Ok(b)
    None => Err("invalid hex in " + key)
  }
}

fn text_field(j : base_codec::Json, key : String) -> Result[String, String] {
  match hex_field(j, key) {
    Ok(b) => Ok(text_of(b))
    Err(e) => Err(e)
  }
}

fn hex_json(s : String) -> base_codec::Json {
  base_codec::json_str(base_codec::hex_encode(s.to_bytes()))
}

fn map_str_object(fields : Array[(String, base_codec::Json)]) -> Map[String, String] {
  let out : Map[String, String] = Map::new()
  for i in 0..<fields.length() {
    let (k, v) = fields[i]
    match v {
      base_codec::Json::Str(s) => out.set(k, s)
      _ => ()
    }
  }
  out
}

pub fn answer(host : MemoryHost, ask : base_codec::Json, sep : String) -> Result[base_codec::Json, String] {
  let op = match str_field(ask, "op") {
    Some(s) => s
    None => ""
  }
  let blobs_dir = match str_field(ask, "blobs") {
    Some(s) => s
    None => ""
  }
  let blobs = Blobs::new(host, blobs_dir, sep)

  if op == "scan" {
    let dir = match need_str(ask, "dir") {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let kept = map_str_object(object_field(ask, "kept"))
    let file_most = match num_field(ask, "fileMost") {
      Some(n) => n
      None => 0.0
    }
    let skill_most = match num_field(ask, "skillMost") {
      Some(n) => n
      None => 0.0
    }
    let skill_files = match num_field(ask, "skillFiles") {
      Some(n) => n.to_int()
      None => 0
    }
    return scan(
      blobs,
      ScanAsk::{
        dir: dir,
        kept: kept,
        builtin: strs_field(ask, "builtin"),
        skipped: strs_field(ask, "skipped"),
        file_most: file_most,
        skill_most: skill_most,
        skill_files: skill_files,
      },
    )
  }

  if op == "decide" {
    let theirs = match base_codec::json_get(ask, "theirs") {
      Some(t) =>
      match rec_of(t) {
        Some(r) => r
        None => return Err("no record")
      }
      None => return Err("no record")
    }
    let mine = match base_codec::json_get(ask, "mine") {
      Some(m) => rec_of(m)
      None => None
    }
    let path = match need_str(ask, "path") {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    let names = map_str_object(object_field(ask, "names"))
    let given = map_str_object(object_field(ask, "given"))
    let prev_most = match num_field(ask, "prevMost") {
      Some(n) => n.to_int()
      None => 16
    }
    let outcome = match decide_records(path, mine, theirs, blobs, given, names, prev_most) {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    match outcome {
      Outcome::Keep => return Ok(base_codec::json_obj([("kind", base_codec::json_str("keep"))]))
      Outcome::Take => {
        let has_content = match lookup_content(blobs, given, theirs.hash) {
          Some(_) => true
          None => false
        }
        return Ok(
          base_codec::json_obj([
            ("kind", base_codec::json_str("take")),
            ("content", base_codec::json_bool(has_content)),
          ]),
        )
      }
      Outcome::Merge(rec, beside) => {
        let beside_json = match beside {
          Some((bp, br)) =>
          base_codec::json_obj([("path", base_codec::json_str(bp)), ("rec", rec_json(br))])
          None => base_codec::json_null()
        }
        return Ok(
          base_codec::json_obj([
            ("kind", base_codec::json_str("merge")),
            ("rec", rec_json(rec)),
            ("beside", beside_json),
          ]),
        )
      }
    }
  }

  if op == "have" {
    let hashes = strs_field(ask, "hashes")
    let out : Array[base_codec::Json] = []
    for i in 0..<hashes.length() {
      out.push(base_codec::json_bool(blobs.has(hashes[i])))
    }
    return Ok(base_codec::json_obj([("have", base_codec::json_arr(out))]))
  }

  if op == "hash" {
    let path = match need_str(ask, "path") {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    match hash_of(host, path) {
      Some(h) => return Ok(base_codec::json_obj([("hash", base_codec::json_str(h))]))
      None => return Ok(base_codec::json_obj([("hash", base_codec::json_null())]))
    }
  }

  if op == "asides" {
    let out : Array[base_codec::Json] = []
    let skills = match base_codec::json_get(ask, "skills") {
      Some(base_codec::Json::Arr(xs)) => xs
      _ => []
    }
    for i in 0..<skills.length() {
      let s = skills[i]
      let skill = match str_field(s, "skill") {
        Some(v) => v
        None => continue
      }
      let hash = match str_field(s, "hash") {
        Some(v) => v
        None => continue
      }
      let author = match str_field(s, "author") {
        Some(v) => v
        None => continue
      }
      let bytes = match blobs.content(hash) {
        Some(b) => b
        None => continue
      }
      let text = text_of(bytes)
      let said = match aside_of(text, skill) {
        Some(v) => v
        None => continue
      }
      let tag = station_tag(said)
      let suffix = "-" + tag
      if !str_has_suffix(skill, suffix) || skill.length() == suffix.length() {
        continue
      }
      let base_name = skill.slice(0, skill.length() - suffix.length())
      out.push(
        base_codec::json_obj([
          ("skill", base_codec::json_str(skill)),
          ("base", base_codec::json_str(base_name)),
          ("tag", base_codec::json_str(tag)),
          ("author", base_codec::json_str(station_tag(author))),
          ("body", base_codec::json_str(body_of(text))),
        ]),
      )
    }
    return Ok(base_codec::json_obj([("asides", base_codec::json_arr(out))]))
  }

  if op == "alikeKept" {
    let given = map_str_object(object_field(ask, "given"))
    let ha = match str_field(ask, "a") {
      Some(s) => s
      None => ""
    }
    let hb = match str_field(ask, "b") {
      Some(s) => s
      None => ""
    }
    match (lookup_content(blobs, given, ha), lookup_content(blobs, given, hb)) {
      (Some(a), Some(b)) =>
      return Ok(base_codec::json_obj([("alike", base_codec::json_bool(alike(text_of(a), text_of(b))))]))
      _ => return Ok(base_codec::json_obj([("alike", base_codec::json_null())]))
    }
  }

  if op == "tags" {
    let names = strs_field(ask, "names")
    let out : Array[base_codec::Json] = []
    for i in 0..<names.length() {
      out.push(base_codec::json_str(station_tag(names[i])))
    }
    return Ok(base_codec::json_obj([("tags", base_codec::json_arr(out))]))
  }

  if op == "skillRead" {
    let dir = match need_str(ask, "dir") {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let max_bytes = match num_field(ask, "maxBytes") {
      Some(n) => n
      None => 512.0 * 1024.0
    }
    let max_files = match num_field(ask, "maxFiles") {
      Some(n) => n.to_int()
      None => 200
    }
    let with_bytes = bool_field_true(ask, "bytes")
    return skill_read(host, sep, dir, max_bytes, max_files, with_bytes)
  }

  if op == "skillWrite" {
    let dir = match need_str(ask, "dir") {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let files = object_field(ask, "files")
    let most = num_field(ask, "most")
    let check = bool_field_true(ask, "check")
    match skill_write(host, sep, dir, files, most, check) {
      Ok(_) => return Ok(base_codec::json_obj([("written", base_codec::json_bool(true))]))
      Err(e) => return Err(e)
    }
  }

  if op == "skillConflict" {
    let dir = match need_str(ask, "dir") {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let peer = match need_str(ask, "peer") {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    let content = match need_str(ask, "content") {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    match skill_conflict(host, sep, dir, peer, content) {
      Ok(_) => return Ok(base_codec::json_obj([("written", base_codec::json_bool(true))]))
      Err(e) => return Err(e)
    }
  }

  if op == "isText" {
    let bytes = match hex_field(ask, "bytes") {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    return Ok(base_codec::json_obj([("value", base_codec::json_bool(is_text(bytes)))]))
  }

  if op == "matches" {
    let a = strs_field(ask, "a")
    let b = strs_field(ask, "b")
    match matches(a, b) {
      Some(pairs) => {
        let out : Array[base_codec::Json] = []
        for i in 0..<pairs.length() {
          let (ia, ib) = pairs[i]
          out.push(base_codec::json_arr([base_codec::json_int(ia), base_codec::json_int(ib)]))
        }
        return Ok(base_codec::json_obj([("value", base_codec::json_arr(out))]))
      }
      None => return Ok(base_codec::json_obj([("value", base_codec::json_null())]))
    }
  }

  if op == "merge3" {
    let base = match text_field(ask, "base") {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let newer = match text_field(ask, "newer") {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let older = match text_field(ask, "older") {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    match merge3(base, newer, older) {
      Some(t) => return Ok(base_codec::json_obj([("value", hex_json(t))]))
      None => return Ok(base_codec::json_obj([("value", base_codec::json_null())]))
    }
  }

  if op == "union" {
    let newer = match text_field(ask, "newer") {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let older = match text_field(ask, "older") {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let newer_name = str_field(ask, "newerName")
    let older_name = str_field(ask, "olderName")
    return Ok(base_codec::json_obj([("value", hex_json(union_lines(newer, older, newer_name, older_name)))]))
  }

  if op == "alike" {
    let a = match text_field(ask, "a") {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let b = match text_field(ask, "b") {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(base_codec::json_obj([("value", base_codec::json_bool(alike(a, b)))]))
  }

  if op == "conflictPath" {
    let path = match need_str(ask, "path") {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    let station = match need_str(ask, "station") {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(base_codec::json_obj([("value", base_codec::json_str(conflict_path(path, station)))]))
  }

  Err("unknown memory op " + op)
}

/// Streaming JSON-RPC loop for `--builder memory --shell-dir <dir> [--sep <sep>]`.
pub fn run(shell_dir : String, sep : String) -> Unit {
  if !host_shim::start(shell_dir, true) {
    host_shim::exit_process(1)
  }
  let host = MemoryHost::new()
  let mut write_failed = false

  while true {
    match host.next_line() {
      None => break
      Some(host_shim::LineItem::TooLong(cap)) => {
        let resp = base_codec::json_obj([
          ("id", base_codec::json_null()),
          ("error", base_codec::json_str("line exceeds max_bytes: " + cap.to_string())),
        ])
        if !host_shim::write_stdout_line(base_codec::json_stringify(resp)) {
          write_failed = true
          break
        }
      }
      Some(host_shim::LineItem::Line(line)) => {
        if line.length() == 0 {
          continue
        }
        let ask = match base_codec::json_parse(line) {
          base_codec::JsonParseResult::Ok(j) => j
          base_codec::JsonParseResult::Err(_) => base_codec::json_null()
        }
        let id = match base_codec::json_get(ask, "id") {
          Some(v) => v
          None => base_codec::json_null()
        }
        let resp = match answer(host, ask, sep) {
          Ok(base_codec::Json::Obj(fields)) => {
            base_codec::json_obj_set(fields, "id", id)
            base_codec::json_obj(fields)
          }
          Ok(other) => other
          Err(msg) => base_codec::json_obj([("id", id), ("error", base_codec::json_str(msg))])
        }
        if !host_shim::write_stdout_line(base_codec::json_stringify(resp)) {
          write_failed = true
          break
        }
      }
    }
  }

  host_shim::stop()
  host_shim::exit_process(if write_failed { 1 } else { 0 })
}
