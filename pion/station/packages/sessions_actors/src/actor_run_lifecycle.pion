      fn(tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        self.catch_up_k(a, !is_some(a.turn) && !is_some(a.waiting), fn(ex_cu : effect::Exit[Unit]) -> Unit {
          match ex_cu {
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(_) => {
              if !was_paused_cap || is_some(a.turn) {
                tk(effect::Exit::Succeeded(()))
                return
              }
              self.busy_k(a, fn(ex_b : effect::Exit[Bool]) -> Unit {
                match ex_b {
                  effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(true) => tk(effect::Exit::Succeeded(()))
                  effect::Exit::Succeeded(false) => {
                    self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                      match ex_hp {
                        effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
                        effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
                        effect::Exit::Succeeded(true) => self.pump_k(a, -1, tk)
                        effect::Exit::Succeeded(false) => {
                          match a.queued_retry {
                            Some(r) => {
                              a.queued_retry = None
                              self.start_turn_k(a, r.kind, r.text, r.by, None, false, 0, false, tk)
                            }
                            None => tk(effect::Exit::Succeeded(()))
                          }
                        }
                      }
                    })
                  }
                }
              })
            }
          }
        })
      },
      finish_null(k),
    )
    return
  }
  if method == "evict" {
    let force = sessions_core::truthy(arg_or_null(args, 0))
    self.enqueue_k(
      a,
      fn(tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        let g = match a.agent {
          Some(v) => v
          None => {
            tk(effect::Exit::Succeeded(()))
            return
          }
        }
        self.busy_k(a, fn(ex_b : effect::Exit[Bool]) -> Unit {
          match ex_b {
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(true) => tk(effect::Exit::Succeeded(()))
            effect::Exit::Succeeded(false) => {
              if is_some(a.turn) {
                tk(effect::Exit::Succeeded(()))
                return
              }
              let finish_evict = fn(is_holding : Bool) -> Unit {
                if !force && is_holding {
                  tk(effect::Exit::Succeeded(()))
                  return
                }
                if !still(a, Some(g)) {
                  tk(effect::Exit::Succeeded(()))
                  return
                }
                self.set_agent(a, None)
                self.log(a, "info", "evicting idle session process")
                self.agent_do_k(a, g, "dispose", [], fn(ex_dp : effect::Exit[base_codec::Json]) -> Unit {
                  match ex_dp {
                    effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => self.notify_store_k(a, tk)
                  }
                })
              }
              if force {
                finish_evict(false)
              } else {
                self.holding_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
                  match ex_h {
                    effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(h) => finish_evict(h)
                  }
                })
              }
            }
          }
        })
      },
      finish_null(k),
    )
    return
  }
  if method == "compact" {
    let say = sessions_core::truthy(arg_or_null(args, 0))
    let mut refused : Option[String] = None
    self.enqueue_k(
      a,
      fn(tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        self.begin_compacting_k(a, fn(ex : effect::Exit[Option[String]]) -> Unit {
          match ex {
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(r_opt) => {
              refused = r_opt
              match r_opt {
                Some(r) => {
                  if say {
                    self.notice_k(
                      a,
                      "⚠️ " + r,
                      base_codec::json_null(),
                      base_codec::json_null(),
                      base_codec::json_null(),
                      None,
                      false,
                      tk,
                    )
                  } else {
                    tk(effect::Exit::Succeeded(()))
                  }
                }
                None => tk(effect::Exit::Succeeded(()))
              }
            }
          }
        })
      },
      fn(ex : effect::Exit[Unit]) -> Unit {
        match ex {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(_) => {
            let out = match refused {
              Some(r) => sessions_core::jstr(r)
              None => base_codec::json_null()
            }
            k(effect::Exit::Succeeded(out))
          }
        }
      },
    )
    return
  }
  if method == "compactToCap" {
    self.enqueue_k(
      a,
      fn(tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        self.compacting_to_cap_k(a, fn(ex : effect::Exit[Bool]) -> Unit {
          match ex {
            effect::Exit::Succeeded(_) => tk(effect::Exit::Succeeded(()))
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
          }
        })
      },
      finish_null(k),
    )
    return
  }
  if method == "clear" {
    let say = sessions_core::truthy(arg_or_null(args, 0))
    let read_back = sessions_core::truthy(arg_or_null(args, 1))
    let mut refused : Option[String] = None
    self.enqueue_k(
      a,
      fn(tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        let said_key = if read_back { "station.notice.afresh" } else { "station.notice.cleared" }
        self.clear_now_k(a, read_back, said_key, "by hand", false, fn(
          ex : effect::Exit[Option[String]],
        ) -> Unit {
          match ex {
            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
            effect::Exit::Succeeded(r_opt) => {
              refused = r_opt
              match r_opt {
                Some(r) => {
                  if say {
                    self.notice_k(
                      a,
                      "⚠️ " + r,
                      base_codec::json_null(),
                      base_codec::json_null(),
                      base_codec::json_null(),
                      None,
                      false,
                      tk,
                    )
                  } else {
                    tk(effect::Exit::Succeeded(()))
                  }
                }
                None => tk(effect::Exit::Succeeded(()))
              }
            }
          }
        })
      },
      fn(ex : effect::Exit[Unit]) -> Unit {
        match ex {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(_) => {
            let out = match refused {
              Some(r) => sessions_core::jstr(r)
              None => base_codec::json_null()
            }
            k(effect::Exit::Succeeded(out))
          }
        }
      },
    )
    return
  }
  if method == "suspend" {
    let why = str_or(sessions_core::str_of(Some(arg_or_null(args, 0))), "the station is in no workspace")
    self.suspend_k(a, why, k)
    return
  }
  if method == "runChanged" {
    let text = str_or(sessions_core::str_of(Some(arg_or_null(args, 0))), "")
    let change = arg_or_null(args, 1)
    // Direct RPC: matches MB where `runChanged` still posts its notice even after `close(a)`.
    self.rpc_direct_k(
      a.key,
      "node.notice",
      [
        sessions_core::jstr(text),
        base_codec::json_null(),
        base_codec::json_null(),
        change,
        base_codec::json_null(),
        sessions_core::jbool(false),
      ],
      fn(ex : effect::Exit[base_codec::Json]) -> Unit {
        match ex {
          effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(base_codec::json_null()))
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
        }
      },
    )
    return
  }
  if method == "adopt" {
    self.adopt(a, arg_or_null(args, 0), arg_or_null(args, 1), arg_or_null(args, 2), arg_or_null(args, 3))
    k(effect::Exit::Succeeded(base_codec::json_null()))
    return
  }
  if method == "snapshot" {
    k(effect::Exit::Succeeded(self.snapshot(a)))
    return
  }
  if method == "close" {
    self.close(a)
    k(effect::Exit::Succeeded(base_codec::json_null()))
    return
  }
  if method == "dispose" {
    let agent = a.agent
    self.set_agent(a, None)
    self.close(a)
    match agent {
      Some(g) => {
        // Direct RPC: `close(a)` already ran, so releasing the captured runtime handle must not
        // be blocked by `a.phase == "closed"`.
        self.rpc_direct_k(
          a.key,
          "agent.dispose",
          [sessions_core::jint(g.handle)],
          fn(ex : effect::Exit[base_codec::Json]) -> Unit {
            match ex {
              effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(base_codec::json_null()))
              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            }
          },
        )
      }
      None => k(effect::Exit::Succeeded(base_codec::json_null()))
    }
    return
  }
  let err_cause = base_codec::json_obj([("message", sessions_core::jstr("no actor method " + method))])
  k(effect::Exit::Failed(sessions_core::AskedError::new(err_cause).to_effect_error()))
}
