// Turn execution, pump/start_turn/begin_turn, notices, wake queues, mid-wait/wait/refill/tools-retry
// timers, and `on_turn_ended` wind-down (`station/mb/src/reader/actor_run.mbt` 1:1).

import "base_codec"
import "builders_core"
import "effect"
import "sessions_core"

pub struct Delivery {
  pub pending : Array[base_codec::Json]
  pub text : String
  pub widgets : base_codec::Json
}

/// Stable key for the pending messages handed over (`actor_run.mbt:1497-1499`).
pub fn handed_ids(pending : Array[base_codec::Json]) -> String {
  let sb = StringBuilder::new()
  for i in 0..<pending.length() {
    if i > 0 {
      sb.write_string(",")
    }
    let h = sessions_core::field_of(pending[i], "handed")
    sb.write_string(base_codec::json_stringify(builders_core::normalize_json(h)))
  }
  sb.to_string()
}

pub fn ActorsGen::interrupted(self : ActorsGen, a : Actor) -> Bool {
  a.delivery_interruptions > 0 || a.recoveries > 0 || a.recovery_deferred || self.closed(a)
}

/// Held, archived, or something runs (`actor_run.mbt:391-393`).
pub fn ActorsGen::blocked_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Bool]) -> Unit,
) -> Unit {
  self.held_k(a, fn(ex1 : effect::Exit[Bool]) -> Unit {
    match ex1 {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(true))
      effect::Exit::Succeeded(false) => {
        self.archived_k(a, fn(ex2 : effect::Exit[Bool]) -> Unit {
          match ex2 {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(true))
            effect::Exit::Succeeded(false) => {
              if is_some(a.turn) || is_some(a.codex_update) {
                k(effect::Exit::Succeeded(true))
              } else {
                self.busy_k(a, k)
              }
            }
          }
        })
      }
    }
  })
}

/// Localized prompt/instruction words from Node (`actor_run.mbt:397-402`).
pub fn ActorsGen::words_k(
  self : ActorsGen,
  a : Actor,
  name : String,
  args : Array[base_codec::Json],
  k : (effect::Exit[String]) -> Unit,
) -> Unit {
  let full : Array[base_codec::Json] = [sessions_core::jstr(name)]
  for i in 0..<args.length() {
    full.push(args[i])
  }
  self.rpc_k(a.key, "node.words", full, fn(ex : effect::Exit[base_codec::Json]) -> Unit {
    match ex {
      effect::Exit::Succeeded(base_codec::Json::Str(s)) => k(effect::Exit::Succeeded(s))
      effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(""))
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn ActorsGen::refills_at_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Double]) -> Unit,
) -> Unit {
  self.deps_k(a, "refillsAt", [sessions_core::jstr(a.key)], fn(
    ex : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex {
      effect::Exit::Succeeded(base_codec::Json::Num(n, _)) => k(effect::Exit::Succeeded(n))
      effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(self.gen.counters.now + 3600000.0))
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn ActorsGen::declare_turn_k(
  self : ActorsGen,
  a : Actor,
  id : String,
  state : Option[base_codec::Json],
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let args : Array[base_codec::Json] = match state {
    Some(s) => {
      let kind = sessions_core::field_of(s, "kind")
      let wait = if opt_str_is(kind_of(Some(s)), "waiting") {
        sessions_core::field_of(s, "seconds")
      } else {
        base_codec::json_null()
      }
      [sessions_core::jstr(id), kind, wait]
    }
    None => [sessions_core::jstr(id), base_codec::json_null(), base_codec::json_null()]
  }
  self.store_k(a, "declareTurn", args, fn(ex : effect::Exit[base_codec::Json]) -> Unit {
    match ex {
      effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(()))
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn ActorsGen::undeclare_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let t = match a.turn {
    Some(v) => v
    None => {
      k(effect::Exit::Succeeded(()))
      return
    }
  }
  let d = match t.declared {
    Some(v) => v
    None => {
      k(effect::Exit::Succeeded(()))
      return
    }
  }
  self.log(a, "info", "a message read after the turn said its state: the state no longer stands", [
    ("was", sessions_core::field_of(d, "kind")),
  ])
  t.declared = None
  self.cancel_mid_wait(a)
  self.declare_turn_k(a, t.id, None, k)
}

/// Format queued notices with a fresh timestamp (`actor_run.mbt:1401-1411`).
/// Intentionally snapshots `notices` before awaiting `deps.nextTs` so concurrent pushes
/// during the RPC cannot desynchronize the formatted batch from `drain_notices(a, n)`.
pub fn ActorsGen::format_notices_k(
  self : ActorsGen,
  a : Actor,
  notices : Array[String],
  k : (effect::Exit[Option[String]]) -> Unit,
) -> Unit {
  if notices.length() == 0 {
    k(effect::Exit::Succeeded(None))
    return
  }
  let snap : Array[String] = []
  for i in 0..<notices.length() {
    snap.push(notices[i])
  }
  self.deps_k(a, "nextTs", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(v) => {
        let at = str_or(sessions_core::str_of(Some(v)), "")
        let sb = StringBuilder::new()
        for i in 0..<snap.length() {
          if i > 0 {
            sb.write_string("\n")
          }
          sb.write_string("<message via=\"station\" from=\"station\" ts=\"")
          sb.write_string(at)
          sb.write_string("\">\n")
          sb.write_string(snap[i])
          sb.write_string("\n</message>")
        }
        k(effect::Exit::Succeeded(Some(sb.to_string())))
      }
    }
  })
}

pub fn drain_notices(a : Actor, n : Int) -> Array[String] {
  let k = if n > a.notices.length() { a.notices.length() } else { n }
  if k <= 0 {
    return []
  }
  let taken : Array[String] = []
  let left : Array[String] = []
  for i in 0..<a.notices.length() {
    if i < k {
      taken.push(a.notices[i])
    } else {
      left.push(a.notices[i])
    }
  }
  a.notices = left
  taken
}

pub fn ActorsGen::with_choices_k(
  self : ActorsGen,
  a : Actor,
  text : String,
  k : (effect::Exit[(String, base_codec::Json)]) -> Unit,
) -> Unit {
  self.rpc_k(a.key, "node.withChoices", [sessions_core::jstr(text)], fn(
    ex : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(got) => {
        let out_text = str_or(sessions_core::str_of(sessions_core::jget(got, "text")), text)
        let told = sessions_core::field_of(got, "told")
        k(effect::Exit::Succeeded((out_text, told)))
      }
    }
  })
}

pub fn ActorsGen::told_k(
  self : ActorsGen,
  a : Actor,
  told : base_codec::Json,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if is_json_null(told) {
    k(effect::Exit::Succeeded(()))
    return
  }
  self.rpc_k(a.key, "node.told", [told], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
    match ex {
      effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(()))
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn ActorsGen::timed_k(
  self : ActorsGen,
  a : Actor,
  text : String,
  k : (effect::Exit[String]) -> Unit,
) -> Unit {
  self.rpc_k(a.key, "node.timed", [sessions_core::jstr(text)], fn(
    ex : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex {
      effect::Exit::Succeeded(v) => k(effect::Exit::Succeeded(str_or(sessions_core::str_of(Some(v)), text)))
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn ActorsGen::said_last_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Option[String]]) -> Unit,
) -> Unit {
  self.rpc_k(a.key, "node.saidLast", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
    match ex {
      effect::Exit::Succeeded(v) => k(effect::Exit::Succeeded(sessions_core::str_of(Some(v))))
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn ActorsGen::notice_k(
  self : ActorsGen,
  a : Actor,
  text : String,
  profile : base_codec::Json,
  runtime : base_codec::Json,
  change : base_codec::Json,
  about : Option[String],
  quiet : Bool,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let about_v = match about {
    Some(t) => sessions_core::jstr(t)
    None => base_codec::json_null()
  }
  self.rpc_k(
    a.key,
    "node.notice",
    [sessions_core::jstr(text), profile, runtime, change, about_v, sessions_core::jbool(quiet)],
    fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(()))
        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      }
    },
  )
}

pub fn ActorsGen::failed_words_k(
  self : ActorsGen,
  a : Actor,
  how : String,
  e : effect::EffectError,
  k : (effect::Exit[String]) -> Unit,
) -> Unit {
  let err = match asked_cause(e) {
    Some(j) => j
    None => base_codec::json_obj([("message", sessions_core::jstr(sessions_core::error_message(e)))])
  }
  self.rpc_k(a.key, "node.words", [sessions_core::jstr(how), err], fn(
    ex : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex {
      effect::Exit::Succeeded(base_codec::Json::Str(s)) => k(effect::Exit::Succeeded(s))
      effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(""))
      effect::Exit::Failed(e2) => k(effect::Exit::Failed(e2))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn ActorsGen::failure_notice_k(
  self : ActorsGen,
  a : Actor,
  outcome : base_codec::Json,
  k : (effect::Exit[String]) -> Unit,
) -> Unit {
  self.rpc_k(a.key, "node.words", [sessions_core::jstr("failureNotice"), outcome], fn(
    ex : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex {
      effect::Exit::Succeeded(v) => k(effect::Exit::Succeeded(str_or(sessions_core::str_of(Some(v)), "")))
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn ActorsGen::asked_now_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Option[base_codec::Json]]) -> Unit,
) -> Unit {
  self.last_turn_k(a, fn(ex : effect::Exit[base_codec::Json]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(last) => {
        match last {
          base_codec::Json::Obj(_) => {
            if opt_str_is(sessions_core::str_of(sessions_core::jget(last, "ending")), "need_help") &&
            !is_opt_null_or_none(sessions_core::jget(last, "endedAt")) {
              k(effect::Exit::Succeeded(Some(last)))
            } else {
              k(effect::Exit::Succeeded(None))
            }
          }
          _ => k(effect::Exit::Succeeded(None))
        }
      }
    }
  })
}

// ── Silent-wait progress reminders & pure-value timers (`actor_run.mbt:3518-3786`) ──

pub fn ActorsGen::note_posted(self : ActorsGen, a : Actor) -> Unit {
  a.posted = true
  a.last_post_at = self.gen.counters.now
  if is_some(a.silent_waiting_since) {
    a.silent_waiting_since = Some(self.gen.counters.now)
    a.progress_reminded_at = 0.0
  }
}

pub fn ActorsGen::clear_silent_wait(self : ActorsGen, a : Actor) -> Unit {
  let _ = self
  a.silent_waiting_since = None
  a.progress_reminded_at = 0.0
}

pub fn ActorsGen::track_silent_wait(self : ActorsGen, a : Actor, t : Turn) -> Unit {
  let _ = self
  if !is_some(a.silent_waiting_since) {
    let since = if a.posted && a.last_post_at > 0.0 { a.last_post_at } else { t.started_at }
    a.silent_waiting_since = Some(since)
    a.progress_reminded_at = 0.0
  }
}

pub fn ActorsGen::maybe_progress_reminder_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[(Option[String], Bool)]) -> Unit,
) -> Unit {
  let since = match a.silent_waiting_since {
    Some(s) => s
    None => {
      k(effect::Exit::Succeeded((None, false)))
      return
    }
  }
  let silent_ms = self.gen.counters.now - since
  let reminded_ms = if a.progress_reminded_at > 0.0 {
    sessions_core::jnum(self.gen.counters.now - a.progress_reminded_at)
  } else {
    base_codec::json_null()
  }
  sessions_core::try_k(
    fn(tk : (effect::Exit[String]) -> Unit) -> Unit {
      self.words_k(a, "silentProgress", [sessions_core::jnum(silent_ms), reminded_ms], tk)
    },
    fn(ex : effect::Exit[Result[String, effect::EffectError]]) -> Unit {
      match ex {
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
        effect::Exit::Succeeded(res) => {
          let words = match res {
            Ok(w) => w
            Err(_) => ""
          }
          if words == "" {
            k(effect::Exit::Succeeded((None, false)))
          } else {
            k(effect::Exit::Succeeded((Some(words), true)))
          }
        }
      }
    },
  )
}

pub fn ActorsGen::on_declared(self : ActorsGen, a : Actor, t : Turn, state : base_codec::Json) -> Unit {
  if opt_str_is(kind_of(Some(state)), "waiting") {
    let seconds = num_or(sessions_core::num_of(sessions_core::jget(state, "seconds")), 0.0)
    t.last_tool_at = self.gen.counters.now
    self.cancel_steer_silent(a)
    self.arm_mid_wait(a, t.id, seconds, seconds * 1000.0)
    if !t.wait_watch {
      self.track_silent_wait(a, t)
    }
  } else {
    self.cancel_mid_wait(a)
  }
}

pub fn ActorsGen::arm_mid_wait(
  self : ActorsGen,
  a : Actor,
  turn_id : String,
  seconds : Double,
  ms : Double,
) -> Unit {
  if seconds <= 0.0 {
    self.cancel_mid_wait(a)
    return
  }
  a.mid_waits = a.mid_waits + 1
  let wait = a.mid_waits
  a.mid_waiting = Some(wait)
  a.mid_waiting_until = self.gen.counters.now + ms
  a.mid_waiting_seconds = seconds
  self.arm_actor_timer(a, "mid_wait", ms, ActorTimerAction::FireMidWait(wait, turn_id, seconds))
}

/// How long a turn steered to check its wait may stay silent before its runtime is taken as hung (1:1
/// `actor_run.mbt` `steered_silent_ms`).
pub let STEERED_SILENT_MS : Double = 900000.0

/// 1:1 `actor_run.mbt` `steer_silent_clamp`: `ms` within 0 and `STEERED_SILENT_MS`.
pub fn steer_silent_clamp(ms : Double) -> Double {
  if ms < 0.0 {
    0.0
  } else if ms > STEERED_SILENT_MS {
    STEERED_SILENT_MS
  } else {
    ms
  }
}

/// 1:1 `actor_run.mbt` `arm_steer_silent`: `since`, when its silence is counted from.
pub fn ActorsGen::arm_steer_silent(
  self : ActorsGen,
  a : Actor,
  turn_id : String,
  since : Double,
  ms : Double,
) -> Unit {
  let ms = steer_silent_clamp(ms)
  a.steer_silents = a.steer_silents + 1
  let silent = a.steer_silents
  a.steer_silent = Some(silent)
  a.steer_silent_until = self.gen.counters.now + ms
  a.steer_silent_since = since
  // timer: a deadline for a runtime steered mid-turn, which may never answer its prompt again
  self.arm_actor_timer(a, "steer_silent", ms, ActorTimerAction::FireSteerSilent(silent, turn_id))
}

/// 1:1 `actor_run.mbt` `steer_silent_left`.
pub fn ActorsGen::steer_silent_left(self : ActorsGen, t : Turn, since : Double) -> Double {
  let from = if t.last_live_at > since { t.last_live_at } else { since }
  steer_silent_clamp(STEERED_SILENT_MS - (self.gen.counters.now - from))
}

/// 1:1 `actor_run.mbt` `fire_steer_silent`: whether it still stands after an await (not closed, still this one, the
/// same turn with no state declared).
fn ActorsGen::steer_silent_stands(self : ActorsGen, a : Actor, silent : Int, turn_id : String) -> Bool {
  if self.closed(a) {
    return false
  }
  let same = match a.steer_silent {
    Some(s) => s == silent
    None => false
  }
  if !same {
    return false
  }
  match a.turn {
    Some(t) => t.id == turn_id && !is_some(t.declared)
    None => false
  }
}

/// 1:1 `actor_run.mbt` `fire_steer_silent`: ends a turn steered to check its wait whose runtime has said nothing since
/// for `STEERED_SILENT_MS`, no tool call begun since open and no watch running: failed, its process ended. Each await
/// is followed by a look that it still stands (`steer_silent_stands`).
pub fn ActorsGen::fire_steer_silent_k(
  self : ActorsGen,
  a : Actor,
  silent : Int,
  turn_id : String,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let same = match a.steer_silent {
    Some(s) => s == silent
    None => false
  }
  if !same {
    k(effect::Exit::Succeeded(()))
    return
  }
  let since = a.steer_silent_since
  let ok = fn() -> Unit { k(effect::Exit::Succeeded(())) }
  // (what is left to look at once nothing awaited is: open tool calls and how long it has been silent; `kill` when
  // neither keeps it)
  let still_due = fn(kill : () -> Unit) -> Unit {
    match a.turn {
      Some(t) => {
        if t.open_tools.length() > 0 {
          self.arm_steer_silent(a, turn_id, self.gen.counters.now, STEERED_SILENT_MS)
          ok()
          return
        }
        let left = self.steer_silent_left(t, since)
        if left > 0.0 {
          self.arm_steer_silent(a, turn_id, since, left)
          ok()
          return
        }
        kill()
      }
      None => ok()
    }
  }
  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
    match ex_h {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(true) => ok()
      effect::Exit::Succeeded(false) => {
        if !self.steer_silent_stands(a, silent, turn_id) {
          ok()
          return
        }
        if a.compacting {
          self.cancel_steer_silent(a)
          ok()
          return
        }
        self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
          match ex_ar {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(archived) => {
              if archived || a.compacting {
                let mine = match a.steer_silent {
                  Some(s) => s == silent
                  None => false
                }
                if mine {
                  self.cancel_steer_silent(a)
                }
                ok()
                return
              }
              if !self.steer_silent_stands(a, silent, turn_id) {
                ok()
                return
              }
              self.last_turn_k(a, fn(ex_lt : effect::Exit[base_codec::Json]) -> Unit {
                match ex_lt {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(last) => {
                    if !self.steer_silent_stands(a, silent, turn_id) {
                      ok()
                      return
                    }
                    let kill = fn() -> Unit {
                      let was = a.agent
                      self.busy_of_k(a, was, fn(ex_b : effect::Exit[Bool]) -> Unit {
                        match ex_b {
                          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(busy) => {
                            if !still(a, was) || !self.steer_silent_stands(a, silent, turn_id) {
                              ok()
                              return
                            }
                            still_due(fn() -> Unit {
                              let agent = match was {
                                Some(g) => g
                                None => {
                                  self.cancel_steer_silent(a)
                                  ok()
                                  return
                                }
                              }
                              if !busy {
                                self.cancel_steer_silent(a)
                                ok()
                                return
                              }
                              self.cancel_steer_silent(a)
                              self.log(
                                a,
                                "warn",
                                "a turn steered after its wait said nothing since; ending its process",
                                [
                                  ("runtime", sessions_core::jstr(a.runtime)),
                                  ("silentMs", sessions_core::jnum(STEERED_SILENT_MS)),
                                ],
                              )
                              self.done_working(a)
                              self.live_turn_ended_k(a, fn(ex_le : effect::Exit[Unit]) -> Unit {
                                match ex_le {
                                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                  effect::Exit::Succeeded(_) => {
                                    let same_turn = match a.turn {
                                      Some(t3) => t3.id == turn_id
                                      None => false
                                    }
                                    if !self.is_current(a, agent.generation) || !same_turn {
                                      ok()
                                      return
                                    }
                                    self.on_turn_ended_k(
                                      a,
                                      agent.generation,
                                      base_codec::json_obj([
                                        ("kind", sessions_core::jstr("failed")),
                                        ("reason", sessions_core::jstr("other")),
                                        (
                                          "message",
                                          sessions_core::jstr(
                                            "The runtime gave no sign of life for 15 minutes after it was asked to check its wait; its process was ended, and the next message starts a new one",
                                          ),
                                        ),
                                        ("hung", sessions_core::jbool(true)),
                                      ]),
                                      k,
                                    )
                                  }
                                }
                              })
                            })
                          }
                        }
                      })
                    }
                    if !is_opt_json_false(sessions_core::jget(last, "waitWatch")) {
                      self.store_k(a, "hasSessionActiveWatch", [sessions_core::jstr(a.key)], fn(
                        ex_aw : effect::Exit[base_codec::Json],
                      ) -> Unit {
                        match ex_aw {
                          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(v) => {
                            if !self.steer_silent_stands(a, silent, turn_id) {
                              ok()
                              return
                            }
                            if sessions_core::truthy(v) {
                              self.arm_steer_silent(a, turn_id, self.gen.counters.now, STEERED_SILENT_MS)
                              ok()
                            } else {
                              still_due(kill)
                            }
                          }
                        }
                      })
                    } else {
                      still_due(kill)
                    }
                  }
                }
              })
            }
          }
        })
      }
    }
  })
}

pub fn ActorsGen::wait_ms(self : ActorsGen, a : Actor, seconds : Double, ms : Double) -> Unit {
  a.waits = a.waits + 1
  let wait = a.waits
  a.waiting = Some(wait)
  a.phase = "waiting"
  a.waiting_until = self.gen.counters.now + ms
  a.waiting_seconds = seconds
  self.arm_actor_timer(a, "wait", ms, ActorTimerAction::FireWait(wait, seconds))
}

pub fn ActorsGen::await_refill(self : ActorsGen, a : Actor, at : Double) -> Unit {
  a.refills = a.refills + 1
  let refill = a.refills
  a.refill = Some(refill)
  a.refill_at = at
  self.arm_actor_timer(a, "refill", at - self.gen.counters.now, ActorTimerAction::FireRefill(refill))
}

pub fn ActorsGen::schedule_tools_retry(self : ActorsGen, a : Actor, ms : Double) -> Unit {
  a.tools_retries = a.tools_retries + 1
  let id = a.tools_retries
  a.tools_retry = Some(id)
  a.tools_retry_at = self.gen.counters.now + ms
  a.tools_retry_deferred = false
  self.mirror(a)
  self.arm_actor_timer(a, "tools_retry", ms, ActorTimerAction::FireToolsRetry(id))
}

// ── Give notices (`actor_run.mbt:1415-1480`) ──

pub fn ActorsGen::give_notices_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
    match ex_h {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(is_held) => {
        if is_held || a.compacting || is_some(a.codex_update) {
          k(effect::Exit::Succeeded(()))
          return
        }
        self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
          match ex_ar {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(true) => {
              a.notices = []
              k(effect::Exit::Succeeded(()))
            }
            effect::Exit::Succeeded(false) => {
              let check_refill = fn(cont : () -> Unit) -> Unit {
                if is_some(a.refill) {
                  self.busy_k(a, fn(ex_b : effect::Exit[Bool]) -> Unit {
                    match ex_b {
                      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(false) => k(effect::Exit::Succeeded(()))
                      effect::Exit::Succeeded(true) => cont()
                    }
                  })
                } else {
                  cont()
                }
              }
              check_refill(fn() -> Unit {
                let was = a.agent
                self.busy_of_k(a, was, fn(ex_b2 : effect::Exit[Bool]) -> Unit {
                  match ex_b2 {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(busy) => {
                      if !still(a, was) {
                        k(effect::Exit::Succeeded(()))
                        return
                      }
                      if busy {
                        match was {
                          Some(agent) => {
                            if a.stale {
                              k(effect::Exit::Succeeded(()))
                              return
                            }
                            let n = a.notices.length()
                            self.format_notices_k(a, a.notices, fn(ex_fn : effect::Exit[Option[String]]) -> Unit {
                              match ex_fn {
                                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                effect::Exit::Succeeded(None) => k(effect::Exit::Succeeded(()))
                                effect::Exit::Succeeded(Some(text)) => {
                                  self.maybe_progress_reminder_k(a, fn(
                                    ex_rem : effect::Exit[(Option[String], Bool)],
                                  ) -> Unit {
                                    match ex_rem {
                                      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                      effect::Exit::Succeeded((reminder, reminded)) => {
                                        let body = match reminder {
                                          Some(r) => text + "\n\n" + r
                                          None => text
                                        }
                                        self.with_choices_k(a, body, fn(
                                          ex_wc : effect::Exit[(String, base_codec::Json)],
                                        ) -> Unit {
                                          match ex_wc {
                                            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                            effect::Exit::Succeeded((handed, told)) => {
                                              self.timed_k(a, handed, fn(ex_tm : effect::Exit[String]) -> Unit {
                                                match ex_tm {
                                                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                                  effect::Exit::Succeeded(timed_str) => {
                                                    let take = if n > a.notices.length() { a.notices.length() } else { n }
                                                    let batch_start = a.steered_seq + 1
                                                    for i in 0..<take {
                                                      a.steered_seq = a.steered_seq + 1
                                                      a.steered_notices.push(SteeredNotice::{ seq: a.steered_seq, text: a.notices[i] })
                                                    }
                                                    let batch_end = a.steered_seq
                                                    let unsteer_notices = fn() -> Unit {
                                                      if batch_end >= batch_start {
                                                        let next_sn : Array[SteeredNotice] = []
                                                        for i in 0..<a.steered_notices.length() {
                                                          let item = a.steered_notices[i]
                                                          if item.seq < batch_start || item.seq > batch_end {
                                                            next_sn.push(item)
                                                          }
                                                        }
                                                        a.steered_notices = next_sn
                                                      }
                                                    }
                                                    self.agent_do_k(
                                                      a,
                                                      agent,
                                                      "steer",
                                                      [sessions_core::jstr(timed_str)],
                                                      fn(ex_st : effect::Exit[base_codec::Json]) -> Unit {
                                                        match ex_st {
                                                          effect::Exit::Interrupted => {
                                                            unsteer_notices()
                                                            k(effect::Exit::Interrupted)
                                                          }
                                                          effect::Exit::Failed(e) => {
                                                            unsteer_notices()
                                                            k(effect::Exit::Failed(e))
                                                          }
                                                          effect::Exit::Succeeded(sv) => {
                                                            if sessions_core::truthy(sv) {
                                                              let _ = drain_notices(a, n)
                                                              self.told_k(a, told, fn(ex_td : effect::Exit[Unit]) -> Unit {
                                                                match ex_td {
                                                                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                                                  effect::Exit::Succeeded(_) => {
                                                                    if reminded {
                                                                      a.progress_reminded_at = self.gen.counters.now
                                                                    }
                                                                    k(effect::Exit::Succeeded(()))
                                                                  }
                                                                }
                                                              })
                                                            } else {
                                                              unsteer_notices()
                                                              k(effect::Exit::Succeeded(()))
                                                            }
                                                          }
                                                        }
                                                      },
                                                    )
                                                  }
                                                }
                                              })
                                            }
                                          }
                                        })
                                      }
                                    }
                                  })
                                }
                              }
                            })
                            return
                          }
                          None => ()
                        }
                      }
                      if a.notices.length() == 0 {
                        k(effect::Exit::Succeeded(()))
                        return
                      }
                      // (waiting for its account's concurrency cap: they stay, given with the turn it is woken to)
                      if a.paused_cap {
                        k(effect::Exit::Succeeded(()))
                        return
                      }
                      if self.turn_slots_full(a) {
                        self.enqueue_turn_wait(a)
                        k(effect::Exit::Succeeded(()))
                        return
                      }
                      let reserved = !a.starting_turn
                      if reserved {
                        a.starting_turn = true
                      }
                      let finish = fn(ex : effect::Exit[Unit]) -> Unit {
                        if reserved {
                          a.starting_turn = false
                          if !self.gen.counters.sealed && !is_some(a.turn) {
                            self.drain_turn_queue(!a.paused_cap)
                          }
                        }
                        k(ex)
                      }
                      let n = a.notices.length()
                      self.format_notices_k(a, a.notices, fn(ex_fn : effect::Exit[Option[String]]) -> Unit {
                        match ex_fn {
                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(None) => finish(effect::Exit::Succeeded(()))
                          effect::Exit::Succeeded(Some(text)) => {
                            self.maybe_progress_reminder_k(a, fn(
                              ex_rem : effect::Exit[(Option[String], Bool)],
                            ) -> Unit {
                              match ex_rem {
                                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                effect::Exit::Succeeded((reminder, reminded)) => {
                                  let body = match reminder {
                                    Some(r) => text + "\n\n" + r
                                    None => text
                                  }
                                  self.start_turn_k(
                                    a,
                                    "job",
                                    body,
                                    turn_for_nobody(),
                                    None,
                                    false,
                                    n,
                                    false,
                                    fn(ex_st : effect::Exit[Unit]) -> Unit {
                                      match ex_st {
                                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                        effect::Exit::Succeeded(_) => {
                                          if reminded {
                                            a.progress_reminded_at = self.gen.counters.now
                                          }
                                          finish(effect::Exit::Succeeded(()))
                                        }
                                      }
                                    },
                                  )
                                }
                              }
                            })
                          }
                        }
                      })
                    }
                  }
                })
              })
            }
          }
        })
      }
    }
  })
}

// ── Pending delivery & pump (`actor_run.mbt:1506-1737`, `1810-1831`) ──

pub fn ActorsGen::delivered_k(
  self : ActorsGen,
  a : Actor,
  d : Delivery,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let handed : Array[base_codec::Json] = []
  for i in 0..<d.pending.length() {
    handed.push(sessions_core::field_of(d.pending[i], "handed"))
  }
  self.store_k(a, "markDelivered", [sessions_core::jstr(a.key), base_codec::json_arr(handed)], fn(
    ex1 : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex1 {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(_) => {
        self.store_k(a, "markWidgetModelsTold", [sessions_core::jstr(a.key), d.widgets], fn(
          ex2 : effect::Exit[base_codec::Json],
        ) -> Unit {
          match ex2 {
            effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(()))
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          }
        })
      }
    }
  })
}

pub fn ActorsGen::pending_and_format_k(
  self : ActorsGen,
  a : Actor,
  allow_empty : Bool,
  k : (effect::Exit[Option[Delivery]]) -> Unit,
) -> Unit {
  self.rpc_k(a.key, "node.pendingAndFormat", [sessions_core::jbool(allow_empty)], fn(
    ex : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(v) => {
        match v {
          base_codec::Json::Obj(_) => {
            let pending = match sessions_core::jget(v, "pending") {
              Some(base_codec::Json::Arr(p)) => p
              _ => []
            }
            let text = str_or(sessions_core::str_of(sessions_core::jget(v, "text")), "")
            let widgets = match sessions_core::jget(v, "widgets") {
              Some(w) => w
              None => base_codec::json_arr([])
            }
            k(effect::Exit::Succeeded(Some(Delivery::{ pending: pending, text: text, widgets: widgets })))
          }
          _ => k(effect::Exit::Succeeded(None))
        }
      }
    }
  })
}

pub fn ActorsGen::pump_k(
  self : ActorsGen,
  a : Actor,
  before_failures : Int,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
    match ex_h {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(is_held) => {
        let after_stopped_notice = fn(ex_sn : effect::Exit[Unit]) -> Unit {
          match ex_sn {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(_) => {
              if a.delivery_interruptions > 0 || a.recoveries > 0 || a.recovery_deferred || is_held || a.compacting {
                k(effect::Exit::Succeeded(()))
                return
              }
              self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
                match ex_ar {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(()))
                  effect::Exit::Succeeded(false) => {
                    match a.codex_update {
                      Some(u) => {
                        if u.finished {
                          self.continue_after_codex_update_k(a, u, k)
                        } else {
                          k(effect::Exit::Succeeded(()))
                        }
                        return
                      }
                      None => ()
                    }
                    self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                      match ex_hp {
                        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                        effect::Exit::Succeeded(false) => k(effect::Exit::Succeeded(()))
                        effect::Exit::Succeeded(true) => {
                          self.compacting_to_cap_k(a, fn(ex_cc : effect::Exit[Bool]) -> Unit {
                            match ex_cc {
                              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                              effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(()))
                              effect::Exit::Succeeded(false) => {
                                if self.interrupted(a) || a.compacting {
                                  k(effect::Exit::Succeeded(()))
                                  return
                                }
                                self.held_k(a, fn(ex_h2 : effect::Exit[Bool]) -> Unit {
                                  match ex_h2 {
                                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                    effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(()))
                                    effect::Exit::Succeeded(false) => {
                                      self.archived_k(a, fn(ex_ar2 : effect::Exit[Bool]) -> Unit {
                                        match ex_ar2 {
                                          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                          effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(()))
                                          effect::Exit::Succeeded(false) => {
                                            self.pump_after_guards_k(a, before_failures, k)
                                          }
                                        }
                                      })
                                    }
                                  }
                                })
                              }
                            }
                          })
                        }
                      }
                    })
                  }
                }
              })
            }
          }
        }
        if is_held {
          self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
            match ex_hp {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
              effect::Exit::Succeeded(false) => after_stopped_notice(effect::Exit::Succeeded(()))
              effect::Exit::Succeeded(true) => {
                self.deps_k(a, "stoppedNotice", [sessions_core::jstr(a.key)], fn(
                  ex_w : effect::Exit[base_codec::Json],
                ) -> Unit {
                  match ex_w {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(v) => {
                      match sessions_core::str_of(Some(v)) {
                        Some(words) => {
                          self.notice_k(
                            a,
                            "⚠️ " + words,
                            base_codec::json_null(),
                            base_codec::json_null(),
                            base_codec::json_null(),
                            None,
                            false,
                            after_stopped_notice,
                          )
                        }
                        None => after_stopped_notice(effect::Exit::Succeeded(()))
                      }
                    }
                  }
                })
              }
            }
          })
        } else {
          after_stopped_notice(effect::Exit::Succeeded(()))
        }
      }
    }
  })
}

fn ActorsGen::pump_after_guards_k(
  self : ActorsGen,
  a : Actor,
  before_failures : Int,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let mut reserved = false
  if !is_some(a.turn) && !a.starting_turn {
    if self.turn_slots_full(a) {
      self.enqueue_turn_wait(a)
      if a.failed_handed != "" {
        self.mirror(a)
        self.notify_store_k(a, k)
      } else {
        k(effect::Exit::Succeeded(()))
      }
      return
    }
    a.starting_turn = true
    reserved = true
  }
  let finish = fn(ex : effect::Exit[Unit]) -> Unit {
    if reserved {
      a.starting_turn = false
      if !self.gen.counters.sealed && !is_some(a.turn) {
        self.drain_turn_queue(!a.paused_cap)
      }
    }
    k(ex)
  }
  self.pending_and_format_k(a, false, fn(ex_pf : effect::Exit[Option[Delivery]]) -> Unit {
    match ex_pf {
      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
      effect::Exit::Succeeded(None) => finish(effect::Exit::Succeeded(()))
      effect::Exit::Succeeded(Some(d)) => {
        if self.interrupted(a) || a.compacting {
          finish(effect::Exit::Succeeded(()))
          return
        }
        self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
          match ex_h {
            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
            effect::Exit::Succeeded(true) => finish(effect::Exit::Succeeded(()))
            effect::Exit::Succeeded(false) => {
              self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
                match ex_ar {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(true) => finish(effect::Exit::Succeeded(()))
                  effect::Exit::Succeeded(false) => {
                    let was = a.agent
                    self.busy_of_k(a, was, fn(ex_b : effect::Exit[Bool]) -> Unit {
                      match ex_b {
                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                        effect::Exit::Succeeded(busy) => {
                          let hkey = handed_ids(d.pending)
                          if !busy && a.paused_cap {
                            if hkey != "" && hkey == a.failed_handed {
                              finish(effect::Exit::Succeeded(()))
                              return
                            }
                            self.remove_cap_wait(a.key)
                            a.paused_cap = false
                            a.cap_wait_notified = false
                            a.force_session_cap = true
                          }
                          if !busy &&
                          before_failures >= 0 &&
                          before_failures < a.start_failures &&
                          hkey != "" &&
                          hkey == a.failed_handed {
                            finish(effect::Exit::Succeeded(()))
                            return
                          }
                          let after_clear_failed = fn(ex_cf : effect::Exit[Unit]) -> Unit {
                            match ex_cf {
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                              effect::Exit::Succeeded(_) => {
                                if !still(a, was) {
                                  finish(effect::Exit::Succeeded(()))
                                  return
                                }
                                if busy {
                                  match was {
                                    Some(agent) => {
                                      self.pump_steer_k(a, agent, was, d, finish)
                                      return
                                    }
                                    None => ()
                                  }
                                }
                                if self.turn_slots_full(a) {
                                  self.enqueue_turn_wait(a)
                                  finish(effect::Exit::Succeeded(()))
                                  return
                                }
                                if !a.starting_turn {
                                  a.starting_turn = true
                                  reserved = true
                                }
                                a.nudges = 0
                                self.cancel_tools_retry(a)
                                a.tools_restarts = 0
                                a.deferred_end = None
                                self.work_for(a, d.pending)
                                let mut by = turn_for_nobody()
                                for i in 0..<d.pending.length() {
                                  let m = d.pending[i]
                                  if opt_str_is(
                                    sessions_core::str_of(sessions_core::jget(m, "authorKind")),
                                    "person",
                                  ) {
                                    by = base_codec::json_obj([
                                      ("person", sessions_core::field_of(m, "person")),
                                      ("thread", sessions_core::field_of(m, "thread")),
                                      ("profile", base_codec::json_null()),
                                    ])
                                    break
                                  }
                                }
                                self.start_turn_k(
                                  a,
                                  "input",
                                  d.text,
                                  by,
                                  Some(d),
                                  false,
                                  0,
                                  false,
                                  fn(ex_st : effect::Exit[Unit]) -> Unit {
                                    match ex_st {
                                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                      effect::Exit::Failed(e) => {
                                        a.start_failures = a.start_failures + 1
                                        a.failed_handed = hkey
                                        self.mirror(a)
                                        self.notify_store_k(a, fn(ex_ns : effect::Exit[Unit]) -> Unit {
                                          match ex_ns {
                                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                            effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                                            effect::Exit::Succeeded(_) => finish(effect::Exit::Failed(e))
                                          }
                                        })
                                      }
                                      effect::Exit::Succeeded(_) => {
                                        a.failed_handed = ""
                                        finish(effect::Exit::Succeeded(()))
                                      }
                                    }
                                  },
                                )
                              }
                            }
                          }
                          if a.failed_handed != "" && !a.paused_cap {
                            a.failed_handed = ""
                            self.mirror(a)
                            self.notify_store_k(a, after_clear_failed)
                          } else {
                            after_clear_failed(effect::Exit::Succeeded(()))
                          }
                        }
                      }
                    })
                  }
                }
              })
            }
          }
        })
      }
    }
  })
}

fn ActorsGen::pump_steer_k(
  self : ActorsGen,
  a : Actor,
  agent : Agent,
  was : Option[Agent],
  d : Delivery,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if a.stale {
    k(effect::Exit::Succeeded(()))
    return
  }
  let before = a.unread.length()
  let mut added = 0
  let batch_start = a.steered_seq + 1
  for i in 0..<d.pending.length() {
    let m = d.pending[i]
    if !is_opt_json_true(sessions_core::jget(m, "apart")) {
      a.unread.push(m)
      added = added + 1
    }
    a.steered_seq = a.steered_seq + 1
    a.steered_unread.push(SteeredUnread::{
      seq: a.steered_seq,
      handed: sessions_core::field_of(m, "handed"),
    })
  }
  let batch_end = a.steered_seq
  a.unread_preparing = added
  a.steered_unread_preparing = d.pending.length()
  if added > 0 {
    self.mirror(a)
  }
  let attempt_turn_id : Option[String] = match a.turn {
    Some(t) => Some(t.id)
    None => None
  }
  let attempt_same = fn() -> Bool {
    a.phase != "closed" &&
    still(a, Some(agent)) &&
    match (a.turn, attempt_turn_id) {
      (Some(t), Some(id)) => t.id == id
      (None, None) => true
      _ => false
    }
  }
  let unsteer = fn() -> Unit {
    if !attempt_same() && a.phase != "closed" {
      return
    }
    a.unread_preparing = 0
    a.steered_unread_preparing = 0
    if a.unread.length() >= before + added {
      for _ in 0..<added {
        let _ = a.unread.pop()
      }
    }
    if batch_end >= batch_start {
      let next_su : Array[SteeredUnread] = []
      for i in 0..<a.steered_unread.length() {
        let item = a.steered_unread[i]
        if item.seq < batch_start || item.seq > batch_end {
          next_su.push(item)
        }
      }
      a.steered_unread = next_su
    }
    if added > 0 {
      self.mirror(a)
    }
  }
  self.deps_k(a, "backgroundOnMessage", [sessions_core::jstr(a.key)], fn(
    ex_bg : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex_bg {
      effect::Exit::Interrupted => {
        unsteer()
        k(effect::Exit::Interrupted)
      }
      effect::Exit::Failed(e) => {
        unsteer()
        k(effect::Exit::Failed(e))
      }
      effect::Exit::Succeeded(bg_v) => {
        let after_bg_tools = fn(ex_bt : effect::Exit[Unit]) -> Unit {
          match ex_bt {
            effect::Exit::Interrupted => {
              unsteer()
              k(effect::Exit::Interrupted)
            }
            effect::Exit::Failed(e) => {
              unsteer()
              k(effect::Exit::Failed(e))
            }
            effect::Exit::Succeeded(_) => {
              if !still(a, was) || a.stale {
                unsteer()
                k(effect::Exit::Succeeded(()))
                return
              }
              self.with_choices_k(a, d.text, fn(ex_wc : effect::Exit[(String, base_codec::Json)]) -> Unit {
                match ex_wc {
                  effect::Exit::Interrupted => {
                    unsteer()
                    k(effect::Exit::Interrupted)
                  }
                  effect::Exit::Failed(e) => {
                    unsteer()
                    k(effect::Exit::Failed(e))
                  }
                  effect::Exit::Succeeded((handed, told)) => {
                    let marked : Array[base_codec::Json] = []
                    for i in 0..<d.pending.length() {
                      marked.push(sessions_core::field_of(d.pending[i], "handed"))
                    }
                    let batch_id = if marked.length() > 0 { self.host.alloc_id() } else { 0 }
                    let settle_delivery = fn() -> Unit {
                      if marked.length() > 0 {
                        self.tell(a.key, "store.deliverySettled", [sessions_core::jint(batch_id)])
                      }
                    }
                    let after_mark = fn(ex_mk : effect::Exit[Unit]) -> Unit {
                      match ex_mk {
                        effect::Exit::Interrupted => {
                          unsteer()
                          if !self.gen.counters.sealed && marked.length() > 0 {
                            sessions_core::try_k(
                              fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                                self.store_direct_k(
                                  a,
                                  "markUndelivered",
                                  [
                                    sessions_core::jstr(a.key),
                                    base_codec::json_arr(marked),
                                    sessions_core::jint(batch_id),
                                  ],
                                  tk,
                                )
                              },
                              fn(_ex_u : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                                k(effect::Exit::Interrupted)
                              },
                            )
                          } else {
                            settle_delivery()
                            k(effect::Exit::Interrupted)
                          }
                        }
                        effect::Exit::Failed(e) => {
                          unsteer()
                          k(effect::Exit::Failed(e))
                        }
                        effect::Exit::Succeeded(_) => {
                          if !attempt_same() {
                            unsteer()
                            if !self.gen.counters.sealed && marked.length() > 0 {
                              sessions_core::try_k(
                                fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                                  self.store_direct_k(
                                    a,
                                    "markUndelivered",
                                    [
                                      sessions_core::jstr(a.key),
                                      base_codec::json_arr(marked),
                                      sessions_core::jint(batch_id),
                                    ],
                                    tk,
                                  )
                                },
                                fn(_ex_u : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                                  k(effect::Exit::Interrupted)
                                },
                              )
                            } else {
                              settle_delivery()
                              k(effect::Exit::Interrupted)
                            }
                            return
                          }
                          a.unread_preparing = 0
                          a.steered_unread_preparing = 0
                          self.timed_k(a, handed, fn(ex_tm : effect::Exit[String]) -> Unit {
                            match ex_tm {
                              effect::Exit::Interrupted => {
                                unsteer()
                                if !self.gen.counters.sealed && marked.length() > 0 {
                                  sessions_core::try_k(
                                    fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                                      self.store_direct_k(
                                        a,
                                        "markUndelivered",
                                        [
                                          sessions_core::jstr(a.key),
                                          base_codec::json_arr(marked),
                                          sessions_core::jint(batch_id),
                                        ],
                                        tk,
                                      )
                                    },
                                    fn(_ex_u : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                                      k(effect::Exit::Interrupted)
                                    },
                                  )
                                } else {
                                  settle_delivery()
                                  k(effect::Exit::Interrupted)
                                }
                              }
                              effect::Exit::Failed(e) => {
                                unsteer()
                                if marked.length() > 0 {
                                  sessions_core::try_k(
                                    fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                                      self.store_direct_k(
                                        a,
                                        "markUndelivered",
                                        [
                                          sessions_core::jstr(a.key),
                                          base_codec::json_arr(marked),
                                          sessions_core::jint(batch_id),
                                        ],
                                        tk,
                                      )
                                    },
                                    fn(ex_u : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                                      match ex_u {
                                        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                        _ => {
                                          if !attempt_same() {
                                            k(effect::Exit::Interrupted)
                                          } else {
                                            k(effect::Exit::Failed(e))
                                          }
                                        }
                                      }
                                    },
                                  )
                                } else if !attempt_same() {
                                  k(effect::Exit::Interrupted)
                                } else {
                                  k(effect::Exit::Failed(e))
                                }
                              }
                              effect::Exit::Succeeded(timed_str) => {
                                if !attempt_same() {
                                  unsteer()
                                  if !self.gen.counters.sealed && marked.length() > 0 {
                                    sessions_core::try_k(
                                      fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                                        self.store_direct_k(
                                          a,
                                          "markUndelivered",
                                          [
                                            sessions_core::jstr(a.key),
                                            base_codec::json_arr(marked),
                                            sessions_core::jint(batch_id),
                                          ],
                                          tk,
                                        )
                                      },
                                      fn(_ex_u : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                                        k(effect::Exit::Interrupted)
                                      },
                                    )
                                  } else {
                                    settle_delivery()
                                    k(effect::Exit::Interrupted)
                                  }
                                  return
                                }
                                // Direct RPC: once `agent.steer` is dispatched to Node, settle on
                                // its real receipt even if `close(a)` arrives in flight so a
                                // rejected steer (`false` / `Failed`) still restores delivery.
                                self.rpc_direct_k(
                                  a.key,
                                  "agent.steer",
                                  [sessions_core::jint(agent.handle), sessions_core::jstr(timed_str)],
                                  fn(ex_st : effect::Exit[base_codec::Json]) -> Unit {
                                    match ex_st {
                                      effect::Exit::Interrupted => {
                                        unsteer()
                                        settle_delivery()
                                        k(effect::Exit::Interrupted)
                                      }
                                      effect::Exit::Failed(e) => {
                                        unsteer()
                                        if marked.length() > 0 {
                                          sessions_core::try_k(
                                            fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                                              self.store_direct_k(
                                                a,
                                                "markUndelivered",
                                                [
                                                  sessions_core::jstr(a.key),
                                                  base_codec::json_arr(marked),
                                                  sessions_core::jint(batch_id),
                                                ],
                                                tk,
                                              )
                                            },
                                            fn(ex_u : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                                              match ex_u {
                                                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                _ => {
                                                  if !attempt_same() {
                                                    k(effect::Exit::Interrupted)
                                                  } else {
                                                    k(effect::Exit::Failed(e))
                                                  }
                                                }
                                              }
                                            },
                                          )
                                        } else if !attempt_same() {
                                          k(effect::Exit::Interrupted)
                                        } else {
                                          k(effect::Exit::Failed(e))
                                        }
                                      }
                                      effect::Exit::Succeeded(sv) => {
                                        if !sessions_core::truthy(sv) {
                                          unsteer()
                                          if marked.length() > 0 {
                                            self.store_direct_k(
                                              a,
                                              "markUndelivered",
                                              [
                                                sessions_core::jstr(a.key),
                                                base_codec::json_arr(marked),
                                                sessions_core::jint(batch_id),
                                              ],
                                              fn(ex_u : effect::Exit[base_codec::Json]) -> Unit {
                                                match ex_u {
                                                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                  effect::Exit::Failed(e) => {
                                                    if !attempt_same() {
                                                      k(effect::Exit::Interrupted)
                                                    } else {
                                                      k(effect::Exit::Failed(e))
                                                    }
                                                  }
                                                  effect::Exit::Succeeded(_) => {
                                                    if !attempt_same() {
                                                      k(effect::Exit::Interrupted)
                                                    } else {
                                                      k(effect::Exit::Succeeded(()))
                                                    }
                                                  }
                                                }
                                              },
                                            )
                                          } else if !attempt_same() {
                                            k(effect::Exit::Interrupted)
                                          } else {
                                            k(effect::Exit::Succeeded(()))
                                          }
                                        } else {
                                          settle_delivery()
                                          if !attempt_same() {
                                            k(effect::Exit::Interrupted)
                                            return
                                          }
                                          self.told_k(a, told, fn(ex_td : effect::Exit[Unit]) -> Unit {
                                            match ex_td {
                                              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                              effect::Exit::Succeeded(_) => {
                                                if !attempt_same() {
                                                  k(effect::Exit::Interrupted)
                                                  return
                                                }
                                                self.work_for(a, d.pending)
                                                self.store_k(
                                                  a,
                                                  "markWidgetModelsTold",
                                                  [sessions_core::jstr(a.key), d.widgets],
                                                  fn(ex_mw : effect::Exit[base_codec::Json]) -> Unit {
                                                    match ex_mw {
                                                      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                                      effect::Exit::Succeeded(_) => {
                                                        if !attempt_same() {
                                                          k(effect::Exit::Interrupted)
                                                          return
                                                        }
                                                        for i in 0..<d.pending.length() {
                                                          a.steered.push(
                                                            sessions_core::field_of(d.pending[i], "handed"),
                                                          )
                                                        }
                                                        let matches_pending = fn(w : Working) -> Bool {
                                                          for i in 0..<d.pending.length() {
                                                            let m = d.pending[i]
                                                            if opt_str_is(
                                                              sessions_core::str_of(sessions_core::jget(m, "connect")),
                                                              w.connect,
                                                            ) &&
                                                            opt_str_is(
                                                              sessions_core::str_of(sessions_core::jget(m, "channel")),
                                                              w.channel,
                                                            ) &&
                                                            opt_str_is(
                                                              sessions_core::str_of(sessions_core::jget(m, "threadTs")),
                                                              w.thread_ts,
                                                            ) {
                                                              return true
                                                            }
                                                          }
                                                          false
                                                        }
                                                        let next_sf : Array[Working] = []
                                                        for i in 0..<a.steered_for.length() {
                                                          if !matches_pending(a.steered_for[i]) {
                                                            next_sf.push(a.steered_for[i])
                                                          }
                                                        }
                                                        for i in 0..<a.working_for.length() {
                                                          if matches_pending(a.working_for[i]) {
                                                            next_sf.push(a.working_for[i])
                                                          }
                                                        }
                                                        a.steered_for = next_sf
                                                        k(effect::Exit::Succeeded(()))
                                                      }
                                                    }
                                                  },
                                                )
                                              }
                                            }
                                          })
                                        }
                                      }
                                    }
                                  },
                                )
                              }
                            }
                          })
                        }
                      }
                    }
                    if marked.length() > 0 {
                      // Tracked store call: same-generation `close(a)` cancels this RPC
                      // immediately so `hub_asked` settles even if Node drops it, and
                      // `after_mark` `Interrupted` idempotently compensates with `markUndelivered`.
                      self.store_k(
                        a,
                        "markDelivered",
                        [
                          sessions_core::jstr(a.key),
                          base_codec::json_arr(marked),
                          sessions_core::jint(batch_id),
                        ],
                        fn(ex_m : effect::Exit[base_codec::Json]) -> Unit {
                          match ex_m {
                            effect::Exit::Succeeded(_) => after_mark(effect::Exit::Succeeded(()))
                            effect::Exit::Failed(e) => after_mark(effect::Exit::Failed(e))
                            effect::Exit::Interrupted => after_mark(effect::Exit::Interrupted)
                          }
                        },
                      )
                    } else {
                      after_mark(effect::Exit::Succeeded(()))
                    }
                  }
                }
              })
            }
          }
        }
        if sessions_core::truthy(bg_v) {
          self.agent_do_k(a, agent, "backgroundTools", [], fn(
            ex_bt : effect::Exit[base_codec::Json],
          ) -> Unit {
            match ex_bt {
              effect::Exit::Succeeded(_) => after_bg_tools(effect::Exit::Succeeded(()))
              effect::Exit::Failed(e) => after_bg_tools(effect::Exit::Failed(e))
              effect::Exit::Interrupted => after_bg_tools(effect::Exit::Interrupted)
            }
          })
        } else {
          after_bg_tools(effect::Exit::Succeeded(()))
        }
      }
    }
  })
}

/// After a warm's opening timed out (`e`): whether messages were waiting on it (`actor_run.mbt:1709-1737`).
pub fn ActorsGen::warm_waited_on_k(
  self : ActorsGen,
  a : Actor,
  e : effect::EffectError,
  k : (effect::Exit[Bool]) -> Unit,
) -> Unit {
  if self.interrupted(a) {
    k(effect::Exit::Succeeded(false))
    return
  }
  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
    match ex_h {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
      effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(false))
      effect::Exit::Succeeded(false) => {
        self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
          match ex_ar {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
            effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(false))
            effect::Exit::Succeeded(false) => {
              self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                match ex_hp {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                  effect::Exit::Succeeded(false) => k(effect::Exit::Succeeded(false))
                  effect::Exit::Succeeded(true) => {
                    self.pending_and_format_k(a, false, fn(ex_pf : effect::Exit[Option[Delivery]]) -> Unit {
                      match ex_pf {
                        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                        effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                        effect::Exit::Succeeded(None) => k(effect::Exit::Succeeded(false))
                        effect::Exit::Succeeded(Some(d)) => {
                          let hkey = handed_ids(d.pending)
                          if hkey == "" {
                            k(effect::Exit::Succeeded(false))
                            return
                          }
                          a.start_failures = a.start_failures + 1
                          a.failed_handed = hkey
                          self.mirror(a)
                          self.notify_store_k(a, fn(ex_ns : effect::Exit[Unit]) -> Unit {
                            match ex_ns {
                              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                              effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                              effect::Exit::Succeeded(_) => {
                                self.failed_words_k(a, "cannotStartWords", e, fn(
                                  ex_fw : effect::Exit[String],
                                ) -> Unit {
                                  match ex_fw {
                                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                    effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                                    effect::Exit::Succeeded(fw) => {
                                      let said = "⚠️ " + fw
                                      self.t_k(
                                        a,
                                        "station.notice.cannotStart",
                                        base_codec::json_null(),
                                        fn(ex_cs : effect::Exit[String]) -> Unit {
                                          match ex_cs {
                                            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                            effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                                            effect::Exit::Succeeded(cs) => {
                                              let cannot_start = "⚠️ " + cs
                                              self.said_last_k(a, fn(ex_sl : effect::Exit[Option[String]]) -> Unit {
                                                match ex_sl {
                                                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                  effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                                                  effect::Exit::Succeeded(last_opt) => {
                                                    let post_if_not_dup = fn(is_dup : Bool) -> Unit {
                                                      if !is_dup {
                                                        self.notice_k(
                                                          a,
                                                          said,
                                                          base_codec::json_null(),
                                                          base_codec::json_null(),
                                                          base_codec::json_null(),
                                                          None,
                                                          false,
                                                          fn(ex_n : effect::Exit[Unit]) -> Unit {
                                                            match ex_n {
                                                              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                              effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                                                              effect::Exit::Succeeded(_) => {
                                                                self.tell_opener_failed_k(a, said, fn(ex_to : effect::Exit[Unit]) -> Unit {
                                                                  match ex_to {
                                                                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                                    effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                                                                    effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(true))
                                                                  }
                                                                })
                                                              }
                                                            }
                                                          },
                                                        )
                                                      } else {
                                                        k(effect::Exit::Succeeded(true))
                                                      }
                                                    }
                                                    match last_opt {
                                                      Some(l) => {
                                                        if l == said {
                                                          post_if_not_dup(true)
                                                        } else if l.starts_with(cannot_start) {
                                                          self.missing_said_k(a, fn(ex_ms : effect::Exit[String]) -> Unit {
                                                            match ex_ms {
                                                              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                              effect::Exit::Failed(err) => k(effect::Exit::Failed(err))
                                                              effect::Exit::Succeeded(ms) => post_if_not_dup(l != ms)
                                                            }
                                                          })
                                                        } else {
                                                          post_if_not_dup(false)
                                                        }
                                                      }
                                                      None => post_if_not_dup(false)
                                                    }
                                                  }
                                                }
                                              })
                                            }
                                          }
                                        },
                                      )
                                    }
                                  }
                                })
                              }
                            }
                          })
                        }
                      }
                    })
                  }
                }
              })
            }
          }
        })
      }
    }
  })
}

fn ActorsGen::missing_said_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[String]) -> Unit,
) -> Unit {
  self.rpc_k(a.key, "node.words", [sessions_core::jstr("runtimeLabel"), sessions_core::jstr(a.runtime)], fn(
    ex_lbl : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex_lbl {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(lbl) => {
        self.t_k(a, "station.notice.runtimeMissing", base_codec::json_obj([("name", lbl)]), fn(
          ex_t : effect::Exit[String],
        ) -> Unit {
          match ex_t {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(s) => k(effect::Exit::Succeeded("⚠️ " + s))
          }
        })
      }
    }
  })
}

// ── Session cap pause & start_turn / start_turn_body / begin_turn (`actor_run.mbt:1849-2188`) ──

pub fn ActorsGen::pause_for_session_cap_k(
  self : ActorsGen,
  a : Actor,
  profile : String,
  active : Int,
  cap : Int,
  protection : Bool,
  kind : String,
  by : base_codec::Json,
  turn : Option[Turn],
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  self.enqueue_cap_wait(a)
  a.paused_cap = true
  a.force_session_cap = false
  let finish_pause = fn(ex : effect::Exit[Unit]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(_) => {
        self.set_running_k(a, false, fn(ex1 : effect::Exit[Unit]) -> Unit {
          match ex1 {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(_) => {
              self.live_turn_ended_k(a, fn(ex2 : effect::Exit[Unit]) -> Unit {
                match ex2 {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(_) => {
                    self.done_working(a)
                    k(effect::Exit::Succeeded(()))
                  }
                }
              })
            }
          }
        })
      }
    }
  }
  if !a.cap_wait_notified {
    self.log(
      a,
      "info",
      "session queued by account concurrency cap",
      [
        ("active", sessions_core::jint(active)),
        ("cap", sessions_core::jint(cap)),
        ("runtime", sessions_core::jstr(a.runtime)),
      ],
    )
    let with_tid = fn(tid : String) -> Unit {
      self.store_k(
        a,
        "endTurn",
        [
          sessions_core::jstr(tid),
          sessions_core::jstr("failed"),
          sessions_core::jstr("other: session_cap"),
          base_codec::json_null(),
          base_codec::json_null(),
        ],
        fn(ex_et : effect::Exit[base_codec::Json]) -> Unit {
          match ex_et {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(_) => {
              let notice_key = if protection {
                "station.notice.accountCapProtectionPaused"
              } else {
                "station.notice.accountCapPaused"
              }
              self.t_k(
                a,
                notice_key,
                base_codec::json_obj([
                  ("profile", sessions_core::jstr(profile)),
                  ("active", sessions_core::jint(active)),
                  ("cap", sessions_core::jint(cap)),
                ]),
                fn(ex_t : effect::Exit[String]) -> Unit {
                  match ex_t {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(said) => {
                      self.notice_k(
                        a,
                        said,
                        base_codec::json_null(),
                        base_codec::json_null(),
                        base_codec::json_null(),
                        Some(tid),
                        false,
                        fn(ex_n : effect::Exit[Unit]) -> Unit {
                          match ex_n {
                            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(_) => {
                              a.cap_wait_notified = true
                              finish_pause(effect::Exit::Succeeded(()))
                            }
                          }
                        },
                      )
                    }
                  }
                },
              )
            }
          }
        },
      )
    }
    match turn {
      Some(t) => with_tid(t.id)
      None => {
        self.rpc_k(a.key, "node.uuid", [], fn(ex_u : effect::Exit[base_codec::Json]) -> Unit {
          match ex_u {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(v) => {
              let id = str_or(sessions_core::str_of(Some(v)), "")
              self.store_k(
                a,
                "startTurnFor",
                [sessions_core::jstr(id), sessions_core::jstr(a.key), sessions_core::jstr(kind), by],
                fn(ex_s : effect::Exit[base_codec::Json]) -> Unit {
                  match ex_s {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => with_tid(id)
                  }
                },
              )
            }
          }
        })
      }
    }
  } else {
    match turn {
      Some(t) => {
        self.store_k(
          a,
          "endTurn",
          [
            sessions_core::jstr(t.id),
            sessions_core::jstr("failed"),
            sessions_core::jstr("other: session_cap"),
            base_codec::json_null(),
            base_codec::json_null(),
          ],
          fn(ex_et : effect::Exit[base_codec::Json]) -> Unit {
            match ex_et {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
              effect::Exit::Succeeded(_) => finish_pause(effect::Exit::Succeeded(()))
            }
          },
        )
      }
      None => finish_pause(effect::Exit::Succeeded(()))
    }
  }
}

pub fn ActorsGen::start_turn_k(
  self : ActorsGen,
  a : Actor,
  kind : String,
  text : String,
  by : base_codec::Json,
  delivery : Option[Delivery],
  passive : Bool,
  notices_taken : Int,
  fresh : Bool,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let own_slot = !a.starting_turn
  if own_slot {
    a.starting_turn = true
  }
  let mut paused_by_cap = false
  let finish = fn(ex : effect::Exit[Unit]) -> Unit {
    if own_slot {
      a.starting_turn = false
      if !self.gen.counters.sealed && !is_some(a.turn) {
        self.drain_turn_queue(!paused_by_cap)
      }
    }
    k(ex)
  }
  self.words_k(a, "GO_ON_AFTER_OVERLOADED", [], fn(ex_ov : effect::Exit[String]) -> Unit {
    match ex_ov {
      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
      effect::Exit::Succeeded(ov_words) => {
        let with_retry_about = fn(retry_about : base_codec::Json) -> Unit {
          let check_arch = fn(cont : () -> Unit) -> Unit {
            if kind != "input" {
              self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
                match ex_ar {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(true) => {
                    self.log(a, "info", "archived: no turn of its own", [
                      ("kind", sessions_core::jstr(kind)),
                    ])
                    finish(effect::Exit::Succeeded(()))
                  }
                  effect::Exit::Succeeded(false) => cont()
                }
              })
            } else {
              cont()
            }
          }
          check_arch(fn() -> Unit {
            if kind != "auth_retry" {
              a.auth_tried = []
            }
            self.start_turn_body_k(
              a,
              kind,
              text,
              by,
              retry_about,
              delivery,
              passive,
              notices_taken,
              fresh,
              fn(ex_body : effect::Exit[Unit]) -> Unit {
                match ex_body {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Succeeded(_) => {
                    match delivery {
                      Some(d) => {
                        self.store_k(
                          a,
                          "markWidgetModelsTold",
                          [sessions_core::jstr(a.key), d.widgets],
                          fn(ex_mw : effect::Exit[base_codec::Json]) -> Unit {
                            match ex_mw {
                              effect::Exit::Succeeded(_) => finish(effect::Exit::Succeeded(()))
                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                            }
                          },
                        )
                      }
                      None => finish(effect::Exit::Succeeded(()))
                    }
                  }
                  effect::Exit::Failed(e) => {
                    let turn = a.turn
                    a.turn = None
                    if a.phase == "closed" {
                      finish(effect::Exit::Interrupted)
                      return
                    }
                    match open_abort_reason(e) {
                      Some(why) => {
                        if why == "closed" {
                          finish(effect::Exit::Succeeded(()))
                          return
                        }
                        a.phase = "idle"
                        let after_stop_delivery = fn(ex_sd : effect::Exit[Unit]) -> Unit {
                          match ex_sd {
                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                            effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                            effect::Exit::Succeeded(_) => {
                              let after_end_turn = fn(ex_et : effect::Exit[Unit]) -> Unit {
                                match ex_et {
                                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                  effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                                  effect::Exit::Succeeded(_) => {
                                    self.set_running_k(a, false, fn(ex_sr : effect::Exit[Unit]) -> Unit {
                                      match ex_sr {
                                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                        effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                                        effect::Exit::Succeeded(_) => {
                                          self.live_turn_ended_k(a, fn(ex_lt : effect::Exit[Unit]) -> Unit {
                                            match ex_lt {
                                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                              effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                                              effect::Exit::Succeeded(_) => {
                                                self.done_working(a)
                                                finish(effect::Exit::Succeeded(()))
                                              }
                                            }
                                          })
                                        }
                                      }
                                    })
                                  }
                                }
                              }
                              match turn {
                                Some(t) => {
                                  let stopped = why == "stopped"
                                  self.emit_turn_trace(a, t, "stopped")
                                  self.store_k(
                                    a,
                                    "endTurn",
                                    [
                                      sessions_core::jstr(t.id),
                                      sessions_core::jstr("aborted"),
                                      sessions_core::jstr(if stopped { "user" } else { "other: " + why }),
                                      if stopped { sessions_core::jstr("stopped") } else { base_codec::json_null() },
                                      base_codec::json_null(),
                                    ],
                                    fn(ex_e : effect::Exit[base_codec::Json]) -> Unit {
                                      match ex_e {
                                        effect::Exit::Succeeded(_) => after_end_turn(effect::Exit::Succeeded(()))
                                        effect::Exit::Failed(e2) => after_end_turn(effect::Exit::Failed(e2))
                                        effect::Exit::Interrupted => after_end_turn(effect::Exit::Interrupted)
                                      }
                                    },
                                  )
                                }
                                None => after_end_turn(effect::Exit::Succeeded(()))
                              }
                            }
                          }
                        }
                        if why == "stopped" {
                          let after_deliv = fn(ex_sd : effect::Exit[Unit]) -> Unit {
                            match ex_sd {
                              effect::Exit::Succeeded(_) => {
                                let _ = drain_notices(a, notices_taken)
                                after_stop_delivery(effect::Exit::Succeeded(()))
                              }
                              effect::Exit::Failed(e2) => after_stop_delivery(effect::Exit::Failed(e2))
                              effect::Exit::Interrupted => after_stop_delivery(effect::Exit::Interrupted)
                            }
                          }
                          match delivery {
                            Some(d) => self.delivered_k(a, d, after_deliv)
                            None => after_deliv(effect::Exit::Succeeded(()))
                          }
                        } else {
                          after_stop_delivery(effect::Exit::Succeeded(()))
                        }
                        return
                      }
                      None => ()
                    }
                    a.phase = "idle"
                    match session_cap_info(e) {
                      Some((profile, active, cap, protection)) => {
                        paused_by_cap = true
                        match turn {
                          Some(t) => self.emit_turn_trace(a, t, "cap")
                          None => ()
                        }
                        self.pause_for_session_cap_k(
                          a,
                          profile,
                          active,
                          cap,
                          protection,
                          kind,
                          by,
                          turn,
                          fn(ex_pc : effect::Exit[Unit]) -> Unit {
                            match ex_pc {
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                              effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                              effect::Exit::Succeeded(_) => {
                                // (a turn of its own, on no messages or notices, is had once woken: those are taken up
                                // again as they wait)
                                let handed = match delivery {
                                  Some(d) => d.pending.length() > 0
                                  None => false
                                }
                                if kind != "input" && !handed && notices_taken == 0 && !is_some(a.queued_retry) {
                                  a.queued_retry = Some(QueuedRetry::{
                                    kind: kind,
                                    text: text,
                                    by: by,
                                    codex_retried: false,
                                    passive: passive,
                                    fresh: fresh,
                                  })
                                }
                                finish(effect::Exit::Failed(e))
                              }
                            }
                          },
                        )
                        return
                      }
                      None => ()
                    }
                    self.start_turn_handle_error_k(a, turn, e, finish)
                  }
                }
              },
            )
          })
        }
        if text == ov_words {
          self.last_turn_k(a, fn(ex_lt : effect::Exit[base_codec::Json]) -> Unit {
            match ex_lt {
              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
              effect::Exit::Succeeded(last) => with_retry_about(sessions_core::field_of(last, "about"))
            }
          })
        } else {
          with_retry_about(base_codec::json_null())
        }
      }
    }
  })
}

fn ActorsGen::start_turn_handle_error_k(
  self : ActorsGen,
  a : Actor,
  turn : Option[Turn],
  e : effect::EffectError,
  finish : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let message = match asked_cause(e) {
    Some(j) => str_or(sessions_core::str_of(sessions_core::jget(j, "message")), "")
    None => sessions_core::error_message(e)
  }
  let after_end = fn(ex_et : effect::Exit[Unit]) -> Unit {
    match ex_et {
      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
      effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
      effect::Exit::Succeeded(_) => {
        self.set_running_k(a, false, fn(ex_sr : effect::Exit[Unit]) -> Unit {
          match ex_sr {
            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
            effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
            effect::Exit::Succeeded(_) => {
              self.live_turn_ended_k(a, fn(ex_lt : effect::Exit[Unit]) -> Unit {
                match ex_lt {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                  effect::Exit::Succeeded(_) => {
                    self.done_working(a)
                    let missing = match asked_cause(e) {
                      Some(j) => is_opt_json_true(sessions_core::jget(j, "missing"))
                      None => false
                    }
                    match asked_cause(e) {
                      Some(j) => {
                        match sessions_core::str_of(sessions_core::jget(j, "runtime")) {
                          Some(rt) => a.runtime = rt
                          None => ()
                        }
                      }
                      None => ()
                    }
                    let after_missing_dep = fn(ex_md : effect::Exit[Unit]) -> Unit {
                      match ex_md {
                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                        effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                        effect::Exit::Succeeded(_) => {
                          let with_said = fn(ex_s : effect::Exit[String]) -> Unit {
                            match ex_s {
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                              effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                              effect::Exit::Succeeded(said) => {
                                self.t_k(
                                  a,
                                  "station.notice.cannotStart",
                                  base_codec::json_null(),
                                  fn(ex_cs : effect::Exit[String]) -> Unit {
                                    match ex_cs {
                                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                      effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                                      effect::Exit::Succeeded(cs) => {
                                        let cannot_start = "⚠️ " + cs
                                        self.said_last_k(a, fn(ex_sl : effect::Exit[Option[String]]) -> Unit {
                                          match ex_sl {
                                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                            effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                                            effect::Exit::Succeeded(last_opt) => {
                                              let post_if_not_dup = fn(is_dup : Bool) -> Unit {
                                                if !is_dup {
                                                  let about_id = match turn {
                                                    Some(t) => Some(t.id)
                                                    None => None
                                                  }
                                                  self.notice_k(
                                                    a,
                                                    said,
                                                    base_codec::json_null(),
                                                    if missing { sessions_core::jstr(a.runtime) } else { base_codec::json_null() },
                                                    base_codec::json_null(),
                                                    about_id,
                                                    false,
                                                    fn(ex_n : effect::Exit[Unit]) -> Unit {
                                                      match ex_n {
                                                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                        effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                                                        effect::Exit::Succeeded(_) => {
                                                          self.tell_opener_failed_k(a, said, fn(ex_to : effect::Exit[Unit]) -> Unit {
                                                            match ex_to {
                                                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                              _ => finish(effect::Exit::Failed(e))
                                                            }
                                                          })
                                                        }
                                                      }
                                                    },
                                                  )
                                                } else {
                                                  finish(effect::Exit::Failed(e))
                                                }
                                              }
                                              match last_opt {
                                                Some(l) => {
                                                  if l == said {
                                                    post_if_not_dup(true)
                                                  } else if !missing && l.starts_with(cannot_start) {
                                                    self.missing_said_k(a, fn(ex_ms : effect::Exit[String]) -> Unit {
                                                      match ex_ms {
                                                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                        effect::Exit::Failed(e2) => finish(effect::Exit::Failed(e2))
                                                        effect::Exit::Succeeded(ms) => post_if_not_dup(l != ms)
                                                      }
                                                    })
                                                  } else {
                                                    post_if_not_dup(false)
                                                  }
                                                }
                                                None => post_if_not_dup(false)
                                              }
                                            }
                                          }
                                        })
                                      }
                                    }
                                  },
                                )
                              }
                            }
                          }
                          if missing {
                            self.missing_said_k(a, with_said)
                          } else {
                            self.failed_words_k(a, "cannotStartWords", e, fn(ex_fw : effect::Exit[String]) -> Unit {
                              match ex_fw {
                                effect::Exit::Succeeded(fw) => with_said(effect::Exit::Succeeded("⚠️ " + fw))
                                effect::Exit::Failed(e2) => with_said(effect::Exit::Failed(e2))
                                effect::Exit::Interrupted => with_said(effect::Exit::Interrupted)
                              }
                            })
                          }
                        }
                      }
                    }
                    if missing {
                      self.deps_k(a, "runtimeMissing", [sessions_core::jstr(a.runtime)], fn(
                        ex_rm : effect::Exit[base_codec::Json],
                      ) -> Unit {
                        match ex_rm {
                          effect::Exit::Succeeded(_) => after_missing_dep(effect::Exit::Succeeded(()))
                          effect::Exit::Failed(e2) => after_missing_dep(effect::Exit::Failed(e2))
                          effect::Exit::Interrupted => after_missing_dep(effect::Exit::Interrupted)
                        }
                      })
                    } else {
                      after_missing_dep(effect::Exit::Succeeded(()))
                    }
                  }
                }
              })
            }
          }
        })
      }
    }
  }
  match turn {
    Some(t) => {
      self.emit_turn_trace(a, t, "failed")
      self.store_k(
        a,
        "endTurn",
        [
          sessions_core::jstr(t.id),
          sessions_core::jstr("failed"),
          sessions_core::jstr("other: " + message),
          base_codec::json_null(),
          base_codec::json_null(),
        ],
        fn(ex_e : effect::Exit[base_codec::Json]) -> Unit {
          match ex_e {
            effect::Exit::Succeeded(_) => after_end(effect::Exit::Succeeded(()))
            effect::Exit::Failed(e2) => after_end(effect::Exit::Failed(e2))
            effect::Exit::Interrupted => after_end(effect::Exit::Interrupted)
          }
        },
      )
    }
    None => after_end(effect::Exit::Succeeded(()))
  }
}

pub fn ActorsGen::start_turn_body_k(
  self : ActorsGen,
  a : Actor,
  kind : String,
  text : String,
  by : base_codec::Json,
  retry_about : base_codec::Json,
  delivery : Option[Delivery],
  passive : Bool,
  notices_taken : Int,
  fresh : Bool,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  (self.live.live_event)(
    a.key,
    base_codec::json_obj([
      ("kind", sessions_core::jstr("phase")),
      ("phase", sessions_core::jstr("starting")),
    ]),
  )
  let after_cold_afresh = fn(ex_ca : effect::Exit[Unit]) -> Unit {
    match ex_ca {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(_) => {
        let after_refused = fn(ex_rf : effect::Exit[Unit]) -> Unit {
          match ex_rf {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(_) => {
              self.open_over_k(a, passive, fn(ex_oo : effect::Exit[Agent]) -> Unit {
                match ex_oo {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(opened_agent) => {
                    let lost = a.resume_lost
                    a.resume_lost = false
                    self.with_choices_k(a, text, fn(ex_wc : effect::Exit[(String, base_codec::Json)]) -> Unit {
                      match ex_wc {
                        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                        effect::Exit::Succeeded((handed, told_choices)) => {
                          a.turn_text = handed
                          let stopped = a.stopped_note
                          a.stopped_note = None
                          let afresh = a.afresh
                          a.afresh = None
                          let compacted = a.compacted_untold
                          a.compacted_untold = false
                          let stopped_j = match stopped {
                            Some(s) => sessions_core::jstr(s)
                            None => base_codec::json_null()
                          }
                          let afresh_j = match afresh {
                            Some(s) => sessions_core::jstr(s)
                            None => base_codec::json_null()
                          }
                          self.rpc_k(
                            a.key,
                            "node.prompt",
                            [
                              sessions_core::jstr(handed),
                              sessions_core::jbool(lost),
                              stopped_j,
                              afresh_j,
                              sessions_core::jbool(compacted),
                            ],
                            fn(ex_pr : effect::Exit[base_codec::Json]) -> Unit {
                              match ex_pr {
                                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                effect::Exit::Succeeded(pr_v) => {
                                  let prompt = str_or(sessions_core::str_of(Some(pr_v)), handed)
                                  let with_final_agent = fn(agent : Agent) -> Unit {
                                    self.start_turn_send_prompt_k(
                                      a,
                                      agent,
                                      kind,
                                      by,
                                      retry_about,
                                      delivery,
                                      passive,
                                      notices_taken,
                                      fresh,
                                      prompt,
                                      told_choices,
                                      k,
                                    )
                                  }
                                  if a.stale {
                                    self.busy_of_k(a, Some(opened_agent), fn(ex_b : effect::Exit[Bool]) -> Unit {
                                      match ex_b {
                                        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                        effect::Exit::Succeeded(true) => with_final_agent(opened_agent)
                                        effect::Exit::Succeeded(false) => {
                                          self.ensure_agent_k(a, fn(ex_ea : effect::Exit[Agent]) -> Unit {
                                            match ex_ea {
                                              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                              effect::Exit::Succeeded(ag2) => with_final_agent(ag2)
                                            }
                                          })
                                        }
                                      }
                                    })
                                  } else {
                                    with_final_agent(opened_agent)
                                  }
                                }
                              }
                            },
                          )
                        }
                      }
                    })
                  }
                }
              })
            }
          }
        }
        if (kind == "input" || kind == "resume" || kind == "job") && a.runtime == "codex" {
          self.busy_k(a, fn(ex_b : effect::Exit[Bool]) -> Unit {
            match ex_b {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
              effect::Exit::Succeeded(false) => self.refused_thread_k(a, after_refused)
              effect::Exit::Succeeded(true) => after_refused(effect::Exit::Succeeded(()))
            }
          })
        } else {
          after_refused(effect::Exit::Succeeded(()))
        }
      }
    }
  }
  if kind == "input" || kind == "job" {
    self.holding_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
      match ex_h {
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
        effect::Exit::Succeeded(true) => after_cold_afresh(effect::Exit::Succeeded(()))
        effect::Exit::Succeeded(false) => {
          self.busy_k(a, fn(ex_b : effect::Exit[Bool]) -> Unit {
            match ex_b {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
              effect::Exit::Succeeded(true) => after_cold_afresh(effect::Exit::Succeeded(()))
              effect::Exit::Succeeded(false) => {
                self.deps_k(
                  a,
                  "coldAfresh",
                  [sessions_core::jstr(a.key), sessions_core::jnum(self.gen.counters.now)],
                  fn(ex_cf : effect::Exit[base_codec::Json]) -> Unit {
                    match ex_cf {
                      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(base_codec::Json::Bool(true)) => {
                        self.clear_now_k(
                          a,
                          true,
                          "station.notice.afreshCold",
                          "as its cache is over",
                          true,
                          fn(ex_cl : effect::Exit[Option[String]]) -> Unit {
                            match ex_cl {
                              effect::Exit::Succeeded(_) => after_cold_afresh(effect::Exit::Succeeded(()))
                              effect::Exit::Failed(e) => after_cold_afresh(effect::Exit::Failed(e))
                              effect::Exit::Interrupted => after_cold_afresh(effect::Exit::Interrupted)
                            }
                          },
                        )
                      }
                      effect::Exit::Succeeded(_) => after_cold_afresh(effect::Exit::Succeeded(()))
                    }
                  },
                )
              }
            }
          })
        }
      }
    })
  } else {
    after_cold_afresh(effect::Exit::Succeeded(()))
  }
}

fn ActorsGen::start_turn_send_prompt_k(
  self : ActorsGen,
  a : Actor,
  agent : Agent,
  kind : String,
  by : base_codec::Json,
  retry_about : base_codec::Json,
  delivery : Option[Delivery],
  passive : Bool,
  notices_taken : Int,
  fresh : Bool,
  prompt : String,
  told_choices : base_codec::Json,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let delivered : Array[base_codec::Json] = match delivery {
    Some(d) => {
      let arr : Array[base_codec::Json] = []
      for i in 0..<d.pending.length() {
        arr.push(sessions_core::field_of(d.pending[i], "handed"))
      }
      arr
    }
    None => []
  }
  let proceed_prompt = fn() -> Unit {
    a.steered = []
    a.steered_for = []
    a.unread = []
    a.unread_preparing = 0
    a.steered_unread = []
    a.steered_unread_preparing = 0
    a.steered_notices = []
    self.begin_turn_k(a, kind, by, passive, fresh, fn(ex_bt : effect::Exit[Unit]) -> Unit {
      match ex_bt {
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
        effect::Exit::Succeeded(_) => {
          let after_about = fn(ex_ab : effect::Exit[Unit]) -> Unit {
            match ex_ab {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
              effect::Exit::Succeeded(_) => {
                let marked = delivered.length() > 0
                let batch_id = if marked { self.host.alloc_id() } else { 0 }
                let settle_delivery = fn() -> Unit {
                  if marked {
                    self.tell(a.key, "store.deliverySettled", [sessions_core::jint(batch_id)])
                  }
                }
                let after_mark = fn(ex_mk : effect::Exit[Unit]) -> Unit {
                  match ex_mk {
                    effect::Exit::Interrupted => {
                      if !self.gen.counters.sealed && marked {
                        sessions_core::try_k(
                          fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                            self.store_direct_k(
                              a,
                              "markUndelivered",
                              [
                                sessions_core::jstr(a.key),
                                base_codec::json_arr(delivered),
                                sessions_core::jint(batch_id),
                              ],
                              tk,
                            )
                          },
                          fn(_ex_u : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                            k(effect::Exit::Interrupted)
                          },
                        )
                      } else {
                        settle_delivery()
                        k(effect::Exit::Interrupted)
                      }
                    }
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => {
                      let drained_notices = drain_notices(a, notices_taken)
                      self.agent_do_k(a, agent, "prompt", [sessions_core::jstr(prompt)], fn(
                        ex_p : effect::Exit[base_codec::Json],
                      ) -> Unit {
                        match ex_p {
                          effect::Exit::Interrupted => {
                            settle_delivery()
                            k(effect::Exit::Interrupted)
                          }
                          effect::Exit::Succeeded(_) => {
                            settle_delivery()
                            self.told_k(a, told_choices, k)
                          }
                          effect::Exit::Failed(e) => {
                            let reopen_and_prompt = fn() -> Unit {
                              self.log(a, "warn", "prompt failed, reopening the runtime", [
                                ("error", sessions_core::jstr(sessions_core::error_message(e))),
                              ])
                              let on_reopen_err = fn(e2 : effect::EffectError) -> Unit {
                                if !opt_str_is(open_abort_reason(e2), "stopped") {
                                  if drained_notices.length() > 0 {
                                    let next_n : Array[String] = []
                                    for i in 0..<drained_notices.length() {
                                      next_n.push(drained_notices[i])
                                    }
                                    for i in 0..<a.notices.length() {
                                      next_n.push(a.notices[i])
                                    }
                                    a.notices = next_n
                                  }
                                  if marked {
                                    self.store_direct_k(
                                      a,
                                      "markUndelivered",
                                      [
                                        sessions_core::jstr(a.key),
                                        base_codec::json_arr(delivered),
                                        sessions_core::jint(batch_id),
                                      ],
                                      fn(ex_u : effect::Exit[base_codec::Json]) -> Unit {
                                        match ex_u {
                                          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e3) => k(effect::Exit::Failed(e3))
                                          effect::Exit::Succeeded(_) => k(effect::Exit::Failed(e2))
                                        }
                                      },
                                    )
                                    return
                                  }
                                } else {
                                  settle_delivery()
                                }
                                k(effect::Exit::Failed(e2))
                              }
                              let on_reopen_interrupted = fn() -> Unit {
                                if !self.gen.counters.sealed {
                                  if drained_notices.length() > 0 {
                                    let next_n : Array[String] = []
                                    for i in 0..<drained_notices.length() {
                                      next_n.push(drained_notices[i])
                                    }
                                    for i in 0..<a.notices.length() {
                                      next_n.push(a.notices[i])
                                    }
                                    a.notices = next_n
                                  }
                                  if marked {
                                    sessions_core::try_k(
                                      fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                                        self.store_direct_k(
                                          a,
                                          "markUndelivered",
                                          [
                                            sessions_core::jstr(a.key),
                                            base_codec::json_arr(delivered),
                                            sessions_core::jint(batch_id),
                                          ],
                                          tk,
                                        )
                                      },
                                      fn(_ex_u : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                                        k(effect::Exit::Interrupted)
                                      },
                                    )
                                    return
                                  }
                                } else {
                                  settle_delivery()
                                }
                                k(effect::Exit::Interrupted)
                              }
                              self.set_agent(a, None)
                              self.agent_do_k(a, agent, "dispose", [], fn(
                                ex_d : effect::Exit[base_codec::Json],
                              ) -> Unit {
                                match ex_d {
                                  effect::Exit::Interrupted => on_reopen_interrupted()
                                  effect::Exit::Failed(e2) => on_reopen_err(e2)
                                  effect::Exit::Succeeded(_) => {
                                    self.ensure_agent_k(a, fn(ex_ea : effect::Exit[Agent]) -> Unit {
                                      match ex_ea {
                                        effect::Exit::Interrupted => on_reopen_interrupted()
                                        effect::Exit::Failed(e2) => on_reopen_err(e2)
                                        effect::Exit::Succeeded(ag2) => {
                                          self.agent_do_k(
                                            a,
                                            ag2,
                                            "prompt",
                                            [sessions_core::jstr(prompt)],
                                            fn(ex_p2 : effect::Exit[base_codec::Json]) -> Unit {
                                              match ex_p2 {
                                                // Do not call `markUndelivered` when the 2nd prompt is
                                                // interrupted: the runtime may already have accepted it,
                                                // so reverting could duplicate delivery.
                                                effect::Exit::Interrupted => {
                                                  settle_delivery()
                                                  k(effect::Exit::Interrupted)
                                                }
                                                effect::Exit::Failed(e2) => on_reopen_err(e2)
                                                effect::Exit::Succeeded(_) => {
                                                  settle_delivery()
                                                  self.told_k(a, told_choices, k)
                                                }
                                              }
                                            },
                                          )
                                        }
                                      }
                                    })
                                  }
                                }
                              })
                            }
                            if sessions_core::error_message(e) == "a turn is already running" {
                              let batch_start = a.steered_seq + 1
                              for i in 0..<delivered.length() {
                                a.steered_seq = a.steered_seq + 1
                                a.steered_unread.push(SteeredUnread::{ seq: a.steered_seq, handed: delivered[i] })
                              }
                              for i in 0..<drained_notices.length() {
                                a.steered_seq = a.steered_seq + 1
                                a.steered_notices.push(SteeredNotice::{ seq: a.steered_seq, text: drained_notices[i] })
                              }
                              let batch_end = a.steered_seq
                              let unsteer_fallback = fn() -> Unit {
                                if batch_end >= batch_start {
                                  let next_su : Array[SteeredUnread] = []
                                  for i in 0..<a.steered_unread.length() {
                                    let item = a.steered_unread[i]
                                    if item.seq < batch_start || item.seq > batch_end {
                                      next_su.push(item)
                                    }
                                  }
                                  a.steered_unread = next_su
                                  let next_sn : Array[SteeredNotice] = []
                                  for i in 0..<a.steered_notices.length() {
                                    let item = a.steered_notices[i]
                                    if item.seq < batch_start || item.seq > batch_end {
                                      next_sn.push(item)
                                    }
                                  }
                                  a.steered_notices = next_sn
                                }
                              }
                              sessions_core::try_k(
                                fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                                  self.agent_do_k(a, agent, "steer", [sessions_core::jstr(prompt)], tk)
                                },
                                fn(ex_st : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                                  match ex_st {
                                    effect::Exit::Interrupted => {
                                      unsteer_fallback()
                                      settle_delivery()
                                      k(effect::Exit::Interrupted)
                                    }
                                    effect::Exit::Failed(e2) => {
                                      unsteer_fallback()
                                      settle_delivery()
                                      k(effect::Exit::Failed(e2))
                                    }
                                    effect::Exit::Succeeded(Ok(sv)) => {
                                      if sessions_core::truthy(sv) {
                                        for i in 0..<delivered.length() {
                                          a.steered.push(delivered[i])
                                        }
                                        settle_delivery()
                                        self.told_k(a, told_choices, k)
                                      } else {
                                        unsteer_fallback()
                                        reopen_and_prompt()
                                      }
                                    }
                                    effect::Exit::Succeeded(Err(_)) => {
                                      unsteer_fallback()
                                      reopen_and_prompt()
                                    }
                                  }
                                },
                              )
                            } else {
                              reopen_and_prompt()
                            }
                          }
                        }
                      })
                    }
                  }
                }
                if marked {
                  self.store_k(
                    a,
                    "markDelivered",
                    [
                      sessions_core::jstr(a.key),
                      base_codec::json_arr(delivered),
                      sessions_core::jint(batch_id),
                    ],
                    fn(ex_m : effect::Exit[base_codec::Json]) -> Unit {
                      match ex_m {
                        effect::Exit::Succeeded(_) => after_mark(effect::Exit::Succeeded(()))
                        effect::Exit::Failed(e) => after_mark(effect::Exit::Failed(e))
                        effect::Exit::Interrupted => after_mark(effect::Exit::Interrupted)
                      }
                    },
                  )
                } else {
                  after_mark(effect::Exit::Succeeded(()))
                }
              }
            }
          }
          if !is_json_null(retry_about) {
            match a.turn {
              Some(t) => {
                self.store_k(
                  a,
                  "setAbout",
                  [
                    sessions_core::jstr(t.id),
                    base_codec::json_arr([
                      sessions_core::field_of(retry_about, "thread"),
                      sessions_core::field_of(retry_about, "seq"),
                      sessions_core::field_of(retry_about, "ts"),
                    ]),
                  ],
                  fn(ex_sa : effect::Exit[base_codec::Json]) -> Unit {
                    match ex_sa {
                      effect::Exit::Succeeded(_) => after_about(effect::Exit::Succeeded(()))
                      effect::Exit::Failed(e) => after_about(effect::Exit::Failed(e))
                      effect::Exit::Interrupted => after_about(effect::Exit::Interrupted)
                    }
                  },
                )
              }
              None => after_about(effect::Exit::Succeeded(()))
            }
          } else {
            after_about(effect::Exit::Succeeded(()))
          }
        }
      }
    })
  }
  self.busy_of_k(a, Some(agent), fn(ex_b : effect::Exit[Bool]) -> Unit {
    match ex_b {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(false) => proceed_prompt()
      effect::Exit::Succeeded(true) => {
        let take = if notices_taken > a.notices.length() { a.notices.length() } else { notices_taken }
        let batch_start = a.steered_seq + 1
        for i in 0..<delivered.length() {
          a.steered_seq = a.steered_seq + 1
          a.steered_unread.push(SteeredUnread::{ seq: a.steered_seq, handed: delivered[i] })
        }
        for i in 0..<take {
          a.steered_seq = a.steered_seq + 1
          a.steered_notices.push(SteeredNotice::{ seq: a.steered_seq, text: a.notices[i] })
        }
        let batch_end = a.steered_seq
        let unsteer_start = fn() -> Unit {
          if batch_end >= batch_start {
            let next_su : Array[SteeredUnread] = []
            for i in 0..<a.steered_unread.length() {
              let item = a.steered_unread[i]
              if item.seq < batch_start || item.seq > batch_end {
                next_su.push(item)
              }
            }
            a.steered_unread = next_su
            let next_sn : Array[SteeredNotice] = []
            for i in 0..<a.steered_notices.length() {
              let item = a.steered_notices[i]
              if item.seq < batch_start || item.seq > batch_end {
                next_sn.push(item)
              }
            }
            a.steered_notices = next_sn
          }
        }
        self.agent_do_k(a, agent, "steer", [sessions_core::jstr(prompt)], fn(
          ex_st : effect::Exit[base_codec::Json],
        ) -> Unit {
          match ex_st {
            effect::Exit::Interrupted => {
              unsteer_start()
              k(effect::Exit::Interrupted)
            }
            effect::Exit::Failed(e) => {
              unsteer_start()
              k(effect::Exit::Failed(e))
            }
            effect::Exit::Succeeded(sv) => {
              if sessions_core::truthy(sv) {
                let after_md = fn(ex_md : effect::Exit[Unit]) -> Unit {
                  match ex_md {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => {
                      for i in 0..<delivered.length() {
                        a.steered.push(delivered[i])
                      }
                      let _ = drain_notices(a, notices_taken)
                      self.told_k(a, told_choices, k)
                    }
                  }
                }
                if delivered.length() > 0 {
                  self.store_k(
                    a,
                    "markDelivered",
                    [sessions_core::jstr(a.key), base_codec::json_arr(delivered)],
                    fn(ex_m : effect::Exit[base_codec::Json]) -> Unit {
                      match ex_m {
                        effect::Exit::Succeeded(_) => after_md(effect::Exit::Succeeded(()))
                        effect::Exit::Failed(e) => after_md(effect::Exit::Failed(e))
                        effect::Exit::Interrupted => after_md(effect::Exit::Interrupted)
                      }
                    },
                  )
                } else {
                  after_md(effect::Exit::Succeeded(()))
                }
              } else {
                unsteer_start()
                proceed_prompt()
              }
            }
          }
        })
      }
    }
  })
}

pub fn ActorsGen::begin_turn_k(
  self : ActorsGen,
  a : Actor,
  kind : String,
  by : base_codec::Json,
  passive : Bool,
  fresh : Bool,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  a.queued_retry = None
  self.cancel_tools_retry(a)
  self.cancel_mid_wait(a)
  if kind == "input" {
    self.clear_silent_wait(a)
  }
  if fresh || kind == "input" || kind == "job" {
    a.last_said = ""
    a.posted = false
  }
  self.rpc_k(a.key, "node.uuid", [], fn(ex_u : effect::Exit[base_codec::Json]) -> Unit {
    match ex_u {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(uv) => {
        let id = str_or(sessions_core::str_of(Some(uv)), "")
        let after_asked = fn(asked_before : Option[base_codec::Json]) -> Unit {
          let is_passive = passive || kind == "title" || kind == "nudge"
          a.turn = Some(Turn::{
            id: id,
            declared: None,
            auth_retried: kind == "auth_retry",
            codex_retried: kind == "codex_retry",
            passive: is_passive,
            by: by,
            asked_before: asked_before,
            started_at: self.gen.counters.now,
            first_live_at: None,
            tools_count: 0,
            last_tool_at: self.gen.counters.now,
            wait_watch: false,
            last_live_at: self.gen.counters.now,
            open_tools: [],
          })
          a.deferred_end = None
          a.warm = false
          a.phase = "running"
          a.waiting = None
          self.mirror(a)
          let for_j = match by {
            base_codec::Json::Obj(fields) => {
              let out : Array[(String, base_codec::Json)] = []
              let mut replaced = false
              for i in 0..<fields.length() {
                let (fk, fv) = fields[i]
                if fk == "profile" {
                  out.push(("profile", a.profile))
                  replaced = true
                } else {
                  out.push((fk, fv))
                }
              }
              if !replaced {
                out.push(("profile", a.profile))
              }
              base_codec::json_obj(out)
            }
            _ => by
          }
          self.store_k(
            a,
            "startTurnFor",
            [sessions_core::jstr(id), sessions_core::jstr(a.key), sessions_core::jstr(kind), for_j],
            fn(ex_st : effect::Exit[base_codec::Json]) -> Unit {
              match ex_st {
                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                effect::Exit::Succeeded(_) => self.set_running_k(a, true, k)
              }
            },
          )
        }
        if kind == "job" {
          self.asked_now_k(a, fn(ex_an : effect::Exit[Option[base_codec::Json]]) -> Unit {
            match ex_an {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
              effect::Exit::Succeeded(ab) => after_asked(ab)
            }
          })
        } else {
          after_asked(None)
        }
      }
    }
  })
}

// ── Wake queued / wake cap queued / timer firings (`actor_run.mbt:795-880`, `3464-3786`) ──

pub fn ActorsGen::wake_queued_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if a.recovery_deferred && a.recoveries == 0 {
    a.recovery_deferred = false
    self.recover_k(a, true, fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => k(effect::Exit::Succeeded(()))
        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      }
    })
    return
  }
  let before = a.start_failures
  self.enqueue_k(
    a,
    fn(tk : (effect::Exit[Unit]) -> Unit) -> Unit {
      let owned = a.starting_turn
      let finish = fn(ex : effect::Exit[Unit]) -> Unit {
        if owned {
          a.starting_turn = false
          if !self.gen.counters.sealed && !is_some(a.turn) {
            self.drain_turn_queue(!a.paused_cap)
          }
        }
        tk(ex)
      }
      let step_pump = fn() -> Unit {
        self.pump_k(a, before, fn(ex_p : effect::Exit[Unit]) -> Unit {
          match ex_p {
            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
            effect::Exit::Succeeded(_) => {
              if !is_some(a.turn) && a.notices.length() > 0 {
                self.give_notices_k(a, finish)
              } else {
                finish(effect::Exit::Succeeded(()))
              }
            }
          }
        })
      }
      let step_retry = fn() -> Unit {
        match a.queued_retry {
          Some(r) => {
            self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
              match ex_ar {
                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                effect::Exit::Succeeded(true) => {
                  a.queued_retry = None
                  step_pump()
                }
                effect::Exit::Succeeded(false) => {
                  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
                    match ex_h {
                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(true) => step_pump()
                      effect::Exit::Succeeded(false) => {
                        a.queued_retry = None
                        self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                          match ex_hp {
                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(true) => step_pump()
                            effect::Exit::Succeeded(false) => {
                              self.start_turn_k(
                                a,
                                r.kind,
                                r.text,
                                r.by,
                                None,
                                r.passive,
                                0,
                                r.fresh,
                                fn(ex_st : effect::Exit[Unit]) -> Unit {
                                  match ex_st {
                                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                    effect::Exit::Succeeded(_) => {
                                      match a.turn {
                                        Some(nt) => {
                                          if r.codex_retried {
                                            nt.codex_retried = true
                                          }
                                          finish(effect::Exit::Succeeded(()))
                                        }
                                        None => step_pump()
                                      }
                                    }
                                  }
                                },
                              )
                            }
                          }
                        })
                      }
                    }
                  })
                }
              }
            })
          }
          None => step_pump()
        }
      }
      let step_refill = fn() -> Unit {
        match a.refill {
          Some(refill) => {
            if a.refill_at <= self.gen.counters.now {
              self.fire_refill_k(a, refill, fn(ex_rf : effect::Exit[Unit]) -> Unit {
                match ex_rf {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(_) => {
                    if is_some(a.turn) {
                      finish(effect::Exit::Succeeded(()))
                    } else {
                      step_retry()
                    }
                  }
                }
              })
              return
            }
          }
          None => ()
        }
        step_retry()
      }
      match a.waiting {
        Some(wait) => {
          if a.waiting_until <= self.gen.counters.now {
            self.fire_wait_k(a, wait, a.waiting_seconds, fn(ex_fw : effect::Exit[Unit]) -> Unit {
              match ex_fw {
                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                effect::Exit::Succeeded(_) => {
                  if is_some(a.turn) {
                    finish(effect::Exit::Succeeded(()))
                  } else {
                    step_refill()
                  }
                }
              }
            })
            return
          }
        }
        None => ()
      }
      step_refill()
    },
    k,
  )
}

pub fn ActorsGen::wake_cap_queued_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  self.enqueue_k(
    a,
    fn(tk : (effect::Exit[Unit]) -> Unit) -> Unit {
      if a.phase == "closed" || is_some(a.turn) {
        tk(effect::Exit::Succeeded(()))
        return
      }
      self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
        match ex_ar {
          effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
          effect::Exit::Succeeded(true) => tk(effect::Exit::Succeeded(()))
          effect::Exit::Succeeded(false) => {
            self.busy_k(a, fn(ex_b : effect::Exit[Bool]) -> Unit {
              match ex_b {
                effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
                effect::Exit::Succeeded(true) => tk(effect::Exit::Succeeded(()))
                effect::Exit::Succeeded(false) => {
                  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
                    match ex_h {
                      effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(true) => {
                        a.paused_cap = true
                        tk(effect::Exit::Succeeded(()))
                      }
                      effect::Exit::Succeeded(false) => {
                        self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                          match ex_hp {
                            effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => tk(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(has_p) => {
                              // (as `wake_queued_k`: what came since it was queued is had first, its own turn given up
                              // for it)
                              match a.queued_retry {
                                Some(r) => {
                                  a.queued_retry = None
                                  if !has_p {
                                    self.start_turn_k(
                                      a,
                                      r.kind,
                                      r.text,
                                      r.by,
                                      None,
                                      r.passive,
                                      0,
                                      r.fresh,
                                      fn(ex_st : effect::Exit[Unit]) -> Unit {
                                        match ex_st {
                                          effect::Exit::Interrupted => tk(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e) => {
                                            if is_some(session_cap_info(e)) {
                                              a.queued_retry = Some(r)
                                            }
                                            tk(effect::Exit::Failed(e))
                                          }
                                          effect::Exit::Succeeded(_) => {
                                            match a.turn {
                                              Some(nt) => {
                                                if r.codex_retried {
                                                  nt.codex_retried = true
                                                }
                                              }
                                              None => ()
                                            }
                                            tk(effect::Exit::Succeeded(()))
                                          }
                                        }
                                      },
                                    )
                                    return
                                  }
                                }
                                None => ()
                              }
                              // (notices it was refused a turn on, and those come while it waited: never woken otherwise)
                              let after_pump = fn(ex_p : effect::Exit[Unit]) -> Unit {
                                match ex_p {
                                  effect::Exit::Succeeded(_) => {
                                    if !is_some(a.turn) && !a.paused_cap && a.notices.length() > 0 {
                                      self.give_notices_k(a, tk)
                                    } else {
                                      tk(effect::Exit::Succeeded(()))
                                    }
                                  }
                                  _ => tk(ex_p)
                                }
                              }
                              if has_p {
                                self.pump_k(a, -1, after_pump)
                              } else {
                                after_pump(effect::Exit::Succeeded(()))
                              }
                            }
                          }
                        })
                      }
                    }
                  })
                }
              }
            })
          }
        }
      })
    },
    k,
  )
}

pub fn ActorsGen::fire_wait_k(
  self : ActorsGen,
  a : Actor,
  wait : Int,
  seconds : Double,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
    match ex_h {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(is_held) => {
        let same_wait = match a.waiting {
          Some(w) => w == wait
          None => false
        }
        if is_held || !same_wait {
          k(effect::Exit::Succeeded(()))
          return
        }
        self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
          match ex_ar {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(true) => self.let_go_k(a, k)
            effect::Exit::Succeeded(false) => {
              if a.compacting {
                a.over_while_compacting = true
                k(effect::Exit::Succeeded(()))
                return
              }
              if self.turn_slots_full(a) {
                a.waiting_until = self.gen.counters.now
                self.enqueue_turn_wait(a)
                k(effect::Exit::Succeeded(()))
                return
              }
              let reserved = !a.starting_turn
              if reserved {
                a.starting_turn = true
              }
              let finish = fn(ex : effect::Exit[Unit]) -> Unit {
                if reserved {
                  a.starting_turn = false
                  if !self.gen.counters.sealed && !is_some(a.turn) {
                    self.drain_turn_queue(!a.paused_cap)
                  }
                }
                k(ex)
              }
              a.waiting = None
              a.phase = "idle"
              self.last_turn_k(a, fn(ex_lt : effect::Exit[base_codec::Json]) -> Unit {
                match ex_lt {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(last) => {
                    if !is_json_null(last) && retrying(last) {
                      self.log(a, "info", "trying again a turn the provider had no room for", [
                        ("seconds", sessions_core::jnum(seconds)),
                      ])
                      self.words_k(a, "GO_ON_AFTER_OVERLOADED", [], fn(ex_w : effect::Exit[String]) -> Unit {
                        match ex_w {
                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(words) => {
                            self.start_turn_k(
                              a,
                              "resume",
                              words,
                              turn_for_nobody(),
                              None,
                              true,
                              0,
                              false,
                              finish,
                            )
                          }
                        }
                      })
                      return
                    }
                    let ask_again = fn() -> Unit {
                      self.log(a, "info", "the wait is over without word; asking again", [
                        ("seconds", sessions_core::jnum(seconds)),
                      ])
                      self.words_k(a, "waitOver", [sessions_core::jnum(seconds)], fn(
                        ex_w : effect::Exit[String],
                      ) -> Unit {
                        match ex_w {
                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(base) => {
                            self.maybe_progress_reminder_k(a, fn(
                              ex_rem : effect::Exit[(Option[String], Bool)],
                            ) -> Unit {
                              match ex_rem {
                                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                effect::Exit::Succeeded((reminder, reminded)) => {
                                  let body = match reminder {
                                    Some(r) => base + "\n\n" + r
                                    None => base
                                  }
                                  self.start_turn_k(
                                    a,
                                    "nudge",
                                    body,
                                    turn_for_nobody(),
                                    None,
                                    false,
                                    0,
                                    true,
                                    fn(ex_st : effect::Exit[Unit]) -> Unit {
                                      match ex_st {
                                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                        effect::Exit::Succeeded(_) => {
                                          if reminded {
                                            a.progress_reminded_at = self.gen.counters.now
                                          }
                                          finish(effect::Exit::Succeeded(()))
                                        }
                                      }
                                    },
                                  )
                                }
                              }
                            })
                          }
                        }
                      })
                    }
                    if !is_opt_json_false(sessions_core::jget(last, "waitWatch")) {
                      self.store_k(a, "hasSessionActiveWatch", [sessions_core::jstr(a.key)], fn(
                        ex_aw : effect::Exit[base_codec::Json],
                      ) -> Unit {
                        match ex_aw {
                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(v) => {
                            if sessions_core::truthy(v) {
                              self.wait_ms(a, seconds, seconds * 1000.0)
                              finish(effect::Exit::Succeeded(()))
                            } else {
                              ask_again()
                            }
                          }
                        }
                      })
                    } else {
                      ask_again()
                    }
                  }
                }
              })
            }
          }
        })
      }
    }
  })
}

pub fn ActorsGen::fire_mid_wait_k(
  self : ActorsGen,
  a : Actor,
  wait : Int,
  turn_id : String,
  seconds : Double,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let same = match a.mid_waiting {
    Some(w) => w == wait
    None => false
  }
  if !same {
    k(effect::Exit::Succeeded(()))
    return
  }
  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
    match ex_h {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(()))
      effect::Exit::Succeeded(false) => {
        a.mid_waiting = None
        a.mid_waiting_until = 0.0
        a.mid_waiting_seconds = 0.0
        if a.compacting {
          k(effect::Exit::Succeeded(()))
          return
        }
        self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
          match ex_ar {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(()))
            effect::Exit::Succeeded(false) => {
              let t = match a.turn {
                Some(v) => {
                  if v.id == turn_id && opt_str_is(kind_of(v.declared), "waiting") {
                    v
                  } else {
                    k(effect::Exit::Succeeded(()))
                    return
                  }
                }
                None => {
                  k(effect::Exit::Succeeded(()))
                  return
                }
              }
              self.last_turn_k(a, fn(ex_lt : effect::Exit[base_codec::Json]) -> Unit {
                match ex_lt {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(last) => {
                    let after_watch_check = fn() -> Unit {
                      let wait_ms = seconds * 1000.0
                      let idle_ms = self.gen.counters.now - t.last_tool_at
                      if idle_ms < wait_ms {
                        self.arm_mid_wait(a, turn_id, seconds, wait_ms - idle_ms)
                        k(effect::Exit::Succeeded(()))
                        return
                      }
                      let was = a.agent
                      self.busy_of_k(a, was, fn(ex_b : effect::Exit[Bool]) -> Unit {
                        match ex_b {
                          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(busy) => {
                            if !still(a, was) {
                              k(effect::Exit::Succeeded(()))
                              return
                            }
                            let still_waiting = match a.turn {
                              Some(t2) => t2.id == turn_id && opt_str_is(kind_of(t2.declared), "waiting")
                              None => false
                            }
                            if !still_waiting || !busy {
                              k(effect::Exit::Succeeded(()))
                              return
                            }
                            let agent = match was {
                              Some(g) => g
                              None => {
                                k(effect::Exit::Succeeded(()))
                                return
                              }
                            }
                            self.log(
                              a,
                              "info",
                              "a turn declared waiting did not end before its wait ran out; steering it to check",
                              [("seconds", sessions_core::jnum(seconds))],
                            )
                            self.words_k(a, "waitOver", [sessions_core::jnum(seconds)], fn(
                              ex_w : effect::Exit[String],
                            ) -> Unit {
                              match ex_w {
                                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                effect::Exit::Succeeded(base) => {
                                  self.maybe_progress_reminder_k(a, fn(
                                    ex_rem : effect::Exit[(Option[String], Bool)],
                                  ) -> Unit {
                                    match ex_rem {
                                      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                      effect::Exit::Succeeded((reminder, reminded)) => {
                                        let body = match reminder {
                                          Some(r) => base + "\n\n" + r
                                          None => base
                                        }
                                        self.with_choices_k(a, body, fn(
                                          ex_wc : effect::Exit[(String, base_codec::Json)],
                                        ) -> Unit {
                                          match ex_wc {
                                            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                            effect::Exit::Succeeded((handed, told)) => {
                                              self.timed_k(a, handed, fn(ex_tm : effect::Exit[String]) -> Unit {
                                                match ex_tm {
                                                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                                  effect::Exit::Succeeded(timed_str) => {
                                                    self.agent_do_k(
                                                      a,
                                                      agent,
                                                      "steer",
                                                      [sessions_core::jstr(timed_str)],
                                                      fn(ex_st : effect::Exit[base_codec::Json]) -> Unit {
                                                        match ex_st {
                                                          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                                          effect::Exit::Succeeded(sv) => {
                                                            if sessions_core::truthy(sv) {
                                                              self.told_k(a, told, fn(ex_td : effect::Exit[Unit]) -> Unit {
                                                                match ex_td {
                                                                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                                                                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                                                                  effect::Exit::Succeeded(_) => {
                                                                    if reminded {
                                                                      a.progress_reminded_at = self.gen.counters.now
                                                                    }
                                                                    match a.turn {
                                                                      Some(t3) => {
                                                                        if t3.id == turn_id &&
                                                                        opt_str_is(kind_of(t3.declared), "waiting") {
                                                                          t3.declared = None
                                                                          // (only tool calls begun after the steer hold its deadline, and only messages steered in after it are
                                                                          // handed again if it is ended: 1:1 `actor_run.mbt` `fire_mid_wait`)
                                                                          t3.open_tools = []
                                                                          a.steer_silent_steered = a.steered.length()
                                                                          self.arm_steer_silent(a, turn_id, self.gen.counters.now, STEERED_SILENT_MS)
                                                                          self.declare_turn_k(a, t3.id, None, k)
                                                                          return
                                                                        }
                                                                      }
                                                                      None => ()
                                                                    }
                                                                    k(effect::Exit::Succeeded(()))
                                                                  }
                                                                }
                                                              })
                                                            } else {
                                                              self.log(
                                                                a,
                                                                "warn",
                                                                "could not steer a running turn whose waiting timer ran out",
                                                                [
                                                                  ("seconds", sessions_core::jnum(seconds)),
                                                                  ("runtime", sessions_core::jstr(a.runtime)),
                                                                ],
                                                              )
                                                              k(effect::Exit::Succeeded(()))
                                                            }
                                                          }
                                                        }
                                                      },
                                                    )
                                                  }
                                                }
                                              })
                                            }
                                          }
                                        })
                                      }
                                    }
                                  })
                                }
                              }
                            })
                          }
                        }
                      })
                    }
                    if !is_opt_json_false(sessions_core::jget(last, "waitWatch")) {
                      self.store_k(a, "hasSessionActiveWatch", [sessions_core::jstr(a.key)], fn(
                        ex_aw : effect::Exit[base_codec::Json],
                      ) -> Unit {
                        match ex_aw {
                          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(v) => {
                            if sessions_core::truthy(v) {
                              self.arm_mid_wait(a, turn_id, seconds, seconds * 1000.0)
                              k(effect::Exit::Succeeded(()))
                            } else {
                              after_watch_check()
                            }
                          }
                        }
                      })
                    } else {
                      after_watch_check()
                    }
                  }
                }
              })
            }
          }
        })
      }
    }
  })
}

pub fn ActorsGen::fire_refill_k(
  self : ActorsGen,
  a : Actor,
  refill : Int,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let same = match a.refill {
    Some(r) => r == refill
    None => false
  }
  if !same {
    k(effect::Exit::Succeeded(()))
    return
  }
  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
    match ex_h {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(()))
      effect::Exit::Succeeded(false) => {
        self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
          match ex_ar {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(is_arch) => {
              let check_busy = fn(is_busy : Bool) -> Unit {
                if is_arch || is_some(a.turn) || is_busy {
                  a.refill = None
                  k(effect::Exit::Succeeded(()))
                  return
                }
                if self.turn_slots_full(a) {
                  a.refill_at = self.gen.counters.now
                  self.enqueue_turn_wait(a)
                  k(effect::Exit::Succeeded(()))
                  return
                }
                let reserved = !a.starting_turn
                if reserved {
                  a.starting_turn = true
                }
                let finish = fn(ex : effect::Exit[Unit]) -> Unit {
                  if reserved {
                    a.starting_turn = false
                    if !self.gen.counters.sealed && !is_some(a.turn) {
                      self.drain_turn_queue(!a.paused_cap)
                    }
                  }
                  k(ex)
                }
                a.refill = None
                self.log(a, "info", "its allowance should have refilled; going on")
                self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                  match ex_hp {
                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(true) => self.pump_k(a, -1, finish)
                    effect::Exit::Succeeded(false) => {
                      self.words_k(a, "GO_ON_AFTER_REFILL", [], fn(ex_w : effect::Exit[String]) -> Unit {
                        match ex_w {
                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(words) => {
                            self.start_turn_k(
                              a,
                              "resume",
                              words,
                              turn_for_nobody(),
                              None,
                              true,
                              0,
                              false,
                              finish,
                            )
                          }
                        }
                      })
                    }
                  }
                })
              }
              if is_arch || is_some(a.turn) {
                check_busy(false)
              } else {
                self.busy_k(a, fn(ex_b : effect::Exit[Bool]) -> Unit {
                  match ex_b {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(b) => check_busy(b)
                  }
                })
              }
            }
          }
        })
      }
    }
  })
}

pub fn ActorsGen::fire_tools_retry_k(
  self : ActorsGen,
  a : Actor,
  id : Int,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let same = match a.tools_retry {
    Some(r) => r == id
    None => false
  }
  if !same {
    k(effect::Exit::Succeeded(()))
    return
  }
  a.tools_retry = None
  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
    match ex_h {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(true) => {
        a.tools_retry_deferred = true
        self.mirror(a)
        k(effect::Exit::Succeeded(()))
      }
      effect::Exit::Succeeded(false) => {
        self.mirror(a)
        self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
          match ex_ar {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(true) => self.let_go_k(a, k)
            effect::Exit::Succeeded(false) => {
              if is_some(a.turn) {
                k(effect::Exit::Succeeded(()))
                return
              }
              self.busy_k(a, fn(ex_b : effect::Exit[Bool]) -> Unit {
                match ex_b {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(true) => k(effect::Exit::Succeeded(()))
                  effect::Exit::Succeeded(false) => {
                    if self.turn_slots_full(a) {
                      self.words_k(a, "TOOLS_LOST", [], fn(ex_w : effect::Exit[String]) -> Unit {
                        match ex_w {
                          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(words) => {
                            a.queued_retry = Some(QueuedRetry::{
                              kind: "resume",
                              text: words,
                              by: turn_for_nobody(),
                              codex_retried: false,
                              passive: false,
                              fresh: false,
                            })
                            self.enqueue_turn_wait(a)
                            k(effect::Exit::Succeeded(()))
                          }
                        }
                      })
                      return
                    }
                    let reserved = !a.starting_turn
                    if reserved {
                      a.starting_turn = true
                    }
                    let finish = fn(ex : effect::Exit[Unit]) -> Unit {
                      if reserved {
                        a.starting_turn = false
                        if !self.gen.counters.sealed && !is_some(a.turn) {
                          self.drain_turn_queue(!a.paused_cap)
                        }
                      }
                      k(ex)
                    }
                    self.words_k(a, "TOOLS_LOST", [], fn(ex_w : effect::Exit[String]) -> Unit {
                      match ex_w {
                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                        effect::Exit::Succeeded(words) => {
                          self.start_turn_k(
                            a,
                            "resume",
                            words,
                            turn_for_nobody(),
                            None,
                            false,
                            0,
                            false,
                            finish,
                          )
                        }
                      }
                    })
                  }
                }
              })
            }
          }
        })
      }
    }
  })
}

// ── Undeclared end, cool, give_up, and on_turn_ended (`actor_run.mbt:2712-3389`) ──

pub fn ActorsGen::cool_k(
  self : ActorsGen,
  a : Actor,
  warm : Bool,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if a.warm {
    a.warm = false
    self.mirror(a)
  }
  if warm && !is_some(a.turn) && !a.compacting && !is_some(a.codex_update) {
    self.set_running_k(a, false, k)
  } else {
    k(effect::Exit::Succeeded(()))
  }
}

pub fn ActorsGen::tell_opener_failed_k(
  self : ActorsGen,
  a : Actor,
  said : String,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let warn_prefix = "⚠️ "
  let words = if said.starts_with(warn_prefix) {
    said.slice(warn_prefix.length(), said.length())
  } else {
    said
  }
  sessions_core::try_k(
    fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
      self.deps_k(
        a,
        "settled",
        [sessions_core::jstr(a.key), sessions_core::jstr("failed"), sessions_core::jstr(words)],
        tk,
      )
    },
    fn(ex : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
      match ex {
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
        effect::Exit::Failed(err) => {
          self.log(a, "warn", "the opener of its chat was not told", [
            ("error", sessions_core::jstr(sessions_core::error_message(err))),
          ])
          k(effect::Exit::Succeeded(()))
        }
        effect::Exit::Succeeded(Ok(_)) => k(effect::Exit::Succeeded(()))
        effect::Exit::Succeeded(Err(err)) => {
          self.log(a, "warn", "the opener of its chat was not told", [
            ("error", sessions_core::jstr(sessions_core::error_message(err))),
          ])
          k(effect::Exit::Succeeded(()))
        }
      }
    },
  )
}

pub fn ActorsGen::give_up_k(
  self : ActorsGen,
  a : Actor,
  turn : Option[String],
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let said = if a.posted { "" } else { a.last_said }
  a.last_said = ""
  if said == "" {
    self.t_k(a, "station.notice.noResult", base_codec::json_null(), fn(
      ex_t : effect::Exit[String],
    ) -> Unit {
      match ex_t {
        effect::Exit::Interrupted => k(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
        effect::Exit::Succeeded(msg) => {
          let words = "⚠️ " + msg
          self.notice_k(
            a,
            words,
            base_codec::json_null(),
            base_codec::json_null(),
            base_codec::json_null(),
            turn,
            false,
            fn(ex_n : effect::Exit[Unit]) -> Unit {
              match ex_n {
                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                effect::Exit::Succeeded(_) => self.tell_opener_failed_k(a, words, k)
              }
            },
          )
        }
      }
    })
    return
  }
  self.log(a, "info", "the turn reached nobody; its last words are shown in its place")
  self.rpc_k(a.key, "node.words", [sessions_core::jstr("quoted"), sessions_core::jstr(said)], fn(
    ex_q : effect::Exit[base_codec::Json],
  ) -> Unit {
    match ex_q {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(qv) => {
        let quoted = str_or(sessions_core::str_of(Some(qv)), "")
        self.t_k(a, "station.notice.noResultSaid", base_codec::json_null(), fn(
          ex_t : effect::Exit[String],
        ) -> Unit {
          match ex_t {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(msg) => {
              let words = "⚠️ " + msg + "\n\n" + quoted
              self.notice_k(
                a,
                words,
                base_codec::json_null(),
                base_codec::json_null(),
                base_codec::json_null(),
                turn,
                false,
                fn(ex_n : effect::Exit[Unit]) -> Unit {
                  match ex_n {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => self.tell_opener_failed_k(a, words, k)
                  }
                },
              )
            }
          }
        })
      }
    }
  })
}

pub fn ActorsGen::continue_undeclared_end_k(
  self : ActorsGen,
  a : Actor,
  lost : Bool,
  unheard : Bool,
  recorded : Option[String],
  warm : Bool,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if lost {
    a.nudges = 0
    if a.tools_restarts < 1 {
      a.tools_restarts = a.tools_restarts + 1
      self.log(a, "info", "the turn reached nobody; going on in a new process", [
        ("attempt", sessions_core::jint(a.tools_restarts)),
      ])
      self.words_k(a, "TOOLS_LOST", [], fn(ex_w : effect::Exit[String]) -> Unit {
        match ex_w {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(words) => {
            self.start_turn_k(
              a,
              "resume",
              words,
              turn_for_nobody(),
              None,
              false,
              0,
              false,
              fn(ex_st : effect::Exit[Unit]) -> Unit {
                match ex_st {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(_) => self.cool_k(a, warm, k)
                }
              },
            )
          }
        }
      })
      return
    }
    if unheard && a.tools_restarts < 2 {
      a.tools_restarts = a.tools_restarts + 1
      self.log(
        a,
        "info",
        "the turn still reached no tools; retrying in a new process after backoff",
        [
          ("attempt", sessions_core::jint(a.tools_restarts)),
          ("delayMs", sessions_core::jnum(TOOLS_RETRY_DELAY_MS)),
        ],
      )
      self.schedule_tools_retry(a, TOOLS_RETRY_DELAY_MS)
      self.cool_k(a, warm, k)
      return
    }
    a.tools_restarts = 0
    let give_up_lost = fn() -> Unit {
      self.cool_k(a, warm, fn(ex_c : effect::Exit[Unit]) -> Unit {
        match ex_c {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(_) => {
            let finish_gu = fn(ex_cu : effect::Exit[Unit]) -> Unit {
              match ex_cu {
                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                effect::Exit::Succeeded(_) => self.give_up_k(a, recorded, k)
              }
            }
            if a.stale {
              self.catch_up_k(a, !is_some(a.waiting), finish_gu)
            } else {
              finish_gu(effect::Exit::Succeeded(()))
            }
          }
        }
      })
    }
    // (`actor_run.mbt` `continue_undeclared_end`: three processes in a row that never reached the station's tools, the
    // last after the backoff, go on on another profile or runtime's when one left to the station can, FB-66)
    if !unheard {
      give_up_lost()
      return
    }
    sessions_core::try_k(
      fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
        self.deps_k(a, "toolsUnreachable", [sessions_core::jstr(a.key), a.profile, sessions_core::jstr(a.runtime)], tk)
      },
      fn(ex_tu : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
        match ex_tu {
          effect::Exit::Interrupted => k(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
          effect::Exit::Succeeded(res) => {
            let moved = match res {
              Ok(v) => v
              Err(e) => {
                self.log(a, "warn", "could not move off a profile out of reach of the station's tools", [
                  ("error", sessions_core::jstr(sessions_core::error_message(e))),
                ])
                base_codec::json_null()
              }
            }
            match moved {
              base_codec::Json::Arr(m) => {
                if m.length() != 2 {
                  give_up_lost()
                  return
                }
                self.log(a, "info", "the station's tools stayed out of reach; going on on another profile", [
                  ("from", m[0]),
                  ("to", m[1]),
                ])
                self.words_k(a, "TOOLS_LOST", [], fn(ex_w : effect::Exit[String]) -> Unit {
                  match ex_w {
                    effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(words) => {
                      self.start_turn_k(
                        a,
                        "resume",
                        words,
                        turn_for_nobody(),
                        None,
                        false,
                        0,
                        false,
                        fn(ex_st : effect::Exit[Unit]) -> Unit {
                          match ex_st {
                            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(_) => self.cool_k(a, warm, k)
                          }
                        },
                      )
                    }
                  }
                })
              }
              _ => give_up_lost()
            }
          }
        }
      },
    )
    return
  }
  self.deps_k(a, "maxNudges", [], fn(ex_mn : effect::Exit[base_codec::Json]) -> Unit {
    match ex_mn {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(mv) => {
        let most = num_or(sessions_core::num_of(Some(mv)), 0.0).to_int()
        if a.nudges < most {
          a.nudges = a.nudges + 1
          self.log(a, "info", "turn ended without a state; nudging", [
            ("attempt", sessions_core::jint(a.nudges)),
          ])
          self.words_k(a, "NUDGE", [], fn(ex_w : effect::Exit[String]) -> Unit {
            match ex_w {
              effect::Exit::Interrupted => k(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
              effect::Exit::Succeeded(words) => {
                self.start_turn_k(
                  a,
                  "nudge",
                  words,
                  turn_for_nobody(),
                  None,
                  false,
                  0,
                  false,
                  fn(ex_st : effect::Exit[Unit]) -> Unit {
                    match ex_st {
                      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(_) => self.cool_k(a, warm, k)
                    }
                  },
                )
              }
            }
          })
          return
        }
        a.nudges = 0
        self.cool_k(a, warm, fn(ex_c : effect::Exit[Unit]) -> Unit {
          match ex_c {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(_) => {
              let finish_gu = fn(ex_cu : effect::Exit[Unit]) -> Unit {
                match ex_cu {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(_) => self.give_up_k(a, recorded, k)
                }
              }
              if a.stale {
                self.catch_up_k(a, !is_some(a.waiting), finish_gu)
              } else {
                finish_gu(effect::Exit::Succeeded(()))
              }
            }
          }
        })
      }
    }
  })
}

/// Complete turn end state machine (`actor_run.mbt:2712-3251`).
pub fn ActorsGen::on_turn_ended_k(
  self : ActorsGen,
  a : Actor,
  generation : Int,
  outcome : base_codec::Json,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if !self.is_current(a, generation) {
    k(effect::Exit::Succeeded(()))
    return
  }
  if a.compacting && !is_some(a.turn) {
    self.compacted_k(a, outcome, k)
    return
  }
  let init_kind = sessions_core::text_of(outcome, "kind")
  let init_reason = sessions_core::text_of(outcome, "reason")
  let message = sessions_core::text_of(outcome, "message")
  let check_limit = fn(kind : String, reason : String, lent_expired : Bool, ran_out : Bool) -> Unit {
    if kind == "failed" && reason == "model" && is_some(a.turn) && !is_json_null(a.profile) && !a.stop_requested {
      sessions_core::try_k(
        fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
          self.rpc_k(a.key, "node.limitAfter", [a.profile], tk)
        },
        fn(ex_la : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
          match ex_la {
            effect::Exit::Interrupted => k(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
            effect::Exit::Succeeded(res) => {
              let limit : Option[base_codec::Json] = match res {
                Ok(v) => {
                  match v {
                    base_codec::Json::Obj(_) => sessions_core::jget(v, "limit")
                    _ => None
                  }
                }
                Err(_) => None
              }
              if !self.is_current(a, generation) {
                k(effect::Exit::Succeeded(()))
                return
              }
              match limit {
                Some(l) => {
                  self.log(a, "info", "a failure its words did not name is where the allowance shows a limit", [
                    ("model", if is_json_null(l) { sessions_core::jstr("") } else { l }),
                  ])
                }
                None => ()
              }
              self.on_turn_ended_body_k(a, outcome, kind, reason, message, lent_expired, ran_out, limit, k)
            }
          }
        },
      )
    } else {
      self.on_turn_ended_body_k(a, outcome, kind, reason, message, lent_expired, ran_out, None, k)
    }
  }
  if a.runtime == "agy" && init_kind == "failed" {
    match a.agent {
      Some(g) => {
        let check_lent = fn(reason : String, ran_out : Bool) -> Unit {
          let is_auth_retried = match a.turn {
            Some(t) => t.auth_retried
            None => false
          }
          if reason == "auth" && is_auth_retried {
            sessions_core::try_k(
              fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                self.agent_do_k(a, g, "lentExpired", [], tk)
              },
              fn(ex_le : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                match ex_le {
                  effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(res) => {
                    let le = match res {
                      Ok(v) => sessions_core::truthy(v)
                      Err(_) => false
                    }
                    if !self.is_current(a, generation) {
                      k(effect::Exit::Succeeded(()))
                      return
                    }
                    check_limit(init_kind, reason, le, ran_out)
                  }
                }
              },
            )
          } else {
            check_limit(init_kind, reason, false, ran_out)
          }
        }
        if init_reason == "other" && ascii_lower(message).contains("agent execution terminated due to error") {
          sessions_core::try_k(
            fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
              self.agent_do_k(a, g, "signInExpired", [], tk)
            },
            fn(ex_se : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
              match ex_se {
                effect::Exit::Interrupted => k(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
                effect::Exit::Succeeded(res) => {
                  let expired = match res {
                    Ok(v) => sessions_core::truthy(v)
                    Err(_) => false
                  }
                  if !self.is_current(a, generation) {
                    k(effect::Exit::Succeeded(()))
                    return
                  }
                  if expired {
                    check_lent("auth", true)
                  } else {
                    check_lent(init_reason, false)
                  }
                }
              }
            },
          )
        } else {
          check_lent(init_reason, false)
        }
        return
      }
      None => ()
    }
  }
  check_limit(init_kind, init_reason, false, false)
}

fn ActorsGen::on_turn_ended_body_k(
  self : ActorsGen,
  a : Actor,
  outcome : base_codec::Json,
  init_kind : String,
  reason : String,
  message : String,
  lent_expired : Bool,
  ran_out : Bool,
  limit : Option[base_codec::Json],
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  self.idle_now(a)
  let turn = a.turn
  a.turn = None
  self.cancel_mid_wait(a)
  let turn_undeclared = match turn {
    Some(t) => !is_some(t.declared)
    None => false
  }
  let turn_declared = match turn {
    Some(t) => is_some(t.declared)
    None => false
  }
  if init_kind == "completed" && !a.stop_requested && turn_undeclared {
    a.warm = true
  }
  match turn {
    Some(t) => {
      let trace_outcome = if a.stop_requested || init_kind == "aborted" {
        "stopped"
      } else if init_kind == "failed" {
        "failed"
      } else {
        "done"
      }
      self.emit_turn_trace(a, t, trace_outcome)
    }
    None => ()
  }
  let had_turn = is_some(turn)
  if had_turn {
    a.starting_turn = true
  }
  let finish = fn(ex : effect::Exit[Unit]) -> Unit {
    if a.warm && !is_some(a.deferred_end) {
      a.warm = false
      self.mirror(a)
    }
    if had_turn {
      a.starting_turn = false
      if !self.gen.counters.sealed && !is_some(a.turn) {
        self.drain_turn_queue(true)
      }
    }
    k(ex)
  }
  a.phase = "idle"
  if !(a.runtime == "codex" && init_kind == "failed" && reason == "model" && !is_some(limit) && bare_bad_request(message)) {
    a.codex_reloaded = None
  }
  let stop_requested = a.stop_requested
  a.stop_requested = false
  let refused = init_kind == "failed" && reason == "auth" && !stop_requested && turn_undeclared
  if !refused {
    a.auth_tried = []
  }
  let had_steered = a.steered.length() > 0
  let after_trailing_auth = fn(kind : String) -> Unit {
    let after_status_infer = fn(kept_wait : Option[Double]) -> Unit {
      self.on_turn_ended_record_k(
        a,
        turn,
        outcome,
        kind,
        reason,
        message,
        lent_expired,
        ran_out,
        limit,
        stop_requested,
        refused,
        kept_wait,
        finish,
      )
    }
    if kind == "completed" && !stop_requested {
      match turn {
        Some(t) => {
          let check_keep_ask = fn() -> Unit {
            if opt_str_is(kind_of(t.declared), "waiting") && !had_steered {
              match t.asked_before {
                Some(before) => {
                  let seconds = match t.declared {
                    Some(d) => num_or(sessions_core::num_of(sessions_core::jget(d, "seconds")), 0.0)
                    None => 0.0
                  }
                  self.rpc_k(a.key, "node.keepAsk", [sessions_core::jstr(t.id), before], fn(
                    ex_ka : effect::Exit[base_codec::Json],
                  ) -> Unit {
                    match ex_ka {
                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(kv) => {
                        if sessions_core::truthy(kv) {
                          t.declared = Some(base_codec::json_obj([("kind", sessions_core::jstr("need_help"))]))
                          self.log(a, "info", "woken by its background work, it waits on: what it asked before still stands")
                          after_status_infer(Some(seconds))
                        } else {
                          after_status_infer(None)
                        }
                      }
                    }
                  })
                  return
                }
                None => ()
              }
            }
            after_status_infer(None)
          }
          if !is_some(t.declared) && a.posted {
            self.last_turn_k(a, fn(ex_lt : effect::Exit[base_codec::Json]) -> Unit {
              match ex_lt {
                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                effect::Exit::Succeeded(last) => {
                  let started = sessions_core::field_of(last, "startedAt")
                  self.deps_k(a, "maxNudges", [], fn(ex_mn : effect::Exit[base_codec::Json]) -> Unit {
                    match ex_mn {
                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(mv) => {
                        let most = num_or(sessions_core::num_of(Some(mv)), 0.0).to_int()
                        self.rpc_k(a.key, "node.cardAsks", [sessions_core::jstr(t.id), started], fn(
                          ex_ca : effect::Exit[base_codec::Json],
                        ) -> Unit {
                          match ex_ca {
                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(cv) => {
                              if sessions_core::truthy(cv) {
                                t.declared = Some(base_codec::json_obj([("kind", sessions_core::jstr("need_help"))]))
                                self.log(a, "info", "the turn ended with no state on a card it posted, still waiting: it ends needing a person")
                              } else if a.nudges >= (if most < 1 { most } else { 1 }) {
                                t.declared = Some(base_codec::json_obj([("kind", sessions_core::jstr("all_done"))]))
                                self.log(a, "info", "the turn posted and said no state, asked again: it ends done")
                              }
                              check_keep_ask()
                            }
                          }
                        })
                      }
                    }
                  })
                }
              }
            })
          } else {
            check_keep_ask()
          }
          return
        }
        None => ()
      }
    }
    after_status_infer(None)
  }
  if init_kind == "failed" && reason == "auth" && !stop_requested && turn_declared {
    let had_agent = is_some(a.agent)
    let after_close = fn(ex_ep : effect::Exit[Unit]) -> Unit {
      match ex_ep {
        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
        effect::Exit::Succeeded(_) => {
          self.requeue_unread_steered_k(a, fn(ex_rq : effect::Exit[(Int, Int)]) -> Unit {
            match ex_rq {
              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
              effect::Exit::Succeeded((undelivered, restored_notices)) => {
                let done_ta = fn(ex_ns : effect::Exit[Unit]) -> Unit {
                  match ex_ns {
                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => {
                      let fields : Array[(String, base_codec::Json)] = [
                        ("runtime", sessions_core::jstr(a.runtime)),
                      ]
                      if undelivered > 0 {
                        fields.push(("undelivered", sessions_core::jint(undelivered)))
                      }
                      if restored_notices > 0 {
                        fields.push(("notices", sessions_core::jint(restored_notices)))
                      }
                      self.log(
                        a,
                        "info",
                        "trailing auth failure after the turn declared its state; closing the stale process and keeping the state",
                        fields,
                      )
                      after_trailing_auth("completed")
                    }
                  }
                }
                if had_agent || undelivered > 0 {
                  self.notify_store_k(a, done_ta)
                } else {
                  done_ta(effect::Exit::Succeeded(()))
                }
              }
            }
          })
        }
      }
    }
    if had_agent {
      let agent = a.agent
      self.set_agent(a, None)
      self.end_process_k(a, agent, after_close)
    } else {
      after_close(effect::Exit::Succeeded(()))
    }
  } else {
    after_trailing_auth(init_kind)
  }
}

/// Returns steered messages and station notices that the runtime has not yet read (`phase: "requesting"`)
/// back to the store and `a.notices` when a dying process is closed so the next process delivers them.
fn ActorsGen::requeue_unread_steered_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[(Int, Int)]) -> Unit,
) -> Unit {
  let keep = a.steered_unread_preparing
  let count = a.steered_unread.length() - keep
  let lost : Array[base_codec::Json] = []
  if count > 0 {
    for i in 0..<count {
      lost.push(a.steered_unread[i].handed)
    }
  }
  let lost_notices : Array[String] = []
  for i in 0..<a.steered_notices.length() {
    lost_notices.push(a.steered_notices[i].text)
  }
  let had_unread = a.unread.length() > 0 || a.unread_preparing > 0
  a.steered = []
  a.steered_for = []
  a.unread = []
  a.unread_preparing = 0
  a.steered_unread = []
  a.steered_unread_preparing = 0
  a.steered_notices = []
  a.steer_silent_steered = 0
  if lost_notices.length() > 0 {
    let next_n : Array[String] = []
    for i in 0..<lost_notices.length() {
      next_n.push(lost_notices[i])
    }
    for i in 0..<a.notices.length() {
      next_n.push(a.notices[i])
    }
    a.notices = next_n
  }
  let finish_rq = fn(ex : effect::Exit[Unit]) -> Unit {
    match ex {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(_) => {
        if had_unread || lost.length() > 0 {
          self.mirror(a)
        }
        k(effect::Exit::Succeeded((lost.length(), lost_notices.length())))
      }
    }
  }
  if lost.length() > 0 {
    self.store_k(
      a,
      "markUndelivered",
      [sessions_core::jstr(a.key), base_codec::json_arr(lost)],
      fn(ex_mu : effect::Exit[base_codec::Json]) -> Unit {
        match ex_mu {
          effect::Exit::Succeeded(_) => finish_rq(effect::Exit::Succeeded(()))
          effect::Exit::Failed(e) => finish_rq(effect::Exit::Failed(e))
          effect::Exit::Interrupted => finish_rq(effect::Exit::Interrupted)
        }
      },
    )
  } else {
    finish_rq(effect::Exit::Succeeded(()))
  }
}

fn ActorsGen::drain_steered_after_retry_k(
  self : ActorsGen,
  a : Actor,
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  if !is_some(a.turn) {
    k(effect::Exit::Succeeded(()))
    return
  }
  let after_pump = fn(ex_p : effect::Exit[Unit]) -> Unit {
    match ex_p {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(_) => {
        if a.notices.length() > 0 {
          self.give_notices_k(a, k)
        } else {
          k(effect::Exit::Succeeded(()))
        }
      }
    }
  }
  self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
    match ex_hp {
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Succeeded(true) => self.pump_k(a, -1, after_pump)
      effect::Exit::Succeeded(false) => after_pump(effect::Exit::Succeeded(()))
    }
  })
}

fn ActorsGen::on_turn_ended_record_k(
  self : ActorsGen,
  a : Actor,
  turn : Option[Turn],
  outcome : base_codec::Json,
  kind : String,
  reason : String,
  message : String,
  lent_expired : Bool,
  ran_out : Bool,
  limit : Option[base_codec::Json],
  stop_requested : Bool,
  refused : Bool,
  kept_wait : Option[Double],
  finish : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let turn_undeclared = match turn {
    Some(t) => !is_some(t.declared)
    None => false
  }
  let compute_warm = fn(warm : Bool) -> Unit {
    let after_running = fn(ex_sr : effect::Exit[Unit]) -> Unit {
      match ex_sr {
        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
        effect::Exit::Succeeded(_) => {
          let overloaded = is_some(turn) && kind == "failed" && reason == "overloaded" && !stop_requested
          let retry : Option[base_codec::Json] = if overloaded {
            let n = a.overloads
            a.overloads = a.overloads + 1
            Some(
              base_codec::json_obj([
                ("kind", sessions_core::jstr("waiting")),
                ("seconds", sessions_core::jnum(retry_after(n))),
              ]),
            )
          } else {
            None
          }
          if !overloaded {
            a.overloads = 0
          }
          let ends = match retry {
            Some(_) => retry
            None => {
              match turn {
                Some(t) => ended_in(t.declared, kind)
                None => None
              }
            }
          }
          let recorded = match turn {
            Some(t) => Some(t.id)
            None => None
          }
          let after_end_turn = fn(ex_et : effect::Exit[Unit]) -> Unit {
            match ex_et {
              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
              effect::Exit::Succeeded(_) => {
                if kind == "completed" && opt_str_is(kind_of(ends), "waiting") && !is_some(retry) {
                  match turn {
                    Some(t) => {
                      if t.wait_watch {
                        self.clear_silent_wait(a)
                      } else {
                        self.track_silent_wait(a, t)
                      }
                    }
                    None => ()
                  }
                } else if kind != "completed" || is_some(kind_of(ends)) {
                  self.clear_silent_wait(a)
                }
                self.on_turn_ended_tools_and_auth_k(
                  a,
                  turn,
                  outcome,
                  kind,
                  reason,
                  message,
                  lent_expired,
                  ran_out,
                  limit,
                  stop_requested,
                  refused,
                  kept_wait,
                  warm,
                  overloaded,
                  retry,
                  ends,
                  recorded,
                  finish,
                )
              }
            }
          }
          match turn {
            Some(t) => {
              let detail = if kind != "failed" {
                base_codec::json_null()
              } else {
                match limit {
                  Some(l) => {
                    let ls = match l {
                      base_codec::Json::Str(s) => s
                      _ => ""
                    }
                    sessions_core::jstr("limit:" + ls + ": " + message)
                  }
                  None => sessions_core::jstr(reason + ": " + message)
                }
              }
              let ends_kind = match kind_of(ends) {
                Some(ek) => sessions_core::jstr(ek)
                None => base_codec::json_null()
              }
              let wait_j = if opt_str_is(kind_of(ends), "waiting") {
                match ends {
                  Some(ev) => sessions_core::field_of(ev, "seconds")
                  None => base_codec::json_null()
                }
              } else {
                base_codec::json_null()
              }
              self.store_k(
                a,
                "endTurn",
                [sessions_core::jstr(t.id), sessions_core::jstr(kind), detail, ends_kind, wait_j],
                fn(ex_e : effect::Exit[base_codec::Json]) -> Unit {
                  match ex_e {
                    effect::Exit::Interrupted => after_end_turn(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => after_end_turn(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => {
                      if is_some(retry) {
                        self.t_k(a, "station.wait.overloaded", base_codec::json_null(), fn(
                          ex_t : effect::Exit[String],
                        ) -> Unit {
                          match ex_t {
                            effect::Exit::Interrupted => after_end_turn(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => after_end_turn(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(wmsg) => {
                              self.store_k(
                                a,
                                "setWaitFor",
                                [sessions_core::jstr(t.id), sessions_core::jstr(wmsg), sessions_core::jbool(false)],
                                fn(ex_sw : effect::Exit[base_codec::Json]) -> Unit {
                                  match ex_sw {
                                    effect::Exit::Succeeded(_) => after_end_turn(effect::Exit::Succeeded(()))
                                    effect::Exit::Failed(e) => after_end_turn(effect::Exit::Failed(e))
                                    effect::Exit::Interrupted => after_end_turn(effect::Exit::Interrupted)
                                  }
                                },
                              )
                            }
                          }
                        })
                      } else {
                        after_end_turn(effect::Exit::Succeeded(()))
                      }
                    }
                  }
                },
              )
            }
            None => after_end_turn(effect::Exit::Succeeded(()))
          }
        }
      }
    }
    if warm {
      a.warm = true
      after_running(effect::Exit::Succeeded(()))
    } else {
      a.warm = false
      self.set_running_k(a, false, after_running)
    }
  }
  if kind == "completed" && !stop_requested && turn_undeclared {
    self.deps_k(a, "maxNudges", [], fn(ex_mn : effect::Exit[base_codec::Json]) -> Unit {
      match ex_mn {
        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
        effect::Exit::Succeeded(mv) => {
          let most = num_or(sessions_core::num_of(Some(mv)), 0.0).to_int()
          compute_warm(a.nudges < most)
        }
      }
    })
  } else {
    compute_warm(false)
  }
}

fn ActorsGen::on_turn_ended_tools_and_auth_k(
  self : ActorsGen,
  a : Actor,
  turn : Option[Turn],
  outcome : base_codec::Json,
  kind : String,
  reason : String,
  message : String,
  lent_expired : Bool,
  ran_out : Bool,
  limit : Option[base_codec::Json],
  stop_requested : Bool,
  refused : Bool,
  kept_wait : Option[Double],
  warm : Bool,
  overloaded : Bool,
  retry : Option[base_codec::Json],
  ends : Option[base_codec::Json],
  recorded : Option[String],
  finish : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let turn_undeclared = match turn {
    Some(t) => !is_some(t.declared)
    None => false
  }
  let after_unheard = fn(unheard_tools : Bool) -> Unit {
    let resolve_lost = fn(lost : Option[String]) -> Unit {
      a.tools_lost = None
      a.tools_lost_heard = None
      let after_lost_proc = fn(ex_lp : effect::Exit[Unit]) -> Unit {
        match ex_lp {
          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
          effect::Exit::Succeeded(_) => {
            match turn {
              Some(t) => {
                if is_some(t.declared) {
                  a.tools_restarts = 0
                }
              }
              None => ()
            }
            self.on_turn_ended_codex_auth_k(
              a,
              turn,
              outcome,
              kind,
              reason,
              message,
              lent_expired,
              ran_out,
              limit,
              stop_requested,
              refused,
              kept_wait,
              warm,
              overloaded,
              retry,
              ends,
              recorded,
              is_some(lost),
              unheard_tools,
              finish,
            )
          }
        }
      }
      match lost {
        Some(why) => {
          let agent = a.agent
          self.set_agent(a, None)
          self.log(a, "warn", "ending the process that lost the station's tools; the next one resumes it", [
            ("why", sessions_core::jstr(why)),
          ])
          self.end_process_k(a, agent, fn(ex_ep : effect::Exit[Unit]) -> Unit {
            match ex_ep {
              effect::Exit::Interrupted => after_lost_proc(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => after_lost_proc(effect::Exit::Failed(e))
              effect::Exit::Succeeded(_) => {
                self.requeue_unread_steered_k(a, fn(ex_rq : effect::Exit[(Int, Int)]) -> Unit {
                  match ex_rq {
                    effect::Exit::Interrupted => after_lost_proc(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => after_lost_proc(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => self.notify_store_k(a, after_lost_proc)
                  }
                })
              }
            }
          })
        }
        None => {
          let hung = is_opt_json_true(sessions_core::jget(outcome, "hung"))
          if hung && is_some(a.agent) {
            let agent = a.agent
            self.set_agent(a, None)
            self.end_process_k(a, agent, fn(ex_ep : effect::Exit[Unit]) -> Unit {
              match ex_ep {
                effect::Exit::Interrupted => after_lost_proc(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => after_lost_proc(effect::Exit::Failed(e))
                effect::Exit::Succeeded(_) => {
                  // (what a person said while it was silent was steered into the process ended: handed again to the
                  // next, `pump`; 1:1 `actor_run.mbt` `on_turn_ended`)
                  let from = if a.steer_silent_steered > a.steered.length() {
                    a.steered.length()
                  } else {
                    a.steer_silent_steered
                  }
                  let lost : Array[base_codec::Json] = []
                  for i in from..<a.steered.length() {
                    lost.push(a.steered[i])
                  }
                  let lost_notices : Array[String] = []
                  for i in 0..<a.steered_notices.length() {
                    lost_notices.push(a.steered_notices[i].text)
                  }
                  a.steered = []
                  a.steered_for = []
                  a.unread = []
                  a.unread_preparing = 0
                  a.steered_unread = []
                  a.steered_unread_preparing = 0
                  a.steered_notices = []
                  a.steer_silent_steered = 0
                  if lost_notices.length() > 0 {
                    let next_n : Array[String] = []
                    for i in 0..<lost_notices.length() {
                      next_n.push(lost_notices[i])
                    }
                    for i in 0..<a.notices.length() {
                      next_n.push(a.notices[i])
                    }
                    a.notices = next_n
                  }
                  let after_undel = fn(ex_mu : effect::Exit[Unit]) -> Unit {
                    match ex_mu {
                      effect::Exit::Interrupted => after_lost_proc(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => after_lost_proc(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(_) => {
                        self.mirror(a)
                        self.notify_store_k(a, after_lost_proc)
                      }
                    }
                  }
                  if lost.length() > 0 {
                    self.store_k(
                      a,
                      "markUndelivered",
                      [sessions_core::jstr(a.key), base_codec::json_arr(lost)],
                      fn(ex_st : effect::Exit[base_codec::Json]) -> Unit {
                        match ex_st {
                          effect::Exit::Succeeded(_) => after_undel(effect::Exit::Succeeded(()))
                          effect::Exit::Failed(e) => after_undel(effect::Exit::Failed(e))
                          effect::Exit::Interrupted => after_undel(effect::Exit::Interrupted)
                        }
                      },
                    )
                  } else {
                    after_undel(effect::Exit::Succeeded(()))
                  }
                }
              }
            })
          } else {
            after_lost_proc(effect::Exit::Succeeded(()))
          }
        }
      }
    }
    match (a.tools_lost, a.tools_lost_heard) {
      (Some(_), Some(before)) => {
        if !unheard_tools {
          self.tools_heard_k(a, fn(ex_th : effect::Exit[Option[Double]]) -> Unit {
            match ex_th {
              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
              effect::Exit::Succeeded(Some(now_h)) => {
                if now_h > before {
                  self.log(a, "info", "the agent reached the station's tools again after a call failed; its process is kept")
                  resolve_lost(None)
                } else {
                  resolve_lost(a.tools_lost)
                }
              }
              effect::Exit::Succeeded(None) => resolve_lost(a.tools_lost)
            }
          })
        } else {
          resolve_lost(a.tools_lost)
        }
      }
      _ => resolve_lost(a.tools_lost)
    }
  }
  if !is_some(a.tools_lost) && kind == "completed" && !stop_requested && !a.posted && turn_undeclared {
    match a.agent {
      Some(g) => {
        sessions_core::try_k(
          fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
            self.rpc_k(
              a.key,
              "node.toolsUnheard",
              [sessions_core::jint(g.handle), sessions_core::jbool(a.nudges > 0)],
              tk,
            )
          },
          fn(ex_tu : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
            match ex_tu {
              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
              effect::Exit::Succeeded(res) => {
                match res {
                  Ok(base_codec::Json::Str(why)) => {
                    self.log(a, "warn", "the agent cannot reach the station's tools", [
                      ("why", sessions_core::jstr(why)),
                    ])
                    a.tools_lost = Some(why)
                    after_unheard(true)
                  }
                  Err(e) => {
                    self.log(a, "warn", "toolsUnheard check failed", [
                      ("error", sessions_core::jstr(sessions_core::error_message(e))),
                    ])
                    after_unheard(false)
                  }
                  _ => after_unheard(false)
                }
              }
            }
          },
        )
        return
      }
      None => ()
    }
  }
  after_unheard(false)
}

fn ActorsGen::on_turn_ended_codex_auth_k(
  self : ActorsGen,
  a : Actor,
  turn : Option[Turn],
  outcome : base_codec::Json,
  kind : String,
  reason : String,
  message : String,
  lent_expired : Bool,
  ran_out : Bool,
  limit : Option[base_codec::Json],
  stop_requested : Bool,
  refused : Bool,
  kept_wait : Option[Double],
  warm : Bool,
  overloaded : Bool,
  retry : Option[base_codec::Json],
  ends : Option[base_codec::Json],
  recorded : Option[String],
  lost_bool : Bool,
  unheard_tools : Bool,
  finish : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let with_too_old = fn(too_old : Bool) -> Unit {
    let after_codex_update = fn() -> Unit {
      let refused_on : Option[String] = match a.profile {
        base_codec::Json::Str(p) => if p != "" && refused && !lent_expired && !ran_out { Some(p) } else { None }
        _ => None
      }
      let tried_before = auth_tried_json(a)
      let after_recheck = fn(ex_rc : effect::Exit[Unit]) -> Unit {
        match ex_rc {
          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
          effect::Exit::Succeeded(_) => {
            let after_trajectory = fn() -> Unit {
              let after_auth_retry = fn() -> Unit {
                let after_agy_cleanup = fn(ex_ac : effect::Exit[Unit]) -> Unit {
                  match ex_ac {
                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(_) => {
                      self.on_turn_ended_notices_k(
                        a,
                        turn,
                        outcome,
                        kind,
                        reason,
                        message,
                        limit,
                        stop_requested,
                        kept_wait,
                        warm,
                        overloaded,
                        retry,
                        ends,
                        recorded,
                        lost_bool,
                        unheard_tools,
                        too_old,
                        finish,
                      )
                    }
                  }
                }
                if a.runtime == "agy" && kind == "failed" && reason == "auth" && is_some(a.agent) {
                  let agent = a.agent
                  self.set_agent(a, None)
                  self.end_process_k(a, agent, fn(ex_ep : effect::Exit[Unit]) -> Unit {
                    match ex_ep {
                      effect::Exit::Interrupted => after_agy_cleanup(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => after_agy_cleanup(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(_) => self.notify_store_k(a, after_agy_cleanup)
                    }
                  })
                } else {
                  after_agy_cleanup(effect::Exit::Succeeded(()))
                }
              }
              if refused && a.auth_tried.length() < AUTH_TRIED_MOST {
                match turn {
                  Some(t) => {
                    if (!t.passive || lent_expired) &&
                    (lent_expired || ran_out || !t.auth_retried || is_some(refused_on)) {
                      self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
                        match ex_h {
                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(true) => after_auth_retry()
                          effect::Exit::Succeeded(false) => {
                            let agent = a.agent
                            self.set_agent(a, None)
                            self.end_process_k(a, agent, fn(ex_ep : effect::Exit[Unit]) -> Unit {
                              match ex_ep {
                                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                effect::Exit::Succeeded(_) => {
                                  let with_allow = fn(allow_retry : Bool) -> Unit {
                                    if !allow_retry {
                                      a.auth_tried = []
                                      self.notify_store_k(a, fn(ex_ns : effect::Exit[Unit]) -> Unit {
                                        match ex_ns {
                                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                          effect::Exit::Succeeded(_) => {
                                            self.log(
                                              a,
                                              "info",
                                              "authentication failed; profile unusable and no healthy fallback, waiting for user",
                                              [("runtime", sessions_core::jstr(a.runtime))],
                                            )
                                            after_auth_retry()
                                          }
                                        }
                                      })
                                    } else {
                                      self.requeue_unread_steered_k(a, fn(ex_rq : effect::Exit[(Int, Int)]) -> Unit {
                                        match ex_rq {
                                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                          effect::Exit::Succeeded(_) => {
                                            a.nudges = 0
                                            self.log(
                                              a,
                                              "info",
                                              "authentication failed; reopening and continuing",
                                              [
                                                ("runtime", sessions_core::jstr(a.runtime)),
                                                ("tried", auth_tried_json(a)),
                                              ],
                                            )
                                            self.words_k(a, "GO_ON_AFTER_AUTH", [], fn(
                                              ex_w : effect::Exit[String],
                                            ) -> Unit {
                                              match ex_w {
                                                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                effect::Exit::Succeeded(words) => {
                                                  if self.gen.counters.max_concurrent_turns > 0 &&
                                                  self.active_turn_slots() > self.gen.counters.max_concurrent_turns {
                                                    a.queued_retry = Some(QueuedRetry::{
                                                      kind: "auth_retry",
                                                      text: words,
                                                      by: t.by,
                                                      codex_retried: t.codex_retried,
                                                      passive: false,
                                                      fresh: false,
                                                    })
                                                    self.enqueue_turn_wait(a)
                                                    finish(effect::Exit::Succeeded(()))
                                                    return
                                                  }
                                                  self.start_turn_k(
                                                    a,
                                                    "auth_retry",
                                                    words,
                                                    t.by,
                                                    None,
                                                    false,
                                                    0,
                                                    false,
                                                    fn(ex_st : effect::Exit[Unit]) -> Unit {
                                                      match ex_st {
                                                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                        effect::Exit::Succeeded(_) => {
                                                          match a.turn {
                                                            Some(nt) => {
                                                              if t.codex_retried {
                                                                nt.codex_retried = true
                                                              }
                                                            }
                                                            None => ()
                                                          }
                                                          self.drain_steered_after_retry_k(a, finish)
                                                        }
                                                      }
                                                    },
                                                  )
                                                }
                                              }
                                            })
                                          }
                                        }
                                      })
                                    }
                                  }
                                  match refused_on {
                                    Some(p) => {
                                      self.deps_k(
                                        a,
                                        "canAuthRetry",
                                        [sessions_core::jstr(a.key), sessions_core::jstr(p), tried_before],
                                        fn(ex_can : effect::Exit[base_codec::Json]) -> Unit {
                                          match ex_can {
                                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                            effect::Exit::Succeeded(cv) => {
                                              let can = !is_json_false_val(cv)
                                              if !array_contains_str(a.auth_tried, p) {
                                                a.auth_tried.push(p)
                                              }
                                              with_allow(can)
                                            }
                                          }
                                        },
                                      )
                                    }
                                    None => with_allow(lent_expired || ran_out || !t.auth_retried)
                                  }
                                }
                              }
                            })
                          }
                        }
                      })
                      return
                    }
                  }
                  None => ()
                }
              }
              after_auth_retry()
            }
            if a.runtime == "agy" && kind == "failed" && ascii_lower(message).contains("trajectory not found") {
              let agent = a.agent
              self.set_agent(a, None)
              self.end_process_k(a, agent, fn(ex_ep : effect::Exit[Unit]) -> Unit {
                match ex_ep {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(_) => {
                    self.notify_store_k(a, fn(ex_ns : effect::Exit[Unit]) -> Unit {
                      match ex_ns {
                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                        effect::Exit::Succeeded(_) => {
                          if !stop_requested {
                            match turn {
                              Some(t) => {
                                if !t.auth_retried && !is_some(t.declared) {
                                  self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
                                    match ex_h {
                                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                      effect::Exit::Succeeded(true) => after_trajectory()
                                      effect::Exit::Succeeded(false) => {
                                        self.requeue_unread_steered_k(a, fn(ex_rq : effect::Exit[(Int, Int)]) -> Unit {
                                          match ex_rq {
                                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                            effect::Exit::Succeeded(_) => {
                                              a.nudges = 0
                                              self.log(
                                                a,
                                                "warn",
                                                "Antigravity trajectory missing; reopening in a new runtime session",
                                                [("error", sessions_core::jstr(message))],
                                              )
                                              self.start_turn_k(
                                                a,
                                                "auth_retry",
                                                a.turn_text,
                                                t.by,
                                                None,
                                                false,
                                                0,
                                                false,
                                                fn(ex_st : effect::Exit[Unit]) -> Unit {
                                                  match ex_st {
                                                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                    effect::Exit::Succeeded(_) => {
                                                      match a.turn {
                                                        Some(nt) => {
                                                          if t.codex_retried {
                                                            nt.codex_retried = true
                                                          }
                                                        }
                                                        None => ()
                                                      }
                                                      self.drain_steered_after_retry_k(a, finish)
                                                    }
                                                  }
                                                },
                                              )
                                            }
                                          }
                                        })
                                      }
                                    }
                                  })
                                  return
                                }
                              }
                              None => ()
                            }
                          }
                          after_trajectory()
                        }
                      }
                    })
                  }
                }
              })
            } else {
              after_trajectory()
            }
          }
        }
      }
      match refused_on {
        Some(p) => {
          self.deps_k(
            a,
            "recheck",
            [sessions_core::jstr(p), sessions_core::jbool(array_contains_str(a.auth_tried, p)), sessions_core::jstr(message)],
            fn(ex_r : effect::Exit[base_codec::Json]) -> Unit {
              match ex_r {
                effect::Exit::Succeeded(_) => after_recheck(effect::Exit::Succeeded(()))
                effect::Exit::Failed(e) => after_recheck(effect::Exit::Failed(e))
                effect::Exit::Interrupted => after_recheck(effect::Exit::Interrupted)
              }
            },
          )
        }
        None => after_recheck(effect::Exit::Succeeded(()))
      }
    }
    if too_old && !stop_requested {
      match turn {
        Some(t) => {
          if !t.codex_retried && !is_some(t.declared) {
            self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
              match ex_h {
                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                effect::Exit::Succeeded(true) => after_codex_update()
                effect::Exit::Succeeded(false) => {
                  self.rpc_k(a.key, "node.canUpdateCodex", [], fn(
                    ex_cu : effect::Exit[base_codec::Json],
                  ) -> Unit {
                    match ex_cu {
                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                      effect::Exit::Succeeded(base_codec::Json::Bool(true)) => {
                        let agent = a.agent
                        a.codex_next = a.codex_next + 1
                        let update = CodexUpdate::{
                          id: a.codex_next,
                          by: t.by,
                          finished: false,
                          turn: t.id,
                        }
                        a.codex_update = Some(update)
                        self.set_agent(a, None)
                        a.nudges = 0
                        self.t_k(a, "station.notice.codexUpdating", base_codec::json_null(), fn(
                          ex_t : effect::Exit[String],
                        ) -> Unit {
                          match ex_t {
                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(msg) => {
                              self.notice_k(
                                a,
                                msg,
                                base_codec::json_null(),
                                base_codec::json_null(),
                                base_codec::json_null(),
                                Some(t.id),
                                false,
                                fn(ex_n : effect::Exit[Unit]) -> Unit {
                                  match ex_n {
                                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                    effect::Exit::Succeeded(_) => {
                                      let handle = match agent {
                                        Some(g) => sessions_core::jint(g.handle)
                                        None => base_codec::json_null()
                                      }
                                      self.rpc_k(
                                        a.key,
                                        "node.codexBefore",
                                        [handle, sessions_core::jint(update.id)],
                                        fn(ex_cb : effect::Exit[base_codec::Json]) -> Unit {
                                          match ex_cb {
                                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                            effect::Exit::Succeeded(_) => {
                                              self.end_process_k(a, agent, fn(ex_ep : effect::Exit[Unit]) -> Unit {
                                                match ex_ep {
                                                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                  effect::Exit::Succeeded(_) => {
                                                    self.requeue_unread_steered_k(a, fn(ex_rq : effect::Exit[(Int, Int)]) -> Unit {
                                                      match ex_rq {
                                                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                        effect::Exit::Succeeded(_) => {
                                                          self.set_running_k(a, true, fn(ex_sr : effect::Exit[Unit]) -> Unit {
                                                            match ex_sr {
                                                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                              effect::Exit::Succeeded(_) => {
                                                                self.rpc_k(
                                                                  a.key,
                                                                  "node.updateCodex",
                                                                  [sessions_core::jint(update.id)],
                                                                  fn(ex_uc : effect::Exit[base_codec::Json]) -> Unit {
                                                                    match ex_uc {
                                                                      effect::Exit::Succeeded(_) => finish(effect::Exit::Succeeded(()))
                                                                      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                                    }
                                                                  },
                                                                )
                                                              }
                                                            }
                                                          })
                                                        }
                                                      }
                                                    })
                                                  }
                                                }
                                              })
                                            }
                                          }
                                        },
                                      )
                                    }
                                  }
                                },
                              )
                            }
                          }
                        })
                      }
                      effect::Exit::Succeeded(_) => after_codex_update()
                    }
                  })
                }
              }
            })
            return
          }
        }
        None => ()
      }
    }
    after_codex_update()
  }
  if a.runtime == "codex" && kind == "failed" {
    self.rpc_k(
      a.key,
      "node.words",
      [sessions_core::jstr("codexTooOld"), sessions_core::jstr(message)],
      fn(ex_to : effect::Exit[base_codec::Json]) -> Unit {
        match ex_to {
          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
          effect::Exit::Succeeded(base_codec::Json::Bool(true)) => with_too_old(true)
          effect::Exit::Succeeded(_) => with_too_old(false)
        }
      },
    )
  } else {
    with_too_old(false)
  }
}

fn ActorsGen::on_turn_ended_notices_k(
  self : ActorsGen,
  a : Actor,
  turn : Option[Turn],
  outcome : base_codec::Json,
  kind : String,
  reason : String,
  message : String,
  limit : Option[base_codec::Json],
  stop_requested : Bool,
  kept_wait : Option[Double],
  warm : Bool,
  overloaded : Bool,
  retry : Option[base_codec::Json],
  ends : Option[base_codec::Json],
  recorded : Option[String],
  lost_bool : Bool,
  unheard_tools : Bool,
  too_old : Bool,
  finish : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let after_outcome_notice = fn(ex_on : effect::Exit[Unit]) -> Unit {
    match ex_on {
      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
      effect::Exit::Succeeded(_) => {
        self.on_turn_ended_finalize_k(
          a,
          turn,
          kind,
          message,
          stop_requested,
          kept_wait,
          warm,
          retry,
          ends,
          recorded,
          lost_bool,
          unheard_tools,
          finish,
        )
      }
    }
  }
  let spent = kind == "failed" && reason == "rate_limit"
  if !spent {
    a.refill = None
  }
  if spent {
    a.nudges = 0
    self.rpc_k(
      a.key,
      "node.words",
      [sessions_core::jstr("modelLimitOf"), sessions_core::jstr(message)],
      fn(ex_ml : effect::Exit[base_codec::Json]) -> Unit {
        match ex_ml {
          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
          effect::Exit::Succeeded(model) => {
            sessions_core::try_k(
              fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                self.deps_k(a, "spend", [sessions_core::jstr(a.key), a.profile, model], tk)
              },
              fn(ex_sp : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                match ex_sp {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(res) => {
                    let moved = match res {
                      Ok(v) => v
                      Err(e) => {
                        self.log(a, "warn", "could not move off a spent profile", [
                          ("error", sessions_core::jstr(sessions_core::error_message(e))),
                        ])
                        base_codec::json_null()
                      }
                    }
                    match moved {
                      base_codec::Json::Arr(m) => {
                        let agent = a.agent
                        self.set_agent(a, None)
                        self.end_process_k(a, agent, fn(ex_ep : effect::Exit[Unit]) -> Unit {
                          match ex_ep {
                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(_) => {
                              self.requeue_unread_steered_k(a, fn(ex_rq : effect::Exit[(Int, Int)]) -> Unit {
                                match ex_rq {
                                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                  effect::Exit::Succeeded(_) => {
                                    let from_v = if m.length() > 0 { m[0] } else { base_codec::json_null() }
                                    let to_v = if m.length() > 1 { m[1] } else { base_codec::json_null() }
                                    self.log(a, "info", "allowance ran out; going on on another profile", [
                                      ("from", from_v),
                                      ("to", to_v),
                                    ])
                                    a.refill = None
                                    if self.gen.counters.max_concurrent_turns > 0 &&
                                    self.active_turn_slots() > self.gen.counters.max_concurrent_turns {
                                      self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                                        match ex_hp {
                                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                          effect::Exit::Succeeded(has_p) => {
                                            if !has_p {
                                              self.words_k(a, "GO_ON_AFTER_SPENT", [], fn(
                                                ex_w : effect::Exit[String],
                                              ) -> Unit {
                                                match ex_w {
                                                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                  effect::Exit::Succeeded(words) => {
                                                    a.queued_retry = Some(QueuedRetry::{
                                                      kind: "resume",
                                                      text: words,
                                                      by: turn_for_nobody(),
                                                      codex_retried: false,
                                                      passive: false,
                                                      fresh: false,
                                                    })
                                                    self.enqueue_turn_wait(a)
                                                    finish(effect::Exit::Succeeded(()))
                                                  }
                                                }
                                              })
                                            } else {
                                              self.enqueue_turn_wait(a)
                                              finish(effect::Exit::Succeeded(()))
                                            }
                                          }
                                        }
                                      })
                                      return
                                    }
                                    self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                                      match ex_hp {
                                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                        effect::Exit::Succeeded(true) => self.pump_k(a, -1, finish)
                                        effect::Exit::Succeeded(false) => {
                                          if a.notices.length() > 0 {
                                            self.give_notices_k(a, finish)
                                            return
                                          }
                                          self.words_k(a, "GO_ON_AFTER_SPENT", [], fn(
                                            ex_w : effect::Exit[String],
                                          ) -> Unit {
                                            match ex_w {
                                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                              effect::Exit::Succeeded(words) => {
                                                self.start_turn_k(
                                                  a,
                                                  "resume",
                                                  words,
                                                  turn_for_nobody(),
                                                  None,
                                                  false,
                                                  0,
                                                  false,
                                                  finish,
                                                )
                                              }
                                            }
                                          })
                                        }
                                      }
                                    })
                                  }
                                }
                              })
                            }
                          }
                        })
                        return
                      }
                      base_codec::Json::Obj(_) => {
                        if opt_str_is(sessions_core::str_of(sessions_core::jget(moved, "paused")), "session_cap") {
                          let agent = a.agent
                          self.set_agent(a, None)
                          self.end_process_k(a, agent, fn(ex_ep : effect::Exit[Unit]) -> Unit {
                            match ex_ep {
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                              effect::Exit::Succeeded(_) => {
                                self.requeue_unread_steered_k(a, fn(ex_rq : effect::Exit[(Int, Int)]) -> Unit {
                                  match ex_rq {
                                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                    effect::Exit::Succeeded(_) => {
                                      a.refill = None
                                      self.words_k(a, "GO_ON_AFTER_SPENT", [], fn(ex_w : effect::Exit[String]) -> Unit {
                                        match ex_w {
                                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                          effect::Exit::Succeeded(words) => {
                                            a.queued_retry = Some(QueuedRetry::{
                                              kind: "resume",
                                              text: words,
                                              by: turn_for_nobody(),
                                              codex_retried: false,
                                              passive: false,
                                              fresh: false,
                                            })
                                            self.pause_for_session_cap_k(
                                              a,
                                              str_or(
                                                sessions_core::str_of(sessions_core::jget(moved, "profile")),
                                                "",
                                              ),
                                              num_or(
                                                sessions_core::num_of(sessions_core::jget(moved, "active")),
                                                0.0,
                                              ).to_int(),
                                              num_or(
                                                sessions_core::num_of(sessions_core::jget(moved, "cap")),
                                                0.0,
                                              ).to_int(),
                                              is_opt_json_true(sessions_core::jget(moved, "protection")),
                                              "resume",
                                              turn_for_nobody(),
                                              None,
                                              finish,
                                            )
                                          }
                                        }
                                      })
                                    }
                                  }
                                })
                              }
                            }
                          })
                          return
                        }
                      }
                      _ => ()
                    }
                    self.failure_notice_k(a, outcome, fn(ex_fn : effect::Exit[String]) -> Unit {
                      match ex_fn {
                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                        effect::Exit::Succeeded(notice) => {
                          self.rpc_k(a.key, "node.words", [sessions_core::jstr("spentBefore")], fn(
                            ex_sb : effect::Exit[base_codec::Json],
                          ) -> Unit {
                            match ex_sb {
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                              effect::Exit::Succeeded(sb_v) => {
                                let parts = notice.split("\n\n")
                                let head = if parts.length() > 0 { parts[0] } else { notice }
                                let starts : Array[String] = [head]
                                match sb_v {
                                  base_codec::Json::Arr(xs) => {
                                    for i in 0..<xs.length() {
                                      match sessions_core::str_of(Some(xs[i])) {
                                        Some(s) => starts.push(s)
                                        None => ()
                                      }
                                    }
                                  }
                                  _ => ()
                                }
                                self.said_last_k(a, fn(ex_sl : effect::Exit[Option[String]]) -> Unit {
                                  match ex_sl {
                                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                    effect::Exit::Succeeded(said_opt) => {
                                      let mut dup_spent = false
                                      match said_opt {
                                        Some(s) => {
                                          for i in 0..<starts.length() {
                                            if s.starts_with(starts[i]) {
                                              dup_spent = true
                                              break
                                            }
                                          }
                                        }
                                        None => ()
                                      }
                                      let after_spent_notice = fn(ex_sn : effect::Exit[Unit]) -> Unit {
                                        match ex_sn {
                                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                          effect::Exit::Succeeded(_) => {
                                            self.refills_at_k(a, fn(ex_ra : effect::Exit[Double]) -> Unit {
                                              match ex_ra {
                                                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                effect::Exit::Succeeded(at) => {
                                                  self.await_refill(a, at)
                                                  after_outcome_notice(effect::Exit::Succeeded(()))
                                                }
                                              }
                                            })
                                          }
                                        }
                                      }
                                      if !dup_spent {
                                        self.notice_k(
                                          a,
                                          notice,
                                          a.profile,
                                          base_codec::json_null(),
                                          base_codec::json_null(),
                                          recorded,
                                          false,
                                          after_spent_notice,
                                        )
                                      } else {
                                        match turn {
                                          Some(t) => {
                                            self.store_k(a, "latestThread", [sessions_core::jstr(a.key)], fn(
                                              ex_lt : effect::Exit[base_codec::Json],
                                            ) -> Unit {
                                              match ex_lt {
                                                effect::Exit::Interrupted => after_spent_notice(effect::Exit::Interrupted)
                                                effect::Exit::Failed(e) => after_spent_notice(effect::Exit::Failed(e))
                                                effect::Exit::Succeeded(latest) => {
                                                  match sessions_core::jget(latest, "thread") {
                                                    Some(thread) => {
                                                      let tid = sessions_core::field_of(thread, "id")
                                                      self.store_k(
                                                        a,
                                                        "entriesBefore",
                                                        [tid, base_codec::json_null(), sessions_core::jint(1)],
                                                        fn(ex_eb : effect::Exit[base_codec::Json]) -> Unit {
                                                          match ex_eb {
                                                            effect::Exit::Interrupted => after_spent_notice(effect::Exit::Interrupted)
                                                            effect::Exit::Failed(e) => after_spent_notice(effect::Exit::Failed(e))
                                                            effect::Exit::Succeeded(base_codec::Json::Arr(rows)) => {
                                                              if rows.length() > 0 {
                                                                let last = rows[rows.length() - 1]
                                                                self.store_k(
                                                                  a,
                                                                  "setAbout",
                                                                  [
                                                                    sessions_core::jstr(t.id),
                                                                    base_codec::json_arr([
                                                                      tid,
                                                                      sessions_core::field_of(last, "n"),
                                                                      sessions_core::field_of(last, "ts"),
                                                                    ]),
                                                                  ],
                                                                  fn(ex_sa : effect::Exit[base_codec::Json]) -> Unit {
                                                                    match ex_sa {
                                                                      effect::Exit::Interrupted => after_spent_notice(effect::Exit::Interrupted)
                                                                      effect::Exit::Failed(e) => after_spent_notice(effect::Exit::Failed(e))
                                                                      effect::Exit::Succeeded(_) => self.notify_store_k(a, after_spent_notice)
                                                                    }
                                                                  },
                                                                )
                                                              } else {
                                                                after_spent_notice(effect::Exit::Succeeded(()))
                                                              }
                                                            }
                                                            effect::Exit::Succeeded(_) => after_spent_notice(effect::Exit::Succeeded(()))
                                                          }
                                                        },
                                                      )
                                                    }
                                                    None => after_spent_notice(effect::Exit::Succeeded(()))
                                                  }
                                                }
                                              }
                                            })
                                          }
                                          None => after_spent_notice(effect::Exit::Succeeded(()))
                                        }
                                      }
                                    }
                                  }
                                })
                              }
                            }
                          })
                        }
                      }
                    })
                  }
                }
              },
            )
          }
        }
      },
    )
    return
  }
  if overloaded {
    a.nudges = 0
    self.last_turn_k(a, fn(ex_lt : effect::Exit[base_codec::Json]) -> Unit {
      match ex_lt {
        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
        effect::Exit::Succeeded(last_t) => {
          let about = sessions_core::jget(last_t, "about")
          self.store_k(a, "latestThread", [sessions_core::jstr(a.key)], fn(
            ex_lth : effect::Exit[base_codec::Json],
          ) -> Unit {
            match ex_lth {
              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
              effect::Exit::Succeeded(latest) => {
                self.t_k(a, "station.notice.overloaded", base_codec::json_null(), fn(
                  ex_t : effect::Exit[String],
                ) -> Unit {
                  match ex_t {
                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(ov_msg) => {
                      let notice = "⚠️ " + ov_msg
                      let finish_ov = fn(same : Bool) -> Unit {
                        if !same {
                          self.notice_k(
                            a,
                            notice,
                            base_codec::json_null(),
                            base_codec::json_null(),
                            base_codec::json_null(),
                            recorded,
                            true,
                            fn(ex_n : effect::Exit[Unit]) -> Unit {
                              match ex_n {
                                effect::Exit::Interrupted => after_outcome_notice(effect::Exit::Interrupted)
                                effect::Exit::Failed(e) => after_outcome_notice(effect::Exit::Failed(e))
                                effect::Exit::Succeeded(_) => self.notify_store_k(a, after_outcome_notice)
                              }
                            },
                          )
                        } else {
                          self.notify_store_k(a, after_outcome_notice)
                        }
                      }
                      match (about, sessions_core::jget(latest, "thread")) {
                        (Some(ab), Some(thread)) => {
                          match ab {
                            base_codec::Json::Obj(_) => {
                              let tid = sessions_core::field_of(thread, "id")
                              self.store_k(
                                a,
                                "entriesBefore",
                                [tid, base_codec::json_null(), sessions_core::jint(1)],
                                fn(ex_eb : effect::Exit[base_codec::Json]) -> Unit {
                                  match ex_eb {
                                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                    effect::Exit::Succeeded(base_codec::Json::Arr(rows)) => {
                                      if rows.length() > 0 {
                                        let last = rows[rows.length() - 1]
                                        let is_same = json_eq(sessions_core::field_of(ab, "thread"), tid) &&
                                        json_eq(sessions_core::field_of(ab, "seq"), sessions_core::field_of(last, "n")) &&
                                        json_eq(sessions_core::field_of(ab, "ts"), sessions_core::field_of(last, "ts")) &&
                                        opt_str_is(sessions_core::str_of(sessions_core::jget(last, "text")), notice)
                                        finish_ov(is_same)
                                      } else {
                                        finish_ov(false)
                                      }
                                    }
                                    effect::Exit::Succeeded(_) => finish_ov(false)
                                  }
                                },
                              )
                            }
                            _ => finish_ov(false)
                          }
                        }
                        _ => finish_ov(false)
                      }
                    }
                  }
                })
              }
            }
          })
        }
      }
    })
    return
  }
  if kind == "failed" {
    a.nudges = 0
    let post_failed = fn(ex_s : effect::Exit[String]) -> Unit {
      match ex_s {
        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
        effect::Exit::Succeeded(said) => {
          let prof = if reason == "auth" || reason == "refused" { a.profile } else { base_codec::json_null() }
          self.notice_k(a, said, prof, base_codec::json_null(), base_codec::json_null(), recorded, false, after_outcome_notice)
        }
      }
    }
    match limit {
      Some(l) => {
        self.rpc_k(
          a.key,
          "node.words",
          [sessions_core::jstr("limitShownNotice"), l, sessions_core::jstr(message)],
          fn(ex_w : effect::Exit[base_codec::Json]) -> Unit {
            match ex_w {
              effect::Exit::Succeeded(v) => post_failed(effect::Exit::Succeeded(str_or(sessions_core::str_of(Some(v)), "")))
              effect::Exit::Failed(e) => post_failed(effect::Exit::Failed(e))
              effect::Exit::Interrupted => post_failed(effect::Exit::Interrupted)
            }
          },
        )
      }
      None => {
        let is_codex_retried = match turn {
          Some(t) => t.codex_retried
          None => false
        }
        if a.runtime == "codex" && is_codex_retried && too_old {
          self.rpc_k(
            a.key,
            "node.words",
            [sessions_core::jstr("codexStillOld"), sessions_core::jstr(message)],
            fn(ex_w : effect::Exit[base_codec::Json]) -> Unit {
              match ex_w {
                effect::Exit::Succeeded(v) => post_failed(effect::Exit::Succeeded(str_or(sessions_core::str_of(Some(v)), "")))
                effect::Exit::Failed(e) => post_failed(effect::Exit::Failed(e))
                effect::Exit::Interrupted => post_failed(effect::Exit::Interrupted)
              }
            },
          )
        } else {
          self.failure_notice_k(a, outcome, post_failed)
        }
      }
    }
    return
  }
  if kind == "aborted" {
    a.nudges = 0
    if stop_requested {
      self.stop_background_k(a, fn(ex_sb : effect::Exit[Unit]) -> Unit {
        match ex_sb {
          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
          effect::Exit::Succeeded(_) => {
            self.t_k(a, "station.notice.stopped", base_codec::json_null(), fn(
              ex_t : effect::Exit[String],
            ) -> Unit {
              match ex_t {
                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                effect::Exit::Succeeded(msg) => {
                  self.notice_k(
                    a,
                    msg,
                    base_codec::json_null(),
                    base_codec::json_null(),
                    base_codec::json_null(),
                    None,
                    false,
                    after_outcome_notice,
                  )
                }
              }
            })
          }
        }
      })
      return
    }
  }
  after_outcome_notice(effect::Exit::Succeeded(()))
}

fn ActorsGen::on_turn_ended_finalize_k(
  self : ActorsGen,
  a : Actor,
  turn : Option[Turn],
  kind : String,
  message : String,
  stop_requested : Bool,
  kept_wait : Option[Double],
  warm : Bool,
  retry : Option[base_codec::Json],
  ends : Option[base_codec::Json],
  recorded : Option[String],
  lost_bool : Bool,
  unheard_tools : Bool,
  finish : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  let after_stands_and_settled = fn(ex_ss : effect::Exit[Unit]) -> Unit {
    match ex_ss {
      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
      effect::Exit::Succeeded(_) => {
        self.archived_k(a, fn(ex_ar : effect::Exit[Bool]) -> Unit {
          match ex_ar {
            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
            effect::Exit::Succeeded(true) => {
              a.deferred_end = None
              self.cool_k(a, warm, fn(ex_c : effect::Exit[Unit]) -> Unit {
                match ex_c {
                  effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(_) => {
                    self.let_go_k(a, fn(ex_lg : effect::Exit[Unit]) -> Unit {
                      match ex_lg {
                        effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                        effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                        effect::Exit::Succeeded(_) => {
                          self.deps_k(a, "idle", [sessions_core::jstr(a.key)], fn(
                            ex_id : effect::Exit[base_codec::Json],
                          ) -> Unit {
                            match ex_id {
                              effect::Exit::Succeeded(_) => finish(effect::Exit::Succeeded(()))
                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                            }
                          })
                        }
                      }
                    })
                  }
                }
              })
            }
            effect::Exit::Succeeded(false) => {
              let after_compact_cap = fn(compacted : Bool) -> Unit {
                if compacted {
                  self.cool_k(a, warm, finish)
                  return
                }
                self.has_pending_k(a, fn(ex_hp : effect::Exit[Bool]) -> Unit {
                  match ex_hp {
                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(true) => {
                      self.pump_k(a, -1, fn(ex_p : effect::Exit[Unit]) -> Unit {
                        match ex_p {
                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(_) => self.cool_k(a, warm, finish)
                        }
                      })
                    }
                    effect::Exit::Succeeded(false) => {
                      if a.notices.length() > 0 {
                        self.give_notices_k(a, fn(ex_gn : effect::Exit[Unit]) -> Unit {
                          match ex_gn {
                            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                            effect::Exit::Succeeded(_) => self.cool_k(a, warm, finish)
                          }
                        })
                        return
                      }
                      let declared = match turn {
                        Some(t) => t.declared
                        None => None
                      }
                      if opt_str_is(kind_of(ends), "waiting") {
                        a.nudges = 0
                        let start_wait = fn() -> Unit {
                          let secs = match ends {
                            Some(ev) => num_or(sessions_core::num_of(sessions_core::jget(ev, "seconds")), 0.0)
                            None => 0.0
                          }
                          self.wait_ms(a, secs, secs * 1000.0)
                          self.deps_k(a, "idle", [sessions_core::jstr(a.key)], fn(
                            ex_id : effect::Exit[base_codec::Json],
                          ) -> Unit {
                            match ex_id {
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                              effect::Exit::Succeeded(_) => {
                                if a.stale {
                                  self.catch_up_k(a, !is_some(a.waiting), finish)
                                } else {
                                  finish(effect::Exit::Succeeded(()))
                                }
                              }
                            }
                          })
                        }
                        if !is_some(retry) && a.stopped.length() > 0 {
                          self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
                            match ex_h {
                              effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                              effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                              effect::Exit::Succeeded(false) => {
                                self.log(
                                  a,
                                  "info",
                                  "its background work ended with its process while it waits; going on now",
                                  [("stopped", sessions_core::jint(a.stopped.length()))],
                                )
                                self.words_k(a, "BACKGROUND_STOPPED_WAITING", [], fn(
                                  ex_w : effect::Exit[String],
                                ) -> Unit {
                                  match ex_w {
                                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                    effect::Exit::Succeeded(words) => {
                                      self.start_turn_k(
                                        a,
                                        "resume",
                                        words,
                                        turn_for_nobody(),
                                        None,
                                        false,
                                        0,
                                        true,
                                        finish,
                                      )
                                    }
                                  }
                                })
                              }
                              effect::Exit::Succeeded(true) => start_wait()
                            }
                          })
                        } else {
                          start_wait()
                        }
                        return
                      }
                      self.deps_k(a, "idle", [sessions_core::jstr(a.key)], fn(
                        ex_id : effect::Exit[base_codec::Json],
                      ) -> Unit {
                        match ex_id {
                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(_) => {
                            match kept_wait {
                              Some(seconds) => self.wait_ms(a, seconds, seconds * 1000.0)
                              None => ()
                            }
                            if kind != "completed" || is_some(declared) {
                              a.nudges = 0
                              let finish_stale = fn() -> Unit {
                                if a.stale {
                                  self.catch_up_k(a, !is_some(a.waiting), finish)
                                } else {
                                  finish(effect::Exit::Succeeded(()))
                                }
                              }
                              if kind == "completed" {
                                self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
                                  match ex_h {
                                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                    effect::Exit::Succeeded(true) => finish_stale()
                                    effect::Exit::Succeeded(false) => {
                                      self.deps_k(a, "untitled", [sessions_core::jstr(a.key)], fn(
                                        ex_un : effect::Exit[base_codec::Json],
                                      ) -> Unit {
                                        match ex_un {
                                          effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                          effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                          effect::Exit::Succeeded(uv) => {
                                            match sessions_core::str_of(Some(uv)) {
                                              Some(u) => {
                                                if !array_contains_str(a.asked_to_name, u) {
                                                  a.asked_to_name.push(u)
                                                  self.log(a, "info", "its chat has no title; asking it to name it", [
                                                    ("chat", sessions_core::jstr(u)),
                                                  ])
                                                  self.words_k(a, "nameUntitled", [sessions_core::jstr(u)], fn(
                                                    ex_w : effect::Exit[String],
                                                  ) -> Unit {
                                                    match ex_w {
                                                      effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                                      effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                                      effect::Exit::Succeeded(words) => {
                                                        self.start_turn_k(
                                                          a,
                                                          "title",
                                                          words,
                                                          turn_for_nobody(),
                                                          None,
                                                          false,
                                                          0,
                                                          false,
                                                          finish,
                                                        )
                                                      }
                                                    }
                                                  })
                                                  return
                                                }
                                              }
                                              None => ()
                                            }
                                            finish_stale()
                                          }
                                        }
                                      })
                                    }
                                  }
                                })
                              } else {
                                finish_stale()
                              }
                              return
                            }
                            self.held_k(a, fn(ex_h : effect::Exit[Bool]) -> Unit {
                              match ex_h {
                                effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                                effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                                effect::Exit::Succeeded(true) => {
                                  a.deferred_end = Some(DeferredEnd::{
                                    lost: lost_bool,
                                    unheard: unheard_tools,
                                    recorded: recorded,
                                  })
                                  self.mirror(a)
                                  finish(effect::Exit::Succeeded(()))
                                }
                                effect::Exit::Succeeded(false) => {
                                  self.continue_undeclared_end_k(a, lost_bool, unheard_tools, recorded, warm, finish)
                                }
                              }
                            })
                          }
                        }
                      })
                    }
                  }
                })
              }
              if kind == "completed" && !opt_str_is(kind_of(ends), "waiting") {
                self.compacting_to_cap_k(a, fn(ex_cc : effect::Exit[Bool]) -> Unit {
                  match ex_cc {
                    effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
                    effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
                    effect::Exit::Succeeded(c) => after_compact_cap(c)
                  }
                })
              } else {
                after_compact_cap(false)
              }
            }
          }
        })
      }
    }
  }
  match turn {
    Some(t) => {
      let ended : Option[String] = match kind_of(t.declared) {
        Some(dk) => {
          if dk == "all_done" {
            Some("all_done")
          } else if dk == "need_help" {
            Some("need_human")
          } else if is_some(retry) {
            None
          } else if kind == "failed" {
            Some("failed")
          } else if kind == "aborted" && stop_requested {
            Some("stopped")
          } else {
            None
          }
        }
        None => {
          if is_some(retry) {
            None
          } else if kind == "failed" {
            Some("failed")
          } else if kind == "aborted" && stop_requested {
            Some("stopped")
          } else {
            None
          }
        }
      }
      let with_words = fn(words : base_codec::Json) -> Unit {
        let stands : base_codec::Json = match ended {
          Some(ek) => {
            if ek == "all_done" {
              base_codec::json_obj([("kind", sessions_core::jstr("done")), ("words", words)])
            } else if ek == "need_human" {
              base_codec::json_obj([("kind", sessions_core::jstr("need")), ("words", words)])
            } else {
              base_codec::json_null()
            }
          }
          None => base_codec::json_null()
        }
        let ended_for_snap = a.ended_for
        let mut idx = 0
        sessions_core::iter_sync_k(
          fn(sk : (effect::Exit[sessions_core::IterStep]) -> Unit) -> Unit {
            if idx >= ended_for_snap.length() {
              sk(effect::Exit::Succeeded(sessions_core::IterStep::Stop))
              return
            }
            let w = ended_for_snap[idx]
            idx = idx + 1
            sessions_core::try_k(
              fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                self.store_k(
                  a,
                  "leftThread",
                  [
                    sessions_core::jstr(a.key),
                    sessions_core::jstr(w.connect),
                    sessions_core::jstr(w.channel),
                    sessions_core::jstr(w.thread_ts),
                  ],
                  tk,
                )
              },
              fn(ex_lt : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                match ex_lt {
                  effect::Exit::Interrupted => sk(effect::Exit::Interrupted)
                  effect::Exit::Failed(e) => sk(effect::Exit::Failed(e))
                  effect::Exit::Succeeded(res) => {
                    let is_left = match res {
                      Ok(base_codec::Json::Bool(true)) => true
                      _ => false
                    }
                    let at_v = if is_left {
                      base_codec::json_obj([
                        ("kind", sessions_core::jstr("left")),
                        ("words", base_codec::json_null()),
                      ])
                    } else {
                      stands
                    }
                    self.tell(
                      a.key,
                      "chat.standsAt",
                      [
                        sessions_core::jstr(w.connect),
                        sessions_core::jstr(w.channel),
                        sessions_core::jstr(w.thread_ts),
                        at_v,
                      ],
                    )
                    sk(effect::Exit::Succeeded(sessions_core::IterStep::Continue))
                  }
                }
              },
            )
          },
          fn(ex_loop : effect::Exit[Unit]) -> Unit {
            match ex_loop {
              effect::Exit::Interrupted => after_stands_and_settled(effect::Exit::Interrupted)
              effect::Exit::Failed(e) => after_stands_and_settled(effect::Exit::Failed(e))
              effect::Exit::Succeeded(_) => {
                match (ended, kept_wait) {
                  (Some(e_str), None) => {
                    sessions_core::try_k(
                      fn(tk : (effect::Exit[base_codec::Json]) -> Unit) -> Unit {
                        self.deps_k(a, "settled", [sessions_core::jstr(a.key), sessions_core::jstr(e_str), words], tk)
                      },
                      fn(ex_s : effect::Exit[Result[base_codec::Json, effect::EffectError]]) -> Unit {
                        match ex_s {
                          effect::Exit::Interrupted => after_stands_and_settled(effect::Exit::Interrupted)
                          effect::Exit::Failed(e) => after_stands_and_settled(effect::Exit::Failed(e))
                          effect::Exit::Succeeded(Ok(_)) => after_stands_and_settled(effect::Exit::Succeeded(()))
                          effect::Exit::Succeeded(Err(err)) => {
                            self.log(a, "warn", "the opener of its chat was not told", [
                              ("error", sessions_core::jstr(sessions_core::error_message(err))),
                            ])
                            after_stands_and_settled(effect::Exit::Succeeded(()))
                          }
                        }
                      },
                    )
                  }
                  _ => after_stands_and_settled(effect::Exit::Succeeded(()))
                }
              }
            }
          },
        )
      }
      if opt_str_is(ended, "failed") {
        with_words(sessions_core::jstr(message))
      } else {
        self.last_turn_k(a, fn(ex_lt : effect::Exit[base_codec::Json]) -> Unit {
          match ex_lt {
            effect::Exit::Interrupted => finish(effect::Exit::Interrupted)
            effect::Exit::Failed(e) => finish(effect::Exit::Failed(e))
            effect::Exit::Succeeded(last) => with_words(sessions_core::field_of(last, "need"))
          }
        })
      }
    }
    None => after_stands_and_settled(effect::Exit::Succeeded(()))
  }
}
