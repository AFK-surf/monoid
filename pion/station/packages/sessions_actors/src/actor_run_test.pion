test "R9 independent: close during a notice steer issues no undo in fallback mode" {
  let s = r2_new()
  r3_probe_adopt(s, "turn", 1)
  let r = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "agent.steer" {
      return None
    }
    if f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"method\":\"notify\",\"args\":[\"notice\"]}", s.disp)
  s.drive(r)
  let mut rid = 0
  for i in 0..<s.rpcs.length() {
    let (id, f, _) = s.rpcs[i]
    if f == "agent.steer" {
      rid = id
    }
  }
  assert_run(rid != 0, "notify did not dispatch agent.steer")
  s.actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"close\"}", s.disp)
  s.drive(r)
  s.actors.heard("{\"answer\":" + rid.to_string() + ",\"value\":false}", s.disp)
  s.drive(r)
  for i in 0..<s.rpcs.length() {
    let (_, f, _) = s.rpcs[i]
    assert_run(f != "store.markDelivered" && f != "store.markUndelivered", "unexpected delivery RPC " + f)
  }
  assert_run(s.actors.host.hub_asked.length() == 0 && s.actors.current.gen.counters.active == 0, "all settled")
}

test "R9 independent: timer refill needs undo after snapshot returns" {
  let s = r2_new()
  s.actors.heard(
    "{\"call\":100,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"adopt\",\"args\":[{\"runtime\":\"claude\",\"refillMs\":1},{\"handle\":1,\"generation\":1},null,{\"runtime\":\"claude\"}]}",
    s.disp,
  )
  let mut busy_calls = 0
  let mut delivered = false
  let respond = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "agent.steer" {
      return None
    }
    if f == "agent.busy" {
      busy_calls = busy_calls + 1
      return Some(Ok(sessions_core::jbool(busy_calls > 1)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("pending", base_codec::json_arr([base_codec::json_obj([("handed", sessions_core::jstr("m"))])])),
            ("text", sessions_core::jstr("hello")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "store.markDelivered" {
      delivered = true
    }
    if f == "store.markUndelivered" {
      delivered = false
    }
    Some(Ok(base_codec::json_null()))
  }
  s.drive(respond)
  assert_run(s.timers.length() > 0, "refill timer not armed")
  let (id, _) = s.timers[0]
  s.actors.heard("{\"due\":" + id.to_string() + "}", s.disp)
  s.drive(respond)
  let mut rid = 0
  for i in 0..<s.rpcs.length() {
    let (id, f, _) = s.rpcs[i]
    if f == "agent.steer" {
      rid = id
    }
  }
  assert_run(rid != 0 && delivered, "did not reach steer window")
  s.actors.heard("{\"call\":9,\"actor\":\"s1\",\"method\":\"snapshot\"}", s.disp)
  s.drive(respond)
  let mut snapshot_returned = false
  for i in 0..<s.returned.length() {
    if sessions_core::int_of(sessions_core::jget(s.returned[i], "returned")) == 9 {
      snapshot_returned = true
    }
  }
  assert_run(snapshot_returned && !s.has_rpc("store.markUndelivered"), "snapshot must precede undo")
  s.actors.heard("{\"answer\":" + rid.to_string() + ",\"value\":false}", s.disp)
  s.drive(respond)
  assert_run(!delivered, "snapshot before negative steer ACK must still give message back")
}

test "R10 review: snapshot after a committed cold mark before its receipt restores the unsent input" {
  let s = r2_new()
  let mut marked = false
  let mut rid = 0
  let mut mark_batch_id = 0
  let mut undo_batch_id = 0
  let r = fn(f : String, args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(!marked)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("pending", base_codec::json_arr([base_codec::json_obj([("handed", sessions_core::jstr("m"))])])),
            ("text", sessions_core::jstr("hello")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "node.open" {
      return Some(Ok(base_codec::json_obj([("handle", sessions_core::jint(4)), ("generation", sessions_core::jint(1))])))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn")))
    }
    if f == "store.markDelivered" {
      assert_run(args.length() == 3, "provisional cold markDelivered must carry batch_id")
      mark_batch_id = sessions_core::int_of(Some(args[2]))
      marked = true
      return None
    }
    if f == "store.markUndelivered" {
      assert_run(args.length() == 3, "provisional cold markUndelivered must carry batch_id")
      undo_batch_id = sessions_core::int_of(Some(args[2]))
      marked = false
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\"}", s.disp)
  s.drive(r)
  for i in 0..<s.rpcs.length() {
    let (id, f, _) = s.rpcs[i]
    if f == "store.markDelivered" {
      rid = id
    }
  }
  assert_run(rid != 0 && marked && mark_batch_id > 0, "cold path never reached provisional mark")
  s.actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"snapshot\"}", s.disp)
  s.drive(r)
  s.actors.heard("{\"answer\":" + rid.to_string() + ",\"value\":1}", s.disp)
  s.drive(r)
  assert_run(s.returned.length() == 2 && s.actors.host.hub_asked.length() == 0, "call or RPC still pending")
  assert_run(!s.has_rpc("agent.prompt") && !s.has_rpc("agent.steer"), "runtime unexpectedly received input")
  assert_run(!marked && undo_batch_id == mark_batch_id, "cold mark compensation must match batch_id")
}

test "R10 review: busy changes while starting and the final delivery mark follows acceptance" {
  let s = r2_new()
  let mut marked = false
  let mut busy_calls = 0
  let mut accepted = false
  let mut mark_argc = 0
  let r = fn(f : String, args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "agent.busy" {
      busy_calls = busy_calls + 1
      return Some(Ok(sessions_core::jbool(busy_calls > 1)))
    }
    if f == "agent.steer" {
      accepted = true
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(!marked)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("pending", base_codec::json_arr([base_codec::json_obj([("handed", sessions_core::jstr("m"))])])),
            ("text", sessions_core::jstr("hello")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "node.open" {
      return Some(Ok(base_codec::json_obj([("handle", sessions_core::jint(4)), ("generation", sessions_core::jint(1))])))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn")))
    }
    if f == "store.markDelivered" {
      assert_run(accepted, "unexpected provisional mark before steer")
      mark_argc = args.length()
      marked = true
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "store.markUndelivered" {
      marked = false
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard(
    "{\"call\":100,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"adopt\",\"args\":[{\"runtime\":\"claude\"},{\"handle\":4,\"generation\":1},null,{\"runtime\":\"claude\"}]}",
    s.disp,
  )
  s.drive(r)
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\"}", s.disp)
  s.drive(r)
  assert_run(marked && accepted && mark_argc == 2 && !s.has_rpc("agent.prompt") && !s.has_rpc("store.markUndelivered"), "final mark trace must use 2 args")
  assert_run(s.returned.length() == 2 && s.actors.host.hub_asked.length() == 0, "kick did not settle")
}

test "R10 review: stopped open sends a final mark without a runtime settlement" {
  let s = r2_new()
  let mut pending_left = true
  let mut mark_argc = 0
  let responder = fn(f : String, args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.open" {
      return None
    }
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(pending_left)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            (
              "pending",
              base_codec::json_arr([
                base_codec::json_obj([
                  ("handed", sessions_core::jstr("m1")),
                  ("surface", sessions_core::jstr("stillfail")),
                ]),
              ]),
            ),
            ("text", sessions_core::jstr("hi")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "store.markDelivered" {
      mark_argc = args.length()
      pending_left = false
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "t" {
      return Some(Ok(sessions_core::jstr("Stopped")))
    }
    Some(Ok(base_codec::json_null()))
  }

  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)
  assert_run(s.has_rpc("node.open"), "node.open must be in flight")

  s.actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"stop\",\"args\":[],\"now\":1001}", s.disp)
  s.drive(responder)
  assert_run(s.has_tell_fn("node.cancelOpen"), "stop must emit node.cancelOpen")
  assert_run(s.has_rpc("store.markDelivered") && mark_argc == 2, "stop during open must send 2-arg final markDelivered")
  assert_run(s.has_rpc("node.notice"), "stop during open must emit stopped notice")
  assert_run(!s.has_rpc("agent.prompt") && !s.has_rpc("agent.steer") && !s.has_rpc("store.markUndelivered"), "stop unexpectedly produced a settlement RPC")
  assert_run(s.returned.length() == 2, "both kick and stop calls must return")
}

test "R10 review: prompt interrupted by snapshot emits store.deliverySettled with matching batch_id" {
  let s = r2_new()
  let mut marked = false
  let mut mark_batch_id = 0
  let r = fn(f : String, args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(!marked)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("pending", base_codec::json_arr([base_codec::json_obj([("handed", sessions_core::jstr("m"))])])),
            ("text", sessions_core::jstr("hello")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "node.open" {
      return Some(Ok(base_codec::json_obj([("handle", sessions_core::jint(4)), ("generation", sessions_core::jint(1))])))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn")))
    }
    if f == "store.markDelivered" {
      assert_run(args.length() == 3, "provisional prompt markDelivered must carry batch_id")
      mark_batch_id = sessions_core::int_of(Some(args[2]))
      marked = true
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "agent.prompt" {
      return None
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\"}", s.disp)
  s.drive(r)
  assert_run(marked && mark_batch_id > 0 && s.has_rpc("agent.prompt"), "did not reach prompt window")
  s.actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"snapshot\"}", s.disp)
  s.drive(r)
  let mut settled_batch_id = 0
  for i in 0..<s.tells.length() {
    let (_, fn_name, targs) = s.tells[i]
    if fn_name == "store.deliverySettled" && targs.length() == 1 {
      settled_batch_id = sessions_core::int_of(Some(targs[0]))
    }
  }
  assert_run(!s.has_rpc("store.markUndelivered"), "interrupted prompt must not markUndelivered")
  assert_run(settled_batch_id == mark_batch_id, "snapshot during prompt must emit store.deliverySettled with matching batch_id")
}

test "stop during stuck warm clears snapshotted pending messages and notifies" {
  let s = r2_new()
  let mut marked_args : Array[base_codec::Json] = []
  let responder = fn(f : String, args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.open" {
      return None
    }
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.markDelivered" {
      marked_args = args
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "t" {
      return Some(Ok(sessions_core::jstr("Stopped")))
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"warm\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)
  assert_run(s.has_rpc("node.open"), "node.open must be in flight")

  s.actors.heard(
    "{\"call\":2,\"actor\":\"s1\",\"method\":\"stop\",\"args\":[[{\"thread\":1,\"n\":2,\"apart\":false}]],\"now\":1001}",
    s.disp,
  )
  s.drive(responder)
  assert_run(s.has_tell_fn("node.cancelOpen"), "stop must cancel warm open")
  assert_run(s.has_rpc("store.markDelivered") && marked_args.length() == 2, "stop during warm must mark snapshotted handed")
  assert_run(s.has_rpc("store.notify"), "stop during warm must notify store")
  assert_run(s.has_rpc("node.notice"), "stop during warm must post stopped notice")
  assert_run(s.returned.length() == 2, "both warm and stop must return")
}

test "stop with only failed_handed and !was_queued keeps pending messages for retry" {
  let s = r2_new()
  let mut mark_calls = 0
  let mut notice_calls = 0
  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.open" {
      return Some(Err(base_codec::json_obj([("message", sessions_core::jstr("boom"))])))
    }
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            (
              "pending",
              base_codec::json_arr([
                base_codec::json_obj([
                  ("handed", base_codec::json_obj([("thread", sessions_core::jint(1)), ("n", sessions_core::jint(2)), ("apart", sessions_core::jbool(false))])),
                  ("surface", sessions_core::jstr("stillfail")),
                ]),
              ]),
            ),
            ("text", sessions_core::jstr("hello")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "node.words" {
      return Some(Ok(sessions_core::jstr("cannot start")))
    }
    if f == "store.markDelivered" {
      mark_calls = mark_calls + 1
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "node.notice" {
      notice_calls = notice_calls + 1
      return Some(Ok(base_codec::json_null()))
    }
    if f == "t" {
      return Some(Ok(sessions_core::jstr("Stopped")))
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)
  assert_run(mark_calls == 0 && notice_calls == 1, "failed start must record failed_handed without marking delivered")

  notice_calls = 0
  s.actors.heard(
    "{\"call\":2,\"actor\":\"s1\",\"method\":\"stop\",\"args\":[[{\"thread\":1,\"n\":2,\"apart\":false}]],\"now\":1001}",
    s.disp,
  )
  s.drive(responder)
  assert_run(mark_calls == 0, "stop after failed start must not mark delivered")
  assert_run(notice_calls == 0, "stop after failed start must not post stopped notice")
  assert_run(s.returned.length() == 2, "both kick and stop must return")
}

test "stop when markDelivered returns 0 skips notify and stopped notice" {
  let s = r2_new()
  let mut notify_after_mark = false
  let mut mark_called = false
  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.open" {
      return None
    }
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.markDelivered" {
      mark_called = true
      return Some(Ok(sessions_core::jint(0)))
    }
    if f == "store.notify" && mark_called {
      notify_after_mark = true
      return Some(Ok(base_codec::json_null()))
    }
    if f == "t" {
      return Some(Ok(sessions_core::jstr("Stopped")))
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"warm\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)
  assert_run(s.has_rpc("node.open"), "node.open must be in flight")

  s.actors.heard(
    "{\"call\":2,\"actor\":\"s1\",\"method\":\"stop\",\"args\":[[{\"thread\":1,\"n\":2,\"apart\":false}]],\"now\":1001}",
    s.disp,
  )
  s.drive(responder)
  assert_run(mark_called, "stop_pending must call markDelivered")
  assert_run(!notify_after_mark, "already-delivered race must skip store.notify")
  assert_run(!s.has_rpc("node.notice"), "already-delivered race must skip stopped notice")
  assert_run(s.returned.length() == 2, "both warm and stop must return")
}

test "stop during kick pendingAndFormat keeps pending messages when was_starting_turn is true" {
  let s = r2_new()
  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.pendingAndFormat" {
      return None
    }
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "t" {
      return Some(Ok(sessions_core::jstr("Stopped")))
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)
  assert_run(s.has_rpc("node.pendingAndFormat"), "pendingAndFormat must be in flight")

  s.actors.heard(
    "{\"call\":2,\"actor\":\"s1\",\"method\":\"stop\",\"args\":[[{\"thread\":1,\"n\":2,\"apart\":false}]],\"now\":1001}",
    s.disp,
  )
  s.drive(responder)
  assert_run(!s.has_rpc("store.markDelivered"), "stop during kick pendingAndFormat must not mark delivered")
  assert_run(!s.has_rpc("node.notice"), "stop during kick pendingAndFormat must not post stopped notice")
}

fn d103_logged(s : NodeScript, message : String) -> Bool {
  for i in 0..<s.tells.length() {
    let (_, t, args) = s.tells[i]
    if t == "log" && args.length() > 1 {
      match sessions_core::str_of(Some(args[1])) {
        Some(m) => {
          if m == message {
            return true
          }
        }
        None => ()
      }
    }
  }
  false
}

fn d103_count(s : NodeScript, fn_name : String) -> Int {
  let mut n = 0
  for i in 0..<s.rpcs.length() {
    let (_, f, _) = s.rpcs[i]
    if f == fn_name {
      n = n + 1
    }
  }
  n
}

fn d103_prompted(s : NodeScript, parts : Array[String]) -> Bool {
  for i in 0..<s.rpcs.length() {
    let (_, f, args) = s.rpcs[i]
    if f == "agent.prompt" {
      let text = base_codec::json_stringify(base_codec::json_arr(args))
      let mut all = true
      for j in 0..<parts.length() {
        if !text.contains(parts[j]) {
          all = false
        }
      }
      if all {
        return true
      }
    }
  }
  false
}

test "d103: notices refused by the account concurrency cap stay queued, gather, and are given once woken" {
  let s = r2_new()
  let a = s.actors.actor("s3", "claude")
  let mut capped = true
  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "deps.held" || f == "store.hasPending" || f == "agent.busy" || f == "agent.holding" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "node.open" {
      if capped {
        return Some(
          Err(
            base_codec::json_obj([
              ("message", sessions_core::jstr("account reached concurrency cap (2/2)")),
              ("sessionCap", sessions_core::jbool(true)),
              ("profile", sessions_core::jstr("cc")),
              ("active", sessions_core::jint(2)),
              ("cap", sessions_core::jint(2)),
            ]),
          ),
        )
      }
      return Some(
        Ok(
          base_codec::json_obj([
            ("handle", sessions_core::jint(3)),
            ("generation", sessions_core::jint(2)),
            ("runtime", sessions_core::jstr("claude")),
            ("profile", sessions_core::jstr("cc")),
            ("identity", base_codec::json_obj([])),
          ]),
        ),
      )
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn-s3")))
    }
    Some(Ok(base_codec::json_null()))
  }

  // A notice while 2/2 run: queued by the cap, said once, logged as no failure.
  s.actors.heard("{\"call\":1,\"actor\":\"s3\",\"method\":\"notify\",\"args\":[\"background job A finished\"],\"now\":1001}", s.disp)
  s.drive(responder)
  assert_run(a.paused_cap, "a notice refused by the cap must leave it waiting in cap_wait_queue")
  assert_run(s.actors.current.gen.resources.cap_wait_queue.length() == 1, "queued once")
  assert_run(!is_some(a.queued_retry), "a notice turn is not a queued_retry: its notices are kept instead")
  assert_run(a.notices.length() >= 1, "the notice must be kept")
  assert_run(d103_logged(s, "session queued by account concurrency cap"), "the queue must be logged")
  assert_run(!d103_logged(s, "session task failed"), "a cap queue must not be logged as a failed task")
  let opens = d103_count(s, "node.open")

  // Another while it waits: kept, no start tried for it.
  s.actors.heard("{\"call\":2,\"actor\":\"s3\",\"method\":\"notify\",\"args\":[\"background job B finished\"],\"now\":1002}", s.disp)
  s.drive(responder)
  assert_run(
    d103_count(s, "node.open") == opens,
    "a notice while queued by the cap must not try to open again",
  )
  assert_run(a.paused_cap, "still waiting")

  // A slot frees: woken with both notices in one job turn.
  capped = false
  s.actors.heard("{\"drainCapQueue\":true,\"now\":3000}", s.disp)
  s.drive(responder)
  assert_run(!a.paused_cap, "woken")
  assert_run(s.actors.current.gen.resources.cap_wait_queue.length() == 0, "cap_wait_queue must be empty")
  assert_run(d103_prompted(s, ["background job A finished", "background job B finished"]), "both notices must be given in the woken turn")
  assert_run(!d103_logged(s, "session task failed"), "no failed task logged")
}

test "d103: a turn of its own refused by the account concurrency cap is kept as queued_retry and resumed once woken" {
  let s = r2_new()
  let a = s.actors.actor("s3", "claude")
  let mut capped = true
  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "deps.held" || f == "store.hasPending" || f == "agent.busy" || f == "agent.holding" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "node.open" {
      if capped {
        return Some(
          Err(
            base_codec::json_obj([
              ("message", sessions_core::jstr("account reached concurrency cap (2/2)")),
              ("sessionCap", sessions_core::jbool(true)),
              ("profile", sessions_core::jstr("cc")),
              ("active", sessions_core::jint(2)),
              ("cap", sessions_core::jint(2)),
            ]),
          ),
        )
      }
      return Some(
        Ok(
          base_codec::json_obj([
            ("handle", sessions_core::jint(3)),
            ("generation", sessions_core::jint(2)),
            ("runtime", sessions_core::jstr("claude")),
            ("profile", sessions_core::jstr("cc")),
            ("identity", base_codec::json_obj([])),
          ]),
        ),
      )
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn-s3")))
    }
    Some(Ok(base_codec::json_null()))
  }
  let cur = s.actors.current
  cur.spawn_work(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cur.enqueue_k(
      a,
      fn(tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        cur.start_turn_k(a, "resume", "RESUME_AFTER_RESTART_WORDS", turn_for_nobody(), None, false, 0, true, tk)
      },
      k,
    )
  })
  s.drive(responder)
  assert_run(a.paused_cap, "the resume must wait in cap_wait_queue")
  match a.queued_retry {
    Some(r) => assert_run(r.kind == "resume" && r.text == "RESUME_AFTER_RESTART_WORDS" && r.fresh, "kept as it was asked")
    None => panic("a turn of its own refused by the cap must be kept as queued_retry")
  }
  assert_run(!d103_logged(s, "session task failed"), "a cap queue must not be logged as a failed task")

  capped = false
  s.actors.heard("{\"drainCapQueue\":true,\"now\":3000}", s.disp)
  s.drive(responder)
  assert_run(!a.paused_cap && !is_some(a.queued_retry), "woken and its retry taken")
  assert_run(d103_prompted(s, ["RESUME_AFTER_RESTART_WORDS"]), "the resume must be given once woken")
}

test "runChanged updates actor runtime and mirrors when no live agent is open, and preserves live agent runtime" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)

  let mut open_id = 0
  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.open" {
      return None
    }
    if f == "deps.held" || f == "store.getSession" || f == "store.hasPending" || f == "agent.holding" || f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    Some(Ok(base_codec::json_null()))
  }

  // Start `warm` as `claude`; `node.open` stays in flight while `takeAcross` fires `runChanged` -> `agy`.
  actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"warm\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)
  for i in 0..<s.rpcs.length() {
    let (id, f, _) = s.rpcs[i]
    if f == "node.open" {
      open_id = id
    }
  }
  assert_run(open_id > 0, "expected in-flight node.open")

  // `runChanged` arrives while `node.open` is in flight (`a.agent` is still `None`).
  // Note `runChanged` queues behind `warm` in the actor pump, or runs when idle before `open`:
  // test both an idle actor `s2` and `s1` completing `open` + `runChanged`.
  actors.heard(
    "{\"call\":2,\"actor\":\"s2\",\"runtime\":\"claude\",\"method\":\"runChanged\",\"args\":[\"switched\",{\"now\":{\"runtime\":\"agy\"}}],\"now\":1005}",
    s.disp,
  )
  s.drive(responder)
  let a2 = get_actor(actors, "s2")
  assert_run(a2.runtime == "agy", "idle actor runtime must update to agy on runChanged")

  // Complete `node.open` on `s1` with `runtime: "agy"` and queue `runChanged` right behind it.
  actors.heard(
    "{\"call\":3,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"runChanged\",\"args\":[\"switched\",{\"now\":{\"runtime\":\"agy\"}}],\"now\":1006}",
    s.disp,
  )
  let open_ans = base_codec::json_obj([
    ("answer", sessions_core::jint(open_id)),
    (
      "value",
      base_codec::json_obj([
        ("handle", sessions_core::jint(5)),
        ("generation", sessions_core::jint(1)),
        ("runtime", sessions_core::jstr("agy")),
        ("profile", sessions_core::jstr("ag")),
        ("identity", base_codec::json_obj([("runtime", sessions_core::jstr("agy"))])),
      ]),
    ),
    ("now", sessions_core::jnum(1010.0)),
  ])
  actors.heard(base_codec::json_stringify(open_ans), s.disp)
  s.drive(responder)

  let a1 = get_actor(actors, "s1")
  assert_run(a1.runtime == "agy", "s1 runtime must be agy after cross-runtime open")

  // While a live `agy` agent is open (`a1.agent` is `Some`), a `runChanged` to `claude` must keep `a1.runtime == "agy"`
  // until the live `agy` process is actually closed/replaced.
  actors.heard(
    "{\"call\":4,\"actor\":\"s1\",\"method\":\"runChanged\",\"args\":[\"configured\",{\"now\":{\"runtime\":\"claude\"}}],\"now\":1020}",
    s.disp,
  )
  s.drive(responder)
  assert_run(a1.runtime == "agy", "live agent runtime must stay agy while process is open")

  let snap = actors.current.snapshot(a1)
  assert_run(sessions_core::text_of(snap, "runtime") == "agy", "snapshot must export live agent runtime agy")
  assert_run(actors.current.gen.counters.active == 0, "active == 0")
  assert_run_rt_clean(host.rt)
}

test "trailing auth failure requeues unread steered message (including apart letter) and skips already-read steered message" {
  let s = r2_new()
  let mut pending_batch = 0
  let mut pending_left = true
  let mut open_calls = 0
  let mut undelivered_args : Array[base_codec::Json] = []
  let responder = fn(f : String, args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(is_some(get_actor(s.actors, "s1").turn))))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(pending_left)))
    }
    if f == "node.pendingAndFormat" {
      pending_batch = pending_batch + 1
      let handed_id = if pending_batch == 1 { "m1" } else if pending_batch == 2 { "m2-read" } else { "m3-unread" }
      let is_apart = pending_batch >= 3
      return Some(
        Ok(
          base_codec::json_obj([
            (
              "pending",
              base_codec::json_arr([
                base_codec::json_obj([
                  ("handed", sessions_core::jstr(handed_id)),
                  ("apart", sessions_core::jbool(is_apart)),
                  ("authorKind", sessions_core::jstr("person")),
                  ("person", sessions_core::jstr("ada")),
                  ("thread", sessions_core::jstr("th1")),
                  ("surface", sessions_core::jstr("stillfail")),
                ]),
              ]),
            ),
            ("text", sessions_core::jstr("msg:" + handed_id)),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "store.markDelivered" {
      pending_left = false
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "store.markUndelivered" {
      undelivered_args = args
      pending_left = true
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "agent.steer" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "node.open" {
      open_calls = open_calls + 1
      return Some(
        Ok(
          base_codec::json_obj([
            ("handle", sessions_core::jint(open_calls)),
            ("generation", sessions_core::jint(open_calls)),
            ("runtime", sessions_core::jstr("agy")),
            ("profile", sessions_core::jstr("ag")),
            ("identity", base_codec::json_obj([])),
          ]),
        ),
      )
    }
    if f == "node.withChoices" {
      return Some(Ok(base_codec::json_obj([("text", args[0]), ("told", base_codec::json_null())])))
    }
    if f == "node.prompt" || f == "node.timed" || f == "node.words" {
      return Some(Ok(args[0]))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn-" + open_calls.to_string())))
    }
    Some(Ok(base_codec::json_null()))
  }

  // Turn 1 starts on m1.
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"agy\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)
  assert_run(open_calls == 1, "first process opened")

  // m2-read is steered in and read (`phase: requesting`) BEFORE declare.
  pending_left = true
  s.actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"kick\",\"args\":[],\"now\":1010}", s.disp)
  s.drive(responder)
  s.actors.heard(
    "{\"actor\":\"s1\",\"generation\":1,\"event\":{\"type\":\"live\",\"event\":{\"kind\":\"phase\",\"phase\":\"requesting\"}},\"now\":1020}",
    s.disp,
  )
  s.drive(responder)

  // Agent declares need_help, then an unread letter (apart: true, m3-unread) is steered while trailing 401 retries.
  s.actors.heard("{\"call\":3,\"actor\":\"s1\",\"method\":\"declare\",\"args\":[{\"kind\":\"need_help\"}],\"now\":1030}", s.disp)
  s.drive(responder)
  pending_left = true
  s.actors.heard("{\"call\":4,\"actor\":\"s1\",\"method\":\"kick\",\"args\":[],\"now\":1040}", s.disp)
  s.drive(responder)

  // Trailing 401 ends Turn 1: must mark ONLY m3-unread undelivered (NOT m2-read) and open fresh process immediately.
  s.actors.heard(
    "{\"event\":{\"type\":\"turnEnded\",\"outcome\":{\"kind\":\"failed\",\"reason\":\"auth\",\"message\":\"401\"}},\"generation\":1,\"actor\":\"s1\",\"read\":null,\"now\":1050}",
    s.disp,
  )
  s.drive(responder)

  assert_run(undelivered_args.length() == 2, "expected markUndelivered call")
  let undel_str = base_codec::json_stringify(undelivered_args[1])
  assert_run(undel_str.contains("m3-unread"), "unread steered letter must be marked undelivered: " + undel_str)
  assert_run(!undel_str.contains("m2-read"), "already-read steered message must not be replayed: " + undel_str)
  assert_run(open_calls == 2, "fresh process must open immediately for requeued message")
  assert_run(s.actors.current.gen.counters.active == 0, "active == 0")
  assert_run_rt_clean(s.actors.host.rt)
}

test "apart: true letter steered after waiting clears stale declaration on requesting so mid-work 401 enters auth_retry" {
  let s = r2_new()
  let mut pending_batch = 0
  let mut pending_left = true
  let mut open_calls = 0
  let responder = fn(f : String, args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "deps.canAuthRetry" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(is_some(get_actor(s.actors, "s1").turn))))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(pending_left)))
    }
    if f == "node.pendingAndFormat" {
      pending_batch = pending_batch + 1
      let handed_id = if pending_batch == 1 { "m1" } else { "letter-apart" }
      let is_apart = pending_batch == 2
      return Some(
        Ok(
          base_codec::json_obj([
            (
              "pending",
              base_codec::json_arr([
                base_codec::json_obj([
                  ("handed", sessions_core::jstr(handed_id)),
                  ("apart", sessions_core::jbool(is_apart)),
                  ("authorKind", sessions_core::jstr("agent")),
                  ("thread", sessions_core::jstr("th1")),
                  ("surface", sessions_core::jstr("stillfail")),
                ]),
              ]),
            ),
            ("text", sessions_core::jstr("msg:" + handed_id)),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "store.markDelivered" {
      pending_left = false
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "agent.steer" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "node.open" {
      open_calls = open_calls + 1
      return Some(
        Ok(
          base_codec::json_obj([
            ("handle", sessions_core::jint(open_calls)),
            ("generation", sessions_core::jint(open_calls)),
            ("runtime", sessions_core::jstr("agy")),
            ("profile", sessions_core::jstr("ag")),
            ("identity", base_codec::json_obj([])),
          ]),
        ),
      )
    }
    if f == "node.withChoices" {
      return Some(Ok(base_codec::json_obj([("text", args[0]), ("told", base_codec::json_null())])))
    }
    if f == "node.prompt" || f == "node.timed" {
      return Some(Ok(args[0]))
    }
    if f == "node.words" {
      return Some(Ok(sessions_core::jstr("GO_ON_AFTER_AUTH_WORDS")))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn-" + open_calls.to_string())))
    }
    Some(Ok(base_codec::json_null()))
  }

  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"agy\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)
  s.actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"declare\",\"args\":[{\"kind\":\"waiting\",\"seconds\":600}],\"now\":1010}", s.disp)
  s.drive(responder)

  // Steer an `apart: true` letter, then emit `phase: requesting` (model read it and started working).
  pending_left = true
  s.actors.heard("{\"call\":3,\"actor\":\"s1\",\"method\":\"kick\",\"args\":[],\"now\":1020}", s.disp)
  s.drive(responder)
  s.actors.heard(
    "{\"actor\":\"s1\",\"generation\":1,\"event\":{\"type\":\"live\",\"event\":{\"kind\":\"phase\",\"phase\":\"requesting\"}},\"now\":1030}",
    s.disp,
  )
  s.drive(responder)

  let a = get_actor(s.actors, "s1")
  match a.turn {
    Some(t) => assert_run(!is_some(t.declared), "stale waiting declaration must be cleared after reading apart letter")
    None => panic("expected active turn before 401")
  }

  // Mid-work 401 must enter auth_retry (reopening process 2 with GO_ON_AFTER_AUTH), NOT trailing auth completion.
  s.actors.heard(
    "{\"event\":{\"type\":\"turnEnded\",\"outcome\":{\"kind\":\"failed\",\"reason\":\"auth\",\"message\":\"401\"}},\"generation\":1,\"actor\":\"s1\",\"read\":null,\"now\":1040}",
    s.disp,
  )
  s.drive(responder)

  assert_run(open_calls == 2, "mid-work 401 must open fresh process for auth_retry")
  assert_run(d103_prompted(s, ["GO_ON_AFTER_AUTH_WORDS"]), "auth_retry must prompt GO_ON_AFTER_AUTH")
  assert_run(!d103_logged(s, "trailing auth failure"), "must not classify mid-work 401 as trailing auth failure")
  assert_run(s.actors.current.gen.counters.active == 0, "active == 0")
  assert_run_rt_clean(s.actors.host.rt)
}
