// Deterministic state machine unit tests for real `ActorRunHandlers::real()` (`W8-E2`).
// Covers: normal turn lifecycle, `Exit::Interrupted` propagation, `close` with 1 in-flight RPC +
// 2 queued calls, FB-26 (Codex Bad Request reload -> afresh), FB-34 (open timeout & stop abort),
// FB-44 (auth profile failover), pure-value `ActorTimerAction` + stale timer discard across DB
// rotation, `sessionCap` pause + `drainCapQueue` wake, `snapshot`/`adopt`, and `rt.holding() == 0`.

import "base_codec"
import "effect"
import "sessions_core"
import "sql_db"

fn assert_run(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic("actor_run_test failed: " + msg)
  }
}

fn get_actor(actors : Actors, key : String) -> Actor {
  match actors.current.actors.get(key) {
    Some(a) => a
    None => panic("missing actor " + key)
  }
}

fn assert_run_rt_clean(rt : effect::Runtime) -> Unit {
  let (live_tasks, ready_tasks, timers, d, e, f) = rt.holding()
  assert_run(live_tasks == 0, "live_tasks == 0")
  assert_run(ready_tasks == 0, "ready_tasks == 0")
  assert_run(timers == 0, "timers == 0")
  assert_run(d == 0, "deferreds == 0")
  assert_run(e == 0, "events == 0")
  assert_run(f == 0, "fibers == 0")
}

/// Scripted Node RPC responder that drains stdout frames from `mem` and answers each new `{"rpc": id, "fn": ...}`.
struct NodeScript {
  pub mem : sessions_core::MemHostTransport
  pub actors : Actors
  pub disp : sessions_core::SessionDispatch
  pub mut cursor : Int
  pub rpcs : Array[(Int, String, Array[base_codec::Json])]
  pub tells : Array[(String, String, Array[base_codec::Json])]
  pub timers : Array[(Int, Double)]
  pub cancels : Array[Int]
  pub returned : Array[base_codec::Json]
  pub mut quiet_count : Int
  pub mut now : Double
}

fn NodeScript::new(
  mem : sessions_core::MemHostTransport,
  actors : Actors,
) -> NodeScript {
  NodeScript::{
    mem: mem,
    actors: actors,
    disp: sessions_core::SessionDispatch::stub(),
    cursor: 0,
    rpcs: [],
    tells: [],
    timers: [],
    cancels: [],
    returned: [],
    quiet_count: 0,
    now: 1000.0,
  }
}

fn NodeScript::drive(
  self : NodeScript,
  respond : (String, Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]],
) -> Unit {
  let mut progress = true
  while progress {
    progress = false
    self.actors.host.tick()
    while self.cursor < self.mem.stdout_lines.length() {
      let line = self.mem.stdout_lines[self.cursor]
      self.cursor = self.cursor + 1
      let msg = match sessions_core::parse_json_strict(line) {
        Ok(j) => j
        Err(e) => panic("bad stdout json: " + e)
      }
      if is_opt_json_true(sessions_core::jget(msg, "quiet")) {
        self.quiet_count = self.quiet_count + 1
      }
      match sessions_core::jget(msg, "returned") {
        Some(_) => self.returned.push(msg)
        None => ()
      }
      match (sessions_core::jget(msg, "tell"), sessions_core::str_of(sessions_core::jget(msg, "actor"))) {
        (Some(base_codec::Json::Str(t)), Some(ak)) => {
          let targs = match sessions_core::jget(msg, "args") {
            Some(base_codec::Json::Arr(xs)) => xs
            _ => []
          }
          self.tells.push((ak, t, targs))
        }
        _ => ()
      }
      match (sessions_core::jget(msg, "after"), sessions_core::jget(msg, "ms")) {
        (Some(base_codec::Json::Num(tid, _)), Some(base_codec::Json::Num(ms, _))) => {
          self.timers.push((tid.to_int(), ms))
        }
        _ => ()
      }
      match sessions_core::jget(msg, "cancel") {
        Some(base_codec::Json::Num(cid, _)) => self.cancels.push(cid.to_int())
        _ => ()
      }
      match (sessions_core::jget(msg, "rpc"), sessions_core::str_of(sessions_core::jget(msg, "fn"))) {
        (Some(base_codec::Json::Num(id_n, _)), Some(f)) => {
          let id = id_n.to_int()
          let args = match sessions_core::jget(msg, "args") {
            Some(base_codec::Json::Arr(xs)) => xs
            _ => []
          }
          self.rpcs.push((id, f, args))
          match respond(f, args) {
            Some(Ok(v)) => {
              let ans = base_codec::json_obj([
                ("answer", sessions_core::jint(id)),
                ("value", v),
                ("now", sessions_core::jnum(self.now)),
              ])
              self.actors.heard(base_codec::json_stringify(ans), self.disp)
              progress = true
            }
            Some(Err(err_j)) => {
              let ans = base_codec::json_obj([
                ("answer", sessions_core::jint(id)),
                ("error", err_j),
                ("now", sessions_core::jnum(self.now)),
              ])
              self.actors.heard(base_codec::json_stringify(ans), self.disp)
              progress = true
            }
            None => ()
          }
        }
        _ => ()
      }
    }
  }
}

fn NodeScript::has_rpc(self : NodeScript, fn_name : String) -> Bool {
  for i in 0..<self.rpcs.length() {
    let (_, f, _) = self.rpcs[i]
    if f == fn_name {
      return true
    }
  }
  false
}

fn NodeScript::has_tell_fn(self : NodeScript, tell_name : String) -> Bool {
  for i in 0..<self.tells.length() {
    let (_, t, _) = self.tells[i]
    if t == tell_name {
      return true
    }
  }
  false
}

test "actor_run: ActorRunHandlers::real_with_live has is_stub == false, real() has is_stub == true, unknown method fails with AskedError" {
  let real_no_live = ActorRunHandlers::real()
  assert_run(real_no_live.is_stub, "real() without live hooks must keep is_stub == true")
  let real = ActorRunHandlers::real_with_live(ActorLiveHooks::noop())
  assert_run(!real.is_stub, "real_with_live().is_stub must be false")

  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", real, no_store_db)
  let s = NodeScript::new(mem, actors)

  actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"noSuchMethod\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(fn(_f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    Some(Ok(base_codec::json_null()))
  })

  assert_run(s.returned.length() == 1, "expected 1 returned frame")
  assert_run(
    sessions_core::text_of(s.returned[0], "error") == "no actor method noSuchMethod",
    "expected AskedError message, got: " + sessions_core::text_of(s.returned[0], "error"),
  )
  assert_run(actors.current.gen.counters.active == 0, "active == 0")
  assert_run_rt_clean(host.rt)
}

test "actor_run: normal turn lifecycle (kick -> open -> prompt -> declare all_done -> turnEnded -> idle)" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)
  let mut pending_left = true

  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(pending_left)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            (
              "pending",
              base_codec::json_arr([
                base_codec::json_obj([
                  ("handed", sessions_core::jstr("m1")),
                  ("authorKind", sessions_core::jstr("person")),
                  ("person", sessions_core::jstr("alice")),
                  ("thread", sessions_core::jstr("th1")),
                  ("surface", sessions_core::jstr("stillfail")),
                ]),
              ]),
            ),
            ("text", sessions_core::jstr("hello")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "node.open" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("handle", sessions_core::jint(7)),
            ("generation", sessions_core::jint(1)),
            ("runtime", sessions_core::jstr("claude")),
            ("profile", sessions_core::jstr("prof-1")),
            ("identity", base_codec::json_obj([("model", sessions_core::jstr("opus"))])),
          ]),
        ),
      )
    }
    if f == "node.withChoices" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("text", sessions_core::jstr("hello")),
            ("told", base_codec::json_null()),
          ]),
        ),
      )
    }
    if f == "node.prompt" {
      return Some(Ok(sessions_core::jstr("prompt:hello")))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn-1")))
    }
    if f == "store.markDelivered" {
      pending_left = false
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "node.words" {
      return Some(Ok(sessions_core::jstr("WORDS")))
    }
    Some(Ok(base_codec::json_null()))
  }

  actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)

  let a = get_actor(actors, "s1")
  assert_run(is_some(a.turn), "turn should be active after kick")
  assert_run(a.phase == "running", "phase should be running")
  assert_run(s.has_rpc("node.open"), "expected node.open")
  assert_run(s.has_rpc("agent.prompt"), "expected agent.prompt")
  assert_run(s.has_tell_fn("node.tasks"), "expected node.tasks tell")

  // Declare all_done
  actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"declare\",\"args\":[{\"kind\":\"all_done\"}],\"now\":1100}", s.disp)
  s.drive(responder)

  // End turn
  s.now = 1200.0
  actors.heard("{\"event\":{\"type\":\"turnEnded\",\"outcome\":{\"kind\":\"completed\"}},\"generation\":1,\"actor\":\"s1\",\"read\":null,\"now\":1200}", s.disp)
  s.drive(responder)

  assert_run(!is_some(a.turn), "turn should be cleared after turnEnded")
  assert_run(a.phase == "idle", "phase should be idle")
  assert_run(s.has_rpc("store.endTurn"), "expected store.endTurn")
  assert_run(s.has_rpc("deps.settled"), "expected deps.settled")
  assert_run(s.has_rpc("deps.idle"), "expected deps.idle")
  assert_run(actors.current.gen.counters.active == 0, "active == 0")
  assert_run_rt_clean(host.rt)
}

test "actor_run: close with 1 in-flight node.open RPC + 2 queued calls settles all cleanly (active == 0, quiet once)" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)

  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.open" {
      // Leave node.open in flight!
      return None
    }
    if f == "deps.held" || f == "store.getSession" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    Some(Ok(base_codec::json_null()))
  }

  // Start warm (will suspend on node.open)
  actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"warm\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)

  let a = get_actor(actors, "s1")
  assert_run(is_some(a.opening_rpc), "opening_rpc should be set while node.open is in flight")

  // Queue 2 more calls behind warm
  actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"flushed\",\"args\":[],\"now\":1010}", s.disp)
  actors.heard("{\"call\":3,\"actor\":\"s1\",\"method\":\"flushed\",\"args\":[],\"now\":1020}", s.disp)
  s.drive(responder)
  assert_run(a.queued == 3, "expected 3 queued/running tasks before close")

  // Reset quiet count right before close
  s.quiet_count = 0

  // Close the actor: aborts opening_rpc via node.cancelOpen, skips the 2 queued calls cleanly
  actors.heard("{\"call\":4,\"actor\":\"s1\",\"method\":\"close\",\"args\":[],\"now\":1030}", s.disp)
  s.drive(responder)

  assert_run(a.phase == "closed", "phase must be closed")
  assert_run(a.queued == 0, "all queued tasks must be settled")
  assert_run(actors.current.gen.counters.active == 0, "active must be 0")
  assert_run(s.has_tell_fn("node.cancelOpen"), "expected node.cancelOpen tell")
  assert_run(s.returned.length() == 4, "all 4 calls must have returned")
  assert_run(s.quiet_count == 1, "quiet must be emitted exactly once after drain")
  assert_run_rt_clean(host.rt)
}

test "actor_run: FB-34 open timeout fires without deadlocking serial pump and emits node.cancelOpen" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)

  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.open" {
      return None
    }
    if f == "deps.held" || f == "store.getSession" || f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "t" {
      return Some(Ok(sessions_core::jstr("open timed out")))
    }
    Some(Ok(base_codec::json_null()))
  }

  actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"warm\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)

  assert_run(s.timers.length() == 1, "expected 1 open timeout timer")
  let (tid, ms) = s.timers[0]
  assert_run(ms == OPEN_TIMEOUT_MS, "expected OPEN_TIMEOUT_MS")

  // Fire the open timeout timer while warm is still blocked in serial pump!
  s.now = 121000.0
  actors.heard("{\"due\":" + tid.to_string() + ",\"now\":121000}", s.disp)
  s.drive(responder)

  assert_run(s.has_tell_fn("node.cancelOpen"), "expected node.cancelOpen on timeout")
  assert_run(s.returned.length() == 1, "warm call must finish after timeout")
  assert_run(actors.current.gen.counters.active == 0, "active == 0")
  assert_run_rt_clean(host.rt)
}

test "actor_run: FB-44 open_over retries on next profile when node.open fails with auth:true" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)
  let mut open_calls = 0

  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(open_calls == 0)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("pending", base_codec::json_arr([base_codec::json_obj([("handed", sessions_core::jstr("m1")), ("surface", sessions_core::jstr("stillfail"))])])),
            ("text", sessions_core::jstr("hi")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "node.open" {
      open_calls = open_calls + 1
      if open_calls == 1 {
        return Some(
          Err(
            base_codec::json_obj([
              ("auth", sessions_core::jbool(true)),
              ("authProfile", sessions_core::jstr("prof-bad")),
              ("message", sessions_core::jstr("login over")),
            ]),
          ),
        )
      }
      return Some(
        Ok(
          base_codec::json_obj([
            ("handle", sessions_core::jint(9)),
            ("generation", sessions_core::jint(1)),
            ("runtime", sessions_core::jstr("claude")),
            ("profile", sessions_core::jstr("prof-good")),
            ("identity", base_codec::json_obj([])),
          ]),
        ),
      )
    }
    if f == "deps.canAuthRetry" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "node.withChoices" {
      return Some(Ok(base_codec::json_obj([("text", sessions_core::jstr("hi")), ("told", base_codec::json_null())])))
    }
    if f == "node.prompt" {
      return Some(Ok(sessions_core::jstr("hi")))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn-fb44")))
    }
    Some(Ok(base_codec::json_null()))
  }

  actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)

  let a = get_actor(actors, "s1")
  assert_run(open_calls == 2, "expected 2 node.open calls (failover)")
  assert_run(s.has_rpc("deps.recheck"), "expected deps.recheck")
  assert_run(s.has_rpc("deps.canAuthRetry"), "expected deps.canAuthRetry")
  assert_run(a.auth_tried.length() == 1 && a.auth_tried[0] == "prof-bad", "expected prof-bad in auth_tried")
  assert_run(is_some(a.turn), "turn should succeed on second profile")
  assert_run_rt_clean(host.rt)
}

test "actor_run: FB-26 Codex bare Bad Request reloads rollout once, then clears afresh on second refusal" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)

  let a = actors.actor("s1", "codex")
  a.agent = Some(Agent::{ generation: 1, handle: 4 })

  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "store.lastTurn" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("outcome", sessions_core::jstr("failed")),
            ("detail", sessions_core::jstr("model: {\"detail\":\"Bad Request\"}")),
          ]),
        ),
      )
    }
    if f == "store.getSession" {
      return Some(Ok(base_codec::json_obj([("runtimeSessionId", sessions_core::jstr("codex-th-1"))])))
    }
    if f == "agent.background" {
      return Some(Ok(base_codec::json_arr([])))
    }
    if f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "t" {
      return Some(Ok(sessions_core::jstr("started afresh")))
    }
    Some(Ok(base_codec::json_null()))
  }

  // First call: reloads rollout (sets codex_reloaded = Some("codex-th-1") and disposes agent)
  let mut done1 = false
  actors.current.spawn_work(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    actors.current.refused_thread_k(a, fn(ex : effect::Exit[Unit]) -> Unit {
      done1 = true
      k(ex)
    })
  })
  s.drive(responder)
  assert_run(done1, "first refused_thread_k must complete")
  assert_run(opt_str_is(a.codex_reloaded, "codex-th-1"), "expected codex_reloaded set to thread id")
  assert_run(!is_some(a.agent), "agent must be disposed on reload")

  // Second call on same thread id: clears afresh (setRuntimeSessionId -> null, read_back -> true)
  let mut done2 = false
  actors.current.spawn_work(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    actors.current.refused_thread_k(a, fn(ex : effect::Exit[Unit]) -> Unit {
      done2 = true
      k(ex)
    })
  })
  s.drive(responder)
  assert_run(done2, "second refused_thread_k must complete")
  assert_run(!is_some(a.codex_reloaded), "codex_reloaded must reset after afresh")
  assert_run(a.read_back, "read_back must be true after afresh")
  assert_run(s.has_rpc("store.setRuntimeSessionId"), "expected setRuntimeSessionId on afresh")
  assert_run_rt_clean(host.rt)
}

test "actor_run: pure-value ActorTimerAction fires wait with context and stale timers are discarded across db rotation" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)

  let a = actors.actor("s1", "claude")
  actors.current.wait_ms(a, 60.0, 60000.0)
  s.drive(fn(_f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    Some(Ok(base_codec::json_null()))
  })
  assert_run(s.timers.length() == 1, "expected 1 wait timer")
  let (tid1, _) = s.timers[0]

  // Fire timer -> fire_wait_k checks held/archived/lastTurn and starts nudge turn
  let mut started_nudge = false
  s.now = 61000.0
  actors.heard("{\"due\":" + tid1.to_string() + ",\"now\":61000}", s.disp)
  s.drive(fn(f : String, args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "store.startTurnFor" && args.length() > 2 && opt_str_is(sessions_core::str_of(Some(args[2])), "nudge") {
      started_nudge = true
    }
    if f == "deps.held" || f == "store.getSession" || f == "store.hasSessionActiveWatch" || f == "agent.busy" || f == "agent.holding" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "node.open" {
      return Some(Ok(base_codec::json_obj([("handle", sessions_core::jint(1)), ("generation", sessions_core::jint(1)), ("runtime", sessions_core::jstr("claude"))])))
    }
    if f == "node.withChoices" {
      return Some(Ok(base_codec::json_obj([("text", sessions_core::jstr("wait over")), ("told", base_codec::json_null())])))
    }
    if f == "node.prompt" || f == "node.words" {
      return Some(Ok(sessions_core::jstr("wait over")))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn-wait")))
    }
    Some(Ok(base_codec::json_null()))
  })
  assert_run(started_nudge, "expected fire_wait_k to start nudge turn")

  // Now arm another timer and rotate generation (`{"db": null}`): firing old timer ID must be ignored!
  actors.current.wait_ms(a, 30.0, 30000.0)
  s.drive(fn(_f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    Some(Ok(base_codec::json_null()))
  })
  let (stale_tid, _) = s.timers[s.timers.length() - 1]
  actors.heard("{\"db\":null,\"now\":62000}", s.disp)
  host.tick()
  let rpcs_before = s.rpcs.length()
  actors.heard("{\"due\":" + stale_tid.to_string() + ",\"now\":92000}", s.disp)
  s.drive(fn(_f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    Some(Ok(base_codec::json_null()))
  })
  assert_run(s.rpcs.length() == rpcs_before, "stale timer from previous generation must be ignored")
  assert_run_rt_clean(host.rt)
}

test "actor_run: sessionCap pauses into cap_wait_queue and drainCapQueue wakes actor" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)
  let mut cap_full = true

  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(true)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("pending", base_codec::json_arr([base_codec::json_obj([("handed", sessions_core::jstr("m1")), ("surface", sessions_core::jstr("stillfail"))])])),
            ("text", sessions_core::jstr("go")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "node.open" {
      if cap_full {
        return Some(
          Err(
            base_codec::json_obj([
              ("sessionCap", sessions_core::jbool(true)),
              ("profile", sessions_core::jstr("prof-1")),
              ("active", sessions_core::jint(3)),
              ("cap", sessions_core::jint(3)),
              ("protection", sessions_core::jbool(false)),
            ]),
          ),
        )
      }
      return Some(
        Ok(
          base_codec::json_obj([
            ("handle", sessions_core::jint(11)),
            ("generation", sessions_core::jint(1)),
            ("runtime", sessions_core::jstr("claude")),
          ]),
        ),
      )
    }
    if f == "node.withChoices" {
      return Some(Ok(base_codec::json_obj([("text", sessions_core::jstr("go")), ("told", base_codec::json_null())])))
    }
    if f == "node.prompt" || f == "node.words" || f == "t" {
      return Some(Ok(sessions_core::jstr("msg")))
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("turn-cap")))
    }
    Some(Ok(base_codec::json_null()))
  }

  actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)

  let a = get_actor(actors, "s1")
  assert_run(a.paused_cap, "actor must be paused_cap")
  assert_run(actors.current.gen.resources.cap_wait_queue.length() == 1, "expected 1 in cap_wait_queue")

  // Release cap and drainCapQueue -> wakes s1 and starts its turn
  cap_full = false
  actors.heard("{\"drainCapQueue\":true,\"now\":1100}", s.disp)
  s.drive(responder)

  assert_run(!a.paused_cap, "paused_cap must be cleared after wake")
  assert_run(actors.current.gen.resources.cap_wait_queue.length() == 0, "cap_wait_queue must be empty")
  assert_run(is_some(a.turn), "turn must be running after cap wake")
  assert_run_rt_clean(host.rt)
}

test "actor_run: snapshot and adopt preserve turn, notices, timers and Exit::Interrupted propagates on db rotation" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  gen.counters.now = 5000.0
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)

  let a = actors.actor("s1", "claude")
  a.notices.push("job done")
  a.nudges = 2
  actors.current.wait_ms(a, 60.0, 40000.0)

  let snap = actors.current.snapshot(a)
  assert_run(a.phase == "closed", "snapshot must close old actor")

  // Adopt into a new actor key
  let a2 = actors.actor("s2", "claude")
  actors.current.adopt(
    a2,
    snap,
    base_codec::json_obj([("handle", sessions_core::jint(3)), ("generation", sessions_core::jint(2))]),
    sessions_core::jstr("prof-2"),
    base_codec::json_obj([("runtime", sessions_core::jstr("claude"))]),
  )
  assert_run(a2.notices.length() == 1 && a2.notices[0] == "job done", "notices preserved")
  assert_run(a2.nudges == 2, "nudges preserved")
  assert_run(is_some(a2.waiting), "waiting timer re-armed on adopt")

  // Start an in-flight RPC on a2 (`kick` awaits `deps.held`), then rotate DB -> must interrupt cleanly
  let mut got_interrupted = false
  let cur_gen = actors.current
  cur_gen.spawn_work(fn(wk : (effect::Exit[Unit]) -> Unit) -> Unit {
    cur_gen.called_k(a2, "kick", [], fn(ex : effect::Exit[base_codec::Json]) -> Unit {
      match ex {
        effect::Exit::Interrupted => {
          got_interrupted = true
          wk(effect::Exit::Interrupted)
        }
        effect::Exit::Failed(e) => wk(effect::Exit::Failed(e))
        effect::Exit::Succeeded(_) => wk(effect::Exit::Succeeded(()))
      }
    })
  })
  host.tick()
  actors.heard("{\"db\":null,\"now\":6000}", s.disp)
  host.tick()
  assert_run(got_interrupted, "DB rotation must propagate Exit::Interrupted to in-flight called_k")
  assert_run_rt_clean(host.rt)
}

// ── R2 Review Regression & Coverage Tests ──

fn r2_new() -> NodeScript {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  NodeScript::new(mem, actors)
}

fn r2_started(s : NodeScript) -> Bool {
  s.has_rpc("store.startTurnFor") || s.has_rpc("node.open")
}

fn r2_release_stop(deferred : Bool) -> NodeScript {
  let s = r2_new()
  let a = s.actors.actor("s1", "claude")
  if deferred {
    a.deferred_end = Some(DeferredEnd::{ lost: false, unheard: false, recorded: None })
    a.warm = true
  } else {
    a.tools_retry_deferred = true
  }
  let mut held_n = 0
  let mut held_id = 0
  let r = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "deps.held" {
      held_n = held_n + 1
      if held_n == 2 {
        return None
      }
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.hasPending" || f == "agent.busy" || f == "agent.holding" || f == "deps.coldAfresh" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "deps.maxNudges" {
      return Some(Ok(sessions_core::jint(2)))
    }
    if f == "node.words" {
      return Some(Ok(sessions_core::jstr("W")))
    }
    if f == "node.open" {
      return Some(
        Ok(
          base_codec::json_obj([
            ("handle", sessions_core::jint(1)),
            ("generation", sessions_core::jint(1)),
            ("runtime", sessions_core::jstr("claude")),
          ]),
        ),
      )
    }
    if f == "node.uuid" {
      return Some(Ok(sessions_core::jstr("t1")))
    }
    Some(Ok(base_codec::json_null()))
  }
  s.actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"release\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(r)
  for i in 0..<s.rpcs.length() {
    let (id, f, _) = s.rpcs[i]
    if f == "deps.held" {
      held_id = id
    }
  }
  assert_run(held_n == 2, "second held in flight")
  s.actors.heard("{\"call\":2,\"actor\":\"s1\",\"method\":\"stop\",\"args\":[],\"now\":1001}", s.disp)
  s.drive(r)
  s.actors.heard("{\"answer\":" + held_id.to_string() + ",\"value\":false,\"now\":1002}", s.disp)
  s.drive(r)
  s
}

test "r2 zz1: release deferred_end then stop during held must not start a turn" {
  let s = r2_release_stop(true)
  assert_run(!r2_started(s), "ZZ1 nudge turn started after stop")
}

test "r2 zz2: release tools_retry_deferred then stop during held must not start a turn" {
  let s = r2_release_stop(false)
  assert_run(!r2_started(s), "ZZ2 TOOLS_LOST turn started after stop")
}

test "r2 zz3: ensure_agent swallows a holding failure as MB catch does" {
  let s = r2_new()
  let a = s.actors.actor("s1", "claude")
  a.agent = Some(Agent::{ generation: 1, handle: 4 })
  let mut got = "none"
  s.actors.current.spawn_work(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    s.actors.current.ensure_agent_k(a, fn(ex : effect::Exit[Agent]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => got = "ok"
        effect::Exit::Failed(_) => got = "failed"
        effect::Exit::Interrupted => got = "interrupted"
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  s.drive(fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "agent.holding" {
      return Some(Err(base_codec::json_obj([("message", sessions_core::jstr("boom"))])))
    }
    Some(Ok(base_codec::json_null()))
  })
  assert_run(got == "ok", "ZZ3 got " + got)
}

test "r2 zz4: pump_steer passes Interrupted through markUndelivered" {
  let s = r2_new()
  let a = s.actors.actor("s1", "claude")
  let g = Agent::{ generation: 1, handle: 4 }
  a.agent = Some(g)
  let d = Delivery::{
    pending: [base_codec::json_obj([("handed", sessions_core::jstr("m1"))])],
    text: "x",
    widgets: base_codec::json_null(),
  }
  let cur = s.actors.current
  let mut got = "none"
  cur.spawn_work(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cur.pump_steer_k(a, g, Some(g), d, fn(ex : effect::Exit[Unit]) -> Unit {
      match ex {
        effect::Exit::Succeeded(_) => got = "ok"
        effect::Exit::Failed(_) => got = "failed"
        effect::Exit::Interrupted => got = "interrupted"
      }
      k(ex)
    })
  })
  s.drive(fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "agent.steer" {
      return Some(Err(base_codec::json_obj([("message", sessions_core::jstr("boom"))])))
    }
    if f == "store.markUndelivered" {
      return None
    }
    Some(Ok(base_codec::json_null()))
  })
  assert_run(s.has_rpc("store.markUndelivered"), "in flight")
  s.actors.heard("{\"db\":null,\"now\":6000}", s.disp)
  s.actors.host.tick()
  assert_run(got == "interrupted", "ZZ4 got " + got)
}

test "r2 zz5: stopFromSlack lastTurn failure is the task's (logged, answers null)" {
  let s = r2_new()
  s.actors.heard(
    "{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"stopFromSlack\",\"args\":[\"c\",\"ch\",\"1.0\",\"2.0\"],\"now\":1000}",
    s.disp,
  )
  s.drive(fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "store.lastTurn" {
      return Some(Err(base_codec::json_obj([("message", sessions_core::jstr("boom"))])))
    }
    Some(Ok(base_codec::json_null()))
  })
  assert_run(
    s.returned.length() == 1 && sessions_core::text_of(s.returned[0], "error") == "",
    "ZZ5 returned error",
  )
}

test "r2 review: close interleave during openTimeout t RPC stays closed" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
  let actors = Actors::new_with_store_provider(host, gen, "/", ActorRunHandlers::real(), no_store_db)
  let s = NodeScript::new(mem, actors)
  let mut parked = true
  let mut pending_left = true

  let responder = fn(f : String, _args : Array[base_codec::Json]) -> Option[Result[base_codec::Json, base_codec::Json]] {
    if f == "node.open" {
      return None
    }
    if f == "t" && parked {
      return None
    }
    if f == "deps.held" || f == "store.getSession" || f == "agent.holding" || f == "agent.busy" {
      return Some(Ok(sessions_core::jbool(false)))
    }
    if f == "store.hasPending" {
      return Some(Ok(sessions_core::jbool(pending_left)))
    }
    if f == "node.pendingAndFormat" {
      return Some(
        Ok(
          base_codec::json_obj([
            (
              "pending",
              base_codec::json_arr([
                base_codec::json_obj([
                  ("handed", sessions_core::jstr("m1")),
                  ("authorKind", sessions_core::jstr("person")),
                  ("person", sessions_core::jstr("alice")),
                  ("thread", sessions_core::jstr("th1")),
                  ("surface", sessions_core::jstr("stillfail")),
                ]),
              ]),
            ),
            ("text", sessions_core::jstr("hello")),
            ("widgets", base_codec::json_arr([])),
          ]),
        ),
      )
    }
    if f == "store.markDelivered" {
      pending_left = false
      return Some(Ok(sessions_core::jint(1)))
    }
    if f == "node.words" {
      return Some(Ok(sessions_core::jstr("WORDS")))
    }
    Some(Ok(base_codec::json_null()))
  }

  actors.heard("{\"call\":1,\"actor\":\"s1\",\"runtime\":\"claude\",\"method\":\"kick\",\"args\":[],\"now\":1000}", s.disp)
  s.drive(responder)

  let (tid, _) = s.timers[0]
  actors.heard("{\"due\":" + tid.to_string() + "}", s.disp)
  s.drive(responder)
  let a = get_actor(actors, "s1")
  let mut rid = 0
  for i in 0..<s.rpcs.length() {
    let (r, f, _) = s.rpcs[i]
    if f == "t" {
      rid = r
    }
  }
  assert_run(rid != 0, "parked RPC reached")
  actors.heard("{\"call\":20,\"actor\":\"s1\",\"method\":\"close\"}", s.disp)
  s.drive(responder)
  assert_run(a.phase == "closed", "closure took effect")
  parked = false
  actors.heard("{\"answer\":" + rid.to_string() + ",\"value\":null}", s.disp)
  s.drive(responder)
  assert_run(a.phase == "closed", "closed became " + a.phase)
}

test "r2 review: close interleave during node.withChoices stays closed" {
  let mem = sessions_core::MemHostTransport::new()
  let host = sessions_core::SessionHost::for_test(mem)
  let gen = sessions_core::HubGen::new(host, 0)
