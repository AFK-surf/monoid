// Strongly-typed port between `sessions_actors` core (`actors.pion`) and the actor state machine
// (`actor_run_{turn,agent,events,lifecycle}.pion` added in `W8-E2`), aligned with `wave8-plan.md` v5 §2.5.3.
//
// Every callback receives the immutable per-generation `ActorsGen` context (NEVER the mutable outer
// `Actors` shell), so old-generation closures can never observe a newer generation's `HubGen` or DB.

import "base_codec"
import "effect"

/// Pure-callback bridge from `sessions_actors` to `#live` (`live_event`, `live_turn_end`, `live_ended`),
/// holding zero back-references to `Actors` or `ActorsGen`.
pub struct ActorLiveHooks {
  pub live_event : (String, base_codec::Json) -> Unit
  pub live_turn_end_k : (String, (effect::Exit[Unit]) -> Unit) -> Unit
  pub live_ended_k : (Int, (effect::Exit[Unit]) -> Unit) -> Unit
}

pub fn ActorLiveHooks::noop() -> ActorLiveHooks {
  ActorLiveHooks::{
    live_event: fn(_key : String, _ev : base_codec::Json) -> Unit { () },
    live_turn_end_k: fn(_key : String, k : (effect::Exit[Unit]) -> Unit) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
    live_ended_k: fn(_n : Int, k : (effect::Exit[Unit]) -> Unit) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
  }
}

pub struct ActorRunHandlers {
  pub on_event_k : (
    ActorsGen,
    Actor,
    Int,
    base_codec::Json,
    base_codec::Json,
    (effect::Exit[Unit]) -> Unit,
  ) -> Unit
  pub called_k : (
    ActorsGen,
    Actor,
    String,
    Array[base_codec::Json],
    (effect::Exit[base_codec::Json]) -> Unit,
  ) -> Unit
  pub wake_queued_k : (ActorsGen, Actor, (effect::Exit[Unit]) -> Unit) -> Unit
  pub wake_cap_queued_k : (ActorsGen, Actor, (effect::Exit[Unit]) -> Unit) -> Unit
  pub codex_updated_k : (
    ActorsGen,
    Actor,
    Int,
    Option[String],
    (effect::Exit[Unit]) -> Unit,
  ) -> Unit
  pub on_timer_k : (
    ActorsGen,
    Actor,
    String,
    ActorTimerAction,
    (effect::Exit[Unit]) -> Unit,
  ) -> Unit
  /// `true` while stub handlers remain (`W8-F` asserts `false` on production assembly).
  pub is_stub : Bool
}

pub fn ActorRunHandlers::stub() -> ActorRunHandlers {
  ActorRunHandlers::{
    on_event_k: fn(
      _ctx : ActorsGen,
      _a : Actor,
      _generation : Int,
      _event : base_codec::Json,
      _read : base_codec::Json,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
    called_k: fn(
      _ctx : ActorsGen,
      _a : Actor,
      _method : String,
      _args : Array[base_codec::Json],
      k : (effect::Exit[base_codec::Json]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Succeeded(base_codec::json_null()))
    },
    wake_queued_k: fn(
      _ctx : ActorsGen,
      _a : Actor,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
    wake_cap_queued_k: fn(
      _ctx : ActorsGen,
      _a : Actor,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
    codex_updated_k: fn(
      _ctx : ActorsGen,
      _a : Actor,
      _id : Int,
      _why : Option[String],
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
    on_timer_k: fn(
      _ctx : ActorsGen,
      _a : Actor,
      _name : String,
      _action : ActorTimerAction,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      k(effect::Exit::Succeeded(()))
    },
    is_stub: true,
  }
}

/// Assemble real production `ActorRunHandlers` (`is_stub: false`) with `#live` hooks.
pub fn ActorRunHandlers::real_with_live(live : ActorLiveHooks) -> ActorRunHandlers {
  ActorRunHandlers::{
    on_event_k: fn(
      ctx : ActorsGen,
      a : Actor,
      generation : Int,
      event : base_codec::Json,
      read : base_codec::Json,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      ctx.live = live
      ctx.on_event_k(a, generation, event, read, k)
    },
    called_k: fn(
      ctx : ActorsGen,
      a : Actor,
      method : String,
      args : Array[base_codec::Json],
      k : (effect::Exit[base_codec::Json]) -> Unit,
    ) -> Unit {
      ctx.live = live
      ctx.called_k(a, method, args, k)
    },
    wake_queued_k: fn(
      ctx : ActorsGen,
      a : Actor,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      ctx.live = live
      ctx.wake_queued_k(a, k)
    },
    wake_cap_queued_k: fn(
      ctx : ActorsGen,
      a : Actor,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      ctx.live = live
      ctx.wake_cap_queued_k(a, k)
    },
    codex_updated_k: fn(
      ctx : ActorsGen,
      a : Actor,
      id : Int,
      why : Option[String],
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      ctx.live = live
      ctx.codex_updated_k(a, id, why, k)
    },
    on_timer_k: fn(
      ctx : ActorsGen,
      a : Actor,
      name : String,
      action : ActorTimerAction,
      k : (effect::Exit[Unit]) -> Unit,
    ) -> Unit {
      ctx.live = live
      ctx.on_timer_k(a, name, action, k)
    },
    is_stub: false,
  }
}

/// Assemble `ActorRunHandlers` without live hooks (for unit tests; `is_stub: true` because
/// `#live` hooks are no-op stubs — production assembly must use `real_with_live`).
pub fn ActorRunHandlers::real() -> ActorRunHandlers {
  let h = ActorRunHandlers::real_with_live(ActorLiveHooks::noop())
  ActorRunHandlers::{
    on_event_k: h.on_event_k,
    called_k: h.called_k,
    wake_queued_k: h.wake_queued_k,
    wake_cap_queued_k: h.wake_cap_queued_k,
    codex_updated_k: h.codex_updated_k,
    on_timer_k: h.on_timer_k,
    is_stub: true,
  }
}
