// Process-scope host event loop (`SessionHost`, `HostFlags`, `ShellSender`, `ShellSlot`,
// `HostTransport`, `MemHostTransport`, `run_host_loop`), 1:1 aligned with
// `station/mb/src/host/host.mbt:173-269` and `wave8-plan.md` v5 §2.1 & §2.2.
//
// Strict open-lifetime RC acyclicity invariants (zero strong reference cycles):
// - `rt.on_defect` captures ONLY `HostFlags` (never `SessionHost` or `Runtime`).
// - `SessionHost::shell_k` and `HubGen::shell_k` continuations capture ONLY leaf structs
//   (`ShellSender`, `ShellSlot`, `HubCounters`, `AbandonedOp`, `k`) — NEVER `SessionHost`,
//   `shell_waiters`, `HubGen`, or `EffectScope`.
// - `hub_asked` and `hub_timers` live on `SessionHost` tagged by `epoch` (NEVER inside
//   `HubGenResources`), so `EffectScope -> finalizer -> HubGenResources` has zero path back
//   to any `Deferred`, `Task`, `HubGen`, `EffectScope`, or `SessionHost`.

import "base_codec"
import "builders_core"
import "effect"
import "host_shim"
import "sql_db"

/// Maximum host events drained per outer pump iteration (`host.mbt:254`: 1 + up to 63).
pub let MAX_HOST_EVENTS_PER_ROUND : Int = 64

/// Standalone defect/error flags captured by `rt.on_defect` with ZERO back-reference
/// to `SessionHost` or `effect::Runtime`.
pub struct HostFlags {
  pub mut failed : Bool
  write_stderr_line : (String) -> Bool
}

/// Standalone leaf shell-call sender with ZERO back-reference to `SessionHost` or `Runtime`.
pub struct ShellSender {
  pub mut next_shell_id : Int64
  pub shell_call : (Int64, String, String, Option[Bytes]) -> Unit
}

pub fn ShellSender::new(
  shell_call : (Int64, String, String, Option[Bytes]) -> Unit,
) -> ShellSender {
  ShellSender::{
    next_shell_id: 0.to_int64(),
    shell_call: shell_call,
  }
}

pub fn ShellSender::alloc_shell_id(self : ShellSender) -> Int64 {
  self.next_shell_id = self.next_shell_id + 1.to_int64()
  self.next_shell_id
}

pub fn ShellSender::close_abandoned_handle_json(
  self : ShellSender,
  close_op : String,
  j : base_codec::Json,
) -> Unit {
  let handle_opt : Option[base_codec::Json] = match j {
    base_codec::Json::Num(_, _) => Some(j)
    base_codec::Json::Obj(_) => jget(j, "id")
    _ => None
  }
  match handle_opt {
    Some(h) => {
      let close_id = self.alloc_shell_id()
      let close_args = base_codec::json_obj([("id", h)])
      (self.shell_call)(
        close_id,
        close_op,
        base_codec::json_stringify(builders_core::normalize_json(close_args)),
        None,
      )
    }
    None => ()
  }
}

pub fn ShellSender::close_abandoned_op_json(
  self : ShellSender,
  aop : AbandonedOp,
  j : base_codec::Json,
) -> Unit {
  match aop {
    AbandonedOp::CloseTcpHandle => self.close_abandoned_handle_json("tcp.close", j)
    AbandonedOp::ClosePackHandle => self.close_abandoned_handle_json("pack.close", j)
  }
}

pub fn ShellSender::close_abandoned_op(
  self : ShellSender,
  aop : AbandonedOp,
  done : host_shim::ShellDone,
) -> Unit {
  if done.error.length() > 0 || done.json.length() == 0 {
    return
  }
  match parse_json_strict(done.json) {
    Ok(j) => self.close_abandoned_op_json(aop, j)
    Err(_) => ()
  }
}

pub fn ShellSender::close_abandoned_tcp_handle_json(
  self : ShellSender,
  j : base_codec::Json,
) -> Unit {
  self.close_abandoned_handle_json("tcp.close", j)
}

pub fn ShellSender::close_abandoned_tcp_handle(
  self : ShellSender,
  done : host_shim::ShellDone,
) -> Unit {
  self.close_abandoned_op(AbandonedOp::CloseTcpHandle, done)
}

/// Abstract host I/O & clock transport so production uses `host_shim` + `sql_db` while
/// deterministic unit tests inject `MemHostTransport` without touching OS FDs or wall clocks.
pub struct HostTransport {
  pub now_ms : () -> Int64
  pub wall_ms : () -> Int64
  pub wait : (Int64) -> Option[host_shim::HostEvent]
  pub shell_call : (Int64, String, String, Option[Bytes]) -> Unit
  pub shell_sync : (String, String) -> String
  pub write_stdout_line : (String) -> Bool
  pub write_stdout_bytes : (Bytes) -> Bool
  pub write_stderr_line : (String) -> Bool
  pub exit_process : (Int) -> Unit
  pub attach_db : (String, Int) -> Result[sql_db::Db, sql_db::SqlError]
  pub close_db : (sql_db::Db) -> Unit
  /// `false` in production (`HostTransport::live()`) so spurious/EINTR/24h-cap empty
  /// wakeups NEVER exit the loop; `true` in `MemHostTransport` so exhausted tests terminate.
  pub stop_on_empty_wait : Bool
}

pub fn HostTransport::live() -> HostTransport {
  HostTransport::{
    now_ms: host_shim::now_ms,
    wall_ms: host_shim::wall_ms,
    wait: host_shim::wait,
    shell_call: host_shim::shell_call,
    shell_sync: host_shim::shell_sync,
    write_stdout_line: fn(line : String) -> Bool {
      host_shim::write_stdout_line(builders_core::escape_line_separators(line))
    },
    write_stdout_bytes: host_shim::write_stdout,
    write_stderr_line: host_shim::write_stderr_line,
    exit_process: host_shim::exit_process,
    attach_db: sql_db::Db::attach,
    close_db: fn(db : sql_db::Db) -> Unit { db.close() },
    stop_on_empty_wait: false,
  }
}

// ── Public in-memory test transport (`MemHostTransport`) ──

pub struct MemShellCall {
  pub id : Int64
  pub op : String
  pub json : String
  pub bytes : Option[Bytes]
}

pub struct MemHostTransport {
  pub stdout_lines : Array[String]
  pub stdout_raw : Array[Bytes]
  pub stderr_lines : Array[String]
  pub shell_calls : Array[MemShellCall]
  pub shell_sync_calls : Array[(String, String)]
  pub exit_codes : Array[Int]
  pub wait_log : Array[Int64]
  pub events : Array[host_shim::HostEvent]
  pub mut event_head : Int
  /// Event indices where `wait(0)` returns `None` to force an outer round boundary (`rt.tick()`).
  pub barriers : Array[Int]
  pub mut barrier_head : Int
  pub mut now : Int64
  pub mut wall : Int64
  pub mut shell_sync_handler : Option[(String, String) -> String]
  pub mut attach_db_handler : Option[(String, Int) -> Result[sql_db::Db, sql_db::SqlError]]
  pub mut db_attach_calls : Array[(String, Int)]
  pub mut db_close_count : Int
  pub mut auto_advance_wait : Bool
  pub mut stop_on_empty_wait : Bool
  /// Optional scripted spurious empty wakeups (`wait(ms)` returns `None` without advancing `now`).
  pub mut spurious_nones : Int
}

pub fn MemHostTransport::new() -> MemHostTransport {
  MemHostTransport::{
    stdout_lines: [],
    stdout_raw: [],
    stderr_lines: [],
    shell_calls: [],
    shell_sync_calls: [],
    exit_codes: [],
    wait_log: [],
    events: [],
    event_head: 0,
    barriers: [],
    barrier_head: 0,
    now: 0.to_int64(),
    wall: 0.to_int64(),
    shell_sync_handler: None,
    attach_db_handler: None,
    db_attach_calls: [],
    db_close_count: 0,
    auto_advance_wait: true,
    stop_on_empty_wait: true,
    spurious_nones: 0,
  }
}

pub fn MemHostTransport::push_event(self : MemHostTransport, ev : host_shim::HostEvent) -> Unit {
  self.events.push(ev)
}

pub fn MemHostTransport::push_stdin(self : MemHostTransport, text : String) -> Unit {
  self.events.push(host_shim::HostEvent::StdinData(text.to_bytes()))
}

pub fn MemHostTransport::push_eof(self : MemHostTransport) -> Unit {
  self.events.push(host_shim::HostEvent::StdinEof)
}

/// Insert an outer-round barrier at the current event queue tail: inner `wait(0)` returns
/// `None` once at this index so `run_host_loop` runs `rt.tick()` before pulling the next event.
pub fn MemHostTransport::push_round_barrier(self : MemHostTransport) -> Unit {
  self.barriers.push(self.events.length())
}

pub fn MemHostTransport::push_shell_done(
  self : MemHostTransport,
  id : Int64,
  json : String,
  error : String = "",
  bytes : Option[Bytes] = None,
) -> Unit {
  self.events.push(
    host_shim::HostEvent::ShellDone(host_shim::ShellDone::{
      id: id,
      error: error,
      json: json,
      bytes: bytes,
    }),
  )
}

pub fn MemHostTransport::advance_now(self : MemHostTransport, delta_ms : Int64) -> Unit {
  self.now = self.now + delta_ms
  self.wall = self.wall + delta_ms
}

pub fn MemHostTransport::transport(self : MemHostTransport) -> HostTransport {
  HostTransport::{
    now_ms: fn() -> Int64 { self.now },
    wall_ms: fn() -> Int64 { self.wall },
    wait: fn(ms : Int64) -> Option[host_shim::HostEvent] {
      self.wait_log.push(ms)
      if self.spurious_nones > 0 {
        self.spurious_nones = self.spurious_nones - 1
        return None
      }
      if ms == 0.to_int64() && self.barrier_head < self.barriers.length() {
        if self.barriers[self.barrier_head] == self.event_head {
          self.barrier_head = self.barrier_head + 1
          return None
        }
      }
      if self.event_head < self.events.length() {
        let ev = self.events[self.event_head]
        self.event_head = self.event_head + 1
        return Some(ev)
      }
      if ms > 0.to_int64() && self.auto_advance_wait {
        self.now = self.now + ms
        self.wall = self.wall + ms
      }
      None
    },
    shell_call: fn(id : Int64, op : String, json : String, bytes : Option[Bytes]) -> Unit {
      self.shell_calls.push(MemShellCall::{ id: id, op: op, json: json, bytes: bytes })
    },
    shell_sync: fn(op : String, json : String) -> String {
      self.shell_sync_calls.push((op, json))
      match self.shell_sync_handler {
        Some(f) => f(op, json)
        None => "{\"value\":null}"
      }
    },
    write_stdout_line: fn(line : String) -> Bool {
      self.stdout_lines.push(builders_core::escape_line_separators(line))
      true
    },
    write_stdout_bytes: fn(bytes : Bytes) -> Bool {
      self.stdout_raw.push(bytes)
      true
    },
    write_stderr_line: fn(line : String) -> Bool {
      self.stderr_lines.push(line)
      true
    },
    exit_process: fn(code : Int) -> Unit {
      self.exit_codes.push(code)
    },
    attach_db: fn(path : String, wait_ms : Int) -> Result[sql_db::Db, sql_db::SqlError] {
      self.db_attach_calls.push((path, wait_ms))
      match self.attach_db_handler {
        Some(f) => f(path, wait_ms)
        None => Err(sql_db::sql_error(1, "MemHostTransport: no attach_db_handler"))
      }
    },
    close_db: fn(_db : sql_db::Db) -> Unit {
      self.db_close_count = self.db_close_count + 1
    },
    stop_on_empty_wait: self.stop_on_empty_wait,
  }
}

// ── Shell ownership & abandoned-op handle cleanup ──

pub enum ShellOwner {
  Process
  Hub(Int)
}

pub enum AbandonedOp {
  CloseTcpHandle
  ClosePackHandle
}

/// Standalone per-call cancellation/settlement leaf with ZERO back-reference to `SessionHost`.
/// Coordinates exact-once handle cleanup across `ShellDone` settlement and fiber interruption.
pub struct ShellSlot {
  pub mut cancelled : Bool
  pub mut settled : Option[base_codec::Json]
  pub mut closed : Bool
}

/// Pure leaf list of interrupted shell call IDs queued for synchronous removal from
/// `SessionHost.shell_waiters` without capturing `SessionHost` in `done.wait_k`.
pub struct CancelledShellIds {
  pub items : Array[(Int64, Option[AbandonedOp])]
}

pub struct ShellWaiter {
  pub owner : ShellOwner
  pub abandoned_op : Option[AbandonedOp]
  pub slot : ShellSlot
  pub done : effect::Deferred[(base_codec::Json, Option[Bytes])]
}

/// Epoch-tagged RPC waiter stored on `SessionHost` (never inside `HubGenResources`).
pub struct HubAskedEntry {
  pub epoch : Int
  pub deferred : effect::Deferred[base_codec::Json]
}

/// Epoch-tagged Node timer callback stored on `SessionHost` (never inside `HubGenResources`).
pub struct HubTimerEntry {
  pub epoch : Int
  pub then : () -> Unit
}

// ── Process-scope SessionHost ──

pub struct SessionHost {
  pub rt : effect::Runtime
  pub proc_scope : effect::EffectScope
  pub mut proc_closed : Bool
  pub transport : HostTransport
  pub flags : HostFlags
  pub sender : ShellSender
  pub lines : effect::Queue[String]
  input : builders_core::RawLines
  pub shell_waiters : Map[Int64, ShellWaiter]
  pub cancelled_ids : CancelledShellIds
  pub abandoned_ops : Map[Int64, AbandonedOp]
  pub hub_asked : Map[Int, HubAskedEntry]
  pub hub_timers : Map[Int, HubTimerEntry]
  /// Process-scope manifest publish barriers keyed by manifest path (zero back-reference to `HubGen`).
  pub manifest_barriers : Map[String, effect::Deferred[Unit]]
  manifest_barrier_seq : Map[String, Int]
  /// Monotonic process-scope RPC/timer ID counter (NEVER reset across `{"db": ...}`).
  pub mut next : Int
  pub mut exited : Bool
  pub mut exit_code : Int
}

pub fn SessionHost::new(rt : effect::Runtime, transport : HostTransport) -> SessionHost {
  let flags = HostFlags::{
    failed: false,
    write_stderr_line: transport.write_stderr_line,
  }
  let sender = ShellSender::new(transport.shell_call)
  let host = SessionHost::{
    rt: rt,
    proc_scope: rt.new_scope(),
    proc_closed: false,
    transport: transport,
    flags: flags,
    sender: sender,
    lines: effect::Queue::unbounded(),
    input: builders_core::RawLines::new(),
    shell_waiters: Map::new(),
    cancelled_ids: CancelledShellIds::{ items: [] },
    abandoned_ops: Map::new(),
    hub_asked: Map::new(),
    hub_timers: Map::new(),
    manifest_barriers: Map::new(),
    manifest_barrier_seq: Map::new(),
    next: 0,
    exited: false,
    exit_code: 0,
  }
  // Captures ONLY `flags` (never `host` or `rt`): zero `SessionHost <-> Runtime` RC cycle.
  rt.on_defect(fn(e : effect::EffectError) -> Unit {
    let _ = (flags.write_stderr_line)("failed: " + effect::effect_error_to_string(e))
    flags.failed = true
  })
  host
}

pub fn SessionHost::live() -> SessionHost {
  let tr = HostTransport::live()
  let rt = effect::Runtime::live(tr.now_ms)
  SessionHost::new(rt, tr)
}

/// Deterministic test host using `effect::Runtime::new_at(None, 0L)` (NEVER seeded!)
/// wired to `mem.now` via `rt.outside_clock` so virtual timers fire deterministically.
pub fn SessionHost::for_test(mem : MemHostTransport) -> SessionHost {
  let rt = effect::Runtime::new_at(None, 0.to_int64())
  rt.outside_clock(fn() -> Int64 { mem.now })
  SessionHost::new(rt, mem.transport())
}

pub fn SessionHost::alloc_id(self : SessionHost) -> Int {
  self.next = self.next + 1
  self.next
}

pub fn SessionHost::say(self : SessionHost, text : String) -> Unit {
  let _ = (self.transport.write_stdout_line)(text)
}

pub fn SessionHost::say_bytes(self : SessionHost, bytes : Bytes) -> Unit {
  let _ = (self.transport.write_stdout_bytes)(bytes)
  let _ = (self.transport.write_stdout_bytes)("\n".to_bytes())
}

pub fn SessionHost::out(self : SessionHost, bytes : Bytes) -> Unit {
  let _ = (self.transport.write_stdout_bytes)(bytes)
}

pub fn SessionHost::note(self : SessionHost, text : String) -> Unit {
  let _ = (self.transport.write_stderr_line)(text)
}

pub fn SessionHost::exit(self : SessionHost, code : Int) -> Unit {
  self.exit_code = code
  self.exited = true
  (self.transport.exit_process)(code)
}

/// Process-scope silent `pack.close` via `self.sender` (bypasses `HubGen::shell_k`,
/// emits zero business RPCs, touches zero generation counters, zero RC cycles).
pub fn SessionHost::close_pack_silent(self : SessionHost, id : Int) -> Unit {
  self.sender.close_abandoned_op_json(AbandonedOp::ClosePackHandle, jint(id))
}

/// Process-scope silent `fs.remove` via `self.sender` (bypasses `HubGen::shell_k`,
/// emits zero business RPCs, touches zero generation counters, zero RC cycles).
pub fn SessionHost::remove_path_silent(self : SessionHost, path : String) -> Unit {
  let call_id = self.sender.alloc_shell_id()
  let args = base_codec::json_obj([
    ("path", jstr(path)),
    ("recursive", jbool(false)),
  ])
  (self.sender.shell_call)(
    call_id,
    "fs.remove",
    base_codec::json_stringify(builders_core::normalize_json(args)),
    None,
  )
}

/// Process-scope shell call over `ShellOwner::Process` (survives `rotate_hub_gen`,
/// emits zero business frames, touches zero generation counters, zero RC cycles).
pub fn SessionHost::proc_shell_k(
  self : SessionHost,
  method : String,
  args : base_codec::Json,
  data : Option[Bytes],
  k : (effect::Exit[(base_codec::Json, Option[Bytes])]) -> Unit,
) -> Unit {
  self.shell_k(ShellOwner::Process, method, args, data, None, None, k)
}

/// Spawn a process-scope daemon inside `self.proc_scope` (survives `rotate_hub_gen`,
/// cancelled only on process exit). Returns `false` if `proc_scope` is already closed.
pub fn SessionHost::proc_daemon_k(
  self : SessionHost,
  name : String,
  body : ((effect::Exit[Unit]) -> Unit) -> Unit,
) -> Bool {
  if self.proc_closed {
    return false
  }
  let _ = self.proc_scope.fork_daemon(name, body, fn(_e : effect::EffectError) -> Unit { () })
  true
}

/// Process-scope silent atomic manifest publish (`fs.put(temp)` + `fs.rename(temp, path)`
/// over `ShellOwner::Process` in `self.scope`, surviving `rotate_hub_gen` with zero business
/// frames, zero SQLite writes, and zero old-generation counter mutations).
pub fn SessionHost::publish_manifest_k(
  self : SessionHost,
  path : String,
  temp : String,
  json : String,
  wait_before : Option[effect::Deferred[Unit]],
) -> effect::Deferred[effect::Exit[Unit]] {
  self.publish_manifest_lazy_k(path, temp, fn() -> String { json }, wait_before)
}

/// Lazy-JSON variant of `publish_manifest_k` so callers waiting on an in-flight mirror
/// mutation (`wait_before`) serialize the final post-mutation manifest state right before `fs.put`.
pub fn SessionHost::publish_manifest_lazy_k(
  self : SessionHost,
  path : String,
  temp : String,
  make_json : () -> String,
  wait_before : Option[effect::Deferred[Unit]],
) -> effect::Deferred[effect::Exit[Unit]] {
  let prev = self.manifest_barriers.get(path)
  let seq = self.alloc_id()
  let barrier : effect::Deferred[Unit] = effect::Deferred::new()
  let result : effect::Deferred[effect::Exit[Unit]] = effect::Deferred::new()
  self.manifest_barriers.set(path, barrier)
  self.manifest_barrier_seq.set(path, seq)
  let release_barrier = fn(res : effect::Exit[Unit], dk : (effect::Exit[Unit]) -> Unit) -> Unit {
    match self.manifest_barrier_seq.get(path) {
      Some(cur) => {
        if cur == seq {
          let _ = self.manifest_barriers.remove(path)
          let _ = self.manifest_barrier_seq.remove(path)
        }
      }
      None => ()
    }
    let _ = barrier.succeed(())
    let _ = result.succeed(res)
    match res {
      effect::Exit::Interrupted => dk(effect::Exit::Interrupted)
      _ => dk(effect::Exit::Succeeded(()))
    }
  }
  let _ = self.proc_scope.fork_daemon(
    "publish manifest",
    fn(dk : (effect::Exit[Unit]) -> Unit) -> Unit {
      let run_io = fn() -> Unit {
        let json = make_json()
        self.shell_k(
          ShellOwner::Process,
          "fs.put",
          base_codec::json_obj([
            ("path", jstr(temp)),
            ("offset", jnum(0.0)),
            ("exclusive", jbool(true)),
            ("truncate", jbool(true)),
            ("sync", jbool(true)),
            ("mode", jnum(384.0)),
          ]),
          Some(json.to_bytes()),
          None,
          None,
          fn(pex : effect::Exit[(base_codec::Json, Option[Bytes])]) -> Unit {
            match pex {
              effect::Exit::Failed(e) => release_barrier(effect::Exit::Failed(e), dk)
              effect::Exit::Interrupted => release_barrier(effect::Exit::Interrupted, dk)
              effect::Exit::Succeeded(_) => {
                self.shell_k(
                  ShellOwner::Process,
                  "fs.rename",
                  base_codec::json_obj([("from", jstr(temp)), ("to", jstr(path))]),
                  None,
                  None,
                  None,
                  fn(rex : effect::Exit[(base_codec::Json, Option[Bytes])]) -> Unit {
                    match rex {
                      effect::Exit::Succeeded(_) => release_barrier(effect::Exit::Succeeded(()), dk)
                      effect::Exit::Interrupted => release_barrier(effect::Exit::Interrupted, dk)
                      effect::Exit::Failed(e) => {
                        self.remove_path_silent(temp)
                        release_barrier(effect::Exit::Failed(e), dk)
                      }
                    }
                  },
                )
              }
            }
          },
        )
      }
      let after_prev = fn() -> Unit {
        match wait_before {
          Some(d) => {
            if d.is_done() {
              run_io()
            } else {
              d.wait_k(fn(wex : effect::Exit[Unit]) -> Unit {
                match wex {
                  effect::Exit::Interrupted => release_barrier(effect::Exit::Interrupted, dk)
                  _ => run_io()
                }
              })
            }
          }
          None => run_io()
        }
      }
      match prev {
        Some(pb) => {
          if pb.is_done() {
            after_prev()
          } else {
            pb.wait_k(fn(bex : effect::Exit[Unit]) -> Unit {
              match bex {
                effect::Exit::Interrupted => release_barrier(effect::Exit::Interrupted, dk)
                _ => after_prev()
              }
            })
          }
        }
        None => after_prev()
      }
    },
    fn(_e : effect::EffectError) -> Unit { () },
  )
  result
}

/// Read the next complete `\n`-terminated stdin line.
/// Explicitly maps `Exit::Failed(EffectError::QueueShutdown)` -> `Exit::Succeeded(None)` (EOF);
/// all other failures and `Exit::Interrupted` are propagated verbatim.
pub fn SessionHost::line_k(
  self : SessionHost,
  k : (effect::Exit[Option[String]]) -> Unit,
) -> Unit {
  self.lines.take_k(fn(ex : effect::Exit[String]) -> Unit {
    match ex {
      effect::Exit::Succeeded(line) => k(effect::Exit::Succeeded(Some(line)))
      effect::Exit::Failed(effect::EffectError::QueueShutdown) => k(effect::Exit::Succeeded(None))
      effect::Exit::Failed(e) => k(effect::Exit::Failed(e))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

/// Synchronous shell call (`host.mbt:73`).
pub fn SessionHost::shell_sync(
  self : SessionHost,
  op : String,
  args : base_codec::Json,
) -> Result[base_codec::Json, builders_core::ShellError] {
  let raw = (self.transport.shell_sync)(op, base_codec::json_stringify(builders_core::normalize_json(args)))
  builders_core::parse_shell_sync_answer(raw)
}

/// Synchronously remove any shell waiters whose fibers were interrupted, transferring only
/// handle-producing ops (`Some(CloseTcpHandle)`) to `abandoned_ops` (zero residual for `None` ops).
pub fn SessionHost::drain_cancelled_waiters(self : SessionHost) -> Unit {
  for i in 0..<self.cancelled_ids.items.length() {
    let (id, abandoned_op) = self.cancelled_ids.items[i]
    match self.shell_waiters.get(id) {
      Some(w) => {
        let _ = self.shell_waiters.remove(id)
        if !w.slot.closed {
          match abandoned_op {
            Some(aop) => self.abandoned_ops.set(id, aop)
            None => ()
          }
        }
      }
      None => ()
    }
  }
  self.cancelled_ids.items.clear()
}

/// Run one runtime tick and immediately drain any cancelled shell waiters.
pub fn SessionHost::tick(self : SessionHost) -> Unit {
  self.rt.tick()
  self.drain_cancelled_waiters()
}

/// Asynchronous shell call (`host.mbt:83-104`) with ownership tagging and late/interleaved
/// handle cleanup. The `done.wait_k` continuation captures ONLY leaf objects (`slot`, `sender`,
/// `cancelled_ids`, `id`, `abandoned_op`, `k`) — NEVER `SessionHost` or `shell_waiters`.
pub fn SessionHost::shell_k(
  self : SessionHost,
  owner : ShellOwner,
  op : String,
  args : base_codec::Json,
  bytes : Option[Bytes],
  abandoned_op : Option[AbandonedOp],
  on_called : Option[(Int64) -> Unit],
  k : (effect::Exit[(base_codec::Json, Option[Bytes])]) -> Unit,
) -> Unit {
  self.drain_cancelled_waiters()
  let sender = self.sender
  let cancelled_ids = self.cancelled_ids
  let id = sender.alloc_shell_id()
  match on_called {
    Some(f) => f(id)
    None => ()
  }
  let done : effect::Deferred[(base_codec::Json, Option[Bytes])] = effect::Deferred::new()
  let slot = ShellSlot::{ cancelled: false, settled: None, closed: false }
  self.shell_waiters.set(
    id,
    ShellWaiter::{
      owner: owner,
      abandoned_op: abandoned_op,
      slot: slot,
      done: done,
    },
  )
  let json_str = base_codec::json_stringify(builders_core::normalize_json(args))
  (sender.shell_call)(id, op, json_str, bytes)
  done.wait_k(fn(ex : effect::Exit[(base_codec::Json, Option[Bytes])]) -> Unit {
    match ex {
      effect::Exit::Interrupted => {
        slot.cancelled = true
        if !slot.closed {
          match (slot.settled, abandoned_op) {
            (Some(j), Some(aop)) => {
              slot.closed = true
              sender.close_abandoned_op_json(aop, j)
            }
            (None, _) => cancelled_ids.items.push((id, abandoned_op))
            _ => ()
          }
        }
        k(effect::Exit::Interrupted)
      }
      other => {
        slot.closed = true
        k(other)
      }
    }
  })
}

/// Drop (without failing) all `ShellOwner::Hub(epoch)` waiters during `{"db": ...}` rotation,
/// transferring any handle-producing calls to `abandoned_ops`. Never touches `ShellOwner::Process`.
pub fn SessionHost::abandon_hub_waiters(self : SessionHost, epoch : Int) -> Unit {
  let keys = self.shell_waiters.keys()
  for i in 0..<keys.length() {
    let id = keys[i]
    match self.shell_waiters.get(id) {
      Some(w) => {
        match w.owner {
          ShellOwner::Hub(ep) => {
            if ep == epoch {
              w.slot.cancelled = true
              let _ = self.shell_waiters.remove(id)
              match w.abandoned_op {
                Some(aop) => self.abandoned_ops.set(id, aop)
                None => ()
              }
            }
          }
          ShellOwner::Process => ()
        }
      }
      None => ()
    }
  }
}

/// Drop (without failing) all RPC waiters belonging to `epoch` during `{"db": ...}` rotation.
pub fn SessionHost::abandon_hub_asked(self : SessionHost, epoch : Int) -> Unit {
  let keys = self.hub_asked.keys()
  for i in 0..<keys.length() {
    let id = keys[i]
    match self.hub_asked.get(id) {
      Some(entry) => {
        if entry.epoch == epoch {
          let _ = self.hub_asked.remove(id)
        }
      }
      None => ()
    }
  }
}

/// Drop all Node timer callbacks belonging to `epoch` during `{"db": ...}` rotation.
pub fn SessionHost::abandon_hub_timers(self : SessionHost, epoch : Int) -> Unit {
  let keys = self.hub_timers.keys()
  for i in 0..<keys.length() {
    let id = keys[i]
    match self.hub_timers.get(id) {
      Some(entry) => {
        if entry.epoch == epoch {
          let _ = self.hub_timers.remove(id)
        }
      }
      None => ()
    }
  }
}

/// Dispatch one host event (`host.mbt:173-200`).
pub fn SessionHost::dispatch_event(self : SessionHost, ev : host_shim::HostEvent) -> Unit {
  self.drain_cancelled_waiters()
  match ev {
    host_shim::HostEvent::StdinData(chunk) => {
      // Enqueue ALL complete `\n`-terminated lines in this chunk (never truncated at 64 lines).
      let items = self.input.push(chunk)
      for i in 0..<items.length() {
        let _ = self.lines.try_offer(items[i])
      }
    }
    host_shim::HostEvent::StdinEof => {
      // Shutdown queue without synthesizing an unterminated trailing partial line.
      self.lines.shutdown()
    }
    host_shim::HostEvent::ShellDone(done) => {
      match self.shell_waiters.get(done.id) {
        Some(waiter) => {
          let _ = self.shell_waiters.remove(done.id)
          if waiter.slot.cancelled {
            if !waiter.slot.closed {
              match waiter.abandoned_op {
                Some(aop) => {
                  waiter.slot.closed = true
                  self.sender.close_abandoned_op(aop, done)
                }
                None => ()
              }
            }
          } else {
            match builders_core::decode_shell_done(done) {
              Ok((j_opt, b_opt)) => {
                let j = match j_opt {
                  Some(v) => v
                  None => base_codec::json_null()
                }
                waiter.slot.settled = Some(j)
                let _ = waiter.done.succeed((j, b_opt))
              }
              Err(err) => {
                let _ = waiter.done.fail(effect::EffectError::IoError(err.message))
              }
            }
          }
        }
        None => {
          match self.abandoned_ops.get(done.id) {
            Some(aop) => {
              let _ = self.abandoned_ops.remove(done.id)
              self.sender.close_abandoned_op(aop, done)
            }
            None => ()
          }
        }
      }
    }
    host_shim::HostEvent::Sys(_, _) => ()
  }
}

/// Run the 1:1 `host.mbt:228-272` outer pump loop over `SessionHost`.
pub fn run_host_loop(
  host : SessionHost,
  main_fn : (SessionHost, (effect::Exit[Unit]) -> Unit) -> Unit,
) -> Int {
  let main_fiber = host.rt.fork_named("main", fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    main_fn(host, k)
  })
  while true {
    // Unconditionally tick once per round so expired timers fire even when `rt.idle()` is true.
    host.tick()
    if main_fiber.is_done() || host.exited {
      break
    }
    let wait_ms : Int64 = if !host.rt.idle() {
      0.to_int64()
    } else {
      match host.rt.next_timer() {
        Some(at) => {
          let left = at - (host.transport.now_ms)()
          if left < 0.to_int64() { 0.to_int64() } else { left }
        }
        None => (-1).to_int64()
      }
    }
    match (host.transport.wait)(wait_ms) {
      Some(first) => {
        host.dispatch_event(first)
        let mut drained = 1
        while drained < MAX_HOST_EVENTS_PER_ROUND {
          match (host.transport.wait)(0.to_int64()) {
            Some(more) => {
              host.dispatch_event(more)
              drained = drained + 1
            }
            None => break
          }
        }
      }
      None => {
        // Production (`stop_on_empty_wait == false`): NEVER break on empty `wait()` —
        // POSIX EINTR, C shim 24h cap (86400000ms), or Windows SRW tick granularity can
        // return `None` before deadline (1:1 `host.mbt:229-263`).
        if host.transport.stop_on_empty_wait {
          if wait_ms < 0.to_int64() {
            break
          }
          if wait_ms > 0.to_int64() {
            let after = (host.transport.now_ms)()
            match host.rt.next_timer() {
              Some(at) => {
                if after < at {
                  break
                }
              }
              None => break
            }
          }
        }
      }
    }
  }
  let main_outcome = main_fiber.poll()
  if !main_fiber.is_done() {
    main_fiber.interrupt()
    host.tick()
  }
  host.proc_closed = true
  host.proc_scope.close_now()
  host.tick()
  if host.exited {
    return host.exit_code
  }
  match main_outcome {
    Some(effect::Exit::Failed(e)) => {
      host.note("failed: " + effect::effect_error_to_string(e))
      1
    }
    Some(_) => if host.flags.failed { 1 } else { 0 }
    None => 1
  }
}
